ind:serviceProviderType rdf:type rdf:Property ;
    rdfs:label 'Service Provider Type' ;
    rdfs:comment 'Classification of the entity performing the maintenance work (internal NCDOT staff, external contractor, vendor, or mutual aid from another agency).' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
