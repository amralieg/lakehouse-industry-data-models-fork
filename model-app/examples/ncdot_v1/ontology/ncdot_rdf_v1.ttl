    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fleetNumber rdf:type rdf:Property ;
    rdfs:label 'Fleet Number' ;
    rdfs:comment 'Fleet identifier if the vehicle is part of a registered fleet. Null if not a fleet vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:antiqueFlag rdf:type rdf:Property ;
    rdfs:label 'Antique Flag' ;
    rdfs:comment 'Indicates whether the vehicle qualifies for antique vehicle registration based on age and condition.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salvageFlag rdf:type rdf:Property ;
    rdfs:label 'Salvage Flag' ;
    rdfs:comment 'Indicates whether the vehicle has been declared a total loss by an insurance company and branded as salvage.' ;
    rdfs:domain ind:Vehicle ;
