ind:firmPanelRevisionDate rdf:type rdf:Property ;
    rdfs:label 'Firm Panel Revision Date' ;
    rdfs:comment 'Most recent date when the FIRM panel was revised or updated by FEMA.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:floodZoneRatingFactor rdf:type rdf:Property ;
