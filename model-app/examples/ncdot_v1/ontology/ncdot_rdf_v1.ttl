ind:professionalLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Professional License Number' ;
    rdfs:comment 'License number of the professional who sealed the document (e.g., PE license number).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archiveFlag rdf:type rdf:Property ;
    rdfs:label 'Archive Flag' ;
    rdfs:comment 'Boolean indicator of whether the document has been archived and moved to long-term storage.' ;
