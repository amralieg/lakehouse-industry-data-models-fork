ind:imapUnitNumber rdf:type rdf:Property ;
    rdfs:label 'Imap Unit Number' ;
    rdfs:comment 'Identification number of the IMAP unit that responded to the incident.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:towRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Tow Required Flag' ;
    rdfs:comment 'Indicator whether vehicle towing services were required.' ;
