ind:environmentalPermitRequired rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Required' ;
    rdfs:comment 'Flag indicating whether environmental permits were required for the maintenance work.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stormwaterBmpImplemented rdf:type rdf:Property ;
    rdfs:label 'Stormwater Bmp Implemented' ;
    rdfs:comment 'Flag indicating whether stormwater best management practices were implemented during the maintenance event.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
