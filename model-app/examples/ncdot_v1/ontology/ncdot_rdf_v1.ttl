ind:initiativeRating rdf:type rdf:Property ;
    rdfs:label 'Initiative Rating' ;
    rdfs:comment 'Rating score for the employee\'s proactive approach, problem-solving, and innovative contributions.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attendanceReliabilityRating rdf:type rdf:Property ;
    rdfs:label 'Attendance Reliability Rating' ;
    rdfs:comment 'Rating score for the employee\'s punctuality, attendance record, and dependability.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerServiceRating rdf:type rdf:Property ;
    rdfs:label 'Customer Service Rating' ;
    rdfs:comment 'Rating score for the employee\'s effectiveness in serving internal or external customers and stakeholders.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyComplianceRating rdf:type rdf:Property ;
    rdfs:label 'Safety Compliance Rating' ;
    rdfs:comment 'Rating score for the employee\'s adherence to safety protocols and Occupational Safety and Health Administration (OSHA) standards.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strengthsComments rdf:type rdf:Property ;
    rdfs:label 'Strengths Comments' ;
    rdfs:comment 'Narrative comments describing the employee\'s key strengths and positive contributions during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areasForImprovementComments rdf:type rdf:Property ;
    rdfs:label 'Areas For Improvement Comments' ;
    rdfs:comment 'Narrative comments identifying specific areas where the employee needs development or improvement.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalsAchievedComments rdf:type rdf:Property ;
    rdfs:label 'Goals Achieved Comments' ;
    rdfs:comment 'Narrative comments describing the goals and objectives the employee successfully achieved during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalsNotAchievedComments rdf:type rdf:Property ;
    rdfs:label 'Goals Not Achieved Comments' ;
    rdfs:comment 'Narrative comments describing goals or objectives that were not met and reasons for non-achievement.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallComments rdf:type rdf:Property ;
    rdfs:label 'Overall Comments' ;
    rdfs:comment 'General narrative comments providing an overall assessment of the employee\'s performance during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:developmentPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Development Plan Description' ;
    rdfs:comment 'Detailed description of the employee development plan, including training, mentoring, and growth opportunities identified for the upcoming period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingRecommendations rdf:type rdf:Property ;
    rdfs:label 'Training Recommendations' ;
    rdfs:comment 'Specific training courses, certifications, or learning activities recommended for the employee\'s professional development.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careerDevelopmentGoals rdf:type rdf:Property ;
    rdfs:label 'Career Development Goals' ;
    rdfs:comment 'Long-term career objectives and development goals established for the employee in collaboration with the reviewer.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewGoals rdf:type rdf:Property ;
    rdfs:label 'Next Review Goals' ;
    rdfs:comment 'Specific performance goals and objectives set for the employee to achieve by the next review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeAcknowledgementFlag rdf:type rdf:Property ;
    rdfs:label 'Employee Acknowledgement Flag' ;
    rdfs:comment 'Indicates whether the employee has acknowledged receipt and review of the performance evaluation.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employeeAcknowledgementDate rdf:type rdf:Property ;
    rdfs:label 'Employee Acknowledgement Date' ;
    rdfs:comment 'Date when the employee acknowledged receipt and review of the performance evaluation.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeeComments rdf:type rdf:Property ;
    rdfs:label 'Employee Comments' ;
    rdfs:comment 'Comments provided by the employee as part of self-assessment or response to the performance review.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeSignatureCapturedFlag rdf:type rdf:Property ;
    rdfs:label 'Employee Signature Captured Flag' ;
    rdfs:comment 'Indicates whether the employee\'s signature has been captured electronically or physically on the review document.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewerSignatureCapturedFlag rdf:type rdf:Property ;
    rdfs:label 'Reviewer Signature Captured Flag' ;
    rdfs:comment 'Indicates whether the reviewer\'s signature has been captured electronically or physically on the review document.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:probationaryStatus rdf:type rdf:Property ;
    rdfs:label 'Probationary Status' ;
    rdfs:comment 'Indicates whether the employee is in probationary status at the time of the review (probationary, permanent, not applicable).' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probationaryRecommendation rdf:type rdf:Property ;
    rdfs:label 'Probationary Recommendation' ;
    rdfs:comment 'Recommendation for probationary employees regarding continuation, conversion to permanent status, extension, or termination.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionRecommendationFlag rdf:type rdf:Property ;
    rdfs:label 'Promotion Recommendation Flag' ;
    rdfs:comment 'Indicates whether the reviewer recommends the employee for promotion based on performance.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:promotionRecommendationComments rdf:type rdf:Property ;
    rdfs:label 'Promotion Recommendation Comments' ;
    rdfs:comment 'Detailed comments supporting the promotion recommendation, including justification and readiness assessment.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryIncreaseRecommendationFlag rdf:type rdf:Property ;
    rdfs:label 'Salary Increase Recommendation Flag' ;
    rdfs:comment 'Indicates whether the reviewer recommends a salary increase or merit raise for the employee.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salaryIncreasePercentage rdf:type rdf:Property ;
    rdfs:label 'Salary Increase Percentage' ;
    rdfs:comment 'Recommended percentage increase in salary based on performance evaluation results.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryIncreaseAmount rdf:type rdf:Property ;
    rdfs:label 'Salary Increase Amount' ;
    rdfs:comment 'Recommended dollar amount of salary increase based on performance evaluation results.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusRecommendationFlag rdf:type rdf:Property ;
    rdfs:label 'Bonus Recommendation Flag' ;
    rdfs:comment 'Indicates whether the reviewer recommends a performance bonus for the employee.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceImprovementPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Improvement Plan Flag' ;
    rdfs:comment 'Indicates whether the employee has been placed on a Performance Improvement Plan (PIP) as a result of the review.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceImprovementPlanStartDate rdf:type rdf:Property ;
    rdfs:label 'Performance Improvement Plan Start Date' ;
    rdfs:comment 'Start date of the Performance Improvement Plan (PIP) if the employee has been placed on one.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceImprovementPlanEndDate rdf:type rdf:Property ;
    rdfs:label 'Performance Improvement Plan End Date' ;
    rdfs:comment 'Expected end date of the Performance Improvement Plan (PIP) period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceImprovementPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Improvement Plan Description' ;
    rdfs:comment 'Detailed description of the Performance Improvement Plan (PIP), including specific performance deficiencies and required improvements.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionFlag rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Flag' ;
    rdfs:comment 'Indicates whether disciplinary action was recommended or taken as a result of the performance review.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disciplinaryActionType rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Type' ;
    rdfs:comment 'Type of disciplinary action taken or recommended (e.g., verbal warning, written warning, suspension, termination, none).' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionComments rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Comments' ;
    rdfs:comment 'Detailed comments describing the disciplinary action, reasons, and expected corrective measures.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Review Document Url' ;
    rdfs:comment 'Uniform Resource Locator (URL) or file path to the stored performance review document in SharePoint or document management system.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTemplateVersion rdf:type rdf:Property ;
    rdfs:label 'Review Template Version' ;
    rdfs:comment 'Version identifier of the performance review template or form used for this evaluation.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCycle rdf:type rdf:Property ;
    rdfs:label 'Review Cycle' ;
    rdfs:comment 'Identifier for the review cycle or period (e.g., FY2024-Q1, Annual-2024) to group reviews conducted in the same timeframe.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordId rdf:type rdf:Property ;
    rdfs:label 'Source System Record Id' ;
    rdfs:comment 'Unique identifier or key of the performance review record in the source system for traceability and reconciliation.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPlanId rdf:type rdf:Property ;
    rdfs:label 'Benefit Plan Id' ;
    rdfs:comment 'Unique identifier for the benefit plan record. Primary key for the benefit plan entity.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitPlan .

ind:planCode rdf:type rdf:Property ;
    rdfs:label 'Plan Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the benefit plan for reference in HR and payroll systems. Used for system integration and reporting.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planCategory rdf:type rdf:Property ;
    rdfs:label 'Plan Category' ;
    rdfs:comment 'High-level grouping of benefit plans for organizational and reporting purposes.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'Master policy number assigned by the carrier for the group benefit plan contract.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planAdministrator rdf:type rdf:Property ;
    rdfs:label 'Plan Administrator' ;
    rdfs:comment 'Name of the organization or entity responsible for administering the benefit plan, which may differ from the carrier.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Date when the benefit plan is discontinued and no longer available for new enrollments or coverage.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planYearStartDate rdf:type rdf:Property ;
    rdfs:label 'Plan Year Start Date' ;
    rdfs:comment 'Beginning date of the benefit plan year for coverage, eligibility, and contribution calculations.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planYearEndDate rdf:type rdf:Property ;
    rdfs:label 'Plan Year End Date' ;
    rdfs:comment 'Ending date of the benefit plan year for coverage, eligibility, and contribution calculations.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period Start' ;
    rdfs:comment 'Beginning date of the open enrollment period when employees can enroll in or make changes to the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period End' ;
    rdfs:comment 'Ending date of the open enrollment period when employees can enroll in or make changes to the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageLevelOptions rdf:type rdf:Property ;
    rdfs:label 'Coverage Level Options' ;
    rdfs:comment 'Available coverage tiers for the benefit plan such as employee only, employee plus spouse, employee plus children, or family coverage.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Amount' ;
    rdfs:comment 'Standard dollar amount that employees contribute per pay period for the benefit plan coverage.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Amount' ;
    rdfs:comment 'Standard dollar amount that NCDOT contributes per pay period toward employee benefit plan coverage.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeContributionPercentage rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Percentage' ;
    rdfs:comment 'Percentage of the total premium cost that employees are required to contribute for benefit plan coverage.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerContributionPercentage rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Percentage' ;
    rdfs:comment 'Percentage of the total premium cost that NCDOT contributes toward employee benefit plan coverage.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Total Premium Amount' ;
    rdfs:comment 'Total cost per pay period for the benefit plan coverage including both employee and employer contributions.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionFrequency rdf:type rdf:Property ;
    rdfs:label 'Contribution Frequency' ;
    rdfs:comment 'Frequency at which employee and employer contributions are collected for the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityRules rdf:type rdf:Property ;
    rdfs:label 'Eligibility Rules' ;
    rdfs:comment 'Detailed description of the criteria and conditions that employees must meet to be eligible for enrollment in the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Days' ;
    rdfs:comment 'Number of days an employee must wait after hire date or qualifying event before becoming eligible for the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Hours Required' ;
    rdfs:comment 'Minimum number of hours per week or pay period an employee must work to be eligible for the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeClassEligibility rdf:type rdf:Property ;
    rdfs:label 'Employee Class Eligibility' ;
    rdfs:comment 'Employee classification or categories eligible for the benefit plan such as full-time, part-time, temporary, or contract employees.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentEligibilityRules rdf:type rdf:Property ;
    rdfs:label 'Dependent Eligibility Rules' ;
    rdfs:comment 'Criteria defining which dependents are eligible for coverage under the benefit plan including age limits and relationship requirements.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Amount' ;
    rdfs:comment 'Maximum benefit amount or coverage limit provided by the plan such as life insurance face value or maximum annual benefit.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfPocketMaximum rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Maximum' ;
    rdfs:comment 'Maximum amount an employee will pay out-of-pocket for covered services during the plan year before the plan pays 100 percent.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percentage' ;
    rdfs:comment 'Percentage of covered service costs that the employee is responsible for paying after meeting the deductible.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Amount' ;
    rdfs:comment 'Fixed dollar amount that the employee pays for specific covered services such as office visits or prescriptions.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkType rdf:type rdf:Property ;
    rdfs:label 'Network Type' ;
    rdfs:comment 'Type of provider network structure for the benefit plan indicating how employees access care and provider reimbursement.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:summaryPlanDescriptionUrl rdf:type rdf:Property ;
    rdfs:label 'Summary Plan Description Url' ;
    rdfs:comment 'Web address where employees can access the Summary Plan Description document required by ERISA.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Plan Document Url' ;
    rdfs:comment 'Web address where the official plan document and legal agreement can be accessed.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erisaPlanIndicator rdf:type rdf:Property ;
    rdfs:label 'Erisa Plan Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan is subject to ERISA regulations and reporting requirements.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:erisaPlanNumber rdf:type rdf:Property ;
    rdfs:label 'Erisa Plan Number' ;
    rdfs:comment 'Three-digit plan number assigned for ERISA reporting purposes on Form 5500.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Cobra Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan is subject to COBRA continuation coverage requirements.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaCompliantIndicator rdf:type rdf:Property ;
    rdfs:label 'Aca Compliant Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan meets Affordable Care Act minimum essential coverage and affordability requirements.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hsaEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Hsa Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan qualifies as a high-deductible health plan eligible for Health Savings Account contributions.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fsaEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Fsa Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether employees enrolled in this plan can participate in a Flexible Spending Account.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preTaxIndicator rdf:type rdf:Property ;
    rdfs:label 'Pre Tax Indicator' ;
    rdfs:comment 'Flag indicating whether employee contributions to the benefit plan are deducted on a pre-tax basis under Section 125 cafeteria plan rules.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imputedIncomeIndicator rdf:type rdf:Property ;
    rdfs:label 'Imputed Income Indicator' ;
    rdfs:comment 'Flag indicating whether employer-paid premiums for this benefit plan result in imputed income to the employee for tax purposes.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retirementPlanType rdf:type rdf:Property ;
    rdfs:label 'Retirement Plan Type' ;
    rdfs:comment 'Specific type of retirement plan structure for retirement benefit plans.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingSchedule rdf:type rdf:Property ;
    rdfs:label 'Vesting Schedule' ;
    rdfs:comment 'Schedule defining when employees gain ownership of employer contributions to retirement or other benefit plans.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerMatchPercentage rdf:type rdf:Property ;
    rdfs:label 'Employer Match Percentage' ;
    rdfs:comment 'Percentage of employee retirement contributions that NCDOT will match for defined contribution plans.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerMatchLimit rdf:type rdf:Property ;
    rdfs:label 'Employer Match Limit' ;
    rdfs:comment 'Maximum dollar amount or percentage of salary that NCDOT will contribute as matching funds for retirement plans.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualContributionLimit rdf:type rdf:Property ;
    rdfs:label 'Annual Contribution Limit' ;
    rdfs:comment 'Maximum amount that can be contributed to the benefit plan per year as defined by IRS regulations or plan rules.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchUpContributionLimit rdf:type rdf:Property ;
    rdfs:label 'Catch Up Contribution Limit' ;
    rdfs:comment 'Additional contribution amount allowed for employees age 50 and older in retirement plans.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planSponsor rdf:type rdf:Property ;
    rdfs:label 'Plan Sponsor' ;
    rdfs:comment 'Legal entity sponsoring the benefit plan, typically NCDOT or the State of North Carolina.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planTrustee rdf:type rdf:Property ;
    rdfs:label 'Plan Trustee' ;
    rdfs:comment 'Individual or entity serving as trustee with fiduciary responsibility for plan assets.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentMethod rdf:type rdf:Property ;
    rdfs:label 'Enrollment Method' ;
    rdfs:comment 'Method by which employees can enroll in or make changes to the benefit plan.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Auto Enrollment Indicator' ;
    rdfs:comment 'Flag indicating whether eligible employees are automatically enrolled in the benefit plan unless they opt out.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defaultContributionRate rdf:type rdf:Property ;
    rdfs:label 'Default Contribution Rate' ;
    rdfs:comment 'Default percentage of salary contributed for employees who are automatically enrolled in the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualifyingLifeEventChangesAllowed rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Changes Allowed' ;
    rdfs:comment 'Flag indicating whether employees can make changes to the benefit plan outside of open enrollment due to qualifying life events.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planFundingSource rdf:type rdf:Property ;
    rdfs:label 'Plan Funding Source' ;
    rdfs:comment 'Method by which the benefit plan is funded indicating financial risk and administrative structure.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopLossCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the self-funded benefit plan has stop-loss insurance to limit financial exposure.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsAdministrator rdf:type rdf:Property ;
    rdfs:label 'Claims Administrator' ;
    rdfs:comment 'Name of the third-party administrator or entity responsible for processing benefit claims.' ;
    rdfs:domain ind:BenefitPlan ;
