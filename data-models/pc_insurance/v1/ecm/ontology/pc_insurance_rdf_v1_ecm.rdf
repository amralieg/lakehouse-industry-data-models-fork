    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:characteristicCategory rdf:type rdf:Property ;
    rdfs:label 'Characteristic Category' ;
    rdfs:comment 'High-level category grouping the characteristic (e.g., property, liability, auto, workers_comp, driver, equipment). [ENUM-REF-CANDIDATE: property|liability|auto|workers_comp|equipment|driver|occupancy|construction|protection|exposure — 10 candidates' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
