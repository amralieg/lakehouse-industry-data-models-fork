    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorContactName rdf:type rdf:Property ;
    rdfs:label 'Grantor Contact Name' ;
    rdfs:comment 'The name of the primary contact person at the grantor agency.' ;
