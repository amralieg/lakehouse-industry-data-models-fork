    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditedPayrollAmount rdf:type rdf:Property ;
    rdfs:label 'Audited Payroll Amount' ;
    rdfs:comment 'Actual payroll amount determined through premium audit after policy expiration, used for final premium adjustment.' ;
    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:classDescription rdf:type rdf:Property ;
    rdfs:label 'Class Description' ;
    rdfs:comment 'Full text description of the work activities and operations covered by this classification code.' ;
    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classStatus rdf:type rdf:Property ;
    rdfs:label 'Class Status' ;
    rdfs:comment 'Current status of this payroll classification on the policy, indicating whether it is actively rated or has been removed.' ;
    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAnnualPayroll rdf:type rdf:Property ;
