    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleIssueDate rdf:type rdf:Property ;
    rdfs:label 'Title Issue Date' ;
    rdfs:comment 'Date when the current North Carolina title was issued for this vehicle.' ;
