ind:partialDayStartTime rdf:type rdf:Property ;
    rdfs:label 'Partial Day Start Time' ;
    rdfs:comment 'Start time for partial day leave requests.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:partialDayEndTime rdf:type rdf:Property ;
    rdfs:label 'Partial Day End Time' ;
    rdfs:comment 'End time for partial day leave requests.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isIntermittent rdf:type rdf:Property ;
