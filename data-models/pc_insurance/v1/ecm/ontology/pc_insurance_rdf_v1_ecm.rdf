    rdfs:range xsd:date .

ind:autoLossCount rdf:type rdf:Property ;
    rdfs:label 'Auto Loss Count' ;
    rdfs:comment 'Number of auto-related losses reported in the CLUE report.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catastropheLossIndicator rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Loss Indicator' ;
    rdfs:comment 'Indicates whether any of the reported losses were catastrophe-related events.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clueScore rdf:type rdf:Property ;
    rdfs:label 'Clue Score' ;
    rdfs:comment 'Numeric risk score assigned by the CLUE system based on prior loss history.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clueScoreTier rdf:type rdf:Property ;
    rdfs:label 'Clue Score Tier' ;
    rdfs:comment 'Categorical tier classification of the CLUE score for underwriting decisioning.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lookbackPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Years' ;
    rdfs:comment 'Number of years of loss history included in the CLUE report.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orderDate rdf:type rdf:Property ;
    rdfs:label 'Order Date' ;
    rdfs:comment 'Date when the CLUE report was ordered from the provider.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorCarrierNaicCode rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Naic Code' ;
    rdfs:comment 'Five-digit NAIC code identifying the prior insurance carrier.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Effective Date' ;
    rdfs:comment 'Effective date of the most recent prior policy reported in the CLUE report.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorPolicyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Expiration Date' ;
    rdfs:comment 'Expiration date of the most recent prior policy reported in the CLUE report.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:propertyLossCount rdf:type rdf:Property ;
    rdfs:label 'Property Loss Count' ;
    rdfs:comment 'Number of property-related losses reported in the CLUE report.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerName rdf:type rdf:Property ;
    rdfs:label 'Provider Name' ;
    rdfs:comment 'Name of the CLUE report provider (typically ISO/Verisk or LexisNexis).' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Provider Transaction Code' ;
    rdfs:comment 'Unique transaction identifier assigned by the CLUE report provider.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportCostAmount rdf:type rdf:Property ;
    rdfs:label 'Report Cost Amount' ;
    rdfs:comment 'Cost charged by the provider for the CLUE report.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'Unique report number assigned by the CLUE database provider.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportStatus rdf:type rdf:Property ;
    rdfs:label 'Report Status' ;
    rdfs:comment 'Current status of the CLUE report in the underwriting workflow.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportType rdf:type rdf:Property ;
    rdfs:label 'Report Type' ;
    rdfs:comment 'Type of CLUE report indicating whether it covers property losses, auto losses, or both.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLossCount rdf:type rdf:Property ;
    rdfs:label 'Total Loss Count' ;
    rdfs:comment 'Total number of prior losses reported in the CLUE report.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:underwriterReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Underwriter Review Required' ;
    rdfs:comment 'Indicates whether the CLUE report findings require manual underwriter review.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uwDecision rdf:type rdf:Property ;
    rdfs:label 'Uw Decision' ;
    rdfs:comment 'Underwriting decision made based on the CLUE report findings.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Uw Decision Date' ;
    rdfs:comment 'Date when the underwriting decision was made based on the CLUE report.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uwDecisionReason rdf:type rdf:Property ;
    rdfs:label 'Uw Decision Reason' ;
    rdfs:comment 'Reason code or description for the underwriting decision based on CLUE findings.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Driver Assignment Id' ;
    rdfs:comment 'Unique identifier for the driver assignment record.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accidentCount3yr rdf:type rdf:Property ;
    rdfs:label 'Accident Count 3yr' ;
    rdfs:comment 'Number of at-fault accidents reported for this driver in the past three years, impacts rating tier.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualMileage rdf:type rdf:Property ;
    rdfs:label 'Annual Mileage' ;
    rdfs:comment 'Estimated annual miles driven by this driver in this vehicle, used for exposure rating.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessUseIndicator rdf:type rdf:Property ;
    rdfs:label 'Business Use Indicator' ;
    rdfs:comment 'Flag indicating whether the driver uses this vehicle for business purposes, affecting coverage and rating.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commuteDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Commute Distance Miles' ;
    rdfs:comment 'One-way commute distance in miles for this driver using this vehicle, impacts rating and classification.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commuteFrequency rdf:type rdf:Property ;
    rdfs:label 'Commute Frequency' ;
    rdfs:comment 'How often the driver uses this vehicle for commuting purposes.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverDesignation rdf:type rdf:Property ;
