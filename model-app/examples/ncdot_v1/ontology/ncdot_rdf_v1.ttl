ind:stepCount rdf:type rdf:Property ;
    rdfs:label 'Step Count' ;
    rdfs:comment 'Number of incremental pay steps within this salary grade. Used for progression-based compensation structures.' ;
    rdfs:domain ind:SalaryGrade ;
