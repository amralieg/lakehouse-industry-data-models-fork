ind:exposureDescription rdf:type rdf:Property ;
    rdfs:label 'Exposure Description' ;
    rdfs:comment 'Description of external exposures that may increase risk. Part of COPE attributes. Examples: proximity to brush, adjacent buildings, hazardous operations nearby.' ;
