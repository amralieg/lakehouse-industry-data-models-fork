ind:gradeLevel rdf:type rdf:Property ;
    rdfs:label 'Grade Level' ;
    rdfs:comment 'Numeric level of the grade within the organizational hierarchy. Used for sorting and comparison purposes.' ;
    rdfs:domain ind:SalaryGrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jobFamily rdf:type rdf:Property ;
    rdfs:label 'Job Family' ;
    rdfs:comment 'Broad occupational category or job family to which this grade applies (e.g., \'Engineering\', \'Administrative\', \'Transportation Operations\').' ;
    rdfs:domain ind:SalaryGrade ;
