{
    "compilerOptions": {
      "incremental": true,
      "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
      "target": "ESNext",
      "useDefineForClassFields": true,
      "lib": ["ESNext", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "skipLibCheck": true,
      // Node types for the build/read-the-source test files (node:fs, __dirname).
      "types": ["node"],
  
      /* Bundler mode */
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      // a lot of components use type imports without using the `verbatimModuleSyntax` flag,
      // so we need to disable it to allow for type imports
      "verbatimModuleSyntax": false,
      "moduleDetection": "force",
      "noEmit": true,
      "jsx": "react-jsx",
  
      /* Linting */
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true,
      "noUncheckedSideEffectImports": true,
  
      // Under moduleResolution "bundler", `paths` resolves relative to this
      // tsconfig's directory, so the deprecated `baseUrl` (a hard error in
      // TS 5.9, TS5101) is not needed for the `@/*` alias.
      "paths": {
        "@/*": ["./src/vibe_modeling/ui/*"]
      }
    },
    "include": ["src/vibe_modeling/ui", "vite.config.ts", ".apx", "src/vibe_modeling/ui/types/vite-env.d.ts"]
  }