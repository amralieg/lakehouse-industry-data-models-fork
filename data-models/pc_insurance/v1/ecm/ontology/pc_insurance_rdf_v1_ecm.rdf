    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'Date when the survey was finalized and all findings documented.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:copeConstruction rdf:type rdf:Property ;
    rdfs:label 'Cope Construction' ;
    rdfs:comment 'Construction type observed during survey, part of COPE assessment: frame, joisted masonry, non-combustible, masonry non-combustible, modified fire resistive, or fire resistive.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copeExposure rdf:type rdf:Property ;
    rdfs:label 'Cope Exposure' ;
    rdfs:comment 'External exposure factors observed during survey, part of COPE assessment: proximity to other buildings, wildfire risk, flood risk, earthquake risk.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copeOccupancy rdf:type rdf:Property ;
    rdfs:label 'Cope Occupancy' ;
    rdfs:comment 'Occupancy type observed during survey, part of COPE assessment, describing how the building is used.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copeProtection rdf:type rdf:Property ;
    rdfs:label 'Cope Protection' ;
    rdfs:comment 'Fire protection features observed during survey, part of COPE assessment: sprinklers, alarms, fire department proximity, water supply adequacy.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationMinutes rdf:type rdf:Property ;
    rdfs:label 'Duration Minutes' ;
    rdfs:comment 'Total time spent conducting the survey, measured in minutes.' ;
