ind:performingOrganization rdf:type rdf:Property ;
    rdfs:label 'Performing Organization' ;
    rdfs:comment 'Name of the organizational unit or contractor responsible for performing the maintenance work.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
