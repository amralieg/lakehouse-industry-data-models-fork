ind:adaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Flag' ;
    rdfs:comment 'Indicates whether the scheduled service meets ADA (Americans with Disabilities Act) compliance requirements.' ;
    rdfs:domain ind:Ncdot ;
