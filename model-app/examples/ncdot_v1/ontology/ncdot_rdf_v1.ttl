    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabilityPlacardNumber rdf:type rdf:Property ;
    rdfs:label 'Disability Placard Number' ;
    rdfs:comment 'The number of the disability parking placard issued, if applicable.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityPlacardExpirationDate rdf:type rdf:Property ;
