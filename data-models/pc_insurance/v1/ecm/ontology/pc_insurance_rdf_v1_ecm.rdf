ind:primaryReasonCode rdf:type rdf:Property ;
    rdfs:label 'Primary Reason Code' ;
    rdfs:comment 'Primary reason code explaining the underwriting decision, aligned with regulatory and internal classification standards.' ;
    rdfs:domain ind:UwDecision ;
