    rdfs:comment 'Reference identifier to the photographic documentation of the scheduled item stored in the document management system (e.g., OpenText, FileNet) for claims and underwriting.' ;
    rdfs:domain ind:ScheduledItem ;
    rdf:type owl:ObjectProperty ;
