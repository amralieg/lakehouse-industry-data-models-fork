    rdfs:range xsd:boolean .

ind:percentileRank rdf:type rdf:Property ;
    rdfs:label 'Percentile Rank' ;
    rdfs:comment 'The percentile rank of this return period in the loss distribution (e.g., 99th percentile for a 100-year return period).' ;
    rdfs:domain ind:PmlReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmlReturnPeriodStatus rdf:type rdf:Property ;
