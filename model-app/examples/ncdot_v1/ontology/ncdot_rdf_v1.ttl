    rdfs:comment 'The percentage of the asset cost funded by federal sources (FHWA, FTA, FAA, FRA), relevant for grant compliance and reporting.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
