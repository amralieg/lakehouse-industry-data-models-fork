    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:declinationReason rdf:type rdf:Property ;
    rdfs:label 'Declination Reason' ;
    rdfs:comment 'Detailed reason for declining the submission, required for regulatory compliance and adverse action notices.' ;
    rdfs:domain ind:UwDecision ;
