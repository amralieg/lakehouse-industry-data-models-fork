    rdfs:comment 'Current lifecycle status of the survey: scheduled, in progress, completed, cancelled, pending review, or approved.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyTime rdf:type rdf:Property ;
