    rdfs:range xsd:string .

ind:milestoneId rdf:type rdf:Property ;
    rdfs:label 'Milestone Id' ;
    rdfs:comment 'Unique identifier for the project milestone record. Primary key for the project milestone reference table.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Milestone .

ind:projectPhase rdf:type rdf:Property ;
    rdfs:label 'Project Phase' ;
    rdfs:comment 'The primary project phase during which this milestone typically occurs, aligned with NCDOT project delivery methodology.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCriticalPath rdf:type rdf:Property ;
    rdfs:label 'Is Critical Path' ;
    rdfs:comment 'Indicates whether this milestone type is typically on the critical path for project delivery. True if delays to this milestone directly impact project completion date.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Indicates whether this milestone is required for all projects or only applicable to specific project types. True if mandatory for all projects.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportableToFhwa rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To Fhwa' ;
    rdfs:comment 'Indicates whether this milestone must be reported to FHWA for federally-funded projects. True if FHWA reporting is required.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStipMilestone rdf:type rdf:Property ;
    rdfs:label 'Is Stip Milestone' ;
    rdfs:comment 'Indicates whether this milestone is tracked and reported in the State Transportation Improvement Program. True if included in STIP reporting.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'The organizational role or external agency responsible for approving this milestone, if approval is required.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalDurationDays rdf:type rdf:Property ;
    rdfs:label 'Typical Duration Days' ;
    rdfs:comment 'The typical or average number of days required to complete this milestone, used for project scheduling and planning purposes.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sequenceOrder rdf:type rdf:Property ;
    rdfs:label 'Sequence Order' ;
    rdfs:comment 'Numeric value indicating the typical sequential order of this milestone within the project lifecycle. Lower numbers occur earlier in the project.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:predecessorMilestoneCodes rdf:type rdf:Property ;
    rdfs:label 'Predecessor Milestone Codes' ;
    rdfs:comment 'Comma-separated list of milestone codes that typically must be completed before this milestone can begin. Used for dependency tracking.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableProjectTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Project Types' ;
    rdfs:comment 'Comma-separated list of project types for which this milestone is applicable (e.g., Highway, Bridge, Safety, Maintenance, Ferry, Rail, Aviation).' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableFundingSources rdf:type rdf:Property ;
    rdfs:label 'Applicable Funding Sources' ;
    rdfs:comment 'Comma-separated list of funding sources that require tracking of this milestone (e.g., Federal, State, GARVEE, BUILD, INFRA, RAISE).' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Required' ;
    rdfs:comment 'Indicates whether this milestone involves environmental compliance activities or documentation under NEPA or state environmental regulations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nepaClassOfAction rdf:type rdf:Property ;
    rdfs:label 'Nepa Class Of Action' ;
    rdfs:comment 'The NEPA classification associated with this milestone if environmental compliance is required: CE (Categorical Exclusion), EA (Environmental Assessment), EIS (Environmental Impact Statement).' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresPublicInvolvement rdf:type rdf:Property ;
    rdfs:label 'Requires Public Involvement' ;
    rdfs:comment 'Indicates whether this milestone requires public involvement activities such as public hearings, comment periods, or stakeholder meetings.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliverableType rdf:type rdf:Property ;
    rdfs:label 'Deliverable Type' ;
    rdfs:comment 'The type of deliverable or documentation typically produced or received at this milestone, if applicable.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentRepository rdf:type rdf:Property ;
    rdfs:label 'Document Repository' ;
    rdfs:comment 'The primary system or repository where documentation related to this milestone is stored and managed.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapPsMilestoneCode rdf:type rdf:Property ;
    rdfs:label 'Sap Ps Milestone Code' ;
    rdfs:comment 'The corresponding milestone code in SAP PS (Project System) module, used for integration and synchronization with the enterprise project management system.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hicamsMilestoneCode rdf:type rdf:Property ;
    rdfs:label 'Hicams Milestone Code' ;
    rdfs:comment 'The corresponding milestone code in HiCAMS, used for construction project tracking and materials management integration.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Flag' ;
    rdfs:comment 'Indicates whether completion of this milestone triggers financial transactions, budget releases, or payment authorizations. True if financial impact exists.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersPayment rdf:type rdf:Property ;
    rdfs:label 'Triggers Payment' ;
    rdfs:comment 'Indicates whether this milestone serves as a payment trigger for contractors or consultants. True if milestone completion authorizes payment.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceMetricTracked rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Tracked' ;
    rdfs:comment 'Indicates whether this milestone is tracked as a key performance indicator (KPI) for organizational performance measurement and reporting.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Level' ;
    rdfs:comment 'The typical risk level associated with this milestone type, indicating the potential impact of delays or issues on project success.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequired rdf:type rdf:Property ;
    rdfs:label 'Notification Required' ;
    rdfs:comment 'Indicates whether automated notifications should be sent to stakeholders when this milestone is achieved or at risk. True if notifications are configured.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAgency rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency' ;
    rdfs:comment 'The primary regulatory agency involved in oversight or approval of this milestone, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRequirement rdf:type rdf:Property ;
    rdfs:label 'Compliance Requirement' ;
    rdfs:comment 'Specific regulatory or policy compliance requirements that must be met for this milestone, including citations to relevant statutes or regulations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityAssuranceRequired rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Required' ;
    rdfs:comment 'Indicates whether formal quality assurance review or inspection is required before this milestone can be marked complete. True if QA review is mandatory.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionType rdf:type rdf:Property ;
    rdfs:label 'Inspection Type' ;
    rdfs:comment 'The type of inspection required at this milestone, if applicable, aligned with NCDOT inspection protocols and standards.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Version number of this milestone definition, used to track changes and updates to milestone specifications over time.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternatePhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Alternate Phone Number' ;
    rdfs:comment 'Secondary contact phone number for the passenger.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter state or province code for the passenger address (e.g., NC for North Carolina).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the passenger address (e.g., USA).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Date' ;
    rdfs:comment 'The date when the passenger first registered with the NCDOT ferry system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastTravelDate rdf:type rdf:Property ;
    rdfs:label 'Last Travel Date' ;
    rdfs:comment 'The most recent date the passenger traveled on an NCDOT ferry.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:frequentTravelerFlag rdf:type rdf:Property ;
    rdfs:label 'Frequent Traveler Flag' ;
    rdfs:comment 'Indicates whether the passenger is enrolled in the frequent traveler program for regular ferry users.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequentTravelerNumber rdf:type rdf:Property ;
    rdfs:label 'Frequent Traveler Number' ;
    rdfs:comment 'Unique identifier assigned to passengers enrolled in the frequent traveler program.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncResidentFlag rdf:type rdf:Property ;
    rdfs:label 'Nc Resident Flag' ;
    rdfs:comment 'Indicates whether the passenger is a North Carolina resident, which may affect fare eligibility and discounts.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seniorCitizenFlag rdf:type rdf:Property ;
    rdfs:label 'Senior Citizen Flag' ;
    rdfs:comment 'Indicates whether the passenger qualifies for senior citizen discounts based on age criteria.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Disability Flag' ;
    rdfs:comment 'Indicates whether the passenger has a documented disability requiring special accommodations or qualifying for ADA-related discounts.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabilityType rdf:type rdf:Property ;
    rdfs:label 'Disability Type' ;
    rdfs:comment 'Classification of the passenger disability type to ensure appropriate accommodations are provided.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veteranFlag rdf:type rdf:Property ;
    rdfs:label 'Veteran Flag' ;
    rdfs:comment 'Indicates whether the passenger is a military veteran, which may qualify them for special discounts or priority boarding.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:militaryActiveDutyFlag rdf:type rdf:Property ;
    rdfs:label 'Military Active Duty Flag' ;
    rdfs:comment 'Indicates whether the passenger is currently serving on active duty in the military.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studentFlag rdf:type rdf:Property ;
    rdfs:label 'Student Flag' ;
    rdfs:comment 'Indicates whether the passenger is a student eligible for student discounts on ferry fares.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyContactRelationship rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Relationship' ;
    rdfs:comment 'Relationship of the emergency contact to the passenger.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibilityNeeds rdf:type rdf:Property ;
    rdfs:label 'Accessibility Needs' ;
    rdfs:comment 'Free-text description of specific accessibility accommodations required by the passenger during ferry travel.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Alert Flag' ;
    rdfs:comment 'Indicates whether the passenger has medical conditions that ferry staff should be aware of for safety purposes.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalAlertNotes rdf:type rdf:Property ;
    rdfs:label 'Medical Alert Notes' ;
    rdfs:comment 'Confidential notes regarding passenger medical conditions or allergies relevant to ferry operations and emergency response.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoIdType rdf:type rdf:Property ;
    rdfs:label 'Photo Id Type' ;
    rdfs:comment 'Type of government-issued photo identification provided by the passenger for verification purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoIdNumber rdf:type rdf:Property ;
    rdfs:label 'Photo Id Number' ;
    rdfs:comment 'The identification number from the passenger government-issued photo ID.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoIdIssuingState rdf:type rdf:Property ;
    rdfs:label 'Photo Id Issuing State' ;
    rdfs:comment 'Two-letter state code of the jurisdiction that issued the passenger photo identification.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoIdExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Photo Id Expiration Date' ;
    rdfs:comment 'Expiration date of the passenger government-issued photo identification.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cdlHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Cdl Holder Flag' ;
    rdfs:comment 'Indicates whether the passenger holds a valid Commercial Driver License, relevant for commercial vehicle transport on ferries.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentMethodPreference rdf:type rdf:Property ;
    rdfs:label 'Payment Method Preference' ;
    rdfs:comment 'The passenger preferred method of payment for ferry fares and services.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'The passenger preferred channel for receiving service notifications, schedule changes, and alerts.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In Flag' ;
    rdfs:comment 'Indicates whether the passenger has consented to receive marketing communications and promotional materials from NCDOT Ferry Division.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privacyConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Privacy Consent Flag' ;
    rdfs:comment 'Indicates whether the passenger has provided consent for data collection and processing in accordance with privacy regulations.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privacyConsentDate rdf:type rdf:Property ;
    rdfs:label 'Privacy Consent Date' ;
    rdfs:comment 'The date when the passenger provided privacy consent.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountNotes rdf:type rdf:Property ;
    rdfs:label 'Account Notes' ;
    rdfs:comment 'Internal notes regarding the passenger account, service history, or special circumstances.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipFlag rdf:type rdf:Property ;
    rdfs:label 'Vip Flag' ;
    rdfs:comment 'Indicates whether the passenger is designated as a VIP requiring special handling or priority service.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bannedFlag rdf:type rdf:Property ;
    rdfs:label 'Banned Flag' ;
    rdfs:comment 'Indicates whether the passenger has been banned from using ferry services due to policy violations or safety concerns.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bannedReason rdf:type rdf:Property ;
    rdfs:label 'Banned Reason' ;
    rdfs:comment 'Description of the reason why the passenger was banned from ferry services.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bannedStartDate rdf:type rdf:Property ;
    rdfs:label 'Banned Start Date' ;
    rdfs:comment 'The date when the passenger ban became effective.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bannedEndDate rdf:type rdf:Property ;
    rdfs:label 'Banned End Date' ;
    rdfs:comment 'The date when the passenger ban expires, if applicable. Null indicates permanent ban.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loyaltyPointsBalance rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Balance' ;
    rdfs:comment 'Current balance of loyalty points accumulated by the passenger through the frequent traveler program.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalTripsCount rdf:type rdf:Property ;
    rdfs:label 'Total Trips Count' ;
    rdfs:comment 'Total number of ferry trips taken by the passenger since registration.' ;
    rdfs:domain ind:Passenger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licenseClassCode rdf:type rdf:Property ;
    rdfs:label 'License Class Code' ;
    rdfs:comment 'Standard classification code for the driver license type (e.g., A, B, C for commercial classes, or C for regular operator license). Aligns with federal CDL classifications.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseClassName rdf:type rdf:Property ;
    rdfs:label 'License Class Name' ;
    rdfs:comment 'Full descriptive name of the license class (e.g., Class A Commercial Driver License, Class C Operator License).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseCategory rdf:type rdf:Property ;
    rdfs:label 'License Category' ;
    rdfs:comment 'High-level category grouping for the license type, distinguishing between commercial, non-commercial, motorcycle, learner permits, provisional, and restricted licenses.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumAgeYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Age Years' ;
    rdfs:comment 'Minimum age in years required for an applicant to be eligible for this license type. Varies by license class and endorsements.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumAgeYears rdf:type rdf:Property ;
    rdfs:label 'Maximum Age Years' ;
    rdfs:comment 'Maximum age in years for eligibility or special requirements for this license type. Typically null unless age-based restrictions apply.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleWeightClassMinLbs rdf:type rdf:Property ;
    rdfs:label 'Vehicle Weight Class Min Lbs' ;
    rdfs:comment 'Minimum gross vehicle weight rating (GVWR) or gross combination weight rating (GCWR) in pounds that this license class authorizes the holder to operate.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleWeightClassMaxLbs rdf:type rdf:Property ;
    rdfs:label 'Vehicle Weight Class Max Lbs' ;
    rdfs:comment 'Maximum gross vehicle weight rating (GVWR) or gross combination weight rating (GCWR) in pounds that this license class authorizes the holder to operate.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passengerCapacityMin rdf:type rdf:Property ;
    rdfs:label 'Passenger Capacity Min' ;
    rdfs:comment 'Minimum number of passengers (including driver) that vehicles authorized under this license type may carry. Relevant for passenger endorsements.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passengerCapacityMax rdf:type rdf:Property ;
    rdfs:label 'Passenger Capacity Max' ;
    rdfs:comment 'Maximum number of passengers (including driver) that vehicles authorized under this license type may carry. Relevant for passenger endorsements.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizedVehicleTypes rdf:type rdf:Property ;
    rdfs:label 'Authorized Vehicle Types' ;
    rdfs:comment 'Comma-separated list or description of vehicle types that the license holder is authorized to operate (e.g., combination vehicles, single vehicles, motorcycles, passenger vehicles).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresEndorsement rdf:type rdf:Property ;
    rdfs:label 'Requires Endorsement' ;
    rdfs:comment 'Boolean flag indicating whether this license type requires additional endorsements for specific vehicle types or cargo (e.g., hazmat, tanker, passenger, school bus).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibleEndorsements rdf:type rdf:Property ;
    rdfs:label 'Eligible Endorsements' ;
    rdfs:comment 'Comma-separated list of endorsement codes that can be added to this license type (e.g., H for Hazmat, N for Tank Vehicle, P for Passenger, S for School Bus, T for Double/Triple Trailers).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresMedicalCertification rdf:type rdf:Property ;
    rdfs:label 'Requires Medical Certification' ;
    rdfs:comment 'Boolean flag indicating whether this license type requires a valid medical examiner\'s certificate (typically required for CDL holders).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalCertificationClass rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Class' ;
    rdfs:comment 'Classification of medical certification required for CDL holders, distinguishing between interstate/intrastate and excepted/non-excepted operations.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:knowledgeTestRequired rdf:type rdf:Property ;
    rdfs:label 'Knowledge Test Required' ;
    rdfs:comment 'Boolean flag indicating whether a written knowledge test is required to obtain this license type.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:skillsTestRequired rdf:type rdf:Property ;
    rdfs:label 'Skills Test Required' ;
    rdfs:comment 'Boolean flag indicating whether a practical driving skills test is required to obtain this license type.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visionTestRequired rdf:type rdf:Property ;
    rdfs:label 'Vision Test Required' ;
    rdfs:comment 'Boolean flag indicating whether a vision screening test is required to obtain or renew this license type.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumVisionAcuity rdf:type rdf:Property ;
    rdfs:label 'Minimum Vision Acuity' ;
    rdfs:comment 'Minimum visual acuity standard required for this license type (e.g., 20/40 in each eye, 20/70 in one eye with restrictions).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Training Hours Required' ;
    rdfs:comment 'Minimum number of training hours required before an applicant can test for this license type. Particularly relevant for CDL and learner permits.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supervisedDrivingHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Supervised Driving Hours Required' ;
    rdfs:comment 'Minimum number of supervised driving hours required for provisional or learner permit holders before advancing to this license type.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validityPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Validity Period Years' ;
    rdfs:comment 'Standard validity period in years for this license type before renewal is required. Typically ranges from 5 to 8 years for standard licenses.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalGracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Grace Period Days' ;
    rdfs:comment 'Number of days after expiration during which the license can be renewed without additional testing or penalties.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Application Fee Amount' ;
    rdfs:comment 'Standard fee amount in US dollars charged for initial application for this license type.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Renewal Fee Amount' ;
    rdfs:comment 'Standard fee amount in US dollars charged for renewal of this license type.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duplicateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Duplicate Fee Amount' ;
    rdfs:comment 'Fee amount in US dollars charged for issuing a duplicate license due to loss, theft, or damage.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:restrictionCodesAllowed rdf:type rdf:Property ;
    rdfs:label 'Restriction Codes Allowed' ;
    rdfs:comment 'Comma-separated list of restriction codes that may be applied to this license type (e.g., corrective lenses, daylight only, automatic transmission, hearing aid).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reciprocityEligible rdf:type rdf:Property ;
    rdfs:label 'Reciprocity Eligible' ;
    rdfs:comment 'Boolean flag indicating whether this license type is eligible for reciprocity agreements with other states or jurisdictions.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatEndorsementEligible rdf:type rdf:Property ;
    rdfs:label 'Hazmat Endorsement Eligible' ;
    rdfs:comment 'Boolean flag indicating whether this license type is eligible for a hazardous materials (HAZMAT) endorsement, requiring TSA background check.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tsaBackgroundCheckRequired rdf:type rdf:Property ;
    rdfs:label 'Tsa Background Check Required' ;
    rdfs:comment 'Boolean flag indicating whether a TSA security threat assessment is required for this license type (typically for HAZMAT endorsements).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfStateTransferEligible rdf:type rdf:Property ;
    rdfs:label 'Out Of State Transfer Eligible' ;
    rdfs:comment 'Boolean flag indicating whether holders of equivalent out-of-state licenses can transfer to this license type without retesting.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:militaryWaiverEligible rdf:type rdf:Property ;
    rdfs:label 'Military Waiver Eligible' ;
    rdfs:comment 'Boolean flag indicating whether military personnel with equivalent military vehicle operation experience may receive waivers for certain testing requirements.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalStandardCode rdf:type rdf:Property ;
    rdfs:label 'Federal Standard Code' ;
    rdfs:comment 'Federal classification code for this license type as defined by FHWA or other federal transportation authorities for interstate reporting.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecificCode rdf:type rdf:Property ;
    rdfs:label 'State Specific Code' ;
    rdfs:comment 'North Carolina-specific classification code for this license type used in internal DMV systems and state reporting.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aamvaCode rdf:type rdf:Property ;
    rdfs:label 'Aamva Code' ;
    rdfs:comment 'Standardized license type code as defined by AAMVA for interstate data exchange and reciprocity purposes.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria' ;
    rdfs:comment 'Comprehensive description of eligibility requirements for obtaining this license type, including age, residency, training, and testing requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disqualifyingOffenses rdf:type rdf:Property ;
    rdfs:label 'Disqualifying Offenses' ;
    rdfs:comment 'Description of criminal offenses or traffic violations that disqualify an applicant from obtaining or maintaining this license type.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalRequirements rdf:type rdf:Property ;
    rdfs:label 'Renewal Requirements' ;
    rdfs:comment 'Description of requirements for renewing this license type, including any retesting, medical certification updates, or documentation needed.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upgradePath rdf:type rdf:Property ;
    rdfs:label 'Upgrade Path' ;
    rdfs:comment 'Description of the progression path from this license type to higher classes or endorsements, including prerequisites and testing requirements.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downgradePath rdf:type rdf:Property ;
    rdfs:label 'Downgrade Path' ;
    rdfs:comment 'Description of circumstances and procedures for downgrading from this license type to a lower class, typically due to medical conditions or voluntary surrender of privileges.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceRequirements rdf:type rdf:Property ;
    rdfs:label 'Insurance Requirements' ;
    rdfs:comment 'Description of minimum insurance coverage requirements for holders of this license type, particularly relevant for commercial licenses.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isProvisional rdf:type rdf:Property ;
    rdfs:label 'Is Provisional' ;
    rdfs:comment 'Boolean flag indicating whether this is a provisional license type with graduated licensing restrictions for new drivers.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:provisionalRestrictions rdf:type rdf:Property ;
    rdfs:label 'Provisional Restrictions' ;
    rdfs:comment 'Description of restrictions applicable to provisional license holders, such as passenger limitations, nighttime driving restrictions, and supervision requirements.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalDrivingPermitEligible rdf:type rdf:Property ;
    rdfs:label 'International Driving Permit Eligible' ;
    rdfs:comment 'Boolean flag indicating whether holders of this license type are eligible to obtain an International Driving Permit for driving abroad.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sadlsSystemCode rdf:type rdf:Property ;
    rdfs:label 'Sadls System Code' ;
    rdfs:comment 'Internal system code used in the State Automated Driver License System (SADLS) to identify this license type in the legacy mainframe database.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Updated Date' ;
    rdfs:comment 'Date when this license type reference record was last modified in the system, used for change tracking and audit purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceId rdf:type rdf:Property ;
    rdfs:label 'Resource Id' ;
    rdfs:comment 'Unique identifier for the project resource assignment record.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employeeName rdf:type rdf:Property ;
    rdfs:label 'Employee Name' ;
    rdfs:comment 'Full name of the employee assigned to the project work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialNumber rdf:type rdf:Property ;
    rdfs:label 'Material Number' ;
    rdfs:comment 'Standard material number from the materials management system for material resources.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialDescription rdf:type rdf:Property ;
    rdfs:label 'Material Description' ;
    rdfs:comment 'Detailed description of the material being assigned to the project work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'Unique identifier for the vendor or subcontractor providing the resource.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'Name of the vendor or subcontractor providing resources to the project.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Start Date' ;
    rdfs:comment 'The date when the resource assignment begins for the work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Assignment End Date' ;
    rdfs:comment 'The date when the resource assignment is scheduled to end for the work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedStartDate rdf:type rdf:Property ;
    rdfs:label 'Planned Start Date' ;
    rdfs:comment 'The originally planned start date for the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedEndDate rdf:type rdf:Property ;
    rdfs:label 'Planned End Date' ;
    rdfs:comment 'The originally planned end date for the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualStartDate rdf:type rdf:Property ;
    rdfs:label 'Actual Start Date' ;
    rdfs:comment 'The actual date when the resource assignment commenced.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualEndDate rdf:type rdf:Property ;
    rdfs:label 'Actual End Date' ;
    rdfs:comment 'The actual date when the resource assignment was completed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedQuantity rdf:type rdf:Property ;
    rdfs:label 'Planned Quantity' ;
    rdfs:comment 'The planned quantity of the resource to be utilized for the work package.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualQuantity rdf:type rdf:Property ;
    rdfs:label 'Actual Quantity' ;
    rdfs:comment 'The actual quantity of the resource utilized for the work package.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'The unit of measure for the resource quantity (e.g., hours, days, tons, cubic yards, each).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedHours rdf:type rdf:Property ;
    rdfs:label 'Planned Hours' ;
    rdfs:comment 'The planned number of hours for labor resources assigned to the work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualHours rdf:type rdf:Property ;
    rdfs:label 'Actual Hours' ;
    rdfs:comment 'The actual number of hours worked by labor resources on the work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizationRate rdf:type rdf:Property ;
    rdfs:label 'Utilization Rate' ;
    rdfs:comment 'The percentage rate at which the resource is utilized or allocated to the work package (0-100).' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'The percentage of the resource\'s total capacity allocated to this specific work package (0-100).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plannedCost rdf:type rdf:Property ;
    rdfs:label 'Planned Cost' ;
    rdfs:comment 'The planned cost for the resource assignment to the work package.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualCost rdf:type rdf:Property ;
    rdfs:label 'Actual Cost' ;
    rdfs:comment 'The actual cost incurred for the resource assignment to the work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costVariance rdf:type rdf:Property ;
    rdfs:label 'Cost Variance' ;
    rdfs:comment 'The variance between planned and actual costs for the resource assignment (actual minus planned).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitRate rdf:type rdf:Property ;
    rdfs:label 'Unit Rate' ;
    rdfs:comment 'The cost rate per unit of measure for the resource (e.g., hourly rate, daily rate, per ton rate).' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current status of the resource assignment to the work package.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Approval status of the resource assignment by project management or authorized personnel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the person who approved the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:skillLevel rdf:type rdf:Property ;
    rdfs:label 'Skill Level' ;
    rdfs:comment 'Required or actual skill level of the labor resource for the assignment.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationRequired rdf:type rdf:Property ;
    rdfs:label 'Certification Required' ;
    rdfs:comment 'Indicates whether specific certifications are required for the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationType rdf:type rdf:Property ;
    rdfs:label 'Certification Type' ;
    rdfs:comment 'Type of certification required for the resource (e.g., CDL, welding certification, engineering license).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workLocation rdf:type rdf:Property ;
    rdfs:label 'Work Location' ;
    rdfs:comment 'Physical location or site where the resource will perform work for the assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:division rdf:type rdf:Property ;
    rdfs:label 'Division' ;
    rdfs:comment 'NCDOT division responsible for the project and resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Cost center code to which the resource costs are charged.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalFundingProgram rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Program' ;
    rdfs:comment 'Specific federal funding program supporting the resource assignment (e.g., HSIP, CMAQ, STP, BUILD, INFRA).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantNumber rdf:type rdf:Property ;
    rdfs:label 'Grant Number' ;
    rdfs:comment 'Grant or award number associated with the funding for the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Number' ;
    rdfs:comment 'Contract number under which the resource is being provided (for subcontractors and consultants).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Number' ;
    rdfs:comment 'Purchase order number for material or equipment resources.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requisitionNumber rdf:type rdf:Property ;
    rdfs:label 'Requisition Number' ;
    rdfs:comment 'Requisition number for the resource request.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingType rdf:type rdf:Property ;
    rdfs:label 'Billing Type' ;
    rdfs:comment 'Method by which the resource costs are billed or calculated.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overtimeEligible rdf:type rdf:Property ;
    rdfs:label 'Overtime Eligible' ;
    rdfs:comment 'Indicates whether the labor resource is eligible for overtime compensation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimeHours rdf:type rdf:Property ;
    rdfs:label 'Overtime Hours' ;
    rdfs:comment 'Number of overtime hours worked by the labor resource on the assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftType rdf:type rdf:Property ;
    rdfs:label 'Shift Type' ;
    rdfs:comment 'Type of work shift for the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Availability Status' ;
    rdfs:comment 'Current availability status of the resource for the assignment period.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictFlag rdf:type rdf:Property ;
    rdfs:label 'Conflict Flag' ;
    rdfs:comment 'Indicates whether the resource has scheduling conflicts with other assignments.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialRequirements rdf:type rdf:Property ;
    rdfs:label 'Special Requirements' ;
    rdfs:comment 'Any special requirements, conditions, or constraints for the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyTrainingRequired rdf:type rdf:Property ;
    rdfs:label 'Safety Training Required' ;
    rdfs:comment 'Indicates whether specific safety training is required for the resource assignment.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Safety Training Date' ;
    rdfs:comment 'Date when required safety training was completed by the resource.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:equipmentCondition rdf:type rdf:Property ;
    rdfs:label 'Equipment Condition' ;
    rdfs:comment 'Current condition status of equipment resources at the time of assignment.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceStatus rdf:type rdf:Property ;
    rdfs:label 'Maintenance Status' ;
    rdfs:comment 'Maintenance status of equipment resources relative to scheduled maintenance requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Last Maintenance Date' ;
    rdfs:comment 'Date of the most recent maintenance performed on equipment resources.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dbeParticipation rdf:type rdf:Property ;
    rdfs:label 'Dbe Participation' ;
    rdfs:comment 'Indicates whether the resource is provided by a DBE certified vendor or subcontractor.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hubCertified rdf:type rdf:Property ;
    rdfs:label 'Hub Certified' ;
    rdfs:comment 'Indicates whether the vendor providing the resource is HUB certified.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prevailingWageApplicable rdf:type rdf:Property ;
    rdfs:label 'Prevailing Wage Applicable' ;
    rdfs:comment 'Indicates whether prevailing wage requirements apply to the labor resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prevailingWageRate rdf:type rdf:Property ;
    rdfs:label 'Prevailing Wage Rate' ;
    rdfs:comment 'The applicable prevailing wage rate for the labor resource classification.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionAffiliation rdf:type rdf:Property ;
    rdfs:label 'Union Affiliation' ;
    rdfs:comment 'Union affiliation of the labor resource, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitNumber rdf:type rdf:Property ;
    rdfs:label 'Permit Number' ;
    rdfs:comment 'Environmental or regulatory permit number associated with the resource assignment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentCreatedDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Created Date' ;
    rdfs:comment 'Date when the resource assignment record was created in the system.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentModifiedDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Modified Date' ;
    rdfs:comment 'Date when the resource assignment record was last modified.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedBy rdf:type rdf:Property ;
    rdfs:label 'Requested By' ;
    rdfs:comment 'Name or identifier of the person who requested the resource assignment.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedBy rdf:type rdf:Property ;
    rdfs:label 'Assigned By' ;
    rdfs:comment 'Name or identifier of the person who made the resource assignment.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFiscalYear rdf:type rdf:Property ;
    rdfs:label 'State Fiscal Year' ;
    rdfs:comment 'State fiscal year in which the resource assignment costs are budgeted or incurred.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleId rdf:type rdf:Property ;
    rdfs:label 'Schedule Id' ;
    rdfs:comment 'Unique identifier for the project schedule entry. Primary key for the project schedule transactional record.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Schedule .

ind:projectId rdf:type rdf:Property ;
    rdfs:label 'Project Id' ;
    rdfs:comment 'Unique identifier for the parent transportation project. Links schedule entry to the project in SAP PS or HiCAMS.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Project .

ind:workPackageId rdf:type rdf:Property ;
    rdfs:label 'Work Package Id' ;
    rdfs:comment 'Unique identifier for the work package within the project schedule. Represents a discrete unit of work to be completed.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkPackage .

ind:workPackageName rdf:type rdf:Property ;
    rdfs:label 'Work Package Name' ;
    rdfs:comment 'Descriptive name of the work package or task within the project schedule.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workPackageDescription rdf:type rdf:Property ;
    rdfs:label 'Work Package Description' ;
    rdfs:comment 'Detailed description of the work package scope, deliverables, and activities to be performed.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityId rdf:type rdf:Property ;
    rdfs:label 'Activity Id' ;
    rdfs:comment 'Unique identifier for the schedule activity within the work package. Used for detailed task-level tracking.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Activity .

ind:activityName rdf:type rdf:Property ;
    rdfs:label 'Activity Name' ;
    rdfs:comment 'Name of the specific activity or task within the work package.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityDescription rdf:type rdf:Property ;
    rdfs:label 'Activity Description' ;
    rdfs:comment 'Detailed description of the activity scope and expected outcomes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phaseCode rdf:type rdf:Property ;
    rdfs:label 'Phase Code' ;
    rdfs:comment 'Code representing the project phase. PE=Preliminary Engineering, CE=Construction Engineering, ROW=Right-of-Way acquisition, DESIGN=Design phase, CONSTRUCTION=Construction phase, CLOSEOUT=Project closeout.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneFlag rdf:type rdf:Property ;
    rdfs:label 'Milestone Flag' ;
    rdfs:comment 'Indicates whether this schedule entry represents a project milestone (true) or a regular activity (false).' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'Planned start date for the work package or activity as originally scheduled.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledFinishDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Finish Date' ;
    rdfs:comment 'Planned finish date for the work package or activity as originally scheduled.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baselineStartDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Start Date' ;
    rdfs:comment 'Baseline start date established at project approval or contract award. Used for variance analysis.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baselineFinishDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Finish Date' ;
    rdfs:comment 'Baseline finish date established at project approval or contract award. Used for variance analysis.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualFinishDate rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Date' ;
    rdfs:comment 'Actual date when work on the activity or work package was completed.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastStartDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Start Date' ;
    rdfs:comment 'Current forecast or projected start date based on latest project status and conditions.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastFinishDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Finish Date' ;
    rdfs:comment 'Current forecast or projected finish date based on latest project status and conditions.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earlyStartDate rdf:type rdf:Property ;
    rdfs:label 'Early Start Date' ;
    rdfs:comment 'Earliest possible start date calculated by critical path method (CPM) scheduling analysis.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earlyFinishDate rdf:type rdf:Property ;
    rdfs:label 'Early Finish Date' ;
    rdfs:comment 'Earliest possible finish date calculated by critical path method (CPM) scheduling analysis.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lateStartDate rdf:type rdf:Property ;
    rdfs:label 'Late Start Date' ;
    rdfs:comment 'Latest allowable start date without delaying project completion, calculated by CPM analysis.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lateFinishDate rdf:type rdf:Property ;
    rdfs:label 'Late Finish Date' ;
    rdfs:comment 'Latest allowable finish date without delaying project completion, calculated by CPM analysis.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:durationDays rdf:type rdf:Property ;
    rdfs:label 'Duration Days' ;
    rdfs:comment 'Planned duration of the work package or activity measured in calendar days.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingDurationDays rdf:type rdf:Property ;
    rdfs:label 'Remaining Duration Days' ;
    rdfs:comment 'Estimated remaining duration to complete the activity, measured in calendar days.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualDurationDays rdf:type rdf:Property ;
    rdfs:label 'Actual Duration Days' ;
    rdfs:comment 'Actual duration from start to finish of the completed activity, measured in calendar days.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentComplete rdf:type rdf:Property ;
    rdfs:label 'Percent Complete' ;
    rdfs:comment 'Percentage of work completed for the activity or work package, ranging from 0.00 to 100.00.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:physicalPercentComplete rdf:type rdf:Property ;
    rdfs:label 'Physical Percent Complete' ;
    rdfs:comment 'Physical completion percentage based on actual work performed, ranging from 0.00 to 100.00.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalPathFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Path Flag' ;
    rdfs:comment 'Indicates whether this activity is on the project critical path (true) or not (false). Critical path activities directly impact project completion date.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalFloatDays rdf:type rdf:Property ;
    rdfs:label 'Total Float Days' ;
    rdfs:comment 'Total float or slack time available for the activity without delaying project completion, measured in days.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freeFloatDays rdf:type rdf:Property ;
    rdfs:label 'Free Float Days' ;
    rdfs:comment 'Free float time available without delaying any successor activities, measured in days.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constraintType rdf:type rdf:Property ;
    rdfs:label 'Constraint Type' ;
    rdfs:comment 'Type of scheduling constraint applied. ASAP=As Soon As Possible, ALAP=As Late As Possible, SNET=Start No Earlier Than, SNLT=Start No Later Than, FNET=Finish No Earlier Than, FNLT=Finish No Later Than, MSO=Mandatory Start On, MFO=Mandatory Finish On.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintDate rdf:type rdf:Property ;
    rdfs:label 'Constraint Date' ;
    rdfs:comment 'Date associated with the schedule constraint, if applicable.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calendarId rdf:type rdf:Property ;
    rdfs:label 'Calendar Id' ;
    rdfs:comment 'Identifier for the work calendar applied to this activity, defining working days and holidays.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:calendarName rdf:type rdf:Property ;
    rdfs:label 'Calendar Name' ;
    rdfs:comment 'Name of the work calendar (e.g., Standard 5-Day Week, 7-Day Construction Calendar).' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOrganization rdf:type rdf:Property ;
    rdfs:label 'Responsible Organization' ;
    rdfs:comment 'NCDOT division or external organization responsible for executing this work package or activity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePersonName rdf:type rdf:Property ;
    rdfs:label 'Responsible Person Name' ;
    rdfs:comment 'Name of the individual responsible for managing or executing this schedule activity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePersonEmail rdf:type rdf:Property ;
    rdfs:label 'Responsible Person Email' ;
    rdfs:comment 'Email address of the individual responsible for this schedule activity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorName rdf:type rdf:Property ;
    rdfs:label 'Contractor Name' ;
    rdfs:comment 'Name of the contractor or vendor assigned to perform this work package, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetedCost rdf:type rdf:Property ;
    rdfs:label 'Budgeted Cost' ;
    rdfs:comment 'Budgeted cost allocated to this work package or activity in US dollars.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'Current estimated cost to complete this work package or activity in US dollars.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceDays rdf:type rdf:Property ;
    rdfs:label 'Variance Days' ;
    rdfs:comment 'Variance between planned and actual schedule, measured in days. Positive values indicate ahead of schedule, negative values indicate delays.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorityRank rdf:type rdf:Property ;
    rdfs:label 'Priority Rank' ;
    rdfs:comment 'Numerical priority ranking of this activity within the project schedule. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weatherDependentFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Dependent Flag' ;
    rdfs:comment 'Indicates whether this activity is weather-dependent (true) or can proceed regardless of weather conditions (false).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Permit Required Flag' ;
    rdfs:comment 'Indicates whether regulatory permits are required before this activity can commence (true) or not (false).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permitType rdf:type rdf:Property ;
    rdfs:label 'Permit Type' ;
    rdfs:comment 'Type of permit required. Values include NEPA (environmental), 404 (wetlands), NPDES (stormwater), AIR (air quality), SHPO (historic preservation), OTHER.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitStatus rdf:type rdf:Property ;
    rdfs:label 'Permit Status' ;
    rdfs:comment 'Current status of required permits. Values: NOT_REQUIRED, PENDING, APPROVED, DENIED, EXPIRED.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowAcquisitionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Row Acquisition Required Flag' ;
    rdfs:comment 'Indicates whether right-of-way acquisition is required before this activity can proceed (true) or not (false).' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trafficControlRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Required Flag' ;
    rdfs:comment 'Indicates whether traffic control measures (MOT/TCP) are required during this activity (true) or not (false).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laneClosureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Lane Closure Required Flag' ;
    rdfs:comment 'Indicates whether lane closures are required during this activity (true) or not (false).' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:predecessorActivities rdf:type rdf:Property ;
    rdfs:label 'Predecessor Activities' ;
    rdfs:comment 'Comma-separated list of predecessor activity IDs that must be completed before this activity can start.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successorActivities rdf:type rdf:Property ;
    rdfs:label 'Successor Activities' ;
    rdfs:comment 'Comma-separated list of successor activity IDs that depend on the completion of this activity.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'Type of dependency relationship with predecessor activities. FS=Finish-to-Start, SS=Start-to-Start, FF=Finish-to-Finish, SF=Start-to-Finish.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lagDays rdf:type rdf:Property ;
    rdfs:label 'Lag Days' ;
    rdfs:comment 'Number of lag days (delay) between predecessor completion and successor start, measured in days.' ;
