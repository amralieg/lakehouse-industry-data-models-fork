    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:axleCount rdf:type rdf:Property ;
    rdfs:label 'Axle Count' ;
    rdfs:comment 'Number of axles on the vehicle. Important for commercial vehicles and weight-based fees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tireSize rdf:type rdf:Property ;
    rdfs:label 'Tire Size' ;
    rdfs:comment 'Standard tire size specification for the vehicle (e.g., P215/65R15).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleNumber rdf:type rdf:Property ;
    rdfs:label 'Title Number' ;
    rdfs:comment 'Unique identifier assigned to the certificate of title for this vehicle in North Carolina.' ;
