    rdfs:comment 'Notes documenting quality assurance and quality control procedures applied to the model development and application.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runTimeMinutes rdf:type rdf:Property ;
