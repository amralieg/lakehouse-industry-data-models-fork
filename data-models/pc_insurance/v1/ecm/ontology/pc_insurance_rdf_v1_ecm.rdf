    rdfs:range xsd:string .

ind:secondaryReasonCode rdf:type rdf:Property ;
    rdfs:label 'Secondary Reason Code' ;
    rdfs:comment 'Secondary reason code providing additional context for the underwriting decision.' ;
    rdfs:domain ind:UwDecision ;
