// DBML Schema for Business: Pc_Insurance
// Version: 1
// Generated on: 2026-09-20 21:32:56

Project {
  database_type: 'Databricks Unity Catalog'
  Note: 'Lakehouse data model for Pc_Insurance - Version 1'
}

Table party.party {
  party_id varchar [pk, note: 'Unique surrogate key for every person or organization in the MDM party master. One row per party. Role = MASTER_PARTY primary key.']
  master_party_id varchar [note: 'References the surviving golden-record party_id when this record has been merged into another. Null if this record is itself the golden record. Supports MDM deduplication lineage.']
  address_line1 varchar [note: 'First line of the party\'s primary mailing/residence address (street number and name). Used for policy issuance, billing, regulatory filings, and territory rating.']
  address_line2 varchar [note: 'Second line of the party\'s primary address (suite, apartment, unit, floor). Supplementary to address_line1 for complete mailing address.']
  city varchar [note: 'City or municipality of the party\'s primary address. Used in territory rating, catastrophe aggregation, and regulatory jurisdiction determination.']
  clue_report_date date [note: 'Date the most recent CLUE loss history report was ordered for this party. Used in personal lines underwriting to assess prior claims history. Governed by FCRA.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the party\'s primary address (e.g., USA, CAN). Required for international commercial lines and OFAC/sanctions screening.']
  created_timestamp timestamp [note: 'Timestamp when the party record was first created in the MDM system. Immutable audit field. RECORD_AUDIT_CREATED per MASTER_PARTY canonical category.']
  credit_score varchar [note: 'Insurance-based credit score used in personal lines rating (HO, PAP) where state-permitted. Sourced from credit bureaus under FCRA. Range typically 150–950. Null where prohibited by state DOI.']
  credit_score_date date [note: 'Date the insurance credit score was last obtained from the credit bureau. Used to determine score freshness and re-pull schedules per FCRA and state DOI requirements.']
  date_of_birth date [note: 'Date of birth for a natural person. Used in age-based rating, MVR eligibility, KYC identity verification, and OFAC/sanctions screening. Null for ORGANIZATION.']
  date_of_death date [note: 'Date of death for a natural person, populated when confirmed. Triggers policy lifecycle actions (cancellation, beneficiary notification) and stops billing. Null if living or ORGANIZATION.']
  date_of_incorporation date [note: 'Date the organization was legally incorporated or formed. Used to calculate years_in_business and validate commercial underwriting eligibility. Null for INDIVIDUAL.']
  do_not_contact_flag boolean [note: 'Indicates the party has opted out of marketing and non-essential communications. Enforced in outbound campaign and billing communication workflows per TCPA and GLBA opt-out rules.']
  family_name varchar [note: 'Surname/family name of a natural person. Null for ORGANIZATION party type. Used in KYC, CLUE, MVR, and OFAC screening.']
  fraud_indicator_flag boolean [note: 'Set to True when the SIU or fraud detection system has flagged this party for suspected fraudulent activity. Triggers enhanced review on new submissions and claims.']
  full_name varchar [note: 'Golden-record display name. For individuals: concatenated given + family name. For organizations: legal entity name. Primary IDENTITY_LABEL per MDM golden record.']
  gender varchar [note: 'Self-reported gender of a natural person: M=Male, F=Female, X=Non-binary/Other, U=Unknown. Used in auto rating where state-permitted. Null for ORGANIZATION.']
  given_name varchar [note: 'First/given name of a natural person. Null for ORGANIZATION party type. Used in correspondence, KYC matching, and CLUE/MVR lookups.']
  golden_record_flag boolean [note: 'True if this party record is the MDM-designated master (golden) record after deduplication. False for duplicate or candidate records pending merge resolution.']
  kyc_status varchar [note: 'Current KYC/AML verification status of the party. VERIFIED = identity confirmed; FAILED = verification failed; REVIEW = under enhanced due diligence. Required for GLBA and BSA/AML compliance.']
  kyc_verified_date date [note: 'Date on which the party\'s identity was most recently verified through the KYC process. Used to determine re-verification schedules and compliance audit trails.']
  legal_entity_name varchar [note: 'Registered legal name of an organization as filed with the state or federal authority. Null for INDIVIDUAL party type. Used in commercial lines underwriting and FEIN matching.']
  marital_status varchar [note: 'Marital status of a natural person used in personal lines rating (HO, PAP). Null for ORGANIZATION. [ENUM-REF-CANDIDATE: SINGLE|MARRIED|DIVORCED|WIDOWED|SEPARATED|UNKNOWN — promote to reference product]']
  naics_code varchar [note: 'NAICS code classifying the industry of an organization party. Used in commercial lines underwriting, CGL class rating, BOP eligibility, and actuarial segmentation.']
  ofac_match_flag boolean [note: 'Indicates whether the party returned a potential match on the OFAC SDN or consolidated sanctions list. True triggers manual review and blocks policy binding until cleared.']
  ofac_screened_date date [note: 'Most recent date the party was screened against the OFAC Specially Designated Nationals (SDN) list. Required for regulatory compliance before policy binding.']
  organization_type varchar [note: 'Legal structure of an organization party. Drives commercial lines eligibility, CGL/BOP underwriting rules, and FEIN validation. Null for INDIVIDUAL. [ENUM-REF-CANDIDATE: CORPORATION|LLC|PARTNERSHIP|SOLE_PROP|TRUST|NONPROFIT|GOVERNMENT|OTHER — promote to']
  party_status varchar [note: 'Current MDM lifecycle state of the party record. ACTIVE = in use; INACTIVE = no current relationships; DECEASED = confirmed death; MERGED = superseded by survivor; SUSPENDED = under review.']
  party_type varchar [note: 'Discriminator distinguishing a natural person (INDIVIDUAL) from a legal entity (ORGANIZATION). Drives which subtype attributes are populated and which KYC rules apply.']
  postal_code varchar [note: 'US ZIP or ZIP+4 postal code for the party\'s primary address. Used in territory rating, catastrophe zone mapping, and USPS address validation.']
  preferred_contact_method varchar [note: 'Party\'s stated preference for receiving communications: EMAIL, PHONE, MAIL, TEXT, or PORTAL. Drives outbound communication routing in PAS and billing systems.']
  preferred_language varchar [note: 'ISO 639-1 language code (optionally with BCP-47 region tag, e.g., en-US, es-MX) indicating the party\'s preferred language for documents and communications.']
  primary_email varchar [note: 'Primary electronic mail address for the party. Used for policy documents, billing notices, FNOL acknowledgements, and regulatory correspondence. PRIMARY_CONTACT field per MASTER_PARTY role.']
  primary_phone varchar [note: 'Primary telephone number in E.164 format. Used for FNOL intake, billing collections, underwriting contact, and fraud/SIU outreach.']
  privacy_opt_out_flag boolean [note: 'Indicates the party has exercised their right to opt out of information sharing with non-affiliated third parties under GLBA/CCPA. Restricts data sharing in downstream systems.']
  sic_code varchar [note: 'Four-digit SIC code for an organization party. Legacy classification used alongside NAICS in commercial underwriting, ISO rating, and NAIC statutory reporting.']
  source_system_code varchar [note: 'Identifies the operational system of record that originated this party record (e.g., PAS = Guidewire PolicyCenter, CLAIMS = ClaimCenter). Used for MDM lineage and deduplication.']
  source_system_party_code varchar [note: 'The party\'s native identifier in the originating operational system (e.g., Guidewire contact ID, ClaimCenter party ID). Enables cross-system reconciliation and MDM matching.']
  state_code varchar [note: 'Two-letter US state or territory code (USPS abbreviation) for the party\'s primary address. Determines applicable DOI jurisdiction, rate filings, and statutory requirements.']
  state_of_incorporation varchar [note: 'Two-letter US state code where the organization was legally incorporated. Relevant for surplus lines eligibility, admitted vs non-admitted determination, and regulatory filings.']
  tax_id_type varchar [note: 'Classifies the tax identifier held in the party identifier table: Social Security Number (SSN), Federal Employer Identification Number (FEIN), Individual Taxpayer Identification Number (ITIN), or other.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the party record in the MDM system. Used for change data capture, audit trails, and downstream incremental loads.']
  years_in_business varchar [note: 'Number of years the organization has been in continuous operation. Used in commercial lines underwriting as a risk factor for BOP, CGL, and E&O eligibility.']

  Note: 'One row per party (person or organization). Master identity record. Roles, addresses, contacts, and identifiers are child tables. Never embed role on this record; use party.role with effective/expiration dates.'
}

Table party.role {
  role_id varchar [pk, note: 'Unique surrogate identifier for a party role assignment. One row per party-role assignment instance.']
  claim_id varchar [note: 'Reference to the claim under which this role is assigned, when the role is claim-scoped (e.g., claimant, adjuster, payee on a specific claim).']
  party_id varchar [note: 'Reference to the party (person or organization) holding this role. Links to the Party master record.']
  policy_id varchar [note: 'Reference to the policy under which this role is assigned, when the role is policy-scoped (e.g., policyholder, named insured, additional insured).']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Additional insureds, named insureds, and other party roles are added or removed by endorsement within a specific policy term.']
  acord_role_code varchar [note: 'Standardized ACORD data standard role code for this party role assignment. Enables interoperability with trading partners, MGAs, and reinsurers using ACORD XML/JSON.']
  assignment_reason varchar [note: 'Business reason that triggered the creation of this role assignment. Supports audit trails and lifecycle analysis across the policy and claims lifecycle. [ENUM-REF-CANDIDATE']
  consent_obtained_date date [note: 'Date on which the required consent was obtained from the party for this role. Null if consent has not yet been obtained or is not required.']
  created_timestamp timestamp [note: 'Timestamp when this party role assignment record was first created in the data platform. Supports audit trails and data lineage per SOX and NAIC requirements.']
  do_not_contact_flag boolean [note: 'Indicates that this party has requested no outbound contact in this role. Enforces compliance with TCPA, CAN-SPAM, and state do-not-call regulations.']
  effective_date date [note: 'Date on which this party role assignment becomes effective. Used to reconstruct roles in force at any given date, including the loss date.']
  expiration_date date [note: 'Date on which this party role assignment expires or is terminated. Null indicates the role is open-ended and currently active.']
  fraud_score decimal(5,2) [note: 'Numeric fraud risk score assigned to this party in this role by the fraud detection system. Higher values indicate greater fraud risk. Range 0.00 to 100.00.']
  guardian_flag boolean [note: 'Indicates whether this party is acting as a legal guardian for a minor or incapacitated insured in this role. Affects claims payment authorization and policy management.']
  interest_type_code varchar [note: 'Specifies the nature of the insurable interest held by the party in this role. Relevant for property and auto lines where multiple parties have financial interests.']
  is_consent_required boolean [note: 'Flags whether this party role requires explicit consent for data processing or communications under GLBA, GDPR, or CCPA privacy regulations.']
  is_primary_role boolean [note: 'Indicates whether this is the primary instance of the role type for the associated policy or claim. True for the first named insured or lead claimant.']
  kyc_verified boolean [note: 'Indicates whether Know Your Customer identity verification has been completed for this party in this role. Required for producers and high-value policyholders.']
  kyc_verified_date date [note: 'Date on which KYC verification was completed for this party role. Used for compliance audit trails and periodic re-verification scheduling.']
  language_preference varchar [note: 'Preferred language for communications with this party in this role, expressed as a BCP 47 language tag (e.g., en-US, es-MX). Supports regulatory plain-language requirements.']
  litigation_flag boolean [note: 'Indicates whether this party role is involved in active litigation related to a claim or policy dispute. Triggers legal hold and restricts certain automated communications.']
  notes varchar [note: 'Free-text notes or remarks entered by underwriters, adjusters, or administrators regarding this specific party role assignment. Supports audit and workflow context.']
  notification_preference varchar [note: 'Preferred communication channel for this party in this role. Drives billing notices, policy documents, and claims correspondence delivery.']
  ofac_match_flag boolean [note: 'Indicates whether the OFAC screening returned a potential match for this party. A True value triggers a compliance hold and manual review workflow.']
  ofac_screen_date date [note: 'Most recent date on which the OFAC screening was performed for this party in this role. Supports periodic re-screening compliance requirements.']
  ofac_screened boolean [note: 'Indicates whether this party has been screened against the OFAC Specially Designated Nationals list for this role assignment. Mandatory for regulatory compliance.']
  power_of_attorney_flag boolean [note: 'Indicates whether this party is acting under a power of attorney on behalf of another party in this role. Triggers additional documentation and authorization requirements.']
  relationship_to_insured varchar [note: 'Describes the relationship of this party to the primary named insured. Used for household underwriting, rating, and claims adjudication. [ENUM-REF-CANDIDATE: SELF|SPOUSE|CHILD|PARENT|SIBLING|EMPLOYEE|PARTNER|OTHER — 8 candidates stripped; promote to']
  represented_by_counsel boolean [note: 'Indicates whether this party is represented by legal counsel in this role. When True, all communications must be directed to the attorney of record.']
  role_status varchar [note: 'Current lifecycle state of this party role assignment. Drives eligibility checks, billing, and claims adjudication workflows.']
  sequence_number varchar [note: 'Ordinal position when multiple parties hold the same role type on the same policy or claim (e.g., first named insured = 1, second named insured = 2).']
  siu_referral_flag boolean [note: 'Indicates whether this party role has been referred to the Special Investigations Unit for fraud investigation. Relevant for claimant and adjuster roles.']
  source_system_role_code varchar [note: 'The native identifier for this role assignment in the originating source system (e.g., Guidewire PolicyCenter contact role ID). Supports lineage and reconciliation.']
  subtype_code varchar [note: 'Further classifies the role within its type. For example, distinguishes First Party from Third Party claimants, or Primary from Secondary named insureds.']
  tax_identification_number varchar [note: 'Federal tax identifier for this party in this role. May be an SSN for individuals or FEIN for organizations. Required for 1099 and statutory reporting.']
  tax_reporting_required boolean [note: 'Indicates whether IRS tax reporting (e.g., 1099 issuance) is required for payments made to this party in this role. Relevant for payee, claimant, and producer roles.']
  termination_reason varchar [note: 'Business reason for the termination or expiration of this role assignment. Null if the role is still active. Supports regulatory and audit reporting. [ENUM-REF-CANDIDATE: CANCELLATION|NON_RENEWAL|ENDORSEMENT_REMOVAL|CLAIM_CLOSED|DEATH|COURT_ORDER|OTHER —']
  type_code varchar [note: 'Classifies the functional role the party plays in the insurance lifecycle. [ENUM-REF-CANDIDATE: POLICYHOLDER|NAMED_INSURED|ADDITIONAL_INSURED|CLAIMANT|PRODUCER|ADJUSTER|PAYEE|MORTGAGEE|LOSS_PAYEE|ADDITIONAL_INTEREST — promote to reference product]']
  updated_timestamp timestamp [note: 'Timestamp when this party role assignment record was last modified in the data platform. Supports change tracking, audit trails, and incremental data loading.']
  w9_on_file boolean [note: 'Indicates whether a valid IRS Form W-9 has been collected and is on file for this party role. Required before issuing payments to producers, vendors, and claimants.']
  w9_received_date date [note: 'Date on which the IRS Form W-9 was received from this party for this role. Supports tax compliance audit trails and payment hold management.']

  Note: 'One row per party-role assignment. A party may hold many roles over time: policyholder, named insured, additional insured, claimant, producer, adjuster, payee. Effective and expiration dates govern each assignment.'
}

Table party.individual {
  individual_id varchar [pk, note: 'Unique surrogate key identifying a natural person in the party master. One row per individual. MASTER_PARTY role; canonical-attrs-enforced.']
  household_id varchar [note: 'Foreign key linking to party.household. Business justification: An individual person belongs to a household — the canonical 1:N relationship for grouping family members.']
  party_id varchar [note: 'Foreign key reference to the parent Party record in the enterprise party master. Links the individual subtype to its supertype party record.']
  birth_date date [note: 'Individual\'s date of birth in ISO 8601 format. Used for age-based rating, eligibility screening, MVR ordering, and FCRA-compliant underwriting.']
  citizenship_country_code varchar [note: 'ISO 3166-1 alpha-3 country code representing the individual\'s country of citizenship. Used for KYC, OFAC screening, and international policy eligibility.']
  clue_consent_flag boolean [note: 'Indicates whether the individual has consented to a CLUE report pull for prior loss history. Required under FCRA before accessing LexisNexis CLUE data.']
  communication_preference varchar [note: 'Individual\'s preferred channel for receiving policy documents, billing notices, and claims correspondence. Drives document delivery routing in the PAS and billing system.']
  created_timestamp timestamp [note: 'Timestamp when this individual record was first created in the lakehouse silver layer. Used for audit trail, data lineage, and GDPR right-to-erasure tracking.']
  credit_score varchar [note: 'Insurance-based credit score obtained from a consumer reporting agency. Used as a rating variable in personal lines where permitted by state DOI. Governed by FCRA.']
  credit_score_date date [note: 'Date on which the insurance credit score was last obtained. Used to determine score currency and trigger re-pull at renewal per underwriting guidelines.']
  credit_score_source varchar [note: 'Name of the consumer reporting agency or scoring model that provided the insurance credit score. Required for FCRA adverse action notices and audit trails.']
  deceased_date date [note: 'Date of death for the individual if known. Triggers policy lifecycle actions (cancellation, beneficiary notification) and stops renewal processing.']
  do_not_contact_flag boolean [note: 'Indicates the individual has opted out of marketing and non-essential communications. Enforced per TCPA, CAN-SPAM, and state privacy regulations including CCPA.']
  drivers_license_expiry_date date [note: 'Expiration date of the individual\'s driver license. Used to flag expired licenses during auto underwriting eligibility checks and renewal processing.']
  drivers_license_number varchar [note: 'State-issued driver license number for the individual. Required for MVR ordering, auto underwriting eligibility, and claims investigation in personal and commercial auto lines.']
  drivers_license_state varchar [note: 'Two-letter USPS state code of the jurisdiction that issued the individual\'s driver license. Required to route MVR orders to the correct state DMV.']
  employer_name varchar [note: 'Name of the individual\'s current employer. Used in commercial lines underwriting, group policy eligibility verification, and workers compensation exposure assessment.']
  first_name varchar [note: 'Legal given name of the individual as it appears on government-issued identification. Used for policy issuance, claims, and regulatory reporting.']
  fraud_indicator_flag boolean [note: 'Flag set by the SIU or fraud detection system indicating the individual has an active fraud alert or prior confirmed fraud history. Triggers referral to SIU on new submissions.']
  gender_code varchar [note: 'Gender of the individual as reported. M=Male, F=Female, X=Non-binary/Other, U=Unknown. Used in auto and life rating where permitted by state DOI regulations.']
  golden_record_flag boolean [note: 'Indicates this individual record is the master golden record in the MDM after deduplication. Non-golden records are survivorship candidates linked to the golden record.']
  kyc_status varchar [note: 'Current KYC verification status for the individual. Required for GLBA compliance and OFAC/AML screening before policy binding or claim payment disbursement.']
  kyc_verified_date date [note: 'Date on which the individual\'s identity was last successfully verified through the KYC process. Used to determine re-verification cadence per compliance policy.']
  last_name varchar [note: 'Legal surname of the individual as it appears on government-issued identification. Used for policy issuance, claims, and regulatory reporting.']
  marital_status_code varchar [note: 'Marital status of the individual. S=Single, M=Married, D=Divorced, W=Widowed, P=Domestic Partner. Used as a rating variable in personal auto and homeowners lines.']
  middle_name varchar [note: 'Legal middle name or initial of the individual. Used for identity disambiguation and matching against MVR and CLUE reports.']
  mvr_consent_flag boolean [note: 'Indicates whether the individual has provided written consent for the insurer to order an MVR report. Required under FCRA before pulling driving history for underwriting.']
  mvr_order_date date [note: 'Date on which the most recent MVR report was ordered for this individual. Used to determine MVR currency and trigger re-order at renewal per underwriting guidelines.']
  name_prefix varchar [note: 'Honorific or title prefix for the individual\'s name (e.g., Mr., Dr.). Used in correspondence, policy documents, and declarations pages.']
  name_suffix varchar [note: 'Generational or professional suffix appended to the individual\'s legal name (e.g., Jr., Sr., II). Used for precise identity matching and document generation.']
  occupation_code varchar [note: 'Standardized occupation classification code for the individual. Used as a rating variable in personal lines and for SIC/NAICS alignment in commercial underwriting.']
  occupation_description varchar [note: 'Free-text description of the individual\'s occupation or job title as self-reported on the application. Supplements the occupation code for underwriting review.']
  ofac_screen_date date [note: 'Date of the most recent OFAC screening for this individual. Used to determine whether a re-screen is required at renewal or prior to claim payment.']
  ofac_screened_flag boolean [note: 'Indicates whether the individual has been screened against the OFAC Specially Designated Nationals list. Mandatory before policy issuance and claim payment.']
  preferred_language_code varchar [note: 'BCP 47 language tag representing the individual\'s preferred communication language (e.g., en-US, es-MX). Used for policy document generation and claims correspondence.']
  prior_carrier_name varchar [note: 'Name of the individual\'s most recent prior insurance carrier. Used in underwriting to verify continuous coverage and assess prior loss history context.']
  prior_policy_expiry_date date [note: 'Expiration date of the individual\'s most recent prior policy. Used to calculate coverage lapse duration and apply lapse surcharges per underwriting guidelines.']
  residency_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the individual\'s country of primary residence. Used for jurisdictional rating, regulatory compliance, and tax reporting.']
  residency_state_code varchar [note: 'Two-letter USPS state code of the individual\'s state of primary residence. Determines applicable state DOI regulations, rating territory, and statutory form requirements.']
  siu_referral_date date [note: 'Date on which this individual was most recently referred to the Special Investigations Unit for fraud investigation. Null if no referral has occurred.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this individual record (e.g., PAS=PolicyCenter, CLAIMS=ClaimCenter, MDM=Party MDM). Used for data lineage.']
  source_system_person_code varchar [note: 'Native identifier for this individual in the originating operational system (e.g., Guidewire PolicyCenter contact ID). Used for cross-system reconciliation and ETL lineage.']
  ssn_hash varchar [note: 'One-way cryptographic hash of the individual\'s SSN. Used for identity deduplication and CLUE/MVR ordering without storing the raw SSN in the lakehouse.']
  ssn_last_four varchar [note: 'Last four digits of the individual\'s SSN retained for identity verification and customer service purposes per GLBA data minimization requirements.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this individual record in the lakehouse silver layer. Used for change data capture, audit trail, and SCD Type 1/2 processing.']
  years_continuously_insured varchar [note: 'Number of years the individual has maintained continuous insurance coverage without a lapse. Used as a rating and eligibility variable in personal lines underwriting.']

  Note: 'One row per individual (person subtype of Party). Extends party.party with person-specific attributes: name parts, DOB, SSN hash, drivers license, MVR consent, credit score, and occupational data.'
}

Table party.organization {
  organization_id varchar [pk, note: 'Unique surrogate identifier for the organization record in the party master data management system. Primary key for the organization entity.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commercial insured organizations report annual_revenue and financial statements in a functional currency.']
  mailing_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Organization embeds mailing address fields that duplicate the address table structure. The address table is the SSOT for all addresses and provides geocoding, territory codes, CAT zones, and']
  parent_organization_id varchar [note: 'Self-referencing identifier pointing to the immediate parent organization in a corporate hierarchy. Supports enterprise account management, consolidated TIV, and group policy structures.']
  party_id varchar [note: 'Foreign key reference to the parent Party record in the enterprise party master. Links the organization subtype to its supertype party record.']
  primary_ultimate_parent_organization_id varchar [note: 'Identifier of the top-level ultimate parent in the corporate ownership hierarchy. Used for enterprise-wide exposure aggregation, PML modeling, and group reinsurance treaty application.']
  annual_payroll decimal(18,2) [note: 'Organization\'s total annual payroll in USD. Primary rating basis for Workers Compensation (WC) and a secondary factor for CGL and employer liability lines.']
  annual_revenue decimal(18,2) [note: 'Organization\'s most recently reported annual gross revenue in USD. Used as a rating basis for CGL, E&O, D&O, and EPLI lines, and for exposure-based premium calculations.']
  created_timestamp timestamp [note: 'Timestamp when the organization record was first created in the system. Supports audit trail, data lineage, and regulatory record-keeping requirements under SOX and GLBA.']
  credit_score varchar [note: 'Commercial credit score from a recognized bureau (e.g., D&B Paydex, Experian Business). Used in commercial lines underwriting for financial stability assessment and pricing.']
  credit_score_source varchar [note: 'Source bureau or model that produced the commercial credit score. Required for FCRA compliance, adverse action notices, and audit of underwriting decisions.']
  dba_name varchar [note: 'Trade name or doing-business-as name used by the organization in commercial operations, which may differ from the registered legal name.']
  duns_number varchar [note: 'Nine-digit Dun & Bradstreet Data Universal Numbering System (DUNS) number for the organization. Used for commercial credit scoring, financial strength assessment, and third-party data enrichment.']
  employee_count varchar [note: 'Total number of full-time equivalent employees. Used in underwriting for WC classification, EPLI exposure assessment, and BOP eligibility determination.']
  entity_type varchar [note: 'Legal structure of the organization (e.g., corporation, LLC, partnership). Drives underwriting eligibility, policy form selection, and liability exposure assessment.']
  fein varchar [note: 'IRS-issued Federal Employer Identification Number (FEIN) uniquely identifying the organization for tax and regulatory purposes. Required for commercial policy issuance and 1099 reporting.']
  financial_statement_date date [note: 'Date of the most recent financial statement used to derive annual revenue and payroll figures. Ensures underwriting data currency and supports audit trail for rating basis.']
  fraud_indicator boolean [note: 'Flag set by the SIU or fraud detection system indicating the organization has been associated with suspected or confirmed fraudulent activity. Triggers underwriting referral.']
  incorporation_country varchar [note: 'ISO 3166-1 alpha-3 country code where the organization is incorporated. Required for international commercial accounts, reinsurance counterparties, and OFAC/sanctions screening.']
  incorporation_date date [note: 'Date the organization was legally incorporated or formed. Used in underwriting to assess years in business, business continuity risk, and eligibility for certain commercial lines.']
  incorporation_state varchar [note: 'Two-letter US state code where the organization is legally incorporated or registered. Used for jurisdictional underwriting rules, admitted vs. surplus lines determination, and regulatory compliance.']
  kyc_status varchar [note: 'Current KYC verification status for the organization. Tracks AML/BSA compliance screening outcome. Policies cannot be bound for organizations with failed or pending KYC status.']
  kyc_verified_date date [note: 'Date on which the organization\'s KYC verification was last completed or refreshed. Drives periodic re-verification schedules per AML/BSA compliance requirements.']
  legal_name varchar [note: 'Full legal name of the organization as registered with the state or federal authority. Used on policy declarations, certificates of insurance, and regulatory filings.']
  naic_code varchar [note: 'Five-digit NAIC company code assigned to insurance carriers and reinsurers. Used for statutory reporting, Schedule F, and reinsurance counterparty identification.']
  naics_code varchar [note: 'Six-digit NAICS code identifying the organization\'s primary industry. Supplements SIC for modern commercial underwriting, risk classification, and regulatory reporting.']
  naics_description varchar [note: 'Plain-text description of the organization\'s primary business activity corresponding to the NAICS code. Provides human-readable context for underwriters and auditors.']
  ofac_screen_date date [note: 'Date of the most recent OFAC SDN screening for the organization. Supports compliance audit and triggers re-screening when the record is updated or a policy is renewed.']
  ofac_screened boolean [note: 'Indicates whether the organization has been screened against the OFAC Specially Designated Nationals (SDN) list. Must be true before policy binding per regulatory requirements.']
  preferred_language varchar [note: 'BCP 47 language tag representing the organization\'s preferred language for communications (e.g., en-US, es-MX). Drives document generation and customer service routing.']
  primary_email varchar [note: 'Primary business email address for the organization. Used for policy document delivery, billing notices, claims correspondence, and regulatory communications.']
  primary_phone varchar [note: 'Primary business telephone number for the organization. Used for underwriting contact, claims notification, billing, and producer communication.']
  publicly_traded boolean [note: 'Indicates whether the organization\'s securities are publicly traded on a recognized exchange. Relevant for D&O, EPLI, and E&O underwriting and for financial disclosure requirements.']
  sic_code varchar [note: 'Four-digit SIC code classifying the organization by primary business activity. Used in commercial underwriting, rating, and ISO classification for CGL and BOP lines.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this organization record (e.g., PAS, CMS, MDM). Supports data lineage, deduplication, and master data governance.']
  source_system_ref_code varchar [note: 'Native identifier of this organization record in the originating source system. Enables cross-system reconciliation, deduplication, and lineage tracing in the MDM and data lakehouse.']
  stock_ticker varchar [note: 'Exchange ticker symbol for publicly traded organizations. Used in D&O underwriting, financial strength monitoring, and market capitalization-based exposure assessment.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the organization record. Used for change data capture, MDM synchronization, and audit trail maintenance per SOX and GLBA requirements.']
  website_url varchar [note: 'Official website URL of the organization. Used in commercial underwriting for business activity verification, cyber risk assessment, and e-commerce exposure evaluation.']
  years_in_business varchar [note: 'Number of years the organization has been in continuous operation. Key underwriting factor for commercial lines eligibility, experience rating, and risk assessment.']

  Note: 'One row per organization (entity subtype of Party). Extends party.party with org-specific attributes: legal name, FEIN, NAICS/SIC, revenue, employee count, incorporation details, and parent hierarchy.'
}

Table party.address {
  address_id varchar [pk, note: 'Unique surrogate identifier for each address record in the party domain. Primary key. One row per address per party.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Underwriting eligibility decisions, moratorium enforcement, and concentration management require direct cat_zone assignment to addresses.']
  party_id varchar [note: 'Reference to the party (person or organization) that owns this address. Links address to the Party master record.']
  acord_address_type_code varchar [note: 'ACORD standard address type code from the ACORD data dictionary. Enables interoperability with ACORD 125/126/140 forms and carrier/agency data exchanges.']
  address_status varchar [note: 'Current operational status of the address record. Active addresses receive policy documents and billing. Returned_mail triggers address update workflow in the PAS.']
  address_type varchar [note: 'Classifies the purpose of the address: mailing for correspondence, billing for invoices, risk for insured property location, garaging for auto, loss for claim site.']
  care_of_name varchar [note: 'In-care-of name for mail delivery when correspondence is directed through a third party (e.g., attorney, trustee, mortgagee). Common for additional insured notices.']
  census_tract varchar [note: 'US Census Bureau census tract code for the address. Used for demographic risk analysis, CRA compliance, and actuarial territory segmentation in pricing models.']
  city varchar [note: 'City or municipality name of the address. Used for territory rating, catastrophe aggregation, and regulatory jurisdiction determination.']
  coastal_indicator boolean [note: 'Flags whether the address is within a defined coastal zone subject to enhanced windstorm, storm surge, or tidal flood exposure. Used in underwriting eligibility screening.']
  congressional_district varchar [note: 'US Congressional district code for the address. Used for regulatory reporting, legislative tracking, and state DOI jurisdictional filings.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 three-letter country code (e.g., USA, CAN). Required for international policies, reinsurance bordereaux, and IFRS 17 reporting.']
  county varchar [note: 'County or parish name for the address. Used for territory rating, surplus lines stamping, local tax jurisdiction, and catastrophe exposure aggregation.']
  created_timestamp timestamp [note: 'Timestamp when this address record was first created in the system. Supports audit trail, data lineage, and SOX/MAR compliance for record creation tracking.']
  distance_to_coast_miles decimal(7,2) [note: 'Straight-line distance in miles from the address to the nearest coastline. Used in windstorm rating, coastal surcharge calculation, and catastrophe model inputs.']
  distance_to_fire_station_miles decimal(7,2) [note: 'Distance in miles from the address to the nearest responding fire station. Used in ISO PPC determination and property rating for rural or semi-rural locations.']
  do_not_mail_indicator boolean [note: 'Suppresses physical mail delivery to this address per party preference or returned mail. Compliance with GLBA and state DOI notice delivery requirements.']
  dpv_confirmation_code varchar [note: 'USPS DPV result: Y=confirmed deliverable, S=primary match only, D=default match, N=not confirmed. Validates address deliverability for policy documents and billing.']
  effective_date date [note: 'Date from which this address record is valid for the party. Supports point-in-time reconstruction of the address in force at policy inception or loss date.']
  expiration_date date [note: 'Date on which this address record ceases to be valid. Null indicates currently active. Enables historical address reconstruction for claims and regulatory audits.']
  fips_code varchar [note: 'Five-digit FIPS county code (2-digit state + 3-digit county). Used for catastrophe modeling, PML aggregation, and regulatory geographic reporting.']
  fire_protection_class varchar [note: 'ISO Public Protection Classification (PPC) code (1-10) for the address. Directly impacts property insurance rating; class 1 is best, 10 is unprotected.']
  geocode_quality varchar [note: 'Precision level of the geocoded coordinates. Rooftop is highest precision; zip_centroid is lowest. Drives confidence weighting in catastrophe PML and AAL models.']
  geocode_source varchar [note: 'Name of the geocoding service or vendor that produced the latitude/longitude (e.g., Google Maps API, HERE, TomTom, ESRI). Supports data lineage and quality audits.']
  iso_territory_code varchar [note: 'ISO-assigned rating territory code for this address. Used by the rating engine to apply territory-specific loss costs and rate factors per ISO circulars.']
  latitude decimal(9,6) [note: 'Geographic latitude coordinate in decimal degrees (WGS84). Enables precise catastrophe hazard scoring, PML modeling, and territory assignment for insured locations.']
  line1 varchar [note: 'Primary street address line including house/building number and street name. Used for mail delivery, risk location identification, and regulatory filings.']
  line2 varchar [note: 'Secondary address line for suite, apartment, unit, floor, or building designator. Supplements address_line1 for complete delivery address.']
  longitude decimal(9,6) [note: 'Geographic longitude coordinate in decimal degrees (WGS84). Paired with latitude for precise catastrophe hazard scoring and exposure aggregation.']
  po_box varchar [note: 'Post Office box number when the mailing address is a PO Box rather than a street address. Used for billing and correspondence when party does not receive street delivery.']
  postal_code varchar [note: 'Non-US postal code for international addresses (e.g., Canadian postal code, UK postcode). Distinct from zip_code which is US-specific. Used for international risk rating.']
  primary_indicator boolean [note: 'Flags this as the primary address for the party when multiple addresses of the same type exist. Exactly one address per party per type should be primary at any time.']
  province varchar [note: 'Province or region name for non-US addresses (e.g., Canadian provinces, Mexican states). Required for international policies and IFRS 17 geographic segmentation.']
  seasonal_indicator boolean [note: 'Indicates the address is a seasonal or secondary residence (e.g., vacation home). Relevant for homeowners underwriting, vacancy conditions, and occupancy rating.']
  source_system_address_code varchar [note: 'Native address identifier from the originating operational system (e.g., Guidewire internal ID). Enables reconciliation between the lakehouse and the system of record.']
  state_code varchar [note: 'Two-letter US state or territory code (USPS abbreviation). Drives regulatory jurisdiction, rate filings, DOI compliance, and statutory reporting by state.']
  time_zone varchar [note: 'IANA time zone identifier for the address location (e.g., America/New_York). Used for loss date/time determination, FNOL timestamping, and notice deadline calculations.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this address record. Used for change data capture, MDM deduplication refresh, and audit trail in the party data domain.']
  usps_standardized_indicator boolean [note: 'Indicates whether the address has been validated and standardized against the USPS Coding Accuracy Support System (CASS). Ensures deliverability and geocoding accuracy.']
  wind_pool_indicator boolean [note: 'Indicates whether this address falls within a state wind pool or FAIR plan territory (e.g., Texas Windstorm, Florida Citizens). Affects coverage eligibility and reinsurance.']
  zip_code varchar [note: 'Five-digit US ZIP code for the address. Used for territory rating, catastrophe zone assignment, and USPS mail delivery routing.']
  zip_plus4 varchar [note: 'Four-digit ZIP+4 extension providing carrier route precision for USPS delivery. Enhances geocoding accuracy for catastrophe modeling and territory rating.']

  Note: 'One row per party address record. Effective-dated address with geocode, USPS standardization, fire protection class, coastal/wind indicators, and CAT zone linkage. Supports territory and catastrophe aggregation.'
}

Table party.contact {
  contact_id varchar [pk, note: 'Unique surrogate identifier for each contact point record in the party contact master. One row per contact point per party.']
  party_id varchar [note: 'Reference to the Party record that owns this contact point. Links contact to the party master for identity resolution and KYC.']
  acord_contact_type_code varchar [note: 'ACORD standard contact type code from the ACORD data dictionary (e.g., ACORD 125/126 PhoneInfo/EmailInfo type codes). Enables interoperability with trading partners.']
  best_contact_time_end varchar [note: 'Latest time of day (HH:MM, 24-hour local) the party prefers to be contacted via this channel. Supports TCPA-compliant outbound call scheduling.']
  best_contact_time_start varchar [note: 'Earliest time of day (HH:MM, 24-hour local) the party prefers to be contacted via this channel. Supports TCPA-compliant outbound call scheduling.']
  consent_source varchar [note: 'Channel or mechanism through which opt-in consent was captured (e.g., web_form, agent_recorded, ivr, written). Supports GLBA and TCPA audit trail requirements.']
  contact_status varchar [note: 'Current lifecycle status of this contact point. Bounced indicates delivery failure; opted_out reflects GLBA/TCPA suppression. Drives communication eligibility.']
  contact_type varchar [note: 'Classification of the communication channel for this contact point (e.g., phone, email, fax, sms, postal_address, web_portal). Drives routing in PAS and CMS.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code associated with this contact point. Used for international dialing prefix resolution and regulatory jurisdiction mapping.']
  created_timestamp timestamp [note: 'Timestamp when this contact point record was first created in the system. Supports audit trail, GLBA data retention, and MDM lineage requirements.']
  do_not_contact_flag boolean [note: 'Hard suppression flag indicating the party must not be contacted via this channel regardless of opt-in status. Overrides all outbound communication triggers.']
  do_not_contact_reason varchar [note: 'Reason code explaining why the do_not_contact_flag is set. Supports legal hold, regulatory order, and SIU fraud investigation suppression scenarios.']
  effective_date date [note: 'Date from which this contact point is considered active and valid for the party. Supports point-in-time reconstruction of contact data for policy and claims history.']
  email_address varchar [note: 'Structured email address for the party when contact_type is email. Stored separately for validation, opt-in tracking, and GLBA compliance.']
  email_bounce_code varchar [note: 'SMTP bounce code or classification (e.g., 550 hard bounce, 421 soft bounce) returned when an email delivery attempt failed. Used to update contact_status to bounced.']
  expiration_date date [note: 'Date on which this contact point ceases to be valid. Null indicates the contact point is currently active. Enables temporal querying of contact history.']
  is_preferred boolean [note: 'Indicates whether this is the party\'s overall preferred contact method across all contact types. Used by PAS and CMS to select the default outreach channel.']
  is_primary boolean [note: 'Indicates whether this contact point is the primary contact for the party within its contact_type. Only one record per party per contact_type should be primary.']
  is_verified_mobile boolean [note: 'Indicates whether a phone contact point has been confirmed as a mobile/wireless number via carrier lookup. Critical for TCPA autodialer and text message compliance.']
  is_wireless boolean [note: 'Indicates whether the phone number is a wireless (cell) number as determined by carrier lookup. Distinct from is_verified_mobile; set by automated number type detection.']
  language_preference varchar [note: 'Preferred language for communications via this contact point in BCP 47 format (e.g., en-US, es-MX). Supports state DOI language access requirements.']
  last_contact_date date [note: 'Most recent date on which a successful outbound or inbound communication was recorded via this contact point. Used for contact recency analytics and dormancy detection.']
  last_contact_outcome varchar [note: 'Result of the most recent communication attempt via this contact point (e.g., reached, no_answer, voicemail, bounced). Informs next-best-action in claims and billing.']
  notes varchar [note: 'Free-text notes recorded by an agent or adjuster about this contact point (e.g., call-back instructions, seasonal address). Stored in PAS and CMS contact objects.']
  opt_in_flag boolean [note: 'Indicates whether the party has affirmatively opted in to receive communications via this contact point. Required for GLBA and TCPA compliance tracking.']
  opt_in_timestamp timestamp [note: 'Date and time when the party provided opt-in consent for this contact point. Retained as evidence of consent for GLBA and TCPA regulatory audits.']
  opt_out_flag boolean [note: 'Indicates whether the party has explicitly opted out of communications via this contact point. Suppresses outbound contact in PAS, CMS, and Billing systems.']
  opt_out_timestamp timestamp [note: 'Date and time when the party revoked consent or opted out for this contact point. Triggers suppression in all downstream communication systems.']
  phone_extension varchar [note: 'Optional telephone extension appended to the phone number for commercial parties, brokers, or agency contacts in the Producer Management System.']
  phone_number varchar [note: 'Structured phone number in E.164 format for the party when contact_type is phone or sms. Used for FNOL intake, billing, and claims communication.']
  source_system_contact_code varchar [note: 'Native identifier of this contact record in the originating operational system (e.g., Guidewire ContactID). Enables cross-system reconciliation and MDM deduplication.']
  subtype varchar [note: 'Secondary classification refining the contact type (e.g., home, work, mobile, billing, claims, underwriting). [ENUM-REF-CANDIDATE: home|work|mobile|billing|claims|underwriting|other — promote to reference product]']
  time_zone varchar [note: 'IANA time zone identifier for this contact point (e.g., America/New_York). Used to schedule compliant outbound calls within TCPA permitted calling hours.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this contact point record. Used for change data capture, MDM synchronization, and audit trail compliance.']
  usage_purpose varchar [note: 'Business purpose for which this contact point is used (e.g., billing notices, claims FNOL, policy documents, marketing). Drives targeted communication routing.']
  value varchar [note: 'The actual contact point value: phone number, email address, fax number, SMS number, or postal address string depending on contact_type. Contains PII.']
  verification_date date [note: 'Date on which the contact point was last verified through a validation process such as email ping, carrier lookup, or agent confirmation.']
  verification_method varchar [note: 'Method used to verify this contact point (e.g., carrier_lookup for phone, email_ping for email, agent_confirmed for manual review). Supports MDM data quality.']
  verification_status varchar [note: 'Indicates whether this contact point has been validated (e.g., email deliverability check, phone number validation via carrier lookup). Used in KYC and MDM.']

  Note: 'One row per party contact method. Stores phone, email, and other contact channels with opt-in/opt-out flags, verification status, and effective dating. Supports do-not-contact compliance.'
}

Table party.identifier {
  identifier_id varchar [pk, note: 'Surrogate primary key uniquely identifying one party identifier record. One row per identifier per party. Grain: one row per external or internal identifier assigned to a party.']
  identifier_mdm_golden_party_id varchar [note: 'The MDM golden record identifier assigned to the party after deduplication and survivorship processing. Links this identifier to the authoritative master party record across all source systems.']
  identifier_party_id varchar [note: 'Reference to the party record that owns this identifier. Links the identifier back to the master party in the Customer/Party MDM.']
  identifier_pas_party_id varchar [note: 'The party identifier as assigned by the Policy Administration System (Guidewire PolicyCenter or Duck Creek Policy). Used for cross-reference between the data lakehouse and the PAS.']
  license_id varchar [note: 'Foreign key linking to party.license. Business justification: The identifier table stores raw external identifier values (license numbers, NPNs, SSNs, TINs) as typed records, while the license table stores the full structured license entity with status']
  clue_report_ordered boolean [note: 'Indicates whether a CLUE (Comprehensive Loss Underwriting Exchange) report has been ordered for this party identifier. Used in personal lines underwriting to retrieve prior loss history.']
  created_timestamp timestamp [note: 'Timestamp when this identifier record was first created in the data platform. Supports audit trail, data lineage, and SOX compliance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  dedup_match_key varchar [note: 'Normalized, standardized form of the identifier value used for fuzzy matching and deduplication in the Party MDM. Strips formatting characters (dashes, spaces) for consistent comparison.']
  effective_date date [note: 'Date on which this identifier became valid and effective. Used for temporal queries to determine which identifier was active at a given point in time.']
  expiration_date date [note: 'Date on which this identifier expires or ceases to be valid. Null for identifiers with no expiry (e.g., SSN, FEIN). Used for license renewal tracking and compliance monitoring.']
  fraud_indicator boolean [note: 'Flag set by the Fraud Detection/SIU system indicating this identifier has been associated with suspected or confirmed fraudulent activity. Triggers enhanced review in underwriting and claims.']
  identifier_status varchar [note: 'Current lifecycle status of this identifier record: active (in use), inactive (superseded), expired (past validity), revoked (cancelled by issuing authority), pending_verification (awaiting confirmation).']
  is_masked boolean [note: 'Indicates whether the identifier_value stored is a masked or tokenized representation rather than the full plaintext value. True when only last-4 digits or a token is stored for PCI/GLBA compliance.']
  is_primary boolean [note: 'Indicates whether this is the primary identifier for the party within its identifier type. True if this is the preferred or golden record identifier used for cross-system matching and deduplication.']
  issuing_authority varchar [note: 'Name of the government agency, regulatory body, or internal system that issued this identifier (e.g., IRS, SSA, NIPR, state DMV, state DOI, NAIC, internal MDM system).']
  issuing_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the country that issued this identifier (e.g., USA, CAN, GBR). Required for passports and foreign national identifiers.']
  issuing_state_code varchar [note: 'Two-letter US state or territory code of the jurisdiction that issued this identifier. Applicable for driver licenses, state-issued producer licenses, and state DOI registrations.']
  kyc_status varchar [note: 'Know Your Customer compliance status for this identifier as part of anti-money laundering and fraud screening. Tracks whether the identifier has passed identity verification per GLBA and BSA/AML requirements.']
  license_class varchar [note: 'Classification of the license associated with this identifier (e.g., producer license class: P&C, Life, Health; driver license class: A, B, C, M). Applicable for DLN and producer license identifier types.']
  license_state_code varchar [note: 'Two-letter US state code of the jurisdiction under which the license was issued. Distinct from issuing_state_code when a producer holds licenses in multiple states.']
  masked_value decimal(18,2) [note: 'Partially masked display version of the identifier for UI and reporting use (e.g., ***-**-1234 for SSN, **-***1234 for FEIN). Allows display without exposing the full sensitive value.']
  mvr_order_date date [note: 'Date on which the most recent MVR was ordered for this driver license identifier. Used to determine MVR currency and whether a refresh is required per underwriting guidelines.']
  mvr_ordered boolean [note: 'Indicates whether a Motor Vehicle Record (MVR) has been ordered for this driver license identifier. Applicable when identifier_type_code = DLN. Used in personal and commercial auto underwriting.']
  naic_company_code varchar [note: 'Five-digit NAIC company code assigned to an insurance carrier or reinsurer. Populated when identifier_type_code = NAIC_CODE. Used in statutory reporting and Schedule F/P filings.']
  notes varchar [note: 'Free-text notes or comments recorded by underwriters, compliance officers, or MDM stewards regarding this identifier (e.g., reason for revocation, manual override justification, discrepancy notes).']
  npn varchar [note: 'NIPR-assigned National Producer Number for licensed insurance producers and agencies. Populated when identifier_type_code = NPN. Required for producer appointment and commission processing.']
  ofac_check_status varchar [note: 'Result of OFAC SDN (Specially Designated Nationals) screening for this identifier. Required for sanctions compliance. Cleared = no match; Flagged = potential match requiring review.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this identifier record (e.g., PAS for PolicyCenter, MDM for party master, PRODUCER_MGMT for agency system, FRAUD_SIU for SIU system).']
  source_system_party_ref varchar [note: 'The party or entity reference key as it exists in the originating source system. Enables cross-system reconciliation and deduplication between PAS, MDM, billing, and claims systems.']
  tin_match_status varchar [note: 'Result of IRS TIN matching for SSN/FEIN identifiers. Used for 1099 reporting compliance and backup withholding determination. Values: matched, not_matched, pending, not_checked.']
  tin_type varchar [note: 'Specifies the type of IRS Taxpayer Identification Number: SSN (Social Security Number), FEIN (Federal Employer Identification Number), ITIN (Individual Taxpayer Identification Number), or EIN (Employer Identification Number).']
  type_code varchar [note: 'Classifies the kind of identifier: SSN (Social Security Number), FEIN (Federal Employer Identification Number), NPN (National Producer Number), NAIC Code, DLN (Driver License Number), PASSPORT, PAS_PARTY_ID, MDM_GOLDEN_ID.']
  updated_timestamp timestamp [note: 'Timestamp when this identifier record was last modified. Used for change data capture, incremental ETL processing, and audit trail maintenance per SOX and GLBA requirements.']
  value varchar [note: 'The actual identifier string (e.g., SSN digits, FEIN digits, NPN number, driver license number, passport number, PAS party ID, MDM golden record ID). Stored encrypted at rest per GLBA and GDPR/CCPA.']
  verification_date date [note: 'Date on which the identifier was last verified against the issuing authority or third-party source. Supports compliance audit trails and re-verification scheduling.']
  verification_source varchar [note: 'Name of the system or service used to verify this identifier (e.g., NIPR, IRS TIN Match, SSA, LexisNexis, Equifax, state DMV MVR, CLUE). Supports audit and compliance documentation.']
  verification_status varchar [note: 'Indicates whether this identifier has been validated against the issuing authority or a third-party verification service (e.g., NIPR NPN check, IRS TIN match, SSA SSN verification, CLUE, MVR).']

  Note: 'One row per party external identifier (SSN, TIN, NPN, license number, etc.). Effective-dated with masking, verification status, and MDM golden-record linkage. Supports KYC, OFAC, and deduplication workflows.'
}

Table party.relationship {
  relationship_id varchar [pk, note: 'Unique surrogate identifier for a directed party-to-party relationship record. One row per relationship instance in the Party MDM.']
  from_party_id varchar [note: 'Surrogate key of the originating (subject) party in the directed relationship, e.g., the policyholder or parent organization.']
  household_id varchar [note: 'Identifier linking parties that belong to the same household unit. Used for multi-policy household bundling, cross-sell analytics, and personal lines rating.']
  to_party_id varchar [note: 'Surrogate key of the target (object) party in the directed relationship, e.g., the additional insured or subsidiary organization.']
  control_flag boolean [note: 'Indicates whether the from-party exercises a controlling interest over the to-party for regulatory group reporting and affiliated transaction disclosures.']
  created_timestamp timestamp [note: 'Timestamp when this relationship record was first created in the data platform. Supports audit trail, data lineage, and SOX compliance.']
  effective_date date [note: 'Calendar date on which the relationship became or becomes legally and operationally effective. Used for point-in-time reconstruction of party relationships.']
  expiration_date date [note: 'Calendar date on which the relationship ceases to be effective. Null indicates an open-ended relationship with no scheduled end date.']
  fraud_indicator_flag boolean [note: 'Flag set by the SIU or fraud detection system indicating this relationship has been flagged for potential fraud, e.g., staged household relationships to obtain discounts.']
  is_bidirectional boolean [note: 'Indicates whether the relationship is symmetric (True) or strictly directed (False). Symmetric relationships such as spouse do not require a reciprocal row.']
  is_primary boolean [note: 'Indicates whether the from-party is the primary party in this relationship type (e.g., primary named insured vs. additional insured). True = primary.']
  jurisdiction_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction governing the relationship. Supports international and surplus lines business.']
  jurisdiction_state_code varchar [note: 'Two-letter US state code of the jurisdiction governing the relationship. Drives state-specific underwriting rules, regulatory filings, and DOI compliance.']
  legal_basis_code varchar [note: 'Legal instrument or authority establishing the relationship, e.g., MARRIAGE certificate, COURT_ORDER, CORPORATE_FILING. Required for KYC and regulatory compliance.']
  legal_basis_date date [note: 'Date the legal instrument establishing the relationship was executed or issued, e.g., date of marriage, date of court order, date of corporate filing.']
  legal_basis_reference varchar [note: 'Document reference number or identifier for the legal instrument establishing the relationship, e.g., marriage certificate number, court order docket number.']
  notes varchar [note: 'Free-text field for underwriter or compliance officer annotations about the relationship, such as special circumstances, exceptions, or documentation notes.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership or controlling interest held by the from-party over the to-party. Applicable for parent-subsidiary and investor relationships. Range 0.00–100.00.']
  relationship_category varchar [note: 'Broad grouping of the relationship type: Personal (family/household), Commercial (business hierarchy), Legal (trust/guardianship), or Financial (guarantor/beneficiary).']
  relationship_status varchar [note: 'Current lifecycle state of the relationship record. ACTIVE means the relationship is in force; TERMINATED means it has ended; PENDING means awaiting verification.']
  role_from varchar [note: 'The specific role the from-party plays within this relationship instance, e.g., POLICYHOLDER, PARENT, EMPLOYER. Complements relationship_type_code for granular role tracking.']
  role_to varchar [note: 'The specific role the to-party plays within this relationship instance, e.g., ADDITIONAL_INSURED, SUBSIDIARY, EMPLOYEE. Enables multi-role party resolution.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this relationship record, e.g., MDM (Party MDM), PAS (PolicyCenter), CLAIMS (ClaimCenter).']
  source_system_relationship_code varchar [note: 'Native identifier of this relationship record in the originating source system. Enables lineage tracing and reconciliation back to Guidewire PolicyCenter or Duck Creek.']
  termination_date date [note: 'Actual date the relationship was terminated or dissolved, which may differ from the scheduled expiration date (e.g., divorce decree date, corporate dissolution date).']
  termination_reason_code varchar [note: 'Coded reason explaining why the relationship was terminated. Supports audit, compliance, and underwriting eligibility re-evaluation.']
  type_code varchar [note: 'Classifies the nature of the directed relationship between two parties. Drives underwriting, coverage eligibility, and KYC rules. [ENUM-REF-CANDIDATE: promote to reference product for full list]']
  updated_timestamp timestamp [note: 'Timestamp when this relationship record was last modified in the data platform. Used for change data capture and incremental processing in the Databricks Silver layer.']
  uw_impact_flag boolean [note: 'Indicates whether this relationship has a material impact on underwriting eligibility or rating, e.g., a parent-subsidiary relationship affecting group pricing or a household relationship affecting multi-car discount.']
  verification_date date [note: 'Date on which the relationship was last verified by the KYC/compliance process. Null if never verified.']
  verification_status varchar [note: 'KYC/AML verification status of the relationship. VERIFIED means supporting documentation has been reviewed and accepted by the underwriting or compliance team.']
  verified_by varchar [note: 'Name or user identifier of the compliance officer or underwriter who verified the relationship. Supports audit trail and SOX controls.']

  Note: 'One row per directed party-to-party relationship (spouse, employer, subsidiary, etc.). Effective-dated with ownership percentage, legal basis, and UW impact flag. Supports household and corporate hierarchy traversal.'
}

Table party.kyc_verification {
  kyc_verification_id varchar [pk, note: 'Unique surrogate identifier for each KYC verification record. One row per KYC check performed on a party. Grain: one row per KYC verification event per party.']
  claim_id varchar [note: 'Reference to the claim that triggered this KYC verification, when applicable (e.g., FNOL claimant screening or SIU referral). Null for verifications not associated with a specific claim.']
  jurisdiction_geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: KYC regulatory compliance reporting requires tracking verification jurisdiction by state/country geography.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: KYC due diligence level and risk tier are LOB-driven in P&C: surplus lines require enhanced KYC, commercial lines differ from personal lines.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: AML/KYC regulations require insurers to document identity verification at policy issuance and renewal.']
  primary_kyc_analyst_party_id varchar [note: 'Identifier of the compliance analyst or underwriter who performed or reviewed this KYC verification. Required for manual review cases and audit accountability. Links to the Party or User record.']
  submission_id varchar [note: 'Foreign key linking to coverage.submission. Business justification: KYC/OFAC screening performed during underwriting (pre-bind) requires linkage to submission for regulatory audit trail, SIU referral tracking, and compliance with AML requirements at']
  tertiary_kyc_party_id varchar [note: 'Reference to the party (person or organization) subject to this KYC verification. Links to the Party master record in the Party domain.']
  adverse_media_summary varchar [note: 'Brief narrative summary of adverse media findings when is_adverse_media is true. Captures the nature of the negative news (e.g., fraud allegation, regulatory sanction) for analyst review and documentation.']
  analyst_decision varchar [note: 'Final decision made by the compliance analyst after reviewing the KYC verification results. APPROVE=cleared to proceed; REJECT=relationship declined; ESCALATE=referred to senior compliance; DEFER=pending additional info.']
  analyst_notes varchar [note: 'Free-text notes entered by the compliance analyst documenting the rationale for the decision, exceptions granted, or additional context observed during the KYC review process.']
  beneficial_owner_count varchar [note: 'Number of beneficial owners identified and verified for a legal entity party. Per FinCEN CDD Rule, includes all natural persons owning 25% or more equity interest plus one control person.']
  beneficial_owner_verified boolean [note: 'Indicates whether the beneficial ownership of the party (for legal entities) has been verified per FinCEN CDD Rule requirements. Mandatory for legal entity customers with 25%+ ownership threshold.']
  created_timestamp timestamp [note: 'Timestamp when this KYC verification record was first created in the system. Provides the audit trail creation marker required for SOX and regulatory compliance reporting.']
  data_source_code varchar [note: 'Code identifying the originating system or data source for this KYC verification record (e.g., MDM_KYC, PAS_UW, CLAIMS_FNOL). Supports data lineage and source-system reconciliation in the lakehouse.']
  due_diligence_level varchar [note: 'Level of due diligence applied for this KYC verification. SIMPLIFIED=low-risk customers; STANDARD=normal CDD; ENHANCED=high-risk, PEP, or OFAC-adjacent parties. Aligns with FinCEN CDD Rule tiers.']
  escalation_reason varchar [note: 'Narrative reason for escalating this KYC case to senior compliance or a Suspicious Activity Report (SAR) filing. Populated when analyst_decision is ESCALATE. Supports AML investigation workflow.']
  expiration_date date [note: 'Date on which this KYC verification result expires and a refresh is required. Drives periodic review scheduling. Null if the verification has no defined expiry per risk tier.']
  identity_document_expiry_date date [note: 'Expiration date of the identity document used during verification. An expired document may invalidate the KYC result and trigger a re-verification requirement.']
  identity_document_issuing_country varchar [note: 'ISO 3166-1 alpha-3 country code of the authority that issued the identity document used in verification. Used for sanctions screening and cross-border risk assessment.']
  identity_document_number varchar [note: 'The document number from the identity document used for verification (e.g., passport number, driver license number, FEIN). Stored as restricted PII per GLBA and FCRA requirements.']
  identity_document_type varchar [note: 'Type of identity document presented or verified during the KYC check. PASSPORT, DRIVERS_LICENSE, NATIONAL_ID, STATE_ID, MILITARY_ID for individuals; FEIN (Federal Employer Identification Number) for organizations.']
  is_adverse_media boolean [note: 'Indicates whether adverse media (negative news coverage related to financial crime, fraud, sanctions, or regulatory action) was found for this party during the KYC screening process.']
  is_pep boolean [note: 'Indicates whether the party has been identified as a Politically Exposed Person (PEP) — a current or former senior government official or close associate. Triggers enhanced due diligence requirements.']
  next_review_date date [note: 'Date on which the next periodic KYC review is scheduled for this party, based on risk tier and due diligence level. Drives compliance workflow queues and regulatory review cycle management.']
  ofac_hit_reference varchar [note: 'OFAC SDN list entry reference number or identifier when a hit or potential hit is recorded. Populated only when ofac_screening_status is HIT or POTENTIAL_HIT. Used for regulatory escalation.']
  ofac_screening_status varchar [note: 'Result of screening the party against the OFAC Specially Designated Nationals (SDN) and blocked persons list. CLEAR=no match; HIT=confirmed match; POTENTIAL_HIT=possible match requiring review.']
  override_reason varchar [note: 'Documented reason when a KYC verification result is overridden by a compliance officer (e.g., false positive OFAC hit, known PEP with approved exception). Required for audit trail when verification_status is WAIVED.']
  pep_category varchar [note: 'Classification of the PEP relationship when is_pep is true. DOMESTIC=domestic official; FOREIGN=foreign official; INTERNATIONAL_ORGANIZATION=IO official; CLOSE_ASSOCIATE=known associate; FAMILY_MEMBER=immediate family.']
  review_date date [note: 'Date on which the compliance analyst completed their manual review and recorded the analyst_decision. Distinct from verification_date which is when the automated check ran.']
  risk_tier varchar [note: 'Customer risk classification assigned as a result of the KYC process. Determines due diligence level, review frequency, and monitoring intensity. Aligns with FATF risk-based approach.']
  sar_filed boolean [note: 'Indicates whether a Suspicious Activity Report (SAR) was filed with FinCEN as a result of this KYC verification finding. Triggers restricted access controls on the record per BSA requirements.']
  sar_reference_number varchar [note: 'FinCEN-assigned reference number for the Suspicious Activity Report filed in connection with this KYC verification. Populated only when sar_filed is true. Strictly access-controlled.']
  siu_case_number varchar [note: 'Case reference number assigned by the SIU system when this KYC verification triggered a fraud investigation referral. Populated only when siu_referral is true.']
  siu_referral boolean [note: 'Indicates whether this KYC verification result triggered a referral to the Special Investigations Unit (SIU) for potential insurance fraud investigation. Integrates with the Fraud Detection/SIU System.']
  third_party_provider varchar [note: 'Name of the external vendor or service used to perform the KYC verification (e.g., LexisNexis, Experian, Equifax, Refinitiv World-Check). Populated when verification_method is THIRD_PARTY_SERVICE.']
  third_party_reference_code varchar [note: 'Unique transaction or case reference number returned by the third-party KYC provider for this verification. Used for reconciliation, dispute resolution, and audit trail with the external vendor.']
  trigger_event varchar [note: 'Business event that initiated this KYC verification. NEW_BUSINESS=new policy application; RENEWAL=policy renewal; ENDORSEMENT=mid-term change; CLAIM_FNOL=first notice of loss; PERIODIC_REVIEW=scheduled refresh; RISK_CHANGE=risk profile change.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this KYC verification record. Tracks when analyst decisions, overrides, or status changes were last applied. Required for data lineage in the Silver layer.']
  verification_date date [note: 'Calendar date on which the KYC verification check was performed. Used for regulatory reporting, periodic review scheduling, and compliance audit trails.']
  verification_method varchar [note: 'Mechanism used to perform the verification. Examples: DOCUMENT_REVIEW=physical/digital ID doc; DATABASE_LOOKUP=internal/external data match; THIRD_PARTY_SERVICE=vendor API; BIOMETRIC=fingerprint/facial; CREDIT_BUREAU=bureau pull.']
  verification_result varchar [note: 'Detailed outcome of the verification check. CLEAR=no issues found; MATCH=identity confirmed; NO_MATCH=identity not confirmed; PARTIAL_MATCH=partial data match requiring review; INCONCLUSIVE=insufficient data.']
  verification_status varchar [note: 'Current outcome or workflow state of this KYC verification. PASS=cleared; FAIL=failed check; REVIEW=manual review required; PENDING=in progress; EXPIRED=result past validity window; WAIVED=exempted per policy.']
  verification_timestamp timestamp [note: 'Exact date and time the KYC verification was executed, including timezone offset. Provides precise audit trail for regulatory and compliance purposes beyond the calendar date.']
  verification_type varchar [note: 'Category of KYC check performed. IDENTITY=identity document check; OFAC_SCREENING=sanctions list; PEP_SCREENING=politically exposed person; ADVERSE_MEDIA=negative news; EDU=enhanced due diligence; PERIODIC_REVIEW=scheduled refresh.']
  watchlist_hit_detail varchar [note: 'Description of any watchlist match found beyond OFAC screening, including the list name and entry reference. Populated when watchlist_screened is true and a match was identified.']
  watchlist_screened boolean [note: 'Indicates whether the party was screened against applicable government and industry watchlists beyond OFAC (e.g., FBI Most Wanted, Interpol, EU Consolidated List, UN Sanctions). Supports comprehensive AML compliance.']

  Note: 'One row per KYC verification event for a party. Records due-diligence level, OFAC/PEP screening, identity document details, analyst decision, SAR filing, and SIU referral. Links to submission and claim contexts.'
}

Table party.loss_payee {
  loss_payee_id varchar [pk, note: 'Unique surrogate identifier for each loss payee or mortgagee interest record. One row per interest attachment on a party and policy or insured risk.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Loss payees (mortgagees, lienholders) are often specific to individual coverages rather than entire policies. Mortgagee on building coverage, lienholder on auto physical damage.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Loss payee payment_threshold_amount and claim payments to lenders/mortgagees are currency-denominated.']
  insured_risk_id varchar [note: 'Reference to the specific Insured Risk (property, vehicle, etc.) to which this loss payee interest is attached. Null when attached at policy level only.']
  lender_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Loss payee embeds lender address fields that should be normalized to the address table. The address table is the SSOT for all addresses.']
  party_id varchar [note: 'Reference to the Party record representing the lender, mortgagee, or loss payee entity holding the financial interest.']
  policy_id varchar [note: 'Reference to the Policy to which this loss payee interest is attached. Null when interest is attached at insured risk level only.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Loss payee interests (mortgagees, lienholders) are term-specific — they are added, changed, or removed by endorsement within a term.']
  acord_form_type varchar [note: 'ACORD standard form type used to evidence this loss payee or mortgagee interest (e.g., ACORD 25 Certificate of Liability, ACORD 28 Evidence of Property Insurance).']
  cancellation_notice_date date [note: 'Date on which the cancellation or non-renewal notice was sent to this loss payee or mortgagee. Required for regulatory compliance and audit.']
  cancellation_notice_sent boolean [note: 'Indicates whether the required cancellation or non-renewal notice has been sent to this loss payee or mortgagee per the policy terms and state regulations.']
  certificate_issue_date date [note: 'Date on which the Certificate of Insurance (CoI) was issued to this loss payee or mortgagee. Used for compliance tracking and renewal notifications.']
  certificate_number varchar [note: 'Certificate of Insurance (CoI) number issued to this loss payee or mortgagee as evidence of coverage per ACORD 28 or equivalent form.']
  created_timestamp timestamp [note: 'Timestamp when this loss payee interest record was first created in the system. Used for audit trail and SOX compliance.']
  effective_date date [note: 'Date on which this loss payee or mortgagee interest becomes active and enforceable on the policy or insured risk.']
  endorsement_number varchar [note: 'Policy endorsement number under which this loss payee or mortgagee interest was added or modified on the policy.']
  escrow_account_number varchar [note: 'Lender escrow account number used to collect and remit insurance premium payments on behalf of the mortgagor. Supports billing integration with lender.']
  expiration_date date [note: 'Date on which this loss payee or mortgagee interest expires or is removed. Null indicates the interest remains active through the policy term.']
  form_number varchar [note: 'ISO or proprietary form number of the loss payable or mortgagee endorsement attached to the policy (e.g., ISO CP 12 18, PP 03 03).']
  interest_rank varchar [note: 'Ordinal rank of this interest when multiple loss payees or mortgagees exist on the same insured risk (e.g., first mortgagee = 1, second mortgagee = 2).']
  interest_status varchar [note: 'Current lifecycle status of the loss payee or mortgagee interest record. Drives whether the interest is honored in claims payment and certificate issuance.']
  interest_type varchar [note: 'Classification of the financial interest held by the party on the policy or insured risk. Drives certificate of insurance (CoI) and claims payment routing.']
  joint_payee_required boolean [note: 'Indicates whether claim payments must be made jointly to both the insured and this loss payee or mortgagee rather than solely to the insured.']
  lender_email varchar [note: 'Email address of the lender or mortgagee institution used for electronic certificate of insurance delivery and claims payment notifications.']
  lender_fein varchar [note: 'IRS-assigned Federal Employer Identification Number (FEIN) of the lending institution. Required for tax reporting on claim payments and 1099 issuance.']
  lender_name varchar [note: 'Legal name of the lending institution, mortgagee, or lienholder as it must appear on the policy declarations and loss payment instruments.']
  lender_phone varchar [note: 'Primary contact telephone number for the lender or mortgagee institution used for claims notification and certificate of insurance correspondence.']
  lender_reference_number varchar [note: 'Secondary lender-assigned reference or account number (e.g., investor loan number, servicer reference) distinct from the primary loan number.']
  loan_number varchar [note: 'Lender-assigned loan or mortgage account number associated with the insured risk. Used to route claim payments and satisfy lender reporting requirements.']
  loss_payable_clause_type varchar [note: 'Type of loss payable clause attached to the policy for this interest: Standard, Lenders (protects lender independently), Open, or Union mortgage clause.']
  naic_lender_code varchar [note: 'NAIC-assigned code identifying the lender or financial institution for statutory reporting and Schedule F bordereaux purposes.']
  notes varchar [note: 'Free-text underwriter or policy service notes regarding special conditions, lender instructions, or exceptions applicable to this loss payee interest.']
  notification_days varchar [note: 'Number of days advance notice required to be given to the lender or mortgagee before policy cancellation or non-renewal takes effect.']
  notification_required boolean [note: 'Indicates whether the lender or mortgagee must be notified of policy changes, cancellations, or non-renewals per the loss payable clause or lender agreement.']
  payment_payable_to varchar [note: 'Full legal name(s) as they must appear on claim payment instruments (checks or EFT) issued jointly or solely to this loss payee or mortgagee.']
  payment_threshold_amount decimal(18,2) [note: 'Minimum claim payment amount above which joint payee or mortgagee co-endorsement is required per the lender agreement or loss payable clause.']
  premium_billed_to_lender boolean [note: 'Indicates whether the insurance premium is billed directly to the lender via escrow rather than to the policyholder. Drives billing system routing.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this loss payee interest record originated (e.g., PAS for PolicyCenter, MDM for Party Master).']
  source_system_ref_code varchar [note: 'Native identifier of this loss payee interest record in the originating operational system (e.g., Guidewire PolicyCenter internal ID) for lineage and reconciliation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this loss payee interest record. Used for change tracking, audit trail, and downstream incremental processing.']

  Note: 'One row per loss payee or additional interest on a policy. Links party, policy, coverage, and insured risk. Captures lender details, loan number, loss-payable clause type, and cancellation notice requirements.'
}

Table party.license {
  license_id varchar [pk, note: 'Unique surrogate identifier for a professional license record held by a party. Primary key of the license table; one row per license per party.']
  issuing_geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Producer license validation by operating territory and regulatory compliance tracking require linking licenses to issuing state geography.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Producer licenses authorize specific LOBs (personal auto, commercial property, workers compensation). Regulatory compliance requires validating agent LOB authority before binding.']
  party_id varchar [note: 'Reference to the party (person or organization) who holds this license. Links the license to the Party master record.']
  adjuster_type varchar [note: 'Sub-type of adjuster license indicating the adjuster\'s operational role. Populated only when license_type is \'adjuster\'. Drives claim assignment eligibility rules.']
  background_check_date date [note: 'Date on which the most recent background check was completed for this license. Used to determine if a re-check is required at renewal per state DOI requirements.']
  background_check_status varchar [note: 'Status of the criminal background check conducted as part of the license application or renewal process. Required by many state DOIs for producer and adjuster licensing.']
  ce_credits_completed varchar [note: 'Number of continuing education (CE) credit hours completed by the licensee in the current renewal cycle. Compared against ce_credits_required to assess compliance.']
  ce_credits_required varchar [note: 'Total number of continuing education (CE) credit hours required by the issuing state for the current renewal cycle. Varies by state and license class.']
  class varchar [note: 'Sub-classification of the license type as defined by the issuing state (e.g., Property, Casualty, Life, Health, Personal Lines, Commercial Lines). Drives appointment eligibility.']
  continuing_education_due_date date [note: 'Date by which the licensee must complete required continuing education (CE) credit hours to maintain license validity. Drives CE compliance tracking and renewal alerts.']
  contractor_license_number varchar [note: 'State-issued contractor license number for parties who are licensed contractors (e.g., restoration vendors). Populated only when license_type is \'contractor\'. Used in claims vendor management.']
  created_timestamp timestamp [note: 'Timestamp when this license record was first created in the data platform. Supports audit trail, data lineage, and GDPR/CCPA record-keeping obligations.']
  disciplinary_action_description varchar [note: 'Free-text description of any regulatory disciplinary actions, fines, or sanctions associated with this license. Populated only when disciplinary_action_indicator is True.']
  disciplinary_action_indicator boolean [note: 'Indicates whether the licensee has any regulatory disciplinary actions, fines, or sanctions on record with the issuing DOI (True) or not (False). Sourced from NIPR PDB.']
  effective_date date [note: 'Date from which this license record is considered effective in the insurer\'s systems. May differ from issue_date if the license was backdated or loaded from a historical feed.']
  errors_omissions_carrier varchar [note: 'Name of the insurance carrier providing the licensee\'s Errors and Omissions (E&O) professional liability coverage. Required for producer appointment eligibility verification.']
  errors_omissions_expiry_date date [note: 'Expiration date of the licensee\'s Errors and Omissions (E&O) professional liability policy. Drives alerts when E&O coverage is about to lapse, which may affect appointment status.']
  errors_omissions_policy_number varchar [note: 'Policy number of the licensee\'s Errors and Omissions (E&O) professional liability insurance. Verified during producer appointment and renewal processes.']
  ethics_ce_credits_completed varchar [note: 'Number of ethics-specific continuing education (CE) credit hours completed by the licensee in the current renewal cycle. Compared against ethics_ce_credits_required.']
  ethics_ce_credits_required varchar [note: 'Number of ethics-specific continuing education (CE) credit hours mandated by the issuing state within the renewal cycle. Many states require a separate ethics CE component.']
  expiry_date date [note: 'Date on which this license expires and must be renewed to remain valid. Null for licenses with no fixed expiration. Drives renewal workflow and appointment eligibility.']
  fein varchar [note: 'Federal Employer Identification Number of the licensed entity when the licensee is an organization (agency or firm). Used for tax reporting and IRS compliance.']
  is_resident_license boolean [note: 'Indicates whether this is a resident (home-state) license (True) or a non-resident license (False). Non-resident licenses are issued under reciprocity agreements.']
  issue_date date [note: 'Date on which the issuing state DOI originally granted this license. Used to calculate license tenure and continuing education (CE) cycle start.']
  issuing_state_code varchar [note: 'Two-letter US state or territory code of the Department of Insurance that issued this license (e.g., CA, TX, NY). Aligns with NAIC state coding standards.']
  license_status varchar [note: 'Current regulatory status of the license as reported by the issuing DOI or NIPR. Drives eligibility for producer appointments and claim adjuster assignments.']
  license_type varchar [note: 'Category of professional license held by the party. Distinguishes producer, adjuster, contractor, surplus lines, and other license types. [ENUM-REF-CANDIDATE: promote to reference product if types expand]']
  nipr_last_verified_date date [note: 'Date on which this license record was last verified against the NIPR Producer Database (PDB). Supports ongoing compliance monitoring and stale-data detection.']
  nipr_verification_status varchar [note: 'Result of the most recent NIPR PDB verification check for this license. \'mismatch\' indicates discrepancies between internal records and NIPR data requiring remediation.']
  notes varchar [note: 'Free-text field for underwriting or compliance notes related to this license record, such as conditions, restrictions, or manual override explanations. For internal use only.']
  npn varchar [note: 'Unique National Producer Number assigned by NIPR to identify a licensed producer across all states. Used for cross-state appointment validation and NIPR PDB lookups.']
  number varchar [note: 'Official license number assigned by the issuing state Department of Insurance (DOI) or regulatory authority. Used for NIPR validation and DOI compliance checks.']
  reciprocity_state_codes varchar [note: 'Comma-delimited list of two-letter state codes where this license is recognized under reciprocity agreements. Enables multi-state appointment eligibility without separate applications.']
  renewal_date date [note: 'Date on which the license was most recently renewed by the issuing DOI. Tracks renewal history and supports continuing education (CE) compliance monitoring.']
  resident_state_code varchar [note: 'Two-letter US state code of the licensee\'s home state of residence. Distinguishes resident licenses from non-resident licenses for NIPR and reciprocity tracking.']
  source_system_license_key varchar [note: 'Natural key or record identifier for this license in the originating source system (e.g., NIPR PDB record ID, PAS license record ID). Supports reconciliation and deduplication.']
  ssn_last4 varchar [note: 'Last four digits of the licensee\'s Social Security Number, stored for identity verification purposes only. Full SSN must not be stored per GLBA and GDPR/CCPA data minimization.']
  surplus_lines_authorized boolean [note: 'Indicates whether the licensee is authorized to place surplus lines business in the issuing state (True) or not (False). Required for non-admitted market placements.']
  surplus_lines_number varchar [note: 'State-issued surplus lines license number, distinct from the standard producer license number. Required for stamping office filings and surplus lines tax remittance.']
  termination_date date [note: 'Date on which the license was terminated, revoked, or surrendered prior to its natural expiry. Null if the license has not been terminated. Required for DOI market conduct reporting.']
  termination_reason varchar [note: 'Reason code explaining why the license was terminated or revoked. Populated only when termination_date is set. Supports regulatory and compliance reporting.']
  updated_timestamp timestamp [note: 'Timestamp when this license record was last modified in the data platform. Used for change detection, incremental ETL processing, and audit trail compliance.']

  Note: 'One row per party license (producer, adjuster, contractor). Tracks license number, type, state, effective/expiry dates, CE credits, NIPR verification, E&O coverage, and disciplinary actions.'
}

Table party.household {
  household_id varchar [pk, note: 'Primary key for household']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Personal lines territory rating and cat accumulation reporting require resolving a household\'s primary location to a geography record.']
  master_household_id varchar [note: 'Reference to the master household record if this household has been merged or is a duplicate.']
  primary_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Household needs FK to address for primary address. The household table has denormalized address fields (primary_address_line_1, primary_address_line_2, primary_city, primary_state_province']
  primary_contact_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Household needs FK to party for primary contact. The household table has primary_phone_number and primary_email_address, but these are household-level summary fields that may differ from']
  adult_count varchar [note: 'Number of adults aged 18 or older in the household, used for underwriting and rating purposes.']
  created_timestamp timestamp [note: 'Timestamp when the household record was first created in the system.']
  credit_score varchar [note: 'Insurance credit score for the household used in underwriting and rating decisions where permitted by regulation.']
  credit_score_date date [note: 'Date when the credit score was obtained or last refreshed for the household.']
  deduplication_key varchar [note: 'Composite key used for household matching and deduplication across systems and data sources.']
  dependent_count varchar [note: 'Number of dependents under age 18 in the household, used for underwriting and rating purposes.']
  do_not_contact_flag boolean [note: 'Indicates whether the household has requested no marketing or non-essential contact.']
  effective_date date [note: 'Date when this version of the household record became effective for temporal tracking.']
  established_date date [note: 'Date when the household was first established as a customer or prospect in the system.']
  expiration_date date [note: 'Date when this version of the household record expires or is superseded, null if current.']
  first_policy_effective_date date [note: 'Date when the first policy for this household became effective, used for tenure and loyalty analysis.']
  household_name varchar [note: 'Primary display name for the household, typically derived from the primary policyholder or head of household.']
  household_number varchar [note: 'Business-facing unique household identifier used in customer communications and policy documents.']
  household_status varchar [note: 'Current lifecycle status of the household record in the system.']
  household_type varchar [note: 'Classification of the household structure for underwriting and risk segmentation purposes.']
  kyc_verification_date date [note: 'Date when the most recent KYC verification was completed for the household.']
  kyc_verification_status varchar [note: 'Status of identity verification and anti-money laundering checks for the household.']
  last_contact_date date [note: 'Date of the most recent interaction or communication with the household.']
  last_modified_timestamp timestamp [note: 'Timestamp when the household record was last updated or modified.']
  marketing_opt_in_flag boolean [note: 'Indicates whether the household has consented to receive marketing communications.']
  member_count varchar [note: 'Total number of individuals associated with this household for underwriting and risk assessment.']
  paperless_delivery_flag boolean [note: 'Indicates whether the household has elected to receive policy documents and communications electronically.']
  primary_email_address varchar [note: 'Primary email address for household communications and policy correspondence.']
  primary_language_code varchar [note: 'Two-letter ISO language code representing the preferred communication language for the household.']
  primary_phone_number varchar [note: 'Primary contact telephone number for the household in E.164 format.']
  source_system_code varchar [note: 'Code identifying the originating system or channel where the household record was created.']

  Note: 'One row per household grouping of parties. Effective-dated with member count, credit score, CAT zone, territory, and marketing preferences. Supports household-level underwriting and customer analytics.'
}

Table policy.policy {
  policy_id varchar [pk, note: 'Unique system identifier for the policy. Primary key. One row per policy.']
  agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Agency-level book-of-business reporting, contingent commission calculations, and agency performance management require direct policy-to-agency attribution.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Underwriting accumulation management and reinsurance treaty attachment require linking each policy to its cat zone.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Policy issuance and premium booking require the governing commission schedule for producer compensation calculation and finance reconciliation.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Policies issued in multiple currencies require currency master reference for FX conversion, financial consolidation, and multi-currency premium reporting.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Distribution channel governs commission rates, regulatory surplus-lines filing requirements, and market segmentation reporting at the policy level.']
  household_id varchar [note: 'Foreign key linking to party.household. Business justification: Personal lines insurers aggregate all policies under a household for cross-sell, retention scoring, and multi-policy discount pricing.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Policy-level LOB classification drives Schedule P reporting, NAIC annual statement filings, and underwriting appetite controls.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Policy-level territory assignment is used for premium rating, state regulatory reporting, and producer appointment validation.']
  type_id varchar [note: 'Foreign key linking to policy.policy_type. Business justification: Policy.type (STRING) currently stores policy type codes inline. Normalizing to policy_type reference table eliminates redundancy and enables centralized management of policy type']
  underwriting_authority_id varchar [note: 'Foreign key linking to producers.underwriting_authority. Business justification: E&O compliance and binding authority audits require recording which underwriting authority was in effect when a policy was bound.']
  auto_renew_flag boolean [note: 'Flag indicating whether the policy is set to automatically renew at expiration. True if auto-renew enabled.']
  billing_method varchar [note: 'Method by which premium is billed: direct bill, agency bill, list bill, or account current.']
  binding_date date [note: 'Date the policy was bound and coverage became contractually obligated.']
  cancellation_date date [note: 'Date the policy was cancelled, if applicable. Null if policy has not been cancelled.']
  cancellation_reason_code varchar [note: 'Reason for policy cancellation: non-payment, insured request, underwriting decision, fraud, material change, or non-renewal.']
  carrier_code varchar [note: 'Identifier for the insurance carrier or legal entity issuing the policy.']
  commission_rate decimal(5,2) [note: 'Commission rate percentage paid to the producer on this policy. Expressed as a percentage.']
  created_timestamp timestamp [note: 'Timestamp when the policy record was first created in the system.']
  effective_date date [note: 'Date from which the current policy version or transaction is in force. Used for effective dating and loss date reconstruction.']
  expiration_date date [note: 'Date the policy contract expires or is scheduled to expire. End of the current term.']
  facultative_flag boolean [note: 'Flag indicating whether facultative reinsurance was placed for this policy. True if facultative coverage exists.']
  form_code varchar [note: 'ISO or proprietary form code identifying the base policy contract form.']
  inception_date date [note: 'Date the policy contract first becomes effective. Start of the initial term.']
  issue_date date [note: 'Date the policy documents were issued to the policyholder.']
  last_modified_timestamp timestamp [note: 'Timestamp when the policy record was last modified in the system.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the legal entity issuing the policy.']
  non_renewal_notice_date date [note: 'Date non-renewal notice was sent to the policyholder, if applicable. Null if policy is renewing.']
  non_renewal_reason_code varchar [note: 'Reason for non-renewal: underwriting decision, loss history, non-payment, program exit, or regulatory requirement.']
  number varchar [note: 'Externally-known unique policy number assigned at issuance. Business identifier for the contract.']
  payment_plan_code varchar [note: 'Premium payment plan selected by the policyholder: full pay, monthly, quarterly, or semi-annual.']
  policy_status varchar [note: 'Current lifecycle status of the policy contract. [ENUM-REF-CANDIDATE: draft|quoted|bound|in_force|cancelled|expired|non_renewed — 7 candidates stripped; promote to reference product]']
  prior_policy_number varchar [note: 'Policy number of the prior term if this is a renewal or rewrite. Null for new business.']
  producer_code varchar [note: 'Identifier for the producer (agent or broker) who sold the policy.']
  program_code varchar [note: 'Internal program or product line identifier under which the policy is written.']
  quote_date date [note: 'Date the initial quote was generated for this policy.']
  reinsurance_treaty_code varchar [note: 'Identifier for the reinsurance treaty under which this policy is ceded, if applicable.']
  renewal_indicator boolean [note: 'Flag indicating whether this policy is a renewal of a prior term. True if renewal, false if new business.']
  risk_score decimal(5,2) [note: 'Numeric risk score assigned by underwriting or rating engine. Higher score indicates higher risk.']
  state_code varchar [note: 'Two-letter US state code where the policy is domiciled and regulated.']
  submission_date date [note: 'Date the risk submission was received for underwriting evaluation.']
  term_months varchar [note: 'Length of the policy term in months. Typically 12 for annual policies, 6 for semi-annual.']
  total_insured_value decimal(15,2) [note: 'Total insured value across all coverages and insured risks on the policy. Sum of all limits.']
  underwriting_tier varchar [note: 'Risk tier assigned during underwriting: preferred, standard, non-standard, or declined.']
  written_premium_amount decimal(15,2) [note: 'Total written premium for the policy term. Gross premium before adjustments.']

  Note: 'One row per policy. Master policy record anchoring the full lifecycle. Carries policy number, status, effective/expiration dates, LOB, state, and carrier. FK lineage: Party -> Policy -> Policy Term -> Coverage.'
}

Table policy.term {
  term_id varchar [pk, note: 'Unique identifier for the policy term. Primary key. One row per policy per term.']
  agency_id varchar [note: 'Foreign key to the agency representing the producer. Used for agency-level commission and reporting.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Policy terms must map to accounting periods for premium earning calculations, reserve valuations, and GAAP/SAP financial statement preparation.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Policy terms track written premium in transaction currency—FK to currency master required for FX conversion to functional currency, multi-currency financial reporting, and consolidation.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Distribution channel can change at renewal (e.g., direct to agency). Term-level channel tracking is required for renewal performance reporting and commission schedule selection']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Policy terms require geography linkage for underwriting territory assignment, rate filing compliance by jurisdiction, exposure aggregation for catastrophe modeling, and']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Policy term is the grain for earned premium and loss ratio reporting by LOB in NAIC Schedule P and statutory filings.']
  loss_event_id varchar [note: 'Foreign key linking to claims.loss_event. Business justification: Loss events occur during policy terms; underwriting renewal decisions, loss ratio analysis, and experience rating require linking loss history to the term in force at loss occurrence date.']
  party_id varchar [note: 'Foreign key to the underwriter who approved this term. Links to party role for underwriter.']
  policy_id varchar [note: 'Foreign key to the parent policy. Links this term to the overarching policy lifecycle.']
  prior_term_id varchar [note: 'Foreign key to the immediately preceding term. Null for new business, populated for renewals.']
  producers_producer_id varchar [note: 'Foreign key to the producer who sold this term. Links to producer for commission calculation.']
  quote_id varchar [note: 'Foreign key linking to coverage.quote. Business justification: Each policy term is the direct product of binding a specific quote. Renewal pricing, re-rating audits, and regulatory rate filings require linking the term to the quote that produced it.']
  type_id varchar [note: 'Foreign key linking to policy.policy_type. Business justification: Term.product_code and product_name currently store policy type information redundantly at the term level.']
  accident_year varchar [note: 'Accident year for loss reserving and IBNR calculation. Derived from term effective date.']
  accounting_date date [note: 'Date when the term was recorded in the accounting system. Used for financial reporting cutoffs.']
  billing_method varchar [note: 'Method by which premium is billed and collected. Determines billing workflow and commission settlement.']
  bound_date date [note: 'Date when the term was bound and coverage became contractually effective.']
  calendar_year varchar [note: 'Calendar year for statutory and financial reporting. Derived from term effective date.']
  cancellation_date date [note: 'Date when the term was cancelled. Null if term was not cancelled. Used for earned premium calculation.']
  cancellation_reason_code varchar [note: 'Code indicating the reason for term cancellation. Examples: non-payment, insured request, underwriting.']
  cancellation_type varchar [note: 'Type of cancellation determining premium return calculation. Flat, short-rate, or pro-rata.']
  created_timestamp timestamp [note: 'Timestamp when this term record was first created in the system. Audit trail for data lineage.']
  duration_days varchar [note: 'Number of days between term effective and expiration dates. Typically 365 for annual policies.']
  effective_date date [note: 'Date when this policy term becomes effective and coverage begins.']
  expiration_date date [note: 'Date when this policy term expires and coverage ends. Nullable for open-ended terms.']
  inception_date date [note: 'Original inception date of the first term of the policy. Carried forward across all renewals.']
  is_renewal boolean [note: 'Indicates whether this term is a renewal of a prior term. False for new business, true for renewals.']
  issued_date date [note: 'Date when the policy documents for this term were issued to the insured.']
  last_modified_timestamp timestamp [note: 'Timestamp when this term record was last updated. Audit trail for change tracking.']
  non_renewal_notice_date date [note: 'Date when non-renewal notice was sent to the insured. Required by state law for non-renewals.']
  non_renewal_reason_code varchar [note: 'Code indicating the reason for non-renewal. Must comply with state-specific non-renewal regulations.']
  number varchar [note: 'Sequential term number within the policy lifecycle. First term is 1, increments with each renewal.']
  payment_plan_code varchar [note: 'Code identifying the premium payment plan. Examples: annual, semi-annual, quarterly, monthly.']
  policy_year varchar [note: 'Policy year for actuarial and loss reserving analysis. Derived from term effective date.']
  rate_effective_date date [note: 'Effective date of the rate table used to price this term. Required for regulatory rate filings.']
  rate_version varchar [note: 'Version identifier of the rating algorithm used to price this term. Enables rate change analysis.']
  reinstatement_date date [note: 'Date when a cancelled term was reinstated. Null if term was never reinstated.']
  renewal_accepted_date date [note: 'Date when the insured accepted the renewal offer. Null if renewal was not accepted.']
  renewal_offer_date date [note: 'Date when renewal offer was extended to the insured. Used for renewal cycle tracking.']
  renewal_type varchar [note: 'Classification of the renewal process. Indicates whether renewal was automatic, manual, or conditional.']
  term_status varchar [note: 'Current lifecycle status of the policy term. Indicates whether the term is active, expired, or cancelled.']
  underwriting_company_code varchar [note: 'NAIC company code of the insurer underwriting this term. Used for statutory reporting.']
  underwriting_company_name varchar [note: 'Legal name of the insurance company underwriting this term.']
  written_premium_amount decimal(18,2) [note: 'Total written premium for this term. Represents the full premium charged for the term period.']

  Note: 'One row per policy per term. Time-bounded period of a policy (annual, short-rate, etc.). Enables reconstruction of coverages and premium in force at any date including loss date. Links Policy to Coverage via Coverage table.'
}

Table policy.policy_transaction {
  policy_transaction_id varchar [pk, note: 'Unique identifier for the policy transaction. Primary key. One row per transaction event applied to a policy term.']
  accounting_period_id varchar [note: 'Foreign key linking to claimfinancials.accounting_period. Business justification: Every policy transaction (new business, endorsement, cancellation, reinstatement) must be booked to an accounting period for written/earned premium accounting, statutory']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Post-catastrophe moratoriums, reinstatements, and cancellation holds are policy transactions triggered by specific cat events.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Endorsement and cancellation transactions generate commission impacts (commission_impact_amount).']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Transactions record premium changes in transaction currency—FK to currency master enables FX translation for accounting entries, multi-currency GL posting, and audit trails.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Surplus lines regulatory filings and commission impact calculations on transactions depend on distribution channel.']
  insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Endorsement processing and regulatory audit trails require recording which insured risk was added, removed, or modified by each policy transaction.']
  party_id varchar [note: 'Reference to the underwriter who approved or processed this transaction. Links to party role for audit and workflow tracking.']
  policy_id varchar [note: 'Reference to the parent policy contract. Links this transaction to the overarching policy lifecycle.']
  policy_term_id varchar [note: 'Reference to the specific policy term period affected by this transaction.']
  primary_prior_transaction_policy_transaction_id varchar [note: 'Reference to the immediately preceding transaction in the policy lifecycle. Enables transaction chain reconstruction.']
  producers_producer_id varchar [note: 'Reference to the producer or agent of record at the time of this transaction. Used for commission calculation and distribution tracking.']
  quote_id varchar [note: 'Foreign key linking to coverage.quote. Business justification: Endorsement and mid-term change transactions originate from re-quotes. Linking the transaction to its driving quote supports endorsement premium audit, commission recalculation, and regulatory']
  uw_decision_id varchar [note: 'Foreign key linking to coverage.uw_decision. Business justification: Transactions requiring underwriting approval (endorsements, reinstatements) must reference the authorizing UW decision for authority-level audit and E&O compliance.']
  accounting_date date [note: 'Date when the transaction is recognized for accounting and statutory reporting purposes. May differ from effective and processed dates.']
  approved_timestamp timestamp [note: 'Date and time when the transaction was approved. Distinct from processed and effective timestamps.']
  cancellation_basis varchar [note: 'Legal or business basis for cancellation. Determines regulatory notice requirements and return premium method. Null for non-cancellation transactions.']
  cancellation_type_code varchar [note: 'Method used to calculate return premium for cancellations: flat (no return), short_rate (penalty), pro_rata (proportional). Null for non-cancellation transactions.']
  commission_impact_amount decimal(15,2) [note: 'Net change in producer commission resulting from this transaction. Used for commission settlement and payables.']
  created_timestamp timestamp [note: 'Date and time when this transaction record was first created in the system. Audit trail for record lifecycle.']
  document_reference_number varchar [note: 'Reference to the generated policy document, declarations page, or endorsement form associated with this transaction.']
  effective_date date [note: 'Date when the transaction becomes effective and changes take effect on the policy. Critical for loss date reconstruction.']
  endorsement_description varchar [note: 'Business description of the endorsement changes. Summarizes coverage, limit, or risk modifications. Null for non-endorsement transactions.']
  endorsement_form_number varchar [note: 'ISO or proprietary form number attached to this endorsement transaction. Null for non-endorsement transactions.']
  expiration_date date [note: 'Date when the transaction or its effects expire. Applicable for term-bounded endorsements or temporary changes.']
  is_backdated_flag boolean [note: 'Indicates whether the effective date is prior to the processed date. Used for audit and compliance monitoring.']
  is_midterm_flag boolean [note: 'Indicates whether this transaction occurred mid-term (between policy inception and expiration). True for endorsements, cancellations, reinstatements.']
  is_renewal_flag boolean [note: 'Indicates whether this transaction represents a policy renewal. True for REN transaction type, false otherwise.']
  issued_timestamp timestamp [note: 'Date and time when the transaction was issued and documents were generated. Marks final commitment.']
  last_modified_timestamp timestamp [note: 'Date and time when this transaction record was last updated. Audit trail for record lifecycle.']
  policy_year varchar [note: 'Policy year in which this transaction occurred. Used for loss ratio analysis and actuarial reserving by policy year cohort.']
  processed_date date [note: 'Date when the transaction was processed and recorded in the system. May differ from effective date.']
  reason_code varchar [note: 'Standardized code indicating the business reason for the transaction. Type-specific: endorsement reason, cancellation cause, reinstatement justification.']
  reason_description varchar [note: 'Detailed narrative explanation of why the transaction was initiated. Supplements the reason code with context.']
  regulatory_filing_date date [note: 'Date when regulatory filing was submitted. Null if no filing required or not yet filed.']
  regulatory_filing_required_flag boolean [note: 'Indicates whether this transaction requires filing with state Department of Insurance or other regulatory body.']
  reinstatement_lapse_days varchar [note: 'Number of days the policy was lapsed before reinstatement. Used for underwriting and pricing adjustments. Null for non-reinstatement transactions.']
  reinsurance_cession_required_flag boolean [note: 'Indicates whether this transaction triggers reinsurance cession under treaty or facultative agreements.']
  requires_underwriting_review_flag boolean [note: 'Indicates whether this transaction triggered underwriting referral or manual review based on risk appetite rules.']
  source_system_code varchar [note: 'Code identifying the originating system for this transaction. Supports multi-system integration and data lineage.']
  transaction_number varchar [note: 'Business-facing transaction number displayed on declarations pages and endorsements. Externally visible identifier.']
  transaction_status varchar [note: 'Current workflow status of the transaction. Tracks progression from draft through issuance or reversal.']
  type_code varchar [note: 'Governed enumeration of the policy transaction type. Allowed values: New Business, Renewal, Endorsement, Cancellation, Reinstatement, Non-renewal. Satisfies VREQ-003.']
  voided_reason_code varchar [note: 'Standardized code indicating why the transaction was voided. Null for active transactions.']
  voided_timestamp timestamp [note: 'Date and time when the transaction was voided or reversed. Null for active transactions.']
  written_premium_change_amount decimal(15,2) [note: 'Net change in written premium resulting from this transaction. Positive for increases, negative for returns. Used for premium accounting and statutory reporting.']

  Note: 'One row per policy transaction. Records every lifecycle event: New Business, Renewal, Endorsement, Cancellation, Reinstatement, Non-renewal. Effective-dated so in-force state is reconstructable at any point in time.'
}

Table policy.policyholder {
  policyholder_id varchar [pk, note: 'Unique identifier for the policyholder data product (auto-inserted during validation).']
  party_id varchar [note: 'Reference to the party acting as policyholder or named insured on this policy.']
  policy_id varchar [note: 'Reference to the policy contract to which this policyholder is associated.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Policyholders can change by term (named insured changes on renewal, ownership transfers). The effective_date and expiration_date attributes on policyholder indicate term-level tracking is needed.']
  policyholder_policy_transaction_id varchar [note: 'Reference to the policy transaction that added this policyholder to the policy.']
  policyholder_removed_by_transaction_policy_transaction_id varchar [note: 'Reference to the policy transaction that removed this policyholder from the policy. Null if still active.']
  role_id varchar [note: 'Reference to the specific party role record capturing the policyholder relationship with effective dates.']
  billing_responsibility_flag boolean [note: 'Indicates whether this policyholder is responsible for premium payment. True if responsible, false otherwise.']
  cancellation_reason_code varchar [note: 'Code indicating the reason this policyholder association was cancelled or removed from the policy.']
  certificate_holder_flag boolean [note: 'Indicates whether this party should receive a Certificate of Insurance. True if certificate holder, false otherwise.']
  created_timestamp timestamp [note: 'Date and time when this policyholder record was first created in the system.']
  effective_date date [note: 'Date when this policyholder association becomes active and binding on the policy contract.']
  expiration_date date [note: 'Date when this policyholder association ends. Null for open-ended associations.']
  holder_sequence varchar [note: 'Ordinal position of this policyholder within the policy, used for display and reporting order.']
  holder_type varchar [note: 'Classification of the policyholder role on the policy contract.']
  interest_type varchar [note: 'Nature of the insurable interest this party holds in the covered risk or property. [ENUM-REF-CANDIDATE: Owner|Lessee|Mortgagee|Lienholder|Bailee|Trustee|Other — 7 candidates stripped; promote to reference product]']
  is_primary_insured boolean [note: 'Indicates whether this party is the primary named insured on the policy. True if primary, false otherwise.']
  loan_number varchar [note: 'Loan or mortgage account number associated with this policyholder when acting as mortgagee or lienholder.']
  loss_payable_clause_type varchar [note: 'Type of loss payable clause governing payment priority and rights for this policyholder.']
  mailing_address_same_as_primary_flag boolean [note: 'Indicates whether this policyholder uses the same mailing address as the primary insured. True if same, false otherwise.']
  modified_timestamp timestamp [note: 'Date and time when this policyholder record was last modified in the system.']
  notice_required_flag boolean [note: 'Indicates whether this party must receive policy notices such as cancellation or non-renewal. True if required, false otherwise.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership or interest this policyholder has in the insured risk. Null if not applicable.']
  policyholder_status varchar [note: 'Current lifecycle status of this policyholder association on the policy contract.']
  rank_order varchar [note: 'Priority ranking for loss payment when multiple loss payees or mortgagees exist. Lower numbers indicate higher priority.']
  relationship_to_primary varchar [note: 'Nature of the relationship between this policyholder and the primary named insured. [ENUM-REF-CANDIDATE: Spouse|Domestic Partner|Child|Parent|Sibling|Business Partner|Landlord|Tenant|Contractor|Vendor|Other — 11 candidates stripped; promote to reference']
  remarks varchar [note: 'Free-form notes or special instructions related to this policyholder association.']
  waiver_of_subrogation_flag boolean [note: 'Indicates whether the insurer has waived subrogation rights against this party. True if waived, false otherwise.']

  Note: 'One row per party-policy holder assignment. Links party.role to a policy and term with effective dating, holder type, interest type, billing responsibility, and waiver of subrogation. Supports multiple named insureds.'
}

Table policy.interest {
  interest_id varchar [pk, note: 'Unique identifier for the additional interest record. Primary key.']
  building_id varchar [note: 'Foreign key linking to riskexposure.building. Business justification: Commercial property mortgagees and loss payees attach at building-level granularity for multi-building locations.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Loss payees, mortgagees, and additional insureds attach to specific coverages (e.g., a lender on auto physical damage only).']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: Certificate of insurance issuance and loss payee notification workflows require tracking mortgagee/lienholder interests at the location level (e.g., blanket interests covering all']
  party_id varchar [note: 'Reference to the party who holds this interest on the policy.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: policy_interest already links to term (which carries policy_id), but all peer child tables (line, fee, state_reg, policy_document, policyholder) carry a direct policy_id for efficient']
  policy_term_id varchar [note: 'Reference to the policy term to which this interest is attached.']
  primary_policy_transaction_id varchar [note: 'Reference to the policy transaction that added this interest to the policy term.']
  property_risk_id varchar [note: 'Foreign key linking to riskexposure.property_risk. Business justification: Mortgagees, loss payees, and additional insureds attach to specific commercial properties for loss payment routing, subrogation waiver, and certificate issuance.']
  vehicle_id varchar [note: 'Foreign key linking to riskexposure.vehicle. Business justification: Lienholders and lessors attach to specific financed or leased vehicles for loss payee endorsements and total loss settlement.']
  address_line_1 varchar [note: 'Primary street address of the interest holder for certificate mailing and notification purposes.']
  address_line_2 varchar [note: 'Secondary address line for suite, unit, or building information.']
  blanket_additional_insured_flag boolean [note: 'Indicates whether the interest is covered under a blanket additional insured endorsement.']
  certificate_issue_date date [note: 'Date the certificate of insurance was issued to the interest holder.']
  certificate_number varchar [note: 'Certificate number issued to the interest holder as evidence of coverage.']
  city varchar [note: 'City of the interest holder\'s mailing address.']
  contact_email varchar [note: 'Email address for the interest holder contact for certificate delivery and notifications.']
  contact_name varchar [note: 'Name of the primary contact person at the interest holder organization for policy and certificate matters.']
  contact_phone varchar [note: 'Primary phone number for the interest holder contact.']
  country_code varchar [note: 'Three-letter ISO country code for the interest holder\'s address.']
  coverage_scope varchar [note: 'Description of the scope of coverage provided to the interest holder, including any limitations or conditions.']
  created_timestamp timestamp [note: 'Timestamp when this interest record was first created in the system.']
  effective_date date [note: 'Date when the interest becomes effective on the policy term.']
  endorsement_form_number varchar [note: 'ISO or carrier-specific form number of the endorsement that adds this interest to the policy.']
  expiration_date date [note: 'Date when the interest expires or is removed from the policy term. Nullable for open-ended interests.']
  last_modified_timestamp timestamp [note: 'Timestamp when this interest record was last updated.']
  loan_number varchar [note: 'Loan or mortgage account number associated with the interest, typically for mortgagees or lienholders.']
  notification_days varchar [note: 'Number of days advance notice required for policy changes or cancellations, typically 10, 30, or 60 days.']
  notification_required_flag boolean [note: 'Indicates whether the interest holder must be notified of policy changes, cancellations, or non-renewals.']
  policy_interest_name varchar [note: 'Full legal name of the party holding the interest as it appears on the policy or certificate.']
  policy_interest_status varchar [note: 'Current lifecycle status of the interest on the policy.']
  postal_code varchar [note: 'Postal or ZIP code for the interest holder\'s mailing address.']
  primary_noncontributory_flag boolean [note: 'Indicates whether coverage is primary and non-contributory with respect to the interest holder\'s own insurance.']
  rank_order varchar [note: 'Priority ranking of the interest for loss payment purposes. Lower numbers indicate higher priority.']
  remarks varchar [note: 'Free-form notes or special instructions related to the interest holder, coverage requirements, or certificate issuance.']
  state_province_code varchar [note: 'Two-letter state or province code for the interest holder\'s address.']
  type_code varchar [note: 'Type of interest: Additional Insured (AI), Loss Payee (LP), Mortgagee (MORT), Lienholder (LIEN), Lessor, Trustee.']
  waiver_of_subrogation_flag boolean [note: 'Indicates whether the insurer has waived subrogation rights against the interest holder.']

  Note: 'One row per additional interest on a policy term (mortgagee, lienholder, certificate holder). Links party, policy term, and insured risk with effective dating, coverage scope, and notification requirements.'
}

Table policy.form {
  form_id varchar [pk, note: 'Unique identifier for the policy form attachment record. Primary key.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Endorsement and exclusion forms attach to specific coverages, not just the policy. Regulatory form filing, claims coverage determination, and ISO form tracking all require the']
  document_id varchar [note: 'Reference to the physical or digital document storage location for the form PDF or image.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: ISO and state-specific forms are organized and filed by LOB. Form attachment validation, regulatory form filing, and form library management all require LOB classification.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: policy_form links to term and policy_document but lacks a direct policy_id FK. Every other child table in this domain (line, fee, state_reg, policy_document, policyholder) carries a direct']
  policy_term_id varchar [note: 'Reference to the policy term to which this form is attached.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Forms are attached to a policy via a specific transaction (New Business, Endorsement, Renewal).']
  acord_form_flag boolean [note: 'Indicates whether this is a standard ACORD form (true) or not (false).']
  approval_date date [note: 'The date the form was approved by the state Department of Insurance for use.']
  attachment_reason_code varchar [note: 'Coded reason for attaching this form: regulatory requirement, risk mitigation, customer request, underwriting referral, rate modification, or coverage enhancement.']
  attachment_sequence varchar [note: 'The order in which this form is attached to the policy term, used for precedence and document assembly.']
  created_timestamp timestamp [note: 'The date and time this form attachment record was first created in the system.']
  edition_date date [note: 'The edition date of the form as published by ISO or the carrier, indicating the version in use.']
  effective_date date [note: 'The date this form attachment becomes effective on the policy term.']
  expiration_date date [note: 'The date this form attachment expires or is removed from the policy term. Null if still in force.']
  filing_number varchar [note: 'The state Department of Insurance filing number or SERFF tracking number for this form.']
  form_category varchar [note: 'High-level category of the form indicating the major coverage area it addresses. [ENUM-REF-CANDIDATE: coverage|liability|property|auto|workers_comp|umbrella|inland_marine|crime|professional_liability — 9 candidates stripped; promote to reference product]']
  form_description varchar [note: 'Detailed description of the coverage, exclusion, or condition provided by this form.']
  form_name varchar [note: 'The full descriptive name of the form (e.g., Homeowners 3 Special Form, Commercial General Liability Coverage Form).']
  form_number varchar [note: 'The ISO or ACORD form number identifying the specific form or endorsement (e.g., HO-3, CA 00 01, CG 00 01).']
  form_status varchar [note: 'Current status of the form attachment: active, superseded by a newer edition, withdrawn, or pending approval.']
  form_type varchar [note: 'Classification of the form: base policy form, endorsement, exclusion, condition, declaration page, schedule, or certificate of insurance. [ENUM-REF-CANDIDATE: base|endorsement|exclusion|condition|declaration|schedule|certificate — 7 candidates stripped']
  iso_form_flag boolean [note: 'Indicates whether this is a standard ISO form (true) or a carrier-proprietary form (false).']
  language varchar [note: 'The language in which the form is written (e.g., English, Spanish, French).']
  mandatory_flag boolean [note: 'Indicates whether this form is mandatory per state filing or carrier underwriting rules (true) or optional (false).']
  modified_timestamp timestamp [note: 'The date and time this form attachment record was last modified.']
  premium_amount decimal(15,2) [note: 'The additional premium amount charged for this form attachment, if premium-bearing.']
  premium_bearing_flag boolean [note: 'Indicates whether this form attachment carries an additional premium charge (true) or is included at no charge (false).']
  state_code varchar [note: 'Two-letter state code where this form is filed and approved for use (e.g., CA, TX, NY).']
  superseded_by_form_number varchar [note: 'The form number that supersedes this form, if the form has been replaced by a newer edition.']
  transaction_effective_date date [note: 'The effective date of the policy transaction that attached or modified this form.']
  transaction_type varchar [note: 'The policy transaction type that triggered this form attachment (NB, REN, END, CAN, RI).']
  underwriter_notes varchar [note: 'Free-text notes from the underwriter regarding the reason for attaching this form or special considerations.']
  version varchar [note: 'Internal version identifier for carrier-proprietary forms, tracking revisions and updates.']

  Note: 'One row per form attached to a policy term. Tracks ISO/ACORD form number, edition date, state filing, mandatory flag, premium-bearing flag, and attachment sequence. Links to policy document for the physical artifact.'
}

Table policy.line {
  line_id varchar [pk, note: 'Primary key for line']
  line_of_business_id varchar [pk, note: 'Unique identifier for the line of business within a policy term. Primary key.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Per-LOB cat zone assignment drives line-level accumulation tracking, reinsurance cession calculations, and bordereaux reporting.']
  insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Underwriting premium allocation and exposure aggregation reports require linking each coverage line directly to the insured risk it rates against.']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: Catastrophe exposure aggregation and PML reporting require summing written premium and TIV by location.']
  party_id varchar [note: 'Foreign key to the underwriter who evaluated and approved this line of business.']
  policy_id varchar [note: 'Foreign key to the parent policy record.']
  policy_term_id varchar [note: 'Foreign key to the policy term under which this line of business is written.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Line records are created and modified by policy transactions (NB creates lines, endorsements modify coverage/limits/premium).']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Territory drives rating loss costs, base rates, and regulatory rate filings at the line-of-business level.']
  aal_amount decimal(18,2) [note: 'Average annual loss amount for this line of business based on catastrophe modeling.']
  ceded_percentage decimal(5,2) [note: 'Percentage of premium and risk ceded to reinsurers for this line of business under quota share treaties.']
  coinsurance_percentage decimal(5,2) [note: 'Coinsurance percentage applicable to this line of business, representing the insureds share of covered losses.']
  created_timestamp timestamp [note: 'Timestamp when this line of business record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'Standard deductible amount applicable to this line of business. May be overridden at coverage or risk level.']
  endorsements_attached varchar [note: 'Comma-separated list of endorsement form numbers modifying coverage for this line of business.']
  experience_mod_factor decimal(5,4) [note: 'Experience modification factor applied to adjust premium based on the insureds historical loss experience. Common in Workers Compensation and Commercial Auto.']
  forms_attached varchar [note: 'Comma-separated list of ISO or proprietary form numbers attached to this line of business.']
  last_modified_timestamp timestamp [note: 'Timestamp when this line of business record was last modified.']
  lob_code varchar [note: 'Standard code identifying the line of business. Examples: HO (Homeowners), PAP (Personal Auto Policy), CGL (Commercial General Liability), WC (Workers Compensation), BOP (Business Owners Policy).']
  lob_effective_date date [note: 'Date when this line of business coverage becomes effective within the policy term.']
  lob_expiration_date date [note: 'Date when this line of business coverage expires within the policy term.']
  lob_name varchar [note: 'Full descriptive name of the line of business.']
  lob_status varchar [note: 'Current lifecycle status of this line of business within the policy term.']
  loss_ratio_target decimal(5,2) [note: 'Target loss ratio for this line of business used in pricing and profitability analysis.']
  naic_lob_code varchar [note: 'NAIC statutory reporting code for the line of business used in Schedule P and statutory financial statements.']
  naics_code varchar [note: 'NAICS code for the insured business or risk under this line of business.']
  package_discount_percentage decimal(5,2) [note: 'Discount percentage applied to this line of business when written as part of a package policy.']
  package_indicator boolean [note: 'Indicates whether this line of business is part of a multi-line package policy such as CPP or BOP.']
  pml_amount decimal(18,2) [note: 'Probable maximum loss amount for this line of business under catastrophe scenarios.']
  policy_limit_amount decimal(18,2) [note: 'Maximum aggregate limit of liability for this line of business across all coverages within the policy term.']
  premium_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the written premium amount.']
  program_code varchar [note: 'Internal program or product offering code under which this line of business is written. Used for rate table and underwriting rule selection.']
  program_name varchar [note: 'Descriptive name of the program or product offering.']
  rate_basis varchar [note: 'Unit of measure used as the basis for premium rating. Examples: per $1000 of coverage, per vehicle, per employee, per square foot.']
  rate_factor decimal(10,6) [note: 'Base rate factor applied to the rate basis to calculate premium for this line of business.']
  reinsurance_treaty_code varchar [note: 'Code identifying the reinsurance treaty under which this line of business is ceded.']
  retention_amount decimal(18,2) [note: 'Self-insured retention amount for this line of business, applicable before policy coverage attaches.']
  schedule_credit_percentage decimal(5,2) [note: 'Underwriter-applied schedule credit percentage for this line of business based on risk characteristics.']
  schedule_debit_percentage decimal(5,2) [note: 'Underwriter-applied schedule debit percentage for this line of business based on adverse risk characteristics.']
  sic_code varchar [note: 'Standard Industrial Classification code for the insured business or risk under this line of business.']
  sub_line_code varchar [note: 'Sub-line or product variant code within the primary line of business for granular classification.']
  sub_line_name varchar [note: 'Descriptive name of the sub-line or product variant.']
  tiv_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the total insured value amount.']
  total_insured_value_amount decimal(18,2) [note: 'Total insured value or sum insured for all risks covered under this line of business. Used for catastrophe exposure aggregation and PML modeling.']
  underwriting_tier varchar [note: 'Underwriting tier assigned to this line of business based on risk evaluation.']
  written_premium_amount decimal(18,2) [note: 'Total written premium amount for this line of business within the policy term. Used for statutory Schedule P reporting and premium allocation.']

  Note: 'One row per line of business per policy term. Captures LOB-level underwriting attributes: TIV, policy limit, deductible, rate factor, reinsurance treaty, CAT zone, and written premium. Child of policy term.'
}

Table policy.policy_producer {
  policy_producer_id varchar [pk, note: 'Unique identifier for the policy producer association record.']
  agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Commission statements and agency performance reports require knowing which agency each policy_producer record belongs to.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Commission statement reconciliation requires knowing which schedule governs each producer-policy relationship.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: The producer-policy relationship is channel-specific (e.g., independent agent vs. direct).']
  license_id varchar [note: 'Foreign key linking to party.license. Business justification: Regulatory compliance requires verifying the writing producer held an active, state-appropriate license at policy binding. State DOI audits and E&O reviews depend on this link.']
  policy_id varchar [note: 'Foreign key to the policy record this producer is associated with.']
  policy_term_id varchar [note: 'Foreign key to the specific policy term this producer association applies to.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Producer assignments on a policy are created or modified by specific lifecycle transactions (New Business binding, mid-term endorsement adding a co-producer, cancellation removing a']
  producer_appointment_id varchar [note: 'Foreign key linking to producers.producer_appointment. Business justification: State DOI regulatory audits require insurers to verify that the producer held a valid carrier appointment when each policy was written.']
  producers_producer_id varchar [note: 'Foreign key to the producer party record representing the agent or broker.']
  appointment_date date [note: 'Date the producer was appointed by the carrier to sell this line of business.']
  appointment_status varchar [note: 'Current status of the producers appointment with the carrier for this policy.']
  commission_payable_flag boolean [note: 'Indicates whether commission is payable to this producer for this policy.']
  commission_rate decimal(5,2) [note: 'Base commission rate percentage applied to premium for this producer.']
  contact_name varchar [note: 'Name of the individual producer or primary contact at the agency for this policy.']
  contingent_commission_eligible_flag boolean [note: 'Indicates whether this producer is eligible for contingent or profit-sharing commission on this policy.']
  created_timestamp timestamp [note: 'Timestamp when this policy producer association record was first created in the system.']
  effective_date date [note: 'Date when this producer association became effective for the policy.']
  email varchar [note: 'Primary email address for the producer contact for policy communications.']
  eo_coverage_verified_flag boolean [note: 'Indicates whether the producers E&O insurance coverage has been verified for this policy.']
  eo_expiration_date date [note: 'Expiration date of the producers E&O insurance coverage.']
  eo_policy_number varchar [note: 'Policy number of the producers E&O insurance coverage on file.']
  expiration_date date [note: 'Date when this producer association expires or was terminated.']
  lob_authority varchar [note: 'Specific lines of business the producer is authorized to write under this association.']
  modified_timestamp timestamp [note: 'Timestamp when this policy producer association record was last modified.']
  notes varchar [note: 'Free-form notes or comments regarding this producer association or special arrangements.']
  npn varchar [note: 'Ten-digit unique identifier assigned by NIPR to licensed insurance producers.']
  of_record_flag boolean [note: 'Indicates whether this producer is the official producer of record for the policy.']
  override_rate decimal(5,2) [note: 'Additional override commission rate for managing general agents or agency principals.']
  phone varchar [note: 'Primary phone number for the producer contact for policy communications.']
  producer_tier varchar [note: 'Performance tier classification affecting commission rates and incentives.']
  referral_source varchar [note: 'Description of how this producer sourced or was referred to this policy opportunity.']
  role_type varchar [note: 'Classification of the producers role on this policy.']
  servicing_office_code varchar [note: 'Internal code identifying the carrier office or region servicing this producer relationship.']
  servicing_rights_flag boolean [note: 'Indicates whether this producer retains servicing rights for the policy.']
  source_system_code varchar [note: 'Code identifying the operational system that originated this policy producer association record.']
  split_percentage decimal(5,2) [note: 'Percentage of commission allocated to this producer when multiple producers share commission.']
  termination_date date [note: 'Date the producers appointment with the carrier was terminated.']
  termination_reason_code varchar [note: 'Code indicating the reason for termination of the producer appointment.']
  writing_company_code varchar [note: 'NAIC company code of the carrier entity this producer represents for this policy.']

  Note: 'One row per producer-policy assignment. Links producer to policy and term with role type, commission rate, split percentage, license details, and servicing rights. Supports multi-producer and split-commission scenarios.'
}

Table policy.type {
  type_id varchar [pk, note: 'Unique identifier for the policy_type data product (auto-inserted during validation).']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Policy types are defined within LOBs (e.g., HO-3 belongs to Homeowners LOB). LOB-level product management, minimum premium rules, and reinsurance eligibility all depend on this']
  acord_form_number varchar [note: 'ACORD standard form number used for applications or certificates for this policy type (e.g., ACORD 125, ACORD 140).']
  cancellation_allowed_flag boolean [note: 'Indicates whether policies of this type can be cancelled mid-term by the insurer or insured.']
  cat_exposure_flag boolean [note: 'Indicates whether policies of this type carry catastrophe exposure requiring CAT modeling and aggregation.']
  coverage_basis varchar [note: 'Trigger basis for coverage (Occurrence, Claims-Made, Claims-Made and Reported). Determines when a loss must occur or be reported to be covered.']
  created_timestamp timestamp [note: 'Timestamp when this policy type record was first created in the system.']
  deductible_required_flag boolean [note: 'Indicates whether a deductible is required for policies of this type.']
  effective_date date [note: 'Date when this policy type became available for new business.']
  endorsement_allowed_flag boolean [note: 'Indicates whether mid-term endorsements are allowed for this policy type.']
  expiration_date date [note: 'Date when this policy type was discontinued or will be discontinued. Null if still active.']
  iso_program_code varchar [note: 'ISO program identifier for standardized forms and rating (e.g., HO for Homeowners, CA for Commercial Auto).']
  last_modified_timestamp timestamp [note: 'Timestamp when this policy type record was last modified.']
  limit_required_flag boolean [note: 'Indicates whether coverage limits must be specified for policies of this type.']
  maximum_premium_amount decimal(15,2) [note: 'Maximum premium amount allowed for policies of this type, in USD. Null if no maximum.']
  minimum_premium_amount decimal(15,2) [note: 'Minimum premium amount required for policies of this type, in USD.']
  monoline_package_indicator varchar [note: 'Indicates whether the policy type is a monoline (single coverage) or package (multiple coverages bundled) policy.']
  personal_commercial_flag boolean [note: 'Indicates whether the policy type is for personal lines or commercial lines business.']
  policy_term_length_months varchar [note: 'Standard term length in months for this policy type (e.g., 12 for annual, 6 for semi-annual).']
  policy_type_status varchar [note: 'Current lifecycle status of the policy type. Active types are available for new business.']
  producer_commission_schedule_code varchar [note: 'Default commission schedule code for producers selling this policy type.']
  rating_algorithm_version varchar [note: 'Version identifier of the rating algorithm or pricing model used for this policy type.']
  reinstatement_allowed_flag boolean [note: 'Indicates whether cancelled policies of this type can be reinstated within a grace period.']
  reinsurance_eligible_flag boolean [note: 'Indicates whether policies of this type are eligible for reinsurance cession under treaty or facultative agreements.']
  renewal_eligible_flag boolean [note: 'Indicates whether policies of this type are eligible for renewal. False for non-renewable policy types.']
  risk_appetite_score decimal(5,2) [note: 'Numeric score representing the companys risk appetite for this policy type (0-100 scale). Higher scores indicate greater appetite.']
  state_filing_required_flag boolean [note: 'Indicates whether rates and forms for this policy type require state Department of Insurance filing and approval.']
  target_loss_ratio_percent decimal(5,2) [note: 'Target loss ratio percentage for this policy type, used for pricing and profitability analysis.']
  type_code varchar [note: 'Short alphanumeric code identifying the policy type (e.g., HO3, PAP, BOP, CGL). Used for system integration and reporting.']
  type_description varchar [note: 'Detailed description of the policy type, including coverage scope, target market, and key features.']
  type_name varchar [note: 'Full business name of the policy type (e.g., Homeowners Special Form, Personal Auto Policy, Business Owners Policy).']
  underwriting_tier_count varchar [note: 'Number of underwriting tiers or risk classes available for this policy type (e.g., Preferred, Standard, Non-Standard).']

  Note: 'One row per policy type definition (reference/lookup). Defines LOB category, term length, minimum/maximum premium, rating algorithm version, reinsurance eligibility, and state filing requirements.'
}

Table policy.state_reg {
  state_reg_id varchar [pk, note: 'Unique identifier for the state regulatory record. Primary key.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: State regulatory records (mandatory PIP, UM/UIM requirements, financial responsibility filings) attach to specific coverages.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: State regulatory filings require geography linkage for jurisdiction-specific compliance reporting, rate filing territorial analysis, and DOI submission by geographic hierarchy.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: State regulatory filings, DOI compliance, and NAIC annual statement exhibits are organized by line of business.']
  policy_id varchar [note: 'Foreign key to the policy this state regulatory record applies to.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: State regulatory attributes vary by term in P&C operations (admitted status can change on renewal, stamping fees are per-term).']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: State regulatory attributes are established and modified by policy transactions (admitted status declared at NB, surplus lines stamping occurs at issuance, state tax rates can']
  admitted_status varchar [note: 'Indicates whether the policy is written on an admitted or surplus lines basis in this state.']
  assigned_risk_pool_indicator boolean [note: 'Indicates whether this policy is written through a state-mandated assigned risk pool or residual market mechanism.']
  assigned_risk_pool_name varchar [note: 'Name of the assigned risk pool or residual market facility through which the policy is written.']
  compliance_notes varchar [note: 'Free-text notes regarding regulatory compliance issues, exceptions, or special handling for this policy.']
  compliance_review_date date [note: 'Date of the most recent regulatory compliance review for this policy.']
  created_timestamp timestamp [note: 'Timestamp when this state regulatory record was first created in the system.']
  doi_filing_number varchar [note: 'State Department of Insurance filing or approval number for the policy form or rate filing.']
  effective_date date [note: 'Date when this state regulatory record becomes effective for the policy.']
  expiration_date date [note: 'Date when this state regulatory record expires or is superseded.']
  fair_plan_indicator boolean [note: 'Indicates whether this policy is written through a state FAIR plan for high-risk properties.']
  fair_plan_name varchar [note: 'Name of the FAIR plan facility through which the policy is written, if applicable.']
  financial_responsibility_filing_date date [note: 'Date the financial responsibility filing was submitted to the state.']
  financial_responsibility_filing_indicator boolean [note: 'Indicates whether a financial responsibility filing (e.g., SR-22, FR-44) is required for this policy.']
  financial_responsibility_filing_type varchar [note: 'Type of financial responsibility filing required by the state (e.g., SR-22, FR-44).']
  guaranty_fund_assessment_amount decimal(15,2) [note: 'Total state guaranty fund assessment collected for this policy, in USD.']
  guaranty_fund_assessment_rate decimal(5,4) [note: 'State guaranty fund assessment rate applicable to this policy, expressed as a decimal.']
  iso_form_edition_date date [note: 'Edition date of the ISO standard form used for this policy, if applicable.']
  last_modified_timestamp timestamp [note: 'Timestamp when this state regulatory record was last updated.']
  minimum_liability_limit_required decimal(15,2) [note: 'State-mandated minimum liability limit required for this line of business, in USD.']
  municipal_tax_amount decimal(15,2) [note: 'Total municipal or local premium tax amount collected for this policy, in USD.']
  municipal_tax_rate decimal(5,4) [note: 'Municipal or local premium tax rate applicable to this policy, expressed as a decimal.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the insurer writing this policy in this state.']
  regulatory_compliance_status varchar [note: 'Current compliance status of this policy with state regulatory requirements.']
  stamping_fee_amount decimal(15,2) [note: 'Fee charged by the stamping office for processing the surplus lines filing, in USD.']
  stamping_office_filing_number varchar [note: 'Filing or stamp number assigned by the surplus lines stamping office for this policy.']
  state_form_number varchar [note: 'State-specific policy form number or edition approved for use in this jurisdiction.']
  state_mandated_coverage_indicator boolean [note: 'Indicates whether this policy includes state-mandated coverage requirements specific to this jurisdiction.']
  state_mandated_coverage_list varchar [note: 'Comma-separated list of state-mandated coverages included in this policy (e.g., uninsured motorist, personal injury protection).']
  state_reporting_code varchar [note: 'State-specific reporting code used for statutory financial reporting and NAIC Annual Statement preparation.']
  state_specific_endorsement_list varchar [note: 'Comma-separated list of state-specific endorsements attached to this policy.']
  state_tax_amount decimal(15,2) [note: 'Total state premium tax amount collected for this policy, in USD.']
  state_tax_rate decimal(5,4) [note: 'State premium tax rate applicable to this policy, expressed as a decimal (e.g., 0.0250 for 2.5%).']
  surplus_lines_stamping_office varchar [note: 'Name of the surplus lines stamping office or service office that processed the filing, if applicable.']

  Note: 'One row per state regulatory record per policy transaction. Captures admitted status, DOI filing, surplus lines stamping, state/municipal tax amounts, guaranty fund assessments, and mandated coverage indicators.'
}

Table policy.fee {
  fee_id varchar [pk, note: 'Unique identifier for the fee record. Primary key.']
  accounting_period_id varchar [note: 'Foreign key to the accounting period in which this fee is recognized for financial reporting.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Inspection fees, stamping fees, and coverage-specific surcharges are allocated to individual coverages for accurate premium accounting and regulatory remittance.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Fees denominated in multiple currencies require proper foreign exchange handling, financial consolidation, and regulatory reporting in functional currency.']
  original_fee_id varchar [note: 'Foreign key to the original fee record that this record reverses, if this is a reversal transaction.']
  policy_id varchar [note: 'Foreign key to the policy to which this fee applies.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this fee was assessed.']
  policy_transaction_id varchar [note: 'Foreign key to the policy transaction that triggered this fee (New Business, Renewal, Endorsement, Cancellation, Reinstatement).']
  amount decimal(15,2) [note: 'Monetary amount of the fee assessed, in the policy currency.']
  billing_method_code varchar [note: 'Code indicating the billing method under which this fee is collected: direct bill, agency bill, list bill, or account current.']
  created_timestamp timestamp [note: 'Timestamp when this fee record was first created in the data warehouse.']
  effective_date date [note: 'Date on which the fee becomes effective and is applied to the policy.']
  fee_description varchar [note: 'Detailed description of the fee, including the reason for assessment and any relevant context.']
  gl_account_code varchar [note: 'General ledger account code to which this fee is posted for statutory and GAAP accounting.']
  inspection_bureau_code varchar [note: 'Code identifying the inspection bureau to which inspection fees are remitted.']
  installment_number varchar [note: 'Installment sequence number for installment fees, indicating which payment installment this fee applies to.']
  payment_plan_code varchar [note: 'Code identifying the payment plan under which this fee is assessed, relevant for installment fees.']
  refund_date date [note: 'Date on which the fee was refunded, if applicable.']
  refund_reason_code varchar [note: 'Code indicating the reason the fee was refunded, if applicable.']
  refunded_flag boolean [note: 'Indicates whether this fee was refunded to the policyholder. True if refunded, False otherwise.']
  remittance_destination_code varchar [note: 'Code indicating the entity to which this fee must be remitted: carrier, state Department of Insurance, surplus lines stamping office, inspection bureau, or third party.']
  remittance_payee_name varchar [note: 'Name of the entity or organization to which the fee is remitted.']
  reversal_flag boolean [note: 'Indicates whether this fee record is a reversal of a previously recorded fee. True if reversal, False otherwise.']
  reversal_reason_code varchar [note: 'Code indicating the reason this fee was reversed, if applicable.']
  source_system_code varchar [note: 'Code identifying the source system that originated this fee record (e.g., PolicyCenter, Duck Creek Policy, Rating Engine).']
  source_system_fee_code varchar [note: 'Unique identifier for this fee in the source system, used for reconciliation and traceability.']
  state_code varchar [note: 'Two-letter US state or Canadian province code where the fee applies, relevant for surplus lines and stamping fees.']
  surplus_lines_stamping_office_code varchar [note: 'Code identifying the surplus lines stamping office to which surplus lines fees are remitted.']
  taxable_flag boolean [note: 'Indicates whether this fee is subject to sales tax or other levies. True if taxable, False otherwise.']
  transaction_date date [note: 'Date on which the fee transaction was recorded in the system.']
  type_code varchar [note: 'Code representing the type of fee assessed: policy fee, inspection fee, installment fee, surplus lines tax, stamping fee, or late payment fee.']
  updated_timestamp timestamp [note: 'Timestamp when this fee record was last updated in the data warehouse.']
  waived_flag boolean [note: 'Indicates whether this fee was waived by underwriting or management. True if waived, False otherwise.']
  waiver_authorized_by varchar [note: 'Name or identifier of the person who authorized the fee waiver.']
  waiver_reason_code varchar [note: 'Code indicating the reason the fee was waived, if applicable.']

  Note: 'One row per fee transaction on a policy. Records policy fee, inspection fee, installment fee, and similar charges with amount, type, accounting period, GL account, and refund/waiver tracking.'
}

Table policy.document {
  document_id varchar [pk, note: 'Unique identifier for the policy document record. Primary key. One row per document generated at a policy transaction.']
  binder_id varchar [note: 'Foreign key linking to coverage.binder. Business justification: Binder documents are a specific document type issued before the formal policy. Linking policy_document to the binder it represents supports binder document retrieval, regulatory']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Coverage-specific endorsement documents, certificates of insurance for specific coverages, and coverage declination notices must be linked to the coverage they govern.']
  policy_id varchar [note: 'Foreign key to the policy for which this document was generated.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this document was issued.']
  policy_transaction_id varchar [note: 'Foreign key to the policy transaction that triggered document generation (New Business, Renewal, Endorsement, Cancellation, Reinstatement).']
  recipient_party_id varchar [note: 'Foreign key to the party who is the intended recipient of this document (policyholder, named insured, additional insured, loss payee, etc.).']
  recipient_party_role_id varchar [note: 'Foreign key to the party role of the recipient at the time of document issuance.']
  superseded_document_policy_document_id varchar [note: 'Foreign key to the prior document that this document replaces or supersedes, if applicable.']
  created_timestamp timestamp [note: 'Date and time when this document record was first created in the system.']
  delivery_confirmation_flag boolean [note: 'Indicates whether delivery confirmation was received from the recipient (True) or not (False).']
  delivery_confirmation_timestamp timestamp [note: 'Date and time when delivery confirmation was received, if applicable.']
  delivery_date date [note: 'Date the document was delivered or sent to the recipient.']
  delivery_method varchar [note: 'Method by which the document was delivered to the policyholder or recipient.']
  document_description varchar [note: 'Detailed description of the document content, purpose, or summary of changes for endorsements.']
  document_number varchar [note: 'Business-facing unique document number or control number assigned to this document for tracking and reference.']
  document_status varchar [note: 'Current lifecycle status of the document in the document management workflow. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|issued|delivered|voided|superseded|archived — 8 candidates stripped; promote to reference product]']
  document_type varchar [note: 'Type of policy document issued. [ENUM-REF-CANDIDATE']
  effective_date date [note: 'Date from which the terms and conditions documented in this record become binding or enforceable.']
  expiration_date date [note: 'Date on which the document or the coverage it represents expires or is no longer valid.']
  file_format varchar [note: 'File format of the stored document (e.g., PDF, DOCX, HTML).']
  file_size_bytes varchar [note: 'Size of the document file in bytes.']
  form_code varchar [note: 'ISO or carrier-specific form code identifying the standard form template used for this document (e.g., ACORD 125, ISO HO-3).']
  form_edition_date date [note: 'Edition date of the form template used, indicating the version of the standard form applied.']
  generation_timestamp timestamp [note: 'Date and time when the document was generated by the policy administration or document management system.']
  hash varchar [note: 'Cryptographic hash (e.g., SHA-256) of the document file for integrity verification and tamper detection.']
  issue_date date [note: 'Official date the document was issued or became effective for business purposes.']
  language_code varchar [note: 'ISO 639-1 two-letter language code indicating the language in which the document was generated.']
  modified_timestamp timestamp [note: 'Date and time when this document record was last modified or updated.']
  page_count varchar [note: 'Total number of pages in the generated document.']
  recipient_address_line1 varchar [note: 'First line of the mailing address to which the document was sent.']
  recipient_address_line2 varchar [note: 'Second line of the mailing address (suite, apartment, etc.).']
  recipient_city varchar [note: 'City of the recipient mailing address.']
  recipient_country_code varchar [note: 'Three-letter ISO country code of the recipient mailing address.']
  recipient_email varchar [note: 'Email address to which the document was sent, if delivered electronically.']
  recipient_name varchar [note: 'Name of the recipient as it appears on the document for delivery purposes.']
  recipient_postal_code varchar [note: 'Postal or ZIP code of the recipient mailing address.']
  recipient_state_code varchar [note: 'Two-letter state or province code of the recipient mailing address.']
  regulatory_filing_reference varchar [note: 'Reference number or identifier of the regulatory filing or approval associated with this document form.']
  regulatory_required_flag boolean [note: 'Indicates whether this document is required by state or federal regulation (True) or is optional/carrier-initiated (False).']
  state_code varchar [note: 'Two-letter state code for the jurisdiction under which this document was issued and must comply.']
  storage_location_uri varchar [note: 'URI or path to the document file in the document management system or content repository.']
  subtype varchar [note: 'Further classification of the document type, such as specific endorsement form code or notice category.']
  template_version varchar [note: 'Version number of the document template used at the time of generation.']
  title varchar [note: 'Human-readable title or name of the document as it appears on the document itself.']
  void_date date [note: 'Date on which the document was voided, if applicable.']
  void_flag boolean [note: 'Indicates whether this document has been voided and is no longer valid (True) or remains valid (False).']
  void_reason_code varchar [note: 'Code indicating the reason the document was voided (e.g., error, reissue, policy cancellation).']

  Note: 'One row per policy document issued. Tracks document type, delivery method, recipient party, delivery confirmation, storage URI, and supersession chain. Links to policy, term, and transaction for full audit trail.'
}

Table coverage.submission {
  submission_id varchar [pk, note: 'Unique identifier for the submission record. Primary key.']
  agency_id varchar [note: 'Foreign key to the agency or brokerage firm associated with this submission.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Underwriters evaluate catastrophe exposure during submission intake to determine risk appetite, pricing tier, and referral triggers.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Submissions capture risk location (risk_state, risk_country) which maps to geography hierarchy for territory rating, catastrophe zone assignment, and regulatory jurisdiction']
  household_id varchar [note: 'Foreign key linking to party.household. Business justification: Personal lines underwriting requires household-level risk assessment at submission: aggregate prior losses, household member count, and multi-policy exposure are evaluated before quoting.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Normalize lob_code string to FK reference to shared.line_of_business master data. Submission currently stores lob_code as string; replacing with FK enables consistent LOB']
  producers_producer_id varchar [note: 'Foreign key to the producer or agent who submitted or is associated with this submission.']
  submission_applicant_party_id varchar [note: 'Foreign key to the party table identifying the applicant or prospect submitting the risk for underwriting evaluation.']
  submission_party_id varchar [note: 'Foreign key to the underwriter assigned to evaluate this submission.']
  acord_form_type varchar [note: 'ACORD standard form type used for this submission such as ACORD 125 for commercial, ACORD 126 for commercial supplemental, ACORD 140 for personal lines.']
  clearance_status varchar [note: 'Status of submission intake clearance process indicating whether all required information and documents have been received.']
  clue_report_date date [note: 'Date the CLUE or Comprehensive Loss Underwriting Exchange report was pulled for this submission.']
  created_timestamp timestamp [note: 'System timestamp when this submission record was first created in the underwriting system.']
  credit_report_date date [note: 'Date the credit report or insurance score was pulled for this submission.']
  credit_score varchar [note: 'Insurance credit score or credit-based insurance score used in underwriting and rating where permitted by state regulation.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this submission.']
  decline_reason varchar [note: 'Business reason for declining the submission if status is declined such as adverse loss history, unacceptable risk, or outside appetite.']
  effective_date date [note: 'Requested or proposed effective date for coverage to begin if the submission is bound.']
  eligibility_status varchar [note: 'Result of automated eligibility screening indicating whether the submission meets basic acceptance criteria.']
  estimated_annual_premium decimal(18,2) [note: 'Estimated or indicative annual premium for this submission prior to final rating.']
  expiration_date date [note: 'Requested or proposed expiration date for coverage if the submission is bound.']
  inspection_completed_date date [note: 'Date the required inspection was completed if applicable.']
  inspection_required_flag boolean [note: 'Boolean flag indicating whether a physical inspection of the insured property or risk is required before binding.']
  line_of_business varchar [note: 'Insurance line of business for this submission such as Personal Auto, Homeowners, Commercial General Liability, Workers Compensation.']
  loss_history_reviewed_flag boolean [note: 'Boolean flag indicating whether prior loss history was reviewed via CLUE, ISO, or other loss database.']
  modified_timestamp timestamp [note: 'System timestamp when this submission record was last modified or updated.']
  mvr_report_date date [note: 'Date the Motor Vehicle Record report was pulled for auto submissions.']
  naics_code varchar [note: 'Six-digit NAICS code classifying the business or industry of the applicant for commercial submissions.']
  number varchar [note: 'Business-facing unique submission number displayed to users and producers.']
  policy_type_code varchar [note: 'Code identifying the type of policy being submitted such as HO3, PAP, BOP, CGL, WC.']
  prior_carrier_naic_code varchar [note: 'NAIC company code of the prior insurance carrier.']
  prior_carrier_name varchar [note: 'Name of the prior insurance carrier if the applicant is switching carriers.']
  prior_policy_number varchar [note: 'Policy number of the prior or expiring policy if this submission is a renewal or rewrite.']
  quote_count varchar [note: 'Number of quotes generated from this submission.']
  referral_reason varchar [note: 'Business reason or rule that triggered the referral requirement such as high TIV, adverse loss history, or non-standard risk.']
  referral_required_flag boolean [note: 'Boolean flag indicating whether this submission requires referral to senior underwriter or management for approval.']
  risk_appetite_score decimal(5,2) [note: 'Automated or manual risk appetite score indicating alignment with underwriting guidelines and risk tolerance.']
  risk_country varchar [note: 'Three-letter ISO country code where the insured risk is located.']
  risk_state varchar [note: 'Two-letter state code where the primary insured risk is located.']
  sic_code varchar [note: 'Four-digit SIC code classifying the business or industry of the applicant for commercial submissions.']
  source varchar [note: 'Channel or origin through which the submission was received. [ENUM-REF-CANDIDATE: agent|broker|direct|web_portal|mobile_app|call_center|renewal|endorsement — 8 candidates stripped; promote to reference product]']
  submission_date date [note: 'Date the submission was received or created in the system.']
  submission_status varchar [note: 'Current lifecycle status of the submission in the underwriting workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|quoted|bound|declined|withdrawn|expired — 8 candidates stripped; promote to reference product]']
  submission_type varchar [note: 'Classification of the submission as new business, renewal, rewrite, or remarketing of existing risk.']
  submitted_by_user_code varchar [note: 'User identifier or login of the person who created or submitted this submission record.']
  total_insured_value decimal(18,2) [note: 'Total insured value or sum insured across all risks and coverages in this submission.']
  withdrawn_reason varchar [note: 'Reason the submission was withdrawn by the applicant or producer before binding.']

  Note: 'One row per submission (application for coverage). Entry point of the underwriting lifecycle. Captures applicant, producer, LOB, risk state, estimated premium, eligibility status, and links to bound policy when accepted.'
}

Table coverage.uw_decision {
  uw_decision_id varchar [pk, note: 'Unique identifier for the underwriting decision event. Grain: one row per UW decision event.']
  primary_uw_approved_by_party_id varchar [note: 'Reference to the party who provided final approval for the underwriting decision, if approval was required.']
  quote_id varchar [note: 'Reference to the quote being evaluated or modified by this underwriting decision, if applicable.']
  submission_id varchar [note: 'Reference to the submission being evaluated by this underwriting decision.']
  tertiary_uw_referred_to_underwriter_party_id varchar [note: 'Reference to the senior underwriter or specialist to whom the submission was escalated.']
  uw_referral_id varchar [note: 'Foreign key linking to coverage.uw_referral. Business justification: UW decision can result from a referral being resolved. 1 decision resolves 1 referral. FK populated when referral is resolved with decision.']
  appetite_match_flag boolean [note: 'Indicates whether the submission aligns with the insurers current risk appetite and strategic guidelines.']
  approval_required_flag boolean [note: 'Indicates whether the underwriting decision requires additional approval from management or a senior authority before being finalized.']
  approval_timestamp timestamp [note: 'The date and time when the underwriting decision was approved by the designated authority.']
  assigned_underwriter_name varchar [note: 'Full name of the underwriter who rendered this decision, for reporting and audit purposes.']
  automated_decision_flag boolean [note: 'Indicates whether the underwriting decision was rendered by an automated rules engine or AI model versus a human underwriter.']
  conditions_required varchar [note: 'List of conditions or requirements that must be met for conditional acceptance, such as inspections, loss control measures, or additional documentation.']
  created_timestamp timestamp [note: 'The date and time when this underwriting decision record was first created in the system.']
  decision_effective_date date [note: 'The date from which the underwriting decision becomes effective, relevant for conditional acceptances or modified terms.']
  decision_expiration_date date [note: 'The date when the underwriting decision expires if not acted upon, typically for quotes or conditional offers.']
  decision_model_version varchar [note: 'Version identifier of the automated underwriting model or rules engine used to render the decision, for audit and reproducibility.']
  decision_number varchar [note: 'Business-facing unique identifier for the underwriting decision, used in correspondence and workflow tracking.']
  decision_rationale varchar [note: 'Detailed explanation of the reasoning behind the underwriting decision, including risk factors and business considerations.']
  decision_status varchar [note: 'Current lifecycle status of the underwriting decision within the workflow. [ENUM-REF-CANDIDATE: pending|in_review|approved|rejected|escalated|withdrawn|expired — 7 candidates stripped; promote to reference product]']
  decision_timestamp timestamp [note: 'The date and time when the underwriting decision was rendered by the underwriter.']
  decision_type varchar [note: 'The type of underwriting decision rendered: accept, decline, refer to senior UW, modify terms, counter-offer, or conditional acceptance.']
  decline_reason_code varchar [note: 'Standardized code indicating the primary reason for declining the submission, aligned with regulatory disclosure requirements.']
  decline_reason_description varchar [note: 'Human-readable description of the decline reason, provided to the applicant per regulatory requirements.']
  eligibility_flag boolean [note: 'Indicates whether the submission meets all eligibility criteria for the requested line of business and coverage.']
  endorsements_required varchar [note: 'List of endorsements or policy forms that must be attached as part of the underwriting decision.']
  exclusions_added varchar [note: 'List of exclusions added to the policy as part of the underwriting decision to mitigate specific risks.']
  last_modified_timestamp timestamp [note: 'The date and time when this underwriting decision record was last updated in the system.']
  modified_deductible_amount decimal(18,2) [note: 'The revised deductible amount proposed by the underwriter if the decision type is modify or counter-offer.']
  modified_limit_amount decimal(18,2) [note: 'The revised coverage limit proposed by the underwriter if the decision type is modify or counter-offer.']
  modified_premium_amount decimal(18,2) [note: 'The revised premium amount proposed by the underwriter if the decision type is modify or counter-offer.']
  notes varchar [note: 'Additional free-text notes or comments recorded by the underwriter regarding the decision, for internal reference and knowledge transfer.']
  override_flag boolean [note: 'Indicates whether the underwriter manually overrode an automated decision or system recommendation.']
  override_reason varchar [note: 'Explanation of why the underwriter overrode the automated decision, required for compliance and audit purposes.']
  referral_due_date date [note: 'Service Level Agreement (SLA) due date by which the referral must be resolved to meet business commitments.']
  referral_priority varchar [note: 'Priority level assigned to the referral, determining the urgency of senior underwriter review.']
  referral_reason_code varchar [note: 'Standardized code indicating why the submission was referred to a senior underwriter or specialist for further review.']
  referral_reason_description varchar [note: 'Detailed explanation of why the submission requires escalation or specialist review.']
  risk_score decimal(10,4) [note: 'Quantitative risk score calculated for the submission, used to support the underwriting decision.']
  risk_tier varchar [note: 'Categorical risk classification assigned to the submission based on underwriting evaluation.']
  sla_actual_hours decimal(10,2) [note: 'The actual number of hours taken to render the underwriting decision, measured from submission intake to decision timestamp.']
  sla_met_flag boolean [note: 'Indicates whether the underwriting decision was rendered within the committed service level agreement timeframe.']
  sla_target_hours varchar [note: 'The target number of hours within which the underwriting decision should be rendered per business commitments.']
  underwriter_authority_level varchar [note: 'The authority level of the underwriter who made the decision, indicating approval limits and escalation tier.']

  Note: 'One row per underwriting decision on a submission or quote. Records accept/decline/refer outcome, risk score, authority level, conditions, exclusions added, modified limits/deductibles, and SLA compliance.'
}

Table coverage.uw_referral {
  uw_referral_id varchar [pk, note: 'Unique identifier for the underwriting referral record. Primary key.']
  agency_id varchar [note: 'Identifier of the agency representing the producer who submitted the business.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Referrals are routed to underwriters by line of business expertise and authority limits.']
  policy_id varchar [note: 'Identifier of the policy associated with this referral, if applicable for endorsements or renewals.']
  primary_uw_assigned_underwriter_party_id varchar [note: 'Identifier of the senior underwriter or specialist assigned to review and resolve the referral.']
  producers_producer_id varchar [note: 'Identifier of the agent or broker who submitted the business that triggered the referral.']
  quote_id varchar [note: 'Identifier of the quote that triggered this referral, if applicable.']
  submission_id varchar [note: 'Identifier of the submission that triggered this referral.']
  term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Referrals occur at renewal (term-specific underwriting review triggered by loss activity, occupancy change, limit increase).']
  approval_conditions varchar [note: 'Specific conditions or requirements that must be met for approval, such as additional documentation, coverage modifications, or premium adjustments.']
  assigned_underwriter_name varchar [note: 'Full name of the assigned underwriter for display and reporting purposes.']
  authority_level_required varchar [note: 'Level of underwriting authority required to approve this referral based on risk, premium, or policy limits.']
  catastrophe_exposure_flag boolean [note: 'Indicates whether the referral involves significant catastrophe exposure requiring senior review.']
  created_by_user_code varchar [note: 'User identifier of the person or system that created the referral record.']
  decline_reason_code varchar [note: 'Standardized code indicating the primary reason for declining the referral, if applicable.']
  decline_reason_description varchar [note: 'Detailed explanation of why the referral was declined, if applicable.']
  escalation_level varchar [note: 'Number of times the referral has been escalated to higher authority levels. Zero indicates no escalation.']
  fraud_indicator_flag boolean [note: 'Indicates whether fraud detection systems flagged this submission for potential fraud requiring special investigation unit review.']
  last_modified_by_user_code varchar [note: 'User identifier of the person or system that last modified the referral record.']
  last_modified_timestamp timestamp [note: 'Date and time when the referral record was last updated.']
  premium_amount decimal(15,2) [note: 'Total premium amount associated with the referred submission or quote.']
  prior_loss_amount decimal(15,2) [note: 'Total dollar amount of prior losses for the insured or risk that contributed to the referral decision.']
  prior_loss_count varchar [note: 'Number of prior losses reported for the insured or risk that contributed to the referral decision.']
  priority_level varchar [note: 'Business priority assigned to the referral for queue management and SLA tracking.']
  product_code varchar [note: 'Internal product code identifying the specific insurance product being underwritten.']
  referral_assigned_timestamp timestamp [note: 'Date and time when the referral was assigned to a senior underwriter for review.']
  referral_created_timestamp timestamp [note: 'Date and time when the referral was first created in the underwriting workbench.']
  referral_number varchar [note: 'Business-facing unique referral number displayed to underwriters and stakeholders.']
  referral_reason_code varchar [note: 'Standardized code indicating the primary reason for referral. [ENUM-REF-CANDIDATE']
  referral_reason_description varchar [note: 'Detailed narrative explanation of why the submission or quote was referred beyond standard authority.']
  referral_status varchar [note: 'Current lifecycle status of the referral: pending, under review, approved, declined, withdrawn, escalated, or returned. [ENUM-REF-CANDIDATE: pending|under_review|approved|declined|withdrawn|escalated|returned — 7 candidates stripped; promote to reference']
  referral_type varchar [note: 'Type of transaction that triggered the referral: new business, renewal, endorsement, cancellation, reinstatement, or quote revision.']
  regulatory_concern_flag boolean [note: 'Indicates whether the referral involves regulatory compliance concerns requiring legal or compliance review.']
  reinsurance_required_flag boolean [note: 'Indicates whether reinsurance placement or facultative coverage is required as part of the referral review.']
  resolution_notes varchar [note: 'Detailed notes from the reviewing underwriter explaining the resolution decision and any special conditions or requirements.']
  resolution_outcome varchar [note: 'Final decision outcome of the referral review: approved, approved with conditions, declined, withdrawn, escalated, or returned for rework.']
  resolution_timestamp timestamp [note: 'Date and time when the referral was resolved with a final decision.']
  risk_score decimal(5,2) [note: 'Quantitative risk score assigned to the submission or quote that triggered the referral.']
  sla_due_date date [note: 'Target date by which the referral must be resolved per underwriting service level agreements.']
  sla_due_timestamp timestamp [note: 'Precise date and time by which the referral must be resolved per underwriting service level agreements.']
  state_code varchar [note: 'Two-letter US state code where the risk is located, relevant for regulatory and underwriting authority rules.']
  territory_code varchar [note: 'Internal territory code used for rating and underwriting segmentation.']
  total_insured_value decimal(15,2) [note: 'Total insured value of all risks covered under the referred submission or quote.']

  Note: 'One row per underwriting referral. Tracks referral reason, priority, assigned underwriter, escalation level, SLA due date, resolution outcome, and links to submission, quote, and policy for full audit trail.'
}

Table coverage.quote {
  quote_id varchar [pk, note: 'Unique identifier for the insurance quote. Primary key.']
  agency_id varchar [note: 'Identifier of the agency through which the quote was submitted.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Quotes are priced with catastrophe load factors based on the risk\'s cat zone. Rating worksheets apply zone-specific surcharges for wind, earthquake, and other cat perils.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Quote rating uses geography for territory assignment, tax jurisdiction determination, and regulatory filing compliance.']
  household_id varchar [note: 'Foreign key linking to party.household. Business justification: Personal lines quoting applies household-level discounts (multi-policy, loyalty, companion policy credits) and aggregates household exposure for pricing.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Quotes are classified by line of business for premium aggregation, loss ratio analysis, and regulatory reporting.']
  party_id varchar [note: 'Identifier of the underwriter who reviewed and approved the quote.']
  payment_plan_id varchar [note: 'Foreign key linking to billing.payment_plan. Business justification: Quotes present payment plan options to applicants with plan-specific premium calculations.']
  producers_producer_id varchar [note: 'Identifier of the producer or agent who submitted the quote request.']
  submission_id varchar [note: 'Reference to the submission from which this quote was generated.']
  base_premium_amount decimal(15,2) [note: 'Base premium before application of discounts, surcharges, taxes, and fees.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has authority to bind this quote without further underwriter approval.']
  bound_by_user_code varchar [note: 'Identifier of the user who bound the quote.']
  bound_timestamp timestamp [note: 'Timestamp when the quote was bound and converted to a policy.']
  commission_amount decimal(15,2) [note: 'Estimated commission amount payable to the producer if the quote is bound.']
  commission_rate decimal(5,4) [note: 'Commission rate percentage payable to the producer if the quote is bound.']
  created_timestamp timestamp [note: 'Timestamp when the quote record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this quote.']
  decline_reason varchar [note: 'Reason the quote was declined if status is declined.']
  distribution_channel varchar [note: 'Channel through which the quote was originated and distributed.']
  effective_date date [note: 'Proposed effective date when coverage would begin if the quote is bound.']
  expiration_date date [note: 'Proposed expiration date when coverage would end if the quote is bound.']
  expiry_date date [note: 'Date after which the quote is no longer valid for binding.']
  fee_amount decimal(15,2) [note: 'Total fees included in the quoted premium, such as policy fees and stamping fees.']
  loss_free_years varchar [note: 'Number of consecutive years without a claim, used for rating and discount eligibility.']
  modified_timestamp timestamp [note: 'Timestamp when the quote record was last modified.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the insurer issuing the quote.']
  notes varchar [note: 'Free-text notes or comments entered by the underwriter or producer regarding the quote.']
  number varchar [note: 'Business-facing unique quote number displayed to producers and customers.']
  policy_type_code varchar [note: 'Code representing the policy type or product offering.']
  prior_carrier_name varchar [note: 'Name of the insurance carrier that previously insured the risk, if applicable.']
  prior_expiration_date date [note: 'Expiration date of the prior policy, used to assess continuity of coverage.']
  prior_policy_number varchar [note: 'Policy number from the prior carrier, used for continuity and loss history verification.']
  quote_date date [note: 'Date the quote was generated and presented to the customer or producer.']
  quote_status varchar [note: 'Current lifecycle status of the quote.']
  quoted_premium_amount decimal(15,2) [note: 'Total premium amount quoted to the customer, including all charges, taxes, and fees.']
  rate_effective_date date [note: 'Effective date of the rate table or pricing rules used to generate this quote.']
  rating_engine_version varchar [note: 'Version of the rating engine or pricing algorithm used to calculate the quoted premium.']
  rating_tier varchar [note: 'Risk tier assigned during underwriting that determines pricing level.']
  referral_flag boolean [note: 'Indicates whether the quote was referred to senior underwriting for manual review.']
  referral_reason varchar [note: 'Business reason why the quote was referred for manual underwriting review.']
  risk_score decimal(5,2) [note: 'Numeric risk score calculated by the rating engine, used for pricing and underwriting decisions.']
  state_code varchar [note: 'Two-letter state code where the risk is domiciled and coverage will be written.']
  tax_amount decimal(15,2) [note: 'Total tax amount included in the quoted premium.']
  version varchar [note: 'Version number of the quote, incremented when quote is re-rated or modified.']

  Note: 'One row per quote version. Captures quoted premium, commission, fees, taxes, rating engine version, rating tier, and binding status. Versioned so multiple quote iterations per submission are preserved.'
}

Table coverage.quote_coverage {
  quote_coverage_id varchar [pk, note: 'Unique identifier for the quote coverage line. Primary key. Grain: one row per coverage per quote.']
  bound_coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Quote coverages become bound policy coverages when a quote is accepted. This lineage link enables tracking quote-to-policy conversion, comparing quoted vs bound terms, and supporting audit']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Premium amounts on quote coverages must reference the currency master for multi-currency rating, financial reporting, and regulatory filings.']
  fac_agreement_id varchar [note: 'Foreign key linking to reinsurance.fac_agreement. Business justification: Facultative reinsurance underwriting decisions are made at the quote_coverage level before binding.']
  insured_risk_id varchar [note: 'Foreign key to the insured risk. Links this coverage to the specific property, vehicle, or other exposure being covered.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Each coverage protects against specific perils (wind, earthquake, flood). Underwriters and actuaries need peril-level exposure aggregation for catastrophe modeling and reinsurance']
  quote_id varchar [note: 'Foreign key to the parent quote. Links this coverage line to the quote proposal.']
  submission_id varchar [note: 'Foreign key linking to coverage.rating_worksheet. Business justification: Each coverage line can have its own rating calculation. FK associates coverage with its rating worksheet.']
  term_id varchar [note: 'Foreign key to the coverage form master. Identifies the ISO or proprietary form attached to this coverage line.']
  aggregate_limit_amount decimal(18,2) [note: 'Maximum amount the insurer will pay for all claims during the policy term. Null if no aggregate limit applies.']
  class_code varchar [note: 'ISO or NCCI class code for this coverage. Used in rating and risk classification.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of loss shared by the insured after deductible. Null if no coinsurance applies.']
  condition_codes varchar [note: 'Comma-separated list of condition codes applied to this coverage. References standard condition forms.']
  coverage_basis varchar [note: 'Trigger basis for the coverage. Occurrence-based or claims-made, determining when coverage applies.']
  coverage_code varchar [note: 'Standard code identifying the coverage type. Examples: BIPD, COLL, COMP, FIRE, THEFT, GL, WC.']
  coverage_description varchar [note: 'Detailed description of what this coverage protects against, including scope and key terms.']
  coverage_name varchar [note: 'Human-readable name of the coverage. Examples: Bodily Injury, Property Damage, Collision, Comprehensive, Fire, General Liability.']
  coverage_status varchar [note: 'Current status of this coverage line within the quote. Indicates whether coverage was quoted, declined, or referred.']
  coverage_type varchar [note: 'Classification of the coverage layer. Indicates whether this is primary, excess, umbrella, or supplemental coverage.']
  created_timestamp timestamp [note: 'Timestamp when this quote coverage record was first created in the system. Audit trail for record creation.']
  declination_reason varchar [note: 'Reason the applicant declined this coverage. Null if coverage was not declined.']
  deductible_amount decimal(18,2) [note: 'Amount the insured must pay out-of-pocket before coverage applies. The deductible for this coverage line.']
  deductible_applies_to varchar [note: 'Scope of deductible application. Per occurrence, per claim, per policy term, or aggregate across all claims.']
  deductible_type varchar [note: 'Structure of the deductible. Flat dollar amount, percentage of loss, franchise, disappearing, or aggregate annual.']
  effective_date date [note: 'Proposed effective date for this coverage if the quote is bound. Coverage inception date.']
  endorsement_codes varchar [note: 'Comma-separated list of endorsement form numbers modifying this coverage. References ISO or proprietary endorsements.']
  exclusion_codes varchar [note: 'Comma-separated list of exclusion codes applied to this coverage. References standard exclusion forms.']
  expiration_date date [note: 'Proposed expiration date for this coverage if the quote is bound. Coverage termination date.']
  exposure_units decimal(18,2) [note: 'Quantity of exposure units used in premium calculation. Examples: number of vehicles, square footage, payroll amount.']
  extended_reporting_period_months varchar [note: 'Length of extended reporting period in months for claims-made coverage. Null if not applicable.']
  form_edition_date date [note: 'Edition date of the coverage form. ISO forms are versioned by edition date.']
  form_number varchar [note: 'ISO or proprietary form number for this coverage. Examples: CG0001, CA0001, HO0003.']
  is_declined boolean [note: 'Indicates whether the applicant declined this optional coverage. True if declined, false otherwise.']
  is_mandatory boolean [note: 'Indicates whether this coverage is mandatory by law or regulation. True if required, false if optional.']
  limit_amount decimal(18,2) [note: 'Maximum amount the insurer will pay under this coverage. The policy limit for this coverage line.']
  limit_type varchar [note: 'Structure of the limit. Per occurrence, per claim, aggregate annual, combined single limit, or split limits.']
  modified_timestamp timestamp [note: 'Timestamp when this quote coverage record was last modified. Audit trail for record updates.']
  per_accident_limit_amount decimal(18,2) [note: 'Maximum amount payable per accident or occurrence. Null if not applicable.']
  per_person_limit_amount decimal(18,2) [note: 'Maximum amount payable per person for bodily injury or medical payments. Null if not applicable.']
  premium_basis varchar [note: 'Rating basis for premium calculation. Examples: per vehicle, per square foot, per payroll dollar, per revenue dollar, flat.']
  quoted_date date [note: 'Date this coverage line was quoted. Business event timestamp for the quote generation.']
  quoted_premium_amount decimal(18,2) [note: 'Premium amount quoted for this coverage line. Coverage-level premium before taxes and fees.']
  rate decimal(12,6) [note: 'Unit rate applied to the exposure base to calculate premium. Rate per unit of exposure.']
  retroactive_date date [note: 'Retroactive date for claims-made coverage. Claims arising from incidents before this date are not covered.']
  self_insured_retention_amount decimal(18,2) [note: 'Self-insured retention amount the insured must pay before coverage applies. Differs from deductible in claims handling.']
  territory_code varchar [note: 'Rating territory code for this coverage. Used in premium calculation and catastrophe exposure aggregation.']
  underwriter_notes varchar [note: 'Free-text notes from the underwriter regarding this coverage line. May include special terms, conditions, or referral reasons.']
  valuation_method varchar [note: 'Method used to value losses under this coverage. Actual cash value, replacement cost, agreed value, stated amount, or market value.']
  waiting_period_days varchar [note: 'Number of days before coverage becomes effective after policy inception. Null if no waiting period applies.']

  Note: 'One row per coverage line on a quote. Captures quoted limit, deductible, premium, exclusion/condition codes, and coverage basis per insured risk. Links to bound coverage.coverage when quote is accepted.'
}

Table coverage.rating_factor {
  rating_factor_id varchar [pk, note: 'Unique identifier for the rating factor record.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Rating factors are also applied when rating a bound coverage (e.g., endorsement re-rating, renewal rating).']
  insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Rating factors are applied to specific insured risks during premium calculation. Underwriters and actuaries need to trace which territory, construction, protection class, and']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Rating factors are defined and filed by line of business for regulatory compliance.']
  override_user_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Factor-level overrides (schedule rating, experience mod adjustments) require user attribution for regulatory audit (rate filing compliance), pricing integrity validation, and underwriting']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Rating factors are often peril-specific (wind deductible credit, earthquake increased limits factor, flood base rate). Peril provides standardized taxonomy for factor application.']
  quote_coverage_id varchar [note: 'Foreign key linking to coverage.quote_coverage. Business justification: Rating factors are applied at the coverage-line level during quoting. Linking rating_factor.quote_coverage_id -> quote_coverage.quote_coverage_id provides precise traceability of']
  quote_id varchar [note: 'Foreign key linking to coverage.quote. Business justification: Rating factors are computed during the quoting/pricing process for a specific quote. Linking rating_factor.quote_id -> quote.quote_id establishes the quoting context in which each factor was']
  submission_id varchar [note: 'Foreign key to the parent rating worksheet that contains this factor.']
  calculation_formula varchar [note: 'Mathematical expression or rule describing how this factor is computed or applied in the rating algorithm.']
  created_timestamp timestamp [note: 'Date and time when this rating factor record was first created in the system.']
  effective_date date [note: 'Date when this rating factor becomes effective for use in premium calculations.']
  expiration_date date [note: 'Date when this rating factor expires and is no longer valid for use in premium calculations.']
  factor_basis varchar [note: 'The underlying risk characteristic or attribute that this factor is based on (e.g., ZIP code, NAICS code, loss history).']
  factor_category varchar [note: 'Classification of the factor type within the rating algorithm structure. [ENUM-REF-CANDIDATE: base_rate|territory|class_code|experience_mod|schedule_credit|schedule_debit|coverage_adjustment|limit_factor|deductible_credit — 9 candidates stripped; promote']
  factor_code varchar [note: 'Short code or abbreviation identifying the factor type for system processing and reporting.']
  factor_description varchar [note: 'Detailed explanation of what the factor represents and how it impacts the premium calculation.']
  factor_name varchar [note: 'Business name of the rating factor (e.g., Territory Factor, Class Code Factor, Experience Modification).']
  factor_sequence varchar [note: 'Ordinal position of this factor within the rating worksheet calculation sequence.']
  factor_source varchar [note: 'Origin of the factor value (ISO table, proprietary rating plan, manual underwriter override, actuarial model, or state filing).']
  factor_type varchar [note: 'Indicates how the factor value is applied in the calculation (multiplicative, additive, percentage, or flat).']
  factor_value decimal(18,6) [note: 'Numeric value of the rating factor applied in the premium calculation (multiplier or additive amount).']
  filing_number varchar [note: 'Regulatory filing reference number under which this factor was approved by the state Department of Insurance (DOI).']
  is_filed boolean [note: 'Indicates whether this factor is part of a state-filed rating plan and subject to regulatory approval.']
  is_mandatory boolean [note: 'Indicates whether this factor must be applied per regulatory or underwriting guidelines (true) or is optional (false).']
  last_modified_timestamp timestamp [note: 'Date and time when this rating factor record was last updated.']
  max_factor_value decimal(18,6) [note: 'Maximum allowable value for this factor, enforcing underwriting or regulatory constraints.']
  min_factor_value decimal(18,6) [note: 'Minimum allowable value for this factor, enforcing underwriting or regulatory constraints.']
  override_reason varchar [note: 'Explanation provided by the underwriter if this factor was manually overridden from the standard table value.']
  override_timestamp timestamp [note: 'Date and time when the manual override was applied to this rating factor.']
  rating_factor_status varchar [note: 'Current lifecycle status of the rating factor within the rating engine.']
  state_code varchar [note: 'Two-letter US state code where this rating factor applies, ensuring jurisdiction-specific compliance.']
  table_effective_date date [note: 'Date when the rating table version became effective for use in premium calculations.']
  table_name varchar [note: 'Name of the rating table or rule set from which this factor was retrieved.']
  table_version varchar [note: 'Version identifier of the rating table used to derive this factor, ensuring auditability and regulatory compliance.']

  Note: 'One row per rating factor applied during premium calculation. Records factor name, value, basis, peril, and rating engine version. Supports full rate reconstruction and actuarial audit of any quoted or written premium.'
}

Table coverage.loss_history {
  loss_history_id varchar [pk, note: 'Unique identifier for the prior loss record.']
  auto_risk_id varchar [note: 'Foreign key linking to riskexposure.auto_risk. Business justification: Auto loss history (collision, comprehensive, liability claims) must link to auto_risk for vehicle-specific and driver-specific rating.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Prior catastrophe losses (catastrophe_flag, catastrophe_code fields exist) link to specific cat events for loss history verification and underwriting surcharge']
  claim_id varchar [note: 'Foreign key to the current claim used to verify the prior loss record.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Prior loss amounts from CLUE/MVR reports and carrier loss runs are denominated in specific currencies.']
  insured_risk_id varchar [note: 'Insured risk (property, vehicle, driver) to which this prior loss applies.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Prior losses are classified by line of business for experience rating and loss development analysis.']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: Loss history may trigger or be validated by inspection. FK associates loss with the inspection order that investigated it. Nullable YES (not all losses trigger inspections).']
  loss_date_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Loss date is the primary dimension for accident year analysis, loss development triangles, IBNR reserve calculations, and statutory reporting (Schedule P).']
  party_id varchar [note: 'Party (applicant, named insured, driver) associated with this prior loss.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Prior losses are categorized by peril (loss_cause_code field exists). Peril provides standardized taxonomy for underwriting evaluation and loss-free year calculation by peril type.']
  property_risk_id varchar [note: 'Foreign key linking to riskexposure.property_risk. Business justification: Property loss history (roof damage, fire, water damage) must link directly to property_risk for property-specific underwriting rules, inspection triggers, and pricing.']
  submission_id varchar [note: 'Submission to which this prior loss record is attached.']
  verified_by_adjuster_id varchar [note: 'Foreign key to the adjuster party who performed the verification.']
  at_fault_flag boolean [note: 'Indicates whether the applicant or insured party was determined to be at fault for the loss.']
  catastrophe_code varchar [note: 'Industry catastrophe event code if the loss was part of a declared CAT event.']
  catastrophe_flag boolean [note: 'Indicates whether the prior loss was part of a declared catastrophe event.']
  claim_status varchar [note: 'Status of the prior claim at the time of reporting (open, closed, settled, denied, withdrawn).']
  clue_report_order_number varchar [note: 'Order number for the CLUE report from which this loss record was extracted.']
  coverage_type varchar [note: 'Type of coverage under which the prior loss was claimed (collision, comprehensive, liability, property, etc.).']
  created_timestamp timestamp [note: 'Timestamp when this loss history record was first created in the system.']
  excluded_from_rating_flag boolean [note: 'Indicates whether this prior loss is excluded from rating calculations (e.g., not-at-fault, CAT event).']
  exclusion_reason varchar [note: 'Reason the prior loss is excluded from rating (not at fault, catastrophe, outside lookback period).']
  impact_on_current_claim varchar [note: 'Assessment of how the verified prior loss information affects the handling or settlement of the current claim.']
  impact_on_rating varchar [note: 'Underwriting decision on how the prior loss impacts rating (surcharge, decline, refer, no impact, credit).']
  incurred_amount decimal(18,2) [note: 'Total incurred amount (paid plus outstanding reserves) for the prior loss.']
  lookback_period_months varchar [note: 'Number of months in the lookback period for this loss type as defined by underwriting guidelines.']
  loss_cause_code varchar [note: 'Standardized code for the cause of loss (fire, theft, collision, liability, water damage, wind, hail).']
  loss_cause_description varchar [note: 'Human-readable description of the loss cause.']
  loss_date date [note: 'Date the prior loss event occurred.']
  loss_description varchar [note: 'Narrative description of the prior loss event as reported by applicant or third-party source.']
  loss_free_years varchar [note: 'Number of years since this loss occurred, used in loss-free discount calculations.']
  loss_type varchar [note: 'Classification of the loss by type (first party, third party, liability, property, auto, workers compensation).']
  mvr_report_order_number varchar [note: 'Order number for the MVR report from which this loss record was extracted.']
  paid_amount decimal(18,2) [note: 'Total amount paid on the prior loss claim by the carrier.']
  prior_carrier_naic_code varchar [note: 'Five-digit NAIC company code for the carrier that handled the prior loss.']
  prior_carrier_name varchar [note: 'Name of the insurance carrier that handled the prior loss claim.']
  prior_policy_number varchar [note: 'Policy number under which the prior loss was claimed.']
  report_date date [note: 'Date the loss history report (CLUE, MVR, or carrier inquiry) was generated.']
  reserve_amount decimal(18,2) [note: 'Outstanding reserve amount on the prior loss at the time of reporting.']
  surcharge_amount decimal(18,2) [note: 'Premium surcharge amount applied due to this prior loss.']
  surcharge_percentage decimal(5,2) [note: 'Premium surcharge percentage applied due to this prior loss.']
  underwriter_notes varchar [note: 'Free-text notes entered by the underwriter regarding the prior loss and its impact on risk assessment.']
  updated_timestamp timestamp [note: 'Timestamp when this loss history record was last updated.']
  variance_amount decimal(18,2) [note: 'Dollar difference between prior loss reported amount and verified claim amount, if applicable.']
  variance_explanation varchar [note: 'Adjuster notes explaining any discrepancies found between the prior loss record and actual claim data.']
  verification_date date [note: 'Date the prior loss record was verified by underwriting.']
  verification_method varchar [note: 'Method used to verify the prior loss (third-party report, carrier inquiry, applicant statement, document review). [Moved from loss_history: Verification method may differ by claim context (one claim uses carrier inquiry, another uses adjuster inspection)']
  verification_status varchar [note: 'Current status of the verification process comparing prior loss data to actual claim outcome.']
  verified_flag boolean [note: 'Indicates whether the prior loss has been verified by underwriting or third-party source. [Moved from loss_history: Verification is claim-specific. A prior loss may be verified against one claim but not another, so the flag belongs to the association, not']
  within_lookback_flag boolean [note: 'Indicates whether the prior loss falls within the applicable lookback period for underwriting and rating.']

  Note: 'Prior loss record for a submission or insured risk from CLUE, MVR, or applicant disclosure: loss date, cause, paid amount, open/closed status. Grain: one row per prior loss. Used in appetite and pricing.'
}

Table coverage.bind_request {
  bind_request_id varchar [pk, note: 'Unique identifier for the bind request. Primary key. Grain: one row per bind request.']
  agency_id varchar [note: 'Reference to the agency through which the bind request was submitted. Distribution channel tracking.']
  binder_id varchar [note: 'Foreign key linking to coverage.binder. Business justification: Bind request results in a binder being issued when approved. 1 bind_request → 1 binder. FK populated when bind is approved and binder issued.']
  primary_bind_applicant_party_id varchar [note: 'Reference to the party requesting to bind the policy. Primary insured or named insured.']
  producers_producer_id varchar [note: 'Reference to the agent or broker submitting the bind request on behalf of the applicant.']
  quote_id varchar [note: 'Reference to the quote being bound. Links bind request to the quoted coverage and premium.']
  submission_id varchar [note: 'Reference to the originating submission. Traces bind request back to initial application.']
  uw_decision_id varchar [note: 'Foreign key linking to coverage.uw_decision. Business justification: Bind request follows from UW decision to approve. FK references the decision that authorized the bind.']
  automated_bind_flag boolean [note: 'Indicates whether the bind request was approved automatically by system rules without underwriter review.']
  bind_approval_date date [note: 'Date the underwriter or system approved the bind request. Policy issuance proceeds after approval.']
  bind_approval_timestamp timestamp [note: 'Precise date and time the bind request was approved. Used for SLA compliance and audit trail.']
  bind_authority_level varchar [note: 'Authority level required to approve this bind request. Determined by risk characteristics and premium size.']
  bind_conditions_met_flag boolean [note: 'Indicates whether all required bind conditions have been satisfied. Must be true for bind approval.']
  bind_conditions_required varchar [note: 'List of conditions that must be satisfied before bind approval. Inspection, loss control, additional documentation.']
  bind_rejection_date date [note: 'Date the bind request was rejected by underwriter or system. Ends bind request lifecycle.']
  bind_rejection_reason_code varchar [note: 'Standardized code indicating why the bind request was rejected. Links to rejection reason reference table.']
  bind_rejection_reason_description varchar [note: 'Detailed explanation of why the bind request was rejected. Provided to producer and applicant.']
  bind_request_date date [note: 'Date the bind request was submitted by producer or applicant. Business event timestamp for bind initiation.']
  bind_request_status varchar [note: 'Current lifecycle status of the bind request. Tracks progression from submission through final disposition.']
  certificate_of_insurance_required_flag boolean [note: 'Indicates whether a certificate of insurance must be issued at bind. Common for commercial liability.']
  created_timestamp timestamp [note: 'System timestamp when the bind request record was first created in the database. Audit trail.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts. Typically USD for domestic US business.']
  down_payment_amount decimal(15,2) [note: 'Amount due at bind to initiate coverage. First installment or full premium depending on payment plan.']
  down_payment_received_date date [note: 'Date the down payment was received and cleared. Triggers bind approval workflow.']
  down_payment_received_flag boolean [note: 'Indicates whether the down payment has been received and cleared. Required for bind approval.']
  inspection_completed_date date [note: 'Date the required inspection was completed. Satisfies bind condition for inspection requirement.']
  inspection_required_flag boolean [note: 'Indicates whether a property or risk inspection is required before bind approval. Common for commercial property.']
  lob varchar [note: 'Insurance line of business for the bind request. Personal Auto, Homeowners, Commercial General Liability, etc.']
  modified_timestamp timestamp [note: 'System timestamp when the bind request record was last modified. Audit trail for status changes and updates.']
  mortgagee_required_flag boolean [note: 'Indicates whether mortgagee or loss payee information is required before bind. Common for property coverage.']
  naic_company_code varchar [note: 'Five-digit NAIC code identifying the insurance company issuing the policy. Required for statutory reporting.']
  notes varchar [note: 'Free-text notes from producer, applicant, or underwriter regarding the bind request. Special instructions or clarifications.']
  number varchar [note: 'Human-readable business identifier for the bind request. Used in producer and customer communications.']
  payment_method varchar [note: 'Instrument used for down payment or first installment. Credit card, ACH, check, wire, cash, or escrow. [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|check|wire_transfer|cash|escrow — 7 candidates stripped; promote to reference product]']
  payment_plan_code varchar [note: 'Code identifying the requested payment plan. Determines installment schedule and down payment.']
  policy_type_code varchar [note: 'Code identifying the policy form or product type being bound. Links to policy type reference table.']
  prior_carrier_cancellation_required_flag boolean [note: 'Indicates whether proof of prior carrier cancellation is required before bind. Prevents dual coverage.']
  requested_effective_date date [note: 'Date the applicant or producer requests coverage to begin. May differ from quote effective date.']
  requested_expiration_date date [note: 'Date the applicant or producer requests coverage to end. Typically one year from effective date.']
  sla_actual_hours decimal(10,2) [note: 'Actual number of hours taken to process bind request. Calculated from request to approval or rejection.']
  sla_met_flag boolean [note: 'Indicates whether the bind request was processed within the SLA target. Used for performance reporting.']
  sla_target_hours varchar [note: 'Target number of hours for bind request processing. Used for performance tracking and producer expectations.']
  state_code varchar [note: 'Two-letter state code where the risk is domiciled. Determines regulatory jurisdiction and filing requirements.']
  timestamp timestamp [note: 'Precise date and time the bind request was received. Used for SLA tracking and audit trail.']
  total_premium_amount decimal(15,2) [note: 'Total premium amount from the quote being bound. Includes base premium, taxes, fees, and surcharges.']

  Note: 'Formal request to bind a quoted policy, submitted by producer or applicant. Grain: one row per bind request. Captures requested effective date, payment plan, and bind confirmation or rejection reason.'
}

Table coverage.binder {
  binder_id varchar [pk, note: 'Unique identifier for the binder record. Primary key.']
  agency_id varchar [note: 'Reference to the agency that bound this coverage.']
  binder_insured_party_id varchar [note: 'Reference to the party being insured under this binder.']
  binder_party_id varchar [note: 'Reference to the underwriter who authorized this binder.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Binders commit premium amounts in specific currencies before policy issuance. Binding authority systems require currency reference for limit validation, premium reconciliation, and bordereaux']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Binders are issued under specific lines of business for binding authority limit tracking and bordereaux reporting.']
  policy_id varchar [note: 'Reference to the formal policy issued after this binder, if applicable.']
  producers_producer_id varchar [note: 'Reference to the producer or agent who bound this coverage.']
  quote_id varchar [note: 'Reference to the quote that was bound to create this binder.']
  submission_id varchar [note: 'Reference to the submission that resulted in this binder.']
  uw_decision_id varchar [note: 'Foreign key linking to coverage.uw_decision. Business justification: Binder is issued based on UW decision. FK references the decision that authorized the binder. Nullable YES (some binders may not have explicit decision records).']
  bind_date date [note: 'Date when the binder was issued and coverage became effective.']
  binder_status varchar [note: 'Current lifecycle status of the binder contract.']
  binding_authority_limit decimal(15,2) [note: 'Maximum premium or limit the binding authority can issue without referral.']
  binding_authority_type varchar [note: 'Type of authority under which this binder was issued.']
  cancellation_date date [note: 'Date when the binder was cancelled, if applicable.']
  cancellation_reason varchar [note: 'Reason for binder cancellation, if applicable.']
  commission_amount decimal(15,2) [note: 'Total commission payable to the producer for this binder.']
  commission_rate decimal(5,4) [note: 'Producer commission rate as a decimal percentage for this binder.']
  coverage_limit_amount decimal(15,2) [note: 'Maximum liability limit provided under this binder.']
  created_by_user_code varchar [note: 'User identifier of the person who created this binder record.']
  created_timestamp timestamp [note: 'Timestamp when this binder record was first created in the system.']
  deductible_amount decimal(15,2) [note: 'Deductible amount applicable to claims under this binder.']
  document_url varchar [note: 'Reference URL or path to the binder document in the document management system.']
  down_payment_amount decimal(15,2) [note: 'Initial payment required to bind coverage.']
  effective_date date [note: 'Date when binder coverage begins.']
  expiration_date date [note: 'Date when binder coverage ends or formal policy must be issued.']
  issuing_company_code varchar [note: 'NAIC company code of the insurer issuing this binder.']
  issuing_state varchar [note: 'State jurisdiction where the binder was issued.']
  modified_by_user_code varchar [note: 'User identifier of the person who last modified this binder record.']
  modified_timestamp timestamp [note: 'Timestamp when this binder record was last modified.']
  notes varchar [note: 'Free-form notes or comments about this binder.']
  number varchar [note: 'Externally-known unique business identifier for the binder contract.']
  payment_plan_code varchar [note: 'Code identifying the premium payment plan for this binder.']
  policy_issued_date date [note: 'Date when the formal policy was issued to replace this binder.']
  policy_type_code varchar [note: 'Code identifying the specific policy form or product type.']
  premium_amount decimal(15,2) [note: 'Total premium amount for the binder period.']
  replaced_by_policy_flag boolean [note: 'Indicates whether this binder was replaced by a formal policy issuance.']
  risk_state varchar [note: 'State where the insured risk is located.']
  special_conditions varchar [note: 'Any special conditions or endorsements attached to this binder.']
  term_days varchar [note: 'Duration of binder coverage in days, typically 30-90 days.']
  total_insured_value decimal(15,2) [note: 'Total value of all property and assets covered under this binder.']

  Note: 'Temporary insurance contract issued upon bind confirmation, providing coverage before the formal policy is issued. Captures binder number, effective/expiration dates, LOB, and issuing authority.'
}

Table coverage.coverage {
  coverage_id varchar [pk, note: 'Unique identifier for the coverage. Primary key.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Premium amounts on coverages must be denominated in a specific currency for multi-currency policies, financial reporting, and reinsurance cession calculations.']
  fac_agreement_id varchar [note: 'Foreign key linking to reinsurance.fac_agreement. Business justification: Facultative reinsurance is placed on specific high-value or unusual coverages. Underwriters and reinsurance managers need to track which coverages have facultative protection for']
  insured_risk_id varchar [note: 'Foreign key to the insured risk this coverage protects.']
  line_id varchar [note: 'Foreign key linking to policy.line. Business justification: A coverage belongs to a specific LOB line record. LOB-level premium aggregation, loss ratio reporting, and reinsurance treaty allocation require navigating from coverage to its parent line']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Coverages must link to LOB master for regulatory reporting (Schedule P), reinsurance treaty assignment, loss ratio analysis, and underwriting authority limits.']
  policy_term_id varchar [note: 'Foreign key to the policy term this coverage is attached to.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Coverages are created or modified by specific policy transactions (new business, endorsements, renewals).']
  prior_coverage_id varchar [note: 'Foreign key to the previous version of this coverage, if this is an endorsement or renewal.']
  reinsurance_treaty_id varchar [note: 'Foreign key to the reinsurance treaty covering this coverage, if applicable.']
  servicing_agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Tracks the agency of record for in-force coverage, supporting producer servicing assignments, commission calculations on earned premium, policy change routing, and producer performance']
  servicing_producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Identifies the individual producer of record for the coverage, enabling producer-level commission allocation, book of business tracking, servicing responsibility assignment, and']
  aggregate_limit_amount decimal(18,2) [note: 'Maximum total amount payable under this coverage for all occurrences during the policy term.']
  basis varchar [note: 'Trigger basis for the coverage (occurrence-based or claims-made).']
  cancellation_date date [note: 'Date when the coverage was cancelled, if applicable.']
  cancellation_reason_code varchar [note: 'Code indicating the reason for coverage cancellation.']
  ceded_percentage decimal(5,2) [note: 'Percentage of this coverage ceded to reinsurers.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of loss shared by the insured after deductible is met.']
  coverage_description varchar [note: 'Detailed textual description of what this coverage protects against.']
  coverage_status varchar [note: 'Current lifecycle status of the coverage.']
  created_timestamp timestamp [note: 'Timestamp when this coverage record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'Amount the insured must pay out-of-pocket before coverage applies.']
  deductible_type varchar [note: 'Type of deductible applied to this coverage.']
  effective_date date [note: 'Date when the coverage becomes effective and protection begins.']
  expiration_date date [note: 'Date when the coverage expires and protection ends.']
  exposure_units decimal(18,2) [note: 'Number of rating units used to calculate premium (e.g., payroll amount, number of vehicles).']
  form_edition_date date [note: 'Edition date of the coverage form used.']
  form_number varchar [note: 'ISO or proprietary form number defining the coverage terms and conditions.']
  is_mandatory_coverage boolean [note: 'Indicates whether this coverage is required by law or regulation.']
  is_optional_coverage boolean [note: 'Indicates whether this coverage was elected by the insured as optional.']
  is_primary_coverage boolean [note: 'Indicates whether this is the primary coverage on the policy term.']
  iso_coverage_code varchar [note: 'Standardized ISO code for this coverage type.']
  last_modified_timestamp timestamp [note: 'Timestamp when this coverage record was last updated.']
  naic_line_code varchar [note: 'NAIC line of business code for statutory reporting.']
  number varchar [note: 'Business identifier for the coverage, often printed on declarations page.']
  per_occurrence_limit_amount decimal(18,2) [note: 'Maximum amount payable per occurrence or event under this coverage.']
  premium_amount decimal(18,2) [note: 'Premium charged for this specific coverage.']
  rate decimal(10,6) [note: 'Rating factor or rate per unit applied to calculate premium for this coverage.']
  rating_basis varchar [note: 'Unit of measure used for rating (e.g., per $1000 of coverage, per vehicle, per square foot).']
  source_system_code varchar [note: 'Code identifying the source system that originated this coverage record.']
  sub_coverage_code varchar [note: 'Code for sub-coverage or endorsement modifying the base coverage.']
  territory varchar [note: 'Geographic territory where the coverage applies (e.g., USA, Worldwide).']
  underwriting_tier varchar [note: 'Risk tier assigned during underwriting that affects coverage pricing.']
  valuation_method varchar [note: 'Method used to determine the value of a covered loss.']
  version_number varchar [note: 'Version number tracking changes to this coverage over the policy term lifecycle.']

  Note: 'One row per coverage per policy term. Bridge between the policy contract and insured risk. Captures coverage type, LOB, form number, effective/expiration dates, and status. Links to Policy Term and Insured Risk.'
}

Table coverage.limit {
  limit_id varchar [pk, note: 'Unique identifier for the limit record. Primary key.']
  coverage_id varchar [note: 'Foreign key to the coverage to which this limit is attached.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Limit amounts require formal currency reference for multi-currency policies, reinsurance treaty attachment points, and regulatory capital calculations.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this limit is in force.']
  aggregate_limit_period varchar [note: 'Time period over which the aggregate limit applies: policy period, calendar year, accident year, or rolling 12 months.']
  amount decimal(18,2) [note: 'The monetary value of the limit in the policy currency.']
  applies_to_coverage_part varchar [note: 'Specific coverage part or section to which this limit applies (e.g., Coverage A, Coverage B, Medical Payments). Null if limit applies to entire coverage.']
  applies_to_peril varchar [note: 'Specific peril or cause of loss to which this limit applies (e.g., fire, wind, flood, earthquake, theft). Null if limit applies to all covered perils.']
  attachment_point decimal(18,2) [note: 'For excess or umbrella limits, the attachment point or retention amount above which this limit begins to apply.']
  basis varchar [note: 'Basis on which the limit applies: per occurrence, per claim, per policy period, per location, per person, per accident, or aggregate annual. [ENUM-REF-CANDIDATE']
  created_timestamp timestamp [note: 'Timestamp when this limit record was first created in the data warehouse.']
  effective_date date [note: 'Date on which this limit becomes effective and begins to apply to covered losses.']
  erosion_method varchar [note: 'Method by which the limit is eroded or depleted: per claim, per payment, or aggregate depletion over the policy period.']
  exhausted_date date [note: 'Date on which the limit was fully exhausted by claim payments. Null if limit has not been exhausted.']
  expiration_date date [note: 'Date on which this limit expires and ceases to apply. Null for limits that remain in force through the end of the policy term.']
  is_combined_single_limit boolean [note: 'Indicates whether this is a combined single limit (CSL) covering bodily injury and property damage under one limit.']
  is_shared_limit boolean [note: 'Indicates whether this limit is shared across multiple coverages, insured risks, or policy terms.']
  is_stacked boolean [note: 'Indicates whether this limit can be stacked with other limits (e.g., uninsured/underinsured motorist coverage).']
  iso_limit_code varchar [note: 'Standard ISO code for the limit type, used for rating and statistical reporting.']
  limit_code varchar [note: 'Standard code or abbreviation for the limit type, often used in rating and policy administration systems (e.g., ISO limit codes).']
  limit_description varchar [note: 'Detailed textual description of the limit, including any special conditions, exclusions, or clarifications.']
  limit_status varchar [note: 'Current status of the limit: active, suspended, exhausted (fully depleted by claims), cancelled, or expired.']
  limit_type varchar [note: 'Type of limit: occurrence, aggregate, per-person, per-accident, combined single limit (CSL), split limits, or sublimit. [ENUM-REF-CANDIDATE: occurrence|aggregate|per_person|per_accident|combined_single|split|sublimit — 7 candidates stripped; promote to']
  modified_timestamp timestamp [note: 'Timestamp when this limit record was last modified in the data warehouse.']
  naic_limit_code varchar [note: 'NAIC standard code for the limit type, used for regulatory and statutory reporting.']
  reinstatement_premium_rate decimal(5,4) [note: 'Rate or percentage of the original premium charged for reinstating the limit after a claim. Null if no reinstatement premium applies.']
  reinstatement_provision varchar [note: 'Provision for reinstating the limit after a claim: automatic reinstatement, manual reinstatement with additional premium, or no reinstatement.']
  remaining_limit_amount decimal(18,2) [note: 'Current remaining amount of the limit after deducting claim payments and reserves. Null if not tracked or if limit is not aggregate.']
  scope varchar [note: 'Scope of the limit: primary, excess, umbrella, or sublimit within a broader coverage.']
  sequence varchar [note: 'Sequence or ordering number for this limit within the coverage, used when multiple limits apply to the same coverage.']
  source_system_code varchar [note: 'Unique identifier for this limit in the source policy administration system.']
  split_limit_bodily_injury_per_accident decimal(18,2) [note: 'For split limits, the maximum amount payable for bodily injury per accident (all persons combined).']
  split_limit_bodily_injury_per_person decimal(18,2) [note: 'For split limits, the maximum amount payable for bodily injury per person per accident.']
  split_limit_property_damage_per_accident decimal(18,2) [note: 'For split limits, the maximum amount payable for property damage per accident.']

  Note: 'Limit attached to a coverage: occurrence limit, aggregate limit, per-person limit, split limits. Supports stacked, CSL, and sublimit structures. One row per limit per coverage.'
}

Table coverage.deductible {
  deductible_id varchar [pk, note: 'Unique identifier for the deductible record. Primary key.']
  coverage_id varchar [note: 'Foreign key to the coverage to which this deductible applies.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Deductible amounts must reference currency for multi-currency policies, claims adjudication in foreign jurisdictions, and financial statement presentation.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this deductible is in effect.']
  acord_code varchar [note: 'ACORD standard code for this deductible type, used for data exchange and reporting.']
  aggregate_limit decimal(18,2) [note: 'Maximum total deductible amount the insured must pay during the policy term when deductible_basis is aggregate_annual.']
  amount decimal(18,2) [note: 'Flat dollar amount of the deductible when deductible_type is flat or SIR.']
  application_method varchar [note: 'How the deductible is applied: before coverage limits, after coverage limits, or split between insured and insurer.']
  applies_to_coverage_part varchar [note: 'Specific coverage part to which this deductible applies (e.g., Property, Liability, Medical Payments). Null if applies to entire coverage.']
  applies_to_lae_flag boolean [note: 'Indicates whether the deductible applies to Loss Adjustment Expenses in addition to the loss amount. True if LAE is subject to deductible.']
  applies_to_peril varchar [note: 'Specific peril or cause of loss to which this deductible applies (e.g., wind, hail, earthquake, flood). Null if applies to all perils.']
  applies_to_salvage_flag boolean [note: 'Indicates whether salvage recoveries reduce the deductible amount. True if salvage offsets deductible.']
  applies_to_subrogation_flag boolean [note: 'Indicates whether subrogation recoveries reduce the deductible amount. True if subrogation offsets deductible.']
  basis varchar [note: 'Basis on which the deductible applies: per occurrence, per claim, per policy term, per location, per item, or aggregate annual.']
  created_timestamp timestamp [note: 'Timestamp when this deductible record was first created in the system.']
  deductible_description varchar [note: 'Free-text description of the deductible terms, conditions, and any special provisions or endorsements.']
  deductible_type varchar [note: 'Type of deductible: flat dollar amount, percentage of loss, Self-Insured Retention (SIR), disappearing, franchise, or aggregate.']
  disappearing_threshold decimal(18,2) [note: 'Loss amount at which a disappearing deductible fully disappears. Deductible reduces proportionally as loss approaches this threshold.']
  effective_date date [note: 'Date on which this deductible becomes effective for the coverage.']
  expiration_date date [note: 'Date on which this deductible expires or is no longer in effect. Null for open-ended deductibles.']
  iso_form_code varchar [note: 'ISO form code or endorsement number that defines this deductible structure (e.g., IL 03 10, CP 03 10).']
  maximum_deductible_amount decimal(18,2) [note: 'Maximum dollar amount for percentage-based or disappearing deductibles. Caps the deductible at this ceiling.']
  minimum_deductible_amount decimal(18,2) [note: 'Minimum dollar amount for percentage-based deductibles. Ensures deductible does not fall below this floor.']
  naic_code varchar [note: 'NAIC code for deductible classification used in statutory reporting (Schedule P, Annual Statement).']
  percentage decimal(5,2) [note: 'Percentage of loss or insured value when deductible_type is percentage. Stored as decimal (e.g., 5.00 for 5%).']
  source_system_code varchar [note: 'Unique identifier for this deductible in the source policy administration system.']
  transaction_effective_date date [note: 'Effective date of the policy transaction that created or modified this deductible.']
  transaction_type varchar [note: 'Type of policy transaction that created or modified this deductible record (NB, REN, END, CAN, RI).']
  underwriter_notes varchar [note: 'Free-text notes from the underwriter regarding special deductible terms, exceptions, or rationale for non-standard deductibles.']
  updated_timestamp timestamp [note: 'Timestamp when this deductible record was last modified.']
  waiting_period_days varchar [note: 'Number of days the insured must wait before coverage begins, applicable to time-based deductibles (e.g., business interruption).']
  waiver_authority varchar [note: 'Name or role of the person or system that authorized the deductible waiver.']
  waiver_date date [note: 'Date on which the deductible waiver was granted.']
  waiver_flag boolean [note: 'Indicates whether the deductible has been waived for this coverage. True if waived, False otherwise.']
  waiver_reason varchar [note: 'Business reason for waiving the deductible (e.g., catastrophe event, customer retention, underwriting exception).']

  Note: 'Deductible attached to a coverage: flat, percentage, SIR, or disappearing. Captures amount, basis, application method, and waiver flags. One row per deductible per coverage.'
}

Table coverage.exclusion {
  exclusion_id varchar [pk, note: 'Unique identifier for the exclusion record. Primary key.']
  coverage_id varchar [note: 'Foreign key to the coverage to which this exclusion is attached.']
  excluded_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Named exclusions (excluded driver in personal auto, excluded partner in commercial liability) explicitly identify a specific party to be excluded from coverage.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Exclusions reference specific perils (earthquake, flood, wind) by ISO/NAIC codes.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this exclusion is in force.']
  specific_insured_risk_id varchar [note: 'Foreign key to a specific insured risk if this exclusion applies only to that risk. Null if exclusion applies to all risks under the coverage.']
  superseded_by_exclusion_id varchar [note: 'Foreign key to the exclusion record that supersedes this one, if this exclusion has been replaced by a later endorsement. Null if current.']
  applies_to_all_insured_risks boolean [note: 'Boolean flag indicating whether this exclusion applies blanket to all insured risks under the coverage or only to specific risks.']
  applies_to_first_party boolean [note: 'Boolean flag indicating whether this exclusion applies to first-party coverage under the policy.']
  applies_to_third_party boolean [note: 'Boolean flag indicating whether this exclusion applies to third-party liability coverage under the policy.']
  buyback_endorsement_available boolean [note: 'Boolean flag indicating whether a standard endorsement exists to buy back coverage for this exclusion.']
  buyback_premium_amount decimal(15,2) [note: 'Additional premium charged to waive or buy back this exclusion, if applicable. Null if exclusion is not waivable.']
  claims_made_trigger boolean [note: 'Boolean flag indicating whether this exclusion applies only to claims-made policies or claims-made coverage triggers.']
  created_timestamp timestamp [note: 'Timestamp when this exclusion record was first created in the system.']
  effective_date date [note: 'Date from which this exclusion applies to the coverage. Must align with policy term or endorsement effective date.']
  endorsement_effective_date date [note: 'Date on which the endorsement introducing this exclusion became effective.']
  endorsement_number varchar [note: 'Policy endorsement number that introduced or modified this exclusion, if applicable.']
  exclusion_category varchar [note: 'High-level classification of what dimension the exclusion applies to: specific peril, property type, activity, location, person, time period, condition, or other.']
  exclusion_code varchar [note: 'Standard code identifying the exclusion type. May be ISO (Insurance Services Office) standard code or carrier-specific manuscript code.']
  exclusion_description varchar [note: 'Detailed narrative description of what perils, circumstances, or losses are excluded from coverage under this exclusion clause.']
  exclusion_name varchar [note: 'Short business-friendly name of the exclusion for display and reporting purposes.']
  exclusion_status varchar [note: 'Current lifecycle status of the exclusion: active and in force, inactive, superseded by a later endorsement, deleted, or pending approval.']
  exclusion_type varchar [note: 'Classification of the exclusion origin: ISO standard form, manuscript custom language, endorsement-based, statutory requirement, regulatory mandate, or carrier-specific.']
  expiration_date date [note: 'Date on which this exclusion ceases to apply. Nullable for exclusions that remain in force through policy term expiration.']
  iso_form_number varchar [note: 'ISO standard form number if this exclusion is derived from an ISO policy form or endorsement.']
  language_text varchar [note: 'Full legal text of the exclusion clause as it appears in the policy contract or endorsement.']
  last_modified_timestamp timestamp [note: 'Timestamp when this exclusion record was last updated or modified.']
  occurrence_trigger boolean [note: 'Boolean flag indicating whether this exclusion applies to occurrence-based policies or occurrence coverage triggers.']
  regulatory_mandate_flag boolean [note: 'Boolean flag indicating whether this exclusion is mandated by state or federal regulation and cannot be waived.']
  scope varchar [note: 'Scope level at which the exclusion operates: coverage-level, policy-wide, location-specific, vehicle-specific, driver-specific, building-specific, or other.']
  source_system_code varchar [note: 'Unique identifier of this exclusion record in the source policy administration system.']
  state_mandate_code varchar [note: 'State jurisdiction code if this exclusion is mandated by a specific state Department of Insurance regulation.']
  underwriter_notes varchar [note: 'Free-text notes from the underwriter explaining the rationale for applying this exclusion or any special handling instructions.']
  version_number varchar [note: 'Version number of this exclusion record, incremented with each endorsement or modification.']
  waivable_flag boolean [note: 'Boolean flag indicating whether this exclusion can be waived or bought back through an endorsement or additional premium.']

  Note: 'Exclusion attached to a coverage: ISO or manuscript exclusion code, description, endorsement reference, and effective dates. One row per exclusion per coverage.'
}

Table coverage.rate {
  rate_id varchar [pk, note: 'Unique identifier for the rate element applied to a coverage during pricing.']
  coverage_id varchar [note: 'Reference to the coverage to which this rate element applies.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Rates are territory-specific; territory_code is denormalized geography reference.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.classification_code. Business justification: Rating requires formal link to classification code master for base rate lookup, hazard group assignment, loss cost retrieval, and regulatory filing compliance.']
  policy_term_id varchar [note: 'Reference to the policy term during which this rate is effective.']
  basis_code varchar [note: 'The unit of measure to which the rate applies: per hundred of coverage, per thousand, per unit, per vehicle, per location, per employee, per payroll unit, or flat amount.']
  coinsurance_factor decimal(6,4) [note: 'Factor applied when coinsurance provisions are in effect, adjusting premium based on the ratio of insurance to value.']
  created_timestamp timestamp [note: 'Timestamp when this rate record was first created in the system.']
  deductible_credit_factor decimal(6,4) [note: 'Credit factor applied to reduce premium when a deductible is selected, reflecting reduced carrier exposure.']
  effective_date date [note: 'The date on which this rate element becomes effective for premium calculation.']
  endorsement_number varchar [note: 'Endorsement number if this rate element was added or modified via a policy endorsement.']
  experience_modifier decimal(6,3) [note: 'Experience modification factor applied to adjust premium based on the insureds historical loss experience. Typically ranges from 0.500 to 2.000.']
  expiration_date date [note: 'The date on which this rate element expires and is no longer valid for premium calculation. Null indicates no expiration.']
  factor decimal(10,4) [note: 'Multiplicative factor applied to base rate for territory, class, or experience adjustments. Typically a decimal multiplier.']
  filing_approval_date date [note: 'The date on which the state Department of Insurance (DOI) approved this rate for use.']
  filing_number varchar [note: 'The regulatory filing number under which this rate was approved by the state Department of Insurance (DOI).']
  filing_state_code varchar [note: 'Two-letter state code where this rate was filed and approved. Rates are state-specific in Property and Casualty insurance.']
  increased_limits_factor decimal(8,4) [note: 'Factor applied when coverage limits exceed the base limit, reflecting the increased exposure. Common in liability coverages.']
  iso_form_number varchar [note: 'ISO form number associated with this rate element, linking the rate to standardized policy forms and endorsements.']
  last_modified_timestamp timestamp [note: 'Timestamp when this rate record was last modified, supporting audit trail and premium reconstruction.']
  minimum_premium_amount decimal(15,2) [note: 'The minimum premium amount that must be charged for this coverage, regardless of calculated premium. Ensures carrier covers administrative costs.']
  override_approval_date date [note: 'Date on which the rate override was approved.']
  override_approved_by varchar [note: 'Name or identifier of the underwriter or manager who approved the rate override.']
  override_indicator boolean [note: 'Indicates whether this rate was manually overridden by an underwriter, deviating from the standard rating algorithm.']
  override_reason varchar [note: 'Business justification for the rate override, required for audit and regulatory compliance.']
  rate_code varchar [note: 'The unique code identifying the rate element in the rating engine or rate table.']
  rating_algorithm_code varchar [note: 'Code identifying the rating algorithm or pricing model used to calculate this rate element.']
  rating_variable_name varchar [note: 'Name of the rating variable or input factor used in the rating algorithm for this rate element.']
  rating_variable_value decimal(18,2) [note: 'The value of the rating variable at the time of rating, captured for premium reconstruction and audit purposes.']
  schedule_credit_debit_amount decimal(15,2) [note: 'Dollar amount of schedule credit (negative) or debit (positive) applied for underwriting judgment factors such as management quality, safety programs, or loss control.']
  schedule_credit_debit_percentage decimal(5,2) [note: 'Percentage credit (negative) or debit (positive) applied for underwriting judgment factors. Expressed as a percentage of base premium.']
  sequence_number varchar [note: 'Sequence number for ordering multiple rate elements applied to the same coverage within a policy term.']
  source_system_code varchar [note: 'Code identifying the source system from which this rate element originated, such as the rating engine or policy administration system.']
  table_name varchar [note: 'Name or identifier of the rate table from which this rate element was retrieved.']
  table_version varchar [note: 'Version identifier of the rate table, enabling reconstruction of premium at any point in time using the correct rate version.']
  transaction_type_code varchar [note: 'Type of policy transaction that introduced or modified this rate element: New Business (NB), Renewal (REN), Endorsement (END), Cancellation (CAN), or Reinstatement (RI).']
  type_code varchar [note: 'Classification of the rate element: base rate, territory factor, class factor, experience modifier, schedule credit or debit, discretionary adjustment, minimum premium, or flat charge.']
  value decimal(18,6) [note: 'The numeric rate value or factor applied during premium calculation. Precision supports actuarial rating accuracy.']

  Note: 'Rate element applied to a coverage during pricing: rate code, rate basis, rate value, territory factor, class factor, and effective date. Supports reconstruction of premium at any point in time.'
}

Table coverage.condition {
  condition_id varchar [pk, note: 'BIGINT']
  condition_policy_transaction_id varchar [note: 'Policy transaction (endorsement, new business, renewal) that introduced or last modified this condition.']
  coverage_id varchar [note: 'coverage.coverage.coverage_id']
  policy_term_id varchar [note: 'policy.term.term_id']
  waived_by_party_id varchar [note: 'description']
  breach_consequence varchar [note: 'description']
  compliance_due_date date [note: 'Date by which the insured must demonstrate compliance with the condition.']
  compliance_required boolean [note: 'description']
  compliance_required_flag boolean [note: 'BOOLEAN']
  compliance_verified_date date [note: 'Date on which underwriting confirmed the insured satisfied this condition.']
  compliance_verified_flag boolean [note: 'BOOLEAN']
  condition_category varchar [note: 'description']
  condition_code varchar [note: 'Carrier or ISO form code identifying the standard condition text, e.g. ISO form number or internal code.']
  condition_description varchar [note: 'Full text or summary of the contractual condition as it appears on the policy form.']
  condition_status varchar [note: 'STRING']
  condition_type varchar [note: 'Classifies the condition: WARRANTY, CONDITION_PRECEDENT, CONDITION_SUBSEQUENT, SPECIAL_PROVISION, REPORTING_REQUIREMENT, OTHER.']
  created_timestamp timestamp [note: 'System timestamp when this condition record was first inserted.']
  effective_date date [note: 'Date from which this condition is in force on the coverage. Supports mid-term endorsement of conditions.']
  expiration_date date [note: 'Date on which this condition ceases to apply. Null means the condition runs to the end of the policy term.']
  form_number varchar [note: 'STRING']
  is_active boolean [note: 'description']
  is_mandatory boolean [note: 'TRUE if the condition is a mandatory statutory or regulatory requirement; FALSE if it is a negotiated or optional provision.']
  is_satisfied boolean [note: 'Tracks whether the insured has fulfilled the condition. NULL = not yet evaluated; TRUE = satisfied; FALSE = breached.']
  iso_condition_code varchar [note: 'description']
  last_modified_timestamp timestamp [note: 'TIMESTAMP']
  mandatory_flag boolean [note: 'BOOLEAN']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to this condition record.']
  non_compliance_action varchar [note: 'Action taken if condition is not met: CANCEL, ENDORSE, SURCHARGE, NOTIFY, NONE.']
  notes varchar [note: 'Free-text underwriter or compliance notes about this condition, e.g. reason for imposition or waiver details.']
  satisfaction_date date [note: 'Date on which the condition was confirmed satisfied or breached. Null until evaluated.']
  source_form_number varchar [note: 'STRING']
  source_system_code varchar [note: 'Code identifying the originating system of record for this condition row.']
  source_system_condition_ref varchar [note: 'STRING']
  text varchar [note: 'Full policy language or manuscript wording of the condition as it appears in the contract.']
  type_code varchar [note: 'Classifies the condition: WARRANTY, CONDITION_PRECEDENT, SPECIAL_CONDITION, REPORTING_REQUIREMENT, OTHER.']
  underwriter_notes varchar [note: 'STRING']
  updated_timestamp timestamp [note: 'System timestamp of the most recent update to this condition record.']
  waiver_reason varchar [note: 'Free-text reason recorded when condition_status is WAIVED; NULL otherwise.']
  waiver_reason_code varchar [note: 'STRING']

  Note: 'One row per contract Condition per Coverage. Attaches named Conditions to a Coverage and Policy Term, completing the VREQ-004 quartet alongside Limit, Deductible, and Exclusion.'
}

Table premium.premium_transaction {
  premium_transaction_id varchar [pk, note: 'Unique surrogate identifier for each premium financial movement record. Grain: one row per financial premium movement (Written, Earned, Unearned, Return). Primary key.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this premium transaction is recognized for statutory and GAAP reporting purposes.']
  agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Agency-bill premium reconciliation requires attributing premium transactions directly to the billing agency for agency account statements and premium trust accounting.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Premium transactions posted to accounting periods require calendar dimensions for fiscal/accident/policy year reporting.']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: Retrospectively-rated policies (workers comp, general liability) adjust premium based on actual claim experience during the policy term.']
  coverage_id varchar [note: 'Reference to the specific coverage line within the policy term to which this premium transaction is allocated. Enables per-coverage premium analytics.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Premium transactions record amounts in specific currencies. Multi-currency operations require proper FK for FX validation, conversion, and regulatory reporting.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Distribution channel written premium volume reporting is a core P&C management report for growth and profitability analysis by channel.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Premium transactions require geographic attribution for statutory state pages, territorial profitability analysis, regulatory reporting, and geographic concentration']
  household_id varchar [note: 'Foreign key linking to party.household. Business justification: Personal lines household-level premium aggregation reports (total written premium per household, retention analysis, cross-sell scoring) require direct household linkage on premium']
  insured_risk_id varchar [note: 'Reference to the insured risk or exposure unit (property, vehicle, driver) to which this premium transaction is allocated.']
  line_id varchar [note: 'Foreign key linking to policy.line. Business justification: P&C premium is written and earned at the line-of-business level on a policy. Line-level written premium reports, loss ratio monitoring by LOB, and reinsurance cession calculations require linking']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Normalize lob_code string to FK reference to shared.line_of_business master data. Premium transaction currently stores lob_code as string; replacing with FK enables consistent LOB']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: Commercial lines CAT accumulation reports and exposure management aggregate written/earned premium by insured location.']
  original_transaction_premium_transaction_id varchar [note: 'Reference to the original premium transaction that this record reverses or corrects. Populated only when reversal_indicator is True. Supports audit trail.']
  policy_id varchar [note: 'Reference to the policy under which this premium transaction was generated. Links the premium ledger entry to the master policy record.']
  policy_term_id varchar [note: 'Reference to the specific policy term (time-bounded period) to which this premium transaction belongs. Enables reconstruction of premium in force at any date.']
  policy_transaction_id varchar [note: 'Reference to the policy transaction (New Business, Renewal, Endorsement, Cancellation, Reinstatement) that triggered this premium movement.']
  producers_producer_id varchar [note: 'Reference to the producer (agent or broker) associated with this premium transaction for commission settlement and distribution channel reporting.']
  quote_id varchar [note: 'Foreign key linking to coverage.quote. Business justification: Premium transactions originate from bound quotes; accounting audit trail requires quote reference for rate reconciliation, variance analysis between quoted and booked premium, and']
  rate_table_id varchar [note: 'Foreign key linking to premium.rate_table. Business justification: Links each premium transaction to the versioned rate table used to price it, enabling audit of which rate filing, base rate, and algorithm produced the written premium.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Written and earned premium must be aggregated by rating territory for state rate filings, loss ratio monitoring, and reinsurance bordereau reporting.']
  audit_basis varchar [note: 'Exposure basis used for auditable policies (e.g., WC, CGL) to determine final earned premium: Payroll, Revenue, Units, Receipts, or None for non-auditable policies.']
  ceded_written_premium decimal(18,4) [note: 'Portion of gross written premium ceded to reinsurers under treaty or facultative agreements. Used for Schedule F and reinsurance bordereaux reporting.']
  cost_center_code varchar [note: 'Internal cost center or profit center code to which this premium transaction is allocated for management accounting and segment reporting purposes.']
  created_timestamp timestamp [note: 'Date and time when this premium transaction record was first created in the source system. Used for audit trail and data lineage.']
  days_in_force varchar [note: 'Number of days the coverage was in force during the accounting period for this premium transaction. Used in pro-rata earning and exposure calculations.']
  direct_billed_indicator boolean [note: 'Indicates whether this premium is billed directly to the policyholder (True) or through the producer/agency (False = agency billed). Drives billing workflow routing.']
  earned_premium decimal(18,4) [note: 'Portion of written premium recognized as earned for the accounting period based on pro-rata or other earning methodology. Core input to loss ratio (LR) calculation.']
  earning_method varchar [note: 'Method used to recognize written premium as earned over the policy period: Pro-Rata (daily), 1/365, 1/24 (monthly), Flat (fully earned at inception), or Other.']
  effective_date date [note: 'Date from which this premium transaction takes effect for coverage and financial recognition purposes. Used to reconstruct premium in force at any given date.']
  endorsement_type varchar [note: 'Type of endorsement premium adjustment: Additional (increase), Return (decrease/credit), Flat (no change), Audit (audit-based adjustment), or None for non-endorsement transactions.']
  expiration_date date [note: 'Date on which the premium coverage period ends for this transaction. Used for unearned premium (UEP) calculation and pro-rata earning.']
  exposure_amount decimal(18,4) [note: 'Quantitative exposure measure (e.g., payroll dollars, vehicle count, property TIV) underlying the premium calculation. Used for rate adequacy and actuarial analysis.']
  gl_account_code varchar [note: 'General ledger account code to which this premium transaction is posted in the statutory and GAAP accounting systems. Required for financial close and SOX compliance.']
  gross_written_premium decimal(18,4) [note: 'Total gross written premium amount for this transaction before cessions, taxes, fees, and commissions. Core ledger amount for statutory and GAAP reporting.']
  net_written_premium decimal(18,4) [note: 'Written premium net of reinsurance cessions. NWP = GWP minus ceded written premium. Used for net retention reporting and RBC calculations.']
  notes varchar [note: 'Free-text notes or comments entered by underwriters, billing staff, or system processes to explain the reason for or context of this premium transaction.']
  payment_plan_code varchar [note: 'Code identifying the installment or payment plan under which this premium is billed (e.g., Annual, Semi-Annual, Quarterly, Monthly, Pay-As-You-Go).']
  posted_timestamp timestamp [note: 'Date and time when this premium transaction was posted to the general ledger and accounting system. Distinct from the business event date.']
  pro_rata_factor decimal(10,6) [note: 'Decimal factor (0.0 to 1.0) representing the proportion of the policy period elapsed as of the accounting period end date. Used to compute earned premium.']
  rate decimal(18,6) [note: 'The rate applied to the exposure base to calculate the premium for this transaction. Expressed per unit of exposure (e.g., per $100 payroll, per $1000 TIV).']
  rate_effective_date date [note: 'Date on which the rate used for this premium transaction became effective. Required for rate adequacy monitoring and DOI rate filing compliance.']
  return_premium decimal(18,4) [note: 'Premium amount returned to the policyholder due to cancellation, mid-term endorsement reduction, or audit adjustment. Negative financial movement in the ledger.']
  reversal_indicator boolean [note: 'Flag indicating whether this premium transaction is a reversal of a previously posted transaction. True = reversal entry; False = original entry.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this premium transaction (e.g., PAS for PolicyCenter, BILLING for BillingCenter, RATING for rating engine).']
  state_code varchar [note: 'Two-letter US state code where the risk is located or the policy is written. Required for state-level statutory reporting and DOI filings.']
  transaction_date date [note: 'The business event date on which this premium movement was generated or triggered (e.g., policy effective date, endorsement effective date, cancellation date).']
  transaction_number varchar [note: 'Externally visible, human-readable identifier for this premium transaction as assigned by the Policy Administration System or billing system. Used in bordereaux and reconciliation.']
  transaction_status varchar [note: 'Current lifecycle state of the premium transaction in the accounting ledger: Pending (awaiting posting), Posted (booked to GL), Reversed, Voided, or Error.']
  transaction_type varchar [note: 'Classifies the premium movement. Allowed values: Written, Earned, Unearned, Return.']
  unearned_premium decimal(18,4) [note: 'Portion of written premium not yet earned as of the accounting period end date. Represents the UEP reserve liability on the balance sheet.']
  updated_timestamp timestamp [note: 'Date and time when this premium transaction record was last modified. Supports audit trail, change detection, and incremental data loading.']

  Note: 'Grain: one row per financial premium transaction. Carries FKs to policy, policy term, coverage, insured risk, and accounting period. transaction_type enumerates Written, Earned, Unearned, Return.'
}

Table premium.charge {
  charge_id varchar [pk, note: 'Unique identifier for the charge component within a premium transaction.']
  accounting_period_id varchar [note: 'Foreign key to the accounting period in which this charge is recognized.']
  agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Agency-bill reconciliation requires attributing charges directly to the billing agency. Agency bill statements aggregate charges by agency account; without a direct agency FK on charge']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Charges posted to accounting periods. FK enables period-based charge analysis, fiscal year reporting, and ensures charges align with calendar dimensions for financial statements.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Wind, hail, and hurricane surcharges are rated and reported by cat zone. Underwriters and actuaries aggregate charge amounts by cat zone for concentration monitoring and']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Individual rating charges (wind surcharges, earthquake deductible buybacks) are event-specific for post-catastrophe pricing adjustments, experience rating, and']
  coverage_id varchar [note: 'Foreign key to the coverage to which this charge applies, if coverage-specific.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Charges have amounts denominated in currency. FK enables currency validation, FX conversion for consolidated reporting, and ensures charge amounts reference valid active currencies for']
  driver_id varchar [note: 'Foreign key linking to riskexposure.driver. Business justification: Personal auto point surcharges, defensive driving credits, and good-student discounts are booked as named charges attributed to a specific driver.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Individual charges require geographic assignment for tax calculation, surplus lines allocation, territorial rating factors, and jurisdictional compliance.']
  insured_risk_id varchar [note: 'Foreign key to the insured risk to which this charge applies, if risk-specific.']
  line_id varchar [note: 'Foreign key linking to policy.line. Business justification: Surcharges, schedule credits/debits, and minimum premium charges apply at the policy line level in multi-line commercial policies.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Charges apply to specific lines of business. FK enables LOB-specific charge analysis, regulatory reporting by line, and ensures charges reference valid active LOBs.']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: Commercial multi-location policies apply location-specific surcharges (protection class charges, earthquake zone loadings, flood zone assessments).']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Individual charges (earthquake coverage, flood buyback, wind deductible) are peril-specific for pricing transparency, regulatory compliance, coverage verification, and claims']
  policy_id varchar [note: 'Foreign key to the policy to which this charge applies.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this charge is effective.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Every charge (surcharge, credit, minimum premium) is generated by a specific policy transaction (endorsement, cancellation, renewal).']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Producer commission statement generation and commissionable charge reconciliation require tracing each charge to the writing producer.']
  rate_table_id varchar [note: 'Foreign key linking to premium.rate_table. Business justification: Links each charge component (base premium, surcharge, credit) to the specific rate table entry that produced it, supporting regulatory filing traceability and actuarial audit.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Rating charges (base premium, increased limits factors, deductible credits) are computed from territory-specific rate relativities.']
  vehicle_id varchar [note: 'Foreign key linking to riskexposure.vehicle. Business justification: Commercial auto policies apply per-vehicle charges such as safety equipment credits, anti-theft discounts, and radius-of-operation surcharges.']
  amount decimal(18,2) [note: 'Monetary value of the charge component in the policy currency.']
  basis_amount decimal(18,2) [note: 'Base amount to which the charge rate is applied to derive the charge amount.']
  ceded_amount decimal(18,2) [note: 'Portion of the charge amount ceded to reinsurers under applicable reinsurance agreements.']
  charge_category varchar [note: 'High-level category of the charge: premium, fee, penalty, refund, or adjustment.']
  charge_description varchar [note: 'Detailed business description of the charge component and its purpose.']
  charge_status varchar [note: 'Current lifecycle status of the charge: active, voided, reversed, adjusted, or pending.']
  charge_type varchar [note: 'Classification of the charge component: base premium, surcharge, credit, discount, minimum premium, flat charge, or adjustment. [ENUM-REF-CANDIDATE: base_premium|surcharge|credit|discount|minimum_premium|flat_charge|adjustment — 7 candidates stripped']
  commission_amount decimal(18,2) [note: 'Commission amount payable to the producer based on this charge, if commissionable.']
  commission_rate decimal(5,2) [note: 'Percentage rate applied to this charge to calculate producer commission, if commissionable.']
  created_timestamp timestamp [note: 'Date and time when this charge record was first created in the system.']
  earned_amount decimal(18,2) [note: 'Portion of the charge amount that has been earned as of the accounting period date.']
  effective_date date [note: 'Date from which this charge becomes effective and applies to the policy or coverage.']
  expiration_date date [note: 'Date on which this charge expires and no longer applies to the policy or coverage.']
  gl_account_code varchar [note: 'General ledger account code to which this charge is posted for financial reporting.']
  is_ceded boolean [note: 'Indicates whether this charge is subject to reinsurance cession under a treaty or facultative agreement.']
  is_commissionable boolean [note: 'Indicates whether this charge is subject to producer commission calculation.']
  is_earned boolean [note: 'Indicates whether this charge has been earned as of the accounting period date.']
  is_minimum_premium boolean [note: 'Indicates whether this charge represents a minimum premium requirement for the policy or coverage.']
  is_prorated boolean [note: 'Indicates whether the charge amount has been prorated for a partial term or endorsement period.']
  net_amount decimal(18,2) [note: 'Net charge amount retained by the insurer after reinsurance cession, calculated as charge amount minus ceded amount.']
  number varchar [note: 'Business identifier for the charge, unique within the premium transaction context.']
  percentage decimal(5,2) [note: 'Percentage applied to the basis amount to calculate the charge, if applicable.']
  proration_factor decimal(8,6) [note: 'Factor applied to prorate the charge for a partial term, typically a fraction of the full term.']
  rate decimal(12,6) [note: 'Rate or factor applied to calculate the charge amount, if applicable.']
  rating_element_code varchar [note: 'Code identifying the rating element or factor that generated this charge, per the rating engine.']
  rating_element_description varchar [note: 'Human-readable description of the rating element or factor that generated this charge.']
  reversal_reason_code varchar [note: 'Code indicating the reason for voiding or reversing this charge, if applicable.']
  reversal_reason_description varchar [note: 'Human-readable description of the reason for voiding or reversing this charge.']
  sequence varchar [note: 'Ordering sequence of this charge within the premium transaction for display and calculation purposes.']
  statutory_line_code varchar [note: 'NAIC statutory line of business code for regulatory reporting and Schedule P aggregation.']
  unearned_amount decimal(18,2) [note: 'Portion of the charge amount that remains unearned as of the accounting period date.']
  updated_timestamp timestamp [note: 'Date and time when this charge record was last modified in the system.']

  Note: 'Child of Premium Transaction. One row per charge component (base premium, surcharge, credit, minimum premium) within a transaction. Enables granular decomposition of gross written premium by rating element and LOB.'
}

Table premium.tax_levy {
  tax_levy_id varchar [pk, note: 'Unique identifier for the tax levy record. Primary key.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Taxes posted to accounting periods. FK enables period-based tax reporting, fiscal year tax remittance analysis, and ensures taxes align with calendar dimensions for regulatory reporting.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Tax amounts recorded in specific currencies. Multi-currency tax remittance requires proper FK for currency validation, FX conversion, and regulatory tax reporting across jurisdictions with']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Tax jurisdiction mapping requires geographic hierarchy for proper remittance, surplus lines stamping office allocation, multi-state tax apportionment, and regulatory']
  insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Surplus lines stamping offices and state tax authorities require tax levy allocation to specific insured risks on multi-risk policies.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Tax rates and remittance vary by line of business. FK enables LOB-specific tax reporting, regulatory compliance by line, and ensures taxes reference valid LOBs for statutory reporting.']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: Surplus lines tax stamping and state premium tax remittance are jurisdiction-specific and require the precise insured property address.']
  original_tax_levy_id varchar [note: 'Foreign key to the original tax levy record being adjusted or corrected, if this is an adjustment transaction. Null for original levies.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Surplus lines stamping fees and state-mandated levies are often peril-specific (flood vs. wind vs. earthquake).']
  policy_id varchar [note: 'Foreign key to the policy associated with this tax levy for direct policy-level aggregation.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this tax levy was assessed.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: State surplus lines stamping and tax remittance filings require tracing each tax levy to the specific policy transaction that triggered it (new business, endorsement, cancellation']
  state_reg_id varchar [note: 'Foreign key linking to policy.state_reg. Business justification: Surplus lines stamping fees, guaranty fund assessments, and municipal taxes are governed by the state regulatory record for the policy.']
  amount decimal(15,2) [note: 'The computed tax amount due, calculated as taxable premium amount multiplied by tax rate, in US dollars.']
  created_timestamp timestamp [note: 'Timestamp when the tax levy record was first created in the data platform.']
  naic_company_code varchar [note: 'Five-digit NAIC company code of the insurer responsible for remitting the tax, used for statutory reporting and reconciliation.']
  policy_transaction_type_code varchar [note: 'Type of policy transaction that triggered the premium and associated tax levy: new business, renewal, endorsement, cancellation, or reinstatement.']
  source_system_code varchar [note: 'Code identifying the source system that originated the tax levy record, such as billing system or policy administration system.']
  stamping_office_code varchar [note: 'Code identifying the surplus lines stamping office responsible for processing and collecting the tax, if applicable.']
  surplus_lines_flag boolean [note: 'Indicates whether this tax levy applies to a surplus lines policy, subject to surplus lines tax and stamping requirements.']
  tax_adjustment_flag boolean [note: 'Indicates whether this tax levy record represents an adjustment or correction to a previously recorded tax levy.']
  tax_authority_name varchar [note: 'Name of the regulatory or governmental authority to which the tax is remitted, such as State Department of Insurance or Surplus Lines Stamping Office.']
  tax_calculation_method_code varchar [note: 'Method used to calculate the tax levy: statutory rate, flat fee, tiered rate schedule, or minimum tax threshold.']
  tax_effective_date date [note: 'The date on which the tax levy becomes effective, typically aligned with the premium transaction effective date.']
  tax_exemption_flag boolean [note: 'Indicates whether the premium transaction qualifies for a tax exemption under statutory or regulatory provisions.']
  tax_exemption_reason_code varchar [note: 'Code indicating the reason for tax exemption: exempt entity, reinsurance, export, federal program, or other statutory exemption.']
  tax_levy_description varchar [note: 'Free-text description providing additional context or detail about the tax levy, such as special assessments or regulatory notes.']
  tax_rate decimal(10,6) [note: 'The statutory tax rate applied to the taxable premium base, expressed as a decimal (e.g., 0.025 for 2.5 percent).']
  tax_remittance_batch_code varchar [note: 'Identifier of the remittance batch or payment run in which this tax levy was included for payment to the authority.']
  tax_remittance_date date [note: 'The actual date on which the tax was remitted to the taxing authority. Null if not yet remitted.']
  tax_remittance_due_date date [note: 'The statutory due date by which the tax must be remitted to the taxing authority to avoid penalties.']
  tax_remittance_status varchar [note: 'Current remittance status of the tax levy: pending, remitted, overdue, waived, or adjusted.']
  tax_reporting_category_code varchar [note: 'Reporting category for statutory and regulatory tax filings: direct written premium, assumed reinsurance, or ceded reinsurance.']
  tax_type_code varchar [note: 'Classification of the tax levy: state premium tax, surplus lines tax, stamping fee, municipal tax, fire marshal tax, or guaranty fund assessment.']
  taxable_premium_amount decimal(15,2) [note: 'The base premium amount subject to tax, after any exemptions or adjustments, in US dollars.']
  updated_timestamp timestamp [note: 'Timestamp when the tax levy record was last modified in the data platform.']

  Note: 'Child of Premium Transaction. One row per state or surplus-lines tax, stamping fee, or regulatory assessment applied to a premium transaction. Tracks tax type, jurisdiction, rate, and computed amount for statutory remittance.'
}

Table premium.policy_fee {
  policy_fee_id varchar [pk, note: 'Unique identifier for the policy fee transaction record.']
  accounting_period_id varchar [note: 'Foreign key to the accounting period in which this fee transaction is recognized for statutory and financial reporting.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Fees posted to accounting periods. FK enables period-based fee analysis, fiscal year fee revenue reporting, and ensures fees align with calendar dimensions for financial statements.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Policy fees denominated in currency. FK enables currency validation, FX conversion for consolidated fee revenue reporting, and ensures fee amounts reference valid active currencies for']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Policy fees vary by state and jurisdiction (inspection fees, filing fees, surplus lines fees).']
  invoice_id varchar [note: 'Foreign key to the billing invoice on which this fee appears; null if not yet invoiced.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Policy fees vary by line of business (e.g., surplus lines inspection fees, admitted policy fees).']
  payment_plan_id varchar [note: 'Foreign key to the payment plan under which this fee is financed; null for full-pay policies.']
  policy_id varchar [note: 'Foreign key to the policy to which this fee applies.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this fee was charged.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Installment fees, reinstatement fees, and inspection fees are each triggered by a specific policy transaction.']
  premium_transaction_id varchar [note: 'Unique identifier of the fee transaction in the source operational system for audit and reconciliation.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Broker fee tracking and producer statement reconciliation require knowing which producer generated each policy fee.']
  billing_method varchar [note: 'Method by which the fee is billed: direct bill to insured, agency bill through producer, list bill, or account current.']
  created_timestamp timestamp [note: 'Timestamp when this policy fee record was first created in the source system.']
  fee_amount decimal(15,2) [note: 'Monetary amount of the fee charged, in the policy currency.']
  fee_basis varchar [note: 'Basis on which the fee is calculated: flat amount, per policy, per vehicle, per location, per driver, per installment, or percentage of premium. [ENUM-REF-CANDIDATE: flat|per_policy|per_vehicle|per_location|per_driver|per_installment|percentage_of_premium']
  fee_code varchar [note: 'Standardized code identifying the type of fee charged, aligned with rating engine and billing system fee schedules.']
  fee_description varchar [note: 'Human-readable description of the fee, displayed on declarations pages and billing statements.']
  fee_quantity decimal(10,2) [note: 'Quantity or count used to calculate the fee when charged on a per-unit basis; null for flat or percentage fees.']
  fee_rate decimal(10,6) [note: 'Rate applied when fee is calculated as a percentage or per-unit charge; null for flat fees.']
  fee_status varchar [note: 'Current lifecycle status of the fee transaction: pending, posted, reversed, refunded, or written off.']
  fee_type varchar [note: 'Classification of the fee by business purpose: policy fee, inspection fee, installment fee, service fee, late fee, reinstatement fee, endorsement fee, or cancellation fee.']
  gl_account_code varchar [note: 'General ledger account code to which this fee is posted for financial reporting.']
  is_commission_bearing boolean [note: 'Indicates whether producer commission is calculated on this fee; typically false for most policy fees.']
  is_refundable boolean [note: 'Indicates whether this fee is refundable upon policy cancellation or endorsement reversal.']
  is_taxable boolean [note: 'Indicates whether this fee is subject to state or local taxes; most policy fees are non-taxable.']
  last_modified_timestamp timestamp [note: 'Timestamp when this policy fee record was last updated in the source system.']
  notes varchar [note: 'Free-text notes or comments regarding this fee transaction, for audit and customer service reference.']
  reversal_date date [note: 'Date on which the fee was reversed or refunded; null if not reversed.']
  reversal_reason_code varchar [note: 'Code indicating the reason for fee reversal or refund; null if not reversed.']
  source_system_code varchar [note: 'Code identifying the operational system that originated this fee transaction.']
  statutory_line_code varchar [note: 'NAIC statutory line of business code for regulatory reporting classification.']
  transaction_booking_date date [note: 'Date on which the fee transaction was recorded in the financial ledger.']
  transaction_effective_date date [note: 'Date on which the fee transaction becomes effective for policy accounting purposes.']
  transaction_type varchar [note: 'Type of financial movement: charge for new fee, reversal for cancellation, adjustment for correction, or refund for return.']
  waived_flag boolean [note: 'Indicates whether this fee was waived as part of underwriting discretion or customer service exception.']
  waiver_authorized_by varchar [note: 'User ID or name of the underwriter or manager who authorized the fee waiver; null if not waived.']
  waiver_reason_code varchar [note: 'Code indicating the reason for fee waiver; null if not waived.']

  Note: 'Child of Premium Transaction. One row per non-premium fee (policy fee, inspection fee, installment fee) charged on a transaction. Fees are non-taxable in most jurisdictions and tracked separately from taxable premium.'
}

Table premium.commission {
  commission_id varchar [pk, note: 'Unique identifier for the commission transaction record.']
  agency_id varchar [note: 'Foreign key to the agency associated with this commission.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Commissions posted to accounting periods. FK enables period-based producer accounting, fiscal year commission expense reporting, and ensures commissions align with calendar dimensions for']
  commission_rule_id varchar [note: 'Foreign key linking to producers.commission_rule. Business justification: Commission dispute resolution and audit trail require identifying which specific commission rule produced each commission amount.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Commission audit and recalculation require tracing each commission record to the schedule that drove the rate.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission amounts in specific currencies. Multi-currency producer accounting requires proper FK for currency validation, FX conversion, and accurate producer compensation reporting across']
  disbursement_id varchar [note: 'Foreign key linking to billing.disbursement. Business justification: Commission records earned amounts; disbursement records actual payment to producer. Reconciliation of earned vs paid commission is critical for producer accounting, commission payable']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Distribution channel commission cost reporting is a standard P&C management report segmenting commission expense by channel (direct, independent agent, broker) for']
  license_id varchar [note: 'Foreign key linking to party.license. Business justification: Commission eligibility and payment often depend on active license status at transaction date.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Commission rates vary by line of business. FK enables LOB-specific producer compensation analysis, commission schedule management by line, and ensures commissions reference valid LOBs.']
  original_commission_id varchar [note: 'Foreign key to the original commission record that this transaction reverses or adjusts.']
  payee_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Commission disbursement requires identifying the payee party for 1099 tax reporting, W-9 verification, and OFAC screening — all named regulatory obligations.']
  policy_id varchar [note: 'Foreign key to the policy associated with this commission.']
  policy_producer_id varchar [note: 'Foreign key linking to policy.policy_producer. Business justification: Split-commission calculations and producer statement generation require knowing the specific policy_producer appointment record (split percentage, commission plan, of-record flag)']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this commission was earned.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Commission chargeback processing and producer statement reconciliation require knowing which specific policy transaction (cancellation, endorsement, reinstatement) triggered each']
  producer_appointment_id varchar [note: 'Foreign key linking to producers.producer_appointment. Business justification: State DOI regulatory reporting requires verifying commission was paid only under a valid, active producer appointment.']
  amount decimal(15,2) [note: 'The computed dollar amount of commission payable to the producer, calculated as basis amount multiplied by commission rate.']
  basis varchar [note: 'The premium or fee basis on which the commission is calculated: written premium, earned premium, policy fee, or installment fee.']
  basis_amount decimal(15,2) [note: 'The dollar amount of premium or fee on which the commission is calculated.']
  calculation_method varchar [note: 'The method used to calculate the commission: flat rate, tiered structure, sliding scale, or manual override.']
  chargeback_indicator boolean [note: 'Flag indicating whether this commission is a chargeback reversing a previously paid commission due to policy cancellation or return premium.']
  chargeback_reason varchar [note: 'Explanation for why the commission was charged back, typically due to policy cancellation, non-payment, or return premium.']
  commission_status varchar [note: 'Current lifecycle status of the commission: calculated, approved, pending payment, paid, reversed, or cancelled.']
  commission_type varchar [note: 'Type of commission: new business, renewal, endorsement, contingent, override, or bonus.']
  contingent_indicator boolean [note: 'Flag indicating whether this is a contingent commission based on volume, profitability, or other performance criteria.']
  created_timestamp timestamp [note: 'The timestamp when this commission record was first created in the system.']
  earned_date date [note: 'The date on which the commission was earned, typically aligned with premium earning.']
  effective_date date [note: 'The date from which the commission becomes effective and eligible for payment.']
  gl_account_code varchar [note: 'The general ledger account code to which this commission expense is posted.']
  modified_timestamp timestamp [note: 'The timestamp when this commission record was last modified.']
  net_payable_amount decimal(15,2) [note: 'The net commission amount payable to the producer after deductions, offsets, and withholdings.']
  notes varchar [note: 'Free-text notes or comments regarding this commission transaction, including manual adjustments or special circumstances.']
  override_indicator boolean [note: 'Flag indicating whether this commission is an override commission paid to a managing or supervising producer.']
  payment_date date [note: 'The date on which the commission was paid to the producer.']
  payment_method varchar [note: 'The method used to pay the commission: ACH, wire transfer, check, offset against debit balance, or direct deposit.']
  payment_status varchar [note: 'Payment status indicating whether the commission has been paid to the producer.']
  policy_transaction_type varchar [note: 'The type of policy transaction that triggered this commission: new business, renewal, endorsement, cancellation, or reinstatement.']
  rate decimal(7,5) [note: 'The percentage rate applied to the basis to calculate the commission amount, expressed as a decimal.']
  reversal_indicator boolean [note: 'Flag indicating whether this commission transaction is a reversal of a prior commission entry.']
  split_percentage decimal(5,2) [note: 'The percentage of the total commission allocated to this producer when commission is split among multiple producers.']
  tax_withholding_amount decimal(15,2) [note: 'The amount of tax withheld from the commission payment, if applicable.']
  tier_level varchar [note: 'The producer tier or level within a tiered commission structure, affecting the commission rate.']
  transaction_date date [note: 'The date on which the commission transaction was recorded.']

  Note: 'Child of Premium Transaction. One row per producer commission calculation on a transaction: type (new/renewal/contingent), rate, basis, and computed payable. Calculation-only; commission settlement/payout is owned by the producers domain.'
}

Table premium.rate_table {
  rate_table_id varchar [pk, note: 'Unique identifier for the rate table version. Primary key.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Rate tables are versioned by regulatory filing period. Actuarial rate change reporting and period-over-period rate adequacy analysis require aligning rate table versions to calendar']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Rating tables are zone-specific with different base rates, territorial factors, and catastrophe loadings by geographic hazard.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Bound coverages must reference the filed rate table used for premium calculation to support premium audits, rate justification during regulatory examinations, and actuarial analysis of']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Rate tables denominated in specific currencies. FK enables currency-specific rating, FX conversion for international rating, and ensures rates reference valid currencies for underwriting and']
  filing_organization_id varchar [note: 'Foreign key linking to party.organization. Business justification: Rate tables are filed by or on behalf of specific carrier organizations or MGAs. Linking rate_table to organization supports regulatory compliance (which entity filed this rate)']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Rating tables are geography-specific with territorial base rates, protection class adjustments, jurisdiction-specific factors, and regulatory filing requirements.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Rate tables specific to line of business. FK enables LOB-specific rating, regulatory filing management by line, and ensures rates reference valid LOBs for underwriting and pricing.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Rate tables are peril-specific (wind vs. earthquake vs. flood) with distinct actuarial bases, loss costs, regulatory filings, and coverage definitions.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Each rate table entry applies to a specific rating territory. Actuarial rate filings, state approval workflows, and territory-level loss-cost analyses require directly joining']
  type_id varchar [note: 'Foreign key linking to policy.policy_type. Business justification: Rate tables are filed, approved, and versioned per policy type (HO3, BOP, CPP, PAP). Actuarial rate adequacy reviews and state DOI filings require linking each rate table version to the']
  actuarial_memo_reference varchar [note: 'Reference number or document identifier for the actuarial memorandum supporting this rate table filing.']
  approval_date date [note: 'Date when the state regulator approved this rate table for use.']
  approval_status varchar [note: 'Current regulatory approval status of this rate table version.']
  base_rate_amount decimal(15,4) [note: 'Primary rate value or starting premium amount before application of factors and adjustments.']
  created_timestamp timestamp [note: 'System timestamp when this rate table record was first created in the data platform.']
  credibility_factor decimal(5,4) [note: 'Actuarial credibility weight applied to experience data used to develop this rate table, ranging from 0 to 1.']
  deductible_amount decimal(15,2) [note: 'Standard deductible level this rate table is designed for, if rate varies by deductible.']
  effective_date date [note: 'Date when this rate table version becomes active and available for policy rating.']
  expense_provision_percentage decimal(5,2) [note: 'Percentage load for underwriting expenses, commissions, and overhead included in the rate.']
  expiration_date date [note: 'Date when this rate table version is superseded or withdrawn from use. Null indicates currently active.']
  filing_date date [note: 'Date when this rate table was submitted to the state regulator for approval.']
  filing_number varchar [note: 'State Department of Insurance filing reference number for regulatory approval of this rate table.']
  is_file_and_use boolean [note: 'Indicates whether this rate table was implemented under file-and-use regulatory framework, requiring filing before use but not prior approval.']
  is_prior_approval boolean [note: 'Indicates whether this rate table required prior regulatory approval before implementation.']
  is_use_and_file boolean [note: 'Indicates whether this rate table was implemented under use-and-file regulatory framework, allowing immediate use before approval.']
  iso_program_code varchar [note: 'ISO program or form edition code if this rate table is based on ISO advisory rates or forms.']
  limit_amount decimal(15,2) [note: 'Standard coverage limit this rate table is designed for, if rate varies by limit.']
  loss_cost_basis decimal(15,4) [note: 'Actuarial loss cost per exposure unit underlying this rate table, before expense and profit loads.']
  maximum_premium_amount decimal(15,2) [note: 'Ceiling premium amount that cannot be exceeded for this rate table, if applicable.']
  minimum_premium_amount decimal(15,2) [note: 'Floor premium amount that must be charged regardless of calculated premium for this rate table.']
  modified_timestamp timestamp [note: 'System timestamp when this rate table record was last updated in the data platform.']
  notes varchar [note: 'Free-text field for additional comments, special instructions, or context about this rate table version.']
  profit_provision_percentage decimal(5,2) [note: 'Percentage load for underwriting profit and contingencies included in the rate.']
  published_date date [note: 'Date when this rate table version was released to the rating engine and made available for policy transactions.']
  rate_change_percentage decimal(5,2) [note: 'Overall percentage increase or decrease from the prior rate table version, used for regulatory filing disclosure.']
  rate_manual_edition varchar [note: 'Edition or publication date of the rate manual or rating guide this table is published in.']
  rate_source varchar [note: 'Origin of the rate data: proprietary company rates, ISO advisory, NCCI, state-mandated manual, or competitor benchmark.']
  rate_table_code varchar [note: 'Business identifier for the rate table, typically combining LOB, state, and version components for external reference.']
  rate_table_name varchar [note: 'Human-readable name describing the rate table purpose and scope.']
  rate_table_status varchar [note: 'Current operational status of this rate table version in the rating engine.']
  rate_type varchar [note: 'Classification of rate content: base rates, rating factors, minimum premiums, surcharges, discounts, or credits.']
  rating_algorithm_code varchar [note: 'Identifier for the calculation method or formula used to apply this rate table during policy rating.']
  state_code varchar [note: 'Two-letter US state or territory code where this rate table is filed and approved for use.']
  trend_factor decimal(5,4) [note: 'Actuarial trend adjustment factor applied to historical loss data to project future losses for this rate table.']
  version_number varchar [note: 'Sequential version identifier for this rate table edition, incremented with each filing or update.']
  withdrawn_date date [note: 'Date when this rate table version was removed from active use in the rating engine.']

  Note: 'Versioned rate table published by the rating engine for a specific LOB, state, and effective date. Stores base rates, factors, and minimum premiums. Provides the authoritative rate version used to price each Policy Term.'
}

Table billing.installment_plan {
  installment_plan_id varchar [pk, note: 'Unique identifier for the installment plan. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Installment plan is executed against a billing account. The installment_plan table tracks the elected payment schedule for a policy term, and that schedule is managed within the context of a']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Installment plans span accounting periods. FK enables period-based billing analysis, fiscal year receivables reporting, and ensures plans align with calendar dimensions for financial']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Installment plan amounts denominated in currency. FK enables multi-currency billing, FX conversion for consolidated receivables reporting, and ensures plan amounts reference valid active']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Payment plans vary by line of business. FK enables LOB-specific billing analysis, payment plan management by line, and ensures plans reference valid LOBs for receivables reporting.']
  payment_id varchar [note: 'Unique transaction identifier from the source billing system for this installment plan.']
  payment_plan_id varchar [note: 'Foreign key linking to billing.payment_plan. Business justification: Installment plan is an instance of a payment plan template. The payment_plan table defines the master template (number of installments, down payment rules, fees, etc.), and']
  policy_id varchar [note: 'Reference to the policy for which this installment plan was established.']
  policy_term_id varchar [note: 'Reference to the specific policy term covered by this installment plan.']
  policy_transaction_id varchar [note: 'Reference to the policy transaction that triggered or modified this installment plan.']
  producers_producer_id varchar [note: 'Reference to the producer or agent who sold the policy and established the installment plan.']
  amount_outstanding decimal(18,2) [note: 'Remaining unpaid balance on the installment plan, including overdue amounts.']
  amount_paid_to_date decimal(18,2) [note: 'Cumulative amount paid by the policyholder against this installment plan to date.']
  auto_pay_flag boolean [note: 'Indicates whether automatic payment is enabled for this installment plan.']
  billing_method varchar [note: 'Method by which installments are billed: direct bill, agency bill, list bill, or account current.']
  cancellation_effective_date date [note: 'Date on which the policy will be cancelled if outstanding installments are not paid.']
  cancellation_notice_date date [note: 'Date on which a notice of cancellation for non-payment was issued to the policyholder.']
  created_timestamp timestamp [note: 'Timestamp when this installment plan record was first created in the system.']
  days_delinquent varchar [note: 'Number of days the installment plan has been in delinquent status.']
  delinquency_date date [note: 'Date on which the installment plan first became delinquent.']
  down_payment_amount decimal(18,2) [note: 'Initial down payment amount required at policy binding before installment schedule begins.']
  down_payment_date date [note: 'Date on which the down payment was received or is due.']
  effective_date date [note: 'Date on which the installment plan becomes effective and binding.']
  expiration_date date [note: 'Date on which the installment plan expires or is scheduled to be completed.']
  final_installment_due_date date [note: 'Due date for the last scheduled installment payment under this plan.']
  first_installment_due_date date [note: 'Due date for the first scheduled installment payment after the down payment.']
  grace_period_days varchar [note: 'Number of days after the due date during which payment may be made without penalty or cancellation.']
  installment_fee_per_payment decimal(18,2) [note: 'Fee charged per installment payment to cover administrative costs of the payment plan.']
  installments_outstanding varchar [note: 'Count of installments that remain unpaid or partially paid.']
  installments_paid varchar [note: 'Count of installments that have been fully paid to date.']
  is_delinquent boolean [note: 'Indicates whether the installment plan is currently delinquent due to missed or late payments.']
  last_modified_timestamp timestamp [note: 'Timestamp when this installment plan record was last updated or modified.']
  late_fee_amount decimal(18,2) [note: 'Standard late fee charged per installment when payment is received after the grace period.']
  notes varchar [note: 'Free-text notes or comments regarding special arrangements, waivers, or exceptions for this installment plan.']
  number_of_installments varchar [note: 'Total count of installment payments scheduled under this plan for the policy term.']
  payment_method varchar [note: 'Primary payment method elected for installment payments: EFT, credit card, check, cash, payroll deduction, or escrow.']
  plan_status varchar [note: 'Current lifecycle status of the installment plan: active, completed, cancelled, suspended, or defaulted.']
  reinstatement_date date [note: 'Date on which a previously cancelled or suspended installment plan was reinstated.']
  reinstatement_fee_amount decimal(18,2) [note: 'Fee charged to reinstate a cancelled or suspended installment plan.']
  source_system_code varchar [note: 'Code identifying the billing or policy administration system that created this installment plan record.']
  total_fees_amount decimal(18,2) [note: 'Total installment fees charged across all scheduled payments under this plan.']
  total_plan_amount decimal(18,2) [note: 'Total amount due under the installment plan, including premium and all fees.']
  total_premium_amount decimal(18,2) [note: 'Total premium amount to be collected across all installments under this plan.']

  Note: 'Installment schedule elected for a Policy Term with per-installment lines: number, due dates, billed/paid amounts, fees, and status. Feeds delinquency and cancellation-for-non-payment.'
}

Table billing.account {
  account_id varchar [pk, note: 'Unique identifier for the billing account. Primary key.']
  billing_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Billing accounts require validated billing address distinct from policyholder address for invoice delivery, collections correspondence, and regulatory cancellation notices.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Billing account next_invoice_date and effective_date must align to fiscal/accounting periods for period-close AR aging, NAIC premium receivable reporting, and billing cycle management.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Billing accounts maintain balances in specific currencies and require currency master data for balance calculations, aging reports, and multi-currency consolidation.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Account billing geography determines tax jurisdiction codes, payment plan regulatory eligibility, escheatment rules, and state-specific billing regulations.']
  household_id varchar [note: 'Foreign key linking to party.household. Business justification: Personal lines billing accounts are consolidated at the household level for multi-policy statements, household-level payment plans, and multi-policy discount eligibility.']
  party_id varchar [note: 'Reference to the party (policyholder or payee) who owns this billing account.']
  policy_id varchar [note: 'Reference to the policy associated with this billing account.']
  producers_producer_id varchar [note: 'Reference to the producer or agent responsible for this account, used for commission allocation and servicing.']
  submission_id varchar [note: 'Foreign key linking to coverage.submission. Business justification: Billing accounts are often established during underwriting for quoted business to prepare payment collection infrastructure before binding.']
  account_status varchar [note: 'Current lifecycle status of the billing account indicating whether it is active, suspended, closed, delinquent, pending activation, or cancelled.']
  account_type varchar [note: 'Classification of billing account indicating who collects premium: direct bill (insurer bills policyholder), agency bill (producer collects), list bill, or account current.']
  auto_pay_enabled boolean [note: 'Indicates whether automatic payment processing is enabled for this account. True means payments are automatically withdrawn on due date.']
  billing_contact_name varchar [note: 'Name of the person or entity designated to receive billing communications and invoices for this account.']
  billing_email varchar [note: 'Email address for delivery of electronic invoices, payment confirmations, and billing notices.']
  billing_frequency varchar [note: 'Frequency at which invoices are generated for this account: monthly, quarterly, semi-annual, annual, or on-demand.']
  billing_method varchar [note: 'Method by which the policyholder is billed: invoice, automatic payment, payroll deduction, escrow, or mortgagee bill.']
  billing_phone varchar [note: 'Primary phone number for billing inquiries, payment reminders, and delinquency notifications.']
  cancellation_date date [note: 'Date the billing account was cancelled, either due to policy cancellation, non-payment, or policyholder request.']
  cancellation_reason varchar [note: 'Business reason for account cancellation: non-payment, policy cancellation, policyholder request, fraud, or other. [ENUM-REF-CANDIDATE: non_payment|policy_cancelled|policyholder_request|fraud|underwriting|rewrite|duplicate|other — promote to reference']
  commission_payable_flag boolean [note: 'Indicates whether producer commission is payable on premium collected through this account. False for direct accounts with no producer involvement.']
  created_timestamp timestamp [note: 'Date and time this billing account record was first created in the system.']
  credit_balance decimal(18,2) [note: 'Total credit amount available on the account from overpayments, return premiums, or cancellations. Positive value indicates credit owed to policyholder.']
  current_balance decimal(18,2) [note: 'Current outstanding balance on the account, representing total amount owed by the policyholder. Positive indicates amount due; negative indicates credit.']
  days_past_due varchar [note: 'Number of days the oldest unpaid invoice on this account is overdue. Zero indicates account is current.']
  delinquency_status varchar [note: 'Classification of account delinquency based on days past due: current, 1-30 days, 31-60 days, 61-90 days, over 90 days, or in collections.']
  effective_date date [note: 'Date the billing account became active and began accepting charges and payments.']
  expiration_date date [note: 'Date the billing account is scheduled to close or expire, typically aligned with policy expiration or account closure.']
  grace_period_days varchar [note: 'Number of days after payment due date before policy cancellation for non-payment is initiated, as required by state regulation.']
  last_payment_amount decimal(18,2) [note: 'Monetary amount of the most recent payment received on this account.']
  last_payment_date date [note: 'Date the most recent payment was received and posted to this account.']
  next_invoice_date date [note: 'Scheduled date for the next invoice to be generated for this account based on billing frequency and payment plan.']
  next_payment_due_date date [note: 'Date by which the next payment is due to avoid delinquency or late fees.']
  number varchar [note: 'Externally visible unique account number assigned to the billing account for customer reference and payment processing.']
  outstanding_fees decimal(18,2) [note: 'Total unpaid fees currently due on this account, including installment fees, late fees, and service charges.']
  outstanding_premium decimal(18,2) [note: 'Total unpaid premium amount currently due on this account, excluding fees, taxes, and other charges.']
  outstanding_taxes decimal(18,2) [note: 'Total unpaid taxes currently due on this account, including premium taxes, surplus lines taxes, and stamping fees.']
  paperless_billing_flag boolean [note: 'Indicates whether the policyholder has opted for electronic delivery of invoices and billing statements instead of paper mail.']
  payment_method varchar [note: 'Preferred payment instrument for this account: credit card, debit card, ACH (Automated Clearing House), check, wire transfer, or cash.']
  payment_plan_type varchar [note: 'Installment plan structure for premium payments: full pay, monthly, quarterly, semi-annual, or custom installment schedule.']
  unapplied_cash decimal(18,2) [note: 'Amount of cash received but not yet applied to specific invoices or charges, held in suspense pending allocation.']
  updated_timestamp timestamp [note: 'Date and time this billing account record was last modified or updated.']
  write_off_amount decimal(18,2) [note: 'Total amount written off as uncollectible on this account due to bankruptcy, insolvency, or collection failure.']
  write_off_date date [note: 'Date the uncollectible balance was written off and removed from accounts receivable.']

  Note: 'Master billing account linking a policyholder or payee to invoicing and collections. One row per billing account. Tracks account type (direct bill, agency bill), status, payment method, and balance.'
}

Table billing.invoice {
  invoice_id varchar [pk, note: 'Unique identifier for the invoice. Primary key.']
  agency_id varchar [note: 'Reference to the agency associated with this invoice for agency bill scenarios.']
  bill_to_party_id varchar [note: 'Reference to the party to whom this invoice is addressed, may differ from policyholder.']
  billing_account_id varchar [note: 'Reference to the billing account that owns this invoice.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Invoice GL posting date and billing period must align to fiscal/accounting calendar periods for NAIC statutory reporting, period-close AR reconciliation, and premium written/earned']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: Invoices bill claim-related charges: deductible collection from insureds, salvage recovery billing, subrogation reimbursement invoicing.']
  claim_payment_id varchar [note: 'Foreign key linking to claimfinancials.claim_payment. Business justification: Deductible recovery billing: when a claim payment is made, an invoice is generated to recover the insured\'s deductible.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Commission audit trail: invoice.commission_amount is computed from a commission_schedule.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Invoices are primary financial documents requiring full currency master data for multi-currency operations: exchange rates, rounding rules, display formats, and regulatory reporting.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Invoice-level geography enables jurisdiction-specific tax calculation (state premium tax, municipal fees, surplus lines tax), regulatory reporting by domicile, and multi-state']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Invoices require LOB segmentation for financial reporting, regulatory filings (Schedule P, statutory annual statements), and business analytics.']
  payment_plan_id varchar [note: 'Reference to the payment plan or installment schedule associated with this invoice.']
  policy_id varchar [note: 'Reference to the policy for which this invoice was generated.']
  policy_term_id varchar [note: 'Reference to the specific policy term covered by this invoice.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: P&C invoices are generated by policy transactions (new business, endorsement, renewal, cancellation).']
  policyholder_id varchar [note: 'Reference to the party responsible for payment of this invoice.']
  producers_producer_id varchar [note: 'Reference to the producer or agent associated with this invoice for commission purposes.']
  ri_agreement_id varchar [note: 'Foreign key linking to reinsurance.ri_agreement. Business justification: Bordereaux and ceded-premium settlement invoices are issued under a specific reinsurance agreement.']
  risk_inspection_id varchar [note: 'Foreign key linking to riskexposure.risk_inspection. Business justification: Inspection fees are billed as separate invoices tied to a specific risk inspection order.']
  amount_paid decimal(18,2) [note: 'Total amount paid against this invoice to date.']
  billing_method varchar [note: 'Method by which the invoice is billed: direct to policyholder or through agency.']
  billing_period_end_date date [note: 'End date of the coverage or billing period represented by this invoice.']
  billing_period_start_date date [note: 'Start date of the coverage or billing period represented by this invoice.']
  cancellation_notice_date date [note: 'Date on which a cancellation notice was sent due to non-payment of this invoice.']
  commission_amount decimal(18,2) [note: 'Total commission payable to the producer or agency on this invoice.']
  created_timestamp timestamp [note: 'Timestamp when this invoice record was first created in the billing system.']
  delinquency_status varchar [note: 'Current delinquency status of this invoice for collections management.']
  due_date date [note: 'Date by which payment is due for this invoice.']
  fee_amount decimal(18,2) [note: 'Total fees and surcharges included in this invoice.']
  gl_posting_date date [note: 'Date on which this invoice was posted to the general ledger for accounting purposes.']
  installment_number varchar [note: 'Sequence number of this invoice within a multi-installment payment plan.']
  invoice_date date [note: 'Date the invoice was issued to the policyholder or agency.']
  invoice_description varchar [note: 'Free-text description or memo providing additional context about this invoice.']
  invoice_status varchar [note: 'Current lifecycle status of the invoice in the billing workflow. [ENUM-REF-CANDIDATE: draft|issued|billed|paid|partially_paid|overdue|cancelled|written_off — 8 candidates stripped; promote to reference product]']
  invoice_type varchar [note: 'Type of invoice based on the underlying policy transaction or billing event. [ENUM-REF-CANDIDATE: new_business|renewal|endorsement|cancellation|reinstatement|audit|installment|commission — 8 candidates stripped; promote to reference product]']
  last_modified_timestamp timestamp [note: 'Timestamp when this invoice record was last updated in the billing system.']
  number varchar [note: 'Externally visible unique invoice number assigned by the billing system.']
  outstanding_balance decimal(18,2) [note: 'Remaining unpaid balance on this invoice.']
  paid_date date [note: 'Date on which this invoice was fully paid.']
  payment_method varchar [note: 'Preferred or expected payment method for this invoice. [ENUM-REF-CANDIDATE: check|ach|credit_card|debit_card|wire_transfer|cash|payroll_deduction — 7 candidates stripped; promote to reference product]']
  premium_amount decimal(18,2) [note: 'Total premium charges included in this invoice before taxes and fees.']
  reversal_date date [note: 'Date on which this invoice was reversed or voided.']
  reversal_flag boolean [note: 'Indicates whether this invoice has been reversed or voided.']
  reversal_reason varchar [note: 'Business reason or code explaining why this invoice was reversed.']
  tax_amount decimal(18,2) [note: 'Total tax charges included in this invoice.']
  total_amount_due decimal(18,2) [note: 'Total amount due on this invoice including premium, taxes, and fees.']
  total_installments varchar [note: 'Total number of installments in the payment plan for this policy term.']
  write_off_reason varchar [note: 'Business reason or code explaining why this invoice balance was written off.']
  written_off_date date [note: 'Date on which the outstanding balance of this invoice was written off as uncollectible.']

  Note: 'Billing document issued to a policyholder or agency for premium charges, fees, and taxes due. One row per invoice. Grain: one invoice per billing cycle per billing account. Tracks due date, amount billed, and status.'
}

Table billing.invoice_item {
  invoice_item_id varchar [pk, note: 'Unique identifier for the invoice item. Primary key.']
  accounting_period_id varchar [note: 'Reference to the accounting period this item is recognized in for financial reporting and statutory filings.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Wind pool assessments, coastal surcharges, and cat-zone-specific fees appear as invoice line items requiring cat zone attribution.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Cat assessment fees, FHCF surcharges, and cat-specific premium endorsements appear as invoice line items tied to specific cat events.']
  cession_id varchar [note: 'Foreign key linking to reinsurance.cession. Business justification: Invoice items for ceded policies must track which cession applies to calculate net premium due after reinsurance credit.']
  charge_id varchar [note: 'Reference to the premium charge record this item bills. Null for taxes, fees, or commissions.']
  claim_expense_id varchar [note: 'Foreign key linking to claimfinancials.claim_expense. Business justification: LAE expense billing reconciliation: vendor invoices for DCC/LAE expenses (legal, medical, expert) generate invoice line items referencing the specific claim_expense record']
  claim_payment_id varchar [note: 'Foreign key linking to claimfinancials.claim_payment. Business justification: Line-level deductible billing reconciliation: each invoice line for a deductible charge references the specific claim payment that generated it, enabling precise cash']
  coverage_id varchar [note: 'Reference to the coverage this item charges for. Null for policy-level fees or taxes.']
  driver_id varchar [note: 'Foreign key linking to riskexposure.driver. Business justification: Driver-specific billing line items — SR-22 filing fees, driver surcharges, and DUI-related premium loads — must reference the specific driver.']
  invoice_id varchar [note: 'Reference to the parent invoice header. Links this line item to its containing invoice.']
  payment_plan_id varchar [note: 'Reference to the payment plan this item is billed under. Null for full-pay or direct-bill policies.']
  policy_id varchar [note: 'Reference to the policy this invoice item relates to. Enables reconciliation to policy contract.']
  policy_term_id varchar [note: 'Reference to the specific policy term period this charge applies to. Supports effective dating.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Invoice line items in P&C are generated by policy transactions (premium changes, endorsements, cancellations).']
  producers_producer_id varchar [note: 'Reference to the producer or agent earning the commission. Populated only when item_type is commission.']
  property_risk_id varchar [note: 'Foreign key linking to riskexposure.property_risk. Business justification: Commercial property premium allocation requires billing line items tied to specific property risks.']
  reinsurance_recovery_id varchar [note: 'Foreign key linking to claimfinancials.reinsurance_recovery. Business justification: Line-level reinsurance recovery billing: invoice line items for ceded loss and LAE reference specific reinsurance_recovery records, enabling per-line reconciliation of']
  reversed_item_invoice_item_id varchar [note: 'Reference to the original invoice item this item reverses. Populated only when reversal_flag is true.']
  ri_claim_cession_id varchar [note: 'Foreign key linking to reinsurance.ri_claim_cession. Business justification: Invoice line items for reinsurance loss recovery billings reference the specific ri_claim_cession being billed.']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Commercial lines billing often requires risk-level premium detail for schedule-rated policies with multiple locations/buildings.']
  tax_levy_id varchar [note: 'Foreign key linking to premium.tax_levy. Business justification: Invoice items for taxes must reference the specific tax_levy record that calculated the tax amount.']
  vehicle_id varchar [note: 'Foreign key linking to riskexposure.vehicle. Business justification: Auto insurance billing allocates premium line items per vehicle (VIN-level). Vehicle-specific surcharges, endorsement fees, and per-vehicle installment schedules require this FK.']
  billing_method varchar [note: 'Method by which this item is billed: direct to policyholder, agency bill, list bill, or account current.']
  commission_rate decimal(7,5) [note: 'Commission rate applied to calculate the commission amount. Expressed as a decimal. Populated only when item_type is commission.']
  created_by_user varchar [note: 'User identifier or system process that created this invoice item record. Supports audit and compliance.']
  created_timestamp timestamp [note: 'Timestamp when this invoice item record was first created in the billing system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the item amount. Typically USD for US-domiciled insurers.']
  due_date date [note: 'Date payment for this invoice item is due from the policyholder. Inherited from invoice header but may vary by item.']
  effective_date date [note: 'Date this invoice item becomes effective. Aligns with the policy transaction or coverage effective date.']
  expiration_date date [note: 'Date this invoice item expires. Aligns with the policy term or coverage expiration date.']
  gl_account_code varchar [note: 'General ledger account code this item posts to. Enables financial statement reconciliation and statutory reporting.']
  installment_number varchar [note: 'Installment sequence number if this item is part of an installment payment plan. Null for full-pay policies.']
  item_amount decimal(15,2) [note: 'Monetary amount of this invoice line item in the invoice currency. Positive for charges, negative for credits or refunds.']
  item_category varchar [note: 'Further categorization of the item within its type. For premium: written, earned, unearned, return. For fees: installment, surcharge, penalty. [ENUM-REF-CANDIDATE: written|earned|unearned|return|installment|surcharge|penalty — 7 candidates stripped']
  item_code varchar [note: 'Internal billing code or accounting code for the item type. Used for general ledger posting and reporting.']
  item_description varchar [note: 'Human-readable description of the invoice item displayed to the policyholder. Explains what is being charged.']
  item_type varchar [note: 'Classification of the invoice line item indicating what is being billed: premium charge, tax, fee, commission, adjustment, or refund.']
  line_number varchar [note: 'Sequential line number within the invoice for ordering and display purposes.']
  outstanding_amount decimal(15,2) [note: 'Remaining unpaid balance for this invoice item. Calculated as item_amount minus paid_amount.']
  paid_amount decimal(15,2) [note: 'Amount of this invoice item that has been paid by the policyholder. Updated as payments are applied.']
  proration_factor decimal(9,6) [note: 'Decimal factor applied to calculate prorated premium for mid-term endorsements or cancellations.']
  proration_method varchar [note: 'Method used to prorate premium for mid-term changes. Daily, monthly, short-rate, pro-rata, or full-term.']
  reversal_flag boolean [note: 'Indicates whether this invoice item reverses a prior item due to cancellation, endorsement, or correction. True if reversal, false otherwise.']
  tax_jurisdiction varchar [note: 'State, county, or municipal jurisdiction imposing the tax. Populated only when item_type is tax.']
  tax_rate decimal(7,5) [note: 'Tax rate applied to calculate the tax amount. Expressed as a decimal (e.g., 0.06 for 6%). Populated only when item_type is tax.']
  taxable_base_amount decimal(15,2) [note: 'Base premium amount the tax is calculated on. Populated only when item_type is tax.']
  transaction_date date [note: 'Date the underlying premium or billing transaction occurred that generated this invoice item.']
  updated_by_user varchar [note: 'User identifier or system process that last modified this invoice item record. Supports audit and compliance.']
  updated_timestamp timestamp [note: 'Timestamp when this invoice item record was last modified. Supports audit trail and change tracking.']
  waived_flag boolean [note: 'Indicates whether this fee or charge was waived by underwriting or management approval. True if waived, false otherwise.']
  waiver_reason varchar [note: 'Business reason the fee or charge was waived. Populated only when waived_flag is true.']
  write_off_amount decimal(15,2) [note: 'Amount of this invoice item written off as uncollectible. Reduces outstanding balance without payment.']

  Note: 'Line-level detail on an invoice representing a single charge, tax, fee, or commission amount. One row per line item per invoice. Links to premium charge, coverage, and policy term for reconciliation.'
}

Table billing.payment {
  payment_id varchar [pk, note: 'Unique identifier for the payment transaction. Primary key.']
  agency_id varchar [note: 'Reference to the agency associated with this payment, if applicable.']
  billing_account_id varchar [note: 'Reference to the billing account against which this payment is applied.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Payment receipt and GL posting dates must tie to fiscal/accounting periods for cash-basis premium reporting, NAIC Schedule T, and period-close cash reconciliation.']
  commission_statement_id varchar [note: 'Foreign key linking to producers.commission_statement. Business justification: Agency-bill remittance reconciliation: agencies remit premium net of commission, and the payment corresponds to a specific commission_statement.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Payments received in multiple currencies require currency master data for foreign exchange processing, bank reconciliation, and treasury operations.']
  invoice_id varchar [note: 'Reference to the invoice this payment is applied against, if applicable.']
  payer_party_id varchar [note: 'Reference to the party (person or organization) who made the payment.']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: payment.method (STRING) is a denormalized copy of the payment instrument type that is authoritatively stored in payment_method.']
  payment_plan_id varchar [note: 'Reference to the payment plan or installment schedule this payment is part of, if applicable.']
  policy_id varchar [note: 'Reference to the policy associated with this payment.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: In P&C, premium payments must be allocated to specific policy terms for earned/unearned premium accounting, reinsurance treaty settlement, and policy year loss ratio reporting.']
  producers_producer_id varchar [note: 'Reference to the producer or agent associated with this payment, if applicable.']
  ri_premium_transaction_id varchar [note: 'Foreign key linking to reinsurance.ri_premium_transaction. Business justification: Outgoing payments to reinsurers for ceded premium remittance must reference the ri_premium_transaction being settled.']
  submission_id varchar [note: 'Foreign key linking to coverage.submission. Business justification: Down payments or good-faith deposits may be collected at submission stage before binding, particularly for commercial lines or high-value personal lines.']
  amount decimal(18,2) [note: 'Total monetary amount of the payment received.']
  applied_amount decimal(18,2) [note: 'Portion of the payment amount that has been applied to outstanding invoices or charges.']
  applied_date date [note: 'Date the payment was applied to the billing account or invoice.']
  authorization_code varchar [note: 'Authorization code provided by the payment processor for card transactions.']
  bank_account_last_four varchar [note: 'Last four digits of the bank account used for ACH or wire transfer payments.']
  bank_routing_number varchar [note: 'Nine-digit ABA routing number for ACH or wire transfer payments.']
  card_last_four varchar [note: 'Last four digits of the payment card used, for identification purposes only.']
  card_type varchar [note: 'Type of payment card used (Visa, MasterCard, American Express, Discover).']
  channel varchar [note: 'Interface or channel through which the payment was received (web, mobile, agent portal, mail, phone, in-person).']
  check_number varchar [note: 'Check number for payments made by check.']
  cleared_date date [note: 'Date the payment cleared through the financial institution and funds were confirmed.']
  created_by_user varchar [note: 'User identifier of the person or system that created the payment record.']
  created_timestamp timestamp [note: 'Date and time when the payment record was first created in the system.']
  effective_date date [note: 'Date from which the payment is considered effective for policy coverage and billing purposes.']
  installment_number varchar [note: 'Sequential number of this installment within the payment plan (e.g., 1 of 12).']
  is_returned boolean [note: 'Indicates whether the payment was returned due to insufficient funds or other reasons.']
  modified_by_user varchar [note: 'User identifier of the person or system that last modified the payment record.']
  modified_timestamp timestamp [note: 'Date and time when the payment record was last modified.']
  notes varchar [note: 'Free-text notes or comments about the payment transaction.']
  nsf_fee_amount decimal(18,2) [note: 'Fee charged to the policyholder for a returned payment due to insufficient funds.']
  number varchar [note: 'Externally visible unique business identifier for the payment transaction.']
  payment_status varchar [note: 'Current lifecycle status of the payment transaction.']
  payment_type varchar [note: 'Classification of the payment purpose (premium, down payment, installment, reinstatement, endorsement, refund).']
  processor varchar [note: 'Name of the payment gateway or processor that handled the transaction.']
  receipt_date date [note: 'Date the payment was received by the insurer.']
  receipt_timestamp timestamp [note: 'Precise date and time the payment was received and recorded in the billing system.']
  reference_number varchar [note: 'External reference number provided by the payer or payment processor (e.g., check number, confirmation number).']
  return_reason_code varchar [note: 'Code indicating the reason for payment return (e.g., NSF, account closed, stop payment).']
  return_reason_description varchar [note: 'Detailed explanation of why the payment was returned.']
  returned_date date [note: 'Date the payment was returned by the financial institution.']
  reversal_reason_code varchar [note: 'Code indicating the reason for payment reversal (e.g., NSF, stop payment, dispute).']
  reversal_reason_description varchar [note: 'Detailed explanation of why the payment was reversed.']
  reversed_date date [note: 'Date the payment was reversed, if applicable.']
  source varchar [note: 'Origin or source of the payment (policyholder, agency, third party, escrow, reinsurer).']
  unapplied_amount decimal(18,2) [note: 'Portion of the payment amount that remains unapplied and available for future allocation.']

  Note: 'Record of a payment received from a policyholder, agency, or third party against a billing account. One row per payment transaction. Captures payment method, amount, receipt date, and application status.'
}

Table billing.payment_application {
  payment_application_id varchar [pk, note: 'Unique identifier for the payment application record. Primary key.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this payment application was recognized for financial reporting.']
  billing_account_id varchar [note: 'Reference to the billing account for which this payment application or suspense holding is recorded.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Payment application GL posting date must align to fiscal/accounting periods for general ledger period-close reconciliation and unapplied cash reporting.']
  claim_payment_id varchar [note: 'Foreign key linking to claimfinancials.claim_payment. Business justification: Deductible cash application: when an insured pays their deductible, the payment application offsets a specific claim payment.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Payment applications allocate received funds to specific coverages when policies have multiple coverage parts with separate billing.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: payment_application carries denormalized currency_code. Multi-currency cash application and GL reconciliation require a proper FK to currency for FX reporting and period-close.']
  installment_schedule_id varchar [note: 'Foreign key linking to billing.installment_schedule. Business justification: A payment_application records how a payment is allocated. Linking it to the specific installment_schedule row being satisfied closes the reconciliation loop: the scheduled']
  invoice_id varchar [note: 'Reference to the invoice to which this payment is applied. Null if unapplied or suspense.']
  invoice_item_id varchar [note: 'Reference to the specific invoice line item to which this payment is applied. Null if applied at invoice level or unapplied.']
  payment_id varchar [note: 'Reference to the payment transaction being applied or held in suspense.']
  policy_id varchar [note: 'Reference to the policy associated with this payment application. Null if payment is not policy-specific.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Payment applications allocate cash to specific policy terms for earned premium recognition, unearned premium reserve management, and reinsurance accounting.']
  reversed_application_payment_application_id varchar [note: 'Reference to the original payment application record that this reversal is correcting. Null if not a reversal.']
  ri_recovery_id varchar [note: 'Foreign key linking to reinsurance.ri_recovery. Business justification: When a reinsurer remits a recovery payment, the cash application team applies it via payment_application.']
  allocation_priority varchar [note: 'Numeric priority order for applying this payment when multiple invoices or items are eligible. Lower numbers indicate higher priority.']
  allocation_rule_code varchar [note: 'Code identifying the business rule used to allocate this payment across invoices or items.']
  application_date date [note: 'Date on which the payment was applied to the invoice or moved to suspense.']
  application_method varchar [note: 'Method by which the payment was applied: automatic matching, manual user action, system rule, batch process, or override.']
  application_number varchar [note: 'Business-readable identifier for this payment application transaction.']
  application_reason_code varchar [note: 'Code indicating the reason for the application, unapplied status, or suspense holding.']
  application_reason_description varchar [note: 'Detailed explanation of why the payment was applied, held unapplied, or placed in suspense.']
  application_status varchar [note: 'Current status of the payment application in the billing lifecycle.']
  application_timestamp timestamp [note: 'Precise date and time when the payment application was recorded in the billing system.']
  application_type varchar [note: 'Type of payment application: applied to invoice, held as unapplied cash, held in suspense, reversal of prior application, or adjustment.']
  applied_amount decimal(18,2) [note: 'Monetary amount applied to the invoice or invoice item from the payment. Zero if unapplied or suspense.']
  applied_by_user_code varchar [note: 'User identifier of the billing representative who manually applied this payment. Null if automatic.']
  commission_payable_flag boolean [note: 'Indicates whether this payment application triggers a commission payable to a producer or agent.']
  created_timestamp timestamp [note: 'Date and time when this payment application record was first created in the billing system.']
  delinquency_flag boolean [note: 'Indicates whether this payment application was made to cure a delinquent account or invoice.']
  effective_date date [note: 'Date from which this payment application is effective for billing and financial reporting purposes.']
  expiration_date date [note: 'Date on which this payment application record expires or is superseded. Null if currently active.']
  external_reference_code varchar [note: 'External system identifier for this payment application, used for cross-system reconciliation.']
  gl_account_code varchar [note: 'General ledger account code to which this payment application amount was posted.']
  gl_posting_date date [note: 'Date on which this payment application was posted to the general ledger for financial reporting.']
  installment_number varchar [note: 'Sequence number of the installment within the payment plan to which this application applies. Null if not part of a plan.']
  last_modified_timestamp timestamp [note: 'Date and time when this payment application record was last updated in the billing system.']
  notes varchar [note: 'Free-text notes or comments recorded by billing staff regarding this payment application or suspense holding.']
  reversal_date date [note: 'Date on which this payment application was reversed. Null if not reversed.']
  reversal_flag boolean [note: 'Indicates whether this application record represents a reversal of a prior payment application.']
  reversal_reason varchar [note: 'Explanation of why this payment application was reversed.']
  source_system_code varchar [note: 'Code identifying the billing or payment system from which this payment application record originated.']
  suspense_amount decimal(18,2) [note: 'Monetary amount held in suspense pending resolution of account or invoice discrepancies.']
  suspense_cleared_by_user_code varchar [note: 'User identifier of the billing representative who cleared the suspense and applied the payment.']
  suspense_cleared_date date [note: 'Date on which the suspense holding was resolved and the payment was applied. Null if still in suspense.']
  suspense_reason_code varchar [note: 'Code indicating the specific reason why this payment was placed in suspense rather than applied.']
  unapplied_amount decimal(18,2) [note: 'Monetary amount held as unapplied cash pending identification of the correct invoice or account.']
  write_off_flag boolean [note: 'Indicates whether this application record represents a write-off of uncollectible amounts rather than a cash payment.']
  write_off_reason_code varchar [note: 'Code indicating the reason for writing off the amount. Null if not a write-off.']

  Note: 'Links a payment to one or more invoices or invoice items, and holds all unapplied/suspense cash pending identification of the correct account or invoice. One row per application or suspense holding.'
}

Table billing.payment_plan {
  payment_plan_id varchar [pk, note: 'Unique identifier for the payment plan. Primary key.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Payment plans vary significantly by line of business: personal auto typically offers more flexible installment options than commercial property; workers comp requires specific payment']
  type_id varchar [note: 'Foreign key linking to policy.policy_type. Business justification: Payment plan eligibility in P&C is governed by policy type (e.g., personal auto allows monthly installments; surplus lines may require full pay).']
  approval_required_flag boolean [note: 'Indicates whether underwriter or management approval is required before a policy can be bound with this plan.']
  auto_pay_eligible_flag boolean [note: 'Indicates whether this payment plan allows policyholders to enroll in automatic recurring payment processing.']
  billing_method varchar [note: 'Method by which invoices are generated and payments collected indicating whether insurer or producer handles billing.']
  cancellation_short_rate_penalty_percentage decimal(5,2) [note: 'Percentage penalty applied to unearned premium when policyholder cancels mid-term under installment plan.']
  created_timestamp timestamp [note: 'Date and time when the payment plan record was first created in the billing system.']
  display_order varchar [note: 'Numeric sequence controlling the presentation order of payment plans in user interfaces and quote proposals.']
  down_payment_minimum_amount decimal(15,2) [note: 'Minimum dollar amount required for down payment regardless of percentage calculation.']
  down_payment_percentage decimal(5,2) [note: 'Percentage of total premium required as initial down payment at policy binding expressed as decimal.']
  effective_date date [note: 'Date when the payment plan becomes available for use on new or renewing policies.']
  expiration_date date [note: 'Date when the payment plan is no longer available for new policies. Null indicates no expiration.']
  external_plan_code varchar [note: 'Third-party or legacy system payment plan identifier used for integration and data migration mapping.']
  grace_period_days varchar [note: 'Number of days after installment due date during which payment may be received without penalty or cancellation.']
  installment_fee_amount decimal(10,2) [note: 'Fixed dollar fee charged per installment payment to cover administrative and processing costs.']
  installment_fee_percentage decimal(5,2) [note: 'Percentage-based fee applied to each installment amount expressed as decimal for proportional billing.']
  installment_frequency varchar [note: 'Recurring interval at which installment payments are scheduled and invoiced to the policyholder.']
  late_payment_fee_amount decimal(10,2) [note: 'Fixed dollar penalty assessed when an installment payment is received after the grace period expires.']
  maximum_premium_amount decimal(15,2) [note: 'Maximum total policy premium allowed for this payment plan. Policies exceeding this may require different terms.']
  minimum_premium_amount decimal(15,2) [note: 'Minimum total policy premium required to qualify for this payment plan. Policies below this threshold must pay in full.']
  modified_timestamp timestamp [note: 'Date and time when the payment plan record was last updated reflecting configuration or status changes.']
  number_of_installments varchar [note: 'Total count of scheduled payment installments in the plan excluding the down payment.']
  payment_plan_description varchar [note: 'Detailed explanation of the payment plan terms, conditions, and intended use for underwriter and agent reference.']
  plan_code varchar [note: 'Business identifier code for the payment plan template used for external reference and billing system integration.']
  plan_name varchar [note: 'Descriptive name of the payment plan displayed to policyholders and agents.']
  plan_status varchar [note: 'Current lifecycle status of the payment plan indicating availability for new policies.']
  plan_type varchar [note: 'Classification of the payment plan structure indicating how premium is collected.']
  producer_commission_impact_flag boolean [note: 'Indicates whether installment fees affect producer commission calculation or are retained entirely by the insurer.']
  regulatory_filing_reference varchar [note: 'State Department of Insurance filing number or reference for approved payment plan terms and fee schedules.']
  reinstatement_fee_amount decimal(10,2) [note: 'Fixed dollar fee charged to reinstate a policy that was cancelled for non-payment under this plan.']
  returned_payment_fee_amount decimal(10,2) [note: 'Fixed dollar fee assessed when a payment is returned due to insufficient funds or account closure.']

  Note: 'Installment plan template defining the number of installments, down payment percentage, installment frequency, and applicable fees for a billing account or policy. Master record for plan configuration.'
}

Table billing.installment_schedule {
  installment_schedule_id varchar [pk, note: 'Unique identifier for the installment schedule record. Primary key.']
  billing_account_id varchar [note: 'Reference to the billing account under which this installment is scheduled.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Installment scheduled_due_date and billing periods must align to fiscal/accounting calendar for delinquency aging reports, NAIC premium receivable reporting, and period-close installment']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: installment_schedule carries denormalized currency_code. Multi-currency installment billing requires a proper FK to currency for FX translation and regulatory reporting.']
  installment_plan_id varchar [note: 'Foreign key linking to billing.installment_plan. Business justification: installment_schedule rows are the individual installment lines generated under an elected installment_plan instance.']
  invoice_id varchar [note: 'Reference to the invoice that includes this installment charge.']
  payment_id varchar [note: 'Foreign key linking to billing.payment. Business justification: installment_schedule already tracks payment_received_date and paid_amount, indicating a payment was received against the scheduled installment.']
  payment_plan_id varchar [note: 'Reference to the payment plan that generated this installment schedule.']
  policy_term_id varchar [note: 'Reference to the policy term for which this installment applies.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Installment schedules are created or restructured by policy transactions (endorsements changing premium, renewals, reinstatements).']
  auto_pay_flag boolean [note: 'Indicates whether this installment is enrolled in automatic payment processing.']
  billing_period_end_date date [note: 'End date of the billing period covered by this installment.']
  billing_period_start_date date [note: 'Start date of the billing period covered by this installment.']
  cancellation_date date [note: 'Date on which this installment was cancelled. Null if not cancelled.']
  cancellation_reason varchar [note: 'Business reason for cancelling this installment. Null if not cancelled.']
  created_timestamp timestamp [note: 'Timestamp when this installment schedule record was first created in the system.']
  delinquency_days varchar [note: 'Number of days this installment is past due. Zero if paid on time or not yet due.']
  down_payment_flag boolean [note: 'Indicates whether this installment represents the initial down payment for the policy term.']
  fee_allocation_amount decimal(18,2) [note: 'Portion of the installment amount allocated to fees such as policy fees or installment fees.']
  final_installment_flag boolean [note: 'Indicates whether this is the final installment in the payment plan.']
  grace_period_end_date date [note: 'Date after which the installment is considered past due if unpaid. Typically scheduled due date plus grace period days.']
  installment_fee_amount decimal(18,2) [note: 'Fee charged for paying in installments rather than in full. Zero if no installment fee applies.']
  installment_number varchar [note: 'Sequential number of this installment within the payment plan. First installment is 1.']
  installment_status varchar [note: 'Current status of the installment in its lifecycle.']
  late_fee_amount decimal(18,2) [note: 'Late fee assessed if payment is received after grace period. Zero if paid on time or waived.']
  modified_by_user varchar [note: 'User ID or name of the person or system that last modified this installment record.']
  modified_timestamp timestamp [note: 'Timestamp when this installment schedule record was last modified.']
  notice_sent_date date [note: 'Date on which a payment reminder or delinquency notice was sent for this installment. Null if no notice sent.']
  notice_type varchar [note: 'Type of notice sent to the policyholder regarding this installment. Null if no notice sent.']
  outstanding_amount decimal(18,2) [note: 'The remaining unpaid balance on this installment. Calculated as scheduled amount minus paid amount.']
  paid_amount decimal(18,2) [note: 'The actual amount paid against this installment. May differ from scheduled amount due to partial payments or adjustments.']
  payment_channel varchar [note: 'Channel through which the payment was or is expected to be received. [ENUM-REF-CANDIDATE: web|mobile_app|phone|mail|agent|branch|auto_pay — 7 candidates stripped; promote to reference product]']
  payment_method varchar [note: 'Payment instrument used or expected for this installment. [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|check|cash|wire_transfer|payroll_deduction|escrow — 8 candidates stripped; promote to reference product]']
  payment_received_date date [note: 'Date on which payment was actually received for this installment. Null if unpaid.']
  premium_allocation_amount decimal(18,2) [note: 'Portion of the installment amount allocated to premium charges.']
  returned_payment_date date [note: 'Date on which a payment for this installment was returned. Null if no return occurred.']
  returned_payment_flag boolean [note: 'Indicates whether a payment for this installment was returned or reversed due to insufficient funds or other reason.']
  returned_payment_reason varchar [note: 'Reason code or description for why the payment was returned. Null if no return occurred.']
  scheduled_amount decimal(18,2) [note: 'The amount scheduled to be paid for this installment as originally calculated.']
  scheduled_due_date date [note: 'Date on which the installment payment is scheduled to be due.']
  tax_allocation_amount decimal(18,2) [note: 'Portion of the installment amount allocated to taxes and surcharges.']
  waived_amount decimal(18,2) [note: 'Portion of the installment amount that has been waived or forgiven. Zero if no waiver applied.']
  waiver_reason varchar [note: 'Business reason for waiving all or part of the installment. Null if no waiver applied.']

  Note: 'Scheduled installment records generated for a billing account under a payment plan. One row per installment. Tracks scheduled due date, scheduled amount, actual paid amount, and installment status (due, paid, past due).'
}

Table billing.delinquency {
  delinquency_id varchar [pk, note: 'Unique identifier for the delinquency event. Primary key.']
  billing_account_id varchar [note: 'Billing account that entered delinquency status.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Delinquency start_date and grace_period_end_date must align to fiscal periods for collections aging reports, state regulatory cancellation notice compliance, and period-close delinquency']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Catastrophe-triggered delinquencies require event linkage for regulatory forbearance programs, loss mitigation tracking, and state-mandated grace period extensions.']
  claim_payment_id varchar [note: 'Foreign key linking to claimfinancials.claim_payment. Business justification: Deductible delinquency tracking: delinquency on deductible obligations originates from a specific claim payment.']
  contact_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Collections outreach requires identifying the responsible party (named insured, guarantor) directly on the delinquency record.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: delinquency carries denormalized currency_code. Multi-currency P&C operations require a proper FK to currency for past_due_amount and write_off_amount FX reporting and regulatory filings.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: State regulators require delinquency statistics reported by geography for market conduct exams.']
  installment_schedule_id varchar [note: 'Foreign key linking to billing.installment_schedule. Business justification: A delinquency lifecycle is triggered by a missed installment. Linking delinquency to the specific installment_schedule row that was missed provides precise traceability: which']
  payment_plan_id varchar [note: 'Payment plan that was in effect when the delinquency occurred, if applicable.']
  policy_id varchar [note: 'Policy associated with the delinquent billing account.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Delinquency tracking in P&C is term-specific: state-mandated cancellation notice periods, reinstatement deadlines, and earned premium calculations are all term-level events.']
  assigned_collector_user_code varchar [note: 'User ID of the collections specialist assigned to work this delinquency case.']
  cancellation_effective_date date [note: 'Date the policy will be or was cancelled due to non-payment if the delinquency is not cured.']
  cancellation_notice_date date [note: 'Date the notice of intent to cancel for non-payment was sent to the policyholder, per statutory requirements.']
  cancellation_reason_code varchar [note: 'Code indicating the specific cancellation reason, typically non-payment or payment plan default.']
  collections_agency_flag boolean [note: 'Indicates whether the delinquent account was referred to an external collections agency.']
  collections_agency_name varchar [note: 'Name of the external collections agency to which the account was referred.']
  collections_referral_date date [note: 'Date the delinquent account was referred to the collections agency.']
  created_timestamp timestamp [note: 'Timestamp when this delinquency record was first created in the system.']
  days_past_due varchar [note: 'Number of calendar days the account has been delinquent since the first missed installment due date.']
  delinquency_status varchar [note: 'Current lifecycle state of the delinquency event in the collections workflow. [ENUM-REF-CANDIDATE: open|past_due|notice_sent|pending_cancellation|cancelled|reinstated|closed|written_off — 8 candidates stripped; promote to reference product]']
  external_reference_code varchar [note: 'External identifier used by collections agencies or third-party systems to reference this delinquency.']
  first_missed_installment_date date [note: 'Due date of the first installment that was not paid, initiating the delinquency.']
  first_notice_date date [note: 'Date the first delinquency notice was sent to the policyholder.']
  grace_period_days varchar [note: 'Number of days allowed after the due date before the account is marked delinquent, per policy terms and state law.']
  grace_period_end_date date [note: 'Date the grace period expired, after which the account was marked delinquent.']
  last_modified_timestamp timestamp [note: 'Timestamp when this delinquency record was last updated.']
  last_notice_date date [note: 'Date the most recent delinquency or cancellation notice was sent.']
  late_fee_amount decimal(15,2) [note: 'Late payment fees assessed during the delinquency period, per state regulations and policy terms.']
  notes varchar [note: 'Free-text notes documenting collections actions, policyholder communications, and resolution details.']
  notice_sent_count varchar [note: 'Total number of delinquency notices sent to the policyholder during this delinquency event.']
  number varchar [note: 'Business identifier for the delinquency event, used in collections correspondence and workflow tracking.']
  past_due_amount decimal(15,2) [note: 'Portion of the total amount due that is overdue and subject to collections action.']
  payment_plan_default_flag boolean [note: 'Indicates whether the delinquency was caused by a payment plan default.']
  penalty_amount decimal(15,2) [note: 'Additional penalties or interest charges applied to the delinquent balance.']
  reason_code varchar [note: 'Code indicating the root cause of delinquency, such as missed payment, returned check, or payment plan default.']
  reason_description varchar [note: 'Detailed explanation of why the account became delinquent.']
  reinstatement_amount decimal(15,2) [note: 'Total amount paid to reinstate the policy, including past-due premium, fees, and penalties.']
  reinstatement_date date [note: 'Date the policy was reinstated after the delinquency was cured and all past-due amounts were paid.']
  resolution_method varchar [note: 'Method by which the delinquency was resolved.']
  resolved_date date [note: 'Date the delinquency was fully resolved through payment, reinstatement, cancellation, or write-off.']
  returned_payment_flag boolean [note: 'Indicates whether the delinquency was triggered by a returned or dishonored payment.']
  returned_payment_reason varchar [note: 'Reason the payment was returned, such as insufficient funds, closed account, or stop payment.']
  source_system_code varchar [note: 'Code identifying the billing system that originated this delinquency record.']
  start_date date [note: 'Date the billing account first became delinquent, typically the day after the grace period expired.']
  start_timestamp timestamp [note: 'Precise timestamp when the delinquency event was triggered in the billing system.']
  total_amount_due decimal(15,2) [note: 'Total outstanding balance owed on the billing account at the time of delinquency, including premium, fees, and penalties.']
  write_off_amount decimal(15,2) [note: 'Amount of the delinquent balance that was written off as bad debt.']
  write_off_date date [note: 'Date the delinquent balance was written off as uncollectible, per accounting policy.']
  write_off_reason_code varchar [note: 'Code indicating the reason for write-off, such as bankruptcy, deceased, or uncollectible.']

  Note: 'Delinquency lifecycle for a billing account that missed installments, including all workflow actions (past-due, cancellation, reinstatement, write-off trigger) and notices issued during collections. One row per delinquency event per account.'
}

Table billing.delinquency_action {
  delinquency_action_id varchar [pk, note: 'Unique identifier for each delinquency action record. Primary key.']
  billing_account_id varchar [note: 'Foreign key to the billing account associated with this delinquency action.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Delinquency actions (cancellation notices, reinstatement deadlines) must align to fiscal/accounting periods for state regulatory compliance tracking, period-close cancellation reporting, and']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Post-catastrophe grace period extensions and collection forbearance actions are tied to declared catastrophe events.']
  delinquency_id varchar [note: 'Foreign key to the parent delinquency process that this action belongs to.']
  invoice_id varchar [note: 'Foreign key linking to billing.billing_notice. Business justification: Delinquency actions often generate billing notices (cancellation notice, reinstatement offer, final demand).']
  policy_id varchar [note: 'Foreign key to the policy affected by this delinquency action.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Cancellation and reinstatement actions are term-specific operations in P&C. State DOI compliance requires linking each delinquency action (cancellation notice, reinstatement offer) to the exact']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Delinquency actions (cancellation execution, reinstatement) directly generate or correspond to policy transactions.']
  reversed_action_delinquency_action_id varchar [note: 'Foreign key to the original delinquency action that this action reverses, if applicable.']
  uw_decision_id varchar [note: 'Foreign key linking to coverage.uw_decision. Business justification: Cancellation for non-payment may trigger reinstatement underwriting review or conditional reinstatement decisions.']
  action_date date [note: 'Business date when the delinquency action was initiated or executed.']
  action_outcome_code varchar [note: 'Result or outcome of the delinquency action after execution.']
  action_reason_code varchar [note: 'Coded reason or trigger that caused this delinquency action to be initiated.']
  action_reason_description varchar [note: 'Detailed narrative explanation of why this delinquency action was taken.']
  action_sequence_number varchar [note: 'Sequential order of this action within the parent delinquency process.']
  action_status varchar [note: 'Current status of the delinquency action in its workflow lifecycle.']
  action_timestamp timestamp [note: 'Precise timestamp when the delinquency action was initiated or executed.']
  action_type_code varchar [note: 'Type of delinquency action taken: notice issued, reminder sent, cancellation initiated, reinstatement offered, write-off triggered, or referral to collections.']
  approval_date date [note: 'Date when this delinquency action was approved or authorized for execution.']
  approved_by_user_code varchar [note: 'Identifier of the system user who approved or authorized this delinquency action, if approval required.']
  cancellation_effective_date date [note: 'Date when the policy cancellation becomes effective if this action is a cancellation.']
  cancellation_type_code varchar [note: 'Type of cancellation initiated if action type is cancellation, such as non-payment cancellation or flat cancellation.']
  collections_agency_code varchar [note: 'Identifier of the external collections agency to which the account was referred, if applicable.']
  collections_referral_date date [note: 'Date when the delinquent account was referred to external collections agency.']
  collections_referral_flag boolean [note: 'Indicates whether the delinquent account was referred to external collections agency as part of this action.']
  completed_date date [note: 'Date when the delinquency action was fully completed or finalized.']
  effective_date date [note: 'Date when the delinquency action becomes effective for policy or billing purposes.']
  external_reference_code varchar [note: 'External system identifier or reference number for this delinquency action, used for cross-system reconciliation.']
  grace_period_days varchar [note: 'Number of days allowed for policyholder response or payment before next action is triggered.']
  grace_period_end_date date [note: 'Date when the grace period expires and next delinquency action may be triggered.']
  initiated_by_user_code varchar [note: 'Identifier of the system user or automated process that initiated this delinquency action.']
  notes varchar [note: 'Free-form text notes or comments about this delinquency action for internal reference.']
  regulatory_compliance_flag boolean [note: 'Indicates whether this delinquency action complies with all applicable state and federal regulatory requirements.']
  reinstatement_deadline_date date [note: 'Last date by which the policyholder can accept the reinstatement offer and restore coverage.']
  reinstatement_offered_flag boolean [note: 'Indicates whether a reinstatement offer was extended to the policyholder as part of this action.']
  reversal_date date [note: 'Date when this delinquency action was reversed or undone.']
  reversal_flag boolean [note: 'Indicates whether this delinquency action was subsequently reversed or undone.']
  reversal_reason_code varchar [note: 'Coded reason why this delinquency action was reversed, such as payment received or error correction.']
  scheduled_date date [note: 'Planned date for the delinquency action to be executed, if scheduled in advance.']
  source_system_code varchar [note: 'Code identifying the operational system that originated this delinquency action record, such as billing system or collections module.']
  state_code varchar [note: 'Two-letter state code where the delinquency action is governed, determining applicable regulatory rules.']
  write_off_amount decimal(15,2) [note: 'Dollar amount written off if this action is a write-off, representing uncollectible balance.']
  write_off_reason_code varchar [note: 'Coded reason for the write-off if this action is a write-off, such as bankruptcy or uncollectible.']

  Note: 'Individual workflow action taken within a delinquency process (notice issued, cancellation initiated, reinstatement offered, write-off triggered). One row per action per delinquency. Tracks action type, action date, and outcome.'
}

Table billing.disbursement {
  disbursement_id varchar [pk, note: 'Unique identifier for the disbursement transaction. Primary key.']
  accounting_period_id varchar [note: 'Accounting period in which the disbursement is recognized for financial and statutory reporting.']
  billing_account_id varchar [note: 'Billing account from which the disbursement originates or to which it relates.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Disbursement GL posting date must align to fiscal/accounting periods for claims payment reporting, NAIC Schedule P loss payment triangles, and period-close cash disbursement reconciliation.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Claim disbursements must be attributed to catastrophe events for cat loss payment aggregation, reinsurance recovery calculations, and regulatory cat loss reporting.']
  claim_exposure_id varchar [note: 'Foreign key linking to claims.claim_exposure. Business justification: Claim disbursements (payments, settlements) are issued at the per-coverage-line (claim_exposure) level.']
  claim_id varchar [note: 'Claim associated with the disbursement, if payment relates to claim settlement or recovery.']
  claim_payment_id varchar [note: 'Foreign key linking to claimfinancials.claim_payment. Business justification: Disbursements execute claim payments via check/EFT. Linking disbursement to the specific claim_payment record enables reconciliation of authorized claim payments vs actual cash']
  claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: Settlement and indemnity disbursements are issued to specific claimants. This FK supports claimant-level payment tracking, 1099 tax reporting, settlement agreement reconciliation, and']
  commission_statement_id varchar [note: 'Foreign key linking to producers.commission_statement. Business justification: Agency commission statement settlement: a single disbursement pays an entire commission statement (bulk remittance).']
  commission_transaction_id varchar [note: 'Foreign key linking to producers.commission_transaction. Business justification: Commission settlement process: a disbursement check to a producer settles a specific commission_transaction.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Disbursements carry denormalized currency_code. Multi-currency P&C operations (e.g., Canadian or Lloyd\'s business) require a proper FK to currency for FX translation, regulatory reporting']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: State regulatory reporting requires cat loss disbursements aggregated by geography.']
  litigation_id varchar [note: 'Foreign key linking to claims.litigation. Business justification: Defense cost and settlement disbursements must be tracked against specific litigation records for legal expense management, outside counsel billing reconciliation, and litigation reserve']
  payee_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Commission and claim disbursement checks require USPS-validated payee address for delivery. Denormalized address fields should reference party.address master to leverage geocoding, DPV']
  payee_agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Agency commission disbursement: checks are cut to agencies (not individual producers) for agency-bill commission settlements.']
  payee_party_id varchar [note: 'Party receiving the disbursement payment, linking to the party master.']
  policy_id varchar [note: 'Policy associated with the disbursement transaction.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Return premium disbursements and producer commission disbursements are reconciled at the policy term level for earned premium accounting, reinsurance settlement, and statutory financial']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Return premium disbursements are triggered by specific policy transactions (cancellation, mid-term endorsement).']
  producers_producer_id varchar [note: 'Producer associated with commission disbursement, if applicable.']
  reversed_disbursement_id varchar [note: 'Identifier of the original disbursement being reversed, if this is a reversal transaction.']
  ri_premium_transaction_id varchar [note: 'Foreign key linking to reinsurance.ri_premium_transaction. Business justification: Disbursements remitting ceded premium or ceding commission to reinsurers reference the underlying ri_premium_transaction.']
  ri_recovery_id varchar [note: 'Foreign key linking to reinsurance.ri_recovery. Business justification: Reinsurance recovery receipts are posted as cash receipts in billing. Linking disbursement to ri_recovery enables the reinsurance cash reconciliation process, allowing finance to']
  salvage_id varchar [note: 'Foreign key linking to claimfinancials.salvage. Business justification: Salvage proceeds disbursement: auction or sale proceeds for salvaged property are disbursed through billing.']
  subrogation_id varchar [note: 'Foreign key linking to claimfinancials.subrogation. Business justification: Subrogation proceeds disbursement: collected subrogation amounts are disbursed to the insured (made-whole reimbursement) or retained.']
  approval_date date [note: 'Date the disbursement was approved for payment by authorized personnel.']
  approved_by_user_code varchar [note: 'User identifier of the person who approved the disbursement for payment.']
  check_number varchar [note: 'Physical check number if the disbursement was issued via check.']
  cleared_date date [note: 'Date the disbursement cleared the bank or payment processor.']
  commission_basis_amount decimal(18,2) [note: 'Base premium or transaction amount on which the commission was calculated.']
  commission_rate decimal(5,4) [note: 'Commission rate applied to calculate the disbursement amount, if applicable to producer commission.']
  created_timestamp timestamp [note: 'Date and time when the disbursement record was first created in the system.']
  disbursement_date date [note: 'Date the disbursement was issued or scheduled for payment.']
  disbursement_status varchar [note: 'Current lifecycle status of the disbursement transaction.']
  disbursement_type varchar [note: 'Classification of the disbursement purpose: commission payable, premium refund, return premium, claim payment, or recovery. [ENUM-REF-CANDIDATE']
  external_reference_code varchar [note: 'External system reference identifier for cross-system reconciliation and tracking.']
  gl_account_code varchar [note: 'General ledger account code to which the disbursement is posted for financial reporting.']
  gl_posting_date date [note: 'Date the disbursement transaction was posted to the general ledger.']
  gross_amount decimal(18,2) [note: 'Total gross amount of the disbursement before any withholdings or adjustments.']
  issued_by_user_code varchar [note: 'User identifier of the person who issued or processed the disbursement.']
  modified_timestamp timestamp [note: 'Date and time when the disbursement record was last modified or updated.']
  net_amount decimal(18,2) [note: 'Net amount disbursed to the payee after all withholdings and adjustments.']
  notes varchar [note: 'Free-text notes or comments related to the disbursement transaction.']
  number varchar [note: 'Business-facing unique identifier or check number for the disbursement.']
  payee_name varchar [note: 'Full legal name of the payee receiving the disbursement.']
  payee_tax_number varchar [note: 'Tax identification number (TIN, EIN, or SSN) of the payee for IRS reporting and withholding.']
  payment_method varchar [note: 'Method or instrument used for the disbursement: check, ACH, wire transfer, EFT, card, or cash.']
  payment_reference_number varchar [note: 'External reference number from the payment processor or bank for tracking and reconciliation.']
  reversal_flag boolean [note: 'Indicates whether this disbursement is a reversal of a prior disbursement transaction.']
  reversal_reason_code varchar [note: 'Code indicating the reason for reversing the disbursement, if applicable. [ENUM-REF-CANDIDATE: stop_payment|incorrect_amount|duplicate|payee_error|policy_cancelled|claim_denied|other — promote to reference product]']
  reversal_reason_description varchar [note: 'Detailed explanation of why the disbursement was reversed.']
  source_system_code varchar [note: 'Code identifying the originating system that created the disbursement record.']
  timestamp timestamp [note: 'Precise date and time the disbursement transaction was created or issued.']
  void_date date [note: 'Date the disbursement was voided or cancelled, if applicable.']
  withheld_amount decimal(18,2) [note: 'Amount withheld from the disbursement for tax, offset, or other deductions.']

  Note: 'Outbound payment to a producer, claimant, or payee, including producer commission payable pending settlement. One row per disbursement. Captures payee party, producer, policy, disbursement type (commission, refund, return premium), earned/withheld amount'
}

Table billing.payment_method {
  payment_method_id varchar [pk, note: 'Unique identifier for the payment method record. Primary key.']
  billing_account_id varchar [note: 'Reference to the billing account that owns this payment method.']
  billing_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Payment processors require validated billing address for AVS (Address Verification System) fraud checks on card transactions and ACH verification.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: payment_method carries denormalized currency_code. Payment methods are currency-specific (USD ACH vs.']
  party_id varchar [note: 'Reference to the party (person or organization) who owns this payment instrument.']
  autopay_enrollment_date date [note: 'Date when the payment method was enrolled in automatic payment processing.']
  bank_account_last_four varchar [note: 'Last four digits of the bank account number for identification purposes. Masked for security and compliance.']
  bank_account_type varchar [note: 'Type of bank account: checking, savings, business checking, or business savings.']
  bank_name varchar [note: 'Name of the financial institution for Automated Clearing House (ACH) or Electronic Funds Transfer (EFT) payment methods.']
  bank_routing_number varchar [note: 'Nine-digit American Bankers Association (ABA) routing transit number for ACH or EFT transactions.']
  card_expiry_month varchar [note: 'Expiration month of the credit or debit card (1-12). Populated only for card-based methods.']
  card_expiry_year varchar [note: 'Expiration year of the credit or debit card (four-digit year). Populated only for card-based methods.']
  card_last_four varchar [note: 'Last four digits of the credit or debit card number for identification purposes. Masked for Payment Card Industry (PCI) compliance.']
  card_type varchar [note: 'Brand of credit or debit card (Visa, MasterCard, American Express, Discover, Diners Club, JCB). Populated only for card-based methods.']
  cardholder_name varchar [note: 'Name of the cardholder as it appears on the credit or debit card.']
  created_by_user_code varchar [note: 'Identifier of the user or system process that created the payment method record.']
  created_timestamp timestamp [note: 'Date and time when the payment method record was first created in the system.']
  effective_date date [note: 'Date when the payment method becomes active and available for use.']
  eft_authorization_date date [note: 'Date when the Electronic Funds Transfer authorization was granted by the account holder.']
  eft_authorization_reference varchar [note: 'Reference number or identifier for the EFT authorization agreement or signed form.']
  eft_authorization_status varchar [note: 'Status of the Electronic Funds Transfer authorization indicating whether the account holder has granted permission for automatic debits.']
  expiration_date date [note: 'Date when the payment method expires or is no longer valid for use. Nullable for methods without expiration.']
  external_reference_code varchar [note: 'External identifier or reference number from a third-party system, payment processor, or legacy system for cross-system reconciliation.']
  is_autopay_enabled boolean [note: 'Indicates whether this payment method is enrolled in automatic payment processing for recurring invoices.']
  is_default boolean [note: 'Indicates whether this is the default payment method for the billing account.']
  last_verification_date date [note: 'Date when the payment method was last verified or validated by the payment processor or financial institution.']
  method_name varchar [note: 'User-friendly display name or nickname for the payment method (e.g., Personal Visa, Business Checking).']
  method_status varchar [note: 'Current lifecycle status of the payment method indicating whether it is available for use.']
  method_type varchar [note: 'Type of payment instrument: credit card, debit card, Automated Clearing House (ACH), Electronic Funds Transfer (EFT), check, escrow, or wire transfer. [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|eft|check|escrow|wire_transfer — 7 candidates stripped']
  notes varchar [note: 'Free-form text field for additional comments, instructions, or special handling requirements related to the payment method.']
  payment_token varchar [note: 'Tokenized representation of the payment instrument provided by the payment processor for secure storage and recurring transactions.']
  priority_rank varchar [note: 'Numeric ranking indicating the order of preference for this payment method when multiple methods are available (1 = highest priority).']
  processor_merchant_code varchar [note: 'Merchant identifier assigned by the payment processor for transaction routing and reconciliation.']
  processor_name varchar [note: 'Name of the third-party payment processor or gateway handling transactions for this payment method (e.g., Stripe, PayPal, Authorize.Net).']
  source_system_code varchar [note: 'Code identifying the originating system or module where the payment method was captured (e.g., BillingCenter, PolicyCenter, Customer Portal).']
  updated_by_user_code varchar [note: 'Identifier of the user or system process that last modified the payment method record.']
  updated_timestamp timestamp [note: 'Date and time when the payment method record was last modified.']
  usage_limit_amount decimal(15,2) [note: 'Maximum transaction amount allowed for a single payment using this method. Nullable if no limit is imposed.']
  verification_status varchar [note: 'Status of the payment method verification process indicating whether the instrument has been validated.']

  Note: 'Stored payment instrument on file for a billing account (credit card, ACH/EFT, check, escrow). One row per payment method per billing account. Captures instrument type, masked account details, expiry, and EFT authorization status.'
}

Table billing.account_policy {
  account_policy_id varchar [pk, note: 'Unique identifier for the billing account to policy association. One row per billing-account-to-policy relationship.']
  agency_id varchar [note: 'Reference to the agency responsible for this policy within the billing account context.']
  bill_to_party_id varchar [note: 'Reference to the party who receives invoices for this policy. May differ from policyholder in agency bill scenarios.']
  billing_account_id varchar [note: 'Reference to the billing account that owns this policy relationship.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Cat event moratoriums prohibit policy cancellation for affected policyholders.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Account-policy commission governance: the commission_schedule applicable to a policy on a billing account drives commission calculation for all transactions on that']
  payment_plan_id varchar [note: 'Reference to the payment plan governing this policy on the billing account.']
  policy_id varchar [note: 'Reference to the policy associated with this billing account.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Billing account-to-policy relationships in P&C are term-specific: a policy may move to a different billing account at renewal or mid-term endorsement.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Policies are added to or removed from billing accounts as a result of specific policy transactions (new business binding, cancellation, transfer).']
  policyholder_id varchar [note: 'Reference to the policyholder party for this policy. Captured for reporting and reconciliation purposes.']
  producers_producer_id varchar [note: 'Reference to the producer responsible for this policy within the billing account context.']
  added_by_user_code varchar [note: 'Identifier of the user who added this policy to the billing account.']
  allocation_method varchar [note: 'Method used to allocate payments across policies on this billing account.']
  allocation_percentage decimal(5,2) [note: 'Percentage of account-level payments to allocate to this policy. Used for proportional allocation rules.']
  allocation_priority varchar [note: 'Priority order for allocating payments when multiple policies exist on the same billing account. Lower numbers indicate higher priority.']
  billing_method varchar [note: 'Method by which this policy is billed within the account. Supports agency bill and direct bill splits.']
  cancellation_notice_date date [note: 'Date when a cancellation notice was issued for this policy due to non-payment on the billing account.']
  cancellation_pending_flag boolean [note: 'Indicates whether this policy is pending cancellation due to billing account delinquency.']
  commission_payable_flag boolean [note: 'Indicates whether producer commission is payable for this policy on this billing account. Supports agency bill scenarios where commission handling differs.']
  consolidation_flag boolean [note: 'Indicates whether this policy is part of a multi-policy consolidated billing arrangement.']
  created_timestamp timestamp [note: 'Timestamp when this account-policy relationship record was first created in the system.']
  delinquency_flag boolean [note: 'Indicates whether this policy is currently delinquent on the billing account.']
  effective_date date [note: 'Date when this policy was added to the billing account.']
  expiration_date date [note: 'Date when this policy was removed from the billing account. Null for active relationships.']
  external_reference_code varchar [note: 'External system reference identifier for this account-policy relationship. Used for integration and reconciliation.']
  installment_billing_flag boolean [note: 'Indicates whether this policy is billed on an installment basis within the billing account.']
  notes varchar [note: 'Free-form notes regarding this account-policy relationship. Used for special billing instructions or exceptions.']
  relationship_status varchar [note: 'Current lifecycle status of the account-to-policy association.']
  relationship_type varchar [note: 'Type of relationship between the billing account and policy. Supports multi-policy consolidation and split billing scenarios.']
  removed_by_user_code varchar [note: 'Identifier of the user who removed this policy from the billing account.']
  source_system_code varchar [note: 'Code identifying the source billing system that created this account-policy relationship.']
  split_billing_flag boolean [note: 'Indicates whether this policy uses split billing between direct bill and agency bill methods.']
  termination_date date [note: 'Date when the account-policy relationship was terminated due to cancellation, non-renewal, or account closure.']
  termination_reason_code varchar [note: 'Code indicating why the account-policy relationship was terminated.']
  termination_reason_description varchar [note: 'Detailed explanation of why the account-policy relationship was terminated.']
  updated_timestamp timestamp [note: 'Timestamp when this account-policy relationship record was last modified.']

  Note: 'Association linking a billing account to one or more policies. One row per billing-account-to-policy relationship. Supports agency bill and direct bill splits, and multi-policy billing account consolidation.'
}

Table reinsurance.ri_agreement {
  ri_agreement_id varchar [pk, note: 'Unique surrogate identifier for the reinsurance agreement record. Primary key. One row per reinsurance agreement between the cedant and one or more reinsurers.']
  broker_agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Treaty agreements are placed through reinsurance brokers (agencies). Formalizing broker_name as FK enables producer performance tracking on treaty placements, commission reconciliation, and']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Reinsurance agreements are geographically scoped to catastrophe zones for PML aggregation and accumulation limit monitoring.']
  cedant_party_id varchar [note: 'Foreign key linking to party.party. Business justification: NAIC Schedule F regulatory reporting requires cedant identification by legal entity. Multi-entity P&C insurers must file reinsurance assumed/ceded by legal entity.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reinsurance agreements are multi-currency contracts; currency master provides exchange rates, rounding rules, and display formats for financial reporting, settlement, and collateral']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Normalize lob_code string to FK reference to shared.line_of_business master data. RI agreement currently stores lob_code as string; replacing with FK enables consistent LOB']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Master reinsurance agreements define in-scope perils for treaty placement and regulatory reporting.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Treaty agreements may credit lead producer on cedant side who structured the reinsurance program.']
  aggregate_limit_amt decimal(18,2) [note: 'Maximum cumulative reinsurance recovery across all losses in the treaty period. Caps total reinsurer exposure for Stop Loss and aggregate XOL structures. Null if no aggregate cap.']
  agreement_name varchar [note: 'Descriptive name or title of the reinsurance agreement (e.g., \'2024 Property CAT XL Layer 1\'). Used for human-readable identification in reports and workbenches.']
  agreement_number varchar [note: 'Externally-known unique reference number assigned to the reinsurance agreement by the cedant or reinsurance management system. Used in bordereaux and Schedule F reporting.']
  agreement_status varchar [note: 'Current lifecycle state of the reinsurance agreement. Active indicates the agreement is in force and cessions may be made. Expired indicates the term has ended with no renewal.']
  agreement_type varchar [note: 'Broad classification of the reinsurance arrangement: Treaty (automatic cession under standing contract), Facultative (individual risk negotiation), or Facultative-Obligatory.']
  arbitration_clause boolean [note: 'Indicates whether the agreement contains a mandatory arbitration clause for dispute resolution in lieu of litigation. True if arbitration is required.']
  attachment_point_amt decimal(18,2) [note: 'The loss threshold at which the reinsurance layer attaches and begins to respond for XOL and CAT XL treaties. Expressed in agreement currency. Null for proportional treaties.']
  authorized_status varchar [note: 'Regulatory authorization status of the lead reinsurer in the cedant\'s domicile state: Authorized, Unauthorized, Certified (under NAIC Credit for Reinsurance Model Law), or Reciprocal.']
  cat_event_scope varchar [note: 'Defines the loss aggregation basis for CAT XL treaties: Per Risk, Per Occurrence, Per Event (hours clause), or Aggregate. Determines how losses from a single CAT event are combined.']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant as a ceding commission under proportional (QS/Surplus) treaties to offset acquisition and overhead costs.']
  cession_pct decimal(7,4) [note: 'Percentage of risk ceded to reinsurers under a Quota Share treaty (e.g., 25.0000 = 25%). Null for XOL and non-proportional treaties where cession is loss-triggered.']
  collateral_required boolean [note: 'Indicates whether the reinsurer is required to post collateral (LOC, trust, funds withheld) due to unauthorized/alien reinsurer status. Drives Schedule F credit allowance.']
  collateral_type varchar [note: 'Type of collateral posted by the reinsurer: Letter of Credit (LOC), Trust Account, Funds Withheld, Cash, or None. Required for unauthorized reinsurer credit under SAP SSAP No. 62R.']
  coverage_basis varchar [note: 'Defines which losses are covered: Losses Occurring (loss event in treaty period), Risks Attaching (policy incepting in treaty period), or Claims Made (claim reported in treaty period).']
  created_timestamp timestamp [note: 'Timestamp when the reinsurance agreement record was first created in the reinsurance management system. Used for audit trail and data lineage tracking.']
  deposit_premium_amt decimal(18,2) [note: 'Initial premium paid by the cedant at inception of the treaty year, subject to adjustment at year-end based on actual subject premium. Used in ROL and premium settlement calculations.']
  expiry_date date [note: 'The date on which the reinsurance agreement expires and no new cessions may be made. Null for evergreen or open-ended agreements. Used in Schedule F run-off reporting.']
  funds_withheld boolean [note: 'Indicates whether the cedant withholds ceded premium reserves rather than remitting to the reinsurer. Affects Schedule F credit and collateral requirements under SAP SSAP No. 62R.']
  governing_law varchar [note: 'Legal jurisdiction whose laws govern interpretation and enforcement of the agreement (e.g., \'New York\', \'England and Wales\'). Required for dispute resolution and regulatory compliance.']
  hours_clause_hrs varchar [note: 'Number of consecutive hours within which losses from a single occurrence are aggregated for CAT XL recovery purposes (e.g., 72 hours for wind, 168 hours for flood). Null if not applicable.']
  inception_date date [note: 'The date on which the reinsurance agreement becomes effective and cessions may begin. Aligns with the treaty year start for annual treaties.']
  insolvency_clause boolean [note: 'Indicates whether the agreement contains an insolvency clause ensuring reinsurer obligations survive cedant insolvency. Required under SAP SSAP No. 62R for credit as reinsurance.']
  lead_reinsurer_naic_code varchar [note: 'Five-digit NAIC company code for the lead reinsurer. Required for Schedule F counterparty identification and credit risk assessment under SAP SSAP No. 62R.']
  lead_reinsurer_name varchar [note: 'Legal name of the lead reinsurer on the agreement. For syndicated treaties, this is the lead market that sets terms. Used in bordereaux and Schedule F counterparty reporting.']
  limit_amt decimal(18,2) [note: 'Maximum amount the reinsurer will pay per risk, per occurrence, or in aggregate under this agreement. Defines the top of the reinsurance layer for XOL treaties.']
  loss_corridor_pct decimal(7,4) [note: 'Loss ratio band within which the cedant retains losses before the reinsurer re-engages, used in Stop Loss and aggregate structures. Null if no loss corridor provision.']
  minimum_premium_amt decimal(18,2) [note: 'Minimum reinsurance premium guaranteed to the reinsurer regardless of actual subject premium volume. Protects reinsurer against cedant portfolio shrinkage.']
  offset_clause boolean [note: 'Indicates whether the agreement permits mutual offset of amounts owed between cedant and reinsurer. Relevant for credit risk management and Schedule F balance netting.']
  profit_commission_pct decimal(7,4) [note: 'Percentage of reinsurer profit returned to the cedant under a profit commission clause. Calculated on the treaty year result after losses and expenses. Null if no profit commission.']
  program_layer varchar [note: 'Identifies the layer within a multi-layer reinsurance program (e.g., \'Layer 1\', \'Layer 2\', \'Top Layer\'). Used to sequence layers for loss allocation and PML modeling.']
  reinstatement_count varchar [note: 'Number of times the reinsurance limit may be reinstated after a loss exhausts the layer. Common in CAT XL treaties. Zero indicates no reinstatement provision.']
  reinstatement_premium_pct decimal(7,4) [note: 'Percentage of the original reinsurance premium charged to reinstate the limit after a loss. Expressed as a percentage of the annual deposit premium (e.g., 100% = pro-rata reinstatement).']
  retention_amt decimal(18,2) [note: 'The cedant\'s net retained amount per risk or per occurrence before reinsurance responds. For XOL, this is the attachment point (SIR). For QS, this is the retained share in currency.']
  retrocession_flag boolean [note: 'Indicates whether this agreement is a retrocession (reinsurer ceding risk to another reinsurer) rather than a primary cession from the cedant. Affects Schedule F netting.']
  rol_pct decimal(7,4) [note: 'Rate on Line expressed as a percentage: reinsurance premium divided by the reinsurance limit. Key pricing metric for XOL and CAT XL layers used in actuarial and underwriting analysis.']
  signed_date date [note: 'The date the reinsurance agreement was formally executed and signed by all parties. May differ from inception date for retroactive or late-signed treaties.']
  territory_scope varchar [note: 'Geographic scope of risks covered by the agreement (e.g., \'USA and Canada\', \'Worldwide excluding War Zones\'). Drives exposure aggregation and CAT model alignment.']
  treaty_type varchar [note: 'Sub-classification for Treaty agreements: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), Catastrophe Excess of Loss (CAT XL), Surplus Share, or Other. Null for Facultative agreements.']
  unl_basis varchar [note: 'Defines how Ultimate Net Loss is calculated for recovery purposes: Gross (before other RI), Net of Inuring RI (after lower layers), or Net of All RI. Critical for layered program structures.']
  updated_timestamp timestamp [note: 'Timestamp when the reinsurance agreement record was most recently modified. Used for change tracking, audit compliance, and incremental data pipeline processing.']

  Note: 'Master record for a reinsurance agreement between the cedant and one or more reinsurers. One row per agreement. Captures agreement type (Treaty/Facultative), status, inception/expiry, governing law, and currency.'
}

Table reinsurance.treaty {
  treaty_id varchar [pk, note: 'Unique surrogate identifier for a reinsurance treaty record. Primary key. One row per treaty under a reinsurance agreement.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Treaty financial terms require currency master for exchange rate application, premium settlement, and multi-currency reporting.']
  intermediary_agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Treaties track intermediary/broker by name; should formalize as FK to agency. Enables broker performance analysis on treaty placements, commission tracking for reinsurance intermediation']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Treaty structuring, rate adequacy analysis, and regulatory reporting require LOB master for NAIC line codes, loss ratio targets, and treaty applicability rules.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Treaties are structured by peril (wind, earthquake, flood) for pricing, coverage basis, and regulatory Schedule F reporting.']
  reinsurer_id varchar [note: 'Foreign key linking to reinsurance.reinsurer. Business justification: Treaty has denormalized reinsurer attributes (reinsurer_name, reinsurer_naic_code, reinsurer_share_pct). Adding FK to reinsurer master and removing redundant name and NAIC code.']
  ri_agreement_id varchar [note: 'Reference to the parent reinsurance agreement under which this treaty is placed. Links treaty to the master agreement record.']
  aggregate_deductible decimal(18,2) [note: 'Cumulative loss amount the cedant must absorb before aggregate stop loss or aggregate XOL reinsurance attaches. Also known as the annual aggregate retention.']
  aggregate_limit decimal(18,2) [note: 'Maximum total reinsurance recovery across all occurrences during the treaty period. Caps cumulative recoveries for aggregate XOL and Stop Loss treaties.']
  attachment_point decimal(18,2) [note: 'Dollar amount at which reinsurance coverage attaches for XOL and CAT XL treaties. Losses below this threshold are retained by the cedant. Null for proportional treaties.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized/accredited in the cedant\'s domicile state. Affects credit for reinsurance on the statutory balance sheet per NAIC requirements.']
  brokerage_pct decimal(7,4) [note: 'Percentage of ceded premium paid to the reinsurance intermediary as brokerage commission. Expressed as a decimal (e.g., 0.0250 = 2.5%).']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant as ceding commission under a proportional treaty. Expressed as a decimal (e.g., 0.3000 = 30%). Null for XOL treaties.']
  cession_pct decimal(7,4) [note: 'Percentage of risk ceded to reinsurers under a Quota Share treaty. Expressed as a decimal (e.g., 0.7500 = 75%). Null for non-proportional treaties.']
  collateral_required_flag boolean [note: 'Indicates whether the reinsurer must post collateral (letter of credit or trust fund) to support credit for reinsurance on the cedant\'s statutory balance sheet.']
  coverage_basis varchar [note: 'Defines which losses are covered: Risks Attaching (policies incepting in treaty period), Losses Occurring (losses occurring in treaty period), or Claims Made.']
  created_timestamp timestamp [note: 'Timestamp when this treaty record was first created in the reinsurance management system. Used for audit trail and data lineage tracking.']
  deposit_premium decimal(18,2) [note: 'Provisional premium paid at treaty inception, subject to adjustment at year-end based on actual subject premium. Common in proportional and adjustable XOL treaties.']
  effective_date date [note: 'Date on which the treaty becomes binding and cessions may attach. Policies with inception on or after this date are eligible for cession under this treaty.']
  expiration_date date [note: 'Date on which the treaty expires and no new cessions may attach. Null for evergreen treaties. Used in Schedule F period-end calculations.']
  hours_clause varchar [note: 'Maximum number of consecutive hours within which losses from a single catastrophe event are aggregated for recovery purposes (e.g., 72 hours for windstorm, 168 hours for flood).']
  inception_year varchar [note: 'Calendar year in which the treaty incepted. Used for underwriting year (UY) and policy year (PY) loss triangle segmentation in actuarial reserving.']
  layer_number varchar [note: 'Sequential layer number within a tower of XOL or CAT XL protection (e.g., Layer 1, Layer 2). Distinguishes multiple treaties in the same program year.']
  limit decimal(18,2) [note: 'Maximum reinsurance recovery available under this treaty per occurrence or in aggregate. Defines the top of the layer for XOL/CAT XL treaties.']
  loss_corridor_lower decimal(7,4) [note: 'Lower bound of the loss ratio corridor retained by the cedant in a Stop Loss treaty. Expressed as a decimal loss ratio (e.g., 0.7000 = 70%). Null for non-SL treaties.']
  loss_corridor_upper decimal(7,4) [note: 'Upper bound of the loss ratio corridor at which Stop Loss reinsurance attaches. Expressed as a decimal loss ratio (e.g., 0.9000 = 90%). Null for non-SL treaties.']
  minimum_premium decimal(18,2) [note: 'Minimum reinsurance premium guaranteed to the reinsurer regardless of ceded subject premium volume. Protects reinsurer against low-volume years.']
  number varchar [note: 'Externally-known alphanumeric identifier assigned to the treaty by the cedant or reinsurer. Used in bordereaux reporting and Schedule F filings.']
  occurrence_limit decimal(18,2) [note: 'Maximum reinsurance recovery per single occurrence or event under this treaty. Distinct from aggregate limit. Applies to per-occurrence XOL and CAT XL structures.']
  placement_pct decimal(7,4) [note: 'Total percentage of treaty capacity placed with all reinsurers combined. A value less than 1.0000 indicates a partially placed treaty with net retained gap.']
  premium decimal(18,2) [note: 'Total reinsurance premium ceded to reinsurers under this treaty for the treaty period. For QS treaties, this is the ceded written premium. For XOL, this is the flat or deposit premium.']
  profit_commission_pct decimal(7,4) [note: 'Percentage of treaty profit returned to the cedant as profit commission under a sliding scale or profit-sharing arrangement. Null if no profit commission applies.']
  reinstatement_count varchar [note: 'Number of times the treaty limit may be reinstated after a loss exhausts the layer. Common in CAT XL treaties. Zero indicates no reinstatements available.']
  reinstatement_premium_pct decimal(7,4) [note: 'Percentage of the original treaty premium charged to reinstate the treaty limit after a loss. Expressed as a decimal (e.g., 1.0000 = 100% pro-rata reinstatement).']
  reinsurer_share_pct decimal(7,4) [note: 'Percentage of the treaty capacity subscribed by the lead reinsurer. For fully placed treaties this may be 100%; for syndicated treaties it reflects the lead line.']
  retention_amount decimal(18,2) [note: 'The cedant\'s net retained loss amount before reinsurance attaches. For XOL, this is the attachment point per occurrence. For QS, this is the retained percentage expressed as a dollar floor.']
  retention_pct decimal(7,4) [note: 'Percentage of risk retained by the cedant under a proportional (QS or Surplus) treaty. Expressed as a decimal (e.g., 0.2500 = 25%). Null for non-proportional treaties.']
  retrocession_flag boolean [note: 'Indicates whether this treaty is a retrocession arrangement (reinsurer ceding risk to another reinsurer). True = retrocession; False = standard cedant-to-reinsurer treaty.']
  rol_pct decimal(7,4) [note: 'Rate on Line expressed as a decimal: treaty premium divided by treaty limit. Key pricing metric for XOL and CAT XL treaties used in reinsurance pricing analytics.']
  subject_premium_basis varchar [note: 'Defines the premium base used to calculate ceded premium under proportional treaties: Gross Written Premium (GWP), Net Written Premium (NWP), Direct Premium Written (DPW), or Net Earned.']
  territory varchar [note: 'Geographic scope of risks covered by this treaty (e.g., \'USA\', \'USA and Canada\', \'Worldwide Excluding\'). Defines eligible cession geography for bordereaux reporting.']
  treaty_name varchar [note: 'Descriptive name of the treaty (e.g., \'Property CAT XL Layer 1 2024\'). Used for human identification in reinsurance management system and bordereaux.']
  treaty_status varchar [note: 'Current lifecycle state of the treaty. Controls whether new cessions can be written against it and whether recoveries are eligible.']
  treaty_type varchar [note: 'Classification of the treaty structure: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), Catastrophe Excess of Loss (CAT XL), or Surplus. Drives cession and recovery calculation logic.']
  unl_basis varchar [note: 'Defines how Ultimate Net Loss (UNL) is calculated for recovery purposes: gross of inuring reinsurance, net of inuring reinsurance, net of salvage/subrogation, or full UNL.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this treaty record in the reinsurance management system. Supports change tracking and audit compliance.']

  Note: 'Defines a proportional or non-proportional treaty under a reinsurance agreement. One row per treaty. Captures treaty type (QS/XOL/SL/CAT XL), layer, retention, limit, ROL, and UNL basis.'
}

Table reinsurance.treaty_layer {
  treaty_layer_id varchar [pk, note: 'Unique surrogate identifier for a single attachment/exhaustion layer within an XOL or CAT XL reinsurance treaty. One row per layer per treaty.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Treaty layers often have zone-specific attachment points and limits for concentration management, regulatory capital calculations, and underwriting guidelines.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Layer limits and premiums are currency-denominated; currency master provides exchange rates for multi-currency treaty structures and ensures consistent financial reporting across layers.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Treaty layers often restrict coverage by type (e.g., layer covers only general liability, not property).']
  parent_treaty_layer_id varchar [note: 'Self-referencing identifier of the immediately underlying treaty layer in a multi-layer tower. Null for the first layer above the cedant retention.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Treaty layers are defined by peril (wind layer, quake layer, flood layer) for PML runs, accumulation monitoring, and reinsurance pricing.']
  ri_agreement_id varchar [note: 'Reference to the parent reinsurance agreement under which this layer is structured. Links the layer to its governing treaty contract.']
  treaty_id varchar [note: 'Foreign key linking to reinsurance.treaty. Business justification: treaty_layer represents individual attachment/exhaustion layers within a treaty. Currently only references ri_agreement, but should also reference the parent treaty.']
  accounting_basis varchar [note: 'Basis on which losses are covered: losses_occurring (losses that occur during the treaty period) or risks_attaching (policies attaching during the treaty period).']
  annual_aggregate_deductible decimal(18,2) [note: 'Cumulative loss amount the cedant must retain across all occurrences before the annual aggregate limit of this layer begins to respond.']
  annual_aggregate_limit decimal(18,2) [note: 'Maximum total dollar amount recoverable from reinsurers under this layer across all occurrences within the treaty year. Null if no aggregate cap applies.']
  attachment_point decimal(18,2) [note: 'Dollar amount of loss per occurrence at which this reinsurance layer begins to respond. Losses below this threshold are retained by the cedant.']
  broker_reference varchar [note: 'Reinsurance broker\'s reference number or slip identifier for this layer as used in placement correspondence and market submissions.']
  cedant_retention_pct decimal(7,4) [note: 'Percentage of loss within this layer retained by the cedant (co-participation). Expressed as a decimal (e.g., 0.1000 = 10%). Remainder is ceded to reinsurers.']
  ceded_pct decimal(7,4) [note: 'Percentage of loss within this layer ceded to reinsurers. Equals 1 minus cedant_retention_pct. Stored explicitly for bordereaux and Schedule F reporting.']
  created_timestamp timestamp [note: 'Timestamp when this treaty layer record was first created in the reinsurance management system. Used for audit trail and data lineage.']
  deposit_premium decimal(18,2) [note: 'Provisional premium paid at inception of the treaty layer, subject to adjustment at year-end based on actual subject premium earned.']
  effective_date date [note: 'Date on which this treaty layer becomes binding and coverage obligations commence. Used to determine which layer applies to a given loss date.']
  exhaustion_point decimal(18,2) [note: 'Dollar amount at which this layer is fully exhausted, equal to attachment_point plus layer_limit. Stored explicitly for bordereaux reporting and PML tower analysis.']
  expiration_date date [note: 'Date on which this treaty layer expires and coverage obligations cease. Nullable for evergreen or continuous layers.']
  hours_clause varchar [note: 'Maximum number of consecutive hours within which losses from a single catastrophic event are aggregated as one occurrence (e.g., 168 for windstorm, 72 for earthquake).']
  index_basis varchar [note: 'Name or description of the index used for the index clause (e.g., CPI, Marshall & Swift construction cost index). Null if index_clause_flag is false.']
  index_clause_flag boolean [note: 'Indicates whether an index or stability clause applies to this layer, adjusting the attachment point and limit in line with an inflation or price index.']
  layer_code varchar [note: 'Externally-known alphanumeric code identifying this layer as referenced in bordereaux, reinsurer slips, and Schedule F filings.']
  layer_limit decimal(18,2) [note: 'Maximum dollar amount recoverable from reinsurers under this layer for a single occurrence or event. Defines the exhaustion point as attachment_point + layer_limit.']
  layer_name varchar [note: 'Descriptive name for this layer (e.g., \'1st XOL Layer\', \'2nd CAT XL Layer\') used in reinsurer communications and internal reporting.']
  layer_notes varchar [note: 'Free-text field for underwriter or reinsurance analyst notes regarding special terms, conditions, or exceptions applicable to this layer not captured in structured fields.']
  layer_number varchar [note: 'Sequential ordinal position of this layer within the treaty tower, starting at 1 for the first layer above the retention. Used to reconstruct the full tower order.']
  layer_status varchar [note: 'Current lifecycle state of the treaty layer indicating whether it is actively in force, expired, cancelled, pending placement, or suspended.']
  layer_type varchar [note: 'Classification of the reinsurance layer structure. XOL=Excess of Loss, CAT_XL=Catastrophe Excess of Loss, QS=Quota Share, SL=Stop Loss, WORKING=working layer, CLASH=clash cover.']
  lob_scope varchar [note: 'Comma-delimited list of Lines of Business covered by this layer (e.g., HO, PAP, CGL, BOP). Defines the subject business eligible for recovery under this layer.']
  loss_corridor_lower decimal(18,2) [note: 'Lower bound of a loss corridor within this layer where the cedant retains losses. Used in structured XOL layers with embedded retentions.']
  loss_corridor_upper decimal(18,2) [note: 'Upper bound of a loss corridor within this layer where the cedant retains losses. Losses above this bound revert to reinsurer coverage within the layer.']
  loss_occurrence_definition varchar [note: 'Contractual definition of a single occurrence for this layer (e.g., 168-hour clause for windstorm, 72-hour clause for earthquake). Critical for CAT XL aggregation.']
  minimum_premium decimal(18,2) [note: 'Minimum reinsurance premium guaranteed to reinsurers for this layer regardless of subject premium volume. Protects reinsurers against low-volume scenarios.']
  placed_pct decimal(7,4) [note: 'Percentage of this layer that has been placed with reinsurers. A value less than 1.0 indicates the layer is not fully subscribed.']
  profit_commission_pct decimal(7,4) [note: 'Percentage of underwriting profit returned to the cedant by reinsurers under a profit commission clause for this layer. Expressed as a decimal.']
  reinstatement_basis varchar [note: 'Basis on which reinstatement premium is calculated: pro_rata (proportional to loss), flat (fixed percentage), or free (no additional premium charged).']
  reinstatement_count varchar [note: 'Number of reinstatements available for this layer after a loss exhausts the layer limit. Zero indicates no reinstatements; null indicates unlimited reinstatements.']
  reinstatement_premium_pct decimal(7,4) [note: 'Percentage of the original layer premium charged per reinstatement to restore the layer limit after a loss. Expressed as a decimal (e.g., 1.0000 = 100% pro-rata).']
  reinsurance_premium decimal(18,2) [note: 'Gross reinsurance premium payable by the cedant to reinsurers for this layer for the treaty period. Used in bordereaux and Schedule F premium reporting.']
  retrocession_flag boolean [note: 'Indicates whether this layer is a retrocession layer (reinsurance of reinsurance) rather than a direct cession from the primary insurer.']
  rol_pct decimal(7,4) [note: 'Rate on Line expressed as a decimal; the reinsurance premium for this layer divided by the layer limit. Key pricing metric for XOL and CAT XL layers.']
  signed_line_pct decimal(7,4) [note: 'Total signed line percentage across all reinsurers participating in this layer after signing-down from written lines. Should sum to placed_pct.']
  sliding_scale_flag boolean [note: 'Indicates whether a sliding scale commission arrangement applies to this layer, where the ceding commission varies inversely with the loss ratio.']
  subject_premium_basis varchar [note: 'Premium base used to calculate the reinsurance premium for this layer. GWP=Gross Written Premium, NWP=Net Written Premium, DPW=Direct Premium Written, NEP=Net Earned Premium, GEP=Gross Earned Premium.']
  territory_scope varchar [note: 'Geographic territory covered by this layer (e.g., USA, USA_GULF, NATIONWIDE). Defines the geographic boundary of eligible subject business for this layer.']
  unl_basis varchar [note: 'Defines how Ultimate Net Loss is calculated for recovery under this layer: gross of all recoveries, net of other recoveries, or net of underlying reinsurance.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this treaty layer record. Used for change tracking, audit compliance, and incremental data loading.']

  Note: 'Individual attachment/exhaustion layer within an XOL or CAT XL treaty. One row per layer per treaty. Stores attachment point, limit per occurrence, annual aggregate limit, and reinstatement terms.'
}

Table reinsurance.fac_agreement {
  fac_agreement_id varchar [pk, note: 'Unique surrogate primary key for the facultative reinsurance agreement. One row per FAC placement covering a single risk or policy.']
  auto_risk_id varchar [note: 'Foreign key linking to riskexposure.auto_risk. Business justification: Facultative reinsurance is placed on large commercial auto fleets and high-value vehicles.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Facultative certificates are placed for specific risks whose cat zone drives pricing, capacity decisions, and accumulation monitoring.']
  catastrophe_event_id varchar [note: 'Reference to a catastrophe event record if this FAC placement was triggered or influenced by a specific CAT event exposure.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Facultative certificates are often in foreign currencies; currency master provides exchange rates for premium settlement, collateral valuation, and financial reporting.']
  fac_broker_agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Facultative placements are placed through broker agencies. Commission statements, binding authority verification, and appointment checks require the placing agency record.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Facultative certificates require LOB master for Schedule F reporting, reinsurer authorization by line, and collateral requirement calculations.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Facultative certificates are issued for named perils (wind, earthquake, flood).']
  policy_id varchar [note: 'Reference to the underlying policy whose risk is being ceded under this facultative agreement.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Facultative certificates are issued per policy term, not just per policy. On renewal, a new fac placement may be required for the new term.']
  primary_fac_broker_party_id varchar [note: 'Reference to the party record for the reinsurance intermediary/broker who placed this FAC agreement on behalf of the cedant.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Facultative certificates are often placed by individual producers who negotiate coverage with reinsurers.']
  property_risk_id varchar [note: 'Foreign key linking to riskexposure.property_risk. Business justification: Facultative underwriters evaluate property-specific attributes (construction type, replacement cost, TIV, roof type) when pricing and binding fac placements on commercial property.']
  reinsurer_id varchar [note: 'Foreign key linking to reinsurance.reinsurer. Business justification: fac_agreement has reinsurer_party_id pointing to generic party table, but also needs FK to specialized reinsurer master for reinsurer-specific attributes (ratings, authorization status']
  ri_agreement_id varchar [note: 'Reference to the parent reinsurance agreement record under which this facultative placement is administered.']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Facultative reinsurance is placed on specific high-value or unusual individual risks. Underwriters submit detailed risk characteristics to reinsurers for facultative quotes.']
  tertiary_fac_reinsurer_party_id varchar [note: 'Reference to the party record representing the assuming reinsurer accepting the ceded risk under this FAC placement.']
  uw_decision_id varchar [note: 'Foreign key linking to coverage.uw_decision. Business justification: Facultative reinsurers require underwriting decision context (risk tier, referral reasons, conditions, decline rationale) to assess participation and price fac certificates.']
  uw_referral_id varchar [note: 'Foreign key linking to coverage.uw_referral. Business justification: High-risk submissions triggering underwriting referrals often require facultative reinsurance.']
  agreement_status varchar [note: 'Current lifecycle state of the FAC agreement. Tracks progression from offer through binding, active coverage, and termination.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized/accredited in the cedant\'s state of domicile. Affects Schedule F credit and collateral requirements.']
  bound_date date [note: 'Date on which the reinsurer formally bound coverage under this facultative agreement, confirming acceptance of the ceded risk.']
  broker_commission_rate decimal(7,4) [note: 'Percentage of ceded premium payable to the reinsurance broker as intermediary commission for placing this FAC agreement.']
  cancellation_date date [note: 'Date on which the facultative agreement was cancelled, if applicable. Null for agreements that run to natural expiry.']
  ceded_limit_amount decimal(18,2) [note: 'Maximum dollar amount of loss the reinsurer will pay under this FAC agreement. Represents the reinsurer\'s liability cap for the placement.']
  ceded_percentage decimal(7,4) [note: 'Percentage of the original risk ceded to the reinsurer under this FAC agreement, expressed as a decimal (e.g., 0.5000 = 50%). Applies to pro-rata placements.']
  ceded_premium_amount decimal(18,2) [note: 'Dollar amount of premium ceded to the reinsurer under this FAC agreement. Reduces net written premium (NWP) for the cedant.']
  ceding_commission_amount decimal(18,2) [note: 'Dollar amount of ceding commission receivable from the reinsurer. Calculated as ceded premium multiplied by the ceding commission rate.']
  ceding_commission_rate decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant by the reinsurer as a ceding commission to offset acquisition and administrative costs.']
  collateral_amount decimal(18,2) [note: 'Dollar amount of collateral posted by the reinsurer (letter of credit or trust) to secure obligations under this FAC agreement.']
  collateral_required_flag boolean [note: 'Indicates whether the reinsurer is required to post collateral (letter of credit or trust fund) due to unauthorized status under NAIC credit for reinsurance rules.']
  created_timestamp timestamp [note: 'Timestamp when this FAC agreement record was first created in the reinsurance management system. Used for audit trail and data lineage.']
  expiry_date date [note: 'Date on which the facultative reinsurance coverage expires. Typically co-terminus with the underlying policy expiration date.']
  fac_certificate_number varchar [note: 'Certificate number issued by the reinsurer confirming acceptance of the facultative placement. Used for claims recovery and bordereaux reconciliation.']
  fac_premium_rate decimal(10,6) [note: 'Rate applied to the ceded limit or TIV to derive the FAC reinsurance premium. Expressed as a decimal (e.g., 0.005000 = 0.50%). Also known as Rate on Line (ROL) for XOL placements.']
  fac_reference_number varchar [note: 'Externally-known business identifier assigned to this FAC placement, used in bordereaux reporting and reinsurer correspondence. Unique per placement.']
  fac_type varchar [note: 'Structural type of the facultative placement: pro-rata (quota share basis) or excess of loss. Determines how premium and losses are shared.']
  gross_written_premium decimal(18,2) [note: 'Total gross written premium on the underlying policy before cession. Basis for calculating the ceded reinsurance premium.']
  inception_date date [note: 'Date on which the facultative reinsurance coverage becomes effective. Must align with or precede the underlying policy effective date.']
  loss_participation_rate decimal(7,4) [note: 'Percentage of losses the cedant participates in alongside the reinsurer under profit-sharing or loss-sensitive FAC structures.']
  original_insured_tiv decimal(18,2) [note: 'Total Insured Value of the underlying risk at the time of FAC placement. Used to calculate ceded exposure and Rate on Line (ROL).']
  placement_basis varchar [note: 'Basis on which the FAC agreement responds: risks attaching (policies incepting during the period) or losses occurring (losses during the period).']
  reinstatement_premium_rate decimal(7,4) [note: 'Rate applied to the original FAC premium to calculate the reinstatement premium payable when the ceded limit is reinstated after a loss.']
  reinstatement_provision boolean [note: 'Indicates whether the FAC agreement includes a reinstatement provision allowing the ceded limit to be restored after a loss, typically for XOL placements.']
  reinsurer_share_percentage decimal(7,4) [note: 'Percentage of the FAC placement accepted by this specific reinsurer. Relevant when a single FAC risk is placed with multiple reinsurers (co-reinsurance).']
  reinsurer_underwriter_name varchar [note: 'Name of the underwriter at the assuming reinsurer who accepted and bound this FAC placement.']
  retention_amount decimal(18,2) [note: 'Dollar amount of loss retained by the cedant (Pc_Insurance) before the reinsurer\'s liability attaches. Applies to excess-of-loss FAC placements.']
  retrocession_flag boolean [note: 'Indicates whether this FAC agreement is a retrocession (reinsurance of reinsurance), where the cedant is itself a reinsurer passing risk further.']
  schedule_f_category varchar [note: 'NAIC Schedule F classification of the reinsurer for statutory reporting: authorized, unauthorized, certified, or reciprocal jurisdiction reinsurer.']
  slip_reference varchar [note: 'Market slip or cover note reference number associated with this FAC placement, used in London Market or broker-placed reinsurance transactions.']
  special_conditions varchar [note: 'Free-text description of any special terms, conditions, exclusions, or warranties specific to this facultative placement not captured in structured fields.']
  underwriter_name varchar [note: 'Name of the cedant\'s underwriter responsible for placing and managing this facultative reinsurance agreement.']
  updated_timestamp timestamp [note: 'Timestamp when this FAC agreement record was last modified in the reinsurance management system. Supports audit trail and change tracking.']

  Note: 'Facultative reinsurance agreement covering a single risk or policy. One row per FAC placement. Captures cedant, reinsurer, ceded percentage, premium rate, inception/expiry, and the linked policy or submission.'
}

Table reinsurance.reinsurer {
  reinsurer_id varchar [pk, note: 'Unique surrogate identifier for each reinsurance counterparty record. Primary key of the reinsurer master table. One row per reinsurer entity.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reinsurer credit limits and collateral are currency-denominated; currency master provides exchange rates for credit monitoring, collateral adequacy assessment, and multi-currency reinsurer']
  parent_reinsurer_id varchar [note: 'Self-referencing identifier pointing to the parent reinsurer entity for group-level exposure aggregation, credit limit monitoring, and group Schedule F reporting.']
  party_id varchar [note: 'Foreign key linking to party.party. Business justification: Reinsurer entities are parties requiring KYC, address, contact, and identifier management. Multiple reinsurance products already use reinsurer_party_id FK to party.party, but reinsurer table']
  am_best_outlook varchar [note: 'AM Best rating outlook indicating the likely direction of the reinsurer\'s financial strength rating over the medium term. Informs counterparty risk monitoring.']
  am_best_rating varchar [note: 'AM Best Financial Strength Rating (FSR) assigned to the reinsurer. Used in underwriting guidelines to validate counterparty credit quality and treaty eligibility thresholds.']
  am_best_rating_date date [note: 'Date on which the current AM Best Financial Strength Rating was assigned or last affirmed. Used to assess rating currency and trigger counterparty review workflows.']
  approval_date date [note: 'Date on which the reinsurer was most recently approved by the internal credit committee for new cession activity. Supports counterparty governance audit trails.']
  approval_expiry_date date [note: 'Date on which the current internal approval for the reinsurer expires and must be renewed by the credit committee. Drives counterparty review scheduling.']
  approved_flag boolean [note: 'Indicates whether the reinsurer has been formally approved by the cedant\'s internal credit and counterparty risk committee for placement of new reinsurance agreements.']
  authorization_status varchar [note: 'Indicates whether the reinsurer is authorized, unauthorized, certified, or accredited in the cedant\'s domicile state. Determines Schedule F credit for reinsurance and collateral obligations.']
  broker_intermediary_name varchar [note: 'Name of the reinsurance broker or intermediary through which business is placed with this reinsurer. Used for commission tracking and intermediary credit risk assessment.']
  collateral_amount decimal(18,2) [note: 'Total USD amount of collateral currently posted by the reinsurer. Used in Schedule F credit calculations and counterparty exposure monitoring.']
  collateral_required_flag boolean [note: 'Indicates whether the reinsurer is required to post collateral (letter of credit, trust fund, or funds withheld) to support Schedule F credit for unauthorized reinsurers.']
  collateral_type varchar [note: 'Type of collateral arrangement posted by the reinsurer to secure Schedule F credit. Applicable to unauthorized and certified reinsurers per NAIC Model Law #785.']
  created_timestamp timestamp [note: 'Timestamp when the reinsurer master record was first created in the system. Supports audit trail, data lineage, and SOX compliance requirements.']
  credit_limit_amount decimal(18,2) [note: 'Maximum aggregate ceded exposure (in USD) approved for this reinsurer by the internal credit committee. Enforced at cession booking to prevent counterparty concentration breaches.']
  domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction where the reinsurer is legally domiciled. Used for Schedule F foreign reinsurer classification and credit determination.']
  domicile_state varchar [note: 'Two-letter US state or territory code where the reinsurer is domiciled, if a domestic entity. Used for state-level authorization and credit for reinsurance analysis.']
  federal_excise_tax_exempt_flag boolean [note: 'Indicates whether the reinsurer is exempt from US Federal Excise Tax on reinsurance premiums under a tax treaty or qualified jurisdiction status per IRC Section 4371.']
  fein varchar [note: 'IRS-assigned Federal Employer Identification Number (FEIN) for the reinsurer entity. Used for tax reporting, 1099 issuance, and AP payment processing.']
  group_name varchar [note: 'Name of the reinsurance group or holding company to which this reinsurer belongs. Used for group-level credit exposure aggregation and counterparty concentration risk.']
  last_review_date date [note: 'Date of the most recent formal counterparty credit review conducted by the cedant\'s reinsurance credit committee. Supports ORSA and governance audit requirements.']
  lloyds_syndicate_number varchar [note: 'Four-digit Lloyd\'s of London syndicate number. Populated only when reinsurer_type is lloyds_syndicate. Required for Lloyd\'s-specific bordereaux and premium trust fund reporting.']
  minimum_am_best_rating varchar [note: 'Minimum AM Best Financial Strength Rating required by internal policy for this reinsurer to remain eligible for new cessions. Triggers review if current rating falls below threshold.']
  moodys_rating varchar [note: 'Moody\'s Investors Service insurance financial strength rating for the reinsurer. Used as a tertiary credit quality indicator in counterparty risk frameworks.']
  naic_code varchar [note: 'Five-digit NAIC company code assigned to the reinsurer. Required for NAIC Schedule F statutory reporting and credit for reinsurance determinations.']
  next_review_date date [note: 'Scheduled date for the next formal counterparty credit review. Drives workflow alerts in the Reinsurance Management System to ensure timely governance compliance.']
  notes varchar [note: 'Free-text field for underwriting, credit, or operational notes about the reinsurer, such as special collateral arrangements, run-off status details, or relationship history.']
  pool_name varchar [note: 'Name of the reinsurance pool or facility when the reinsurer participates as a pool member. Used for pool-level aggregation in bordereaux and Schedule F reporting.']
  reinsurer_code varchar [note: 'Internal alphanumeric code assigned to uniquely identify the reinsurer within the Reinsurance Management System for bordereaux and cession processing.']
  reinsurer_status varchar [note: 'Current operational status of the reinsurer in the cedant\'s system. Controls eligibility for new cessions and triggers collection escalation for run-off or insolvent counterparties.']
  reinsurer_type varchar [note: 'Classification of the reinsurer entity structure. Drives Schedule F credit treatment and collateral requirements. [ENUM-REF-CANDIDATE: assuming_company|lloyds_syndicate|pool|captive|government|other — promote to reference product]']
  relationship_inception_date date [note: 'Date on which the cedant first entered into a reinsurance agreement with this counterparty. Used for relationship tenure analysis and counterparty history reporting.']
  retrocession_flag boolean [note: 'Indicates whether this reinsurer also acts as a retrocessionaire, accepting ceded risk from other reinsurers. Used to identify retrocession (RETRO) relationships in the reinsurance chain.']
  schedule_f_category varchar [note: 'NAIC Schedule F reporting category for this reinsurer. Determines the statutory credit treatment, penalty charges, and collateral requirements in the Annual Statement.']
  short_name varchar [note: 'Abbreviated or commonly used trading name of the reinsurer used in bordereaux reports, internal systems, and operational communications.']
  sp_rating varchar [note: 'S&P Global Ratings financial strength rating for the reinsurer. Supplementary credit quality indicator used alongside AM Best for counterparty risk assessment.']
  tax_withholding_rate decimal(5,4) [note: 'Federal excise tax or withholding rate applicable to premium payments to this reinsurer, expressed as a decimal (e.g., 0.01 = 1%). Applies to foreign unauthorized reinsurers per IRC Section 4371.']
  updated_timestamp timestamp [note: 'Timestamp when the reinsurer master record was most recently modified. Used for change data capture, audit trails, and data quality monitoring in the Silver layer.']

  Note: 'Master record for each reinsurance counterparty (assuming company, Lloyd\'s syndicate, or pool). One row per reinsurer. Stores legal name, NAIC code, AM Best rating, domicile, and authorized/unauthorized status for Schedule F credit.'
}

Table reinsurance.ri_participant {
  ri_participant_id varchar [pk, note: 'Unique surrogate identifier for a reinsurer\'s participation record within a treaty or facultative agreement. One row per reinsurer per agreement.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Participant settlement amounts (commutation, LC, trust fund, cession share) are currency-denominated.']
  fac_agreement_id varchar [note: 'Foreign key linking to reinsurance.fac_agreement. Business justification: ri_participant description states \'one row per reinsurer per agreement\' covering both treaty and FAC placements. For FAC placements, the participant must link to fac_agreement.']
  primary_ri_party_id varchar [note: 'Reference to the reinsurance intermediary (broker) who placed this participant\'s line. Used for broker commission settlement and bordereaux routing.']
  reinsurer_id varchar [note: 'Foreign key linking to reinsurance.reinsurer. Business justification: ri_participant has reinsurer_party_id but also extensive denormalized reinsurer attributes.']
  ri_agreement_id varchar [note: 'Reference to the parent reinsurance agreement (treaty or facultative) under which this participation is recorded.']
  treaty_id varchar [note: 'Foreign key linking to reinsurance.treaty. Business justification: ri_participant records a reinsurer\'s share within a specific treaty or FAC. Currently only ri_agreement_id exists, but participation is typically at the treaty level (not just master']
  account_current_basis varchar [note: 'Basis on which the account current (bordereaux) is prepared for this participant: written premium basis, earned premium basis, or cash basis.']
  agreement_type varchar [note: 'Type of reinsurance agreement: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), Catastrophe XL (CAT XL), or Facultative (FAC). Determines cession and recovery mechanics.']
  brokerage_commission_pct decimal(7,4) [note: 'Percentage of ceded premium payable to the reinsurance broker for placing this participant\'s line. Applied to the participant\'s share of written premium.']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant by this reinsurer as a ceding commission, covering acquisition and overhead costs. Applicable primarily to QS treaties.']
  cession_share_pct decimal(7,4) [note: 'Effective share of each cession allocated to this participant, derived from signed line and order hereon. Used to compute this reinsurer\'s portion of premium and loss.']
  commutation_amount decimal(18,2) [note: 'Lump-sum amount agreed upon in the commutation to settle all outstanding reserves and future obligations for this reinsurer\'s participation share.']
  commutation_date date [note: 'Date on which the commutation agreement was executed, extinguishing all future obligations between the cedant and this reinsurer under this participation.']
  commutation_flag boolean [note: 'Indicates whether this participation has been commuted, meaning all outstanding obligations have been settled by a lump-sum payment and the agreement extinguished.']
  cut_through_clause_flag boolean [note: 'Indicates whether a cut-through endorsement exists allowing the cedant\'s policyholders to claim directly against this reinsurer in the event of the cedant\'s insolvency.']
  effective_date date [note: 'Date on which the reinsurer\'s participation in the agreement becomes binding and cessions may be allocated to this participant.']
  expiration_date date [note: 'Date on which the reinsurer\'s participation ends. Null for open-ended participations. Used to determine in-force panel at any given date.']
  funds_withheld_flag boolean [note: 'Indicates whether the cedant withholds ceded premium from this reinsurer under a funds-withheld arrangement, used as collateral for unauthorized reinsurers.']
  insolvency_clause_flag boolean [note: 'Indicates whether the standard insolvency clause is included, requiring the reinsurer to pay claims even if the cedant becomes insolvent, per NAIC model law requirements.']
  lc_amount decimal(18,2) [note: 'Dollar amount of the letter of credit posted by this reinsurer as collateral. Required for Schedule F credit for reinsurance calculations for unauthorized reinsurers.']
  lc_required_flag boolean [note: 'Indicates whether this reinsurer is required to post a letter of credit as collateral for credit for reinsurance purposes under state regulation.']
  offset_clause_flag boolean [note: 'Indicates whether the participation agreement includes an offset clause allowing mutual debts between cedant and reinsurer to be netted in settlement.']
  order_hereon_pct decimal(7,4) [note: 'The cedant\'s order percentage representing the total share of risk placed with the reinsurance market. Used to scale signed and written lines to the actual ceded amount.']
  participant_reference_number varchar [note: 'Externally-known unique identifier assigned by the reinsurance management system to this participation line, used in bordereaux and Schedule F reporting.']
  participant_status varchar [note: 'Current lifecycle state of the reinsurer\'s participation in the agreement. Controls whether cessions and recoveries can be posted against this participant.']
  participation_type varchar [note: 'Classifies the reinsurer\'s role in the panel: leader sets terms, followers subscribe, sole reinsurer takes 100%. Drives bordereaux and settlement logic.']
  placement_date date [note: 'Date on which the reinsurer\'s line was formally placed and agreed, which may precede the participation effective date. Used for audit trail and contract management.']
  profit_commission_pct decimal(7,4) [note: 'Percentage of underwriting profit returned to the cedant by this reinsurer under a profit commission clause. Calculated after losses and expenses against this participant\'s share.']
  retrocession_flag boolean [note: 'Indicates whether this participation is part of a retrocession arrangement where the reinsurer is itself ceding risk onward to a retrocessionaire.']
  rol_pct decimal(7,4) [note: 'Rate on Line expressed as a percentage of the limit, representing the reinsurance premium as a proportion of the coverage limit for this participant\'s share. Key XOL pricing metric.']
  settlement_frequency varchar [note: 'Frequency at which premium and loss accounts are settled between the cedant and this reinsurer. Drives bordereaux generation and cash settlement scheduling.']
  signed_line_pct decimal(7,4) [note: 'The percentage of the agreement\'s risk that the reinsurer has formally signed and committed to. Signed lines across all participants must sum to 100% for a fully placed agreement.']
  signing_date date [note: 'Date on which the reinsurer formally signed the slip or contract, confirming their committed signed line percentage. Distinct from placement date.']
  source_system_code varchar [note: 'Identifier of the originating reinsurance management system record (e.g., Sapiens ReinsurancePro participant ID) for lineage and reconciliation purposes.']
  termination_date date [note: 'Date on which the reinsurer\'s participation was terminated prior to the scheduled expiration date, such as due to insolvency, commutation, or mutual agreement.']
  termination_reason varchar [note: 'Reason code for early termination of the reinsurer\'s participation. Used in commutation accounting and Schedule F disclosures.']
  trust_fund_amount decimal(18,2) [note: 'Amount held in a reinsurance trust fund by this reinsurer as an alternative collateral mechanism for credit for reinsurance under NAIC model law.']
  written_line_pct decimal(7,4) [note: 'The percentage of the agreement initially offered to and accepted by the reinsurer before signing-down. May differ from signed line when the placement is oversubscribed.']

  Note: 'Allocation of a reinsurer\'s share within a treaty or FAC agreement. One row per reinsurer per agreement. Captures signed line percentage, written line percentage, and participation effective dates.'
}

Table reinsurance.cession {
  cession_id varchar [pk, note: 'Unique surrogate identifier for each cession record. One row per policy term per treaty layer or facultative agreement. Primary key of the cession table.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this cession is booked for statutory and GAAP financial reporting purposes.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Cession records must align to NAIC reporting quarters and SAP/GAAP fiscal periods for bordereaux aggregation and Schedule F filing.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Reinsurance cessions must be aggregated by catastrophe zone for bordereaux reporting, accumulation limit monitoring, and Schedule F regulatory filings.']
  catastrophe_event_id varchar [note: 'Reference to the catastrophe event associated with this cession when is_catastrophe_cession is true. Links to the catastrophe event for PML and AAL aggregation.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Cessions record the actual transfer of risk to reinsurers. Premium and claim cessions must trace to the specific coverage being ceded for accurate bordereaux reporting, treaty allocation']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Cession accounting requires currency master for exchange rate application, multi-currency premium and loss aggregation, and statutory reporting in reporting currency.']
  fac_agreement_id varchar [note: 'Reference to the facultative reinsurance agreement if this is a FAC cession. Null for treaty cessions.']
  line_id varchar [note: 'Foreign key linking to policy.line. Business justification: Reinsurance cessions are allocated by LOB line within a policy term. Linking cession to the policy line record enables LOB-level bordereaux production, Schedule F reporting by line, and']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Cession accounting and bordereaux submission require LOB master for consistent line classification, treaty applicability rules, and regulatory reporting.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Cessions must identify the triggering peril for treaty allocation, bordereaux reporting, Schedule F classification, and reinsurer accounting.']
  policy_term_id varchar [note: 'Reference to the policy term being ceded. Links the cession to the specific time-bounded policy period in force at the time of cession.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Mid-term endorsements, cancellations, and reinstatements change subject premium and trigger cession adjustments.']
  quote_coverage_id varchar [note: 'Foreign key linking to coverage.quote_coverage. Business justification: Cessions must reconcile back to the original quoted coverage that was bound, enabling auditors and actuaries to trace ceded premium from quote through bind to cession.']
  reinsurer_id varchar [note: 'Foreign key linking to reinsurance.reinsurer. Business justification: reinsurance_cession has reinsurer_party_id pointing to the cross-domain party table but no FK to the in-domain reinsurer master record.']
  reinsurer_party_id varchar [note: 'Reference to the reinsurer party accepting this cession. Supports multi-reinsurer panels where each reinsurer has a separate cession row.']
  ri_agreement_id varchar [note: 'Reference to the parent reinsurance agreement (treaty or facultative) under which this cession is placed.']
  ri_participant_id varchar [note: 'Foreign key linking to reinsurance.ri_participant. Business justification: A cession is made to a specific reinsurer\'s participation share (signed line %, ceding commission %, settlement terms).']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Cessions represent the actual transfer of specific risk exposure to reinsurers. Exposure management and catastrophe modeling require linking cessions to underlying insured risks to']
  treaty_layer_id varchar [note: 'Reference to the specific treaty layer (e.g., first excess layer, second excess layer) within the reinsurance agreement to which this cession attaches.']
  accident_year varchar [note: 'Accident Year (AY) associated with losses ceded under this cession. Used for loss development triangles and IBNR reserving on ceded basis.']
  agreement_type varchar [note: 'Classifies the cession as treaty-based (automatic, per agreed terms) or facultative (individually negotiated per risk).']
  attachment_point decimal(18,2) [note: 'Dollar threshold at which the reinsurer\'s liability begins under an XOL or CAT XL treaty. Equivalent to the cedant\'s retention for excess layers.']
  booking_date date [note: 'Date on which this cession was recorded in the Reinsurance Management System and booked to the general ledger for statutory reporting.']
  bordereaux_period varchar [note: 'Reporting period (YYYY-MM or YYYY-Q#) for which this cession is included in the reinsurance bordereaux submission to the reinsurer.']
  ceded_case_reserve decimal(18,2) [note: 'Reinsurer\'s share of the case reserve for known reported losses ceded under this cession. Used for ceded reserve reporting on Schedule F.']
  ceded_earned_premium decimal(18,2) [note: 'Portion of the ceded premium that has been earned as of the reporting date, based on the pro-rata exposure period elapsed.']
  ceded_gwp decimal(18,2) [note: 'Gross Written Premium (GWP) ceded to the reinsurer for this policy term. Represents the cedant\'s cost of reinsurance before ceding commission.']
  ceded_ibnr_reserve decimal(18,2) [note: 'Reinsurer\'s share of the IBNR reserve for losses incurred but not yet reported under this cession. Required for ceded IBNR disclosure on Schedule F.']
  ceded_limit decimal(18,2) [note: 'Maximum reinsurer liability under this cession. For XOL treaties, this is the layer limit; for QS, it is the proportional share of the policy limit.']
  ceded_tiv decimal(18,2) [note: 'Total Insured Value (TIV) transferred to the reinsurer under this cession. Represents the gross exposure ceded for property lines.']
  ceded_unearned_premium decimal(18,2) [note: 'Portion of the ceded premium not yet earned as of the reporting date. Represents the reinsurer\'s liability for the unexpired risk period.']
  ceding_commission_amount decimal(18,2) [note: 'Commission paid by the reinsurer to the cedant to offset acquisition and administrative costs. Reduces the net cost of reinsurance.']
  ceding_commission_pct decimal(7,4) [note: 'Ceding commission expressed as a percentage of ceded written premium. Used to calculate the ceding commission amount for QS treaties.']
  collateral_amount decimal(18,2) [note: 'Amount of collateral (letters of credit, trust funds) posted by an unauthorized reinsurer to secure their obligations under this cession.']
  collateral_type varchar [note: 'Type of collateral instrument posted by the reinsurer to secure obligations. Required for unauthorized reinsurers per NAIC credit for reinsurance rules.']
  created_timestamp timestamp [note: 'Timestamp when this cession record was first created in the Reinsurance Management System. Used for audit trail and data lineage.']
  direction varchar [note: 'Indicates whether this is an outward cession (cedant to reinsurer) or a retrocession (reinsurer ceding further). Distinguishes primary cession from retro.']
  effective_date date [note: 'Date on which this cession becomes effective and the reinsurer assumes the ceded risk. Aligns with the policy term effective date for automatic treaty cessions.']
  exhaustion_point decimal(18,2) [note: 'Dollar amount at which the reinsurer\'s layer is fully exhausted (attachment point plus ceded limit). Defines the upper boundary of the reinsurer\'s liability.']
  expiration_date date [note: 'Date on which the cession expires and the reinsurer\'s liability ceases. Typically aligns with the policy term expiration date.']
  funds_held_amount decimal(18,2) [note: 'Amount of reinsurance premium held by the cedant as funds held under the reinsurance agreement, rather than remitted to the reinsurer.']
  is_catastrophe_cession boolean [note: 'Indicates whether this cession is associated with a catastrophe event (CAT XL treaty). Flags cessions for CAT PML aggregation and catastrophe bordereaux reporting.']
  number varchar [note: 'Externally-known business identifier for this cession, used in bordereaux reporting and reinsurer correspondence. Assigned by the Reinsurance Management System.']
  policy_year varchar [note: 'Policy Year (PY) in which the ceded policy term incepted. Used for actuarial loss development, Schedule P, and reinsurance year-of-account reporting.']
  rate_on_line decimal(7,4) [note: 'Rate on Line (ROL) expressed as a percentage of the ceded limit. Key pricing metric for XOL and CAT XL layers; equals ceded premium divided by ceded limit.']
  reinsurance_cession_status varchar [note: 'Current lifecycle state of the cession record within the reinsurance management workflow.']
  reinsurer_authorization_status varchar [note: 'NAIC authorization classification of the assuming reinsurer: authorized, accredited, certified, unauthorized, or reciprocal. Drives collateral and credit requirements.']
  reinsurer_domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code of the reinsurer\'s domicile. Determines whether the reinsurer is authorized, accredited, or unauthorized under NAIC Schedule F.']
  reinsurer_naic_code varchar [note: 'Five-digit NAIC company code of the assuming reinsurer. Required for NAIC Schedule F statutory reporting and reinsurer credit risk assessment.']
  retention_amount decimal(18,2) [note: 'Amount retained by the cedant (Self-Insured Retention / SIR) before the reinsurer\'s liability attaches. Attachment point for XOL; retained share for QS.']
  share_pct decimal(7,4) [note: 'Proportional share (as a percentage) ceded to the reinsurer. Applicable for Quota Share treaties. For XOL, this represents the reinsurer\'s participation percentage in the layer.']
  source_system_code varchar [note: 'Identifier of the originating Reinsurance Management System record (e.g., Sapiens ReinsurancePro cession ID or SICS record key) for traceability and reconciliation.']
  treaty_type varchar [note: 'Type of reinsurance treaty structure: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), or Catastrophe Excess of Loss (CAT XL). Null for FAC cessions.']
  ultimate_net_loss decimal(18,2) [note: 'Ultimate Net Loss (UNL) ceded under this cession, representing the reinsurer\'s share of total incurred losses including LAE. Key metric for XOL treaty performance.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this cession record. Used for change tracking and incremental data pipeline processing.']

  Note: 'Records risk transfer of a policy term to a treaty layer or FAC. Grain: one row per policy term per treaty layer (or FAC). Direction flag (outward/retro) distinguishes cession from retrocession.'
}

Table reinsurance.ri_premium_transaction {
  ri_premium_transaction_id varchar [pk, note: 'Unique surrogate key for each reinsurance ceded premium financial movement. One row per written, earned, unearned, return, or reinstatement transaction for a cession. TRANSACTION_HEADER role.']
  accounting_period_id varchar [note: 'Reference to the accounting period (month/quarter/year) in which this reinsurance premium transaction is booked for statutory and GAAP financial reporting purposes.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: RI premium transactions must be aligned to fiscal/reporting calendar periods for NAIC Schedule F bordereaux submission, GAAP/SAP period-close, and treaty year vs.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Ceded premium transactions require zone attribution for bordereaux reporting, zone-level reinsurance cost allocation, and catastrophe program premium analysis.']
  cession_id varchar [note: 'Reference to the reinsurance cession record that this premium transaction belongs to. Links the financial movement to the specific risk ceded under a treaty or facultative agreement.']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: Reinstatement premiums are triggered by specific claims exhausting a treaty layer limit. Linking ri_premium_transaction to the triggering claim supports reinstatement premium billing, treaty']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: RI premium transactions record ceded written/earned premium in multiple currencies. A proper currency FK replaces the denormalized currency_code plain column and enables multi-currency']
  fac_agreement_id varchar [note: 'Foreign key linking to reinsurance.fac_agreement. Business justification: Premium transactions can be for facultative placements in addition to treaty layers. Currently has treaty_layer_id. Adding optional fac_agreement_id for FAC premium transactions.']
  insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Facultative RI premium transactions must be allocated to specific insured risks for Schedule F regulatory reporting, risk-level ceded premium accounting, and reinsurer bordereaux.']
  line_id varchar [note: 'Foreign key linking to policy.line. Business justification: RI premium transactions must be allocated to the specific policy LOB line for bordereaux reporting and LOB-level reinsurance premium accounting.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Premium transactions must classify by line for GL coding, treaty allocation, and statutory accounting; LOB master provides chart of accounts mappings and ensures consistent line']
  original_transaction_ri_premium_transaction_id varchar [note: 'For reversal or correction transactions, references the ri_premium_transaction_id of the original entry being reversed. Null for original transactions. Supports audit trail and net balance reconciliation.']
  policy_id varchar [note: 'Reference to the underlying direct policy whose premium is being ceded. Required for facultative cessions and policy-level bordereaux reporting under Schedule F.']
  policy_term_id varchar [note: 'Reference to the specific policy term period for which ceded premium is being transacted. Enables reconstruction of in-force ceded premium at any historical date.']
  premium_transaction_id varchar [note: 'Foreign key linking to premium.premium_transaction. Business justification: Reinsurance premium transactions must trace to the originating gross premium transaction for reconciliation, bordereaux preparation, ceded/net premium calculation, and regulatory']
  reinsurer_id varchar [note: 'Reference to the reinsurer party record (assuming entity in the party domain) to whom the premium is ceded. Required for Schedule F counterparty-level reporting.']
  ri_agreement_id varchar [note: 'Reference to the reinsurance agreement (treaty or facultative) under which this premium transaction is recorded. Supports bordereaux reporting and treaty-level premium aggregation.']
  treaty_layer_id varchar [note: 'Reference to the specific treaty layer (e.g., first excess, second excess) within a multi-layer XOL or CAT XL program to which this ceded premium is allocated.']
  accident_year varchar [note: 'The calendar year in which losses covered by this ceded premium are expected to occur. Used for accident year (AY) loss development triangles and actuarial reserving analysis.']
  accounting_date date [note: 'The date on which this transaction is recognized in the general ledger and statutory accounts. May differ from transaction_date due to period-end cut-off adjustments.']
  agreement_type varchar [note: 'The structural type of the reinsurance agreement: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), Catastrophe Excess of Loss (CAT XL), or Surplus Share.']
  bordereaux_period varchar [note: 'The YYYY-MM period for which this transaction is included in the reinsurance bordereaux submission to the reinsurer. Format: YYYY-MM. Drives bordereaux extract and reinsurer statement reconciliation.']
  bordereaux_status varchar [note: 'Tracks the submission lifecycle of this transaction in the reinsurance bordereaux process. Acknowledged by reinsurer confirms premium settlement; Disputed triggers reconciliation workflow.']
  ceded_earned_premium decimal(18,2) [note: 'The pro-rata portion of ceded written premium recognized as earned during the accounting period. Used for ceded loss ratio and earned premium calculations in Schedule P and Schedule F.']
  ceded_unearned_premium decimal(18,2) [note: 'The portion of ceded written premium not yet earned as of the accounting date. Represents the reinsurer\'s liability for the unexpired policy period. Required for NAIC Annual Statement balance sheet.']
  ceded_written_premium decimal(18,2) [note: 'The portion of written premium transferred to the reinsurer under this cession. For QS treaties, equals GWP multiplied by the cession percentage. Core field for NWP and DPW calculations.']
  ceding_commission decimal(18,2) [note: 'Commission paid by the reinsurer to the cedant to offset acquisition and administrative costs. Expressed as a flat amount per transaction. Reduces the net cost of reinsurance.']
  ceding_commission_rate decimal(7,4) [note: 'The rate applied to ceded written premium to calculate the ceding commission (e.g., 0.2500 = 25%). Used for sliding-scale commission calculations under profit-sharing treaties.']
  cession_percentage decimal(7,4) [note: 'The percentage of the underlying risk ceded to the reinsurer under a quota share or surplus share treaty (e.g., 0.3000 = 30%). Null for XOL treaties where cession is event-triggered.']
  cession_type varchar [note: 'Indicates whether the ceded premium relates to a treaty arrangement, a facultative (FAC) placement, or a retrocession. Drives bordereaux format and Schedule F classification.']
  created_timestamp timestamp [note: 'Timestamp when this reinsurance premium transaction record was first created in the reinsurance management system (Sapiens ReinsurancePro or SICS).']
  exchange_rate decimal(18,6) [note: 'Exchange rate used to convert foreign currency amounts to the cedant\'s functional reporting currency (USD). Applied as of the accounting_date for statutory reporting purposes.']
  gl_account_code varchar [note: 'The general ledger account code to which this reinsurance premium transaction is posted in the statutory accounting system (Oracle/SAP GL). Required for Schedule F and NAIC Annual Statement mapping.']
  gross_written_premium decimal(18,2) [note: 'The total direct written premium on the underlying policy before any reinsurance cession. Base for calculating the ceded share under quota share or facultative agreements.']
  occurrence_reference_code varchar [note: 'Reference to the loss occurrence or catastrophe event that triggered a reinstatement premium. Populated only for transaction_type = Reinstatement. Links to the loss event record.']
  policy_effective_date date [note: 'The date the underlying direct policy became effective. Used to assign the ceded premium to the correct policy year (PY) for actuarial and Schedule P/F reporting.']
  policy_expiration_date date [note: 'The date the underlying direct policy expires. Used to calculate the unearned premium period and pro-rata earning of ceded premium over the policy term.']
  policy_year varchar [note: 'The year in which the underlying policy was written. Used for policy year (PY) experience analysis and reinsurance program performance monitoring per NAIC Schedule F.']
  profit_commission decimal(18,2) [note: 'Contingent commission earned by the cedant when the reinsurer\'s loss ratio on the treaty falls below a specified threshold. Booked as a reduction in net reinsurance cost.']
  rate_on_line decimal(7,4) [note: 'The reinsurance premium expressed as a percentage of the treaty limit (ROL = premium / limit). Key pricing metric for XOL and CAT XL treaties used in actuarial and underwriting analysis.']
  reinstated_limit decimal(18,2) [note: 'The amount of treaty limit reinstated following a loss occurrence, for which the reinstatement_premium is charged. Applicable only when transaction_type = Reinstatement.']
  reinstatement_premium decimal(18,2) [note: 'Additional premium paid to the reinsurer to reinstate exhausted treaty limit following a loss occurrence. Applicable to XOL and CAT XL treaties. Linked to occurrence_reference_id.']
  reporting_currency_amount decimal(18,2) [note: 'Ceded written premium converted to the cedant\'s statutory reporting currency (USD) using the exchange_rate. Used for NAIC Annual Statement and Schedule F USD-denominated filings.']
  return_premium decimal(18,2) [note: 'Premium returned to the cedant from the reinsurer due to policy cancellation, mid-term endorsement reducing exposure, or audit adjustment. Negative impact on ceded written premium.']
  reversal_flag boolean [note: 'Indicates whether this transaction is a reversal of a previously posted reinsurance premium entry. True = reversal transaction. Used for audit trail and net premium reconciliation.']
  risk_effective_date date [note: 'The date from which the reinsurer\'s coverage obligation begins for this cession. May differ from policy_effective_date for mid-term facultative placements or endorsements.']
  risk_expiration_date date [note: 'The date on which the reinsurer\'s coverage obligation ends for this cession. Used to determine the ceded unearned premium reserve at any balance sheet date.']
  source_system_code varchar [note: 'Identifies the operational system that originated this reinsurance premium transaction (e.g., SICS, Sapiens ReinsurancePro, manual entry). Used for data lineage and reconciliation.']
  transaction_date date [note: 'The business event date on which this premium movement occurred (e.g., policy effective date for written, pro-rata date for earned, cancellation date for return).']
  transaction_number varchar [note: 'Externally visible business identifier for this reinsurance premium transaction, used in bordereaux submissions, reinsurer statements, and Schedule F regulatory filings.']
  transaction_status varchar [note: 'Current workflow state of the premium transaction in the reinsurance management system. Posted transactions are included in bordereaux and statutory filings.']
  transaction_type varchar [note: 'Classification of the premium movement: Written (new cession), Earned (pro-rata recognition), Unearned (reserve release), Return (cancellation/endorsement), or Reinstatement (post-loss premium).']
  treaty_year varchar [note: 'The underwriting year of the reinsurance treaty under which this premium is ceded (e.g., 2024). Used for treaty-year loss ratio monitoring and bordereaux aggregation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this reinsurance premium transaction record. Used for audit trail and incremental data pipeline processing.']

  Note: 'Ceded premium ledger. One row per financial movement (written, earned, unearned, return, reinstatement) for a cession. FK to cession, accounting period, treaty layer. Reinstatement rows carry occurrence reference and reinstated limit.'
}

Table reinsurance.ri_claim_cession {
  ri_claim_cession_id varchar [pk, note: 'Unique surrogate primary key for the reinsurance claim cession record. One row per claim exposure per treaty layer or facultative agreement.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this cession is recognized for statutory and GAAP financial reporting purposes.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Claim cessions must be aligned to NAIC Schedule P reporting periods and bordereaux submission cycles.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Claim-level cessions require zone attribution for catastrophe loss aggregation, reinsurance recovery analysis by zone, and bordereaux reporting to reinsurers.']
  catastrophe_event_id varchar [note: 'Reference to the catastrophe event record if this claim cession is associated with a CAT event, enabling CAT XL treaty aggregation and PML tracking.']
  cession_id varchar [note: 'Foreign key linking to reinsurance.reinsurance_cession. Business justification: A claim cession is triggered under the same policy-term cession arrangement.']
  claim_exposure_id varchar [note: 'Reference to the claim exposure (coverage line within a claim) being ceded to the reinsurer. Links the cession to the specific coverage and insured risk.']
  claim_id varchar [note: 'Reference to the parent claim record associated with this cession, enabling claim-level reinsurance aggregation and bordereaux reporting.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Claim cession financials (ceded loss, reserve, paid amounts) are denominated in specific currencies.']
  fac_agreement_id varchar [note: 'Foreign key linking to reinsurance.fac_agreement. Business justification: Claim cessions can be to facultative agreements in addition to treaty layers. Description states \'Links a claim exposure to a reinsurance treaty layer or FAC agreement.\' Currently']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Claim cessions aggregate by line for treaty layer attachment, bordereaux reporting, and Schedule P reconciliation; LOB master ensures consistent classification across claims and']
  loss_event_id varchar [note: 'Foreign key linking to claims.loss_event. Business justification: Per-occurrence treaty aggregation requires grouping all cessions under a single loss occurrence for hours-clause compliance and per-occurrence limit calculations.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Claim cessions require peril identification for treaty layer matching, coverage verification, and reinsurer reporting.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Schedule F and reinsurance claim accounting require aggregating ceded losses by policy year and term. ri_claim_cession has policy_year as a plain attribute but no FK to the term record.']
  reinsurer_id varchar [note: 'FK to reinsurance.reinsurer']
  ri_agreement_id varchar [note: 'Reference to the reinsurance agreement (treaty or facultative) under which this claim cession is made.']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: When ceding claim recoveries, reinsurers require detailed risk characteristics (TIV, construction type, occupancy, protection class, year built) to validate coverage applicability']
  treaty_layer_id varchar [note: 'Reference to the specific treaty layer (e.g., first XOL layer, second XOL layer) within the reinsurance agreement applicable to this cession.']
  accident_year varchar [note: 'Calendar year in which the loss event occurred. Used for actuarial loss triangle development and reinsurance recovery analysis by accident year.']
  bordereaux_period varchar [note: 'Reporting period (e.g., 2024-Q1 or 2024-M03) for which this cession is included in the reinsurance bordereaux submission to the reinsurer.']
  bordereaux_submission_date date [note: 'Date on which this cession record was included in a bordereaux submission to the reinsurer for loss recovery billing.']
  cat_event_code varchar [note: 'Industry-standard catastrophe event code (e.g., ISO PCS serial number) identifying the CAT event for aggregation under CAT XL treaty layers.']
  ceded_alae_amount decimal(18,2) [note: 'Allocated Loss Adjustment Expense (ALAE) component of the ceded LAE, representing defense and cost containment (DCC) expenses ceded to the reinsurer.']
  ceded_lae_amount decimal(18,2) [note: 'The portion of Loss Adjustment Expense (LAE) ceded to the reinsurer, including ALAE and applicable ULAE, per the treaty terms.']
  ceded_loss_amount decimal(18,2) [note: 'The portion of the gross incurred loss ceded to the reinsurer under this agreement layer. Core financial metric for reinsurance recovery eligibility.']
  ceded_paid_loss_amount decimal(18,2) [note: 'Cumulative loss payments already recovered from or billed to the reinsurer under this cession as of the reporting date.']
  ceded_reserve_amount decimal(18,2) [note: 'Outstanding case reserve amount ceded to the reinsurer for this claim exposure, representing the reinsurer\'s share of unpaid losses.']
  cession_effective_date date [note: 'Date on which this claim cession becomes effective under the reinsurance agreement, typically aligned with the loss date or treaty inception.']
  cession_percentage decimal(7,4) [note: 'Proportional cession percentage applied to the gross loss for quota share treaties (e.g., 0.7500 = 75%). Null for non-proportional XOL structures.']
  cession_status varchar [note: 'Current lifecycle state of the claim cession record within the reinsurance recovery workflow.']
  cession_type varchar [note: 'Indicates whether the cession is under a treaty arrangement, a facultative (FAC) agreement, or a retrocession.']
  commutation_date date [note: 'Date on which the commutation agreement was executed for this cession, if applicable. Null when commutation_flag is false.']
  commutation_flag boolean [note: 'Indicates whether this cession has been subject to a commutation agreement with the reinsurer, settling all future obligations in a lump sum.']
  created_timestamp timestamp [note: 'Timestamp when this reinsurance claim cession record was first created in the reinsurance management system.']
  dispute_reason varchar [note: 'Description of the reason for a reinsurer dispute on this cession, if applicable. Populated when recovery_status is \'disputed\'.']
  funds_held_amount decimal(18,2) [note: 'Amount of funds held by the cedant on behalf of the reinsurer as collateral or per treaty terms, reported on Schedule F.']
  gross_loss_amount decimal(18,2) [note: 'Total gross (pre-reinsurance) incurred loss amount for the claim exposure, including paid losses and outstanding reserves before any cession.']
  is_cat_claim boolean [note: 'Indicates whether this claim cession is associated with a declared catastrophe event, triggering CAT XL treaty layer eligibility review.']
  layer_limit_amount decimal(18,2) [note: 'Maximum reinsurance recovery available under this treaty layer for the ceded claim exposure. Defines the per-occurrence or per-risk limit.']
  layer_retention_amount decimal(18,2) [note: 'The cedant\'s retained loss amount at the applicable treaty layer before reinsurance recovery applies. Represents the SIR or attachment point retention.']
  loss_date date [note: 'Date of the underlying loss event that triggered the claim, used to determine which treaty year and layer applies for cession eligibility.']
  policy_year varchar [note: 'Year in which the policy that generated the ceded claim was written, used for policy-year loss development and reinsurance program analysis.']
  recovery_billed_date date [note: 'Date on which the reinsurance recovery was formally billed to the reinsurer for this claim cession.']
  recovery_received_date date [note: 'Date on which payment was received from the reinsurer for this cession, used for cash flow and Schedule F counterparty aging analysis.']
  recovery_status varchar [note: 'Current status of the reinsurance recovery billing and collection process for this cession. Tracks progress from billing through settlement.']
  reinsurance_type varchar [note: 'Classification of the reinsurance structure: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), CAT XL, or facultative variants. [ENUM-REF-CANDIDATE: quota_share|excess_of_loss|stop_loss|cat_xl|facultative_proportional|facultative_non_proportional —']
  reinsurer_participation_pct decimal(7,4) [note: 'The reinsurer\'s share of the treaty layer as a decimal (e.g., 0.5000 = 50%), used when multiple reinsurers participate in a single layer.']
  report_date date [note: 'Date the claim was reported to the cedant, used for claims-made policy cession eligibility and IBNR bordereaux reporting.']
  rol_rate decimal(7,4) [note: 'Rate on Line (ROL) applicable to this treaty layer, expressed as a decimal. Used for pricing analysis and reinsurance cost allocation.']
  schedule_f_category varchar [note: 'NAIC Schedule F regulatory classification of the reinsurer for statutory reporting: authorized, unauthorized, certified, or other alien reinsurer.']
  treaty_year varchar [note: 'The underwriting or treaty year (e.g., 2023) under which this cession falls, used for bordereaux aggregation and Schedule F reporting.']
  unl_amount decimal(18,2) [note: 'Ultimate Net Loss (UNL) calculation basis for this cession, representing the net loss after salvage, subrogation, and other recoveries, used to determine XOL trigger.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this reinsurance claim cession record, supporting audit trail and data lineage requirements.']

  Note: 'Links a claim exposure to a reinsurance treaty layer or FAC agreement for loss recovery eligibility. One row per claim exposure per treaty layer. Stores ceded loss amount, ceded LAE, and UNL calculation basis.'
}

Table reinsurance.ri_recovery {
  ri_recovery_id varchar [pk, note: 'Unique identifier for each reinsurance recovery financial movement. Primary key. Grain: one row per movement per cession per accounting period.']
  accounting_period_id varchar [note: 'Foreign key to the accounting period in which this recovery movement was recorded.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Recovery movements must be booked to specific accounting calendar periods for GAAP/SAP close and reinsurer collectibility aging reports.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Recovery amounts must be aggregated by catastrophe zone for reinsurance program performance reporting, accumulation limit utilization tracking, and zone-level loss development']
  catastrophe_event_id varchar [note: 'Foreign key to the catastrophe event, if this recovery is related to a catastrophic loss.']
  claim_exposure_id varchar [note: 'Foreign key to the underlying claim exposure that generated this ceded loss and recovery.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Recovery amounts are collected in the reinsurer\'s settlement currency. A proper currency FK replaces the denormalized currency_code plain column and supports multi-currency recovery tracking']
  fac_agreement_id varchar [note: 'Foreign key linking to reinsurance.fac_agreement. Business justification: Recoveries can be from facultative agreements in addition to treaty layers. Currently has reinsurance_agreement_id but no specific FAC reference.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Recoveries are analyzed by line for treaty performance monitoring and reinsurer credit evaluation; LOB master provides loss ratio targets and combined ratio benchmarks for performance']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Reinsurance recoveries must be attributed by peril for Schedule F reporting, actuarial loss development by peril, and reinsurance program performance analysis.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Reinsurance recoveries must be reported by policy year for Schedule F and reinsurance accounting. ri_recovery has policy_year as a plain attribute but no FK to the term.']
  reinsurer_id varchar [note: 'Foreign key to the reinsurer party responsible for this recovery.']
  ri_agreement_id varchar [note: 'Foreign key to the reinsurance agreement (treaty or facultative) under which this recovery is claimed.']
  ri_claim_cession_id varchar [note: 'Foreign key to the reinsurance claim cession that this recovery movement applies to.']
  treaty_id varchar [note: 'Identifier of the bordereaux batch in which this recovery was reported to the reinsurer (for treaty business).']
  accident_year varchar [note: 'The accident year of the underlying loss for which this recovery is claimed.']
  authorized_reinsurer_flag boolean [note: 'Boolean indicator (True/False) whether the reinsurer is authorized or accredited in the ceding companys domiciliary state for statutory credit purposes.']
  billed_date date [note: 'The date on which the recovery was billed to the reinsurer via bordereaux or facultative certificate.']
  bordereaux_submission_date date [note: 'The date on which the bordereaux containing this recovery was submitted to the reinsurer.']
  cat_code varchar [note: 'Industry-standard catastrophe code (e.g., PCS number) identifying the catastrophic event.']
  ceded_share_percentage decimal(5,2) [note: 'The percentage of the underlying loss that is ceded to the reinsurer under the agreement (e.g., 50.00 for 50% quota share).']
  collateral_required_flag boolean [note: 'Boolean indicator (True/False) whether collateral (e.g., letter of credit, trust account) is required from the reinsurer for statutory credit.']
  collected_amount decimal(18,2) [note: 'The actual cash amount collected from the reinsurer, which may differ from the billed recovery amount due to disputes or adjustments.']
  collected_date date [note: 'The date on which cash payment was received from the reinsurer for this recovery.']
  commutation_date date [note: 'The date on which the reinsurance agreement was commuted, if applicable.']
  commutation_flag boolean [note: 'Boolean indicator (True/False) whether this recovery is part of a commutation (final settlement) of the reinsurance agreement.']
  created_timestamp timestamp [note: 'The timestamp when this recovery record was first created in the reinsurance management system.']
  dispute_date date [note: 'The date on which the reinsurer formally disputed this recovery.']
  dispute_flag boolean [note: 'Boolean indicator (True/False) whether this recovery is currently in dispute with the reinsurer.']
  dispute_reason varchar [note: 'Free-text description of the reason for dispute, if applicable (e.g., coverage interpretation, late notice, policy exclusion).']
  exchange_rate decimal(12,6) [note: 'The exchange rate applied to convert the recovery amount from policy currency to USD.']
  facultative_certificate_number varchar [note: 'The certificate number for facultative reinsurance agreements, if applicable.']
  movement_date date [note: 'The business date on which this recovery movement was recorded or effective.']
  movement_type varchar [note: 'Discriminator indicating the type of financial movement: reserve position (case/IBNR/LAE) or cash recovery (loss/LAE/DCC payment, subrogation, salvage). [ENUM-REF-CANDIDATE']
  notes varchar [note: 'Free-text notes or comments regarding this recovery movement, including adjustments, disputes, or special handling instructions.']
  outstanding_amount decimal(18,2) [note: 'The amount of recovery still outstanding (billed but not yet collected) from the reinsurer.']
  payment_type varchar [note: 'Type of payment for cash movements: loss (indemnity), LAE (loss adjustment expense), DCC (defense and cost containment), subrogation, salvage.']
  policy_year varchar [note: 'The policy year of the underlying policy for which this recovery is claimed.']
  recovery_amount decimal(18,2) [note: 'The gross amount of reinsurance recovery for this movement, in the policy currency. Positive for recoveries due from reinsurer, negative for adjustments or reversals.']
  recovery_amount_usd decimal(18,2) [note: 'The recovery amount converted to USD for statutory and consolidated reporting purposes.']
  recovery_status varchar [note: 'Current status of the recovery: pending (not yet billed), billed (invoice sent), collected (cash received), disputed, written off, or reversed.']
  reinstatement_premium_amount decimal(18,2) [note: 'The amount of reinstatement premium payable to the reinsurer to restore coverage after a loss recovery.']
  reinstatement_premium_flag boolean [note: 'Boolean indicator (True/False) whether a reinstatement premium is due to the reinsurer as a result of this recovery.']
  reserve_type varchar [note: 'Type of reserve for reserve movements: case (reported loss), IBNR (incurred but not reported), LAE (loss adjustment expense), ULAE (unallocated LAE), ALAE (allocated LAE).']
  transaction_timestamp timestamp [note: 'The precise timestamp when this recovery transaction was posted to the reinsurance ledger.']
  treaty_year varchar [note: 'The treaty year (underwriting year) to which this recovery applies, for treaty accounting and reporting.']
  updated_timestamp timestamp [note: 'The timestamp when this recovery record was last modified.']

  Note: 'Single ceded loss ledger. Grain: one row per movement per ri_claim_cession per accounting period, discriminated by movement_type: case/IBNR/LAE reserve position, or cash recovery (loss/LAE/DCC, subrogation, salvage).'
}

Table riskexposure.insured_risk {
  insured_risk_id varchar [pk, note: 'Unique identifier for the insured_risk data product (auto-inserted during validation).']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Cat zone assignment on insured_risk drives reinsurance treaty applicability, accumulation limit checks, and PML run scoping.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: TIV (Total Insured Value) on insured_risk is a monetary amount requiring currency context for multi-currency commercial portfolios, reinsurance cession calculations, and regulatory solvency']
  geography_id varchar [note: 'Foreign key to the geography hierarchy for this risk. Enables aggregation by state, county, city, postal code.']
  household_id varchar [note: 'Foreign key linking to party.household. Business justification: Household-level TIV aggregation, multi-policy underwriting review, and catastrophe accumulation reporting require linking insured risks to the owning household.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Every insured risk must be classified to a line of business for rating, loss reserving, regulatory reporting (Schedule P), and reinsurance treaty attachment.']
  policy_term_id varchar [note: 'Foreign key to the policy term under which this risk is insured.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Rating territory on insured_risk is the primary driver of base rate selection, ISO loss cost filings, and state regulatory rate filings.']
  writing_producer_producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Producer book-of-business reporting, commission calculation, and binding authority compliance all require tracing each insured risk to the writing producer.']
  coinsurance_percentage decimal(5,2) [note: 'Coinsurance percentage applicable to this risk. Triggers penalty if insurance-to-value falls below this threshold.']
  construction_code varchar [note: 'ISO or NAIC construction type code. Part of COPE data for property risks.']
  created_by_user_code varchar [note: 'User identifier of the person who created this insured risk record.']
  created_timestamp timestamp [note: 'Timestamp when this insured risk record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'Standard deductible amount applicable to this risk. May be overridden at coverage level.']
  deductible_type varchar [note: 'Type of deductible applied to this risk. Determines how the deductible is calculated and applied at claim time.']
  effective_date date [note: 'Date when coverage for this insured risk begins. Must fall within the policy term effective period.']
  expiration_date date [note: 'Date when coverage for this insured risk ends. Nullable for open-ended risks. Must not exceed policy term expiration.']
  exposure_basis varchar [note: 'Unit of measure for rating exposure. Examples: square footage, payroll, sales, number of vehicles, number of employees.']
  exposure_units decimal(18,2) [note: 'Quantity of exposure units for rating purposes. Used to calculate premium based on rate per unit.']
  flood_zone_code varchar [note: 'FEMA flood zone designation for this risk. Determines flood coverage eligibility and pricing.']
  geocode_quality_score decimal(3,2) [note: 'Quality score for the geocoded coordinates, ranging from 0.00 to 1.00. Higher scores indicate more precise geocoding.']
  hazard_score decimal(5,2) [note: 'Catastrophe hazard score for this risk location. Derived from catastrophe modeling platforms.']
  inspection_date date [note: 'Date when the most recent physical inspection of this risk was completed.']
  inspection_required_flag boolean [note: 'Indicates whether a physical inspection is required for this risk before binding or renewal.']
  inspection_status varchar [note: 'Current status of the inspection requirement for this risk.']
  itv_percentage decimal(5,2) [note: 'Ratio of sum insured to total insured value, expressed as percentage. Used to identify underinsurance and apply coinsurance penalties.']
  latitude decimal(10,7) [note: 'Geocoded latitude coordinate for the risk location. Used in catastrophe modeling and spatial analytics.']
  longitude decimal(10,7) [note: 'Geocoded longitude coordinate for the risk location. Used in catastrophe modeling and spatial analytics.']
  modified_by_user_code varchar [note: 'User identifier of the person who last modified this insured risk record.']
  modified_timestamp timestamp [note: 'Timestamp when this insured risk record was last modified.']
  occupancy_code varchar [note: 'ISO or NAIC occupancy classification code. Part of COPE data for property risks.']
  prior_loss_amount decimal(18,2) [note: 'Total dollar amount of prior losses for this risk or similar risks. Used in underwriting evaluation and pricing.']
  prior_loss_count varchar [note: 'Number of prior losses reported for this risk or similar risks. Used in underwriting evaluation and pricing.']
  protection_class varchar [note: 'ISO Public Protection Classification or equivalent fire protection grade. Part of COPE data for property risks.']
  risk_description varchar [note: 'Free-text narrative describing the insured risk. Appears on policy declarations and endorsements.']
  risk_number varchar [note: 'Business identifier for the insured risk, unique within the policy. Used on declarations pages and endorsements.']
  risk_score decimal(5,2) [note: 'Underwriting risk score assigned to this insured risk. Higher scores indicate higher risk. Used in pricing and underwriting decisions.']
  risk_status varchar [note: 'Current lifecycle status of the insured risk within the policy term.']
  sum_insured_amount decimal(18,2) [note: 'Sum insured representing the policy limit applicable to this risk. May differ from total insured value based on underwriting decisions.']
  tiv_amount decimal(18,2) [note: 'Total insured value representing the maximum exposure for this risk. Used in catastrophe modeling and aggregate exposure reporting.']
  underwriter_notes varchar [note: 'Free-text notes recorded by the underwriter regarding this insured risk. May contain risk assessment details and special conditions.']
  valuation_date date [note: 'Date when the insured value was last assessed or updated. Used for insurance-to-value calculations.']
  valuation_method varchar [note: 'Method used to determine the insured value of the risk. Drives claims settlement basis.']

  Note: 'Supertype master for every insurable object underwritten on a policy. One row per insured risk. Subtypes property_risk and auto_risk extend it via shared PK (explicit subtype FK).'
}

Table riskexposure.property_risk {
  property_risk_id varchar [pk, note: 'Unique identifier for the property_risk data product (auto-inserted during validation).']
  insured_risk_id varchar [note: 'Foreign key to the parent insured risk supertype record.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Property risks span multiple LOBs (commercial property, homeowners, dwelling fire, inland marine) with distinct ISO forms, rating plans, and state filing requirements.']
  policy_term_id varchar [note: 'Foreign key to the policy term under which this property risk is insured.']
  property_owner_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Property underwriting requires direct link to property owner party for title verification, loss payee validation, and insured interest determination.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Property risk territory assignment drives ISO loss cost selection, rate filings, and TIV accumulation reporting by territory for property lines.']
  actual_cash_value decimal(18,2) [note: 'The replacement cost value minus depreciation. Used for certain policy forms and loss settlement.']
  basement_finish_type varchar [note: 'The level of finish in the basement, if present. Impacts valuation and loss potential.']
  basement_indicator boolean [note: 'Indicates whether the property has a basement. Impacts flood and water damage risk.']
  burglar_alarm_indicator boolean [note: 'Indicates whether the property has a burglar or intrusion alarm system. May provide premium credit.']
  central_station_monitoring_indicator boolean [note: 'Indicates whether alarm systems are monitored by a central station. Provides additional premium credit.']
  coinsurance_percentage decimal(5,2) [note: 'The coinsurance percentage required by the policy form, typically 80%, 90%, or 100%. Used to calculate coinsurance penalties at claim time.']
  construction_type varchar [note: 'The construction class of the building. Part of COPE attributes. Examples: frame, joisted masonry, non-combustible, masonry non-combustible, modified fire resistive, fire resistive.']
  cooling_type varchar [note: 'The type of cooling or air conditioning system. Examples: central air, window units, evaporative, none.']
  created_timestamp timestamp [note: 'The timestamp when this property risk record was first created in the system.']
  distance_to_fire_hydrant_feet decimal(8,2) [note: 'Distance in feet from the property to the nearest fire hydrant. Impacts protection class and rating.']
  distance_to_fire_station_miles decimal(8,2) [note: 'Distance in miles from the property to the nearest responding fire station. Impacts protection class and rating.']
  effective_date date [note: 'The date from which this property risk record is effective under the policy term.']
  electrical_system_type varchar [note: 'The type of electrical system. Examples: circuit breaker, fuse box, knob and tube. Impacts fire risk.']
  expiration_date date [note: 'The date on which this property risk record expires or is no longer in force under the policy term.']
  exposure_description varchar [note: 'Description of external exposures that may increase risk. Part of COPE attributes. Examples: proximity to brush, adjacent buildings, hazardous operations nearby.']
  fire_alarm_indicator boolean [note: 'Indicates whether the property has a fire alarm or smoke detection system. May provide premium credit.']
  foundation_type varchar [note: 'The type of foundation supporting the structure. Impacts flood and earthquake risk.']
  heating_type varchar [note: 'The type of heating system. Examples: forced air, electric, oil, gas, heat pump, wood stove. Impacts fire and equipment breakdown risk.']
  insurance_to_value_percentage decimal(5,2) [note: 'The ratio of insured value to replacement cost value, expressed as a percentage. Used to assess adequacy of coverage and apply coinsurance penalties.']
  iso_construction_code varchar [note: 'ISO standard construction classification code used for rating and catastrophe modeling.']
  number varchar [note: 'Business identifier for the property risk, often used in underwriting and rating systems.']
  number_of_stories varchar [note: 'The number of above-ground stories or floors in the building.']
  number_of_units varchar [note: 'The number of dwelling units or rental units in the property, if applicable for multi-family or commercial properties.']
  occupancy_type varchar [note: 'The use or occupancy of the property. Part of COPE attributes for underwriting and rating. Examples: owner-occupied, tenant-occupied, retail, office, manufacturing, warehouse.']
  plumbing_type varchar [note: 'The type of plumbing material. Examples: copper, PVC, galvanized, PEX. Impacts water damage risk.']
  property_status varchar [note: 'Current lifecycle status of the property risk record within the policy term.']
  protection_class varchar [note: 'ISO Public Protection Classification or similar fire protection rating. Part of COPE attributes. Lower numbers indicate better fire protection.']
  replacement_cost_value decimal(18,2) [note: 'The estimated cost to replace the property with materials of like kind and quality at current prices.']
  roof_shape varchar [note: 'The architectural shape of the roof. Impacts wind resistance and catastrophe modeling.']
  roof_type varchar [note: 'The type of roofing material. Examples: asphalt shingle, tile, metal, flat, slate. Impacts wind and hail risk.']
  roof_year varchar [note: 'The year the roof was installed or last replaced. Used for age-based rating and underwriting decisions.']
  sprinkler_system_indicator boolean [note: 'Indicates whether the property has an automatic fire sprinkler system. Provides premium credit and reduces fire loss potential.']
  square_footage decimal(12,2) [note: 'Total square footage of the property. Used for rating, valuation, and catastrophe exposure aggregation.']
  total_insured_value decimal(18,2) [note: 'The total insured value of the property risk. Used for catastrophe exposure aggregation, reinsurance cession, and PML modeling.']
  updated_timestamp timestamp [note: 'The timestamp when this property risk record was last modified.']
  valuation_date date [note: 'The date on which the property was last valued or appraised.']
  valuation_method varchar [note: 'The method used to determine the insured value. Examples: appraisal, cost estimator tool, market value, agreed value, stated amount.']
  year_built varchar [note: 'The year the property was originally constructed. Used for age-based rating and risk assessment.']
  year_renovated varchar [note: 'The year of the most recent major renovation or remodel, if applicable.']

  Note: 'Property-line subtype of insured_risk. One row per property risk. Captures COPE attributes (Construction, Occupancy, Protection, Exposure), ITV, year built, square footage, and ISO construction class for rating and CAT modeling.'
}

Table riskexposure.location {
  location_id varchar [pk, note: 'Unique identifier for the location data product (auto-inserted during validation).']
  address_id varchar [note: 'Foreign key linking to party.address. Business justification: Underwriting territory rating, geocoding, and catastrophe zone assignment all require the canonical party.address record for a risk location.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Locations require catastrophe zone assignment for real-time accumulation limit monitoring during quoting, underwriting guideline enforcement (moratorium checks), and reinsurance']
  policy_id varchar [note: 'Reference to the policy under which this location is insured.']
  property_risk_id varchar [note: 'Reference to the parent property risk entity for this location.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Location-level territory assignment is used for property rating, ISO loss cost application, and TIV concentration reporting by territory.']
  alarm_type varchar [note: 'Type of fire or burglar alarm system installed at the location. Used for rating credits.']
  building_limit decimal(15,2) [note: 'Coverage limit for the building structure at this location. Part of TIV calculation.']
  business_income_limit decimal(15,2) [note: 'Coverage limit for business interruption or time element coverage at this location. Part of TIV calculation.']
  coastal_distance_miles decimal(8,2) [note: 'Distance in miles from the location to the nearest coastline. Used for hurricane and storm surge exposure assessment.']
  construction_type varchar [note: 'ISO construction class for the primary building at this location. Part of COPE data used for rating and catastrophe modeling.']
  contents_limit decimal(15,2) [note: 'Coverage limit for business personal property and contents at this location. Part of TIV calculation.']
  county_name varchar [note: 'County or parish name for the location. Used for regulatory and catastrophe aggregation.']
  created_timestamp timestamp [note: 'Timestamp when this location record was first created in the system. Used for audit and data lineage.']
  deductible_amount decimal(12,2) [note: 'Standard deductible amount applicable to losses at this location. May be overridden by peril-specific deductibles.']
  earthquake_deductible_percent decimal(5,2) [note: 'Percentage deductible applied to earthquake losses at this location. Common in seismic zones.']
  effective_date date [note: 'Date this location became effective under the policy. Used for temporal queries and loss date matching.']
  elevation_feet decimal(8,2) [note: 'Elevation of the location above sea level in feet. Used for flood and storm surge risk modeling.']
  expiration_date date [note: 'Date this location expires or was removed from the policy. Null for currently active locations.']
  fips_code varchar [note: 'Five-digit FIPS code identifying the county. Used for catastrophe modeling and regulatory reporting.']
  fire_station_distance_miles decimal(6,2) [note: 'Distance in miles from the location to the nearest fire station. Used for protection class rating.']
  flood_zone varchar [note: 'FEMA flood zone classification for the location. Determines flood risk and eligibility for NFIP coverage.']
  geocode_accuracy varchar [note: 'Precision level of the geocoded coordinates. Rooftop is most precise, county is least precise.']
  hydrant_distance_feet decimal(6,2) [note: 'Distance in feet from the location to the nearest fire hydrant. Used for protection class rating.']
  latitude decimal(10,7) [note: 'Geocoded latitude coordinate of the location. Used for catastrophe exposure aggregation and mapping.']
  location_name varchar [note: 'Business or site name for the insured location. Human-readable label for the property.']
  location_status varchar [note: 'Current lifecycle status of the location within the policy. Active locations are in force and contribute to exposure.']
  longitude decimal(10,7) [note: 'Geocoded longitude coordinate of the location. Used for catastrophe exposure aggregation and mapping.']
  modified_timestamp timestamp [note: 'Timestamp when this location record was last modified. Used for audit and change tracking.']
  naics_code varchar [note: 'Six-digit NAICS code describing the business activity at the location. Used for risk classification and underwriting.']
  number varchar [note: 'Business identifier for the location within the policy. Typically sequential or alphanumeric code assigned by underwriter.']
  number_of_stories varchar [note: 'Total number of above-ground stories in the primary building. Used for catastrophe modeling and underwriting.']
  occupancy_type varchar [note: 'Primary business or use classification for the location. Part of COPE data used for underwriting and rating.']
  protection_class varchar [note: 'ISO Public Protection Classification or fire protection class for the location. Ranges from 1 best to 10 worst. Part of COPE data.']
  sic_code varchar [note: 'Four-digit SIC code describing the business activity at the location. Used for risk classification and underwriting.']
  sprinkler_type varchar [note: 'Type of fire sprinkler system installed at the location. Used for rating credits and underwriting decisions.']
  tiv decimal(15,2) [note: 'Total insured value for all property at this location. Sum of building, contents, and business income limits. Used for catastrophe aggregation.']
  total_area_square_feet decimal(12,2) [note: 'Total building area in square feet for all structures at the location. Used for exposure calculation and rating.']
  wind_deductible_percent decimal(5,2) [note: 'Percentage deductible applied to wind and hail losses at this location. Common in coastal and high-wind areas.']
  year_built varchar [note: 'Year the primary building at this location was originally constructed. Used for age-based rating and underwriting.']
  year_renovated varchar [note: 'Year of most recent major renovation or update to the building. Used for underwriting and rating adjustments.']

  Note: 'Physical address and geocoded site associated with a property risk. One row per insured location. Stores street address, lat/long, FIPS code, territory code, flood zone, and links to geography hierarchy for CAT aggregation.'
}

Table riskexposure.building {
  building_id varchar [pk, note: 'Unique identifier for the building data product (auto-inserted during validation).']
  location_id varchar [note: 'Foreign key to the insured location where this building is situated.']
  property_risk_id varchar [note: 'Foreign key to the parent property risk record that this building belongs to.']
  actual_cash_value decimal(15,2) [note: 'Replacement cost value minus depreciation. Used for certain coverage types and loss settlement.']
  agreed_value_amount decimal(15,2) [note: 'Pre-agreed valuation amount between insurer and insured, if applicable. Used in agreed value policies.']
  basement_finish_type varchar [note: 'Classification of basement finish: finished, partially finished, unfinished, or none.']
  basement_indicator boolean [note: 'Indicates whether the building has a basement. True if basement present, false otherwise.']
  building_name varchar [note: 'Descriptive name or label for the building, if applicable.']
  building_status varchar [note: 'Current operational status of the building: active, vacant, under construction, under renovation, or demolished.']
  burglar_alarm_indicator boolean [note: 'Indicates whether the building has a burglar or intrusion alarm system installed. True if present, false otherwise.']
  central_station_monitoring_indicator boolean [note: 'Indicates whether fire or burglar alarms are monitored by a central station. True if monitored, false otherwise.']
  coinsurance_percentage decimal(5,2) [note: 'Coinsurance requirement percentage (e.g., 80, 90, 100) that applies to this building. Used for loss settlement calculation.']
  construction_type varchar [note: 'Building construction classification per ISO standards: frame, joisted masonry, non-combustible, masonry non-combustible, modified fire resistive, or fire resistive.']
  cooling_type varchar [note: 'Primary cooling system type (e.g., central air, window units, evaporative, none). Impacts equipment breakdown risk.']
  created_timestamp timestamp [note: 'System timestamp when this building record was first created in the source system.']
  distance_to_fire_hydrant_feet decimal(8,2) [note: 'Distance in feet from the building to the nearest fire hydrant. Used for protection class rating.']
  distance_to_fire_station_miles decimal(6,2) [note: 'Distance in miles from the building to the nearest responding fire station. Used for protection class rating.']
  earthquake_retrofit_indicator boolean [note: 'Indicates whether the building has been retrofitted for earthquake resistance. True if retrofitted, false otherwise.']
  effective_date date [note: 'Date this building record became effective for the policy term. Used for temporal reconstruction of coverage.']
  electrical_system_year varchar [note: 'Calendar year the electrical system was last updated or replaced. Used for age-based risk assessment.']
  expiration_date date [note: 'Date this building record expires or is superseded. Null if currently active. Used for temporal reconstruction.']
  exterior_wall_material varchar [note: 'Primary material used for exterior walls (e.g., brick, wood siding, vinyl, stucco). Impacts fire and wind rating.']
  fire_alarm_indicator boolean [note: 'Indicates whether the building has a fire alarm system installed. True if present, false otherwise.']
  fire_protection_class varchar [note: 'ISO Public Protection Classification (PPC) code for the building location, ranging from 1 (best) to 10 (worst).']
  flood_vents_indicator boolean [note: 'Indicates whether the building has flood vents installed per NFIP (National Flood Insurance Program) standards. True if present, false otherwise.']
  foundation_type varchar [note: 'Type of building foundation: slab, crawl space, basement, pier, or other. Impacts flood and earthquake risk.']
  heating_type varchar [note: 'Primary heating system type (e.g., forced air, hot water, electric, steam). Impacts fire and equipment breakdown risk.']
  hvac_system_year varchar [note: 'Calendar year the HVAC system was last updated or replaced. Used for equipment breakdown risk assessment.']
  iso_building_class varchar [note: 'ISO classification code for the building type used in property rating and underwriting.']
  last_modified_timestamp timestamp [note: 'System timestamp when this building record was last updated in the source system.']
  number varchar [note: 'Business identifier for the building within the location. Used for rating and underwriting reference.']
  number_of_stories varchar [note: 'Total count of above-ground floors in the building. Used for risk assessment and rating.']
  number_of_units varchar [note: 'Total count of dwelling units or rental units in the building, if applicable (e.g., for apartment buildings).']
  occupancy_type varchar [note: 'Primary use or occupancy classification of the building per COPE (Construction, Occupancy, Protection, Exposure) framework.']
  plumbing_system_year varchar [note: 'Calendar year the plumbing system was last updated or replaced. Used for water damage risk assessment.']
  replacement_cost_value decimal(15,2) [note: 'Estimated cost to replace the building with materials of like kind and quality at current prices. Used for coverage limits and ITV (Insurance to Value) calculation.']
  roof_material varchar [note: 'Primary material used for the roof covering (e.g., asphalt shingle, metal, tile, slate). Impacts wind and hail rating.']
  roof_type varchar [note: 'Classification of the roof structure: flat, gable, hip, mansard, gambrel, shed, or other. [ENUM-REF-CANDIDATE: flat|gable|hip|mansard|gambrel|shed|other — 7 candidates stripped; promote to reference product]']
  roof_year varchar [note: 'Calendar year the roof was last replaced or substantially renovated. Used for age-based rating adjustments.']
  sprinkler_indicator boolean [note: 'Indicates whether the building has an automatic fire sprinkler system installed. True if sprinklered, false otherwise.']
  sprinkler_type varchar [note: 'Classification of the fire sprinkler system: wet pipe, dry pipe, pre-action, deluge, or none.']
  total_square_footage decimal(12,2) [note: 'Total floor area of the building in square feet. Used for exposure calculation and rating.']
  vacancy_indicator boolean [note: 'Indicates whether the building is currently vacant. True if vacant, false if occupied. Impacts underwriting and rating.']
  vacancy_start_date date [note: 'Date the building became vacant, if applicable. Used for vacancy clause enforcement.']
  wind_mitigation_features varchar [note: 'Description of wind mitigation features present (e.g., hurricane straps, impact-resistant windows, reinforced roof deck). Used for wind rating credits.']
  year_built varchar [note: 'Calendar year the building was originally constructed. Used for age-based rating and underwriting.']

  Note: 'Individual structure on an insured location. One row per building. Captures number of stories, roof type, roof year, frame type, sprinkler indicator, replacement cost value, and ISO building class for property rating.'
}

Table riskexposure.auto_risk {
  auto_risk_id varchar [pk, note: 'Unique identifier for the auto_risk data product (auto-inserted during validation).']
  garaging_address_id varchar [note: 'Foreign key to the address where the vehicle is principally garaged, used for territory rating.']
  insured_risk_id varchar [note: 'Foreign key to the parent insured risk supertype record.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Auto underwriting, NAIC Schedule P reporting, and reinsurance treaty applicability all require LOB classification on auto_risk.']
  party_id varchar [note: 'Foreign key to the party record representing the lienholder or lessor with financial interest in the vehicle.']
  policy_term_id varchar [note: 'Foreign key to the policy term under which this auto risk is insured.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Garaging territory on auto_risk is the foundational rating variable for personal and commercial auto — it determines base rates, surcharges, and state-mandated rate filings.']
  actual_cash_value_amount decimal(15,2) [note: 'Estimated actual cash value of the vehicle at policy inception, used for underwriting and claims settlement.']
  annual_mileage varchar [note: 'Estimated annual mileage driven, used as a rating factor for exposure and loss frequency.']
  anti_theft_device_code varchar [note: 'Code indicating the type of anti-theft device installed, used for premium discounts and underwriting.']
  business_use_class varchar [note: 'Detailed business use classification code for commercial vehicles, aligned with SIC or NAICS codes.']
  clue_report_date date [note: 'Date the CLUE report was pulled for this vehicle, used for loss history verification.']
  clue_report_indicator boolean [note: 'Flag indicating whether a CLUE report was obtained for underwriting this auto risk.']
  created_by_user varchar [note: 'User identifier of the person or system that created this auto risk record.']
  created_timestamp timestamp [note: 'Timestamp when this auto risk record was first created in the system.']
  effective_date date [note: 'Date this auto risk became effective on the policy term, used for coverage and premium proration.']
  expiration_date date [note: 'Date this auto risk expires or was removed from the policy term, used for coverage and premium proration.']
  garaging_state varchar [note: 'Two-letter state code where the vehicle is principally garaged, critical for rating and regulatory compliance.']
  garaging_zip_code varchar [note: 'ZIP or postal code of the garaging location, used for territory and catastrophe exposure rating.']
  loss_free_years varchar [note: 'Number of consecutive years without a claim on this vehicle, used for experience rating and discounts.']
  modified_by_user varchar [note: 'User identifier of the person or system that last modified this auto risk record.']
  modified_timestamp timestamp [note: 'Timestamp when this auto risk record was last modified in the system.']
  primary_driver_code varchar [note: 'Foreign key to the driver record designated as the primary operator of this vehicle.']
  primary_use varchar [note: 'Primary use classification of the vehicle: pleasure, commuting, business, farm, or artisan, used in rating and underwriting.']
  prior_carrier_name varchar [note: 'Name of the prior insurance carrier for this vehicle, captured for underwriting and continuity verification.']
  prior_expiration_date date [note: 'Expiration date of the prior policy, used to assess continuity of coverage and lapse risk.']
  prior_policy_number varchar [note: 'Policy number from the prior carrier, used for loss history verification and underwriting.']
  radius_of_operation varchar [note: 'Geographic radius classification for commercial auto: local, intermediate, or long distance, used in commercial auto rating.']
  rate_group varchar [note: 'Carrier-specific rate group classification for the vehicle, used in proprietary rating algorithms.']
  rating_symbol varchar [note: 'ISO rating symbol assigned to the vehicle based on make, model, and year, used in premium calculation.']
  risk_number varchar [note: 'Business identifier for the auto risk unit, often displayed on declarations pages and used in rating.']
  risk_score decimal(5,2) [note: 'Numeric risk score calculated for this auto risk, used in underwriting decisioning and tiering.']
  risk_status varchar [note: 'Current lifecycle status of the auto risk unit within the policy term.']
  safety_feature_code varchar [note: 'Code representing safety features such as airbags, ABS, or electronic stability control, used for rating discounts.']
  stated_value_amount decimal(15,2) [note: 'Agreed or stated value of the vehicle for valuation purposes, used in classic or specialty auto policies.']
  tiv decimal(15,2) [note: 'Total insured value of the auto risk, representing maximum exposure for catastrophe and reinsurance aggregation.']
  underwriting_tier varchar [note: 'Underwriting tier assigned to this auto risk based on risk scoring and eligibility rules.']
  vehicle_ownership varchar [note: 'Ownership status of the vehicle: owned, leased, financed, or hired, relevant for coverage and loss payee requirements.']
  vehicle_use_description varchar [note: 'Free-text description of the vehicles specific use, captured during underwriting for risk assessment.']

  Note: 'Auto-line subtype of insured_risk. One row per auto risk unit. Captures garaging state, primary use, annual mileage, radius of operation, and links to vehicle and driver records for PAP and CA rating.'
}

Table riskexposure.vehicle {
  vehicle_id varchar [pk, note: 'Unique identifier for the vehicle data product (auto-inserted during validation).']
  auto_risk_id varchar [note: 'Foreign key to the parent auto risk record that this vehicle is associated with.']
  garaging_address_id varchar [note: 'Foreign key to the address where the vehicle is primarily garaged. Used for territory rating.']
  policy_term_id varchar [note: 'Foreign key to the policy term under which this vehicle is insured.']
  registered_owner_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Vehicle registered owner (title holder) is distinct from policyholder (auto_risk.party_id). Underwriting and claims require registered owner for lien verification, total loss settlement, and']
  abs_indicator boolean [note: 'Indicates whether the vehicle is equipped with anti-lock braking system. Safety feature for rating.']
  actual_cash_value decimal(15,2) [note: 'Current market value of the vehicle accounting for depreciation. Used for total loss settlements.']
  airbag_count varchar [note: 'Number of airbags installed in the vehicle. Safety feature used for rating.']
  annual_mileage varchar [note: 'Estimated or actual annual miles driven. Key rating variable for exposure calculation.']
  anti_theft_device_indicator boolean [note: 'Indicates whether the vehicle is equipped with an anti-theft device. May qualify for premium discount.']
  anti_theft_device_type varchar [note: 'Type of anti-theft device installed. Used for discount eligibility and rating.']
  body_type varchar [note: 'Body style or configuration of the vehicle used for rating and classification. [ENUM-REF-CANDIDATE: sedan|coupe|suv|truck|van|wagon|convertible|hatchback — 8 candidates stripped; promote to reference product]']
  commute_miles varchar [note: 'One-way commute distance in miles. Used for rating and risk classification.']
  created_timestamp timestamp [note: 'Timestamp when the vehicle record was first created in the system.']
  effective_date date [note: 'Date the vehicle coverage became effective on the policy.']
  engine_size decimal(5,2) [note: 'Engine displacement in liters. Used for vehicle classification and rating.']
  expiration_date date [note: 'Date the vehicle coverage expires or was removed from the policy.']
  fuel_type varchar [note: 'Type of fuel or power source used by the vehicle. May affect rating and eligibility for green vehicle discounts.']
  garaging_zip_code varchar [note: 'ZIP or postal code where the vehicle is primarily garaged. Critical for territory-based rating.']
  gross_vehicle_weight varchar [note: 'Maximum loaded weight of the vehicle in pounds. Used for commercial auto classification.']
  iso_symbol varchar [note: 'ISO vehicle symbol used for rating and premium calculation. Represents vehicle risk classification.']
  license_plate_number varchar [note: 'Current license plate or registration number assigned to the vehicle.']
  license_plate_state varchar [note: 'Two-letter state code where the vehicle is registered.']
  lienholder_name varchar [note: 'Name of the financial institution or party holding a lien on the vehicle.']
  make varchar [note: 'Manufacturer or brand of the vehicle (e.g., Ford, Toyota, Honda).']
  model varchar [note: 'Specific model name or designation of the vehicle (e.g., Camry, F-150, Civic).']
  modified_timestamp timestamp [note: 'Timestamp when the vehicle record was last modified.']
  odometer_reading varchar [note: 'Current odometer reading in miles. Used for valuation and claims verification.']
  odometer_reading_date date [note: 'Date the odometer reading was recorded.']
  ownership_type varchar [note: 'Type of ownership arrangement for the vehicle. Affects loss payee and coverage requirements.']
  purchase_date date [note: 'Date the vehicle was purchased by the current owner.']
  purchase_price decimal(15,2) [note: 'Original purchase price paid for the vehicle.']
  registration_expiration_date date [note: 'Date the vehicle registration expires. Used for compliance verification.']
  safety_rating varchar [note: 'NHTSA or IIHS safety rating for the vehicle. Used for underwriting and rating decisions.']
  salvage_indicator boolean [note: 'Indicates whether the vehicle has a salvage or rebuilt title. Affects underwriting eligibility and valuation.']
  seating_capacity varchar [note: 'Number of passengers the vehicle is designed to carry. Used for liability rating.']
  stated_value decimal(15,2) [note: 'Declared or agreed value of the vehicle for insurance purposes. Used for coverage limits and premium calculation.']
  usage_type varchar [note: 'Primary use classification of the vehicle. Critical rating factor for premium calculation.']
  use_description varchar [note: 'Detailed description of how the vehicle is used. Provides additional context for underwriting and rating.']
  vehicle_status varchar [note: 'Current status of the vehicle on the policy. Tracks lifecycle from addition through removal.']
  vin varchar [note: '17-character Vehicle Identification Number uniquely identifying the vehicle. Used for rating, underwriting, and claims.']
  year varchar [note: 'Model year of the vehicle as designated by the manufacturer.']

  Note: 'Motor vehicle associated with an auto risk. One row per vehicle. Stores VIN, year, make, model, body type, ISO symbol, stated value, anti-theft device indicator, and safety rating for auto rating and claims.'
}

Table riskexposure.driver {
  driver_id varchar [pk, note: 'Unique identifier for the driver data product (auto-inserted during validation).']
  auto_risk_id varchar [note: 'Foreign key to the auto risk this driver is associated with.']
  party_id varchar [note: 'Foreign key to the party record representing this driver as a person.']
  primary_vehicle_id varchar [note: 'Foreign key to the vehicle this driver primarily operates, if applicable.']
  age varchar [note: 'Current age of the driver in years, calculated from date of birth.']
  clue_report_order_date date [note: 'Date the CLUE report was ordered to review the driver prior claim and loss history.']
  clue_report_receipt_date date [note: 'Date the CLUE report was received and available for underwriting review.']
  created_timestamp timestamp [note: 'Timestamp when this driver record was first created in the system.']
  date_of_birth date [note: 'Date of birth of the driver, used for age-based rating and eligibility.']
  defensive_driving_course_date date [note: 'Date the driver completed the defensive driving course, if applicable.']
  defensive_driving_course_indicator boolean [note: 'Indicates whether the driver has completed an approved defensive driving or driver training course.']
  driver_type varchar [note: 'Classification of the driver role on the policy: principal operator, additional driver, excluded driver, or occasional operator.']
  effective_date date [note: 'Date this driver record became effective on the policy or auto risk.']
  excluded_driver_indicator boolean [note: 'Indicates whether this driver has been formally excluded from coverage under the policy by endorsement.']
  excluded_driver_reason varchar [note: 'Reason the driver was excluded from coverage, such as poor driving record, unlicensed, or policyholder request.']
  expiration_date date [note: 'Date this driver record expires or is removed from the policy or auto risk. Null if currently active.']
  gender varchar [note: 'Gender of the driver: M for male, F for female, X for non-binary, U for unknown or not disclosed.']
  good_student_indicator boolean [note: 'Indicates whether the driver qualifies for a good student discount based on academic performance.']
  license_expiration_date date [note: 'Date the driver license expires and must be renewed.']
  license_issue_date date [note: 'Date the driver license was originally issued.']
  license_number varchar [note: 'The driver license number issued by the licensing state or jurisdiction.']
  license_state varchar [note: 'Two-letter state or jurisdiction code where the driver license was issued.']
  license_status varchar [note: 'Current status of the driver license: valid, suspended, revoked, expired, or restricted.']
  marital_status varchar [note: 'Marital status of the driver, used as a rating factor in personal auto underwriting.']
  modified_timestamp timestamp [note: 'Timestamp when this driver record was last modified or updated.']
  mvr_accident_count varchar [note: 'Total number of at-fault accidents recorded on the driver MVR within the underwriting review period.']
  mvr_clean_record_indicator boolean [note: 'Indicates whether the driver has a clean MVR with no violations, accidents, or suspensions in the review period.']
  mvr_dui_indicator boolean [note: 'Indicates whether the driver has a DUI or DWI conviction recorded on the MVR within the review period.']
  mvr_most_recent_violation_date date [note: 'Date of the most recent moving violation recorded on the driver MVR.']
  mvr_order_date date [note: 'Date the Motor Vehicle Record report was ordered from the state DMV or third-party vendor.']
  mvr_receipt_date date [note: 'Date the Motor Vehicle Record report was received and available for underwriting review.']
  mvr_status varchar [note: 'Current status of the MVR report: ordered, received, clean record, violations found, pending review, or error in retrieval.']
  mvr_violation_count varchar [note: 'Total number of moving violations recorded on the driver MVR within the underwriting review period.']
  occupation varchar [note: 'The driver occupation or job title, used as a rating factor in some jurisdictions.']
  occupation_class varchar [note: 'Standardized occupation classification code or category for rating purposes.']
  rating_tier varchar [note: 'Underwriting tier assigned to the driver based on risk profile: preferred, standard, non-standard, or declined.']
  relationship_to_named_insured varchar [note: 'The driver relationship to the named insured on the policy: self, spouse, child, parent, sibling, or other.']
  score decimal(5,2) [note: 'Numeric risk score assigned to the driver based on MVR, CLUE, and other underwriting factors.']
  sr22_expiration_date date [note: 'Date the SR-22 filing requirement expires, if applicable.']
  sr22_filing_date date [note: 'Date the SR-22 certificate was filed with the state, if applicable.']
  sr22_indicator boolean [note: 'Indicates whether an SR-22 certificate of financial responsibility filing is required for this driver.']
  years_licensed varchar [note: 'Number of years the driver has held a valid driver license, used for experience-based rating.']

  Note: 'Licensed operator associated with an auto risk. One row per driver. Captures license number/state, DOB, gender, marital status, years licensed, SR-22 indicator, and MVR order/receipt/status and clean-record fields (absorbed from mvr_report) for auto'
}

Table riskexposure.risk_score {
  risk_score_id varchar [pk, note: 'Unique identifier for the risk_score data product (auto-inserted during validation).']
  insured_risk_id varchar [note: 'Foreign key to the insured risk being scored (property, auto, liability exposure).']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Risk scoring models are LOB-specific (personal auto credit score vs. property hazard model).']
  party_id varchar [note: 'User identifier of the underwriter who performed the manual score override.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Risk scores in P&C are routinely peril-specific — wind scores, flood scores, and earthquake scores are separate model outputs used in underwriting triage and']
  policy_id varchar [note: 'Foreign key to the policy under which this risk is scored.']
  policy_term_id varchar [note: 'Foreign key to the policy term during which this scoring occurred.']
  risk_inspection_id varchar [note: 'Foreign key linking to riskexposure.risk_inspection. Business justification: A risk score is frequently triggered by or derived from an inspection event. Linking risk_score to the risk_inspection that informed it creates a traceable audit chain from']
  underwriting_authority_id varchar [note: 'Foreign key linking to producers.underwriting_authority. Business justification: Risk scores are evaluated against underwriting authority thresholds to trigger referral or auto-bind decisions.']
  acceptable_flag boolean [note: 'Boolean flag indicating whether this risk score falls within acceptable underwriting guidelines.']
  cat_exposure_score decimal(10,4) [note: 'Component score representing catastrophe exposure risk (hurricane, earthquake, flood, wildfire).']
  construction_score decimal(10,4) [note: 'Component score based on construction type, materials, and building characteristics.']
  created_timestamp timestamp [note: 'Timestamp when this risk score record was first created in the system.']
  credit_score decimal(10,4) [note: 'Credit-based insurance score component used in risk evaluation where permitted by regulation.']
  data_quality_score decimal(5,2) [note: 'Percentage score indicating the completeness and quality of input data used in risk scoring.']
  driver_score decimal(10,4) [note: 'Component score for auto risks based on driver characteristics (age, experience, violations, accidents).']
  effective_date date [note: 'Date from which this risk score is effective for underwriting and rating purposes.']
  expiration_date date [note: 'Date when this risk score expires and is no longer valid for underwriting decisions.']
  hazard_score decimal(10,4) [note: 'Component score representing physical hazard factors (construction, occupancy, protection, exposure).']
  loss_history_score decimal(10,4) [note: 'Component score based on prior loss and claims history for this risk or similar risks.']
  model_name varchar [note: 'Name of the risk scoring model or algorithm used to generate this score.']
  model_vendor varchar [note: 'Vendor or provider of the risk scoring model (e.g., ISO, Verisk, internal proprietary).']
  model_version varchar [note: 'Version identifier of the risk scoring model used, enabling tracking of model changes over time.']
  moral_hazard_score decimal(10,4) [note: 'Component score representing moral hazard factors (claims history, fraud indicators, financial stability).']
  occupancy_score decimal(10,4) [note: 'Component score based on occupancy type and usage characteristics of the insured risk.']
  override_flag boolean [note: 'Boolean flag indicating whether the system-generated score was manually overridden by an underwriter.']
  override_reason varchar [note: 'Reason code or description explaining why the risk score was manually overridden.']
  override_timestamp timestamp [note: 'Timestamp when the manual score override was performed.']
  protection_class_score decimal(10,4) [note: 'Component score based on fire protection class and other protective device factors.']
  referral_flag boolean [note: 'Boolean flag indicating whether this risk score triggered an underwriting referral for manual review.']
  referral_reason varchar [note: 'Reason code or description explaining why this risk was referred for underwriting review.']
  score_confidence_level decimal(5,2) [note: 'Statistical confidence level or reliability percentage for the calculated risk score.']
  score_date date [note: 'Date when the risk score was calculated and assigned.']
  score_grade varchar [note: 'Letter grade representation of the risk score for simplified classification and communication.']
  score_notes varchar [note: 'Free-text notes or comments regarding the risk score calculation, exceptions, or special considerations.']
  score_status varchar [note: 'Current status of this risk score record (Active, Superseded, Voided, Archived).']
  score_tier varchar [note: 'Underwriting tier classification based on the risk score (Preferred, Standard, Substandard, Declined).']
  score_timestamp timestamp [note: 'Precise timestamp when the risk score was generated by the rating or underwriting system.']
  score_type varchar [note: 'Type or purpose of the risk score (Underwriting, Renewal, Endorsement, Reunderwriting, Catastrophe, Credit).']
  score_value decimal(10,4) [note: 'Numeric risk score value assigned to the insured risk. Higher values typically indicate higher risk.']
  territory_score decimal(10,4) [note: 'Component score reflecting geographic territory risk factors (crime, weather, loss frequency).']
  threshold_exceeded_flag boolean [note: 'Boolean flag indicating whether the risk score exceeded acceptable underwriting thresholds.']
  threshold_value decimal(10,4) [note: 'The threshold value against which this risk score was compared for acceptance decisions.']
  updated_timestamp timestamp [note: 'Timestamp when this risk score record was last updated or modified.']
  vehicle_score decimal(10,4) [note: 'Component score for auto risks based on vehicle characteristics (make, model, year, safety features).']

  Note: 'Point-in-time risk score attached to an insured risk for exposure grading. One row per scoring event per risk. Stores score value, model version, score date, component scores, and referral threshold flag.'
}

Table riskexposure.risk_inspection {
  risk_inspection_id varchar [pk, note: 'Unique identifier for the risk inspection record. Primary key.']
  auto_risk_id varchar [note: 'Foreign key linking to riskexposure.auto_risk. Business justification: Auto inspections (vehicle condition checks, salvage inspections, appraisals) are conducted against a specific auto_risk unit.']
  building_id varchar [note: 'Foreign key linking to riskexposure.building. Business justification: A physical or virtual inspection targets a specific building on an insured location. Linking risk_inspection to building allows underwriters to associate inspection findings (roof']
  inspector_party_id varchar [note: 'Foreign key to the party (individual or organization) who conducted the inspection.']
  insured_risk_id varchar [note: 'Foreign key to the insured risk being inspected (property, building, vehicle, etc.).']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: A risk inspection is conducted at a specific insured location. risk_inspection carries denormalized address fields (location_address, location_city, location_state']
  ordering_producer_producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Producers order or are notified of property/auto inspections for risks they wrote.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Inspections are ordered for specific peril concerns — wind mitigation inspections, flood elevation certificates, and earthquake retrofit assessments are']
  policy_id varchar [note: 'Foreign key to the policy under which this inspection was conducted.']
  policy_term_id varchar [note: 'Foreign key to the specific policy term during which the inspection occurred.']
  property_risk_id varchar [note: 'Foreign key linking to riskexposure.property_risk. Business justification: A property inspection is directly associated with a property_risk subtype record.']
  completed_date date [note: 'Date the physical or virtual inspection was completed and findings recorded.']
  construction_type varchar [note: 'Construction classification of the inspected building per COPE framework (frame, masonry, fire-resistive, etc.).']
  created_timestamp timestamp [note: 'Timestamp when the inspection record was first created in the system.']
  electrical_condition varchar [note: 'Condition assessment of the electrical system: excellent, good, fair, poor, or hazardous.']
  exposure_description varchar [note: 'Description of external exposures affecting the risk: proximity to other structures, hazards, or environmental factors.']
  fire_protection_present boolean [note: 'Indicates whether fire protection systems (sprinklers, alarms, extinguishers) are present at the location.']
  fire_protection_type varchar [note: 'Type of fire protection system observed: automatic sprinkler, fire alarm, standpipe, extinguishers, or combination.']
  hazards_identified varchar [note: 'Summary of hazards or deficiencies identified during the inspection that may increase loss potential.']
  hvac_condition varchar [note: 'Condition assessment of the heating, ventilation, and air conditioning system.']
  inspection_method varchar [note: 'Method used to conduct the inspection: on-site physical, desktop review, aerial (drone/satellite), virtual (video), or hybrid.']
  inspection_number varchar [note: 'Business identifier for the inspection, often used in correspondence and reporting.']
  inspection_purpose varchar [note: 'Business reason for the inspection: underwriting risk assessment, loss control, compliance verification, valuation, or post-loss evaluation.']
  inspection_report_url varchar [note: 'URL or document reference to the full inspection report stored in the document management system.']
  inspection_status varchar [note: 'Current lifecycle status of the inspection: ordered, scheduled, in progress, completed, cancelled, or deferred.']
  inspection_type varchar [note: 'Category of inspection: new business underwriting, renewal, mid-term endorsement, loss control, compliance, reinspection, catastrophe, or special request. [ENUM-REF-CANDIDATE']
  inspection_vendor varchar [note: 'Name of the third-party inspection service provider, if applicable.']
  notes varchar [note: 'Additional notes or observations recorded by the inspector that do not fit structured fields.']
  occupancy_type varchar [note: 'Primary use or occupancy of the inspected property per COPE framework (residential, commercial, industrial, etc.).']
  ordered_date date [note: 'Date the inspection was requested or ordered by underwriting or claims.']
  overall_condition varchar [note: 'Inspector\'s overall assessment of the risk condition: excellent, good, fair, poor, or unacceptable.']
  photos_count varchar [note: 'Number of photographs taken during the inspection and attached to the report.']
  plumbing_condition varchar [note: 'Condition assessment of the plumbing system: excellent, good, fair, poor, or hazardous.']
  protection_class varchar [note: 'Fire protection classification code (ISO PPC or similar) indicating proximity to fire services and water supply.']
  recommendations varchar [note: 'Inspector\'s recommendations for risk improvement, hazard mitigation, or underwriting action.']
  roof_age_years varchar [note: 'Estimated age of the roof in years since installation or last replacement.']
  roof_condition varchar [note: 'Condition assessment of the roof: excellent, good, fair, poor, or needs replacement.']
  roof_type varchar [note: 'Type of roofing material observed: asphalt shingle, metal, tile, flat membrane, etc.']
  scheduled_date date [note: 'Date the inspection appointment was scheduled with the insured or property contact.']
  security_system_present boolean [note: 'Indicates whether security systems (burglar alarm, surveillance, access control) are present at the location.']
  underwriting_action varchar [note: 'Recommended underwriting action based on inspection findings: accept, accept with conditions, decline, refer, or request reinspection.']
  updated_timestamp timestamp [note: 'Timestamp when the inspection record was last modified.']
  valuation_currency varchar [note: 'Three-letter ISO currency code for the valuation estimate.']
  valuation_estimate decimal(15,2) [note: 'Inspector\'s estimated replacement cost or insurable value of the property, if applicable.']

  Note: 'Physical or virtual inspection of an insured risk that produces exposure facts of record (condition, hazards, valuation checks). One row per inspection. Stores inspection type, ordered/completed dates, inspector party, findings summary, and recommendation'
}

Table claims.loss_event {
  loss_event_id varchar [pk, note: 'Unique identifier for the loss event occurrence. Primary key.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Loss events are aggregated by accident year and fiscal period for catastrophe exposure reporting, reinsurance treaty reinstatement calculations, and NAIC CAT reporting.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Zone-level loss accumulation reporting groups loss events by cat zone to compare against accumulation limits and reinsurance attachment points.']
  catastrophe_event_id varchar [note: 'Foreign key to the catastrophe event if this loss is part of a declared catastrophe.']
  currency_id varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts associated with this loss event.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Loss event geocoding links the loss location to the geographic hierarchy for territory-level loss ratio reporting, regulatory state filings, and catastrophe exposure']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Normalizes the peril that caused the loss event, enabling peril-level loss aggregation across events for cat modeling input and reinsurance treaty peril']
  cat_serial_number varchar [note: 'Industry-standard catastrophe serial number assigned by ISO or PCS for declared catastrophe events.']
  closed_date date [note: 'Date when the loss event was closed and all associated claims were finalized.']
  created_timestamp timestamp [note: 'System timestamp when this loss event record was first created in the claims management system.']
  estimated_total_loss_amount decimal(15,2) [note: 'Initial estimated total financial impact of the loss event across all affected claims and coverages.']
  fatality_occurred boolean [note: 'Indicates whether a fatality occurred as part of this loss event, requiring special handling and reporting.']
  fire_department_notified boolean [note: 'Indicates whether the fire department was notified and responded to this loss event.']
  fire_report_number varchar [note: 'Official fire department report number or incident number for fire-related losses.']
  fraud_indicator boolean [note: 'Indicates whether this loss event has been flagged for potential fraud investigation by SIU.']
  injury_occurred boolean [note: 'Indicates whether bodily injury occurred as part of this loss event, triggering liability and medical coverage.']
  is_catastrophe_loss boolean [note: 'Indicates whether this loss event is part of a declared catastrophe event for aggregation and reinsurance purposes.']
  is_large_loss boolean [note: 'Indicates whether this loss exceeds the threshold for large loss reporting and special handling.']
  large_loss_threshold_amount decimal(15,2) [note: 'Monetary threshold amount that defines a large loss for this event, used for reinsurance and escalation.']
  loss_complexity_code varchar [note: 'Classification of the loss event by complexity, used for adjuster assignment and workflow routing.']
  loss_description varchar [note: 'Narrative description of the loss event, including circumstances, cause, and extent of damage or injury.']
  loss_discovery_date date [note: 'Date when the loss was first discovered or became known to the insured or insurer.']
  loss_event_status varchar [note: 'Current lifecycle state of the loss event in the claims workflow.']
  loss_event_type varchar [note: 'Classification of the physical loss occurrence by peril or cause of loss. [ENUM-REF-CANDIDATE: fire|water_damage|wind|hail|theft|vandalism|collision|liability|weather|flood|earthquake|explosion|other — 13 candidates stripped; promote to reference product]']
  loss_location_address varchar [note: 'Street address where the loss event occurred. Used for catastrophe aggregation and geographic analysis.']
  loss_location_city varchar [note: 'City where the loss event occurred.']
  loss_location_country varchar [note: 'Three-letter ISO country code where the loss event occurred.']
  loss_location_latitude decimal(10,7) [note: 'Geographic latitude coordinate of the loss location, used for catastrophe modeling and spatial analysis.']
  loss_location_longitude decimal(10,7) [note: 'Geographic longitude coordinate of the loss location, used for catastrophe modeling and spatial analysis.']
  loss_location_postal_code varchar [note: 'Postal or ZIP code of the loss location, used for geocoding and catastrophe zone assignment.']
  loss_location_state varchar [note: 'State or province where the loss event occurred. Critical for regulatory reporting and territorial analysis.']
  loss_occurrence_date date [note: 'The calendar date on which the physical loss event occurred. Critical for policy coverage determination and loss reserving.']
  loss_occurrence_timestamp timestamp [note: 'Precise date and time when the loss event occurred, used for detailed event sequencing and catastrophe modeling.']
  loss_reported_date date [note: 'Date when the loss was formally reported to the insurer, triggering First Notice of Loss (FNOL) processing.']
  loss_severity_code varchar [note: 'Classification of the loss event by severity level, used for triage and resource allocation.']
  notes varchar [note: 'Additional notes, comments, or observations about the loss event for internal use.']
  number varchar [note: 'Business identifier for the loss event, externally visible and used for tracking and reporting.']
  number_of_fatalities varchar [note: 'Count of fatalities resulting from this loss event.']
  number_of_injuries varchar [note: 'Count of individuals injured in this loss event.']
  police_report_filed boolean [note: 'Indicates whether a police report was filed for this loss event, relevant for theft, vandalism, and liability claims.']
  police_report_number varchar [note: 'Official police report number or case number associated with this loss event.']
  reopened_date date [note: 'Date when a previously closed loss event was reopened for additional investigation or claims processing.']
  salvage_potential boolean [note: 'Indicates whether damaged property from this loss event has salvage value that can be recovered.']
  siu_referral_date date [note: 'Date when this loss event was referred to the Special Investigation Unit for fraud investigation.']
  subrogation_potential boolean [note: 'Indicates whether this loss event has potential for subrogation recovery from a responsible third party.']
  third_party_involved boolean [note: 'Indicates whether a third party is involved in this loss event, triggering liability investigation.']
  updated_timestamp timestamp [note: 'System timestamp when this loss event record was last modified.']
  weather_condition varchar [note: 'Description of weather conditions at the time of loss, relevant for weather-related perils.']

  Note: 'Master record of a physical loss occurrence (storm, fire, collision, liability event). One row per occurrence. Links multiple claims arising from the same event. Supports CAT aggregation and PML analysis.'
}

Table claims.claim {
  claim_id varchar [pk, note: 'Unique identifier for the claim. Primary key. Grain: one row per reported loss.']
  agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Agency-level loss ratio monitoring, contingent commission calculation, and regulatory claim reporting all require direct claim-to-agency attribution.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Claims must be aligned to accident year, policy year, and report year periods for NAIC Schedule P loss development triangles and IBNR actuarial analysis.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Cat zone assignment on a claim drives reinsurance treaty attachment determination and bordereaux reporting.']
  catastrophe_event_id varchar [note: 'Foreign key to the catastrophe event if this claim is CAT-related.']
  claim_adjuster_party_id varchar [note: 'Foreign key to the party record of the assigned adjuster.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Claim payments, reserves, and incurred amounts are monetary values requiring currency context for multi-currency insurer operations, GAAP/IFRS17 reporting, and reinsurance settlement.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Links claim loss location to the geography master for territory-level loss ratio reporting, state regulatory filings, and geographic concentration analysis.']
  insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Claims adjusters review underwriting risk scores for SIU referral decisions, subrogation potential assessment, and fraud pattern analysis.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Normalize lob_code string to FK reference to shared.line_of_business master data. Claim currently stores lob_code as string; replacing with FK enables consistent LOB classification']
  location_id varchar [note: 'Foreign key linking to riskexposure.location. Business justification: Pre-bind inspection reports establish baseline property condition for damage assessment, fraud detection, and pre-existing damage disputes.']
  loss_event_id varchar [note: 'Foreign key to the loss event that triggered this claim.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Normalizes peril classification on claims, replacing denormalized peril_code and peril_description.']
  policy_id varchar [note: 'Foreign key to the policy under which this claim was filed.']
  policy_term_id varchar [note: 'Foreign key to the specific policy term in force at the time of loss.']
  primary_claimant_party_id varchar [note: 'Foreign key to the party record of the primary claimant.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Tracks producer/agent of record at time of loss for commission clawback calculations, producer loss ratio reporting, E&O exposure analysis, and regulatory claim-to-producer']
  ri_agreement_id varchar [note: 'Foreign key to the reinsurance agreement applicable to this claim.']
  risk_score_id varchar [note: 'Foreign key linking to riskexposure.risk_score. Business justification: Fraud analytics and reserve adequacy — linking the underwriting risk score at policy bind to the resulting claim enables predictive model validation, SIU referral scoring, and']
  uw_decision_id varchar [note: 'Foreign key linking to coverage.uw_decision. Business justification: Underwriting decisions (referrals, conditions, exclusions, modified terms) are reviewed during claims for coverage interpretation, exclusion enforcement, and bad faith litigation']
  accident_year varchar [note: 'Calendar year in which the loss occurred, used for actuarial reserving and loss development.']
  adjuster_type varchar [note: 'Type of adjuster assigned to the claim.']
  catastrophe_flag boolean [note: 'Indicates whether this claim is associated with a catastrophe event.']
  claim_status varchar [note: 'Current lifecycle status of the claim.']
  claimant_type varchar [note: 'Indicates whether the claimant is a first-party or third-party claimant.']
  close_date date [note: 'Date when the claim was closed or finalized.']
  created_timestamp timestamp [note: 'Timestamp when this claim record was first created in the system.']
  fnol_date date [note: 'Date when the claim was first reported to the insurer.']
  fnol_timestamp timestamp [note: 'Precise timestamp when the claim was first reported to the insurer.']
  iso_cat_serial_number varchar [note: 'ISO-assigned serial number for the catastrophe event.']
  litigation_date date [note: 'Date when litigation was initiated for this claim.']
  litigation_flag boolean [note: 'Indicates whether this claim is in litigation or has legal representation involved.']
  loss_date date [note: 'Date when the loss or accident occurred.']
  loss_description varchar [note: 'Detailed narrative description of the loss event and circumstances.']
  loss_location_address varchar [note: 'Street address where the loss occurred.']
  loss_location_city varchar [note: 'City where the loss occurred.']
  loss_location_country varchar [note: 'Country where the loss occurred, using 3-letter ISO code.']
  loss_location_postal_code varchar [note: 'Postal or ZIP code where the loss occurred.']
  loss_location_state varchar [note: 'State or province where the loss occurred.']
  loss_time timestamp [note: 'Precise time when the loss or accident occurred, if known.']
  number varchar [note: 'Externally-known unique claim number assigned by the insurer for tracking and reference.']
  policy_year varchar [note: 'Policy year in which the loss occurred, used for policy-year loss analysis.']
  reinsurance_flag boolean [note: 'Indicates whether this claim is subject to reinsurance cession.']
  reopen_date date [note: 'Date when the claim was reopened after being previously closed.']
  report_date date [note: 'Date when the claim was formally recorded in the claims system.']
  report_year varchar [note: 'Calendar year in which the claim was reported.']
  salvage_flag boolean [note: 'Indicates whether salvage recovery is applicable for this claim.']
  siu_flag boolean [note: 'Indicates whether this claim has been referred to the Special Investigations Unit for fraud investigation.']
  siu_referral_date date [note: 'Date when the claim was referred to SIU.']
  status_reason varchar [note: 'Reason or explanation for the current claim status.']
  subrogation_flag boolean [note: 'Indicates whether subrogation is being pursued for this claim.']
  updated_timestamp timestamp [note: 'Timestamp when this claim record was last modified.']

  Note: 'Core claim record. Grain: one row per reported loss. Captures FNOL intake, line of business, accident date, report date, status, and FK links to policy, loss_event, and reinsurance cession keys for recovery linkage.'
}

Table claims.claimant {
  claimant_id varchar [pk, note: 'Unique identifier for the claimant record. Grain: one row per party per claim.']
  claim_id varchar [note: 'Foreign key to the parent claim this claimant is associated with.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: settlement_demand_amount and settlement_offer_amount on claimant are monetary; currency FK is required for multi-currency claim settlement operations and accurate financial reporting of']
  mailing_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Claims correspondence, settlement checks, and legal notices require a verified, standardized claimant address.']
  party_id varchar [note: 'Foreign key to the party master record representing this claimant.']
  attorney_contact_email varchar [note: 'Primary email address for the claimant\'s attorney or law firm.']
  attorney_contact_phone varchar [note: 'Primary contact phone number for the claimant\'s attorney or law firm.']
  attorney_name varchar [note: 'Full name of the attorney or law firm representing the claimant, if applicable.']
  claimant_status varchar [note: 'Current lifecycle status of the claimant within the claim: active, closed, withdrawn, settled, denied, or pending investigation.']
  claimant_type varchar [note: 'Classification of the claimant role: first-party insured, third-party claimant, additional insured, named insured, or other.']
  contact_preference varchar [note: 'Preferred method of communication for the claimant: email, phone, mail, SMS, or online portal.']
  created_timestamp timestamp [note: 'Timestamp when the claimant record was first created in the claims system.']
  date_of_death date [note: 'Date of death if the claimant died as a result of the loss event. Null if claimant is alive.']
  date_of_injury date [note: 'The specific date on which the claimant sustained the injury or damage, which may differ from the loss event date in some cases.']
  fault_indicator boolean [note: 'Boolean flag indicating whether the claimant is determined to be at fault in the loss event. True if at fault, False otherwise.']
  fraud_indicator_flag boolean [note: 'Boolean flag indicating whether fraud indicators or red flags have been identified for this claimant. True if indicators present, False otherwise.']
  guardian_contact_phone varchar [note: 'Primary contact phone number for the claimant\'s legal guardian or parent.']
  guardian_name varchar [note: 'Full name of the legal guardian or parent if the claimant is a minor or legally incapacitated.']
  hospital_name varchar [note: 'Name of the hospital or medical facility where the claimant received treatment, if applicable.']
  hospitalization_flag boolean [note: 'Boolean flag indicating whether the claimant was hospitalized as a result of the loss event. True if hospitalized, False otherwise.']
  injury_description varchar [note: 'Detailed narrative description of the injury or damage sustained by the claimant, as reported during First Notice of Loss (FNOL) or investigation.']
  injury_severity_code varchar [note: 'Standardized severity classification of the injury: minor, moderate, major, catastrophic, or fatal.']
  injury_type varchar [note: 'Type of injury or damage sustained by the claimant: bodily injury, property damage, both, or none.']
  last_modified_timestamp timestamp [note: 'Timestamp when the claimant record was last updated or modified in the claims system.']
  liability_percentage decimal(5,2) [note: 'Percentage of liability attributed to this claimant in comparative negligence or contributory negligence scenarios, ranging from 0.00 to 100.00.']
  medical_treatment_required_flag boolean [note: 'Boolean flag indicating whether the claimant required or is receiving medical treatment for injuries sustained. True if treatment required, False otherwise.']
  minor_flag boolean [note: 'Boolean flag indicating whether the claimant is a minor (under 18 years of age). True if minor, False otherwise.']
  notes varchar [note: 'Free-form text field for adjuster notes, observations, and additional context regarding the claimant and their involvement in the claim.']
  number varchar [note: 'Business-facing unique identifier for the claimant within the claim, often displayed on correspondence and documents.']
  primary_contact_email varchar [note: 'Primary email address to reach the claimant for claim-related communications.']
  primary_contact_phone varchar [note: 'Primary phone number to reach the claimant for claim-related communications.']
  relationship_to_insured varchar [note: 'Describes the claimant\'s relationship to the named insured: self, spouse, child, parent, other relative, employee, passenger, pedestrian, or other. [ENUM-REF-CANDIDATE: self|spouse|child|parent|other_relative|employee|passenger|pedestrian|other — 9']
  release_signed_date date [note: 'Date on which the claimant signed the legal release document.']
  release_signed_flag boolean [note: 'Boolean flag indicating whether the claimant has signed a legal release waiving further claims. True if signed, False otherwise.']
  represented_by_attorney_flag boolean [note: 'Boolean flag indicating whether the claimant is represented by legal counsel. True if represented, False otherwise.']
  settlement_date date [note: 'Date on which the claimant\'s portion of the claim was settled and agreed upon by all parties.']
  settlement_demand_amount decimal(15,2) [note: 'The monetary amount demanded by the claimant or their attorney for settlement of the claim.']
  settlement_offer_amount decimal(15,2) [note: 'The monetary amount offered by the insurer to settle the claimant\'s portion of the claim.']
  siu_referral_date date [note: 'Date on which the claimant was referred to the Special Investigation Unit for fraud investigation.']
  siu_referral_flag boolean [note: 'Boolean flag indicating whether this claimant has been referred to the Special Investigation Unit for fraud investigation. True if referred, False otherwise.']
  subrogation_potential_flag boolean [note: 'Boolean flag indicating whether this claimant presents potential for subrogation recovery. True if potential exists, False otherwise.']
  treating_physician_name varchar [note: 'Full name of the primary physician treating the claimant for injuries sustained in the loss event.']

  Note: 'Party involved in a claim as first-party insured or third-party claimant. Grain: one row per party per claim. Captures claimant type (FP/TP), injury or damage description, and links to Party domain.'
}

Table claims.claim_exposure {
  claim_exposure_id varchar [pk, note: 'Unique identifier for the claim exposure. Primary key. Grain: one row per coverage per claim.']
  adjuster_id varchar [note: 'Foreign key to the adjuster assigned to handle this exposure.']
  building_id varchar [note: 'Foreign key linking to riskexposure.building. Business justification: Property claims adjustment — repair scopes, replacement cost verification, and construction-type coverage checks require the specific building per exposure.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Cat zone at the exposure level is required for reinsurance cession calculation and treaty bordereau reporting at per-coverage granularity.']
  catastrophe_event_id varchar [note: 'Foreign key to the catastrophe event if this exposure is CAT-related. Nullable for non-CAT exposures.']
  claim_id varchar [note: 'Foreign key to the parent claim. Links this exposure to the reported loss event.']
  claimant_id varchar [note: 'Foreign key to the claimant (first party or third party) associated with this exposure.']
  coverage_id varchar [note: 'Foreign key to the coverage under which this exposure is being claimed.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: claim_exposure carries incurred_amount, paid_amount, lae_paid_amount, outstanding_reserve_amount — all monetary.']
  driver_id varchar [note: 'Foreign key linking to riskexposure.driver. Business justification: Auto liability/BI/PD claims — excluded-driver coverage verification, subrogation eligibility, and MVR review at claim time require identifying the specific driver per exposure.']
  insured_risk_id varchar [note: 'Foreign key to the insured risk (property, vehicle, driver) that suffered the loss.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Claim exposure is the grain for NAIC Schedule P loss development triangles, which are organized by line of business.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Claim exposures track coverage_type and loss_cause but lack FK to peril master. Underwriters and actuaries need peril attributes (cat_peril flag, severity classification']
  policy_term_id varchar [note: 'Foreign key to the policy term in force at the loss date. Enables effective-dated coverage reconstruction.']
  vehicle_id varchar [note: 'Foreign key linking to riskexposure.vehicle. Business justification: Auto claims processing — total-loss evaluation, salvage disposition, and rental initiation require the specific vehicle per coverage exposure.']
  accident_year varchar [note: 'Calendar year in which the loss occurred. Derived from loss_date for actuarial and statutory reporting.']
  catastrophe_flag boolean [note: 'True if this exposure is part of a declared catastrophe event. Drives CAT reporting and reinsurance recovery.']
  claim_party_role varchar [note: 'Indicates whether the claimant is a first party (insured) or third party (external claimant).']
  closed_date date [note: 'Date the exposure was closed. Nullable until closure. Used for settlement lag and closure rate analytics.']
  coverage_limit_amount decimal(18,2) [note: 'Maximum amount payable under this coverage for this exposure. Denormalized from coverage for financial posting efficiency.']
  coverage_type varchar [note: 'Type of coverage under which the exposure is claimed (e.g., Property Damage, Bodily Injury, Collision, Comprehensive, Liability).']
  created_timestamp timestamp [note: 'Timestamp when this exposure record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'Deductible applicable to this exposure. Denormalized from coverage for payment calculation efficiency.']
  denial_reason varchar [note: 'Reason for denial if the exposure was denied. Nullable if not denied.']
  exposure_description varchar [note: 'Narrative description of the exposure, including nature of injury or damage and circumstances.']
  exposure_number varchar [note: 'Business identifier for the exposure, often a concatenation of claim number and coverage line sequence.']
  exposure_status varchar [note: 'Current lifecycle status of the claim exposure. Drives workflow and financial posting rules.']
  fraud_flag boolean [note: 'True if this exposure has been flagged for potential fraud by SIU or fraud detection systems.']
  incurred_amount decimal(18,2) [note: 'Total incurred loss for this exposure (paid + outstanding reserves). Snapshot value for reporting.']
  lae_paid_amount decimal(18,2) [note: 'Total allocated loss adjustment expense paid to date on this exposure.']
  lae_reserve_amount decimal(18,2) [note: 'Current outstanding allocated loss adjustment expense reserve for this exposure.']
  liability_indicator boolean [note: 'True if this exposure involves liability coverage; false for property or other first-party coverages.']
  litigation_flag boolean [note: 'True if this exposure is in litigation or has legal representation involved.']
  loss_cause varchar [note: 'Peril or cause of loss for this exposure (e.g., Fire, Theft, Collision, Wind, Hail, Water Damage, Vandalism).']
  loss_date date [note: 'Date the loss occurred. Critical for policy term lookup, reserving, and accident year reporting.']
  outstanding_reserve_amount decimal(18,2) [note: 'Current outstanding case reserve for this exposure. Snapshot value for reporting.']
  paid_amount decimal(18,2) [note: 'Total amount paid to date on this exposure. Snapshot value for reporting.']
  recovery_amount decimal(18,2) [note: 'Total recoveries received to date (subrogation, salvage, reinsurance). Snapshot value for reporting.']
  reinsurance_ceded_flag boolean [note: 'True if this exposure has been ceded to reinsurance under treaty or facultative agreements.']
  reopened_date date [note: 'Date the exposure was reopened after initial closure. Nullable if never reopened.']
  report_year varchar [note: 'Calendar year in which the exposure was first reported. Derived from reported_date for lag analysis.']
  reported_date date [note: 'Date the exposure was first reported to the insurer. Used for IBNR lag analysis and reporting year assignment.']
  salvage_potential_flag boolean [note: 'True if the exposure has potential for salvage recovery (e.g., damaged vehicle or property).']
  settlement_type varchar [note: 'Type of settlement reached for this exposure. Nullable until settled.']
  siu_referral_date date [note: 'Date the exposure was referred to SIU for fraud investigation. Nullable if not referred.']
  subrogation_potential_flag boolean [note: 'True if the exposure has potential for subrogation recovery from a third party.']
  updated_timestamp timestamp [note: 'Timestamp when this exposure record was last modified.']

  Note: 'Coverage line within a claim. Grain: one row per coverage per claim. Junction between Claim and Coverage/Insured Risk. Drives all financial postings; prevents fan-out double-counting of reserves and payments.'
}

Table claims.claim_status {
  claim_status_id varchar [pk, note: 'Unique identifier for each claim status transition record. Primary key.']
  adjuster_id varchar [note: 'Foreign key to the adjuster assigned to the claim at the time of this status transition.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: claim_status snapshots reserve_amount, paid_amount, and incurred_amount at a point in time.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: claim_status records reserve_amount, paid_amount, and incurred_amount as financial snapshots.']
  primary_status_claim_id varchar [note: 'Foreign key to the parent claim for which this status transition applies.']
  approval_required_flag boolean [note: 'Indicates whether supervisory or management approval is required for this status transition per authority limits.']
  approval_timestamp timestamp [note: 'Date and time when the status transition was approved by authorized personnel, nullable if no approval required.']
  approved_by_user_code varchar [note: 'System identifier of the supervisor or manager who approved this status transition, nullable if no approval required.']
  approved_by_user_name varchar [note: 'Full name of the supervisor or manager who approved this status transition, for audit trail purposes.']
  cat_serial_number varchar [note: 'ISO catastrophe serial number linking this claim to a specific catastrophe event, nullable if not CAT-related.']
  catastrophe_flag boolean [note: 'Indicates whether this claim is associated with a declared catastrophe event at this status point.']
  closure_type_code varchar [note: 'Classification of how the claim was closed, applicable only when status is CLOSED. Supports loss ratio and settlement analytics.']
  created_timestamp timestamp [note: 'Date and time when this status transition record was first created in the source system.']
  effective_timestamp timestamp [note: 'Date and time when this status became effective, supporting point-in-time queries and regulatory reporting.']
  expiration_timestamp timestamp [note: 'Date and time when this status ceased to be effective, nullable for current status. Enables temporal queries.']
  fraud_investigation_flag boolean [note: 'Indicates whether the claim is under fraud investigation by Special Investigations Unit at this status point.']
  incurred_amount decimal(18,2) [note: 'Total incurred loss amount at this status point, calculated as paid plus outstanding reserves.']
  is_current_status boolean [note: 'Boolean flag indicating whether this is the current active status for the claim. True for latest, false for historical.']
  last_modified_timestamp timestamp [note: 'Date and time when this status transition record was last updated in the source system.']
  litigation_flag boolean [note: 'Indicates whether the claim is in litigation at this status point. True if litigated, false otherwise.']
  litigation_start_date date [note: 'Date when litigation commenced for this claim, nullable if not litigated. Supports legal expense tracking.']
  paid_amount decimal(18,2) [note: 'Cumulative amount paid on the claim as of this status transition, in policy currency.']
  previous_status_code varchar [note: 'Status code immediately prior to this transition, enabling lifecycle reconstruction and audit trail.']
  reopen_count varchar [note: 'Cumulative number of times the claim has been reopened as of this status transition, indicating claim complexity.']
  reserve_amount decimal(18,2) [note: 'Total case reserve amount held for the claim at the time of this status transition, in policy currency.']
  siu_referral_date date [note: 'Date when the claim was referred to SIU for fraud investigation, nullable if not referred.']
  status_code varchar [note: 'Current lifecycle status of the claim at this transition point.']
  status_duration_days varchar [note: 'Number of calendar days the claim remained in this status, calculated for cycle time and performance analytics.']
  status_notes varchar [note: 'Free-text notes or comments recorded by the adjuster or system at the time of status transition, supporting claim documentation.']
  status_reason_code varchar [note: 'Coded reason explaining why the status transition occurred, aligned with business rules and regulatory requirements.']
  status_reason_description varchar [note: 'Detailed narrative explanation of the reason for the status change, supporting audit and regulatory review.']
  status_set_by_user_code varchar [note: 'System identifier of the user or automated process that triggered this status transition.']
  status_set_by_user_name varchar [note: 'Full name of the user who set this status, supporting audit and accountability requirements.']
  subrogation_flag boolean [note: 'Indicates whether subrogation is being pursued at this status point. True if subrogation active, false otherwise.']
  system_source_code varchar [note: 'Code identifying the source system that recorded this status transition, supporting multi-system integration and data lineage.']
  workflow_step_code varchar [note: 'Code representing the workflow step or stage in the claims process at this status transition.']
  workflow_step_name varchar [note: 'Human-readable name of the workflow step or stage in the claims adjudication process.']

  Note: 'Lifecycle status history for a claim. Grain: one row per status transition per claim. Tracks Open, Pending, Closed, Reopened, Denied, Litigated transitions with effective timestamps and reason codes.'
}

Table claims.adjuster {
  adjuster_id varchar [pk, note: 'Unique identifier for the adjuster record. Primary key.']
  license_id varchar [note: 'Foreign key linking to party.license. Business justification: Adjuster licensing compliance is a state-mandated regulatory requirement. Linking adjuster to party.license enables license expiry monitoring, multi-state authorization checks, and DOI audit']
  party_id varchar [note: 'Reference to the party master record for this adjuster\'s identity and contact information.']
  supervisor_adjuster_id varchar [note: 'Reference to the supervising adjuster or claims manager overseeing this adjuster\'s work.']
  adjuster_status varchar [note: 'Current operational status of the adjuster indicating availability for claim assignments.']
  adjuster_type varchar [note: 'Classification of adjuster employment relationship: staff employee, independent contractor, third-party administrator, catastrophe specialist, or public adjuster.']
  background_check_date date [note: 'Date the most recent background check was completed for the adjuster.']
  background_check_status varchar [note: 'Result status of the most recent background check.']
  catastrophe_qualified_flag boolean [note: 'Indicates whether the adjuster is qualified and available for catastrophe event deployments.']
  certification_designations varchar [note: 'Professional certifications held by the adjuster such as AIC, CPCU, SCLA, or other industry designations.']
  created_timestamp timestamp [note: 'Timestamp when this adjuster record was first created in the system.']
  current_caseload_count varchar [note: 'Number of open claims currently assigned to the adjuster.']
  effective_date date [note: 'Date this adjuster record became effective for claim assignments.']
  expiration_date date [note: 'Date this adjuster record expires or was superseded. Null if currently active.']
  field_adjuster_flag boolean [note: 'Indicates whether the adjuster conducts on-site field inspections versus desk-only adjusting.']
  hire_date date [note: 'Date the adjuster was hired or contracted by the insurer or TPA.']
  home_office_location varchar [note: 'Primary office or geographic location where the adjuster is based.']
  language_skills varchar [note: 'Comma-separated list of languages the adjuster is fluent in for claimant communication.']
  last_performance_review_date date [note: 'Date of the most recent formal performance review.']
  last_updated_timestamp timestamp [note: 'Timestamp when this adjuster record was most recently modified.']
  max_caseload_capacity varchar [note: 'Maximum number of concurrent claims the adjuster can handle based on workload management policies.']
  max_claim_authority decimal(15,2) [note: 'Maximum dollar amount the adjuster is authorized to settle without supervisory approval.']
  multi_state_licensed_flag boolean [note: 'Indicates whether the adjuster holds licenses in multiple states.']
  notes varchar [note: 'Free-text notes capturing additional information about the adjuster\'s skills, restrictions, or special circumstances.']
  npn varchar [note: 'National Producer Number assigned by NIPR if the adjuster also holds producer licensing.']
  number varchar [note: 'Business identifier assigned to the adjuster by the insurer or TPA.']
  performance_rating varchar [note: 'Most recent performance evaluation rating for the adjuster.']
  service_territory varchar [note: 'Geographic territory or region the adjuster is assigned to cover for claim investigations.']
  specialty_lines varchar [note: 'Comma-separated list of insurance lines the adjuster specializes in handling, such as property, auto, liability, workers compensation.']
  termination_date date [note: 'Date the adjuster\'s employment or contract ended. Null if currently active.']
  vendor_company_name varchar [note: 'Name of the independent adjusting firm or TPA if the adjuster is not a staff employee.']
  vendor_contract_number varchar [note: 'Contract identifier for independent or TPA adjusters linking to the vendor agreement.']
  years_experience varchar [note: 'Total years of claims adjusting experience across all employers.']

  Note: 'Staff or independent adjuster assigned to handle claims. Captures adjuster type (staff/IA/TPA), license number, state appointments, assignment capacity, and links to Party domain for identity.'
}

Table claims.adjuster_assignment {
  adjuster_assignment_id varchar [pk, note: 'Unique identifier for the adjuster assignment record. Primary key.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Cat deployment planning tracks adjuster assignments by cat zone to manage capacity, SLA compliance, and surge staffing during catastrophe events.']
  catastrophe_event_id varchar [note: 'The catastrophe event this assignment is associated with, if applicable. Null for non-catastrophe claims.']
  claim_exposure_id varchar [note: 'The specific claim exposure (coverage line) to which the adjuster is assigned. Nullable if assignment is at claim level.']
  claim_id varchar [note: 'The claim to which the adjuster is assigned.']
  primary_adjuster_id varchar [note: 'The adjuster assigned to handle the claim or exposure.']
  assigned_by_user_code varchar [note: 'The system user or supervisor who made the assignment. Null for automatic assignments.']
  assignment_authority_level varchar [note: 'The level of authority the adjuster has in this assignment: full settlement authority, limited, or advisory only.']
  assignment_date date [note: 'The date the adjuster was assigned to the claim or exposure.']
  assignment_method varchar [note: 'The method used to assign the adjuster: automatic routing, manual selection, or rule-based assignment.']
  assignment_notes varchar [note: 'Free-text notes or instructions provided at the time of assignment, such as special handling requirements or context.']
  assignment_number varchar [note: 'Business identifier for the assignment, often used in workflow systems and correspondence.']
  assignment_role varchar [note: 'The role the adjuster plays in this assignment: primary handler, supervisor, specialist, or support. [ENUM-REF-CANDIDATE: primary|secondary|supervisor|desk|field|independent|catastrophe|specialist — 8 candidates stripped; promote to reference product]']
  assignment_source_system varchar [note: 'The system that originated this assignment record: ClaimCenter, legacy system, or external vendor platform.']
  assignment_source_system_code varchar [note: 'The unique identifier for this assignment in the source system, used for reconciliation and traceability.']
  assignment_status varchar [note: 'Current lifecycle status of the adjuster assignment. [ENUM-REF-CANDIDATE: assigned|active|suspended|completed|closed|reassigned|withdrawn — 7 candidates stripped; promote to reference product]']
  assignment_timestamp timestamp [note: 'The precise date and time the assignment was created in the system.']
  assignment_type varchar [note: 'The nature of the assignment: initial assignment, reassignment, escalation, or specialist referral.']
  completion_date date [note: 'The date the adjuster completed their work on the assignment.']
  created_timestamp timestamp [note: 'The date and time this assignment record was first created in the data warehouse.']
  effective_date date [note: 'The date from which the adjuster assignment becomes active and the adjuster assumes responsibility.']
  expected_completion_date date [note: 'The target date by which the adjuster is expected to complete their work on this assignment.']
  expiration_date date [note: 'The date the assignment ends or is superseded. Null for open assignments.']
  geographic_territory varchar [note: 'The geographic territory or region this assignment covers, relevant for field adjusters.']
  is_active boolean [note: 'Indicates whether this assignment is currently active. False for completed, closed, or superseded assignments.']
  is_primary_adjuster boolean [note: 'Indicates whether this adjuster is the primary handler for the claim or exposure. True for primary, false for secondary or support roles.']
  is_supervisor_assignment boolean [note: 'Indicates whether this is a supervisory assignment for oversight and quality review rather than primary handling.']
  last_modified_timestamp timestamp [note: 'The date and time this assignment record was last updated in the data warehouse.']
  priority_level varchar [note: 'The priority assigned to this claim assignment, influencing adjuster workflow and response time.']
  reassignment_reason_code varchar [note: 'Standardized code indicating why the claim was reassigned from a previous adjuster.']
  reassignment_reason_description varchar [note: 'Detailed explanation of why the assignment was transferred to this adjuster.']
  reserve_authority_limit decimal(15,2) [note: 'The maximum reserve amount the adjuster can set without supervisor approval for this assignment.']
  service_level_agreement_days varchar [note: 'The number of days within which the adjuster must take initial action or complete key milestones per service level agreement.']
  settlement_authority_limit decimal(15,2) [note: 'The maximum settlement amount the adjuster can approve without escalation for this assignment.']
  specialty_line varchar [note: 'The line of business specialty for which the adjuster was assigned: property, auto, liability, workers compensation, etc.']
  workload_at_assignment varchar [note: 'The number of open claims the adjuster had at the time of this assignment, used for workload balancing analysis.']

  Note: 'Assignment of an adjuster to a claim or claim exposure. Grain: one row per assignment. Tracks assignment date, reassignment reason, workload at assignment, and primary vs supervisory role. FK to adjuster and claim.'
}

Table claims.fnol {
  fnol_id varchar [pk, note: 'Unique identifier for the FNOL submission record.']
  assigned_adjuster_id varchar [note: 'Reference to the adjuster assigned to investigate the FNOL, if assigned during intake.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: FNOL triage uses cat zone to route incoming loss reports to cat-qualified adjusters and apply cat SLAs.']
  catastrophe_event_id varchar [note: 'Reference to the catastrophe event if the loss is CAT-related.']
  claim_id varchar [note: 'Reference to the formal claim record created from this FNOL, if opened.']
  coverage_id varchar [note: 'Reference to the specific coverage under which the loss is being reported, if known at FNOL time.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: estimated_loss_amount on FNOL is a monetary value used for initial reserve setting and large-loss triage.']
  driver_id varchar [note: 'Foreign key linking to riskexposure.driver. Business justification: Auto FNOL — identifying the driver at first notice is required for excluded-driver triage, coverage-in-doubt flagging, and SIU referral decisions.']
  insured_risk_id varchar [note: 'Reference to the insured risk (property, vehicle, driver) involved in the loss, if identified at FNOL time.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: FNOL triage, adjuster routing, and SLA assignment are driven by LOB. The existing lob plain-text column is a denormalization of the shared LOB entity.']
  loss_event_id varchar [note: 'Foreign key linking to claims.loss_event. Business justification: An FNOL submission may be matched to a master loss event record once the event is identified (e.g., a catastrophe or multi-claim occurrence).']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophegeography_peril. Business justification: Normalizes peril classification at first notice of loss, enabling peril-based triage routing, specialist adjuster assignment, and cat flag determination.']
  policy_id varchar [note: 'Reference to the policy under which the loss is being reported.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Captures which producer reported the loss when reporter_party_role indicates producer involvement.']
  reporter_party_id varchar [note: 'Reference to the party who reported the loss (policyholder, agent, claimant, or third party).']
  reporter_party_role_id varchar [note: 'Reference to the specific role the reporter was acting in at the time of report (policyholder, named insured, agent, claimant).']
  vehicle_id varchar [note: 'Foreign key linking to riskexposure.vehicle. Business justification: Auto FNOL triage — rental car initiation, total-loss pre-screening, and glass/roadside dispatch at first notice require the specific vehicle (VIN, make/model, ACV).']
  cat_event_flag boolean [note: 'Indicates whether the loss is associated with a declared catastrophe event.']
  claim_opened_flag boolean [note: 'Indicates whether a formal claim record has been created from this FNOL submission.']
  created_timestamp timestamp [note: 'System timestamp when the FNOL record was first created in the claims management system.']
  estimated_loss_amount decimal(18,2) [note: 'Initial estimate of the loss amount provided by the reporter at the time of FNOL.']
  fatality_flag boolean [note: 'Indicates whether a fatality occurred as part of the loss event.']
  fnol_status varchar [note: 'Current status of the FNOL submission in the intake and triage workflow.']
  fraud_indicator_flag boolean [note: 'Indicates whether the FNOL has been flagged for potential fraud based on initial screening rules.']
  injury_flag boolean [note: 'Indicates whether bodily injury was reported as part of the loss.']
  iso_cat_serial_number varchar [note: 'ISO-assigned catastrophe serial number for industry-wide catastrophe event tracking.']
  loss_cause varchar [note: 'Preliminary cause or peril of the loss as reported (fire, theft, collision, wind, water, liability, etc.).']
  loss_date date [note: 'Date the loss or incident occurred as reported by the reporter.']
  loss_description varchar [note: 'Initial narrative description of the loss event as provided by the reporter.']
  loss_location_address varchar [note: 'Street address where the loss occurred.']
  loss_location_city varchar [note: 'City where the loss occurred.']
  loss_location_country varchar [note: 'Country where the loss occurred, using 3-letter ISO country code.']
  loss_location_postal_code varchar [note: 'Postal or ZIP code of the loss location.']
  loss_location_state varchar [note: 'State or province where the loss occurred.']
  loss_time timestamp [note: 'Time of day the loss occurred, if known and reported.']
  modified_timestamp timestamp [note: 'System timestamp when the FNOL record was last updated.']
  number varchar [note: 'Business identifier for the FNOL submission, often displayed to users and external parties.']
  police_department varchar [note: 'Name of the police department or law enforcement agency that took the report.']
  police_report_filed_flag boolean [note: 'Indicates whether a police report was filed for the loss event.']
  police_report_number varchar [note: 'Police report or incident number, if a report was filed.']
  property_damage_flag boolean [note: 'Indicates whether property damage was reported as part of the loss.']
  rejection_reason varchar [note: 'Reason the FNOL was rejected or not converted to a formal claim, if applicable.']
  report_channel varchar [note: 'Channel through which the loss was reported.']
  report_date date [note: 'Date the loss was reported to the insurer.']
  report_timestamp timestamp [note: 'Precise date and time the FNOL was submitted or received by the system.']
  reporter_contact_email varchar [note: 'Email address of the reporter for follow-up communication.']
  reporter_contact_phone varchar [note: 'Phone number of the reporter for follow-up communication.']
  siu_referral_flag boolean [note: 'Indicates whether the FNOL has been referred to the Special Investigations Unit for fraud investigation.']
  third_party_involved_flag boolean [note: 'Indicates whether a third party (non-insured) is involved in the loss event.']
  triage_priority varchar [note: 'Priority level assigned to the FNOL for adjuster assignment and investigation, based on severity and complexity.']

  Note: 'First Notice of Loss intake record. Grain: one row per FNOL submission. Captures report channel, reporter party, initial loss description, date/time of loss, and triage flags before a formal claim is opened.'
}

Table claims.litigation {
  litigation_id varchar [pk, note: 'Unique identifier for the litigation record. Primary key.']
  assigned_adjuster_id varchar [note: 'Identifier of the adjuster assigned to manage this litigation.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Cat-related litigation (bad faith, coverage disputes post-hurricane/flood) must be tracked against the triggering catastrophe event for reinsurance bad faith cost']
  claim_exposure_id varchar [note: 'Foreign key linking to claims.claim_exposure. Business justification: Litigation is frequently tied to a specific coverage line (claim exposure) rather than the entire claim — e.g., a bodily injury lawsuit targets the BI coverage exposure specifically.']
  claim_id varchar [note: 'Foreign key to the claim that this litigation is attached to.']
  claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: A lawsuit is filed by a specific claimant party. Linking litigation directly to the claimant record (beyond the claim-level link) enables precise tracking of which claimant is the plaintiff']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Litigation defense strategy, reserve authority, and settlement negotiations require direct reference to the specific coverage part in dispute.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: litigation carries defense_cost_incurred, demand_amount, reserve_amount, settlement_amount, and verdict_amount — all monetary.']
  defense_counsel_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Defense attorneys are parties requiring tracking for legal billing, conflict checks, panel counsel management, and regulatory reporting.']
  appeal_date date [note: 'Date the appeal was filed.']
  appeal_filed_flag boolean [note: 'Indicates whether an appeal has been filed following the verdict.']
  cause_of_action varchar [note: 'Legal basis or grounds for the lawsuit, such as negligence, breach of contract, or bad faith.']
  closure_date date [note: 'Date the litigation was formally closed in the claims system.']
  confidentiality_flag boolean [note: 'Indicates whether the litigation settlement or details are subject to a confidentiality agreement.']
  court_jurisdiction varchar [note: 'Name of the court or jurisdiction where the lawsuit is filed, including district or county.']
  court_type varchar [note: 'Type or level of court handling the litigation.']
  created_timestamp timestamp [note: 'Timestamp when the litigation record was first created in the system.']
  defense_cost_incurred decimal(18,2) [note: 'Total defense and cost containment expenses incurred for this litigation.']
  demand_amount decimal(18,2) [note: 'Monetary amount demanded by the plaintiff in the lawsuit.']
  dismissal_date date [note: 'Date the lawsuit was dismissed by the court.']
  dismissal_reason varchar [note: 'Reason provided for the dismissal of the lawsuit, such as lack of jurisdiction or settlement.']
  filing_date date [note: 'Date the lawsuit was filed with the court.']
  lawsuit_number varchar [note: 'Court-assigned case number or docket number for the lawsuit.']
  litigation_status varchar [note: 'Current status of the litigation in its lifecycle. [ENUM-REF-CANDIDATE: filed|discovery|mediation|trial|settled|dismissed|verdict_rendered|appeal|closed — 9 candidates stripped; promote to reference product]']
  litigation_type varchar [note: 'Classification of the litigation based on the nature of the dispute.']
  mediation_date date [note: 'Date of scheduled or completed mediation session.']
  notes varchar [note: 'Free-text notes capturing key details, strategy, or updates related to the litigation.']
  plaintiff_attorney_firm varchar [note: 'Law firm name representing the plaintiff.']
  plaintiff_attorney_name varchar [note: 'Name of the attorney or law firm representing the plaintiff.']
  plaintiff_attorney_phone varchar [note: 'Contact phone number for the plaintiff attorney.']
  plaintiff_name varchar [note: 'Name of the plaintiff or claimant who filed the lawsuit.']
  reserve_amount decimal(18,2) [note: 'Total reserve amount set aside for this litigation, including indemnity and defense costs.']
  settlement_amount decimal(18,2) [note: 'Total monetary amount agreed upon in the settlement.']
  settlement_date date [note: 'Date the litigation was settled, if applicable.']
  trial_date date [note: 'Scheduled date for the trial or hearing.']
  updated_timestamp timestamp [note: 'Timestamp when the litigation record was last updated.']
  venue_county varchar [note: 'County where the lawsuit is being heard.']
  venue_state varchar [note: 'State where the lawsuit is being heard.']
  verdict_amount decimal(18,2) [note: 'Monetary award determined by the court or jury in the verdict.']
  verdict_date date [note: 'Date the court or jury rendered a verdict.']
  verdict_type varchar [note: 'Outcome of the verdict indicating which party prevailed.']

  Note: 'Litigation record attached to a claim. Tracks lawsuit filing date, plaintiff attorney, defense counsel, court jurisdiction, trial date, verdict, and settlement amount. One row per lawsuit per claim.'
}

Table claimfinancials.reserve {
  reserve_id varchar [pk, note: 'Unique surrogate identifier for each reserve position record. One row per reserve type per claim exposure per accounting period. Grain: one reserve movement per claim exposure per period.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this reserve position is recorded. Enables calendar year, accident year, and policy year reserve triangles.']
  adjuster_id varchar [note: 'Reference to the adjuster who authorized or last modified this reserve position. Required for reserve authority and audit trail.']
  approved_by_party_id varchar [note: 'Reference to the party (supervisor or manager) who approved this reserve movement when it exceeded adjuster authority limits. Null if no approval was required.']
  claim_exposure_id varchar [note: 'Reference to the claim exposure (coverage line within a claim) to which this reserve position belongs. Links reserve to a specific coverage and insured risk within the claim.']
  claim_id varchar [note: 'Reference to the parent claim record. Denormalized for direct claim-level aggregation and reporting without joining through claim exposure.']
  coverage_id varchar [note: 'Reference to the coverage under which this reserve is established. Supports reserve analysis by coverage type and line of business.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Multi-currency claim operations require currency master for exchange rate lookup, functional currency conversion, rounding rules, and financial consolidation.']
  financial_transaction_id varchar [note: 'Foreign key linking to claimfinancials.financial_transaction. Business justification: Every reserve movement (case, IBNR, LAE) generates an atomic double-entry posting in financial_transaction.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Actuarial reserve adequacy analysis, NAIC Schedule P reporting, and regulatory reserve filings require joining reserve transactions to LOB master for proper line classification, loss']
  litigation_id varchar [note: 'Foreign key linking to claims.litigation. Business justification: Litigation reserves are a distinct reserve category (reserve_category field confirms this) set when a claim enters suit.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: Reserves are established against specific policies for loss reserve adequacy analysis, IBNR calculations, and statutory reserve reporting.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Reserves must link to policy term for accurate loss ratio calculations, earned premium matching, and Schedule P development triangle reporting by accident year and policy year.']
  ri_claim_cession_id varchar [note: 'Foreign key linking to reinsurance.ri_claim_cession. Business justification: Ceded case reserves and IBNR are booked per claim-level cession for Schedule P and NAIC reporting.']
  ri_recovery_id varchar [note: 'Foreign key linking to reinsurance.ri_recovery. Business justification: RI recoveries reduce ceded reserves; actuaries link ri_recovery to reserve movements for ceded IBNR runoff and Schedule P loss development analysis.']
  riskexposure_auto_risk_id varchar [note: 'Foreign key linking to riskexposure.auto_risk. Business justification: Auto liability reserve adequacy benchmarking requires auto risk attributes (territory, use class, radius of operation) for actuarial development factor selection.']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Actuaries segment reserve adequacy by risk characteristics (construction type, protection class, vehicle type, driver profile) for accurate loss development and catastrophe']
  accident_year varchar [note: 'The calendar year in which the loss event occurred. Used for accident year (AY) loss triangle development and actuarial reserving analysis per NAIC Schedule P.']
  approval_timestamp timestamp [note: 'Date and time when the reserve movement was approved by the authorizing supervisor or manager. Null if no approval was required for this movement.']
  authority_limit_amount decimal(18,2) [note: 'Maximum reserve amount the authorizing adjuster is permitted to set without escalation per the claims reserving authority matrix. Supports reserve governance and SOX controls.']
  basis varchar [note: 'Indicates whether the reserve amounts are stated on a Gross (before reinsurance), Net (after reinsurance), or Ceded (reinsurer share only) basis for this record.']
  case_reserve_adequacy_flag boolean [note: 'Actuarial or supervisory assessment of whether the case reserve is adequate relative to the expected ultimate loss. Used in reserve review and ORSA reporting.']
  catastrophe_indicator boolean [note: 'Indicates whether this reserve is associated with a declared catastrophe event. Enables CAT vs. non-CAT reserve segregation for PML analysis and reinsurance recovery tracking.']
  ceded_closing_balance_amount decimal(18,2) [note: 'Portion of the closing reserve balance ceded to reinsurers. Net reserve equals closing balance minus ceded closing balance. Required for Schedule F statutory reporting.']
  ceded_movement_amount decimal(18,2) [note: 'Incremental change in the ceded reserve portion during the accounting period. Supports net reserve calculation and reinsurance bordereaux reporting.']
  ceded_opening_balance_amount decimal(18,2) [note: 'Portion of the opening reserve balance ceded to reinsurers under applicable treaties or facultative agreements. Used for net reserve and Schedule F reporting.']
  closing_balance_amount decimal(18,2) [note: 'Reserve balance at the end of the accounting period for this claim exposure and reserve type. Equals opening balance plus movement amount. Gross of reinsurance.']
  cost_center_code varchar [note: 'Internal cost center to which this reserve is allocated for management accounting and expense reporting purposes. Supports departmental P&L and RBC capital allocation.']
  created_timestamp timestamp [note: 'Timestamp when this reserve record was first created in the system. Used for audit trail, SOX compliance, and data lineage tracking in the lakehouse silver layer.']
  development_period varchar [note: 'Number of months elapsed from the accident year start to the end of the accounting period. Used to position this reserve in the loss development triangle (e.g., 12, 24, 36 months).']
  effective_date date [note: 'Date on which this reserve position becomes effective for financial reporting purposes. May differ from the transaction date for period-end adjustments and actuarial entries.']
  gl_account_code varchar [note: 'General ledger account code to which this reserve movement is posted in the statutory and GAAP accounting systems. Supports financial close and Schedule P reconciliation.']
  ibnr_factor decimal(10,6) [note: 'Actuarial development factor applied to derive the IBNR reserve component. Sourced from the actuarial reserving system loss development triangle for the applicable LOB and accident year.']
  loss_date date [note: 'Date of the underlying loss event that gave rise to this claim and reserve. Denormalized from the claim for accident year triangle development without additional joins.']
  method varchar [note: 'Methodology used to establish or update this reserve: Case_Estimate (adjuster judgment), Formula (system-calculated), Actuarial (actuarial model output), Bulk (portfolio-level), or Tabular (mortality/morbidity table).']
  movement_amount decimal(18,2) [note: 'Incremental change to the reserve during the accounting period. Positive value indicates reserve strengthening; negative value indicates reserve release. Gross of reinsurance.']
  movement_reason_code varchar [note: 'Coded reason for the reserve movement in this period (e.g., NEW_RESERVE, STRENGTHENING, PARTIAL_RELEASE, FULL_RELEASE, PAYMENT_OFFSET, REOPEN). [ENUM-REF-CANDIDATE']
  movement_reason_description varchar [note: 'Free-text narrative provided by the adjuster or actuarial team explaining the basis for the reserve movement. Supports audit trail and reserve review documentation.']
  number varchar [note: 'Externally visible business identifier for this reserve record, typically assigned by the claims management system. Used in bordereaux and statutory reporting.']
  opening_balance_amount decimal(18,2) [note: 'Reserve balance carried forward from the prior accounting period for this claim exposure and reserve type. Starting point for the period movement calculation.']
  policy_year varchar [note: 'The year in which the policy that generated this claim was written. Supports policy year (PY) reserve development triangles distinct from accident year analysis.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'Estimated reinsurance recoverable on this reserve position based on applicable treaty or facultative cession. Supports Schedule F reporting and net reserve calculation.']
  report_date date [note: 'Date the claim was first reported to the insurer (FNOL date). Used to compute report lag and support IBNR development analysis in actuarial reserving.']
  requires_supervisor_approval boolean [note: 'Indicates whether this reserve movement exceeded the adjuster authority limit and required supervisor or management approval before posting.']
  reserve_category varchar [note: 'Broad financial category of the reserve: Loss (indemnity), Expense (LAE/DCC/AO), Salvage (anticipated recovery from salvage), or Subrogation (anticipated recovery from third parties).']
  reserve_status varchar [note: 'Current lifecycle state of the reserve position. Open reserves are active; Closed reserves have been fully settled or released; Reopened indicates a previously closed reserve reactivated.']
  reserve_type varchar [note: 'Classification of the reserve: Case (known reported loss), IBNR (Incurred But Not Reported), LAE (Loss Adjustment Expense), ULAE (Unallocated LAE), ALAE (Allocated LAE), or DCC (Defense & Cost Containment).']
  salvage_anticipated_amount decimal(18,2) [note: 'Estimated salvage recovery anticipated on this claim exposure. Reduces the net reserve position and is reported separately in NAIC statutory filings.']
  source_system_code varchar [note: 'Identifies the operational system that originated this reserve record: ClaimCenter, DuckCreek, Legacy, Manual (spreadsheet entry), or Actuarial (reserving system upload).']
  state_code varchar [note: 'Two-letter US state code where the insured risk is located or the loss occurred. Required for state-level Schedule P statutory reporting and DOI regulatory filings.']
  subrogation_anticipated_amount decimal(18,2) [note: 'Estimated subrogation recovery anticipated on this claim exposure. Reduces the net reserve position and is tracked separately for recovery management and statutory reporting.']
  transaction_date date [note: 'Calendar date on which the reserve movement was entered into the claims management system. Used for CY (Calendar Year) reporting and reconciliation to the general ledger.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this reserve record. Used for incremental data pipeline processing, audit trail, and change data capture in the lakehouse.']

  Note: 'One row per reserve position per claim exposure per accounting period. Tracks Case, IBNR, and LAE reserves with opening balance, incremental movement (strengthening/release with reason code and authorizing adjuster), and closing balance.'
}

Table claimfinancials.claim_payment {
  claim_payment_id varchar [pk, note: 'Unique surrogate identifier for each claim payment disbursement record. Primary key. One row per payment per claim exposure per accounting period.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this payment is recognized for statutory and GAAP financial reporting purposes.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Cat-event-level payment aggregation is required for reinsurance bordereaux reporting and treaty recovery billing.']
  claim_exposure_id varchar [note: 'Reference to the specific coverage line within the claim (Claim Exposure) against which this payment is charged. Grain anchor per VREQ-007.']
  claim_id varchar [note: 'Reference to the parent claim under which this payment is issued. Links payment to the reported loss event.']
  claim_party_id varchar [note: 'System user ID of the claims examiner or supervisor who authorized this payment within the authority limit matrix.']
  claim_payee_party_id varchar [note: 'Reference to the Party record identifying the individual or organization receiving this payment (claimant, vendor, attorney, lienholder, loss payee).']
  claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: Settlement payments are issued to specific claimants. This FK enables per-claimant payment reconciliation, release-signed-date validation before disbursement, 1099 reporting at the claimant']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: International claim payments require currency master for exchange rate application, withholding tax calculation, bank account validation, and functional currency conversion.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Payment authority limits, commission calculations, and loss ratio monitoring are configured by line of business.']
  litigation_id varchar [note: 'Foreign key linking to claims.litigation. Business justification: Settlement and verdict payments directly close or partially satisfy litigation matters. Linking payment to litigation enables litigation cost-to-close analysis, verdict vs.']
  original_payment_claim_payment_id varchar [note: 'Self-referencing identifier pointing to the original payment record when this row represents a reissue or replacement. Null for original disbursements.']
  payee_id varchar [note: 'Foreign key linking to claimfinancials.payee. Business justification: claim_payment carries denormalized payee_name and payee_tax_number that duplicate the authoritative claimfinancials.payee master record.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: Payments are made under specific policies for deductible application, policy limit tracking, aggregate limit monitoring, and premium-to-loss reconciliation.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Payments must match to the policy term in force at loss date for accurate loss ratio, combined ratio, and loss development analysis by underwriting year.']
  ri_claim_cession_id varchar [note: 'Foreign key linking to reinsurance.ri_claim_cession. Business justification: Ceded claim payments are billed to reinsurers against specific claim cessions via bordereaux and cash calls.']
  ri_recovery_id varchar [note: 'Foreign key linking to reinsurance.ri_recovery. Business justification: RI recovery collections are reconciled against specific claim payments for cash application and aged-receivables reporting.']
  accident_year varchar [note: 'Four-digit calendar year in which the loss event occurred. Used for accident year (AY) loss development triangles and actuarial reserving.']
  ap_batch_number varchar [note: 'Identifier of the AP disbursement batch in which this payment was grouped for bank settlement. Used for batch reconciliation in Oracle/SAP AP module.']
  authority_limit_amount decimal(18,2) [note: 'Maximum payment amount the authorizing user was permitted to approve per the claims authority matrix at the time of authorization.']
  bank_account_code varchar [note: 'Internal code identifying the company bank account from which the payment was funded. Supports multi-bank disbursement and reconciliation workflows.']
  check_eft_reference varchar [note: 'Check number or EFT transaction reference issued by the bank or payment processor. Used for bank reconciliation and stop-payment processing.']
  cleared_date date [note: 'Date the payment instrument cleared the bank. Null until the check or EFT is confirmed settled. Used for outstanding check reconciliation.']
  cost_center_code varchar [note: 'Internal cost center to which the payment expense is allocated for management accounting and expense ratio reporting.']
  coverage_type_code varchar [note: 'Code identifying the coverage part under which this payment is charged (e.g., HO-Dwelling, PAP-Liability, CGL-BI). Aligns payment to the policy coverage for Schedule P reporting.']
  created_timestamp timestamp [note: 'Timestamp when this payment record was first created in the claims management system. Supports audit trail and SOX compliance.']
  deductible_offset_amount decimal(18,2) [note: 'Amount of the payment attributable to the insured\'s deductible or Self-Insured Retention (SIR) that is to be collected back from the policyholder.']
  gl_account_code varchar [note: 'General Ledger account code to which this payment is posted in the statutory and GAAP accounting systems for financial reporting.']
  gross_payment_amount decimal(18,2) [note: 'Total gross amount disbursed before any deductions, withholdings, or offsets. Denominated in the currency indicated by currency_code.']
  is_1099_reportable boolean [note: 'Indicates whether this payment must be reported to the IRS on Form 1099-MISC or 1099-NEC. Drives year-end tax reporting extract.']
  is_final_payment boolean [note: 'Indicates this payment closes the claim exposure financially. When true, triggers reserve release and exposure closure workflow in ClaimCenter.']
  is_structured_settlement boolean [note: 'Indicates whether this payment is part of a structured settlement annuity arrangement rather than a lump-sum disbursement.']
  loss_category varchar [note: 'Detailed loss sub-category classifying the nature of the payment: Bodily Injury (BI), Property Damage (PD), Medical Payments (MP), Uninsured Motorist (UM), etc.']
  net_payment_amount decimal(18,2) [note: 'Actual amount disbursed to the payee after withholding and deductions. Net = gross_payment_amount minus withholding_amount.']
  payment_authorization_code varchar [note: 'Internal authorization or approval code assigned by the claims supervisor or authority matrix before payment release. Supports SOX payment controls.']
  payment_date date [note: 'Calendar date on which the payment was issued or disbursed to the payee. Used for calendar year (CY) and accident year (AY) loss reporting.']
  payment_description varchar [note: 'Free-text narrative describing the purpose or nature of the payment (e.g., \'Partial settlement for dwelling damage\', \'Attorney fee disbursement\').']
  payment_method varchar [note: 'Instrument or mechanism used to disburse funds to the payee (paper check, ACH, wire transfer, EFT, draft, or virtual card).']
  payment_number varchar [note: 'Externally visible, human-readable payment reference number assigned by the claims payment system or AP module. Used for reconciliation and payee inquiries.']
  payment_status varchar [note: 'Current lifecycle state of the payment instrument. Tracks issuance through clearance, void, stop-payment, reissue, and return workflows in ClaimCenter.']
  payment_type varchar [note: 'Classification of the payment by financial category: indemnity (loss), medical, Loss Adjustment Expense (LAE), Defense & Cost Containment (DCC), Adjusting & Other (AO), or recovery offset.']
  policy_year varchar [note: 'Four-digit year of the policy period under which the loss is covered. Used for policy year (PY) loss development and reinsurance treaty year allocation.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'Portion of this payment expected to be recovered from reinsurers under applicable treaty or facultative agreements. Used for net loss reporting.']
  reissue_date date [note: 'Date a replacement payment was reissued after a void or stop-payment. Links to the original payment via original_payment_id for audit trail.']
  remittance_memo varchar [note: 'Short memo line printed on the check or included in the EFT remittance advice to the payee. Typically includes claim number and coverage description.']
  siu_referral_flag boolean [note: 'Indicates this payment was flagged for Special Investigations Unit (SIU) review due to suspected fraud. Payment may be held pending SIU clearance.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this payment record was ingested into the lakehouse Silver layer.']
  state_jurisdiction_code varchar [note: 'Two-letter US state code of the jurisdiction governing this payment for regulatory reporting and state DOI compliance purposes.']
  stop_payment_flag boolean [note: 'Indicates a stop-payment order has been placed on this check with the issuing bank. Triggers reissue workflow and outstanding check reconciliation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this payment record. Used for incremental data pipeline processing and audit trail.']
  void_date date [note: 'Date the payment was voided. Populated only when payment_status is Voided. Triggers reversal entries in the general ledger.']
  withholding_amount decimal(18,2) [note: 'Amount withheld from the gross payment for tax withholding, Medicare Set-Aside (MSA), or other statutory deductions before net disbursement.']

  Note: 'One row per payment disbursement per claim exposure per accounting period. Records indemnity, medical, and LAE payments with payee, method, check/EFT reference, void/reissue/stop-payment status, and AP batch grouping (batch id, bank account, settlement'
}

Table claimfinancials.recovery {
  recovery_id varchar [pk, note: 'Unique surrogate identifier for each claim recovery transaction. One row per recovery transaction per claim exposure per accounting period.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this recovery transaction is recognized for statutory and GAAP financial reporting.']
  adjuster_id varchar [note: 'Reference to the claims adjuster or recovery specialist responsible for managing and pursuing this recovery transaction.']
  attorney_organization_id varchar [note: 'Foreign key linking to party.organization. Business justification: Recovery (salvage, subrogation, reinsurance) often involves legal counsel. Law firms are organizations requiring full party attribution for vendor management, payment processing, and']
  cession_id varchar [note: 'Reference to the reinsurance cession record when recovery_type is reinsurance. Null for subrogation and salvage recoveries.']
  claim_exposure_id varchar [note: 'Reference to the specific coverage line within the claim (Claim Exposure) against which this recovery is applied.']
  claim_id varchar [note: 'Reference to the parent claim record. Denormalized for direct claim-level reporting and aggregation without joining through claim exposure.']
  claim_payment_id varchar [note: 'Reference to the original claim payment transaction that this recovery offsets. Links recovery to the indemnity payment for net loss calculation.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Subrogation and salvage recoveries must tie to the coverage that paid the original loss for proper reserve relief, reinsurance accounting, and statutory reporting.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Multi-currency recovery operations (reinsurance collections, subrogation from foreign insurers, salvage auctions) require currency master for demand amount conversion, collection tracking']
  financial_transaction_id varchar [note: 'Foreign key linking to claimfinancials.financial_transaction. Business justification: Subrogation collections and salvage proceeds captured in recovery generate financial_transaction postings (recovery income, offset to paid losses).']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Subrogation and salvage recovery tracking, reinsurance recovery allocation, and net loss ratio calculation require LOB master for treaty participation rules, recovery expense']
  litigation_id varchar [note: 'Foreign key linking to claims.litigation. Business justification: Subrogation and other recoveries are frequently collected through litigation. recovery.litigation_flag confirms litigation is tracked on recoveries, but no FK exists.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: Recoveries (salvage and subrogation) reduce net incurred loss on specific policies. Policy linkage required for ultimate loss calculation, experience modification rating, and loss cost analysis.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Recoveries must link to policy term for accurate net loss ratio calculations and to match recovery timing with the original loss term for loss development analysis.']
  responsible_party_id varchar [note: 'Reference to the party from whom recovery is sought: tortfeasor for subrogation, salvage buyer for salvage, or reinsurer for reinsurance recovery.']
  ri_agreement_id varchar [note: 'Reference to the reinsurance agreement (treaty or facultative) under which a reinsurance recovery is claimed. Null for subrogation and salvage.']
  ri_claim_cession_id varchar [note: 'Foreign key linking to reinsurance.ri_claim_cession. Business justification: Subrogation and salvage recoveries net against ceded losses at the claim-cession level for UNL calculation.']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Cross-LOB recovery reporting and Schedule P aggregation require linking recovery records to the parent insured risk.']
  salvage_id varchar [note: 'Foreign key linking to claimfinancials.salvage. Business justification: Recovery is the transaction record for collected amounts. Salvage is the master record for salvage activity.']
  subrogation_id varchar [note: 'Foreign key linking to claimfinancials.subrogation. Business justification: Recovery is the transaction record for collected amounts. Subrogation is the master record for a subrogation pursuit.']
  accident_year varchar [note: 'Calendar year in which the loss event occurred. Used for accident year (AY) loss development triangles and actuarial reserving analysis.']
  bordereaux_period varchar [note: 'YYYY-MM formatted period for which this recovery is included in reinsurance bordereaux reporting to the reinsurer. Applicable for reinsurance recoveries.']
  closed_date date [note: 'Date on which the recovery file was formally closed, either after full collection, settlement, or abandonment of pursuit.']
  collected_amount decimal(18,2) [note: 'Gross amount actually received from the responsible party or reinsurer prior to deducting collection expenses or attorney fees.']
  collected_date date [note: 'Date on which recovery funds were actually received and posted. Null if recovery has not yet been collected.']
  collection_expense_amount decimal(18,2) [note: 'Costs incurred to pursue and collect the recovery, including attorney fees, court costs, and investigation expenses. Deducted to derive net recovery.']
  created_timestamp timestamp [note: 'Timestamp when this recovery record was first created in the system. Used for audit trail, SOX compliance, and data lineage tracking.']
  demand_amount decimal(18,2) [note: 'Gross amount formally demanded from the responsible party or reinsurer. Represents the maximum expected recovery before negotiation or adjustment.']
  demand_date date [note: 'Date on which the formal demand for recovery was first issued to the responsible party, tortfeasor, or reinsurer.']
  gl_account_code varchar [note: 'General ledger account code to which this recovery transaction is posted for statutory and GAAP financial reporting.']
  litigation_flag boolean [note: 'Indicates whether legal action has been filed to pursue this recovery. True when a lawsuit or arbitration proceeding is active.']
  method varchar [note: 'Mechanism used to pursue or collect the recovery. [ENUM-REF-CANDIDATE: demand_letter|litigation|negotiated_settlement|auction|bordereaux|direct_bill — promote to reference product]']
  net_amount decimal(18,2) [note: 'Net recovery amount after deducting collection expenses from collected amount. Used for statutory reporting and loss ratio calculations (NWP basis).']
  notes varchar [note: 'Free-text narrative capturing adjuster commentary, negotiation history, legal strategy notes, or other contextual information about this recovery.']
  number varchar [note: 'Externally visible business identifier for this recovery transaction, used in bordereaux reporting, correspondence, and audit trails.']
  payment_reference varchar [note: 'Check number, wire transfer reference, EFT trace number, or other payment instrument identifier for the collected recovery funds.']
  policy_year varchar [note: 'Year in which the policy that generated the claim was written. Used for policy year (PY) loss development and reinsurance treaty year allocation.']
  recovery_status varchar [note: 'Current lifecycle state of the recovery transaction: open (demand issued), collected (funds received), closed (finalized), void (cancelled), or disputed.']
  recovery_type varchar [note: 'Classifies the nature of the recovery: subrogation (pursuit of third-party tortfeasor), salvage (sale of damaged property), reinsurance (ceded loss recovery), or other.']
  ri_participation_pct decimal(7,4) [note: 'Percentage of the ceded loss recoverable from the reinsurer under the applicable treaty or facultative agreement (e.g., 0.7500 = 75%).']
  ri_recovery_basis varchar [note: 'Reinsurance structure under which the recovery is claimed: quota share (QS), excess of loss (XOL), stop loss (SL), or facultative (FAC).']
  salvage_item_description varchar [note: 'Description of the salvaged property or item sold, including condition, make/model for vehicles, or material type for property salvage.']
  salvage_type varchar [note: 'Classification of salvage recovery: total loss vehicle, damaged property, scrap material, or auction proceeds. Applicable only when recovery_type is salvage.']
  siu_referral_flag boolean [note: 'Indicates whether this recovery has been referred to the Special Investigations Unit (SIU) for fraud investigation or suspicious activity review.']
  source_system_code varchar [note: 'Identifies the operational system of record that originated this recovery transaction (e.g., ClaimCenter, ReinsurancePro, BillingCenter, or manual entry).']
  state_code varchar [note: 'Two-letter US state code for the jurisdiction governing this recovery, used for statutory reporting and state DOI regulatory compliance.']
  statute_of_limitations_date date [note: 'Date by which legal action must be filed to preserve the right of recovery. Critical for subrogation diary management and SIU oversight.']
  subrogation_basis varchar [note: 'Legal theory under which subrogation is pursued: tort (negligence), contract (breach), statutory (workers comp lien), or equitable subrogation.']
  transaction_date date [note: 'The real-world date on which the recovery event occurred: demand issued, settlement agreed, payment received, or salvage sale completed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this recovery record. Used for change data capture, audit trail, and incremental ETL processing.']

  Note: 'One row per recovery transaction per claim exposure per accounting period. SSOT for ALL claim recoveries: recovery_type (subrogation, salvage, reinsurance), responsible party, demand/collected/net amounts.'
}

Table claimfinancials.subrogation {
  subrogation_id varchar [pk, note: 'Unique surrogate identifier for the subrogation pursuit record. One row per subrogation action initiated against a liable third party arising from a paid claim.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which the subrogation recovery is recognized for statutory and GAAP financial reporting. Aligns with Schedule P accident year reporting.']
  attorney_organization_id varchar [note: 'Foreign key linking to party.organization. Business justification: Law firms handling subrogation litigation are organizations in the party domain. Tracking counsel requires full organization details for billing, communication, and regulatory reporting.']
  claim_exposure_id varchar [note: 'Reference to the specific coverage line (claim exposure) within the claim that generated the subrogation opportunity. Enables per-coverage recovery tracking.']
  claim_id varchar [note: 'Reference to the parent claim from which this subrogation pursuit originates. Links the recovery action to the underlying loss event and paid indemnity.']
  claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: Subrogation recovery is pursued on behalf of the specific claimant who suffered the loss. Made-whole doctrine compliance and insured reimbursement calculations (insured_reimbursement_amount']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Cross-border subrogation pursuits against foreign liable parties require currency master for demand amount calculation, settlement negotiation, collection tracking, and insured reimbursement']
  liable_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Subrogation pursues recovery from liable third parties who are tracked as party entities. Demand letters, settlement negotiations, and litigation require full party attribution including address']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Subrogation teams are organized by LOB (auto vs. property), recovery benchmarks and pursuit strategies differ by LOB, and regulatory subrogation reporting requires LOB attribution.']
  litigation_id varchar [note: 'Foreign key linking to claims.litigation. Business justification: Subrogation pursued through suit requires reference to the litigation record. subrogation.suit_filed_date, litigation_status, and statute_of_limitations_date confirm litigation is tracked']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: Subrogation pursuits are policy-specific for tracking recovery potential, adjusting loss experience, and calculating net incurred amounts.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Subrogation must link to policy term to match recovery collections with the original loss term for accurate loss development and net loss ratio reporting.']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Property subrogation (e.g., fire caused by contractor negligence) requires linking the pursuit record to the insured risk for cross-LOB subrogation reporting and reinsurance']
  arbitration_award_amount decimal(18,2) [note: 'Dollar amount awarded by the arbitration panel in favor of the insurer. May differ from demand amount. Drives final collection and closure processing.']
  arbitration_filing_date date [note: 'Date the subrogation dispute was filed with the arbitration forum. Used to track filing deadlines and arbitration cycle times.']
  arbitration_forum varchar [note: 'Arbitration body used for intercompany dispute resolution. Arbitration Forums Inc. is standard for auto subrogation. Drives filing fee tracking and award enforcement.']
  closed_date date [note: 'Date the subrogation pursuit was formally closed in the claims system. Used for cycle time reporting and recovery performance measurement.']
  closure_reason varchar [note: 'Reason the subrogation pursuit was closed. Required for recovery analytics, SIU referral decisions, and regulatory reporting. [ENUM-REF-CANDIDATE: promote to reference product if values expand]']
  collected_amount decimal(18,2) [note: 'Total gross amount actually received from the liable party or their insurer to date. Cumulative across all payments. Used in net recovery and loss ratio calculations.']
  collectible_amount decimal(18,2) [note: 'Estimated collectible portion of the demand amount after applying comparative negligence, policy limits of the liable party, and asset assessment. Used for reserve adequacy.']
  created_timestamp timestamp [note: 'Timestamp when the subrogation record was first created in the claims management system. Used for audit trail, data lineage, and SOX compliance.']
  demand_amount decimal(18,2) [note: 'Gross dollar amount demanded from the liable third party, typically equal to total indemnity paid plus allocated loss adjustment expenses (ALAE) on the claim.']
  demand_date date [note: 'Date the formal subrogation demand letter was issued to the liable party or their insurer. Starts the statute of limitations clock for recovery actions.']
  insured_reimbursement_amount decimal(18,2) [note: 'Portion of the net recovery returned to the insured, typically representing their deductible or uninsured loss. Required by the made-whole doctrine in most jurisdictions.']
  last_activity_date date [note: 'Date of the most recent action taken on the subrogation file (demand, payment received, court filing, etc.). Used for diary management and dormant file identification.']
  liable_party_claim_number varchar [note: 'Claim number assigned by the liable party\'s insurer for the same loss event. Enables cross-carrier reconciliation and arbitration tracking.']
  liable_party_insurer varchar [note: 'Name of the insurance carrier for the liable third party. Used to route intercompany arbitration and direct demand letters to the correct carrier.']
  liable_party_policy_number varchar [note: 'Policy number of the liable third party\'s insurance coverage. Required for intercompany arbitration filings and demand correspondence.']
  litigation_status varchar [note: 'Current stage of legal proceedings for the subrogation pursuit. Drives reserve adequacy reviews and legal expense forecasting. [ENUM-REF-CANDIDATE: promote to reference product if stages expand]']
  made_whole_indicator boolean [note: 'Indicates whether the insured has been fully compensated for their loss before the insurer may retain subrogation proceeds. Required by the made-whole doctrine in most states.']
  negligence_pct decimal(5,2) [note: 'Percentage of fault attributed to the liable third party as determined by investigation or adjudication. Drives the collectible amount calculation under comparative negligence statutes.']
  net_recovery_amount decimal(18,2) [note: 'Net recovery after deducting recovery expenses from collected amount (collected_amount minus recovery_expense_amount). Represents the actual financial benefit to the insurer.']
  next_action_date date [note: 'Diary date for the next required action on the subrogation file. Drives case management queues and ensures statute of limitations compliance.']
  notes varchar [note: 'Free-text narrative capturing key developments, negotiation history, legal strategy, and adjuster observations for the subrogation pursuit. Supports case management and audit.']
  number varchar [note: 'Externally visible business identifier for the subrogation pursuit, used in demand letters, court filings, and bordereaux reporting. Format: SUBR-YYYY-NNNNNNN.']
  opened_date date [note: 'Date the subrogation pursuit was formally opened in the claims management system. Used as the start point for cycle time and recovery lag analysis.']
  pursuit_status varchar [note: 'Current workflow state of the subrogation pursuit. Drives case management queues and recovery reporting. [ENUM-REF-CANDIDATE: Open|Demand Issued|Negotiating|Settled|Collected|Closed - No Recovery|Referred to Litigation — promote to reference product]']
  recovery_expense_amount decimal(18,2) [note: 'Total allocated expenses incurred in pursuing the subrogation recovery, including attorney fees, court costs, and investigation costs (DCC/ALAE). Deducted to compute net recovery.']
  recovery_method varchar [note: 'Mechanism used to pursue the subrogation recovery. Intercompany Arbitration applies to auto claims under Arbitration Forum agreements. Drives legal cost allocation.']
  referral_date date [note: 'Date the subrogation file was referred to outside counsel or a subrogation vendor for legal pursuit. Triggers DCC expense tracking and litigation status updates.']
  reinsurance_recovery_indicator boolean [note: 'Indicates whether a portion of the subrogation recovery must be remitted to reinsurers per cession agreements. Triggers reinsurance bordereaux reporting and recovery allocation.']
  settlement_amount decimal(18,2) [note: 'Agreed gross settlement amount with the liable party. May differ from demand amount due to negotiation, comparative negligence, or policy limits of the liable party.']
  settlement_date date [note: 'Date a settlement agreement was reached with the liable party or their insurer. Triggers final payment processing and closure of the subrogation pursuit.']
  siu_referral_indicator boolean [note: 'Indicates whether the subrogation file has been referred to the Special Investigations Unit (SIU) for fraud investigation related to the liable party or loss circumstances.']
  state_of_loss varchar [note: 'Two-letter US state code where the loss occurred. Determines applicable subrogation statutes, comparative negligence rules, and statute of limitations periods.']
  statute_of_limitations_date date [note: 'Date by which legal action must be filed to preserve the subrogation right. Calculated from loss date per applicable state statute. Critical for diary and case management.']
  subrogation_type varchar [note: 'Legal basis of the recovery action: Subrogation (insurer steps into insured\'s rights), Contribution (recovery from co-insurer), or Indemnification (contractual hold-harmless recovery).']
  suit_filed_date date [note: 'Date the subrogation lawsuit was filed in court. Marks the transition from pre-litigation to litigation phase and triggers enhanced reserve and expense tracking.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the subrogation record. Used for change data capture, audit trail, and incremental ETL processing in the lakehouse.']

  Note: 'Master record for a subrogation pursuit against a liable third party. Tracks demand amount, collected amount, attorney assignment, litigation status, settlement date, and net recovery after expenses per claim.'
}

Table claimfinancials.salvage {
  salvage_id varchar [pk, note: 'BIGINT']
  accounting_period_id varchar [note: 'Reference to the accounting period in which salvage proceeds are recognized for statutory and GAAP reporting.']
  buyer_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Salvage buyers (auto auctions, scrap dealers) must be tracked as parties for 1099 tax reporting, OFAC screening, and fraud detection.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: salvage.catastrophe_code is a denormalized string representing the catastrophe_event entity.']
  claim_exposure_id varchar [note: 'BIGINT']
  claim_id varchar [note: 'Reference to the parent claim under which this salvage activity is recorded.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Salvage auction proceeds, storage costs, and net salvage calculations require currency master for multi-currency total loss settlements, reinsurance salvage share allocation, and functional']
  insured_risk_id varchar [note: 'Reference to the insured risk (vehicle, property, etc.) that is the subject of salvage disposition.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Salvage disposition processes and recovery rates differ materially by LOB (auto total-loss vs. commercial property salvage).']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: Salvage items are recovered from specific policy losses for net loss calculation, total loss determination, and deductible application. Policy linkage required for accurate loss cost analysis.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Salvage must link to policy term to match salvage proceeds with the original loss term for accurate net loss ratio and loss development reporting.']
  riskexposure_property_risk_id varchar [note: 'Foreign key linking to riskexposure.property_risk. Business justification: Salvage teams coordinate property demolition, environmental remediation, and land sale with specific property characteristics.']
  riskexposure_vehicle_id varchar [note: 'Foreign key linking to riskexposure.vehicle. Business justification: Salvage vendors require VIN, title number, and vehicle specifications for auction processing and title transfer.']
  vendor_payee_id varchar [note: 'Foreign key linking to claimfinancials.payee. Business justification: Salvage has vendor_name and vendor_code (STRING) for the salvage vendor (auction house, salvage yard). Vendors are payees. Adding vendor_payee_id FK normalizes vendor master data.']
  assigned_date date [note: 'Date the salvage item was formally assigned to the salvage vendor or auction house for disposition.']
  auction_date date [note: 'Date on which the salvaged item was auctioned or sold. Used to align proceeds recognition with the correct accounting period.']
  auction_fee decimal(18,2) [note: 'Fee charged by the auction house or salvage vendor for facilitating the sale, deducted from gross proceeds to arrive at net salvage.']
  auction_proceeds decimal(18,2) [note: 'Gross cash proceeds received from the auction or direct sale of the salvaged item before deducting storage, towing, and auction fees.']
  buyer_type varchar [note: 'Classification of the salvage buyer. Determines applicable title transfer rules and tax reporting obligations.']
  certificate_number varchar [note: 'Certificate of destruction or salvage certificate number issued by the state DMV or relevant authority for the disposed item.']
  closed_date date [note: 'Date the salvage activity was closed, indicating all proceeds collected, title transferred, and financials reconciled.']
  created_timestamp timestamp [note: 'Timestamp when the salvage record was first created in the claims management system.']
  disposition_method varchar [note: 'Method by which the salvaged item is disposed of. Impacts net salvage calculation and title transfer obligations.']
  gl_account_code varchar [note: 'GL account code to which the net salvage proceeds are posted in the statutory and GAAP general ledger.']
  insured_retained_indicator boolean [note: 'Indicates whether the insured elected to retain the salvaged item, resulting in a deduction from the total-loss settlement payment.']
  insured_retention_deduction decimal(18,2) [note: 'Amount deducted from the total-loss settlement when the insured elects to retain the salvaged item, equal to the salvage value estimate.']
  item_description varchar [note: 'Free-text description of the salvaged item including make, model, year, condition, or property type to support valuation and disposition.']
  net_salvage_amount decimal(18,2) [note: 'Net proceeds from salvage after deducting storage, towing, and auction fees from gross auction proceeds. Credited against claim payments.']
  notes varchar [note: 'Free-text adjuster notes capturing disposition decisions, buyer negotiations, title issues, or other relevant salvage activity details.']
  number varchar [note: 'Externally visible business identifier for the salvage record, used in bordereaux, vendor communications, and regulatory filings.']
  reinsurance_recoverable_indicator boolean [note: 'Indicates whether a portion of the net salvage proceeds is recoverable by or creditable to a reinsurer under treaty or facultative agreement.']
  reinsurance_salvage_share decimal(18,2) [note: 'Portion of net salvage proceeds attributable to reinsurers under applicable treaty or facultative agreement, per SSAP No. 62R.']
  salvage_status varchar [note: 'Current lifecycle state of the salvage activity. Drives workflow in ClaimCenter Recovery module and financial recognition timing.']
  salvage_type varchar [note: 'Classification of the salvage by asset category. Determines applicable disposition rules, title transfer requirements, and accounting treatment.']
  siu_referral_indicator boolean [note: 'Indicates whether this salvage activity has been referred to the SIU for fraud investigation (e.g., staged total loss).']
  state_code varchar [note: 'Two-letter US state code where the salvage activity occurs, used for state DOI reporting and title transfer jurisdiction.']
  storage_cost decimal(18,2) [note: 'Cumulative cost of storing the salvaged item from date of loss to date of disposition, deducted from gross proceeds.']
  storage_end_date date [note: 'Date the salvaged item was removed from storage upon sale, transfer, or destruction.']
  storage_location varchar [note: 'Address or facility name where the salvaged item is stored pending auction or disposition.']
  storage_start_date date [note: 'Date the salvaged item entered storage, used to calculate accrued storage costs and vendor billing.']
  title_number varchar [note: 'State-issued salvage title number assigned to the vehicle or property after total-loss declaration, required for legal resale.']
  title_received_date date [note: 'Date the insurer physically received the signed title document from the insured, initiating the transfer process.']
  title_transfer_date date [note: 'Date on which the title of the salvaged item was legally transferred from the insured to the insurer or designated buyer.']
  title_transfer_status varchar [note: 'Status of the vehicle or property title transfer from the insured to the insurer or salvage buyer. Required for total-loss compliance.']
  total_loss_indicator boolean [note: 'Indicates whether the insured item was declared a total loss, triggering full salvage disposition and title transfer requirements.']
  towing_cost decimal(18,2) [note: 'Cost of towing or transporting the salvaged item to the storage yard or auction facility, deducted from gross proceeds.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the salvage record, supporting audit trail and change tracking requirements.']
  value_estimate decimal(18,2) [note: 'Appraised or estimated market value of the salvaged item prior to auction or sale, used to set reserve and evaluate offers.']
  vin varchar [note: '17-character Vehicle Identification Number for salvaged vehicles, used for title transfer, DMV reporting, and CLUE database updates.']

  Note: 'Grain: one row per salvage financial movement per claim exposure. Records proceeds recovered by taking title to damaged property. FK to claim_exposure_id and accounting_period_id. PK: salvage_id.'
}

Table claimfinancials.claim_expense {
  claim_expense_id varchar [pk, note: 'Unique surrogate identifier for each claim expense transaction record. Primary key for the claim_expense table. One row per expense movement per claim exposure and accounting period.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this expense transaction is recognized for statutory and GAAP financial reporting purposes.']
  adjuster_id varchar [note: 'Reference to the claims adjuster responsible for authorizing or submitting this expense. Links expense to the handling adjuster for workload and cost reporting.']
  approved_by_party_id varchar [note: 'Reference to the party (adjuster supervisor or manager) who approved this expense transaction. Required for audit trail and authority-level compliance.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Cat treaties frequently cover ALAE and ULAE. Insurers must aggregate LAE by cat event for reinsurance treaty billing and NAIC Schedule P cat reporting.']
  claim_exposure_id varchar [note: 'Reference to the claim exposure (coverage line within a claim) to which this expense is allocated. Links expense to the specific coverage and insured risk.']
  claim_id varchar [note: 'Reference to the parent claim record. Enables direct claim-level aggregation of all expense transactions without joining through claim exposure.']
  claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: Defense costs and medical expenses (is_dcc_expense flag confirms this) are incurred per claimant.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: LAE allocation to coverage line is required for Schedule P reporting, reinsurance bordereaux, and actuarial reserving.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Multi-currency claim expense processing (foreign adjuster fees, international expert invoices, cross-border legal costs) requires currency master for functional currency conversion']
  financial_transaction_id varchar [note: 'The native transaction identifier from the originating system of record (e.g., Guidewire ClaimCenter expense ID). Enables traceability back to the source system.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: LAE allocation, expense ratio monitoring, and reinsurance expense recovery require LOB master for ALAE vs ULAE classification rules, treaty expense participation, and regulatory']
  litigation_id varchar [note: 'Foreign key linking to claims.litigation. Business justification: Defense costs (is_dcc_expense flag) are billed against specific litigation matters. Legal bill review systems and litigation management platforms require linking DCC expenses to the']
  original_expense_claim_expense_id varchar [note: 'For reversal transactions, references the claim_expense_id of the original expense being reversed. Null for original (non-reversal) expense transactions.']
  payee_id varchar [note: 'Reference to the party record of the vendor or service provider who rendered the service and generated this expense (e.g., law firm, medical examiner, appraiser).']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: Defense and cost containment expenses (ALAE/ULAE) are allocated to policies for combined ratio, expense ratio, and loss adjustment expense ratio analysis. Required for profitability measurement.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: LAE must match to policy term for accurate loss adjustment expense ratio calculations and to align expense recognition with earned premium by underwriting period.']
  ri_claim_cession_id varchar [note: 'Foreign key linking to reinsurance.ri_claim_cession. Business justification: Ceded LAE (Loss Adjustment Expenses) are reported per claim cession in Schedule P Part 2 and reinsurer bordereaux.']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Expense management tracks inspection costs by property type, engineering report costs by construction class, and appraisal fees by vehicle type.']
  accident_year varchar [note: 'The calendar year in which the underlying loss event occurred. Used for accident-year LAE development triangles and actuarial reserving analysis.']
  approval_date date [note: 'Date on which the expense was approved by the authorized approver. Used for SLA measurement and audit trail documentation.']
  approval_status varchar [note: 'Approval workflow status for the expense. Expenses above authority thresholds require supervisor or management approval before payment can be issued.']
  check_number varchar [note: 'Check or EFT reference number issued for payment of this expense. Used for bank reconciliation and positive pay verification. Null for non-check payments.']
  cost_center_code varchar [note: 'Internal cost center or department code responsible for this expense. Supports management reporting, expense allocation, and budget variance analysis.']
  created_timestamp timestamp [note: 'Timestamp when this expense record was first created in the system. Used for audit trail, data lineage, and regulatory record-retention compliance.']
  exchange_rate decimal(18,6) [note: 'Exchange rate applied to convert the expense from transaction currency to functional currency at the transaction date. Stored for audit and restatement purposes.']
  expense_amount decimal(18,2) [note: 'Gross amount of the expense transaction in the policy currency before any adjustments or recoveries. Positive for charges; negative for reversals or credits.']
  expense_date date [note: 'The date on which the expense was incurred or the service was rendered. Used for accident-year and policy-year LAE allocation in Schedule P reporting.']
  expense_description varchar [note: 'Free-text description of the services rendered or expense incurred as provided by the adjuster or vendor. Used for audit review and dispute resolution.']
  expense_number varchar [note: 'Externally visible, human-readable identifier for this expense transaction. Used in vendor correspondence, GL postings, and audit trails.']
  expense_status varchar [note: 'Current workflow state of the expense transaction from initial entry through approval, payment, and potential voiding or dispute resolution.']
  expense_type varchar [note: 'Detailed classification of the nature of the expense. Drives GL account mapping and regulatory cost categorization. [ENUM-REF-CANDIDATE: legal_fee|expert_witness|medical_exam|investigation|appraisal|court_cost|adjuster_fee|other — promote to reference']
  functional_currency_amount decimal(18,2) [note: 'Expense amount converted to the company functional currency (USD) using the exchange rate at transaction date. Used for consolidated statutory and GAAP reporting.']
  gl_account_code varchar [note: 'The GL account code to which this expense is posted in the general ledger. Drives statutory Schedule P line assignment and GAAP income statement classification.']
  invoice_date date [note: 'Date printed on the vendor invoice. Used for accounts payable aging, payment terms calculation, and late-payment penalty assessment.']
  invoice_number varchar [note: 'The invoice or billing reference number issued by the vendor. Used for three-way matching (PO, receipt, invoice) and duplicate payment prevention.']
  invoice_received_date date [note: 'Date the invoice was received by the claims department. Used to measure vendor billing timeliness and trigger payment due-date calculations.']
  is_dcc_expense boolean [note: 'Indicates whether this expense is classified as Defense and Cost Containment (DCC) per NAIC Schedule P definitions. Distinct from AO (Adjusting and Other) expenses.']
  is_recoverable boolean [note: 'Indicates whether this expense is subject to reinsurance recovery under a treaty or facultative agreement. Drives cession and bordereaux reporting.']
  lae_category varchar [note: 'Classifies the expense into LAE sub-categories: ALAE (Allocated LAE), ULAE (Unallocated LAE), DCC (Defense and Cost Containment), or AO (Adjusting and Other). Required for Schedule P.']
  payment_date date [note: 'The date on which the expense was actually disbursed to the vendor or payee. Null if the expense has not yet been paid. Used for cash-basis reporting.']
  payment_method varchar [note: 'Method by which the expense was or will be disbursed to the vendor. Drives accounts payable processing and bank reconciliation workflows.']
  policy_year varchar [note: 'The year in which the policy that generated the underlying claim was effective. Used for policy-year LAE development and reinsurance treaty year allocation.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'Portion of this expense recoverable from reinsurers under applicable treaty or facultative agreements. Used in Schedule F and bordereaux reporting.']
  reversal_flag boolean [note: 'Indicates this transaction is a reversal of a previously posted expense. Reversals carry a negative amount and reference the original transaction via original_expense_id.']
  service_end_date date [note: 'End date of the service period covered by this expense. Together with service_start_date defines the billing period for period-based vendor engagements.']
  service_start_date date [note: 'Start date of the service period covered by this expense (e.g., legal retainer period, expert engagement). Used for period-based expense accrual.']
  siu_referral_flag boolean [note: 'Indicates this expense has been flagged for SIU review due to suspected fraud, inflated billing, or unusual vendor patterns. Triggers SIU workflow.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this expense record was sourced. Supports data lineage, reconciliation, and multi-system integration audits.']
  transaction_date date [note: 'The date the expense transaction was entered or posted in the claims management system. May differ from expense_date for late-reported or backdated entries.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this expense record. Used for incremental data pipeline processing and change-data-capture audit trails.']

  Note: 'One row per expense transaction per claim exposure and accounting period. Classifies LAE into ALAE/ULAE, DCC, and AO categories with vendor, invoice reference, approval status, and GL account. Grain: one row per expense movement.'
}

Table claimfinancials.accounting_period {
  accounting_period_id varchar [pk, note: 'Unique surrogate identifier for each accounting period record. Primary key. _canonical_skip_reason: REFERENCE_LOOKUP — this is a reference calendar/dimension table; per-role minimums are exempt.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Schedule P actuarial development, NAIC statutory filings, and IFRS17 period reporting require each claim accounting period to be anchored to the enterprise calendar dimension.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Multi-currency statutory reporting (GAAP, SAP, IFRS17) requires accounting periods to reference the enterprise currency master for FX rate application and functional-currency translation.']
  prior_period_claimfinancials_accounting_period_id varchar [note: 'Reference to the immediately preceding accounting period. Supports period-over-period variance analysis, loss triangle chaining, and reserve roll-forward calculations.']
  accident_year varchar [note: 'Four-digit accident year for loss development triangles and IBNR estimation. Losses are bucketed by the year the loss event occurred, per actuarial reserving standards.']
  bordereaux_period_code varchar [note: 'Period code used in reinsurance bordereaux submissions to treaty reinsurers. Aligns cession, premium, and loss data to the reinsurer\'s reporting calendar.']
  calendar_year varchar [note: 'Four-digit calendar year (January–December). Used for CY loss ratio, CY written premium, and CY combined ratio analytics per NAIC Schedule P.']
  close_date date [note: 'Date on which the accounting period was officially closed (soft close). After this date, new transactions require a journal entry adjustment or period reopening.']
  created_timestamp timestamp [note: 'Timestamp when this accounting period record was first created in the data platform. Supports audit trail and SOX compliance.']
  end_date date [note: 'Last calendar date included in this accounting period (inclusive). Transactions with an effective date on or before this date fall within the period.']
  fiscal_month varchar [note: 'Month number (1–12) within the fiscal year. Used for monthly close cycles, premium booking, and loss reserve movements in the GL.']
  fiscal_quarter varchar [note: 'Quarter number (1–4) within the fiscal year. Used for quarterly statutory filings, NAIC quarterly statements, and interim GAAP reporting.']
  fiscal_year varchar [note: 'Four-digit fiscal year to which this period belongs (e.g., 2024). Aligns with the company\'s statutory and GAAP reporting year.']
  fx_rate_to_usd decimal(18,8) [note: 'Exchange rate to USD applicable for this period\'s financial translations. Used for multi-currency consolidation in statutory and GAAP reporting.']
  gl_period_code varchar [note: 'Period code as defined in the General Ledger system (Oracle/SAP). Used to reconcile premium, loss, and expense transactions between the data warehouse and the GL.']
  ifrs17_reporting_period varchar [note: 'Period identifier as used in IFRS 17 insurance contract reporting (e.g., \'2024-Q1\'). Supports CSM amortization, loss component tracking, and IFRS 17 disclosure requirements.']
  is_quarter_end boolean [note: 'True if this period is the last month of a fiscal quarter, triggering quarterly NAIC statement preparation and interim GAAP reporting.']
  is_stub_period boolean [note: 'True if this period is a partial period (fewer days than a standard month), such as a company formation period or mid-year fiscal year change.']
  is_year_end boolean [note: 'True if this period represents the final period of the fiscal or calendar year, triggering year-end statutory close, NAIC Annual Statement preparation, and RBC calculations.']
  lock_date date [note: 'Date on which the period was hard-locked, preventing any further postings. Supports SOX controls and statutory filing integrity.']
  loss_development_lag varchar [note: 'Number of months elapsed from the accident year start to this period\'s end date. Used to position the period on loss development triangles for IBNR and IBNER estimation.']
  naic_statement_period varchar [note: 'NAIC filing period designation: Q1, Q2, Q3 for quarterly statements, or ANNUAL for the year-end NAIC Annual Statement. Drives statutory reporting schedules.']
  period_basis varchar [note: 'Actuarial and statutory basis: CY (Calendar Year), AY (Accident Year), PY (Policy Year), or FY (Fiscal Year). Drives loss triangle bucketing and Schedule P reporting.']
  period_code varchar [note: 'Externally-known alphanumeric code uniquely identifying the period (e.g., CY-2024-03 for calendar year 2024 March). Used in GL, statutory, and bordereaux reporting.']
  period_days varchar [note: 'Number of calendar days in this accounting period. Used for daily pro-rata premium earning, exposure day calculations, and IFRS 17 coverage unit computations.']
  period_name varchar [note: 'Human-readable label for the period (e.g., \'March 2024\', \'Q1 2024\', \'AY 2023\'). Used in reports, dashboards, and statutory filings.']
  period_status varchar [note: 'Current state of the period in the financial close lifecycle: OPEN (transactions posting), CLOSED (soft close), LOCKED (hard close, no further postings), REOPENED (adjustment window).']
  period_type varchar [note: 'Granularity of the period: MONTHLY for standard close cycles, QUARTERLY for interim reporting, SEMI_ANNUAL, or ANNUAL for year-end statutory filings.']
  policy_year varchar [note: 'Four-digit policy year for policy-year loss development. Losses and premium are bucketed by the year the policy was written, used in Schedule P and reinsurance bordereaux.']
  premium_earning_method varchar [note: 'Method used to earn written premium into earned premium during this period: PRO_RATA (daily pro-rata), RULE_OF_78, DAILY, or MONTHLY. Drives UEP and EP calculations.']
  reopen_date date [note: 'Date on which a previously closed or locked period was reopened for adjustment postings. Null if the period has never been reopened.']
  reporting_framework varchar [note: 'Accounting framework under which this period is reported: SAP (Statutory Accounting Principles), GAAP (US GAAP/FASB), IFRS17 (IASB IFRS 17), or STATUTORY for state-specific filings.']
  schedule_p_period_label varchar [note: 'Label used to identify this period on NAIC Schedule P loss development exhibits (e.g., \'2024 1 Year\', \'2023 2 Years\'). Supports actuarial reserving and regulatory filing.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this period definition (e.g., \'ORACLE_GL\', \'SAP_FI\'). Supports data lineage and reconciliation.']
  start_date date [note: 'First calendar date included in this accounting period. Transactions with an effective date on or after this date fall within the period.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this accounting period record. Supports change tracking, audit trail, and SOX compliance.']

  Note: 'Reference calendar for financial close cycles. Defines calendar year, accident year, policy year, and fiscal period boundaries used to bucket premium, loss, and expense transactions for statutory and GAAP reporting.'
}

Table claimfinancials.financial_transaction {
  financial_transaction_id varchar [pk, note: 'Unique surrogate key for each atomic double-entry posting generated by a claim financial event. One row per financial movement per claim exposure. Grain: one row per posting.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this financial transaction is recognized for statutory and GAAP reporting purposes.']
  catastrophe_event_id varchar [note: 'Reference to the catastrophe event (CAT) associated with this financial transaction, if the underlying loss is part of a declared catastrophe. Supports CAT loss aggregation and PML reporting.']
  claim_exposure_id varchar [note: 'Reference to the specific coverage line within the claim (Claim Exposure) that this financial movement is attributed to. Drives per-coverage financial reporting.']
  claim_id varchar [note: 'Reference to the parent claim under which this financial movement was generated. Links the posting to the reported loss event.']
  claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: GL postings and bordereaux reporting require claimant-level financial transaction detail in multi-claimant losses.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Financial transactions carry gross, net, and ceded amounts requiring FX conversion for multi-currency GAAP and IFRS17 reporting.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Financial transactions must be allocated to LOB for GAAP/SAP income statement reporting, combined ratio analysis, and Schedule P regulatory filings.']
  original_transaction_financial_transaction_id varchar [note: 'For reversal or correction transactions, references the original financial_transaction_id that this entry offsets or corrects. Null for original (non-reversal) postings.']
  party_id varchar [note: 'System user ID of the adjuster, supervisor, or financial controller who authorized this financial transaction. Required for authority limit compliance and SOX audit trail.']
  payment_id varchar [note: 'Reference to the associated claim payment record when this financial transaction represents a disbursement. Links the GL posting to the payment instrument record for reconciliation.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: All claim financial movements (reserves, payments, recoveries) must tie to the originating policy for financial statement reconciliation, audit trail, and policy-level profitability analysis.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: Financial transactions must link to policy term for accurate period-over-period loss development, earned premium matching, and underwriting year loss ratio analysis.']
  ri_agreement_id varchar [note: 'Reference to the reinsurance agreement (treaty or facultative) under which the ceded portion of this transaction is recoverable. Null if no reinsurance applies.']
  ri_claim_cession_id varchar [note: 'Foreign key linking to reinsurance.ri_claim_cession. Business justification: Ceded loss payments, reserve movements, and recoveries post GL financial_transactions keyed to the claim cession.']
  ri_premium_transaction_id varchar [note: 'Foreign key linking to reinsurance.ri_premium_transaction. Business justification: Ceded written and earned premium transactions post to the GL as financial_transactions.']
  ri_recovery_id varchar [note: 'Foreign key linking to reinsurance.ri_recovery. Business justification: Each RI recovery cash collection posts a financial_transaction (debit cash, credit reinsurance recoverable).']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Statutory Schedule P reporting, loss development triangles, and reinsurance bordereau require GL postings to reference the insured risk for risk-class segmentation.']
  salvage_id varchar [note: 'Reference to the associated salvage record when this financial transaction represents a salvage recovery. Links the GL posting to the salvage disposition record.']
  accident_year varchar [note: 'The calendar year in which the loss event (accident) occurred. Used for accident year (AY) loss development triangles and actuarial reserving analysis per NAIC Schedule P.']
  ap_batch_number varchar [note: 'Identifier of the accounts payable batch run in which this financial transaction was processed and disbursed. Used for payment reconciliation and GL batch balancing.']
  authority_limit_amount decimal(18,2) [note: 'The financial authority limit of the approving user at the time of authorization. Confirms the transaction was within delegated authority and supports SOX internal controls.']
  calendar_year varchar [note: 'The calendar year in which this financial transaction was posted. Used for calendar year (CY) incurred loss and paid loss reporting in statutory financial statements.']
  ceded_amount decimal(18,2) [note: 'Portion of the gross amount ceded to reinsurers under applicable treaty or facultative agreements. Used for net retained loss calculation and reinsurance bordereaux reporting.']
  cost_center_code varchar [note: 'Organizational cost center to which this financial transaction is allocated for internal management accounting and expense reporting purposes.']
  coverage_type_code varchar [note: 'Code identifying the specific coverage type (e.g., BI, PD, COMP, COLL, MED_PAY, UM/UIM) associated with this financial posting. Enables coverage-level financial analysis.']
  created_timestamp timestamp [note: 'Date and time when this financial transaction record was first created in the claims management system. Supports audit trail and data lineage requirements.']
  current_balance_amount decimal(18,2) [note: 'The reserve or financial balance on the claim exposure immediately after this transaction was applied. Supports outstanding loss reserve (OSLR) and IBNR reporting.']
  deductible_offset_amount decimal(18,2) [note: 'Amount of the financial transaction attributable to the insured\'s deductible or self-insured retention (SIR), reducing the insurer\'s net liability on this posting.']
  effective_date date [note: 'The date from which this financial transaction is effective for accounting and reserving purposes. May differ from transaction_date for backdated adjustments or period corrections.']
  expense_category varchar [note: 'For expense-type transactions, classifies the LAE component: DCC (Defense and Cost Containment), AO (Adjusting and Other), ULAE (Unallocated Loss Adjustment Expense). Null for non-expense transactions.']
  gl_account_code varchar [note: 'The GL account code to which this financial transaction is posted in the general ledger system (Oracle/SAP). Enables reconciliation between claims system and statutory financial statements.']
  gross_amount decimal(18,2) [note: 'The full gross monetary amount of this financial posting before any reinsurance, deductible, or offset adjustments. Positive for charges/losses; negative for recoveries/credits.']
  loss_category varchar [note: 'Categorizes the financial movement by loss component: INDEMNITY (property/liability loss), MEDICAL (bodily injury medical), LAE (loss adjustment expense), ALAE (allocated LAE), ULAE (unallocated LAE), OTHER.']
  net_amount decimal(18,2) [note: 'Net retained amount after deducting ceded reinsurance and deductible offsets from the gross amount. Represents the insurer\'s ultimate net loss (UNL) for this posting.']
  policy_year varchar [note: 'The year in which the policy that generated this claim was effective. Used for policy year (PY) loss development and underwriting year profitability analysis.']
  posted_timestamp timestamp [note: 'Date and time when this financial transaction was posted to the general ledger and claims system. Used for audit trail and reconciliation with GL batch runs.']
  prior_balance_amount decimal(18,2) [note: 'The reserve or financial balance on the claim exposure immediately before this transaction was applied. Enables incremental change analysis and reserve development tracking.']
  reinsurance_recoverable_indicator boolean [note: 'Indicates whether any portion of this financial transaction is recoverable from reinsurers under a treaty or facultative agreement. Drives reinsurance bordereaux and Schedule F reporting.']
  reserve_type varchar [note: 'For reserve transactions, identifies the reserve category: CASE (case reserve set by adjuster), IBNR (incurred but not reported), IBNER (incurred but not enough reported), LAE (loss adjustment expense reserve). Null for non-reserve transactions.']
  reversal_indicator boolean [note: 'Indicates whether this transaction is a reversal (offsetting entry) of a previously posted financial transaction. True if this is a correcting reversal entry.']
  siu_referral_flag boolean [note: 'Indicates whether this financial transaction has been flagged for review by the Special Investigations Unit (SIU) due to suspected fraud or irregularity.']
  source_system_code varchar [note: 'Identifies the operational system of record that originated this financial transaction (e.g., CLAIMCENTER, DUCK_CREEK, GL, MANUAL, REINS_PRO). Supports data lineage and reconciliation.']
  source_transaction_reference varchar [note: 'The native transaction identifier or reference number from the originating source system (e.g., ClaimCenter transaction ID, GL journal entry number). Enables cross-system reconciliation.']
  state_code varchar [note: 'Two-letter US state code for the jurisdiction in which this financial transaction is reported. Required for state-level statutory reporting to Departments of Insurance (DOI).']
  transaction_date date [note: 'The business date on which the financial event occurred (e.g., reserve change effective date, payment issue date, recovery receipt date). Principal real-world event date for this posting.']
  transaction_description varchar [note: 'Free-text narrative describing the reason for or nature of this financial posting (e.g., \'Initial case reserve set at FNOL\', \'Partial indemnity payment to claimant\'). Supports adjuster notes.']
  transaction_number varchar [note: 'Externally visible, human-readable reference number assigned to this financial posting by the claims management or general ledger system. Used for audit trails and reconciliation.']
  transaction_status varchar [note: 'Current lifecycle state of the financial posting: PENDING (awaiting approval), POSTED (booked to GL), REVERSED (offset entry created), VOIDED (cancelled before posting), APPROVED (authorized, not yet posted).']
  transaction_subtype varchar [note: 'Granular classification within the transaction type. Examples: CASE_RESERVE, IBNR_RESERVE, LAE_RESERVE, INDEMNITY_PAYMENT, MEDICAL_PAYMENT, SUBROGATION_RECOVERY, SALVAGE_RECOVERY, REINSURANCE_RECOVERY, DCC_EXPENSE, AO_EXPENSE.']
  transaction_type varchar [note: 'High-level category of the financial movement: RESERVE (case/IBNR/LAE reserve), PAYMENT (indemnity/LAE disbursement), RECOVERY (subrogation/salvage/reinsurance), or EXPENSE (DCC/AO/ULAE).']
  updated_timestamp timestamp [note: 'Date and time when this financial transaction record was last modified. Tracks corrections, reversals, and status changes for audit and reconciliation purposes.']

  Note: 'One row per atomic double-entry posting generated by a claim financial event (reserve, payment, recovery, expense), keyed to claim exposure and accounting period.'
}

Table claimfinancials.reinsurance_recovery {
  reinsurance_recovery_id varchar [pk, note: 'Unique surrogate identifier for each reinsurance recovery billing record. One row per reinsurance recovery billing per claim exposure and treaty or facultative agreement.']
  accounting_period_id varchar [note: 'Reference to the accounting period in which this recovery transaction is recognized for statutory and GAAP financial reporting.']
  catastrophe_event_id varchar [note: 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Cat treaty recoveries are triggered by specific cat events. Reinsurance_recovery records must link to the triggering cat event for treaty-level settlement, cash call']
  cession_id varchar [note: 'Reference to the reinsurance cession record that establishes the cedant\'s share ceded to the reinsurer under the applicable agreement.']
  claim_exposure_id varchar [note: 'Reference to the specific coverage line (claim exposure) within the claim to which this recovery applies.']
  claim_id varchar [note: 'Reference to the parent claim from which this reinsurance recovery originates.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reinsurance recoveries frequently involve cross-currency settlements (USD cedant, London market reinsurer in GBP).']
  financial_transaction_id varchar [note: 'Foreign key linking to claimfinancials.financial_transaction. Business justification: Reinsurance recovery billings and collections generate financial_transaction postings (ceded loss recoverable, cash received).']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Reinsurance recoveries are tracked by LOB for treaty compliance, Schedule F statutory filings, and bordereaux reporting to reinsurers.']
  policy_id varchar [note: 'Foreign key linking to policy.policy. Business justification: Reinsurance recoveries on claims must link to the ceded policy for treaty settlement, bordereaux reporting, and ceded loss ratio analysis. Required for reinsurance accounting and reconciliation.']
  policy_term_id varchar [note: 'Foreign key linking to policy.term. Business justification: RI recoveries must match to policy term for accurate ceded loss ratio calculations, treaty performance analysis, and to align recovery timing with ceded premium by term.']
  reinsurer_id varchar [note: 'Foreign key linking to reinsurance.reinsurer. Business justification: Reinsurer AR aging, credit limit monitoring, and Schedule F reporting require grouping reinsurance_recovery records by reinsurer entity.']
  reinsurer_party_id varchar [note: 'Reference to the party record representing the reinsurer from whom recovery is sought.']
  ri_agreement_id varchar [note: 'Reference to the reinsurance agreement (treaty or facultative) under which this recovery is billed.']
  ri_claim_cession_id varchar [note: 'Foreign key linking to reinsurance.ri_claim_cession. Business justification: reinsurance_recovery tracks cash collections against claim-level cessions for bordereaux reconciliation.']
  ri_participant_id varchar [note: 'Foreign key linking to reinsurance.ri_participant. Business justification: Treaty participation shares determine each reinsurer\'s recovery allocation. ri_participant defines signed-line percentages; linking reinsurance_recovery to ri_participant enables']
  ri_recovery_id varchar [note: 'FK to reinsurance.ri_recovery.ri_recovery_id — Links the cedant-side reinsurance recovery accrual to the reinsurance ceded-loss ledger so ceded recovery is booked once and reconciled, preventing double-counting of recoverables (VREQ-009/VREQ-014).']
  riskexposure_insured_risk_id varchar [note: 'Foreign key linking to riskexposure.insured_risk. Business justification: Per-risk excess of loss reinsurance recovery billing requires the insured risk TIV, construction class, and territory for treaty layer determination and NAIC Schedule F reporting.']
  accident_year varchar [note: 'Calendar year in which the loss event occurred. Used for actuarial loss triangle development and reinsurance bordereaux reporting.']
  agreement_type varchar [note: 'Indicates whether the recovery is under a treaty (automatic) or facultative (individually negotiated) reinsurance agreement.']
  attachment_point decimal(18,2) [note: 'The loss threshold above which the reinsurer\'s obligation begins under an Excess of Loss (XOL) or Stop Loss (SL) treaty layer.']
  authorized_control_level_flag boolean [note: 'Indicates whether the reinsurer is an authorized (admitted) reinsurer for statutory credit purposes, affecting RBC and Schedule F treatment.']
  billing_date date [note: 'The date on which the reinsurance recovery was billed to the reinsurer. Principal business event date for this transaction.']
  bordereaux_period varchar [note: 'The reporting period (YYYY-MM or YYYY-Q#) in which this recovery is included in the reinsurance bordereaux submission to the reinsurer.']
  cash_call_indicator boolean [note: 'Indicates whether this recovery was billed as an interim cash call to the reinsurer prior to final claim settlement, as permitted under large-loss provisions.']
  ceded_lae_amount decimal(18,2) [note: 'Loss Adjustment Expense (LAE) amount ceded to the reinsurer, including both Allocated LAE (ALAE) and Unallocated LAE (ULAE) where applicable.']
  ceded_loss_amount decimal(18,2) [note: 'Gross indemnity loss amount ceded to the reinsurer under the applicable agreement for this claim exposure. Excludes LAE.']
  cession_percentage decimal(7,4) [note: 'The percentage of the loss ceded to the reinsurer under the applicable agreement, expressed as a decimal (e.g., 0.7500 = 75%). Applicable primarily to quota share treaties.']
  collateral_held_amount decimal(18,2) [note: 'Amount of collateral (letters of credit, trust funds) held from the reinsurer that can be applied against this outstanding recovery balance.']
  collection_date date [note: 'The date on which the recovery amount was actually received from the reinsurer. Null if not yet collected.']
  commutation_indicator boolean [note: 'Flags whether this recovery record has been settled via a commutation agreement, extinguishing future obligations between cedant and reinsurer.']
  coverage_type_code varchar [note: 'Code identifying the coverage type within the claim exposure (e.g., dwelling, liability, collision, comprehensive). Drives treaty layer applicability.']
  created_timestamp timestamp [note: 'Timestamp when this reinsurance recovery record was first created in the Reinsurance Management System.']
  days_overdue varchar [note: 'Number of calendar days the outstanding recovery balance has been past the contractual due date. Used for Schedule F aging buckets and credit risk monitoring.']
  disputed_amount decimal(18,2) [note: 'Portion of the billed recovery amount that the reinsurer has formally disputed. Tracked separately for collections and reserving purposes.']
  due_date date [note: 'Contractual due date by which the reinsurer is obligated to remit the recovery amount per the reinsurance agreement terms.']
  gl_account_code varchar [note: 'General Ledger account code to which this reinsurance recovery is posted in the statutory and GAAP financial statements.']
  loss_date date [note: 'Date of the underlying loss event. Used to determine which treaty year and layer applies for accident year (AY) and policy year (PY) reporting.']
  notes varchar [note: 'Free-text notes entered by reinsurance analysts documenting dispute details, collection actions, commutation terms, or other recovery-specific commentary.']
  outstanding_balance decimal(18,2) [note: 'Unpaid balance owed by the reinsurer, calculated as recovery billed minus recovery collected. Used for Schedule F overdue reporting.']
  overdue_indicator boolean [note: 'Flags recoveries where the outstanding balance has exceeded the contractual due date. Drives NAIC Schedule F overdue reinsurance reporting.']
  policy_year varchar [note: 'Year in which the policy that generated the claim was written. Used for policy year (PY) reinsurance treaty allocation and bordereaux.']
  recovery_billed_amount decimal(18,2) [note: 'Total amount billed to the reinsurer for this recovery, combining ceded loss and ceded LAE. Represents the gross recovery claim submitted.']
  recovery_collected_amount decimal(18,2) [note: 'Actual amount received from the reinsurer to date. May be less than billed if partial payment or dispute exists.']
  recovery_number varchar [note: 'Externally-known business identifier for this recovery billing, used in bordereaux reporting and reinsurer correspondence. Assigned by the Reinsurance Management System.']
  recovery_status varchar [note: 'Current lifecycle state of the recovery billing. Tracks progression from initial billing through collection or write-off.']
  recovery_type varchar [note: 'Classifies the nature of the recovery: indemnity loss, Loss Adjustment Expense (LAE), combined loss and LAE, salvage share, or subrogation share.']
  reinsurer_limit decimal(18,2) [note: 'Maximum amount the reinsurer is obligated to pay under the applicable treaty layer or facultative certificate for this claim.']
  retention_amount decimal(18,2) [note: 'The portion of the loss retained by the cedant (Pc_Insurance) after cession. For XOL treaties, this equals the Self-Insured Retention (SIR) or attachment point.']
  settlement_reference varchar [note: 'Reference number of the reinsurance settlement or cash call under which this recovery was remitted by the reinsurer.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this recovery record was sourced (e.g., SAPIENS for Sapiens ReinsurancePro, SICS, or MANUAL for manual entries).']
  treaty_type varchar [note: 'Specifies the treaty structure: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), or Catastrophe Excess of Loss (CAT XL). Null for facultative agreements.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this reinsurance recovery record.']
  written_off_amount decimal(18,2) [note: 'Amount of the recovery deemed uncollectible and written off, typically due to reinsurer insolvency or commutation agreement.']

  Note: 'One row per reinsurance recovery billing per claim exposure and treaty or facultative agreement. Tracks ceded loss amount, ceded LAE, recovery billed, recovery collected, and outstanding balance. Links claim to reinsurance cession.'
}

Table claimfinancials.payee {
  payee_id varchar [pk, note: 'Unique surrogate identifier for the payee master record. One row per party designated to receive claim payments. MASTER_PARTY role.']
  claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: Payee records are created from claimant records when payments are issued. Linking payee to claimant supports OFAC screening traceability, duplicate payee detection, 1099 reporting accuracy']
  party_id varchar [note: 'Reference to the enterprise Party master record for this payee, enabling linkage to the canonical party identity and deduplication via Customer/Party MDM.']
  preferred_currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: International payee management requires currency master for payment processing in payee\'s preferred currency, withholding tax calculation, bank account validation, and 1099/tax reporting.']
  address_line1 varchar [note: 'Primary street address line for the payee. Used for check mailing, 1099 form delivery, and OFAC/fraud screening. Required for all check-based payment methods.']
  address_line2 varchar [note: 'Secondary address line (suite, apartment, unit, floor) for the payee. Supplements address_line1 for complete mailing address on checks and 1099 forms.']
  attorney_bar_number varchar [note: 'State bar license number for payees classified as attorneys. Used to validate attorney payees in ClaimCenter and supports regulatory reporting of legal expense payments.']
  backup_withholding_flag boolean [note: 'Indicates whether the payee is subject to IRS backup withholding (currently 24%). Set when TIN is missing, unverified, or IRS notifies the payer of withholding obligation.']
  bank_account_number varchar [note: 'Payee\'s bank account number for EFT/ACH disbursements. Stored in tokenized or encrypted form per PCI DSS and GLBA requirements. Required when payment_method is EFT or wire.']
  bank_account_type varchar [note: 'Type of bank account used for EFT disbursements: checking or savings. Required by NACHA for ACH transaction formatting and return code handling.']
  bank_name varchar [note: 'Name of the financial institution holding the payee\'s account. Used for EFT remittance documentation and payment reconciliation in the General Ledger.']
  bank_routing_number varchar [note: 'ABA routing transit number (9 digits) identifying the payee\'s financial institution for ACH/EFT transactions. Required when payment_method is EFT or wire.']
  city varchar [note: 'City of the payee\'s mailing address. Required for check issuance, 1099 reporting, and OFAC geographic screening.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the payee\'s mailing address (e.g., USA, CAN). Drives OFAC screening, foreign payment rules, and FATCA/FBAR reporting obligations.']
  created_timestamp timestamp [note: 'Timestamp when the payee record was first created in the Claims Management System. Supports audit trail, SOX compliance, and data lineage tracking.']
  do_not_pay_flag boolean [note: 'Hard stop flag that prevents any payment from being issued to this payee. Set by compliance, SIU, or legal hold. Overrides all payment authorizations until manually cleared.']
  effective_date date [note: 'Date from which this payee record is valid and eligible to receive payments. Supports temporal validity tracking for payee lifecycle management and audit compliance.']
  email varchar [note: 'Primary email address for the payee. Used for EFT remittance advice delivery, payment notifications, and electronic 1099 delivery where consent is obtained.']
  entity_type varchar [note: 'Indicates whether the payee is a natural person (individual) or a legal entity (organization). Determines which tax identification type applies and governs 1099/W-9 requirements.']
  expiration_date date [note: 'Date after which this payee record is no longer eligible to receive payments. Null indicates an open-ended active payee. Used for attorney retainer expiry and vendor contract end dates.']
  fraud_indicator_flag boolean [note: 'Indicates whether the Fraud Detection/SIU system has flagged this payee as a potential fraud risk based on pattern analysis, prior SIU findings, or external data sources (e.g., NICB).']
  guardian_name varchar [note: 'Full legal name of the court-appointed guardian or conservator when the payee is a minor or legally incapacitated. Payments are issued in the guardian\'s name on behalf of the payee.']
  is_1099_reportable boolean [note: 'Indicates whether payments to this payee are subject to IRS 1099 reporting. Drives year-end tax reporting workflows and AP batch processing in the General Ledger system.']
  is_minor boolean [note: 'Indicates whether the payee is a minor (under 18). Triggers guardian/conservator payment controls, court approval requirements, and special handling in ClaimCenter payment workflows.']
  is_structured_settlement boolean [note: 'Indicates whether payments to this payee are part of a structured settlement annuity arrangement. Triggers specialized payment scheduling, tax treatment, and regulatory disclosure requirements.']
  lien_holder_flag boolean [note: 'Indicates whether the payee holds a lien or security interest on the insured property. When true, the payee must be co-payee on property damage payments per standard mortgage/lien clauses.']
  number varchar [note: 'Externally visible, human-readable identifier assigned to the payee by the Claims Management System (e.g., PAY-000012345). Used on checks, EFT remittances, and 1099 filings.']
  ofac_match_flag boolean [note: 'Indicates whether the payee returned a potential match against the OFAC SDN list during screening. A true value triggers a compliance hold and manual review before payment release.']
  ofac_screen_date date [note: 'Most recent date on which the payee was screened against the OFAC SDN and consolidated sanctions lists. Supports periodic re-screening compliance requirements.']
  ofac_screened boolean [note: 'Indicates whether the payee has been screened against the OFAC Specially Designated Nationals (SDN) list. Payments to blocked persons are prohibited under U.S. sanctions law.']
  payee_name varchar [note: 'Full legal name of the payee as it must appear on the payment instrument (check or EFT). For individuals this is the legal name; for entities the registered business name.']
  payee_status varchar [note: 'Current lifecycle state of the payee record. Blocked payees cannot receive payments until cleared by SIU or compliance review. Drives payment eligibility checks in ClaimCenter.']
  payee_type varchar [note: 'Classifies the payee\'s role in the payment transaction. Drives 1099 reporting rules, authority limits, and payment workflow routing within ClaimCenter.']
  payment_method varchar [note: 'Preferred or designated payment instrument for disbursements to this payee: check, EFT (ACH), wire transfer, Zelle, or other. Drives payment routing in BillingCenter and ClaimCenter.']
  phone varchar [note: 'Primary contact phone number for the payee. Used for payment confirmation, returned check follow-up, and EFT pre-notification as required by NACHA rules.']
  postal_code varchar [note: 'ZIP or ZIP+4 postal code for the payee\'s mailing address. Required for check delivery, 1099 filing, and USPS address validation.']
  siu_referral_flag boolean [note: 'Indicates whether this payee has been referred to the Special Investigations Unit (SIU) for fraud screening. A true value places a payment hold pending SIU clearance.']
  source_system_code varchar [note: 'Identifies the operational system of record that originated this payee record (e.g., CLAIMCENTER, BILLINGCENTER, MDM). Supports data lineage and master data reconciliation.']
  tax_id_type varchar [note: 'Classifies the tax_id field: SSN (Social Security Number), FEIN (Federal Employer Identification Number), ITIN (Individual Taxpayer Identification Number), or EIN (Employer Identification Number).']
  tax_id_verified boolean [note: 'Indicates whether the payee\'s TIN has been validated against IRS TIN Matching or equivalent verification service. Required before issuing 1099 forms.']
  tax_number varchar [note: 'Federal tax identifier for the payee: Social Security Number (SSN) for individuals or Federal Employer Identification Number (FEIN) for organizations. Required for IRS 1099 reporting.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the payee record. Used for change data capture (CDC), audit trail, and downstream Silver layer incremental processing.']
  vendor_code varchar [note: 'Internal vendor identifier assigned by the Accounts Payable system (Oracle/SAP) for payees classified as vendors (e.g., repair shops, medical providers, appraisers). Enables AP reconciliation.']
  w9_received boolean [note: 'Indicates whether a completed IRS Form W-9 (Request for Taxpayer Identification Number and Certification) has been received from the payee. Required before releasing payments subject to backup withholding.']
  w9_received_date date [note: 'Date on which the IRS Form W-9 was received from the payee. Used to establish the effective date of TIN certification and backup withholding exemption.']

  Note: 'Master record for a party designated to receive claim payments. Captures payee name, tax ID (SSN/FEIN), address, bank account for EFT, 1099 reporting flag, and payee type (claimant, attorney, vendor, lienholder).'
}

Table producers.producers_producer {
  producers_producer_id varchar [pk, note: 'Unique surrogate identifier for each licensed insurance producer record. Primary key. One row per producer.']
  distribution_channel_id varchar [note: 'Reference to the distribution channel through which this producer operates (e.g., independent agent, direct, broker, MGA).']
  party_id varchar [note: 'Foreign key linking to party.party. Business justification: Every producer is a party in the master registry. Links producer identity to KYC/OFAC screening, fraud indicators, license verification, contact management, and regulatory reporting.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Territory-level production tracking and binding authority validation require knowing which rating territory a producer is authorized for.']
  appointment_effective_date date [note: 'Date the producer\'s appointment with Pc_Insurance became effective. Marks the start of the producer\'s authority to bind business.']
  appointment_status varchar [note: 'Current appointment status of the producer with the insurer. Drives eligibility to bind business. Lifecycle: pending -> active -> suspended/terminated.']
  appointment_termination_date date [note: 'Date the producer\'s appointment with Pc_Insurance was terminated. Null if appointment is currently active.']
  background_check_date date [note: 'Date the most recent background check was completed. Used to determine if a refresh is required per appointment policy.']
  background_check_status varchar [note: 'Status of the most recent background check conducted on the producer as part of the appointment process.']
  bank_account_reference varchar [note: 'Tokenized or masked reference to the producer\'s bank account used for ACH commission disbursements. Full account data stored in payment vault.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has delegated binding authority to issue policies on behalf of Pc_Insurance without prior underwriting approval.']
  binding_authority_limit decimal(18,2) [note: 'Maximum single-risk premium or TIV the producer may bind without referral to underwriting. Null if binding_authority_flag is false.']
  commission_schedule_code varchar [note: 'Code identifying the commission schedule applicable to this producer. Drives commission calculation on premium transactions.']
  contingent_commission_eligible boolean [note: 'Indicates whether the producer is eligible for contingent (profit-sharing) commission based on loss ratio and volume performance.']
  continuing_education_due_date date [note: 'Date by which the producer must complete state-mandated continuing education (CE) credits to maintain licensure.']
  continuing_education_hours_completed decimal(5,1) [note: 'Number of continuing education credit hours completed in the current CE cycle. Tracked against state-mandated minimums.']
  created_timestamp timestamp [note: 'Timestamp when the producer record was first created in the Producer/Agency Management System. Audit trail field.']
  default_commission_rate decimal(7,4) [note: 'Default commission rate (as a decimal, e.g., 0.1200 = 12%) applied to written premium for this producer absent a line-specific override.']
  eo_carrier_name varchar [note: 'Name of the insurance carrier providing the producer\'s Errors & Omissions (E&O) professional liability coverage.']
  eo_coverage_amount decimal(18,2) [note: 'Per-occurrence limit of the producer\'s E&O professional liability policy in USD. Used to verify minimum coverage requirements.']
  eo_expiration_date date [note: 'Expiration date of the producer\'s E&O professional liability policy. Triggers renewal reminder and potential appointment suspension.']
  eo_policy_number varchar [note: 'Policy number of the producer\'s E&O professional liability insurance. Required for appointment and renewal.']
  is_surplus_lines_licensed boolean [note: 'Indicates whether the producer holds a surplus lines broker license, enabling placement of non-admitted coverage.']
  license_class varchar [note: 'Class or type of insurance license held (e.g., Property & Casualty, Life & Health, Personal Lines). Determines lines of business the producer may sell. [ENUM-REF-CANDIDATE: property_casualty|life_health|personal_lines|commercial_lines|surplus_lines —']
  license_effective_date date [note: 'Date the producer\'s resident state license became effective. Used to verify active licensure at time of policy binding.']
  license_expiration_date date [note: 'Date the producer\'s resident state license expires. Triggers renewal workflow and appointment suspension if not renewed.']
  license_number varchar [note: 'Primary state-issued insurance producer license number in the resident state. Additional non-resident licenses are tracked in the Producer Appointment table.']
  lob_authorizations varchar [note: 'Comma-delimited list of lines of business (LOB) codes the producer is authorized to write (e.g., HO, PAP, CGL, BOP, CA). Enforced at submission intake.']
  naic_company_code varchar [note: 'Five-digit NAIC code of the insurer entity appointing this producer. Used in Schedule F and state appointment filings.']
  npn varchar [note: 'NIPR-assigned National Producer Number uniquely identifying the producer across all US states. Used for license validation and regulatory reporting.']
  payment_method varchar [note: 'Method by which commission payments are disbursed to the producer (ACH direct deposit, paper check, or wire transfer).']
  producer_role varchar [note: 'Functional role of the producer in the distribution channel. [ENUM-REF-CANDIDATE: agent|broker|managing_general_agent|surplus_lines_broker|independent_agent|captive_agent — promote to reference product]']
  producer_type varchar [note: 'Indicates whether the producer is a natural person (individual) or a business entity (agency/firm). Drives licensing and appointment rules.']
  regulatory_action_flag boolean [note: 'Indicates whether the producer has any open or historical regulatory actions, fines, or license sanctions on record.']
  resident_state_code varchar [note: 'Two-letter US state code of the producer\'s resident (home) state for licensing purposes. Determines reciprocal licensing eligibility.']
  since_date date [note: 'Date the producer first became appointed with Pc_Insurance. Used for tenure-based commission tier calculations and relationship analytics.']
  surplus_lines_license_number varchar [note: 'State-issued surplus lines broker license number. Null if producer is not surplus lines licensed.']
  tax_identification_number varchar [note: 'Federal Employer Identification Number (FEIN) for entity producers or Social Security Number (SSN) for individual producers. Used for IRS 1099 commission reporting.']
  termination_reason varchar [note: 'Reason code for appointment termination. Required for state DOI termination filings. Null if appointment is active.']
  updated_timestamp timestamp [note: 'Timestamp when the producer record was most recently modified. Used for change data capture and audit trail.']
  w9_on_file boolean [note: 'Indicates whether a valid IRS Form W-9 (or W-8 for foreign producers) is on file. Required before commission disbursement.']
  writing_company_code varchar [note: 'NAIC company code of the Pc_Insurance legal entity (writing company) to which this producer is appointed. Supports multi-company insurer groups.']

  Note: 'Master record for every licensed insurance producer (agent or broker). One row per producer. Stores NPN, license numbers, resident state, producer type, appointment status, and E&O coverage details.'
}

Table producers.agency {
  agency_id varchar [pk, note: 'Unique identifier for the insurance agency or brokerage firm. Primary key.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Agency-level premium volume reporting and binding authority limits are currency-denominated.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Agencies operate through a specific distribution channel (captive, independent, broker, direct). Replace STRING distribution_channel_code with FK. N:1 relationship.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Agencies are assigned service territories defined in geography hierarchy. Used for producer appointment validation (ensuring producer is appointed in geography where risk is']
  parent_agency_id varchar [note: 'Reference to the parent agency for hierarchical relationships such as MGA to sub-producer or wholesale to retail agency networks.']
  party_id varchar [note: 'Foreign key linking to party.party. Business justification: Every agency is a legal entity in party registry. Links agency to organizational KYC, FEIN/NAIC validation, address standardization, OFAC screening, and consolidated party view.']
  principal_address_id varchar [note: 'Foreign key linking to party.address. Business justification: Agency principal address drives geocoding, cat zone assignment, and state DOI regulatory address verification for agency licensing.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Agency book-of-business analysis, market conduct exams, and territory-level production reports require agencies to be linked to their primary operating territory.']
  agency_status varchar [note: 'Current lifecycle status of the agency relationship with the carrier: active, inactive, suspended, terminated, or pending appointment.']
  agency_type varchar [note: 'Classification of the agency business model: independent agent, captive agent, managing general agent (MGA), wholesale broker, retail broker, surplus lines broker, or direct writer.']
  annual_premium_volume decimal(15,2) [note: 'Total annual written premium volume produced by the agency across all lines of business for the most recent calendar year.']
  appointment_effective_date date [note: 'Date when the agency appointment with the carrier became effective and the agency was authorized to bind business.']
  appointment_termination_date date [note: 'Date when the agency appointment with the carrier was terminated or expired, ending binding authority.']
  binding_authority_flag boolean [note: 'Indicates whether the agency has binding authority to issue policies on behalf of the carrier without prior underwriting approval.']
  binding_authority_limit decimal(15,2) [note: 'Maximum total insured value or premium amount the agency is authorized to bind without carrier underwriting review.']
  commission_schedule_code varchar [note: 'Reference code to the commission rate schedule applicable to this agency for new business, renewals, and endorsements by line of business.']
  contingent_commission_eligible boolean [note: 'Indicates whether the agency is eligible for contingent or profit-sharing commission based on loss ratio and volume performance.']
  created_timestamp timestamp [note: 'Timestamp when the agency record was first created in the system capturing the initial appointment or onboarding event.']
  default_commission_rate decimal(5,4) [note: 'Default commission rate as a decimal percentage applied to written premium when no line-specific rate is defined in the commission schedule.']
  eo_carrier_name varchar [note: 'Name of the insurance carrier providing errors and omissions professional liability coverage for the agency.']
  eo_coverage_amount decimal(15,2) [note: 'Total coverage limit amount for the agency errors and omissions professional liability insurance policy.']
  eo_expiration_date date [note: 'Expiration date of the agency errors and omissions professional liability insurance policy requiring renewal for continued appointment.']
  eo_policy_number varchar [note: 'Policy number for the agency errors and omissions professional liability insurance coverage required for appointment.']
  last_modified_timestamp timestamp [note: 'Timestamp when the agency record was most recently updated reflecting changes to appointment status, contact information, or authorization.']
  lob_authorizations varchar [note: 'Comma-separated list of lines of business the agency is authorized to write: personal auto, homeowners, commercial property, general liability, workers compensation, etc.']
  mailing_address_same_as_principal boolean [note: 'Indicates whether the mailing address is identical to the principal business address for correspondence and regulatory notices.']
  policy_count varchar [note: 'Total number of active policies in force written by the agency as of the most recent reporting period.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which the agency data originated: producer management system, policy administration system, or agency portal.']
  surplus_lines_eligible boolean [note: 'Indicates whether the agency is licensed and authorized to place surplus lines business with non-admitted carriers.']
  surplus_lines_license_number varchar [note: 'State-issued surplus lines broker license number authorizing the agency to place business with non-admitted carriers.']
  termination_reason_code varchar [note: 'Standardized code indicating the reason for agency appointment termination: voluntary, involuntary, non-renewal, regulatory action, merger, or acquisition.']
  tier varchar [note: 'Performance tier classification based on premium volume, loss ratio, and retention metrics used for contingent commission and incentive programs.']
  writing_company_code varchar [note: 'Internal carrier code identifying the specific insurance company entity the agency is appointed to represent for policy issuance.']

  Note: 'Master record for an insurance agency or brokerage firm. One row per agency. Captures agency name, FEIN, NAIC code, principal address, agency type, and parent agency hierarchy for MGA and wholesale relationships.'
}

Table producers.producer_license {
  producer_license_id varchar [pk, note: 'Unique identifier for the producer license record. Primary key. One row per producer per state per license class.']
  license_id varchar [note: 'Foreign key linking to party.license. Business justification: Regulatory compliance (NIPR reconciliation, DOI filings) requires linking producer-specific appointment licenses to the canonical party license record.']
  party_id varchar [note: 'Reference to the party master record for this producer.']
  producers_producer_id varchar [note: 'Reference to the producer who holds this license.']
  application_date date [note: 'Date the producer submitted the license application to the state Department of Insurance.']
  appointment_required boolean [note: 'Indicates whether the state requires a carrier appointment for this license class.']
  approval_date date [note: 'Date the license application was approved by the state Department of Insurance.']
  background_check_date date [note: 'Date the most recent background check was completed for this license.']
  background_check_required boolean [note: 'Indicates whether the state requires a background check for this license.']
  background_check_status varchar [note: 'Status of the background check: passed, failed, pending, not required, or expired.']
  ce_due_date date [note: 'Date by which continuing education requirements must be completed for renewal.']
  ce_ethics_hours_required decimal(5,2) [note: 'Ethics-specific continuing education hours required for license renewal in this state.']
  ce_hours_completed decimal(5,2) [note: 'Total continuing education hours completed toward current renewal cycle.']
  ce_hours_required decimal(5,2) [note: 'Total continuing education hours required for license renewal in this state.']
  denial_date date [note: 'Date the license application was denied by the state Department of Insurance.']
  denial_reason varchar [note: 'Reason provided by the state Department of Insurance for denying the license application.']
  doi_action_date date [note: 'Date the regulatory action was taken by the state Department of Insurance.']
  doi_action_description varchar [note: 'Detailed description of the regulatory action taken by the state Department of Insurance.']
  doi_action_flag boolean [note: 'Indicates whether any regulatory action has been taken against this license by the state DOI.']
  doi_action_type varchar [note: 'Type of regulatory action taken: suspension, revocation, fine, probation, consent order, or cease and desist.']
  effective_date date [note: 'Date the license becomes active and the producer is authorized to transact insurance business.']
  expiration_date date [note: 'Date the license expires and must be renewed to remain valid.']
  fingerprint_date date [note: 'Date fingerprints were submitted to the state Department of Insurance.']
  fingerprint_required boolean [note: 'Indicates whether the state requires fingerprinting for this license.']
  issue_date date [note: 'Date the license was originally issued by the state Department of Insurance.']
  license_class varchar [note: 'Classification of the license: resident, non-resident, temporary, surplus lines, adjuster, or public adjuster.']
  license_state_code varchar [note: 'Two-letter state code where the license is issued. Resident or non-resident state.']
  license_status varchar [note: 'Current status of the license with the state Department of Insurance. [ENUM-REF-CANDIDATE: active|inactive|expired|suspended|revoked|pending|denied — 7 candidates stripped; promote to reference product]']
  license_type varchar [note: 'Type of licensee: individual producer, business entity, or agency.']
  loa_casualty boolean [note: 'Indicates whether the license includes authority to sell casualty insurance lines.']
  loa_health boolean [note: 'Indicates whether the license includes authority to sell health insurance products.']
  loa_life boolean [note: 'Indicates whether the license includes authority to sell life insurance products.']
  loa_personal_lines boolean [note: 'Indicates whether the license includes authority to sell personal lines insurance.']
  loa_property boolean [note: 'Indicates whether the license includes authority to sell property insurance lines.']
  loa_variable_annuity boolean [note: 'Indicates whether the license includes authority to sell variable annuity products.']
  nipr_transaction_number varchar [note: 'Transaction identifier from NIPR for license application, renewal, or update.']
  npn varchar [note: 'National Producer Number assigned by NIPR. Unique federal identifier for licensed insurance producers.']
  reciprocity_state_code varchar [note: 'Two-letter state code of the resident state if this is a non-resident license granted through reciprocity.']
  renewal_date date [note: 'Date the license was last renewed with the state Department of Insurance.']
  source_system_code varchar [note: 'Code identifying the operational system of record for this license record.']
  source_system_reference_code varchar [note: 'Unique identifier for this license record in the source operational system.']
  surplus_lines_eligible boolean [note: 'Indicates whether the producer is eligible to place surplus lines business in this state.']
  termination_date date [note: 'Date the license was terminated, either voluntarily or by regulatory action.']
  termination_reason varchar [note: 'Reason for license termination: voluntary, non-renewal, regulatory action, death, retirement, or business closure.']

  Note: 'Individual state license held by a producer. One row per producer per state per license class. Tracks license number, line of authority, issue date, expiration date, and DOI status for compliance and appointment eligibility.'
}

Table producers.agency_producer {
  agency_producer_id varchar [pk, note: 'Unique identifier for the agency-producer relationship record. Primary key.']
  agency_id varchar [note: 'Foreign key to the agency in this producer relationship.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: The producer-agency affiliation relationship defines the commission schedule for that specific employment/contractor arrangement.']
  party_id varchar [note: 'Foreign key to the party master record for the producer.']
  primary_agency_producers_producer_id varchar [note: 'Foreign key to the producer in this agency relationship.']
  annual_production_target decimal(15,2) [note: 'Annual written premium production target assigned to the producer through this agency.']
  appointment_effective_date date [note: 'Date when the carrier appointment became effective for this producer-agency pairing.']
  appointment_status varchar [note: 'Status of the producers appointment with the carrier through this agency.']
  appointment_termination_date date [note: 'Date when the carrier appointment was terminated for this producer-agency pairing.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has authority to bind coverage on behalf of the carrier through this agency.']
  binding_authority_limit decimal(15,2) [note: 'Maximum premium or coverage amount the producer can bind without referral through this agency.']
  book_of_business_ownership varchar [note: 'Indicates who owns the book of business generated by the producer through this agency.']
  commission_split_percentage decimal(5,2) [note: 'Percentage of commission allocated to the producer in split arrangements with the agency.']
  contingent_commission_eligible boolean [note: 'Indicates whether the producer is eligible for contingent or bonus commission through this agency.']
  contract_document_reference varchar [note: 'Reference identifier or URI to the producer-agency contract or agreement document.']
  created_timestamp timestamp [note: 'Timestamp when this agency-producer relationship record was first created in the system.']
  default_commission_rate decimal(5,4) [note: 'Default commission percentage rate for this producer-agency pairing, expressed as decimal.']
  desk_location varchar [note: 'Physical desk or office location identifier within the agency premises.']
  effective_date date [note: 'Date when the producer-agency relationship became effective.']
  eo_coverage_required boolean [note: 'Indicates whether E&O insurance coverage is required for this producer-agency relationship.']
  eo_coverage_verified_date date [note: 'Date when E&O insurance coverage was last verified for this producer-agency pairing.']
  expiration_date date [note: 'Date when the producer-agency relationship ended or is scheduled to end. Null for open-ended relationships.']
  last_modified_timestamp timestamp [note: 'Timestamp when this agency-producer relationship record was last updated.']
  lob_authorizations varchar [note: 'Comma-separated list of LOB codes the producer is authorized to write through this agency.']
  non_compete_clause_flag boolean [note: 'Indicates whether a non-compete clause exists in the producer-agency agreement.']
  non_compete_expiration_date date [note: 'Date when the non-compete obligation expires after relationship termination.']
  notes varchar [note: 'Free-form text notes or comments about this producer-agency relationship.']
  performance_tier varchar [note: 'Performance classification or tier assigned to the producer within the agency structure.']
  primary_agency_flag boolean [note: 'Indicates whether this is the producers primary or home agency affiliation.']
  record_version_number varchar [note: 'Version number tracking changes to this relationship record for audit and concurrency control.']
  relationship_status varchar [note: 'Current status of the producer-agency relationship.']
  relationship_type varchar [note: 'Type of employment or affiliation relationship between producer and agency.']
  source_system_code varchar [note: 'Code identifying the source system that created or manages this agency-producer relationship record.']
  source_system_reference_code varchar [note: 'Unique identifier for this relationship record in the source system.']
  termination_date date [note: 'Actual date the relationship was terminated if ended before expiration.']
  termination_reason_code varchar [note: 'Standardized code indicating the reason for relationship termination.']
  termination_reason_description varchar [note: 'Detailed narrative explanation of the termination reason.']
  territory_code varchar [note: 'Geographic territory or region assigned to the producer within this agency.']
  writing_authority_level varchar [note: 'Level of underwriting and binding authority granted to the producer within this agency.']

  Note: 'Association between a producer and an agency capturing the employment or affiliation relationship. One row per producer-agency pairing. Stores role, start date, end date, and primary-agency flag.'
}

Table producers.producer_appointment {
  producer_appointment_id varchar [pk, note: 'Unique identifier for the producer appointment record. Primary key.']
  agency_id varchar [note: 'Reference to the agency through which the producer is appointed.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Appointments define the commission schedule that applies to the producer for that LOB/state/company combination. Replace STRING commission_schedule_code with FK.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Appointments are made through a specific distribution channel. Replace STRING distribution_channel_code with FK to distribution_channel. N:1 relationship.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Appointments are granted by LOB per state regulatory requirements and carrier underwriting guidelines.']
  party_id varchar [note: 'Reference to the party record representing the producer.']
  prior_appointment_producer_appointment_id varchar [note: 'Reference to the previous appointment record if this is a renewal or replacement.']
  producer_license_id varchar [note: 'Foreign key linking to producers.producer_license. Business justification: Appointments are granted based on a valid license in that state and LOB. Links the appointment to the underlying license that authorizes the producer to sell. N:1 relationship.']
  producers_producer_id varchar [note: 'Reference to the producer who holds this appointment.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Producer appointments are validated against territory-level binding authority limits and rate filings.']
  appointment_agreement_date date [note: 'Date when the appointment agreement was signed by both parties.']
  appointment_agreement_number varchar [note: 'Reference number of the legal contract governing this appointment.']
  appointment_number varchar [note: 'Unique business identifier for this appointment issued by the insurer or state DOI.']
  appointment_source varchar [note: 'Origin or method by which the producer appointment was established.']
  appointment_state_code varchar [note: 'Two-letter state code where the appointment is granted and registered.']
  appointment_status varchar [note: 'Current lifecycle status of the producer appointment.']
  appointment_tier varchar [note: 'Performance or volume tier assigned to the producer for this appointment.']
  appointment_type varchar [note: 'Classification of the appointment relationship between producer and insurer.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has authority to bind coverage on behalf of the insurer.']
  binding_authority_limit decimal(15,2) [note: 'Maximum policy limit or premium amount the producer can bind without underwriter approval.']
  contingent_commission_eligible boolean [note: 'Indicates whether the producer is eligible for contingent or profit-sharing commission.']
  created_timestamp timestamp [note: 'Timestamp when this appointment record was first created in the system.']
  default_commission_rate decimal(5,4) [note: 'Standard commission rate as a decimal percentage for policies written under this appointment.']
  doi_reported_date date [note: 'Date when the appointment was reported to the state Department of Insurance.']
  effective_date date [note: 'Date when the producer appointment becomes active and binding authority begins.']
  eo_insurance_required_flag boolean [note: 'Indicates whether the producer must maintain E&O insurance as a condition of appointment.']
  eo_minimum_coverage_amount decimal(15,2) [note: 'Minimum E&O insurance coverage amount required to maintain the appointment.']
  expiration_date date [note: 'Date when the producer appointment expires or is scheduled to end.']
  last_modified_timestamp timestamp [note: 'Timestamp when this appointment record was last updated.']
  lob_category varchar [note: 'High-level category grouping the line of business.']
  lob_description varchar [note: 'Full description of the line of business authorized under this appointment.']
  naic_company_code varchar [note: 'Five-digit NAIC code identifying the insurer granting the appointment.']
  nipr_transaction_number varchar [note: 'Unique transaction identifier assigned by NIPR for this appointment filing.']
  npn varchar [note: 'Ten-digit unique identifier assigned by NIPR to licensed insurance producers.']
  regulatory_reporting_required boolean [note: 'Indicates whether this appointment must be reported to state DOI or NIPR.']
  renewal_flag boolean [note: 'Indicates whether this appointment is a renewal of a prior appointment.']
  resident_state_code varchar [note: 'Two-letter code of the state where the producer holds resident license.']
  source_system_code varchar [note: 'Code identifying the operational system from which this appointment record originated.']
  source_system_reference_code varchar [note: 'Primary key or unique identifier of this appointment in the source system.']
  surplus_lines_flag boolean [note: 'Indicates whether this appointment authorizes surplus lines business placement.']
  surplus_lines_license_number varchar [note: 'License number issued by the state for surplus lines authority.']
  termination_date date [note: 'Actual date when the appointment was terminated before its scheduled expiration.']
  termination_for_cause_flag boolean [note: 'Indicates whether the appointment was terminated for cause requiring regulatory reporting.']
  termination_reason_code varchar [note: 'Standardized code indicating the reason for appointment termination.']
  termination_reason_description varchar [note: 'Detailed explanation of the reason for appointment termination.']
  writing_company_code varchar [note: 'Internal code identifying the insurance company granting the appointment.']

  Note: 'Formal appointment and binding authority granted by the insurer to a producer to sell specific lines in a state. One row per producer per insurer per state per LOB.'
}

Table producers.distribution_channel {
  distribution_channel_id varchar [pk, note: 'Unique identifier for the distribution channel. Primary key.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Distribution channels are configured with LOB authorizations for market segmentation and channel conflict management.']
  agency_bill_flag boolean [note: 'Indicates whether policies written through this channel use agency bill arrangements where the producer collects premium and remits to the insurer.']
  appointment_required boolean [note: 'Indicates whether producers must be formally appointed by the insurer to write business through this channel.']
  background_check_required boolean [note: 'Indicates whether producers must pass a background check before being authorized to write business through this channel.']
  binding_authority_flag boolean [note: 'Indicates whether producers in this channel have authority to bind coverage on behalf of the insurer without prior underwriting approval.']
  binding_authority_limit decimal(15,2) [note: 'Maximum policy premium or total insured value that producers in this channel may bind without referral to underwriting.']
  channel_code varchar [note: 'Short alphanumeric code uniquely identifying the channel type for system integration and reporting.']
  channel_description varchar [note: 'Detailed narrative describing the purpose, structure, and operational characteristics of this distribution channel.']
  channel_name varchar [note: 'Full business name of the distribution channel.']
  channel_priority_rank varchar [note: 'Numeric ranking indicating the strategic priority or preference of this channel relative to others for business development and resource allocation.']
  channel_status varchar [note: 'Current lifecycle status of the distribution channel indicating whether it is available for new business.']
  channel_subtype varchar [note: 'Secondary classification providing additional granularity within the primary channel type, such as affinity, digital, call center, or retail branch.']
  channel_type varchar [note: 'Primary classification of how business reaches the insurer: captive agent, independent agent, broker, direct-to-consumer, managing general agent, or wholesale.']
  commission_schedule_code varchar [note: 'Reference code linking this channel to its default commission rate structure and payment terms.']
  contingent_commission_eligible boolean [note: 'Indicates whether producers in this channel are eligible for performance-based contingent commission payments.']
  continuing_education_required boolean [note: 'Indicates whether producers in this channel must complete ongoing continuing education requirements to maintain their authorization.']
  created_timestamp timestamp [note: 'System timestamp when this distribution channel record was first created in the data platform.']
  default_commission_rate decimal(5,4) [note: 'Standard commission percentage paid to producers operating through this channel, expressed as a decimal fraction.']
  direct_bill_flag boolean [note: 'Indicates whether policies written through this channel are billed directly by the insurer or through agency bill arrangements.']
  effective_date date [note: 'Date when this distribution channel became active and available for producer appointments and policy binding.']
  eo_insurance_required boolean [note: 'Indicates whether producers operating through this channel must maintain errors and omissions professional liability coverage.']
  expiration_date date [note: 'Date when this distribution channel is scheduled to terminate or was terminated. Null for open-ended channels.']
  geographic_scope varchar [note: 'Description of the geographic territories or jurisdictions where this channel is authorized to operate, such as nationwide, regional, or state-specific.']
  lob_authorizations varchar [note: 'Comma-separated list of line-of-business codes that producers in this channel are authorized to write, such as HO, PAP, CGL, BOP, WC.']
  minimum_eo_coverage_amount decimal(15,2) [note: 'Minimum required errors and omissions insurance coverage limit for producers in this channel, expressed in policy currency.']
  naic_company_code varchar [note: 'Five-digit NAIC company code assigned to the writing company for regulatory reporting and statutory filings.']
  regulatory_reporting_required boolean [note: 'Indicates whether activity through this channel triggers specific regulatory reporting obligations to state departments of insurance or NAIC.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this distribution channel data originated, such as producer management or policy administration system.']
  surplus_lines_eligible boolean [note: 'Indicates whether this channel is authorized to place surplus lines or non-admitted business in jurisdictions where the carrier is not licensed.']
  target_market_segment varchar [note: 'Description of the primary customer demographic or market segment this channel is designed to serve, such as personal lines, small commercial, or middle market.']
  termination_reason varchar [note: 'Business reason for channel termination, such as strategic realignment, regulatory action, or performance issues.']
  updated_timestamp timestamp [note: 'System timestamp when this distribution channel record was last modified.']
  writing_company_code varchar [note: 'Internal code identifying the insurance company or carrier that underwrites policies through this channel.']

  Note: 'Reference classification of how business reaches the insurer (captive, independent, broker, direct, MGA, wholesale, affinity, digital). One row per channel. Drives commission schedule selection and producer underwriting authority rules.'
}

Table producers.commission_schedule {
  commission_schedule_id varchar [pk, note: 'Unique identifier for the commission schedule. Primary key.']
  agency_id varchar [note: 'Agency to which this commission schedule applies, if agency-level.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission schedules define payment currency for producer compensation. The existing currency_code plain-text column is a denormalization of shared.currency.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Commission schedules are defined for specific distribution channels. Replace STRING distribution_channel_code with FK to distribution_channel. N:1 relationship.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Commission schedules are structured by LOB for rate differentiation, regulatory compliance, and profitability management.']
  producers_producer_id varchar [note: 'Producer to whom this commission schedule applies.']
  superseded_by_schedule_commission_schedule_id varchar [note: 'Identifier of the commission schedule that replaces this one, if superseded.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Commission schedules in P&C insurance are frequently territory-specific — coastal or wind-pool territories carry different commission structures than inland territories.']
  approval_date date [note: 'Date when this commission schedule was approved by management or underwriting authority.']
  approved_by varchar [note: 'Name or identifier of the person who approved this commission schedule.']
  base_commission_rate decimal(7,5) [note: 'Base commission rate as a decimal percentage applied to written premium for this schedule.']
  bonus_commission_rate decimal(7,5) [note: 'Bonus commission rate as a decimal percentage, awarded for exceptional performance or strategic initiatives.']
  chargeback_period_days varchar [note: 'Number of days from policy effective date during which cancellation triggers commission chargeback.']
  chargeback_provision boolean [note: 'Indicates whether commission is subject to chargeback if policy cancels within a specified period.']
  commission_basis varchar [note: 'Premium basis on which commission is calculated: written, earned, net, or gross premium.']
  contingent_commission_rate decimal(7,5) [note: 'Contingent commission rate as a decimal percentage, earned based on profitability or volume thresholds.']
  coverage_type_code varchar [note: 'Specific coverage type within the line of business for which this schedule applies, if coverage-specific.']
  created_timestamp timestamp [note: 'Timestamp when this commission schedule record was first created in the system.']
  effective_date date [note: 'Date when this commission schedule becomes active and binding.']
  expiration_date date [note: 'Date when this commission schedule expires or is no longer in force. Null for open-ended schedules.']
  last_modified_timestamp timestamp [note: 'Timestamp when this commission schedule record was last updated or modified.']
  loss_ratio_threshold decimal(5,4) [note: 'Maximum loss ratio threshold for contingent commission eligibility, expressed as a decimal.']
  maximum_premium_threshold decimal(15,2) [note: 'Maximum written premium amount beyond which this commission schedule no longer applies or a different tier begins.']
  minimum_premium_threshold decimal(15,2) [note: 'Minimum written premium amount required for this commission schedule to apply.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the insurer for regulatory reporting.']
  new_business_credit_rate decimal(7,5) [note: 'Additional commission credit rate for new business production, expressed as a decimal percentage.']
  notes varchar [note: 'Free-text notes or comments regarding special terms, exceptions, or conditions of this commission schedule.']
  override_commission_rate decimal(7,5) [note: 'Override commission rate as a decimal percentage, typically for agency principals or managing general agents.']
  payment_timing varchar [note: 'Timing of commission payment: immediate upon booking, monthly, quarterly, annual, or upon premium collection.']
  renewal_credit_rate decimal(7,5) [note: 'Additional commission credit rate for renewal business, expressed as a decimal percentage.']
  retention_rate_threshold decimal(5,4) [note: 'Minimum policy retention rate required for contingent commission eligibility, expressed as a decimal.']
  schedule_code varchar [note: 'Business identifier for the commission schedule, used for external reference and reporting.']
  schedule_name varchar [note: 'Descriptive name of the commission schedule for business users.']
  schedule_status varchar [note: 'Current lifecycle status of the commission schedule.']
  schedule_type varchar [note: 'Type of commission schedule: standard, override, contingent, bonus, or special arrangement.']
  source_system_code varchar [note: 'Code identifying the operational system from which this commission schedule record originated.']
  source_system_reference_code varchar [note: 'Unique identifier of this commission schedule in the source operational system for traceability.']
  state_code varchar [note: 'Two-letter state code for which this commission schedule applies, if state-specific.']
  termination_date date [note: 'Date when this commission schedule was terminated before its natural expiration.']
  termination_reason varchar [note: 'Reason for early termination of this commission schedule: producer termination, contract renegotiation, regulatory change, etc.']
  tier_level varchar [note: 'Tier level within a multi-tier commission structure, where higher tiers may have different rates.']
  transaction_type varchar [note: 'Policy transaction type for which this commission rate applies: New Business, Renewal, Endorsement, Cancellation, Reinstatement.']
  version_number varchar [note: 'Version number of this commission schedule, incremented with each amendment or revision.']
  volume_threshold_policy_count varchar [note: 'Minimum number of policies required to qualify for this commission schedule or tier.']
  writing_company_code varchar [note: 'Insurance company code for which this commission schedule applies, if company-specific.']

  Note: 'Contractual commission rate set for a producer or agency by LOB, transaction type (NB/REN/END), and coverage type over an effective period. One row per schedule version. Holds all rate lines (base, contingent, override) as embedded detail.'
}

Table producers.commission_rule {
  commission_rule_id varchar [pk, note: 'Unique identifier for the commission rule. Primary key.']
  commission_schedule_id varchar [note: 'Foreign key to the parent commission schedule that owns this rule.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission rules specify minimum and maximum commission amounts in a defined currency. The existing currency_code is a denormalized text field.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Commission rules may vary by distribution channel. Replace STRING distribution_channel_code with FK to distribution_channel. N:1 relationship.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Commission rules are configured by LOB for rate differentiation, transaction type handling, and regulatory compliance.']
  approval_date date [note: 'Date this commission rule was approved by management or compliance.']
  approval_required_flag boolean [note: 'Indicates whether this rule requires management or compliance approval before activation.']
  approved_by varchar [note: 'Name or identifier of the person who approved this commission rule for use.']
  base_commission_rate decimal(7,5) [note: 'Standard commission rate expressed as a decimal percentage applied to written premium for this rule.']
  chargeback_eligible_flag boolean [note: 'Indicates whether commission paid under this rule is subject to chargeback if the policy cancels or premium is returned.']
  chargeback_period_days varchar [note: 'Number of days from policy effective date during which commission chargeback applies if the policy cancels.']
  commission_basis_code varchar [note: 'Premium basis on which commission is calculated: written premium, earned premium, billed premium, or collected premium.']
  commission_split_flag boolean [note: 'Indicates whether this rule supports splitting commission among multiple producers.']
  contingent_commission_rate decimal(7,5) [note: 'Additional performance-based commission rate applied when volume, profitability, or retention thresholds are met.']
  created_timestamp timestamp [note: 'Timestamp when this commission rule record was first created in the system.']
  effective_date date [note: 'Date this commission rule becomes active and begins applying to new transactions.']
  expiration_date date [note: 'Date this commission rule expires and ceases to apply; null indicates an open-ended rule.']
  last_modified_timestamp timestamp [note: 'Timestamp when this commission rule record was last updated or modified.']
  loss_ratio_threshold decimal(5,4) [note: 'Maximum loss ratio threshold for contingent commission eligibility; expressed as a decimal percentage.']
  maximum_commission_amount decimal(12,2) [note: 'Ceiling amount for commission payment; if calculated commission exceeds this, the maximum is paid instead.']
  minimum_commission_amount decimal(12,2) [note: 'Floor amount for commission payment; if calculated commission is below this, the minimum is paid instead.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the insurer for regulatory reporting and commission allocation.']
  override_commission_rate decimal(7,5) [note: 'Hierarchical override commission rate paid to managing producers or agency principals on downline production.']
  payment_timing_code varchar [note: 'Timing of commission payment under this rule: immediate upon transaction, monthly, quarterly, or annual settlement.']
  policy_state_code varchar [note: 'Two-letter state or jurisdiction code where the policy is written; rule applies only to policies in this state.']
  premium_tier_maximum decimal(12,2) [note: 'Maximum written premium threshold for this rule to apply; enables tiered commission structures.']
  premium_tier_minimum decimal(12,2) [note: 'Minimum written premium threshold for this rule to apply; enables tiered commission structures.']
  producer_type_code varchar [note: 'Type of producer this rule applies to: agent, broker, managing general agent, or direct.']
  retention_rate_threshold decimal(5,4) [note: 'Minimum policy retention rate threshold for contingent commission eligibility; expressed as a decimal percentage.']
  rule_description varchar [note: 'Detailed explanation of the conditions and rates applied by this rule.']
  rule_name varchar [note: 'Business-friendly name or label for this commission rule.']
  rule_notes varchar [note: 'Free-text notes or comments about this commission rule for internal reference and documentation.']
  rule_sequence_number varchar [note: 'Ordering of this rule within the parent schedule for evaluation precedence.']
  rule_status varchar [note: 'Current lifecycle status of this commission rule: active, inactive, pending approval, expired, or superseded by a newer rule.']
  source_rule_reference varchar [note: 'External reference or identifier for this rule in the source producer management or commission system.']
  source_system_code varchar [note: 'Code identifying the operational system that created or manages this commission rule.']
  split_percentage decimal(5,4) [note: 'Percentage of total commission allocated to this rule when commission splitting is enabled; expressed as a decimal.']
  transaction_type_code varchar [note: 'Policy transaction type this rule applies to: New Business, Renewal, Endorsement, Cancellation, Reinstatement, Non-renewal.']
  volume_threshold_amount decimal(15,2) [note: 'Cumulative premium volume threshold that must be met for contingent or bonus commission rates to apply.']
  writing_company_code varchar [note: 'Insurance company or carrier code this rule applies to, for multi-carrier agency environments.']

  Note: 'Individual rate rule within a commission schedule. One row per rule. Specifies transaction type (NB, REN, END), LOB, coverage type, base rate, contingent rate, override rate, and effective date range.'
}

Table producers.commission_transaction {
  commission_transaction_id varchar [pk, note: 'Unique identifier for the commission financial movement. Primary key.']
  accounting_period_id varchar [note: 'Foreign key to the accounting period in which this commission is recognized.']
  agency_id varchar [note: 'Foreign key to the agency associated with this commission.']
  commission_rule_id varchar [note: 'Foreign key linking to producers.commission_rule. Business justification: Each transaction is calculated by applying a specific rule within a schedule. The rule specifies the exact rate, tier, LOB, and conditions that produced the commission amount.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Each transaction is calculated using a specific commission schedule. Replace STRING commission_schedule_code with FK to commission_schedule. N:1 relationship.']
  commission_statement_id varchar [note: 'Foreign key linking to producers.commission_statement. Business justification: Transactions roll up into periodic statements. Each transaction appears on exactly one statement for a given billing period. Standard transaction-to-statement aggregation link.']
  coverage_id varchar [note: 'Foreign key linking to coverage.coverage. Business justification: Enables coverage-level commission allocation when commission rates vary by coverage type within a policy (e.g., different rates for property vs liability).']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission transactions in multi-currency operations require currency reference for financial reporting, GL posting, and payment processing.']
  original_transaction_commission_transaction_id varchar [note: 'Foreign key to the original commission transaction if this is a reversal, adjustment, or claw-back.']
  policy_id varchar [note: 'Foreign key to the policy generating this commission.']
  policy_term_id varchar [note: 'Foreign key to the policy term associated with this commission.']
  premium_transaction_id varchar [note: 'Foreign key to the premium transaction that generated this commission.']
  producers_producer_id varchar [note: 'Foreign key to the producer earning this commission.']
  adjustment_amount decimal(18,2) [note: 'Adjustment amount applied to correct or modify the commission.']
  claw_back_amount decimal(18,2) [note: 'Amount of commission reclaimed due to policy cancellation, return premium, or other reversal event.']
  commission_basis varchar [note: 'Basis on which commission is calculated: Gross Written Premium, Net Written Premium, Earned Premium, flat fee, or sliding scale.']
  commission_rate decimal(7,4) [note: 'Percentage rate applied to the premium to calculate the commission, expressed as a decimal.']
  contingent_commission_flag boolean [note: 'Indicates whether this commission is contingent on meeting performance or profitability targets.']
  created_timestamp timestamp [note: 'Timestamp when this commission transaction record was first created in the system.']
  earned_amount decimal(18,2) [note: 'Gross commission amount earned by the producer on the premium transaction.']
  effective_date date [note: 'Date when the commission becomes effective for accounting purposes.']
  gl_account_code varchar [note: 'General ledger account code to which this commission transaction is posted.']
  lob_code varchar [note: 'Code identifying the line of business for which this commission was earned.']
  net_commission_amount decimal(18,2) [note: 'Net commission amount after applying claw-backs and adjustments.']
  notes varchar [note: 'Free-text notes or comments related to this commission transaction.']
  npn varchar [note: 'National Producer Number of the producer earning this commission, for regulatory reporting.']
  override_flag boolean [note: 'Indicates whether this commission is an override commission paid to a higher-level producer or manager.']
  payment_date date [note: 'Date when the commission was paid or is scheduled to be paid to the producer.']
  payment_method varchar [note: 'Method used to pay the commission to the producer.']
  payment_reference_number varchar [note: 'External reference number for the payment transaction, such as check number or wire confirmation.']
  payment_status varchar [note: 'Current payment status of the commission transaction.']
  policy_transaction_type varchar [note: 'Type of policy transaction that triggered this commission: new business, renewal, endorsement, cancellation, or reinstatement.']
  reversal_reason_code varchar [note: 'Code indicating the reason for commission reversal or claw-back, if applicable.']
  reversal_reason_description varchar [note: 'Detailed description of the reason for commission reversal or claw-back.']
  source_system_code varchar [note: 'Code identifying the source system that originated this commission transaction.']
  source_transaction_reference varchar [note: 'External reference identifier from the source system for this commission transaction.']
  split_percentage decimal(5,2) [note: 'Percentage of the total commission allocated to this producer in a split commission scenario.']
  state_code varchar [note: 'Two-letter state code where the policy was written and commission earned.']
  tax_withholding_amount decimal(18,2) [note: 'Amount of tax withheld from the commission payment, if applicable.']
  transaction_date date [note: 'Date when the commission transaction was recorded in the system.']
  transaction_number varchar [note: 'Business identifier for this commission transaction, unique within the system.']
  transaction_status varchar [note: 'Current lifecycle status of the commission transaction.']
  transaction_timestamp timestamp [note: 'Precise timestamp when the commission transaction was created.']
  transaction_type varchar [note: 'Type of commission financial movement: earned, claw-back, adjustment, reversal, advance, or chargeback.']
  updated_timestamp timestamp [note: 'Timestamp when this commission transaction record was last modified.']
  writing_company_code varchar [note: 'Code identifying the insurance company that wrote the policy and owes the commission.']

  Note: 'One row per commission financial movement earned by a producer on a premium transaction. Captures earned amount, claw-back amount, transaction type, accounting period, and payment status. Child of premium transaction.'
}

Table producers.commission_statement {
  commission_statement_id varchar [pk, note: 'Unique identifier for the commission statement. Primary key.']
  agency_id varchar [note: 'Agency associated with the producer for this statement.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Statements are generated based on a specific commission schedule that defines the rates and rules. N:1 relationship.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission statements carry multiple monetary totals (net_commission_payable, total_commission_earned, chargeback_amount) requiring a defined currency.']
  distribution_channel_id varchar [note: 'Foreign key linking to producers.distribution_channel. Business justification: Statements may be segmented by distribution channel for reporting and reconciliation. Replace STRING distribution_channel_code with FK. N:1 relationship.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Commission statements aggregate transactions by LOB for producer reporting, tax reporting (1099), and reconciliation.']
  producers_producer_id varchar [note: 'Producer or agent to whom this statement is issued.']
  chargeback_amount decimal(18,2) [note: 'Total commission chargebacks for cancelled or returned policies during the statement period.']
  contingent_commission decimal(18,2) [note: 'Performance-based bonus commission earned based on loss ratio, volume, or other criteria.']
  created_timestamp timestamp [note: 'Timestamp when this commission statement record was first created in the system.']
  dispute_date date [note: 'Date the producer filed a dispute against this commission statement.']
  dispute_flag boolean [note: 'Indicates whether the producer has disputed any portion of this commission statement.']
  dispute_resolution_date date [note: 'Date the dispute was resolved and the statement was finalized.']
  endorsement_commission decimal(18,2) [note: 'Commission earned on policy endorsements and mid-term changes during the statement period.']
  eo_premium_deduction decimal(18,2) [note: 'Deduction for errors and omissions insurance premium paid on behalf of the producer.']
  last_modified_timestamp timestamp [note: 'Timestamp when this commission statement record was last updated.']
  naic_company_code varchar [note: 'Five-digit NAIC code identifying the insurance company for regulatory reporting.']
  net_commission_payable decimal(18,2) [note: 'Net commission amount payable to the producer after all adjustments and deductions.']
  new_business_commission decimal(18,2) [note: 'Commission earned on new business policies written during the statement period.']
  notes varchar [note: 'Free-text notes or comments regarding this commission statement.']
  npn varchar [note: 'National Producer Number of the producer receiving this statement.']
  payment_date date [note: 'Date the commission payment was issued to the producer.']
  payment_method varchar [note: 'Method used to disburse the commission payment to the producer.']
  payment_reference_number varchar [note: 'External reference number for the payment transaction such as check number or wire confirmation.']
  payment_status varchar [note: 'Current payment status indicating whether the net commission has been disbursed to the producer.']
  policy_count varchar [note: 'Total number of policies contributing commission transactions to this statement.']
  renewal_commission decimal(18,2) [note: 'Commission earned on policy renewals during the statement period.']
  source_system_code varchar [note: 'Code identifying the operational system that originated this commission statement record.']
  statement_date date [note: 'Date the commission statement was generated and issued.']
  statement_delivery_method varchar [note: 'Method by which the commission statement was delivered to the producer.']
  statement_document_reference varchar [note: 'Reference identifier or URI to the generated commission statement document.']
  statement_number varchar [note: 'Externally visible unique identifier for the commission statement.']
  statement_period_end_date date [note: 'End date of the billing cycle covered by this statement.']
  statement_period_start_date date [note: 'Start date of the billing cycle covered by this statement.']
  statement_status varchar [note: 'Current lifecycle status of the commission statement.']
  statement_type varchar [note: 'Type of commission statement indicating whether it is a regular periodic statement or a special issuance.']
  tax_identification_number varchar [note: 'Federal Employer Identification Number or Social Security Number for tax reporting purposes.']
  total_adjustments decimal(18,2) [note: 'Total adjustments applied to earned commission including chargebacks, corrections, and bonuses.']
  total_commission_earned decimal(18,2) [note: 'Total commission amount earned by the producer for the statement period before adjustments.']
  total_deductions decimal(18,2) [note: 'Total deductions from commission including errors and omissions insurance premiums, fees, and withholdings.']
  transaction_count varchar [note: 'Total number of individual commission transactions included in this statement.']
  writing_company_code varchar [note: 'Code identifying the insurance company or carrier issuing this commission statement.']

  Note: 'Periodic statement issued to a producer or agency summarizing commission transactions due for a billing cycle. One row per statement. Tracks statement date, total earned, total adjustments, net payable, and payment status.'
}

Table producers.underwriting_authority {
  underwriting_authority_id varchar [pk, note: 'Unique identifier for the underwriting authority grant record.']
  agency_id varchar [note: 'Reference to the agency organization holding this authority.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Binding authority is explicitly restricted by catastrophe zone. Producers in coastal wind zones or earthquake zones require higher authority levels or mandatory referral.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Underwriting authority limits (max_single_risk_limit, max_tiv, deductible_max/min, premium thresholds) are all currency-denominated monetary fields.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Authority grants are LOB-specific per regulatory and risk management requirements. LOB reference provides admitted/surplus lines status, state filing requirements, and default policy']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Binding authority is granted per peril (wind, earthquake, flood, wildfire). Producers must have explicit peril-specific authority to bind coverage.']
  producers_producer_id varchar [note: 'Reference to the producer or agent receiving this binding authority.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: Underwriting authorities in P&C are defined at territory level — a producer may have binding authority in territory 001 but require referral in territory 002 within the same']
  approval_date date [note: 'Date when the underwriting authority was approved by the carrier or underwriting management.']
  approved_by varchar [note: 'Name or identifier of the underwriting manager or executive who approved this authority grant.']
  audit_frequency varchar [note: 'Frequency at which policies bound under this authority must be audited: monthly, quarterly, semi-annual, annual, or per policy.']
  audit_required boolean [note: 'Indicates whether policies bound under this authority require post-binding underwriting audit or review.']
  authority_status varchar [note: 'Current lifecycle status of the underwriting authority grant.']
  authority_type varchar [note: 'Classification of the authority level granted: binding, quoting, referral, limited binding, full binding, or conditional.']
  blanket_coverage_allowed boolean [note: 'Indicates whether the producer may bind blanket coverage policies under this authority.']
  cancellation_allowed boolean [note: 'Indicates whether this authority permits canceling policies.']
  coinsurance_allowed boolean [note: 'Indicates whether the producer may bind policies with coinsurance clauses under this authority.']
  construction_restrictions varchar [note: 'Construction types or building classes excluded from this authority per COPE criteria.']
  created_timestamp timestamp [note: 'Timestamp when this authority record was first created in the data platform.']
  deductible_max decimal(18,2) [note: 'Maximum deductible amount the producer may offer when binding coverage under this authority.']
  deductible_min decimal(18,2) [note: 'Minimum deductible amount the producer must apply when binding coverage under this authority.']
  effective_date date [note: 'Date when the underwriting authority becomes active and binding authority may be exercised.']
  eligible_states varchar [note: 'Comma-separated list of state codes where this authority is valid and may be exercised.']
  endorsement_allowed boolean [note: 'Indicates whether this authority permits issuing policy endorsements.']
  excluded_states varchar [note: 'Comma-separated list of state codes explicitly excluded from this authority grant.']
  expiration_date date [note: 'Date when the underwriting authority expires and can no longer be exercised unless renewed.']
  last_modified_timestamp timestamp [note: 'Timestamp when this authority record was last updated in the data platform.']
  limit_tier varchar [note: 'Tiered classification of authority limits: tier 1 (lowest), tier 2, tier 3, tier 4, or unlimited.']
  max_premium_threshold decimal(18,2) [note: 'Maximum written premium amount the producer may bind without underwriting referral.']
  max_single_risk_limit decimal(18,2) [note: 'Maximum policy limit the producer may bind on a single insured risk without referral to underwriting.']
  max_tiv decimal(18,2) [note: 'Maximum total insured value the producer may bind without underwriting referral.']
  min_premium_threshold decimal(18,2) [note: 'Minimum written premium amount required for the producer to exercise binding authority on a policy.']
  new_business_allowed boolean [note: 'Indicates whether this authority permits binding new business policies.']
  notes varchar [note: 'Free-text notes or comments regarding special conditions, exceptions, or clarifications for this authority grant.']
  occupancy_restrictions varchar [note: 'Specific occupancy types or uses excluded from this binding authority per Construction, Occupancy, Protection, Exposure (COPE) criteria.']
  protection_class_max varchar [note: 'Maximum ISO protection class rating allowed for binding under this authority without referral.']
  protection_class_min varchar [note: 'Minimum ISO protection class rating required for the producer to bind coverage under this authority.']
  referral_criteria varchar [note: 'Business rules or conditions that trigger mandatory referral to underwriting despite binding authority.']
  reinstatement_allowed boolean [note: 'Indicates whether this authority permits reinstating lapsed or canceled policies.']
  renewal_allowed boolean [note: 'Indicates whether this authority permits binding renewal policies.']
  renewal_eligible boolean [note: 'Indicates whether this authority grant is eligible for renewal upon expiration.']
  revocation_date date [note: 'Date when the underwriting authority was revoked or terminated prior to expiration.']
  revocation_reason varchar [note: 'Business reason or cause for revoking the underwriting authority prior to expiration.']
  risk_class_restrictions varchar [note: 'Comma-separated list of risk classes or NAICS codes for which this authority is restricted or excluded.']
  source_system_code varchar [note: 'Code identifying the operational system of record where this authority grant was created.']
  source_system_reference_code varchar [note: 'Unique identifier or key for this authority record in the source operational system.']

  Note: 'Defines the binding authority granted to a producer or agency by LOB, coverage type, and limit tier. One row per authority grant. Tracks max TIV, max single-risk limit, eligible states, and authority expiration date.'
}

Table catastrophegeography.catastrophe_event {
  catastrophe_event_id varchar [pk, note: 'Unique identifier for the catastrophe event. Primary key.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: NAIC Schedule P and statutory reporting require cat events to be assigned to accident year periods.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Multi-currency cat loss reporting for regulatory filings and reinsurance settlement requires a proper currency FK.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Each catastrophe event has a primary peril type. Adding peril_id FK to peril reference table for referential integrity. peril_type remains for operational queries.']
  aal_amount decimal(18,2) [note: 'Average annual loss amount attributed to this type of catastrophe event based on historical modeling in USD.']
  acres_burned varchar [note: 'Total number of acres burned during the wildfire event.']
  actual_loss_amount decimal(18,2) [note: 'Actual reported insured loss amount for this catastrophe event after claims settlement in USD.']
  affected_countries varchar [note: 'Comma-separated list of ISO 3-letter country codes where the catastrophe event caused insured losses.']
  affected_states varchar [note: 'Comma-separated list of US state postal codes where the catastrophe event caused insured losses.']
  cat_bond_trigger_flag boolean [note: 'Indicates whether this catastrophe event triggered a catastrophe bond payout.']
  created_timestamp timestamp [note: 'Timestamp when this catastrophe event record was first created in the system.']
  data_source varchar [note: 'Source system or organization that provided the catastrophe event data (e.g., ISO, PCS, RMS, AIR, NOAA, USGS).']
  declaration_date date [note: 'Date when the event was officially declared a catastrophe by industry or regulatory bodies.']
  epicenter_latitude decimal(10,7) [note: 'Latitude coordinate of the catastrophe event epicenter or origin point.']
  epicenter_longitude decimal(10,7) [note: 'Longitude coordinate of the catastrophe event epicenter or origin point.']
  estimated_claim_count varchar [note: 'Estimated total number of insurance claims expected to be filed industry-wide for this catastrophe event.']
  event_description varchar [note: 'Detailed narrative description of the catastrophe event including impact, path, and key characteristics.']
  event_duration_days varchar [note: 'Total number of days the catastrophe event lasted from start to end.']
  event_end_date date [note: 'Date when the catastrophe event concluded or was declared over.']
  event_name varchar [note: 'Official name assigned to the catastrophe event (e.g., Hurricane Katrina, Northridge Earthquake).']
  event_start_date date [note: 'Date when the catastrophe event began.']
  event_status varchar [note: 'Current lifecycle status of the catastrophe event record.']
  event_type varchar [note: 'High-level classification of the catastrophe event origin.']
  federal_disaster_declaration_flag boolean [note: 'Indicates whether a federal disaster declaration was issued for this catastrophe event.']
  fema_disaster_number varchar [note: 'Official FEMA disaster declaration number assigned to the event.']
  geographic_footprint_description varchar [note: 'Narrative description of the geographic area impacted by the catastrophe event.']
  industry_loss_estimate_amount decimal(18,2) [note: 'Estimated total insured loss across the entire insurance industry for this catastrophe event in USD.']
  iso_cat_serial_number varchar [note: 'Industry-standard ISO serial number uniquely identifying the catastrophe event for cross-carrier reporting.']
  loss_development_factor decimal(5,4) [note: 'Factor representing the ratio of ultimate loss to reported loss, used for IBNR estimation.']
  magnitude_scale varchar [note: 'Name of the scale used to measure event magnitude (e.g., Richter, Moment Magnitude, Saffir-Simpson, Enhanced Fujita).']
  magnitude_value decimal(5,2) [note: 'Quantitative measure of event intensity (e.g., Richter scale for earthquakes, Saffir-Simpson for hurricanes).']
  modeled_loss_amount decimal(18,2) [note: 'Loss amount calculated by catastrophe modeling software for this event in USD.']
  nfip_participation_flag boolean [note: 'Indicates whether the event triggered NFIP claims and participation.']
  notes varchar [note: 'Additional notes or comments regarding the catastrophe event for internal reference.']
  peril_type varchar [note: 'Primary peril classification of the catastrophe event.']
  pml_amount decimal(18,2) [note: 'Probable maximum loss amount for this catastrophe event based on exposure modeling in USD.']
  pml_class varchar [note: 'Classification of the event based on probable maximum loss severity.']
  precipitation_inches decimal(6,2) [note: 'Total precipitation recorded during the event in inches, applicable to flood and storm events.']
  reinsurance_trigger_flag boolean [note: 'Indicates whether this catastrophe event triggered reinsurance treaty or facultative coverage.']
  return_period_years varchar [note: 'Statistical return period in years indicating the expected frequency of an event of this magnitude.']
  storm_surge_feet decimal(6,2) [note: 'Maximum storm surge height recorded in feet, applicable to hurricanes and coastal flooding events.']
  updated_timestamp timestamp [note: 'Timestamp when this catastrophe event record was last modified.']
  wind_speed_mph varchar [note: 'Maximum sustained wind speed recorded during the event in miles per hour, applicable to hurricanes and tornadoes.']

  Note: 'Master record of a named CAT event (hurricane, quake, wildfire, flood, tornado), one row per event. Captures event type, peril, date range, footprint, industry loss estimate, PML class, ISO CAT serial number, event name, and affected states for statutory'
}

Table catastrophegeography.cat_zone {
  cat_zone_id varchar [pk, note: 'Unique identifier for the catastrophe zone. Primary key.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: cat_zone holds currency-denominated thresholds (reinsurance_attachment_point, reinsurance_limit, tiv_amount, pml_100/250/500_year_amount) used in reinsurance treaty structuring and regulatory']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: CAT zones have geographic scope and should link to the geography hierarchy for spatial analysis.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: CAT zones are defined by peril type. Adding peril_id FK to peril reference table for referential integrity. peril_type remains for operational queries.']
  aal_amount decimal(18,2) [note: 'Average annual loss amount in USD expected from catastrophe events in this zone, used for reinsurance treaty pricing and capital allocation.']
  concentration_threshold_amount decimal(18,2) [note: 'Maximum total insured value in USD allowed in this zone before underwriting referral or capacity restrictions are triggered.']
  concentration_threshold_percentage decimal(5,2) [note: 'Maximum percentage of total company exposure allowed in this zone before underwriting referral or capacity restrictions are triggered.']
  country_code varchar [note: 'Three-letter ISO country code where this catastrophe zone is located, used for international exposure reporting.']
  created_timestamp timestamp [note: 'Timestamp when this catastrophe zone record was first created in the system.']
  effective_date date [note: 'Date when this catastrophe zone definition became effective for underwriting and exposure aggregation.']
  expiration_date date [note: 'Date when this catastrophe zone definition expires or is superseded by a new version. Null for open-ended zones.']
  geographic_scope varchar [note: 'Geographic boundaries of the catastrophe zone, such as county list, ZIP code ranges, or latitude/longitude bounding box.']
  iso_territory_code varchar [note: 'ISO-standardized territory code used for rating and catastrophe zone classification in ISO-based rating plans.']
  last_cat_event_date date [note: 'Date of the most recent catastrophe event that impacted this zone, used for loss history and model validation.']
  last_cat_event_loss_amount decimal(18,2) [note: 'Total incurred loss amount in USD from the most recent catastrophe event in this zone, used for model validation and pricing.']
  last_cat_event_name varchar [note: 'Name of the most recent catastrophe event that impacted this zone, such as Hurricane Ian or Northridge Earthquake.']
  last_updated_timestamp timestamp [note: 'Timestamp when this catastrophe zone record was most recently modified, including model updates or threshold changes.']
  model_update_date date [note: 'Date when the catastrophe model version for this zone was last updated or recalibrated.']
  model_version varchar [note: 'Version identifier of the catastrophe model used to define this zone, such as RMS v21.0 or AIR v18.1.']
  modeling_vendor varchar [note: 'Catastrophe modeling vendor whose model defines this zone: RMS, AIR, CoreLogic, KCC, or Internal proprietary model.']
  moratorium_end_date date [note: 'Date when the current catastrophe moratorium is scheduled to end for this zone. Null if no moratorium or open-ended.']
  moratorium_flag boolean [note: 'Indicates whether a catastrophe moratorium is currently in effect, prohibiting new business or policy changes in this zone.']
  moratorium_start_date date [note: 'Date when the current catastrophe moratorium began for this zone. Null if no moratorium is in effect.']
  naic_territory_code varchar [note: 'NAIC-standardized territory code mapping this catastrophe zone to regulatory reporting categories.']
  peril_type varchar [note: 'Primary catastrophe peril associated with this zone: wind, earthquake, flood, hail, wildfire, or tornado.']
  pml_100_year_amount decimal(18,2) [note: 'Probable maximum loss amount in USD for a 100-year return period event in this zone, used for reinsurance attachment point determination.']
  pml_250_year_amount decimal(18,2) [note: 'Probable maximum loss amount in USD for a 250-year return period event in this zone, used for catastrophe excess of loss treaty structuring.']
  pml_500_year_amount decimal(18,2) [note: 'Probable maximum loss amount in USD for a 500-year return period event in this zone, used for regulatory capital and solvency modeling.']
  policy_count varchar [note: 'Number of active policies currently assigned to this catastrophe zone for exposure aggregation and concentration monitoring.']
  regulatory_reporting_code varchar [note: 'Code used for catastrophe zone reporting to state departments of insurance and NAIC annual statement Schedule P catastrophe supplement.']
  reinsurance_attachment_point decimal(18,2) [note: 'Loss amount in USD at which catastrophe excess of loss reinsurance coverage attaches for events in this zone.']
  reinsurance_limit decimal(18,2) [note: 'Maximum reinsurance recovery amount in USD available for catastrophe events in this zone under current treaty structure.']
  state_code varchar [note: 'Two-letter US state code where this catastrophe zone is primarily located, used for regulatory jurisdiction determination.']
  tiv_amount decimal(18,2) [note: 'Total insured value in USD of all policies and insured risks currently assigned to this catastrophe zone.']
  underwriting_restriction_flag boolean [note: 'Indicates whether new business or renewal underwriting restrictions are currently in effect for this catastrophe zone.']
  zone_code varchar [note: 'Insurer-defined alphanumeric code uniquely identifying the catastrophe zone for rating and exposure aggregation.']
  zone_description varchar [note: 'Detailed description of the catastrophe zone, including geographic boundaries, peril characteristics, and modeling assumptions.']
  zone_name varchar [note: 'Human-readable name of the catastrophe zone, such as Florida Wind Zone 1 or California Earthquake Zone A.']
  zone_status varchar [note: 'Current lifecycle status of the catastrophe zone: active for rating, inactive, suspended, or under review for model updates.']
  zone_tier varchar [note: 'Risk tier classification of the catastrophe zone based on loss frequency and severity: tier 1 highest risk, tier 4 lowest risk.']

  Note: 'Insurer-defined CAT zone or territory used for exposure aggregation and PML modeling. One row per zone. Zones map to peril types (wind, quake, flood) and carry AAL and PML thresholds for reinsurance treaty attachment.'
}

Table catastrophegeography.geography {
  geography_id varchar [pk, note: 'Unique identifier for the geography hierarchy node. Primary key.']
  parent_geography_id varchar [note: 'Reference to the parent geography node in the hierarchy, enabling recursive drill-up from ZIP to county to state to country.']
  catastrophe_zone varchar [note: 'Catastrophe exposure zone classification (e.g., hurricane, earthquake, wildfire, flood) for PML (Probable Maximum Loss) and AAL (Average Annual Loss) modeling.']
  census_tract_code varchar [note: 'US Census Bureau tract identifier, an 11-digit code combining state, county, and tract, used for demographic and socioeconomic analysis.']
  coastal_indicator boolean [note: 'Flag indicating whether the geography unit is within a coastal exposure zone, subject to hurricane, storm surge, or coastal flood risk.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the geography unit, enabling global aggregation and regulatory reporting.']
  county_code varchar [note: 'FIPS county code, a five-digit identifier combining state and county codes, used for granular territory rating and catastrophe aggregation.']
  cresta_zone_code varchar [note: 'CRESTA zone identifier for catastrophe modeling and reinsurance reporting, standardizing geographic aggregation for CAT exposure.']
  earthquake_zone varchar [note: 'Seismic hazard zone classification for earthquake exposure, used in catastrophe modeling and underwriting.']
  effective_date date [note: 'Date when this geography record became effective, supporting temporal analysis and historical territory rating.']
  expiration_date date [note: 'Date when this geography record expires or is superseded, supporting temporal analysis and historical territory rating. Null for current records.']
  flood_zone varchar [note: 'FEMA flood hazard zone designation (e.g., A, AE, X, V) for flood exposure assessment and NFIP (National Flood Insurance Program) compliance.']
  geography_code varchar [note: 'Standard code for the geography unit: ISO 3166 country code, FIPS state/county code, ZIP code, CRESTA zone code, or census tract identifier.']
  geography_name varchar [note: 'Human-readable name of the geography unit, such as United States, California, Los Angeles County, or 90210.']
  geography_status varchar [note: 'Current lifecycle status of the geography record: active for in-use geographies, inactive for discontinued, deprecated for superseded, pending for future.']
  geography_type varchar [note: 'Classification of the geography node: country, state, county, ZIP, CRESTA zone, or census tract.']
  hail_zone varchar [note: 'Hail hazard zone classification for severe convective storm exposure, used in catastrophe modeling and underwriting.']
  last_updated_date date [note: 'Date when this geography record was last updated, supporting data quality audits and change tracking.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate in decimal degrees for the centroid of the geography unit, enabling spatial analysis and catastrophe modeling.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate in decimal degrees for the centroid of the geography unit, enabling spatial analysis and catastrophe modeling.']
  median_household_income decimal(15,2) [note: 'Median household income in US dollars for the geography unit, used for socioeconomic segmentation and underwriting.']
  population varchar [note: 'Total population count for the geography unit, used for exposure density analysis and market sizing.']
  rating_territory varchar [note: 'Actuarial rating territory grouping for premium calculation, aggregating geographies into homogeneous risk pools.']
  state_code varchar [note: 'Two-letter state or province abbreviation (e.g., CA, NY, TX) for US and Canadian geographies, used in territory rating and statutory reporting.']
  territory_code varchar [note: 'Insurer-defined territory code used in rating and pricing, mapping geography to rate tables and underwriting rules.']
  time_zone varchar [note: 'IANA time zone identifier for the geography unit, used for timestamp normalization and operational scheduling.']
  tornado_zone varchar [note: 'Tornado hazard zone classification for severe convective storm exposure, used in catastrophe modeling and underwriting.']
  urban_rural_code varchar [note: 'US Census Bureau urban-rural classification code, used for demographic segmentation and territory rating.']
  wildfire_zone varchar [note: 'Wildfire hazard zone classification for wildfire exposure, used in catastrophe modeling and underwriting.']
  wind_zone varchar [note: 'Wind hazard zone classification for hurricane and windstorm exposure, used in catastrophe modeling and underwriting.']
  zip_code varchar [note: 'Five-digit or nine-digit ZIP code (ZIP+4) for US locations, used in rating, underwriting, and catastrophe exposure aggregation.']

  Note: 'Enterprise geography hierarchy node (country, state, county, ZIP, CRESTA zone, census tract). One row per geography unit. Provides the spatial backbone for territory rating, CAT aggregation, and regulatory reporting.'
}

Table catastrophegeography.territory {
  territory_id varchar [pk, note: 'Unique identifier for the rating territory. Primary key.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Territories are associated with CAT zones for exposure aggregation and PML analysis. Adding cat_zone_id FK for referential integrity.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Territories are geographic rating units that should link to the geography hierarchy for spatial analysis.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Rating territories are LOB-specific constructs—personal auto territories differ from homeowners, commercial property, and workers compensation territories.']
  aal_contribution_pct decimal(5,2) [note: 'Percentage contribution of this territory to the overall portfolio AAL for catastrophe risk management.']
  approval_date date [note: 'Date on which the Department of Insurance approved the rate filing containing this territory definition.']
  base_rate decimal(12,2) [note: 'The base premium rate per unit of exposure for this territory, as filed with the DOI.']
  county_list varchar [note: 'Comma-separated list of county names or FIPS codes included in this territory definition.']
  created_timestamp timestamp [note: 'Timestamp when this territory record was first created in the system.']
  crime_index decimal(8,4) [note: 'Composite crime index score for the territory, used in underwriting and pricing for property and liability lines.']
  effective_date date [note: 'Date on which this territory definition and its associated rate relativities become effective for new and renewal business.']
  expiration_date date [note: 'Date on which this territory definition expires or is superseded by a new filing. Null if currently in force.']
  exposure_base varchar [note: 'The unit of exposure to which the rate or loss cost applies, such as per policy, per vehicle, per location, per 100 of payroll.']
  filing_date date [note: 'Date on which the rate filing containing this territory definition was submitted to the Department of Insurance.']
  filing_number varchar [note: 'The official rate filing number assigned by the Department of Insurance for this territory definition.']
  filing_status varchar [note: 'Current regulatory status of the rate filing containing this territory definition.']
  geographic_region varchar [note: 'Classification of the territory by geographic characteristics relevant to risk assessment and pricing.']
  loss_cost decimal(12,2) [note: 'The expected loss cost per unit of exposure for this territory, used in actuarial pricing and rate development.']
  median_household_income decimal(12,2) [note: 'Median household income for the territory, used in underwriting and socioeconomic risk assessment.']
  moratorium_effective_date date [note: 'Date on which the current moratorium became effective, if applicable.']
  moratorium_expiration_date date [note: 'Date on which the current moratorium is scheduled to expire, if applicable.']
  moratorium_flag boolean [note: 'Indicates whether a binding or quoting moratorium is currently in effect for this territory due to catastrophe or regulatory action.']
  notes varchar [note: 'Free-text notes or comments regarding this territory definition, including special instructions or historical context.']
  pml_contribution_pct decimal(5,2) [note: 'Percentage contribution of this territory to the overall portfolio PML for catastrophe risk management.']
  population_density decimal(10,2) [note: 'Average population density per square mile for the territory, used in risk assessment and pricing.']
  protection_class_range varchar [note: 'Range of ISO Public Protection Classification codes applicable to this territory for property rating.']
  rate_relativity decimal(10,6) [note: 'The filed rate relativity factor for this territory, representing the multiplicative adjustment to base rates.']
  residual_market_flag boolean [note: 'Indicates whether this territory is designated as a residual or involuntary market territory requiring special handling.']
  state_code varchar [note: 'Two-letter postal abbreviation of the state or jurisdiction where this territory is filed and effective.']
  territory_code varchar [note: 'The filed territory code as submitted to and approved by the Department of Insurance for rating purposes.']
  territory_name varchar [note: 'Human-readable name or description of the territory, often referencing geographic boundaries or county groupings.']
  tier varchar [note: 'Tiering classification within the territory for additional rate segmentation, if applicable.']
  tiv_concentration decimal(18,2) [note: 'Total insured value concentration within this territory, used for exposure management and catastrophe aggregation.']
  underwriting_tier varchar [note: 'Underwriting tier classification for this territory, indicating appetite and risk selection guidelines.']
  updated_timestamp timestamp [note: 'Timestamp when this territory record was last modified in the system.']
  weather_zone varchar [note: 'Code identifying the weather or climate zone for this territory, relevant for catastrophe and weather-related perils.']
  wind_pool_flag boolean [note: 'Indicates whether this territory is subject to state wind pool or catastrophe fund requirements for coastal exposure.']
  zip_code_list varchar [note: 'Comma-separated list of ZIP codes or ZIP code ranges included in this territory definition.']

  Note: 'Rating territory as filed with the DOI per state and LOB. One row per territory per LOB per state. Carries territory code, effective date, filed rate relativities, residual-market/wind-pool designation flags, and links to the geography hierarchy for'
}

Table catastrophegeography.peril {
  peril_id varchar [pk, note: 'Unique identifier for the peril. Primary key.']
  cat_model_peril_code varchar [note: 'Peril code used in catastrophe modeling platforms such as RMS RiskLink or AIR Touchstone for exposure and loss estimation.']
  catastrophegeography_peril_category varchar [note: 'High-level classification of the peril into natural disasters, man-made events, liability exposures, or other categories.']
  catastrophegeography_peril_code varchar [note: 'Standard alphanumeric code identifying the peril type, used across policy administration and claims systems.']
  catastrophegeography_peril_description varchar [note: 'Detailed description of the peril, including scope, typical coverage scenarios, and exclusions.']
  catastrophegeography_peril_name varchar [note: 'Full business name of the peril, such as Wind, Hail, Earthquake, Flood, Fire, Theft, or Liability.']
  catastrophegeography_peril_status varchar [note: 'Current lifecycle status of the peril definition: active for use, inactive, deprecated, or pending regulatory approval.']
  coverage_form_applicability varchar [note: 'Comma-separated list of ISO or proprietary coverage forms where this peril is included or excluded, such as HO-3, DP-1, CP 10 30, CGL.']
  effective_date date [note: 'Date when this peril definition became effective for underwriting, rating, and claims purposes.']
  endorsement_required varchar [note: 'ISO or proprietary endorsement form number required to add coverage for this peril, if not included in base policy.']
  expiration_date date [note: 'Date when this peril definition expires or is superseded by a new version, nullable for currently active perils.']
  fraud_risk_level varchar [note: 'Assessment of the relative fraud risk associated with claims for this peril, used for SIU referral and investigation prioritization.']
  frequency_classification varchar [note: 'Actuarial classification of the perils expected frequency of occurrence: high, medium, low, or rare.']
  geographic_restriction varchar [note: 'Description of geographic zones or territories where this peril is restricted, excluded, or subject to special underwriting rules.']
  is_cat_peril boolean [note: 'Indicates whether the peril is classified as a catastrophe peril for exposure aggregation, PML modeling, and reinsurance treaty purposes.']
  is_covered_by_standard_policy boolean [note: 'Indicates whether the peril is typically covered under standard policy forms or requires special endorsement or separate policy.']
  is_excluded_by_default boolean [note: 'Indicates whether the peril is excluded from standard coverage and requires explicit endorsement or separate policy to be covered.']
  is_reportable_to_naic boolean [note: 'Indicates whether losses from this peril must be reported separately in NAIC Annual Statement Schedule P or other statutory filings.']
  is_subject_to_state_regulation boolean [note: 'Indicates whether coverage for this peril is subject to special state-level regulatory requirements, rate approval, or mandatory availability.']
  iso_cause_of_loss_code varchar [note: 'ISO-standardized cause-of-loss code used in policy forms, rating, and claims adjudication.']
  last_updated_timestamp timestamp [note: 'Timestamp when this peril record was last modified in the reference catalog.']
  lob_applicability varchar [note: 'Comma-separated list of lines of business where this peril is relevant, such as Homeowners, Commercial Property, Auto Physical Damage, General Liability.']
  naic_peril_code varchar [note: 'NAIC-standardized numeric code for statutory reporting and regulatory filings, used in Schedule P and Annual Statement.']
  nfip_covered boolean [note: 'Indicates whether the peril is covered under the National Flood Insurance Program, relevant for flood perils.']
  notes varchar [note: 'Free-text field for additional notes, special instructions, or clarifications regarding the peril definition and usage.']
  reinsurance_treaty_peril_mapping varchar [note: 'Mapping code or identifier used to link this peril to reinsurance treaty terms, cession rules, and recovery calculations.']
  requires_separate_deductible boolean [note: 'Indicates whether the peril requires a separate deductible, often expressed as a percentage of insured value for CAT perils.']
  requires_separate_limit boolean [note: 'Indicates whether the peril requires a separate coverage limit distinct from the main policy limit, common for flood, earthquake, or wind.']
  requires_specialist_adjuster boolean [note: 'Indicates whether claims for this peril typically require assignment to a specialist adjuster with specific expertise.']
  salvage_potential varchar [note: 'Assessment of the likelihood that damaged property from this peril can be salvaged and sold to offset claim costs.']
  seasonal_pattern varchar [note: 'Description of seasonal occurrence patterns for the peril, such as hurricane season June-November, wildfire season summer-fall.']
  severity_classification varchar [note: 'Actuarial classification of the perils expected loss severity: catastrophic, severe, moderate, or minor.']
  subrogation_potential varchar [note: 'Assessment of the likelihood that losses from this peril can be recovered through subrogation against third parties.']
  typical_deductible_type varchar [note: 'Standard deductible structure applied to this peril: flat dollar amount, percentage of insured value, franchise, or disappearing deductible.']
  typical_investigation_complexity varchar [note: 'Standard level of investigation complexity required for claims involving this peril, affecting adjuster assignment and LAE.']
  version_number varchar [note: 'Version identifier for this peril definition, incremented when classification, codes, or business rules change.']

  Note: 'Reference catalog of insured perils (wind, hail, earthquake, flood, fire, theft, liability). One row per peril. Carries NAIC peril code, CAT vs. non-CAT flag, reinsurance treaty peril mapping, and ISO cause-of-loss code.'
}

Table catastrophegeography.cat_event_loss {
  cat_event_loss_id varchar [pk, note: 'Unique identifier for the catastrophe event loss record. Primary key for this table.']
  accounting_period_id varchar [note: 'Foreign key to the accounting period for which this CAT loss estimate is reported.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: cat_event_loss has plain accident_year and report_year attributes used in Schedule P actuarial development triangles.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: cat_event_loss tracks loss estimates that must be aggregated at the CAT zone level for reinsurance attachment and accumulation management.']
  catastrophe_event_id varchar [note: 'Foreign key to the catastrophe event that triggered this loss estimate.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: cat_event_loss carries gross, ceded, and net loss amounts requiring currency context for reinsurance settlement and NAIC Schedule P reporting.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: cat_event_loss is a loss estimate per CAT event per LOB per geography. geography_code (STRING) is a denormalized natural key; replacing it with geography_id FK to the geography']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Catastrophe event loss estimates are segmented by LOB for Schedule P regulatory reporting, reinsurance treaty attachment point evaluation, and GAAP/SAP financial statement']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: CAT event losses are tracked by peril. Adding peril_id FK to peril reference table for referential integrity. peril_code remains for operational queries.']
  treaty_id varchar [note: 'Foreign key linking to reinsurance.treaty. Business justification: Catastrophe event loss estimates drive treaty layer attachment and exhaustion calculations for reinsurance purchasing decisions, capital modeling, and reinstatement premium triggers.']
  accident_year varchar [note: 'Accident year in which the catastrophe event occurred, used for loss development and reserving.']
  alae_amount decimal(18,2) [note: 'Allocated loss adjustment expenses directly attributable to this CAT event loss segment.']
  average_annual_loss decimal(18,2) [note: 'Average annual loss estimate for this segment based on catastrophe modeling.']
  ceded_loss_amount decimal(18,2) [note: 'Portion of gross loss ceded to reinsurers under treaty or facultative agreements.']
  claim_count_estimate varchar [note: 'Estimated or actual number of claims arising from this CAT event within this segment.']
  confidence_level_percent decimal(5,2) [note: 'Statistical confidence level for modeled loss estimates (e.g., 90%, 95%, 99%).']
  created_timestamp timestamp [note: 'Timestamp when this CAT event loss record was first created in the system.']
  data_quality_score decimal(3,2) [note: 'Quality score for the underlying exposure data used in this estimate, ranging from 0.00 to 1.00.']
  estimate_date date [note: 'Date on which this CAT loss estimate was generated or last updated.']
  estimate_status varchar [note: 'Current status of this CAT loss estimate in the reporting lifecycle.']
  gross_loss_amount decimal(18,2) [note: 'Total estimated or actual loss before reinsurance cessions and recoveries.']
  ibnr_loading_amount decimal(18,2) [note: 'Additional reserve loading for incurred but not reported losses within this CAT event and segment.']
  loss_estimate_type varchar [note: 'Indicates whether the loss is modeled (pre-event), actual (post-event), hybrid, preliminary, or final.']
  loss_ratio_percent decimal(5,2) [note: 'Loss ratio for this CAT event segment, calculated as net loss divided by earned premium.']
  model_vendor varchar [note: 'Vendor of the catastrophe model used for this loss estimate.']
  model_version varchar [note: 'Version identifier of the catastrophe model used to generate this loss estimate (e.g., RMS v21.0).']
  net_loss_amount decimal(18,2) [note: 'Net loss retained by the insurer after reinsurance cessions (gross minus ceded).']
  notes varchar [note: 'Free-text notes or comments regarding this CAT loss estimate, including assumptions or caveats.']
  policy_count varchar [note: 'Number of policies in force within this CAT event, LOB, and geography segment.']
  probable_maximum_loss decimal(18,2) [note: 'Probable maximum loss estimate for this segment at a specified return period (e.g., 250-year PML).']
  report_year varchar [note: 'Calendar year in which this CAT loss estimate was reported or filed.']
  return_period_years varchar [note: 'Return period in years for the PML estimate (e.g., 100, 250, 500 years).']
  total_insured_value decimal(18,2) [note: 'Total insured value of all exposures within this CAT event, LOB, and geography segment.']
  ulae_amount decimal(18,2) [note: 'Unallocated loss adjustment expenses apportioned to this CAT event loss segment.']
  updated_timestamp timestamp [note: 'Timestamp when this CAT event loss record was last modified.']

  Note: 'CAT-attribution loss ESTIMATE per CAT event per LOB per geography (one row each). Holds modeled/actual gross, ceded, and net loss and IBNR loading for Schedule P CAT reporting only -- NOT the financial ledger; authoritative payments/reserves live in'
}

Table catastrophegeography.location_geocode {
  location_geocode_id varchar [pk, note: 'Unique identifier for the location geocode record. Primary key.']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: location_geocode is the per-location SSOT for hazard data. Each geocoded location falls within a CAT zone for exposure aggregation and PML modeling.']
  geography_id varchar [note: 'Foreign key linking to catastrophegeography.geography. Business justification: Location geocodes represent specific geographic points that should link to the geography hierarchy.']
  insured_risk_id varchar [note: 'Foreign key to the insured risk this geocode represents.']
  location_id varchar [note: 'Foreign key to the location master record.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.flood_zone. Business justification: Location geocodes reference FEMA flood zones for flood hazard assessment. Adding flood_zone_id FK for referential integrity.']
  territory_id varchar [note: 'Foreign key linking to catastrophegeography.territory. Business justification: location_geocode has iso_territory_code (STRING) as a denormalized natural key for the rating territory. territory.territory_code is the authoritative code.']
  address_line_1 varchar [note: 'Primary street address of the insured location.']
  address_line_2 varchar [note: 'Secondary address information such as suite, unit, or building number.']
  base_flood_elevation_ft decimal(8,2) [note: 'Base flood elevation in feet above sea level from FEMA FIRM.']
  cat_model_vendor varchar [note: 'Vendor of the catastrophe model used for hazard assessment.']
  cat_model_version varchar [note: 'Version identifier of the catastrophe model used.']
  city varchar [note: 'City name of the insured location.']
  country_code varchar [note: 'Three-letter ISO country code.']
  cresta_zone_code varchar [note: 'CRESTA zone code for catastrophe risk aggregation.']
  earthquake_aal_amount decimal(18,2) [note: 'Average annual loss amount for earthquake peril.']
  earthquake_pml_amount decimal(18,2) [note: 'Probable maximum loss amount for earthquake peril.']
  effective_date date [note: 'Date when this geocode record becomes effective.']
  expiration_date date [note: 'Date when this geocode record expires or is superseded.']
  fema_firm_panel_number varchar [note: 'FEMA FIRM panel identifier for the location.']
  fema_flood_zone varchar [note: 'FEMA flood zone designation from Flood Insurance Rate Map.']
  fips_county_code varchar [note: 'Five-digit FIPS code identifying the county.']
  fips_state_code varchar [note: 'Two-digit FIPS code identifying the state.']
  fire_protection_class varchar [note: 'ISO Public Protection Classification rating, 1 to 10 scale.']
  flood_aal_amount decimal(18,2) [note: 'Average annual loss amount for flood peril.']
  flood_pml_amount decimal(18,2) [note: 'Probable maximum loss amount for flood peril.']
  geocode_match_level varchar [note: 'Precision level of the geocode match. [ENUM-REF-CANDIDATE: rooftop|parcel|street|zip|city|county|state — 7 candidates stripped; promote to reference product]']
  geocode_quality_score decimal(5,2) [note: 'Quality score of the geocoding result, typically 0-100 scale.']
  geocode_source varchar [note: 'Name of the geocoding service or vendor used.']
  geocode_timestamp timestamp [note: 'Date and time when the geocoding was performed.']
  hail_aal_amount decimal(18,2) [note: 'Average annual loss amount for hail peril.']
  hail_pml_amount decimal(18,2) [note: 'Probable maximum loss amount for hail peril.']
  hazard_band_earthquake varchar [note: 'Categorical hazard band for earthquake peril.']
  hazard_band_flood varchar [note: 'Categorical hazard band for flood peril.']
  hazard_band_hurricane varchar [note: 'Categorical hazard band for hurricane peril.']
  hazard_band_wildfire varchar [note: 'Categorical hazard band for wildfire peril.']
  hurricane_aal_amount decimal(18,2) [note: 'Average annual loss amount for hurricane peril.']
  hurricane_pml_amount decimal(18,2) [note: 'Probable maximum loss amount for hurricane peril.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate in decimal degrees.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate in decimal degrees.']
  pml_return_period_years varchar [note: 'Return period in years for PML calculation, typically 100, 250, or 500 years.']
  postal_code varchar [note: 'Five or nine-digit postal code (ZIP code in US).']
  state_province_code varchar [note: 'Two-letter state or province code.']
  tornado_aal_amount decimal(18,2) [note: 'Average annual loss amount for tornado peril.']
  tornado_pml_amount decimal(18,2) [note: 'Probable maximum loss amount for tornado peril.']
  wildfire_aal_amount decimal(18,2) [note: 'Average annual loss amount for wildfire peril.']
  wildfire_pml_amount decimal(18,2) [note: 'Probable maximum loss amount for wildfire peril.']

  Note: 'Per-location SSOT for geocode and hazard: one row per insured location. Stores lat/long, FIPS, CRESTA zone, FEMA FIRM flood zone, base flood elevation, FIRM panel, fire protection class, and model-derived AAL/PML/hazard band per peril and CAT model'
}

Table catastrophegeography.pml_run {
  pml_run_id varchar [pk, note: 'Unique identifier for the PML modeling run. Primary key. One row per run.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: PML runs are submitted to rating agencies and regulators tied to specific reporting periods (e.g., year-end capital adequacy).']
  cat_zone_id varchar [note: 'Foreign key linking to catastrophegeography.cat_zone. Business justification: A PML modeling run is typically scoped to a specific CAT zone for accumulation and PML analysis.']
  catastrophe_event_id varchar [note: 'Reference to the exposure portfolio snapshot used as input for this run.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: PML runs produce currency-denominated return-period loss figures submitted to rating agencies (AM Best, S&P) and regulators.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: PML runs are executed per LOB for reinsurance program design, treaty pricing, and regulatory capital modeling. Rating agencies and regulators require LOB-specific PML disclosure.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: PML runs are executed for specific perils. Adding peril_id FK to peril reference table for referential integrity. peril_code remains for operational queries.']
  pml_approved_by_user_party_id varchar [note: 'Identifier of the user who validated and approved this PML run results.']
  pml_run_owner_party_id varchar [note: 'Identifier of the user who initiated and executed this PML run.']
  ri_agreement_id varchar [note: 'Reference to the reinsurance program applied in net PML calculations.']
  treaty_id varchar [note: 'Foreign key linking to reinsurance.treaty. Business justification: PML runs model treaty structures to calculate net retained loss for capital adequacy, rating agency submissions (AM Best BCAR, S&P capital model), and reinsurance program optimization.']
  aal_gross decimal(18,2) [note: 'Gross average annual loss before reinsurance recoveries.']
  aal_net decimal(18,2) [note: 'Net average annual loss after reinsurance recoveries.']
  approval_date date [note: 'Date when the PML run results were formally approved for use.']
  completion_timestamp timestamp [note: 'Timestamp when the PML modeling run completed processing.']
  data_quality_score decimal(5,2) [note: 'Composite quality score of the exposure data used in this run, expressed as percentage.']
  demand_surge_applied boolean [note: 'Indicates whether demand surge factors were applied in loss calculations.']
  event_set_version varchar [note: 'Version identifier of the stochastic event set used in this run.']
  exposure_as_of_date date [note: 'Effective date of the exposure portfolio snapshot used in this run.']
  geocoding_accuracy_percent decimal(5,2) [note: 'Percentage of exposure locations successfully geocoded to precise coordinates.']
  geography_scope varchar [note: 'Geographic region or territory scope covered by this PML run.']
  location_count varchar [note: 'Number of insured locations included in the exposure portfolio for this run.']
  loss_amplification_applied boolean [note: 'Indicates whether loss amplification factors were applied in calculations.']
  model_name varchar [note: 'Name of the specific catastrophe model used for the run.']
  model_vendor varchar [note: 'Vendor providing the catastrophe modeling platform used for this run.']
  model_version varchar [note: 'Version identifier of the catastrophe model used for this run.']
  notes varchar [note: 'Free-text notes or comments about this PML run, including assumptions or special conditions.']
  policy_count varchar [note: 'Number of policies included in the exposure portfolio for this run.']
  rating_agency_submission_flag boolean [note: 'Indicates whether this PML run is submitted to rating agencies for capital assessment.']
  regulatory_filing_flag boolean [note: 'Indicates whether this PML run is used for regulatory reporting or filing purposes.']
  return_period_1000_gross_pml decimal(18,2) [note: 'Gross PML amount at 1000-year return period before reinsurance.']
  return_period_1000_net_pml decimal(18,2) [note: 'Net PML amount at 1000-year return period after reinsurance recoveries.']
  return_period_100_gross_pml decimal(18,2) [note: 'Gross PML amount at 100-year return period before reinsurance.']
  return_period_100_net_pml decimal(18,2) [note: 'Net PML amount at 100-year return period after reinsurance recoveries.']
  return_period_250_gross_pml decimal(18,2) [note: 'Gross PML amount at 250-year return period before reinsurance.']
  return_period_250_net_pml decimal(18,2) [note: 'Net PML amount at 250-year return period after reinsurance recoveries.']
  return_period_500_gross_pml decimal(18,2) [note: 'Gross PML amount at 500-year return period before reinsurance.']
  return_period_500_net_pml decimal(18,2) [note: 'Net PML amount at 500-year return period after reinsurance recoveries.']
  run_date date [note: 'Date when the PML modeling run was executed.']
  run_duration_minutes varchar [note: 'Total elapsed time in minutes from run initiation to completion.']
  run_name varchar [note: 'Descriptive name assigned to the PML run for identification and reporting purposes.']
  run_number varchar [note: 'Business-assigned unique run number or code for external reference and tracking.']
  run_status varchar [note: 'Current lifecycle status of the PML modeling run.']
  run_timestamp timestamp [note: 'Precise timestamp when the PML modeling run was initiated.']
  run_type varchar [note: 'Classification of the PML run based on its business purpose and frequency.']
  simulation_count varchar [note: 'Number of stochastic simulations executed in this modeling run.']
  tiv_amount decimal(18,2) [note: 'Total insured value of the exposure portfolio included in this run.']
  treaty_effective_date date [note: 'Effective date of the reinsurance treaty used in net PML calculations.']
  vulnerability_set_version varchar [note: 'Version identifier of the vulnerability functions used in this run.']

  Note: 'A probabilistic PML modeling run executed against the exposure portfolio. One row per run. Captures model vendor, model version, run date, return period set, gross and net PML at each return period, and the exposure snapshot used as input.'
}

Table catastrophegeography.accumulation_limit {
  accumulation_limit_id varchar [pk, note: 'Unique identifier for the accumulation limit record. Primary key.']
  approver_party_id varchar [note: 'Foreign key linking to party.party. Business justification: Underwriting governance and audit trails require tracking which internal party (underwriter, executive) approved each cat accumulation limit.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Accumulation limits are reviewed on periodic cycles tied to fiscal/regulatory periods for capital adequacy and reinsurance renewal reporting.']
  cat_zone_id varchar [note: 'Reference to the catastrophe zone to which this accumulation limit applies.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Accumulation limits (limit_amount, net_retention_amount, utilization_amount) are currency-denominated underwriting controls used in reinsurance treaty structuring.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Accumulation limits are set per LOB per peril per zone to control underwriting authority and manage capacity concentration.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Accumulation limits are set per peril. Adding peril_id FK to peril reference table for referential integrity. peril_code remains for operational queries.']
  reinsurance_treaty_id varchar [note: 'Reference to the reinsurance treaty that provides capacity supporting this accumulation limit, if applicable.']
  accumulation_limit_status varchar [note: 'Current lifecycle status of the accumulation limit: active, suspended, expired, pending approval, or withdrawn.']
  approval_authority varchar [note: 'Role or title of the individual or committee authorized to approve this accumulation limit, such as Chief Underwriting Officer or Risk Committee.']
  approval_date date [note: 'Date on which this accumulation limit was formally approved by the designated authority.']
  available_capacity decimal(18,2) [note: 'Remaining capacity available under this accumulation limit, calculated as limit amount minus utilization amount.']
  business_justification varchar [note: 'Textual explanation of the business rationale for setting this accumulation limit at the specified level.']
  calculation_timestamp timestamp [note: 'Timestamp when the utilization and available capacity were last calculated for this accumulation limit.']
  ceded_percent decimal(5,2) [note: 'Percentage of exposure ceded to reinsurers under treaties applicable to this zone and peril.']
  created_timestamp timestamp [note: 'Timestamp when this accumulation limit record was first created in the system.']
  data_quality_score decimal(5,2) [note: 'Score from 0 to 100 indicating the quality and completeness of the underlying exposure data used to calculate utilization against this limit.']
  effective_date date [note: 'Date from which this accumulation limit becomes active and enforceable.']
  expiration_date date [note: 'Date on which this accumulation limit ceases to be active. Null indicates an open-ended limit.']
  geographic_scope varchar [note: 'Textual description of the geographic area covered by this accumulation limit, such as state, region, or custom zone definition.']
  hard_threshold_percent decimal(5,2) [note: 'Utilization percentage at which new business is declined or suspended, typically 95-100 percent of the limit.']
  last_review_date date [note: 'Date on which this accumulation limit was last reviewed by underwriting or risk management.']
  limit_amount decimal(18,2) [note: 'Maximum aggregate exposure amount allowed in this zone for this peril and line of business. Enforces underwriting appetite constraints.']
  limit_basis varchar [note: 'Basis on which the limit is applied: per occurrence, aggregate across all events, or annual aggregate.']
  limit_type varchar [note: 'Type of exposure measure this limit applies to: Total Insured Value, Gross Written Premium, policy count, insured risk count, Probable Maximum Loss, or Average Annual Loss.']
  model_vendor varchar [note: 'Vendor of the catastrophe model used to define exposure and set this limit: RMS, AIR, Karen Clark, EQECAT, internal model, or other.']
  model_version varchar [note: 'Version identifier of the catastrophe model used to calculate exposure and set this accumulation limit.']
  modified_timestamp timestamp [note: 'Timestamp when this accumulation limit record was last modified.']
  net_retention_amount decimal(18,2) [note: 'Amount of exposure retained net of reinsurance under this accumulation limit.']
  next_review_date date [note: 'Scheduled date for the next review of this accumulation limit.']
  notes varchar [note: 'Free-text field for additional comments, exceptions, or context related to this accumulation limit.']
  override_allowed_flag boolean [note: 'Indicates whether underwriters are permitted to override this accumulation limit with appropriate authority. True if override allowed, false otherwise.']
  override_authority_level varchar [note: 'Minimum authority level required to override this accumulation limit, such as Senior Underwriter, Chief Underwriting Officer, or Risk Committee.']
  pml_return_period_years varchar [note: 'Return period in years for the Probable Maximum Loss calculation used to inform this limit, such as 100, 250, 500, or 1000 years.']
  regulatory_reference varchar [note: 'Citation or reference to the specific regulation, statute, or guideline that mandates or informs this accumulation limit.']
  regulatory_requirement_flag boolean [note: 'Indicates whether this accumulation limit is mandated by regulatory or statutory requirements. True if mandated, false otherwise.']
  review_frequency varchar [note: 'Frequency at which this accumulation limit is reviewed and potentially adjusted: daily, weekly, monthly, quarterly, annually, or event-driven.']
  soft_threshold_percent decimal(5,2) [note: 'Utilization percentage at which referral or enhanced monitoring is triggered, typically 80-90 percent of the limit.']
  threshold_action varchar [note: 'Action to be taken when utilization exceeds defined thresholds: allow with monitoring, refer to senior underwriter, decline new business, or suspend writing.']
  utilization_amount decimal(18,2) [note: 'Current aggregate exposure amount utilized against this limit, calculated from in-force policies and insured risks in the zone.']
  utilization_percent decimal(5,2) [note: 'Percentage of the accumulation limit currently utilized, calculated as utilization amount divided by limit amount times 100.']

  Note: 'Insurer-defined maximum aggregate exposure limit per CAT zone, peril, and LOB. One row per zone per peril per LOB. Enforces underwriting appetite constraints; triggers referral or declination when TIV in zone exceeds the approved accumulation cap.'
}

Table catastrophegeography.policy_cat_exposure {
  policy_cat_exposure_id varchar [pk, note: 'Unique identifier for the policy catastrophe exposure record. One row per policy per CAT event or zone.']
  cat_zone_id varchar [note: 'Reference to the catastrophe zone in which the insured risk resides.']
  catastrophe_event_id varchar [note: 'Reference to the specific catastrophe event to which this policy is exposed. Null if exposure is zone-based only.']
  coverage_id varchar [note: 'Reference to the primary coverage providing protection against the catastrophe peril.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: policy_cat_exposure carries TIV, limit, deductible, and estimated loss amounts for bordereaux reporting and cat exposure aggregation.']
  insured_risk_id varchar [note: 'Reference to the specific insured risk (property, building, vehicle) exposed to the catastrophe.']
  line_of_business_id varchar [note: 'Foreign key linking to shared.line_of_business. Business justification: Catastrophe exposure aggregation and PML calculation require LOB segmentation for reinsurance treaty attachment, regulatory capital calculation (RBC), and ORSA scenario analysis.']
  location_geocode_id varchar [note: 'Foreign key linking to catastrophegeography.location_geocode. Business justification: policy_cat_exposure carries denormalized geocode fields (latitude, longitude, geocode_quality) that are authoritatively owned by location_geocode.']
  location_id varchar [note: 'Reference to the geographic location of the insured risk for exposure aggregation.']
  peril_id varchar [note: 'Foreign key linking to catastrophegeography.peril. Business justification: Policy CAT exposures are tracked by peril. Adding peril_id FK to peril reference table for referential integrity. peril_code remains for operational queries.']
  policy_id varchar [note: 'Reference to the in-force policy exposed to the catastrophe event or zone.']
  policy_term_id varchar [note: 'Reference to the specific policy term period during which the exposure exists.']
  aal_amount decimal(18,2) [note: 'Average annual loss amount for this exposure, used for pricing and reinsurance treaty structuring.']
  as_of_date date [note: 'Snapshot date for which this catastrophe exposure record is valid, supporting point-in-time analysis.']
  bordereaux_reporting_flag boolean [note: 'Indicates whether this exposure must be reported to reinsurers via bordereaux submissions.']
  building_area_sqft decimal(12,2) [note: 'Total building area in square feet, used for exposure density and loss estimation.']
  cat_model_vendor varchar [note: 'Vendor of the catastrophe model used to generate loss estimates (RMS, AIR, CoreLogic, KCC).']
  cat_model_version varchar [note: 'Version identifier of the catastrophe model used for this exposure calculation.']
  construction_class varchar [note: 'Construction type classification (frame, masonry, fire-resistive, non-combustible) per COPE framework.']
  created_timestamp timestamp [note: 'Timestamp when this catastrophe exposure record was first created in the system.']
  data_quality_score decimal(5,2) [note: 'Quality score (0-100) indicating completeness and accuracy of exposure data used in modeling.']
  deductible_amount decimal(18,2) [note: 'Deductible amount or percentage applicable to catastrophe claims for this exposure.']
  deductible_type varchar [note: 'Type of deductible applied to catastrophe losses (flat dollar, percentage of TIV, franchise).']
  estimated_gross_loss_amount decimal(18,2) [note: 'Modeled or estimated gross loss amount for this exposure, used in FNOL triage and reinsurance bordereaux.']
  estimated_net_loss_amount decimal(18,2) [note: 'Estimated net loss after deductible and policy limits, used for reserving and reinsurance recovery estimation.']
  exposure_effective_date date [note: 'Date when the catastrophe exposure begins for this policy and location.']
  exposure_expiration_date date [note: 'Date when the catastrophe exposure ends for this policy and location.']
  exposure_status varchar [note: 'Current status of the catastrophe exposure record (active, expired, cancelled, suspended).']
  fnol_triage_priority varchar [note: 'Priority level for FNOL triage based on estimated loss severity and policy characteristics.']
  limit_amount decimal(18,2) [note: 'Maximum coverage limit applicable to the catastrophe peril for this policy and location.']
  model_run_date date [note: 'Date when the catastrophe model was executed to generate loss estimates for this exposure.']
  notes varchar [note: 'Free-text notes capturing additional context, exceptions, or special handling instructions for this exposure.']
  number_of_stories varchar [note: 'Number of stories or floors in the insured building, used for wind and earthquake modeling.']
  occupancy_class varchar [note: 'Occupancy classification of the insured property (residential, commercial, industrial, agricultural) per COPE framework.']
  pml_amount decimal(18,2) [note: 'Probable maximum loss amount for this exposure at a specified return period, used for capital and reinsurance planning.']
  pml_return_period_years varchar [note: 'Return period in years for the PML calculation (e.g., 100, 250, 500, 1000 year event).']
  protection_class varchar [note: 'Fire protection class or ISO Public Protection Classification (PPC) for the location.']
  reinsurance_program_code varchar [note: 'Code identifying the reinsurance program or treaty applicable to this catastrophe exposure.']
  retention_amount decimal(18,2) [note: 'Net retention amount after reinsurance cession for this catastrophe exposure.']
  tiv_amount decimal(18,2) [note: 'Total insured value of the risk exposed to the catastrophe, used for PML and AAL calculations.']
  treaty_share_percent decimal(5,2) [note: 'Percentage of exposure ceded to reinsurance treaties, used for bordereaux generation and net exposure calculation.']
  updated_timestamp timestamp [note: 'Timestamp when this catastrophe exposure record was last modified.']
  year_built varchar [note: 'Year the insured building or structure was originally constructed, used for vulnerability assessment.']

  Note: 'Association linking an in-force policy to a CAT event or CAT zone for exposure tracking. One row per policy per CAT event or zone. Carries TIV, coverage type, and estimated gross loss used in FNOL triage and reinsurance bordereaux generation.'
}

Table shared.currency {
  currency_id varchar [pk, note: 'Unique identifier for the currency. Primary key.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code of the primary issuing country (e.g., USA, GBR, JPN).']
  country_name varchar [note: 'Full name of the primary country or territory that issues the currency.']
  created_timestamp timestamp [note: 'Timestamp when the currency record was first created in the system.']
  currency_code varchar [note: 'Three-letter alphabetic ISO 4217 currency code (e.g., USD, EUR, GBP, CAD, JPY).']
  currency_name varchar [note: 'Full official name of the currency (e.g., United States Dollar, Euro, British Pound Sterling).']
  display_format varchar [note: 'Standard display format pattern for currency amounts (e.g., $1,234.56 or 1.234,56 €).']
  effective_date date [note: 'Date when the currency became officially recognized and available for use in the system.']
  expiration_date date [note: 'Date when the currency was or will be withdrawn from circulation. Null for active currencies.']
  is_active boolean [note: 'Indicates whether the currency is currently active and in circulation for financial transactions.']
  is_crypto boolean [note: 'Indicates whether the currency is a cryptocurrency or digital asset rather than fiat currency.']
  is_precious_metal boolean [note: 'Indicates whether the currency represents a precious metal commodity (e.g., XAU for gold, XAG for silver).']
  minor_unit varchar [note: 'Number of decimal places for the currency\'s minor unit (e.g., 2 for USD cents, 0 for JPY).']
  notes varchar [note: 'Additional notes or comments about the currency, including special handling instructions or historical context.']
  numeric_code varchar [note: 'Three-digit numeric ISO 4217 currency code (e.g., 840 for USD, 978 for EUR).']
  rounding_method varchar [note: 'Standard rounding method applied to currency amounts (standard, up, down, nearest).']
  sort_order varchar [note: 'Numeric value used to control the display order of currencies in user interfaces and reports.']
  symbol varchar [note: 'Standard symbol used to represent the currency (e.g., $, €, £, ¥).']
  updated_timestamp timestamp [note: 'Timestamp when the currency record was last modified in the system.']

  Note: 'Reference catalog of ISO 4217 currencies used across premium, claim, billing, and reinsurance financial transactions. One row per currency code. Carries code, name, minor unit, and active flag.'
}

Table shared.line_of_business {
  line_of_business_id varchar [pk, note: 'Unique identifier for the line of business. Primary key. One row per LOB.']
  catastrophe_exposed boolean [note: 'Indicates whether this line of business is exposed to catastrophe perils such as hurricane, earthquake, wildfire, requiring CAT modeling and PML analysis.']
  combined_ratio_target_pct decimal(5,2) [note: 'Target combined ratio percentage for this line of business, calculated as loss ratio plus expense ratio, used for profitability assessment.']
  created_timestamp timestamp [note: 'Timestamp when this line of business record was first created in the system.']
  default_commission_pct decimal(5,2) [note: 'Standard commission percentage paid to producers for new business in this line of business, subject to producer appointment and agency agreement terms.']
  default_policy_term_months varchar [note: 'Standard policy term duration in months for this line of business, typically 12 months for annual policies or 6 months for semi-annual policies.']
  display_order varchar [note: 'Numeric sequence for sorting and displaying lines of business in user interfaces, reports, and policy administration screens.']
  effective_date date [note: 'Date when this line of business became available for underwriting and policy issuance.']
  expense_ratio_target_pct decimal(5,2) [note: 'Target expense ratio percentage for this line of business, including commission, underwriting expenses, and general overhead allocation.']
  expiration_date date [note: 'Date when this line of business was discontinued or withdrawn from the market. Null for active lines.']
  is_admitted boolean [note: 'Indicates whether this line of business is written on an admitted basis, subject to state guaranty fund protection and rate/form regulation.']
  is_surplus_lines boolean [note: 'Indicates whether this line of business is written on a surplus lines basis, requiring stamping office approval and diligent search documentation.']
  iso_line_code varchar [note: 'ISO standard code for the line of business, used for forms, rating, and industry benchmarking.']
  line_of_business_description varchar [note: 'Detailed business description of the line of business, including coverage scope, typical insured risks, and key characteristics.']
  line_of_business_status varchar [note: 'Current operational status of the line of business, indicating whether it is actively written, inactive, discontinued, or pending regulatory approval.']
  lob_abbreviation varchar [note: 'Standard industry abbreviation for the line of business, such as HO, PAP, CGL, BOP, CPP, WC, CA.']
  lob_category varchar [note: 'High-level classification of the line of business into Personal Lines, Commercial Lines, Specialty Lines, or Surplus Lines.']
  lob_code varchar [note: 'Short alphanumeric code uniquely identifying the line of business. Used across policy, coverage, premium, claim, and reinsurance systems.']
  lob_name varchar [note: 'Full business name of the line of business, such as Homeowners, Personal Auto Policy, Commercial General Liability, Business Owners Policy.']
  lob_type varchar [note: 'Primary type classification of the line of business, indicating whether it is Property, Casualty, Liability, Auto, Workers Compensation, or Package coverage.']
  loss_ratio_target_pct decimal(5,2) [note: 'Target loss ratio percentage for this line of business, used for pricing, underwriting guidelines, and profitability monitoring.']
  minimum_premium_amount decimal(15,2) [note: 'Minimum premium amount in USD required to issue a policy for this line of business, enforced at underwriting and rating.']
  naic_line_code varchar [note: 'Official NAIC numeric code for the line of business, used in statutory reporting and Schedule P filings.']
  regulatory_approval_date date [note: 'Date when the line of business received regulatory approval from the state Department of Insurance for writing new business.']
  reinsurance_treaty_applicable boolean [note: 'Indicates whether this line of business is covered under one or more reinsurance treaties, requiring cession and bordereaux reporting.']
  requires_state_filing boolean [note: 'Indicates whether rates, forms, and policy language for this line of business require prior approval or filing with state regulators.']
  schedule_p_line_number varchar [note: 'NAIC Schedule P line number for statutory loss reserve reporting, used in annual statement filings and actuarial reserve analysis.']
  supports_package_policy boolean [note: 'Indicates whether this line of business can be combined with other lines into a package policy such as Commercial Package Policy or Business Owners Policy.']
  updated_timestamp timestamp [note: 'Timestamp when this line of business record was last modified.']

  Note: 'Reference catalog of P&C lines of business (HO, PAP, CGL, BOP, CPP, WC, Commercial Auto, Umbrella). One row per LOB. SSOT for LOB codes referenced by policy, coverage, premium, claim, and reinsurance.'
}

Table shared.calendar {
  calendar_id varchar [pk, note: 'Unique identifier for the calendar period record. Primary key.']
  accident_year varchar [note: 'Four-digit accident year for loss reserving and IBNR calculations per NAIC Schedule P.']
  close_date date [note: 'Date when the period was closed for accounting purposes.']
  created_timestamp timestamp [note: 'Timestamp when this calendar period record was first created in the system.']
  day_count varchar [note: 'Number of days in the period, used for premium earning and reserve calculations.']
  end_date date [note: 'Last date of the calendar period, inclusive.']
  fiscal_month varchar [note: 'Fiscal month number (1-12) within the fiscal year.']
  fiscal_quarter varchar [note: 'Fiscal quarter number (1-4) within the fiscal year.']
  fiscal_year varchar [note: 'Four-digit fiscal year as defined by the organization\'s fiscal calendar.']
  fiscal_year_start_month varchar [note: 'Calendar month (1-12) when the fiscal year begins for this organization.']
  gaap_period_key varchar [note: 'Period identifier for GAAP financial reporting and consolidation.']
  ifrs17_period_key varchar [note: 'Period identifier for IFRS 17 insurance contracts standard reporting.']
  is_closed boolean [note: 'Indicates whether the period is closed for financial transactions and reporting.']
  is_current_period boolean [note: 'Indicates whether this period includes the current system date.']
  is_leap_year boolean [note: 'Indicates whether the calendar year is a leap year (366 days).']
  modified_timestamp timestamp [note: 'Timestamp when this calendar period record was last modified.']
  month varchar [note: 'Calendar month number (1-12) within the calendar year.']
  naic_reporting_quarter varchar [note: 'Quarter number (1-4) for NAIC quarterly statement filing.']
  naic_reporting_year varchar [note: 'Four-digit year for NAIC Annual Statement and Schedule P/F reporting.']
  period_key varchar [note: 'Business identifier for the period in standard format (e.g., 2024-Q1, 2024-01, AY2024, PY2024-01-01).']
  period_name varchar [note: 'Human-readable name of the period (e.g., January 2024, Q1 FY2024, Accident Year 2024).']
  period_status varchar [note: 'Current status of the period for transaction posting and reporting.']
  period_type varchar [note: 'Type of calendar period: Calendar Year (CY), Policy Year (PY), Accident Year (AY), Fiscal Year, Quarter, Month, or Week. [ENUM-REF-CANDIDATE']
  policy_year varchar [note: 'Four-digit policy year for premium and loss aggregation by policy effective date cohort.']
  quarter varchar [note: 'Calendar quarter number (1-4) within the calendar year.']
  reporting_period_key varchar [note: 'Standardized key for regulatory and statutory reporting (e.g., 2024Q1, 202401).']
  sap_period_key varchar [note: 'Period identifier for Statutory Accounting Principles reporting and compliance.']
  start_date date [note: 'First date of the calendar period, inclusive.']
  valuation_date date [note: 'Date used for reserve valuation, loss triangle development, and actuarial analysis for this period.']
  week varchar [note: 'ISO week number (1-53) within the calendar year.']
  year varchar [note: 'Four-digit calendar year (e.g., 2024).']

  Note: 'Enterprise calendar reference of fiscal, accident, policy, and calendar-year periods. One row per period. Complements domain-local accounting_period tables by providing a single cross-domain date dimension.'
}

