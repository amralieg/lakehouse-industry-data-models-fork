ind:totalEstimatedUnits rdf:type rdf:Property ;
    rdfs:label 'Total Estimated Units' ;
    rdfs:comment 'The total estimated units of production or service over the assets useful life, used for units of production depreciation.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
