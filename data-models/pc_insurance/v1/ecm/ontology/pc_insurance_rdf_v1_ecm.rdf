ind:driverLicenseState rdf:type rdf:Property ;
    rdfs:label 'Driver License State' ;
    rdfs:comment 'Two-letter state code where the driver\'s license was issued.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverLicenseStatus rdf:type rdf:Property ;
    rdfs:label 'Driver License Status' ;
    rdfs:comment 'Current status of the driver\'s license as verified through Motor Vehicle Report (MVR).' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverTrainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Driver Training Completion Date' ;
    rdfs:comment 'Date when the driver completed the approved training course.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driverTrainingCompletionIndicator rdf:type rdf:Property ;
    rdfs:label 'Driver Training Completion Indicator' ;
    rdfs:comment 'Flag indicating whether the driver has completed an approved defensive driving or driver training course, may qualify for discount.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:duiIndicator rdf:type rdf:Property ;
    rdfs:label 'Dui Indicator' ;
    rdfs:comment 'Flag indicating whether the driver has a DUI or DWI conviction on record, critical for underwriting decisions.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:goodStudentDiscountIndicator rdf:type rdf:Property ;
    rdfs:label 'Good Student Discount Indicator' ;
    rdfs:comment 'Flag indicating whether the driver qualifies for good student discount based on academic performance.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrScore rdf:type rdf:Property ;
    rdfs:label 'Mvr Score' ;
    rdfs:comment 'Numerical score derived from the driver\'s Motor Vehicle Report, used in underwriting and rating decisions.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usagePercentage rdf:type rdf:Property ;
    rdfs:label 'Usage Percentage' ;
    rdfs:comment 'Percentage of time this driver operates the assigned vehicle, used for rating and premium calculation. Range 0.00 to 100.00.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:violationCount3yr rdf:type rdf:Property ;
    rdfs:label 'Violation Count 3yr' ;
    rdfs:comment 'Number of moving violations reported for this driver in the past three years, impacts rating tier.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:experienceModId rdf:type rdf:Property ;
    rdfs:label 'Experience Mod Id' ;
    rdfs:comment 'Unique identifier for the experience modification record.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByModId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Mod Id' ;
    rdfs:comment 'Reference to the experience modification record that supersedes this one, used to track modification history.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExperienceMod .

ind:actualLossAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Loss Amount' ;
    rdfs:comment 'Actual incurred loss amount for the insured during the rating period, used as the numerator in the EMod calculation.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Date' ;
    rdfs:comment 'Date on which the insured filed an appeal to contest the experience modification.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolution Date' ;
    rdfs:comment 'Date on which the appeal was resolved by the rating bureau.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealStatus rdf:type rdf:Property ;
    rdfs:label 'Appeal Status' ;
    rdfs:comment 'Status of any appeal filed by the insured to contest the experience modification calculation.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ballastValue rdf:type rdf:Property ;
    rdfs:label 'Ballast Value' ;
    rdfs:comment 'Ballast or credibility factor applied in the experience modification calculation to stabilize the mod for smaller insureds.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bureauCode rdf:type rdf:Property ;
    rdfs:label 'Bureau Code' ;
    rdfs:comment 'Code identifying the rating bureau that issued the experience modification, such as NCCI or a state-specific bureau.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bureauName rdf:type rdf:Property ;
    rdfs:label 'Bureau Name' ;
    rdfs:comment 'Name of the rating bureau that issued the experience modification.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excessLossComponent rdf:type rdf:Property ;
    rdfs:label 'Excess Loss Component' ;
    rdfs:comment 'Dollar amount of excess losses used in the experience modification calculation, representing losses above the primary threshold.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedExcessLossAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Excess Loss Amount' ;
    rdfs:comment 'Expected excess loss amount used in the experience modification formula.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Loss Amount' ;
    rdfs:comment 'Expected loss amount for the insured based on industry averages and exposure, used as the denominator in the EMod calculation.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedPrimaryLossAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Primary Loss Amount' ;
    rdfs:comment 'Expected primary loss amount used in the experience modification formula.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indemnityClaimCount rdf:type rdf:Property ;
    rdfs:label 'Indemnity Claim Count' ;
    rdfs:comment 'Number of indemnity claims included in the experience period, representing claims with wage replacement payments.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interstateModIndicator rdf:type rdf:Property ;
    rdfs:label 'Interstate Mod Indicator' ;
    rdfs:comment 'Indicates whether the experience modification applies across multiple states or is state-specific.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalOnlyClaimCount rdf:type rdf:Property ;
    rdfs:label 'Medical Only Claim Count' ;
    rdfs:comment 'Number of medical-only claims included in the experience period, representing claims with no indemnity payments.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modChangeReason rdf:type rdf:Property ;
    rdfs:label 'Mod Change Reason' ;
    rdfs:comment 'Reason for change in the experience modification value compared to the prior period, such as improved loss experience or increased claims.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modNumber rdf:type rdf:Property ;
    rdfs:label 'Mod Number' ;
    rdfs:comment 'Business identifier for the experience modification record, typically assigned by the rating bureau.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modStatus rdf:type rdf:Property ;
    rdfs:label 'Mod Status' ;
    rdfs:comment 'Current lifecycle status of the experience modification record.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modType rdf:type rdf:Property ;
    rdfs:label 'Mod Type' ;
    rdfs:comment 'Type of experience modification, indicating the line of business or adjustment category.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modValue rdf:type rdf:Property ;
    rdfs:label 'Mod Value' ;
    rdfs:comment 'The calculated experience modification factor applied to the base premium. A value of 1.00 is neutral; below 1.00 is a credit; above 1.00 is a debit.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payrollAmount rdf:type rdf:Property ;
    rdfs:label 'Payroll Amount' ;
    rdfs:comment 'Total payroll amount for the rating period, used as the exposure base for workers compensation experience rating.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryLossComponent rdf:type rdf:Property ;
    rdfs:label 'Primary Loss Component' ;
    rdfs:comment 'Dollar amount of primary losses used in the experience modification calculation, typically capped per occurrence.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorModValue rdf:type rdf:Property ;
    rdfs:label 'Prior Mod Value' ;
    rdfs:comment 'Experience modification value from the immediately preceding rating period, used for trend analysis and comparison.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Rating Period End Date' ;
    rdfs:comment 'End date of the experience period used to calculate the modification factor.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Rating Period Start Date' ;
    rdfs:comment 'Start date of the experience period used to calculate the modification factor.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revisedModValue rdf:type rdf:Property ;
    rdfs:label 'Revised Mod Value' ;
    rdfs:comment 'Revised experience modification value resulting from a successful appeal or correction.' ;
    rdfs:domain ind:ExperienceMod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposurePeriodId rdf:type rdf:Property ;
    rdfs:label 'Exposure Period Id' ;
    rdfs:comment 'Unique identifier for the exposure period record.' ;
    rdfs:domain ind:ExposurePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catZone rdf:type rdf:Property ;
    rdfs:label 'Cat Zone' ;
    rdfs:comment 'Catastrophe zone classification for this exposure period.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earnedDays rdf:type rdf:Property ;
    rdfs:label 'Earned Days' ;
    rdfs:comment 'Number of days earned as of the calculation date within the exposure period.' ;
    rdfs:domain ind:ExposurePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:earnedExposureUnits rdf:type rdf:Property ;
    rdfs:label 'Earned Exposure Units' ;
    rdfs:comment 'Exposure units earned as of the calculation date, prorated over the exposure period.' ;
    rdfs:domain ind:ExposurePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Endorsement Effective Date' ;
    rdfs:comment 'Effective date of the endorsement that created or modified this exposure period.' ;
    rdfs:domain ind:ExposurePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unearnedExposureUnits rdf:type rdf:Property ;
    rdfs:label 'Unearned Exposure Units' ;
    rdfs:comment 'Exposure units remaining unearned as of the calculation date.' ;
    rdfs:domain ind:ExposurePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writtenExposureUnits rdf:type rdf:Property ;
    rdfs:label 'Written Exposure Units' ;
    rdfs:comment 'Total exposure units written at policy inception or endorsement effective date.' ;
    rdfs:domain ind:ExposurePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:floodZoneAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Assignment Id' ;
    rdfs:comment 'Unique identifier for the flood zone assignment record.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cbrsUnitCode rdf:type rdf:Property ;
    rdfs:label 'Cbrs Unit Code' ;
    rdfs:comment 'Identifier for the specific CBRS unit if the location falls within a designated coastal barrier area.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
