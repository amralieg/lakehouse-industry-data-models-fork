ind:occupationalGroup rdf:type rdf:Property ;
    rdfs:label 'Occupational Group' ;
    rdfs:comment 'Specific occupational group or series within the job family (e.g., \'Civil Engineering\', \'Highway Maintenance\').' ;
    rdfs:domain ind:SalaryGrade ;
    rdf:type owl:DatatypeProperty ;
