    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recallCount rdf:type rdf:Property ;
    rdfs:label 'Recall Count' ;
    rdfs:comment 'Number of open safety recalls affecting this vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:manufacturerCountry rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Country' ;
    rdfs:comment 'Three-letter country code indicating the country where the vehicle was manufactured, derived from VIN.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assemblyPlant rdf:type rdf:Property ;
    rdfs:label 'Assembly Plant' ;
    rdfs:comment 'Manufacturing plant or facility where the vehicle was assembled, derived from VIN.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:importFlag rdf:type rdf:Property ;
    rdfs:label 'Import Flag' ;
    rdfs:comment 'Indicates whether the vehicle was imported from outside the United States.' ;
