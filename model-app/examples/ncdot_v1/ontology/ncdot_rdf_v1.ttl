ind:reportedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reported Timestamp' ;
    rdfs:comment 'Precise date and time when the incident was first reported to NCDOT or relevant authority.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:occurredDate rdf:type rdf:Property ;
    rdfs:label 'Occurred Date' ;
    rdfs:comment 'Date when the incident actually occurred (may differ from reported date).' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:occurredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Occurred Timestamp' ;
    rdfs:comment 'Precise date and time when the incident actually occurred.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:detectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detected Timestamp' ;
    rdfs:comment 'Date and time when the incident was first detected by automated systems, IMAP patrol, or other monitoring mechanisms.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clearedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cleared Timestamp' ;
    rdfs:comment 'Date and time when the incident was cleared and normal operations resumed.' ;
