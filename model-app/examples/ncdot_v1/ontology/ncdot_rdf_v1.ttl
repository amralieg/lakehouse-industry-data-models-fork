ind:qualityControlPerformed rdf:type rdf:Property ;
    rdfs:label 'Quality Control Performed' ;
    rdfs:comment 'Flag indicating whether quality control testing was performed during the maintenance work.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyApplicable rdf:type rdf:Property ;
    rdfs:label 'Warranty Applicable' ;
    rdfs:comment 'Flag indicating whether warranty coverage applies to the maintenance work performed.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingPeriod rdf:type rdf:Property ;
