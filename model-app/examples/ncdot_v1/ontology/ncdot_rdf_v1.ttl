    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:economicDevelopmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Economic Development Indicator' ;
    rdfs:comment 'Indicates whether the project supports economic development objectives.' ;
    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multimodalIndicator rdf:type rdf:Property ;
