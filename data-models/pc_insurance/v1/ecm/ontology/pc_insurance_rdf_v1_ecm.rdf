ind:suffix rdf:type rdf:Property ;
    rdfs:label 'Suffix' ;
    rdfs:comment 'Name suffix such as Jr., Sr., III, Esq. Applicable only when party_type is individual.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityRating rdf:type rdf:Property ;
    rdfs:label 'Data Quality Rating' ;
    rdfs:comment 'Actuarial assessment of the quality and credibility of the underlying claims data used in the reserve study.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ibnrClaimCountEstimate rdf:type rdf:Property ;
    rdfs:label 'Ibnr Claim Count Estimate' ;
    rdfs:comment 'Estimated number of claims incurred but not yet reported to the insurer as of the valuation date.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Estimate Amount' ;
    rdfs:comment 'Total reserve amount estimated by the study, representing the actuarial best estimate of unpaid claim liabilities.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveHighEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve High Estimate Amount' ;
    rdfs:comment 'Upper bound of the reserve estimate range, representing an optimistic or high-severity scenario.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveLowEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Low Estimate Amount' ;
    rdfs:comment 'Lower bound of the reserve estimate range, representing a conservative or pessimistic scenario.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageSubrogationAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Subrogation Amount' ;
    rdfs:comment 'Anticipated recoveries from salvage and subrogation, reducing net reserve requirements.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:studyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Study Effective Date' ;
    rdfs:comment 'Date when the reserve study becomes effective for financial reporting and reserving purposes.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Study Expiration Date' ;
    rdfs:comment 'Date when the reserve study is superseded or no longer applicable for reserving purposes.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studyName rdf:type rdf:Property ;
    rdfs:label 'Study Name' ;
    rdfs:comment 'Descriptive name of the reserve study for identification and reporting purposes.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyNotes rdf:type rdf:Property ;
    rdfs:label 'Study Notes' ;
    rdfs:comment 'Free-text commentary and assumptions documented by the actuary regarding methodology, data quality, or special considerations.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyNumber rdf:type rdf:Property ;
    rdfs:label 'Study Number' ;
    rdfs:comment 'Business identifier for the reserve study, externally referenced in actuarial reports and regulatory filings.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyStatus rdf:type rdf:Property ;
    rdfs:label 'Study Status' ;
    rdfs:comment 'Current lifecycle status of the reserve study indicating its approval and publication state.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyType rdf:type rdf:Property ;
    rdfs:label 'Study Type' ;
    rdfs:comment 'Classification of reserve study: case reserves, incurred but not reported, unallocated loss adjustment expense, allocated loss adjustment expense, salvage and subrogation, or unallocated reserves.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ultimateLossEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Estimate Amount' ;
    rdfs:comment 'Actuarial estimate of total losses that will ultimately be paid for the cohort, including paid and unpaid amounts.' ;
    rdfs:domain ind:ReserveStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supervisorAnalystId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Analyst Id' ;
    rdfs:comment 'Identifier of the supervising actuarial analyst for this analyst.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ActuarialAnalyst .

ind:analystType rdf:type rdf:Property ;
    rdfs:label 'Analyst Type' ;
    rdfs:comment 'Specialization area of the actuarial analyst within the organization.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointedActuaryFlag rdf:type rdf:Property ;
    rdfs:label 'Appointed Actuary Flag' ;
    rdfs:comment 'Indicates whether the analyst is designated as the appointed actuary for statutory reporting purposes.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialDate rdf:type rdf:Property ;
    rdfs:label 'Credential Date' ;
    rdfs:comment 'Date when the analyst achieved their current professional credential.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialDesignation rdf:type rdf:Property ;
    rdfs:label 'Credential Designation' ;
    rdfs:comment 'Specific professional designation held by the actuarial analyst.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingLevel rdf:type rdf:Property ;
    rdfs:label 'Credentialing Level' ;
    rdfs:comment 'Professional actuarial credentialing level achieved by the analyst.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentCode rdf:type rdf:Property ;
    rdfs:label 'Department Code' ;
    rdfs:comment 'Code identifying the department where the actuarial analyst is assigned.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentName rdf:type rdf:Property ;
    rdfs:label 'Department Name' ;
    rdfs:comment 'Name of the department where the actuarial analyst is assigned.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Last Training Date' ;
    rdfs:comment 'Date of the most recent professional training or continuing education completed by the analyst.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:officeLocation rdf:type rdf:Property ;
    rdfs:label 'Office Location' ;
    rdfs:comment 'Physical office location or site where the actuarial analyst is based.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLineOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Primary Line Of Business' ;
    rdfs:comment 'Primary insurance line of business the analyst specializes in analyzing.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifiedActuaryFlag rdf:type rdf:Property ;
    rdfs:label 'Qualified Actuary Flag' ;
    rdfs:comment 'Indicates whether the analyst meets regulatory requirements as a qualified actuary for statutory filings.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remoteWorkFlag rdf:type rdf:Property ;
    rdfs:label 'Remote Work Flag' ;
    rdfs:comment 'Indicates whether the analyst is authorized to work remotely.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signingAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Signing Authority Flag' ;
    rdfs:comment 'Indicates whether the analyst has authority to sign actuarial opinions and statements.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workScheduleType rdf:type rdf:Property ;
    rdfs:label 'Work Schedule Type' ;
    rdfs:comment 'Employment schedule type for the actuarial analyst.' ;
    rdfs:domain ind:ActuarialAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageClaimCycleTimeDays rdf:type rdf:Property ;
    rdfs:label 'Average Claim Cycle Time Days' ;
    rdfs:comment 'Average number of days the TPA takes to close a claim from first notice of loss to final settlement.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsHandlingAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Claims Handling Authority Limit' ;
    rdfs:comment 'Maximum monetary amount the TPA is authorized to settle claims without escalation.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataExchangeMethod rdf:type rdf:Property ;
    rdfs:label 'Data Exchange Method' ;
    rdfs:comment 'Primary technical method used to exchange claim data between the insurer and TPA systems.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeStructureType rdf:type rdf:Property ;
    rdfs:label 'Fee Structure Type' ;
    rdfs:comment 'Pricing model used to compensate the TPA for claims administration services.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tpaName rdf:type rdf:Property ;
    rdfs:label 'Tpa Name' ;
    rdfs:comment 'Legal business name of the third-party administrator organization.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentProcessingEnabled rdf:type rdf:Property ;
    rdfs:label 'Payment Processing Enabled' ;
    rdfs:comment 'Indicates whether the TPA is authorized to process and issue claim payments on behalf of the insurer.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveSettingAuthority rdf:type rdf:Property ;
    rdfs:label 'Reserve Setting Authority' ;
    rdfs:comment 'Indicates whether the TPA has authority to establish and adjust loss reserves.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Service Scope Description' ;
    rdfs:comment 'Detailed description of the claims administration and related services provided by the TPA.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaResponseTimeHours rdf:type rdf:Property ;
    rdfs:label 'Sla Response Time Hours' ;
    rdfs:comment 'Contractual maximum hours the TPA has to respond to new claim assignments or inquiries.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specializationLines rdf:type rdf:Property ;
    rdfs:label 'Specialization Lines' ;
    rdfs:comment 'Comma-separated list of insurance lines of business the TPA specializes in handling.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Standard Fee Amount' ;
    rdfs:comment 'Standard fee charged by the TPA per claim or per period based on the fee structure type.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tpaStatus rdf:type rdf:Property ;
    rdfs:label 'Tpa Status' ;
    rdfs:comment 'Current operational status of the TPA relationship.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tpaCode rdf:type rdf:Property ;
    rdfs:label 'Tpa Code' ;
    rdfs:comment 'Unique alphanumeric business identifier code assigned to the TPA for operational reference.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tpaType rdf:type rdf:Property ;
    rdfs:label 'Tpa Type' ;
    rdfs:comment 'Classification of the TPA based on the scope of services provided.' ;
    rdfs:domain ind:Tpa ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attorneyType rdf:type rdf:Property ;
    rdfs:label 'Attorney Type' ;
    rdfs:comment 'Classification of the attorney role in relation to the insurer: defense counsel, plaintiff counsel, coverage counsel, panel attorney, or independent.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barAdmissionDate rdf:type rdf:Property ;
    rdfs:label 'Bar Admission Date' ;
    rdfs:comment 'Date when the attorney was admitted to the bar and licensed to practice law.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:barNumber rdf:type rdf:Property ;
    rdfs:label 'Bar Number' ;
    rdfs:comment 'Unique bar association registration number issued to the attorney by the state licensing authority.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barState rdf:type rdf:Property ;
    rdfs:label 'Bar State' ;
    rdfs:comment 'State or jurisdiction where the attorney is admitted to practice law.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hourlyRate rdf:type rdf:Property ;
    rdfs:label 'Hourly Rate' ;
    rdfs:comment 'Standard hourly billing rate charged by the attorney for legal services.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lawFirmName rdf:type rdf:Property ;
    rdfs:label 'Law Firm Name' ;
    rdfs:comment 'Name of the law firm or legal practice with which the attorney is affiliated.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:panelEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Panel Effective Date' ;
    rdfs:comment 'Date when the attorney was added to the insurer defense panel.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:panelMemberFlag rdf:type rdf:Property ;
    rdfs:label 'Panel Member Flag' ;
    rdfs:comment 'Indicates whether the attorney is a member of the insurer approved defense panel.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:panelTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Panel Termination Date' ;
    rdfs:comment 'Date when the attorney was removed from the insurer defense panel.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialty rdf:type rdf:Property ;
    rdfs:label 'Specialty' ;
    rdfs:comment 'Primary area of legal specialization such as personal injury, workers compensation, property damage, liability, or subrogation.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attorneyStatus rdf:type rdf:Property ;
    rdfs:label 'Attorney Status' ;
    rdfs:comment 'Current status of the attorney in relation to the insurer and bar association standing.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Number' ;
    rdfs:comment 'Tax identification number for the attorney or law firm used for payment processing and tax reporting.' ;
    rdfs:domain ind:Attorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
