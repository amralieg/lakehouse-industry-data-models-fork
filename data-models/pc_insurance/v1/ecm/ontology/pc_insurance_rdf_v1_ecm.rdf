    rdfs:domain ind:ScheduledItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:itemName rdf:type rdf:Property ;
    rdfs:label 'Item Name' ;
    rdfs:comment 'Short descriptive name or title of the scheduled item as it appears on the policy schedule (e.g., \'Diamond Engagement Ring\', \'Leica M11 Camera\').' ;
    rdfs:domain ind:ScheduledItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemStatus rdf:type rdf:Property ;
    rdfs:label 'Item Status' ;
    rdfs:comment 'Current lifecycle status of the scheduled item on the policy. Drives coverage eligibility and claims adjudication.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementCostValueAmount rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Value Amount' ;
    rdfs:comment 'Estimated cost to replace the scheduled item with a new item of like kind and quality at current market prices. Used for RCV settlement basis claims.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administratorContactName rdf:type rdf:Property ;
