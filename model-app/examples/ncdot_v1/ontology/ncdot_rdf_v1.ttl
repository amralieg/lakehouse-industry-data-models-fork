ind:Fund rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Fund' ;
    rdfs:comment 'Master record of internal and external funding sources, including federal grants, state appropriations, and special revenue funds.' .

ind:AccountsPayableInvoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Accounts Payable Invoice' ;
