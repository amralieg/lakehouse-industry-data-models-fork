ind:level rdf:type rdf:Property ;
    rdfs:label 'Level' ;
    rdfs:comment 'Numeric indicator of the department\'s position in the organizational hierarchy, with lower numbers representing higher-level units (e.g., 1 for divisions, 2 for units, 3 for sections).' ;
    rdfs:domain ind:Department ;
