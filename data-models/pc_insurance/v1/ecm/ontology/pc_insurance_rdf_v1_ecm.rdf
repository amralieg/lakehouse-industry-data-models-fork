ind:newStatus rdf:type rdf:Property ;
    rdfs:label 'New Status' ;
    rdfs:comment 'The claim status immediately after this transition was applied. [ENUM-REF-CANDIDATE: open|assigned|investigating|pending_info|approved|denied|closed|reopened — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSentIndicator rdf:type rdf:Property ;
