    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:benefitEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Benefit Enrollment Id' ;
    rdfs:comment 'Unique identifier for each benefit enrollment transaction record.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitPlanCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Plan Code' ;
    rdfs:comment 'Short code representing the benefit plan type (e.g., MED01 for medical plan option 1, DENT01 for dental plan).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPlanName rdf:type rdf:Property ;
    rdfs:label 'Benefit Plan Name' ;
    rdfs:comment 'Full descriptive name of the benefit plan (e.g., State Health Plan - 70/30 Option, Dental Plan - PPO).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitCategory rdf:type rdf:Property ;
    rdfs:label 'Benefit Category' ;
    rdfs:comment 'High-level category of the benefit plan (health, dental, vision, life insurance, disability, retirement, flexible spending, dependent care, supplemental).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentAction rdf:type rdf:Property ;
    rdfs:label 'Enrollment Action' ;
    rdfs:comment 'Type of enrollment transaction being recorded (new enrollment, change to existing coverage, termination, reinstatement, waiver of coverage, cancellation).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status' ;
    rdfs:comment 'Current status of the benefit enrollment (pending approval, active coverage, terminated, cancelled, suspended, waived).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageLevel rdf:type rdf:Property ;
    rdfs:label 'Coverage Level' ;
    rdfs:comment 'Level of coverage selected by the employee (employee only, employee plus spouse, employee plus children, family coverage, spouse only, children only).' ;
