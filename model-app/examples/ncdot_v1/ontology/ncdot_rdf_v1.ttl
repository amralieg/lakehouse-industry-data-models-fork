    rdfs:range xsd:string .

ind:imapUnitDispatchedFlag rdf:type rdf:Property ;
    rdfs:label 'Imap Unit Dispatched Flag' ;
    rdfs:comment 'Indicator whether an IMAP unit was dispatched to the incident.' ;
    rdfs:domain ind:Incident ;
