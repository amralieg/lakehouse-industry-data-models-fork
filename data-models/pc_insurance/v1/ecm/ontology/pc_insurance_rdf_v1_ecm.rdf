ind:scheduledEquipmentId rdf:type rdf:Property ;
    rdfs:label 'Scheduled Equipment Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.scheduled_equipment. Business justification: Risk characteristics can apply to scheduled equipment (e.g., maintenance status, safety certifications, usage intensity).' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScheduledEquipment .

ind:booleanValue rdf:type rdf:Property ;
    rdfs:label 'Boolean Value' ;
    rdfs:comment 'Boolean representation of the characteristic value when data type is boolean (e.g., true for sprinkler_present, false for prior_claims).' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
