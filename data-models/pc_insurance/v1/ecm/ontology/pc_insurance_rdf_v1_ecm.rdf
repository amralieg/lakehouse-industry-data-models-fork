ind:industryCode rdf:type rdf:Property ;
    rdfs:label 'Industry Code' ;
    rdfs:comment 'NAICS or SIC code representing the insureds primary business industry for commercial insureds.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurableInterestDescription rdf:type rdf:Property ;
    rdfs:label 'Insurable Interest Description' ;
    rdfs:comment 'Narrative description of the insureds insurable interest in the covered property or exposure.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredName rdf:type rdf:Property ;
    rdfs:label 'Insured Name' ;
    rdfs:comment 'Full legal name of the insured party as it appears on the policy declarations page (DEC).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestDescription rdf:type rdf:Property ;
    rdfs:label 'Interest Description' ;
    rdfs:comment 'Detailed description of the insured\'s interest in the covered property or risk.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestType rdf:type rdf:Property ;
    rdfs:label 'Interest Type' ;
    rdfs:comment 'Nature of the insureds financial interest in the covered property or risk: owner, lessee, mortgagor, bailee, trustee, or beneficiary.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestTypeCode rdf:type rdf:Property ;
    rdfs:label 'Interest Type Code' ;
    rdfs:comment 'Code representing the nature of the insured\'s interest in the covered property or risk: Owner (OWN), Lessee (LSE), Mortgagee (MTG), Vendor (VND), Bailee (BLR), Other (OTH).' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'Two-letter ISO language code for the insureds preferred communication language.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanNumber rdf:type rdf:Property ;
    rdfs:label 'Loan Number' ;
    rdfs:comment 'Loan or mortgage account number associated with the insured\'s interest, applicable for mortgagees and lienholders.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobilePhone rdf:type rdf:Property ;
    rdfs:label 'Mobile Phone' ;
    rdfs:comment 'Mobile telephone number for the insured, used for SMS notifications and mobile contact.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrOrderDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Order Date' ;
    rdfs:comment 'Date when the MVR was obtained for this insured.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mvrOrderedFlag rdf:type rdf:Property ;
    rdfs:label 'Mvr Ordered Flag' ;
    rdfs:comment 'Indicates whether a Motor Vehicle Report was ordered for this insured during underwriting.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occupation rdf:type rdf:Property ;
    rdfs:label 'Occupation' ;
    rdfs:comment 'Primary occupation or profession of the individual insured, used for risk classification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of ownership or interest the insured holds in the covered property or entity.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paperlessDeliveryFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Delivery Flag' ;
    rdfs:comment 'Indicates whether the insured has elected paperless delivery of policy documents and correspondence.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyInsuredStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Insured Status' ;
    rdfs:comment 'Current lifecycle status of the insured on the policy: active, inactive, suspended, deceased, or removed.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyInsuredType rdf:type rdf:Property ;
    rdfs:label 'Policy Insured Type' ;
    rdfs:comment 'Classification of the insured role on the policy: named insured, additional insured, loss payee, mortgagee, lienholder, or certificate holder.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Insured Flag' ;
    rdfs:comment 'Indicates whether this party is the primary or named insured on the policy.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Primary contact telephone number for the insured.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCarrierName rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Name' ;
    rdfs:comment 'Name of the insureds previous insurance carrier, used for underwriting continuity assessment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Number' ;
    rdfs:comment 'Policy number with the prior carrier, used for loss history verification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:removedByEndorsementNumber rdf:type rdf:Property ;
    rdfs:label 'Removed By Endorsement Number' ;
    rdfs:comment 'Endorsement (ENDT) number that removed this insured from the policy, if applicable.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleCode rdf:type rdf:Property ;
    rdfs:label 'Role Code' ;
    rdfs:comment 'Code indicating the role of the insured on the policy: Named Insured (NI), Additional Insured (AI), Loss Payee (LP), Mortgagee (MTG), Lienholder (LH), or Additional Interest (INT).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleDescription rdf:type rdf:Property ;
    rdfs:label 'Role Description' ;
    rdfs:comment 'Full text description of the insured role on the policy.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequence rdf:type rdf:Property ;
    rdfs:label 'Sequence' ;
    rdfs:comment 'Ordinal position of this insured on the policy for display and reporting purposes.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source Record Code' ;
    rdfs:comment 'Unique identifier of this insured record in the source operational system.' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusCode rdf:type rdf:Property ;
    rdfs:label 'Status Code' ;
    rdfs:comment 'Current status of the insured association: Active (ACT), Inactive (INA), Pending (PND), Cancelled (CAN), Expired (EXP).' ;
    rdfs:domain ind:PolicyInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterNotes rdf:type rdf:Property ;
    rdfs:label 'Underwriter Notes' ;
    rdfs:comment 'Free-text notes from the underwriter regarding this insured\'s risk profile or special considerations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsWithPriorCarrier rdf:type rdf:Property ;
    rdfs:label 'Years With Prior Carrier' ;
    rdfs:comment 'Number of continuous years the insured was with their prior carrier, used for loyalty and persistency rating.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyId rdf:type rdf:Property ;
    rdfs:label 'Agency Id' ;
    rdfs:comment 'Foreign key to the agency organization that placed this policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:regulatoryStateId rdf:type rdf:Property ;
    rdfs:label 'Regulatory State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Regulatory state governs rate filing, form approval, premium tax, and statutory reporting requirements. FK to shared.state enables compliance reporting and DOI filings by jurisdiction.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:State .

ind:sourcePolicyId rdf:type rdf:Property ;
    rdfs:label 'Source Policy Id' ;
    rdfs:comment 'Native policy identifier from the source system. Used for reconciliation and lineage.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:auditType rdf:type rdf:Property ;
    rdfs:label 'Audit Type' ;
    rdfs:comment 'Type of premium audit required at policy expiration: none, physical, financial, or payroll audit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingMethod rdf:type rdf:Property ;
    rdfs:label 'Billing Method' ;
    rdfs:comment 'Method by which premium is billed: direct (carrier bills insured), agency (agent bills insured), or list (reported on bordereaux).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindDate rdf:type rdf:Property ;
    rdfs:label 'Bind Date' ;
    rdfs:comment 'Date the policy was bound, establishing the carriers commitment to provide coverage.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:businessType rdf:type rdf:Property ;
    rdfs:label 'Business Type' ;
    rdfs:comment 'Transaction business type: NB (New Business), REN (Renewal), ENDT (Endorsement), CANC (Cancellation), REINST (Reinstatement).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationType rdf:type rdf:Property ;
    rdfs:label 'Cancellation Type' ;
    rdfs:comment 'Method of premium calculation upon cancellation: flat (no earned premium), short-rate (penalty), or pro-rata (proportional).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catExposureFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Exposure Flag' ;
    rdfs:comment 'Indicates whether this policy has exposure to catastrophe perils (hurricane, earthquake, flood, wildfire).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionRate rdf:type rdf:Property ;
    rdfs:label 'Commission Rate' ;
    rdfs:comment 'Commission rate percentage paid to the producer on this policy. Expressed as a decimal (e.g., 0.1500 for 15%).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mailingStateCode rdf:type rdf:Property ;
    rdfs:label 'Mailing State Code' ;
    rdfs:comment 'Two-letter state code of the policy mailing address.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:module rdf:type rdf:Property ;
    rdfs:label 'Module' ;
    rdfs:comment 'Module or sequence number component of the policy identifier used in some carrier numbering schemes.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namedInsuredName rdf:type rdf:Property ;
    rdfs:label 'Named Insured Name' ;
    rdfs:comment 'Full legal name of the primary named insured on the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nwpAmount rdf:type rdf:Property ;
    rdfs:label 'Nwp Amount' ;
    rdfs:comment 'Net written premium after reinsurance cessions. Amount retained by the carrier.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanCode rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Code' ;
    rdfs:comment 'Code identifying the premium payment plan: full-pay, installment, agency-bill, direct-bill, etc.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Status' ;
    rdfs:comment 'Current lifecycle status of the policy: quoted, bound, issued, inforce, cancelled, expired, nonrenewed, or reinstated. [ENUM-REF-CANDIDATE: quoted|bound|issued|inforce|cancelled|expired|nonrenewed|reinstated — 8 candidates stripped; promote to reference' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyType rdf:type rdf:Property ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'High-level policy classification: personal lines, commercial lines, or specialty.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteDate rdf:type rdf:Property ;
    rdfs:label 'Quote Date' ;
    rdfs:comment 'Date the initial quote was generated for this policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Renewal Policy Number' ;
    rdfs:comment 'Policy number of the renewal policy if this policy was renewed. Links to the subsequent term.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:symbol rdf:type rdf:Property ;
    rdfs:label 'Symbol' ;
    rdfs:comment 'ISO or carrier-specific policy symbol code identifying the product line and rating program.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termMonths rdf:type rdf:Property ;
    rdfs:label 'Term Months' ;
    rdfs:comment 'Duration of the policy term expressed in months. Typically 6 or 12 months for standard policies.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalInsuredValue rdf:type rdf:Property ;
    rdfs:label 'Total Insured Value' ;
    rdfs:comment 'Total insured value across all covered property and exposures on this policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwriterCode rdf:type rdf:Property ;
    rdfs:label 'Underwriter Code' ;
    rdfs:comment 'Foreign key to the employee or user who underwrote this policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Underwriting Company Code' ;
    rdfs:comment 'Code identifying the legal entity (insurance company) that underwrites and bears the risk for this policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionId rdf:type rdf:Property ;
    rdfs:label 'Condition Id' ;
    rdfs:comment 'Unique identifier for the policy condition record. Primary key.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Condition .

ind:assignedToPartyId rdf:type rdf:Property ;
    rdfs:label 'Assigned To Party Id' ;
    rdfs:comment 'Reference to the party responsible for satisfying the condition, typically the insured or producer.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:conditionCategory rdf:type rdf:Property ;
    rdfs:label 'Condition Category' ;
    rdfs:comment 'Timing category indicating when the condition applies: pre-bind, post-bind, ongoing during policy term, or at renewal.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDueDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Due Date' ;
    rdfs:comment 'Date by which the insured must satisfy or comply with the condition. Critical for underwriting and risk management tracking.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Flag' ;
    rdfs:comment 'Indicator of whether the condition has been satisfied or is in compliance. True if satisfied, false if outstanding.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionNumber rdf:type rdf:Property ;
    rdfs:label 'Condition Number' ;
    rdfs:comment 'Business identifier for the condition, unique within the policy context. Used for external reference and communication.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionStatus rdf:type rdf:Property ;
    rdfs:label 'Condition Status' ;
    rdfs:comment 'Current lifecycle status of the condition: pending, satisfied, outstanding, waived, expired, or cancelled.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Coverage Impact Flag' ;
    rdfs:comment 'Indicator of whether non-compliance with this condition affects coverage. True if coverage may be denied or restricted for non-compliance.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionDescription rdf:type rdf:Property ;
    rdfs:label 'Condition Description' ;
    rdfs:comment 'Detailed narrative description of the condition, including specific requirements, actions, or restrictions imposed on the insured or policy.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Flag' ;
    rdfs:comment 'Indicator of whether the condition is mandatory for policy binding or renewal. True if mandatory, false if optional or informational.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Impact Flag' ;
    rdfs:comment 'Indicator of whether satisfaction or non-compliance with this condition affects premium calculation or rating.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Indicator of whether this condition is imposed to satisfy a regulatory or statutory requirement. True if regulatory-driven.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:satisfiedDate rdf:type rdf:Property ;
    rdfs:label 'Satisfied Date' ;
    rdfs:comment 'Date when the condition was marked as satisfied or fulfilled by the insured.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Source Document Reference' ;
    rdfs:comment 'Reference number or identifier of the source document that triggered this condition.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDocumentType rdf:type rdf:Property ;
    rdfs:label 'Source Document Type' ;
    rdfs:comment 'Type of document or source that triggered or justified the imposition of this condition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:text rdf:type rdf:Property ;
    rdfs:label 'Text' ;
    rdfs:comment 'Full legal or contractual text of the condition as it appears on the policy declarations page or endorsement.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waivedDate rdf:type rdf:Property ;
    rdfs:label 'Waived Date' ;
    rdfs:comment 'Date when the condition was waived by the underwriter or authorized party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverApprovedByCode rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved By Code' ;
    rdfs:comment 'Reference to the underwriter or manager who approved the waiver of this condition.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverReasonCode rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason Code' ;
    rdfs:comment 'Code indicating the reason the condition was waived, if applicable.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCoverageId rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Id' ;
    rdfs:comment 'Reference to the previous version of this coverage attachment if this is an endorsement or renewal.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyCoverage .

ind:agreedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Agreed Value Amount' ;
    rdfs:comment 'Pre-agreed value of covered property, eliminating coinsurance penalties at time of loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Benefit Period Days' ;
    rdfs:comment 'Maximum number of days benefits will be paid under this coverage after the elimination period.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blanketCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Blanket Coverage Flag' ;
    rdfs:comment 'Indicates whether this coverage applies on a blanket basis across multiple locations or items.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eliminationPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Elimination Period Days' ;
    rdfs:comment 'Number of days after a loss before benefits begin to be paid under this coverage.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inflationGuardPercentage rdf:type rdf:Property ;
    rdfs:label 'Inflation Guard Percentage' ;
    rdfs:comment 'Annual percentage increase applied to coverage limits to account for inflation.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitAmount rdf:type rdf:Property ;
    rdfs:label 'Limit Amount' ;
    rdfs:comment 'Maximum dollar amount the insurer will pay for covered losses under this coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optionalCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Optional Coverage Flag' ;
    rdfs:comment 'Indicates whether this coverage is optional or mandatory for the policy.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perLocationLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Location Limit Amount' ;
    rdfs:comment 'Maximum coverage limit applicable to each individual location under a blanket coverage.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Basis Amount' ;
    rdfs:comment 'Numeric value of the premium basis used in rating calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateType rdf:type rdf:Property ;
    rdfs:label 'Rate Type' ;
    rdfs:comment 'Type of rating method applied, such as manual, experience-rated, or schedule-rated.' ;
    rdfs:domain ind:PolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'Type of trigger that activates coverage, such as occurrence-based or claims-made.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByFormPolicyFormId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Form Policy Form Id' ;
    rdfs:comment 'Reference to the newer policy form that replaces this form, establishing form version lineage.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyForm .

ind:documentReference rdf:type rdf:Property ;
    rdfs:label 'Document Reference' ;
    rdfs:comment 'Reference identifier or URI to the stored PDF or document image of the official form in the document management system.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoSourceFlag rdf:type rdf:Property ;
    rdfs:label 'Iso Source Flag' ;
    rdfs:comment 'Indicates whether this form originates from ISO standard forms or is a proprietary carrier-developed form.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:language rdf:type rdf:Property ;
    rdfs:label 'Language' ;
    rdfs:comment 'The full legal text and language of the policy form as filed with regulators, stored as a text field or reference to document storage.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyFormStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Form Status' ;
    rdfs:comment 'Current lifecycle status of the form in the system: active and available for use, inactive but retained, archived for historical reference, or draft pending finalization.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumBearingFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Bearing Flag' ;
    rdfs:comment 'Indicates whether this form carries an additional premium charge or is included at no extra cost.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:usageCount rdf:type rdf:Property ;
    rdfs:label 'Usage Count' ;
    rdfs:comment 'The number of active policies currently using this form, providing insight into form adoption and usage trends.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyProducerId rdf:type rdf:Property ;
    rdfs:label 'Policy Producer Id' ;
    rdfs:comment 'Unique identifier for the policy-producer relationship record.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appointmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Effective Date' ;
    rdfs:comment 'Date when the producer\'s appointment to write or service this policy became effective.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Expiration Date' ;
    rdfs:comment 'Date when the producer\'s appointment to write or service this policy expires or was terminated.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindingAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Flag' ;
    rdfs:comment 'Indicates whether the producer has binding authority to issue this policy without prior underwriting approval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionBasisCode rdf:type rdf:Property ;
    rdfs:label 'Commission Basis Code' ;
    rdfs:comment 'Basis on which commission is calculated: Gross Written Premium (GWP), Net Written Premium (NWP), Earned Premium (EP), or flat fee.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionHoldbackPercentage rdf:type rdf:Property ;
    rdfs:label 'Commission Holdback Percentage' ;
    rdfs:comment 'Percentage of commission withheld by the insurer for this policy-producer relationship, typically for quality or performance reasons.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionPaymentMethodCode rdf:type rdf:Property ;
    rdfs:label 'Commission Payment Method Code' ;
    rdfs:comment 'Method by which commission is paid to the producer for this policy: ACH transfer, check, wire, or offset against debit balance.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionPlanCode rdf:type rdf:Property ;
    rdfs:label 'Commission Plan Code' ;
    rdfs:comment 'Code identifying the commission plan or schedule applicable to this producer for this policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSplitPercentage rdf:type rdf:Property ;
    rdfs:label 'Commission Split Percentage' ;
    rdfs:comment 'Percentage of total commission allocated to this producer on the policy, expressed as a decimal (e.g., 75.00 for 75%).' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionStatementFrequencyCode rdf:type rdf:Property ;
    rdfs:label 'Commission Statement Frequency Code' ;
    rdfs:comment 'Frequency at which commission statements are generated for this producer-policy relationship.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Primary email address of the producer for policy-related communication and commission statements.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Primary phone number of the producer for policy servicing and customer inquiries.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentCommissionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Eligible Flag' ;
    rdfs:comment 'Indicates whether this policy-producer relationship is eligible for contingent or bonus commission based on performance metrics.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Timestamp' ;
    rdfs:comment 'Timestamp when this policy-producer relationship record became effective in the system.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expirationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expiration Timestamp' ;
    rdfs:comment 'Timestamp when this policy-producer relationship record expired or was superseded by a new record.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:licenseStateCode rdf:type rdf:Property ;
    rdfs:label 'License State Code' ;
    rdfs:comment 'Two-letter state code where the producer holds the license applicable to this policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicProducerCode rdf:type rdf:Property ;
    rdfs:label 'Naic Producer Code' ;
    rdfs:comment 'NAIC-assigned producer code for regulatory reporting and cross-state producer identification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Override Commission Rate' ;
    rdfs:comment 'Override commission rate percentage applied to this specific policy-producer relationship, if different from standard plan.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyTransactionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Type Code' ;
    rdfs:comment 'Type of policy transaction that established or modified this producer relationship: New Business (NB), Renewal (REN), Endorsement (ENDT), Cancellation (CANC), Reinstatement.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryProducerFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Producer Flag' ;
    rdfs:comment 'Indicates whether this producer is the primary or lead producer for the policy (true) or a secondary/split producer (false).' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Record Version Number' ;
    rdfs:comment 'Version number of this policy-producer relationship record, incremented with each modification for audit trail purposes.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:relationshipStatus rdf:type rdf:Property ;
    rdfs:label 'Relationship Status' ;
    rdfs:comment 'Current status of the producer-policy relationship indicating whether the producer is actively servicing or earning commission.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicingOfficeCode rdf:type rdf:Property ;
    rdfs:label 'Servicing Office Code' ;
    rdfs:comment 'Code identifying the producer\'s office or branch location responsible for servicing this policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subProducerCode rdf:type rdf:Property ;
    rdfs:label 'Sub Producer Code' ;
    rdfs:comment 'Code identifying a sub-producer or sub-agent under the primary producer for hierarchical commission tracking.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identification Number' ;
    rdfs:comment 'Federal Employer Identification Number (FEIN) or Social Security Number (SSN) of the producer for tax reporting (1099 generation).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Code' ;
    rdfs:comment 'Reason code explaining why the producer-policy relationship was terminated or changed.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierCode rdf:type rdf:Property ;
    rdfs:label 'Tier Code' ;
    rdfs:comment 'Tier or performance level of the producer at the time of policy association, affecting commission rates and incentives.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorTransactionPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Prior Transaction Policy Transaction Id' ;
    rdfs:comment 'Reference to the previous transaction in the policy version chain for audit trail and lineage.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:bookingDate rdf:type rdf:Property ;
    rdfs:label 'Booking Date' ;
    rdfs:comment 'Accounting date when the transaction was booked for financial and statutory reporting purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commissionAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Amount' ;
    rdfs:comment 'Total commission amount earned by the producer on this transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:declarationPageGeneratedFlag rdf:type rdf:Property ;
    rdfs:label 'Declaration Page Generated Flag' ;
    rdfs:comment 'Indicates whether a declarations page was generated and issued for this transaction.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:initiatingPartyType rdf:type rdf:Property ;
    rdfs:label 'Initiating Party Type' ;
    rdfs:comment 'Type of party who initiated or requested this transaction.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatingUserCode rdf:type rdf:Property ;
    rdfs:label 'Initiating User Code' ;
    rdfs:comment 'System user identifier of the person who created or initiated this transaction.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Notice Compliance Flag' ;
    rdfs:comment 'Indicates whether required notice period was met for regulatory and contractual compliance.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeDate rdf:type rdf:Property ;
    rdfs:label 'Notice Date' ;
    rdfs:comment 'Date when notice of the transaction was sent to the insured or other parties as required by policy terms or regulation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeDaysRequired rdf:type rdf:Property ;
    rdfs:label 'Notice Days Required' ;
    rdfs:comment 'Number of days advance notice required by policy terms or state regulation for this transaction type.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:premiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Change Amount' ;
    rdfs:comment 'Net change in premium resulting from this transaction, positive for increases and negative for decreases.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Explanation of why this transaction was reversed or voided.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionId rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Id' ;
    rdfs:comment 'Original transaction identifier from the source system for reconciliation and traceability.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalTransactionAmount rdf:type rdf:Property ;
    rdfs:label 'Total Transaction Amount' ;
    rdfs:comment 'Total amount due or refunded for this transaction including premium, taxes, and fees.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle status of the transaction indicating its processing state. [ENUM-REF-CANDIDATE: draft|quoted|bound|issued|voided|declined|withdrawn — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentQuoteId rdf:type rdf:Property ;
    rdfs:label 'Parent Quote Id' ;
    rdfs:comment 'Reference to the original quote if this is a revised version, enabling quote lineage tracking.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Quote .

ind:ratingStateId rdf:type rdf:Property ;
    rdfs:label 'Rating State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Rating state determines which rate filing and underwriting rules apply to the quote. FK to shared.state enables state-specific rating algorithm selection and surplus lines eligibility.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:State .

ind:binderEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Binder Effective Date' ;
    rdfs:comment 'Actual effective date of temporary binder coverage if binding authority was exercised.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:binderExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Binder Expiration Date' ;
    rdfs:comment 'Expiration date of temporary binder, typically 30-90 days pending formal policy issuance.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:binderNumber rdf:type rdf:Property ;
    rdfs:label 'Binder Number' ;
    rdfs:comment 'Temporary binder identifier issued when binding authority is exercised prior to formal policy issuance.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindingAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Limit' ;
    rdfs:comment 'Maximum premium amount the producer is authorized to bind without underwriter review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bound Timestamp' ;
    rdfs:comment 'Timestamp when the quote was bound and converted to active coverage or binder.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:declineReasonCode rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Code' ;
    rdfs:comment 'Standardized code indicating the primary reason for quote declination by underwriting.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Description' ;
    rdfs:comment 'Detailed explanation of why the quote was declined, provided to the agent and insured per regulatory requirements.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declinedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Declined Timestamp' ;
    rdfs:comment 'Timestamp when the quote was declined by underwriting or rejected by the customer.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pml rdf:type rdf:Property ;
    rdfs:label 'Pml' ;
    rdfs:comment 'Estimated probable maximum loss for catastrophe modeling and reinsurance placement purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:presentedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Presented Timestamp' ;
    rdfs:comment 'Timestamp when the quote was formally presented to the customer or agent.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:productCode rdf:type rdf:Property ;
    rdfs:label 'Product Code' ;
    rdfs:comment 'Specific insurance product identifier within the line of business, linking to filed rates and forms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteStatus rdf:type rdf:Property ;
    rdfs:label 'Quote Status' ;
    rdfs:comment 'Current lifecycle status of the quote indicating its progression through the underwriting and binding workflow.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteType rdf:type rdf:Property ;
    rdfs:label 'Quote Type' ;
    rdfs:comment 'Classification indicating whether this is a new business quote, renewal quote, rewrite, or endorsement quote.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quotedGwp rdf:type rdf:Property ;
    rdfs:label 'Quoted Gwp' ;
    rdfs:comment 'Total gross written premium amount quoted before any reinsurance cessions or adjustments.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quotedTaxesFees rdf:type rdf:Property ;
    rdfs:label 'Quoted Taxes Fees' ;
    rdfs:comment 'Total taxes, surplus lines taxes, stamping fees, and regulatory assessments included in the quote.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quotedTotalPremium rdf:type rdf:Property ;
    rdfs:label 'Quoted Total Premium' ;
    rdfs:comment 'Total amount due from the insured including base premium, taxes, fees, and surcharges.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingState rdf:type rdf:Property ;
    rdfs:label 'Rating State' ;
    rdfs:comment 'Two-letter state code determining which filed rates, forms, and regulatory rules apply to this quote.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesFlag rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Flag' ;
    rdfs:comment 'Indicates whether this quote is for surplus lines coverage placed outside the admitted market.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tiv rdf:type rdf:Property ;
    rdfs:label 'Tiv' ;
    rdfs:comment 'Total insured value representing the maximum potential exposure across all coverages in this quote.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uwScore rdf:type rdf:Property ;
    rdfs:label 'Uw Score' ;
    rdfs:comment 'Numeric underwriting score from automated rating and risk assessment models, typically 0-100 scale.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uwTier rdf:type rdf:Property ;
    rdfs:label 'Uw Tier' ;
    rdfs:comment 'Risk tier assigned during underwriting indicating the quality and pricing level of the quoted risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validUntilDate rdf:type rdf:Property ;
    rdfs:label 'Valid Until Date' ;
    rdfs:comment 'Date until which the quoted premium and terms remain valid for binding, typically 30-60 days from quote date.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyRateFilingId rdf:type rdf:Property ;
    rdfs:label 'Policy Rate Filing Id' ;
    rdfs:comment 'Unique identifier for the rate filing record. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyRateFiling .

ind:priorFilingPolicyRateFilingId rdf:type rdf:Property ;
    rdfs:label 'Prior Filing Policy Rate Filing Id' ;
    rdfs:comment 'Reference to the previous rate filing that this submission replaces, supersedes, or amends, establishing filing lineage.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyRateFiling .

ind:stateId rdf:type rdf:Property ;
    rdfs:label 'State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Rate filing state is the regulatory jurisdiction for rate approval. FK to shared.state enables state-specific filing workflow, deemer date calculation, and DOI contact lookup.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:State .

ind:actuarialJustificationSummary rdf:type rdf:Property ;
    rdfs:label 'Actuarial Justification Summary' ;
    rdfs:comment 'Brief summary of the actuarial analysis and loss experience supporting the rate change, including loss ratio trends and expense considerations.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedPolicyCount rdf:type rdf:Property ;
    rdfs:label 'Affected Policy Count' ;
    rdfs:comment 'Number of in-force policies expected to be impacted by the rate filing at renewal or endorsement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:companyCode rdf:type rdf:Property ;
    rdfs:label 'Company Code' ;
    rdfs:comment 'Internal or NAIC company code identifying the legal insurance entity submitting the rate filing.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deemerDate rdf:type rdf:Property ;
    rdfs:label 'Deemer Date' ;
    rdfs:comment 'Date on which the filing is deemed approved by operation of law if the regulator has not acted within the statutory review period.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingContactEmail rdf:type rdf:Property ;
    rdfs:label 'Filing Contact Email' ;
    rdfs:comment 'Email address of the filing contact for regulatory correspondence and questions regarding the rate filing.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingContactName rdf:type rdf:Property ;
    rdfs:label 'Filing Contact Name' ;
    rdfs:comment 'Name of the actuary or regulatory affairs professional responsible for this filing and serving as primary contact with the state regulator.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingContactPhone rdf:type rdf:Property ;
    rdfs:label 'Filing Contact Phone' ;
    rdfs:comment 'Phone number of the filing contact for regulatory inquiries and follow-up discussions regarding the rate filing.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingMethod rdf:type rdf:Property ;
    rdfs:label 'Filing Method' ;
    rdfs:comment 'Regulatory filing method required by the state indicating whether rates must be approved before use or may be implemented immediately.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Number' ;
    rdfs:comment 'External filing number assigned by the state Department of Insurance (DOI) or insurer for tracking and reference purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingType rdf:type rdf:Property ;
    rdfs:label 'Filing Type' ;
    rdfs:comment 'Category of the filing submission indicating whether it is a rate change, form update, rule modification, or combination thereof.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formNumbersIncluded rdf:type rdf:Property ;
    rdfs:label 'Form Numbers Included' ;
    rdfs:comment 'Comma-separated list of policy form numbers and endorsement form numbers included in this filing for regulatory approval.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoProgramEditionDate rdf:type rdf:Property ;
    rdfs:label 'Iso Program Edition Date' ;
    rdfs:comment 'Edition date of the ISO program being adopted or referenced in this filing, if applicable.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isoProgramIndicator rdf:type rdf:Property ;
    rdfs:label 'Iso Program Indicator' ;
    rdfs:comment 'Flag indicating whether this filing adopts or references ISO standard forms and rates or represents a proprietary insurer program.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:objectionReason rdf:type rdf:Property ;
    rdfs:label 'Objection Reason' ;
    rdfs:comment 'Explanation provided by the state regulator for objecting to or rejecting the rate filing, including specific deficiencies or concerns.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallRateChangePercent rdf:type rdf:Property ;
    rdfs:label 'Overall Rate Change Percent' ;
    rdfs:comment 'Percentage change in overall premium rates proposed in this filing, expressed as a signed decimal where positive indicates increase and negative indicates decrease.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedPremiumImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Projected Premium Impact Amount' ;
    rdfs:comment 'Estimated dollar impact on total written premium resulting from the rate change, used for regulatory and financial planning purposes.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateChangeType rdf:type rdf:Property ;
    rdfs:label 'Rate Change Type' ;
    rdfs:comment 'Indicates whether the filing represents an overall rate increase, decrease, no change, or introduction of a new rating program.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReviewDays rdf:type rdf:Property ;
    rdfs:label 'Regulatory Review Days' ;
    rdfs:comment 'Number of calendar days the filing has been under regulatory review, used to track compliance with statutory review period limits.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Resubmission Flag' ;
    rdfs:comment 'Indicates whether this filing is a resubmission of a previously objected or withdrawn filing with modifications addressing regulator concerns.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serffTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'Serff Tracking Number' ;
    rdfs:comment 'Unique tracking number assigned by the SERFF system for electronic rate and form submissions to state regulators.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Date the rate filing was officially submitted to the state Department of Insurance for regulatory review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supportingDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Url' ;
    rdfs:comment 'Reference URL or document management system path to the complete actuarial memorandum, rate manual, and supporting exhibits filed with the regulator.' ;
    rdfs:domain ind:PolicyRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Date' ;
    rdfs:comment 'Date the insurer voluntarily withdrew the rate filing from regulatory consideration before approval or rejection.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statusHistoryId rdf:type rdf:Property ;
