    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onTimePerformanceTargetPct rdf:type rdf:Property ;
    rdfs:label 'On Time Performance Target Pct' ;
    rdfs:comment 'Target percentage for on-time performance defined as arriving within a specified threshold of scheduled time.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
