    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchCenterCode rdf:type rdf:Property ;
    rdfs:label 'Dispatch Center Code' ;
    rdfs:comment 'Unique code identifying the dispatch center managing this train service.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signalSystemType rdf:type rdf:Property ;
