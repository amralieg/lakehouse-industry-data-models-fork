ind:AccountsReceivableInvoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Accounts Receivable Invoice' ;
    rdfs:comment 'Accounts Receivable invoice details for inter-agency billing, service fees, and other receivables.' .

ind:JournalEntry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Journal Entry' ;
    rdfs:comment 'Individual journal entries capturing debits and credits for all financial transactions, with posting date and reference IDs.' .

ind:FinancialPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Financial Period' ;
    rdfs:comment 'Reference table defining fiscal years, quarters, and periods used for financial reporting and period-close processes.' .

ind:Employee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Hr ;
    rdfs:label 'Employee' ;
    rdfs:comment 'Authoritative master record for each NCDOT employee, including personal identifiers, employment status, hire date, and core demographic information.' .

ind:Position rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Hr ;
    rdfs:label 'Position' ;
    rdfs:comment 'Master list of all job positions within NCDOT, defining titles, grade levels, functional classification, and reporting hierarchy.' .

ind:Department rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Hr ;
    rdfs:label 'Department' ;
