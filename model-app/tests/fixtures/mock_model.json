          "primary_key": "product_id",
          "attributes": [
            {
              "attribute": "product_id",
              "type": "BIGINT",
              "description": "Unique product identifier",
              "tags": "",
              "foreign_key_to": ""
            },
            {
              "attribute": "product_name",
