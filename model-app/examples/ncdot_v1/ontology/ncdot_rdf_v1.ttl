ind:unitCodeDepartmentId rdf:type rdf:Property ;
    rdfs:label 'Unit Code Department Id' ;
    rdfs:comment 'Code representing the specific organizational unit, section, or branch within the division where the position resides.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Department .

ind:workLocationCode rdf:type rdf:Property ;
    rdfs:label 'Work Location Code' ;
    rdfs:comment 'Code identifying the primary physical work location or facility where the position is based.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workLocationName rdf:type rdf:Property ;
    rdfs:label 'Work Location Name' ;
    rdfs:comment 'Name of the primary physical work location or facility where the position is based (e.g., Central Office Raleigh, District 5 Office).' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCity rdf:type rdf:Property ;
    rdfs:label 'Work City' ;
    rdfs:comment 'City where the position\'s primary work location is situated.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCounty rdf:type rdf:Property ;
    rdfs:label 'Work County' ;
    rdfs:comment 'North Carolina county where the position\'s primary work location is situated.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workState rdf:type rdf:Property ;
    rdfs:label 'Work State' ;
    rdfs:comment 'Two-letter state code where the position\'s primary work location is situated (typically NC for North Carolina).' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportsToPositionNumber rdf:type rdf:Property ;
    rdfs:label 'Reports To Position Number' ;
    rdfs:comment 'Position number of the supervisory position to which this position directly reports in the organizational hierarchy.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisoryLevel rdf:type rdf:Property ;
    rdfs:label 'Supervisory Level' ;
    rdfs:comment 'Level of supervisory responsibility assigned to the position within the organizational hierarchy.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directReportsCount rdf:type rdf:Property ;
    rdfs:label 'Direct Reports Count' ;
    rdfs:comment 'Number of positions that directly report to this position in the organizational hierarchy.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fteAllocation rdf:type rdf:Property ;
    rdfs:label 'Fte Allocation' ;
    rdfs:comment 'Full-time equivalent allocation for the position expressed as a decimal (e.g., 1.0000 for full-time, 0.5000 for half-time).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardHoursPerWeek rdf:type rdf:Property ;
    rdfs:label 'Standard Hours Per Week' ;
    rdfs:comment 'Standard number of work hours per week expected for the position (e.g., 40.00 for full-time).' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workScheduleType rdf:type rdf:Property ;
    rdfs:label 'Work Schedule Type' ;
    rdfs:comment 'Type of work schedule arrangement for the position (standard business hours, shift work, flexible schedule, compressed workweek, remote, or hybrid).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftDesignation rdf:type rdf:Property ;
    rdfs:label 'Shift Designation' ;
    rdfs:comment 'Shift designation for positions that operate on shift schedules (day shift, evening shift, night shift, rotating shifts, or on-call).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teleworkEligible rdf:type rdf:Property ;
    rdfs:label 'Telework Eligible' ;
    rdfs:comment 'Indicates whether the position is eligible for telework or remote work arrangements based on job duties and operational requirements.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:essentialPersonnel rdf:type rdf:Property ;
    rdfs:label 'Essential Personnel' ;
    rdfs:comment 'Indicates whether the position is designated as essential personnel required to report during emergencies, inclement weather, or other operational disruptions.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:securityClearanceRequired rdf:type rdf:Property ;
    rdfs:label 'Security Clearance Required' ;
    rdfs:comment 'Indicates whether a security clearance or background check is required for the position due to access to sensitive information or facilities.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumEducationLevel rdf:type rdf:Property ;
