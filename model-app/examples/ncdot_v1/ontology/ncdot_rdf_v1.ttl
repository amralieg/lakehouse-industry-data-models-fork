ind:grantName rdf:type rdf:Property ;
    rdfs:label 'Grant Name' ;
    rdfs:comment 'Descriptive name of the grant program or award providing the funding allocation.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationCategory rdf:type rdf:Property ;
    rdfs:label 'Allocation Category' ;
    rdfs:comment 'High-level category classifying the purpose or functional area of the funding allocation.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Match Requirement Flag' ;
