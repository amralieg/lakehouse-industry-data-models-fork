ind:thursdayServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Thursday Service Flag' ;
    rdfs:comment 'Indicates whether service operates on Thursdays under this schedule.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
