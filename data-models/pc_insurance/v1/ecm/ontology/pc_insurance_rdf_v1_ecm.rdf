    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:endorsementId rdf:type rdf:Property ;
    rdfs:label 'Endorsement Id' ;
    rdfs:comment 'Reference to the endorsement record that formally grants additional insured status. Links to the ENDT that modifies the base policy to add this party.' ;
