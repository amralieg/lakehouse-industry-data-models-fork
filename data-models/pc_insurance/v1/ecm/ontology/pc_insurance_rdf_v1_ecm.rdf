    rdfs:range xsd:string .

ind:recipientAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Recipient Address Line2' ;
    rdfs:comment 'Second line of the recipient mailing address for additional address details.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientCity rdf:type rdf:Property ;
    rdfs:label 'Recipient City' ;
    rdfs:comment 'City name of the recipient mailing address.' ;
