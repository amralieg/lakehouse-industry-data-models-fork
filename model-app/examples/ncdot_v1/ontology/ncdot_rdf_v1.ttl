    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalProjectCost rdf:type rdf:Property ;
    rdfs:label 'Total Project Cost' ;
    rdfs:comment 'Total estimated cost of the project, including both requested grant funds and local match.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchSource rdf:type rdf:Property ;
    rdfs:label 'Match Source' ;
    rdfs:comment 'Description of the source(s) of local matching funds (e.g., state funds, local funds, toll revenue, private contribution).' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectStartDate rdf:type rdf:Property ;
    rdfs:label 'Project Start Date' ;
    rdfs:comment 'Anticipated date when project implementation or construction will begin.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Project Completion Date' ;
    rdfs:comment 'Anticipated date when the project will be completed and operational.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Project Duration Months' ;
    rdfs:comment 'Estimated duration of the project from start to completion, expressed in months.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusDate rdf:type rdf:Property ;
    rdfs:label 'Status Date' ;
    rdfs:comment 'Date when the current application status was last updated.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewScore rdf:type rdf:Property ;
    rdfs:label 'Review Score' ;
    rdfs:comment 'Numerical score assigned to the application during the evaluation process based on program criteria.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewerComments rdf:type rdf:Property ;
    rdfs:label 'Reviewer Comments' ;
    rdfs:comment 'Consolidated comments and feedback from grant reviewers regarding the application strengths and weaknesses.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'Date when the grant application was officially rejected or denied.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:awardedAmount rdf:type rdf:Property ;
    rdfs:label 'Awarded Amount' ;
    rdfs:comment 'Actual dollar amount of grant funding awarded to the applicant, which may differ from the requested amount.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awardNumber rdf:type rdf:Property ;
    rdfs:label 'Award Number' ;
    rdfs:comment 'Unique identifier assigned to the grant award for tracking and financial management purposes.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateAgencyName rdf:type rdf:Property ;
    rdfs:label 'State Agency Name' ;
    rdfs:comment 'Name of the state agency administering or coordinating the grant program, typically NCDOT.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nepaApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Nepa Approval Date' ;
    rdfs:comment 'Date when NEPA environmental clearance was obtained for the project.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightOfWayStatus rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Status' ;
    rdfs:comment 'Current status of right-of-way acquisition activities required for the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preliminaryEngineeringStatus rdf:type rdf:Property ;
    rdfs:label 'Preliminary Engineering Status' ;
    rdfs:comment 'Current status of preliminary engineering and design activities for the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preliminaryEngineeringCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Preliminary Engineering Completion Date' ;
    rdfs:comment 'Date when preliminary engineering phase was completed.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:constructionEngineeringStatus rdf:type rdf:Property ;
    rdfs:label 'Construction Engineering Status' ;
    rdfs:comment 'Current status of construction engineering and oversight activities for the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyBenefitDescription rdf:type rdf:Property ;
    rdfs:label 'Safety Benefit Description' ;
    rdfs:comment 'Narrative description of anticipated safety improvements and crash reduction benefits from the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobilityBenefitDescription rdf:type rdf:Property ;
    rdfs:label 'Mobility Benefit Description' ;
    rdfs:comment 'Narrative description of anticipated mobility improvements, congestion reduction, and travel time savings from the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:economicBenefitDescription rdf:type rdf:Property ;
    rdfs:label 'Economic Benefit Description' ;
    rdfs:comment 'Narrative description of anticipated economic development impacts and job creation from the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalBenefitDescription rdf:type rdf:Property ;
    rdfs:label 'Environmental Benefit Description' ;
    rdfs:comment 'Narrative description of anticipated environmental benefits such as air quality improvement, emissions reduction, or habitat enhancement.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityConsiderationDescription rdf:type rdf:Property ;
    rdfs:label 'Equity Consideration Description' ;
    rdfs:comment 'Narrative description of how the project addresses transportation equity, environmental justice, and benefits to disadvantaged communities.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateResilienceDescription rdf:type rdf:Property ;
    rdfs:label 'Climate Resilience Description' ;
    rdfs:comment 'Narrative description of how the project enhances resilience to climate change impacts and extreme weather events.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:innovationDescription rdf:type rdf:Property ;
    rdfs:label 'Innovation Description' ;
    rdfs:comment 'Narrative description of innovative approaches, technologies, or methodologies incorporated in the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentsList rdf:type rdf:Property ;
    rdfs:label 'Supporting Documents List' ;
    rdfs:comment 'Comma-separated list or description of supporting documents submitted with the application (e.g., maps, engineering reports, letters of support).' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:letterOfSupportCount rdf:type rdf:Property ;
    rdfs:label 'Letter Of Support Count' ;
    rdfs:comment 'Number of letters of support from stakeholders, elected officials, or community organizations submitted with the application.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicEngagementDescription rdf:type rdf:Property ;
    rdfs:label 'Public Engagement Description' ;
    rdfs:comment 'Narrative description of public engagement activities conducted or planned for the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbeParticipationGoal rdf:type rdf:Property ;
    rdfs:label 'Dbe Participation Goal' ;
    rdfs:comment 'Target percentage of project contract value to be awarded to DBE firms, expressed as a decimal (e.g., 10.00 for 10%).' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dbeParticipationPlan rdf:type rdf:Property ;
    rdfs:label 'Dbe Participation Plan' ;
    rdfs:comment 'Description of the plan and strategies to achieve DBE participation goals for the project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isShovelReady rdf:type rdf:Property ;
    rdfs:label 'Is Shovel Ready' ;
    rdfs:comment 'Indicator of whether the project has completed all preliminary requirements and is ready to proceed to construction immediately upon funding.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readinessScore rdf:type rdf:Property ;
    rdfs:label 'Readiness Score' ;
    rdfs:comment 'Numerical score assessing the project readiness based on completion of environmental review, design, and right-of-way acquisition.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskAssessmentDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Description' ;
    rdfs:comment 'Narrative description of identified project risks and mitigation strategies.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMeasuresDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Measures Description' ;
    rdfs:comment 'Description of performance measures and metrics that will be used to evaluate project success and outcomes.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingRequirementsDescription rdf:type rdf:Property ;
    rdfs:label 'Reporting Requirements Description' ;
    rdfs:comment 'Description of grant reporting requirements and schedule for progress reports, financial reports, and performance monitoring.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Certification Date' ;
    rdfs:comment 'Date when the applicant certified compliance with all applicable federal and state requirements for grant eligibility.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditStatus rdf:type rdf:Property ;
    rdfs:label 'Audit Status' ;
    rdfs:comment 'Current status of any audits conducted on the grant application or awarded project.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitFeeId rdf:type rdf:Property ;
    rdfs:label 'Permit Fee Id' ;
    rdfs:comment 'Unique identifier for the permit fee record. Primary key for the permit fee reference data.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:permitTypeCode rdf:type rdf:Property ;
    rdfs:label 'Permit Type Code' ;
    rdfs:comment 'Standardized code identifying the type of environmental permit (e.g., CWA404 for Clean Water Act Section 404, NEPA-EIS for Environmental Impact Statement, NEPA-EA for Environmental Assessment, NEPA-CE for Categorical Exclusion).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitTypeName rdf:type rdf:Property ;
    rdfs:label 'Permit Type Name' ;
    rdfs:comment 'Full descriptive name of the environmental permit type (e.g., Section 404 Wetlands Permit, Environmental Impact Statement, Environmental Assessment).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitCategory rdf:type rdf:Property ;
    rdfs:label 'Permit Category' ;
    rdfs:comment 'Jurisdictional category of the permit indicating the level of government authority (federal, state, local, or joint jurisdiction).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Fee Currency Code' ;
    rdfs:comment 'ISO 4217 currency code for the fee amount. Typically USD for NCDOT operations.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeBasis rdf:type rdf:Property ;
    rdfs:label 'Fee Basis' ;
    rdfs:comment 'The calculation basis or methodology for determining the permit fee (e.g., flat rate, per acre of impact, per linear foot of disturbance, percentage of project cost).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Fee Amount' ;
    rdfs:comment 'The minimum fee amount that must be charged regardless of the fee basis calculation, ensuring a floor for permit processing costs.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Fee Amount' ;
    rdfs:comment 'The maximum fee amount that can be charged, providing a ceiling for permit fees regardless of project scale.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Fee Unit Of Measure' ;
    rdfs:comment 'The unit of measure used when the fee basis is quantity-based (e.g., acres for wetland impacts, linear feet for stream crossings, cubic yards for fill material).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableStatuteCode rdf:type rdf:Property ;
    rdfs:label 'Applicable Statute Code' ;
    rdfs:comment 'The legal statute code or citation that authorizes and governs the permit fee (e.g., NCGS 136-44.2, CFR 23 Part 771).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableStatuteName rdf:type rdf:Property ;
    rdfs:label 'Applicable Statute Name' ;
    rdfs:comment 'The full name or title of the statute, regulation, or ordinance that establishes the legal authority for the permit fee.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency Code' ;
    rdfs:comment 'Code identifying the primary regulatory agency responsible for administering the permit and collecting the fee (e.g., USACE for US Army Corps of Engineers, NCDEQ for NC Department of Environmental Quality, SHPO for State Historic Preservation Office).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAgencyName rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency Name' ;
    rdfs:comment 'Full name of the regulatory agency responsible for the permit (e.g., United States Army Corps of Engineers, North Carolina Department of Environmental Quality).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Status' ;
    rdfs:comment 'Current status of the permit fee record indicating whether it is actively in use, has been superseded by a newer fee schedule, or is pending approval.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeRevisionNumber rdf:type rdf:Property ;
    rdfs:label 'Fee Revision Number' ;
    rdfs:comment 'Sequential version number tracking revisions to the fee structure for this permit type, supporting historical fee analysis.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeRevisionDate rdf:type rdf:Property ;
    rdfs:label 'Fee Revision Date' ;
    rdfs:comment 'The date when this fee revision was officially approved and documented, supporting audit trails and compliance verification.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeApprovalAuthority rdf:type rdf:Property ;
    rdfs:label 'Fee Approval Authority' ;
    rdfs:comment 'The name or title of the authority (e.g., NC Legislature, NCDEQ Director, USACE District Commander) that approved the fee schedule.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Fee Approval Date' ;
    rdfs:comment 'The official date when the fee schedule was approved by the governing authority.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeApprovalDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Fee Approval Document Reference' ;
    rdfs:comment 'Reference number or identifier for the official document (e.g., legislative bill number, agency order number) that approved the fee schedule.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDueTiming rdf:type rdf:Property ;
    rdfs:label 'Payment Due Timing' ;
    rdfs:comment 'Specifies when the permit fee payment is due in the permit lifecycle (e.g., upon application submission, upon permit approval, upon permit issuance).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundPolicy rdf:type rdf:Property ;
    rdfs:label 'Refund Policy' ;
    rdfs:comment 'Policy governing whether and under what conditions permit fees may be refunded (e.g., non-refundable, partial refund if application withdrawn, full refund if permit denied).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Eligibility Flag' ;
    rdfs:comment 'Indicates whether this permit fee is eligible for waiver or reduction under certain circumstances (e.g., public benefit projects, non-profit applicants, emergency situations).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverCriteria rdf:type rdf:Property ;
    rdfs:label 'Waiver Criteria' ;
    rdfs:comment 'Description of the criteria or conditions under which the permit fee may be waived or reduced (e.g., public infrastructure projects, demonstrated financial hardship, emergency response).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expeditedProcessingFee rdf:type rdf:Property ;
    rdfs:label 'Expedited Processing Fee' ;
    rdfs:comment 'Additional fee amount charged for expedited or priority processing of the permit application, if available.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:latePaymentPenaltyRate rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Rate' ;
    rdfs:comment 'Percentage rate applied as a penalty for late payment of permit fees, expressed as a percentage of the original fee amount.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualAdjustmentMethod rdf:type rdf:Property ;
    rdfs:label 'Annual Adjustment Method' ;
    rdfs:comment 'Method used for periodic adjustment of permit fees (e.g., Consumer Price Index indexing, fixed percentage increase, legislative review).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualAdjustmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Annual Adjustment Percentage' ;
    rdfs:comment 'The percentage rate used for annual fee adjustments when a fixed percentage method is applied.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costRecoveryBasis rdf:type rdf:Property ;
    rdfs:label 'Cost Recovery Basis' ;
    rdfs:comment 'Indicates the cost recovery philosophy for the fee (e.g., full cost recovery to cover all administrative costs, partial recovery, subsidized by general funds).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueAccountCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Account Code' ;
    rdfs:comment 'The general ledger account code where permit fee revenue is recorded in the financial system.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Project Type Applicability' ;
    rdfs:comment 'Description of the types of transportation projects to which this permit fee applies (e.g., highway construction, bridge replacement, ferry terminal expansion, rail crossing improvements).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalImpactThreshold rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Threshold' ;
    rdfs:comment 'Description of the environmental impact thresholds that trigger this permit requirement and associated fee (e.g., wetland impacts exceeding 0.5 acres, stream crossings, endangered species habitat disturbance).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consultationRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Consultation Requirement Flag' ;
    rdfs:comment 'Indicates whether this permit type requires formal consultation with other agencies (e.g., SHPO for historic preservation, FWS for endangered species, USACE for wetlands).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consultationAgencies rdf:type rdf:Property ;
    rdfs:label 'Consultation Agencies' ;
    rdfs:comment 'Comma-separated list of agencies that must be consulted as part of the permit process (e.g., SHPO, USACE, FWS, NMFS, EPA).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNoticeRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Public Notice Requirement Flag' ;
    rdfs:comment 'Indicates whether public notice and comment period are required as part of the permit application process.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicCommentPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period Days' ;
    rdfs:comment 'The number of days allocated for public comment on the permit application, if public notice is required.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standardProcessingTimeDays rdf:type rdf:Property ;
    rdfs:label 'Standard Processing Time Days' ;
    rdfs:comment 'The typical or standard number of days required for the regulatory agency to process and issue a decision on the permit application.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expeditedProcessingTimeDays rdf:type rdf:Property ;
    rdfs:label 'Expedited Processing Time Days' ;
    rdfs:comment 'The reduced number of days for permit processing when expedited processing is requested and the additional fee is paid.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:permitDurationYears rdf:type rdf:Property ;
    rdfs:label 'Permit Duration Years' ;
    rdfs:comment 'The standard duration in years for which the permit is valid once issued, before renewal is required.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modificationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Modification Fee Amount' ;
    rdfs:comment 'The fee amount charged for modifying an existing permit (e.g., scope changes, timeline extensions, impact area adjustments).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Appeal Fee Amount' ;
    rdfs:comment 'The fee amount charged for filing an administrative appeal of a permit decision (denial, conditions, or other adverse determination).' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mitigationRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Mitigation Requirement Flag' ;
    rdfs:comment 'Indicates whether environmental mitigation (e.g., wetland mitigation, stream restoration, habitat compensation) is typically required for projects under this permit type.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mitigationRatio rdf:type rdf:Property ;
    rdfs:label 'Mitigation Ratio' ;
    rdfs:comment 'The typical mitigation ratio required (e.g., 2:1 meaning two acres of mitigation for every one acre of impact), if applicable to this permit type.' ;
    rdfs:domain ind:Environmental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Bond Requirement Flag' ;
    rdfs:comment 'Indicates whether a performance bond or financial assurance is required as part of the permit conditions to ensure compliance and completion of mitigation.' ;
    rdfs:domain ind:PermitFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bondAmountBasis rdf:type rdf:Property ;
    rdfs:label 'Bond Amount Basis' ;
    rdfs:comment 'Description of how the required bond amount is calculated (e.g., percentage of project cost, fixed amount per acre of impact, estimated mitigation cost plus contingency).' ;
    rdfs:domain ind:PermitFee ;
