ind:fridayServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Friday Service Flag' ;
    rdfs:comment 'Indicates whether service operates on Fridays under this schedule.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:saturdayServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Saturday Service Flag' ;
    rdfs:comment 'Indicates whether service operates on Saturdays under this schedule.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sundayServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Sunday Service Flag' ;
    rdfs:comment 'Indicates whether service operates on Sundays under this schedule.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:headwayMinutes rdf:type rdf:Property ;
    rdfs:label 'Headway Minutes' ;
    rdfs:comment 'Time interval in minutes between consecutive vehicle departures on the route during scheduled service.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
