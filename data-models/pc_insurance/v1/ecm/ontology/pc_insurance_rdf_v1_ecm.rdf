ind:insuredEntityId rdf:type rdf:Property ;
    rdfs:label 'Insured Entity Id' ;
    rdfs:comment 'Reference to the party master record representing the additional insured entity (person or organization). Provides identity resolution for the AI.' ;
    rdfs:domain ind:PcInsurance ;
