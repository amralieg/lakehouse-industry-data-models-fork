    rdfs:range ind:Calendar .

ind:actingUserCode rdf:type rdf:Property ;
    rdfs:label 'Acting User Code' ;
    rdfs:comment 'System identifier of the user or automated process that initiated this status transition.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actingUserName rdf:type rdf:Property ;
    rdfs:label 'Acting User Name' ;
    rdfs:comment 'Full name of the user who performed the status change, captured for audit and regulatory reporting.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actingUserRole rdf:type rdf:Property ;
    rdfs:label 'Acting User Role' ;
    rdfs:comment 'Business role or job function of the user at the time of the status transition, such as adjuster, examiner, or supervisor.' ;
