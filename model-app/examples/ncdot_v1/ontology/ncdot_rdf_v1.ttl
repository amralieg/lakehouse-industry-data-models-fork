    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Cost Category Code' ;
    rdfs:comment 'Code identifying the cost category for the budget allocation such as Preliminary Engineering (PE), Right-of-Way (ROW), Construction Engineering (CE), or Construction.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
