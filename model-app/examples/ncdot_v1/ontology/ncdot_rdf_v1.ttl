    rdfs:comment 'Code of the parent cost center in the organizational hierarchy for roll-up reporting and budget consolidation.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCapitalProject rdf:type rdf:Property ;
    rdfs:label 'Is Capital Project' ;
    rdfs:comment 'Indicates whether this cost center is associated with a capital project requiring special accounting treatment under GASB standards.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isGrantFunded rdf:type rdf:Property ;
    rdfs:label 'Is Grant Funded' ;
    rdfs:comment 'Indicates whether this cost center is funded by federal or state grant programs requiring compliance with OMB Uniform Guidance.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReimbursable rdf:type rdf:Property ;
    rdfs:label 'Is Reimbursable' ;
    rdfs:comment 'Indicates whether costs charged to this cost center are eligible for reimbursement from external parties (e.g., federal government, local municipalities).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresBudgetApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Budget Approval' ;
    rdfs:comment 'Indicates whether transactions posted to this cost center require prior budget approval or can be posted automatically.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsDirectPosting rdf:type rdf:Property ;
    rdfs:label 'Allows Direct Posting' ;
    rdfs:comment 'Indicates whether direct financial postings are allowed to this cost center or if all costs must be allocated from other cost centers.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Method' ;
    rdfs:comment 'Method used to allocate indirect costs to this cost center (e.g., direct allocation, step-down method, activity-based costing).' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceType rdf:type rdf:Property ;
    rdfs:label 'Maintenance Type' ;
    rdfs:comment 'Type of maintenance activities performed by this cost center if it is a maintenance-focused unit.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundId rdf:type rdf:Property ;
    rdfs:label 'Fund Id' ;
    rdfs:comment 'Unique identifier for the fund record. Primary key for the fund master data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:federalProgramName rdf:type rdf:Property ;
    rdfs:label 'Federal Program Name' ;
    rdfs:comment 'Official name of the federal program providing grant funding, such as Highway Safety Improvement Program (HSIP) or Congestion Mitigation and Air Quality (CMAQ).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appropriationNumber rdf:type rdf:Property ;
    rdfs:label 'Appropriation Number' ;
    rdfs:comment 'Legislative appropriation identifier for state-funded accounts. References specific line items in the state budget act.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingAgency rdf:type rdf:Property ;
    rdfs:label 'Funding Agency' ;
    rdfs:comment 'Name of the federal, state, or local agency providing the funding. Examples: FHWA, FTA, NC General Assembly.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Grant Period Start Date' ;
    rdfs:comment 'Start date of the grant performance period for federal or state grant funds. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grantPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Grant Period End Date' ;
    rdfs:comment 'End date of the grant performance period for federal or state grant funds. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizedAmount rdf:type rdf:Property ;
    rdfs:label 'Authorized Amount' ;
    rdfs:comment 'Total amount authorized for the fund by legislative appropriation, grant award, or administrative approval. Represents the maximum funding available.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedAmount rdf:type rdf:Property ;
    rdfs:label 'Budgeted Amount' ;
    rdfs:comment 'Total budgeted amount allocated to the fund for the current fiscal period. May be less than or equal to authorized amount.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:obligatedAmount rdf:type rdf:Property ;
    rdfs:label 'Obligated Amount' ;
    rdfs:comment 'Total amount of funds obligated through purchase orders, contracts, or other commitments but not yet expended.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableBalance rdf:type rdf:Property ;
    rdfs:label 'Available Balance' ;
    rdfs:comment 'Current available balance in the fund, calculated as authorized amount minus obligated and expended amounts.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchRequirementIndicator rdf:type rdf:Property ;
    rdfs:label 'Match Requirement Indicator' ;
    rdfs:comment 'Indicates whether the fund requires matching funds from state or local sources. True if match is required, false otherwise.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carryoverAllowedIndicator rdf:type rdf:Property ;
    rdfs:label 'Carryover Allowed Indicator' ;
    rdfs:comment 'Indicates whether unexpended funds can be carried over to the next fiscal period. True if carryover is allowed, false if funds lapse.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictedUseIndicator rdf:type rdf:Property ;
    rdfs:label 'Restricted Use Indicator' ;
    rdfs:comment 'Indicates whether the fund has restrictions on its use imposed by external parties, legislation, or grant terms. True if restricted, false if unrestricted.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictionDescription rdf:type rdf:Property ;
    rdfs:label 'Restriction Description' ;
    rdfs:comment 'Detailed description of any restrictions on the use of the fund, including eligible expense categories, geographic limitations, or project type constraints.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountingSystemCode rdf:type rdf:Property ;
    rdfs:label 'Accounting System Code' ;
    rdfs:comment 'Code identifying the accounting system where the fund is recorded. Examples: SAP, NCFS (NC Financial System), legacy systems.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditRequirementIndicator rdf:type rdf:Property ;
    rdfs:label 'Audit Requirement Indicator' ;
    rdfs:comment 'Indicates whether the fund is subject to specific audit requirements such as Single Audit or program-specific audits. True if audit required, false otherwise.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:singleAuditIndicator rdf:type rdf:Property ;
    rdfs:label 'Single Audit Indicator' ;
    rdfs:comment 'Indicates whether the fund is subject to Single Audit requirements under OMB Uniform Guidance. True if subject to Single Audit, false otherwise.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceRequirements rdf:type rdf:Property ;
    rdfs:label 'Compliance Requirements' ;
    rdfs:comment 'Description of specific compliance requirements applicable to the fund, including federal regulations, state statutes, or grant terms.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indirectCostRateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Indirect Cost Rate Effective Date' ;
    rdfs:comment 'Date when the current indirect cost rate became effective. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mpoInvolvementIndicator rdf:type rdf:Property ;
    rdfs:label 'Mpo Involvement Indicator' ;
    rdfs:comment 'Indicates whether the fund involves coordination with Metropolitan Planning Organizations for project planning and approval. True if MPO involved, false otherwise.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:generalLedgerId rdf:type rdf:Property ;
    rdfs:label 'General Ledger Id' ;
    rdfs:comment 'Unique identifier for the general ledger record. Primary key for the general ledger master data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneralLedger .

ind:chartOfAccountsCode rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Code' ;
    rdfs:comment 'Unique code identifying the account within the chart of accounts structure. Used for financial classification and reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountShortName rdf:type rdf:Property ;
    rdfs:label 'Account Short Name' ;
    rdfs:comment 'Abbreviated name of the general ledger account for display in constrained reporting formats.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the account into fundamental accounting categories: asset, liability, equity, revenue, or expense.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountGroup rdf:type rdf:Property ;
    rdfs:label 'Account Group' ;
    rdfs:comment 'Logical grouping of accounts for consolidated reporting and analysis. Used for financial statement line item aggregation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementLineItem rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Line Item' ;
    rdfs:comment 'The specific line item on the financial statement where this account balance is reported.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:normalBalanceIndicator rdf:type rdf:Property ;
    rdfs:label 'Normal Balance Indicator' ;
    rdfs:comment 'Indicates whether the account normally carries a debit or credit balance based on accounting principles.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceSheetIndicator rdf:type rdf:Property ;
    rdfs:label 'Balance Sheet Indicator' ;
    rdfs:comment 'Flag indicating whether this account appears on the balance sheet (true) or income statement (false).' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundType rdf:type rdf:Property ;
    rdfs:label 'Fund Type' ;
    rdfs:comment 'Classification of the fund according to GASB standards: general, special revenue, capital projects, debt service, enterprise, internal service, trust, or agency.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantCode rdf:type rdf:Property ;
    rdfs:label 'Grant Code' ;
    rdfs:comment 'Unique identifier for federal or state grant funding associated with this account. Required for grant administration and compliance.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectCode rdf:type rdf:Property ;
    rdfs:label 'Project Code' ;
    rdfs:comment 'Code identifying the capital project or work order. Links financial data to STIP and TIP projects.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controllingAreaCode rdf:type rdf:Property ;
    rdfs:label 'Controlling Area Code' ;
    rdfs:comment 'SAP controlling area code for cost accounting and internal reporting. Typically aligned with company code.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAreaCode rdf:type rdf:Property ;
    rdfs:label 'Business Area Code' ;
    rdfs:comment 'Code representing the business area for segment reporting. Used for external financial statement segmentation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingLevel rdf:type rdf:Property ;
    rdfs:label 'Posting Level' ;
    rdfs:comment 'Hierarchical level in the chart of accounts structure. Used for roll-up and consolidation reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Parent Account Number' ;
    rdfs:comment 'Account number of the parent account in the hierarchical chart of accounts structure. Used for account roll-ups.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountHierarchyPath rdf:type rdf:Property ;
    rdfs:label 'Account Hierarchy Path' ;
    rdfs:comment 'Full hierarchical path from root to this account. Format: root/level1/level2/account. Used for drill-down reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localCurrencyBalance rdf:type rdf:Property ;
    rdfs:label 'Local Currency Balance' ;
    rdfs:comment 'Current balance of the account in local currency (USD). Represents the net of all debits and credits posted to the account.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debitBalance rdf:type rdf:Property ;
    rdfs:label 'Debit Balance' ;
    rdfs:comment 'Total debit balance for the account in the current period. Used for trial balance and reconciliation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditBalance rdf:type rdf:Property ;
    rdfs:label 'Credit Balance' ;
    rdfs:comment 'Total credit balance for the account in the current period. Used for trial balance and reconciliation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beginningBalance rdf:type rdf:Property ;
    rdfs:label 'Beginning Balance' ;
    rdfs:comment 'Account balance at the beginning of the fiscal year or accounting period. Used for period-over-period analysis.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingBalance rdf:type rdf:Property ;
    rdfs:label 'Ending Balance' ;
    rdfs:comment 'Account balance at the end of the fiscal year or accounting period. Used for financial statement preparation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableBudget rdf:type rdf:Property ;
    rdfs:label 'Available Budget' ;
    rdfs:comment 'Remaining budget available for expenditure. Calculated as budget minus actual expenditures minus encumbrances.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationIndicator rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Indicator' ;
    rdfs:comment 'Flag indicating whether this account requires periodic reconciliation. Typically true for balance sheet accounts.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationFrequency rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Frequency' ;
    rdfs:comment 'Required frequency for account reconciliation: daily, weekly, monthly, quarterly, or annually.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingBlockIndicator rdf:type rdf:Property ;
    rdfs:label 'Posting Block Indicator' ;
    rdfs:comment 'Flag indicating whether postings to this account are currently blocked. Used for account maintenance and period close.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planningLevelIndicator rdf:type rdf:Property ;
    rdfs:label 'Planning Level Indicator' ;
    rdfs:comment 'Flag indicating whether this account is used for budget planning. True for accounts included in budget planning cycles.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statisticalAccountIndicator rdf:type rdf:Property ;
    rdfs:label 'Statistical Account Indicator' ;
    rdfs:comment 'Flag indicating whether this is a statistical account used for non-monetary tracking (e.g., headcount, vehicle count).' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxRelevantIndicator rdf:type rdf:Property ;
    rdfs:label 'Tax Relevant Indicator' ;
    rdfs:comment 'Flag indicating whether transactions in this account are relevant for tax reporting and compliance.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalReportingIndicator rdf:type rdf:Property ;
    rdfs:label 'Federal Reporting Indicator' ;
    rdfs:comment 'Flag indicating whether this account is included in federal reporting requirements (FHWA, FTA, FAA, FRA).' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Federal Reporting Category' ;
    rdfs:comment 'Category code for federal reporting classification. Used for FHWA, FTA, and other federal agency reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasbClassificationCode rdf:type rdf:Property ;
    rdfs:label 'Gasb Classification Code' ;
    rdfs:comment 'GASB-compliant classification code for governmental financial reporting. Ensures compliance with GASB standards.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cafrLineItem rdf:type rdf:Property ;
    rdfs:label 'Cafr Line Item' ;
    rdfs:comment 'Line item reference in the Comprehensive Annual Financial Report where this account balance is reported.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current operational status of the account: active (in use), inactive (not currently used), closed (permanently closed), suspended (temporarily blocked).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountDescription rdf:type rdf:Property ;
    rdfs:label 'Account Description' ;
    rdfs:comment 'Detailed description of the account purpose, usage guidelines, and business context. Used for user guidance and documentation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountOwner rdf:type rdf:Property ;
    rdfs:label 'Account Owner' ;
    rdfs:comment 'Name or identifier of the business owner responsible for this account. Used for accountability and governance.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountManager rdf:type rdf:Property ;
    rdfs:label 'Account Manager' ;
    rdfs:comment 'Name or identifier of the financial manager responsible for monitoring and reconciling this account.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortKey rdf:type rdf:Property ;
    rdfs:label 'Sort Key' ;
    rdfs:comment 'Alphanumeric key used for sorting and organizing accounts in reports. Typically based on account hierarchy.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Alternate Account Number' ;
    rdfs:comment 'Alternative account number used in legacy systems or external reporting. Used for cross-system reconciliation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legacySystemCode rdf:type rdf:Property ;
    rdfs:label 'Legacy System Code' ;
    rdfs:comment 'Account code from legacy systems (DCH, NCFS) prior to SAP implementation. Used for historical data mapping.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReportingCode rdf:type rdf:Property ;
    rdfs:label 'External Reporting Code' ;
    rdfs:comment 'Code used for external reporting to state legislature, federal agencies, or public disclosure. May differ from internal codes.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailIndicator rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Indicator' ;
    rdfs:comment 'Flag indicating whether detailed audit trail logging is required for this account. Typically true for high-risk accounts.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Approval Required Indicator' ;
    rdfs:comment 'Flag indicating whether postings to this account require supervisory approval. Used for financial control.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varianceTolerancePercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Tolerance Percentage' ;
    rdfs:comment 'Acceptable percentage variance between budget and actual for this account. Used for exception reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:materialityThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Materiality Threshold Amount' ;
    rdfs:comment 'Dollar amount threshold for determining materiality in financial audits. Used for audit planning and risk assessment.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPostingDate rdf:type rdf:Property ;
    rdfs:label 'Last Posting Date' ;
    rdfs:comment 'Date of the most recent transaction posted to this account. Used for activity monitoring and dormant account identification.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordCreatedBy rdf:type rdf:Property ;
    rdfs:label 'Record Created By' ;
    rdfs:comment 'User ID or name of the person who created this general ledger account record.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordModifiedDate rdf:type rdf:Property ;
    rdfs:label 'Record Modified Date' ;
    rdfs:comment 'Date when this general ledger account record was last modified.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Record Modified By' ;
    rdfs:comment 'User ID or name of the person who last modified this general ledger account record.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procurementPlanId rdf:type rdf:Property ;
    rdfs:label 'Procurement Plan Id' ;
    rdfs:comment 'Unique identifier for the procurement plan record.' ;
    rdfs:domain ind:ProcurementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Total Budget Amount' ;
    rdfs:comment 'Total budget allocation for all procurement activities covered in this plan.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Budget Currency Code' ;
    rdfs:comment 'Currency code for budget amounts, typically USD for NCDOT.' ;
    rdfs:domain ind:ProcurementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByTitle rdf:type rdf:Property ;
    rdfs:label 'Approved By Title' ;
    rdfs:comment 'Title or position of the individual who approved the procurement plan.' ;
    rdfs:domain ind:ProcurementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparedByDepartment rdf:type rdf:Property ;
    rdfs:label 'Prepared By Department' ;
    rdfs:comment 'Department or division responsible for preparing the procurement plan.' ;
    rdfs:domain ind:ProcurementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Stip Reference Number' ;
    rdfs:comment 'Reference number linking this procurement plan to the State Transportation Improvement Program if applicable.' ;
    rdfs:domain ind:ProcurementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tipReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Tip Reference Number' ;
