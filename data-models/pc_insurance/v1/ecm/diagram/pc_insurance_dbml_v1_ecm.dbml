// DBML Schema for Business: Pc_Insurance
// Version: 1
// Generated on: 2026-09-18 02:23:57

Project {
  database_type: 'Databricks Unity Catalog'
  Note: 'Lakehouse data model for Pc_Insurance - Version 1'
}

Table policy.policy {
  policy_id varchar [pk, note: 'Unique system identifier for the P&C policy record. Primary key.']
  agency_id varchar [note: 'Foreign key to the agency organization that placed this policy.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Policies denominate premium (gwp_amount, nwp_amount) in a specific currency. Replacing currency_code with FK to shared.currency enforces referential integrity for financial reporting and']
  regulatory_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Regulatory state governs rate filing, form approval, premium tax, and statutory reporting requirements. FK to shared.state enables compliance reporting and DOI filings by jurisdiction.']
  source_policy_id varchar [note: 'Native policy identifier from the source system. Used for reconciliation and lineage.']
  audit_type varchar [note: 'Type of premium audit required at policy expiration: none, physical, financial, or payroll audit.']
  billing_method varchar [note: 'Method by which premium is billed: direct (carrier bills insured), agency (agent bills insured), or list (reported on bordereaux).']
  bind_date date [note: 'Date the policy was bound, establishing the carriers commitment to provide coverage.']
  business_type varchar [note: 'Transaction business type: NB (New Business), REN (Renewal), ENDT (Endorsement), CANC (Cancellation), REINST (Reinstatement).']
  cancellation_date date [note: 'Effective date of policy cancellation if the policy was cancelled before expiration. Null if not cancelled.']
  cancellation_reason_code varchar [note: 'Code indicating the reason for policy cancellation: non-payment, underwriting, insured request, etc.']
  cancellation_type varchar [note: 'Method of premium calculation upon cancellation: flat (no earned premium), short-rate (penalty), or pro-rata (proportional).']
  cat_exposure_flag boolean [note: 'Indicates whether this policy has exposure to catastrophe perils (hurricane, earthquake, flood, wildfire).']
  commission_rate decimal(5,4) [note: 'Commission rate percentage paid to the producer on this policy. Expressed as a decimal (e.g., 0.1500 for 15%).']
  created_timestamp timestamp [note: 'Timestamp when this policy record was first created in the system.']
  effective_date date [note: 'Date the policy coverage begins. Start of the policy term.']
  expiration_date date [note: 'Date the policy coverage ends. End of the policy term.']
  gwp_amount decimal(15,2) [note: 'Total gross written premium for the policy term before any reinsurance cessions.']
  issue_date date [note: 'Date the policy was officially issued by the carrier.']
  lob_code varchar [note: 'Line of business code: GL, WC, CPP, BOP, AUTO, PROP, etc. Identifies the primary insurance product line.']
  mailing_address_line1 varchar [note: 'First line of the policy mailing address for correspondence and declarations.']
  mailing_address_line2 varchar [note: 'Second line of the policy mailing address (suite, unit, etc.).']
  mailing_city varchar [note: 'City of the policy mailing address.']
  mailing_postal_code varchar [note: 'ZIP or postal code of the policy mailing address.']
  mailing_state_code varchar [note: 'Two-letter state code of the policy mailing address.']
  module varchar [note: 'Module or sequence number component of the policy identifier used in some carrier numbering schemes.']
  naic_line_code varchar [note: 'NAIC statutory reporting line code for regulatory and financial reporting.']
  named_insured_name varchar [note: 'Full legal name of the primary named insured on the policy.']
  number varchar [note: 'Externally visible unique policy number assigned at issuance. Business identifier for the policy across all systems and communications.']
  nwp_amount decimal(15,2) [note: 'Net written premium after reinsurance cessions. Amount retained by the carrier.']
  payment_plan_code varchar [note: 'Code identifying the premium payment plan: full-pay, installment, agency-bill, direct-bill, etc.']
  pml_amount decimal(15,2) [note: 'Estimated probable maximum loss for catastrophe modeling and reinsurance placement.']
  policy_status varchar [note: 'Current lifecycle status of the policy: quoted, bound, issued, inforce, cancelled, expired, nonrenewed, or reinstated. [ENUM-REF-CANDIDATE: quoted|bound|issued|inforce|cancelled|expired|nonrenewed|reinstated — 8 candidates stripped; promote to reference']
  policy_type varchar [note: 'High-level policy classification: personal lines, commercial lines, or specialty.']
  prior_policy_number varchar [note: 'Policy number of the prior term if this is a renewal. Links to the previous term.']
  quote_date date [note: 'Date the initial quote was generated for this policy.']
  renewal_policy_number varchar [note: 'Policy number of the renewal policy if this policy was renewed. Links to the subsequent term.']
  source_system_code varchar [note: 'Code identifying the source system of record: PolicyCenter, Duck Creek Policy, Sapiens IDIT, etc.']
  symbol varchar [note: 'ISO or carrier-specific policy symbol code identifying the product line and rating program.']
  term_months varchar [note: 'Duration of the policy term expressed in months. Typically 6 or 12 months for standard policies.']
  total_insured_value decimal(15,2) [note: 'Total insured value across all covered property and exposures on this policy.']
  underwriter_code varchar [note: 'Foreign key to the employee or user who underwrote this policy.']
  underwriting_company_code varchar [note: 'Code identifying the legal entity (insurance company) that underwrites and bears the risk for this policy.']
  updated_timestamp timestamp [note: 'Timestamp when this policy record was last updated.']

  Note: 'Master record for a P&C policy across personal and commercial lines. SSOT for policy identity, LOB and NAIC line code, term dates, and status. Anchors the lifecycle: NB, REN, ENDT, CANC, reinstatement, non-renewal.'
}

Table policy.version {
  version_id varchar [pk, note: 'Unique identifier for this immutable policy version snapshot. Primary key.']
  agency_id varchar [note: 'Reference to the agency or brokerage firm associated with this policy version.']
  billing_account_id varchar [note: 'Reference to the billing account used for premium collection on this policy version.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Version-level premium amounts (gwp_amount, nwp_amount, tax_amount, fee_amount, total_premium_amount) require currency FK for accurate financial consolidation and multi-currency policy']
  named_insured_id varchar [note: 'Reference to the primary named insured party on this policy version.']
  policy_id varchar [note: 'Reference to the parent policy container that this version belongs to.']
  prior_version_id varchar [note: 'Reference to the immediately preceding policy version, enabling full audit lineage.']
  producers_producer_id varchar [note: 'Reference to the agent or broker who sold or services this policy version.']
  regulatory_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Version-level regulatory state tracking is required for mid-term changes that cross state jurisdictions or trigger state-specific endorsement filing and premium tax recalculation.']
  booking_date date [note: 'Accounting date when this version was booked for financial and statutory reporting purposes.']
  cancellation_reason_code varchar [note: 'Code indicating the reason for cancellation if this version represents a cancellation.']
  cancellation_type varchar [note: 'Type of cancellation applied if this version represents a cancellation transaction.']
  commission_amount decimal(18,2) [note: 'Total commission amount payable to the producer for this policy version.']
  commission_rate decimal(5,4) [note: 'Commission rate percentage paid to the producer for this policy version.']
  created_by_user_code varchar [note: 'User identifier of the person or system that created this policy version.']
  created_timestamp timestamp [note: 'Timestamp when this policy version record was first created in the system.']
  declaration_page_generated_flag boolean [note: 'Indicates whether a declarations page document was generated for this policy version.']
  declaration_page_url varchar [note: 'URL or document reference to the declarations page for this policy version.']
  effective_date date [note: 'Date when this policy version becomes effective and coverage begins or changes take effect.']
  expiration_date date [note: 'Date when this policy version expires and coverage ends or changes cease.']
  fee_amount decimal(18,2) [note: 'Total policy fees (policy fee, installment fee, inspection fee) charged on this policy version.']
  gwp_amount decimal(18,2) [note: 'Total gross written premium for this policy version before any reinsurance cessions.']
  lob_code varchar [note: 'Code identifying the line of business (e.g., Personal Auto, Commercial Property, Workers Compensation, General Liability).']
  modified_by_user_code varchar [note: 'User identifier of the person or system that last modified this policy version.']
  modified_timestamp timestamp [note: 'Timestamp when this policy version record was last modified.']
  notice_date date [note: 'Date when notice of cancellation or non-renewal was sent to the insured.']
  number varchar [note: 'Sequential version number within the policy lifecycle. Increments with each transaction (NB, ENDT, REN, CANC, reinstatement).']
  nwp_amount decimal(18,2) [note: 'Net written premium after reinsurance cessions for this policy version.']
  product_code varchar [note: 'Code identifying the specific insurance product or program within the line of business.']
  reversal_flag boolean [note: 'Indicates whether this version reverses a prior transaction.']
  source_system_code varchar [note: 'Code identifying the operational system of record that created this policy version.']
  source_version_id varchar [note: 'Native version identifier from the source policy administration system.']
  tax_amount decimal(18,2) [note: 'Total taxes (premium tax, surplus lines tax, stamping fees) applicable to this policy version.']
  total_premium_amount decimal(18,2) [note: 'Total amount due including premium, taxes, and fees for this policy version.']
  transaction_effective_timestamp timestamp [note: 'Precise timestamp when the transaction that created this version became effective.']
  transaction_type_code varchar [note: 'Type of transaction that created this version: New Business (NB), Endorsement (ENDT), Renewal (REN), Cancellation (CANC), Reinstatement (REINST), or Rewrite.']
  underwriter_code varchar [note: 'Reference to the underwriter who approved or processed this version.']
  underwriting_tier varchar [note: 'Risk tier or rating class assigned by underwriting (e.g., Preferred, Standard, Non-Standard).']
  version_status varchar [note: 'Current lifecycle status of this policy version snapshot. [ENUM-REF-CANDIDATE: DRAFT|QUOTED|BOUND|ISSUED|ACTIVE|EXPIRED|CANCELLED — 7 candidates stripped; promote to reference product]']

  Note: 'Immutable snapshot of a policy at each transaction (NB, ENDT, REN, CANC, reinstatement). Tracks effective and expiration dates per version, enabling full audit lineage of policy changes over time.'
}

Table policy.policy_coverage {
  policy_coverage_id varchar [pk, note: 'Unique identifier for the policy coverage junction record.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Coverage parts map to lines of business for NAIC statutory reporting, reinsurance treaty attachment, and loss ratio analysis. FK to shared.lob_code standardizes line classification.']
  part_id varchar [note: 'Foreign key to the coverage definition being applied to this policy.']
  policy_form_id varchar [note: 'Foreign key linking to policy.policy_form. Business justification: Policy coverage references specific coverage forms via coverage_form_number and coverage_form_edition_date.']
  policy_id varchar [note: 'Foreign key to the policy that this coverage is attached to.']
  prior_coverage_id varchar [note: 'Reference to the previous version of this coverage attachment if this is an endorsement or renewal.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Policy coverages change with endorsements (limits adjusted, coverages added/removed). Each coverage record should link to the version in which it became effective.']
  agreed_value_amount decimal(18,2) [note: 'Pre-agreed value of covered property, eliminating coinsurance penalties at time of loss.']
  benefit_period_days varchar [note: 'Maximum number of days benefits will be paid under this coverage after the elimination period.']
  blanket_coverage_flag boolean [note: 'Indicates whether this coverage applies on a blanket basis across multiple locations or items.']
  change_reason_code varchar [note: 'Reason code indicating why this coverage was added, modified, or removed.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of the loss shared by the insured after the deductible is met, expressed as a decimal.']
  coverage_status varchar [note: 'Current lifecycle status of the coverage on this policy.']
  created_timestamp timestamp [note: 'Timestamp when this policy coverage record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'Dollar amount the insured must pay out-of-pocket before coverage applies.']
  deductible_type varchar [note: 'Type of deductible applied, such as flat dollar amount, percentage of loss, or aggregate.']
  effective_date date [note: 'Date when this coverage becomes effective on the policy.']
  elimination_period_days varchar [note: 'Number of days after a loss before benefits begin to be paid under this coverage.']
  endorsement_number varchar [note: 'Endorsement number if this coverage was added or modified via policy endorsement.']
  expiration_date date [note: 'Date when this coverage expires or terminates on the policy.']
  extended_reporting_period_days varchar [note: 'Number of days after policy expiration during which claims may be reported for prior occurrences.']
  inflation_guard_percentage decimal(5,2) [note: 'Annual percentage increase applied to coverage limits to account for inflation.']
  last_modified_timestamp timestamp [note: 'Timestamp when this policy coverage record was last updated.']
  limit_amount decimal(18,2) [note: 'Maximum dollar amount the insurer will pay for covered losses under this coverage.']
  limit_type varchar [note: 'Type of limit applied, such as per occurrence, aggregate, or combined single limit.']
  optional_coverage_flag boolean [note: 'Indicates whether this coverage is optional or mandatory for the policy.']
  per_location_limit_amount decimal(18,2) [note: 'Maximum coverage limit applicable to each individual location under a blanket coverage.']
  premium_amount decimal(18,2) [note: 'Premium charged for this specific coverage on the policy.']
  premium_basis varchar [note: 'The rating basis used to calculate premium, such as payroll, sales, area, or number of units.']
  premium_basis_amount decimal(18,2) [note: 'Numeric value of the premium basis used in rating calculations.']
  rate decimal(12,6) [note: 'Rate applied to the premium basis to calculate the coverage premium.']
  rate_type varchar [note: 'Type of rating method applied, such as manual, experience-rated, or schedule-rated.']
  retroactive_date date [note: 'Earliest date of loss or occurrence for which claims-made coverage will respond.']
  sequence_number varchar [note: 'Ordinal position of this coverage within the policy structure for display and processing order.']
  sir_amount decimal(18,2) [note: 'Dollar amount of loss the insured retains before coverage applies, similar to a deductible but with different legal implications.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this coverage attachment originated.']
  territory_code varchar [note: 'Geographic territory where this coverage applies, using ISO territory codes.']
  trigger_type varchar [note: 'Type of trigger that activates coverage, such as occurrence-based or claims-made.']
  underwriter_code varchar [note: 'Identifier of the underwriter who approved this coverage attachment.']
  valuation_method varchar [note: 'Method used to value covered property at time of loss: Actual Cash Value, Replacement Cost Value, or other.']
  version_number varchar [note: 'Version number tracking changes to this coverage attachment over the policy lifecycle.']
  waiting_period_days varchar [note: 'Number of days from policy inception before this coverage becomes active.']

  Note: 'Junction table resolving the M:N relationship between policies and coverages. Carries coverage-specific limits, deductibles, SIR, and effective dates as they apply to a specific policy version.'
}

Table policy.policy_insured {
  policy_insured_id varchar [pk, note: 'Unique identifier for the insured party record. Primary key.']
  insured_id varchar [note: 'Reference to the party entity representing the insured individual or organization.']
  mailing_country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Policy insured mailing country supports international additional insureds and certificate holders. FK to shared.country enforces referential integrity for cross-border policies.']
  mailing_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Policy insured mailing state (for additional insureds, certificate holders) is required for certificate issuance and notice delivery. FK to shared.state standardizes state references.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Insureds are added/removed via endorsements (additional insureds, certificate holders). Each policy_insured record should link to the version in which the insured was added.']
  added_by_endorsement_number varchar [note: 'Endorsement (ENDT) number that added this insured to the policy, if applicable.']
  additional_insured_type_code varchar [note: 'Code specifying the type of additional insured coverage provided (e.g., blanket, scheduled, contractual). [ENUM-REF-CANDIDATE: BLKT|SCHD|CNTR|OWNR|LSEE|MGMT|VEND|GENL — promote to reference product]']
  business_description varchar [note: 'Free-text description of the insured\'s business operations for commercial policies.']
  cancellation_date date [note: 'Date on which this insured\'s association with the policy was cancelled, if applicable.']
  cancellation_reason_code varchar [note: 'Code indicating the reason for cancelling this insured from the policy: Non-Payment (NPAY), Frequency (FREQ), Material Misrepresentation (MATL), Insured Request (INSREQ), Underwriting (UW), Other (OTH).']
  certificate_holder_flag boolean [note: 'Indicates whether this insured is also a certificate holder requiring proof of insurance documentation.']
  clue_report_date date [note: 'Date when the CLUE report was obtained for this insured.']
  clue_report_ordered_flag boolean [note: 'Indicates whether a CLUE report was ordered for this insured during underwriting.']
  contact_email_address varchar [note: 'Primary email address for electronic communication with the insured.']
  contact_phone_number varchar [note: 'Primary phone number for contacting the insured regarding policy matters.']
  created_by_user_code varchar [note: 'Identifier of the user or system process that created this policy-insured association record.']
  created_timestamp timestamp [note: 'Date and time when this policy-insured association record was first created in the system.']
  credit_score varchar [note: 'Credit-based insurance score used for underwriting and rating, where permitted by state regulation.']
  credit_score_date date [note: 'Date when the credit score was obtained or last refreshed.']
  date_of_birth date [note: 'Birth date of the individual insured, used for underwriting and rating purposes.']
  dba_name varchar [note: 'Trade name or DBA under which the insured operates, if different from legal name.']
  effective_date date [note: 'Date on which this insured role becomes active on the policy.']
  email_address varchar [note: 'Primary email address for electronic correspondence and policy documents delivery.']
  entity_type varchar [note: 'Legal structure of the insured: individual, sole proprietor, partnership, LLC, corporation, trust, estate, or government entity. [ENUM-REF-CANDIDATE: individual|sole_proprietor|partnership|llc|corporation|trust|estate|government — 8 candidates stripped']
  expiration_date date [note: 'Date when this insureds coverage under the policy expires or was removed.']
  fein varchar [note: 'IRS-issued FEIN for commercial entities. Format: XX-XXXXXXX.']
  gender varchar [note: 'Gender of the individual insured. M=Male, F=Female, X=Non-binary, U=Unknown or not disclosed.']
  industry_code varchar [note: 'NAICS or SIC code representing the insureds primary business industry for commercial insureds.']
  insurable_interest_description varchar [note: 'Narrative description of the insureds insurable interest in the covered property or exposure.']
  insured_name varchar [note: 'Full legal name of the insured party as it appears on the policy declarations page (DEC).']
  interest_description varchar [note: 'Detailed description of the insured\'s interest in the covered property or risk.']
  interest_type varchar [note: 'Nature of the insureds financial interest in the covered property or risk: owner, lessee, mortgagor, bailee, trustee, or beneficiary.']
  interest_type_code varchar [note: 'Code representing the nature of the insured\'s interest in the covered property or risk: Owner (OWN), Lessee (LSE), Mortgagee (MTG), Vendor (VND), Bailee (BLR), Other (OTH).']
  language_preference varchar [note: 'Two-letter ISO language code for the insureds preferred communication language.']
  last_modified_by_user_code varchar [note: 'Identifier of the user or system process that last modified this policy-insured association record.']
  last_modified_timestamp timestamp [note: 'Date and time when this policy-insured association record was last updated.']
  legal_name varchar [note: 'Full legal name of the insured party as it appears on official documents and declarations page (DEC).']
  loan_number varchar [note: 'Loan or mortgage account number associated with the insured\'s interest, applicable for mortgagees and lienholders.']
  mailing_address_line1 varchar [note: 'First line of the insured\'s mailing address for policy correspondence.']
  mailing_address_line2 varchar [note: 'Second line of the insured\'s mailing address, typically suite or unit number.']
  mailing_city varchar [note: 'City name for the insured\'s mailing address.']
  mailing_postal_code varchar [note: 'ZIP or postal code for the insureds mailing address. Format: XXXXX or XXXXX-XXXX.']
  marital_status varchar [note: 'Marital status of the individual insured, used for underwriting and rating in personal lines.']
  mobile_phone varchar [note: 'Mobile telephone number for the insured, used for SMS notifications and mobile contact.']
  mvr_order_date date [note: 'Date when the MVR was obtained for this insured.']
  mvr_ordered_flag boolean [note: 'Indicates whether a Motor Vehicle Report was ordered for this insured during underwriting.']
  naics_code varchar [note: 'Six-digit NAICS code classifying the insured\'s primary business activity for commercial risks.']
  occupation varchar [note: 'Primary occupation or profession of the individual insured, used for risk classification.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership or interest the insured holds in the covered property or entity.']
  paperless_delivery_flag boolean [note: 'Indicates whether the insured has elected paperless delivery of policy documents and correspondence.']
  policy_insured_status varchar [note: 'Current lifecycle status of the insured on the policy: active, inactive, suspended, deceased, or removed.']
  policy_insured_type varchar [note: 'Classification of the insured role on the policy: named insured, additional insured, loss payee, mortgagee, lienholder, or certificate holder.']
  primary_insured_flag boolean [note: 'Indicates whether this party is the primary or named insured on the policy.']
  primary_phone varchar [note: 'Primary contact telephone number for the insured.']
  prior_carrier_name varchar [note: 'Name of the insureds previous insurance carrier, used for underwriting continuity assessment.']
  prior_policy_number varchar [note: 'Policy number with the prior carrier, used for loss history verification.']
  removed_by_endorsement_number varchar [note: 'Endorsement (ENDT) number that removed this insured from the policy, if applicable.']
  role_code varchar [note: 'Code indicating the role of the insured on the policy: Named Insured (NI), Additional Insured (AI), Loss Payee (LP), Mortgagee (MTG), Lienholder (LH), or Additional Interest (INT).']
  role_description varchar [note: 'Full text description of the insured role on the policy.']
  sequence varchar [note: 'Ordinal position of this insured on the policy for display and reporting purposes.']
  sequence_number varchar [note: 'Ordinal position of this insured within the policy, used for display and sorting purposes.']
  sic_code varchar [note: 'Four-digit SIC code classifying the insured\'s industry for underwriting and rating purposes.']
  source_record_code varchar [note: 'Unique identifier of this insured record in the source operational system.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this insured record originated: Guidewire (GW), Duck Creek (DC), Sapiens (SAP), ISO (ISO), Legacy (LEG), Other (OTH).']
  ssn varchar [note: 'Social Security Number for individual insureds, used for underwriting and claims purposes.']
  status_code varchar [note: 'Current status of the insured association: Active (ACT), Inactive (INA), Pending (PND), Cancelled (CAN), Expired (EXP).']
  underwriter_notes varchar [note: 'Free-text notes from the underwriter regarding this insured\'s risk profile or special considerations.']
  updated_timestamp timestamp [note: 'Date and time when this insured record was last modified.']
  waiver_of_subrogation_flag boolean [note: 'Indicates whether the insurer has waived subrogation rights against this insured party.']
  years_in_business varchar [note: 'Number of years the insured has been operating in their current business, used for underwriting assessment.']
  years_with_prior_carrier varchar [note: 'Number of continuous years the insured was with their prior carrier, used for loyalty and persistency rating.']

  Note: 'Master record for the named insured or additional insured on a policy. Captures party identity (individual or commercial entity), FEIN/SSN, DBA, and insured type. SSOT for insured party within the policy domain.'
}

Table policy.insured {
  insured_id varchar [pk, note: 'Primary key for insured']
  policy_id varchar [note: 'Auto-generated FK linking siloed insured to policy']

  Note: 'Association table linking insureds to a policy version with role (named insured, additional insured, loss payee, mortgagee). Supports multiple insured parties per policy and tracks role effective dates.'
}

Table policy.declarations {
  declarations_id varchar [pk, note: 'Unique identifier for the declarations page record.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Declarations page displays premium amounts in a specific currency. FK to shared.currency ensures consistent currency formatting and symbol display on dec pages.']
  declarations_producers_producer_id varchar [note: 'Reference to the producer entity who sold or serviced this policy.']
  declarations_producers_producers_producer_id varchar [note: 'Reference to the underwriter who approved this policy.']
  mailing_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Declarations page mailing state determines delivery compliance and state-specific disclosure requirements. FK to shared.state enables state-specific dec page generation rules.']
  policy_form_id varchar [note: 'Foreign key linking to policy.policy_form. Business justification: Declarations page references policy forms via form_numbers (denormalized STRING). Adding FK to primary policy_form enables proper form resolution and retrieval of form metadata']
  policy_id varchar [note: 'Reference to the parent policy for which this declarations page was issued.']
  policy_insured_id varchar [note: 'Reference to the party entity representing the named insured.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Declaration pages are generated for specific policy transactions (NB, ENDT, REN, CANC).']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Declarations page represents a specific policy version snapshot. Currently uses policy_version_number (INT) for loose coupling.']
  company_name varchar [note: 'Legal name of the insurance company issuing this policy, as shown on the declarations page.']
  coverage_summary_text varchar [note: 'High-level textual summary of coverages included in this policy, as displayed on the declarations page.']
  created_timestamp timestamp [note: 'Timestamp when this declarations page record was first created in the system.']
  dec_page_number varchar [note: 'Unique document control number assigned to this declarations page.']
  dec_page_status varchar [note: 'Current lifecycle status of the declarations page document.']
  document_generated_timestamp timestamp [note: 'Timestamp when the declarations page document was generated.']
  document_url varchar [note: 'URL or file path to the generated declarations page document in the content management system.']
  effective_date date [note: 'Date on which the policy coverage described in this declarations page becomes effective.']
  endorsement_numbers varchar [note: 'Comma-separated list of endorsement numbers that modify the base policy.']
  expiration_date date [note: 'Date on which the policy coverage described in this declarations page expires.']
  fee_amount decimal(18,2) [note: 'Total fees included in the premium, such as policy fees or stamping fees.']
  form_numbers varchar [note: 'Comma-separated list of ISO or proprietary form numbers attached to this policy.']
  gwp_amount decimal(18,2) [note: 'Total gross written premium for the policy term before any reinsurance cessions.']
  issue_date date [note: 'Date on which the declarations page was formally issued to the insured.']
  lob_code varchar [note: 'Code identifying the primary line of business for this policy.']
  lob_description varchar [note: 'Full description of the line of business.']
  mailing_address_line1 varchar [note: 'First line of the insured mailing address as shown on the declarations page.']
  mailing_address_line2 varchar [note: 'Second line of the insured mailing address, typically suite or unit number.']
  mailing_city varchar [note: 'City of the insured mailing address.']
  mailing_postal_code varchar [note: 'ZIP or postal code for the insured mailing address.']
  naic_company_code varchar [note: 'Five-digit NAIC code identifying the insurance company issuing this policy.']
  named_insured varchar [note: 'Full legal name of the primary insured party as it appears on the declarations page.']
  policy_type_code varchar [note: 'Code indicating the transaction type: New Business, Renewal, Endorsement, Cancellation, or Reinstatement.']
  producer_code varchar [note: 'Alphanumeric code assigned to the producer for commission and reporting purposes.']
  producer_name varchar [note: 'Name of the agent or broker who produced this policy, as shown on the declarations page.']
  regulatory_state_code varchar [note: 'Two-letter state code of the jurisdiction governing this policy.']
  source_system_code varchar [note: 'Code identifying the source system that generated this declarations page record.']
  tax_amount decimal(18,2) [note: 'Total tax amount included in the premium, such as state premium tax or surplus lines tax.']
  total_insured_value_amount decimal(18,2) [note: 'Total insured value representing the sum of all insured property and liability limits.']
  total_premium_amount decimal(18,2) [note: 'Total premium amount due for the policy term, including all taxes and fees.']
  underwriter_name varchar [note: 'Name of the underwriter who approved this policy.']
  updated_timestamp timestamp [note: 'Timestamp when this declarations page record was last updated.']

  Note: 'DEC page record for a policy version: summarizes insured name, policy number, LOB, coverage summary, TIV, total premium, and effective/expiration dates. Represents the formal policy document snapshot issued to the insured.'
}

Table policy.uw_decision {
  uw_decision_id varchar [pk, note: 'Unique identifier for the underwriting decision record.']
  policy_id varchar [note: 'Reference to the policy submission or renewal being underwritten.']
  quote_id varchar [note: 'Reference to the quote associated with this underwriting decision.']
  submission_id varchar [note: 'Foreign key linking to policy.submission. Business justification: Underwriting decisions evaluate submissions (accept, decline, refer). uw_decision already links to quote and policy, but should also link to submission to establish the full pre-bind']
  adverse_action_notice_date date [note: 'The date when the adverse action notice was sent to the applicant.']
  adverse_action_notice_sent_flag boolean [note: 'Indicates whether an adverse action notice was sent to the applicant following a decline or unfavorable decision.']
  approval_date date [note: 'The date when the underwriting decision was approved by the required authority.']
  approval_required_flag boolean [note: 'Indicates whether additional approval is required before the underwriting decision can be finalized.']
  approved_by_underwriter_code varchar [note: 'Reference to the senior underwriter or authority who approved the decision.']
  authority_level varchar [note: 'The level of underwriting authority exercised for this decision, indicating approval hierarchy.']
  automated_decision_flag boolean [note: 'Indicates whether the underwriting decision was made by an automated underwriting system or by a human underwriter.']
  business_type varchar [note: 'Type of business transaction: new business, renewal, endorsement, or reinstatement.']
  conditions_imposed varchar [note: 'Description of any conditions or requirements imposed as part of the underwriting decision, such as risk mitigation measures.']
  created_timestamp timestamp [note: 'Timestamp when the underwriting decision record was first created in the system.']
  decision_action varchar [note: 'The underwriting action taken: accept, decline, refer to senior underwriter, modify terms, counter offer, or conditional acceptance.']
  decision_date date [note: 'The date when the underwriting decision was made.']
  decision_model_name varchar [note: 'Name of the automated underwriting model or rules engine used to generate the decision.']
  decision_model_version varchar [note: 'Version of the automated underwriting model or rules engine used.']
  decision_number varchar [note: 'Business identifier for the underwriting decision, externally visible and used for tracking and reference.']
  decision_status varchar [note: 'Current lifecycle status of the underwriting decision in the workflow.']
  decision_timestamp timestamp [note: 'Precise date and time when the underwriting decision was finalized.']
  declination_reason varchar [note: 'Detailed reason for declining the submission, required for regulatory compliance and adverse action notices.']
  deductible_adjustment decimal(15,2) [note: 'Adjustment to the policy deductible amount imposed by the underwriting decision.']
  effective_date date [note: 'The date from which the underwriting decision becomes effective for the policy.']
  exclusions_applied varchar [note: 'Description of any exclusions applied to the policy coverage as a result of the underwriting decision.']
  expiration_date date [note: 'The date when the underwriting decision expires and must be re-evaluated.']
  limit_adjustment decimal(15,2) [note: 'Adjustment to the policy coverage limit imposed by the underwriting decision.']
  lob varchar [note: 'The line of business for which the underwriting decision applies, such as commercial general liability or personal auto.']
  notes varchar [note: 'Additional notes or comments recorded by the underwriter regarding the decision.']
  override_flag boolean [note: 'Indicates whether the underwriter manually overrode an automated decision or guideline recommendation.']
  override_reason varchar [note: 'Explanation for why the underwriter overrode the automated decision or guideline recommendation.']
  premium_adjustment_amount decimal(15,2) [note: 'Dollar amount of premium adjustment resulting from the underwriting decision.']
  premium_adjustment_pct decimal(5,2) [note: 'Percentage adjustment to the base premium resulting from the underwriting decision, positive for surcharges and negative for credits.']
  primary_reason_code varchar [note: 'Primary reason code explaining the underwriting decision, aligned with regulatory and internal classification standards.']
  reason_description varchar [note: 'Detailed narrative explanation of the underwriting decision rationale and any specific conditions or concerns.']
  referral_reason varchar [note: 'Reason for referring the submission to a higher authority level or specialist underwriter.']
  referred_to_underwriter_code varchar [note: 'Reference to the underwriter to whom the submission was referred for further review.']
  risk_score decimal(10,2) [note: 'Numerical risk score calculated during underwriting evaluation, used to quantify exposure level.']
  risk_tier varchar [note: 'The risk classification tier assigned to the submission based on underwriting assessment.']
  secondary_reason_code varchar [note: 'Secondary reason code providing additional context for the underwriting decision.']
  sir_adjustment decimal(15,2) [note: 'Adjustment to the self-insured retention amount imposed by the underwriting decision.']
  underwriter_code varchar [note: 'Reference to the underwriter who made the decision.']
  underwriting_guidelines_version varchar [note: 'Version of the underwriting guidelines applied when making this decision, for audit and compliance tracking.']
  updated_timestamp timestamp [note: 'Timestamp when the underwriting decision record was last modified.']

  Note: 'Underwriting decision record for a policy submission or renewal: UW action (accept, decline, refer, modify), decision date, UW authority level, reason codes, and any conditions or exclusions imposed.'
}

Table policy.quote {
  quote_id varchar [pk, note: 'Unique system identifier for the quote record. Primary key.']
  agency_id varchar [note: 'Reference to the agency organization through which this quote was submitted.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Quote amounts (quoted_gwp, quoted_taxes_fees, quoted_total_premium) are denominated in a currency. FK to shared.currency supports multi-currency quoting and conversion.']
  parent_quote_id varchar [note: 'Reference to the original quote if this is a revised version, enabling quote lineage tracking.']
  policy_id varchar [note: 'Reference to the policy if this quote was bound and converted to an active policy.']
  policy_insured_id varchar [note: 'Reference to the primary named insured party for this quote.']
  producers_producer_id varchar [note: 'Reference to the agent or broker who originated this quote and will earn commission if bound.']
  rating_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Rating state determines which rate filing and underwriting rules apply to the quote. FK to shared.state enables state-specific rating algorithm selection and surplus lines eligibility.']
  binder_effective_date date [note: 'Actual effective date of temporary binder coverage if binding authority was exercised.']
  binder_expiration_date date [note: 'Expiration date of temporary binder, typically 30-90 days pending formal policy issuance.']
  binder_number varchar [note: 'Temporary binder identifier issued when binding authority is exercised prior to formal policy issuance.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has binding authority to convert this quote to a binder without underwriter approval.']
  binding_authority_limit decimal(15,2) [note: 'Maximum premium amount the producer is authorized to bind without underwriter review.']
  bound_timestamp timestamp [note: 'Timestamp when the quote was bound and converted to active coverage or binder.']
  clue_report_ordered_flag boolean [note: 'Indicates whether a CLUE loss history report was ordered during the quoting process.']
  created_by_user_code varchar [note: 'System user identifier of the person who created this quote record.']
  created_timestamp timestamp [note: 'System timestamp when the quote record was first created in the policy administration system.']
  credit_score varchar [note: 'Insurance credit score used for rating in jurisdictions where permitted, typically 300-850 range.']
  decline_reason_code varchar [note: 'Standardized code indicating the primary reason for quote declination by underwriting.']
  decline_reason_description varchar [note: 'Detailed explanation of why the quote was declined, provided to the agent and insured per regulatory requirements.']
  declined_timestamp timestamp [note: 'Timestamp when the quote was declined by underwriting or rejected by the customer.']
  effective_date date [note: 'Proposed effective date when coverage would begin if the quote is bound.']
  expiration_date date [note: 'Proposed expiration date when coverage would end, typically one year from effective date for annual policies.']
  last_modified_by_user_code varchar [note: 'System user identifier of the person who last modified this quote record.']
  last_modified_timestamp timestamp [note: 'System timestamp of the most recent modification to this quote record.']
  lob varchar [note: 'Insurance line of business category for this quote, determining product rules, rating, and underwriting guidelines. [ENUM-REF-CANDIDATE: personal_auto|homeowners|commercial_auto|general_liability|workers_comp|bop|cpp|umbrella — 8 candidates stripped']
  mvr_ordered_flag boolean [note: 'Indicates whether motor vehicle reports were ordered for drivers on auto quotes.']
  number varchar [note: 'Externally visible business identifier for the quote, used in customer communications and agent references.']
  pml decimal(18,2) [note: 'Estimated probable maximum loss for catastrophe modeling and reinsurance placement purposes.']
  presented_timestamp timestamp [note: 'Timestamp when the quote was formally presented to the customer or agent.']
  prior_carrier_name varchar [note: 'Name of the insurance carrier providing coverage immediately prior to this quote, used for continuity verification.']
  prior_policy_number varchar [note: 'Policy number from the prior carrier, used for loss history and CLUE report verification.']
  product_code varchar [note: 'Specific insurance product identifier within the line of business, linking to filed rates and forms.']
  quote_status varchar [note: 'Current lifecycle status of the quote indicating its progression through the underwriting and binding workflow.']
  quote_type varchar [note: 'Classification indicating whether this is a new business quote, renewal quote, rewrite, or endorsement quote.']
  quoted_gwp decimal(15,2) [note: 'Total gross written premium amount quoted before any reinsurance cessions or adjustments.']
  quoted_taxes_fees decimal(15,2) [note: 'Total taxes, surplus lines taxes, stamping fees, and regulatory assessments included in the quote.']
  quoted_total_premium decimal(15,2) [note: 'Total amount due from the insured including base premium, taxes, fees, and surcharges.']
  rating_state varchar [note: 'Two-letter state code determining which filed rates, forms, and regulatory rules apply to this quote.']
  surplus_lines_flag boolean [note: 'Indicates whether this quote is for surplus lines coverage placed outside the admitted market.']
  tiv decimal(18,2) [note: 'Total insured value representing the maximum potential exposure across all coverages in this quote.']
  underwriter_code varchar [note: 'Reference to the underwriter assigned to review and approve this quote.']
  uw_score decimal(5,2) [note: 'Numeric underwriting score from automated rating and risk assessment models, typically 0-100 scale.']
  uw_tier varchar [note: 'Risk tier assigned during underwriting indicating the quality and pricing level of the quoted risk.']
  valid_until_date date [note: 'Date until which the quoted premium and terms remain valid for binding, typically 30-60 days from quote date.']
  version_number varchar [note: 'Version number tracking iterations and revisions of the quote as coverage options or pricing are adjusted.']
  years_with_prior_carrier varchar [note: 'Number of continuous years the insured maintained coverage with the prior carrier, used for loyalty discounts.']

  Note: 'Pre-bind quote and temporary binder: rated premium, coverage options, TIV, quote and binder effective/expiration dates, binding authority, binder number, and status (draft, presented, bound, declined).'
}

Table policy.submission {
  submission_id varchar [pk, note: 'Unique identifier for the underwriting submission record.']
  agency_id varchar [note: 'Identifier of the agency through which the submission was received.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Submission TIV and requested premium are denominated in a currency. FK to shared.currency supports multi-currency submission intake and conversion to home currency.']
  policy_id varchar [note: 'Identifier of the policy issued from this submission, if the submission was bound.']
  producers_producer_id varchar [note: 'Identifier of the agent or broker who submitted the application.']
  quote_id varchar [note: 'Identifier of the quote generated from this submission, if the submission progressed to the quoted stage.']
  risk_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Submission risk state drives underwriting appetite, rate filing applicability, and producer licensing validation.']
  applicant_email varchar [note: 'Primary email address for the applicant.']
  applicant_name varchar [note: 'Full legal name of the individual or organization applying for coverage.']
  applicant_phone varchar [note: 'Primary contact phone number for the applicant.']
  applicant_type varchar [note: 'Legal entity type of the applicant.']
  business_type varchar [note: 'Classification indicating whether the submission is for new business, renewal, or rewrite.']
  clue_report_ordered boolean [note: 'Indicates whether a CLUE report was ordered to retrieve loss history for the applicant.']
  created_by_user varchar [note: 'Username or identifier of the user who created the submission record.']
  created_timestamp timestamp [note: 'Date and time when the submission record was first created in the system.']
  credit_score varchar [note: 'Credit-based insurance score used for underwriting and rating purposes.']
  declined_reason varchar [note: 'Explanation or code indicating why the submission was declined, if applicable.']
  effective_date date [note: 'Requested policy effective date for coverage to begin if the submission is bound.']
  expiration_date date [note: 'Requested policy expiration date for coverage to end if the submission is bound.']
  lob varchar [note: 'Primary line of business for the submission, indicating the type of coverage requested. [ENUM-REF-CANDIDATE: personal_auto|homeowners|commercial_auto|general_liability|workers_comp|bop|umbrella — 7 candidates stripped; promote to reference product]']
  loss_history_years varchar [note: 'Number of years of loss history provided or requested for underwriting evaluation.']
  mvr_ordered boolean [note: 'Indicates whether a motor vehicle report was ordered for the applicant or drivers.']
  naics_code varchar [note: 'Six-digit NAICS code classifying the applicant\'s business industry for commercial submissions.']
  notes varchar [note: 'Free-text notes or comments recorded by underwriters or agents regarding the submission.']
  number varchar [note: 'Externally-known business identifier for the submission, typically system-generated or agent-provided reference number.']
  prior_carrier_name varchar [note: 'Name of the insurance carrier that previously provided coverage to the applicant, if applicable.']
  prior_policy_number varchar [note: 'Policy number from the prior carrier, used for underwriting evaluation and loss history retrieval.']
  requested_premium decimal(15,2) [note: 'Estimated or requested premium amount for the coverage being applied for.']
  risk_address_line1 varchar [note: 'Primary street address of the risk location being insured.']
  risk_address_line2 varchar [note: 'Secondary address information for the risk location, such as suite or unit number.']
  risk_city varchar [note: 'City where the risk location is situated.']
  risk_country varchar [note: 'Three-letter ISO country code for the risk location.']
  risk_postal_code varchar [note: 'ZIP or postal code for the risk location.']
  sic_code varchar [note: 'Four-digit SIC code classifying the applicant\'s business industry for commercial submissions.']
  source_channel varchar [note: 'Distribution channel through which the submission was received.']
  submission_date date [note: 'Date the submission was received or entered into the system.']
  submission_status varchar [note: 'Current lifecycle state of the submission in the underwriting workflow. [ENUM-REF-CANDIDATE: new|in_review|quoted|bound|declined|withdrawn|expired — 7 candidates stripped; promote to reference product]']
  timestamp timestamp [note: 'Precise date and time the submission was received or created.']
  tiv decimal(18,2) [note: 'Total insured value representing the sum of all property values and limits requested in the submission.']
  underwriter_code varchar [note: 'Identifier of the underwriter assigned to review and evaluate the submission.']
  updated_by_user varchar [note: 'Username or identifier of the user who last updated the submission record.']
  updated_timestamp timestamp [note: 'Date and time when the submission record was last modified.']

  Note: 'Underwriting submission record representing an application for coverage: submission date, source channel, LOB, applicant details, risk information, and submission status (new, in-review, quoted, bound, declined).'
}

Table policy.policy_producer {
  policy_producer_id varchar [pk, note: 'Unique identifier for the policy-producer relationship record.']
  agency_id varchar [note: 'Foreign key reference to the agency under which this producer is writing or servicing the policy.']
  policy_id varchar [note: 'Foreign key reference to the policy being serviced or written by the producer.']
  producers_producer_id varchar [note: 'Foreign key reference to the producer (agent or broker) associated with this policy.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Producer assignments can change via endorsements (producer of record changes, commission splits adjusted).']
  appointment_effective_date date [note: 'Date when the producer\'s appointment to write or service this policy became effective.']
  appointment_expiration_date date [note: 'Date when the producer\'s appointment to write or service this policy expires or was terminated.']
  assignment_date date [note: 'Date when the producer was assigned to this policy, which may differ from appointment effective date for servicing transfers.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has binding authority to issue this policy without prior underwriting approval.']
  commission_basis_code varchar [note: 'Basis on which commission is calculated: Gross Written Premium (GWP), Net Written Premium (NWP), Earned Premium (EP), or flat fee.']
  commission_holdback_percentage decimal(5,2) [note: 'Percentage of commission withheld by the insurer for this policy-producer relationship, typically for quality or performance reasons.']
  commission_payment_method_code varchar [note: 'Method by which commission is paid to the producer for this policy: ACH transfer, check, wire, or offset against debit balance.']
  commission_plan_code varchar [note: 'Code identifying the commission plan or schedule applicable to this producer for this policy.']
  commission_split_percentage decimal(5,2) [note: 'Percentage of total commission allocated to this producer on the policy, expressed as a decimal (e.g., 75.00 for 75%).']
  commission_statement_frequency_code varchar [note: 'Frequency at which commission statements are generated for this producer-policy relationship.']
  contact_email varchar [note: 'Primary email address of the producer for policy-related communication and commission statements.']
  contact_phone varchar [note: 'Primary phone number of the producer for policy servicing and customer inquiries.']
  contingent_commission_eligible_flag boolean [note: 'Indicates whether this policy-producer relationship is eligible for contingent or bonus commission based on performance metrics.']
  created_by_user_code varchar [note: 'User ID of the system user or process that created this policy-producer relationship record.']
  created_timestamp timestamp [note: 'Timestamp when this policy-producer relationship record was first created in the system.']
  effective_timestamp timestamp [note: 'Timestamp when this policy-producer relationship record became effective in the system.']
  expiration_timestamp timestamp [note: 'Timestamp when this policy-producer relationship record expired or was superseded by a new record.']
  license_number varchar [note: 'State-issued license number of the producer valid at the time of policy association, for regulatory compliance tracking.']
  license_state_code varchar [note: 'Two-letter state code where the producer holds the license applicable to this policy.']
  lob_code varchar [note: 'Line of business code for which the producer is appointed on this policy (e.g., Personal Auto, Commercial Property).']
  modified_by_user_code varchar [note: 'User ID of the system user or process that last modified this policy-producer relationship record.']
  modified_timestamp timestamp [note: 'Timestamp when this policy-producer relationship record was last modified in the system.']
  naic_producer_code varchar [note: 'NAIC-assigned producer code for regulatory reporting and cross-state producer identification.']
  notes varchar [note: 'Free-text notes or comments regarding this policy-producer relationship, such as special arrangements or servicing instructions.']
  override_commission_rate decimal(5,2) [note: 'Override commission rate percentage applied to this specific policy-producer relationship, if different from standard plan.']
  policy_transaction_type_code varchar [note: 'Type of policy transaction that established or modified this producer relationship: New Business (NB), Renewal (REN), Endorsement (ENDT), Cancellation (CANC), Reinstatement.']
  primary_producer_flag boolean [note: 'Indicates whether this producer is the primary or lead producer for the policy (true) or a secondary/split producer (false).']
  producer_code varchar [note: 'Unique alphanumeric code assigned to the producer by the insurer for identification and commission tracking.']
  record_version_number varchar [note: 'Version number of this policy-producer relationship record, incremented with each modification for audit trail purposes.']
  relationship_status varchar [note: 'Current status of the producer-policy relationship indicating whether the producer is actively servicing or earning commission.']
  role_code varchar [note: 'Role of the producer on this policy: writing agent, servicing agent, referring agent, or split commission arrangement.']
  servicing_office_code varchar [note: 'Code identifying the producer\'s office or branch location responsible for servicing this policy.']
  source_system_code varchar [note: 'Code identifying the source system from which this policy-producer relationship record originated.']
  sub_producer_code varchar [note: 'Code identifying a sub-producer or sub-agent under the primary producer for hierarchical commission tracking.']
  tax_identification_number varchar [note: 'Federal Employer Identification Number (FEIN) or Social Security Number (SSN) of the producer for tax reporting (1099 generation).']
  termination_date date [note: 'Date when the producer\'s relationship with this policy was terminated or transferred to another producer.']
  termination_reason_code varchar [note: 'Reason code explaining why the producer-policy relationship was terminated or changed.']
  territory_code varchar [note: 'Geographic territory code assigned to the producer for this policy, used for commission and performance tracking.']
  tier_code varchar [note: 'Tier or performance level of the producer at the time of policy association, affecting commission rates and incentives.']

  Note: 'Junction table linking a policy to the writing producer (agent/broker) and servicing producer. Captures producer role, commission split percentage, appointment effective date, and producer code.'
}

Table policy.status_history {
  status_history_id varchar [pk, note: 'Unique identifier for the policy status history record.']
  policy_id varchar [note: 'Reference to the policy that experienced the status transition.']
  policy_transaction_id varchar [note: 'Reference to the specific policy transaction that initiated this status change.']
  reversed_by_status_history_id varchar [note: 'Reference to the subsequent status history record that reversed this transition.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Status transitions correspond to policy versions (each transaction creates a version and may trigger a status change).']
  approval_required_flag boolean [note: 'Indicates whether the status transition required managerial or underwriting approval.']
  approval_timestamp timestamp [note: 'Date and time when the status transition was approved.']
  approved_by_user_code varchar [note: 'System user identifier of the approver, if approval was required.']
  approved_by_user_name varchar [note: 'Full name of the user who approved the status transition.']
  cancellation_notice_date date [note: 'Date when cancellation notice was issued to the insured, if applicable.']
  cancellation_type varchar [note: 'Specific type of cancellation when the transition involves policy cancellation. [ENUM-REF-CANDIDATE: flat|short_rate|pro_rata|insured_request|non_payment|underwriting|fraud — 7 candidates stripped; promote to reference product]']
  comments varchar [note: 'Free-form comments or notes regarding the status transition.']
  created_timestamp timestamp [note: 'Date and time when this status history record was first created in the system.']
  effective_date date [note: 'The date on which the new status became effective for the policy.']
  initiated_by_party_type varchar [note: 'The type of party that initiated the status transition.']
  initiated_by_user_code varchar [note: 'System user identifier of the person who initiated the status change.']
  initiated_by_user_name varchar [note: 'Full name of the user who initiated the status transition.']
  last_modified_timestamp timestamp [note: 'Date and time when this status history record was last updated.']
  lob varchar [note: 'The line of business of the policy at the time of status transition.']
  new_status varchar [note: 'The status of the policy after this transition was applied. [ENUM-REF-CANDIDATE: active|cancelled|lapsed|expired|reinstated|non_renewed|pending|suspended|bound|quoted — 10 candidates stripped; promote to reference product]']
  non_renewal_reason varchar [note: 'Explanation for why the policy was not renewed at expiration.']
  notification_method varchar [note: 'The method used to notify the insured of the status transition.']
  notification_sent_flag boolean [note: 'Indicates whether a notification was sent to the insured regarding the status change.']
  notification_sent_timestamp timestamp [note: 'Date and time when notification was sent to the insured.']
  premium_impact_amount decimal(18,2) [note: 'The financial impact on premium resulting from this status transition.']
  prior_status varchar [note: 'The status of the policy immediately before this transition occurred. [ENUM-REF-CANDIDATE: active|cancelled|lapsed|expired|reinstated|non_renewed|pending|suspended|bound|quoted — 10 candidates stripped; promote to reference product]']
  regulatory_filing_date date [note: 'Date when the status transition was filed with the regulatory authority.']
  regulatory_filing_required_flag boolean [note: 'Indicates whether this status transition requires regulatory reporting or filing.']
  reinstatement_date date [note: 'Date when a lapsed or cancelled policy was reinstated, if applicable.']
  reversal_flag boolean [note: 'Indicates whether this status transition was later reversed or corrected.']
  state_code varchar [note: 'Two-letter state code where the policy is domiciled for regulatory purposes.']
  system_source varchar [note: 'The source system that recorded this status transition event.']
  transition_reason_code varchar [note: 'Standardized code indicating the reason for the status change.']
  transition_reason_description varchar [note: 'Detailed explanation of why the policy status transition occurred.']
  transition_timestamp timestamp [note: 'The exact date and time when the policy status transition occurred.']
  triggering_transaction_type varchar [note: 'The type of policy transaction that caused this status transition. [ENUM-REF-CANDIDATE: new_business|renewal|endorsement|cancellation|reinstatement|non_renewal|lapse|expiration — 8 candidates stripped; promote to reference product]']
  unearned_premium_returned_amount decimal(18,2) [note: 'Amount of unearned premium returned to insured due to cancellation or status change.']

  Note: 'Audit trail of all policy status transitions (active, cancelled, lapsed, expired, reinstated, non-renewed). Records prior status, new status, transition timestamp, and the triggering transaction reference.'
}

Table policy.policy_form {
  policy_form_id varchar [pk, note: 'Unique identifier for the policy form record.']
  superseded_by_form_policy_form_id varchar [note: 'Reference to the newer policy form that replaces this form, establishing form version lineage.']
  approval_date date [note: 'The date the form received regulatory approval from the state insurance department, allowing it to be used in policies.']
  coverage_category varchar [note: 'The broad coverage category this form provides or modifies, such as liability, property damage, bodily injury, medical payments, or uninsured motorist.']
  created_timestamp timestamp [note: 'The date and time when this policy form record was first created in the system.']
  document_reference varchar [note: 'Reference identifier or URI to the stored PDF or document image of the official form in the document management system.']
  edition_date date [note: 'The official edition or publication date of the form version, indicating when this form version was released by ISO or the carrier.']
  effective_date date [note: 'The date from which this form version becomes effective and can be bound on new or renewing policies.']
  expiration_date date [note: 'The date after which this form version is no longer available for new business, typically when superseded by a newer edition.']
  filing_date date [note: 'The date the form was filed with the state insurance department for regulatory approval.']
  filing_status varchar [note: 'Current regulatory filing status indicating whether the form is approved for use, pending state approval, withdrawn, rejected, or superseded by a newer version.']
  form_description varchar [note: 'Detailed description of the coverage, exclusions, or modifications provided by this form, including key terms and conditions.']
  form_name varchar [note: 'The descriptive name of the policy form, such as Commercial General Liability Coverage Form or Homeowners Policy Special Form.']
  form_number varchar [note: 'The official form number assigned by ISO or carrier, such as CG 00 01 or HO 00 03, uniquely identifying the policy form document.']
  form_type varchar [note: 'Classification of the form indicating its purpose: base coverage form, endorsement modifying coverage, exclusion limiting coverage, schedule, condition, or declaration page.']
  iso_source_flag boolean [note: 'Indicates whether this form originates from ISO standard forms or is a proprietary carrier-developed form.']
  language varchar [note: 'The full legal text and language of the policy form as filed with regulators, stored as a text field or reference to document storage.']
  lob varchar [note: 'The insurance line of business this form applies to, such as General Liability, Commercial Package Policy, Workers Compensation, or Auto. [ENUM-REF-CANDIDATE: GL|CGL|CPP|BOP|WC|CAT|auto|property|umbrella|professional_liability|inland_marine — 11']
  mandatory_flag boolean [note: 'Indicates whether this form is mandatory for the line of business or optional based on underwriting rules or state requirements.']
  naic_code varchar [note: 'The five-digit NAIC company code of the carrier that filed or uses this form, linking the form to the insurer.']
  policy_form_status varchar [note: 'Current lifecycle status of the form in the system: active and available for use, inactive but retained, archived for historical reference, or draft pending finalization.']
  premium_bearing_flag boolean [note: 'Indicates whether this form carries an additional premium charge or is included at no extra cost.']
  updated_timestamp timestamp [note: 'The date and time when this policy form record was last modified in the system.']
  usage_count varchar [note: 'The number of active policies currently using this form, providing insight into form adoption and usage trends.']

  Note: 'Reference catalog of policy forms and ISO form numbers used across LOBs: form number, edition date, form type (base, endorsement, exclusion), applicable states, and regulatory filing status.'
}

Table policy.condition {
  condition_id varchar [pk, note: 'Unique identifier for the policy condition record. Primary key.']
  assigned_to_party_id varchar [note: 'Reference to the party responsible for satisfying the condition, typically the insured or producer.']
  policy_form_id varchar [note: 'Foreign key linking to policy.policy_form. Business justification: Policy conditions reference specific forms via form_number and form_edition_date. Adding policy_form_id FK normalizes this relationship and removes redundant form identification.']
  policy_id varchar [note: 'Reference to the parent policy to which this condition is attached.']
  regulatory_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Policy conditions may be state-mandated (e.g., California earthquake disclosure). FK to shared.state enables state-specific condition library and compliance tracking.']
  uw_decision_id varchar [note: 'Foreign key linking to policy.uw_decision. Business justification: Policy conditions are often imposed by underwriting decisions (special requirements, warranties, exclusions). Adding uw_decision_id FK establishes which UW decision mandated the condition.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Policy conditions are attached to specific policy versions (added via endorsements, removed via subsequent transactions). Currently uses policy_version_number (INT).']
  cancellation_reason_code varchar [note: 'Code indicating the reason the condition was cancelled or removed from the policy.']
  compliance_due_date date [note: 'Date by which the insured must satisfy or comply with the condition. Critical for underwriting and risk management tracking.']
  compliance_flag boolean [note: 'Indicator of whether the condition has been satisfied or is in compliance. True if satisfied, false if outstanding.']
  condition_category varchar [note: 'Timing category indicating when the condition applies: pre-bind, post-bind, ongoing during policy term, or at renewal.']
  condition_description varchar [note: 'Detailed narrative description of the condition, including specific requirements, actions, or restrictions imposed on the insured or policy.']
  condition_number varchar [note: 'Business identifier for the condition, unique within the policy context. Used for external reference and communication.']
  condition_status varchar [note: 'Current lifecycle status of the condition: pending, satisfied, outstanding, waived, expired, or cancelled.']
  coverage_impact_flag boolean [note: 'Indicator of whether non-compliance with this condition affects coverage. True if coverage may be denied or restricted for non-compliance.']
  created_by_user_code varchar [note: 'User identifier of the person who created this condition record.']
  created_timestamp timestamp [note: 'Timestamp when this condition record was first created in the system.']
  effective_date date [note: 'Date when the condition becomes effective and binding on the policy.']
  expiration_date date [note: 'Date when the condition expires or is no longer applicable. Null for conditions that remain in force for the policy term.']
  last_modified_by_user_code varchar [note: 'User identifier of the person who last modified this condition record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this condition record was last updated.']
  lob_code varchar [note: 'Line of business code to which this condition applies, supporting multi-line policy condition management.']
  mandatory_flag boolean [note: 'Indicator of whether the condition is mandatory for policy binding or renewal. True if mandatory, false if optional or informational.']
  notes varchar [note: 'Free-text notes or comments related to the condition, including underwriter rationale, insured responses, or follow-up actions.']
  premium_impact_flag boolean [note: 'Indicator of whether satisfaction or non-compliance with this condition affects premium calculation or rating.']
  regulatory_requirement_flag boolean [note: 'Indicator of whether this condition is imposed to satisfy a regulatory or statutory requirement. True if regulatory-driven.']
  satisfied_date date [note: 'Date when the condition was marked as satisfied or fulfilled by the insured.']
  source_document_reference varchar [note: 'Reference number or identifier of the source document that triggered this condition.']
  source_document_type varchar [note: 'Type of document or source that triggered or justified the imposition of this condition.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this condition originated.']
  source_system_record_code varchar [note: 'Unique identifier of this condition in the source operational system, supporting data lineage and reconciliation.']
  text varchar [note: 'Full legal or contractual text of the condition as it appears on the policy declarations page or endorsement.']
  title varchar [note: 'Short descriptive title of the condition for quick identification and reporting purposes.']
  type_code varchar [note: 'Classification of the condition: warranty, special condition, underwriting requirement, compliance requirement, risk improvement, or inspection.']
  underwriter_code varchar [note: 'Reference to the underwriter who imposed or approved this condition.']
  waived_date date [note: 'Date when the condition was waived by the underwriter or authorized party.']
  waiver_approved_by_code varchar [note: 'Reference to the underwriter or manager who approved the waiver of this condition.']
  waiver_reason_code varchar [note: 'Code indicating the reason the condition was waived, if applicable.']

  Note: 'Records special conditions, warranties, and UW requirements attached to a policy version: condition type, description, compliance due date, and whether the condition has been satisfied or is outstanding.'
}

Table policy.document {
  document_id varchar [pk, note: 'Unique identifier for the policy document record. Primary key.']
  document_template_id varchar [note: 'Identifier of the document template used to generate this document instance.']
  policy_form_id varchar [note: 'Foreign key linking to policy.policy_form. Business justification: Document references a specific policy form via form_number and form_edition_date. Adding policy_form_id FK normalizes this relationship and removes redundant form identification columns.']
  policy_id varchar [note: 'Reference to the policy for which this document was generated.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Policy documents (DEC pages, endorsements, cancellation notices, binders, COIs) are generated for specific policy transactions.']
  producers_producer_id varchar [note: 'Reference to the producer or agent associated with the policy for which this document was generated.']
  recipient_country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Document recipient country supports international policy servicing and cross-border delivery. FK to shared.country enforces valid country codes and enables international mailing rules.']
  recipient_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Document recipient state determines delivery method compliance and notice period requirements. FK to shared.state enables state-specific document delivery rules.']
  underwriter_id varchar [note: 'Reference to the underwriter who approved or reviewed the document issuance.']
  user_account_id varchar [note: 'User identifier of the person or system account that initiated document generation.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Documents are generated for specific policy transactions/versions (DEC pages, endorsements, cancellation notices).']
  approval_date date [note: 'Date when the document was approved for issuance by an authorized user.']
  approved_by_user_code varchar [note: 'User identifier of the person who approved the document for issuance or delivery.']
  certificate_holder_address varchar [note: 'Full mailing address of the certificate holder for COI documents.']
  certificate_holder_name varchar [note: 'Name of the certificate holder for Certificate of Insurance (COI) documents.']
  cms_reference_code varchar [note: 'Reference identifier linking this document record to the stored file in the CMS (OpenText or FileNet).']
  cms_url varchar [note: 'Direct URL or path to retrieve the document file from the content management system.']
  delivery_date date [note: 'Date when the document was delivered or sent to the recipient.']
  delivery_method varchar [note: 'Method by which the document was or will be delivered to the policyholder or recipient.']
  delivery_status varchar [note: 'Status of the document delivery process indicating whether delivery was successful.']
  document_description varchar [note: 'Detailed description of the document content, purpose, or scope for business context.']
  document_status varchar [note: 'Current lifecycle status of the document in the document management workflow.']
  effective_date date [note: 'Date when the document becomes effective or binding for the policy or endorsement.']
  expiration_date date [note: 'Date when the document expires or is no longer valid, typically aligned with policy term end.']
  file_format varchar [note: 'File format of the stored document (PDF, DOCX, HTML, XML, TXT).']
  file_size_bytes varchar [note: 'Size of the document file in bytes for storage and transmission tracking.']
  generation_date date [note: 'Date when the document was generated or created by the system or user.']
  generation_timestamp timestamp [note: 'Precise timestamp when the document was generated, including time zone information.']
  language_code varchar [note: 'Two-letter ISO language code indicating the language in which the document was generated.']
  lob_code varchar [note: 'Line of business code (e.g., GL, WC, BOP, CPP) associated with the policy document.']
  number varchar [note: 'Business-assigned unique document number or control identifier for tracking and reference.']
  page_count varchar [note: 'Total number of pages in the document for printing and archival purposes.']
  recipient_address_line1 varchar [note: 'First line of the recipient mailing address for postal document delivery.']
  recipient_address_line2 varchar [note: 'Second line of the recipient mailing address for additional address details.']
  recipient_city varchar [note: 'City name of the recipient mailing address.']
  recipient_email varchar [note: 'Email address of the recipient for electronic document delivery.']
  recipient_name varchar [note: 'Name of the individual or entity to whom the document was addressed or delivered.']
  recipient_postal_code varchar [note: 'Postal or ZIP code of the recipient mailing address.']
  regulatory_state_code varchar [note: 'Two-letter state code indicating the regulatory jurisdiction governing this document.']
  signature_date date [note: 'Date when the document was signed by the policyholder or authorized party.']
  signature_received_flag boolean [note: 'Indicates whether the required signature has been received and recorded.']
  signature_required_flag boolean [note: 'Indicates whether the document requires a signature from the policyholder or other party.']
  source_system_code varchar [note: 'Code identifying the source system that generated the document (e.g., PolicyCenter, Duck Creek Policy).']
  template_version varchar [note: 'Version number of the document template used for generation and audit trail.']
  title varchar [note: 'Human-readable title or name of the document for display and identification purposes.']
  type_code varchar [note: 'Type of policy document: DEC (Declarations Page), ENDT (Endorsement), CANC (Cancellation Notice), BINDER, COI (Certificate of Insurance), RENEWAL.']

  Note: 'Metadata registry for policy documents: DEC page instance, ENDT, CANC notice, binder, and COI. Stores document type, DEC snapshot fields, certificate-holder details, generation date, delivery method, and CMS reference.'
}

Table policy.binder {
  binder_id varchar [pk, note: 'Unique identifier for the temporary insurance binder record.']
  binder_producers_producer_id varchar [note: 'Reference to the agent or broker who issued the binder under binding authority.']
  binder_producers_producers_producer_id varchar [note: 'Reference to the underwriter who authorized or will review the binder for policy conversion.']
  binding_authority_id varchar [note: 'Reference to the binding authority agreement under which this binder was issued.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Binder estimated premium is denominated in a currency. FK to shared.currency supports multi-currency binding authority and premium conversion.']
  mailing_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Binder mailing state determines delivery compliance for binding authority documentation. FK to shared.state enables state-specific binder issuance rules.']
  policy_form_id varchar [note: 'Foreign key linking to policy.policy_form. Business justification: Binder references policy forms via form_numbers (denormalized STRING). Adding FK to primary policy_form enables proper form resolution.']
  policy_id varchar [note: 'Reference to the formal policy that will replace this binder upon issuance.']
  policy_insured_id varchar [note: 'Reference to the party entity representing the insured individual or organization.']
  policy_transaction_id varchar [note: 'Foreign key linking to policy.policy_transaction. Business justification: Binders are temporary insurance instruments that get converted to formal policies through a policy transaction. This FK tracks which transaction converted/formalized the binder.']
  quote_id varchar [note: 'Foreign key linking to policy.quote. Business justification: Binder is issued based on an accepted quote. Business flow: submission → quote → binder → policy. Tracking the originating quote provides critical lineage for the binder.']
  source_binder_id varchar [note: 'Original binder identifier from the source system before transformation to enterprise standard.']
  submission_id varchar [note: 'Foreign key linking to policy.submission. Business justification: Binder originates from a submission (the application for coverage). Business flow: submission → quote → binder → policy.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Binders represent a specific version of coverage terms and conditions. When a binder is issued, it should be associated with a policy version to track the exact terms, coverages, and premium']
  binder_status varchar [note: 'Current lifecycle status of the binder indicating whether it is active, converted to policy, or terminated.']
  binding_timestamp timestamp [note: 'Precise date and time when the binder was bound and coverage was confirmed by the producer.']
  cancellation_date date [note: 'Date when the binder was cancelled, voiding coverage before the scheduled expiration.']
  cancellation_reason_code varchar [note: 'Code indicating the reason if the binder was cancelled before conversion or expiration.']
  conversion_date date [note: 'Date when the binder was converted to a formal policy, marking the end of temporary coverage status.']
  coverage_summary varchar [note: 'Brief narrative description of the coverages, limits, and perils included in the temporary binder.']
  created_timestamp timestamp [note: 'Timestamp when this binder record was first created in the enterprise data platform.']
  declaration_page_url varchar [note: 'URL or document path to the binder declarations page stored in the document management system.']
  deductible_amount decimal(18,2) [note: 'Amount the insured must pay out-of-pocket before coverage under the binder applies.']
  effective_date date [note: 'Date when coverage under the temporary binder becomes effective and risk transfer begins.']
  endorsement_numbers varchar [note: 'Comma-separated list of endorsement form numbers modifying the standard binder coverage.']
  estimated_premium_amount decimal(18,2) [note: 'Preliminary premium amount charged for the temporary binder coverage period.']
  expiration_date date [note: 'Date when the temporary binder coverage expires and must be replaced by a formal policy or terminated.']
  form_numbers varchar [note: 'Comma-separated list of ISO or proprietary form numbers attached to the binder for coverage terms.']
  lob_code varchar [note: 'Code identifying the insurance line of business covered by this binder such as GL, WC, CPP, or BOP.']
  mailing_address_line1 varchar [note: 'Primary street address line for the insured party on the binder declarations.']
  mailing_address_line2 varchar [note: 'Secondary address line for suite, unit, or apartment number on the binder declarations.']
  mailing_city varchar [note: 'City name for the insured party mailing address on the binder.']
  mailing_postal_code varchar [note: 'ZIP or postal code for the insured party mailing address on the binder.']
  named_insured varchar [note: 'Full legal name of the primary insured party covered under this temporary binder.']
  notes varchar [note: 'Free-text notes or special instructions related to the binder issuance, coverage, or conversion requirements.']
  number varchar [note: 'Externally-known unique business identifier for the temporary binder document.']
  per_occurrence_limit_amount decimal(18,2) [note: 'Maximum amount payable for any single occurrence or claim event under the binder.']
  regulatory_state_code varchar [note: 'Two-letter code for the state Department of Insurance with jurisdiction over this binder.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this binder such as PolicyCenter or Duck Creek.']
  total_limit_amount decimal(18,2) [note: 'Aggregate limit of liability provided under the binder across all covered perils and exposures.']
  updated_timestamp timestamp [note: 'Timestamp when this binder record was last modified in the enterprise data platform.']

  Note: 'Temporary insurance binder record providing coverage confirmation prior to formal policy issuance. Captures binder number, effective date, expiration date, coverage summary, and binding authority used.'
}

Table policy.policy_rate_filing {
  policy_rate_filing_id varchar [pk, note: 'Unique identifier for the rate filing record. Primary key.']
  policy_form_id varchar [note: 'Foreign key linking to policy.policy_form. Business justification: Rate filings include policy forms (form_numbers_included is a denormalized STRING list). Adding FK to primary policy_form enables linking the filing to its primary form.']
  prior_filing_policy_rate_filing_id varchar [note: 'Reference to the previous rate filing that this submission replaces, supersedes, or amends, establishing filing lineage.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Rate filing state is the regulatory jurisdiction for rate approval. FK to shared.state enables state-specific filing workflow, deemer date calculation, and DOI contact lookup.']
  actuarial_justification_summary varchar [note: 'Brief summary of the actuarial analysis and loss experience supporting the rate change, including loss ratio trends and expense considerations.']
  affected_policy_count varchar [note: 'Number of in-force policies expected to be impacted by the rate filing at renewal or endorsement.']
  approval_date date [note: 'Date the state regulator officially approved the rate filing, allowing the insurer to implement the rates and forms.']
  company_code varchar [note: 'Internal or NAIC company code identifying the legal insurance entity submitting the rate filing.']
  created_timestamp timestamp [note: 'Timestamp when the rate filing record was first created in the system, supporting audit trail and data lineage requirements.']
  deemer_date date [note: 'Date on which the filing is deemed approved by operation of law if the regulator has not acted within the statutory review period.']
  effective_date date [note: 'Date on which the approved rates and forms become effective and may be used for new business and renewals.']
  expiration_date date [note: 'Date on which the filed rates and forms expire and are no longer valid for new business, if applicable.']
  filing_contact_email varchar [note: 'Email address of the filing contact for regulatory correspondence and questions regarding the rate filing.']
  filing_contact_name varchar [note: 'Name of the actuary or regulatory affairs professional responsible for this filing and serving as primary contact with the state regulator.']
  filing_contact_phone varchar [note: 'Phone number of the filing contact for regulatory inquiries and follow-up discussions regarding the rate filing.']
  filing_method varchar [note: 'Regulatory filing method required by the state indicating whether rates must be approved before use or may be implemented immediately.']
  filing_number varchar [note: 'External filing number assigned by the state Department of Insurance (DOI) or insurer for tracking and reference purposes.']
  filing_status varchar [note: 'Current regulatory approval status of the rate filing in the state review and approval workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|withdrawn|objected|deemer_approved — 8 candidates stripped; promote to reference product]']
  filing_type varchar [note: 'Category of the filing submission indicating whether it is a rate change, form update, rule modification, or combination thereof.']
  form_numbers_included varchar [note: 'Comma-separated list of policy form numbers and endorsement form numbers included in this filing for regulatory approval.']
  iso_program_edition_date date [note: 'Edition date of the ISO program being adopted or referenced in this filing, if applicable.']
  iso_program_indicator boolean [note: 'Flag indicating whether this filing adopts or references ISO standard forms and rates or represents a proprietary insurer program.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to the rate filing record, tracking changes throughout the regulatory review lifecycle.']
  lob_code varchar [note: 'Code identifying the insurance line of business covered by this filing such as personal auto, homeowners, commercial property, general liability, or workers compensation.']
  naic_company_code varchar [note: 'Five-digit NAIC company code uniquely identifying the insurance legal entity for regulatory reporting and filing purposes.']
  objection_reason varchar [note: 'Explanation provided by the state regulator for objecting to or rejecting the rate filing, including specific deficiencies or concerns.']
  overall_rate_change_percent decimal(5,2) [note: 'Percentage change in overall premium rates proposed in this filing, expressed as a signed decimal where positive indicates increase and negative indicates decrease.']
  projected_premium_impact_amount decimal(15,2) [note: 'Estimated dollar impact on total written premium resulting from the rate change, used for regulatory and financial planning purposes.']
  rate_change_type varchar [note: 'Indicates whether the filing represents an overall rate increase, decrease, no change, or introduction of a new rating program.']
  regulatory_review_days varchar [note: 'Number of calendar days the filing has been under regulatory review, used to track compliance with statutory review period limits.']
  resubmission_flag boolean [note: 'Indicates whether this filing is a resubmission of a previously objected or withdrawn filing with modifications addressing regulator concerns.']
  serff_tracking_number varchar [note: 'Unique tracking number assigned by the SERFF system for electronic rate and form submissions to state regulators.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this rate filing data originated, such as rating engine or regulatory management system.']
  submission_date date [note: 'Date the rate filing was officially submitted to the state Department of Insurance for regulatory review.']
  supporting_document_url varchar [note: 'Reference URL or document management system path to the complete actuarial memorandum, rate manual, and supporting exhibits filed with the regulator.']
  withdrawal_date date [note: 'Date the insurer voluntarily withdrew the rate filing from regulatory consideration before approval or rejection.']

  Note: 'Reference record for approved rate and form filings with state DOIs. Tracks filing number, LOB, effective date, state, filing type (rate, rule, form), approval status, and SERFF tracking number.'
}

Table policy.policy_transaction {
  policy_transaction_id varchar [pk, note: 'Unique identifier for each policy transaction record in the system.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Policy transaction amounts (written_premium_amount, premium_change_amount, tax_amount, fee_amount, total_transaction_amount) are denominated in a currency.']
  policy_form_id varchar [note: 'Foreign key linking to policy.policy_form. Business justification: Policy transactions reference forms (endorsement forms, cancellation forms). Currently stores form_number and form_edition_date.']
  policy_id varchar [note: 'Reference to the parent policy for which this transaction was executed.']
  prior_transaction_policy_transaction_id varchar [note: 'Reference to the previous transaction in the policy version chain for audit trail and lineage.']
  producers_producer_id varchar [note: 'Reference to the agent or broker who serviced this transaction.']
  quote_id varchar [note: 'Foreign key linking to policy.quote. Business justification: New business (NB) transactions are based on accepted quotes. The quote contains the rated premium and coverage terms that the NB transaction executes.']
  regulatory_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Transaction regulatory state determines premium tax rate and statutory accounting treatment. FK to shared.state enables state-specific transaction processing and tax calculation.']
  submission_id varchar [note: 'Foreign key linking to policy.submission. Business justification: New business (NB) transactions originate from underwriting submissions. Tracking the originating submission for NB transactions provides critical lineage from application to bound policy.']
  version_id varchar [note: 'Foreign key linking to policy.version. Business justification: Policy transactions create version snapshots (NB creates version 1, ENDT creates version 2, etc.). Adding version_id FK establishes which version the transaction created.']
  audit_type varchar [note: 'Type of audit conducted when transaction type is audit, determining premium adjustment methodology.']
  booking_date date [note: 'Accounting date when the transaction was booked for financial and statutory reporting purposes.']
  cancellation_type varchar [note: 'Type of cancellation method applied when transaction type is cancellation, determining premium refund calculation. [ENUM-REF-CANDIDATE: flat|short_rate|pro_rata|insured_request|non_payment|underwriting|fraud — 7 candidates stripped; promote to reference']
  commission_amount decimal(15,2) [note: 'Total commission amount earned by the producer on this transaction.']
  commission_rate decimal(5,4) [note: 'Commission percentage rate applied to this transaction for producer compensation calculation.']
  created_timestamp timestamp [note: 'System timestamp when this transaction record was first created in the database.']
  declaration_page_generated_flag boolean [note: 'Indicates whether a declarations page was generated and issued for this transaction.']
  declaration_page_url varchar [note: 'Document management system URL or path to the generated declarations page for this transaction.']
  effective_date date [note: 'Date when the transaction becomes effective and coverage or changes take effect.']
  expiration_date date [note: 'Date when the transaction or resulting policy version expires.']
  fee_amount decimal(15,2) [note: 'Total fees charged for this transaction including policy fees, endorsement fees, and administrative charges.']
  initiating_party_type varchar [note: 'Type of party who initiated or requested this transaction.']
  initiating_user_code varchar [note: 'System user identifier of the person who created or initiated this transaction.']
  lob_code varchar [note: 'Code identifying the line of business for this transaction such as Commercial Auto, General Liability, or Workers Compensation.']
  notice_compliance_flag boolean [note: 'Indicates whether required notice period was met for regulatory and contractual compliance.']
  notice_date date [note: 'Date when notice of the transaction was sent to the insured or other parties as required by policy terms or regulation.']
  notice_days_required varchar [note: 'Number of days advance notice required by policy terms or state regulation for this transaction type.']
  premium_change_amount decimal(15,2) [note: 'Net change in premium resulting from this transaction, positive for increases and negative for decreases.']
  reason_code varchar [note: 'Code indicating the business reason for the transaction such as coverage change, rate revision, or insured request.']
  reason_description varchar [note: 'Detailed explanation of why the transaction was initiated or what changes were made.']
  reversal_flag boolean [note: 'Indicates whether this transaction reverses or voids a prior transaction.']
  reversal_reason varchar [note: 'Explanation of why this transaction was reversed or voided.']
  source_system_code varchar [note: 'Code identifying the originating system that created this transaction record.']
  source_transaction_id varchar [note: 'Original transaction identifier from the source system for reconciliation and traceability.']
  tax_amount decimal(15,2) [note: 'Total tax amount assessed on this transaction including state premium taxes and surplus lines taxes.']
  total_transaction_amount decimal(15,2) [note: 'Total amount due or refunded for this transaction including premium, taxes, and fees.']
  transaction_number varchar [note: 'Business-facing unique transaction number displayed on declarations and endorsements.']
  transaction_status varchar [note: 'Current lifecycle status of the transaction indicating its processing state. [ENUM-REF-CANDIDATE: draft|quoted|bound|issued|voided|declined|withdrawn — 7 candidates stripped; promote to reference product]']
  transaction_timestamp timestamp [note: 'Precise date and time when the transaction was executed or recorded in the system.']
  type_code varchar [note: 'Code indicating the type of policy transaction: New Business, Renewal, Endorsement, Cancellation, Reinstatement, Non-Renewal, Rewrite, Audit, or Flat Cancellation.']
  underwriter_code varchar [note: 'Reference to the underwriter who reviewed and approved this transaction.']
  updated_timestamp timestamp [note: 'System timestamp when this transaction record was last modified.']
  written_premium_amount decimal(15,2) [note: 'Total premium amount written for this transaction before any adjustments or cessions.']

  Note: 'Unified transaction ledger per policy version: transaction type (NB, ENDT, CANC, REN, reinstatement, non-renewal), effective date, premium impact, reason code, initiating party, form/ISO reference, and notice-compliance fields.'
}

Table policy.location_condition {
  location_condition_id varchar [pk, note: 'Unique identifier for this location-condition association record. Primary key.']
  condition_id varchar [note: 'Foreign key linking to the policy condition imposed on this location']
  insured_location_id varchar [note: 'Foreign key linking to the insured location subject to this condition']
  policy_condition_id varchar [note: 'Foreign key to the policy condition imposed on this location']
  compliance_due_date date [note: 'Date by which this specific location must satisfy this condition']
  compliance_flag boolean [note: 'Indicator of whether this location is in compliance with this condition']
  created_by_user_code varchar [note: 'User who created this location-condition association record']
  created_timestamp timestamp [note: 'Timestamp when this location-condition association was created']
  inspection_required_flag boolean [note: 'Indicator of whether physical inspection is required to verify compliance at this location']
  last_inspection_date date [note: 'Date of most recent inspection to verify condition compliance at this location']
  notes varchar [note: 'Free-text notes specific to this location-condition combination']
  satisfied_date date [note: 'Date when this location satisfied this condition requirement']
  waived_date date [note: 'Date when this condition was waived for this location']
  waiver_reason_code varchar [note: 'Code indicating why this condition was waived for this specific location']

  Note: 'Association between policy conditions and insured locations. Tracks compliance status, due dates, and satisfaction for underwriting requirements imposed on specific premises..'
}

Table policy.vehicle_form_application {
  vehicle_form_application_id varchar [pk, note: 'Unique identifier for this vehicle form application record. Primary key.']
  form_policy_form_id varchar [note: 'Foreign key linking to the policy form applied to this vehicle']
  insured_vehicle_id varchar [note: 'Foreign key linking to the insured vehicle to which this form applies']
  policy_form_id varchar [note: 'Foreign key to the policy form applied to this vehicle']
  application_reason varchar [note: 'Business reason why this form was applied to the vehicle: new business, renewal, endorsement, mid-term change, or regulatory requirement']
  application_timestamp timestamp [note: 'Date and time when this form was applied to the vehicle in the policy administration system']
  applied_by_user_code varchar [note: 'Reference to the underwriter or system user who applied this form to the vehicle']
  effective_date date [note: 'Date from which this form becomes effective for this specific vehicle, may differ from policy effective date for mid-term changes']
  expiration_date date [note: 'Date on which this form application expires or is removed from the vehicle']
  mandatory_flag boolean [note: 'Indicates whether this form is mandatory for this vehicle based on state regulations, vehicle type, or coverage selections']
  premium_impact_amount decimal(15,2) [note: 'Additional premium or credit amount associated with applying this form to this vehicle, zero if form is included in base premium']
  state_specific_version varchar [note: 'State-specific version identifier when the form has variations by state, critical for regulatory compliance']
  vehicle_form_application_status varchar [note: 'Current lifecycle status of this form application: active, pending approval, expired, cancelled, or superseded by newer version']

  Note: 'Association between policy forms and insured vehicles, tracking which forms apply to each vehicle with effective dates, mandatory status, and state-specific versions for regulatory compliance and coverage verification..'
}

Table policy.premium_cession_allocation {
  premium_cession_allocation_id varchar [pk, note: 'Unique identifier for each premium cession allocation record']
  ceded_premium_transaction_id varchar [note: 'Foreign key linking to the reinsurance ceded premium transaction receiving the allocated premium']
  policy_transaction_id varchar [note: 'Foreign key linking to the direct policy transaction whose premium is being ceded']
  accounting_period varchar [note: 'Accounting period (YYYY-MM or YYYY-Q#) to which this premium allocation is attributed for bordereaux reporting']
  allocated_premium_amount decimal(18,2) [note: 'Dollar amount of premium from the policy transaction allocated to this ceded premium transaction']
  allocation_created_by_user_code varchar [note: 'User identifier of the reinsurance accountant who created this allocation record']
  allocation_created_timestamp timestamp [note: 'System timestamp when this premium allocation record was created']
  allocation_effective_date date [note: 'Date when this premium allocation becomes effective for reinsurance accounting purposes']
  allocation_status varchar [note: 'Current lifecycle status of this premium allocation record from draft through settlement']
  bordereaux_submission_date date [note: 'Date when this allocation was included in a bordereaux submission to the reinsurer']
  cession_percentage decimal(7,4) [note: 'Percentage of the policy transaction premium allocated to this specific ceded premium transaction under treaty or FAC terms']
  premium_allocation_basis varchar [note: 'Method used to allocate premium between policy and ceded transactions: written basis, earned basis, pro-rata, or risk-attaching basis']

  Note: 'Association product representing the allocation of direct policy premium transactions to reinsurance ceded premium transactions. Each record links one policy transaction to one ceded premium transaction with cession-specific allocation attributes..'
}

Table policy.coverage_cession {
  coverage_cession_id varchar [pk, note: 'Unique surrogate identifier for each coverage-cession allocation record.']
  policy_coverage_id varchar [note: 'Foreign key linking to the specific policy coverage being ceded to reinsurance.']
  reinsurance_cession_id varchar [note: 'Foreign key linking to the reinsurance cession transaction accepting the ceded risk.']
  attachment_point decimal(18,2) [note: 'Dollar threshold at which this cession begins to respond for losses under this specific coverage, enabling coverage-specific excess of loss structures.']
  ceded_limit_amount decimal(18,2) [note: 'Maximum reinsurance recovery limit for this specific coverage under this cession, reflecting the layer or share allocated to this coverage-cession pairing.']
  ceded_premium_amount decimal(18,2) [note: 'Portion of the coverage premium ceded to the reinsurer under this specific cession transaction.']
  ceded_share_pct decimal(7,4) [note: 'Percentage of this specific coverage ceded to the reinsurer under this cession transaction, enabling pro-rata allocation across multiple treaties.']
  coverage_cession_status varchar [note: 'Current lifecycle state of this coverage-cession allocation, supporting workflow management and audit trails.']
  coverage_layer_allocation varchar [note: 'Identifies the reinsurance layer or structure to which this coverage is allocated under this cession, such as primary, working excess, or catastrophe excess.']
  created_timestamp timestamp [note: 'Timestamp when this coverage-cession allocation record was first created in the reinsurance management system.']
  effective_date date [note: 'Date when this coverage-cession allocation becomes effective, which may differ from the underlying policy coverage or treaty effective dates.']
  expiry_date date [note: 'Date when this coverage-cession allocation expires, supporting mid-term treaty changes or coverage-specific cession adjustments.']
  retention_amount decimal(18,2) [note: 'Cedant retained loss amount for this coverage before this cession responds, supporting coverage-specific retention strategies.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this coverage-cession allocation, supporting audit and change tracking.']

  Note: 'Junction table resolving the M:N relationship between policy coverages and reinsurance cessions. Captures coverage-specific ceded limits, share percentages, layer allocations, and effective dates for each coverage-cession pairing..'
}

Table policy.form_filing {
  form_filing_id varchar [pk, note: 'Unique identifier for the form filing record']
  form_policy_form_id varchar [note: 'Foreign key linking to the policy form being filed']
  policy_form_id varchar [note: 'Foreign key to the policy form being filed in this state']
  state_id varchar [note: 'Foreign key linking to the state where the form is filed']
  applicable_states varchar [note: 'Comma-separated list of US state codes where this form is approved for use, such as CA,NY,TX. Empty if approved nationwide. [Moved from policy_form: This comma-separated list is a denormalized representation of the many-to-many relationship.']
  approval_date date [note: 'Date the form received regulatory approval from this state']
  created_timestamp timestamp [note: 'Timestamp when this filing record was created in the system']
  effective_date date [note: 'Date from which this form version becomes effective in this state']
  expiration_date date [note: 'Date after which this form version is no longer available in this state']
  filing_date date [note: 'Date the form was filed with this state\'s insurance department']
  filing_status varchar [note: 'Current regulatory filing status for this form in this state']
  updated_timestamp timestamp [note: 'Timestamp when this filing record was last modified']

  Note: 'Represents the regulatory filing and approval of a policy form in a specific state. Each record tracks the filing status, approval dates, and effective period for one form-state combination managed by compliance teams..'
}

Table policy.document_template {
  document_template_id varchar [pk, note: 'Primary key for document_template']
  predecessor_template_id varchar [note: 'Reference to the previous version of this template in the version history chain.']
  acord_form_number varchar [note: 'Standard ACORD form number if this template is based on an industry-standard form.']
  approved_by varchar [note: 'User identifier of the person who approved this template for production use.']
  approved_timestamp timestamp [note: 'Date and time when this template was approved for production use.']
  checksum varchar [note: 'SHA-256 hash of the template content for integrity verification and change detection.']
  created_timestamp timestamp [note: 'Date and time when this template record was first created in the system.']
  delivery_method varchar [note: 'Primary method by which documents generated from this template are delivered.']
  document_template_description varchar [note: 'Detailed business description of the templates purpose, usage, and applicability.']
  document_template_status varchar [note: 'Current lifecycle status of the document template indicating availability for use.']
  effective_date date [note: 'Date when this template version becomes available for use in policy document generation.']
  expiration_date date [note: 'Date when this template version is no longer valid for new document generation.']
  file_format varchar [note: 'Output file format produced when this template is rendered.']
  is_customer_facing boolean [note: 'Indicates whether this template generates documents delivered directly to policyholders.']
  is_default boolean [note: 'Indicates whether this is the default template for its type and line of business combination.']
  iso_form_number varchar [note: 'Insurance Services Office form number if this template uses ISO standard language.']
  jurisdiction_code varchar [note: 'Two-letter state or province code where this template is approved for use.']
  language_code varchar [note: 'Two-letter ISO language code indicating the primary language of the template content.']
  last_modified_by varchar [note: 'User identifier of the person who last modified this template record.']
  last_modified_timestamp timestamp [note: 'Date and time when this template record was last updated.']
  last_used_date date [note: 'Most recent date this template was used to generate a document.']
  line_of_business varchar [note: 'Insurance line of business this template applies to, such as personal or commercial lines.']
  merge_field_count varchar [note: 'Number of dynamic merge fields or placeholders in the template requiring data injection.']
  notes varchar [note: 'Additional notes or comments about the template for internal reference and documentation.']
  page_count varchar [note: 'Number of pages in the rendered template document.']
  print_specification varchar [note: 'Printing requirements for documents generated from this template.']
  regulatory_approval_date date [note: 'Date when regulatory approval was granted for this template.']
  regulatory_approval_number varchar [note: 'State insurance department approval or filing number for this template.']
  regulatory_approval_required boolean [note: 'Indicates whether this template requires state insurance department approval before use.']
  requires_signature boolean [note: 'Indicates whether documents generated from this template require policyholder signature.']
  retention_period_years varchar [note: 'Number of years documents generated from this template must be retained per policy.']
  signature_type varchar [note: 'Type of signature required for documents generated from this template.']
  template_category varchar [note: 'Broad category classification of the template by document function.']
  template_code varchar [note: 'Unique business code identifying the template across systems and business units.']
  template_content_path varchar [note: 'Storage location or URI reference to the physical template file or content.']
  template_name varchar [note: 'Human-readable name of the document template for business user identification.']
  template_type varchar [note: 'Classification of the template by document purpose within the policy lifecycle.']
  template_version varchar [note: 'Version number of the template following semantic versioning convention.']
  usage_count varchar [note: 'Total number of times this template has been used to generate documents.']
  created_by varchar [note: 'User identifier of the person who created this template record.']

  Note: 'Master reference table for document_template. Referenced by template_id.'
}

Table policy.underwriter {
  underwriter_id varchar [pk, note: 'Primary key for underwriter']
  supervisor_underwriter_id varchar [note: 'Identifier of the senior underwriter or manager who supervises this underwriter and reviews escalated submissions.']
  authority_level varchar [note: 'Binding authority tier that determines the maximum premium, risk exposure, and policy complexity the underwriter can approve without escalation.']
  created_timestamp timestamp [note: 'Timestamp when the underwriter record was first created in the system.']
  email_address varchar [note: 'Primary business email address for the underwriter used for policy correspondence and internal communication.']
  first_name varchar [note: 'Legal first name of the underwriter.']
  hire_date date [note: 'Date the underwriter was hired or contracted by the organization.']
  home_office_location varchar [note: 'Primary office location or branch where the underwriter is based for operational and reporting purposes.']
  last_name varchar [note: 'Legal last name of the underwriter.']
  last_review_date date [note: 'Date of the most recent formal performance review or evaluation conducted for the underwriter.']
  license_effective_date date [note: 'Date when the underwriter license became effective and valid for binding coverage.']
  license_expiration_date date [note: 'Date when the underwriter license expires and requires renewal to continue binding authority.']
  license_number varchar [note: 'State or regulatory authority issued license number authorizing the underwriter to bind insurance policies.']
  license_state varchar [note: 'Two-letter state code where the underwriter holds their primary insurance license.']
  maximum_exposure_authority decimal(18,2) [note: 'Maximum total insured value or limit of liability the underwriter is authorized to bind on a single risk or policy without escalation.']
  maximum_premium_authority decimal(15,2) [note: 'Maximum annual premium amount the underwriter is authorized to bind without requiring senior approval or referral.']
  performance_rating varchar [note: 'Most recent performance evaluation rating reflecting the underwriter quality of risk selection, loss ratio, and productivity.']
  phone_number varchar [note: 'Primary business phone number for the underwriter.']
  professional_designations varchar [note: 'Industry certifications and professional designations held by the underwriter such as CPCU, AU, ARe, or CIC.']
  region varchar [note: 'Geographic region or territory the underwriter is assigned to for policy binding and risk evaluation.']
  specialization varchar [note: 'Primary line of business or risk specialty area the underwriter is trained and authorized to evaluate, such as commercial property, personal auto, or workers compensation.']
  termination_date date [note: 'Date the underwriter employment or contract was terminated. Null if currently active.']
  underwriter_code varchar [note: 'Business identifier code assigned to the underwriter for external reference and system integration.']
  underwriter_status varchar [note: 'Current employment and authorization status of the underwriter within the organization.']
  underwriter_type varchar [note: 'Classification of the underwriter role indicating employment relationship and seniority level.']
  updated_timestamp timestamp [note: 'Timestamp when the underwriter record was last modified or updated in the system.']
  years_of_experience varchar [note: 'Total number of years the underwriter has worked in insurance underwriting across all employers and lines of business.']

  Note: 'Master reference table for underwriter. Referenced by underwriter_id.'
}

Table coverage.coverage_policy_coverage {
  coverage_policy_coverage_id varchar [pk, note: 'Unique surrogate primary key for the policy-coverage junction record. Identifies a single coverage form attached to a specific policy term.']
  coverage_form_id varchar [note: 'Foreign key reference to the coverage form or coverage type master record. Identifies the specific coverage being attached to the policy.']
  part_id varchar [note: 'Foreign key linking to coverage.part. Business justification: Coverage records should belong to a specific coverage part within a policy. Business semantics: A policy is divided into parts (e.g., CGL Coverage Part, Commercial Property Part), and each']
  policy_id varchar [note: 'Foreign key reference to the parent policy record. Identifies which policy this coverage attachment belongs to.']
  risk_unit_id varchar [note: 'Reference to the insured risk exposure (location, vehicle, or other insurable unit) to which this coverage is attached.']
  version_id varchar [note: 'Reference to the specific policy term (period) to which this coverage attachment applies. Supports multi-term policy structures.']
  aggregate_limit decimal(18,2) [note: 'Maximum total amount the insurer will pay for all covered losses during the policy period under this coverage. Applies to GL, CGL, and similar liability lines.']
  cancellation_date date [note: 'Date on which this coverage attachment was cancelled, if applicable. Null for active coverages. Used for pro-rata or short-rate return premium calculation.']
  cancellation_reason_code varchar [note: 'Standardized code indicating the reason for coverage cancellation (e.g., non-payment, underwriting, insured request). Required for state DOI cancellation notice compliance.']
  cat_exposed_flag boolean [note: 'Indicates whether this coverage is exposed to catastrophe (CAT) perils such as hurricane, earthquake, or flood. Used for CAT modeling, PML estimation, and CAT XL treaty cession.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of the property value the insured is required to carry as insurance. Used to calculate coinsurance penalties at time of loss for property coverages.']
  coverage_basis varchar [note: 'Trigger basis for coverage: occurrence (loss must occur during policy period) or claims-made (claim must be made during policy period). Critical for liability lines.']
  coverage_sequence_number varchar [note: 'Ordinal position of this coverage within the policy. Used to order and display coverages on the Declarations (DEC) page and in bordereaux reporting.']
  coverage_status varchar [note: 'Current lifecycle state of this policy-coverage attachment. Drives eligibility for claims, billing, and reinsurance cession.']
  coverage_type_code varchar [note: 'Standardized code identifying the type of coverage (e.g., GL, CGL, APD, BI, PD, UM, UIM, PIP, MedPay, WC). Aligns with ISO/NAIC LOB codes. [ENUM-REF-CANDIDATE: GL|CGL|APD|BI|PD|UM|UIM|PIP|MedPay|WC|BOP|CPP — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this policy-coverage junction record was first created in the data platform. Supports audit trail and data lineage requirements.']
  deductible_amount decimal(18,2) [note: 'Dollar amount the insured must pay out-of-pocket before the insurer\'s obligation begins for a covered loss under this coverage.']
  deductible_type varchar [note: 'Classification of the deductible structure applied to this coverage (flat dollar, percentage of loss, disappearing/franchise, or split deductible).']
  earned_premium_amount decimal(18,2) [note: 'Portion of the written premium that has been earned as of the reporting date, proportional to the expired coverage period. Used for financial reporting and loss ratio calculation.']
  effective_date date [note: 'Date on which this coverage attachment becomes effective and the insurer assumes risk. Aligns with policy inception or endorsement effective date.']
  endorsement_flag boolean [note: 'Indicates whether this coverage attachment was added or modified via a policy endorsement rather than being part of the original policy issuance.']
  endorsement_number varchar [note: 'Identifier of the endorsement transaction that created or last modified this coverage attachment. Links to the endorsement record for audit and DEC page generation.']
  exclusion_codes varchar [note: 'Pipe-delimited list of exclusion codes applicable to this coverage attachment (e.g., flood, earthquake, war, pollution). Drives claims eligibility determination.']
  expiration_date date [note: 'Date on which this coverage attachment expires and the insurer\'s obligation under this coverage ends. Null for open-ended coverages.']
  extended_reporting_period_days varchar [note: 'Number of days in the Extended Reporting Period (tail coverage) for claims-made policies, allowing claims to be reported after policy expiration.']
  itv_ratio decimal(7,4) [note: 'Insurance to Value ratio expressing the relationship between the coverage limit and the estimated replacement cost value of the insured property. Used for coinsurance and underwriting adequacy.']
  lob_code varchar [note: 'NAIC-aligned Line of Business code classifying the coverage for statutory reporting, rate filings, and actuarial segmentation.']
  mandatory_coverage_flag boolean [note: 'Indicates whether this coverage is statutorily or contractually required (e.g., state-mandated UM/UIM, PIP, or WC coverage). Prevents inadvertent removal during policy changes.']
  occurrence_limit decimal(18,2) [note: 'Maximum amount the insurer will pay for a single occurrence or accident under this coverage. Core underwriting and claims adjudication field.']
  pml_amount decimal(18,2) [note: 'Estimated Probable Maximum Loss for this coverage attachment, used in catastrophe modeling, reinsurance treaty sizing, and capital adequacy assessment.']
  policy_transaction_type varchar [note: 'Type of policy transaction that created or last modified this coverage attachment: New Business (NB), Renewal (REN), Endorsement (ENDT), Cancellation (CANC), reinstatement, or rewrite.']
  premium_currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this coverage attachment (e.g., USD, CAD). Supports multi-currency operations.']
  rate_code varchar [note: 'Rating code used by the rating engine to price this coverage. Links to the rate table and ISO/Verisk rating content used at time of quote and bind.']
  rate_effective_date date [note: 'Effective date of the rate filing or rate table version used to price this coverage. Required for regulatory rate filing compliance and actuarial audit.']
  reinsurance_eligible_flag boolean [note: 'Indicates whether this coverage attachment is eligible for cession under a reinsurance treaty or facultative certificate. Used in bordereaux and cession processing.']
  retroactive_date date [note: 'For claims-made coverages, the earliest date from which covered incidents are eligible. Losses occurring before this date are excluded.']
  sir_amount decimal(18,2) [note: 'Self-Insured Retention amount the insured retains before the insurer\'s coverage attaches. Distinct from a deductible; insured defends and pays within the SIR.']
  source_system_code varchar [note: 'Code identifying the policy administration system of record from which this coverage attachment record originated. Supports multi-system data lineage in the Snowflake lakehouse.']
  source_system_coverage_ref varchar [note: 'Native identifier of this coverage attachment record in the originating policy administration system (e.g., Guidewire PolicyCenter coverage public ID). Enables reconciliation and lineage tracing.']
  sublimit_amount decimal(18,2) [note: 'Sublimit of liability within the overall coverage limit for a specific peril, category of property, or coverage extension (e.g., flood sublimit, mold sublimit).']
  sublimit_description varchar [note: 'Free-text description of the peril, property category, or coverage extension to which the sublimit applies (e.g., \'Flood\', \'Earthquake\', \'Business Income\').']
  tiv_amount decimal(18,2) [note: 'Total Insured Value for the risk exposure covered under this coverage attachment. Used for property lines, ITV calculation, and reinsurance cession.']
  unearned_premium_amount decimal(18,2) [note: 'Portion of the written premium not yet earned as of the reporting date, representing the insurer\'s liability for the unexpired coverage period.']
  updated_timestamp timestamp [note: 'Timestamp when this policy-coverage junction record was last updated in the data platform. Used for incremental load detection and change data capture.']
  valuation_method varchar [note: 'Method used to value a covered loss under this coverage: Actual Cash Value (ACV), Replacement Cost Value (RCV), agreed value, functional replacement, or stated amount.']
  waiting_period_days varchar [note: 'Number of days after a covered event before benefits under this coverage begin. Commonly applies to Business Interruption and Time Element coverages.']
  written_premium_amount decimal(18,2) [note: 'Gross Written Premium allocated to this specific coverage attachment for the policy term. Used for premium allocation, statutory reporting, and reinsurance cession.']

  Note: 'Junction table resolving the M:N relationship between policies and coverage forms. Carries effective/expiration dates, coverage status, and sequence order. SSOT for which coverages are attached to a given policy term.'
}

Table coverage.coverage_form {
  coverage_form_id varchar [pk, note: 'Unique surrogate identifier for a coverage form record in the master catalog. Primary key for the coverage_form product.']
  aggregate_limit_applicable boolean [note: 'Indicates whether this coverage form supports a policy aggregate limit in addition to per-occurrence limits. Applicable to GL, CGL, and umbrella forms.']
  approval_date date [note: 'Date the state Department of Insurance formally approved the coverage form for use. Null if pending or not required.']
  cat_exposed boolean [note: 'Indicates whether this coverage form provides coverage for catastrophe (CAT) perils such as hurricane, earthquake, or flood. Used for PML modeling and CAT XL reinsurance cession.']
  coinsurance_percent decimal(5,2) [note: 'Required coinsurance percentage for property forms with ITV provisions (e.g., 80%, 90%, 100%). Null for forms without coinsurance requirements.']
  coverage_category varchar [note: 'Broad insurance coverage category grouping the form for product management and regulatory reporting (e.g., liability, property, auto, workers_comp, umbrella).']
  created_timestamp timestamp [note: 'Timestamp when this coverage form record was first created in the master catalog. Used for audit trail and data lineage tracking per SOX compliance requirements.']
  default_deductible_amount decimal(18,2) [note: 'Default deductible amount applied to this coverage form when no specific deductible is selected at policy binding. Expressed in USD.']
  default_limit_amount decimal(18,2) [note: 'Default per-occurrence or per-claim coverage limit amount associated with this form when no specific limit is selected at policy binding. Expressed in USD.']
  document_template_code varchar [note: 'Reference code linking this coverage form to its policy document template in the document management system (OpenText/FileNet) for automated DEC page and policy packet generation.']
  edition_date date [note: 'The edition date printed on the coverage form, indicating the version of the form language approved by the filing authority (e.g., 2013-04-01 for CG 00 01 04 13).']
  effective_date date [note: 'Date from which this coverage form version is available for new policy issuance and binding. Aligns with regulatory approval or insurer implementation date.']
  expiration_date date [note: 'Date after which this form version is no longer available for new policy issuance. Null for forms with no planned expiration. Superseded forms retain historical records.']
  extended_reporting_period_days varchar [note: 'Number of days for the basic extended reporting period (tail coverage) available under claims-made forms after policy expiration. Zero for occurrence-based forms.']
  filing_date date [note: 'Date the coverage form was submitted to the state Department of Insurance for approval or informational filing.']
  filing_jurisdiction varchar [note: 'Two-letter US state or territory code where this form has been filed and approved by the Department of Insurance (DOI). Use \'ALL\' for multi-state or nationwide approved forms.']
  filing_status varchar [note: 'Current regulatory filing status of the form with the applicable state Department of Insurance. Tracks approval lifecycle for compliance and issuance eligibility.']
  form_description varchar [note: 'Detailed narrative description of the coverage form\'s insuring agreement, scope of coverage, and primary use case for underwriting and product management reference.']
  form_name varchar [note: 'Human-readable title of the coverage form as it appears on the declarations page or filing (e.g., \'Commercial General Liability Coverage Form\').']
  form_number varchar [note: 'Externally recognized alphanumeric identifier assigned to the coverage form by ISO/Verisk or the insurer\'s proprietary filing (e.g., CG 00 01, HO 00 03). Unique within edition.']
  form_status varchar [note: 'Current lifecycle state of the coverage form in the master catalog. Superseded forms remain for historical policy reference; withdrawn forms are no longer issuable.']
  form_type varchar [note: 'Classifies the form as a base coverage form, endorsement (ENDT), exclusion, schedule, declarations page (DEC), or conditions form within the policy structure.']
  is_base_form boolean [note: 'Indicates whether this is a base coverage form (True) or a supplemental endorsement/exclusion form (False). Base forms define primary insuring agreements; endorsements modify them.']
  is_iso_standard boolean [note: 'Indicates whether this form is an unmodified ISO/Verisk standard form (True) or a proprietary/manuscript deviation (False). Impacts rate filing and actuarial credibility.']
  is_mandatory boolean [note: 'Indicates whether this form is mandatory for all policies in the applicable LOB and jurisdiction, or optional/elective. Mandatory forms are auto-attached during policy issuance.']
  iso_program_code varchar [note: 'ISO/Verisk program or manual code associated with this form, used for cross-referencing ISO rating content, loss costs, and advisory prospective loss cost filings.']
  lob_code varchar [note: 'NAIC or insurer-assigned Line of Business code identifying the insurance line this form applies to (e.g., GL, CGL, BOP, WC, APD, BI/PD, UM/UIM, PIP, MedPay).']
  lob_description varchar [note: 'Full descriptive name of the line of business associated with this form (e.g., \'Commercial General Liability\', \'Businessowners Policy\', \'Workers Compensation\').']
  minimum_premium_amount decimal(18,2) [note: 'Minimum premium amount required when this coverage form is attached to a policy. Expressed in USD. Null if no minimum applies.']
  naic_line_code varchar [note: 'NAIC statutory line of business code used for Annual Statement reporting and regulatory filings (e.g., 17 for Other Liability, 19 for Workers Compensation).']
  occurrence_claims_basis varchar [note: 'Specifies the coverage trigger basis: occurrence (loss event date), claims-made (claim reported date), or reporting basis. Critical for reserve development and IBNR estimation.']
  origin varchar [note: 'Identifies the originating standards body or source of the form: ISO/Verisk, AAIS, NCCI for WC, NFIP for flood, or insurer-proprietary/manuscript forms.']
  policy_type_applicability varchar [note: 'Indicates whether the form applies to personal lines, commercial lines, or both. Drives underwriting eligibility rules in PolicyCenter and Duck Creek Policy.']
  premium_basis varchar [note: 'The exposure base used to calculate premium for this form (e.g., payroll for WC, gross receipts for GL, area for property). Drives rating engine configuration.']
  reinsurance_eligible boolean [note: 'Indicates whether policies written on this form are eligible for cession under reinsurance treaties (QS, XOL, CAT XL) or facultative (FAC) placements.']
  retroactive_date_required boolean [note: 'Indicates whether a retroactive date must be specified for this form. Required for claims-made forms to define the earliest date of covered occurrences.']
  sir_eligible boolean [note: 'Indicates whether a Self-Insured Retention (SIR) can be applied to this coverage form in lieu of or in addition to a standard deductible. Relevant for large commercial accounts.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this coverage form record originated (e.g., Guidewire PolicyCenter, Duck Creek Policy, ISO ISONet, Sapiens IDIT).']
  source_system_form_code varchar [note: 'Native identifier of this coverage form in the originating source system (e.g., Guidewire PolicyCenter internal form ID). Enables lineage tracing and reconciliation.']
  state_specific_version boolean [note: 'Indicates whether this form is a state-specific version with language deviating from the standard ISO form to comply with state DOI requirements or mandatory coverage provisions.']
  tiv_applicable boolean [note: 'Indicates whether Total Insured Value (TIV) must be declared for this form. Applicable to property forms where ITV (Insurance to Value) coinsurance provisions apply.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this coverage form record. Supports change data capture (CDC) for Snowflake data warehouse synchronization and audit compliance.']
  valuation_basis varchar [note: 'Specifies the loss settlement valuation method: Actual Cash Value (ACV), Replacement Cost Value (RCV), agreed value, or functional replacement cost. Drives claims payment calculation.']

  Note: 'Master catalog of ISO and proprietary coverage forms available for each LOB (GL, CGL, BOP, WC, APD, BI/PD, UM/UIM, PIP, MedPay). Defines form number, edition date, filing jurisdiction, and applicable line of business.'
}

Table coverage.part {
  part_id varchar [pk, note: 'Unique surrogate identifier for a coverage part record within the enterprise data platform. Primary key for the coverage_part product.']
  coverage_form_id varchar [note: 'Foreign key linking to coverage.coverage_form. Business justification: Coverage parts (e.g., CGL Coverage Part, Commercial Property Part) are discrete sections of a policy, each based on a specific ISO or proprietary form.']
  policy_id varchar [note: 'Reference to the parent policy to which this coverage part belongs. Links the coverage part to its governing policy contract.']
  product_id varchar [note: 'Reference to the insurance product definition that governs the forms, rules, and rating logic applicable to this coverage part.']
  aggregate_limit decimal(18,2) [note: 'Maximum total amount the insurer will pay for all covered losses during the policy period under this coverage part. Key metric for reinsurance cession and PML analysis.']
  cat_exposed_ind boolean [note: 'Indicates whether this coverage part is exposed to catastrophe (CAT) perils such as hurricane, earthquake, or flood. Used for CAT modeling, PML analysis, and reinsurance treaty attachment.']
  claims_made_ind boolean [note: 'Indicates whether this coverage part is written on a claims-made basis (True) or occurrence basis (False). Determines IBNR reserving methodology and tail coverage requirements.']
  coinsurance_pct decimal(5,2) [note: 'Coinsurance percentage requirement for this coverage part (e.g., 80%, 90%, 100%). Insured must maintain coverage at this percentage of replacement cost to avoid penalty at loss.']
  created_timestamp timestamp [note: 'Timestamp when this coverage part record was first created in the system of record. Used for audit trail, data lineage, and regulatory compliance under SOX and state DOI requirements.']
  deductible_amount decimal(18,2) [note: 'Dollar amount of the deductible applicable to this coverage part, representing the insured\'s retained share of each covered loss before insurer indemnification begins.']
  deductible_type varchar [note: 'Classification of the deductible structure applied to this coverage part (e.g., straight, franchise, aggregate, disappearing, per occurrence).']
  earned_premium decimal(18,2) [note: 'Portion of Written Premium (WP) earned as of the reporting date, based on pro-rata or other earning method. Used for Loss Ratio (LR) and Combined Ratio (CR) calculations.']
  effective_date date [note: 'Date on which this coverage part becomes effective and coverage obligations begin. Aligns with the policy inception or mid-term endorsement effective date.']
  experience_mod_factor decimal(7,4) [note: 'Experience modification factor (EMF or e-mod) applied to this coverage part, reflecting the insured\'s historical loss experience relative to expected losses. Primarily used for WC.']
  expiration_date date [note: 'Date on which this coverage part expires and coverage obligations cease. Used for Unearned Premium (UEP) calculation and renewal processing.']
  exposure_amount decimal(18,2) [note: 'Quantified exposure base value for this coverage part (e.g., total payroll in USD for WC, square footage for property, number of vehicles for APD). Used in premium rating.']
  extended_reporting_period_days varchar [note: 'Number of days in the Extended Reporting Period (ERP or tail coverage) for claims-made parts, allowing claims to be reported after policy expiration for incidents during the policy period.']
  filing_jurisdiction varchar [note: 'Two-letter US state code of the primary jurisdiction where this coverage part\'s form and rate are filed with the Department of Insurance (DOI).']
  inception_date date [note: 'Original inception date of this coverage part, which may differ from effective_date for renewal or rewritten policies. Used for continuous coverage tracking.']
  insuring_agreement_desc varchar [note: 'Narrative description of the insuring agreement for this coverage part, summarizing the scope of coverage, perils insured, and key conditions as stated on the DEC page.']
  itv_ratio decimal(7,4) [note: 'Insurance to Value (ITV) ratio for this coverage part, calculated as the insured value divided by the estimated replacement cost. Used to detect underinsurance and apply coinsurance penalties.']
  lob_code varchar [note: 'NAIC or ISO standard Line of Business code assigned to this coverage part, used for statutory reporting, rate filings, and actuarial segmentation.']
  med_expense_limit decimal(18,2) [note: 'Per-person limit for medical payments coverage (MedPay) under this coverage part, payable regardless of fault for bodily injury on the insured premises.']
  naic_line_code varchar [note: 'NAIC statutory line of business code for this coverage part, used in Annual Statement Schedule P, Schedule F, and state regulatory filings.']
  occurrence_limit decimal(18,2) [note: 'Maximum amount the insurer will pay for a single occurrence or accident under this coverage part. Core underwriting parameter for GL, CGL, APD, and property lines.']
  part_name varchar [note: 'Human-readable name of the coverage part (e.g., Commercial General Liability Coverage Part, Commercial Property Coverage Part, Workers Compensation and Employers Liability Part).']
  part_number varchar [note: 'Externally visible alphanumeric identifier for this coverage part, as printed on the Declarations (DEC) page and used in bordereaux and regulatory filings.']
  part_status varchar [note: 'Current lifecycle state of the coverage part within the policy administration system. Drives billing, claims eligibility, and regulatory reporting.']
  part_type varchar [note: 'Classifies the coverage part by Line of Business (LOB) form type. [ENUM-REF-CANDIDATE: GL|CGL|CP|WC_EL|APD|BOP|CPP|IM|CRIME|UMBRELLA|OTHER — promote to reference product]']
  personal_adv_injury_limit decimal(18,2) [note: 'Per-occurrence limit for personal and advertising injury coverage under a CGL part, covering offenses such as libel, slander, and copyright infringement.']
  policy_term_months varchar [note: 'Duration of the coverage part in whole months (typically 6 or 12). Used for pro-rata premium calculation, Earned Premium (EP), and Unearned Premium Reserve (UEP).']
  premium_currency varchar [note: 'ISO 4217 three-letter currency code for all premium and limit amounts on this coverage part (e.g., USD). Required for multi-currency and international program reporting.']
  products_completed_ops_limit decimal(18,2) [note: 'Separate aggregate limit applying to products and completed operations exposures under a CGL coverage part, as defined by ISO CG 00 01 form structure.']
  rate_per_unit decimal(18,6) [note: 'Manual or filed rate applied per unit of exposure for this coverage part (e.g., rate per $100 of payroll, rate per $1,000 of TIV). Core rating parameter from ISO or NCCI filings.']
  rating_basis varchar [note: 'Exposure base used to rate this coverage part (e.g., payroll for WC, revenue for GL, area for property). Drives premium calculation and actuarial loss development.']
  retroactive_date date [note: 'For claims-made coverage parts, the retroactive date before which incidents are not covered. Null for occurrence-based parts. Critical for IBNR tail reserve calculations.']
  schedule_mod_factor decimal(7,4) [note: 'Underwriter-applied schedule rating modification factor for this coverage part, reflecting risk-specific credits or debits relative to the manual rate. Subject to state DOI filing limits.']
  sir_amount decimal(18,2) [note: 'Dollar amount of the Self-Insured Retention (SIR) for this coverage part. Unlike a deductible, the insured defends and pays claims within the SIR before insurer involvement.']
  source_system_part_ref varchar [note: 'Native identifier for this coverage part in the originating policy administration system (e.g., Guidewire PolicyCenter CoveragePartBean ID or Duck Creek Part GUID) for lineage tracing.']
  state_filed_ind boolean [note: 'Indicates whether the form and rate for this coverage part have been filed and approved by the applicable state Department of Insurance (DOI). Required for regulatory compliance tracking.']
  terrorism_coverage_ind boolean [note: 'Indicates whether terrorism coverage under TRIA (Terrorism Risk Insurance Act) is included in this coverage part. Required for TRIA certification and federal reporting.']
  tiv_amount decimal(18,2) [note: 'Total Insured Value (TIV) for this coverage part, representing the aggregate replacement or actual cash value of all insured property or assets covered under the part.']
  unearned_premium decimal(18,2) [note: 'Unearned Premium Reserve (UEP) for this coverage part as of the reporting date, representing the unexpired portion of written premium. Required for NAIC statutory balance sheet.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this coverage part record. Used for change data capture (CDC), audit trail, and Silver layer incremental processing in the Databricks Lakehouse.']
  valuation_method varchar [note: 'Method used to value insured property under this coverage part: Actual Cash Value (ACV), Replacement Cost Value (RCV), agreed value, functional replacement, or stated amount.']
  written_premium decimal(18,2) [note: 'Gross Written Premium (GWP) attributed to this coverage part for the current policy term. Used for Gross Written Premium (GWP) reporting, bordereaux, and reinsurance cession calculations.']

  Note: 'Represents a discrete coverage part within a policy (e.g., CGL Coverage Part, Commercial Property Part, WC and EL Part). Groups related coverage forms under a single insuring agreement within a CPP or BOP structure.'
}

Table coverage.limit {
  limit_id varchar [pk, note: 'Unique surrogate identifier for a coverage limit record in the Silver layer lakehouse.']
  coverage_policy_coverage_id varchar [note: 'Reference to the parent coverage to which this limit structure is attached.']
  parent_limit_id varchar [note: 'Self-referencing FK to the parent limit record, enabling hierarchical sublimit modeling (e.g., peril-specific sublimit under an aggregate).']
  aggregate_limit_amount decimal(18,2) [note: 'Maximum total amount payable under this coverage for all occurrences during the policy period. Distinct from per-occurrence limit_amount.']
  amount decimal(18,2) [note: 'The principal monetary limit amount in the policy currency (e.g., per-occurrence limit, aggregate limit, per-person BI limit). Core financial fact for this limit record.']
  amount_2 decimal(18,2) [note: 'Second monetary limit used in split-limit structures (e.g., PD limit in a BI/PD split, or per-person limit alongside per-occurrence). Null for non-split limits.']
  amount_3 decimal(18,2) [note: 'Third monetary limit in a three-part split structure (e.g., per-person BI / per-occurrence BI / PD). Null for non-three-part split limits.']
  application varchar [note: 'Defines how the limit applies across insured units: per insured, per location, per vehicle, per project, per employee, or blanket across all units.']
  basis varchar [note: 'The trigger basis on which the limit applies: occurrence, claims-made, accident, policy period, per location, or per vehicle.']
  cat_exposed_flag boolean [note: 'Indicates whether this limit is exposed to catastrophe (CAT) perils such as hurricane, earthquake, or flood, used for CAT accumulation and PML reporting.']
  coinsurance_pct decimal(7,4) [note: 'Required coinsurance percentage (e.g., 0.80 = 80%) the insured must maintain relative to replacement cost value to avoid a coinsurance penalty at loss.']
  coverage_form_code varchar [note: 'ISO/Verisk or carrier-proprietary form code identifying the policy form under which this limit applies (e.g., CG 00 01, HO 00 03, CA 00 01).']
  created_timestamp timestamp [note: 'Timestamp when this limit record was first created in the Silver layer, used for audit trail and data lineage per SOX and NIST controls.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary limit amounts on this record (e.g., USD, CAD, GBP).']
  effective_date date [note: 'Date on which this limit structure becomes effective, aligned with policy inception or endorsement effective date.']
  endorsement_number varchar [note: 'Identifier of the policy endorsement (ENDT) that introduced or modified this limit, enabling traceability to the endorsement transaction.']
  expiration_date date [note: 'Date on which this limit structure expires, aligned with policy expiration or endorsement termination date. Null for open-ended limits.']
  iso_limit_symbol varchar [note: 'ISO/Verisk rating symbol associated with this limit tier, used in ISO loss cost and rate filing calculations (e.g., auto liability symbol).']
  itv_ratio decimal(7,4) [note: 'Insurance to Value (ITV) ratio: limit_amount divided by replacement cost value, used to detect underinsurance and apply coinsurance penalties.']
  jurisdiction_state_code varchar [note: 'Two-letter US state code of the jurisdiction governing this limit, used for state-specific minimum limit compliance and statutory reporting.']
  limit_code varchar [note: 'Externally-known alphanumeric code identifying this limit type, aligned with ISO form codes and carrier rating plans (e.g., OCC_LIMIT, AGG_LIMIT, PER_PERSON).']
  limit_name varchar [note: 'Human-readable name of the limit structure as displayed on the Declarations (DEC) page (e.g., Per-Occurrence Limit, Annual Aggregate Limit).']
  limit_status varchar [note: 'Current lifecycle state of the limit record: active, inactive, superseded by endorsement, pending approval, or expired.']
  limit_type varchar [note: 'Structural classification of the limit: per-occurrence, aggregate, per-person, split (BI/PD), Combined Single Limit (CSL), sublimit, or per-claim. [ENUM-REF-CANDIDATE: per_occurrence|aggregate|per_person|split|csl|sublimit|per_claim — promote to reference']
  lob_code varchar [note: 'NAIC or carrier Line of Business code classifying the coverage to which this limit belongs (e.g., GL, CGL, BOP, WC, APD, PIP).']
  med_expense_limit decimal(18,2) [note: 'Per-person medical payments (MedPay) limit. Applies to GL Coverage C, auto MedPay, and BOP medical expense coverages.']
  naic_coverage_code varchar [note: 'NAIC statistical coverage code associated with this limit for statutory reporting and Annual Statement Schedule P/T filings.']
  peril_code varchar [note: 'Code identifying the specific peril or cause of loss to which this limit applies (e.g., FIRE, WIND, FLOOD, THEFT, BI, PD). Null for all-peril limits.']
  personal_adv_injury_limit decimal(18,2) [note: 'Per-occurrence limit for personal and advertising injury coverage under CGL policies. Null for non-CGL coverages.']
  pml_amount decimal(18,2) [note: 'Probable Maximum Loss (PML) estimate associated with this limit, used for reinsurance treaty sizing and CAT accumulation management.']
  policy_transaction_type varchar [note: 'Type of policy transaction that created or last modified this limit record: New Business (NB), Renewal (REN), Endorsement (ENDT), Reinstatement, or Cancellation (CANC).']
  products_completed_ops_aggregate decimal(18,2) [note: 'Separate aggregate limit for products and completed operations exposures under CGL policies, per ISO CGL form structure.']
  reinstatable_flag boolean [note: 'Indicates whether the limit can be reinstated after a loss payment (True), relevant for aggregate limits with reinstatement provisions.']
  reinstatement_premium_pct decimal(7,4) [note: 'Percentage of original premium charged to reinstate the aggregate limit after a loss, expressed as a decimal (e.g., 1.0000 = 100% pro-rata).']
  ri_retention_amount decimal(18,2) [note: 'Net retention amount kept by the cedant after reinsurance cession for this limit layer, used in XOL and QS treaty calculations.']
  shared_limit_flag boolean [note: 'Indicates whether this limit is shared across multiple coverages or insured locations on the same policy (True) or applies independently (False).']
  sir_amount decimal(18,2) [note: 'Dollar amount of Self-Insured Retention (SIR) the insured must exhaust before the policy limit applies. Distinct from a deductible.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this limit record was sourced (e.g., Guidewire PolicyCenter, Duck Creek Policy, Sapiens IDIT).']
  source_system_limit_code varchar [note: 'Native primary key of this limit record in the originating operational system (e.g., Guidewire PolicyCenter internal limit GUID), used for reconciliation.']
  state_minimum_flag boolean [note: 'Indicates whether this limit equals the state-mandated minimum required by the applicable Department of Insurance (DOI), used for compliance monitoring.']
  tiv_amount decimal(18,2) [note: 'Total Insured Value (TIV) of the insured property or schedule associated with this limit, used for ITV adequacy checks and CAT modeling.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this limit record in the Silver layer, used for incremental processing and change data capture.']
  valuation_method varchar [note: 'Method used to value a loss under this limit: Actual Cash Value (ACV), Replacement Cost Value (RCV), agreed value, functional replacement cost, or market value.']
  version_number varchar [note: 'Monotonically increasing version counter for this limit record, incremented on each endorsement or mid-term change to support audit trail and temporal queries.']
  xol_attachment_point decimal(18,2) [note: 'Dollar attachment point at which Excess of Loss (XOL) reinsurance coverage begins for this limit layer. Null for non-XOL structures.']

  Note: 'SSOT for coverage limit structures per attached coverage: per-occurrence, aggregate, per-person, split, CSL, and peril-specific sublimits modeled via self-referencing parent-limit link.'
}

Table coverage.deductible {
  deductible_id varchar [pk, note: 'Unique surrogate identifier for a deductible or Self-Insured Retention (SIR) record attached to a coverage on a policy. Primary key of the deductible product.']
  coverage_policy_coverage_id varchar [note: 'Reference to the coverage to which this deductible or SIR structure is attached. Links the deductible record to its parent coverage.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Deductible effective dates determine which deductible applies to a claim based on loss date. New FK needed for temporal tracking and claims adjudication.']
  policy_id varchar [note: 'Reference to the policy under which this deductible applies. Enables direct policy-level reporting without joining through coverage.']
  aggregate_deductible_amount decimal(18,2) [note: 'Annual aggregate cap on the insured\'s total deductible obligation across all occurrences in the policy period. Once exhausted, the insurer pays subsequent losses without deductible offset.']
  application_method varchar [note: 'Defines how the deductible is applied: per_occurrence, per_claim, per_accident, aggregate (annual), or per_location. Drives claims payment calculations and bordereaux reporting.']
  buyback_available_flag boolean [note: 'Indicates whether the insured has the option to purchase a deductible buyback endorsement to reduce or eliminate the deductible obligation for an additional premium.']
  buyback_premium_amount decimal(18,2) [note: 'Additional premium charged to the insured to buy back (reduce or eliminate) the deductible. Applicable only when buyback_available_flag is True and the insured exercises the option.']
  cat_deductible_flag boolean [note: 'Indicates whether this deductible is a CAT-specific deductible triggered only by a declared catastrophe event (e.g., named storm, earthquake). Separate from the standard deductible.']
  cat_peril_type varchar [note: 'Specific catastrophe peril that triggers the CAT deductible. Applicable only when cat_deductible_flag is True. [ENUM-REF-CANDIDATE: named_storm|earthquake|flood|hail|wildfire|all_cat|tornado|ice_storm — promote to reference product]']
  coverage_form_code varchar [note: 'ISO or proprietary form code identifying the coverage form to which this deductible applies (e.g., CG 00 01 for CGL, HO 00 03 for homeowners). Supports rate filing alignment.']
  created_timestamp timestamp [note: 'Timestamp when this deductible record was first created in the data platform. Used for audit trail, data lineage, and SLA monitoring in the Silver layer.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which all deductible and SIR monetary amounts are denominated (e.g., USD, CAD, GBP).']
  deductible_code varchar [note: 'Externally-known alphanumeric code identifying this deductible structure, used in policy declarations, bordereaux, and regulatory filings.']
  deductible_status varchar [note: 'Current lifecycle state of the deductible record: active (in force), inactive (expired or removed), superseded (replaced by endorsement), or pending (awaiting binding).']
  deductible_type varchar [note: 'Structural classification of the deductible: flat (fixed dollar), percentage (of loss or TIV), split (per-occurrence and aggregate), disappearing (reduces to zero at threshold), or SIR (Self-Insured Retention layer).']
  defense_inside_sir_flag boolean [note: 'Indicates whether defense costs (legal fees, investigation) are included within and erode the SIR layer (True) or are paid outside the SIR by the insurer (False).']
  disappearing_max_amount decimal(18,2) [note: 'Loss threshold at which the deductible fully disappears (reduces to zero) in a disappearing deductible structure. Above this amount the insurer pays the full loss.']
  disappearing_min_amount decimal(18,2) [note: 'Minimum loss threshold below which the full deductible applies in a disappearing (franchise) deductible structure. Below this point the insured bears the full deductible.']
  effective_date date [note: 'Date on which this deductible structure becomes binding and applicable to covered losses. Aligns with policy or endorsement effective date.']
  endorsement_number varchar [note: 'Policy endorsement number that introduced or modified this deductible structure. Null if the deductible was established at original policy issuance rather than via endorsement.']
  erosion_basis varchar [note: 'Defines what costs erode (count against) the deductible or SIR: loss_only (indemnity only), loss_and_alae (loss plus Allocated Loss Adjustment Expense), or loss_and_lae (loss plus all LAE).']
  expiration_date date [note: 'Date on which this deductible structure ceases to apply. Null for open-ended structures; typically aligns with policy expiration or endorsement end date.']
  flat_amount decimal(18,2) [note: 'Fixed dollar amount the insured must pay per occurrence or per claim before the insurer\'s obligation begins. Applicable when deductible_type is flat or split.']
  lob_code varchar [note: 'NAIC or internal Line of Business code associated with this deductible (e.g., GL, CGL, BOP, WC, APD, PIP). Supports statutory reporting and actuarial segmentation.']
  maximum_deductible_amount decimal(18,2) [note: 'Ceiling dollar amount for the deductible, capping the insured\'s per-occurrence or per-claim obligation even when a percentage calculation yields a higher result.']
  minimum_deductible_amount decimal(18,2) [note: 'Floor dollar amount for the deductible, ensuring the insured\'s obligation does not fall below this value even when a percentage calculation yields a lower result.']
  notes varchar [note: 'Free-text underwriting or operational notes describing special conditions, negotiated terms, or exceptions applicable to this deductible or SIR structure.']
  percentage_basis varchar [note: 'The value base against which the percentage deductible is calculated: TIV (Total Insured Value), loss (actual loss amount), SI (Sum Insured), or AAV (Agreed Amount Value).']
  percentage_rate decimal(7,4) [note: 'Deductible expressed as a percentage (e.g., 2.0000 = 2%) applied to the loss amount, Total Insured Value (TIV), or sum insured. Used when deductible_type is percentage.']
  rate_credit_factor decimal(7,4) [note: 'Multiplicative premium credit factor applied to the base rate as a result of the insured accepting this deductible or SIR level (e.g., 0.8500 = 15% credit). Used in premium rating.']
  reinstatement_basis varchar [note: 'Defines whether the aggregate deductible or SIR cap reinstates after exhaustion: automatic (reinstates without additional premium), paid (reinstates for additional premium), or none.']
  sir_aggregate_cap decimal(18,2) [note: 'Maximum annual aggregate dollar amount the insured is obligated to fund under the SIR layer across all occurrences in the policy period.']
  sir_amount decimal(18,2) [note: 'Dollar amount of the Self-Insured Retention layer the insured must fully exhaust before the insurer\'s policy obligations are triggered. Distinct from a deductible in that the insurer has no duty to defend within the SIR.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this deductible record originated: guidewire_pc (PolicyCenter), duck_creek, sapiens_idit, or manual entry.']
  source_system_ref_code varchar [note: 'Native primary key or reference identifier of this deductible record in the originating operational system of record. Supports data lineage and reconciliation with source systems.']
  split_aggregate_amount decimal(18,2) [note: 'Annual aggregate dollar cap on the insured\'s total deductible obligation under a split deductible structure. Once reached, the insurer absorbs subsequent losses.']
  split_per_occurrence_amount decimal(18,2) [note: 'Per-occurrence dollar deductible component of a split deductible structure. The insured pays this amount for each individual loss event.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this deductible record in the data platform. Supports change detection, incremental processing, and audit compliance.']
  version_number varchar [note: 'Monotonically increasing version counter for this deductible record. Increments with each endorsement or modification, enabling point-in-time reconstruction of the deductible structure.']
  waiting_period_days varchar [note: 'Number of days the insured must wait after a loss event before the insurer\'s obligation begins. Common in business interruption and time-element coverages.']
  waiver_of_deductible_flag boolean [note: 'Indicates whether the deductible has been waived by endorsement or underwriting authority for this coverage. When True, the insured pays no deductible regardless of the stated amount.']

  Note: 'SSOT for deductible and self-insured retention (SIR) per attached coverage: flat, percentage, split, disappearing, and SIR-layer structures. Captures amount, basis, application method, defense-inside-SIR flag, aggregate SIR cap, and erosion basis.'
}

Table coverage.sir_layer {
  sir_layer_id varchar [pk, note: 'Unique surrogate identifier for the Self-Insured Retention layer record. Primary key for the sir_layer entity in the coverage domain.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage line to which this SIR layer applies, enabling per-coverage SIR tracking within a policy.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: SIR effective dates determine claims handling and reinsurance recovery timing. New FK needed for temporal tracking and coverage determination.']
  policy_id varchar [note: 'Reference to the parent policy to which this SIR layer is attached. Links the SIR configuration to the insured contract.']
  sir_retention_id varchar [note: 'FK to riskexposure.sir_retention.sir_retention_id — Links the coverage-side SIR layer to the risk-side SIR/large-deductible program so SIR erosion queries use a single authoritative retention record.']
  aggregate_limit decimal(18,2) [note: 'Maximum total insurer indemnity across all occurrences within the policy period above the SIR, capping the insurer\'s annual exposure.']
  aggregate_sir_cap decimal(18,2) [note: 'Maximum cumulative SIR amount the insured is obligated to pay across all occurrences within the policy period before the insurer absorbs further losses.']
  alae_treatment varchar [note: 'Specifies how ALAE is handled relative to the SIR: included within the retention amount, excluded entirely, or allocated pro-rata between insured and insurer.']
  claims_made_flag boolean [note: 'Indicates whether the underlying policy is written on a claims-made basis (True) or occurrence basis (False), affecting SIR trigger and erosion timing.']
  collateral_amount decimal(18,2) [note: 'Dollar value of collateral posted by the insured to secure the SIR layer obligation, used for credit risk and financial security monitoring.']
  collateral_expiry_date date [note: 'Date on which the collateral instrument securing the SIR obligation expires, triggering renewal or replacement requirements to maintain coverage continuity.']
  collateral_required boolean [note: 'Indicates whether the insurer requires the insured to post collateral (letter of credit, surety bond, or cash deposit) to secure the SIR obligation.']
  collateral_type varchar [note: 'Type of financial security instrument posted by the insured to collateralize the SIR obligation, such as a letter of credit or surety bond.']
  created_timestamp timestamp [note: 'Timestamp when this SIR layer record was first created in the data platform, providing the audit trail creation marker per SOX and data governance requirements.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code applicable to all monetary amounts on this SIR layer record (e.g., USD, CAD, GBP).']
  defense_inside_sir boolean [note: 'Indicates whether Allocated Loss Adjustment Expenses (ALAE) and defense costs erode the SIR amount (True) or are paid outside and above the SIR (False).']
  effective_date date [note: 'Date on which the SIR layer becomes operative and the insured assumes the defined retention obligation under the policy.']
  endorsement_number varchar [note: 'Policy endorsement number that introduced or last modified this SIR layer, providing traceability to the specific policy change transaction.']
  erosion_basis varchar [note: 'Determines whether the SIR is eroded by paid losses only or by incurred losses (paid plus outstanding reserves), affecting when insurer coverage is triggered.']
  expiration_date date [note: 'Date on which the SIR layer ceases to be operative. Aligns with the policy period end date unless a mid-term endorsement changes the retention terms.']
  extended_reporting_period_days varchar [note: 'Number of days in the extended reporting period (tail coverage) during which claims may be reported and still erode the SIR after policy expiration.']
  form_edition_date date [note: 'Edition date of the ISO or proprietary SIR endorsement form, used to identify the specific version of the form language governing the retention terms.']
  form_number varchar [note: 'ISO or insurer-proprietary form number of the SIR endorsement attached to the policy, enabling regulatory filing traceability and form version control.']
  insured_defense_obligation varchar [note: 'Indicates who controls and funds the legal defense within the SIR layer: the insured independently, the insurer, or a shared arrangement.']
  insured_financial_rating varchar [note: 'Credit or financial strength rating of the insured entity (e.g., A.M. Best, S&P), used to assess the insured\'s ability to fund the SIR obligation.']
  layer_status varchar [note: 'Current lifecycle state of the SIR layer record, indicating whether the retention arrangement is operative, suspended, or terminated.']
  lob_code varchar [note: 'NAIC-aligned Line of Business code identifying the coverage type to which this SIR layer applies, such as CGL, WC, or APD. [ENUM-REF-CANDIDATE: GL|CGL|BOP|WC|APD|BI_PD|UM_UIM|PIP|MedPay|CPP — 10 candidates stripped; promote to reference product]']
  minimum_sir_premium decimal(18,2) [note: 'Minimum premium charged to the insured for the SIR layer arrangement, reflecting the insurer\'s administrative and risk management costs for the retention structure.']
  naic_line_code varchar [note: 'NAIC statutory line of business code associated with this SIR layer, required for annual statement reporting and regulatory compliance.']
  notes varchar [note: 'Free-text underwriting or operational notes describing special conditions, negotiated terms, or exceptions applicable to this SIR layer arrangement.']
  occurrence_limit decimal(18,2) [note: 'Maximum insurer indemnity per occurrence above the SIR. Establishes the ceiling of insurer liability once the SIR is fully eroded for a single loss event.']
  reinsurance_applies_above_sir boolean [note: 'Indicates whether reinsurance treaty or facultative coverage attaches above the SIR layer, affecting net retained loss calculations and cession reporting.']
  retroactive_date date [note: 'For claims-made policies, the earliest date from which covered incidents are eligible to erode the SIR. Null for occurrence-based policies.']
  ri_attachment_point decimal(18,2) [note: 'Dollar threshold above the SIR at which reinsurance coverage attaches, defining the boundary between net retained risk and ceded risk.']
  sir_aggregate_eroded_amount decimal(18,2) [note: 'Cumulative dollar amount of losses and/or ALAE that have eroded the aggregate SIR cap to date within the policy period, used for real-time retention monitoring.']
  sir_amount decimal(18,2) [note: 'Per-occurrence dollar amount the insured must pay before the insurer\'s coverage obligation is triggered. Core financial parameter of the SIR layer.']
  sir_per_occurrence_eroded_amount decimal(18,2) [note: 'Dollar amount of losses and/or ALAE that have eroded the per-occurrence SIR for the most recently tracked loss event, supporting claim-level retention accounting.']
  sir_premium_credit decimal(18,2) [note: 'Premium credit or reduction granted to the insured in exchange for accepting the SIR, representing the risk transfer value of the retention layer.']
  sir_reference_number varchar [note: 'Externally visible alphanumeric identifier for this SIR layer record, used in policy documents, endorsements, and bordereaux reporting.']
  sir_type varchar [note: 'Classifies the SIR structure as per-occurrence, per-claim, aggregate, or combined, determining how the retention threshold is measured and applied.']
  source_system_code varchar [note: 'Identifies the originating policy administration system from which this SIR layer record was sourced, supporting data lineage and reconciliation.']
  source_system_record_code varchar [note: 'Native primary key or record identifier of this SIR layer in the originating policy administration system, enabling cross-system reconciliation.']
  state_code varchar [note: 'Two-letter US state code where the SIR layer is filed and operative, governing applicable state DOI regulations and SIR permissibility rules.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this SIR layer record, supporting change tracking, audit compliance, and incremental data pipeline processing.']
  uw_approval_date date [note: 'Date on which the underwriter formally approved this SIR layer, establishing the authorization timestamp for audit and compliance purposes.']
  uw_approval_required boolean [note: 'Indicates whether this SIR layer configuration requires explicit underwriting authority approval before binding, based on retention size or risk class.']
  uw_approved_by varchar [note: 'Name or employee identifier of the underwriter who approved this SIR layer configuration, providing an audit trail for authority compliance.']

  Note: 'Self-Insured Retention layer record for large commercial and excess policies. Tracks SIR amount, defense-inside vs outside SIR flag, aggregate SIR cap, and erosion basis (paid vs incurred).'
}

Table coverage.endorsement {
  endorsement_id varchar [pk, note: 'Unique surrogate identifier for a coverage endorsement record in the Silver Layer lakehouse. Primary key for the coverage_endorsement product.']
  coverage_form_id varchar [note: 'Foreign key linking to coverage.coverage_form. Business justification: Endorsements are based on ISO or proprietary coverage forms from the master catalog.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage line being modified, added, or deleted by this endorsement. Ties the ENDT to its target coverage.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Endorsement effective dates are critical for coverage determination and claims adjudication. New FK needed for temporal tracking and mid-term change processing.']
  policy_id varchar [note: 'Reference to the parent policy to which this endorsement is attached. Links the endorsement to its governing policy contract.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Endorsements are frequently producer-initiated or processed. Essential for commission calculation on mid-term premium changes, producer activity tracking, and audit of who']
  aggregate_limit_amount decimal(18,2) [note: 'Maximum total coverage limit for the policy period as established or modified by this endorsement. Applies to GL, CGL, and BOP aggregate caps.']
  beneficiary_name varchar [note: 'Name of the additional insured, loss payee, mortgagee, or other beneficiary granted rights under this endorsement. Required for AI grants and waiver of subrogation ENDTs.']
  beneficiary_type varchar [note: 'Classification of the party receiving rights under this endorsement. Determines the scope of coverage extension and claims payment priority.']
  coverage_territory varchar [note: 'Geographic territory or jurisdiction to which this endorsement\'s coverage applies. Uses ISO 3166-1 alpha-2 state/country codes. Drives regulatory filing and rate bureau alignment.']
  created_timestamp timestamp [note: 'System timestamp when the endorsement record was first captured in the policy administration system. Supports audit trail and data lineage requirements.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this endorsement record (e.g., USD, CAD). Supports multi-currency commercial accounts.']
  effective_date date [note: 'Date on which the endorsement becomes binding and coverage changes take effect. Used for EP proration, premium audit, and regulatory filings.']
  endorsement_description varchar [note: 'Free-text narrative describing the purpose and scope of the endorsement. Printed on the DEC page and used by claims adjusters and UW for coverage interpretation.']
  endorsement_number varchar [note: 'Externally visible alphanumeric identifier for the endorsement as printed on the declarations page. Used by agents, insureds, and regulators to reference a specific ENDT.']
  endorsement_status varchar [note: 'Current workflow state of the endorsement record. Controls whether the ENDT is binding, pending UW approval, superseded by a later ENDT, or cancelled.']
  endorsement_type varchar [note: 'Categorical classification of the endorsement action. Drives processing logic for AI grants, SubroFT waivers, mid-term amendments, and coverage changes. [ENUM-REF-CANDIDATE']
  exclusion_description varchar [note: 'Narrative description of any coverage exclusion added or removed by this endorsement. Used by claims adjusters for coverage determination and UW for risk selection.']
  expiration_date date [note: 'Date on which the endorsement ceases to be effective. Null for permanent ENDTs that run to policy expiry. Used for temporary coverage grants and time-limited waivers.']
  issued_date date [note: 'Calendar date on which the endorsement was formally issued and delivered to the insured or broker. Distinct from effective_date for retroactive or prospective ENDTs.']
  itv_ratio decimal(5,4) [note: 'Ratio of insured value to estimated replacement cost value after endorsement. Used to identify coinsurance deficiencies and ensure adequate coverage per ISO ITV guidelines.']
  lob_code varchar [note: 'Line of Business to which this endorsement applies. Aligns with NAIC LOB codes and internal product taxonomy for statutory reporting and analytics. [ENUM-REF-CANDIDATE: GL|CGL|BOP|WC|APD|BI_PD|UM_UIM|PIP|MedPay|CPP|FAC — 11 candidates stripped; promote to']
  new_deductible_amount decimal(18,2) [note: 'Deductible amount established by this endorsement. Drives claims payment net calculations and insured cost-sharing obligations post-endorsement.']
  new_limit_amount decimal(18,2) [note: 'Coverage limit established by this endorsement after the change takes effect. Used for premium rating, TIV calculation, and reinsurance cession.']
  occurrence_limit_amount decimal(18,2) [note: 'Maximum coverage limit per occurrence as established or modified by this endorsement. Distinct from aggregate limit; used for claims payment and reinsurance XOL attachment.']
  policy_transaction_type varchar [note: 'Type of policy transaction that generated this endorsement (New Business, Renewal, Mid-term ENDT, Cancellation, Reinstatement, Rewrite). Aligns with NAIC transaction reporting.']
  premium_impact_amount decimal(18,2) [note: 'Additional or return premium generated by this endorsement. Positive for additional premium, negative for return premium. Feeds BillingCenter and WP/EP accounting.']
  premium_impact_type varchar [note: 'Indicates whether the premium impact is an additional charge, return credit, flat (no change), or waived. Drives billing transaction type in BillingCenter.']
  prior_deductible_amount decimal(18,2) [note: 'Deductible amount in force before this endorsement. Supports before/after audit trail for deductible changes and claims payment calculations.']
  prior_limit_amount decimal(18,2) [note: 'Coverage limit in force immediately before this endorsement was applied. Enables before/after comparison for UW analysis, audit, and claims coverage determination.']
  regulatory_filing_number varchar [note: 'State DOI or SERFF filing number associated with this endorsement form. Required for approved form tracking and regulatory examination responses.']
  regulatory_filing_required_flag boolean [note: 'Indicates whether this endorsement form requires a state DOI filing before use. Supports compliance tracking for rate and form filing obligations.']
  requested_by_party_type varchar [note: 'Type of party who initiated the endorsement request. Supports producer commission attribution, UW workflow routing, and regulatory audit of mid-term changes.']
  retroactive_date date [note: 'Retroactive date established or modified by this endorsement for claims-made policies. Critical for determining coverage applicability on CGL and professional liability forms.']
  sir_amount decimal(18,2) [note: 'Self-Insured Retention dollar threshold established or modified by this endorsement. Applicable to commercial lines where the insured retains a layer of risk below the policy limit.']
  source_system_code varchar [note: 'Identifies the originating policy administration system that created this endorsement record. Supports data lineage, reconciliation, and Silver Layer provenance tracking.']
  source_system_endt_ref varchar [note: 'Native endorsement identifier from the originating policy administration system (e.g., Guidewire PolicyCenter job number). Enables cross-system reconciliation and traceability.']
  subrogation_waiver_flag boolean [note: 'Indicates whether this endorsement includes a waiver of subrogation rights against a specified party. Impacts recovery and SubroFT processes in ClaimCenter.']
  tiv_impact_amount decimal(18,2) [note: 'Change in Total Insured Value resulting from this endorsement. Used for property CAT modeling, PML calculations, and reinsurance cession adjustments.']
  transaction_reason_code varchar [note: 'Coded reason for the endorsement transaction (e.g., insured request, UW correction, regulatory mandate, audit adjustment). Used for NAIC transaction reporting and analytics.']
  updated_timestamp timestamp [note: 'System timestamp of the most recent modification to the endorsement record. Used for change data capture, incremental ETL, and audit compliance.']
  uw_approval_required_flag boolean [note: 'Indicates whether this endorsement requires underwriter approval before binding. Drives workflow routing in PolicyCenter for non-standard or high-value ENDTs.']
  uw_approved_by varchar [note: 'Name or user ID of the underwriter who approved this endorsement. Supports UW authority audit trail and regulatory examination requirements.']
  uw_approved_timestamp timestamp [note: 'Date and time when the underwriter formally approved this endorsement. Provides a precise audit event for UW authority compliance and workflow SLA tracking.']
  version_number varchar [note: 'Sequential version counter incremented each time this endorsement record is amended. Supports optimistic concurrency control and historical version tracking in the lakehouse.']

  Note: 'ENDT records modifying, adding, or deleting coverage on a policy, including AI grants, subrogation waivers, and mid-term amendments. Captures endorsement type, form number, edition/effective date, premium impact, beneficiary/scope, and prior vs new values.'
}

Table coverage.exclusion {
  exclusion_id varchar [pk, note: 'Unique surrogate identifier for a coverage exclusion, sublimit, condition, or warranty record in the P&C policy administration system.']
  coverage_form_id varchar [note: 'Foreign key linking to coverage.coverage_form. Business justification: Exclusions reference ISO or proprietary forms that define the exclusion language. The exclusion table has iso_form_number (STRING) but lacks FK to coverage_form catalog.']
  coverage_policy_coverage_id varchar [note: 'Reference to the parent coverage form or endorsement to which this exclusion clause is attached.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Exclusion effective dates determine coverage applicability at time of loss. New FK needed for temporal tracking and claims adjudication.']
  endorsement_id varchar [note: 'Reference to the endorsement that introduced or modified this exclusion, if applicable. Null when the exclusion originates from the base coverage form.']
  policy_id varchar [note: 'Reference to the policy under which this exclusion applies, enabling direct policy-level exclusion reporting without joining through coverage.']
  bureau_filed_flag boolean [note: 'Indicates whether this clause has been filed with and approved by a rating bureau (ISO/Verisk) or state Department of Insurance (DOI) for use.']
  cat_peril_flag boolean [note: 'Indicates whether this exclusion relates to a catastrophe (CAT) peril such as hurricane, earthquake, or flood, relevant for CAT modeling and reinsurance cession.']
  claims_handling_note varchar [note: 'Operational guidance for claims adjusters on how to apply this exclusion during adjudication, including coverage denial language and documentation requirements.']
  clause_name varchar [note: 'Human-readable name of the exclusion or condition clause as it appears on the policy form, e.g., \'Pollution Exclusion\' or \'War and Terrorism Exclusion\'.']
  clause_status varchar [note: 'Current lifecycle status of the exclusion clause: active (in force), inactive (not yet effective), pending (awaiting approval), superseded (replaced), or voided.']
  clause_summary varchar [note: 'Plain-language summary of the clause for use in consumer-facing disclosures, declarations pages, and regulatory plain-language requirements.']
  clause_text varchar [note: 'Full verbatim text of the exclusion, sublimit, condition, or warranty clause as it appears in the policy form or endorsement wording.']
  clause_type varchar [note: 'Categorizes the clause as an exclusion (removes coverage), sublimit (caps coverage), condition (imposes obligation), warranty (guarantees a fact), or limitation.']
  created_timestamp timestamp [note: 'Timestamp when this exclusion record was first created in the system of record, used for audit trail and data lineage in the Databricks Silver layer.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the sublimit amount, e.g., USD, CAD, GBP. Defaults to USD for domestic policies.']
  cyber_flag boolean [note: 'Indicates whether this clause is a cyber or data breach exclusion, relevant for silent cyber exposure management and regulatory cyber reporting.']
  effective_date date [note: 'Date on which this exclusion clause becomes effective and enforceable under the policy or endorsement.']
  expiration_date date [note: 'Date on which this exclusion clause ceases to be effective. Null for clauses that persist for the full policy term.']
  itv_impact_flag boolean [note: 'Indicates whether this exclusion or sublimit affects the Insurance to Value (ITV) calculation for the insured property, relevant for coinsurance and valuation reporting.']
  lob_code varchar [note: 'NAIC or internal Line of Business code to which this exclusion applies, e.g., GL, CGL, BOP, WC, APD. [ENUM-REF-CANDIDATE: GL|CGL|BOP|WC|APD|BI|PD|UM|UIM|PIP|MedPay — promote to reference product]']
  manuscript_flag boolean [note: 'Indicates whether this exclusion clause is a manuscript (non-standard, bespoke) clause negotiated for this specific policy rather than a standard bureau form.']
  naic_line_code varchar [note: 'NAIC statutory line of business code associated with this exclusion for annual statement and statutory reporting purposes.']
  number varchar [note: 'Externally visible alphanumeric identifier for this exclusion clause, used on declarations pages and correspondence with insureds and brokers.']
  peril_class varchar [note: 'The peril or hazard category excluded or limited by this clause, e.g., flood, earthquake, pollution, terrorism, cyber, mold. [ENUM-REF-CANDIDATE: flood|earthquake|pollution|terrorism|cyber|mold|war|nuclear — promote to reference product]']
  pollution_flag boolean [note: 'Indicates whether this clause is an absolute or qualified pollution exclusion, relevant for environmental liability underwriting and claims adjudication.']
  property_class varchar [note: 'The class of property or liability to which the exclusion scope is restricted, e.g., real property, personal property, bodily injury (BI), property damage (PD).']
  regulatory_approval_number varchar [note: 'State DOI or NAIC filing approval number for this clause form, required for statutory compliance and rate/form filing documentation.']
  reinsurance_impact_flag boolean [note: 'Indicates whether this exclusion has a material impact on reinsurance treaty cession eligibility or facultative (FAC) placement, flagging for RI bordereaux review.']
  scope varchar [note: 'Indicates whether the exclusion applies broadly (blanket), to a scheduled item, a specific location, a specific vehicle, named perils only, or all-risk basis.']
  sir_amount decimal(18,2) [note: 'Self-Insured Retention dollar amount associated with this exclusion or condition clause, applicable to commercial lines where the insured retains a layer of risk.']
  source_system_ref varchar [note: 'Native primary key or record identifier from the originating source system, used for lineage tracing and reconciliation with upstream policy administration systems.']
  state_code varchar [note: 'Two-letter US state code where this exclusion clause is applicable or was filed, per USPS/NAIC state code standards.']
  sublimit_amount decimal(18,2) [note: 'Maximum dollar amount payable under this clause when clause_type is \'sublimit\'. Null for pure exclusions, conditions, or warranties.']
  sublimit_basis varchar [note: 'Defines how the sublimit amount is applied: per occurrence, per claim, in the aggregate, per insured location, or per scheduled item.']
  terrorism_flag boolean [note: 'Indicates whether this clause is a terrorism exclusion, relevant for TRIA (Terrorism Risk Insurance Act) compliance and federal backstop reporting.']
  tiv_reduction_amount decimal(18,2) [note: 'Dollar amount by which this exclusion reduces the Total Insured Value (TIV) for the affected location or schedule item, used in CAT modeling and PML calculations.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this exclusion record, supporting change data capture (CDC) and incremental Silver layer processing.']
  uw_authority_level varchar [note: 'Underwriting authority level required to approve or waive this exclusion clause, from standard automated to chief underwriter or reinsurer sign-off.']
  version_number varchar [note: 'Monotonically increasing version counter for this exclusion record, incremented on each material change to support policy form version control and audit.']
  waiver_endorsement_ref varchar [note: 'Reference number of the endorsement that waives this exclusion, populated only when waiver_flag is true.']
  waiver_flag boolean [note: 'Indicates whether this exclusion has been waived by endorsement or underwriting agreement, restoring coverage for the excluded peril or property class.']

  Note: 'Coverage exclusions, sublimits, conditions, and warranties attached to a coverage form or endorsement. Records clause type, peril/property class scope, and sublimit amount.'
}

Table coverage.additional_insured {
  additional_insured_id varchar [pk, note: 'Unique surrogate identifier for the additional insured endorsement record on a policy. Primary key for the additional_insured entity in the coverage domain.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage line under the policy to which this additional insured\'s rights apply. Scopes the AI grant to a particular coverage.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Additional insured effective dates determine coverage applicability for certificate holders. New FK needed for temporal tracking and certificate issuance.']
  endorsement_id varchar [note: 'Reference to the endorsement record that formally grants additional insured status. Links to the ENDT that modifies the base policy to add this party.']
  insured_entity_id varchar [note: 'Reference to the party master record representing the additional insured entity (person or organization). Provides identity resolution for the AI.']
  insured_location_id varchar [note: 'Reference to the specific insured location or premises associated with this additional insured grant. Scopes AI coverage to a defined property or job site.']
  policy_id varchar [note: 'Reference to the parent policy to which this additional insured endorsement is attached. Links the AI record to its governing policy contract.']
  added_by_user varchar [note: 'Username or system identifier of the underwriter or policy service representative who added this additional insured record to the policy in the policy administration system.']
  added_date date [note: 'Calendar date on which the additional insured was added to the policy in the policy administration system. Used for audit trail and endorsement processing records.']
  additional_premium decimal(18,2) [note: 'Incremental premium charged for adding this additional insured endorsement to the policy. Contributes to gross written premium (GWP) and earned premium (EP) calculations.']
  aggregate_limit decimal(18,2) [note: 'Maximum aggregate dollar amount payable for all claims involving the additional insured during the policy period. May be sub-limited below the policy aggregate.']
  ai_address_line1 varchar [note: 'First line of the additional insured\'s mailing or registered address. Used for certificate delivery, notice of cancellation, and claims correspondence.']
  ai_address_line2 varchar [note: 'Second line of the additional insured\'s mailing or registered address (suite, floor, unit). Supplements address line 1 for complete address capture.']
  ai_city varchar [note: 'City of the additional insured\'s mailing or registered address. Required for certificate issuance and regulatory notice compliance.']
  ai_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the additional insured\'s address. Required for international policies and cross-border certificate issuance.']
  ai_name varchar [note: 'Full legal name of the additional insured party as it appears on the endorsement and certificate of insurance. Used for claims and legal correspondence.']
  ai_number varchar [note: 'Externally visible business identifier for this additional insured record, used on certificates of insurance and correspondence. Unique within the policy.']
  ai_postal_code varchar [note: 'ZIP or postal code of the additional insured\'s address. Used for geographic rating, certificate issuance, and regulatory notice delivery.']
  ai_state_code varchar [note: 'Two-letter US state or territory code for the additional insured\'s address. Used for regulatory jurisdiction determination and certificate compliance.']
  ai_status varchar [note: 'Current lifecycle status of the additional insured endorsement record. Drives certificate issuance eligibility and claims coverage validation.']
  ai_type varchar [note: 'Classifies the additional insured as an individual, organization, government entity, trust, or joint venture. Drives certificate formatting and coverage scope rules.']
  auto_cert_issuance_flag boolean [note: 'Indicates whether certificates of insurance for this additional insured should be automatically generated and distributed upon policy issuance or renewal.']
  cancellation_date date [note: 'Date on which the additional insured endorsement was cancelled or removed from the policy prior to its scheduled expiration. Null if not cancelled.']
  cancellation_reason varchar [note: 'Reason code for the cancellation of the additional insured endorsement. Required for regulatory reporting and audit trail in states with mandatory cancellation notice rules.']
  certificate_holder_flag boolean [note: 'Indicates whether the additional insured is also designated as a certificate holder on the ACORD 25 certificate of insurance. Drives automated certificate generation.']
  contract_reference varchar [note: 'Reference number or description of the underlying contract, lease, or agreement that requires the additional insured designation. Provides audit trail for AI requirement.']
  coverage_scope varchar [note: 'Defines the scope of coverage granted to the AI: ongoing operations, completed operations, both, products liability, or premises only. Directly tied to the endorsement form selected.']
  created_timestamp timestamp [note: 'Timestamp when this additional insured record was first created in the data platform. Used for audit trail, data lineage, and Silver layer ingestion tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this additional insured record (limits, premium). Defaults to USD for domestic policies.']
  dba_name varchar [note: 'Trade or operating name of the additional insured if different from the legal name. Captured for certificate issuance and claims identification purposes.']
  effective_date date [note: 'Date on which the additional insured endorsement becomes effective and coverage rights are granted to the AI party. Must fall within the policy term.']
  endorsement_form_edition varchar [note: 'Edition date of the ISO or proprietary endorsement form (MM/YY format), indicating the version of the AI grant language in use. Critical for coverage interpretation.']
  endorsement_form_number varchar [note: 'ISO or proprietary form number of the additional insured endorsement (e.g., CG 20 10, CG 20 26, CG 20 33, CG 20 37). Identifies the exact AI grant language applied.']
  exclusions_description varchar [note: 'Free-text description of any specific exclusions or limitations applied to the additional insured\'s coverage grant beyond the standard endorsement form language.']
  expiration_date date [note: 'Date on which the additional insured endorsement expires and coverage rights terminate. Typically co-terminus with the policy expiration date unless separately scheduled.']
  lob_code varchar [note: 'Line of business under which this additional insured endorsement is issued (e.g., GL, CGL, BOP, WC, APD). Determines applicable coverage forms and regulatory requirements.']
  notice_of_cancellation_days varchar [note: 'Number of days advance written notice of cancellation or material change that must be provided to the additional insured. Typically 30 or 60 days per contract requirement.']
  occurrence_limit decimal(18,2) [note: 'Maximum dollar amount payable per occurrence for claims involving the additional insured under this endorsement. May be sub-limited below the policy occurrence limit.']
  primary_noncontributory_flag boolean [note: 'Indicates whether the policy is designated as primary and non-contributory with respect to the additional insured\'s own insurance. Common contractual requirement in construction and leasing.']
  project_description varchar [note: 'Description of the specific project, location, or operations for which the additional insured designation applies. Scopes the AI grant to defined work or premises.']
  relationship_type varchar [note: 'Categorizes the contractual relationship between the named insured and the additional insured (e.g., lessor, lender, owner, contractor, mortgagee). [ENUM-REF-CANDIDATE: lessor|lender|owner|contractor|mortgagee|franchisor|vendor|co-owner — promote to']
  source_system_code varchar [note: 'Identifies the originating policy administration system from which this additional insured record was sourced (e.g., Guidewire PolicyCenter, Duck Creek, Sapiens IDIT).']
  source_system_ref_code varchar [note: 'Native record identifier from the originating policy administration system for this additional insured record. Enables lineage tracing and reconciliation with source systems.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this additional insured record in the data platform. Supports change data capture (CDC) and incremental processing in the Silver layer.']
  waiver_of_subrogation_flag boolean [note: 'Indicates whether a waiver of subrogation in favor of the additional insured has been endorsed onto the policy. Prevents the insurer from pursuing recovery against the AI.']

  Note: 'Additional insured (AI) endorsement records granting third-party coverage rights on a policy. Captures AI name, relationship type (lessor, lender, owner), endorsement form, and scope of coverage granted.'
}

Table coverage.named_insured {
  named_insured_id varchar [pk, note: 'Unique surrogate identifier for a named insured record on a policy declarations page. Primary key for the named_insured data product in the coverage domain.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Named insured effective dates track when parties are added/removed from coverage. New FK needed for temporal tracking and coverage determination.']
  insured_entity_id varchar [note: 'Reference to the enterprise party master record representing this named insured. Enables cross-policy party consolidation and 360-degree view.']
  policy_id varchar [note: 'Reference to the policy on whose declarations page (DEC) this named insured appears. Links the named insured to its parent policy record.']
  annual_payroll decimal(18,2) [note: 'Total annual payroll of the commercial named insured in USD. Primary exposure base for workers compensation (WC) premium rating and NCCI experience modification calculation.']
  annual_revenue decimal(18,2) [note: 'Reported annual gross revenue of the commercial named insured in USD. Used as an exposure base for general liability (GL) and commercial general liability (CGL) premium rating.']
  consent_to_electronic_delivery boolean [note: 'Indicates whether the named insured has consented to receive policy documents, notices, and the declarations page (DEC) electronically. Required for e-delivery compliance under state DOI rules.']
  created_timestamp timestamp [note: 'Timestamp when this named insured record was first created in the policy administration system. Supports audit trail, data lineage, and NAIC regulatory compliance requirements.']
  credit_score_tier varchar [note: 'Insurance credit score tier derived from the named insured\'s credit report. Used as a rating factor for personal lines where permitted; actual score is not stored per FCRA requirements.']
  date_of_birth date [note: 'Date of birth of the individual named insured. Used for age-based underwriting rating, eligibility determination, and actuarial segmentation in personal lines.']
  date_of_incorporation date [note: 'Date on which the commercial named insured was legally incorporated or formed. Used for years-in-business underwriting factor and commercial eligibility rules.']
  dba_name varchar [note: 'Trade or assumed name under which the insured operates, distinct from the registered legal name. Commonly used for commercial lines where the entity trades as a DBA.']
  effective_date date [note: 'Date on which this named insured\'s coverage became effective on the policy. May differ from the policy effective date when added by endorsement mid-term.']
  email varchar [note: 'Primary email address of the named insured used for policy correspondence, renewal notices, and digital document delivery on the declarations page.']
  endorsement_number varchar [note: 'Endorsement (ENDT) number by which this named insured was added or removed from the policy mid-term. Null for named insureds present at policy inception.']
  expiration_date date [note: 'Date on which this named insured\'s coverage expires or was removed from the policy. Null for active named insureds whose coverage runs to the policy expiration date.']
  fein varchar [note: 'IRS-issued Federal Employer Identification Number (FEIN) for commercial named insureds. Used for statutory reporting, premium audit, and workers compensation payroll verification.']
  gender varchar [note: 'Self-reported gender of the individual named insured. Used for personal lines underwriting rating in jurisdictions where gender-based rating is permitted by state DOI.']
  insured_role varchar [note: 'Role of this party on the declarations page. First named insured has primary rights and obligations; additional named insureds share coverage. [ENUM-REF-CANDIDATE: first_named|additional_named|mortgagee|loss_payee|additional_interest — promote to']
  insured_type varchar [note: 'Legal entity type of the named insured. Drives underwriting eligibility, form selection, and regulatory reporting. [ENUM-REF-CANDIDATE: individual|corporation|partnership|llc|trust|government|non_profit — promote to reference product]']
  is_first_named boolean [note: 'Indicates whether this party is the first named insured on the declarations page (DEC). The first named insured holds primary rights including cancellation authority and premium refund entitlement.']
  is_primary_contact boolean [note: 'Indicates whether this named insured is the primary contact for policy correspondence, billing notices, and renewal communications. Only one named insured per policy should be flagged true.']
  legal_name varchar [note: 'Full legal name of the named insured as it appears on the declarations page (DEC). For individuals this is the full personal name; for entities it is the registered legal name.']
  lob_code varchar [note: 'Primary line of business (LOB) code associated with this named insured\'s policy. Drives form selection, rating algorithm, and statutory reporting classification.']
  marital_status varchar [note: 'Marital status of the individual named insured. Used as a personal lines underwriting (UW) rating variable for auto and homeowners policies where permitted by state DOI.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the writing insurance company for this named insured\'s policy. Required for NAIC Annual Statement and state regulatory filings.']
  naics_code varchar [note: 'Six-digit North American Industry Classification System (NAICS) code describing the primary business activity of the commercial named insured. Used for class-of-business rating and underwriting.']
  named_insured_status varchar [note: 'Current lifecycle status of this named insured on the policy. Active indicates coverage is in force; removed indicates the party was deleted by endorsement.']
  num_employees varchar [note: 'Total number of full-time equivalent employees of the commercial named insured. Used as an underwriting (UW) eligibility factor and exposure indicator for workers compensation (WC) and GL.']
  phone varchar [note: 'Primary contact phone number for the named insured. Used for underwriting contact, claims first notice of loss (FNOL) intake, and billing communications.']
  primary_address_line1 varchar [note: 'First line of the named insured\'s primary mailing address as shown on the declarations page. Used for policy correspondence, premium billing, and regulatory filings.']
  primary_address_line2 varchar [note: 'Second line of the named insured\'s primary mailing address (suite, unit, floor, PO Box). Supplements address line 1 for complete address representation on the DEC.']
  primary_city varchar [note: 'City of the named insured\'s primary mailing address. Used for territory rating, regulatory jurisdiction determination, and statutory reporting.']
  primary_country varchar [note: 'ISO 3166-1 alpha-3 country code of the named insured\'s primary mailing address. Supports multinational commercial policies and IFRS 17 jurisdictional reporting.']
  primary_state varchar [note: 'Two-letter US state code of the named insured\'s primary mailing address. Determines the governing state for policy issuance, rate filing, and regulatory compliance.']
  primary_zip varchar [note: 'ZIP or ZIP+4 postal code of the named insured\'s primary mailing address. Used for territory rating, catastrophe (CAT) zone assignment, and USPS deliverability.']
  removal_reason varchar [note: 'Reason code explaining why this named insured was removed from the policy. Populated only when status is removed or inactive; supports audit and regulatory compliance.']
  sequence_number varchar [note: 'Ordinal position of this named insured on the declarations page. The first named insured is sequence 1; subsequent named insureds are numbered sequentially.']
  sic_code varchar [note: 'Four-digit Standard Industrial Classification (SIC) code for the named insured\'s primary industry. Legacy classification used alongside NAICS for ISO rating and NAIC statutory reporting.']
  source_system_ref varchar [note: 'Native identifier of this named insured record in the originating policy administration system (e.g., Guidewire PolicyCenter internal ID). Enables traceability back to the system of record.']
  ssn_masked varchar [note: 'Masked Social Security Number (SSN) for individual named insureds, storing only the last four digits. Full SSN is stored in a restricted vault; this field supports identity verification without full exposure.']
  state_of_incorporation varchar [note: 'Two-letter US state code where the commercial named insured is legally incorporated or domiciled. Drives jurisdictional form selection and regulatory compliance.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this named insured record. Used for change data capture (CDC), incremental ETL processing, and audit trail in the Databricks Silver layer.']
  years_in_business varchar [note: 'Number of years the commercial named insured has been continuously operating. Used as an underwriting (UW) rating factor for commercial lines eligibility and experience credit.']

  Note: 'Named insured parties listed on the declarations page (DEC) of a policy. Supports multiple named insureds per policy with role (first named, additional named), FEIN/SSN reference, and DBA name.'
}

Table coverage.amendment {
  amendment_id varchar [pk, note: 'Unique surrogate identifier for a mid-term coverage amendment record on a policy. Primary key of the coverage_amendment product.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage line being amended on the policy.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Amendment effective dates drive mid-term rating changes and earned premium calculations. New FK needed for temporal analytics and premium earning.']
  endorsement_id varchar [note: 'Foreign key linking to coverage.endorsement. Business justification: Amendments track mid-term changes to coverage terms and are typically implemented via formal endorsements.']
  insured_location_id varchar [note: 'Reference to the specific insured location affected by this amendment, applicable for property and GL location-level changes.']
  insured_vehicle_id varchar [note: 'Reference to the specific insured vehicle affected by this amendment, applicable for APD, BI/PD, UM/UIM, and PIP coverage changes.']
  policy_id varchar [note: 'Reference to the policy on which this mid-term coverage amendment is applied.']
  policy_transaction_id varchar [note: 'Native transaction or job ID from the originating policy administration system, enabling traceability back to the system of record.']
  producers_producer_id varchar [note: 'Reference to the agent or broker who submitted or requested this coverage amendment on behalf of the insured.']
  uw_decision_id varchar [note: 'Reference to the underwriter who reviewed and approved this coverage amendment. Required for UW authority audit trails.']
  amendment_number varchar [note: 'Externally visible business identifier for this amendment, used in correspondence, audit trails, and bordereaux reporting.']
  amendment_status varchar [note: 'Current workflow lifecycle state of the amendment from initiation through application or rejection.']
  amendment_type varchar [note: 'Categorizes the nature of the mid-term change. [ENUM-REF-CANDIDATE: limit_change|deductible_change|sir_change|location_add|location_remove|vehicle_add|vehicle_remove|coverage_add|coverage_remove — promote to reference product]']
  applied_timestamp timestamp [note: 'Date and time at which the amendment was committed to the policy administration system and coverage terms were updated.']
  approved_timestamp timestamp [note: 'Date and time at which an authorized underwriter or system workflow approved the coverage amendment.']
  change_reason_code varchar [note: 'Standardized code identifying the business reason for the mid-term amendment (e.g., insured request, underwriter correction, regulatory mandate, audit finding).']
  change_reason_description varchar [note: 'Free-text narrative explaining the business justification for the coverage amendment, captured at time of entry.']
  coverage_form_number varchar [note: 'ISO or proprietary form number of the coverage being amended (e.g., CG 00 01, HO 00 03). Identifies the specific policy form.']
  created_timestamp timestamp [note: 'System timestamp when the amendment record was first created in the data platform. Used for audit and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this amendment record (e.g., USD, CAD).']
  effective_date date [note: 'Date on which the amended coverage terms become contractually binding. Drives pro-rata premium adjustment calculations.']
  expiration_date date [note: 'Date on which the amended terms expire, if the change is temporary. Null for permanent mid-term amendments.']
  itv_ratio decimal(7,4) [note: 'Insurance to Value (ITV) ratio after the amendment, calculated as new TIV divided by replacement cost value. Flags coinsurance exposure.']
  lob_code varchar [note: 'NAIC-aligned Line of Business code identifying the insurance product line to which the amended coverage belongs. [ENUM-REF-CANDIDATE: GL|CGL|BOP|WC|APD|HO|CPP|IM|UMBR|EXCESS — 10 candidates stripped; promote to reference product]']
  new_deductible_amount decimal(18,2) [note: 'Deductible amount effective after this amendment. Drives re-rating and impacts insured\'s out-of-pocket exposure.']
  new_limit_amount decimal(18,2) [note: 'Coverage limit effective after this amendment is applied. Used for premium re-rating and reinsurance cession recalculation.']
  new_sir_amount decimal(18,2) [note: 'Self-Insured Retention (SIR) amount effective after this amendment. Impacts claims payment thresholds and reinsurance attachment.']
  new_tiv_amount decimal(18,2) [note: 'Total Insured Value (TIV) effective after this amendment. Drives property premium re-rating and reinsurance treaty cession updates.']
  notes varchar [note: 'Free-text underwriter or operations notes providing additional context for the amendment, visible in the policy file and audit log.']
  premium_impact_amount decimal(18,2) [note: 'Net additional or return premium resulting from this amendment, calculated pro-rata from the effective date to policy expiration.']
  premium_impact_type varchar [note: 'Indicates whether the amendment generates an additional premium charge, a return premium credit, or a flat (no-change) premium adjustment.']
  prior_deductible_amount decimal(18,2) [note: 'Deductible amount in force immediately before this amendment. Supports before/after comparison for premium adjustment.']
  prior_limit_amount decimal(18,2) [note: 'Coverage limit in force immediately before this amendment. Retained for audit, regulatory, and premium adjustment purposes.']
  prior_sir_amount decimal(18,2) [note: 'Self-Insured Retention (SIR) amount in force before this amendment. Relevant for large commercial and excess liability lines.']
  prior_tiv_amount decimal(18,2) [note: 'Total Insured Value (TIV) of the insured property or schedule before this amendment. Used for ITV analysis and CAT modeling.']
  regulatory_filing_reference varchar [note: 'State DOI filing reference number associated with this amendment when a regulatory filing is required and submitted.']
  regulatory_filing_required boolean [note: 'Indicates whether this amendment triggers a state DOI rate or form filing obligation under applicable insurance regulations.']
  reinsurance_impact_flag boolean [note: 'Indicates whether this amendment materially affects reinsurance treaty cession amounts, requiring bordereaux update or facultative re-placement.']
  requested_date date [note: 'Calendar date on which the insured, producer, or underwriter formally requested the coverage amendment.']
  requires_endorsement boolean [note: 'Indicates whether this amendment requires a formal endorsement document to be issued to the insured per policy terms or state regulation.']
  source_system_code varchar [note: 'Identifies the originating policy administration system from which this amendment record was ingested into the data lakehouse.']
  state_code varchar [note: 'Two-letter US state code where the amended coverage is domiciled or the risk is located. Drives regulatory filing and rate applicability.']
  updated_timestamp timestamp [note: 'System timestamp of the most recent modification to this amendment record. Supports change data capture and audit compliance.']
  uw_authority_level varchar [note: 'Underwriting authority tier required to approve this amendment based on limit size, LOB, and risk characteristics.']

  Note: 'Tracks mid-term amendments to coverage terms (limit changes, deductible changes, added/removed locations or vehicles) outside of a full endorsement cycle. Records change reason, effective date, and prior vs new values.'
}

Table coverage.itv_assessment {
  itv_assessment_id varchar [pk, note: 'Unique surrogate identifier for each Insurance-to-Value assessment record on an insured property location.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage line (e.g., building, contents, BOP property) to which this ITV assessment applies.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Assessment effective dates determine when coinsurance penalties apply. New FK needed for temporal tracking and underwriting decisions.']
  insured_location_id varchar [note: 'Reference to the insured property location record being assessed for Insurance-to-Value adequacy.']
  policy_id varchar [note: 'Reference to the policy under which the insured location is covered and for which this ITV assessment is performed.']
  acv_estimate decimal(18,2) [note: 'Actual Cash Value (ACV) estimate for the insured property, calculated as RCV less depreciation, used for ACV policy settlements.']
  agreed_value_flag boolean [note: 'Indicates whether the policy carries an Agreed Value endorsement, suspending the coinsurance clause for this location.']
  assessed_rcv decimal(18,2) [note: 'Replacement Cost Value (RCV) determined by the assessment methodology, representing the estimated cost to rebuild the structure at current prices.']
  assessment_date date [note: 'Calendar date on which the ITV assessment was conducted or the valuation report was produced.']
  assessment_method varchar [note: 'Valuation methodology used to derive the Replacement Cost Value (RCV). [ENUM-REF-CANDIDATE: marshall_swift|corelogic|xactware|internal_model|broker_estimate|appraisal — promote to reference product]']
  assessment_number varchar [note: 'Externally visible business identifier for this ITV assessment, used in underwriting correspondence and bordereaux reporting.']
  assessment_status varchar [note: 'Current workflow status of the ITV assessment record, driving underwriting action and coinsurance penalty determination.']
  assessment_type varchar [note: 'Business trigger category for this assessment: new business underwriting, renewal review, mid-term endorsement, post-loss, or regulatory requirement.']
  assessor_credential varchar [note: 'Professional credential or license of the assessor (e.g., MAI, ASA, SRA), supporting regulatory and E&O defensibility.']
  assessor_name varchar [note: 'Name of the individual, firm, or automated service that performed the ITV assessment (e.g., Marshall Swift, CoreLogic, staff appraiser).']
  coinsurance_pct decimal(5,2) [note: 'Contractual coinsurance percentage required by the policy (e.g., 80%, 90%, 100%) against which the ITV ratio is evaluated.']
  coinsurance_penalty_flag boolean [note: 'Indicates whether the insured property is underinsured relative to the coinsurance requirement, triggering a proportional loss penalty.']
  construction_type varchar [note: 'ISO COPE construction classification of the insured building, a primary driver of replacement cost and fire loss severity.']
  cost_index_factor decimal(8,4) [note: 'Regional construction cost index factor from the valuation model (e.g., Marshall Swift regional multiplier) applied to base replacement cost.']
  created_timestamp timestamp [note: 'Timestamp when this ITV assessment record was first created in the system, used for audit trail and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this assessment record (e.g., USD, CAD).']
  data_source varchar [note: 'Originating system or data feed that supplied this ITV assessment record (e.g., Guidewire PolicyCenter, Verisk, CoreLogic).']
  effective_date date [note: 'Date from which this ITV assessment is considered binding for underwriting, rating, and coinsurance penalty calculations.']
  expiry_date date [note: 'Date after which this ITV assessment is no longer valid and a new assessment must be ordered before policy renewal.']
  inflation_guard_pct decimal(5,2) [note: 'Annual inflation guard percentage applied to the insured value to keep pace with construction cost inflation between assessments.']
  itv_ratio decimal(7,4) [note: 'ITV ratio computed as reported TIV divided by assessed RCV. A ratio below the coinsurance threshold triggers a penalty flag.']
  number_of_stories varchar [note: 'Number of above-grade stories in the insured building, influencing replacement cost per square foot in valuation models.']
  occupancy_code varchar [note: 'ISO COPE occupancy classification code describing the primary use of the insured building (e.g., office, retail, manufacturing).']
  protection_class varchar [note: 'ISO Public Protection Classification (PPC) code (1–10) for the insured location, reflecting fire suppression capability and affecting property rates.']
  report_reference_number varchar [note: 'External reference number of the valuation report or certificate issued by the assessment vendor, used for document retrieval.']
  reported_tiv decimal(18,2) [note: 'Total Insured Value (TIV) as declared by the insured or broker on the policy application or schedule of values.']
  roof_material varchar [note: 'Primary roofing material of the insured structure, used in replacement cost estimation and CAT wind/hail underwriting.']
  roof_type varchar [note: 'Roof geometry classification of the insured structure, affecting both replacement cost estimation and wind/hail loss susceptibility.']
  roof_year varchar [note: 'Year the current roof was installed or last replaced, used in depreciation schedules and wind/hail underwriting eligibility.']
  sprinkler_flag boolean [note: 'Indicates whether the insured building is equipped with an automatic fire sprinkler system, qualifying for rate credits.']
  total_area_sqft decimal(12,2) [note: 'Total gross floor area of the insured structure in square feet, used as the primary size input for replacement cost estimation.']
  underinsurance_gap decimal(18,2) [note: 'Dollar shortfall between the assessed RCV and the reported TIV, representing the monetary exposure from underinsurance at this location.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this ITV assessment record, supporting audit trail and change tracking.']
  uw_action_taken varchar [note: 'Underwriting disposition recorded after review of the ITV assessment findings (e.g., limit increased, coinsurance waived, declined).']
  uw_review_required_flag boolean [note: 'Indicates that the ITV ratio or assessment findings require underwriter review before binding or renewal, triggering a UW referral.']
  uw_reviewed_date date [note: 'Date on which the underwriter completed review of the ITV assessment and recorded the UW action taken.']
  valuation_basis varchar [note: 'Policy valuation basis applied at this location: Replacement Cost Value (RCV), Actual Cash Value (ACV), Functional RCV, or Agreed Value.']
  year_built varchar [note: 'Four-digit year the insured structure was originally constructed, used in depreciation and replacement cost calculations.']

  Note: 'Insurance-to-Value (ITV) assessment records for insured property locations. Captures assessed replacement cost value (RCV), reported TIV, ITV ratio, assessment method (Marshall Swift, CoreLogic), and coinsurance penalty flag.'
}

Table coverage.coverage_peril {
  coverage_peril_id varchar [pk, note: 'Unique surrogate identifier for each coverage-peril association record in the junction table.']
  coverage_policy_coverage_id varchar [note: 'Reference to the coverage form or coverage line to which this peril association belongs.']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Peril association effective dates determine coverage applicability at loss date. New FK needed for temporal tracking and claims adjudication.']
  limit_id varchar [note: 'Reference to a sublimit definition record that caps the insurer\'s liability for this specific peril within the broader coverage limit.']
  peril_coverage_peril_id varchar [note: 'Reference to the peril definition record that is being associated with the coverage form.']
  aggregate_deductible_amount decimal(18,2) [note: 'Maximum total deductible the insured must pay for all losses from this peril in a policy period before the deductible is exhausted and full coverage applies.']
  association_status varchar [note: 'Current lifecycle status of this coverage-peril association record (ACTIVE, INACTIVE, PENDING approval, SUPERSEDED by endorsement, or WITHDRAWN).']
  cat_designation_flag boolean [note: 'Indicates whether this peril is classified as a catastrophe event for reinsurance treaty and reserving purposes.']
  cat_event_type varchar [note: 'Specific catastrophe event classification when CAT designation flag is true, used for CAT modeling and PML calculation. [ENUM-REF-CANDIDATE: hurricane|tornado|earthquake|flood|wildfire|hail|windstorm|other|none — 9 candidates stripped; promote to']
  cat_peril_code varchar [note: 'Industry-standard CAT peril code used in catastrophe modeling and reinsurance bordereaux (e.g., HU for Hurricane, EQ for Earthquake, FL for Flood, WS for Windstorm).']
  cat_peril_flag boolean [note: 'Indicates whether this peril is classified as a catastrophe (CAT) peril for reinsurance treaty cession, PML modeling, and statutory CAT reporting purposes.']
  cat_xl_applicable_flag boolean [note: 'Indicates whether this peril is covered under catastrophe excess of loss reinsurance treaties.']
  coinsurance_percentage decimal(7,4) [note: 'Coinsurance percentage applicable to this peril, requiring the insured to maintain coverage at a specified percentage of TIV to avoid penalty at loss settlement.']
  coverage_form_edition_date date [note: 'Edition date of the coverage form version under which this peril association is defined, ensuring correct form version is applied for rating and claims.']
  coverage_form_number varchar [note: 'ISO or proprietary form number of the coverage form to which this peril is attached (e.g., ISO CP 00 10, HO 00 03). Used for rate filing and regulatory compliance.']
  coverage_peril_category varchar [note: 'High-level classification grouping perils by origin or nature for underwriting and rating purposes. [ENUM-REF-CANDIDATE: natural|man-made|liability|theft|weather|fire|water|other — 8 candidates stripped; promote to reference product]']
  coverage_peril_code varchar [note: 'Standard industry code identifying the peril, typically ISO or carrier-specific classification code.']
  coverage_peril_description varchar [note: 'Detailed definition of the peril including scope of covered loss events and typical manifestations.']
  coverage_peril_name varchar [note: 'Full business name of the peril as recognized in policy forms and coverage documentation.']
  coverage_peril_status varchar [note: 'Current lifecycle status of the peril definition in the reference catalog.']
  coverage_trigger varchar [note: 'Defines the event or condition that activates coverage for this peril under policy terms.']
  created_timestamp timestamp [note: 'Timestamp when this coverage-peril association record was first created in the data platform, used for audit trail and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this coverage-peril record (e.g., USD, CAD, GBP).']
  deductible_amount decimal(18,2) [note: 'Peril-level deductible override amount that applies specifically to this peril on this coverage, superseding the coverage-level deductible where applicable.']
  deductible_basis varchar [note: 'Basis on which the peril deductible is applied: per occurrence, per claim, annual aggregate, per location, or per unit.']
  deductible_percentage decimal(7,4) [note: 'Percentage used when peril_deductible_type is PERCENTAGE, expressed as a decimal (e.g., 0.02 = 2% of TIV). Null for flat deductibles.']
  deductible_type varchar [note: 'Type of deductible applied to this peril (e.g., FLAT dollar, PERCENTAGE of loss or TIV, FRANCHISE, DISAPPEARING, SPLIT). Governs how deductible_amount is applied.']
  effective_date date [note: 'Date on which this coverage-peril association becomes effective, aligning with policy inception or endorsement effective date.']
  endorsement_number varchar [note: 'Endorsement number that introduced or modified this coverage-peril association. Null if the association originates from the base policy form.']
  endorsement_type_code varchar [note: 'Type of endorsement action that created this peril association: ADD a new peril, REMOVE an existing peril, MODIFY terms, RESTRICT coverage, or EXTEND coverage.']
  excluded_by_default_flag boolean [note: 'Indicates whether this peril is excluded by default in standard forms and requires explicit endorsement for coverage.']
  exclusion_description varchar [note: 'Free-text description of the specific exclusion language or endorsement wording applied when the peril is excluded from coverage.']
  exclusion_reason_code varchar [note: 'Standardized code describing why the peril is excluded when insured_flag is False (e.g., FLOOD_ZONE, WAR, NUCLEAR, WEAR_TEAR). Null when peril is covered. [ENUM-REF-CANDIDATE: FLOOD_ZONE|WAR|NUCLEAR|WEAR_TEAR|INTENTIONAL|REGULATORY|OTHER — promote to']
  expiration_date date [note: 'Date on which this coverage-peril association expires, aligning with policy expiration or endorsement termination date. Null for open-ended associations.']
  frequency_rating varchar [note: 'Typical loss frequency classification for underwriting and pricing purposes based on historical claim data.']
  geographic_scope varchar [note: 'Typical geographic extent of loss events for this peril, used for exposure aggregation and PML modeling.']
  group_code varchar [note: 'Higher-level grouping code for the peril (e.g., CAT, NON-CAT, LIABILITY, THEFT). Used for aggregation in actuarial and reinsurance reporting. [ENUM-REF-CANDIDATE: CAT|NON_CAT|LIABILITY|THEFT|WEATHER|FIRE|OTHER — promote to reference product]']
  insurable_flag boolean [note: 'Indicates whether this peril is generally insurable under standard P&C policies or typically excluded.']
  insured_flag boolean [note: 'Indicates whether the peril is covered (True) or excluded (False) under the associated coverage form. Core junction discriminator.']
  iso_peril_code varchar [note: 'ISO/Verisk standardized peril code used for industry statistical reporting, rate filings, and CLUE data exchange.']
  last_updated_timestamp timestamp [note: 'Timestamp when this peril record was last modified in the reference catalog.']
  lob varchar [note: 'Primary line of business where this peril is most commonly insured, such as GL, CGL, BOP, WC, APD, or property.']
  lob_code varchar [note: 'Line of business to which this coverage-peril association applies (e.g., GL, CGL, BOP, WC, APD, HO). Drives LOB-specific peril eligibility rules. [ENUM-REF-CANDIDATE: GL|CGL|BOP|WC|APD|HO|CPP|IM|MARINE|UMBRELLA|EXCESS — 11 candidates stripped; promote to']
  loss_settlement_basis varchar [note: 'Basis on which losses from this peril are settled: occurrence-based, claims-made, or reporting form. Determines trigger and coverage period for peril losses.']
  mandatory_peril_flag boolean [note: 'Indicates whether this peril is mandatory under the coverage form and cannot be excluded by the insured (True) or is optional (False).']
  naic_peril_code varchar [note: 'NAIC statistical peril code used in Annual Statement Schedule P and other statutory filings for loss reporting by cause of loss.']
  nfip_overlap_indicator boolean [note: 'Indicates whether this peril overlaps with NFIP coverage, requiring coordination of benefits and exclusion language.']
  pml_modeling_required_flag boolean [note: 'Indicates whether this peril requires PML modeling for exposure management and capital adequacy assessment.']
  premium_amount decimal(18,2) [note: 'Portion of the written premium allocated to this specific peril within the coverage, used for peril-level profitability analysis and reinsurance pricing.']
  rate decimal(12,6) [note: 'Rate per unit of exposure (e.g., per $100 of TIV) applied to this peril for premium calculation purposes, sourced from the filed rate manual.']
  regulatory_reporting_required_flag boolean [note: 'Indicates whether losses from this peril require special regulatory reporting to state DOI or NAIC.']
  reinsurance_peril_code varchar [note: 'Peril code used in reinsurance treaty and facultative (FAC) cession reporting and bordereaux submissions to reinsurers.']
  reinsurance_treaty_applicable_flag boolean [note: 'Indicates whether this peril is typically covered under reinsurance treaties or requires facultative placement.']
  retroactive_date date [note: 'Earliest date from which losses from this peril are covered under a claims-made form. Null for occurrence-based perils.']
  scheduled_peril_flag boolean [note: 'Indicates whether this peril is on a named/scheduled basis (True) requiring specific listing, versus an open-peril or all-risk basis (False).']
  severity_rating varchar [note: 'Typical loss severity classification for underwriting and pricing purposes based on historical claim data.']
  sir_amount decimal(18,2) [note: 'Self-Insured Retention amount the insured must absorb for losses from this peril before the insurer\'s coverage obligation is triggered.']
  source_system_code varchar [note: 'Identifies the originating policy administration system that created this coverage-peril record (e.g., GUIDEWIRE, DUCK_CREEK, SAPIENS, MANUAL entry, or MIGRATION).']
  source_system_record_code varchar [note: 'Native record identifier from the originating policy administration system, enabling traceability and reconciliation back to the system of record.']
  sublimit_amount decimal(18,2) [note: 'Maximum insurer liability for losses arising from this specific peril, acting as a sublimit within the overall coverage limit. Null if no peril-specific sublimit applies.']
  sublimit_basis varchar [note: 'Basis on which the peril sublimit is applied: per occurrence, per claim, annual aggregate, or per location. Governs how peril_sublimit_amount is consumed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this coverage-peril association record, supporting change tracking and audit compliance.']
  valuation_method varchar [note: 'Method used to value losses for this peril: Actual Cash Value (ACV), Replacement Cost Value (RCV), Agreed Value, Functional Replacement Cost, or Market Value.']
  version_number varchar [note: 'Version identifier for this peril definition, incremented when definition or classification changes.']
  waiting_period_days varchar [note: 'Number of days after policy inception or peril trigger before coverage for this peril becomes effective (e.g., flood waiting period under NFIP-aligned policies).']

  Note: 'Reference catalog of insured and excluded perils (fire, wind, hail, flood, earthquake, theft, liability). Stores ISO peril code, peril category, CAT designation flag, and NFIP overlap indicator.'
}

Table coverage.peril {
  peril_id varchar [pk, note: 'Primary key for peril']
  coverage_policy_coverage_id varchar [note: 'Auto-generated FK linking siloed peril to policy_coverage']

  Note: 'Junction table associating coverage forms with the specific perils they insure or exclude. Carries insured/excluded flag, sublimit linkage, and peril-specific deductible override for each coverage-peril combination.'
}

Table coverage.waiver_of_subrogation {
  waiver_of_subrogation_id varchar [pk, note: 'Unique surrogate identifier for the waiver of subrogation endorsement record on the Databricks Silver Layer.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage line under the policy to which this waiver of subrogation applies.']
  document_id varchar [note: 'Reference identifier to the endorsement document stored in the content management system (OpenText or FileNet) for audit and compliance retrieval.']
  endorsement_id varchar [note: 'Foreign key linking to coverage.endorsement. Business justification: Waiver of subrogation is implemented via endorsement. The waiver_of_subrogation table has endorsement_number and endorsement_form_number as strings but lacks FK to endorsement record.']
  policy_id varchar [note: 'Reference to the parent policy to which this waiver of subrogation endorsement is attached.']
  risk_unit_id varchar [note: 'Reference to the specific risk exposure (insured location, vehicle, or employee group) to which this waiver of subrogation is scoped.']
  version_id varchar [note: 'Reference to the specific policy term period during which this waiver of subrogation endorsement is in force.']
  additional_premium decimal(18,2) [note: 'Additional premium charged to the insured for adding the waiver of subrogation endorsement, expressed in the policy currency.']
  beneficiary_fein varchar [note: 'Federal Employer Identification Number (FEIN) of the beneficiary organization, used for tax reporting and identity verification.']
  beneficiary_name varchar [note: 'Full legal name of the third-party entity granted immunity from subrogation recovery actions under this endorsement.']
  beneficiary_relationship varchar [note: 'Contractual or business relationship between the named insured and the waiver beneficiary (e.g., contractor, lessor). [ENUM-REF-CANDIDATE: additional_insured|contractor|subcontractor|lessor|lessee|mortgagee|owner|joint_venture|other — promote to reference']
  beneficiary_type varchar [note: 'Classification of the waiver beneficiary entity type, used for regulatory reporting and underwriting analytics.']
  blanket_waiver_flag boolean [note: 'Indicates whether this waiver of subrogation applies on a blanket basis to all parties with whom the insured has a written contract requiring such waiver.']
  cancellation_date date [note: 'Date on which the waiver of subrogation endorsement was cancelled mid-term, if applicable. Null for endorsements that run to expiration.']
  cancellation_reason varchar [note: 'Reason code for mid-term cancellation of the waiver endorsement. Null if the endorsement was not cancelled.']
  contractual_requirement_flag boolean [note: 'Indicates whether this waiver of subrogation was required by a written contract between the insured and the beneficiary prior to policy issuance.']
  coverage_scope varchar [note: 'Defines whether the waiver applies on a blanket basis to all qualifying parties, or is scheduled to specific named beneficiaries, projects, or locations.']
  created_timestamp timestamp [note: 'Timestamp when this waiver of subrogation record was first created in the Databricks Silver Layer, used for data lineage and audit trail.']
  effective_date date [note: 'Date on which the waiver of subrogation endorsement becomes effective and the insurer relinquishes recovery rights against the named beneficiary.']
  endorsement_status varchar [note: 'Current lifecycle status of the waiver of subrogation endorsement within the policy administration workflow.']
  exclusion_notes varchar [note: 'Free-text notes describing any exclusions or carve-outs from the waiver of subrogation, such as gross negligence or intentional acts exceptions.']
  expiration_date date [note: 'Date on which the waiver of subrogation endorsement expires. Null indicates the waiver runs co-terminus with the policy term.']
  lob_code varchar [note: 'NAIC or internal Line of Business (LOB) code identifying the insurance line under which this waiver is issued (e.g., GL, WC, APD, BOP).']
  location_description varchar [note: 'Free-text description of the insured location or job site address to which a location-specific waiver of subrogation is restricted.']
  naic_line_code varchar [note: 'NAIC statutory line of business code used for regulatory annual statement reporting associated with this waiver endorsement.']
  premium_basis varchar [note: 'Basis on which the additional premium for the waiver endorsement is calculated (e.g., flat charge, percentage of base premium, payroll).']
  premium_currency_code varchar [note: 'ISO 4217 three-letter currency code for the additional premium charged for this waiver endorsement (e.g., USD, CAD).']
  project_name varchar [note: 'Name of the specific construction project, contract, or job site to which a project-specific waiver of subrogation applies. Null for blanket waivers.']
  project_number varchar [note: 'External project or contract number associated with a project-specific waiver, enabling cross-reference to the insured\'s contract management system.']
  regulatory_filing_required_flag boolean [note: 'Indicates whether this waiver of subrogation endorsement form requires a separate regulatory filing with the state Department of Insurance.']
  regulatory_filing_status varchar [note: 'Current status of the regulatory form filing for this waiver endorsement with the applicable state Department of Insurance.']
  reinsurance_eligible_flag boolean [note: 'Indicates whether the coverage subject to this waiver of subrogation endorsement is eligible for cession under reinsurance treaties.']
  source_system_code varchar [note: 'Code identifying the policy administration system of record from which this waiver of subrogation record was sourced.']
  source_system_reference_code varchar [note: 'Native primary key or reference identifier of this waiver record in the originating policy administration system, used for data lineage and reconciliation.']
  state_code varchar [note: 'Two-letter US state code of the jurisdiction where the waiver of subrogation endorsement is filed and effective.']
  subrogation_rights_description varchar [note: 'Free-text description of the specific subrogation rights being waived, including any limitations or conditions on the scope of the waiver.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this waiver of subrogation record in the Databricks Silver Layer, supporting change tracking and audit.']
  uw_approval_date date [note: 'Date on which the underwriter approved the waiver of subrogation endorsement. Null if UW approval was not required.']
  uw_approval_required_flag boolean [note: 'Indicates whether underwriting authority approval was required before binding this waiver of subrogation endorsement.']
  uw_approved_by varchar [note: 'Name or user ID of the underwriter who approved this waiver of subrogation endorsement when UW authority was required.']
  waiver_type varchar [note: 'Classification of the waiver of subrogation as blanket (all parties), specific (named party), contractual (per contract requirement), or statutory.']
  wc_class_code varchar [note: 'NCCI Workers Compensation (WC) class code applicable when the waiver is issued under a WC policy, driving the premium surcharge calculation.']

  Note: 'Waiver of subrogation endorsement records granting a third party immunity from recovery actions. Captures beneficiary name, relationship, endorsement form number, and effective coverage scope.'
}

Table coverage.exposure {
  exposure_id varchar [pk, note: 'Unique identifier for the coverage exposure junction record linking policy coverage to insured exposures.']
  coverage_policy_coverage_id varchar [note: 'Reference to the policy coverage record that applies to this exposure.']
  deductible_id varchar [note: 'Foreign key linking to coverage.deductible. Business justification: Exposure records capture deductible_amount and deductible_type inline, but the deductible table contains structured deductible records with full details (flat, percentage, split']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Exposure effective dates drive premium earning and loss development analysis. New FK needed for temporal analytics and accident year assignment.']
  endorsement_id varchar [note: 'Foreign key linking to coverage.endorsement. Business justification: Exposure records can be added or modified via endorsements (e.g., adding a new location, vehicle, or scheduled item).']
  insured_location_id varchar [note: 'Reference to the insured location exposure when coverage applies to a fixed property location.']
  insured_vehicle_id varchar [note: 'Reference to the scheduled vehicle exposure when coverage applies to an auto or fleet vehicle.']
  limit_id varchar [note: 'Foreign key linking to coverage.limit. Business justification: Exposure records capture occurrence_limit, aggregate_limit, and sublimit_amount inline, but the limit table contains structured limit records with full details (limit type, basis, application']
  scheduled_item_id varchar [note: 'Reference to the scheduled item exposure when coverage applies to a specific valuable or equipment piece.']
  sir_layer_id varchar [note: 'Foreign key linking to coverage.sir_layer. Business justification: Exposure records capture sir_amount inline, but the sir_layer table contains structured SIR records with full details (aggregate cap, erosion basis, defense inside/outside, ALAE treatment']
  cat_exposed_flag boolean [note: 'Indicates whether this exposure is subject to catastrophe perils such as hurricane, earthquake, or flood.']
  coinsurance_percentage decimal(5,2) [note: 'Coinsurance percentage requirement for this exposure, typically 80%, 90%, or 100% of replacement cost.']
  construction_type varchar [note: 'ISO construction type classification for this exposure used in property rating and underwriting.']
  coverage_scope varchar [note: 'Scope of coverage application: specific to this exposure, blanket across multiple exposures, scheduled list, or floating.']
  created_timestamp timestamp [note: 'Timestamp when this coverage exposure record was first created in the system.']
  earned_premium_amount decimal(18,2) [note: 'Earned premium for this coverage exposure as of the current accounting period.']
  effective_date date [note: 'Date when coverage begins applying to this specific exposure.']
  exclusion_codes varchar [note: 'Comma-separated list of exclusion codes that apply to this coverage exposure limiting covered perils or losses.']
  expiration_date date [note: 'Date when coverage ceases to apply to this specific exposure.']
  exposure_status varchar [note: 'Current lifecycle status of the coverage exposure assignment.']
  exposure_type varchar [note: 'Classification of the exposure being covered: fixed location, vehicle, scheduled item, blanket, or floating.']
  itv_ratio decimal(5,4) [note: 'Ratio of insured limit to actual replacement cost value for this exposure, used to assess coinsurance compliance.']
  lob_code varchar [note: 'Line of business code applicable to this coverage exposure such as GL, CGL, BOP, WC, APD, or CPP.']
  occupancy_code varchar [note: 'ISO occupancy classification code describing the use of the property or vehicle at this exposure.']
  pml_amount decimal(18,2) [note: 'Probable maximum loss estimate for this exposure used in catastrophe modeling and reinsurance placement.']
  premium_currency_code varchar [note: 'ISO 4217 three-letter currency code for premium amounts on this exposure.']
  protection_class varchar [note: 'ISO Public Protection Classification or similar fire protection rating for this exposure location.']
  reference_number varchar [note: 'Business-readable identifier for this coverage exposure assignment used in policy documents and bordereaux.']
  reinsurance_eligible_flag boolean [note: 'Indicates whether this coverage exposure is eligible for reinsurance cession under treaty or facultative agreements.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this coverage exposure, such as PolicyCenter or Duck Creek Policy.']
  state_code varchar [note: 'Two-letter state code where this exposure is located and subject to regulatory jurisdiction.']
  territory_code varchar [note: 'Rating territory code applicable to this exposure for premium calculation and risk classification.']
  tiv_amount decimal(18,2) [note: 'Total insured value for this specific exposure representing maximum property value at risk.']
  unearned_premium_amount decimal(18,2) [note: 'Unearned premium remaining for this coverage exposure representing future coverage obligation.']
  updated_timestamp timestamp [note: 'Timestamp when this coverage exposure record was last modified.']
  valuation_method varchar [note: 'Method used to value losses for this exposure: Actual Cash Value, Replacement Cost Value, agreed value, stated amount, or market value.']
  waiting_period_days varchar [note: 'Number of days after loss occurrence before coverage begins paying for this exposure, common in business interruption.']
  written_premium_amount decimal(18,2) [note: 'Written premium allocated to this specific coverage exposure for the policy term.']

  Note: 'Junction resolving the M:N between coverage_policy_coverage and insured exposures (insured_location, scheduled_vehicle, scheduled_item). Carries applied limit, deductible, and coverage scope per exposure.'
}

Table coverage.cession {
  cession_id varchar [pk, note: 'Unique surrogate primary key for each coverage cession record.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to the specific policy coverage being ceded to the reinsurer.']
  reinsurer_id varchar [note: 'Foreign key linking to the reinsurer counterparty accepting the ceded risk.']
  ri_treaty_id varchar [note: 'Foreign key reference to the reinsurance treaty under which this cession is placed, if treaty reinsurance.']
  ceded_limit_amount decimal(18,2) [note: 'Maximum dollar amount of coverage limit ceded to this reinsurer under this cession.']
  ceded_premium_amount decimal(18,2) [note: 'Gross premium amount ceded to this reinsurer for this coverage under the cession arrangement.']
  ceded_share_pct decimal(7,4) [note: 'Percentage of the coverage risk ceded to this reinsurer, expressed as decimal (0.25 = 25%).']
  collateral_held_amount decimal(18,2) [note: 'Dollar amount of collateral held from this reinsurer to secure recoverables under this cession.']
  commission_pct decimal(7,4) [note: 'Commission percentage paid by the reinsurer to the ceding company on ceded premium.']
  effective_date date [note: 'Date on which this reinsurer\'s participation in the coverage cession becomes effective.']
  expiration_date date [note: 'Date on which this reinsurer\'s participation in the coverage cession expires.']
  facultative_certificate_number varchar [note: 'Certificate number for facultative reinsurance placement, if this cession is facultative rather than treaty.']
  participation_status varchar [note: 'Current lifecycle status of this reinsurer participation in the coverage cession.']
  recoverable_balance decimal(18,2) [note: 'Outstanding balance of claim recoveries due from this reinsurer for this coverage as of reporting date.']
  settlement_status varchar [note: 'Current status of financial settlement between cedant and reinsurer for this cession.']

  Note: 'Represents the cession of a specific policy coverage to a reinsurer. Captures the reinsurer\'s participation share, ceded limits, recoverable balances, and settlement status for each coverage-reinsurer combination..'
}

Table coverage.product {
  product_id varchar [pk, note: 'Primary key for product']
  aggregate_limit_applies boolean [note: 'Indicates whether an annual aggregate limit of liability applies to this product in addition to per-occurrence limits.']
  audit_required boolean [note: 'Indicates whether policies written under this product require a premium audit at policy expiration to adjust premium based on actual exposures.']
  cancellation_allowed boolean [note: 'Indicates whether policies written under this product may be cancelled mid-term by the insurer, subject to regulatory notice requirements.']
  catastrophe_exposure_flag boolean [note: 'Indicates whether this product carries exposure to catastrophic perils such as hurricane, earthquake, or wildfire.']
  claims_made_retroactive_date date [note: 'Default retroactive date for claims-made products, establishing the earliest date of occurrence for which claims will be covered.']
  commission_rate_percent decimal(5,2) [note: 'Standard commission percentage paid to agents or brokers for policies written under this product.']
  coverage_basis varchar [note: 'Trigger basis for coverage: occurrence-based, claims-made, or claims-made-and-reported.']
  created_by_user varchar [note: 'Username or identifier of the user who created this product record.']
  created_timestamp timestamp [note: 'Timestamp when this product record was first created in the system.']
  default_deductible_amount decimal(15,2) [note: 'Standard deductible amount applied to claims under this product unless overridden at the policy or coverage level.']
  default_limit_amount decimal(15,2) [note: 'Standard per-occurrence or aggregate limit of liability for this product unless overridden at the policy or coverage level.']
  endorsement_allowed boolean [note: 'Indicates whether mid-term endorsements and policy changes are permitted for policies written under this product.']
  extended_reporting_period_months varchar [note: 'Standard duration in months for the extended reporting period tail coverage available for claims-made products.']
  filing_effective_date date [note: 'Date on which the regulatory filing became effective and the product became available for new business.']
  filing_expiration_date date [note: 'Date on which the regulatory filing expires or is superseded, after which the product may no longer be sold.']
  form_edition_date date [note: 'Edition date of the base coverage form, indicating the version of policy language in use.']
  form_number varchar [note: 'Primary ISO or proprietary form number for the base coverage form, such as CG 00 01, HO 00 03, or CA 00 01.']
  installment_billing_allowed boolean [note: 'Indicates whether premium for policies under this product may be paid in installments rather than in full at inception.']
  iso_class_code varchar [note: 'ISO general liability or workers compensation classification code associated with the product for rating and exposure analysis.']
  line_of_business varchar [note: 'Primary line of business classification for the product: personal auto, commercial auto, homeowners, commercial property, general liability, or workers compensation.']
  maximum_premium_amount decimal(15,2) [note: 'Maximum allowable premium for a single policy under this product, used for underwriting authority limits.']
  minimum_premium_amount decimal(15,2) [note: 'Minimum earned premium required for a policy written under this product, enforced at policy issuance or audit.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this product record.']
  modified_timestamp timestamp [note: 'Timestamp when this product record was last modified in the system.']
  ncci_class_code varchar [note: 'NCCI classification code for workers compensation products, used for rating and loss cost determination.']
  new_business_allowed boolean [note: 'Indicates whether new policies may be written under this product; false if product is closed to new business but renewals continue.']
  non_renewal_allowed boolean [note: 'Indicates whether the insurer may elect not to renew policies written under this product at expiration, subject to regulatory notice requirements.']
  policy_term_months varchar [note: 'Standard policy term duration in months for this product, typically 6, 12, or 24 months.']
  product_code varchar [note: 'Externally-known unique alphanumeric code identifying the product in catalogs, rating systems, and policy administration systems.']
  product_description varchar [note: 'Detailed narrative describing the coverage intent, target market, and key features of the product.']
  product_name varchar [note: 'Human-readable name of the insurance product as marketed to agents, brokers, and insureds.']
  product_status varchar [note: 'Current lifecycle status of the product: active for new business, inactive, withdrawn from market, or pending regulatory approval.']
  product_type varchar [note: 'Structural classification of the product: monoline, package, umbrella, excess, or business owners policy.']
  rating_plan_code varchar [note: 'Code identifying the rating algorithm, factor tables, and premium calculation methodology used for this product.']
  regulatory_filing_number varchar [note: 'State insurance department filing or SERFF tracking number for the approved product and rates.']
  reinsurance_treaty_applicable boolean [note: 'Indicates whether policies written under this product are automatically ceded to a reinsurance treaty.']
  renewal_allowed boolean [note: 'Indicates whether existing policies may be renewed under this product; false if product is being phased out.']
  reporting_form_flag boolean [note: 'Indicates whether this product uses a reporting form structure requiring periodic exposure or value reports from the insured.']
  self_insured_retention_amount decimal(15,2) [note: 'Standard self-insured retention amount that the insured must pay before coverage attaches, common in umbrella and excess products.']
  state_availability varchar [note: 'Comma-separated list of two-letter state codes where this product is approved for sale and binding.']
  target_market_segment varchar [note: 'Description of the intended customer segment or industry vertical for this product, such as small business, contractors, or high-net-worth individuals.']
  underwriting_tier varchar [note: 'Risk tier classification for the product: preferred, standard, non-standard, or specialty.']

  Note: 'Master reference table for product. Referenced by product_id.'
}

Table premium.written_premium {
  written_premium_id varchar [pk, note: 'Unique identifier for the written premium transaction record.']
  agency_id varchar [note: 'Reference to the agency responsible for this written premium transaction.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Premium accounting requires calendar reference for fiscal period determination, month-end close processing, statutory reporting deadlines, and financial statement preparation.']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: Audit premium adjustments and return premium on total loss claims require tracking which claim triggered the premium write-off.']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: International premium transactions require country reference for currency determination, regulatory regime identification, reinsurance domicile rules, and sanctions compliance.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage for which premium was written, if applicable at coverage level.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Premium transactions in multiple currencies require currency master reference for exchange rate application, rounding rules, display formatting, and financial consolidation.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Premium transactions must link to LOB master for statutory line classification, RBC factor application, loss ratio analysis, reinsurance treaty assignment, and regulatory reporting.']
  policy_id varchar [note: 'Reference to the policy for which this premium was written.']
  producers_producer_id varchar [note: 'Reference to the producer, agent, or broker who originated this written premium transaction.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Premium transactions require state reference for regulatory reporting, rate filing compliance, statutory accounting by jurisdiction, and premium tax calculation.']
  ceded_premium_amount decimal(18,2) [note: 'Portion of gross written premium ceded to reinsurers under treaty or facultative agreements.']
  commission_amount decimal(18,2) [note: 'Total commission payable to producers, agents, or brokers for this written premium transaction.']
  commission_rate decimal(5,4) [note: 'Commission percentage applied to the written premium to calculate commission amount.']
  created_timestamp timestamp [note: 'Timestamp when this written premium record was first created in the system.']
  experience_mod_factor decimal(5,4) [note: 'Experience modification factor applied to manual premium based on the insureds historical loss experience.']
  exposure_basis varchar [note: 'Unit of measure for exposure, such as per $100 payroll, per vehicle, per square foot, or per $1000 insured value.']
  exposure_units decimal(18,4) [note: 'Quantity of exposure units used in premium calculation, such as payroll, vehicle count, or square footage.']
  gwp_amount decimal(18,2) [note: 'Total premium written before any deductions for reinsurance or commissions.']
  installment_count varchar [note: 'Total number of installments in the payment plan for this written premium, if applicable.']
  installment_fee_amount decimal(18,2) [note: 'Fee charged for installment payment plans, if applicable to this premium transaction.']
  is_audit_premium boolean [note: 'Indicates whether this written premium transaction resulted from a policy audit adjustment.']
  is_installment_plan boolean [note: 'Indicates whether this written premium is part of an installment payment plan.']
  last_modified_timestamp timestamp [note: 'Timestamp when this written premium record was last updated or modified.']
  manual_premium_amount decimal(18,2) [note: 'Premium calculated using standard manual rates before application of experience modifications or schedule credits.']
  nwp_amount decimal(18,2) [note: 'Net premium retained after ceding to reinsurers; calculated as GWP minus ceded premium.']
  policy_fee_amount decimal(18,2) [note: 'Administrative or policy issuance fee charged in addition to premium.']
  policy_term_effective_date date [note: 'Start date of the policy term to which this written premium applies.']
  policy_term_expiration_date date [note: 'End date of the policy term to which this written premium applies.']
  premium_basis_amount decimal(18,2) [note: 'Base amount used in premium calculation before application of rates, modifiers, and adjustments.']
  premium_tax_amount decimal(18,2) [note: 'State or local premium tax assessed on this written premium transaction.']
  product_code varchar [note: 'Internal product code identifying the specific insurance product for this written premium.']
  rate_effective_date date [note: 'Date when the rating plan or rate table became effective for use in premium calculations.']
  rate_version varchar [note: 'Version identifier of the rating plan or rate table used for this premium calculation.']
  rating_plan_code varchar [note: 'Code identifying the rating plan or algorithm used to calculate this written premium.']
  reversal_reason_code varchar [note: 'Code indicating the reason for reversing or voiding this written premium transaction, if applicable.']
  schedule_credit_amount decimal(18,2) [note: 'Credit applied to premium for favorable risk characteristics identified during underwriting.']
  schedule_debit_amount decimal(18,2) [note: 'Debit applied to premium for unfavorable risk characteristics identified during underwriting.']
  statutory_reporting_period varchar [note: 'Quarterly statutory reporting period in YYYY-Q# format for NAIC annual statement reporting.']
  total_billed_amount decimal(18,2) [note: 'Total amount billed to the policyholder including premium, taxes, and fees.']
  transaction_booking_date date [note: 'Date when this premium transaction was recorded in the financial system.']
  transaction_effective_date date [note: 'Date when this premium transaction becomes effective for accounting and coverage purposes.']
  transaction_type varchar [note: 'Type of premium transaction: new business, renewal, endorsement, cancellation, reinstatement, or audit adjustment.']
  underwriter_code varchar [note: 'Reference to the underwriter who approved the policy and premium for this transaction.']
  written_premium_status varchar [note: 'Current lifecycle status of this written premium transaction in the premium ledger.']

  Note: 'SSOT for gross written premium (GWP) transactions per policy term. Captures WP, NWP, ceded premium, and net retained amounts at policy/coverage level. Anchors the premium ledger for statutory and GAAP reporting.'
}

Table premium.earned_premium {
  earned_premium_id varchar [pk, note: 'Unique identifier for the earned premium transaction record.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Earned premium accounting requires calendar reference for fiscal period close, revenue recognition timing, and financial statement preparation. Accounting_period denormalized, replace with FK.']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: Loss ratio analysis and profitability reporting require matching earned premium to incurred losses at the policy-coverage level.']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Cross-border earned premium must reference country for IFRS17 revenue recognition, regulatory jurisdiction determination, and reinsurance domicile rules.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage under which premium is earned.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Earned premium in multiple currencies requires currency reference for exchange rate application, GAAP/IFRS revenue recognition, and financial consolidation.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Earned premium accounting requires LOB reference for loss ratio analysis, combined ratio calculation, statutory line reporting, and reinsurance cession determination.']
  original_earned_premium_id varchar [note: 'Reference to the original earned premium record if this is a reversal or adjustment.']
  policy_id varchar [note: 'Reference to the policy for which premium is being earned.']
  premium_transaction_id varchar [note: 'Unique identifier of the transaction in the source system.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Earned premium accounting requires state jurisdiction reference for statutory reporting periods, guaranty fund assessments, premium tax accrual, and regulatory compliance.']
  adjustment_description varchar [note: 'Detailed explanation of any adjustment made to the earned premium calculation.']
  adjustment_reason_code varchar [note: 'Code indicating the reason for any adjustment to the earned premium calculation.']
  calculation_timestamp timestamp [note: 'Date and time when the earned premium calculation was performed.']
  ceded_ep_amount decimal(18,2) [note: 'Portion of earned premium ceded to reinsurers during this period.']
  commission_amount decimal(18,2) [note: 'Commission expense allocated to this earned premium transaction.']
  commission_rate decimal(5,2) [note: 'Commission rate percentage applied to earned premium for producer compensation.']
  created_timestamp timestamp [note: 'Date and time when this earned premium record was first created in the system.']
  dac_amount decimal(18,2) [note: 'Deferred acquisition costs amortized in proportion to earned premium.']
  earned_premium_status varchar [note: 'Current processing status of the earned premium record.']
  earning_method varchar [note: 'Method used to calculate earned premium over the exposure period.']
  earning_percentage decimal(5,2) [note: 'Percentage of total premium earned during this accounting period.']
  effective_date date [note: 'Start date of the earning period for this premium transaction.']
  ep_amount decimal(18,2) [note: 'Amount of premium earned during the accounting period.']
  exchange_rate decimal(12,6) [note: 'Exchange rate applied to convert foreign currency premium to reporting currency.']
  expiration_date date [note: 'End date of the earning period for this premium transaction.']
  exposure_days varchar [note: 'Number of days of exposure covered by this earned premium transaction.']
  gaap_revenue_amount decimal(18,2) [note: 'Earned premium recognized as revenue under GAAP accounting standards.']
  gl_account_code varchar [note: 'General ledger account code to which this earned premium is posted.']
  gwp_amount decimal(18,2) [note: 'Total premium written before reinsurance cessions for this earning record.']
  ifrs17_revenue_amount decimal(18,2) [note: 'Earned premium recognized under IFRS 17 premium allocation approach.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the insurer earning the premium.']
  net_ep_amount decimal(18,2) [note: 'Earned premium retained by the insurer after reinsurance cessions.']
  nwp_amount decimal(18,2) [note: 'Written premium after reinsurance cessions for this earning record.']
  policy_term_months varchar [note: 'Total duration of the policy term in months for earning calculation.']
  posting_date date [note: 'Date when the earned premium was posted to the general ledger.']
  premium_tax_amount decimal(18,2) [note: 'Premium tax expense allocated to this earned premium transaction.']
  premium_tax_rate decimal(5,2) [note: 'State premium tax rate applied to earned premium.']
  reversal_flag boolean [note: 'Indicates whether this earned premium entry is a reversal of a prior transaction.']
  statutory_line_code varchar [note: 'NAIC statutory line of business code for regulatory reporting.']
  transaction_type varchar [note: 'Type of policy transaction that generated this earned premium entry.']
  uep_amount decimal(18,2) [note: 'Remaining unearned premium balance after this earning transaction.']
  updated_timestamp timestamp [note: 'Date and time when this earned premium record was last modified.']

  Note: 'Tracks EP recognized over the policy exposure period via pro-rata or short-rate earning methods. Supports UEP calculation, GAAP revenue recognition, and IFRS 17 premium allocation approach.'
}

Table premium.premium_transaction {
  premium_transaction_id varchar [pk, note: 'Unique identifier for the premium transaction record. Primary key.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Premium transactions must reference calendar for proper accounting period assignment, GL posting, and financial statement preparation. Accounting_period denormalized, replace with FK.']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: Return premium transactions on total loss claims require linking the premium adjustment back to the claim.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Premium transactions allocate to coverages for general ledger accounting, loss ratio tracking by coverage, reinsurance cession calculations, and statutory reporting.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Premium transactions must reference currency master for exchange rate application, payment processing, bank reconciliation, and multi-currency financial reporting.']
  endorsement_id varchar [note: 'Reference to the policy endorsement that triggered this premium transaction, if applicable.']
  installment_schedule_id varchar [note: 'Reference to the billing installment plan under which this premium transaction is scheduled for payment.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Premium transactions require LOB classification for accounting, reinsurance treaty assignment, commission calculation, and regulatory reporting. Lob_code denormalized, replace with FK.']
  policy_id varchar [note: 'Reference to the policy to which this premium transaction applies.']
  policy_transaction_id varchar [note: 'Reference to the policy cancellation event that triggered this premium transaction, if applicable.']
  producers_producer_id varchar [note: 'Reference to the agent, broker, or producer responsible for this premium transaction and entitled to commission.']
  reversed_transaction_premium_transaction_id varchar [note: 'Reference to the original premium transaction that this transaction reverses, if applicable.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty under which premium is ceded for this transaction, if applicable.']
  risk_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Risk location state drives rate filing compliance, surplus lines tax calculation, regulatory jurisdiction determination, and catastrophe exposure tracking.']
  audit_code varchar [note: 'Reference to the premium audit that resulted in this additional or return premium transaction, if applicable.']
  booking_date date [note: 'Date on which the premium transaction was recorded in the financial ledger and accounting system.']
  ceded_premium_amount decimal(18,2) [note: 'Portion of the gross written premium ceded to reinsurers under treaty or facultative agreements.']
  commission_amount decimal(18,2) [note: 'Total commission payable to producers, agents, or brokers for this premium transaction.']
  commission_rate decimal(5,4) [note: 'Percentage rate applied to calculate the commission amount payable to the producer for this transaction.']
  coverage_part_code varchar [note: 'Code identifying the specific coverage part or section of the policy to which this premium applies.']
  created_timestamp timestamp [note: 'Date and time when this premium transaction record was first created in the system.']
  dac_amount decimal(18,2) [note: 'Acquisition costs deferred and amortized over the policy term in accordance with GAAP accounting.']
  due_date date [note: 'Date by which the premium payment is due from the policyholder.']
  earned_premium_amount decimal(18,2) [note: 'Portion of the written premium that has been earned as of the transaction date based on policy exposure period.']
  effective_date date [note: 'Date on which the premium transaction becomes effective for policy coverage and accounting purposes.']
  exchange_rate decimal(12,6) [note: 'Foreign exchange rate applied to convert transaction amounts to the reporting currency, if applicable.']
  exposure_units decimal(18,4) [note: 'Number of exposure units used to calculate the premium for this transaction, such as payroll, sales, or vehicle count.']
  fee_amount decimal(18,2) [note: 'Administrative fees, policy fees, or service charges included in this premium transaction.']
  gl_account_code varchar [note: 'General ledger account code to which this premium transaction is posted in the financial accounting system.']
  gwp_amount decimal(18,2) [note: 'Total premium amount written before any deductions for reinsurance cessions or commissions.']
  installment_number varchar [note: 'Sequential number of the installment within the billing plan, if this transaction is part of an installment schedule.']
  modified_timestamp timestamp [note: 'Date and time when this premium transaction record was last modified or updated.']
  nwp_amount decimal(18,2) [note: 'Net premium retained by the insurer after deducting ceded reinsurance premium from gross written premium.']
  payment_method varchar [note: 'Method or instrument used by the policyholder to remit payment for this premium transaction. [ENUM-REF-CANDIDATE: check|credit_card|debit_card|ach|wire_transfer|cash|payroll_deduction — 7 candidates stripped; promote to reference product]']
  payment_received_date date [note: 'Date on which payment for this premium transaction was received from the policyholder or producer.']
  rate_per_unit decimal(12,6) [note: 'Premium rate applied per unit of exposure to calculate the transaction premium amount.']
  reason_code varchar [note: 'Standardized code indicating the specific reason for the premium transaction, such as policy change, coverage adjustment, or billing correction.']
  reversal_flag boolean [note: 'Indicates whether this transaction is a reversal or correction of a previously posted premium transaction.']
  statutory_line_code varchar [note: 'NAIC statutory line of business code for regulatory annual statement reporting.']
  tax_amount decimal(18,2) [note: 'Total premium taxes, fees, and surcharges assessed on this transaction by state or federal authorities.']
  total_billed_amount decimal(18,2) [note: 'Total amount billed to the policyholder including premium, taxes, and fees.']
  transaction_description varchar [note: 'Free-text description providing additional context or explanation for this premium transaction.']
  transaction_number varchar [note: 'Business-facing unique identifier for this premium transaction, often displayed on billing statements and invoices.']
  transaction_status varchar [note: 'Current lifecycle status of the premium transaction in the billing and accounting system.']
  transaction_type varchar [note: 'Classification of the premium transaction indicating the business event that triggered it. [ENUM-REF-CANDIDATE: new_business|endorsement|cancellation|reinstatement|renewal|audit_premium|return_premium|refund|write_off — 9 candidates stripped; promote to']
  unearned_premium_amount decimal(18,2) [note: 'Portion of the written premium that remains unearned and represents future coverage obligation.']

  Note: 'Atomic premium ledger entry and single SSOT for every premium movement: new business, endorsement AP/RP, cancellation, reinstatement, audit, return premium, refund disbursement, and write-off.'
}

Table premium.rate_element {
  rate_element_id varchar [pk, note: 'Unique identifier for the rate element. Primary key.']
  coverage_form_id varchar [note: 'Reference to the insurance product to which this rate element applies.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Rate elements are LOB-specific for underwriting, actuarial rating, loss cost determination, and rate filing organization. Lob denormalized, replace with FK.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Rate elements are state-specific due to regulatory filing requirements, DOI approval processes, and jurisdiction-specific rating rules. State_code denormalized, replace with FK.']
  calculation_formula varchar [note: 'Mathematical formula or expression defining how this rate element is applied in premium computation.']
  cat_loading_factor decimal(10,6) [note: 'Factor applied to load premium for catastrophe exposure, reflecting probable maximum loss and reinsurance costs.']
  class_code varchar [note: 'Risk classification code to which this rate element applies, such as NCCI class codes or ISO class codes.']
  coverage_code varchar [note: 'ISO or proprietary coverage code to which this rate element applies.']
  created_timestamp timestamp [note: 'Date and time when this rate element record was first created in the system.']
  credibility_factor decimal(10,6) [note: 'Statistical credibility weight applied to experience-based rate elements, ranging from 0 to 1.']
  deductible_credit_factor decimal(10,6) [note: 'Factor applied to reduce premium when a deductible is selected, reflecting reduced insurer exposure.']
  default_value decimal(18,6) [note: 'Default value applied when no specific rate element value is determined during rating.']
  effective_date date [note: 'Date from which this rate element becomes active and applicable to new and renewal policies.']
  expense_provision decimal(10,6) [note: 'Percentage or factor representing underwriting expenses, commissions, and overhead included in the rate element.']
  expiration_date date [note: 'Date on which this rate element ceases to be active and is no longer applicable to policies.']
  filing_approval_date date [note: 'Date on which the regulatory authority approved the rate filing containing this rate element.']
  increased_limits_factor decimal(10,6) [note: 'Factor applied to adjust premium when policy limits exceed the base limit, reflecting increased exposure.']
  is_filed boolean [note: 'Indicates whether this rate element has been filed with and approved by the regulatory authority.']
  is_mandatory boolean [note: 'Indicates whether this rate element must be applied in all rating scenarios or is optional based on underwriting discretion.']
  loss_cost decimal(18,6) [note: 'Pure premium or expected loss per unit of exposure, excluding expenses and profit, used as the foundation for rate development.']
  maximum_value decimal(18,6) [note: 'Maximum allowable value for this rate element as defined by regulatory or underwriting guidelines.']
  minimum_value decimal(18,6) [note: 'Minimum allowable value for this rate element as defined by regulatory or underwriting guidelines.']
  naics_code varchar [note: 'Six-digit NAICS code representing the industry classification to which this rate element applies.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to the application or interpretation of this rate element.']
  profit_margin decimal(10,6) [note: 'Percentage or factor representing the profit and contingency margin included in the rate element.']
  rate_basis varchar [note: 'Unit of measure or basis on which the rate element is applied during premium computation. [ENUM-REF-CANDIDATE: per_100_payroll|per_1000_receipts|per_unit|per_vehicle|per_location|flat|percentage — 7 candidates stripped; promote to reference product]']
  rate_element_category varchar [note: 'Broader grouping of the rate element for reporting and rate filing purposes.']
  rate_element_code varchar [note: 'Business identifier code for the rate element used in rating calculations and external references.']
  rate_element_description varchar [note: 'Detailed business description of the rate element, its purpose, and how it is applied in premium calculations.']
  rate_element_name varchar [note: 'Human-readable name of the rate element describing its purpose in premium computation.']
  rate_element_status varchar [note: 'Current lifecycle status of the rate element indicating its availability for use in rating.']
  rate_element_type varchar [note: 'Classification of the rate element indicating its role in the rating algorithm.']
  rate_filing_number varchar [note: 'Regulatory filing reference number under which this rate element was approved by the state Department of Insurance.']
  rate_source varchar [note: 'Origin of the rate element indicating whether it is from ISO, NCCI, proprietary development, or advisory organization.']
  rate_table_name varchar [note: 'Name of the rate table or rating manual section from which this rate element is derived.']
  rate_value decimal(18,6) [note: 'Numeric value of the rate element used in premium calculation, expressed as a factor, multiplier, or absolute rate.']
  rate_version varchar [note: 'Version identifier for the rate element used to track changes and updates over time.']
  rating_tier varchar [note: 'Underwriting tier or risk segment to which this rate element applies, reflecting risk quality.']
  rol_value decimal(10,6) [note: 'Rate on line value expressed as a percentage of limit, commonly used in reinsurance and catastrophe pricing.']
  rpp_value decimal(18,6) [note: 'Rate per point value used in experience rating calculations, particularly for workers compensation.']
  sic_code varchar [note: 'Four-digit SIC code representing the industry classification to which this rate element applies.']
  territory_code varchar [note: 'Geographic territory code to which this rate element applies, used for territory-based rating.']
  trend_factor decimal(10,6) [note: 'Factor applied to adjust historical loss costs for inflation, frequency, and severity trends.']
  updated_timestamp timestamp [note: 'Date and time when this rate element record was last modified in the system.']

  Note: 'Master catalog of individual rating factors and their values used in premium computation: base rates, class factors, territory multipliers, schedule credits/debits, and ISO RPP elements. SSOT for rate content.'
}

Table premium.rate_table {
  rate_table_id varchar [pk, note: 'Unique identifier for the rate table version. Primary key.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Rate tables are organized by LOB for regulatory filing, rating plan management, and actuarial analysis. Lob denormalized, replace with FK.']
  policy_rate_filing_id varchar [note: 'Reference to the regulatory rate filing under which this rate table was approved.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Rate tables must link to state for regulatory filing tracking, DOI approval verification, jurisdiction-specific rating, and compliance auditing. State_code denormalized, replace with FK.']
  actuarial_memo_reference varchar [note: 'Reference to the actuarial memorandum or rate filing documentation supporting this rate table.']
  approval_date date [note: 'Date the state insurance department approved this rate table for use.']
  approved_by_regulator boolean [note: 'Indicates whether this rate table has received formal approval from the state insurance department.']
  class_code varchar [note: 'ISO or NCCI class code for which this rate table provides base rates or factors.']
  coverage_code varchar [note: 'ISO or company coverage code this rate table applies to, such as BI, PD, COLL, COMP.']
  created_by_user varchar [note: 'User identifier of the person who created this rate table version.']
  created_timestamp timestamp [note: 'Date and time when this rate table version was first created in the system.']
  effective_date date [note: 'Date when this rate table version becomes active and available for policy rating.']
  expense_provision decimal(18,6) [note: 'Expense loading component included in the rate to cover underwriting, acquisition, and administrative costs.']
  expiration_date date [note: 'Date when this rate table version is no longer valid for new business or renewals. Null if still active.']
  filing_number varchar [note: 'State insurance department filing number or SERFF tracking number for this rate table submission.']
  iso_content_flag boolean [note: 'Indicates whether this rate table contains ISO-licensed rating content or proprietary company rates.']
  iso_edition varchar [note: 'ISO manual edition identifier if this rate table is based on ISO content.']
  loss_cost decimal(18,6) [note: 'Pure premium or loss cost component of the rate, excluding expense and profit loads.']
  maximum_rate decimal(18,6) [note: 'Maximum allowable rate value after all factors and modifiers are applied.']
  minimum_rate decimal(18,6) [note: 'Minimum allowable rate value after all factors and modifiers are applied.']
  ncci_content_flag boolean [note: 'Indicates whether this rate table contains NCCI-licensed workers compensation rating content.']
  owner varchar [note: 'Business unit or department responsible for maintaining and updating this rate table.']
  profit_provision decimal(18,6) [note: 'Profit and contingency loading component included in the rate.']
  rate_basis varchar [note: 'Unit basis for rate application: per unit, per hundred exposure, per thousand, flat fee, or percentage.']
  rate_change_percent decimal(5,2) [note: 'Percentage change from the prior rate table version, used for regulatory filing documentation.']
  rate_description varchar [note: 'Detailed business description of what this rate table row represents and how it is applied in rating.']
  rate_footnote varchar [note: 'Additional notes, exceptions, or special instructions for applying this rate.']
  rate_source varchar [note: 'Origin of the rate content: ISO, NCCI, company proprietary, state manual, or advisory organization.']
  rate_table_code varchar [note: 'Unique business code identifying the rate table across systems and filings.']
  rate_table_name varchar [note: 'Business name of the rate table for identification and reference purposes.']
  rate_table_status varchar [note: 'Current lifecycle status of the rate table in the filing and approval workflow.']
  rate_table_type varchar [note: 'Classification of rate content: base rates, factors, credits, debits, or modifiers. [ENUM-REF-CANDIDATE: base_rate|class_factor|territory_factor|schedule_credit|schedule_debit|experience_mod|increased_limit — 7 candidates stripped; promote to reference']
  rate_unit_of_measure varchar [note: 'Unit of measure for the rate value, defining how the rate is applied to exposure. [ENUM-REF-CANDIDATE: per_unit|per_hundred|per_thousand|per_vehicle|per_location|per_employee|flat — 7 candidates stripped; promote to reference product]']
  rate_value decimal(18,6) [note: 'Numeric rate value, factor, credit, or debit stored in this rate table row.']
  rate_version varchar [note: 'Sequential version number for this rate table iteration within the same filing and effective period.']
  rating_plan varchar [note: 'Name or code of the rating plan or program this rate table supports, such as tiered or preferred programs.']
  rating_tier varchar [note: 'Tier level within a multi-tier rating plan, such as standard, preferred, or elite.']
  rol_value decimal(18,6) [note: 'Rate on Line value used in excess and reinsurance pricing, expressed as premium divided by limit.']
  rpp_value decimal(18,6) [note: 'ISO Rate Per Point value used in commercial lines rating calculations.']
  territory_code varchar [note: 'Geographic territory code for which this rate table provides territory-specific rates or factors.']
  updated_by_user varchar [note: 'User identifier of the person who last modified this rate table version.']
  updated_timestamp timestamp [note: 'Date and time when this rate table version was last modified.']

  Note: 'Versioned rate table and single SSOT for all rate content: base rates, class/territory factors, schedule credits/debits, and ISO RPP elements, held as rows grouped by LOB, state, effective date, and filing across multi-tier plans.'
}

Table premium.rating_worksheet {
  rating_worksheet_id varchar [pk, note: 'Unique identifier for the rating worksheet record. Primary key.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Rating worksheets must trace to specific coverages for audit trail, quote reconstruction, underwriting review, and regulatory rate verification.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Rating calculations in multiple currencies require currency reference for proper premium calculation, display formatting, and quote presentation. Currency_code denormalized, replace with FK.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Rating worksheets must reference LOB for proper rating plan selection, premium calculation rules, and underwriting guidelines. Lob denormalized, replace with FK.']
  policy_id varchar [note: 'Reference to the policy being rated or quoted.']
  quote_id varchar [note: 'Reference to the quote for which this rating worksheet was generated.']
  approval_timestamp timestamp [note: 'Date and time when the rating worksheet was approved.']
  approved_by varchar [note: 'Name or identifier of the person who approved the rating worksheet.']
  base_rate decimal(18,6) [note: 'The foundational rate per unit of exposure before application of modifiers and factors.']
  calculation_notes varchar [note: 'Free-text notes or comments regarding the rating calculation, exceptions, or underwriter rationale.']
  calculation_timestamp timestamp [note: 'Date and time when the rating calculation was executed.']
  class_code varchar [note: 'Risk classification code used in rating, such as NAICS, SIC, or ISO class code.']
  created_timestamp timestamp [note: 'Date and time when the rating worksheet record was first created in the system.']
  cumulative_premium decimal(18,2) [note: 'Running total premium amount after applying all rating steps up to and including this step.']
  deductible_credit decimal(18,2) [note: 'Premium credit applied for selection of higher deductibles.']
  effective_date date [note: 'Date from which the rated premium becomes effective for the policy or quote.']
  experience_mod decimal(5,3) [note: 'Experience modification factor applied to adjust premium based on historical loss experience.']
  expiration_date date [note: 'Date on which the rated premium period ends.']
  exposure_units decimal(18,2) [note: 'Quantity of exposure units used in the rating calculation, such as payroll amount or square footage.']
  gwp decimal(18,2) [note: 'Total premium charged before any reinsurance cessions or adjustments.']
  intermediate_premium decimal(18,2) [note: 'Premium amount calculated at this step before subsequent factors are applied.']
  minimum_premium decimal(18,2) [note: 'Minimum premium amount required for this policy or coverage, regardless of calculated premium.']
  minimum_premium_applied_flag boolean [note: 'Indicates whether the minimum premium override was applied in the final calculation.']
  modified_timestamp timestamp [note: 'Date and time when the rating worksheet record was last modified.']
  nwp decimal(18,2) [note: 'Premium retained after reinsurance cessions.']
  product_code varchar [note: 'Code identifying the insurance product being rated.']
  rate_effective_date date [note: 'Date on which the rating plan or rate table became effective.']
  rate_source varchar [note: 'Source of the rating data used, such as ISO, Verisk, proprietary, or state manual.']
  rating_basis varchar [note: 'The exposure basis used for rating, such as payroll, sales, area, number of vehicles, or TIV.']
  rating_factor_code varchar [note: 'Code identifying the specific rating factor or variable used in this step.']
  rating_factor_type varchar [note: 'Type of rating factor applied in this step, indicating how it modifies the premium. [ENUM-REF-CANDIDATE: base_rate|multiplier|additive|discount|surcharge|credit|debit — 7 candidates stripped; promote to reference product]']
  rating_factor_value decimal(18,6) [note: 'Numeric value of the rating factor applied in this calculation step.']
  rating_plan_code varchar [note: 'Code identifying the rating plan or algorithm used for premium calculation.']
  rating_plan_version varchar [note: 'Version of the rating plan applied, ensuring rate adequacy and regulatory compliance.']
  rating_status varchar [note: 'Current lifecycle status of the rating worksheet in the underwriting workflow.']
  rating_step_name varchar [note: 'Descriptive name of the rating step, such as Base Rate, Territory Factor, Experience Mod.']
  rating_step_sequence varchar [note: 'Sequential order of this rating step within the overall calculation workflow.']
  schedule_credit_debit decimal(18,2) [note: 'Discretionary premium adjustment applied by underwriter based on risk characteristics.']
  step_premium_adjustment decimal(18,2) [note: 'The incremental premium change resulting from this rating step.']
  taxes_and_fees decimal(18,2) [note: 'Total amount of taxes, surcharges, and regulatory fees applied to the premium.']
  territory_code varchar [note: 'Geographic territory code used for rating purposes.']
  total_charged_premium decimal(18,2) [note: 'Final premium amount charged to the policyholder, including all taxes and fees.']
  underwriter_code varchar [note: 'Reference to the underwriter who reviewed or approved this rating worksheet.']
  worksheet_number varchar [note: 'Business-facing unique identifier for the rating worksheet, used for audit and reference purposes.']
  worksheet_version varchar [note: 'Version number of the rating worksheet, incremented when recalculations occur.']

  Note: 'Step-by-step premium calculation audit trail for a quoted or bound risk. Captures each rating step, applied factor, intermediate result, and final charged premium. Supports UW review and rate adequacy audits.'
}

Table premium.billing_account {
  billing_account_id varchar [pk, note: 'Unique identifier for the billing account. Primary key.']
  billing_country_id varchar [note: 'Foreign key linking to shared.country. Business justification: International billing requires country reference for address validation, regulatory jurisdiction, postal code format, and payment processing rules.']
  billing_currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Billing in multiple currencies requires currency master for exchange rates, payment processing, and account balance calculation. Billing_currency_code denormalized, replace with FK.']
  billing_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Billing accounts need state reference for premium tax calculation, regulatory compliance, and address validation. Billing_state_code denormalized, replace with FK.']
  insured_id varchar [note: 'Reference to the party responsible for payment on this billing account.']
  policy_id varchar [note: 'Reference to the primary policy associated with this billing account.']
  producers_producer_id varchar [note: 'Reference to the agent or broker servicing this billing account, relevant for agency bill arrangements.']
  account_name varchar [note: 'Descriptive name for the billing account, typically matching the payer or primary insured name.']
  account_number varchar [note: 'Externally visible unique account number used for customer communication and payment reference.']
  account_status varchar [note: 'Current lifecycle status of the billing account reflecting payment standing and operational state.']
  account_type varchar [note: 'Classification of the billing account based on the payer relationship and business segment.']
  autopay_flag boolean [note: 'Indicates whether automatic payment is enabled for this billing account via bank draft or credit card.']
  billing_address_line1 varchar [note: 'First line of the billing address to which statements and notices are sent.']
  billing_address_line2 varchar [note: 'Second line of the billing address for suite, apartment, or additional location details.']
  billing_city varchar [note: 'City name for the billing address.']
  billing_contact_email varchar [note: 'Primary email address for billing communications, statements, and payment notifications.']
  billing_contact_phone varchar [note: 'Primary phone number for billing inquiries and payment reminders.']
  billing_method varchar [note: 'Method by which premiums are billed: direct to insured, through agent, or other arrangement.']
  billing_postal_code varchar [note: 'Postal or ZIP code for the billing address.']
  cancellation_date date [note: 'Date on which the billing account was cancelled due to non-payment, policy cancellation, or other reason.']
  cancellation_reason_code varchar [note: 'Code indicating the reason for billing account cancellation: non-payment, insured request, underwriting, etc.']
  commission_rate_percent decimal(5,2) [note: 'Percentage commission rate applicable to premiums billed on this account for agency bill arrangements.']
  created_by_user varchar [note: 'User identifier of the person or system that created this billing account record.']
  created_timestamp timestamp [note: 'Timestamp when this billing account record was first created in the system.']
  current_balance_amount decimal(15,2) [note: 'Current outstanding balance on the billing account, including all billed charges less payments and adjustments.']
  delinquency_days varchar [note: 'Number of days the account has been past due, calculated from the oldest unpaid invoice due date.']
  effective_date date [note: 'Date on which the billing account became active and billing commenced.']
  expiration_date date [note: 'Date on which the billing account is scheduled to expire or terminate, typically aligned with policy term.']
  grace_period_days varchar [note: 'Number of days after the due date during which payment may be received without penalty or cancellation.']
  last_payment_amount decimal(15,2) [note: 'Amount of the most recent payment received and posted to this billing account.']
  last_payment_date date [note: 'Date on which the most recent payment was received and posted to this billing account.']
  last_statement_date date [note: 'Date on which the most recent billing statement was generated and sent to the payer.']
  next_due_amount decimal(15,2) [note: 'Amount of the next scheduled installment payment due on this billing account.']
  next_due_date date [note: 'Date on which the next installment payment is due for this billing account.']
  paperless_billing_flag boolean [note: 'Indicates whether the payer has elected to receive billing statements electronically instead of by mail.']
  past_due_amount decimal(15,2) [note: 'Portion of the current balance that is past the due date and subject to collection action.']
  payment_frequency varchar [note: 'Frequency at which premium installments are due on this billing account.']
  payment_plan_code varchar [note: 'Code identifying the installment payment plan: full pay, monthly, quarterly, or custom schedule.']
  total_billed_amount decimal(15,2) [note: 'Cumulative amount billed to this account since inception, including all premium charges and fees.']
  total_paid_amount decimal(15,2) [note: 'Cumulative amount paid by the payer on this account since inception, including all applied payments.']
  unapplied_payment_amount decimal(15,2) [note: 'Total amount of payments received but not yet applied to specific invoices or charges.']
  updated_by_user varchar [note: 'User identifier of the person or system that last modified this billing account record.']
  updated_timestamp timestamp [note: 'Timestamp when this billing account record was last modified.']

  Note: 'Master billing account grouping one or more policies under a single payer relationship. Manages payment plan, billing method (direct bill vs. agency bill), and account-level balance. SSOT for payer identity in billing.'
}

Table premium.installment_schedule {
  installment_schedule_id varchar [pk, note: 'Unique identifier for the installment schedule record.']
  billing_account_id varchar [note: 'Reference to the billing account associated with this installment schedule.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Installment payment plans must reference currency for proper billing, payment application, and exchange rate handling. Currency_code denormalized, replace with FK.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Payment plan eligibility and terms vary by LOB for risk management and regulatory compliance. Lob_code denormalized, replace with FK.']
  policy_id varchar [note: 'Reference to the policy for which this installment schedule applies.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Installment eligibility rules, cancellation for non-payment periods, and grace period requirements are state-regulated. State_code denormalized, replace with FK.']
  autopay_discount_amount decimal(15,2) [note: 'Discount applied to total premium or fees when policyholder enrolls in autopay.']
  autopay_enrolled_flag boolean [note: 'Indicates whether the policyholder is enrolled in automatic payment for this schedule.']
  billing_method varchar [note: 'Method by which the policyholder is billed for installments.']
  cancellation_for_nonpayment_days varchar [note: 'Number of days after missed payment before policy is subject to cancellation for nonpayment.']
  cancellation_reason_code varchar [note: 'Code indicating the reason for schedule cancellation such as nonpayment, policy cancellation, or policyholder request.']
  cancelled_timestamp timestamp [note: 'Date and time when the installment schedule was cancelled.']
  created_timestamp timestamp [note: 'Date and time when the installment schedule record was first created in the system.']
  down_payment_amount decimal(15,2) [note: 'Initial payment amount due at policy binding or schedule creation.']
  down_payment_due_date date [note: 'Date by which the down payment must be received.']
  down_payment_percentage decimal(5,2) [note: 'Percentage of total premium required as down payment, typically expressed as a decimal.']
  eligibility_criteria varchar [note: 'Business rules or conditions that determine eligibility for this payment plan by LOB and state.']
  first_installment_due_date date [note: 'Due date for the first regular installment payment after down payment.']
  grace_period_days varchar [note: 'Number of days after due date during which payment may be received without penalty or cancellation.']
  installment_count varchar [note: 'Total number of installments in the schedule including down payment if applicable.']
  installment_fee_amount decimal(15,2) [note: 'Fee charged per installment for payment plan administration.']
  installment_frequency varchar [note: 'Frequency at which installment payments are due.']
  late_payment_fee_amount decimal(15,2) [note: 'Fee assessed when an installment payment is received after the grace period.']
  maximum_premium_threshold decimal(15,2) [note: 'Maximum total premium amount allowed for this installment schedule.']
  minimum_premium_threshold decimal(15,2) [note: 'Minimum total premium amount required to qualify for this installment schedule.']
  notes varchar [note: 'Free-form text for additional comments or special instructions related to the installment schedule.']
  paperless_billing_flag boolean [note: 'Indicates whether the policyholder has opted for electronic billing statements.']
  paperless_discount_amount decimal(15,2) [note: 'Discount applied when policyholder opts for paperless billing.']
  payment_method_preference varchar [note: 'Preferred payment instrument for installment payments.']
  payment_plan_code varchar [note: 'Code identifying the payment plan type such as monthly, quarterly, semi-annual, or annual.']
  payment_plan_name varchar [note: 'Descriptive name of the payment plan for business user reference.']
  reinstatement_fee_amount decimal(15,2) [note: 'Fee charged to reinstate a policy that was cancelled for nonpayment.']
  schedule_effective_date date [note: 'Date when the installment schedule becomes active and binding.']
  schedule_expiration_date date [note: 'Date when the installment schedule ends or final payment is due.']
  schedule_number varchar [note: 'Business identifier for the installment schedule, typically system-generated or policy-derived.']
  schedule_status varchar [note: 'Current lifecycle status of the installment schedule.']
  total_amount_due decimal(15,2) [note: 'Total amount due including premium and all fees across the entire schedule.']
  total_fees_amount decimal(15,2) [note: 'Total fees to be collected across all installments.']
  total_premium_amount decimal(15,2) [note: 'Total premium amount to be collected across all installments including down payment.']
  updated_timestamp timestamp [note: 'Date and time when the installment schedule record was last modified.']

  Note: 'Payment-plan definition and instantiated billing schedule for an account or policy: plan code/name, installment count, down payment, due dates, amounts, fees, and eligibility by LOB and state.'
}

Table premium.installment {
  installment_id varchar [pk, note: 'Unique identifier for the installment record within the billing schedule.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Individual installment billing requires currency reference for payment processing, exchange rate application, and account reconciliation. Currency_code denormalized, replace with FK.']
  installment_schedule_id varchar [note: 'Reference to the parent billing schedule that contains this installment.']
  policy_id varchar [note: 'Reference to the policy for which this installment is billed.']
  autopay_flag boolean [note: 'Indicates whether this installment is enrolled in automatic payment processing.']
  billed_amount decimal(18,2) [note: 'Total amount billed for this installment, including premium and fees.']
  billed_date date [note: 'Date when the installment invoice was generated and sent to the policyholder.']
  billing_notice_sent_flag boolean [note: 'Indicates whether a billing notice has been sent to the policyholder for this installment.']
  cancellation_effective_date date [note: 'Date when the policy will be cancelled if this installment remains unpaid.']
  cancellation_notice_date date [note: 'Date when a cancellation notice was issued due to non-payment of this installment.']
  created_timestamp timestamp [note: 'Timestamp when this installment record was first created in the system.']
  days_overdue varchar [note: 'Number of days the installment payment is past the grace period end date.']
  delinquency_status varchar [note: 'Classification of the installment based on payment timeliness and collection status.']
  due_date date [note: 'Date by which the installment payment is due from the policyholder.']
  fee_amount decimal(18,2) [note: 'Total fees charged on this installment (e.g., installment fee, service charge).']
  grace_period_days varchar [note: 'Number of days after due date before the installment is considered overdue.']
  grace_period_end_date date [note: 'Date when the grace period expires and the installment becomes overdue.']
  installment_status varchar [note: 'Current payment status of the installment in its lifecycle.']
  invoice_number varchar [note: 'Unique invoice number generated for this installment billing.']
  late_fee_amount decimal(18,2) [note: 'Late payment fee assessed if installment is paid after the due date.']
  late_notice_sent_flag boolean [note: 'Indicates whether a late payment notice has been sent for this overdue installment.']
  number varchar [note: 'Sequential number of this installment within the billing schedule (e.g., 1 of 12).']
  outstanding_balance decimal(18,2) [note: 'Remaining unpaid balance on this installment (billed amount minus paid amount).']
  paid_amount decimal(18,2) [note: 'Total amount paid by the policyholder toward this installment to date.']
  paid_date date [note: 'Date when the installment was fully paid by the policyholder.']
  payment_channel varchar [note: 'Channel or interface through which the installment payment was received.']
  payment_method varchar [note: 'Method or instrument used by the policyholder to pay this installment. [ENUM-REF-CANDIDATE: check|credit_card|debit_card|ach|wire|cash|money_order — 7 candidates stripped; promote to reference product]']
  payment_reference_number varchar [note: 'External reference number or transaction ID from the payment processor.']
  premium_amount decimal(18,2) [note: 'Portion of the installment amount that represents pure insurance premium.']
  reminder_notice_sent_flag boolean [note: 'Indicates whether a payment reminder notice has been sent for this installment.']
  reversal_date date [note: 'Date when a payment reversal occurred on this installment.']
  reversal_flag boolean [note: 'Indicates whether a payment on this installment has been reversed (e.g., chargeback, NSF).']
  reversal_reason varchar [note: 'Reason code or description for why a payment was reversed (e.g., NSF, chargeback, dispute).']
  tax_amount decimal(18,2) [note: 'Total taxes (e.g., premium tax, surcharges) included in this installment.']
  updated_timestamp timestamp [note: 'Timestamp when this installment record was last modified.']
  waived_date date [note: 'Date when the installment was waived or forgiven.']
  waived_flag boolean [note: 'Indicates whether this installment has been waived or forgiven by the insurer.']
  waived_reason varchar [note: 'Reason or justification for waiving this installment (e.g., customer service, hardship).']

  Note: 'Individual installment due record within a schedule: due date, billed amount, paid amount, outstanding balance, and delinquency status. Drives billing notices, late fees, and cancellation-for-nonpayment workflows.'
}

Table premium.payment {
  payment_id varchar [pk, note: 'Unique identifier for the premium payment transaction record.']
  billing_account_id varchar [note: 'Reference to the billing account that made this payment.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Payment transactions must reference currency master for exchange rate application, bank reconciliation, and multi-currency payment processing. Currency_code denormalized, replace with FK.']
  installment_schedule_id varchar [note: 'Reference to the installment or payment plan this payment is associated with.']
  policy_id varchar [note: 'Reference to the policy for which this premium payment was received.']
  premium_transaction_id varchar [note: 'Unique transaction identifier assigned by the payment gateway or processor.']
  producers_producer_id varchar [note: 'Reference to the agent or broker who facilitated or collected the payment.']
  amount decimal(18,2) [note: 'Total monetary amount received in this payment transaction.']
  applied_amount decimal(18,2) [note: 'Portion of the payment amount that has been applied to outstanding invoices or installments.']
  authorization_code varchar [note: 'Authorization or approval code returned by the payment processor for card transactions.']
  bank_name varchar [note: 'Name of the financial institution that processed the payment.']
  bank_routing_number varchar [note: 'Nine-digit ABA routing number for ACH or wire payments.']
  channel varchar [note: 'Interface or touchpoint through which the payment was submitted (web portal, mobile app, agent office, mail, phone, branch, lockbox). [ENUM-REF-CANDIDATE: web|mobile|agent|mail|phone|branch|lockbox — 7 candidates stripped; promote to reference product]']
  cleared_date date [note: 'Date the payment cleared the bank and funds were confirmed available.']
  convenience_fee_amount decimal(18,2) [note: 'Additional fee charged to the payer for using a specific payment method or channel.']
  created_timestamp timestamp [note: 'Timestamp when the payment record was first created in the system.']
  deposit_date date [note: 'Date the payment was deposited into the insurers bank account.']
  effective_date date [note: 'Date from which the payment is effective for premium credit or policy reinstatement purposes.']
  installment_number varchar [note: 'Sequence number of the installment this payment satisfies within the payment plan.']
  method varchar [note: 'Instrument or mechanism used to remit the payment (check, ACH, card, wire, cash). [ENUM-REF-CANDIDATE: check|ach|wire|credit_card|debit_card|cash|money_order — 7 candidates stripped; promote to reference product]']
  modified_by varchar [note: 'User ID or system identifier that last modified the payment record.']
  modified_timestamp timestamp [note: 'Timestamp when the payment record was last modified.']
  notes varchar [note: 'Free-text notes or comments regarding the payment transaction, exceptions, or special handling.']
  number varchar [note: 'Business-facing unique payment transaction number or receipt number.']
  payer_account_number varchar [note: 'Masked or tokenized account number from which the payment was drawn (last 4 digits of card or bank account).']
  payer_name varchar [note: 'Name of the individual or entity that remitted the payment.']
  payment_date date [note: 'Date the payment was received or posted to the account.']
  payment_status varchar [note: 'Current lifecycle status of the payment transaction in the billing workflow.']
  payment_type varchar [note: 'Classification of the payment purpose (premium, reinstatement, late fee, NSF fee, adjustment, refund).']
  processing_fee_amount decimal(18,2) [note: 'Fee charged by the payment processor or gateway for handling the transaction.']
  receipt_issued_date date [note: 'Date the payment receipt was generated and issued to the payer.']
  receipt_number varchar [note: 'Official receipt number issued to the payer acknowledging the payment.']
  reference_number varchar [note: 'External reference number from the payment processor, bank, or payer (check number, ACH trace, card authorization code).']
  reversal_date date [note: 'Date the payment was reversed or returned, if applicable.']
  reversal_reason varchar [note: 'Explanation or code for why the payment was reversed, if applicable (NSF, stop payment, dispute).']
  source varchar [note: 'Origin or category of the payer (policyholder, third party, agent, reinsurer, subrogation recovery).']
  unapplied_amount decimal(18,2) [note: 'Portion of the payment held in suspense, not yet matched to a policy or account balance.']
  created_by varchar [note: 'User ID or system identifier that created the payment record.']

  Note: 'Records each premium payment received: date, amount, method (check, ACH, card), and any unapplied suspense balance pending policy/account matching. Applied to installments via the payment_application junction.'
}

Table premium.payment_application {
  payment_application_id varchar [pk, note: 'Unique identifier for the payment application record. Primary key for the junction table linking premium payments to installments.']
  installment_id varchar [note: 'Foreign key reference to the premium installment schedule entry to which the payment is being applied.']
  payment_id varchar [note: 'Foreign key reference to the premium payment transaction that is being applied to one or more installments.']
  premium_transaction_id varchar [note: 'Unique transaction identifier from the source billing system. Enables traceability back to the originating system for reconciliation and troubleshooting.']
  allocation_priority varchar [note: 'Numeric priority order used to allocate payment across multiple installments or charge types. Lower numbers applied first per billing rules.']
  application_date date [note: 'Business date on which the payment was applied to the installment. May differ from payment received date due to batch processing or suspense clearing.']
  application_method varchar [note: 'Method by which the payment was applied to the installment: automatic system matching, manual CSR allocation, suspense clearing, reversal, or adjustment.']
  application_notes varchar [note: 'Free-text notes entered by CSR or system explaining special circumstances of the payment application such as manual allocation reason or suspense research outcome.']
  application_sequence varchar [note: 'Sequential order in which this payment application was processed. Supports audit trail and reversal logic for multi-installment payments.']
  application_status varchar [note: 'Current lifecycle status of the payment application. Applied is normal state; reversed indicates the application was undone; pending for suspense items.']
  application_timestamp timestamp [note: 'Precise date and time when the payment application transaction was recorded in the billing system. Supports audit and reconciliation.']
  applied_amount decimal(15,2) [note: 'Monetary amount from the payment that was applied to this specific installment. Sum of all applied amounts for a payment equals the payment total.']
  applied_by_user_code varchar [note: 'User ID of the CSR or system account that executed the payment application. Null for fully automated applications. Supports audit and quality review.']
  applied_to_fee_flag boolean [note: 'Indicates whether this application was allocated to fees such as late payment fees, NSF fees, or installment fees rather than premium principal.']
  applied_to_interest_flag boolean [note: 'Indicates whether this application was allocated to accrued interest charges on overdue installments rather than premium principal.']
  applied_to_principal_flag boolean [note: 'Indicates whether this application reduced the principal premium amount. True for standard applications; false for fee or interest applications.']
  billing_account_number varchar [note: 'Billing account number under which the installment and payment are managed. Denormalized for cash application and reconciliation reporting.']
  created_timestamp timestamp [note: 'Date and time when this payment application record was first created in the data warehouse. Supports data lineage and audit trail.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the applied amount. Typically USD for domestic P&C operations.']
  installment_balance_after decimal(15,2) [note: 'Outstanding balance of the installment immediately after this payment application. Should equal balance_before minus applied_amount.']
  installment_balance_before decimal(15,2) [note: 'Outstanding balance of the installment immediately before this payment application. Enables balance reconciliation and audit trail.']
  nsf_reversal_flag boolean [note: 'Indicates whether this application was reversed due to a returned or dishonored payment such as NSF check or failed ACH. Triggers reinstatement of installment balance.']
  policy_number varchar [note: 'Policy number associated with the installment to which payment is applied. Denormalized for reporting and reconciliation convenience.']
  reversal_date date [note: 'Business date on which this payment application was reversed. Null if application remains in effect. Critical for earned premium and cash reconciliation.']
  reversal_reason_code varchar [note: 'Standardized code indicating why this payment application was reversed. Null if application has not been reversed. Used for audit and reporting.']
  reversal_timestamp timestamp [note: 'Precise date and time when the payment application was reversed. Null if not reversed. Supports audit trail and temporal queries.']
  source_system_code varchar [note: 'Code identifying the billing or payment system that originated this payment application record. Supports multi-system integration and data lineage.']
  suspense_clearing_flag boolean [note: 'Indicates whether this application cleared a payment from suspense account. True when unidentified payment is matched to installment after research.']
  unapplied_amount decimal(15,2) [note: 'Portion of the payment that remains unapplied after this application. Tracks suspense balance and supports multi-step application workflows.']
  updated_timestamp timestamp [note: 'Date and time when this payment application record was last modified in the data warehouse. Tracks changes such as status updates or reversals.']

  Note: 'Junction table resolving the many-to-many relationship between premium payments and installments. Records applied amount, application date, and sequence. Enables full cash application audit trail.'
}

Table premium.dac_transaction {
  dac_transaction_id varchar [pk, note: 'Unique identifier for the DAC transaction record.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: DAC accounting requires calendar reference for amortization period calculation, financial reporting, and GAAP/IFRS compliance. Accounting_period denormalized, replace with FK.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: DAC amortization tracks by coverage for GAAP accounting, profitability analysis by coverage type, and recoverability testing.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: DAC accounting in multiple currencies requires currency reference for proper GAAP/IFRS reporting, amortization calculation, and financial consolidation.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: DAC transactions require LOB reference for amortization period determination, recoverability testing, and financial reporting by line of business. Lob denormalized, replace with FK.']
  policy_id varchar [note: 'Reference to the policy for which DAC is capitalized or amortized.']
  premium_transaction_id varchar [note: 'Unique identifier of the transaction in the source system, used for reconciliation and audit trail purposes.']
  accounting_standard varchar [note: 'Accounting standard under which this DAC transaction is recorded: US GAAP ASC 944, IFRS 17, or Statutory Accounting Principles.']
  adjustment_amount decimal(18,2) [note: 'Amount of adjustment to previously recorded DAC, due to policy endorsements, premium adjustments, or actuarial recalculations.']
  amortization_amount decimal(18,2) [note: 'Amount of DAC amortized in this transaction, expensed over the policy term in proportion to earned premium or expected gross profits.']
  amortization_method varchar [note: 'Method used to amortize DAC: straight-line over policy term, proportional to earned premium, or proportional to expected gross profits per US GAAP ASC 944.']
  amortization_period_months varchar [note: 'Total number of months over which the DAC asset is amortized, typically matching the policy term.']
  approval_date date [note: 'Date when the DAC transaction was approved by an authorized user, part of the financial control workflow.']
  approved_by_user_code varchar [note: 'Identifier of the user who approved this DAC transaction, required for transactions above materiality thresholds per SOX controls.']
  capitalized_amount decimal(18,2) [note: 'Total acquisition cost amount capitalized as a DAC asset for the policy, including commissions, underwriting expenses, and other deferrable costs.']
  commission_amount decimal(18,2) [note: 'Commission paid to producers or agents, a primary component of deferrable acquisition costs capitalized as DAC.']
  cost_center_code varchar [note: 'Cost center or organizational unit code for financial reporting and expense allocation purposes.']
  created_timestamp timestamp [note: 'Timestamp when this DAC transaction record was first created in the data warehouse.']
  dac_balance decimal(18,2) [note: 'Remaining unamortized DAC asset balance after this transaction, representing future expense to be recognized.']
  earned_premium_amount decimal(18,2) [note: 'Earned premium amount for the period, used as the basis for proportional DAC amortization when amortization method is earned premium.']
  effective_date date [note: 'Date from which the DAC transaction becomes effective for financial statement purposes.']
  gl_account_code varchar [note: 'General ledger account code to which this DAC transaction is posted in the financial accounting system.']
  impairment_amount decimal(18,2) [note: 'Amount of DAC impairment recognized if the recoverability test indicates the asset is not recoverable from future profits.']
  notes varchar [note: 'Free-text notes or comments providing additional context about the DAC transaction, such as special adjustments or manual overrides.']
  other_acquisition_cost_amount decimal(18,2) [note: 'Other deferrable acquisition costs not classified as commission or underwriting expense, included in DAC capitalization.']
  policy_effective_date date [note: 'Effective date of the underlying policy, used to calculate amortization schedules and DAC asset life.']
  policy_expiration_date date [note: 'Expiration date of the underlying policy, marking the end of the DAC amortization period.']
  posted_by_user_code varchar [note: 'Identifier of the user or system account that posted this DAC transaction to the financial ledger.']
  product_code varchar [note: 'Code identifying the specific insurance product associated with this DAC transaction.']
  recoverability_test_date date [note: 'Date when the DAC asset recoverability test was last performed to ensure the asset is not impaired per US GAAP ASC 944.']
  recoverability_test_result varchar [note: 'Result of the most recent DAC recoverability test: pass indicates no impairment, fail indicates write-down required.']
  reversal_reason varchar [note: 'Explanation for why a previously posted DAC transaction was reversed, such as data correction, policy cancellation, or accounting error.']
  transaction_date date [note: 'Business date when the DAC transaction occurred or was recognized for accounting purposes.']
  transaction_number varchar [note: 'Business-facing unique identifier for the DAC transaction, used in financial reporting and audit trails.']
  transaction_status varchar [note: 'Current lifecycle status of the DAC transaction in the financial ledger workflow.']
  transaction_type varchar [note: 'Type of DAC transaction: capitalization of acquisition costs, amortization over policy term, write-off for lapsed policies, adjustment, or reversal.']
  underwriting_expense_amount decimal(18,2) [note: 'Underwriting and policy issuance expenses that are deferrable and included in the DAC capitalization.']
  updated_timestamp timestamp [note: 'Timestamp when this DAC transaction record was last modified in the data warehouse.']
  write_off_amount decimal(18,2) [note: 'Amount of DAC written off due to policy cancellation, lapse, or other termination event before the end of the policy term.']
  written_premium_amount decimal(18,2) [note: 'Written premium amount for the policy, used to calculate the DAC capitalization rate and amortization schedule.']

  Note: 'Deferred Acquisition Cost transaction recording capitalized and amortized DAC amounts per policy. Tracks DAC asset balance, amortization schedule, and write-off events per US GAAP ASC 944 and IFRS 17.'
}

Table premium.minimum_earned_premium {
  minimum_earned_premium_id varchar [pk, note: 'Unique identifier for the minimum earned premium threshold record.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage to which this MEP threshold applies, if coverage-level MEP is enforced.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: MEP amounts must reference currency for proper calculation, regulatory compliance, and multi-currency policy handling. Currency_code denormalized, replace with FK.']
  jurisdiction_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: MEP rules are jurisdiction-specific, driven by state regulatory mandates, filing requirements, and cancellation penalty rules. Jurisdiction_code denormalized, replace with FK.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: MEP rules vary by LOB for regulatory compliance and risk management. Lob denormalized, replace with FK.']
  policy_id varchar [note: 'Reference to the policy to which this MEP threshold applies.']
  applies_to_cancellation_type varchar [note: 'Specifies the cancellation types to which this MEP threshold applies: insured-requested, underwriter-initiated, non-payment, or all.']
  created_timestamp timestamp [note: 'The date and time when this MEP threshold record was first created in the system.']
  effective_date date [note: 'The date from which this MEP threshold becomes effective for the policy or coverage.']
  expiration_date date [note: 'The date on which this MEP threshold expires or is superseded by a new threshold.']
  filing_approval_date date [note: 'The date on which the state DOI approved the filing containing this MEP threshold.']
  filing_reference_number varchar [note: 'The regulatory filing reference number under which this MEP threshold was approved by the state DOI.']
  last_modified_timestamp timestamp [note: 'The date and time when this MEP threshold record was last updated.']
  mep_amount decimal(15,2) [note: 'The minimum earned premium amount that must be retained upon policy cancellation or short-rate endorsement.']
  mep_calculation_method varchar [note: 'The method used to calculate the minimum earned premium: flat amount, percentage of written premium, or the greater of the two.']
  mep_percentage decimal(5,2) [note: 'The minimum earned premium expressed as a percentage of the total written premium (WP) that must be retained.']
  mep_waiver_reason_code varchar [note: 'Code representing the reason for waiving or reducing the MEP threshold, if applicable.']
  minimum_earned_premium_status varchar [note: 'Current lifecycle status of this MEP threshold record.']
  modified_by_user_code varchar [note: 'The user ID of the person who last modified this MEP threshold record.']
  notes varchar [note: 'Free-text notes or comments regarding this MEP threshold, including special conditions or business rationale.']
  override_allowed_flag boolean [note: 'Indicates whether underwriters are permitted to override this MEP threshold under specific circumstances.']
  override_authority_level varchar [note: 'The minimum authority level required to override this MEP threshold, if overrides are allowed.']
  policy_term_months varchar [note: 'The policy term length in months for which this MEP threshold is defined, if term-specific.']
  product_code varchar [note: 'The insurance product code to which this MEP threshold applies, linking to the product catalog.']
  regulatory_mandate_flag boolean [note: 'Indicates whether this MEP threshold is mandated by state or federal regulation (true) or is a contractual/company policy (false).']
  short_rate_penalty_percentage decimal(5,2) [note: 'The short-rate penalty percentage applied in addition to the MEP when the insured cancels mid-term.']
  version_number varchar [note: 'Version number of this MEP threshold record, incremented with each modification for audit trail purposes.']

  Note: 'Defines the minimum earned premium (MEP) threshold per policy or coverage. Enforces MEP on short-rate cancellations and ensures minimum retained premium per regulatory and contractual requirements.'
}

Table premium.surplus_lines_tax {
  surplus_lines_tax_id varchar [pk, note: 'Unique identifier for the surplus lines tax record.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Surplus lines tax amounts require currency reference for proper accounting, payment processing, and multi-currency tax calculation. Currency_code denormalized, replace with FK.']
  policy_id varchar [note: 'Reference to the non-admitted policy subject to surplus lines tax.']
  tax_jurisdiction_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Surplus lines tax calculation is state-specific, requires state reference for tax rates, stamping office assignment, filing requirements, and regulatory compliance.']
  adjustment_amount decimal(18,2) [note: 'Any adjustment amount applied to the original tax calculation due to endorsements, cancellations, or corrections.']
  adjustment_reason varchar [note: 'Explanation of the reason for any tax adjustment.']
  created_timestamp timestamp [note: 'Timestamp when this surplus lines tax record was first created in the system.']
  diligent_search_completed_flag boolean [note: 'Indicates whether the required diligent search for admitted market coverage was completed before placing in surplus lines.']
  diligent_search_date date [note: 'Date on which the diligent search for admitted market coverage was completed.']
  diligent_search_documentation_reference varchar [note: 'Reference identifier to the diligent search documentation maintained for regulatory compliance.']
  exemption_code varchar [note: 'Code identifying any state-specific exemption or waiver applied to this surplus lines tax obligation.']
  exemption_reason varchar [note: 'Description of the reason for any exemption or waiver from surplus lines tax.']
  filing_period_end_date date [note: 'End date of the reporting period for which this surplus lines tax is being filed.']
  filing_period_start_date date [note: 'Start date of the reporting period for which this surplus lines tax is being filed.']
  gwp_subject_to_tax decimal(18,2) [note: 'Total gross written premium amount on which surplus lines tax is calculated.']
  home_state_allocation_percent decimal(5,4) [note: 'Percentage of premium allocated to the insured home state under NRRA multi-state allocation rules.']
  interest_amount decimal(18,2) [note: 'Interest amount accrued on overdue surplus lines tax obligations.']
  multi_state_allocation_flag boolean [note: 'Indicates whether this policy requires multi-state premium allocation for surplus lines tax purposes.']
  nonadmitted_insurer_naic_code varchar [note: 'Five-digit NAIC company code identifying the nonadmitted insurer that issued the policy.']
  nonadmitted_insurer_name varchar [note: 'Legal name of the nonadmitted insurer that issued the surplus lines policy.']
  notes varchar [note: 'Free-form notes or comments related to the surplus lines tax record for internal reference.']
  payment_reference_number varchar [note: 'Reference number or transaction identifier for the tax and fee payment remittance.']
  penalty_amount decimal(18,2) [note: 'Penalty amount assessed for late filing or late payment of surplus lines tax.']
  policy_effective_date date [note: 'Effective date of the non-admitted policy for which surplus lines tax is calculated.']
  policy_expiration_date date [note: 'Expiration date of the non-admitted policy.']
  stamping_fee_amount decimal(18,2) [note: 'Calculated stamping office fee amount due for processing the surplus lines policy.']
  stamping_fee_rate_percent decimal(5,4) [note: 'Stamping office fee rate expressed as a percentage of gross written premium.']
  stamping_office_code varchar [note: 'Code identifying the state-authorized surplus lines stamping office responsible for processing and collecting tax.']
  stamping_office_name varchar [note: 'Name of the surplus lines stamping office entity.']
  surplus_lines_broker_license_number varchar [note: 'License number of the surplus lines broker who placed the non-admitted policy.']
  surplus_lines_broker_name varchar [note: 'Name of the surplus lines broker responsible for placing the policy and remitting tax.']
  tax_amount decimal(18,2) [note: 'Calculated surplus lines tax amount due to the state.']
  tax_calculation_date date [note: 'Date on which the surplus lines tax and stamping fee were calculated.']
  tax_filed_date date [note: 'Actual date on which the surplus lines tax filing was submitted to the state or stamping office.']
  tax_filing_due_date date [note: 'Regulatory due date by which the surplus lines tax filing must be submitted to the state.']
  tax_paid_date date [note: 'Actual date on which the surplus lines tax and stamping fee payment was remitted.']
  tax_payment_due_date date [note: 'Regulatory due date by which the surplus lines tax and stamping fee payment must be remitted.']
  tax_rate_percent decimal(5,4) [note: 'State-specific surplus lines tax rate expressed as a percentage of gross written premium.']
  tax_status varchar [note: 'Current lifecycle status of the surplus lines tax obligation.']
  total_tax_and_fee_amount decimal(18,2) [note: 'Combined total of surplus lines tax and stamping fee due.']
  updated_timestamp timestamp [note: 'Timestamp when this surplus lines tax record was last modified.']

  Note: 'Surplus lines tax and stamping fee record per non-admitted policy. Captures state-specific tax rates, stamping office fees, diligent search requirements, and remittance due dates per state DOI surplus lines regulations.'
}

Table premium.finance_agreement {
  finance_agreement_id varchar [pk, note: 'Unique identifier for the premium finance agreement record.']
  billing_account_id varchar [note: 'Reference to the billing account associated with this finance agreement.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Premium finance agreements must reference currency for interest calculation, payment processing, and multi-currency financing. Currency_code denormalized, replace with FK.']
  insured_id varchar [note: 'Reference to the insured party who is the borrower under this finance agreement.']
  policy_id varchar [note: 'Reference to the insurance policy being financed through this agreement.']
  agreement_number varchar [note: 'Externally-known unique identifier assigned by the finance company for this agreement.']
  agreement_signed_date date [note: 'Date when the finance agreement was executed and signed by all parties.']
  agreement_status varchar [note: 'Current lifecycle status of the premium finance agreement.']
  agreement_type varchar [note: 'Classification of the finance agreement based on the type of policy or borrower segment.']
  annual_percentage_rate decimal(5,2) [note: 'Annualized interest rate charged on the financed amount, expressed as a percentage.']
  cancellation_date date [note: 'Date when the finance agreement was cancelled due to default, early payoff, or other reason.']
  cancellation_notice_days varchar [note: 'Number of days advance notice required before the finance company may cancel the policy for non-payment.']
  cancellation_reason_code varchar [note: 'Code indicating the reason the finance agreement was cancelled.']
  created_timestamp timestamp [note: 'Timestamp when this finance agreement record was first created in the system.']
  default_date date [note: 'Date when the finance agreement was declared in default due to non-payment or breach of terms.']
  delinquency_days varchar [note: 'Number of days the finance agreement has been in delinquent status due to missed payments.']
  down_payment_amount decimal(15,2) [note: 'Initial payment made by the insured at the inception of the finance agreement.']
  effective_date date [note: 'Date when the finance agreement becomes binding and the financing begins.']
  expiration_date date [note: 'Date when the finance agreement is scheduled to conclude and all obligations are due.']
  final_installment_due_date date [note: 'Date when the final installment payment is due, completing the repayment schedule.']
  finance_company_party_code varchar [note: 'Reference to the third-party premium finance company providing the financing.']
  financed_premium_amount decimal(15,2) [note: 'Total insurance premium amount being financed by the finance company.']
  first_installment_due_date date [note: 'Date when the first installment payment is due under the finance agreement.']
  grace_period_days varchar [note: 'Number of days after the due date during which payment may be made without penalty.']
  installment_amount decimal(15,2) [note: 'Fixed amount due for each scheduled installment payment under the finance agreement.']
  installment_frequency varchar [note: 'Frequency at which installment payments are scheduled to be made.']
  interest_rate_percent decimal(5,2) [note: 'Periodic interest rate applied to the outstanding balance, expressed as a percentage.']
  last_payment_amount decimal(15,2) [note: 'Amount of the most recent payment received and applied to the finance agreement.']
  last_payment_date date [note: 'Date when the most recent payment was received and applied to the finance agreement.']
  late_fee_amount decimal(15,2) [note: 'Fee charged for late or missed installment payments under the finance agreement terms.']
  modified_timestamp timestamp [note: 'Timestamp when this finance agreement record was last updated in the system.']
  next_payment_due_amount decimal(15,2) [note: 'Amount due for the next scheduled installment payment.']
  next_payment_due_date date [note: 'Date when the next scheduled installment payment is due.']
  number_of_installments varchar [note: 'Total count of scheduled repayment installments over the term of the finance agreement.']
  outstanding_balance_amount decimal(15,2) [note: 'Current unpaid principal and interest balance remaining on the finance agreement.']
  past_due_amount decimal(15,2) [note: 'Total amount of installment payments that are overdue and unpaid.']
  payoff_amount decimal(15,2) [note: 'Total amount required to satisfy and close the finance agreement, including principal, interest, and fees.']
  payoff_date date [note: 'Date when the finance agreement was paid in full and all obligations satisfied.']
  power_of_attorney_flag boolean [note: 'Indicates whether the finance company holds power of attorney to cancel the policy for non-payment.']
  total_amount_financed decimal(15,2) [note: 'Net amount provided to the insured after down payment, equal to financed premium minus down payment.']
  total_finance_charge_amount decimal(15,2) [note: 'Total interest and fees charged by the finance company over the life of the agreement.']
  total_paid_amount decimal(15,2) [note: 'Cumulative amount paid by the insured toward the finance agreement to date.']
  total_repayment_amount decimal(15,2) [note: 'Total amount the insured must repay including principal and finance charges.']

  Note: 'Records premium financing arrangements where a third-party premium finance company funds the policy premium. Tracks financed amount, interest rate, repayment schedule, and power-of-attorney cancellation rights.'
}

Table premium.premium_rate_filing {
  premium_rate_filing_id varchar [pk, note: 'Unique identifier for the premium rate filing record. Primary key.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Rate filings are LOB-specific regulatory submissions requiring LOB reference for statutory line classification and actuarial analysis. Lob denormalized, replace with FK.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Rate filings are state-specific regulatory submissions requiring state reference for DOI tracking, approval workflow, and compliance monitoring. State_code denormalized, replace with FK.']
  actuarial_justification varchar [note: 'Summary of the actuarial analysis and justification supporting the proposed rate change, including loss experience and trend factors.']
  actuary_credential varchar [note: 'Professional actuarial credential of the certifying actuary, such as FCAS, ACAS, FSA, ASA, MAAA.']
  actuary_name varchar [note: 'Name of the credentialed actuary who prepared and certified the rate filing analysis.']
  affected_policy_count varchar [note: 'Estimated number of policies that will be impacted by the rate change upon approval and implementation.']
  approval_date date [note: 'Date when the state Department of Insurance approved the rate filing. Null if not yet approved or if rejected.']
  certification_date date [note: 'Date when the actuary certified the rate filing analysis and supporting documentation.']
  competitive_impact_analysis varchar [note: 'Summary of the competitive market impact analysis showing how the proposed rates compare to market competitors.']
  consumer_impact_statement varchar [note: 'Statement describing the expected impact of the rate change on policyholders and consumers in the affected market.']
  created_timestamp timestamp [note: 'Timestamp when the rate filing record was first created in the system.']
  effective_date date [note: 'Date when the approved rates become effective and can be applied to new and renewal policies.']
  expiration_date date [note: 'Date when the filed rates expire and can no longer be used, if applicable. Null for indefinite filings.']
  filing_description varchar [note: 'Detailed description of the rate filing purpose, scope, and key changes being proposed to the regulator.']
  filing_fee_amount decimal(18,2) [note: 'Regulatory filing fee amount paid to the state Department of Insurance for processing the rate filing.']
  filing_fee_paid_flag boolean [note: 'Indicates whether the required filing fee has been paid to the state regulator. True if paid, False if outstanding.']
  filing_method varchar [note: 'Regulatory filing method required by the state: file and use, prior approval, use and file, flex rating, or no file required.']
  filing_number varchar [note: 'Unique regulatory filing number assigned by the state Department of Insurance (DOI) or insurer for tracking the rate filing submission.']
  filing_status varchar [note: 'Current lifecycle status of the rate filing with the regulatory authority: draft, submitted, under review, approved, rejected, withdrawn, or deferred. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|withdrawn|deferred — 7 candidates']
  filing_type varchar [note: 'Type of regulatory filing being submitted: rate change, new program introduction, rule modification, form filing, combined rate and rule, or withdrawal.']
  indicated_rate_change_percentage decimal(10,4) [note: 'Actuarially indicated rate change percentage based on loss experience analysis, before any capping or phasing adjustments.']
  insurer_response varchar [note: 'Insurers formal response to regulator comments, questions, or objections during the filing review process.']
  iso_program_code varchar [note: 'ISO program code if the filing uses or references ISO rating content, forms, or rules.']
  loss_ratio_target decimal(10,4) [note: 'Target loss ratio the rate filing is designed to achieve, expressed as a decimal (e.g., 0.6500 for 65%).']
  modified_timestamp timestamp [note: 'Timestamp when the rate filing record was last modified or updated in the system.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the legal insurance entity submitting the rate filing.']
  objection_period_end_date date [note: 'Date when the regulatory objection period ends, after which the filing is deemed approved if no objections are raised.']
  prior_filing_number varchar [note: 'Filing number of the previous rate filing for this line of business and state, establishing the baseline for the current change.']
  rate_change_percentage decimal(10,4) [note: 'Overall percentage change in rates being proposed in this filing, expressed as a decimal (e.g., 0.0750 for 7.5% increase, -0.0300 for 3% decrease).']
  rate_change_type varchar [note: 'Direction of the rate change: increase, decrease, no change, or variable by segment.']
  rate_impact_amount decimal(18,2) [note: 'Estimated dollar impact of the rate change on total written premium for the affected line of business and state.']
  rate_manual_version varchar [note: 'Version identifier of the rate manual or rating algorithm being filed for regulatory approval.']
  regulator_comments varchar [note: 'Comments, questions, or objections provided by the state Department of Insurance during the review process.']
  rejection_date date [note: 'Date when the state Department of Insurance rejected the rate filing. Null if approved or still under review.']
  serff_tracking_number varchar [note: 'SERFF system tracking number used by NAIC for electronic rate and form filing submissions to state regulators.']
  submission_date date [note: 'Date when the rate filing was officially submitted to the state Department of Insurance for review.']
  superseded_filing_number varchar [note: 'Filing number of any filing that this rate filing supersedes or replaces upon approval.']
  supporting_document_count varchar [note: 'Number of supporting documents submitted with the rate filing, including actuarial memoranda, rate manuals, and exhibits.']
  withdrawal_date date [note: 'Date when the insurer voluntarily withdrew the rate filing from regulatory review. Null if not withdrawn.']

  Note: 'Tracks state rate and rule filing submissions to DOI: filing number, LOB, effective date, approval status, SERFF tracking number, and rate change percentage. SSOT for regulatory rate approval lifecycle.'
}

Table premium.agency_bill_statement {
  agency_bill_statement_id varchar [pk, note: 'Unique identifier for the agency bill statement record.']
  agency_id varchar [note: 'Reference to the agency entity for which this bill statement is generated.']
  billing_account_id varchar [note: 'Reference to the billing account associated with this agency bill statement.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Agency billing statements require currency reference for commission calculation, payment processing, and multi-currency agency operations. Currency_code denormalized, replace with FK.']
  producers_producer_id varchar [note: 'Reference to the producing agent or broker receiving this statement.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Agency billing is often state-specific for regulatory reporting, commission tax calculation, and producer licensing compliance. State_code denormalized, replace with FK.']
  adjustment_amount decimal(18,2) [note: 'Total adjustments applied to the statement, including endorsements, cancellations, and corrections from prior periods.']
  balance_forward_amount decimal(18,2) [note: 'Outstanding balance carried forward from the previous agency bill statement period.']
  billing_method varchar [note: 'The billing arrangement method used for this statement, indicating whether the agency collects premium or the insurer bills directly.']
  cancellation_count varchar [note: 'Number of policy cancellations processed during the statement period that affected premium and are included in this bill.']
  commission_amount decimal(18,2) [note: 'Total commission earned by the producer on the premiums included in this statement.']
  commission_rate_percent decimal(5,2) [note: 'The average or blended commission rate percentage applied to calculate the commission amount for this statement.']
  created_timestamp timestamp [note: 'Timestamp when this agency bill statement record was first created in the system.']
  current_balance_amount decimal(18,2) [note: 'The current outstanding balance on the agency bill statement after applying all transactions and payments.']
  delinquency_days varchar [note: 'Number of days the statement balance is past due, calculated from the due date to the current date.']
  due_date date [note: 'The date by which the net amount due must be paid by the producer to avoid delinquency.']
  endorsement_count varchar [note: 'Number of policy endorsements processed during the statement period that affected premium and are included in this bill.']
  fees_amount decimal(18,2) [note: 'Total fees charged on the policies included in this statement, such as policy fees or installment fees.']
  gwp_amount decimal(18,2) [note: 'Total gross written premium for all policies included in this agency bill statement before any deductions.']
  issued_by_user_code varchar [note: 'Identifier of the system user or automated process that issued this agency bill statement.']
  lob_summary varchar [note: 'Comma-separated list or summary of lines of business included in this agency bill statement for reference and categorization.']
  modified_timestamp timestamp [note: 'Timestamp when this agency bill statement record was last modified or updated.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the insurance carrier issuing this agency bill statement.']
  net_amount_due decimal(18,2) [note: 'The net balance owed by the producer to the insurer or vice versa after all premiums, commissions, taxes, fees, and adjustments.']
  new_business_count varchar [note: 'Number of new business policies written during the statement period and included in this bill.']
  notes varchar [note: 'Free-text notes or comments related to this agency bill statement, including special instructions or dispute details.']
  nwp_amount decimal(18,2) [note: 'Net written premium after deducting commissions and other adjustments, representing the amount due to the insurer.']
  payment_received_amount decimal(18,2) [note: 'Total payments received from the producer during the statement period, applied against the outstanding balance.']
  payment_terms_days varchar [note: 'Number of days from the statement date within which payment is expected, defining the payment terms for the producer.']
  policy_count varchar [note: 'Total number of policies included in this agency bill statement for the billing period.']
  premium_tax_amount decimal(18,2) [note: 'Total premium taxes applicable to the policies included in this agency bill statement.']
  producer_contact_email varchar [note: 'Email address of the primary contact person at the producer agency for statement correspondence.']
  producer_contact_name varchar [note: 'Name of the primary contact person at the producer agency for inquiries related to this statement.']
  producer_contact_phone varchar [note: 'Phone number of the primary contact person at the producer agency for statement inquiries.']
  reconciliation_status varchar [note: 'Status indicating whether the agency bill statement has been reconciled with producer records and payments.']
  renewal_count varchar [note: 'Number of renewal policies processed during the statement period and included in this bill.']
  statement_date date [note: 'The date on which the agency bill statement was generated and issued to the producer.']
  statement_delivery_method varchar [note: 'The method by which this agency bill statement was delivered to the producer.']
  statement_format varchar [note: 'The file format in which the agency bill statement was generated and delivered.']
  statement_number varchar [note: 'Unique business identifier for the agency bill statement, typically formatted as a sequential or date-based code.']
  statement_period_end_date date [note: 'The ending date of the billing period covered by this agency bill statement.']
  statement_period_start_date date [note: 'The beginning date of the billing period covered by this agency bill statement.']
  statement_status varchar [note: 'Current lifecycle status of the agency bill statement indicating its payment and processing state.']

  Note: 'Monthly agency bill statement sent to producing agents/brokers summarizing net premiums due, commissions retained, and balance owed. Supports agency bill reconciliation and producer account settlement.'
}

Table reinsurance.ri_treaty {
  ri_treaty_id varchar [pk, note: 'Unique surrogate identifier for each reinsurance treaty or facultative certificate record in the Pc_Insurance reinsurance management system.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code in which treaty financial terms (retention, limit, premium) are denominated (e.g., USD, GBP, EUR).']
  lob_code_id varchar [note: 'NAIC or internal Line of Business (LOB) code identifying the class of business covered by the treaty (e.g., GL, WC, APD, Property). [ENUM-REF-CANDIDATE: promote to reference product]']
  originating_agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Treaties track originating agency for premium volume aggregation and agency-level profit sharing arrangements.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Treaties specify originating producer codes for subject premium attribution in profit commission calculations and bordereaux reporting.']
  admitted_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is admitted (licensed) in the cedant\'s domicile state. Admitted status affects credit for reinsurance on the NAIC statutory balance sheet.']
  aggregate_limit_amount decimal(18,2) [note: 'Maximum total amount the reinsurer will pay across all occurrences during the treaty period. Applies to aggregate stop-loss and CAT XL treaties with annual aggregate caps.']
  aggregate_retention_amount decimal(18,2) [note: 'Annual aggregate deductible or retention that must be exhausted before the aggregate reinsurance limit responds. Used in stop-loss and aggregate XOL structures.']
  am_best_rating varchar [note: 'A.M. Best financial strength rating of the lead reinsurer at treaty binding (e.g., A++, A+, A, A-, B++). Used to assess reinsurer credit quality and counterparty risk.']
  bound_date date [note: 'Date on which the reinsurance treaty was formally bound and agreed upon by all parties, marking the transition from negotiation to a legally binding contract.']
  broker_commission_pct decimal(7,4) [note: 'Percentage of ceded premium paid to the reinsurance broker as brokerage commission for placing the treaty. Expressed as a decimal (e.g., 0.0125 = 1.25%).']
  broker_name varchar [note: 'Name of the reinsurance intermediary broker (e.g., Aon, Guy Carpenter, Willis Re) who placed the treaty on behalf of Pc_Insurance.']
  cancellation_date date [note: 'Date on which the reinsurance treaty was cancelled prior to its natural expiry. Null if the treaty was not cancelled.']
  cat_event_definition varchar [note: 'Contractual definition of a catastrophe event for CAT XL treaties, including the hours clause (e.g., 72-hour clause for windstorm) and minimum loss threshold for event aggregation.']
  ceded_premium_amount decimal(18,2) [note: 'Total reinsurance premium ceded to the reinsurer panel for the treaty period. Represents the cost of reinsurance protection and is reported on NAIC Schedule F.']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to Pc_Insurance by the reinsurer as a ceding commission to offset acquisition and administrative costs. Applicable to QS treaties.']
  cession_percentage decimal(7,4) [note: 'Percentage of risk ceded to reinsurers under a Quota Share (QS) treaty. Expressed as a decimal (e.g., 0.3000 = 30%). Null for non-QS treaty types.']
  collateral_amount decimal(18,2) [note: 'Monetary value of collateral posted by the reinsurer to secure treaty obligations. Required for non-admitted reinsurers to qualify for credit for reinsurance under NAIC rules.']
  collateral_type varchar [note: 'Type of collateral posted by the reinsurer to secure obligations, required for non-admitted reinsurers under NAIC credit-for-reinsurance rules: LOC, Trust Fund, Funds Withheld, or None.']
  coverage_basis varchar [note: 'Defines the trigger basis for reinsurance coverage: Losses Occurring (events during treaty period), Risks Attaching (policies incepting during period), or Claims Made.']
  created_timestamp timestamp [note: 'Timestamp when the reinsurance treaty record was first created in the reinsurance management system. Used for audit trail and data lineage tracking.']
  deposit_premium_amount decimal(18,2) [note: 'Provisional reinsurance premium paid at treaty inception, subject to adjustment at year-end based on actual subject premium earned. Common in proportional treaties.']
  effective_date date [note: 'Date on which the reinsurance treaty or facultative certificate becomes effective and coverage obligations commence. Aligns with the treaty inception date in the RI system.']
  expiry_date date [note: 'Date on which the reinsurance treaty or facultative certificate expires and coverage obligations cease. Null for evergreen or open-ended treaties.']
  funds_withheld_flag boolean [note: 'Indicates whether Pc_Insurance withholds ceded premium funds from the reinsurer under a funds-withheld collateral arrangement, common with non-admitted reinsurers.']
  layer_number varchar [note: 'Sequential layer number within a multi-layer XOL or CAT XL tower (e.g., Layer 1, Layer 2). Identifies the position of this treaty within the overall reinsurance program structure.']
  lead_reinsurer_name varchar [note: 'Name of the lead reinsurer on the treaty panel who sets terms and conditions. The lead reinsurer\'s agreement is typically required for claims and endorsements.']
  lead_reinsurer_share_pct decimal(7,4) [note: 'Percentage of the treaty limit subscribed by the lead reinsurer. Expressed as a decimal (e.g., 0.2500 = 25% line). Total panel shares must sum to 100%.']
  limit_amount decimal(18,2) [note: 'Maximum monetary amount the reinsurer is obligated to pay under this treaty layer. For XOL, this is the layer width above the retention/attachment point.']
  loss_corridor_lower_pct decimal(7,4) [note: 'Lower bound of the loss corridor (as a percentage of subject premium) within which Pc_Insurance retains losses in a stop-loss or aggregate structure. Null if not applicable.']
  loss_corridor_upper_pct decimal(7,4) [note: 'Upper bound of the loss corridor (as a percentage of subject premium) above which reinsurance coverage resumes in a stop-loss or aggregate structure. Null if not applicable.']
  minimum_premium_amount decimal(18,2) [note: 'Minimum reinsurance premium guaranteed to the reinsurer regardless of subject premium volume. Protects the reinsurer against low-volume treaty years.']
  naic_reinsurer_code varchar [note: 'Five-digit NAIC company code assigned to the reinsurer, used for statutory Schedule F reporting and regulatory identification of the reinsurance counterparty.']
  perils_covered varchar [note: 'Description of the perils or causes of loss covered by the treaty (e.g., \'All Natural Perils\', \'Named Windstorm and Earthquake\', \'Fire and Allied Lines\'). Free-text or coded.']
  placement_type varchar [note: 'Indicates whether the reinsurance placement is a treaty (automatic, portfolio-wide) or facultative (FAC) certificate covering a specific risk or policy.']
  pml_amount decimal(18,2) [note: 'Probable Maximum Loss (PML) estimate for the subject portfolio covered by this treaty, used to size the reinsurance limit and assess adequacy of protection.']
  profit_commission_pct decimal(7,4) [note: 'Percentage of reinsurer profit returned to Pc_Insurance as a profit commission when the treaty loss ratio falls below a defined threshold. Incentivizes underwriting quality.']
  profit_commission_threshold_pct decimal(7,4) [note: 'Loss ratio threshold below which the profit commission mechanism is triggered. Expressed as a decimal (e.g., 0.6500 = 65% loss ratio). Null if no profit commission applies.']
  program_name varchar [note: 'Name of the overarching reinsurance program to which this treaty layer belongs (e.g., \'Property CAT Program 2024\'). Groups related layers for program-level reporting.']
  rate_on_line_pct decimal(7,4) [note: 'Rate on Line (ROL) expressed as a percentage of the treaty limit, representing the reinsurance premium as a proportion of the limit purchased. Key pricing metric for XOL treaties.']
  reinstatement_count varchar [note: 'Number of reinstatements available to restore the treaty limit after a loss occurrence. Common in CAT XL treaties. Zero indicates no reinstatements permitted.']
  reinstatement_premium_pct decimal(7,4) [note: 'Percentage of the original reinsurance premium charged to reinstate the treaty limit after a loss. Expressed as a decimal (e.g., 1.0000 = 100% pro-rata reinstatement premium).']
  retention_amount decimal(18,2) [note: 'The monetary amount or percentage of risk that Pc_Insurance retains before the reinsurance treaty responds. For XOL, this is the per-occurrence or per-risk retention (attachment point).']
  retention_type varchar [note: 'Indicates whether the retention is expressed as a fixed monetary amount (e.g., SIR or attachment point in USD) or as a percentage of the risk (used in QS treaties).']
  subject_premium_basis varchar [note: 'Defines the premium base to which the treaty rate or cession percentage is applied: Gross Written Premium (GWP), Net Written Premium (NWP), Earned Premium (EP), or Written Premium (WP).']
  territory_scope varchar [note: 'Geographic scope of risks covered by the treaty (e.g., \'USA and Canada\', \'Worldwide Excluding War Zones\'). Defines the territorial limits of reinsurance protection.']
  treaty_name varchar [note: 'Descriptive business name of the reinsurance treaty (e.g., \'Property CAT XL Layer 1 2024\') used for identification in bordereaux and management reporting.']
  treaty_number varchar [note: 'Externally-known alphanumeric identifier assigned to the reinsurance treaty or facultative (FAC) certificate by the reinsurance management system or lead reinsurer.']
  treaty_status varchar [note: 'Current lifecycle state of the reinsurance treaty: DRAFT (in negotiation), BOUND (signed/agreed), ACTIVE (in-force), EXPIRED, CANCELLED, or SUSPENDED.']
  treaty_type varchar [note: 'Classification of the reinsurance structure: Excess of Loss (XOL), Quota Share (QS), Catastrophe Excess of Loss (CAT XL), Facultative (FAC), CAT Bond, Stop Loss, or Aggregate.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the reinsurance treaty record in the reinsurance management system. Supports audit trail and change tracking requirements.']

  Note: 'Master record for each reinsurance treaty (XOL, QS, CAT XL, CAT Bond) placed by Pc_Insurance. Captures treaty type, structure, effective/expiry dates, reinsurer panel, retention, limit, and placement status.'
}

Table reinsurance.fac_certificate {
  fac_certificate_id varchar [pk, note: 'Unique surrogate identifier for each facultative reinsurance certificate record in the Pc_Insurance lakehouse silver layer.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Facultative certificates are underwritten against specific high-value coverages (not just policies).']
  currency_id varchar [note: 'ISO 4217 three-letter currency code in which all monetary amounts on this certificate are denominated (e.g., USD, GBP, EUR).']
  insured_entity_id varchar [note: 'Reference to the ceding company (Pc_Insurance entity) placing the facultative risk with the reinsurer.']
  lob_code_id varchar [note: 'NAIC or internal line of business code identifying the class of insurance (e.g., GL, CPP, WC, APD) covered by this facultative certificate.']
  policy_id varchar [note: 'Reference to the underlying primary insurance policy for which this facultative certificate provides reinsurance coverage.']
  reinsurer_id varchar [note: 'Reference to the reinsurer (counterparty) accepting the ceded risk under this facultative certificate.']
  risk_unit_id varchar [note: 'Reference to the specific insured risk or scheduled item being ceded under this facultative certificate.']
  accounting_period varchar [note: 'Financial accounting period (YYYY-MM) to which ceded premium and loss transactions on this certificate are posted in the general ledger.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized/accredited in the cedant\'s domicile state, affecting statutory credit for reinsurance on Schedule F.']
  bordereaux_period varchar [note: 'Reporting period (YYYY-MM or YYYY-Q#) in which this certificate is included in the bordereaux submission to the reinsurer.']
  bound_date date [note: 'Date on which the facultative certificate was formally bound and accepted by the reinsurer, establishing the contractual obligation.']
  cancellation_date date [note: 'Date on which the facultative certificate was cancelled prior to its scheduled expiry, if applicable.']
  cat_exposed_flag boolean [note: 'Indicates whether the risk ceded under this certificate is exposed to catastrophe (CAT) perils such as hurricane, earthquake, or flood.']
  ceded_alae_amount decimal(18,2) [note: 'Allocated Loss Adjustment Expense (ALAE) ceded to the reinsurer under this certificate, per treaty or certificate terms.']
  ceded_limit_amount decimal(18,2) [note: 'Maximum reinsurance recovery amount the reinsurer is liable for under this facultative certificate, expressed in the certificate currency.']
  ceded_loss_amount decimal(18,2) [note: 'Total loss amount ceded to the reinsurer under this certificate, representing the reinsurer\'s share of paid and reserved losses.']
  ceded_retention_amount decimal(18,2) [note: 'Dollar amount of loss retained by the cedant before the reinsurer\'s liability attaches under this facultative certificate.']
  ceded_share_pct decimal(7,4) [note: 'Percentage of the original risk ceded to the reinsurer under this certificate. Applicable for proportional (QS/surplus) arrangements.']
  ceding_commission_amount decimal(18,2) [note: 'Absolute dollar amount of ceding commission receivable from the reinsurer, derived from ceding_commission_pct applied to gross_ceded_premium.']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant as ceding commission to offset acquisition and administrative costs.']
  certificate_number varchar [note: 'Externally-known alphanumeric identifier assigned to the facultative certificate by the reinsurer or cedant, used in bordereaux and correspondence.']
  certificate_status varchar [note: 'Current lifecycle state of the facultative certificate from placement through expiry or cancellation.']
  collateral_amount decimal(18,2) [note: 'Dollar amount of collateral posted by the reinsurer to secure the cedant\'s reinsurance recoverable under this certificate.']
  collateral_required_flag boolean [note: 'Indicates whether the reinsurer is required to post collateral (trust, LOC, funds withheld) due to unauthorized status or credit terms.']
  collateral_type varchar [note: 'Type of collateral posted by the reinsurer to secure recoverable obligations: trust fund, letter of credit, funds withheld, or none.']
  created_timestamp timestamp [note: 'Timestamp when this facultative certificate record was first created in the system of record, used for audit trail and data lineage.']
  expiry_date date [note: 'Date on which the facultative certificate expires and reinsurance coverage ceases. Null for open-ended certificates.']
  fac_type varchar [note: 'Classification of the facultative arrangement: proportional (quota share, surplus) or non-proportional (excess of loss). Drives cession calculation methodology.']
  gross_ceded_premium decimal(18,2) [note: 'Gross Written Premium (GWP) ceded to the reinsurer under this certificate before deduction of ceding commission.']
  inception_date date [note: 'Date on which the facultative certificate becomes effective and reinsurance coverage commences.']
  insured_name varchar [note: 'Legal name of the insured party on the underlying policy, included on the facultative certificate for risk identification purposes.']
  net_ceded_premium decimal(18,2) [note: 'Net Written Premium (NWP) ceded to the reinsurer after deducting ceding commission from gross ceded premium.']
  original_tiv decimal(18,2) [note: 'Total Insured Value of the underlying risk at the time of facultative placement, used to size the ceded limit and premium.']
  placement_broker varchar [note: 'Name of the reinsurance intermediary or broker who facilitated the placement of this facultative certificate in the market.']
  pml_amount decimal(18,2) [note: 'Probable Maximum Loss (PML) estimate for the ceded risk, used to size the facultative limit and assess reinsurer exposure.']
  recoverable_balance decimal(18,2) [note: 'Outstanding reinsurance recoverable amount owed by the reinsurer to the cedant for ceded losses not yet collected.']
  risk_description varchar [note: 'Narrative description of the underlying insured risk being ceded, including COPE (Construction, Occupancy, Protection, Exposure) details for property risks.']
  rol_pct decimal(7,4) [note: 'Rate on Line (ROL) expressed as a percentage of the ceded limit, used to price non-proportional (XOL) facultative certificates.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this facultative certificate record was ingested into the lakehouse.']
  underwriter_name varchar [note: 'Name of the cedant\'s underwriter responsible for placing and managing this facultative certificate.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this facultative certificate record, supporting change tracking and incremental ETL processing.']
  xol_attachment_point decimal(18,2) [note: 'Loss amount at which the reinsurer\'s liability attaches under an excess of loss (XOL) facultative arrangement. Null for proportional certificates.']
  xol_exhaustion_point decimal(18,2) [note: 'Loss amount at which the reinsurer\'s layer is fully exhausted under an XOL facultative arrangement (attachment + limit).']

  Note: 'Master record for each facultative (FAC) reinsurance certificate placed on a specific risk or policy. Tracks FAC type, ceded limit, ceded premium, reinsurer, and certificate status independent of treaty structures.'
}

Table reinsurance.treaty_layer {
  treaty_layer_id varchar [pk, note: 'Unique surrogate identifier for each retention/limit layer record within a reinsurance treaty or facultative certificate structure.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this layer (e.g., USD, GBP, EUR). Supports multi-currency treaty structures.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Treaty layers (especially CAT XOL) are priced against location exposure schedules.']
  lob_code_id varchar [note: 'NAIC or internal Line of Business code identifying the class of business covered by this treaty layer (e.g., Commercial Auto, GL, Property, WC). Supports statutory reporting.']
  ri_treaty_id varchar [note: 'Reference to the parent reinsurance treaty or facultative certificate to which this layer belongs.']
  adjusted_premium decimal(18,2) [note: 'Final reinsurance premium after year-end adjustment reconciling deposit premium against actual subject premium earned. Reflects true cost of the layer for the period.']
  aggregate_annual_limit decimal(18,2) [note: 'Maximum total reinsurer liability across all occurrences within the treaty year for this layer. Caps cumulative reinsurer exposure on aggregate XOL structures.']
  aggregate_deductible decimal(18,2) [note: 'Cumulative loss amount the cedant must retain before the aggregate XOL layer responds. Used in aggregate stop-loss and aggregate XOL treaty structures.']
  alae_included boolean [note: 'Indicates whether Allocated Loss Adjustment Expense (ALAE) is included within the layer limit and attachment point calculations for this treaty layer.']
  attachment_point decimal(18,2) [note: 'The loss amount at which this reinsurance layer begins to respond. For XOL structures, losses must exceed this threshold before the reinsurer pays. Also known as the retention.']
  cat_event_limit decimal(18,2) [note: 'Maximum reinsurer liability per defined catastrophe event under a CAT XL layer. Distinct from per-risk occurrence limit; applies to accumulation of losses from a single CAT event.']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant by the reinsurer as a ceding commission to cover acquisition and administrative costs on QS treaties.']
  cession_percentage decimal(7,4) [note: 'Percentage of risk ceded to reinsurers under a Quota Share (QS) layer. Expressed as a decimal (e.g., 0.3000 = 30%). Applicable to QS and proportional treaty structures.']
  created_timestamp timestamp [note: 'Timestamp when this treaty layer record was first created in the reinsurance management system. Supports audit trail and data lineage requirements.']
  deposit_premium decimal(18,2) [note: 'Provisional premium paid to the reinsurer at inception of the treaty period, subject to adjustment at year-end based on actual subject premium earned.']
  effective_date date [note: 'Date on which this treaty layer becomes operative and eligible to accept ceded risk and premium.']
  exclusions_summary varchar [note: 'Free-text summary of key exclusions applicable to this layer (e.g., nuclear, cyber, war, NBCR). Supports underwriting review and reinsurer communication.']
  exhaustion_point decimal(18,2) [note: 'The loss level at which this layer is fully exhausted, calculated as attachment point plus layer limit. Marks the top of the layer in the reinsurance tower.']
  expiry_date date [note: 'Date on which this treaty layer ceases to be operative. Null for evergreen or continuous treaty layers.']
  hours_clause varchar [note: 'Number of consecutive hours defining the event window for CAT XL loss aggregation. Losses occurring within this window are treated as a single occurrence (e.g., 72 or 168 hours).']
  index_base_year varchar [note: 'The reference year used as the base for the index or stability clause adjustment. Applicable only when index_clause is true.']
  index_clause boolean [note: 'Indicates whether an index or stability clause applies to this layer, adjusting the attachment point and limit for inflation over the treaty period.']
  lae_treatment varchar [note: 'Specifies how LAE is handled within this layer. INCLUDED=LAE erodes the limit, EXCLUDED=LAE outside limit, PRO_RATA=LAE shared proportionally with losses.']
  layer_limit decimal(18,2) [note: 'Maximum amount the reinsurer will pay for losses within this layer per occurrence or per risk. Defines the top of the layer in the XOL tower.']
  layer_name varchar [note: 'Descriptive business name for the layer (e.g., \'First XOL Layer\', \'QS Tranche A\', \'CAT XL Working Layer\') used in bordereaux and reinsurer communications.']
  layer_number varchar [note: 'Sequential position of this layer within the treaty structure (e.g., 1 = first XOL layer, 2 = second XOL layer). Drives ordering in multi-layer tower analysis.']
  layer_status varchar [note: 'Current lifecycle state of the treaty layer. Drives whether cessions and premium calculations are applied against this layer.']
  layer_type varchar [note: 'Classification of the reinsurance layer structure. XOL=Excess of Loss, QS=Quota Share, CAT XL=Catastrophe Excess of Loss, FAC=Facultative, AGGREGATE_XL=Aggregate Excess of Loss.']
  loss_basis varchar [note: 'Trigger basis determining how losses are measured and applied to this layer. OCCURRENCE=per event, RISK=per insured risk, AGGREGATE=cumulative annual, CLAIMS_MADE=claims-made trigger.']
  max_ceding_commission_pct decimal(7,4) [note: 'Ceiling ceding commission rate applicable under a sliding scale commission arrangement. The cedant receives at most this rate when loss ratio is at its lowest.']
  min_ceding_commission_pct decimal(7,4) [note: 'Floor ceding commission rate applicable under a sliding scale commission arrangement. The cedant receives at least this rate regardless of loss ratio.']
  minimum_premium decimal(18,2) [note: 'Minimum reinsurance premium guaranteed to the reinsurer for this layer regardless of subject premium volume. Protects reinsurer against low-volume treaty years.']
  occurrence_limit decimal(18,2) [note: 'Maximum reinsurer liability per single occurrence or event under this layer. Distinct from the aggregate annual limit. Applies to per-occurrence XOL and CAT XL structures.']
  pml_basis varchar [note: 'Basis used to size the layer relative to the cedant\'s exposure. PML=Probable Maximum Loss, TIV=Total Insured Value, EML=Estimated Maximum Loss, MFL=Maximum Foreseeable Loss.']
  profit_commission_pct decimal(7,4) [note: 'Percentage of reinsurer profit returned to the cedant as a profit commission under proportional QS layers. Incentivizes cedant loss control.']
  reinstatement_count varchar [note: 'Number of reinstatements available for this layer after a loss exhausts the limit. Common in CAT XL structures where one or two reinstatements are negotiated.']
  reinstatement_premium_pct decimal(7,4) [note: 'Percentage of the original layer premium charged to reinstate the full limit after a loss. Expressed as a decimal (e.g., 1.0000 = 100% pro-rata reinstatement).']
  reinsurance_premium decimal(18,2) [note: 'Gross premium ceded to reinsurers for this layer for the treaty period. For XOL layers, derived from ROL times limit; for QS, from cession percentage times subject premium.']
  rol decimal(7,4) [note: 'Rate on Line expressed as a decimal fraction of the layer limit. Used to price non-proportional XOL and CAT XL layers. ROL multiplied by limit yields the reinsurance premium.']
  signed_line_pct decimal(7,4) [note: 'Total percentage of the layer capacity that has been signed by reinsurers at placement. Should sum to 100% for a fully placed layer. Tracks placement completeness.']
  sliding_scale_commission boolean [note: 'Indicates whether the ceding commission on this QS layer is subject to a sliding scale that varies inversely with the loss ratio, rewarding better underwriting performance.']
  subject_premium_basis varchar [note: 'Premium base used to calculate ceded premium for proportional layers. GWP=Gross Written Premium, NWP=Net Written Premium, EP=Earned Premium, WP=Written Premium.']
  territorial_scope varchar [note: 'Geographic territory covered by this treaty layer (e.g., \'USA\', \'USA and Canada\', specific state codes). Defines the geographic boundary of reinsurer liability.']
  treaty_year varchar [note: 'The underwriting or treaty year to which this layer belongs. Used for bordereaux processing, IBNR development, and year-of-account statutory reporting.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this treaty layer record. Used for change tracking, audit compliance, and incremental data pipeline processing.']
  written_line_pct decimal(7,4) [note: 'Percentage of the layer capacity initially offered and written by reinsurers before signing. May differ from signed line if the market is oversubscribed or undersubscribed.']

  Note: 'Defines each retention/limit layer within a treaty (e.g., first XOL layer, second XOL layer, QS tranche). Stores attachment point, limit, ROL, and layer sequence for multi-layer treaty structures.'
}

Table reinsurance.reinsurer {
  reinsurer_id varchar [pk, note: 'Unique surrogate identifier for each reinsurance counterparty record in the Pc_Insurance reinsurance management system.']
  am_best_outlook varchar [note: 'A.M. Best rating outlook indicating the expected direction of the reinsurer\'s financial strength rating over the medium term.']
  am_best_rating varchar [note: 'A.M. Best Financial Strength Rating (FSR) assigned to the reinsurer (e.g., A++, A+, A, A-, B++). Used to assess counterparty credit quality and treaty eligibility.']
  am_best_rating_date date [note: 'Date on which the current A.M. Best Financial Strength Rating was assigned or last affirmed, used to assess rating currency for treaty approval.']
  approved_lob_list varchar [note: 'Comma-delimited list of Lines of Business (LOB) for which this reinsurer is approved to accept cessions (e.g., GL, WC, APD, CAT XL). Governs treaty eligibility.']
  authorized_status varchar [note: 'Regulatory authorization status of the reinsurer in the cedant\'s domicile state, determining credit-for-reinsurance treatment under NAIC model law.']
  bank_account_reference varchar [note: 'Internal reference code for the reinsurer\'s designated bank account used for premium and loss settlement, stored as a tokenized reference to the financial system.']
  claims_contact_email varchar [note: 'Email address of the reinsurer\'s claims department or designated claims contact for loss notification and recovery correspondence.']
  class varchar [note: 'Broad classification of the reinsurer by organizational class: professional reinsurer, captive, government-sponsored, Lloyd\'s syndicate, or industry pool.']
  collateral_type varchar [note: 'Type of collateral arrangement in place with this reinsurer to secure recoverable balances: none, letter of credit, trust fund, funds withheld, or cash deposit.']
  counterparty_type varchar [note: 'Classification of the reinsurance counterparty indicating its structural role: reinsurer, retrocessionaire, captive, pool, Lloyd\'s syndicate, or fronting carrier.']
  created_timestamp timestamp [note: 'Timestamp when the reinsurer master record was first created in the system, in ISO 8601 format with timezone offset.']
  credit_limit_currency varchar [note: 'ISO 4217 three-letter currency code in which the reinsurer credit limit is denominated (e.g., USD, GBP, EUR).']
  credit_limit_usd decimal(18,2) [note: 'Maximum aggregate ceded exposure in USD that Pc_Insurance is authorized to place with this reinsurer across all treaties and facultative certificates.']
  domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction where the reinsurer is legally domiciled and holds its primary insurance license.']
  domicile_state varchar [note: 'Two-letter US state code of the reinsurer\'s state of domicile for domestic reinsurers, used in NAIC statutory reporting and credit-for-reinsurance determinations.']
  fein varchar [note: 'IRS-issued Federal Employer Identification Number (FEIN) for the reinsurer entity, used in tax reporting and financial settlement.']
  funds_withheld_eligible boolean [note: 'Indicates whether this reinsurer is eligible for funds-withheld collateral arrangements as an alternative to letters of credit for credit-for-reinsurance purposes.']
  last_review_date date [note: 'Date of the most recent periodic counterparty credit and compliance review conducted by the reinsurance or risk management team.']
  legal_name varchar [note: 'Full legal registered name of the reinsurance counterparty as filed with the domicile regulator and used in treaty and facultative contracts.']
  lifecycle_status varchar [note: 'Current operational status of the reinsurer counterparty record, governing whether new treaties or facultative placements may be bound with this entity.']
  lloyds_syndicate_number varchar [note: 'Lloyd\'s of London syndicate number for reinsurers operating as Lloyd\'s syndicates. Null for non-Lloyd\'s entities.']
  loc_required boolean [note: 'Indicates whether a Letter of Credit (LOC) is required from this reinsurer as collateral to support credit-for-reinsurance on the cedant\'s statutory balance sheet.']
  max_single_risk_limit_usd decimal(18,2) [note: 'Maximum ceded limit in USD that may be placed with this reinsurer on any single risk or facultative certificate, per internal counterparty concentration policy.']
  naic_code varchar [note: 'Five-digit NAIC company code assigned to the reinsurer for statutory reporting, regulatory filings, and industry data exchange.']
  naic_group_code varchar [note: 'NAIC-assigned group code identifying the reinsurance holding group, used for group-level concentration risk monitoring and statutory reporting.']
  next_review_date date [note: 'Scheduled date for the next periodic counterparty credit and compliance review, based on rating tier and exposure concentration.']
  onboarding_date date [note: 'Date on which the reinsurer was formally approved and onboarded as an authorized counterparty in the Pc_Insurance reinsurance management system.']
  parent_group_name varchar [note: 'Name of the ultimate parent holding group or reinsurance group to which this reinsurer entity belongs, used for group-level credit limit aggregation.']
  preferred_settlement_currency varchar [note: 'ISO 4217 three-letter currency code preferred by the reinsurer for premium and loss settlement transactions.']
  primary_contact_email varchar [note: 'Email address of the primary relationship contact at the reinsurer for operational communications.']
  primary_contact_name varchar [note: 'Full name of the primary relationship contact at the reinsurer for treaty negotiations, claims, and bordereaux submissions.']
  primary_contact_phone varchar [note: 'Direct telephone number of the primary relationship contact at the reinsurer.']
  registered_address_city varchar [note: 'City of the reinsurer\'s official registered office address.']
  registered_address_country varchar [note: 'ISO 3166-1 alpha-3 country code of the reinsurer\'s registered office address.']
  registered_address_line1 varchar [note: 'First line of the reinsurer\'s official registered office address as filed with the domicile regulator.']
  sanctions_screen_date date [note: 'Date on which the most recent OFAC and international sanctions screening was completed for this reinsurer counterparty.']
  sanctions_screened boolean [note: 'Indicates whether this reinsurer has passed the most recent OFAC and international sanctions screening required before treaty placement or payment.']
  settlement_terms_days varchar [note: 'Standard number of days from bordereaux submission or loss advice to expected settlement payment from the reinsurer, per treaty or market convention.']
  sp_rating varchar [note: 'S&P Global Ratings insurer financial strength rating for the reinsurer (e.g., AAA, AA+, AA, A+, A, BBB). Supplements A.M. Best for counterparty risk assessment.']
  sp_rating_date date [note: 'Date on which the current S&P Global financial strength rating was assigned or last affirmed.']
  swift_bic_code varchar [note: 'SWIFT Bank Identifier Code (BIC) for the reinsurer\'s settlement bank, used for international wire transfers of premium and loss payments.']
  trading_name varchar [note: 'Doing Business As (DBA) or commercial brand name used by the reinsurer in market communications, distinct from the legal registered name.']
  trust_fund_eligible boolean [note: 'Indicates whether this reinsurer maintains a qualifying US trust fund under NAIC model law, enabling credit-for-reinsurance without LOC for unauthorized reinsurers.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the reinsurer master record, used for change tracking and data lineage in the Databricks Silver layer.']

  Note: 'Master record for each reinsurance counterparty (reinsurer or retrocessionaire). Captures legal name, NAIC code, A.M. Best rating, domicile, authorized status, and credit limit for counterparty risk management.'
}

Table reinsurance.treaty_reinsurer {
  treaty_reinsurer_id varchar [pk, note: 'Unique surrogate identifier for each treaty-reinsurer participation record in the reinsurance panel.']
  reinsurer_id varchar [note: 'Reference to the reinsurer party entity participating in this treaty panel.']
  ri_broker_id varchar [note: 'Reference to the reinsurance broker who placed this reinsurer\'s line on the treaty, used for brokerage commission and placement tracking.']
  ri_treaty_id varchar [note: 'Reference to the parent reinsurance treaty to which this reinsurer participates.']
  treaty_replacement_reinsurer_id varchar [note: 'Reference to the reinsurer who replaced this participant on the treaty panel following a withdrawal or capacity reduction.']
  am_best_rating varchar [note: 'A.M. Best financial strength rating of the reinsurer at the time of treaty placement, used for credit quality and security assessment.']
  brokerage_commission_pct decimal(7,4) [note: 'Percentage of ceded premium payable to the reinsurance broker for placing this reinsurer\'s line on the treaty.']
  ceded_lae_amount decimal(18,2) [note: 'Total Loss Adjustment Expense (LAE) ceded to this reinsurer under this treaty participation for the current treaty period.']
  ceded_loss_amount decimal(18,2) [note: 'Total losses ceded to this reinsurer under this treaty participation for the current treaty period, in the treaty currency.']
  ceded_premium_amount decimal(18,2) [note: 'Total premium ceded to this reinsurer under this treaty participation for the current treaty period, in the treaty currency.']
  collateral_held_amount decimal(18,2) [note: 'Actual amount of collateral currently held from this reinsurer (letters of credit, trust funds, funds withheld) for credit for reinsurance.']
  collateral_required_amount decimal(18,2) [note: 'Amount of collateral required from this reinsurer to support credit for reinsurance, based on authorization status and applicable regulations.']
  collateral_type varchar [note: 'Type of collateral arrangement held from this reinsurer (e.g., letter of credit, trust fund, funds withheld, cash deposit).']
  created_timestamp timestamp [note: 'Timestamp when this treaty-reinsurer participation record was first created in the reinsurance management system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which ceded premium, losses, and recoverable balances are denominated for this reinsurer.']
  domicile_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the reinsurer\'s domicile jurisdiction, used for credit for reinsurance and regulatory reporting.']
  effective_date date [note: 'Date on which this reinsurer\'s participation in the treaty becomes binding and effective.']
  expiry_date date [note: 'Date on which this reinsurer\'s participation in the treaty expires or terminates. Null for open-ended participations.']
  funds_withheld_amount decimal(18,2) [note: 'Amount of ceded premium withheld by the cedant from this reinsurer under a funds withheld arrangement, reducing settlement cash flows.']
  is_authorized_reinsurer boolean [note: 'Indicates whether this reinsurer is authorized (licensed) in the cedant\'s domicile state, affecting credit for reinsurance treatment.']
  is_certified_reinsurer boolean [note: 'Indicates whether this reinsurer holds certified reinsurer status under NAIC Credit for Reinsurance Model Law, enabling reduced collateral requirements.']
  is_lead_reinsurer boolean [note: 'Indicates whether this reinsurer is the lead underwriter on the treaty panel, responsible for setting terms and conditions.']
  naic_reinsurer_code varchar [note: 'NAIC-assigned five-digit company code for the reinsurer, used in statutory Schedule F and reinsurance regulatory filings.']
  offered_line_pct decimal(7,4) [note: 'The percentage of the treaty capacity initially offered to this reinsurer during placement, before signing adjustments.']
  order_hereon_pct decimal(7,4) [note: 'The percentage of the total treaty order placed with this reinsurer, reflecting the cedant\'s actual placement instruction.']
  panel_sequence varchar [note: 'Ordering sequence of this reinsurer within the treaty panel, used for bordereaux presentation and cession processing priority.']
  participation_notes varchar [note: 'Free-text notes capturing special conditions, side agreements, or underwriting remarks specific to this reinsurer\'s participation on the treaty.']
  participation_reference varchar [note: 'Externally-known unique reference number assigned to this reinsurer\'s line on the treaty, used in bordereaux and cession statements.']
  participation_status varchar [note: 'Current lifecycle status of the reinsurer\'s participation on the treaty panel (e.g., active, signed, withdrawn, pending, cancelled, suspended).']
  profit_commission_pct decimal(7,4) [note: 'Profit commission percentage payable by this reinsurer to the cedant if the treaty produces a profit, per the profit commission formula.']
  rating_as_of_date date [note: 'Date as of which the reinsurer\'s financial strength ratings (A.M. Best, S&P) were captured for this participation record.']
  recoverable_balance decimal(18,2) [note: 'Outstanding reinsurance recoverable balance owed by this reinsurer to the cedant, representing unpaid ceded losses and LAE.']
  reinsurance_commission_pct decimal(7,4) [note: 'Commission percentage payable by this reinsurer to the cedant on ceded premium, applicable for quota share and proportional treaties.']
  reinsurer_role varchar [note: 'Role of the reinsurer on the treaty panel (e.g., lead, follow, co-reinsurer, fronting, security), indicating their authority and position.']
  signed_line_pct decimal(7,4) [note: 'The final signed share percentage allocated to this reinsurer after signing-down of the oversubscribed panel.']
  signing_date date [note: 'Date on which this reinsurer formally signed their line on the treaty, confirming their participation and subscribed share.']
  sliding_scale_max_commission_pct decimal(7,4) [note: 'Maximum commission percentage under a sliding scale commission arrangement, applied when the loss ratio is at its minimum threshold.']
  sliding_scale_min_commission_pct decimal(7,4) [note: 'Minimum commission percentage under a sliding scale commission arrangement, applied when the loss ratio reaches its maximum threshold.']
  sp_rating varchar [note: 'Standard & Poor\'s (S&P) financial strength rating of the reinsurer at the time of treaty placement, used for panel security evaluation.']
  subscribed_share_pct decimal(7,4) [note: 'The reinsurer\'s confirmed subscribed share of the treaty, representing their proportional participation used for cession and premium allocation.']
  updated_timestamp timestamp [note: 'Timestamp when this treaty-reinsurer participation record was last modified in the reinsurance management system.']
  withdrawal_date date [note: 'Date on which this reinsurer withdrew from the treaty panel, if applicable. Null for active participations.']
  withdrawal_reason varchar [note: 'Reason for the reinsurer\'s withdrawal from the treaty panel (e.g., capacity reduction, credit downgrade, market exit, cedant request).']
  written_line_pct decimal(7,4) [note: 'The percentage of the treaty capacity written (committed) by this reinsurer at the time of placement, prior to signing-down.']

  Note: 'Junction table linking a treaty to its participating reinsurers with each reinsurer\'s subscribed share percentage, signed line, written line, and participation status. Supports multi-reinsurer panel structures.'
}

Table reinsurance.reinsurance_cession {
  reinsurance_cession_id varchar [pk, note: 'Unique surrogate identifier for each cession transaction record in the reinsurance cession ledger.']
  bordereaux_id varchar [note: 'Foreign key linking to reinsurance.bordereaux. Business justification: Cessions are reported in bordereaux submissions. Currently has bordereaux_period (string), should have proper FK to the actual bordereaux record for referential integrity and join']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Cessions must identify the specific coverage being ceded for accurate premium allocation, loss recovery calculations, and bordereaux reporting.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this cession record (e.g., USD, GBP, EUR).']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: Cessions can be under either treaty OR FAC certificate. Currently cession has treaty_id but missing fac_certificate_id for FAC-based cessions.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property cessions reference specific insured locations to determine ceded TIV, apply retention and limit, and validate treaty coverage.']
  lob_code_id varchar [note: 'NAIC line of business code or description for the ceded risk (e.g., Commercial Auto, GL, Property, WC). Used in bordereaux and statutory reporting. [ENUM-REF-CANDIDATE: promote to reference product]']
  policy_id varchar [note: 'Reference to the underlying insurance policy whose risk is being ceded to the reinsurer.']
  reinsurer_id varchar [note: 'Reference to the reinsurer counterparty accepting the ceded risk on this transaction.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty or facultative (FAC) certificate under which this cession is placed.']
  risk_unit_id varchar [note: 'Reference to the specific risk exposure or scheduled item being ceded, enabling sub-policy cession granularity.']
  treaty_layer_id varchar [note: 'Foreign key linking to reinsurance.treaty_layer. Business justification: Cessions apply to specific treaty layers. Currently has layer_number (INT), should have proper FK to treaty_layer for full layer definition and terms.']
  am_best_rating varchar [note: 'A.M. Best financial strength rating of the assuming reinsurer at the time of cession placement, used for credit quality and collateral requirement assessment.']
  attachment_point decimal(18,2) [note: 'Dollar threshold at which the reinsurer\'s liability begins for excess of loss (XOL) and CAT XL structures. Null for pro-rata cessions.']
  basis varchar [note: 'Contractual basis on which losses are ceded: risks attaching, losses occurring, or claims made. Determines which policy periods are covered under the treaty.']
  cat_event_code varchar [note: 'Industry catastrophe event code (e.g., ISO/PCS event code) linking this cession to a declared catastrophe (CAT) occurrence for CAT XL recovery tracking.']
  ceded_alae decimal(18,2) [note: 'Allocated loss adjustment expense (ALAE) ceded to the reinsurer under this transaction, representing defense and cost containment expenses.']
  ceded_earned_premium decimal(18,2) [note: 'Portion of the ceded written premium that has been earned through the exposure period to date, used in loss ratio and statutory reporting.']
  ceded_ibnr decimal(18,2) [note: 'Actuarial estimate of incurred but not reported (IBNR) losses ceded to the reinsurer, used in statutory reserving and Schedule F reporting.']
  ceded_limit decimal(18,2) [note: 'Maximum reinsurance recovery limit ceded under this transaction. For XOL structures, this is the layer limit above the retention.']
  ceded_loss_paid decimal(18,2) [note: 'Cumulative paid loss amount ceded to and recovered from the reinsurer under this cession as of the reporting date.']
  ceded_loss_reserve decimal(18,2) [note: 'Outstanding case reserve (OCR) amount ceded to the reinsurer representing estimated future loss payments recoverable under this cession.']
  ceded_share_pct decimal(7,4) [note: 'Percentage of the risk ceded to the reinsurer under this transaction, expressed as a decimal (e.g., 0.3000 = 30%). Used in quota share (QS) and pro-rata calculations.']
  ceded_tiv decimal(18,2) [note: 'Total insured value (TIV) of the risk exposure ceded to the reinsurer under this cession, used for property and CAT accumulation tracking.']
  ceded_unearned_premium decimal(18,2) [note: 'Unearned portion of the ceded written premium representing the reinsurer\'s liability for unexpired risk as of the reporting date.']
  ceded_written_premium decimal(18,2) [note: 'Portion of the gross written premium (GWP) ceded to the reinsurer under this transaction. Reduces net written premium (NWP) on the cedant\'s books.']
  ceding_commission_amount decimal(18,2) [note: 'Dollar amount of ceding commission receivable from the reinsurer on this cession, calculated as ceded premium multiplied by the ceding commission rate.']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant by the reinsurer as a ceding commission to offset acquisition and administrative costs.']
  collateral_amount decimal(18,2) [note: 'Dollar amount of collateral posted by the reinsurer (letter of credit or trust) to secure the cedant\'s reinsurance recoverable on this cession.']
  collateral_required boolean [note: 'Indicates whether the reinsurer is required to post collateral (e.g., letter of credit or trust fund) for this cession due to unauthorized reinsurer status.']
  created_timestamp timestamp [note: 'Timestamp when this cession record was first created in the reinsurance management system.']
  effective_date date [note: 'Date on which this cession becomes effective and the reinsurer assumes its share of the ceded risk.']
  endorsement_reference varchar [note: 'Reference to the policy endorsement (ENDT) that triggered or modified this cession, linking mid-term changes to the corresponding cession adjustment.']
  expiry_date date [note: 'Date on which this cession expires and the reinsurer\'s liability for new losses ceases under the ceded risk.']
  gross_written_premium decimal(18,2) [note: 'Total gross written premium (GWP) on the underlying policy or risk exposure before any cession or reinsurance deduction.']
  is_retrocession boolean [note: 'Indicates whether this cession is a retrocession (i.e., the cedant is itself a reinsurer ceding risk further to a retrocessionaire).']
  naic_company_code varchar [note: 'Five-digit NAIC company code of the assuming reinsurer, required for Schedule F statutory reporting and reinsurer credit risk assessment.']
  number varchar [note: 'Externally-known business reference number assigned to this cession event, used in bordereaux reporting and reinsurer correspondence.']
  placement_type varchar [note: 'Indicates whether the cession is placed under a standing reinsurance treaty or a facultative (FAC) certificate for an individual risk.']
  profit_commission_pct decimal(7,4) [note: 'Percentage of reinsurer profit returned to the cedant as a profit commission under sliding-scale or profit-sharing treaty arrangements.']
  rate_on_line_pct decimal(7,4) [note: 'Rate on line (ROL) expressed as a percentage of the reinsurance limit, used to price XOL and CAT XL layers and assess cost efficiency.']
  reinstatement_premium decimal(18,2) [note: 'Additional premium paid to reinstate the reinsurance limit after a loss occurrence has eroded the layer, applicable to XOL and CAT XL structures.']
  reinsurance_cession_date date [note: 'The business event date on which the cession was formally recorded and submitted to the reinsurer, distinct from the risk effective date.']
  reinsurance_cession_status varchar [note: 'Current lifecycle state of the cession transaction. [ENUM-REF-CANDIDATE: draft|active|amended|cancelled|expired|settled — promote to reference product if statuses expand]']
  reinsurance_cession_type varchar [note: 'Classification of the cession structure: pro-rata (quota share), excess of loss (XOL), facultative (FAC), catastrophe excess of loss (CAT XL), or catastrophe bond (CAT Bond).']
  reinsurance_recoverable decimal(18,2) [note: 'Total reinsurance recoverable balance on this cession, comprising ceded paid losses, ceded reserves, and ceded IBNR outstanding from the reinsurer.']
  retention_amount decimal(18,2) [note: 'The cedant\'s net retained loss amount before reinsurance recovery applies. For XOL, this is the attachment point; for QS, it is the retained share amount.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this cession record, supporting audit trail and change tracking.']

  Note: 'Transactional cession event linking a ceded policy or risk exposure to a treaty or FAC certificate via foreign keys. Captures ceded TIV, premium, limit, retention, effective date, share, per-policy endorsement reference, and cession basis (pro-rata or'
}

Table reinsurance.policy_cession {
  policy_cession_id varchar [pk, note: 'Unique surrogate identifier for each policy-cession pairing record in the junction table.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Policy cessions often apply to specific coverages within a policy rather than all coverages uniformly.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this policy-cession record (e.g., USD, GBP, EUR).']
  endorsement_id varchar [note: 'Reference to the policy endorsement (ENDT) that triggered or modified this policy-cession pairing, if applicable.']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: Policy_cession can link to FAC certificates. Currently has facultative_certificate_number (string), should have proper FK to fac_certificate for referential integrity.']
  lob_code_id varchar [note: 'NAIC or internal line of business (LOB) code for the ceded policy (e.g., GL, WC, APD, BOP, CPP). Used for bordereaux segmentation and statutory reporting.']
  policy_id varchar [note: 'Reference to the insurance policy being ceded under this record.']
  reinsurance_cession_id varchar [note: 'Reference to the reinsurance cession record (treaty or facultative certificate) under which this policy is ceded.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty or facultative (FAC) certificate governing this cession.']
  attachment_point decimal(18,2) [note: 'The loss amount at which the reinsurer\'s liability attaches under an Excess of Loss (XOL) or CAT XL layer for this policy-cession pairing.']
  bordereaux_included boolean [note: 'Indicates whether this policy-cession record has been included in a bordereaux submission to the reinsurer for the current reporting period.']
  bordereaux_period varchar [note: 'The YYYY-MM reporting period for which this policy-cession record is included in the bordereaux submission to the reinsurer.']
  cancellation_date date [note: 'Date on which this policy-cession pairing was cancelled, if applicable. Null for active or expired records.']
  cancellation_reason varchar [note: 'Reason code for the cancellation of this policy-cession pairing.']
  cat_event_code varchar [note: 'Industry or internal catastrophe (CAT) event code associated with this cession, used for CAT XL recovery tracking and PML reporting.']
  ceded_alae decimal(18,2) [note: 'Allocated loss adjustment expense (ALAE) ceded to the reinsurer under this policy-cession pairing.']
  ceded_ibnr decimal(18,2) [note: 'Actuarial estimate of ceded IBNR reserves attributable to this policy-cession pairing, representing unreported losses expected to be recovered from the reinsurer.']
  ceded_limit_amount decimal(18,2) [note: 'Maximum monetary amount the reinsurer is liable for under this policy-cession pairing, representing the reinsurer\'s limit layer.']
  ceded_loss_paid decimal(18,2) [note: 'Total loss amounts paid by the reinsurer under this policy-cession pairing to date.']
  ceded_loss_reserve decimal(18,2) [note: 'Outstanding case reserve (OCR) amount ceded to the reinsurer for open claims under this policy-cession pairing.']
  ceded_premium_earned decimal(18,2) [note: 'Portion of the ceded written premium that has been earned as of the reporting date, based on the policy exposure period.']
  ceded_premium_written decimal(18,2) [note: 'Gross written premium (GWP) ceded to the reinsurer for this policy-cession pairing at policy inception or renewal.']
  ceded_share_pct decimal(7,4) [note: 'Percentage of the risk ceded to the reinsurer under this pairing, expressed as a decimal (e.g., 0.3000 = 30%). Used in Quota Share (QS) and proportional treaties.']
  ceded_unearned_premium decimal(18,2) [note: 'Portion of the ceded written premium not yet earned as of the reporting date, representing the reinsurer\'s unearned premium reserve liability.']
  ceding_commission_amount decimal(18,2) [note: 'Monetary amount of ceding commission receivable from the reinsurer for this policy-cession pairing.']
  ceding_commission_pct decimal(7,4) [note: 'Percentage of ceded premium returned to the cedant as ceding commission by the reinsurer under proportional (QS) treaties.']
  cession_reference_number varchar [note: 'Externally-known alphanumeric reference number assigned to this policy-cession pairing, used in bordereaux and reinsurer reporting.']
  created_timestamp timestamp [note: 'Timestamp when this policy-cession record was first created in the system.']
  effective_date date [note: 'Date on which this policy-cession pairing becomes effective and the ceded risk transfer begins.']
  exhaustion_point decimal(18,2) [note: 'The loss amount at which the reinsurer\'s layer is fully exhausted (attachment point plus ceded limit). Defines the top of the reinsurance layer.']
  expiration_date date [note: 'Date on which this policy-cession pairing expires and the ceded risk transfer ends. Null for open-ended cessions.']
  net_written_premium decimal(18,2) [note: 'Net written premium (NWP) retained by Pc_Insurance after cession for this policy, calculated as gross written premium minus ceded written premium.']
  policy_term_type varchar [note: 'Indicates whether this cession relates to a new business (NB), renewal (REN), endorsement (ENDT), cancellation (CANC), or reinstatement transaction.']
  profit_commission_amount decimal(18,2) [note: 'Profit commission receivable from the reinsurer based on favorable loss experience under this policy-cession pairing.']
  reinstatement_premium decimal(18,2) [note: 'Additional premium paid to reinstate the reinsurance limit after a loss occurrence has partially or fully exhausted the ceded layer.']
  reinsurance_recoverable decimal(18,2) [note: 'Total reinsurance recoverable balance outstanding from the reinsurer for this policy-cession pairing, including paid and reserved amounts.']
  reinsurer_share_pct decimal(7,4) [note: 'Percentage of the ceded layer subscribed by a specific reinsurer where multiple reinsurers participate in the same treaty or FAC placement.']
  retention_amount decimal(18,2) [note: 'Monetary amount retained by the cedant (Pc_Insurance) before the reinsurer\'s layer attaches. Represents the cedant\'s net retention per policy.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this policy-cession record originated (e.g., SICS, Sapiens ReinsuranceMaster, Guidewire PolicyCenter).']
  tiv_ceded decimal(18,2) [note: 'Total insured value (TIV) of the ceded risk exposure under this policy-cession pairing, used for property CAT modeling and PML calculations.']
  updated_timestamp timestamp [note: 'Timestamp when this policy-cession record was last modified.']

  Note: 'Junction table resolving the many-to-many relationship between policies and cessions. Tracks which policies are ceded under which cession records, with ceded share, effective period, and endorsement reference per policy-cession pairing.'
}

Table reinsurance.bordereaux {
  bordereaux_id varchar [pk, note: 'Unique surrogate identifier for the bordereaux submission record in the reinsurance management system.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code in which all monetary amounts on this bordereaux are denominated.']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: Bordereaux submissions can be for FAC certificates, not just treaties. Currently only has treaty_id. Missing FK for FAC bordereaux reporting.']
  lob_code_id varchar [note: 'NAIC or internal Line of Business code identifying the class of business covered by this bordereaux (e.g., GL, WC, APD, BOP).']
  prior_bordereaux_id varchar [note: 'Reference to the previous version of this bordereaux that was superseded by the current corrected or amended submission.']
  reinsurer_id varchar [note: 'Reference to the reinsurer party receiving this bordereaux submission.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty under which this bordereaux is submitted.']
  accounting_period varchar [note: 'Fiscal accounting period (e.g., 2024-Q1 or 2024-M03) to which the ceded premium and loss figures in this bordereaux are posted.']
  acknowledgement_date date [note: 'Date on which the reinsurer formally acknowledged receipt and acceptance of the bordereaux submission.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized or accredited in the cedant\'s domicile state, affecting credit for reinsurance on statutory balance sheet.']
  bordereaux_type varchar [note: 'Classifies the bordereaux as a premium bordereaux (ceded premium activity), loss bordereaux (ceded loss activity), combined, or adjustment.']
  cat_event_code varchar [note: 'Industry or internal CAT event code (e.g., ISO PCS code) identifying a catastrophe event included in this loss bordereaux.']
  cat_exposed_flag boolean [note: 'Indicates whether this bordereaux includes losses or premiums attributable to a declared catastrophe (CAT) event.']
  ceded_alae_amount decimal(18,2) [note: 'Allocated Loss Adjustment Expense (ALAE) ceded to the reinsurer for the reporting period, recoverable under treaty terms.']
  ceded_ibnr_amount decimal(18,2) [note: 'Ceded portion of the Incurred But Not Reported (IBNR) reserve included in this bordereaux for the reporting period.']
  ceded_loss_amount decimal(18,2) [note: 'Total paid and outstanding ceded loss amount recoverable from the reinsurer for the reporting period.']
  ceded_premium_adjustment decimal(18,2) [note: 'Adjustment to ceded premium arising from endorsements, cancellations, or audit premiums included in this bordereaux period.']
  ceded_share_pct decimal(7,4) [note: 'Percentage of risk ceded to the reinsurer under the treaty for this bordereaux period, expressed as a decimal (e.g., 0.3000 = 30%).']
  ceded_tiv decimal(18,2) [note: 'Aggregate Total Insured Value (TIV) of risks ceded to the reinsurer under this bordereaux for the reporting period.']
  ceded_ulae_amount decimal(18,2) [note: 'Unallocated Loss Adjustment Expense (ULAE) ceded to the reinsurer for the reporting period where treaty terms permit recovery.']
  ceding_commission_amount decimal(18,2) [note: 'Total ceding commission earned by the cedant on ceded premium for the reporting period, reducing net ceded premium payable.']
  claim_count varchar [note: 'Number of individual claims included in this loss bordereaux submission for the reporting period.']
  created_timestamp timestamp [note: 'Timestamp when this bordereaux record was first created in the reinsurance management system.']
  due_date date [note: 'Contractual due date by which the bordereaux must be submitted to the reinsurer per treaty terms.']
  experience_refund_amount decimal(18,2) [note: 'Experience refund or sliding scale commission adjustment payable under the treaty based on loss experience for the period.']
  gross_ceded_premium decimal(18,2) [note: 'Total gross written premium ceded to the reinsurer for the reporting period before deduction of ceding commission.']
  net_ceded_premium decimal(18,2) [note: 'Net premium ceded to the reinsurer after deducting ceding commission from gross ceded premium for the reporting period.']
  number varchar [note: 'Externally-known unique reference number assigned to this bordereaux submission, used in reinsurer correspondence and bordereaux registers.']
  placement_broker varchar [note: 'Name of the reinsurance intermediary or broker who placed the treaty and through whom the bordereaux may be routed.']
  policy_count varchar [note: 'Number of individual policies included in this bordereaux submission for the reporting period.']
  profit_commission_amount decimal(18,2) [note: 'Profit commission payable to the cedant by the reinsurer based on treaty profitability for the reporting period.']
  recoverable_balance decimal(18,2) [note: 'Net outstanding reinsurance recoverable balance owed by the reinsurer as of the bordereaux reporting period end date.']
  remarks varchar [note: 'Free-text remarks or notes accompanying the bordereaux submission, such as explanations for adjustments or disputed items.']
  reporting_period_end_date date [note: 'Last day of the treaty period or accounting period covered by this bordereaux submission.']
  reporting_period_start_date date [note: 'First day of the treaty period or accounting period covered by this bordereaux submission.']
  retention_amount decimal(18,2) [note: 'Cedant net retention amount for the reporting period, representing the portion of risk not ceded to the reinsurer.']
  submission_date date [note: 'Calendar date on which the bordereaux was formally submitted to the reinsurer or reinsurance broker.']
  submission_format varchar [note: 'File or data format in which the bordereaux was submitted to the reinsurer (e.g., ACORD standard, CSV, XML, XLSX, PDF).']
  submission_method varchar [note: 'Channel or method used to transmit the bordereaux to the reinsurer (electronic data interchange, reinsurer portal, email, or paper).']
  submission_status varchar [note: 'Current lifecycle state of the bordereaux submission workflow from draft through reinsurer acknowledgement or dispute resolution.']
  treaty_type varchar [note: 'Type of reinsurance arrangement covered by this bordereaux: Quota Share (QS), Excess of Loss (XOL), Catastrophe Excess of Loss (CAT XL), surplus, or Facultative (FAC).']
  treaty_year varchar [note: 'Underwriting or treaty year to which this bordereaux relates, used for year-of-account tracking and statutory reporting.']
  updated_timestamp timestamp [note: 'Timestamp when this bordereaux record was most recently modified in the reinsurance management system.']
  version_number varchar [note: 'Sequential version number of this bordereaux submission, incremented when a corrected or amended bordereaux replaces a prior submission.']

  Note: 'Periodic bordereaux submission record sent to reinsurers summarizing ceded premium and loss activity for a treaty period. Captures bordereaux type (premium or loss), reporting period, submission date, and aggregate ceded amounts.'
}

Table reinsurance.bordereaux_line {
  bordereaux_line_id varchar [pk, note: 'Unique surrogate identifier for each individual line item within a bordereaux submission. Primary key for the bordereaux_line entity.']
  bordereaux_id varchar [note: 'Reference to the parent bordereaux submission header that this line belongs to. Links the line to its submission batch.']
  claim_id varchar [note: 'Reference to the underlying claim record for claim-type bordereaux lines. Null for premium-only cession lines.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Bordereaux lines report individual coverage exposures and losses to reinsurers per treaty terms.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this bordereaux line (e.g., USD, GBP, EUR).']
  fac_certificate_id varchar [note: 'Reference to the facultative reinsurance certificate under which this line is reported. Applicable for facultative bordereaux submissions.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Bordereaux line items for property risks report location-specific details (address, TIV, construction type, occupancy) to reinsurers for premium and loss validation.']
  lob_code_id varchar [note: 'NAIC or internal line of business code identifying the insurance product class for this cession line (e.g., GL, WC, APD, PD, BI).']
  policy_id varchar [note: 'Reference to the underlying insurance policy associated with this bordereaux cession or claim line.']
  reinsurance_cession_id varchar [note: 'Foreign key linking to reinsurance.cession. Business justification: Each bordereaux line reports a specific cession. Missing the cession FK that links bordereaux line items back to the cession being reported.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty under which this cession line is reported. Applicable for treaty bordereaux submissions.']
  cat_event_code varchar [note: 'Industry or internal CAT event identifier (e.g., ISO PCS code) associated with this bordereaux line for catastrophe loss aggregation and CAT XL recovery.']
  cat_exposed_flag boolean [note: 'Indicates whether this bordereaux line is associated with a catastrophe-exposed risk or loss event, used for CAT XL treaty aggregation.']
  ceded_alae_amount decimal(18,2) [note: 'The Allocated Loss Adjustment Expense ceded to the reinsurer for this line, representing the reinsurer\'s share of directly attributable claim expenses.']
  ceded_earned_premium decimal(18,2) [note: 'The portion of earned premium ceded to the reinsurer for this bordereaux line, representing the time-proportionate share of ceded written premium.']
  ceded_limit_amount decimal(18,2) [note: 'The maximum reinsurance recovery limit applicable to this cession line under the treaty or FAC certificate.']
  ceded_loss_amount decimal(18,2) [note: 'The gross loss amount ceded to the reinsurer for this bordereaux line, representing the reinsurer\'s share of paid or incurred losses.']
  ceded_share_pct decimal(7,4) [note: 'The percentage of the risk ceded to the reinsurer under the treaty or FAC certificate for this line, expressed as a decimal (e.g., 0.3000 = 30%).']
  ceded_ulae_amount decimal(18,2) [note: 'The Unallocated Loss Adjustment Expense ceded to the reinsurer for this line, representing the reinsurer\'s share of overhead claim handling costs.']
  ceded_written_premium decimal(18,2) [note: 'The portion of written premium ceded to the reinsurer for this bordereaux line, calculated as GWP multiplied by the ceded share percentage.']
  ceding_commission_amount decimal(18,2) [note: 'The monetary ceding commission payable by the reinsurer to the cedant on this bordereaux line, derived from ceded premium and commission rate.']
  ceding_commission_pct decimal(7,4) [note: 'The commission rate payable by the reinsurer to the cedant on ceded premium for this line, expressed as a decimal (e.g., 0.2500 = 25%).']
  certificate_number varchar [note: 'The externally-known facultative certificate number carried on the line for FAC bordereaux reconciliation. Null for treaty lines.']
  coverage_type varchar [note: 'The specific coverage type ceded on this line (e.g., BI, PD, UM, UIM, PIP, MedPay, GL, WC). Aligns to the coverage part of the underlying policy.']
  created_timestamp timestamp [note: 'Timestamp when this bordereaux line record was first created in the system, used for audit trail and data lineage.']
  date_of_loss date [note: 'The date on which the insured loss event occurred. Populated for claim-type bordereaux lines; null for premium-only lines.']
  dispute_reason varchar [note: 'Narrative explanation of the reason this bordereaux line is in disputed status, capturing the cedant or reinsurer\'s basis for disagreement.']
  gross_written_premium decimal(18,2) [note: 'The total gross written premium on the underlying cedant policy for this bordereaux line before any cession.']
  insured_name varchar [note: 'Name of the insured party on the underlying policy for this bordereaux line, as reported to the reinsurer on the cession record.']
  line_number varchar [note: 'Sequential line number within the bordereaux submission, used for ordering and reconciliation of individual cession or claim entries.']
  line_status varchar [note: 'Current processing status of this bordereaux line in the reconciliation workflow between cedant and reinsurer.']
  line_type varchar [note: 'Classifies the nature of the bordereaux line: premium cession, claim loss, adjustment, reinstatement premium, or return premium.']
  net_ceded_premium decimal(18,2) [note: 'The net premium remitted to the reinsurer after deducting the ceding commission from the ceded written premium for this bordereaux line.']
  original_tiv decimal(18,2) [note: 'Total Insured Value of the underlying risk exposure on the cedant policy for this bordereaux line, used for proportional share calculations.']
  policy_expiry_date date [note: 'The expiration date of the underlying cedant policy associated with this bordereaux line.']
  policy_inception_date date [note: 'The effective start date of the underlying cedant policy associated with this bordereaux line.']
  recoverable_balance decimal(18,2) [note: 'Outstanding reinsurance recoverable balance for this bordereaux line, representing amounts owed by the reinsurer not yet collected by the cedant.']
  reinstatement_premium_amount decimal(18,2) [note: 'Premium charged to reinstate the reinsurance limit after a loss occurrence under XOL or CAT XL treaties. Populated for reinstatement-type lines only.']
  report_period_end_date date [note: 'End date of the reporting period covered by this bordereaux line, used for earned premium and loss period attribution.']
  report_period_start_date date [note: 'Start date of the reporting period covered by this bordereaux line, used for earned premium and loss period attribution.']
  retention_amount decimal(18,2) [note: 'The cedant\'s retained portion of the risk or loss for this line, representing the amount not ceded to the reinsurer.']
  risk_description varchar [note: 'Narrative description of the insured risk or exposure associated with this bordereaux line, as reported to the reinsurer.']
  risk_expiry_date date [note: 'The date on which the ceded risk exposure terminates under the reinsurance treaty or FAC certificate for this line.']
  risk_inception_date date [note: 'The date on which the ceded risk exposure commenced under the reinsurance treaty or FAC certificate for this line.']
  settlement_date date [note: 'The date on which this bordereaux line was financially settled between the cedant and the reinsurer.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this bordereaux line record, used for change tracking and reconciliation audit.']
  xol_attachment_point decimal(18,2) [note: 'The loss threshold at which the XOL reinsurance layer attaches for this bordereaux line. Null for quota share or non-XOL treaty lines.']
  xol_exhaustion_point decimal(18,2) [note: 'The loss level at which the XOL reinsurance layer is fully exhausted for this bordereaux line. Null for quota share or non-XOL treaty lines.']

  Note: 'Individual line item within a bordereaux submission representing one cession or claim entry. Stores policy reference, ceded premium, ceded loss, ceded LAE, and line-level status for granular bordereaux reconciliation.'
}

Table reinsurance.ceded_premium_transaction {
  ceded_premium_transaction_id varchar [pk, note: 'Unique surrogate identifier for each ceded premium transaction record in the reinsurance ledger.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code in which the ceded premium amounts are denominated (e.g., USD, GBP, EUR).']
  fac_certificate_id varchar [note: 'Reference to the facultative reinsurance certificate when the cession is FAC rather than treaty-based. Null for treaty transactions.']
  lob_code_id varchar [note: 'NAIC or internal Line of Business code identifying the insurance product line (e.g., GL, WC, APD, BOP) for the ceded premium transaction.']
  policy_id varchar [note: 'Reference to the underlying insurance policy whose premium is being ceded under this transaction.']
  reinsurance_cession_id varchar [note: 'Foreign key linking to reinsurance.cession. Business justification: Premium transactions are generated from cessions. Currently only has treaty/fac/policy FKs, missing the cession FK that ties them together.']
  reinsurer_id varchar [note: 'Reference to the reinsurer party entity receiving the ceded premium under this transaction.']
  reversed_transaction_ceded_premium_transaction_id varchar [note: 'Reference to the original ceded premium transaction that this record reverses. Populated only when reversal_flag is true.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty under which this ceded premium transaction is recorded.']
  accounting_period_end_date date [note: 'End date of the accounting period to which this ceded premium transaction is attributed for statutory and GAAP reporting.']
  accounting_period_start_date date [note: 'Start date of the accounting period (month or quarter) to which this ceded premium transaction is attributed for statutory and GAAP reporting.']
  adjustment_premium_amount decimal(18,2) [note: 'Premium adjustment amount arising from the difference between deposit premium and the final calculated premium based on actual subject premium volume.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized/accredited in the cedant\'s domicile state, affecting credit for reinsurance on the statutory balance sheet.']
  bordereaux_reference varchar [note: 'Reference number of the bordereaux submission in which this ceded premium transaction was reported to the reinsurer for settlement.']
  cat_event_code varchar [note: 'Industry or internal CAT event code (e.g., PCS event number) associated with this ceded premium transaction when triggered by a catastrophe occurrence.']
  ceding_commission_amount decimal(18,2) [note: 'Commission received from the reinsurer on the ceded premium, representing reimbursement of acquisition and overhead costs. Reduces net ceded premium.']
  cession_pct decimal(7,4) [note: 'Percentage of the original policy premium ceded to the reinsurer under this transaction, applicable to quota share and surplus treaties.']
  cession_type varchar [note: 'Indicates whether the cession is under a treaty, a facultative (FAC) certificate, or a facultative-obligatory arrangement.']
  created_timestamp timestamp [note: 'Timestamp when this ceded premium transaction record was first created in the data platform, used for audit trail and data lineage.']
  dac_ceded_amount decimal(18,2) [note: 'Deferred acquisition cost attributable to the ceded portion of the policy, representing the ceded DAC asset to be amortized over the policy term.']
  deposit_premium_amount decimal(18,2) [note: 'Provisional deposit premium paid to the reinsurer at inception of the treaty period, subject to adjustment when actual subject premium is known.']
  earned_premium_ceded_amount decimal(18,2) [note: 'Portion of the ceded written premium that has been earned during the accounting period, computed on a pro-rata or other basis per treaty terms.']
  gl_account_code varchar [note: 'General ledger account code to which this ceded premium transaction is posted in the financial ledger (Oracle Financials GL or SAP FI).']
  gwp_ceded_amount decimal(18,2) [note: 'Gross written premium ceded to the reinsurer under this transaction before deduction of ceding commission. Represents the cedant\'s gross exposure transferred.']
  layer_number varchar [note: 'Numeric identifier of the XOL or CAT XL program layer to which this ceded premium transaction belongs, enabling multi-layer program analysis.']
  nwp_ceded_amount decimal(18,2) [note: 'Net written premium ceded after deducting ceding commission from GWP ceded. Represents the net cost of reinsurance protection for this transaction.']
  policy_effective_date date [note: 'Effective date of the underlying policy term to which this ceded premium transaction relates, used for earned premium proration.']
  policy_expiry_date date [note: 'Expiry date of the underlying policy term, used together with effective date to compute the pro-rata earned ceded premium.']
  profit_commission_amount decimal(18,2) [note: 'Profit commission receivable from the reinsurer for this accounting period, calculated when the treaty loss ratio falls below the profit commission threshold.']
  reinstatement_premium_amount decimal(18,2) [note: 'Additional premium payable to reinstate the reinsurance limit after a loss occurrence, applicable to XOL and CAT XL treaties. Zero for QS transactions.']
  reversal_flag boolean [note: 'Indicates whether this transaction is a reversal of a previously posted ceded premium entry, used for correction and audit trail purposes.']
  rol_pct decimal(7,4) [note: 'Rate on Line expressed as a percentage of the reinsurance limit, used for XOL and CAT XL layers to derive the ceded premium from the limit purchased.']
  settlement_date date [note: 'Actual date on which the ceded premium was remitted to or received from the reinsurer. Null if not yet settled.']
  settlement_due_date date [note: 'Contractual due date by which the ceded premium must be remitted to the reinsurer per the treaty or FAC certificate payment terms.']
  settlement_status varchar [note: 'Current settlement state of the ceded premium transaction with the reinsurer: pending, submitted in bordereaux, agreed, paid, or disputed.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this ceded premium transaction (e.g., SICS, Sapiens ReinsuranceMaster, Guidewire PolicyCenter).']
  source_transaction_reference varchar [note: 'The native transaction identifier from the originating source system (e.g., SICS transaction ID), enabling traceability back to the system of record.']
  subject_premium_amount decimal(18,2) [note: 'The base premium amount on which the reinsurance rate or cession percentage is applied to derive the ceded premium for this transaction.']
  transaction_date date [note: 'The business date on which the ceded premium movement was recorded or triggered, representing the principal real-world event date.']
  transaction_number varchar [note: 'Externally visible business reference number for this ceded premium transaction, used in bordereaux and reinsurer settlement statements.']
  transaction_status varchar [note: 'Current lifecycle state of the ceded premium transaction from draft through settlement or void.']
  transaction_type varchar [note: 'Classifies the nature of the ceded premium movement: written (new/renewal), earned (periodic recognition), return (cancellation/endorsement), adjustment, or reinstatement premium.']
  treaty_type varchar [note: 'Type of reinsurance structure governing this cession: Quota Share (QS), Excess of Loss (XOL), Catastrophe Excess of Loss (CAT XL), Surplus, or Stop Loss.']
  uep_ceded_amount decimal(18,2) [note: 'Portion of the ceded written premium that is unearned as of the accounting period end date, representing the ceded UEP reserve on the balance sheet.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this ceded premium transaction record, supporting audit trail and change tracking requirements.']

  Note: 'Transactional record of each ceded premium movement (written, earned, return) under a treaty or FAC certificate. Tracks GWP ceded, NWP ceded, UEP ceded, DAC ceded, accounting period, and settlement status.'
}

Table reinsurance.ceded_loss_transaction {
  ceded_loss_transaction_id varchar [pk, note: 'Unique identifier for the ceded loss transaction record.']
  bordereaux_id varchar [note: 'Identifier for the bordereaux batch in which this transaction was reported to the reinsurer.']
  claim_id varchar [note: 'Reference to the underlying claim generating this ceded loss.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Loss cessions must identify which coverage the claim arose from to apply correct treaty/fac terms, especially in multi-coverage policies.']
  currency_id varchar [note: 'Three-letter ISO currency code for all monetary amounts in this transaction.']
  fac_certificate_id varchar [note: 'Reference to the facultative certificate if this loss is ceded under FAC placement.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property loss transactions must identify the loss location to determine treaty attachment (per-risk vs. CAT), apply retention, and assign CAT event codes.']
  lob_code_id varchar [note: 'Code identifying the line of business for this ceded loss.']
  policy_id varchar [note: 'Reference to the policy associated with the ceded loss.']
  reinsurance_cession_id varchar [note: 'Foreign key linking to reinsurance.cession. Business justification: Loss transactions are generated from cessions. Missing the cession FK that links loss transactions back to the originating cession event.']
  reinsurer_id varchar [note: 'Reference to the reinsurer receiving this ceded loss transaction.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty under which this loss is ceded.']
  accounting_date date [note: 'Date when the transaction is recognized for financial accounting purposes.']
  attachment_point decimal(18,2) [note: 'Loss threshold at which reinsurance coverage begins for excess of loss treaties.']
  bordereaux_submission_date date [note: 'Date when the bordereaux containing this transaction was submitted to the reinsurer.']
  cat_event_code varchar [note: 'Code identifying the catastrophe event if this loss is part of a CAT event.']
  cat_flag boolean [note: 'Indicates whether this ceded loss is associated with a catastrophe event.']
  ceded_alae_amount decimal(18,2) [note: 'Amount of allocated loss adjustment expense ceded to the reinsurer.']
  ceded_loss_amount decimal(18,2) [note: 'Amount of loss ceded to the reinsurer under this transaction.']
  ceded_total_amount decimal(18,2) [note: 'Total amount ceded including loss, ALAE, and ULAE.']
  ceded_ulae_amount decimal(18,2) [note: 'Amount of unallocated loss adjustment expense ceded to the reinsurer.']
  cession_percentage decimal(5,4) [note: 'Percentage of the gross loss ceded to the reinsurer under this transaction.']
  coverage_code varchar [note: 'Code identifying the specific coverage under which the loss is ceded.']
  created_timestamp timestamp [note: 'Timestamp when this ceded loss transaction record was first created in the system.']
  current_reserve_amount decimal(18,2) [note: 'Current ceded reserve amount after this transaction.']
  dispute_flag boolean [note: 'Indicates whether this ceded loss transaction is under dispute with the reinsurer.']
  dispute_reason varchar [note: 'Reason for dispute if the transaction is contested by the reinsurer.']
  dol date [note: 'Date when the underlying loss event occurred.']
  exhaustion_point decimal(18,2) [note: 'Loss threshold at which reinsurance coverage ends for excess of loss treaties.']
  gross_loss_amount decimal(18,2) [note: 'Total gross loss amount before reinsurance cession.']
  layer_number varchar [note: 'Reinsurance layer number if the treaty has multiple layers.']
  net_loss_amount decimal(18,2) [note: 'Net loss amount retained by the cedant after reinsurance cession.']
  paid_recoverable_amount decimal(18,2) [note: 'Amount already recovered from the reinsurer for this transaction.']
  peril_code varchar [note: 'Code identifying the peril or cause of loss.']
  prior_reserve_amount decimal(18,2) [note: 'Previous ceded reserve amount before this transaction.']
  recoverable_balance decimal(18,2) [note: 'Outstanding balance recoverable from the reinsurer for this transaction.']
  reinsurer_confirmation_date date [note: 'Date when the reinsurer confirmed receipt and acceptance of this ceded loss transaction.']
  report_date date [note: 'Date when the loss was first reported to the insurer.']
  reporting_period varchar [note: 'Financial reporting period for this ceded loss transaction, typically YYYY-MM format.']
  reserve_change_amount decimal(18,2) [note: 'Net change in ceded reserve amount from this transaction.']
  reserve_movement_type varchar [note: 'Type of reserve movement: initial establishment, increase, decrease, closure, or reopening.']
  retention_amount decimal(18,2) [note: 'Cedant retention amount applied before reinsurance recovery.']
  transaction_date date [note: 'Date when the ceded loss transaction was recorded in the system.']
  transaction_number varchar [note: 'Business identifier for the ceded loss transaction, used in bordereaux reporting.']
  transaction_status varchar [note: 'Current status of the ceded loss transaction in the reinsurance workflow.']
  transaction_type varchar [note: 'Type of ceded loss transaction: paid loss, case reserve, IBNR, IBNER, LAE paid, LAE reserve, salvage, or subrogation. [ENUM-REF-CANDIDATE: paid_loss|case_reserve|ibnr|ibner|lae_paid|lae_reserve|salvage|subrogation — 8 candidates stripped; promote to']
  updated_timestamp timestamp [note: 'Timestamp when this ceded loss transaction record was last updated.']

  Note: 'Ledger of each ceded loss, LAE, and reserve movement (paid, case/OCR, IBNR, IBNER) reported to a reinsurer under a treaty or FAC. Single owner of ceded reserve balances after ri_loss_reserve merge.'
}

Table reinsurance.ri_recoverable {
  ri_recoverable_id varchar [pk, note: 'Unique identifier for the reinsurance recoverable record.']
  bordereaux_id varchar [note: 'Foreign key linking to reinsurance.bordereaux. Business justification: Recoverables are reported via bordereaux. Currently has bordereaux_reference (string), should have proper FK for referential integrity.']
  claim_id varchar [note: 'Reference to the underlying claim for which reinsurance recovery is being tracked.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Recoverables are tracked at coverage level for reserve adequacy testing and credit risk management.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this recoverable record.']
  fac_certificate_id varchar [note: 'Reference to the facultative certificate under which this recoverable is ceded, if applicable.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Reinsurance recoverables for property losses track the specific loss location to validate treaty coverage, determine attachment, and support recovery billing.']
  lob_code_id varchar [note: 'Line of business code for the underlying policy and loss exposure.']
  policy_id varchar [note: 'Reference to the policy under which the loss occurred and reinsurance applies.']
  reinsurance_cession_id varchar [note: 'Foreign key linking to reinsurance.cession. Business justification: Recoverables arise from cessions. Missing the cession FK that links recoverable balances back to the originating cession.']
  reinsurer_id varchar [note: 'Reference to the reinsurer party from whom recovery is expected.']
  ri_treaty_id varchar [note: 'Reference to the treaty agreement under which this recoverable is ceded, if applicable.']
  accounting_period varchar [note: 'Accounting period in YYYY-MM format during which this recoverable was recognized for financial reporting.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized or accredited in the cedants domiciliary state, affecting statutory credit eligibility.']
  billed_date date [note: 'Date on which the recoverable was formally billed to the reinsurer via bordereaux or claim notice.']
  cat_event_code varchar [note: 'Industry standard catastrophe event code if this recoverable is associated with a named catastrophe.']
  cat_event_flag boolean [note: 'Indicates whether this recoverable arises from a catastrophe event loss, subject to special treaty terms.']
  ceded_alae_amount decimal(18,2) [note: 'Portion of Allocated Loss Adjustment Expense ceded to reinsurers, recoverable under the reinsurance agreement.']
  ceded_loss_amount decimal(18,2) [note: 'Portion of the gross loss amount ceded to reinsurers under treaty or facultative agreements.']
  cession_date date [note: 'Date on which the loss was ceded to reinsurers and the recoverable was established.']
  collateral_held_amount decimal(18,2) [note: 'Amount of collateral held by the cedant to secure this recoverable, reducing credit risk exposure.']
  collected_amount decimal(18,2) [note: 'Total amount collected from the reinsurer to date against this recoverable.']
  collected_date date [note: 'Date on which payment was received from the reinsurer, fully or partially settling the recoverable.']
  created_timestamp timestamp [note: 'Timestamp when this recoverable record was first created in the system.']
  credit_allowed_flag boolean [note: 'Indicates whether statutory credit is allowed for this recoverable under state insurance regulations.']
  dispute_date date [note: 'Date on which the reinsurer formally disputed the recoverable, triggering dispute resolution procedures.']
  disputed_amount decimal(18,2) [note: 'Portion of the recoverable balance currently under dispute with the reinsurer.']
  due_date date [note: 'Date by which payment is due from the reinsurer per the reinsurance agreement payment terms.']
  gross_loss_amount decimal(18,2) [note: 'Total gross loss amount incurred by the cedant before any reinsurance recovery.']
  loss_date date [note: 'Date on which the underlying loss event occurred, determining treaty year and coverage applicability.']
  loss_type varchar [note: 'Type of loss component for which reinsurance recovery is being tracked.']
  notes varchar [note: 'Free-text notes capturing additional context, dispute details, or collection status updates for this recoverable.']
  overdue_flag boolean [note: 'Indicates whether the recoverable balance is overdue per the reinsurance agreement payment terms.']
  recoverable_balance decimal(18,2) [note: 'Outstanding reinsurance recoverable balance owed by the reinsurer, net of any collections or adjustments.']
  recoverable_number varchar [note: 'Business identifier for the recoverable record, used for external reporting and bordereaux submission.']
  recoverable_status varchar [note: 'Current lifecycle status of the recoverable balance in the collection workflow.']
  recoverable_type varchar [note: 'Classification of the reinsurance arrangement type under which recovery is claimed.']
  reported_date date [note: 'Date on which the loss was first reported to the cedant, used for IBNR and reserving calculations.']
  reserve_category varchar [note: 'Category of reserve or payment for which the recoverable is established: case reserve, Incurred But Not Reported (IBNR), Incurred But Not Enough Reported (IBNER), or paid loss.']
  treaty_year varchar [note: 'Calendar or underwriting year of the reinsurance treaty under which this recoverable is ceded.']
  updated_timestamp timestamp [note: 'Timestamp when this recoverable record was last modified, tracking the most recent change to balance or status.']
  written_off_amount decimal(18,2) [note: 'Portion of the recoverable balance written off as uncollectible due to reinsurer insolvency or dispute resolution.']
  written_off_date date [note: 'Date on which the recoverable balance was written off as uncollectible.']

  Note: 'Tracks outstanding reinsurance recoverable balances and ceded loss reserves (OCR, IBNR, IBNER) owed by reinsurers for paid and reserved losses under treaty and FAC agreements.'
}

Table reinsurance.ri_settlement {
  ri_settlement_id varchar [pk, note: 'Unique identifier for the reinsurance settlement record.']
  bordereaux_id varchar [note: 'Foreign key linking to reinsurance.bordereaux. Business justification: Settlements are based on bordereaux submissions. Currently has bordereaux_reference (string), should have proper FK for referential integrity.']
  currency_id varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this settlement.']
  fac_certificate_id varchar [note: 'Reference to the facultative certificate if this settlement is for facultative reinsurance; null for treaty settlements.']
  lob_code_id varchar [note: 'Line of business code for the risks covered by this settlement, aligned with NAIC annual statement lines.']
  reinsurer_id varchar [note: 'Reference to the reinsurer party with whom this settlement is conducted.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty under which this settlement is processed.']
  adjustment_amount decimal(18,2) [note: 'Net adjustment amount for corrections, prior period adjustments, or reconciliation items.']
  approval_date date [note: 'Date the settlement was approved by the cedant or reinsurer for payment processing.']
  approved_by varchar [note: 'Name or identifier of the individual who approved the settlement for payment.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized or admitted in the cedants domiciliary jurisdiction for statutory credit purposes.']
  balance_direction varchar [note: 'Indicates whether the net balance is due from the reinsurer, due to the reinsurer, or zero.']
  broker_commission_amount decimal(18,2) [note: 'Commission paid to the reinsurance broker for placement and servicing of the treaty or certificate.']
  broker_name varchar [note: 'Name of the reinsurance broker or intermediary facilitating the settlement, if applicable.']
  ceded_alae_amount decimal(18,2) [note: 'Allocated loss adjustment expenses ceded to the reinsurer for the settlement period.']
  ceded_loss_amount decimal(18,2) [note: 'Total losses ceded to the reinsurer for the settlement period, including paid and reserved amounts.']
  ceded_premium_amount decimal(18,2) [note: 'Total premium ceded to the reinsurer for the settlement period.']
  ceded_ulae_amount decimal(18,2) [note: 'Unallocated loss adjustment expenses ceded to the reinsurer for the settlement period.']
  ceding_commission_amount decimal(18,2) [note: 'Commission paid by the reinsurer to the cedant for acquisition and administrative costs.']
  collateral_held_amount decimal(18,2) [note: 'Amount of collateral held by the cedant from the reinsurer to secure the recoverable balance.']
  collateral_type varchar [note: 'Type of collateral securing the reinsurance recoverable: letter of credit, trust account, funds withheld, or none.']
  created_timestamp timestamp [note: 'Timestamp when the settlement record was first created in the system.']
  dispute_flag boolean [note: 'Indicates whether this settlement is under dispute between the cedant and reinsurer.']
  dispute_reason varchar [note: 'Description of the reason for dispute if the settlement is contested.']
  due_date date [note: 'Date by which the net settlement balance is due for payment.']
  net_balance_amount decimal(18,2) [note: 'Net settlement balance due to or from the reinsurer after all debits and credits; positive indicates amount due from reinsurer.']
  notes varchar [note: 'Free-text notes or comments regarding the settlement, including special instructions or clarifications.']
  payment_date date [note: 'Actual date the settlement payment was made or received.']
  payment_method varchar [note: 'Method by which the settlement payment was or will be made: wire transfer, check, ACH, offset, or letter of credit.']
  payment_reference_number varchar [note: 'External reference number for the payment transaction, such as wire confirmation or check number.']
  period_end_date date [note: 'End date of the accounting period covered by this settlement.']
  period_start_date date [note: 'Start date of the accounting period covered by this settlement.']
  profit_commission_amount decimal(18,2) [note: 'Additional commission paid to the cedant based on favorable loss experience under the treaty.']
  recoverable_amount decimal(18,2) [note: 'Total amount recoverable from the reinsurer, including losses and expenses.']
  reinstatement_premium_amount decimal(18,2) [note: 'Additional premium due for reinstatement of coverage limits after a loss event under excess of loss treaties.']
  settlement_number varchar [note: 'Business identifier for the settlement statement, typically assigned by the cedant or reinsurer.']
  settlement_status varchar [note: 'Current lifecycle status of the settlement: draft, pending, approved, paid, disputed, or cancelled.']
  statement_date date [note: 'Date the settlement statement was issued or prepared.']
  statement_type varchar [note: 'Type of settlement statement: account current, cash call, interim, final, or adjustment.']
  treaty_year varchar [note: 'Calendar or underwriting year of the treaty to which this settlement applies.']
  updated_timestamp timestamp [note: 'Timestamp when the settlement record was last modified in the system.']

  Note: 'Records each account-current statement and cash settlement of net balances between Pc_Insurance and a reinsurer for a treaty period.'
}

Table reinsurance.claim_ri_recovery {
  claim_ri_recovery_id varchar [pk, note: 'Unique identifier for the claim reinsurance recovery junction record.']
  bordereaux_id varchar [note: 'Foreign key reference to the bordereaux submission in which this recovery was reported to the reinsurer.']
  claim_id varchar [note: 'Foreign key reference to the claim for which reinsurance recovery is being recorded.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Recovery calculations depend on coverage-specific limits, deductibles, SIR amounts, and coinsurance percentages. Claims adjusters need coverage terms to determine gross vs.']
  currency_id varchar [note: 'Three-letter ISO 4217 currency code in which recovery amounts are denominated.']
  fac_certificate_id varchar [note: 'Foreign key reference to the facultative certificate under which recovery is claimed. Null if recovery is under treaty.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Claim recovery calculations for property losses require location data to determine which treaties respond, apply retention and limits, and calculate cession percentages.']
  lob_code_id varchar [note: 'Line of business code for the underlying claim, used for treaty layer matching and bordereaux reporting.']
  reinsurance_cession_id varchar [note: 'Foreign key linking to reinsurance.cession. Business justification: Recoveries are based on cessions. Missing the cession FK that links claim recoveries back to the cession that generated the recovery right.']
  reinsurer_id varchar [note: 'Foreign key reference to the reinsurer from whom recovery is being claimed.']
  ri_treaty_id varchar [note: 'Foreign key reference to the reinsurance treaty under which recovery is claimed. Null if recovery is under facultative certificate.']
  accounting_period varchar [note: 'Accounting period in which this recovery is recognized for statutory and GAAP reporting, format YYYY-MM.']
  acknowledgement_date date [note: 'Date on which reinsurer acknowledged receipt and validity of the recovery claim.']
  approval_date date [note: 'Date on which reinsurer approved the recovery claim for payment.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether reinsurer is authorized or accredited in the cedants domiciliary state, affecting credit for reinsurance treatment.']
  cat_event_code varchar [note: 'Industry catastrophe event code if this recovery relates to a declared catastrophe event.']
  cat_exposed_flag boolean [note: 'Indicates whether this recovery is related to a catastrophe event, triggering CAT XL treaty layers.']
  ceded_alae_amount decimal(18,2) [note: 'Amount of allocated loss adjustment expense ceded to reinsurer under this recovery.']
  ceded_loss_amount decimal(18,2) [note: 'Amount of loss ceded to reinsurer under this recovery, net of retention and subject to treaty limits.']
  cession_percentage decimal(5,2) [note: 'Percentage of loss ceded to reinsurer under quota share or surplus arrangements.']
  collateral_amount decimal(18,2) [note: 'Amount of collateral posted by reinsurer to secure this recovery, if applicable.']
  collateral_required_flag boolean [note: 'Indicates whether collateral is required from reinsurer to receive statutory credit for this recovery.']
  created_timestamp timestamp [note: 'Timestamp when this claim reinsurance recovery record was first created in the system.']
  dispute_flag boolean [note: 'Indicates whether this recovery is currently under dispute with the reinsurer.']
  dispute_reason varchar [note: 'Description of the reason for dispute if recovery is contested by reinsurer.']
  dispute_resolution_date date [note: 'Date on which dispute was resolved, either through negotiation, arbitration, or litigation.']
  gross_alae_amount decimal(18,2) [note: 'Total allocated loss adjustment expense on the underlying claim before reinsurance recovery.']
  gross_loss_amount decimal(18,2) [note: 'Total gross loss amount on the underlying claim before reinsurance recovery, used as basis for cession calculation.']
  layer_attachment_point decimal(18,2) [note: 'Attachment point for excess of loss layer, loss must exceed this amount before reinsurer participates.']
  layer_limit_amount decimal(18,2) [note: 'Maximum limit of the reinsurance layer applicable to this recovery.']
  outstanding_recoverable_amount decimal(18,2) [note: 'Amount still outstanding from reinsurer, calculated as recoverable minus recovered.']
  payment_date date [note: 'Date on which reinsurer paid the recovery amount to the cedant.']
  payment_reference_number varchar [note: 'Reference number of the reinsurer payment transaction that settled this recovery, linking to cash receipt.']
  recoverable_amount decimal(18,2) [note: 'Total amount recoverable from reinsurer, sum of ceded loss and ceded ALAE, subject to treaty terms and reinsurer credit quality.']
  recovered_amount decimal(18,2) [note: 'Actual amount recovered from reinsurer to date, may differ from recoverable due to disputes or partial payments.']
  recovery_basis varchar [note: 'Basis on which recovery amount is calculated, defining whether loss adjustment expenses are included.']
  recovery_number varchar [note: 'Business identifier for this specific recovery transaction, often used in bordereaux and settlement reporting.']
  recovery_status varchar [note: 'Current lifecycle status of the reinsurance recovery claim. [ENUM-REF-CANDIDATE: pending|submitted|acknowledged|approved|paid|disputed|denied|reversed — 8 candidates stripped; promote to reference product]']
  recovery_type varchar [note: 'Type of reinsurance arrangement under which recovery is being claimed.']
  reinstatement_number varchar [note: 'Reinstatement number if this recovery exhausted the original treaty limit and triggered a reinstatement provision.']
  reinstatement_premium_amount decimal(18,2) [note: 'Additional premium owed to reinsurer for reinstating treaty limit after this recovery.']
  reinsurer_share_pct decimal(5,2) [note: 'Percentage share of this specific reinsurer in a co-reinsured treaty or facultative placement.']
  retention_amount decimal(18,2) [note: 'Cedant retention amount applied before calculating ceded loss, may be per-occurrence or aggregate depending on treaty terms.']
  submission_date date [note: 'Date on which this recovery claim was submitted to the reinsurer for acknowledgement and payment.']
  treaty_year varchar [note: 'Treaty year under which this recovery is claimed, relevant for multi-year treaties and reinstatement tracking.']
  updated_timestamp timestamp [note: 'Timestamp when this claim reinsurance recovery record was last modified.']

  Note: 'Junction table resolving the many-to-many relationship between claims and reinsurance recoveries. Links a specific claim to one or more treaty/FAC recoveries, capturing recovered amount, recovery basis, and payment reference per claim-recovery pairing.'
}

Table reinsurance.cat_bond {
  cat_bond_id varchar [pk, note: 'Unique identifier for the catastrophe bond instrument record.']
  currency_id varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in the catastrophe bond.']
  lob_code_id varchar [note: 'Insurance line of business code indicating the type of risk covered, such as property, casualty, multi-peril.']
  org_unit_id varchar [note: 'Identifier of the ceding insurer or reinsurer transferring risk through the catastrophe bond.']
  ri_treaty_id varchar [note: 'Foreign key linking to reinsurance.ri_treaty. Business justification: CAT bonds are often structured alongside or as part of CAT XL treaty programs. This links the bond to its associated treaty structure, enabling integrated CAT risk management analysis.']
  aggregate_limit_flag boolean [note: 'Indicates whether the catastrophe bond has an aggregate loss limit across multiple events.']
  attachment_point decimal(18,2) [note: 'Loss threshold amount at which the catastrophe bond begins to provide coverage and principal may be at risk.']
  basis_risk_description varchar [note: 'Description of potential basis risk where the trigger mechanism may not perfectly correlate with actual losses incurred by the sponsor.']
  bond_name varchar [note: 'Marketing or legal name of the catastrophe bond issuance.']
  bond_number varchar [note: 'Externally-known unique identifier or CUSIP for the catastrophe bond instrument.']
  bond_rating varchar [note: 'Credit rating assigned to the catastrophe bond by the rating agency.']
  bond_status varchar [note: 'Current lifecycle status of the catastrophe bond instrument.']
  cat_event_definition varchar [note: 'Detailed definition of what constitutes a triggering catastrophe event including magnitude, location, and measurement criteria.']
  collateral_amount decimal(18,2) [note: 'Total value of collateral held in trust to secure the catastrophe bond.']
  collateral_type varchar [note: 'Type of collateral held in trust to secure the catastrophe bond obligations.']
  coupon_frequency varchar [note: 'Frequency at which coupon interest payments are made to catastrophe bond investors.']
  coupon_rate_pct decimal(5,4) [note: 'Annual interest rate paid to catastrophe bond investors, expressed as a decimal percentage.']
  created_timestamp timestamp [note: 'Timestamp when this catastrophe bond record was first created in the system.']
  exhaustion_point decimal(18,2) [note: 'Loss amount at which the catastrophe bond coverage is fully exhausted and maximum principal loss occurs.']
  expected_loss_pct decimal(5,4) [note: 'Modeled expected annual loss as a percentage of the notional amount, representing the probability-weighted average loss.']
  issuance_date date [note: 'Date when the catastrophe bond was issued and became effective.']
  maturity_date date [note: 'Date when the catastrophe bond principal is scheduled to be repaid if no trigger event occurs.']
  modeling_firm varchar [note: 'Name of the catastrophe risk modeling firm used to assess and price the bond, such as RMS, AIR Worldwide, CoreLogic.']
  modified_timestamp timestamp [note: 'Timestamp when this catastrophe bond record was last modified in the system.']
  multi_event_flag boolean [note: 'Indicates whether the catastrophe bond can be triggered by multiple separate catastrophe events during its term.']
  notional_amount decimal(18,2) [note: 'Original principal amount of the catastrophe bond at issuance.']
  outstanding_notional decimal(18,2) [note: 'Current outstanding principal amount of the catastrophe bond after any trigger events or partial redemptions.']
  perils_covered varchar [note: 'Comma-separated list of catastrophic perils covered by the bond such as hurricane, earthquake, windstorm, flood, wildfire.']
  placement_broker varchar [note: 'Name of the broker or investment bank that placed the catastrophe bond with investors.']
  pml_amount decimal(18,2) [note: 'Estimated probable maximum loss exposure that the catastrophe bond is designed to cover.']
  principal_reduction_amount decimal(18,2) [note: 'Amount of principal reduced or forgiven due to a trigger event occurring.']
  rating_agency varchar [note: 'Name of the credit rating agency that rated the catastrophe bond, such as A.M. Best, S&P, Moodys, Fitch.']
  reinstatement_provision_flag boolean [note: 'Indicates whether the catastrophe bond includes provisions for reinstatement of coverage after a trigger event.']
  sponsor_name varchar [note: 'Name of the insurance or reinsurance company sponsoring the catastrophe bond issuance.']
  spv_domicile varchar [note: 'Three-letter country code of the jurisdiction where the special purpose vehicle is domiciled.']
  spv_name varchar [note: 'Legal name of the special purpose vehicle entity that issued the catastrophe bond.']
  spv_registration_number varchar [note: 'Official registration or incorporation number of the special purpose vehicle with its domicile authority.']
  territory_scope varchar [note: 'Geographic regions or territories covered by the catastrophe bond, such as US Gulf Coast, Japan, Europe.']
  trigger_event_code varchar [note: 'Industry-standard code identifying the specific catastrophe event that triggered the bond.']
  trigger_event_date date [note: 'Date when a catastrophe event occurred that met the trigger criteria for the bond.']
  trigger_type varchar [note: 'Mechanism that determines when the catastrophe bond is activated: indemnity-based, parametric, index-based, modeled loss, hybrid, or industry loss index.']
  trustee_name varchar [note: 'Name of the trustee institution responsible for holding collateral and administering the catastrophe bond.']

  Note: 'Master record for each catastrophe bond (CAT Bond) instrument issued or held by Pc_Insurance. Tracks trigger type (indemnity, parametric, index), attachment, exhaustion, coupon, maturity date, SPV details, and outstanding notional.'
}

Table reinsurance.profit_commission {
  profit_commission_id varchar [pk, note: 'Unique identifier for the profit commission record.']
  currency_id varchar [note: 'ISO 4217 three-letter currency code in which profit commission amounts are denominated.']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: Profit commissions can be calculated on FAC certificates with profit-sharing provisions, not just QS treaties. Missing FK that enables FAC profit commission tracking.']
  lob_code_id varchar [note: 'Line of business code for which this profit commission is calculated, aligning with treaty coverage scope.']
  reinsurer_id varchar [note: 'Foreign key to the reinsurer party to whom profit commission is owed or from whom it is received.']
  ri_treaty_id varchar [note: 'Foreign key to the reinsurance treaty under which this profit commission is calculated.']
  accounting_period varchar [note: 'The accounting period identifier for which this profit commission is calculated, typically YYYY-MM or YYYY-QQ format.']
  accrued_commission_amount decimal(18,2) [note: 'Accrued profit commission amount recognized in the financial statements for the period, may differ from calculated amount due to timing.']
  adjustment_amount decimal(18,2) [note: 'Net adjustment amount applied to the profit commission calculation, positive for increases and negative for decreases.']
  adjustment_reason varchar [note: 'Reason for any adjustment to the profit commission calculation, such as bordereaux correction, audit finding, or treaty amendment.']
  amount decimal(18,2) [note: 'Total profit commission amount calculated for the treaty and period, computed by applying the commission rate to the net ceded premium.']
  approval_date date [note: 'The date on which the profit commission calculation was approved by authorized personnel.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized or admitted in the cedant\'s domiciliary jurisdiction, affecting statutory credit treatment.']
  calculated_commission_rate_pct decimal(5,2) [note: 'Calculated profit commission rate percentage based on the treaty formula and actual loss ratio for the period.']
  calculated_loss_ratio_pct decimal(5,2) [note: 'Calculated loss ratio percentage for the treaty and period, computed as total ceded loss and LAE divided by net ceded premium.']
  calculation_date date [note: 'The date on which the profit commission calculation was performed.']
  calculation_method varchar [note: 'Method used to determine the experience period for profit commission calculation, such as treaty year, accident year, or calendar year basis.']
  calculation_notes varchar [note: 'Free-text notes documenting assumptions, adjustments, or special considerations applied in the profit commission calculation.']
  calculation_number varchar [note: 'Business identifier for the profit commission calculation, typically assigned by the reinsurance system.']
  calculation_status varchar [note: 'Current lifecycle status of the profit commission calculation. [ENUM-REF-CANDIDATE: draft|calculated|approved|accrued|paid|disputed|cancelled — 7 candidates stripped; promote to reference product]']
  ceded_alae_amount decimal(18,2) [note: 'Total ceded allocated loss adjustment expense for the treaty and period.']
  ceded_loss_amount decimal(18,2) [note: 'Total ceded loss amount including paid and reserved losses for the treaty and period.']
  ceded_premium_amount decimal(18,2) [note: 'Total ceded premium amount for the treaty and period used as the basis for profit commission calculation.']
  ceded_ulae_amount decimal(18,2) [note: 'Total ceded unallocated loss adjustment expense for the treaty and period.']
  ceding_commission_amount decimal(18,2) [note: 'Total ceding commission received from the reinsurer for the treaty and period, deducted from ceded premium.']
  created_timestamp timestamp [note: 'Timestamp when this profit commission record was first created in the system.']
  effective_date date [note: 'The date from which the profit commission calculation is effective, typically aligned with treaty or accounting period start.']
  expiry_date date [note: 'The date through which the profit commission calculation applies, typically aligned with treaty or accounting period end.']
  formula varchar [note: 'Type of profit commission formula specified in the treaty: fixed rate, sliding scale, step function, or custom calculation.']
  loss_ratio_threshold_pct decimal(5,2) [note: 'Loss ratio threshold percentage specified in the treaty profit commission clause, below which profit commission is earned.']
  net_ceded_premium decimal(18,2) [note: 'Net ceded premium after deducting ceding commission, used as the denominator in loss ratio calculation.']
  outstanding_balance decimal(18,2) [note: 'Outstanding profit commission balance remaining to be paid, calculated as accrued amount minus paid amount.']
  paid_commission_amount decimal(18,2) [note: 'Total profit commission amount paid to date for this calculation, tracking settlement progress.']
  payment_due_date date [note: 'The date by which the profit commission payment is due per treaty terms.']
  prior_calculation_amount decimal(18,2) [note: 'Profit commission amount from the prior calculation for the same treaty and period, used to track adjustments and movements.']
  provisional_flag boolean [note: 'Indicates whether this profit commission calculation is provisional and subject to adjustment upon final bordereaux or audit.']
  sliding_scale_max_pct decimal(5,2) [note: 'Maximum profit commission percentage in a sliding scale formula, applicable when loss ratio is at or below the lower threshold.']
  sliding_scale_min_pct decimal(5,2) [note: 'Minimum profit commission percentage in a sliding scale formula, applicable when loss ratio is at or above the upper threshold.']
  total_ceded_loss_lae decimal(18,2) [note: 'Sum of ceded loss, ALAE, and ULAE amounts, used as the numerator in loss ratio calculation.']
  treaty_type varchar [note: 'Type of reinsurance treaty under which profit commission is calculated, typically quota share treaties with profit commission clauses.']
  treaty_year varchar [note: 'The treaty year or underwriting year for which this profit commission is calculated.']
  updated_by varchar [note: 'User identifier of the person or system that last updated this profit commission record.']
  updated_timestamp timestamp [note: 'Timestamp when this profit commission record was last updated in the system.']
  created_by varchar [note: 'User identifier of the person or system that created this profit commission record.']

  Note: 'Tracks profit commission calculations and accruals owed to Pc_Insurance under QS treaties with profit commission clauses. Stores loss ratio threshold, sliding scale parameters, calculated commission rate, and accrued commission amount.'
}

Table reinsurance.reinstatement {
  reinstatement_id varchar [pk, note: 'Unique identifier for the reinstatement data product (auto-inserted during validation).']
  bordereaux_id varchar [note: 'Foreign key reference to the bordereaux submission batch in which this reinstatement transaction was reported to the reinsurer.']
  currency_id varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this reinstatement record.']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: Reinstatements can occur on FAC certificates with reinstatement provisions, not just treaties. Currently only has ri_treaty_id. Missing FK for FAC reinstatements.']
  lob_code_id varchar [note: 'Insurance line of business code covered by the reinstated treaty layer, such as property, casualty, or specialty lines.']
  occurrence_loss_id varchar [note: 'Foreign key linking to reinsurance.occurrence_loss. Business justification: Reinstatements are triggered by specific occurrence losses. Currently has occurrence_reference (string), should have proper FK to occurrence_loss for referential integrity and']
  ri_treaty_id varchar [note: 'Foreign key reference to the reinsurance treaty under which this reinstatement applies.']
  treaty_layer_id varchar [note: 'Foreign key linking to reinsurance.treaty_layer. Business justification: Reinstatements restore specific treaty layers. Currently has layer_number (INT), should have proper FK to treaty_layer for full layer definition.']
  accounting_period varchar [note: 'The accounting period in YYYY-MM format to which this reinstatement transaction is assigned for financial reporting purposes.']
  attachment_point decimal(18,2) [note: 'The retention or attachment point amount for the treaty layer being reinstated, defining where reinsurer coverage begins.']
  automatic_reinstatement_flag boolean [note: 'Indicates whether the treaty limit is automatically reinstated upon payment of premium, without requiring reinsurer approval.']
  basis varchar [note: 'The contractual basis on which the reinstatement is triggered and calculated, such as per-occurrence or aggregate loss basis.']
  broker_name varchar [note: 'Name of the reinsurance broker or intermediary facilitating the reinstatement transaction and premium settlement.']
  calculation_date date [note: 'Date on which the reinstatement premium and terms were calculated based on treaty provisions and loss experience.']
  cat_event_code varchar [note: 'Industry standard code identifying the catastrophe event that exhausted treaty capacity, such as PCS or ISO CAT codes.']
  created_timestamp timestamp [note: 'System timestamp recording when this reinstatement record was first created in the reinsurance management system.']
  effective_date date [note: 'Date on which the reinstated treaty limit becomes effective and available for subsequent losses.']
  exhaustion_point decimal(18,2) [note: 'The upper limit or exhaustion point of the treaty layer being reinstated, defining where reinsurer coverage ends.']
  free_reinstatement_flag boolean [note: 'Indicates whether this reinstatement is provided at no additional premium cost per treaty terms, typically for first reinstatement.']
  invoice_date date [note: 'Date on which the reinstatement premium invoice was issued to the cedant by the reinsurer.']
  lead_reinsurer_name varchar [note: 'Name of the lead reinsurer responsible for coordinating the reinstatement process and premium collection across the syndicate.']
  loss_amount_triggering decimal(18,2) [note: 'Total ceded loss amount from the occurrence that exhausted the treaty layer and triggered the need for reinstatement.']
  notes varchar [note: 'Free-form text field for additional comments, special conditions, or explanatory notes regarding the reinstatement transaction.']
  number varchar [note: 'Sequential number of the reinstatement within the treaty layer, typically 1, 2, or 3 for multiple reinstatements.']
  payment_date date [note: 'Actual date on which the reinstatement premium was paid by the cedant to the reinsurer.']
  payment_due_date date [note: 'Date by which the reinstatement premium payment is contractually due from the cedant to the reinsurer.']
  premium_amount decimal(18,2) [note: 'Total premium amount due for reinstating the treaty limit, calculated as a percentage of the original treaty premium.']
  premium_pct decimal(5,2) [note: 'Percentage rate applied to the original premium to calculate the reinstatement premium, as specified in the treaty terms.']
  prorata_factor decimal(8,6) [note: 'Pro-rata adjustment factor applied when the reinstatement occurs partway through the treaty period, reducing the premium proportionally.']
  prorata_premium_amount decimal(18,2) [note: 'Reinstatement premium adjusted for the pro-rata factor based on remaining treaty period at the time of reinstatement.']
  reinstated_limit_amount decimal(18,2) [note: 'The treaty limit amount being reinstated and made available for subsequent losses after the triggering occurrence.']
  reinstatement_status varchar [note: 'Current lifecycle status of the reinstatement transaction, tracking from initial calculation through payment settlement.']
  reinsurer_approval_date date [note: 'Date on which the reinsurer formally approved the reinstatement of the treaty limit, if approval was required.']
  reinsurer_approval_required_flag boolean [note: 'Indicates whether explicit reinsurer approval is required before the treaty limit can be reinstated for subsequent losses.']
  territory_scope varchar [note: 'Geographic territory or region covered by the reinstated treaty layer, defining the scope of reinstated coverage.']
  treaty_type varchar [note: 'Type of reinsurance treaty structure under which this reinstatement applies, such as Excess of Loss or Catastrophe Excess of Loss.']
  treaty_year varchar [note: 'The treaty underwriting year or policy year to which this reinstatement applies, important for multi-year treaty accounting.']
  updated_by varchar [note: 'User identifier or system account that last modified this reinstatement record, supporting accountability and audit requirements.']
  updated_timestamp timestamp [note: 'System timestamp recording when this reinstatement record was last modified, supporting audit trail and change tracking.']
  created_by varchar [note: 'User identifier or system account that created this reinstatement record, supporting accountability and audit requirements.']

  Note: 'Records reinstatement of treaty limit following a loss occurrence under XOL or CAT XL treaties. Captures reinstatement premium, reinstated limit, occurrence reference, reinstatement number, and effective date per treaty layer.'
}

Table reinsurance.ri_broker {
  ri_broker_id varchar [pk, note: 'Unique identifier for the reinsurance broker record.']
  address_line1 varchar [note: 'First line of the brokers primary business address.']
  address_line2 varchar [note: 'Second line of the brokers business address for suite or floor information.']
  appointment_date date [note: 'Date when the broker was formally appointed to represent the cedant in reinsurance placements.']
  authorized_markets varchar [note: 'Comma-separated list of reinsurance markets where the broker is authorized to place business.']
  broker_code varchar [note: 'Unique business identifier code assigned to the reinsurance broker for operational reference.']
  broker_status varchar [note: 'Current operational status of the broker relationship.']
  broker_type varchar [note: 'Classification of the reinsurance broker by operational focus and market segment.']
  brokerage_rate_pct decimal(5,3) [note: 'Standard brokerage commission rate percentage charged by the broker on placed reinsurance premium.']
  cat_placement_flag boolean [note: 'Indicates whether the broker is authorized and experienced in placing catastrophe reinsurance.']
  city varchar [note: 'City name of the brokers primary business location.']
  compliance_status varchar [note: 'Current compliance status of the broker with regulatory and contractual requirements.']
  country_code varchar [note: 'Three-letter ISO country code of the brokers domicile.']
  created_timestamp timestamp [note: 'Date and time when the broker record was first created in the system.']
  credit_rating varchar [note: 'Financial strength or credit rating assigned to the broker by a recognized rating agency.']
  dba_name varchar [note: 'Trade name or doing business as name used by the broker in the market.']
  eo_coverage_amount decimal(18,2) [note: 'Limit of errors and omissions insurance coverage carried by the broker.']
  eo_expiry_date date [note: 'Expiration date of the brokers current errors and omissions insurance policy.']
  fac_placement_flag boolean [note: 'Indicates whether the broker handles facultative certificate placements.']
  fein varchar [note: 'Federal tax identification number assigned to the brokerage entity.']
  last_audit_date date [note: 'Date of the most recent compliance or financial audit conducted on the broker.']
  legal_name varchar [note: 'Full legal registered name of the reinsurance brokerage firm.']
  lloyds_authorized_flag boolean [note: 'Indicates whether the broker is authorized to place business at Lloyds of London.']
  lloyds_broker_number varchar [note: 'Unique registration number assigned by Lloyds of London for authorized Lloyds brokers.']
  naic_code varchar [note: 'Five-digit NAIC company code assigned to the broker if registered as a reinsurance intermediary.']
  next_review_date date [note: 'Scheduled date for the next periodic review or audit of the broker relationship.']
  notes varchar [note: 'Free-form text field for additional comments or special instructions related to the broker.']
  parent_company_name varchar [note: 'Legal name of the parent company if the broker is part of a larger corporate group.']
  postal_code varchar [note: 'Postal or ZIP code of the brokers primary business address.']
  primary_contact_email varchar [note: 'Email address of the primary contact for reinsurance placement communications.']
  primary_contact_name varchar [note: 'Full name of the primary contact person at the brokerage for treaty and facultative placements.']
  primary_contact_phone varchar [note: 'Primary telephone number for the broker contact.']
  rating_agency varchar [note: 'Name of the rating agency that assigned the credit rating.']
  specialty_lob varchar [note: 'Primary lines of business or perils in which the broker specializes for reinsurance placements.']
  state_province varchar [note: 'State or province code of the brokers primary business location.']
  termination_date date [note: 'Date when the broker appointment was terminated or expired.']
  treaty_placement_flag boolean [note: 'Indicates whether the broker handles treaty reinsurance placements.']
  updated_timestamp timestamp [note: 'Date and time when the broker record was last modified.']
  website_url varchar [note: 'Official website URL of the reinsurance brokerage firm.']

  Note: 'Master record for each reinsurance intermediary (RI broker) involved in treaty or FAC placement. Captures broker legal name, Lloyd\'s registration, brokerage rate, contact details, and authorized markets for placement management.'
}

Table reinsurance.ri_placement {
  ri_placement_id varchar [pk, note: 'Unique identifier for the reinsurance placement record.']
  currency_id varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this placement.']
  fac_certificate_id varchar [note: 'Reference to the facultative certificate being placed. Null for treaty placements.']
  lead_reinsurer_id varchar [note: 'Reference to the lead reinsurer who anchors the placement and typically takes the largest share.']
  lob_code_id varchar [note: 'Line of business code for the reinsurance placement, aligned with statutory reporting categories.']
  placing_agency_id varchar [note: 'Foreign key linking to producers.agency. Business justification: Agency-level attribution for reinsurance placements, especially for MGA/wholesale operations that place reinsurance on behalf of retail networks.']
  ri_broker_id varchar [note: 'Reference to the reinsurance broker or intermediary managing the placement process.']
  ri_treaty_id varchar [note: 'Reference to the treaty being placed. Null for facultative (FAC) placements.']
  treaty_layer_id varchar [note: 'Foreign key linking to reinsurance.treaty_layer. Business justification: Placements are for specific treaty layers. Currently has layer_number (INT), should have proper FK to treaty_layer which contains the full layer definition including layer_number']
  attachment_point decimal(18,2) [note: 'Loss threshold at which the reinsurance layer attaches and begins to respond. Applicable for excess of loss (XOL) structures.']
  binding_date date [note: 'Date the placement was bound and the reinsurance contract became effective.']
  broker_name varchar [note: 'Name of the reinsurance broker or intermediary managing the placement.']
  brokerage_pct decimal(5,2) [note: 'Percentage of premium paid to the reinsurance broker as commission for placement services.']
  cancellation_date date [note: 'Date the placement was cancelled or terminated prior to natural expiry.']
  cat_event_definition varchar [note: 'Definition or criteria used to determine when a catastrophe event triggers coverage under this placement.']
  cat_exposed_flag boolean [note: 'Indicates whether the placement covers catastrophe (CAT) exposures such as hurricanes, earthquakes, or other large-scale events.']
  ceding_commission_pct decimal(5,2) [note: 'Percentage of ceded premium returned to the cedant as commission to cover acquisition and administrative costs.']
  created_timestamp timestamp [note: 'Timestamp when the placement record was first created in the system.']
  exhaustion_point decimal(18,2) [note: 'Loss level at which the reinsurance layer is fully exhausted. Calculated as attachment point plus limit.']
  expiry_date date [note: 'Effective end date of the reinsurance coverage under this placement.']
  fac_type varchar [note: 'Type of facultative reinsurance structure. Applicable for FAC placements; null for treaty.']
  inception_date date [note: 'Effective start date of the reinsurance coverage under this placement.']
  lead_reinsurer_share_pct decimal(5,2) [note: 'Percentage of the total placement capacity taken by the lead reinsurer.']
  limit_amount decimal(18,2) [note: 'Maximum reinsurance coverage amount provided by this placement layer.']
  markets_approached_count varchar [note: 'Number of reinsurance markets or reinsurers approached during the placement process.']
  modified_timestamp timestamp [note: 'Timestamp when the placement record was last modified or updated.']
  participating_reinsurers_count varchar [note: 'Number of reinsurers who ultimately signed and participated in the bound placement.']
  perils_covered varchar [note: 'List or description of perils covered under the reinsurance placement, such as wind, earthquake, flood, or all risks.']
  placed_capacity_amount decimal(18,2) [note: 'Total reinsurance capacity amount successfully placed and bound with reinsurers.']
  placement_notes varchar [note: 'Free-text notes capturing key details, negotiations, special terms, or other relevant information about the placement.']
  placement_number varchar [note: 'Business identifier for the placement workflow, typically assigned by the broker or cedant.']
  placement_stage varchar [note: 'High-level phase of the placement process indicating major workflow milestones.']
  placement_status varchar [note: 'Current stage of the placement workflow from initial submission through binding or decline. [ENUM-REF-CANDIDATE: draft|slip_submitted|market_quoted|negotiation|bound|declined|cancelled — 7 candidates stripped; promote to reference product]']
  placement_type varchar [note: 'Type of reinsurance placement being executed.']
  pml_amount decimal(18,2) [note: 'Estimated probable maximum loss amount used for pricing and capacity determination in the placement.']
  program_name varchar [note: 'Name of the broader reinsurance program or tower to which this placement belongs.']
  quote_due_date date [note: 'Date by which reinsurers are expected to provide their quotes or indications.']
  quotes_received_count varchar [note: 'Number of formal quotes or indications received from reinsurers during the placement process.']
  retention_amount decimal(18,2) [note: 'Amount of risk retained by the cedant before reinsurance coverage applies.']
  rol_pct decimal(5,2) [note: 'Rate on line expressed as a percentage, calculated as premium divided by limit for excess of loss (XOL) placements.']
  slip_submission_date date [note: 'Date the reinsurance slip was submitted to the market for underwriting consideration.']
  target_capacity_amount decimal(18,2) [note: 'Total reinsurance capacity amount the cedant is seeking to place in the market.']
  territory_scope varchar [note: 'Geographic scope of the reinsurance coverage, defining which territories or regions are included.']
  total_signed_line_pct decimal(5,2) [note: 'Aggregate percentage of the placement capacity that has been signed by all participating reinsurers.']
  treaty_type varchar [note: 'Type of reinsurance treaty structure. Applicable for treaty placements; null for facultative.']
  underwriter_name varchar [note: 'Name of the cedant underwriter responsible for managing the placement process and reinsurer relationships.']

  Note: 'Tracks the placement workflow for a treaty or FAC certificate from slip submission through binding. Captures placement stage, market approached, lead reinsurer, signed line percentage, brokerage, and binding date.'
}

Table reinsurance.occurrence_loss {
  occurrence_loss_id varchar [pk, note: 'Unique identifier for the occurrence loss record. Primary key for occurrence-based loss aggregation used in Excess of Loss (XOL) treaty application.']
  bordereaux_id varchar [note: 'Identifier of the bordereaux submission in which this occurrence loss was reported to reinsurers.']
  cat_event_id varchar [note: 'FK to reservespayments.cat_event.cat_event_id — Designates reservespayments.cat_event the single catastrophe master so XOL/CAT XL occurrence aggregation rolls up to the same catastrophe event as claims and reserves.']
  currency_id varchar [note: 'Three-letter ISO currency code for all monetary amounts in this occurrence loss record.']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: Occurrence losses can be ceded under FAC certificates, not just treaties. Currently only has ri_treaty_id. This FK enables tracking FAC-based occurrence cessions.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Catastrophe occurrence losses must identify affected locations for hours clause validation (168-hour rule), PML comparison, and reinstatement trigger determination.']
  lob_code_id varchar [note: 'Code identifying the primary line of business affected by the occurrence, used for treaty layer allocation and cession calculation.']
  ri_treaty_id varchar [note: 'Identifier of the primary reinsurance treaty applied to this occurrence for cession calculation and recovery.']
  treaty_layer_id varchar [note: 'Foreign key linking to reinsurance.treaty_layer. Business justification: Occurrence losses apply to specific treaty layers. Currently has treaty_layer_number (INT), should have proper FK to treaty_layer for full layer definition access.']
  accounting_period varchar [note: 'Accounting period in which this occurrence loss is recognized for statutory and GAAP reporting purposes.']
  attachment_point decimal(18,2) [note: 'Treaty layer attachment point amount at which reinsurance coverage begins for this occurrence under XOL treaty terms.']
  cat_event_code varchar [note: 'Industry-standard catastrophe event identifier assigned by recognized catastrophe services for major loss events.']
  cat_flag boolean [note: 'Indicator whether this occurrence qualifies as a catastrophe event under treaty definitions and triggers CAT XOL coverage.']
  cession_date date [note: 'Date when the occurrence loss was formally ceded to reinsurers under the applicable treaty terms.']
  claim_count varchar [note: 'Total number of individual claims aggregated into this occurrence loss record for treaty cession purposes.']
  country_code varchar [note: 'Three-letter ISO country code identifying the country where the occurrence event occurred.']
  created_timestamp timestamp [note: 'Date and time when this occurrence loss record was first created in the system.']
  exhaustion_point decimal(18,2) [note: 'Treaty layer exhaustion point amount at which reinsurance coverage ends for this occurrence, representing the upper limit of the layer.']
  finalized_date date [note: 'Date when the occurrence loss record was closed and finalized, with no further claim additions or loss development expected.']
  geographic_region varchar [note: 'Geographic area or territory where the occurrence event took place, used for treaty territory scope validation.']
  hours_clause_compliant_flag boolean [note: 'Indicator whether all claims aggregated into this occurrence fall within the treaty hours clause time window for valid occurrence treatment.']
  hours_clause_duration varchar [note: 'Number of hours specified in the treaty hours clause for aggregating related losses into a single occurrence event.']
  layer_limit_amount decimal(18,2) [note: 'Maximum reinsurance recovery available from the treaty layer for this occurrence, calculated as exhaustion point minus attachment point.']
  net_loss_amount decimal(18,2) [note: 'Net loss amount retained by the cedant after reinsurance cession, calculated as gross loss minus ceded loss.']
  notes varchar [note: 'Free-form text notes providing additional context, special handling instructions, or commentary about the occurrence loss.']
  occurrence_date date [note: 'Date when the loss occurrence event took place. Critical for treaty layer attachment and hours clause determination.']
  occurrence_end_timestamp timestamp [note: 'Date and time when the occurrence event concluded, used to determine the duration window for aggregating related claims under hours clause provisions.']
  occurrence_name varchar [note: 'Descriptive name or title assigned to the occurrence event, typically used for catastrophic events or major loss incidents.']
  occurrence_number varchar [note: 'Business identifier for the occurrence event. Externally-known reference number used in reinsurance bordereaux and treaty reporting.']
  occurrence_status varchar [note: 'Current lifecycle status of the occurrence loss record in the reinsurance cession workflow.']
  occurrence_timestamp timestamp [note: 'Precise date and time when the occurrence event began, used for hours clause compliance verification in catastrophe treaties.']
  peril_code varchar [note: 'Standardized code identifying the type of peril that caused the occurrence loss, such as hurricane, earthquake, fire, or flood.']
  peril_description varchar [note: 'Detailed narrative description of the peril or cause of loss for the occurrence event.']
  policy_count varchar [note: 'Total number of distinct policies affected by this occurrence event, used for exposure analysis and treaty reporting.']
  reinstatement_premium_amount decimal(18,2) [note: 'Reinstatement premium amount due to reinsurers as a result of this occurrence loss exhausting or reducing treaty layer capacity.']
  reinstatement_triggered_flag boolean [note: 'Indicator whether this occurrence loss triggered a treaty layer reinstatement, requiring additional reinstatement premium payment.']
  reported_date date [note: 'Date when the occurrence loss was first reported to the reinsurance department for cession processing.']
  retention_amount decimal(18,2) [note: 'Cedant retention amount applied to this occurrence under the applicable treaty terms, representing the portion of loss retained by the ceding company.']
  state_province_code varchar [note: 'Code identifying the state or province where the occurrence event took place, used for regulatory and treaty reporting.']
  total_ceded_alae_amount decimal(18,2) [note: 'Total ALAE amount ceded to reinsurers for this occurrence under applicable treaty terms.']
  total_ceded_amount decimal(18,2) [note: 'Total amount ceded to reinsurers for this occurrence including loss and ALAE, representing the full reinsurance recovery.']
  total_ceded_loss_amount decimal(18,2) [note: 'Total loss amount ceded to reinsurers for this occurrence after applying retention and treaty layer limits.']
  total_gross_alae_amount decimal(18,2) [note: 'Total gross Allocated Loss Adjustment Expense aggregated from all claims in this occurrence, before reinsurance recovery.']
  total_gross_incurred_amount decimal(18,2) [note: 'Total gross incurred loss including indemnity, ALAE, and ULAE for this occurrence, representing the full exposure before reinsurance.']
  total_gross_loss_amount decimal(18,2) [note: 'Total gross loss amount aggregated from all claims associated with this occurrence, before any reinsurance cession or retention deduction.']
  total_gross_ulae_amount decimal(18,2) [note: 'Total gross Unallocated Loss Adjustment Expense allocated to this occurrence based on company methodology.']
  treaty_year varchar [note: 'Treaty year under which this occurrence loss is covered, used for multi-year treaty accounting and aggregate limit tracking.']
  updated_timestamp timestamp [note: 'Date and time when this occurrence loss record was last modified, used for audit trail and data lineage tracking.']

  Note: 'Aggregates losses from multiple claims into a single occurrence for XOL treaty application. Stores occurrence date, peril, total gross loss, total ceded loss, applicable treaty layer, and hours clause compliance flag.'
}

Table riskexposure.insured_location {
  insured_location_id varchar [pk, note: 'Unique surrogate identifier for the insured location record. Primary key for the insured_location master resource in the riskexposure domain.']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: International exposures require country-level risk assessment for sanctions screening, reinsurance domicile rules, catastrophe modeling (country-specific perils), and regulatory jurisdiction']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Every insured location must be classified by state for territorial rating, premium tax calculation, regulatory compliance (state DOI jurisdiction), and catastrophe exposure analysis.']
  address_line1 varchar [note: 'Primary street address of the insured location (street number and street name). Used for risk geocoding, protection class lookup, and regulatory filings.']
  address_line2 varchar [note: 'Secondary address detail for the insured location such as suite, unit, floor, or building number. Supplements address_line1 for precise premises identification.']
  alarm_type varchar [note: 'Type of burglar or fire alarm system at the insured location. Central station and direct-to-fire alarms qualify for rating credits under ISO protective device schedules.']
  building_value decimal(18,2) [note: 'Insured replacement cost or actual cash value of the building structure at this location, excluding contents and business income. Component of TIV used in property rating.']
  business_income_value decimal(18,2) [note: 'Insured value for business income and extra expense coverage at this location. Represents maximum indemnity for lost revenue following a covered loss event.']
  cat_zone varchar [note: 'Insurer-defined CAT accumulation zone code for the insured location. Used for CAT XL reinsurance treaty management, PML aggregation, and exposure accumulation reporting.']
  city varchar [note: 'City or municipality in which the insured location is situated. Used for territory rating, regulatory jurisdiction assignment, and CAT zone mapping.']
  construction_type varchar [note: 'ISO construction class of the insured building per COPE framework. Drives fire and wind rating factors. Frame is highest risk; fire_resistive is lowest. [ENUM-REF-CANDIDATE: promote to reference product if additional ISO classes needed]']
  contents_value decimal(18,2) [note: 'Insured value of business personal property and contents at this location. Separate from building value; used for contents coverage rating and TIV accumulation.']
  county varchar [note: 'County or parish in which the insured location is situated. Used for NFIP flood zone mapping, CAT modeling, and certain state-specific rating territories.']
  created_timestamp timestamp [note: 'Timestamp when the insured location record was first created in the system of record. Used for data lineage, audit trail, and regulatory compliance tracking.']
  distance_to_coast_miles decimal(8,2) [note: 'Straight-line distance in miles from the insured location to the nearest coastline. Used for wind and storm surge rating factors and CAT accumulation management in coastal territories.']
  distance_to_fire_station_miles decimal(6,2) [note: 'Distance in miles from the insured location to the nearest responding fire station. Key input to ISO Public Protection Classification (PPC) and fire rating factor determination.']
  earthquake_zone varchar [note: 'Seismic hazard zone classification (0-4) for the insured location per ISO or USGS standards. Zone 4 is highest seismic risk. Used for earthquake rating and PML modeling.']
  effective_date date [note: 'Date on which the insured location became active and covered under the associated policy. Marks the start of the location\'s coverage period for premium earning and loss reporting.']
  expiration_date date [note: 'Date on which coverage for the insured location expires or is scheduled to end. Null for open-ended locations. Used for renewal processing and earned premium calculation.']
  flood_zone varchar [note: 'FEMA National Flood Insurance Program (NFIP) flood zone designation for the insured location (e.g., AE, X, VE). Determines flood coverage eligibility, mandatory purchase requirements, and rating.']
  geocode_quality varchar [note: 'Precision level of the geocoded coordinates for the insured location. Rooftop is highest precision; zip_centroid is lowest. Affects CAT model confidence and rating accuracy.']
  itv_ratio decimal(6,4) [note: 'Ratio of the insured building value to the estimated full replacement cost. Values below 1.0 indicate underinsurance (coinsurance exposure). Used in UW review and coinsurance penalty calculation.']
  latitude decimal(9,6) [note: 'WGS-84 decimal-degree latitude of the insured location centroid. Used for CAT modeling, PML estimation, flood zone determination, and proximity-to-hazard scoring.']
  location_code varchar [note: 'Externally-known alphanumeric code assigned to the insured location, used on policy declarations pages and bordereaux submissions to identify the premises.']
  location_name varchar [note: 'Human-readable name or description of the insured premises (e.g., \'Main Street Warehouse\', \'Downtown Office\'). Used on declarations pages and loss reports.']
  location_status varchar [note: 'Current lifecycle state of the insured location record. Active locations are covered under a policy; inactive or expired locations are no longer in force.']
  location_type varchar [note: 'Classification of the insured premises by operational role: primary business site, secondary site, storage facility, temporary, mobile, or other. Drives rating and coverage eligibility.']
  longitude decimal(9,6) [note: 'WGS-84 decimal-degree longitude of the insured location centroid. Used alongside latitude for CAT modeling, PML estimation, and hazard proximity analysis.']
  naics_code varchar [note: 'Six-digit NAICS code describing the primary business activity conducted at the insured location. Used for commercial lines classification, GL rating, and regulatory statistical reporting.']
  number_of_stories varchar [note: 'Total number of above-ground floors in the primary structure at the insured location. Influences fire, wind, and earthquake rating factors and PML calculations.']
  occupancy_type varchar [note: 'ISO occupancy classification describing how the insured building is used (e.g., office, retail, manufacturing, habitational). Core COPE attribute driving underwriting and rating. [ENUM-REF-CANDIDATE: promote to reference product]']
  postal_code varchar [note: 'US ZIP or ZIP+4 postal code for the insured location. Used for territory rating, CAT zone assignment, protection class lookup, and NAIC statutory reporting.']
  protection_class varchar [note: 'ISO Public Protection Classification (PPC) rating from 1 (best) to 10 for the insured location. Core COPE attribute reflecting fire suppression capability; directly impacts property premium.']
  roof_material varchar [note: 'Primary material used in the roof covering (e.g., asphalt shingle, metal, tile, built-up). Affects wind, hail, and fire rating factors and claim severity estimates. [ENUM-REF-CANDIDATE: promote to reference product]']
  roof_type varchar [note: 'Geometric shape or style of the roof on the primary structure. Influences wind and hail rating factors, particularly in CAT-exposed territories. [ENUM-REF-CANDIDATE: flat|gable|hip|mansard|gambrel|shed|other — 7 candidates stripped; promote to reference']
  roof_year varchar [note: 'Four-digit year the roof was last replaced or substantially renovated. Used for wind and hail rating credits/surcharges and underwriting eligibility decisions.']
  sic_code varchar [note: 'Four-digit SIC code for the business activity at the insured location. Legacy classification used alongside NAICS for workers compensation, GL rating, and older policy systems.']
  source_system_code varchar [note: 'Native identifier of the insured location record in the originating system of record (e.g., Guidewire PolicyCenter location GUID or Duck Creek location key). Enables lineage tracing.']
  sprinkler_type varchar [note: 'Type of automatic fire sprinkler system installed at the insured location. Part of COPE protection assessment; presence and type provide rating credits and reduce fire PML.']
  territory_code varchar [note: 'Insurer-assigned or ISO-defined rating territory code for the insured location. Determines territory-specific rate factors for property, auto, and liability lines of business.']
  tiv decimal(18,2) [note: 'Aggregate insured value across all coverages at this location including building, contents, and business income. Key metric for PML, reinsurance cession, and CAT accumulation management.']
  total_area_sqft decimal(12,2) [note: 'Total gross floor area of the insured structure in square feet. Used for ITV (Insurance to Value) validation, replacement cost estimation, and premium rating.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the insured location record. Used for change tracking, incremental data loads, and audit compliance.']
  valuation_method varchar [note: 'Method used to value the insured property: Replacement Cost Value (RCV), Actual Cash Value (ACV), agreed value, or functional replacement. Determines claim settlement basis.']
  wind_pool_eligible boolean [note: 'Indicates whether the insured location is eligible for placement in a state wind pool or beach and windstorm plan due to coastal exposure. Affects market availability and pricing.']
  year_built varchar [note: 'Four-digit calendar year in which the primary structure at the insured location was originally constructed. Used for age-of-building rating factors and replacement cost estimation.']

  Note: 'Master SSOT for a physical premises or location insured under a P&C policy. Captures address, COPE attributes, occupancy, TIV, protection class, and geocode.'
}

Table riskexposure.scheduled_item {
  scheduled_item_id varchar [pk, note: 'Unique surrogate identifier for each individually scheduled property item record in the P&C policy administration system.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Scheduled personal property items can be associated with vehicles for coverage purposes (e.g., electronics, tools stored in vehicle, items stolen from vehicle). Optional FK.']
  photo_document_id varchar [note: 'Reference identifier to the photographic documentation of the scheduled item stored in the document management system (e.g., OpenText, FileNet) for claims and underwriting.']
  policy_coverage_id varchar [note: 'Reference to the specific coverage line (e.g., Inland Marine, Scheduled Personal Property) under which this item is scheduled.']
  policy_id varchar [note: 'Reference to the parent policy under which this scheduled item is insured.']
  actual_cash_value_amount decimal(18,2) [note: 'Actual cash value of the scheduled item calculated as RCV less depreciation. Used for ACV settlement basis claims and reserve adequacy assessment.']
  agreed_value_amount decimal(18,2) [note: 'The agreed value (AV) of the scheduled item as established at policy inception or renewal, representing the maximum insured amount payable at total loss without depreciation.']
  agreed_value_currency varchar [note: 'ISO 4217 three-letter currency code for the agreed value amount (e.g., USD, CAD, GBP).']
  annual_premium_amount decimal(18,2) [note: 'Annual written premium (WP) allocated to this scheduled item, used for premium allocation, earned premium (EP) calculation, and profitability analysis.']
  appraisal_date date [note: 'Date on which the most recent professional appraisal of the scheduled item was conducted. Used to assess appraisal currency and trigger re-appraisal workflows.']
  appraisal_expiry_date date [note: 'Date on which the current appraisal expires and a new appraisal is required to maintain agreed value coverage. Typically 2-5 years from appraisal date per carrier guidelines.']
  appraisal_value_amount decimal(18,2) [note: 'Most recent professionally appraised market value of the scheduled item, used to validate agreed value adequacy and insurance-to-value (ITV) compliance.']
  appraiser_certification_number varchar [note: 'Professional certification or license number of the appraiser, used to validate appraiser credentials for underwriting and claims purposes.']
  appraiser_name varchar [note: 'Name of the certified appraiser or appraisal firm that conducted the most recent valuation of the scheduled item.']
  blanket_group_code varchar [note: 'Code identifying the blanket coverage group to which this item belongs when is_blanket_covered is True. Used to aggregate items sharing a single blanket limit.']
  coverage_type varchar [note: 'Indicates whether the item is covered under a scheduled (individual item limit), blanket (group limit), or floater (open perils, no deductible) coverage arrangement.']
  created_timestamp timestamp [note: 'Timestamp when this scheduled item record was first created in the policy administration system, used for audit trail and data lineage.']
  effective_date date [note: 'Date on which coverage for this scheduled item becomes effective on the policy. May differ from policy effective date if item was added mid-term via endorsement.']
  endorsement_number varchar [note: 'Reference number of the policy endorsement (ENDT) through which this scheduled item was added, modified, or removed from the policy.']
  expiration_date date [note: 'Date on which coverage for this scheduled item expires. Typically aligns with policy expiration but may differ for mid-term removals or endorsements.']
  is_away_from_premises boolean [note: 'Indicates whether coverage extends to the scheduled item when it is away from the insured premises (worldwide coverage). True = worldwide; False = premises only.']
  is_blanket_covered boolean [note: 'Indicates whether this item is covered under a blanket limit shared with other items rather than an individual scheduled limit. True = blanket; False = individually scheduled.']
  iso_class_code varchar [note: 'ISO/Verisk classification code assigned to the scheduled item type, used for statistical reporting, rate filings, and NAIC statutory reporting.']
  item_category varchar [note: 'High-level category classifying the type of scheduled property item for underwriting, rating, and statutory reporting. [ENUM-REF-CANDIDATE: jewelry|fine_art|camera|musical_instrument|silverware|sports_equipment|collectible|tools_equipment|other — promote']
  item_deductible_amount decimal(18,2) [note: 'Per-item deductible amount applicable to this scheduled item. Many scheduled item endorsements carry a zero deductible; this field captures exceptions.']
  item_description varchar [note: 'Full narrative description of the scheduled item including make, model, material, distinguishing features, and any other underwriting-relevant details.']
  item_name varchar [note: 'Short descriptive name or title of the scheduled item as it appears on the policy schedule (e.g., \'Diamond Engagement Ring\', \'Leica M11 Camera\').']
  item_number varchar [note: 'Externally visible alphanumeric identifier assigned to this scheduled item on the declarations page (DEC) and endorsement schedule.']
  item_status varchar [note: 'Current lifecycle status of the scheduled item on the policy. Drives coverage eligibility and claims adjudication.']
  item_type varchar [note: 'Granular sub-type within the item category (e.g., \'engagement ring\' under jewelry, \'oil painting\' under fine art) used for detailed rating and claims adjudication.']
  lob_code varchar [note: 'NAIC or carrier-defined line of business (LOB) code under which this scheduled item is reported (e.g., Inland Marine, Homeowners, Commercial Package).']
  location_description varchar [note: 'Narrative description of the primary location where the scheduled item is kept or stored (e.g., \'primary residence safe\', \'bank vault\', \'studio\'). Used for risk assessment.']
  make varchar [note: 'Manufacturer or brand name of the scheduled item (e.g., \'Rolex\', \'Steinway\', \'Canon\') used for valuation and claims settlement.']
  model varchar [note: 'Model name or number of the scheduled item as specified by the manufacturer, used for replacement cost valuation and claims.']
  purchase_date date [note: 'Date on which the insured originally purchased or acquired the scheduled item, used for depreciation calculation and ACV determination.']
  purchase_price_amount decimal(18,2) [note: 'Original purchase price paid by the insured for the scheduled item, used as a baseline for valuation, ITV assessment, and claims settlement reference.']
  rate_per_hundred decimal(10,6) [note: 'Insurance rate expressed as cost per $100 of agreed value, used by the rating engine to calculate the annual premium for this scheduled item.']
  removal_date date [note: 'Date on which the scheduled item was removed from the policy via endorsement (ENDT), triggering a pro-rata premium adjustment and coverage termination.']
  removal_reason varchar [note: 'Reason code for removal of the scheduled item from the policy. Used for underwriting analysis and portfolio management. [ENUM-REF-CANDIDATE: sold|lost|stolen|destroyed|gifted|insured_request|underwriting_decision|other — promote to reference product]']
  replacement_cost_value_amount decimal(18,2) [note: 'Estimated cost to replace the scheduled item with a new item of like kind and quality at current market prices. Used for RCV settlement basis claims.']
  serial_number varchar [note: 'Manufacturer serial number or unique physical identifier of the scheduled item, used for theft recovery, subrogation, and claims verification.']
  storage_type varchar [note: 'Classification of the primary storage arrangement for the scheduled item, used for risk rating and underwriting guidelines compliance.']
  underwriting_notes varchar [note: 'Free-text underwriting notes or conditions associated with this scheduled item, capturing special risk considerations, inspection requirements, or coverage restrictions.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this scheduled item record in the policy administration system, used for change tracking and audit compliance.']
  valuation_basis varchar [note: 'The contractual basis on which the scheduled item will be valued at the time of a covered loss (e.g., agreed value, RCV, ACV, stated amount).']
  year_manufactured varchar [note: 'Four-digit year the scheduled item was manufactured or created, used for depreciation, ACV calculation, and underwriting risk assessment.']

  Note: 'Individually scheduled personal or commercial property items (jewelry, fine art, equipment, tools). Stores item description, agreed value, appraisal date, serial number, and blanket vs scheduled coverage flag.'
}

Table riskexposure.insured_vehicle {
  insured_vehicle_id varchar [pk, note: 'Unique identifier for the insured vehicle record. Primary key.']
  policy_id varchar [note: 'Reference to the auto policy under which this vehicle is insured.']
  actual_cash_value_amount decimal(15,2) [note: 'Current market value of the vehicle accounting for depreciation, used for claim settlement.']
  annual_mileage varchar [note: 'Estimated annual miles driven, used for rating and risk assessment.']
  anti_theft_device varchar [note: 'Type of anti-theft device installed on the vehicle, may qualify for premium discount.']
  body_type varchar [note: 'Physical body style of the vehicle such as sedan, coupe, SUV, pickup, van.']
  collision_symbol varchar [note: 'Rating symbol for collision coverage based on vehicle repair costs and safety features.']
  comp_symbol varchar [note: 'Rating symbol for comprehensive coverage based on vehicle theft and damage risk.']
  created_timestamp timestamp [note: 'Timestamp when the insured vehicle record was first created in the system.']
  effective_date date [note: 'Date the vehicle coverage becomes effective on the policy.']
  expiration_date date [note: 'Date the vehicle coverage expires or is scheduled to end.']
  garaging_address_line1 varchar [note: 'Primary street address where the vehicle is principally garaged or parked overnight.']
  garaging_address_line2 varchar [note: 'Secondary address line for garaging location such as apartment or unit number.']
  garaging_city varchar [note: 'City where the vehicle is principally garaged.']
  garaging_country_code varchar [note: 'Three-letter ISO country code for the garaging location.']
  garaging_county varchar [note: 'County where the vehicle is garaged, used for rating and regulatory reporting.']
  garaging_postal_code varchar [note: 'ZIP code of the garaging location, critical for territory rating.']
  garaging_state_code varchar [note: 'Two-letter state code where the vehicle is principally garaged, used for rating and regulatory compliance.']
  is_rideshare_vehicle boolean [note: 'Indicates whether the vehicle is used for rideshare services such as Uber or Lyft.']
  is_salvage_title boolean [note: 'Indicates whether the vehicle has a salvage or rebuilt title, affecting insurability and valuation.']
  license_plate_number varchar [note: 'Current license plate number registered to the vehicle.']
  license_plate_state varchar [note: 'State of registration for the license plate.']
  lienholder_address varchar [note: 'Mailing address of the lienholder for loss payee and certificate purposes.']
  lienholder_name varchar [note: 'Name of the financial institution or entity holding a lien or loan on the vehicle.']
  loan_lease_indicator varchar [note: 'Indicates whether the vehicle is owned outright, financed, or leased.']
  make varchar [note: 'Manufacturer or brand name of the vehicle.']
  model varchar [note: 'Specific model name or designation of the vehicle.']
  odometer_reading varchar [note: 'Current mileage reading of the vehicle at the time of policy binding or renewal.']
  purchase_date date [note: 'Date the insured purchased or acquired the vehicle.']
  purchase_price_amount decimal(15,2) [note: 'Original purchase price paid for the vehicle by the insured.']
  removal_date date [note: 'Date the vehicle was removed from the policy if applicable.']
  removal_reason varchar [note: 'Reason the vehicle was removed from the policy.']
  safety_features varchar [note: 'Comma-separated list of safety features such as airbags, ABS, ESC that may affect rating.']
  stated_value_amount decimal(15,2) [note: 'Agreed-upon value of the vehicle for insurance purposes, typically used for classic or specialty vehicles.']
  territory_code varchar [note: 'Rating territory code assigned based on garaging location for premium calculation.']
  updated_timestamp timestamp [note: 'Timestamp when the insured vehicle record was last modified.']
  vehicle_number varchar [note: 'Sequential number assigned to the vehicle within the policy for identification purposes.']
  vehicle_status varchar [note: 'Current lifecycle status of the vehicle on the policy.']
  vehicle_symbol varchar [note: 'ISO or proprietary rating symbol assigned to the vehicle based on make, model, and year for premium calculation.']
  vehicle_type varchar [note: 'High-level classification of the vehicle for policy and coverage determination.']
  vehicle_use varchar [note: 'Primary use classification of the vehicle for rating and underwriting purposes.']
  vin varchar [note: '17-character unique identifier assigned to the vehicle by the manufacturer. Industry-standard vehicle identifier.']
  year varchar [note: 'Model year of the vehicle as designated by the manufacturer.']

  Note: 'Master SSOT for a motor vehicle insured under a personal or commercial auto policy. Stores VIN, year, make, model, body type, garaging address, usage, and symbol.'
}

Table riskexposure.insured_entity {
  insured_entity_id varchar [pk, note: 'Unique identifier for the insured entity record. Primary key.']
  parent_entity_insured_entity_id varchar [note: 'Reference to the parent insured entity if this entity is a subsidiary or division, used for account hierarchy.']
  annual_revenue_amount decimal(18,2) [note: 'Reported annual gross revenue of the entity in USD, used for exposure rating and premium calculation.']
  created_timestamp timestamp [note: 'System timestamp when the insured entity record was first created in the source system.']
  credit_score varchar [note: 'Commercial or personal credit score used as an underwriting factor for pricing and risk selection.']
  dba_name varchar [note: 'Trade name or fictitious business name under which the entity operates, if different from legal name.']
  effective_date date [note: 'Date when the insured entity record became active and eligible for policy binding.']
  entity_number varchar [note: 'Business-assigned unique identifier for the insured entity, used in policy documents and correspondence.']
  entity_status varchar [note: 'Current lifecycle status of the insured entity record within the system.']
  entity_type varchar [note: 'Legal structure classification of the insured entity for underwriting and regulatory purposes.']
  expiration_date date [note: 'Date when the insured entity record expires or is no longer active for new policy issuance.']
  fein varchar [note: 'IRS-issued tax identification number for business entities, used for underwriting and regulatory reporting.']
  is_subsidiary boolean [note: 'Indicates whether this entity is a subsidiary of another insured entity, used for account structure analysis.']
  last_modified_timestamp timestamp [note: 'System timestamp when the insured entity record was last updated in the source system.']
  legal_name varchar [note: 'Full legal name of the insured entity as registered with governing authorities or as appears on official documents.']
  loss_free_years varchar [note: 'Number of consecutive years without a reported claim, used for experience rating and premium discounts.']
  mailing_address_line1 varchar [note: 'First line of the mailing address for policy documents, billing statements, and official correspondence.']
  mailing_address_line2 varchar [note: 'Second line of the mailing address for suite, unit, or additional address details.']
  mailing_city varchar [note: 'City name for the mailing address of the insured entity.']
  mailing_country_code varchar [note: 'Three-letter ISO country code for the mailing address of the insured entity.']
  mailing_postal_code varchar [note: 'ZIP or postal code for the mailing address, used for correspondence delivery and territory rating.']
  mailing_state_code varchar [note: 'Two-letter state or province code for the mailing address, used for regulatory jurisdiction and rating.']
  naics_code varchar [note: 'Six-digit code classifying the primary business activity of the entity for risk classification and rating.']
  number_of_employees varchar [note: 'Total count of full-time equivalent employees, used for workers compensation and liability rating.']
  primary_contact_name varchar [note: 'Full name of the primary contact person for the insured entity, used for policy servicing and communication.']
  primary_contact_title varchar [note: 'Job title or role of the primary contact person within the insured entity organization.']
  primary_email varchar [note: 'Primary email address for policy correspondence, billing notices, and renewal communications.']
  primary_phone varchar [note: 'Primary telephone number for contacting the insured entity for underwriting, claims, and servicing.']
  prior_carrier_name varchar [note: 'Name of the previous insurance carrier, used for loss history verification and underwriting continuity.']
  prior_expiration_date date [note: 'Expiration date of the prior insurance policy, used to assess coverage continuity and lapse risk.']
  prior_policy_number varchar [note: 'Policy number with the prior carrier, used for loss run requests and underwriting verification.']
  sic_code varchar [note: 'Four-digit code classifying the industry sector of the entity, used for legacy rating and statistical reporting.']
  ssn varchar [note: 'Social Security Number for individual insured entities, used for identity verification and underwriting.']
  uw_tier varchar [note: 'Risk classification tier assigned by underwriting based on loss history, financials, and risk characteristics.']
  website_url varchar [note: 'Official website address of the insured entity, used for underwriting research and business verification.']
  years_in_business varchar [note: 'Number of years the entity has been operating, used as an underwriting factor for risk assessment.']

  Note: 'Master record for a named insured party (individual, household, or commercial entity) tied to a risk exposure. Captures legal name, FEIN or SSN, NAICS/SIC code, DBA, entity type, and underwriting tier.'
}

Table riskexposure.risk_unit {
  risk_unit_id varchar [pk, note: 'Unique identifier for the risk unit. Primary key. ROLE=MASTER_RESOURCE.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Risk units can represent entity-level risks (e.g., WC employer risk unit, GL named insured operations). Valid FK linking risk unit to the insured entity it represents.']
  insured_location_id varchar [note: 'Foreign key to the insured location where this risk unit is situated.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Risk units can represent vehicle risks in auto policies. The risk_unit table has VIN and vehicle attributes, indicating it can be a vehicle risk.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Risk units must be classified by line of business for rating algorithm selection, loss reserving (LOB-specific development patterns), statutory reporting (Schedule P), reinsurance treaty']
  policy_coverage_id varchar [note: 'Foreign key to the coverage that applies to this risk unit.']
  policy_id varchar [note: 'Foreign key to the policy under which this risk unit is insured.']
  scheduled_equipment_id varchar [note: 'Foreign key linking to riskexposure.scheduled_equipment. Business justification: Risk units can represent scheduled equipment in equipment floater or inland marine policies. Valid FK for equipment-level risks.']
  scheduled_item_id varchar [note: 'Foreign key linking to riskexposure.scheduled_item. Business justification: Risk units can represent scheduled personal property items in inland marine or personal articles floater policies. Valid FK for item-level risks.']
  added_date date [note: 'Date when this risk unit was added to the policy, which may differ from the policy effective date for mid-term additions.']
  annual_premium decimal(18,2) [note: 'Annual premium amount charged for this risk unit based on rated exposure and applicable rates.']
  cat_zone varchar [note: 'Catastrophe zone designation for this risk unit, indicating exposure to natural perils such as hurricane, earthquake, or flood.']
  class_code varchar [note: 'ISO or NCCI classification code identifying the type of risk or business operation for rating purposes.']
  construction_type varchar [note: 'ISO construction classification for building risk units, indicating fire resistance and structural characteristics.']
  created_timestamp timestamp [note: 'Timestamp when this risk unit record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'Deductible amount applicable to this risk unit, representing the insured retention per occurrence.']
  earthquake_zone varchar [note: 'Seismic zone classification indicating earthquake risk exposure for the risk unit.']
  effective_date date [note: 'Date when coverage for this risk unit becomes effective under the policy.']
  endorsement_number varchar [note: 'Endorsement number associated with the addition, modification, or removal of this risk unit.']
  expiration_date date [note: 'Date when coverage for this risk unit expires or terminates under the policy.']
  exposure_base varchar [note: 'The unit of measure used to rate this risk unit, such as area, payroll, receipts, or number of vehicles.']
  exposure_quantity decimal(18,4) [note: 'Numeric quantity of the exposure base used for premium rating calculations.']
  flood_zone varchar [note: 'FEMA flood zone designation indicating flood risk level for the risk unit location.']
  modified_timestamp timestamp [note: 'Timestamp when this risk unit record was last modified in the system.']
  number varchar [note: 'Business identifier for the risk unit, externally known and used in policy documents and communications.']
  number_of_employees varchar [note: 'Count of employees in the employee class for workers compensation risk units.']
  occupancy_type varchar [note: 'Type of occupancy or business operation conducted at the risk unit location.']
  payroll_amount decimal(18,2) [note: 'Annual payroll amount for workers compensation employee class risk units, used as exposure base.']
  pml decimal(18,2) [note: 'Estimated probable maximum loss for this risk unit under catastrophic event scenarios, used for reinsurance and capital planning.']
  protection_class varchar [note: 'ISO Public Protection Classification indicating fire protection quality and proximity to fire services.']
  rate_per_unit decimal(12,6) [note: 'Premium rate applied per unit of exposure for this risk unit, used in premium calculation.']
  removal_reason varchar [note: 'Business reason for removing this risk unit from coverage, such as sale, disposal, or policy cancellation.']
  removed_date date [note: 'Date when this risk unit was removed from the policy, applicable for mid-term deletions or cancellations.']
  risk_unit_name varchar [note: 'Human-readable name or label for the risk unit, such as building name, vehicle description, or employee class title.']
  risk_unit_status varchar [note: 'Current lifecycle status of the risk unit within the policy term.']
  risk_unit_type varchar [note: 'Classification of the risk unit indicating the nature of the insurable asset or exposure. [ENUM-REF-CANDIDATE: building|vehicle|employee_class|gl_operation|equipment|inventory|other — 7 candidates stripped; promote to reference product]']
  si decimal(18,2) [note: 'Total sum insured or limit of liability for this risk unit, representing the maximum coverage amount.']
  sir_amount decimal(18,2) [note: 'Self-insured retention amount for this risk unit, applicable before coverage attaches.']
  territory_code varchar [note: 'Geographic rating territory code assigned to this risk unit for premium calculation purposes.']
  tiv decimal(18,2) [note: 'Total insured value of the risk unit, including all covered property and business income exposures.']
  valuation_method varchar [note: 'Method used to determine the insured value: Replacement Cost Value, Actual Cash Value, Agreed Value, Market Value, or Functional Replacement.']
  wind_pool_eligible boolean [note: 'Indicates whether the risk unit is eligible for state wind pool or coastal insurance programs.']
  year_built varchar [note: 'Year the building or structure was originally constructed, used for age-based rating adjustments.']

  Note: 'Atomic unit of insurable risk on a policy (building, vehicle, employee class, or GL operation). Single SSOT for rated exposure quantity, SI, TIV, exposure base, payroll, and LOB risk characteristics. Anchors the policy-coverage-exposure FK lineage.'
}

Table riskexposure.cat_zone {
  cat_zone_id varchar [pk, note: 'Unique identifier for the catastrophe zone record.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: CAT zones are state-specific regulatory constructs (wind pools, earthquake authorities, FAIR plans).']
  base_flood_elevation_ft decimal(8,2) [note: 'Base flood elevation in feet above sea level for 100-year flood event, used for NFIP compliance.']
  cat_loading_factor decimal(8,5) [note: 'Catastrophe loading factor applied to premium rates for exposures in this zone, expressed as decimal.']
  cat_model_vendor varchar [note: 'Name of catastrophe modeling vendor whose model was used to define this zone.']
  cat_model_version varchar [note: 'Version identifier of the catastrophe model used to define loss characteristics for this zone.']
  county_fips_code varchar [note: 'Five-digit FIPS code identifying the county for this catastrophe zone.']
  distance_to_coast_miles decimal(8,2) [note: 'Distance in miles from this zone centroid to nearest coastline, relevant for hurricane and storm surge risk.']
  earthquake_magnitude_scale decimal(3,1) [note: 'Expected earthquake magnitude on Richter scale for seismic zones, used for exposure assessment.']
  effective_date date [note: 'Date when this catastrophe zone definition became effective for underwriting and rating purposes.']
  expiration_date date [note: 'Date when this catastrophe zone definition expires or is superseded by a new version.']
  fema_flood_zone_code varchar [note: 'FEMA flood zone designation code indicating flood risk level for this zone.']
  firm_effective_date date [note: 'Date when the current FIRM panel became effective for this zone.']
  firm_panel_number varchar [note: 'FEMA FIRM panel number identifying the official flood map for this zone.']
  geography_type varchar [note: 'Type of geographic boundary used to define this catastrophe zone.']
  hurricane_wind_speed_mph varchar [note: 'Design wind speed in miles per hour for hurricane peril zones, used for rating and building code compliance.']
  iso_crpc_code varchar [note: 'ISO CRPC code indicating fire protection class for commercial properties in this zone.']
  last_updated_date date [note: 'Date when this catastrophe zone record was last updated in the system.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the catastrophe zone centroid in decimal degrees.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the catastrophe zone centroid in decimal degrees.']
  mandatory_flood_purchase_indicator boolean [note: 'Indicates whether flood insurance is federally mandated for mortgaged properties in this zone.']
  nfip_community_code varchar [note: 'Six-digit NFIP community identifier for jurisdictions participating in the flood insurance program.']
  nfip_participation_status varchar [note: 'Current NFIP participation status of the community where this zone is located.']
  peril_type varchar [note: 'Type of catastrophe peril this zone represents: hurricane, earthquake, flood, wildfire, hail, or tornado.']
  pml_amount decimal(18,2) [note: 'Estimated probable maximum loss amount in USD for a catastrophic event in this zone.']
  pml_tier varchar [note: 'PML tier classification indicating relative catastrophe loss exposure severity for this zone.']
  return_period_years varchar [note: 'Statistical return period in years for the catastrophe event scenario modeled for this zone.']
  territory_code varchar [note: 'Rating territory code assigned to this catastrophe zone for premium calculation purposes.']
  wildfire_hazard_severity varchar [note: 'Wildfire hazard severity classification for this zone based on fuel load, topography, and climate.']
  wind_pool_eligible boolean [note: 'Indicates whether properties in this zone are eligible for state wind pool or residual market coverage.']
  zip_code varchar [note: 'Five-digit postal ZIP code associated with this catastrophe zone, if applicable.']
  zone_code varchar [note: 'Business identifier code for the catastrophe zone, typically assigned by rating bureau or insurer.']
  zone_name varchar [note: 'Descriptive name of the catastrophe zone for business reference and reporting.']
  zone_status varchar [note: 'Current lifecycle status of the catastrophe zone definition.']

  Note: 'Reference for catastrophe peril zones (hurricane, quake, flood, wildfire, hail) mapped to geography. Stores PML tier, CAT loading, FEMA/NFIP flood zone code, BFE, FIRM panel, and mandatory-purchase indicator for flood compliance.'
}

Table riskexposure.risk_characteristic {
  risk_characteristic_id varchar [pk, note: 'Unique identifier for the risk characteristic record. Primary key.']
  insured_location_id varchar [note: 'Identifier of the insured location when the characteristic applies to a property location.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Risk characteristics can apply to vehicles (e.g., anti-theft device type, safety features, usage patterns). Valid optional FK for vehicle-specific underwriting factors.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Risk characteristics are LOB-specific rating variables (construction type for property, vehicle use for auto, payroll for WC).']
  policy_id varchar [note: 'Identifier of the policy to which this risk characteristic applies.']
  risk_unit_id varchar [note: 'Identifier of the specific risk unit (location, vehicle, driver, equipment) being characterized.']
  scheduled_equipment_id varchar [note: 'Foreign key linking to riskexposure.scheduled_equipment. Business justification: Risk characteristics can apply to scheduled equipment (e.g., maintenance status, safety certifications, usage intensity).']
  scheduled_item_id varchar [note: 'Foreign key linking to riskexposure.scheduled_item. Business justification: Risk characteristics can apply to scheduled items (e.g., appraisal status, security features for jewelry, storage conditions).']
  boolean_value boolean [note: 'Boolean representation of the characteristic value when data type is boolean (e.g., true for sprinkler_present, false for prior_claims).']
  change_reason varchar [note: 'Reason for the characteristic value change (e.g., endorsement, renewal, inspection update, correction).']
  characteristic_category varchar [note: 'High-level category grouping the characteristic (e.g., property, liability, auto, workers_comp, driver, equipment). [ENUM-REF-CANDIDATE: property|liability|auto|workers_comp|equipment|driver|occupancy|construction|protection|exposure — 10 candidates']
  characteristic_code varchar [note: 'Standardized code for the characteristic, used for rating and underwriting rules (e.g., ROOF_AGE, ALARM_TYP, DRV_AGE).']
  characteristic_data_type varchar [note: 'Data type of the characteristic value (string, numeric, boolean, date, enumeration) to support proper rating and validation.']
  characteristic_name varchar [note: 'Name of the underwriting characteristic being captured (e.g., roof_age, alarm_type, driver_age, years_in_business, sprinkler_system).']
  characteristic_value decimal(18,2) [note: 'The actual value of the characteristic as captured during underwriting (e.g., 15 for roof age, Central Station for alarm type, 42 for driver age).']
  created_by_user varchar [note: 'User ID or name of the person who created this characteristic record.']
  created_timestamp timestamp [note: 'Timestamp when this risk characteristic record was first created in the system.']
  date_value date [note: 'Date representation of the characteristic value when data type is date (e.g., roof installation date, driver license issue date).']
  effective_date date [note: 'Date from which this characteristic value is effective for the risk unit and policy.']
  endorsement_number varchar [note: 'Endorsement number associated with the addition or change of this characteristic value.']
  expiration_date date [note: 'Date on which this characteristic value expires or is superseded by a new value.']
  is_mandatory boolean [note: 'Indicates whether this characteristic is mandatory for policy binding and issuance in the applicable line of business.']
  is_rating_variable boolean [note: 'Indicates whether this characteristic is used as a variable in premium rating calculations.']
  is_underwriting_factor boolean [note: 'Indicates whether this characteristic is used in underwriting risk selection and eligibility decisions.']
  iso_class_code varchar [note: 'ISO classification code associated with this characteristic for standardized rating and underwriting.']
  naics_code varchar [note: 'NAICS code associated with the business or occupancy characteristic for industry classification.']
  ncci_class_code varchar [note: 'NCCI class code for workers compensation characteristics (e.g., job classification, payroll exposure).']
  notes varchar [note: 'Free-text notes or comments regarding the characteristic value, its source, or underwriting considerations.']
  numeric_value decimal(18,4) [note: 'Numeric representation of the characteristic value when data type is numeric (e.g., 15.0 for roof age, 42.0 for driver age, 25000.0 for payroll).']
  rating_impact_factor decimal(10,6) [note: 'Multiplicative factor or credit/debit applied to premium rating based on this characteristic value (e.g., 0.95 for alarm discount, 1.20 for high-risk occupancy).']
  sic_code varchar [note: 'SIC code associated with the business or occupancy characteristic for legacy industry classification.']
  source_document_type varchar [note: 'Type of document or data source from which the characteristic was obtained (e.g., application, inspection_report, MVR, CLUE, third_party_data).']
  territory_code varchar [note: 'Rating territory code associated with this characteristic for geographic rating segmentation.']
  underwriting_tier varchar [note: 'Underwriting tier classification driven by this characteristic (preferred, standard, substandard, declined).']
  unit_of_measure varchar [note: 'Unit of measure for numeric characteristics (e.g., years, miles, square_feet, dollars, employees, vehicles).']
  updated_by_user varchar [note: 'User ID or name of the person who last updated this characteristic record.']
  updated_timestamp timestamp [note: 'Timestamp when this risk characteristic record was last updated.']
  verification_date date [note: 'Date on which the characteristic value was verified or last validated.']
  verification_status varchar [note: 'Status indicating whether the characteristic value has been verified through inspection, third-party data, or other means.']
  verified_by varchar [note: 'Name or identifier of the person, system, or third-party service that verified the characteristic value.']

  Note: 'Stores LOB-specific underwriting characteristics for a risk unit (e.g., roof age, alarm type, sprinkler system, driver age, MVR points, years in business). Each row is one characteristic name-value pair per risk unit.'
}

Table riskexposure.exposure_period {
  exposure_period_id varchar [pk, note: 'Unique identifier for the exposure period record.']
  exposure_id varchar [note: 'Reference to the specific coverage within the policy for this exposure period.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Exposure periods can track entity-level exposure (e.g., WC employer exposure, GL named insured exposure). Valid optional FK for entity exposure tracking.']
  insured_location_id varchar [note: 'Reference to the insured location associated with this exposure period.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Exposure periods can track vehicle-specific exposure in auto policies (e.g., vehicle added/removed mid-term). Valid optional FK for vehicle exposure tracking.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Exposure periods drive earned premium calculation by LOB for statutory reporting (Annual Statement Schedule P), loss ratio analysis, and reinsurance premium allocation.']
  policy_id varchar [note: 'Reference to the policy under which this exposure period exists.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Exposure periods track the time ranges during which risk units are on-risk within a policy term. Core missing relationship linking exposure tracking to the specific risk unit.']
  scheduled_item_id varchar [note: 'Reference to a scheduled item if this exposure period applies to a specifically scheduled asset.']
  cancellation_date date [note: 'Date when the exposure period was cancelled, if applicable.']
  cancellation_reason_code varchar [note: 'Standardized code indicating the reason for cancellation.']
  cat_zone varchar [note: 'Catastrophe zone classification for this exposure period.']
  created_timestamp timestamp [note: 'Timestamp when this exposure period record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this exposure period.']
  deductible_amount decimal(18,2) [note: 'Deductible amount applicable to claims during this exposure period.']
  earned_days varchar [note: 'Number of days earned as of the calculation date within the exposure period.']
  earned_exposure_units decimal(18,4) [note: 'Exposure units earned as of the calculation date, prorated over the exposure period.']
  earned_premium_amount decimal(18,2) [note: 'Premium earned as of the calculation date for this exposure period.']
  effective_date date [note: 'Date when the exposure period begins and risk coverage starts.']
  endorsement_effective_date date [note: 'Effective date of the endorsement that created or modified this exposure period.']
  endorsement_number varchar [note: 'Endorsement number if this exposure period was created or modified by an endorsement.']
  expiration_date date [note: 'Date when the exposure period ends and risk coverage terminates.']
  exposure_basis varchar [note: 'The unit of measure used to calculate exposure for rating purposes. [ENUM-REF-CANDIDATE: area|units|payroll|sales|vehicles|employees|receipts — 7 candidates stripped; promote to reference product]']
  exposure_days varchar [note: 'Total number of calendar days in the exposure period.']
  exposure_status varchar [note: 'Current lifecycle status of the exposure period.']
  exposure_units decimal(18,4) [note: 'Quantity of exposure units on risk during this period, used for premium calculation.']
  is_cat_exposed boolean [note: 'Indicates whether this exposure period is subject to catastrophe risk.']
  limit_amount decimal(18,2) [note: 'Maximum coverage limit applicable during this exposure period.']
  number varchar [note: 'Business identifier for the exposure period, typically sequenced within a policy term.']
  pml_amount decimal(18,2) [note: 'Estimated probable maximum loss for this exposure period under catastrophe scenarios.']
  premium_amount decimal(18,2) [note: 'Total premium charged for this exposure period.']
  pro_rata_factor decimal(8,6) [note: 'Pro-rata calculation factor used for mid-term adjustments and earned premium calculations.']
  rate_per_unit decimal(12,6) [note: 'Premium rate applied per exposure unit for this period.']
  reinstatement_date date [note: 'Date when a previously cancelled exposure period was reinstated.']
  sir_amount decimal(18,2) [note: 'Self-insured retention amount the insured must pay before coverage applies.']
  territory_code varchar [note: 'Geographic rating territory code applicable to this exposure period.']
  tiv decimal(18,2) [note: 'Total insured value at risk during this exposure period.']
  transaction_type varchar [note: 'Type of policy transaction that created or modified this exposure period.']
  unearned_exposure_units decimal(18,4) [note: 'Exposure units remaining unearned as of the calculation date.']
  unearned_premium_amount decimal(18,2) [note: 'Premium remaining unearned as of the calculation date.']
  updated_timestamp timestamp [note: 'Timestamp when this exposure period record was last modified.']
  written_exposure_units decimal(18,4) [note: 'Total exposure units written at policy inception or endorsement effective date.']
  written_premium_amount decimal(18,2) [note: 'Premium written at the start of this exposure period.']

  Note: 'Tracks the effective date range during which a risk unit is on-risk within a policy term. Captures written exposure, earned exposure, and mid-term changes due to endorsements, cancellations, or reinstatements.'
}

Table riskexposure.uw_survey {
  uw_survey_id varchar [pk, note: 'Unique identifier for the underwriting survey record.']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: Underwriting surveys often result from prior claims or are referenced during claim investigation for pre-loss condition documentation, subrogation support, and coverage dispute resolution.']
  insured_location_id varchar [note: 'Reference to the specific insured location surveyed.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Underwriting surveys can be conducted on vehicles, especially for commercial fleets or high-value personal auto. Valid optional FK for vehicle inspections.']
  policy_id varchar [note: 'Reference to the policy for which this survey was conducted.']
  report_document_id varchar [note: 'Reference identifier for the formal survey report document stored in the document management system.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Underwriting surveys are conducted on risk units (buildings, operations, fleets). This is a core missing relationship linking surveys to the specific risk unit inspected.']
  completed_date date [note: 'Date when the survey was finalized and all findings documented.']
  conditions_imposed varchar [note: 'Specific conditions, endorsements, or requirements imposed on the policy as a result of survey findings.']
  cope_construction varchar [note: 'Construction type observed during survey, part of COPE assessment: frame, joisted masonry, non-combustible, masonry non-combustible, modified fire resistive, or fire resistive.']
  cope_exposure varchar [note: 'External exposure factors observed during survey, part of COPE assessment: proximity to other buildings, wildfire risk, flood risk, earthquake risk.']
  cope_occupancy varchar [note: 'Occupancy type observed during survey, part of COPE assessment, describing how the building is used.']
  cope_protection varchar [note: 'Fire protection features observed during survey, part of COPE assessment: sprinklers, alarms, fire department proximity, water supply adequacy.']
  cost_amount decimal(15,2) [note: 'Total cost incurred for conducting the survey, including inspector fees, travel, and third-party vendor charges.']
  cost_currency varchar [note: 'Three-letter ISO 4217 currency code for the survey cost amount.']
  created_timestamp timestamp [note: 'Date and time when the survey record was first created in the system.']
  duration_minutes varchar [note: 'Total time spent conducting the survey, measured in minutes.']
  findings_summary varchar [note: 'High-level summary of key observations, hazards, and risk characteristics identified during the survey.']
  follow_up_date date [note: 'Scheduled date for follow-up survey or inspection to verify compliance with recommendations.']
  follow_up_required_flag boolean [note: 'Indicates whether a follow-up survey or inspection is required to verify improvements or reassess risk.']
  hazards_identified varchar [note: 'Detailed list of specific hazards, deficiencies, or risk factors observed during the inspection.']
  improvement_deadline_date date [note: 'Date by which recommended improvements must be completed to maintain coverage or favorable terms.']
  inspector_code varchar [note: 'Unique identifier for the inspector or surveyor who performed the inspection.']
  inspector_company varchar [note: 'Name of the company or organization employing the inspector, relevant for third-party surveys.']
  inspector_name varchar [note: 'Full name of the individual who conducted the field survey or inspection.']
  notes varchar [note: 'Additional comments, observations, or context relevant to the survey that do not fit in other structured fields.']
  photos_taken_count varchar [note: 'Number of photographs captured during the survey for documentation purposes.']
  premium_impact_amount decimal(15,2) [note: 'Estimated change in premium resulting from survey findings, expressed as a positive or negative dollar amount.']
  premium_impact_percentage decimal(5,2) [note: 'Estimated percentage change in premium resulting from survey findings, expressed as a positive or negative percentage.']
  recommended_improvements varchar [note: 'Specific actions or modifications recommended to reduce risk exposure and improve insurability.']
  report_url varchar [note: 'Web link or file path to access the complete survey report document.']
  review_date date [note: 'Date when the underwriter reviewed the survey findings and made the underwriting decision.']
  risk_grade varchar [note: 'Qualitative risk grade assigned to the surveyed location: excellent, good, fair, poor, or unacceptable.']
  risk_score decimal(5,2) [note: 'Quantitative risk assessment score assigned based on survey findings, typically on a scale of 0-100.']
  scheduled_date date [note: 'Date when the survey was originally scheduled to occur.']
  survey_date date [note: 'Date when the field survey or inspection was conducted.']
  survey_method varchar [note: 'Method used to conduct the survey: on-site visit, remote assessment, desktop review, hybrid approach, aerial imagery, or drone inspection.']
  survey_number varchar [note: 'Business identifier for the survey, often used in external communications and documentation.']
  survey_source varchar [note: 'Origin of the survey: internal staff, ISO, third-party vendor, broker, agent, or reinsurer.']
  survey_status varchar [note: 'Current lifecycle status of the survey: scheduled, in progress, completed, cancelled, pending review, or approved.']
  survey_time timestamp [note: 'Precise date and time when the survey began, used for scheduling and audit purposes.']
  survey_type varchar [note: 'Classification of the survey purpose: new business evaluation, renewal inspection, mid-term review, loss control, risk improvement, catastrophe assessment, or special inspection.']
  underwriter_code varchar [note: 'Unique identifier for the underwriter who reviewed and acted on the survey findings.']
  underwriter_name varchar [note: 'Name of the underwriter who reviewed the survey and made the underwriting decision.']
  updated_timestamp timestamp [note: 'Date and time when the survey record was last modified in the system.']
  uw_action varchar [note: 'Underwriting decision resulting from the survey: accept, decline, refer to senior underwriter, conditional acceptance, or request for re-survey.']
  uw_action_reason varchar [note: 'Detailed explanation of the rationale behind the underwriting action decision.']

  Note: 'Underwriting field survey or inspection record for a risk unit. Captures survey date, inspector, findings, recommended improvements, UW action (accept, decline, refer), and survey source (internal, ISO, third-party).'
}

Table riskexposure.mvr_report {
  mvr_report_id varchar [pk, note: 'Unique identifier for the motor vehicle report record.']
  insured_entity_id varchar [note: 'Reference to the driver risk unit for whom this MVR was obtained.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: MVR reports can be associated with specific vehicles the driver operates (especially for commercial auto with driver-vehicle assignments). Valid optional FK.']
  policy_id varchar [note: 'Reference to the policy for which this MVR was pulled.']
  accident_count varchar [note: 'Total number of accidents reported on the MVR within the lookback period.']
  at_fault_accident_count varchar [note: 'Number of accidents where the driver was determined to be at fault.']
  cost_amount decimal(10,2) [note: 'Cost charged by the provider for obtaining the MVR report.']
  cost_currency varchar [note: 'Three-letter ISO 4217 currency code for the MVR cost amount.']
  created_timestamp timestamp [note: 'Timestamp when the MVR report record was first created in the system.']
  dui_count varchar [note: 'Number of DUI or DWI convictions reported on the MVR.']
  expiration_date date [note: 'Date after which the MVR report is considered stale and must be refreshed for underwriting purposes.']
  is_acceptable_for_underwriting boolean [note: 'Indicates whether the MVR results meet underwriting acceptability criteria for policy issuance.']
  license_class varchar [note: 'License class or type indicating vehicle categories the driver is authorized to operate.']
  license_expiration_date date [note: 'Date when the driver license expires.']
  license_issue_date date [note: 'Date when the current driver license was issued.']
  license_number varchar [note: 'Driver license number as reported on the MVR.']
  license_state varchar [note: 'Two-letter state code of the jurisdiction that issued the driver license.']
  license_status varchar [note: 'Current status of the driver license as reported on the MVR.']
  lookback_period_years varchar [note: 'Number of years of driving history included in the MVR report.']
  major_violation_count varchar [note: 'Number of major violations such as DUI, reckless driving, or hit-and-run reported on the MVR.']
  minor_violation_count varchar [note: 'Number of minor violations such as speeding or failure to signal reported on the MVR.']
  mvr_score varchar [note: 'Composite risk score calculated by the MVR provider based on driving history.']
  mvr_tier varchar [note: 'Underwriting tier assignment based on MVR score and driving history.']
  not_at_fault_accident_count varchar [note: 'Number of accidents where the driver was not determined to be at fault.']
  order_date date [note: 'Date when the MVR report was requested from the provider.']
  ordered_by_user_code varchar [note: 'User identifier of the underwriter or system user who ordered the MVR report.']
  provider_name varchar [note: 'Name of the third-party vendor or state agency that supplied the MVR report.']
  received_date date [note: 'Date when the MVR report was received from the provider.']
  rejection_reason varchar [note: 'Reason code or description if the MVR results led to policy declination or driver exclusion.']
  report_date date [note: 'Date as of which the MVR data was compiled by the provider.']
  report_number varchar [note: 'External report number or reference identifier assigned by the MVR provider.']
  report_status varchar [note: 'Current status of the MVR report in the underwriting workflow.']
  report_type varchar [note: 'Type or level of detail of the MVR report obtained.']
  suspension_count varchar [note: 'Number of license suspensions reported on the MVR within the lookback period.']
  underwriter_notes varchar [note: 'Free-text notes entered by the underwriter regarding MVR findings and risk assessment.']
  underwriter_review_required boolean [note: 'Indicates whether the MVR results require manual underwriter review before policy issuance.']
  updated_timestamp timestamp [note: 'Timestamp when the MVR report record was last updated in the system.']
  violation_count varchar [note: 'Total number of moving violations reported on the MVR within the lookback period.']

  Note: 'Motor Vehicle Report obtained for a driver risk unit. Stores pull date, license state, license number, violation count, accident count, MVR score, and source (CLUE Auto / state DMV). Used in personal and commercial auto UW.'
}

Table riskexposure.clue_report {
  clue_report_id varchar [pk, note: 'Unique identifier for the CLUE report record.']
  claim_id varchar [note: 'Foreign key linking to claims.claim. Business justification: CLUE reports are ordered during claim investigation to validate loss history, detect fraud, verify prior losses, and support coverage investigation.']
  insured_entity_id varchar [note: 'Reference to the party (person or organization) for whom the CLUE report was requested.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: CLUE property loss history reports are tied to specific insured locations. Formalizes the relationship and allows removal of redundant address fields (authoritative in']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: CLUE auto loss history reports are tied to specific vehicles. VIN is already captured in clue_report but is authoritative in insured_vehicle. FK formalizes the relationship.']
  policy_id varchar [note: 'Reference to the policy for which this CLUE report was ordered.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: CLUE reports can be associated with specific risk units (e.g., a building risk unit for property CLUE, a vehicle risk unit for auto CLUE).']
  adverse_action_required boolean [note: 'Indicates whether an adverse action notice is required based on CLUE report usage.']
  adverse_action_sent_date date [note: 'Date when the adverse action notice was sent to the applicant.']
  auto_loss_count varchar [note: 'Number of auto-related losses reported in the CLUE report.']
  catastrophe_loss_indicator boolean [note: 'Indicates whether any of the reported losses were catastrophe-related events.']
  clue_score varchar [note: 'Numeric risk score assigned by the CLUE system based on prior loss history.']
  clue_score_tier varchar [note: 'Categorical tier classification of the CLUE score for underwriting decisioning.']
  created_timestamp timestamp [note: 'Timestamp when this CLUE report record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in the report.']
  expiration_date date [note: 'Date when the CLUE report expires and is no longer valid for underwriting decisions.']
  fraud_indicator boolean [note: 'Indicates whether any of the reported losses have fraud flags or suspicions.']
  lookback_period_years varchar [note: 'Number of years of loss history included in the CLUE report.']
  order_date date [note: 'Date when the CLUE report was ordered from the provider.']
  prior_carrier_naic_code varchar [note: 'Five-digit NAIC code identifying the prior insurance carrier.']
  prior_carrier_name varchar [note: 'Name of the most recent prior insurance carrier reported in the CLUE report.']
  prior_policy_effective_date date [note: 'Effective date of the most recent prior policy reported in the CLUE report.']
  prior_policy_expiration_date date [note: 'Expiration date of the most recent prior policy reported in the CLUE report.']
  prior_policy_number varchar [note: 'Policy number from the most recent prior carrier reported in the CLUE report.']
  property_loss_count varchar [note: 'Number of property-related losses reported in the CLUE report.']
  provider_name varchar [note: 'Name of the CLUE report provider (typically ISO/Verisk or LexisNexis).']
  provider_transaction_code varchar [note: 'Unique transaction identifier assigned by the CLUE report provider.']
  received_date date [note: 'Date when the CLUE report was received from the provider.']
  report_cost_amount decimal(10,2) [note: 'Cost charged by the provider for the CLUE report.']
  report_date date [note: 'Date when the CLUE report was generated by the provider.']
  report_number varchar [note: 'Unique report number assigned by the CLUE database provider.']
  report_status varchar [note: 'Current status of the CLUE report in the underwriting workflow.']
  report_type varchar [note: 'Type of CLUE report indicating whether it covers property losses, auto losses, or both.']
  total_incurred_amount decimal(15,2) [note: 'Total incurred loss amount across all prior losses reported in the CLUE report.']
  total_loss_count varchar [note: 'Total number of prior losses reported in the CLUE report.']
  underwriter_notes varchar [note: 'Free-text notes entered by the underwriter regarding the CLUE report findings.']
  underwriter_review_required boolean [note: 'Indicates whether the CLUE report findings require manual underwriter review.']
  updated_timestamp timestamp [note: 'Timestamp when this CLUE report record was last updated in the system.']
  uw_decision varchar [note: 'Underwriting decision made based on the CLUE report findings.']
  uw_decision_date date [note: 'Date when the underwriting decision was made based on the CLUE report.']
  uw_decision_reason varchar [note: 'Reason code or description for the underwriting decision based on CLUE findings.']

  Note: 'Comprehensive Loss Underwriting Exchange (CLUE) property or auto loss history report for an insured entity or vehicle. Captures report date, prior carrier, prior losses, and CLUE score used in UW risk selection.'
}

Table riskexposure.tiv_schedule {
  tiv_schedule_id varchar [pk, note: 'Unique identifier for the TIV schedule item record.']
  insured_location_id varchar [note: 'Reference to the physical location where the scheduled item is situated.']
  policy_id varchar [note: 'Reference to the policy under which this scheduled item is insured.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: TIV schedule line items represent individual risk units (buildings, contents, BI) within a commercial property schedule. Valid FK linking TIV item to its risk unit.']
  actual_cash_value_amount decimal(18,2) [note: 'The replacement cost value minus depreciation, representing the current market value of the item.']
  agreed_value_amount decimal(18,2) [note: 'Pre-agreed valuation amount between insurer and insured, eliminating coinsurance penalties and valuation disputes at claim time.']
  annual_premium_amount decimal(18,2) [note: 'The annual premium charged for coverage of this scheduled item.']
  appraisal_date date [note: 'The date on which the professional appraisal was conducted.']
  appraisal_expiry_date date [note: 'The date after which the appraisal is no longer considered valid and a new appraisal is required.']
  appraisal_value_amount decimal(18,2) [note: 'The value determined by a professional appraiser for this scheduled item, often required for high-value property.']
  appraiser_certification_number varchar [note: 'The professional certification or license number of the appraiser who performed the valuation.']
  appraiser_name varchar [note: 'The name of the professional appraiser or appraisal firm that conducted the valuation.']
  blanket_group_code varchar [note: 'Identifier for a blanket coverage group when this item is covered under a blanket limit rather than a specific limit.']
  coinsurance_percentage decimal(5,2) [note: 'The percentage of value that must be insured to avoid a coinsurance penalty at claim time, typically 80%, 90%, or 100%.']
  construction_type varchar [note: 'The construction classification of the building or structure housing the item, relevant for rating and exposure assessment.']
  created_timestamp timestamp [note: 'The date and time when this TIV schedule record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'The deductible amount applicable to this scheduled item, representing the insured retention before coverage applies.']
  deductible_type varchar [note: 'The structure of the deductible, whether a flat dollar amount, percentage of loss, or franchise deductible.']
  depreciation_amount decimal(18,2) [note: 'The calculated depreciation deducted from replacement cost to arrive at actual cash value.']
  depreciation_basis varchar [note: 'The methodology used to calculate depreciation for this scheduled item.']
  effective_date date [note: 'The date from which coverage for this scheduled item becomes active on the policy.']
  endorsement_number varchar [note: 'The policy endorsement number that added or modified this scheduled item on the policy.']
  expiration_date date [note: 'The date on which coverage for this scheduled item ceases unless renewed or extended.']
  insurance_to_value_ratio decimal(5,4) [note: 'The ratio of sum insured to replacement cost value, indicating adequacy of coverage and potential coinsurance exposure.']
  is_blanket_covered boolean [note: 'Indicates whether this item is covered under a blanket limit that applies to multiple items or locations.']
  iso_class_code varchar [note: 'The ISO classification code used for rating and underwriting this type of scheduled property.']
  item_category varchar [note: 'High-level classification of the scheduled item type for coverage and rating purposes.']
  item_description varchar [note: 'Detailed narrative description of the scheduled item including distinguishing characteristics and identifying features.']
  item_sequence varchar [note: 'Sequential ordering of this item within the schedule for the policy.']
  item_status varchar [note: 'Current lifecycle status of the scheduled item on the policy.']
  item_type varchar [note: 'Specific sub-classification of the item within its category, such as machinery, furniture, or inventory.']
  occupancy_type varchar [note: 'The business use or occupancy classification of the premises where the item is located, affecting risk and rating.']
  protection_class varchar [note: 'The ISO Public Protection Classification indicating fire protection quality at the items location, ranging from 1 best to 10 worst.']
  rate_per_hundred decimal(8,5) [note: 'The insurance rate applied per hundred dollars of sum insured to calculate the premium for this item.']
  removal_date date [note: 'The date on which this item was removed from the schedule, if applicable.']
  removal_reason varchar [note: 'The business reason why this item was removed from the schedule.']
  replacement_cost_value_amount decimal(18,2) [note: 'The cost to replace the item with new property of like kind and quality without deduction for depreciation.']
  schedule_number varchar [note: 'Business identifier for the TIV schedule, typically referenced on policy declarations and endorsements.']
  sum_insured_amount decimal(18,2) [note: 'The total amount of insurance coverage provided for this scheduled item, representing the maximum claim payout.']
  sum_insured_currency varchar [note: 'Three-letter ISO 4217 currency code for the sum insured amount.']
  updated_timestamp timestamp [note: 'The date and time when this TIV schedule record was last modified in the system.']
  valuation_date date [note: 'The date on which the current valuation amounts were determined or last updated.']
  valuation_method varchar [note: 'The basis of valuation applied to determine the insured value of this item for coverage and claims settlement purposes.']

  Note: 'Schedule of Total Insured Values for a commercial property or inland marine risk. Each row represents one scheduled item (building, contents, equipment) with its SI, RCV, ACV, and depreciation basis.'
}

Table riskexposure.wc_payroll_class {
  wc_payroll_class_id varchar [pk, note: 'Unique identifier for the workers compensation payroll classification record.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: WC payroll classifications are for employer entities (insured entities in WC context). Valid FK linking payroll class to the employer entity.']
  policy_id varchar [note: 'Reference to the workers compensation policy under which this payroll class is rated.']
  risk_unit_id varchar [note: 'Reference to the employer risk unit or location to which this payroll classification applies.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Workers compensation class codes and manual rates are state-specific (NCCI or independent bureau rates).']
  audit_type varchar [note: 'Type of premium audit to be conducted for this classification at policy expiration to verify actual payroll exposure.']
  audited_payroll_amount decimal(18,2) [note: 'Actual payroll amount determined through premium audit after policy expiration, used for final premium adjustment.']
  catastrophe_code varchar [note: 'Code identifying if this classification is subject to catastrophe exposure loading for events like earthquakes or hurricanes.']
  class_code varchar [note: 'NCCI or state-specific classification code identifying the type of work performed by employees in this class.']
  class_description varchar [note: 'Full text description of the work activities and operations covered by this classification code.']
  class_status varchar [note: 'Current status of this payroll classification on the policy, indicating whether it is actively rated or has been removed.']
  created_timestamp timestamp [note: 'Date and time when this payroll classification record was first created in the system.']
  effective_date date [note: 'Date when this payroll classification becomes active for rating purposes on the policy.']
  estimated_annual_payroll decimal(18,2) [note: 'Estimated payroll amount provided at policy inception, used for initial premium calculation subject to audit adjustment.']
  executive_officer_payroll decimal(18,2) [note: 'Payroll for executive officers who may be included or excluded from coverage, subject to state-specific rules and election.']
  experience_mod decimal(6,4) [note: 'Experience modification factor applied to the manual rate based on the insureds historical loss experience, where 1.0000 is neutral.']
  expiration_date date [note: 'Date when this payroll classification coverage ends on the policy.']
  exposure_basis varchar [note: 'The unit of measure used to calculate premium for this class, typically payroll but may be sales, units, or area for certain classifications.']
  exposure_units decimal(18,2) [note: 'Number of exposure units for rating, typically payroll divided by 100 for per-hundred rating basis.']
  final_rate decimal(10,4) [note: 'Final rate per hundred dollars of payroll after applying experience mod, schedule rating, and other adjustments to the manual rate.']
  full_time_employee_count varchar [note: 'Number of full-time employees working in this classification during the policy period.']
  governing_class_indicator boolean [note: 'Flag indicating whether this is the governing classification for the policy, used for experience rating and premium allocation.']
  hazard_group varchar [note: 'NCCI hazard group letter A through H indicating the relative risk level of this classification, with A being lowest and H highest.']
  increased_limits_factor decimal(6,4) [note: 'Factor applied when employer liability limits exceed statutory minimums, increasing premium proportionally.']
  loss_cost decimal(10,4) [note: 'Pure premium or loss cost per hundred dollars of payroll published by NCCI, before carrier loss cost multiplier and expense loading.']
  loss_cost_multiplier decimal(6,4) [note: 'Carrier-specific multiplier applied to NCCI loss costs to derive manual rates, covering expenses, profit, and other loadings.']
  manual_premium_amount decimal(18,2) [note: 'Premium calculated by multiplying exposure units by the final rate, before applying policy-level adjustments or minimum premium.']
  manual_rate decimal(10,4) [note: 'Base rate per hundred dollars of payroll or per exposure unit, as published by NCCI or state rating bureau for this class code.']
  modified_timestamp timestamp [note: 'Date and time when this payroll classification record was last updated or modified.']
  naics_code varchar [note: 'Six-digit NAICS code representing the industry classification of the business operations covered by this payroll class.']
  overtime_payroll_amount decimal(18,2) [note: 'Overtime payroll included in total payroll, with special treatment per NCCI rules where only straight-time equivalent may be rated.']
  part_time_employee_count varchar [note: 'Number of part-time employees working in this classification during the policy period.']
  payroll_amount decimal(18,2) [note: 'Total payroll amount in dollars for employees in this classification during the policy period, used as the rating basis.']
  payroll_currency varchar [note: 'Three-letter ISO currency code for the payroll amount, typically USD for US-based policies.']
  premium_basis_type varchar [note: 'Method used to calculate premium for this class, typically per hundred dollars of payroll but may be flat or minimum for certain classes.']
  schedule_credit_debit decimal(6,4) [note: 'Schedule rating adjustment factor applied by underwriter for risk characteristics not reflected in experience mod, expressed as decimal multiplier.']
  sic_code varchar [note: 'Four-digit SIC code representing the industry classification, used for legacy reporting and cross-reference purposes.']
  standard_exception_code varchar [note: 'NCCI code identifying standard exceptions or special rules that apply to this classification for rating or coverage purposes.']
  subcontractor_payroll_amount decimal(18,2) [note: 'Payroll amount for uninsured subcontractors included in this classification, subject to WC premium calculation if certificates not provided.']
  terrorism_rate decimal(10,4) [note: 'Additional rate per hundred dollars of payroll for terrorism coverage under TRIA, if applicable to this classification.']

  Note: 'Master SSOT linking an employer risk unit to an NCCI or state WC classification code with payroll basis, rate, and manual premium.'
}

Table riskexposure.driver_assignment {
  driver_assignment_id varchar [pk, note: 'Unique identifier for the driver assignment record.']
  insured_entity_id varchar [note: 'Reference to the driver (insured entity) being assigned to the vehicle.']
  insured_vehicle_id varchar [note: 'Reference to the insured vehicle being assigned to the driver.']
  policy_id varchar [note: 'Reference to the auto policy under which this driver assignment exists.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Driver assignments link drivers to vehicle risk units. Valid FK formalizing that the assignment is for a specific risk unit (the vehicle as a rated risk).']
  accident_count_3yr varchar [note: 'Number of at-fault accidents reported for this driver in the past three years, impacts rating tier.']
  annual_mileage varchar [note: 'Estimated annual miles driven by this driver in this vehicle, used for exposure rating.']
  assignment_number varchar [note: 'Business identifier for the driver assignment, used for external reference and tracking.']
  assignment_status varchar [note: 'Current lifecycle status of the driver assignment.']
  business_use_indicator boolean [note: 'Flag indicating whether the driver uses this vehicle for business purposes, affecting coverage and rating.']
  commute_distance_miles decimal(8,2) [note: 'One-way commute distance in miles for this driver using this vehicle, impacts rating and classification.']
  commute_frequency varchar [note: 'How often the driver uses this vehicle for commuting purposes.']
  created_timestamp timestamp [note: 'Timestamp when this driver assignment record was first created in the system.']
  driver_designation varchar [note: 'Classification of the driver\'s relationship to the vehicle: principal (primary), occasional (secondary), excluded, permissive, or named.']
  driver_license_expiration_date date [note: 'Date when the driver\'s license expires, monitored for underwriting compliance.']
  driver_license_number varchar [note: 'State-issued driver license number for the assigned driver, used for Motor Vehicle Report (MVR) ordering and validation.']
  driver_license_state varchar [note: 'Two-letter state code where the driver\'s license was issued.']
  driver_license_status varchar [note: 'Current status of the driver\'s license as verified through Motor Vehicle Report (MVR).']
  driver_training_completion_date date [note: 'Date when the driver completed the approved training course.']
  driver_training_completion_indicator boolean [note: 'Flag indicating whether the driver has completed an approved defensive driving or driver training course, may qualify for discount.']
  dui_indicator boolean [note: 'Flag indicating whether the driver has a DUI or DWI conviction on record, critical for underwriting decisions.']
  effective_date date [note: 'Date when this driver assignment becomes effective on the policy.']
  endorsement_number varchar [note: 'Policy endorsement number that added, modified, or removed this driver assignment.']
  expiration_date date [note: 'Date when this driver assignment expires or is scheduled to end.']
  good_student_discount_indicator boolean [note: 'Flag indicating whether the driver qualifies for good student discount based on academic performance.']
  last_modified_timestamp timestamp [note: 'Timestamp when this driver assignment record was last updated.']
  mvr_order_date date [note: 'Date when the most recent Motor Vehicle Report was ordered for this driver assignment.']
  mvr_score varchar [note: 'Numerical score derived from the driver\'s Motor Vehicle Report, used in underwriting and rating decisions.']
  rating_tier varchar [note: 'Underwriting tier assigned to this driver assignment based on risk profile, directly impacts premium calculation.']
  termination_date date [note: 'Actual date when this driver assignment was terminated before the scheduled expiration.']
  termination_reason varchar [note: 'Business reason for early termination of the driver assignment, such as driver removed, vehicle sold, or policy cancelled.']
  territory_code varchar [note: 'Geographic rating territory code where the vehicle is principally garaged by this driver, used for rate lookup.']
  underwriter_notes varchar [note: 'Free-text notes from underwriter regarding special considerations, exceptions, or conditions for this driver assignment.']
  usage_percentage decimal(5,2) [note: 'Percentage of time this driver operates the assigned vehicle, used for rating and premium calculation. Range 0.00 to 100.00.']
  violation_count_3yr varchar [note: 'Number of moving violations reported for this driver in the past three years, impacts rating tier.']

  Note: 'Junction table assigning a driver (insured entity) to an insured vehicle on a policy. Captures principal vs. occasional driver designation, assignment effective date, and usage percentage. Supports auto rating and UW.'
}

Table riskexposure.risk_score {
  risk_score_id varchar [pk, note: 'Unique identifier for the underwriting risk score record.']
  insured_entity_id varchar [note: 'Reference to the insured entity being scored, if entity-specific.']
  insured_location_id varchar [note: 'Reference to the insured location being scored, if location-specific.']
  insured_vehicle_id varchar [note: 'Reference to the insured vehicle being scored, if vehicle-specific.']
  policy_id varchar [note: 'Reference to the policy for which this risk score was generated.']
  policy_transaction_id varchar [note: 'Unique transaction identifier provided by the vendor for the score request.']
  quote_id varchar [note: 'Reference to the quote for which this risk score was pulled during the quoting process.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Risk scores can be assigned to risk units (e.g., ISO FireLine score for a building risk unit). Valid FK linking the score to the rated risk unit.']
  scheduled_equipment_id varchar [note: 'Foreign key linking to riskexposure.scheduled_equipment. Business justification: Risk scores can be assigned to scheduled equipment (e.g., breakdown risk score for machinery). Valid FK linking the score to the rated equipment.']
  scheduled_item_id varchar [note: 'Foreign key linking to riskexposure.scheduled_item. Business justification: Risk scores can be assigned to scheduled items (e.g., theft risk score for jewelry). Valid FK linking the score to the rated item.']
  adverse_action_required boolean [note: 'Indicates whether an adverse action notice is required based on the score result per FCRA regulations.']
  cat_zone varchar [note: 'Catastrophe zone designation relevant to the risk score, such as hurricane or earthquake zone.']
  coverage_type varchar [note: 'Specific coverage type or peril for which the risk score was generated.']
  created_timestamp timestamp [note: 'Timestamp when the risk score record was first created in the system.']
  data_source_count varchar [note: 'Number of data sources used by the vendor to calculate the risk score.']
  error_code varchar [note: 'Vendor error code returned if the score request failed or encountered issues.']
  error_message varchar [note: 'Detailed error message explaining why the score request failed or returned incomplete data.']
  lob_code varchar [note: 'Insurance line of business code for which the risk score applies.']
  model_effective_date date [note: 'Date when the scoring model version became effective for use in underwriting.']
  model_name varchar [note: 'Specific name or identifier of the scoring model used by the vendor.']
  model_vendor varchar [note: 'Name of the third-party vendor that provided the risk scoring model. [ENUM-REF-CANDIDATE: ISO|Verisk|LexisNexis|CoreLogic|TransUnion|Experian|Equifax|Other — 8 candidates stripped; promote to reference product]']
  model_version varchar [note: 'Version number or release identifier of the scoring model used to generate the score.']
  override_flag boolean [note: 'Indicates whether the risk score was manually overridden by an underwriter.']
  override_reason varchar [note: 'Explanation provided by the underwriter for overriding the vendor-provided risk score.']
  override_timestamp timestamp [note: 'Timestamp when the risk score override was performed.']
  override_user_code varchar [note: 'User identifier of the underwriter who performed the score override.']
  rate_modifier decimal(7,4) [note: 'Premium rate adjustment factor derived from the risk score for pricing purposes.']
  request_reference_number varchar [note: 'Internal reference number assigned to the score request for tracking and audit purposes.']
  score_confidence_level varchar [note: 'Vendor-provided confidence level indicating the reliability of the score based on data completeness.']
  score_cost_amount decimal(10,2) [note: 'Cost charged by the vendor for pulling this risk score.']
  score_cost_currency varchar [note: 'Currency code for the score cost amount.']
  score_expiration_date date [note: 'Date when the risk score is no longer considered valid and must be refreshed.']
  score_percentile decimal(5,2) [note: 'Percentile rank of the score within the scoring model population, expressed as a percentage.']
  score_pull_date date [note: 'Date when the risk score was retrieved from the third-party vendor system.']
  score_pull_timestamp timestamp [note: 'Precise timestamp when the risk score was retrieved from the vendor API or batch feed.']
  score_reason_code varchar [note: 'Primary reason code explaining the key factors that influenced the risk score value.']
  score_reason_description varchar [note: 'Human-readable explanation of the primary factors that influenced the risk score.']
  score_status varchar [note: 'Current lifecycle status of the risk score record.']
  score_tier varchar [note: 'Categorical tier or band assigned to the score value for underwriting decisioning.']
  score_type varchar [note: 'Category of risk score indicating the domain or peril being assessed.']
  score_value decimal(10,4) [note: 'Numeric risk score value returned by the third-party scoring model.']
  territory_code varchar [note: 'Geographic territory code associated with the risk unit being scored.']
  updated_timestamp timestamp [note: 'Timestamp when the risk score record was last modified.']
  uw_action_code varchar [note: 'Recommended underwriting action based on the risk score result.']

  Note: 'Underwriting risk score record for a risk unit derived from third-party models (ISO FireLine, Verisk Wildfire, LexisNexis, credit-based insurance score). Stores score value, model version, pull date, and score tier.'
}

Table riskexposure.pml_estimate {
  pml_estimate_id varchar [pk, note: 'Unique identifier for the PML estimate record.']
  insured_location_id varchar [note: 'Reference to the insured location being assessed for probable maximum loss.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Probable maximum loss estimates are calculated per line of business for reinsurance treaty structuring (property cat XOL), capital modeling (RBC CAT charge), and risk appetite monitoring.']
  policy_id varchar [note: 'Reference to the policy under which this PML estimate is calculated.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: PML estimates are calculated for risk units (buildings, locations, portfolios). Valid FK linking the PML estimate to the specific risk unit being modeled.']
  superseded_by_estimate_pml_estimate_id varchar [note: 'Reference to the newer PML estimate that supersedes this one, if applicable.']
  annual_aggregate_deductible_amount decimal(18,2) [note: 'Annual aggregate deductible applied in the PML calculation for the policy or location.']
  approved_by varchar [note: 'Name or identifier of the underwriter or actuary who approved this PML estimate.']
  approved_date date [note: 'Date when this PML estimate was formally approved for use in underwriting decisions.']
  cat_zone_code varchar [note: 'Catastrophe zone code assigned to the location for rating and exposure management.']
  confidence_level_percentage decimal(5,2) [note: 'Statistical confidence level associated with the PML estimate, typically 90% or 95%.']
  construction_type varchar [note: 'Construction type of the insured building used in the catastrophe model.']
  created_timestamp timestamp [note: 'Timestamp when this PML estimate record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this estimate.']
  effective_date date [note: 'Date from which this PML estimate is effective for underwriting and risk management decisions.']
  estimate_number varchar [note: 'Business identifier for the PML estimate used for tracking and reporting purposes.']
  estimate_status varchar [note: 'Current lifecycle status of the PML estimate in the review and approval workflow.']
  exceedance_probability decimal(8,6) [note: 'Probability that the actual loss will exceed the estimated PML amount.']
  expiration_date date [note: 'Date when this PML estimate expires and should be refreshed or superseded.']
  gross_pml_amount decimal(18,2) [note: 'Estimated probable maximum loss amount before reinsurance recoveries.']
  last_modified_timestamp timestamp [note: 'Timestamp when this PML estimate record was last updated or modified.']
  model_run_code varchar [note: 'Unique identifier for the specific model execution batch that produced this estimate.']
  model_run_date date [note: 'Date when the catastrophe model was executed to produce this PML estimate.']
  model_vendor varchar [note: 'Vendor or provider of the catastrophe model used to generate the PML estimate.']
  model_version varchar [note: 'Version identifier of the catastrophe model used for the PML calculation.']
  net_pml_amount decimal(18,2) [note: 'Estimated probable maximum loss amount after reinsurance recoveries and risk transfer.']
  number_of_stories varchar [note: 'Number of stories in the insured building, used as a factor in the PML calculation.']
  occupancy_type varchar [note: 'Type of occupancy for the insured location used in the catastrophe model.']
  per_occurrence_limit_amount decimal(18,2) [note: 'Maximum limit per occurrence applied in the PML calculation.']
  peril_type varchar [note: 'Type of catastrophic peril for which the probable maximum loss is being estimated.']
  pml_percentage decimal(5,2) [note: 'PML expressed as a percentage of total insured value for the location or portfolio.']
  reinsurance_structure_applied varchar [note: 'Type of reinsurance structure applied when calculating net PML from gross PML.']
  review_notes varchar [note: 'Free-text notes from the underwriter or actuary reviewing the PML estimate.']
  scenario_description varchar [note: 'Detailed description of the catastrophe scenario modeled, including magnitude and geographic scope.']
  scenario_return_period_years varchar [note: 'Return period in years for the catastrophe scenario, typically 100, 250, or 500 years.']
  territory_code varchar [note: 'Rating territory code for the location used in the PML assessment.']
  tiv decimal(18,2) [note: 'Total insured value of the property or portfolio used as the basis for PML calculation.']
  year_built varchar [note: 'Year the insured building was constructed, used as a factor in the PML calculation.']

  Note: 'Probable Maximum Loss estimate for a property or CAT-exposed risk unit. Stores PML percentage, scenario (1-in-100, 1-in-250), peril, model vendor (AIR, RMS, CoreLogic), run date, and gross vs. net of reinsurance values.'
}

Table riskexposure.flood_zone_assignment {
  flood_zone_assignment_id varchar [pk, note: 'Unique identifier for the flood zone assignment record.']
  cat_zone_id varchar [note: 'Foreign key linking to riskexposure.cat_zone. Business justification: Flood zone assignments reference the broader catastrophe zone master. Links FEMA-specific flood data to the enterprise cat zone reference.']
  insured_location_id varchar [note: 'Reference to the insured location for which the flood zone is assigned.']
  policy_id varchar [note: 'Reference to the policy associated with this flood zone assignment.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Flood zone determinations require state-level NFIP participation status tracking, state-specific mandatory purchase requirements, and state regulatory oversight of flood insurance placement.']
  assignment_status varchar [note: 'Current lifecycle status of the flood zone assignment record.']
  base_flood_elevation_ft decimal(10,2) [note: 'Elevation in feet above sea level at which there is a one percent chance of flooding in any given year.']
  cbrs_unit_code varchar [note: 'Identifier for the specific CBRS unit if the location falls within a designated coastal barrier area.']
  coastal_barrier_system_indicator boolean [note: 'Flag indicating whether the location is within a Coastal Barrier Resources System area where federal flood insurance is restricted.']
  comments varchar [note: 'Additional notes or remarks regarding the flood zone assignment, determination process, or special circumstances.']
  created_timestamp timestamp [note: 'Date and time when the flood zone assignment record was first created in the system.']
  determination_date date [note: 'Date when the flood zone determination was performed for the insured location.']
  determination_method varchar [note: 'Method used to determine the flood zone classification for the location.']
  determination_number varchar [note: 'Unique tracking number issued by the flood determination service provider for this assessment.']
  determination_provider varchar [note: 'Name of the third-party vendor or service that performed the flood zone determination.']
  effective_date date [note: 'Date when this flood zone assignment became effective for underwriting and rating purposes.']
  elevation_certificate_available boolean [note: 'Flag indicating whether a FEMA Elevation Certificate has been obtained for the insured structure.']
  elevation_certificate_date date [note: 'Date when the Elevation Certificate was completed by a licensed surveyor or engineer.']
  elevation_difference_ft decimal(10,2) [note: 'Difference between the lowest floor elevation and the base flood elevation, used for rating purposes.']
  expiration_date date [note: 'Date when this flood zone assignment expires or is superseded by a new determination.']
  firm_panel_effective_date date [note: 'Date when the current FIRM panel became effective for the location.']
  firm_panel_number varchar [note: 'Unique identifier for the FEMA Flood Insurance Rate Map panel covering the insured location.']
  firm_panel_revision_date date [note: 'Most recent date when the FIRM panel was revised or updated by FEMA.']
  flood_zone_rating_factor decimal(8,4) [note: 'Numerical factor applied to premium calculation based on the flood zone classification and risk level.']
  grandfathering_eligible_indicator boolean [note: 'Flag indicating whether the property is eligible for grandfathered flood insurance rates due to map changes.']
  last_modified_timestamp timestamp [note: 'Date and time when the flood zone assignment record was most recently updated.']
  lender_name varchar [note: 'Name of the mortgage lender requiring flood zone determination for loan compliance purposes.']
  loan_number varchar [note: 'Mortgage loan number associated with the flood zone determination requirement.']
  loma_lomr_case_number varchar [note: 'FEMA case number for the LOMA or LOMR if one has been issued for this location.']
  loma_lomr_effective_date date [note: 'Date when the LOMA or LOMR became effective, modifying the flood zone designation.']
  loma_lomr_indicator boolean [note: 'Flag indicating whether a LOMA or LOMR has been issued by FEMA for this location, potentially changing the flood zone designation.']
  lowest_floor_elevation_ft decimal(10,2) [note: 'Elevation of the lowest floor of the insured structure in feet above sea level.']
  mandatory_purchase_indicator boolean [note: 'Flag indicating whether federal flood insurance purchase is mandatory for mortgage compliance at this location.']
  modified_by_user varchar [note: 'Username or identifier of the system user who last modified the flood zone assignment record.']
  nfip_community_code varchar [note: 'Six-digit identifier assigned by FEMA to the participating NFIP community where the property is located.']
  nfip_community_name varchar [note: 'Name of the NFIP participating community jurisdiction covering the insured location.']
  nfip_participation_status varchar [note: 'Current participation status of the community in the NFIP, affecting insurance availability and requirements.']
  preferred_risk_policy_eligible boolean [note: 'Flag indicating whether the location qualifies for NFIP Preferred Risk Policy lower-cost coverage.']
  redetermination_required_date date [note: 'Date by which a new flood zone determination must be obtained to maintain compliance.']
  sfha_indicator boolean [note: 'Flag indicating whether the location is within a Special Flood Hazard Area subject to mandatory flood insurance purchase requirements.']
  surveyor_license_number varchar [note: 'Professional license number of the surveyor or engineer who completed the Elevation Certificate.']
  surveyor_name varchar [note: 'Name of the licensed surveyor or engineer who completed the Elevation Certificate.']

  Note: 'FEMA/NFIP flood zone designation assigned to an insured location. Stores flood zone code, BFE (Base Flood Elevation), FIRM panel number, determination date, and mandatory purchase indicator for mortgage compliance.'
}

Table riskexposure.gl_operation {
  gl_operation_id varchar [pk, note: 'Unique identifier for the general liability operation record.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: GL operations are business activities conducted by insured entities (commercial insureds). Valid FK linking the operation to the entity conducting it.']
  insured_location_id varchar [note: 'Reference to the physical location where this GL operation is conducted.']
  policy_id varchar [note: 'Reference to the commercial policy under which this GL operation is insured.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: GL operations are themselves risk units in the GL rating structure. Valid FK linking the operation to its parent risk unit record.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: General liability operations are rated by state territory for ISO GL class code application, state-specific tort law exposure assessment, and regulatory compliance.']
  added_date date [note: 'Date on which this operation was added to the policy, which may differ from effective date for mid-term endorsements.']
  annual_payroll_amount decimal(18,2) [note: 'Total annual payroll for employees engaged in this operation, used as rating exposure basis for certain class codes.']
  annual_premium_amount decimal(18,2) [note: 'Total annual premium charged for GL coverage on this operation, calculated from exposure and rate.']
  annual_receipts_amount decimal(18,2) [note: 'Total gross receipts or sales revenue generated by this operation during the policy term, used as rating exposure basis.']
  area_sqft decimal(12,2) [note: 'Total square footage of premises or operational area, used as rating exposure basis for area-rated classes.']
  created_timestamp timestamp [note: 'Date and time when this GL operation record was first created in the source system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this operation record.']
  effective_date date [note: 'Date on which this GL operation became active and coverage commenced.']
  endorsement_number varchar [note: 'Policy endorsement number under which this operation was added, modified, or removed.']
  expiration_date date [note: 'Date on which coverage for this GL operation expires or is scheduled to terminate.']
  exposure_basis varchar [note: 'The rating basis used to calculate premium for this operation: area, payroll, gross receipts, units sold, or other measure.']
  hazard_grade varchar [note: 'Underwriting assessment of the relative hazard or risk level of this operation: low, moderate, high, or severe.']
  iso_gl_class_code varchar [note: 'ISO standard classification code identifying the type of business operation for rating and underwriting purposes.']
  iso_gl_class_description varchar [note: 'Full text description of the ISO GL class code as published in the ISO rating manual.']
  last_modified_timestamp timestamp [note: 'Date and time when this GL operation record was most recently updated in the source system.']
  naics_code varchar [note: 'Six-digit NAICS code classifying the primary industry sector of the operation.']
  number_of_employees varchar [note: 'Total count of full-time equivalent employees engaged in this operation during the policy term.']
  number_of_units varchar [note: 'Count of discrete units produced, sold, or serviced by this operation, used as rating exposure basis for unit-rated classes.']
  operation_description varchar [note: 'Detailed narrative describing the nature, scope, and activities of the insured business operation.']
  operation_name varchar [note: 'Short descriptive name or title of the business operation being insured.']
  operation_number varchar [note: 'Business-assigned sequential or coded identifier for this operation within the policy.']
  operation_status varchar [note: 'Current lifecycle status of the GL operation record within the policy term.']
  operation_type varchar [note: 'Category of GL exposure this operation represents: premises operations, products liability, completed operations, or other.']
  premises_operations_split_pct decimal(5,2) [note: 'Percentage of total receipts or exposure allocated to premises and ongoing operations hazard.']
  products_completed_ops_split_pct decimal(5,2) [note: 'Percentage of total receipts or exposure allocated to products and completed operations hazard, as opposed to premises operations.']
  rate_per_exposure_unit decimal(10,6) [note: 'The manual rate applied per unit of exposure (per hundred of payroll, per thousand of receipts, per square foot) for this operation.']
  removal_reason varchar [note: 'Reason code explaining why this operation was removed from coverage before expiration.']
  removed_date date [note: 'Date on which this operation was removed from the policy prior to natural expiration.']
  sic_code varchar [note: 'Four-digit SIC code classifying the business activity for regulatory and statistical purposes.']
  subcontractor_receipts_amount decimal(18,2) [note: 'Total payments made to uninsured subcontractors for work performed under this operation, subject to additional premium.']
  subcontractor_work_indicator boolean [note: 'Flag indicating whether this operation involves the use of subcontractors or independent contractors.']
  territory_code varchar [note: 'ISO or carrier-specific geographic territory code used for rating this operation.']
  underwriting_notes varchar [note: 'Free-text underwriting comments, special conditions, or risk assessment notes related to this operation.']

  Note: 'General Liability operations record describing the business activities of a commercial insured risk unit. Stores ISO GL class code, operation description, receipts, area, payroll, and products-completed operations split.'
}

Table riskexposure.scheduled_equipment {
  scheduled_equipment_id varchar [pk, note: 'Unique identifier for the scheduled equipment item record.']
  insured_location_id varchar [note: 'Reference to the insured location where the equipment is primarily situated or garaged.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Scheduled equipment can be attached to vehicles (e.g., specialized equipment on commercial trucks, mobile equipment).']
  policy_coverage_id varchar [note: 'Reference to the specific coverage part or endorsement under which this equipment is insured.']
  policy_id varchar [note: 'Reference to the policy under which this equipment is scheduled.']
  acv_amount decimal(18,2) [note: 'Actual cash value of the equipment reflecting depreciation and wear, used for claims settlement.']
  added_date date [note: 'Date on which this equipment item was added to the policy schedule.']
  agreed_value_amount decimal(18,2) [note: 'Mutually agreed upon value between insured and insurer for the equipment, binding for claims settlement.']
  annual_premium_amount decimal(18,2) [note: 'Annual premium charged for insuring this specific equipment item.']
  appraisal_date date [note: 'Date on which the equipment appraisal was conducted.']
  appraisal_value_amount decimal(18,2) [note: 'Professionally appraised value of the equipment as determined by a certified appraiser.']
  appraiser_name varchar [note: 'Name of the certified appraiser or appraisal firm that valued the equipment.']
  blanket_group_code varchar [note: 'Code identifying the blanket coverage group to which this equipment belongs if applicable.']
  coverage_type varchar [note: 'Designation indicating whether the equipment is covered under blanket, specific, or scheduled coverage.']
  created_timestamp timestamp [note: 'System timestamp when this scheduled equipment record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts associated with this equipment item.']
  deductible_amount decimal(18,2) [note: 'Deductible amount applicable to this specific equipment item for claims.']
  effective_date date [note: 'Date on which coverage for this scheduled equipment item becomes effective.']
  endorsement_number varchar [note: 'Policy endorsement number under which this equipment item was added, modified, or removed.']
  equipment_category varchar [note: 'Broader grouping or line of business category for the equipment such as inland marine or equipment floater.']
  equipment_description varchar [note: 'Detailed narrative description of the equipment including distinguishing features and characteristics.']
  equipment_name varchar [note: 'Business-friendly name or title of the scheduled equipment item.']
  equipment_status varchar [note: 'Current lifecycle status of the scheduled equipment item on the policy.']
  equipment_type varchar [note: 'Classification of the equipment by functional category for rating and underwriting purposes.']
  expiration_date date [note: 'Date on which coverage for this scheduled equipment item expires or terminates.']
  is_away_from_premises boolean [note: 'Indicator whether the equipment is covered while away from the primary insured premises.']
  is_blanket_covered boolean [note: 'Indicator whether this equipment is included under a blanket coverage limit rather than individually scheduled.']
  iso_class_code varchar [note: 'ISO classification code for the equipment type used for rating and statistical reporting.']
  item_number varchar [note: 'Sequential or business-assigned number identifying this equipment item within the policy schedule.']
  last_modified_timestamp timestamp [note: 'System timestamp when this scheduled equipment record was last updated or modified.']
  lob_code varchar [note: 'Line of business code classifying the equipment coverage such as inland marine or commercial property.']
  location_description varchar [note: 'Narrative description of where the equipment is normally kept or garaged.']
  make varchar [note: 'Manufacturer or brand name of the equipment.']
  model varchar [note: 'Specific model designation or number assigned by the manufacturer.']
  purchase_date date [note: 'Date on which the insured purchased or acquired the equipment.']
  purchase_price_amount decimal(18,2) [note: 'Original purchase price paid by the insured for the equipment.']
  rate_per_hundred decimal(10,4) [note: 'Rating factor expressed as premium per hundred dollars of insured value for this equipment.']
  rcv_amount decimal(18,2) [note: 'Replacement cost value representing the cost to replace the equipment with new property of like kind and quality.']
  removal_date date [note: 'Date on which this equipment item was removed from the policy schedule.']
  removal_reason varchar [note: 'Business reason code explaining why the equipment was removed from coverage.']
  serial_number varchar [note: 'Manufacturer-assigned serial number uniquely identifying the physical equipment unit.']
  storage_type varchar [note: 'Classification of how and where the equipment is stored when not in use.']
  territory_code varchar [note: 'Geographic rating territory code applicable to the equipment location for premium calculation.']
  valuation_basis varchar [note: 'Method used to determine the insured value of the equipment for coverage and claims purposes.']
  year_manufactured varchar [note: 'Calendar year in which the equipment was manufactured or built.']

  Note: 'Scheduled inland marine or equipment floater item record. Captures equipment type, serial number, year, ACV, RCV, location, and blanket vs. specific coverage designation. Used for CPP and BOP equipment scheduling.'
}

Table riskexposure.experience_mod {
  experience_mod_id varchar [pk, note: 'Unique identifier for the experience modification record.']
  insured_entity_id varchar [note: 'Reference to the insured entity for which the experience modification was calculated.']
  policy_id varchar [note: 'Reference to the policy to which this experience modification applies.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Experience modification factors apply to specific risk units (typically WC employer risk units). Valid FK linking the e-mod to the rated risk unit.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Experience modification factors are calculated by state rating bureau (NCCI or independent) with state-specific loss development and credibility rules.']
  superseded_by_mod_id varchar [note: 'Reference to the experience modification record that supersedes this one, used to track modification history.']
  actual_loss_amount decimal(15,2) [note: 'Actual incurred loss amount for the insured during the rating period, used as the numerator in the EMod calculation.']
  appeal_date date [note: 'Date on which the insured filed an appeal to contest the experience modification.']
  appeal_resolution_date date [note: 'Date on which the appeal was resolved by the rating bureau.']
  appeal_status varchar [note: 'Status of any appeal filed by the insured to contest the experience modification calculation.']
  ballast_value decimal(15,2) [note: 'Ballast or credibility factor applied in the experience modification calculation to stabilize the mod for smaller insureds.']
  bureau_code varchar [note: 'Code identifying the rating bureau that issued the experience modification, such as NCCI or a state-specific bureau.']
  bureau_name varchar [note: 'Name of the rating bureau that issued the experience modification.']
  calculation_date date [note: 'Date on which the experience modification was calculated by the rating bureau.']
  claim_count varchar [note: 'Total number of claims included in the experience period used to calculate the modification factor.']
  class_code varchar [note: 'Primary classification code for the insured, linking to NCCI or ISO class code tables for rating purposes.']
  created_timestamp timestamp [note: 'Timestamp when the experience modification record was first created in the system.']
  credibility_factor decimal(5,4) [note: 'Statistical credibility factor applied to the experience modification, reflecting the reliability of the insureds loss history.']
  effective_date date [note: 'Date on which the experience modification becomes effective for rating purposes.']
  excess_loss_component decimal(15,2) [note: 'Dollar amount of excess losses used in the experience modification calculation, representing losses above the primary threshold.']
  expected_excess_loss_amount decimal(15,2) [note: 'Expected excess loss amount used in the experience modification formula.']
  expected_loss_amount decimal(15,2) [note: 'Expected loss amount for the insured based on industry averages and exposure, used as the denominator in the EMod calculation.']
  expected_primary_loss_amount decimal(15,2) [note: 'Expected primary loss amount used in the experience modification formula.']
  expiration_date date [note: 'Date on which the experience modification expires and is no longer applicable for rating.']
  indemnity_claim_count varchar [note: 'Number of indemnity claims included in the experience period, representing claims with wage replacement payments.']
  interstate_mod_indicator boolean [note: 'Indicates whether the experience modification applies across multiple states or is state-specific.']
  issued_date date [note: 'Date on which the experience modification worksheet was issued to the insured or agent.']
  medical_only_claim_count varchar [note: 'Number of medical-only claims included in the experience period, representing claims with no indemnity payments.']
  mod_change_reason varchar [note: 'Reason for change in the experience modification value compared to the prior period, such as improved loss experience or increased claims.']
  mod_number varchar [note: 'Business identifier for the experience modification record, typically assigned by the rating bureau.']
  mod_status varchar [note: 'Current lifecycle status of the experience modification record.']
  mod_type varchar [note: 'Type of experience modification, indicating the line of business or adjustment category.']
  mod_value decimal(5,2) [note: 'The calculated experience modification factor applied to the base premium. A value of 1.00 is neutral; below 1.00 is a credit; above 1.00 is a debit.']
  naics_code varchar [note: 'NAICS code representing the primary business activity of the insured, used for industry classification and benchmarking.']
  notes varchar [note: 'Free-text notes regarding the experience modification, including underwriter comments, special circumstances, or bureau explanations.']
  payroll_amount decimal(15,2) [note: 'Total payroll amount for the rating period, used as the exposure base for workers compensation experience rating.']
  primary_loss_component decimal(15,2) [note: 'Dollar amount of primary losses used in the experience modification calculation, typically capped per occurrence.']
  prior_mod_value decimal(5,2) [note: 'Experience modification value from the immediately preceding rating period, used for trend analysis and comparison.']
  rating_period_end_date date [note: 'End date of the experience period used to calculate the modification factor.']
  rating_period_start_date date [note: 'Start date of the experience period used to calculate the modification factor.']
  revised_mod_value decimal(5,2) [note: 'Revised experience modification value resulting from a successful appeal or correction.']
  sic_code varchar [note: 'SIC code representing the primary business activity of the insured, used for legacy industry classification.']
  updated_timestamp timestamp [note: 'Timestamp when the experience modification record was last updated in the system.']
  worksheet_number varchar [note: 'Unique identifier for the experience rating worksheet provided by the rating bureau, used for audit and reference.']

  Note: 'Experience modification factor (EMod) record for a WC or GL insured, including WC payroll classification linkage. Stores NCCI or state bureau EMod value, effective date, interstate designation, primary and excess loss components, and history.'
}

Table riskexposure.sir_retention {
  sir_retention_id varchar [pk, note: 'Unique identifier for the self-insured retention record.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: SIR/large deductible programs are established for specific insured entities (commercial insureds). Valid FK linking the retention program to the entity.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: SIR programs can be location-specific (e.g., per-location retention in a multi-location property program). Valid optional FK for location-level retentions.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Self-insured retention programs are LOB-specific structures (GL SIR, WC deductible programs) with line-specific regulatory approval requirements, collateral rules, and claims handling']
  policy_coverage_id varchar [note: 'Reference to the coverage part to which this SIR retention applies.']
  policy_id varchar [note: 'Reference to the policy under which this SIR retention applies.']
  risk_unit_id varchar [note: 'Reference to the specific risk unit subject to this SIR retention.']
  administrator_contact_name varchar [note: 'Primary contact person at the program administrator organization.']
  administrator_email varchar [note: 'Email address of the program administrator primary contact.']
  administrator_name varchar [note: 'Name of the third-party administrator managing claims and loss fund for the SIR program.']
  administrator_phone varchar [note: 'Phone number of the program administrator primary contact.']
  aggregate_limit_amount decimal(18,2) [note: 'Maximum total amount the insured retains across all claims during the policy period.']
  cancellation_date date [note: 'Date on which the SIR retention program was cancelled prior to expiration.']
  cancellation_reason varchar [note: 'Reason for cancellation of the SIR retention program.']
  claims_handling_arrangement varchar [note: 'Arrangement defining who handles claims within the SIR layer.']
  collateral_amount decimal(18,2) [note: 'Total value of collateral posted to secure the SIR retention obligation.']
  collateral_expiration_date date [note: 'Date on which the collateral instrument expires and must be renewed or replaced.']
  collateral_provider_name varchar [note: 'Name of the financial institution or entity providing the collateral instrument.']
  collateral_type varchar [note: 'Type of collateral provided by the insured to secure the SIR obligation.']
  created_timestamp timestamp [note: 'Timestamp when this SIR retention record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this SIR retention record.']
  effective_date date [note: 'Date on which the SIR retention program becomes effective.']
  expiration_date date [note: 'Date on which the SIR retention program expires or terminates.']
  last_modified_timestamp timestamp [note: 'Timestamp when this SIR retention record was last updated.']
  loss_control_services_included boolean [note: 'Indicates whether loss control and risk management services are included in the SIR program.']
  loss_fund_amount decimal(18,2) [note: 'Amount of funds set aside or reserved by the insured to cover losses within the SIR layer.']
  notes varchar [note: 'Free-form notes and comments regarding the SIR retention program.']
  peril_code varchar [note: 'Code identifying the specific peril or coverage type subject to this SIR retention.']
  prior_program_number varchar [note: 'Program number of the prior SIR retention program if this is a renewal.']
  program_name varchar [note: 'Descriptive name of the SIR or large deductible program.']
  program_number varchar [note: 'Business identifier for the SIR or large deductible program.']
  program_status varchar [note: 'Current lifecycle status of the SIR retention program.']
  program_type varchar [note: 'Type of self-insured retention program.']
  regulatory_approval_date date [note: 'Date on which regulatory approval was granted for this SIR retention program.']
  regulatory_approval_required boolean [note: 'Indicates whether state insurance department approval is required for this SIR program.']
  regulatory_filing_number varchar [note: 'Filing number assigned by the state insurance department for this SIR program.']
  renewal_indicator boolean [note: 'Indicates whether this SIR retention is a renewal of a prior program.']
  retention_basis varchar [note: 'Basis on which the SIR retention amount applies.']
  sir_amount decimal(18,2) [note: 'Per-occurrence or per-claim SIR amount the insured retains before insurance coverage applies.']
  underwriter_approval_date date [note: 'Date on which the underwriter approved this SIR retention program.']
  underwriter_name varchar [note: 'Name of the underwriter who approved this SIR retention program.']

  Note: 'Self-Insured Retention or large deductible program record for a commercial risk. Stores SIR amount, aggregate limit, collateral type, collateral amount, loss fund, and program administrator. Links to the risk unit and policy.'
}

Table riskexposure.risk_change_event {
  risk_change_event_id varchar [pk, note: 'Unique identifier for the risk change event record.']
  insured_location_id varchar [note: 'Identifier of the insured location affected by this change, if applicable.']
  insured_vehicle_id varchar [note: 'Identifier of the insured vehicle affected by this change, if applicable.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Risk change events (endorsements, mid-term adjustments) must be tracked by LOB for earned premium recalculation, exposure reporting, and reinsurance premium adjustment.']
  policy_id varchar [note: 'Identifier of the policy under which the risk change occurred.']
  policy_transaction_id varchar [note: 'Transaction identifier from the source system for traceability.']
  producers_producer_id varchar [note: 'Identifier of the producer or agent who requested the risk change.']
  reversed_event_id varchar [note: 'Identifier of the original risk change event that this event reverses.']
  risk_unit_id varchar [note: 'Identifier of the risk unit affected by this change event.']
  scheduled_item_id varchar [note: 'Identifier of the scheduled item affected by this change, if applicable.']
  approved_date date [note: 'Date when the risk change was approved by underwriting.']
  change_reason_code varchar [note: 'Code indicating the business reason for the risk change.']
  change_reason_description varchar [note: 'Detailed description of the reason for the risk change.']
  change_status varchar [note: 'Current status of the risk change event in the workflow.']
  change_type varchar [note: 'Type of change applied to the risk unit: addition, removal, replacement, modification, upgrade, or downgrade.']
  changed_attribute_name varchar [note: 'Name of the specific risk attribute that was changed.']
  class_code varchar [note: 'ISO or NCCI class code applicable to the changed risk.']
  created_by_user varchar [note: 'User ID or name of the person who created this risk change event record.']
  created_timestamp timestamp [note: 'Timestamp when this risk change event record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts.']
  effective_date date [note: 'Date when the risk change becomes effective on the policy.']
  endorsement_number varchar [note: 'The endorsement number that triggered this risk change event.']
  is_cat_exposed boolean [note: 'Indicates whether the changed risk is exposed to catastrophe perils.']
  last_modified_by_user varchar [note: 'User ID or name of the person who last modified this risk change event record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this risk change event record was last modified.']
  new_cat_zone varchar [note: 'Catastrophe zone code after the change was applied.']
  new_exposure_units decimal(18,4) [note: 'Exposure units after the change was applied.']
  new_premium_amount decimal(18,2) [note: 'Premium amount after the change was applied.']
  new_tiv decimal(18,2) [note: 'Total insured value after the change was applied.']
  new_value decimal(18,2) [note: 'The value of the risk attribute after the change was applied.']
  premium_impact_amount decimal(18,2) [note: 'Net change in premium resulting from this risk change event.']
  prior_cat_zone varchar [note: 'Catastrophe zone code before the change was applied.']
  prior_exposure_units decimal(18,4) [note: 'Exposure units before the change was applied.']
  prior_premium_amount decimal(18,2) [note: 'Premium amount before the change was applied.']
  prior_tiv decimal(18,2) [note: 'Total insured value before the change was applied.']
  prior_value decimal(18,2) [note: 'The value of the risk attribute before the change was applied.']
  requested_date date [note: 'Date when the risk change was requested by the insured or agent.']
  reversal_indicator boolean [note: 'Indicates whether this event represents a reversal of a prior change.']
  territory_code varchar [note: 'Rating territory code applicable to the changed risk.']
  transaction_date date [note: 'Date when the risk change transaction was recorded in the system.']
  underwriter_code varchar [note: 'Identifier of the underwriter who approved the risk change.']
  underwriter_notes varchar [note: 'Notes or comments entered by the underwriter regarding the risk change.']

  Note: 'Transactional record of a mid-term change to a risk unit (e.g., location added, vehicle replaced, payroll updated, construction upgrade). Captures change type, effective date, prior and new values, and triggering endorsement.'
}

Table riskexposure.vehicle_claimant_involvement {
  vehicle_claimant_involvement_id varchar [pk, note: 'Unique identifier for the vehicle-claimant involvement record. Primary key.']
  claimant_id varchar [note: 'Foreign key linking to the claimant asserting loss related to this vehicle']
  insured_vehicle_id varchar [note: 'Foreign key linking to the insured vehicle involved in the claim event']
  created_timestamp timestamp [note: 'Timestamp when this vehicle-claimant involvement record was created in the system.']
  driver_at_time_of_loss boolean [note: 'Indicates whether this claimant was the driver of this vehicle at the time of the loss event.']
  fault_percentage decimal(5,2) [note: 'Percentage of fault allocated to this vehicle for this claimant\'s injuries or damages, used for comparative negligence calculations.']
  injury_caused_by_vehicle varchar [note: 'Description of injury or damage this claimant sustained specifically from this vehicle.']
  relationship_to_insured varchar [note: 'Relationship of this claimant to the named insured of this vehicle at time of loss.']
  updated_timestamp timestamp [note: 'Timestamp when this vehicle-claimant involvement record was last updated.']
  vehicle_occupant_position varchar [note: 'Position of the claimant in or relative to this vehicle at time of loss.']

  Note: 'Association representing the involvement of a claimant with a specific insured vehicle in a claim event. Captures driver status, occupant position, fault allocation, and injury details specific to the vehicle-claimant relationship..'
}

Table riskexposure.location_claimant_interest {
  location_claimant_interest_id varchar [pk, note: 'Unique surrogate identifier for the location-claimant interest record. Primary key.']
  claimant_id varchar [note: 'Foreign key linking to the claimant asserting property interest or loss at this location.']
  insured_location_id varchar [note: 'Foreign key linking to the insured location where the claimant has asserted interest or sustained loss.']
  effective_date date [note: 'Date on which the claimant interest at this location became effective. Typically the loss date or the date interest was established.']
  injury_location_description varchar [note: 'Narrative description of where within the insured location the claimant sustained injury or damage (e.g., parking lot, loading dock, second floor hallway). Supports premises liability claims.']
  location_claimant_interest_status varchar [note: 'Current status of the claimant interest at this location: active, settled, withdrawn, denied, or subrogated.']
  loss_exposure_percentage decimal(5,2) [note: 'Percentage of total loss exposure at this location allocated to this claimant. Used for multi-party loss allocation and subrogation. Sum across all claimants for a location should equal 100.']
  property_interest_type varchar [note: 'Type of legal or financial interest the claimant holds in the property at this location: owner, lessee, mortgagee, secured party, bailee, contractor, or none for third-party claimants.']
  role varchar [note: 'Role of the claimant at this specific location: insured party, tenant, lienholder, additional insured, contractor, third-party, mortgagee, or loss payee.']
  termination_date date [note: 'Date on which the claimant interest at this location was terminated or settled. Null if interest is still active.']

  Note: 'Association between insured locations and claimants capturing property interest, loss exposure allocation, and claimant role at specific premises. Supports multi-party claims where multiple claimants assert interest in a single location or a claimant has'
}

Table claims.fnol {
  fnol_id varchar [pk, note: 'Unique identifier for the first notice of loss record.']
  assigned_adjuster_id varchar [note: 'Identifier of the adjuster assigned to handle the claim from this FNOL.']
  claim_id varchar [note: 'Reference to the claim record created from this FNOL, if already established.']
  claimant_id varchar [note: 'Reference to the party record for the claimant reporting the loss.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: FNOL intake captures which coverage is potentially triggered at first notice.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: FNOL estimated_loss_amount requires currency reference for initial loss estimation in international claims.']
  dol_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: FNOL date of loss determines accident year for initial triage, catastrophe event matching, and intake period analysis.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: FNOL intake for property losses must link to insured location for immediate coverage-in-force verification, CAT assignment, adjuster routing by geography, and loss location']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: FNOL for auto losses must link to the vehicle for immediate VIN validation, coverage-in-force verification, and proper claim setup.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: FNOL LOB determines initial triage, adjuster assignment based on specialization, and handling protocol selection.']
  loss_location_country_id varchar [note: 'Foreign key linking to shared.country. Business justification: FNOL loss location country determines international jurisdiction for initial claim handling, language requirements, and catastrophe exposure identification.']
  loss_location_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: FNOL loss location state determines initial jurisdiction for adjuster assignment, state-specific handling requirements, and catastrophe exposure zone identification.']
  policy_id varchar [note: 'Reference to the policy under which the loss is being reported.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: FNOL intake captures the producer/agent who reported the loss. Essential for producer performance tracking, fraud pattern detection (staged losses), and regulatory reporting.']
  cat_code varchar [note: 'Catastrophe event code if the loss is associated with a declared catastrophe.']
  claimant_email varchar [note: 'Email address for the claimant.']
  claimant_phone varchar [note: 'Primary contact phone number for the claimant.']
  created_timestamp timestamp [note: 'Timestamp when the FNOL record was first created in the system.']
  dol date [note: 'Date when the loss event occurred.']
  dol_timestamp timestamp [note: 'Precise date and time when the loss event occurred, if known.']
  estimated_loss_amount decimal(15,2) [note: 'Initial estimate of the loss amount as reported at FNOL.']
  fnol_status varchar [note: 'Current status of the FNOL record in the intake workflow.']
  fraud_indicator boolean [note: 'Flag indicating potential fraud detected during FNOL intake.']
  injury_indicator boolean [note: 'Flag indicating whether bodily injury was reported.']
  intake_channel varchar [note: 'Channel through which the FNOL was received.']
  intake_user_code varchar [note: 'Identifier of the user or system that recorded the FNOL.']
  is_cat_loss boolean [note: 'Flag indicating whether the loss is part of a catastrophe event.']
  loss_description varchar [note: 'Narrative description of the loss event as reported by the claimant or reporter.']
  loss_location_latitude decimal(10,7) [note: 'Geographic latitude coordinate of the loss location.']
  loss_location_longitude decimal(10,7) [note: 'Geographic longitude coordinate of the loss location.']
  number varchar [note: 'Business identifier for the FNOL record, often displayed to users and external parties.']
  peril_code varchar [note: 'Code representing the peril or cause of loss reported.']
  police_report_filed boolean [note: 'Flag indicating whether a police report was filed for the loss.']
  police_report_number varchar [note: 'Police report number if a report was filed.']
  property_damage_indicator boolean [note: 'Flag indicating whether property damage was reported.']
  reported_date date [note: 'Date when the loss was first reported to the insurer.']
  reported_timestamp timestamp [note: 'Precise date and time when the loss was first reported to the insurer.']
  reporter_name varchar [note: 'Full name of the person who reported the loss.']
  reporter_party_code varchar [note: 'Reference to the party who reported the loss, if different from the claimant.']
  reporter_relationship varchar [note: 'Relationship of the reporter to the insured or claimant.']
  updated_timestamp timestamp [note: 'Timestamp when the FNOL record was last updated.']
  witness_present boolean [note: 'Flag indicating whether witnesses were present at the loss event.']

  Note: 'First Notice of Loss record capturing initial claim intake: date of loss, loss location, reported peril, claimant contact, policy reference, and FNOL channel. SSOT for claim origination events.'
}

Table claims.claim {
  claim_id varchar [pk, note: 'Unique system identifier for the claim record. Primary key.']
  cat_event_id varchar [note: 'FK to reservespayments.cat_event.cat_event_id — Ties claims to the single catastrophe master for deterministic CAT rollups (PCS code aggregation) across claims, reserves, and reinsurance.']
  claim_adjuster_id varchar [note: 'Reference to the claims adjuster assigned to handle this claim.']
  claim_examiner_adjuster_id varchar [note: 'Reference to the claims examiner responsible for oversight and approval of claim decisions.']
  claimant_party_id varchar [note: 'Reference to the party making the claim (insured, third party, or other claimant).']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Claims are filed under specific policy coverages. Core adjudication process requires linking claim to the exact coverage_policy_coverage for limit verification, deductible']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Multi-currency claim financials require proper currency reference for total_incurred_amount, paid_loss_amount, outstanding_reserve_amount, ALAE amounts, subrogation, salvage, and deductible.']
  dol_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Date of loss determines accident year for loss development analysis, IBNR calculations, and statutory reporting.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property claims must link to the insured location where loss occurred for coverage verification, exposure validation, CAT modeling, and territory rating confirmation.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto claims must link to the specific vehicle involved for VIN validation, coverage verification, vehicle valuation, total loss determination, and symbol rating validation.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Claim LOB determines handling protocols, reserve authority limits, reinsurance treaty applicability, and statutory reporting classification.']
  loss_location_country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Loss location country determines international jurisdiction, applicable law, reinsurance treaty applicability, and catastrophe exposure zone.']
  loss_location_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Loss location state determines jurisdiction for coverage interpretation, statute of limitations, comparative negligence rules, and regulatory reporting.']
  policy_id varchar [note: 'Reference to the policy under which this claim is filed.']
  policy_insured_id varchar [note: 'Reference to the named insured party on the policy at the time of loss.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Claims must link to the producer who wrote the underlying policy for loss ratio calculation, contingent commission determination, producer performance evaluation, E&O exposure']
  scheduled_item_id varchar [note: 'Foreign key linking to riskexposure.scheduled_item. Business justification: Claims for scheduled personal property (jewelry, fine arts, collectibles) must link to the scheduled item for agreed value verification, appraisal validation, and item-specific']
  tpa_id varchar [note: 'Foreign key linking to claims.tpa. Business justification: TPA (Third Party Administrator) handles claims on behalf of the insurer. One TPA administers many claims; one claim is administered by one TPA (when TPA-administered).']
  alae_paid_amount decimal(18,2) [note: 'Total allocated loss adjustment expenses paid to date (legal, expert, investigation costs directly attributable to this claim).']
  alae_reserve_amount decimal(18,2) [note: 'Outstanding reserve for allocated loss adjustment expenses on this claim.']
  cat_indicator boolean [note: 'Flag indicating whether the claim is part of a catastrophe event.']
  claim_status varchar [note: 'Current lifecycle status of the claim in the adjudication workflow.']
  claim_type varchar [note: 'Classification of the claim based on the relationship of the claimant to the policy (first-party, third-party, subrogation, salvage).']
  closed_date date [note: 'The date the claim was closed (final closure if reopened multiple times).']
  closed_reason varchar [note: 'Reason code or description for claim closure (e.g., paid in full, denied, withdrawn, settled).']
  created_timestamp timestamp [note: 'System timestamp when the claim record was first created in the claims system.']
  deductible_amount decimal(18,2) [note: 'Policy deductible amount applicable to this claim.']
  dol date [note: 'The date on which the loss event occurred.']
  fnol_date date [note: 'The date the claim was first reported to the insurer.']
  fnol_timestamp timestamp [note: 'The precise timestamp when the claim was first reported to the insurer.']
  fraud_indicator boolean [note: 'Flag indicating whether the claim has been flagged for potential fraud investigation.']
  litigation_indicator boolean [note: 'Flag indicating whether the claim is in litigation or legal proceedings.']
  loss_cause varchar [note: 'The peril or cause of loss (e.g., collision, fire, theft, wind, hail, water damage, liability incident).']
  loss_description varchar [note: 'Narrative description of the loss event and circumstances as reported by the claimant or adjuster.']
  loss_time timestamp [note: 'The precise timestamp when the loss event occurred, if known.']
  modified_timestamp timestamp [note: 'System timestamp when the claim record was last modified.']
  number varchar [note: 'Externally-known unique business identifier for the claim, used in all communications and reporting.']
  outstanding_reserve_amount decimal(18,2) [note: 'Current outstanding case reserve amount for unpaid losses on this claim.']
  paid_loss_amount decimal(18,2) [note: 'Total amount paid to date for indemnity losses on this claim.']
  reopened_count varchar [note: 'Number of times the claim has been reopened after initial closure.']
  reported_by varchar [note: 'Name or identifier of the person or entity who reported the claim (insured, agent, third party).']
  salvage_value_amount decimal(18,2) [note: 'Estimated or realized salvage value from damaged property retained by the insurer.']
  settlement_date date [note: 'The date a settlement agreement was reached with the claimant.']
  subrogation_potential_amount decimal(18,2) [note: 'Estimated recoverable amount from subrogation against responsible third parties.']
  subrogation_recovered_amount decimal(18,2) [note: 'Actual amount recovered to date through subrogation activities.']
  total_incurred_amount decimal(18,2) [note: 'Total incurred loss amount including paid losses, outstanding case reserves, and allocated loss adjustment expenses.']

  Note: 'Master P&C claim record for a loss event: claim number, line of business, coverage type, loss cause, CAT code, open/closed status, adjuster assignment, and total incurred. SSOT for claim activity.'
}

Table claims.claimant {
  claimant_id varchar [pk, note: 'Unique identifier for the claimant record. Primary key.']
  attorney_id varchar [note: 'Foreign key linking to claims.attorney. Business justification: Claimants are represented by attorneys when they assert claims. One attorney represents many claimants; one claimant has one attorney (when represented).']
  claim_id varchar [note: 'Reference to the parent claim under which this claimant is asserting a loss.']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Claimant country determines payment processing requirements, tax withholding rules, data privacy compliance (GDPR, etc.), and international communication protocols.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Each claimant\'s exposure is associated with a specific coverage part (e.g., BI vs PD in auto, occurrence vs aggregate in GL).']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Claimant reserve_amount, paid_amount, demand_amount, and settlement_amount require currency reference for multi-jurisdiction claims.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Claimant LOB determines coverage type applicability, settlement authority limits, and claimant-specific handling requirements.']
  settlement_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Claimant settlement date determines settlement period for settlement rate analysis, average time to settle metrics, and financial close reporting.']
  address_line1 varchar [note: 'Primary street address line for the claimant residence or business location.']
  address_line2 varchar [note: 'Secondary address line for apartment, suite, or unit number.']
  body_part_injured varchar [note: 'Specific body part or area injured in the claim event, using standardized anatomical terminology.']
  city varchar [note: 'City or municipality of the claimant address.']
  claimant_status varchar [note: 'Current lifecycle status of the claimant record: active, settled, closed, withdrawn, litigated, or denied.']
  claimant_type varchar [note: 'Classification of the claimant entity: person, organization, estate, trust, minor, or dependent.']
  created_timestamp timestamp [note: 'Timestamp when the claimant record was first created in the system.']
  date_of_birth date [note: 'Date of birth of the claimant if the claimant is a person, used for identification and age verification.']
  dba_name varchar [note: 'Trade name or doing business as name for the claimant organization if different from legal name.']
  demand_amount decimal(15,2) [note: 'Amount demanded by the claimant or their attorney for settlement of the claim.']
  email_address varchar [note: 'Primary email address for claimant communication and correspondence.']
  fault_percentage decimal(5,2) [note: 'Percentage of fault attributed to this claimant in comparative negligence determination, ranging from 0.00 to 100.00.']
  fein varchar [note: 'Federal Employer Identification Number for organizational claimants, used for tax and business identification.']
  first_name varchar [note: 'First or given name of the claimant if the claimant is a person.']
  injury_description varchar [note: 'Detailed narrative description of the injury or damage sustained by the claimant.']
  injury_severity varchar [note: 'Severity classification of the claimant injury: minor, moderate, severe, critical, or fatal.']
  injury_type varchar [note: 'Classification of the injury or damage sustained by the claimant. [ENUM-REF-CANDIDATE: bodily_injury|property_damage|personal_injury_protection|medical_payments|lost_wages|pain_suffering|wrongful_death — promote to reference product]']
  is_represented boolean [note: 'Indicates whether the claimant is represented by legal counsel.']
  last_name varchar [note: 'Last name or surname of the claimant if the claimant is a person.']
  middle_name varchar [note: 'Middle name or initial of the claimant if applicable.']
  mobile_phone_number varchar [note: 'Mobile phone number for SMS and mobile communication with the claimant.']
  number varchar [note: 'Business-assigned unique number for the claimant within the claim, used for external reference and reporting.']
  organization_name varchar [note: 'Legal name of the organization if the claimant is a business entity.']
  paid_amount decimal(15,2) [note: 'Total amount paid to date for this claimant across all payments and settlements.']
  party_code varchar [note: 'Reference to the party master record representing this claimant.']
  phone_number varchar [note: 'Primary contact phone number for the claimant.']
  postal_code varchar [note: 'Postal or ZIP code of the claimant address.']
  representation_date date [note: 'Date when the claimant retained legal representation for this claim.']
  reserve_amount decimal(15,2) [note: 'Current reserve amount set aside for this claimant anticipated loss and expense payments.']
  role varchar [note: 'Role of the claimant in relation to the claim: insured party, third-party claimant, lienholder, additional insured, mortgagee, or loss payee.']
  settlement_amount decimal(15,2) [note: 'Final negotiated settlement amount agreed upon for this claimant.']
  settlement_date date [note: 'Date when the settlement agreement was executed for this claimant.']
  ssn varchar [note: 'Social Security Number of the claimant for tax reporting and identification purposes.']
  state_province varchar [note: 'State, province, or region of the claimant address.']
  updated_timestamp timestamp [note: 'Timestamp when the claimant record was last modified.']

  Note: 'Party asserting a loss under a claim: name, role (insured, third-party, lienholder), contact details, injury/damage type, representation status, and attorney info. Supports BI, PD, PIP, and WC claimant tracking.'
}

Table claims.claim_coverage {
  claim_coverage_id varchar [pk, note: 'Unique identifier for the claim coverage junction record linking a claim to a specific policy coverage.']
  claim_id varchar [note: 'Foreign key reference to the claim that triggered this coverage evaluation.']
  coverage_adjuster_id varchar [note: 'Identifier of the adjuster who made the coverage determination for this claim coverage.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Coverage-level financials (applicable_limit_amount, deductible, SIR, incurred/paid/reserve amounts, ALAE, limit erosion) require currency reference for multi-currency policies.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto coverage determinations must link to the vehicle for vehicle-specific coverage verification, symbol rating validation, and stated value limit application.']
  loss_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Coverage loss date determines coverage trigger analysis for claims-made vs. occurrence policies. Essential for coverage determination, policy period matching, and trigger date disputes.']
  policy_coverage_id varchar [note: 'Foreign key reference to the specific policy coverage being applied to this claim.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Coverage determinations must link to the specific risk unit that was rated and covered for exposure validation, limit verification, deductible application, and premium allocation.']
  scheduled_item_id varchar [note: 'Foreign key linking to riskexposure.scheduled_item. Business justification: Coverage for scheduled items must link to the item for agreed value application, item-specific deductible, and coverage trigger validation.']
  applicable_deductible_amount decimal(18,2) [note: 'The deductible amount that applies to this coverage for the claim, representing the insured\'s out-of-pocket responsibility before coverage begins.']
  applicable_limit_amount decimal(18,2) [note: 'The maximum coverage limit amount applicable to this specific coverage for the claim, reflecting per-occurrence, per-person, or aggregate limits.']
  applicable_sir_amount decimal(18,2) [note: 'The self-insured retention amount applicable to this coverage, representing the amount the insured must pay before the insurer\'s obligation begins.']
  coinsurance_percentage decimal(5,2) [note: 'The percentage of loss shared by the insured after deductible is met, expressed as a decimal percentage.']
  coverage_alae_amount decimal(18,2) [note: 'Allocated loss adjustment expenses directly attributable to this coverage, including legal fees, expert fees, and investigation costs.']
  coverage_basis varchar [note: 'The basis on which coverage limits and deductibles apply, such as per occurrence, per claim, or aggregate.']
  coverage_denial_reason_code varchar [note: 'Standardized code indicating the reason for coverage denial if coverage status is denied, such as exclusion, policy lapse, or non-covered peril.']
  coverage_denial_reason_description varchar [note: 'Detailed explanation of why coverage was denied for this claim under this specific coverage.']
  coverage_determination_date date [note: 'Date when the coverage determination was made by the adjuster or underwriter for this claim coverage.']
  coverage_incurred_loss_amount decimal(18,2) [note: 'Total incurred loss amount attributed to this specific coverage, including paid losses and outstanding reserves.']
  coverage_notes varchar [note: 'Free-text notes documenting coverage decisions, special considerations, or adjuster commentary for this claim coverage.']
  coverage_outstanding_reserve_amount decimal(18,2) [note: 'Outstanding case reserve amount held for this specific coverage representing estimated future payments.']
  coverage_paid_loss_amount decimal(18,2) [note: 'Total amount of loss payments made under this specific coverage to date.']
  coverage_part varchar [note: 'The specific part or section of the policy coverage applicable to this claim, such as liability, property, medical payments, or other coverage divisions.']
  coverage_status varchar [note: 'Current adjudication status of this coverage for the claim indicating whether coverage applies, is denied, or is under review.']
  coverage_trigger_type varchar [note: 'The type of trigger that activates this coverage, such as occurrence-based, claims-made, or manifestation trigger.']
  created_by_user_code varchar [note: 'Identifier of the user or system process that created this claim coverage record.']
  created_timestamp timestamp [note: 'Timestamp when this claim coverage record was first created in the system.']
  deductible_satisfied_date date [note: 'Date when the deductible was fully satisfied for this coverage.']
  deductible_satisfied_flag boolean [note: 'Indicates whether the applicable deductible has been fully satisfied by the insured for this coverage.']
  exclusion_applied_flag boolean [note: 'Indicates whether a policy exclusion was applied that affects coverage for this claim.']
  exclusion_code varchar [note: 'Code identifying the specific policy exclusion applied to this claim coverage, if applicable.']
  limit_erosion_amount decimal(18,2) [note: 'The amount by which the coverage limit has been reduced due to prior claims or payments under the same policy term.']
  loss_date date [note: 'Date when the loss occurred, used to determine coverage applicability and trigger evaluation.']
  policy_effective_date date [note: 'Effective date of the policy coverage at the time of loss, used to validate coverage applicability.']
  policy_expiration_date date [note: 'Expiration date of the policy coverage at the time of loss, used to validate coverage applicability.']
  remaining_limit_amount decimal(18,2) [note: 'The remaining available coverage limit after accounting for limit erosion and current claim incurred amounts.']
  sublimit_amount decimal(18,2) [note: 'The sublimit amount applicable to this coverage if a sublimit applies, representing a lower maximum payout for specific perils or property types.']
  sublimit_applied_flag boolean [note: 'Indicates whether a sublimit applies to this coverage for the claim, restricting the maximum payout below the main policy limit.']
  updated_by_user_code varchar [note: 'Identifier of the user or system process that last updated this claim coverage record.']
  updated_timestamp timestamp [note: 'Timestamp when this claim coverage record was last modified.']

  Note: 'Junction resolving the many-to-many claim-to-coverage relationship: applicable limit, deductible, SIR, coverage part, and coverage-level incurred amounts for each policy coverage triggered by the loss.'
}

Table claims.claims_loss_reserve {
  claims_loss_reserve_id varchar [pk, note: 'Unique identifier for the loss reserve record.']
  claim_coverage_id varchar [note: 'Reference to the specific coverage line within the claim if reserve is coverage-specific.']
  claim_id varchar [note: 'Reference to the parent claim for which this reserve is established.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Reserves are established at the coverage level for actuarial segmentation and IBNR calculations.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reserve amounts (reserve_amount, prior_reserve_amount, reserve_change_amount, paid_to_date_amount, ultimate_loss_estimate) require currency reference for actuarial analysis, IBNR']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property loss reserves must link to location for CAT modeling, geographic loss analysis, PML validation, territory loss ratio analysis, and CAT reserve adequacy.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Reserve LOB determines actuarial segmentation, loss development patterns, and statutory reserve requirements.']
  reserve_set_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Reserve set date determines reserve period for reserve movement analysis, reserve adequacy testing, and financial reporting.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Loss reserves must link to risk unit for exposure-based reserving, actuarial segmentation, loss development analysis, rate adequacy testing, and exposure-based reserve adequacy']
  accident_year varchar [note: 'Calendar year in which the loss event occurred, used for actuarial development triangle analysis.']
  actuarial_segment_code varchar [note: 'Code identifying the actuarial segment or homogeneous risk group to which this reserve is assigned for reserving and pricing analysis.']
  approval_date date [note: 'Date on which the reserve was formally approved by the authorized approver.']
  approver_user_code varchar [note: 'User ID of the manager or actuary who approved this reserve, for audit trail and authority verification.']
  created_timestamp timestamp [note: 'Timestamp when this reserve record was first created in the data warehouse.']
  paid_to_date_amount decimal(18,2) [note: 'Cumulative amount paid on this claim or coverage line as of the reserve set date, used to calculate ultimate loss estimate.']
  prior_reserve_amount decimal(18,2) [note: 'Previous reserve amount before this adjustment, used to calculate reserve development and redundancy/deficiency.']
  report_year varchar [note: 'Calendar year in which the claim was first reported, used for IBNR and development analysis.']
  reserve_amount decimal(18,2) [note: 'Monetary value of the reserve established for this claim or coverage line, in policy currency.']
  reserve_approval_status varchar [note: 'Approval workflow status for reserves requiring management or actuarial sign-off: pending, approved, rejected, or escalated.']
  reserve_basis varchar [note: 'Basis or methodology used to establish the reserve: adjuster estimate, actuarial model, medical report, legal opinion, or settlement demand.']
  reserve_category varchar [note: 'Category of loss reserve: indemnity (pure loss), ALAE (Allocated Loss Adjustment Expense), ULAE (Unallocated Loss Adjustment Expense), defense costs, or medical payments.']
  reserve_change_amount decimal(18,2) [note: 'Net change in reserve amount from prior valuation, positive for increases and negative for decreases.']
  reserve_confidence_level varchar [note: 'Confidence level in the reserve estimate: low, medium, high, or very high, reflecting uncertainty in the valuation.']
  reserve_effective_date date [note: 'Date from which this reserve amount is effective for financial and actuarial reporting purposes.']
  reserve_notes varchar [note: 'Free-text notes or comments from the adjuster or actuary explaining the rationale, assumptions, or special considerations for this reserve.']
  reserve_number varchar [note: 'Business identifier for the reserve transaction, often system-generated or sequential.']
  reserve_reason_code varchar [note: 'Code indicating the reason for reserve establishment or adjustment (e.g., new claim, medical update, legal development, settlement negotiation).']
  reserve_set_date date [note: 'Date on which this reserve amount was established or last revised by the adjuster or actuary.']
  reserve_source_system varchar [note: 'Name of the source system from which this reserve record originated (e.g., ClaimCenter, Duck Creek Claims, Arius).']
  reserve_source_system_code varchar [note: 'Unique identifier of this reserve record in the source system, for traceability and reconciliation.']
  reserve_status varchar [note: 'Current lifecycle status of the reserve entry: open (active), closed (finalized), superseded (replaced by newer estimate), or pending review.']
  reserve_type varchar [note: 'Classification of reserve: case (Outstanding Case Reserve/OCR), IBNR (Incurred But Not Reported), IBNER (Incurred But Not Enough Reported), salvage, or subrogation.']
  ultimate_loss_estimate decimal(18,2) [note: 'Estimated total loss (paid plus outstanding reserve) expected to be incurred on this claim or coverage line at final settlement.']
  updated_timestamp timestamp [note: 'Timestamp when this reserve record was last modified in the data warehouse.']
  valuation_date date [note: 'As-of date for which this reserve valuation is calculated, typically quarter-end or year-end for statutory reporting.']

  Note: 'Case reserve for a claim or claim-coverage line: OCR amount, ALAE reserve, reserve type (case/IBNR/IBNER), set date, basis, and actuarial segment. SSOT for reserve development fed to actuarial reserving.'
}

Table claims.claims_reserve_transaction {
  claims_reserve_transaction_id varchar [pk, note: 'Unique identifier for each reserve transaction record in the audit ledger.']
  claim_id varchar [note: 'Identifier of the claim to which this reserve transaction applies.']
  claims_adjuster_id varchar [note: 'Identifier of the claims adjuster who authorized or executed this reserve movement.']
  claims_supervisor_adjuster_id varchar [note: 'Identifier of the supervisor who approved this reserve change if approval was required.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reserve transaction amounts (prior_reserve_amount, transaction_amount, new_reserve_amount, reinsurance_recoverable_amount, net_reserve_amount) require currency reference for reserve movement']
  effective_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Reserve transaction effective date determines transaction period for reserve movement tracking, loss development analysis, and financial reporting.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Reserve transaction LOB determines GL account mapping, statutory reporting classification, and reinsurance recovery allocation.']
  reversed_transaction_claims_reserve_transaction_id varchar [note: 'Identifier of the original transaction being reversed, if this is a reversal entry.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Reserve changes must link to risk unit for loss development triangles, exposure-based reserve adequacy, and rate indication analysis.']
  accident_year varchar [note: 'Calendar year in which the loss occurred, used for Schedule P triangle reporting and IBNR development.']
  accounting_period varchar [note: 'Year-month accounting period to which this reserve transaction is posted for financial reporting.']
  approval_required_flag boolean [note: 'Indicates whether supervisory approval was required for this reserve transaction based on authority limits.']
  approval_timestamp timestamp [note: 'Date and time when the supervisor approved this reserve transaction, if applicable.']
  bulk_reserve_flag boolean [note: 'Indicates whether this transaction is part of a bulk reserve adjustment across multiple claims.']
  cat_code varchar [note: 'Industry catastrophe event code if this reserve relates to a declared catastrophe event.']
  coverage_code varchar [note: 'Code identifying the specific policy coverage under which this reserve is held.']
  created_timestamp timestamp [note: 'System timestamp when this reserve transaction record was first created in the data warehouse.']
  gl_account_code varchar [note: 'General ledger account code to which this reserve transaction is posted for financial statement preparation.']
  loss_development_factor decimal(10,4) [note: 'Actuarial development factor applied to adjust reserves based on historical loss emergence patterns.']
  net_reserve_amount decimal(18,2) [note: 'Net reserve after deducting reinsurance recoverables, representing the company\'s retained exposure.']
  new_reserve_amount decimal(18,2) [note: 'Reserve balance after applying this transaction, in policy currency.']
  notes varchar [note: 'Free-text notes or comments providing additional context for this reserve transaction.']
  peril_code varchar [note: 'Code identifying the cause of loss or peril associated with this reserve.']
  posting_status varchar [note: 'Current lifecycle status of this reserve transaction in the financial ledger.']
  prior_reserve_amount decimal(18,2) [note: 'Reserve balance immediately before this transaction, in policy currency.']
  reason_code varchar [note: 'Standardized code indicating the business reason for this reserve adjustment.']
  reason_description varchar [note: 'Detailed narrative explanation of why this reserve change was made, supporting actuarial review and audit.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'Portion of this reserve that is expected to be recovered from reinsurers under treaty or facultative agreements.']
  report_year varchar [note: 'Calendar year in which the claim was first reported, supporting incurred-but-not-reported analysis.']
  reserve_category varchar [note: 'Type of reserve being adjusted: case reserve (OCR), IBNR, ALAE, or ULAE.']
  reserve_confidence_level varchar [note: 'Adjuster or actuarial assessment of confidence in the adequacy of this reserve estimate.']
  reserve_method varchar [note: 'Methodology used to calculate this reserve: case-by-case, formula-driven, actuarial model, or bulk reserve.']
  reversal_flag boolean [note: 'Indicates whether this transaction reverses a prior reserve transaction due to error correction or adjustment.']
  salvage_subrogation_estimate decimal(18,2) [note: 'Estimated amount expected to be recovered through salvage or subrogation, reducing net reserve exposure.']
  source_transaction_code varchar [note: 'Unique identifier of this transaction in the source claims system for reconciliation and traceability.']
  transaction_amount decimal(18,2) [note: 'Signed delta applied in this transaction; positive for increases, negative for decreases.']
  transaction_effective_date date [note: 'Accounting date on which this reserve change takes effect for financial and statutory reporting.']
  transaction_number varchar [note: 'Business-facing sequence or reference number for this reserve movement within the claim lifecycle.']
  transaction_timestamp timestamp [note: 'Precise date and time when this reserve transaction was recorded in the system.']
  transaction_type varchar [note: 'Category of reserve movement: initial set, increase, decrease, reopen, close, or transfer between reserve types.']
  updated_timestamp timestamp [note: 'System timestamp when this reserve transaction record was last modified in the data warehouse.']
  valuation_date date [note: 'As-of date for reserve valuation, typically quarter-end or year-end for statutory reporting.']

  Note: 'Audit-grade ledger of every reserve movement on a claim: prior amount, new amount, delta, transaction type (set/increase/decrease/close), and authorizing adjuster. Supports IBNR development and NAIC Schedule P triangles.'
}

Table claims.claims_claim_payment {
  claims_claim_payment_id varchar [pk, note: 'Unique identifier for the claim payment transaction record.']
  claim_coverage_id varchar [note: 'Reference to the specific coverage line within the claim being paid, if payment is coverage-specific.']
  claim_id varchar [note: 'Reference to the parent claim for which this payment is issued.']
  claims_reserve_transaction_id varchar [note: 'Reference to the reserve transaction that authorized or funded this payment.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Payments erode specific coverage limits and must be tracked against the coverage_policy_coverage for aggregate limit monitoring, reinsurance cession calculations, and']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Payment amounts (gross_payment_amount, deductible_amount, offset_amount, withholding_amount, net_payment_amount) require currency reference for payment processing, tax withholding']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property claim payments must link to location for geographic loss analysis, territory rate adequacy, CAT loss validation, and PML reconciliation.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Payment LOB determines GL account mapping, statutory reporting classification, and reinsurance recovery allocation.']
  payee_id varchar [note: 'Reference to the party entity receiving the payment.']
  payment_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Payment date determines payment period for cash flow analysis, paid loss development, and financial reporting. Essential for Schedule P paid loss reporting and cash management.']
  payment_transaction_id varchar [note: 'Foreign key linking to reservespayments.payment_transaction. Business justification: Payment reconciliation requires linking operational payment records (claims domain) to financial payment transactions (reservespayments domain).']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Claim payments must link to risk unit for premium-to-loss ratio analysis, rate adequacy testing, exposure-based profitability, and actuarial pricing.']
  accounting_date date [note: 'Date the payment was posted to the general ledger for financial reporting purposes.']
  approval_authority varchar [note: 'Name or identifier of the adjuster, supervisor, or system that approved the payment.']
  approval_date date [note: 'Date the payment was approved for issuance.']
  catastrophe_code varchar [note: 'ISO or PCS catastrophe event code if the payment is related to a declared catastrophe.']
  check_number varchar [note: 'Physical or virtual check number assigned to the payment, if payment method is check.']
  cleared_date date [note: 'Date the payment cleared the bank or financial institution.']
  created_by_user varchar [note: 'User ID or name of the person or system that created the payment record.']
  created_timestamp timestamp [note: 'Timestamp when the payment record was first created in the system.']
  deductible_amount decimal(18,2) [note: 'Portion of the loss retained by the insured and deducted from the gross payment.']
  gl_account_code varchar [note: 'General ledger account code to which the payment is posted for financial reporting.']
  gross_payment_amount decimal(18,2) [note: 'Total payment amount before any deductions, offsets, or withholdings.']
  is_joint_payee boolean [note: 'Indicates whether the payment is issued to multiple payees jointly (e.g., insured and mortgagee).']
  is_reportable_1099 boolean [note: 'Indicates whether the payment is reportable to the IRS on Form 1099-MISC.']
  joint_payee_name varchar [note: 'Name of the second payee if payment is issued jointly.']
  loss_category varchar [note: 'High-level classification of the loss type for which payment is made: property, liability, auto physical damage, workers compensation, medical, legal, or other.']
  net_payment_amount decimal(18,2) [note: 'Final disbursed amount after all deductions, offsets, and withholdings.']
  offset_amount decimal(18,2) [note: 'Amount offset against the payment for prior overpayments, subrogation, or other recoveries.']
  payee_tax_number varchar [note: 'Tax identification number (SSN or FEIN) of the payee for IRS 1099 reporting purposes.']
  payee_type varchar [note: 'Classification of the payment recipient: claimant, insured, vendor, medical provider, legal counsel, mortgagee, lienholder, or other party. [ENUM-REF-CANDIDATE: claimant|insured|vendor|medical_provider|legal_counsel|mortgagee|lienholder|other — 8']
  payment_batch_code varchar [note: 'Identifier for the batch or run in which this payment was processed, if applicable.']
  payment_date date [note: 'Date the payment was issued or disbursed to the payee.']
  payment_memo varchar [note: 'Free-text memo or note describing the purpose or context of the payment.']
  payment_method varchar [note: 'Instrument used to disburse payment: check, EFT (Electronic Funds Transfer), wire transfer, ACH (Automated Clearing House), debit card, or virtual card.']
  payment_number varchar [note: 'Business identifier for the payment transaction, often sequential within a claim.']
  payment_status varchar [note: 'Current lifecycle status of the payment: pending approval, approved, issued, cleared by bank, voided, stopped, or returned. [ENUM-REF-CANDIDATE: pending|approved|issued|cleared|voided|stopped|returned — 7 candidates stripped; promote to reference product]']
  payment_type varchar [note: 'Classification of payment: indemnity, ALAE (Allocated Loss Adjustment Expense), ULAE (Unallocated Loss Adjustment Expense), medical, expense, subrogation recovery, salvage recovery, or deductible reimbursement.']
  salvage_potential_flag boolean [note: 'Indicates whether the payment has potential for salvage recovery from damaged property.']
  state_code varchar [note: 'Two-letter US state or Canadian province code where the payment is allocated for regulatory reporting.']
  subrogation_potential_flag boolean [note: 'Indicates whether the payment has potential for subrogation recovery from a third party.']
  transaction_reference_number varchar [note: 'Electronic payment confirmation or trace number from the financial institution or payment processor.']
  updated_by_user varchar [note: 'User ID or name of the person or system that last modified the payment record.']
  updated_timestamp timestamp [note: 'Timestamp when the payment record was last modified.']
  void_date date [note: 'Date the payment was voided or cancelled, if applicable.']
  withholding_amount decimal(18,2) [note: 'Tax or legal withholding amount deducted from the gross payment per regulatory or court order.']

  Note: 'Junction table linking a claim (or claim-coverage line) to a disbursement: payee, payment amount, payment type (indemnity/ALAE/ULAE/subrogation recovery), check number, and payment date. Resolves the many-to-many claim-to-payment relationship.'
}

Table claims.disbursement {
  disbursement_id varchar [pk, note: 'Unique identifier for the claim payment disbursement transaction.']
  calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Disbursement date determines disbursement period for cash flow analysis, bank reconciliation, and treasury management. Essential for cash management and disbursement volume tracking.']
  claim_id varchar [note: 'Reference to the parent claim for which this disbursement is issued.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Disbursement amounts (gross_amount, withholding_amount, offset_amount, net_amount) require currency reference for check/EFT processing, bank reconciliation, and GL posting.']
  payee_id varchar [note: 'Reference to the party entity receiving the disbursement funds (claimant, vendor, provider, attorney).']
  payment_id varchar [note: 'Reference to the logical payment authorization that this disbursement fulfills.']
  approval_timestamp timestamp [note: 'Date and time when the disbursement was approved for issuance.']
  approval_user_code varchar [note: 'User identifier of the claims adjuster or supervisor who authorized the disbursement.']
  bank_account_number varchar [note: 'Payee bank account number for electronic funds transfer (EFT/ACH/Wire) disbursements.']
  bank_name varchar [note: 'Name of the financial institution receiving the electronic disbursement.']
  bank_routing_number varchar [note: 'ABA routing transit number for the payee financial institution, used for electronic disbursements.']
  check_number varchar [note: 'Physical check number printed on the disbursement instrument, if disbursement method is check.']
  cleared_date date [note: 'Date the disbursement cleared the bank or was confirmed as received by the payee.']
  coverage_code varchar [note: 'ISO or internal coverage code identifying the policy coverage under which this disbursement is paid.']
  created_timestamp timestamp [note: 'Date and time when the disbursement record was first created in the system.']
  disbursement_date date [note: 'Date the disbursement was issued or initiated (check date or EFT origination date).']
  disbursement_status varchar [note: 'Current lifecycle status of the disbursement transaction.']
  eft_trace_number varchar [note: 'Unique trace or confirmation number assigned by the ACH or wire transfer system for electronic disbursements.']
  gl_account_code varchar [note: 'General ledger account code to which this disbursement is posted for financial reporting.']
  gl_posting_date date [note: 'Accounting date when the disbursement transaction was posted to the general ledger.']
  gross_amount decimal(18,2) [note: 'Total authorized payment amount before any deductions, withholdings, or offsets.']
  is_void boolean [note: 'Indicator whether the disbursement has been voided or cancelled.']
  issued_by_user_code varchar [note: 'User identifier of the person or system that issued or generated the disbursement instrument.']
  issued_timestamp timestamp [note: 'Date and time when the disbursement was physically or electronically issued to the payee.']
  loss_category varchar [note: 'Classification of the loss type for statutory and regulatory reporting (e.g., bodily injury, property damage, medical payments).']
  memo varchar [note: 'Free-text memo or note describing the purpose or context of the disbursement, often printed on check stub or remittance advice.']
  method varchar [note: 'Payment instrument or mechanism used to disburse funds to the payee. [ENUM-REF-CANDIDATE: check|eft|wire|ach|debit_card|paypal|other — 7 candidates stripped; promote to reference product]']
  modified_timestamp timestamp [note: 'Date and time when the disbursement record was last updated or modified.']
  net_amount decimal(18,2) [note: 'Actual amount paid to the payee after all withholdings and offsets (gross minus withholding minus offset).']
  number varchar [note: 'Business-facing unique identifier for the disbursement, often printed on checks or remittance advice.']
  offset_amount decimal(18,2) [note: 'Amount deducted from gross due to subrogation recovery, overpayment recoupment, or other offsets.']
  payee_address_line1 varchar [note: 'Primary street address line for the payee receiving the disbursement.']
  payee_address_line2 varchar [note: 'Secondary address line for the payee (suite, apartment, building number).']
  payee_city varchar [note: 'City name for the payee mailing address.']
  payee_country varchar [note: 'Three-letter ISO country code for the payee mailing address.']
  payee_postal_code varchar [note: 'Postal or ZIP code for the payee mailing address.']
  payee_state varchar [note: 'State or province code for the payee mailing address.']
  payee_tax_number varchar [note: 'Tax identification number for the payee, used for IRS 1099 reporting and tax withholding compliance.']
  payment_type varchar [note: 'Classification of the payment purpose (indemnity, expense, ALAE, ULAE, subrogation recovery, salvage, other). [ENUM-REF-CANDIDATE: indemnity|expense|alae|ulae|subrogation|salvage|other — 7 candidates stripped; promote to reference product]']
  void_date date [note: 'Date the disbursement was voided or cancelled, if applicable.']
  void_reason varchar [note: 'Business reason or explanation for voiding the disbursement (e.g., duplicate payment, incorrect amount, payee request).']
  withholding_amount decimal(18,2) [note: 'Total amount withheld from gross for tax, legal, or other mandatory deductions.']

  Note: 'Financial disbursement record for a claim payment: payee party, bank/check details, gross amount, net amount, withholding, void flag, EFT/check indicator, and GL posting reference. SSOT for claim cash outflow.'
}

Table claims.adjuster {
  adjuster_id varchar [pk, note: 'Unique identifier for the claims adjuster record. Primary key.']
  license_issue_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Adjuster license issue date tracks license lifecycle for compliance monitoring and license history analysis. Essential for adjuster qualification tracking and regulatory compliance.']
  license_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Adjuster license state links to state licensing authority (DOI) for license verification, continuing education requirements, and regulatory compliance.']
  supervisor_adjuster_id varchar [note: 'Identifier of the supervising adjuster or claims manager responsible for oversight and escalations.']
  tpa_id varchar [note: 'Foreign key linking to claims.tpa. Business justification: Adjusters can be employed by TPAs (Third Party Administrators) rather than directly by the insurer. One TPA employs many adjusters; one adjuster works for one TPA (when adjuster_type = \'TPA\').']
  adjuster_type varchar [note: 'Classification of adjuster employment relationship: staff employee, independent contractor, Third-Party Administrator (TPA), Catastrophe (CAT) specialist, or public adjuster.']
  background_check_date date [note: 'Date the most recent background check was completed for compliance and risk management.']
  background_check_status varchar [note: 'Result status of the most recent background check screening.']
  ce_due_date date [note: 'Date by which the adjuster must complete required continuing education hours to maintain license.']
  continuing_education_hours varchar [note: 'Total continuing education hours completed in the current licensing period for compliance tracking.']
  created_timestamp timestamp [note: 'Timestamp when the adjuster record was first created in the system.']
  current_workload_count varchar [note: 'Number of open claims currently assigned to the adjuster for capacity planning and workload balancing.']
  email_address varchar [note: 'Primary business email address for adjuster communication and claim correspondence.']
  employment_status varchar [note: 'Current employment or engagement status of the adjuster.']
  eo_expiration_date date [note: 'Expiration date of the errors and omissions insurance policy for compliance monitoring.']
  eo_insurance_carrier varchar [note: 'Name of the insurance carrier providing errors and omissions coverage for the adjuster.']
  eo_policy_number varchar [note: 'Policy number of the errors and omissions insurance coverage required for independent adjusters.']
  fein varchar [note: 'Federal tax identification number for independent adjusters operating as business entities.']
  first_name varchar [note: 'Legal first name of the adjuster as registered with licensing authorities.']
  hire_date date [note: 'Date the adjuster was hired or contracted to begin claims handling services.']
  home_office_location varchar [note: 'Primary office or branch location where the adjuster is based for assignment and reporting purposes.']
  last_name varchar [note: 'Legal last name of the adjuster as registered with licensing authorities.']
  license_expiration_date date [note: 'Date the adjuster license expires and requires renewal to maintain active status.']
  license_issue_date date [note: 'Date the adjuster license was originally issued by the state Department of Insurance.']
  license_number varchar [note: 'Primary state-issued adjuster license number for regulatory compliance and claim handling authority.']
  license_status varchar [note: 'Current regulatory status of the adjuster license with the state Department of Insurance.']
  lob_authority varchar [note: 'Comma-separated list of lines of business the adjuster is authorized to handle based on license and training. [ENUM-REF-CANDIDATE: personal_auto|commercial_auto|homeowners|commercial_property|GL|WC|umbrella|inland_marine — promote to reference product]']
  max_workload_capacity varchar [note: 'Maximum number of concurrent claims the adjuster can handle based on complexity and line of business.']
  middle_name varchar [note: 'Middle name or initial of the adjuster.']
  mobile_number varchar [note: 'Mobile phone number for field adjuster contact and emergency communication.']
  naic_code varchar [note: 'Five-digit NAIC company code if adjuster is associated with a specific carrier for regulatory reporting.']
  notes varchar [note: 'Free-form notes capturing special skills, restrictions, preferences, or administrative remarks about the adjuster.']
  number varchar [note: 'Business identifier assigned to the adjuster for external reference and licensing purposes.']
  phone_number varchar [note: 'Primary contact phone number for the adjuster.']
  reserve_authority_limit decimal(15,2) [note: 'Maximum dollar amount the adjuster is authorized to establish or modify case reserves without supervisory approval.']
  settlement_authority_limit decimal(15,2) [note: 'Maximum dollar amount the adjuster is authorized to settle without supervisory approval.']
  specialization varchar [note: 'Primary area of claims expertise such as CAT, auto physical damage, general liability, workers compensation, property, or medical. [ENUM-REF-CANDIDATE: CAT|auto|APD|GL|CGL|WC|property|medical|subrogation|fraud — promote to reference product]']
  ssn_last_four varchar [note: 'Last four digits of the adjuster Social Security Number for identity verification and tax reporting.']
  termination_date date [note: 'Date the adjuster employment or contract was terminated.']
  territory_code varchar [note: 'Geographic territory code defining the adjuster service area for claim assignment routing.']
  updated_timestamp timestamp [note: 'Timestamp when the adjuster record was last modified.']
  vendor_company_name varchar [note: 'Name of the independent adjusting firm or TPA if adjuster is not a staff employee.']
  vendor_contract_number varchar [note: 'Contract or agreement number governing the independent adjuster or TPA engagement terms.']
  years_of_experience varchar [note: 'Total years of claims adjusting experience across all employers and lines of business.']

  Note: 'Claims adjuster master: staff or independent adjuster name, license number, state appointments, adjuster type (staff/IA/TPA), specialization (CAT/auto/GL/WC), and current workload capacity. SSOT for adjuster identity.'
}

Table claims.adjuster_assignment {
  adjuster_assignment_id varchar [pk, note: 'Unique identifier for the adjuster assignment record.']
  assignment_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Adjuster assignment date determines assignment period for workload analysis, assignment lag metrics, and operational reporting.']
  claim_id varchar [note: 'Reference to the claim being assigned to an adjuster.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Adjuster assignments for property claims must link to location for geographic routing, workload management by territory, travel optimization, and local expertise matching.']
  primary_adjuster_id varchar [note: 'Reference to the adjuster assigned to handle the claim.']
  actual_hours decimal(10,2) [note: 'Actual number of hours spent by the adjuster on this claim assignment.']
  assigned_by_name varchar [note: 'Name of the user or system that performed the assignment.']
  assigned_by_user_code varchar [note: 'Reference to the user who performed the assignment.']
  assignment_date date [note: 'Date when the adjuster was assigned to the claim.']
  assignment_method varchar [note: 'Method used to assign the adjuster: manual selection, automatic routing, round-robin, skill-based matching, geographic proximity, or workload balancing algorithm.']
  assignment_notes varchar [note: 'Free-text notes or comments regarding the assignment, including special instructions or context.']
  assignment_number varchar [note: 'Business-readable unique identifier for the assignment.']
  assignment_reason varchar [note: 'Business reason for the assignment: initial intake, workload balancing, expertise required, geographic coverage, catastrophe response, or other justification.']
  assignment_role varchar [note: 'Role of the adjuster in this assignment: primary handler, supervisor, catastrophe adjuster, specialist, desk adjuster, field adjuster, or independent adjuster.']
  assignment_status varchar [note: 'Current status of the adjuster assignment.']
  assignment_timestamp timestamp [note: 'Precise timestamp when the adjuster assignment was created.']
  assignment_type varchar [note: 'Type of assignment: initial assignment, reassignment, escalation, transfer, temporary coverage, or permanent assignment.']
  cat_code varchar [note: 'Catastrophe event code if this assignment is related to a declared catastrophe event.']
  complexity_level varchar [note: 'Assessed complexity level of the claim for assignment and workload planning purposes.']
  created_timestamp timestamp [note: 'Timestamp when the assignment record was first created in the system.']
  effective_date date [note: 'Date when the assignment becomes effective.']
  end_date date [note: 'Date when the assignment ended or was terminated.']
  end_reason varchar [note: 'Reason the assignment ended: claim closed, reassignment, adjuster departure, escalation, or other termination cause.']
  end_timestamp timestamp [note: 'Precise timestamp when the assignment was ended or terminated.']
  estimated_hours decimal(10,2) [note: 'Estimated number of hours required to handle this claim assignment.']
  first_contact_date date [note: 'Date when the adjuster first contacted the claimant or insured after assignment.']
  is_active boolean [note: 'Indicates whether this is the current active assignment for the claim.']
  is_cat_assignment boolean [note: 'Indicates whether this assignment is part of a catastrophe response effort.']
  is_primary boolean [note: 'Indicates whether this adjuster is the primary handler for the claim.']
  last_activity_date date [note: 'Date of the most recent activity or action taken by the adjuster on this assignment.']
  license_required varchar [note: 'Adjuster license or certification required for this assignment based on jurisdiction and claim type.']
  lob varchar [note: 'Line of business for the claim: personal auto, homeowners, commercial property, general liability, workers compensation, or other product line.']
  modified_by_user_code varchar [note: 'Reference to the user who last modified the assignment record.']
  modified_timestamp timestamp [note: 'Timestamp when the assignment record was last modified.']
  reassignment_reason varchar [note: 'Reason for reassigning the claim to a different adjuster: workload rebalancing, adjuster unavailability, escalation, conflict of interest, or other cause.']
  sla_target_days varchar [note: 'Target number of days to complete key milestones for this assignment per service level agreement.']
  specialty_required varchar [note: 'Specific adjuster specialty or expertise required for this assignment: bodily injury, property damage, subrogation, fraud investigation, large loss, or other specialization.']
  territory_code varchar [note: 'Geographic territory code for the assignment, used for routing and workload distribution.']
  workload_priority varchar [note: 'Priority ranking of this assignment within the adjuster\'s workload, with lower numbers indicating higher priority.']

  Note: 'Assignment of an adjuster to a claim: assignment date, role (primary/supervisor/CAT/specialist), reassignment reason, and active flag. Tracks adjuster workload and claim ownership history.'
}

Table claims.claim_note {
  claim_note_id varchar [pk, note: 'Unique identifier for the claim note record.']
  claim_coverage_id varchar [note: 'Reference to the specific coverage under which this note is categorized, if applicable.']
  claim_id varchar [note: 'Reference to the parent claim to which this note is attached.']
  exposure_id varchar [note: 'Reference to the claim exposure this note pertains to, if applicable.']
  note_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Claim note date determines note period for activity tracking, diary management, and audit trail. Essential for claim activity analysis and operational metrics.']
  activity_code varchar [note: 'Reference to the claim activity or task associated with this note, if applicable.']
  assigned_to_user_code varchar [note: 'System identifier of the user to whom follow-up or review of this note is assigned.']
  attachment_count varchar [note: 'Number of documents or files attached to this note.']
  author_name varchar [note: 'Full name of the user who authored the note for display and audit purposes.']
  author_user_code varchar [note: 'System identifier of the user who created the note.']
  body_text varchar [note: 'Full text content of the note capturing detailed information, observations, or instructions.']
  confidential_flag boolean [note: 'Indicator whether the note contains confidential or sensitive information restricted to specific roles.']
  deleted_by_user_code varchar [note: 'System identifier of the user who deleted the note, if applicable.']
  deleted_date date [note: 'Date on which the note was marked as deleted, if applicable.']
  deleted_flag boolean [note: 'Indicator whether the note has been soft-deleted and should be excluded from active views.']
  editable_flag boolean [note: 'Indicator whether the note can be edited after creation or is locked for audit integrity.']
  external_reference_code varchar [note: 'Identifier from an external system or document management system linking to related content.']
  follow_up_date date [note: 'Target date by which follow-up action on this note should be completed.']
  follow_up_required_flag boolean [note: 'Indicator whether the note requires follow-up action or review by another user.']
  language_code varchar [note: 'Three-letter ISO 639-2 language code indicating the language in which the note is written.']
  last_modified_by_user_code varchar [note: 'System identifier of the user who last modified the note.']
  last_modified_timestamp timestamp [note: 'Date and time when the note was last updated or modified.']
  litigation_flag boolean [note: 'Indicator whether the note is related to litigation or legal proceedings and subject to discovery.']
  note_date date [note: 'Business date on which the note was created or the event it describes occurred.']
  note_number varchar [note: 'Business-readable sequential or formatted identifier for the note within the claim.']
  note_subtype varchar [note: 'Further classification or subcategory of the note type for granular categorization.']
  note_timestamp timestamp [note: 'Precise date and time when the note was created in the system.']
  note_type varchar [note: 'Classification of the note indicating its purpose: diary, coverage analysis, legal, medical, general, activity log, reserve, or payment. [ENUM-REF-CANDIDATE: diary|coverage|legal|medical|general|activity|reserve|payment — 8 candidates stripped; promote to']
  priority varchar [note: 'Priority level assigned to the note indicating urgency or importance: low, normal, high, or urgent.']
  privileged_flag boolean [note: 'Indicator whether the note is protected by attorney-client privilege or work product doctrine.']
  related_party_code varchar [note: 'Reference to a party involved in the claim that this note discusses, such as claimant, witness, or attorney.']
  reviewed_by_user_code varchar [note: 'System identifier of the user who reviewed the note.']
  reviewed_date date [note: 'Date on which the note was reviewed, if applicable.']
  reviewed_flag boolean [note: 'Indicator whether the note has been reviewed by a supervisor or designated reviewer.']
  security_level varchar [note: 'Classification level controlling access to the note: public, internal, confidential, or restricted.']
  subject varchar [note: 'Brief subject line or title summarizing the content of the note.']
  topic varchar [note: 'Keyword or topic tag for categorizing and searching notes by subject matter.']
  visibility_scope varchar [note: 'Defines who can view the note: internal staff only, external parties, vendors, legal counsel, or medical reviewers.']

  Note: 'Structured diary and activity note on a claim: note type (diary/coverage/legal/medical), author, note date, body text, confidentiality flag, and linked activity. Supports adjudication audit trail and litigation management.'
}

Table claims.claim_document {
  claim_document_id varchar [pk, note: 'Unique identifier for the claim document record.']
  claim_id varchar [note: 'Reference to the parent claim to which this document is attached.']
  document_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Claim document date determines document period for document management, retention policy application, and audit trail. Essential for document lifecycle management and legal hold tracking.']
  fnol_id varchar [note: 'Reference to the FNOL record if document was submitted at intake.']
  approved_by_user_code varchar [note: 'User identifier of the person who approved the document.']
  approved_date date [note: 'Date the document was approved for use in claim processing.']
  approved_flag boolean [note: 'Indicates whether the document has been approved for use in claim adjudication.']
  author_name varchar [note: 'Name of the person or entity who authored or created the document.']
  author_organization varchar [note: 'Organization or company affiliation of the document author.']
  claim_document_description varchar [note: 'Free-text description or summary of the document content and purpose.']
  confidential_flag boolean [note: 'Indicates whether the document contains confidential or sensitive information.']
  document_date date [note: 'Date the document was originally created or issued by the author.']
  document_number varchar [note: 'Business-facing unique document number or reference code.']
  document_status varchar [note: 'Current lifecycle status of the document in the claims workflow. [ENUM-REF-CANDIDATE: pending_review|approved|rejected|archived|deleted|under_review|requires_resubmission — 7 candidates stripped; promote to reference product]']
  document_subtype varchar [note: 'Granular subtype or category within the primary document type.']
  document_type varchar [note: 'Classification of the document type supporting claim adjudication. [ENUM-REF-CANDIDATE: police_report|medical_record|repair_estimate|photo|video|dec_page|correspondence|legal_filing|subrogation_demand|witness_statement|appraisal|invoice — 12 candidates']
  ecm_folder_path varchar [note: 'Hierarchical folder or path location within the ECM repository.']
  ecm_repository varchar [note: 'Name of the ECM or document management system storing the file.']
  file_extension varchar [note: 'File format extension indicating the document type. [ENUM-REF-CANDIDATE: pdf|jpg|jpeg|png|tif|tiff|doc|docx|xls|xlsx|msg|eml — 12 candidates stripped; promote to reference product]']
  file_name varchar [note: 'Original file name of the uploaded or scanned document.']
  file_size_bytes varchar [note: 'Size of the document file in bytes for storage and retrieval tracking.']
  legal_hold_flag boolean [note: 'Indicates whether the document is under legal hold and cannot be destroyed.']
  legal_hold_reason varchar [note: 'Reason or case reference for the legal hold on the document.']
  mime_type varchar [note: 'MIME type of the document file for content handling and rendering.']
  notes varchar [note: 'Additional notes or comments regarding the document handling or review.']
  ocr_processed_flag boolean [note: 'Indicates whether the document has been processed through OCR for text extraction.']
  ocr_text varchar [note: 'Extracted text content from OCR processing for search and indexing.']
  page_count varchar [note: 'Number of pages in the document for indexing and review tracking.']
  phi_flag boolean [note: 'Indicates whether the document contains protected health information under HIPAA.']
  pii_flag boolean [note: 'Indicates whether the document contains personally identifiable information.']
  received_date date [note: 'Date the document was physically or electronically received by the insurer.']
  redaction_required_flag boolean [note: 'Indicates whether the document requires redaction before external sharing.']
  retention_class varchar [note: 'Document retention classification determining how long the document must be kept.']
  retention_expiry_date date [note: 'Date when the document retention period expires and may be eligible for destruction.']
  reviewed_by_user_code varchar [note: 'User identifier of the adjuster or examiner who reviewed the document.']
  reviewed_date date [note: 'Date the document was reviewed by an adjuster or examiner.']
  reviewed_flag boolean [note: 'Indicates whether the document has been reviewed by an adjuster or examiner.']
  source_system_code varchar [note: 'Unique identifier of the document in the originating source system.']
  upload_date date [note: 'Date the document was uploaded or received into the claims system.']
  upload_timestamp timestamp [note: 'Precise timestamp when the document was uploaded or received.']
  uploaded_by_party_code varchar [note: 'Party identifier for the individual or organization that submitted the document.']
  uploaded_by_user_code varchar [note: 'User or system account that uploaded or submitted the document.']

  Note: 'Document attached to a claim: document type (police report/medical record/estimate/DEC page), source system, file reference (OpenText/FileNet), upload date, author, and retention class. Supports adjudication and litigation.'
}

Table claims.litigation {
  litigation_id varchar [pk, note: 'Unique identifier for the litigation record.']
  adjuster_id varchar [note: 'Identifier of the litigation manager overseeing the case.']
  assigned_adjuster_id varchar [note: 'Identifier of the claims adjuster managing the litigation.']
  claim_id varchar [note: 'Reference to the parent claim under litigation.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Lawsuits trigger specific liability coverages with defense obligations. Required for defense cost allocation (inside vs outside limits), duty to defend determination, and']
  defense_counsel_service_vendor_id varchar [note: 'Foreign key linking to claims.service_vendor. Business justification: Defense counsel (law firms) are service vendors engaged by the insurer to defend claims in litigation.']
  plaintiff_attorney_id varchar [note: 'Foreign key linking to claims.attorney. Business justification: Litigation involves a plaintiff attorney who represents the claimant in suit. One attorney can represent plaintiffs in many litigations; one litigation has one plaintiff attorney.']
  plaintiff_claimant_id varchar [note: 'Foreign key linking to claims.claimant. Business justification: In litigation, the plaintiff is typically a claimant asserting a loss under the policy (or the insured in a coverage dispute).']
  suit_filed_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Litigation suit filed date determines litigation period for litigation rate analysis, defense cost tracking, and operational metrics.']
  alae_incurred decimal(18,2) [note: 'Total allocated loss adjustment expense incurred for litigation defense and legal costs.']
  alae_paid decimal(18,2) [note: 'Total allocated loss adjustment expense paid to date for litigation.']
  appeal_filed_indicator boolean [note: 'Flag indicating whether an appeal has been filed following verdict.']
  bad_faith_indicator boolean [note: 'Flag indicating whether the litigation involves bad faith allegations against the insurer.']
  case_description varchar [note: 'Detailed narrative description of the litigation case and allegations.']
  court_county varchar [note: 'County where the court is located.']
  court_jurisdiction varchar [note: 'Name and jurisdiction of the court where the suit is filed.']
  court_state varchar [note: 'State where the court is located.']
  court_type varchar [note: 'Type or level of court handling the litigation.']
  created_timestamp timestamp [note: 'Timestamp when the litigation record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts.']
  discovery_deadline_date date [note: 'Court-imposed deadline for completion of discovery phase.']
  dismissal_date date [note: 'Date the lawsuit was dismissed by the court.']
  litigation_status varchar [note: 'Current procedural status of the litigation case. [ENUM-REF-CANDIDATE: filed|discovery|mediation|trial|settled|verdict|dismissed|appealed — 8 candidates stripped; promote to reference product]']
  litigation_type varchar [note: 'Classification of the nature of the litigation.']
  mediation_scheduled_date date [note: 'Date scheduled for mediation or alternative dispute resolution.']
  notes varchar [note: 'Free-form notes and comments regarding the litigation case.']
  plaintiff_demand_amount decimal(18,2) [note: 'Monetary amount demanded by the plaintiff in the lawsuit.']
  punitive_damages_sought boolean [note: 'Flag indicating whether plaintiff is seeking punitive damages.']
  reserve_amount decimal(18,2) [note: 'Financial reserve set aside for potential litigation exposure.']
  settlement_amount decimal(18,2) [note: 'Agreed settlement amount paid to resolve the litigation.']
  settlement_date date [note: 'Date the litigation was settled out of court.']
  suit_filed_date date [note: 'Date the lawsuit was filed with the court.']
  suit_filed_timestamp timestamp [note: 'Precise timestamp when the lawsuit was filed with the court.']
  suit_number varchar [note: 'Court-assigned case or docket number for the lawsuit.']
  trial_date date [note: 'Scheduled or actual date of trial hearing.']
  updated_timestamp timestamp [note: 'Timestamp when the litigation record was last modified.']
  verdict_amount decimal(18,2) [note: 'Court-awarded judgment amount in favor of plaintiff or defendant.']
  verdict_date date [note: 'Date the court issued a verdict or judgment.']

  Note: 'Litigation record for a claim in suit: plaintiff attorney, defense counsel, court jurisdiction, suit filed date, trial date, verdict amount, settlement amount, and litigation status. Tracks legal exposure and LAE spend.'
}

Table claims.medical_bill {
  medical_bill_id varchar [pk, note: 'Unique identifier for the medical bill record.']
  adjuster_id varchar [note: 'Identifier of the claims examiner or nurse reviewer who evaluated the bill.']
  bill_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Medical bill date determines billing period for medical cost trend analysis, bill review metrics, and operational reporting.']
  claim_id varchar [note: 'Reference to the parent claim for which this medical bill was submitted.']
  claimant_id varchar [note: 'Reference to the party who received the medical treatment.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Medical bills are paid under specific medical payments, PIP, or bodily injury coverages.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Medical bill amounts (billed_amount, allowed_amount, paid_amount, reduction_amount) require currency reference for bill review, fee schedule application, and payment processing.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Medical bills for auto injury claims must link to the vehicle for PIP/med pay coverage verification, per-person limit application, and liability determination.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Medical bill LOB determines fee schedule applicability (workers\' comp vs. auto injury), bill review protocols, and payment authorization limits.']
  payment_transaction_id varchar [note: 'Foreign key linking to reservespayments.payment_transaction. Business justification: Medical bill payment processing requires linking bill records to payment transactions for provider payment tracking, fee schedule compliance audits, Medicare Secondary']
  service_vendor_id varchar [note: 'Foreign key linking to claims.service_vendor. Business justification: Medical providers (hospitals, clinics, physicians, physical therapists) are service vendors in P&C claims (BI, PIP, MedPay, WC).']
  admission_date date [note: 'Date the patient was admitted to the facility for inpatient care, if applicable.']
  allowed_amount decimal(15,2) [note: 'Maximum amount allowed per fee schedule or negotiated rate after bill review.']
  bill_date date [note: 'Date the medical bill was issued by the provider.']
  bill_number varchar [note: 'External bill number assigned by the medical provider or billing system.']
  bill_received_date date [note: 'Date the medical bill was received by the insurer for processing.']
  bill_review_date date [note: 'Date the medical bill review was completed by the insurer or third-party reviewer.']
  bill_review_outcome varchar [note: 'Result of the medical bill review process indicating approval, reduction, or denial.']
  bill_type_code varchar [note: 'Three-digit UB-04 type of bill code indicating facility type and care type.']
  billed_amount decimal(15,2) [note: 'Total amount billed by the provider before any adjustments or reductions.']
  created_timestamp timestamp [note: 'Timestamp when this medical bill record was first created in the system.']
  denial_reason_code varchar [note: 'Code indicating the reason for denial or reduction of the medical bill.']
  denial_reason_description varchar [note: 'Narrative explanation of why the medical bill was denied or reduced.']
  diagnosis_code_primary varchar [note: 'ICD-10 code representing the primary diagnosis for the medical treatment.']
  diagnosis_code_secondary varchar [note: 'ICD-10 code representing secondary or additional diagnoses.']
  discharge_date date [note: 'Date the patient was discharged from the facility, if applicable.']
  fee_schedule_applied varchar [note: 'Name or code of the fee schedule used to determine allowed amounts (e.g., Medicare, PPO, UCR).']
  notes varchar [note: 'Free-text notes or comments regarding the medical bill review or payment decision.']
  paid_amount decimal(15,2) [note: 'Actual amount paid by the insurer to the provider or claimant.']
  payment_date date [note: 'Date the payment was issued to the provider or claimant.']
  payment_method varchar [note: 'Method used to remit payment to the provider (e.g., check, EFT, wire transfer).']
  payment_status varchar [note: 'Current status of payment processing for this medical bill.']
  procedure_code varchar [note: 'CPT or HCPCS code representing the medical procedure or service performed.']
  procedure_description varchar [note: 'Narrative description of the medical procedure or service performed.']
  provider_npi varchar [note: 'Ten-digit unique identifier for the healthcare provider who rendered services.']
  reduction_amount decimal(15,2) [note: 'Amount reduced from billed to allowed due to fee schedule or bill review.']
  revenue_code varchar [note: 'Four-digit UB-04 revenue code classifying the type of service or accommodation.']
  service_date_from date [note: 'Start date of the medical service period covered by this bill.']
  service_date_to date [note: 'End date of the medical service period covered by this bill.']
  service_units decimal(10,2) [note: 'Quantity of service units provided (e.g., days, visits, procedures).']
  updated_timestamp timestamp [note: 'Timestamp when this medical bill record was last modified.']

  Note: 'Medical bill record for BI, PIP, MedPay, or WC claims: provider NPI, bill date, CPT codes, billed amount, allowed amount, paid amount, bill review outcome, and fee schedule applied. Supports medical cost containment.'
}

Table claims.damage_estimate {
  damage_estimate_id varchar [pk, note: 'Unique identifier for the damage estimate record.']
  approved_by_adjuster_id varchar [note: 'Reference to the claims adjuster who reviewed and approved this estimate for payment authorization.']
  claim_id varchar [note: 'Reference to the parent claim for which this damage estimate was prepared.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Property damage estimates are scoped to specific coverages (dwelling, other structures, contents, ALE in homeowners).']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Estimate amounts (rcv_amount, depreciation_amount, acv_amount, deductible_amount, net_payable_amount, salvage_value, labor/materials/equipment/tax amounts) require currency reference for']
  estimate_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Damage estimate date determines estimate period for estimate cycle time analysis, estimator performance metrics, and operational reporting.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property damage estimates must link to insured location for scope validation, replacement cost verification, building characteristics confirmation (construction type, year']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto damage estimates must link to the insured vehicle for VIN validation, stated value comparison, total loss threshold calculation, and vehicle characteristics verification.']
  scheduled_item_id varchar [note: 'Foreign key linking to riskexposure.scheduled_item. Business justification: Damage estimates for scheduled items must link to the item record for agreed value verification, appraisal comparison, and coverage limit validation.']
  service_vendor_id varchar [note: 'Foreign key linking to claims.service_vendor. Business justification: Damage estimates are often prepared by third-party vendors (body shops, restoration companies, independent adjusters).']
  acv_amount decimal(15,2) [note: 'Net settlement value after depreciation, calculated as RCV minus depreciation, representing the pre-loss market value of the damaged property.']
  approval_date date [note: 'Date when the damage estimate was approved by the adjuster or claims manager, authorizing payment processing.']
  created_timestamp timestamp [note: 'System timestamp when the damage estimate record was first created in the claims system.']
  damage_estimate_status varchar [note: 'Current workflow status of the damage estimate: draft in progress, submitted for review, approved for payment, rejected for revision, revised and resubmitted, or final.']
  damage_type varchar [note: 'High-level classification of the damaged asset: property (building/structure), vehicle (auto physical damage), equipment, or other.']
  deductible_amount decimal(15,2) [note: 'Policy deductible applicable to this estimate, representing the insured\'s out-of-pocket responsibility before insurance payment.']
  depreciation_amount decimal(15,2) [note: 'Calculated depreciation deducted from RCV based on age, condition, and useful life of damaged components, used to determine ACV.']
  equipment_amount decimal(15,2) [note: 'Total estimated equipment rental or specialized tool cost component of the RCV, such as scaffolding, lifts, or drying equipment.']
  estimate_date date [note: 'Date when the damage estimate was prepared or finalized by the estimator.']
  estimate_methodology varchar [note: 'Method used to prepare the estimate: detailed on-site inspection, summary estimate, desk review of documentation, or photo-based remote estimate.']
  estimate_number varchar [note: 'Business identifier for the damage estimate, often used in external communications and vendor coordination.']
  estimate_software varchar [note: 'Name of the estimating software or platform used to prepare the estimate (e.g., Xactimate, Mitchell, CCC ONE), important for data integration and audit.']
  estimate_type varchar [note: 'Classification of the estimate in the claim lifecycle: initial assessment, supplemental for additional damage, revised for corrections, or final settlement estimate.']
  estimator_license_number varchar [note: 'Professional license or certification number of the estimator, required for appraisers and engineers in many jurisdictions.']
  estimator_party_code varchar [note: 'Reference to the party (individual or organization) who prepared the damage estimate.']
  estimator_type varchar [note: 'Category of the party who prepared the estimate: staff adjuster, independent adjuster (IA), third-party vendor, licensed appraiser, or structural engineer.']
  inspection_date date [note: 'Date when the physical inspection of the damaged property or vehicle was conducted.']
  labor_amount decimal(15,2) [note: 'Total estimated labor cost component of the RCV, representing the cost of skilled trades and technicians to perform repairs.']
  line_item_count varchar [note: 'Number of individual line items or components included in the detailed estimate, indicating scope and complexity.']
  loss_description varchar [note: 'Detailed narrative description of the damage observed during inspection, including scope, severity, and affected components.']
  materials_amount decimal(15,2) [note: 'Total estimated materials and parts cost component of the RCV, representing the cost of replacement components and supplies.']
  net_payable_amount decimal(15,2) [note: 'Final amount payable to the insured or claimant after applying depreciation, deductible, and any other adjustments.']
  notes varchar [note: 'Additional comments, observations, or special instructions related to the damage estimate, repair scope, or settlement considerations.']
  overhead_profit_amount decimal(15,2) [note: 'Contractor overhead and profit allowance included in the RCV, typically applied when general contractor coordination is required.']
  rcv_amount decimal(15,2) [note: 'Total estimated cost to repair or replace the damaged property with new materials of like kind and quality, without deduction for depreciation.']
  rejection_reason varchar [note: 'Explanation provided when an estimate is rejected, detailing discrepancies, missing information, or policy coverage issues requiring correction.']
  repair_vs_total_decision varchar [note: 'Determination of whether the damaged property should be repaired or declared a total loss based on cost-to-repair versus pre-loss value threshold.']
  salvage_value decimal(15,2) [note: 'Estimated residual value of the damaged property if declared a total loss, representing the amount recoverable through salvage sale.']
  tax_amount decimal(15,2) [note: 'Sales tax or other applicable taxes included in the estimate, based on jurisdiction and taxability of repair services and materials.']
  total_loss_threshold_percentage decimal(5,2) [note: 'Percentage threshold used to determine total loss, typically when repair cost exceeds this percentage of pre-loss value (commonly 70-80 percent).']
  updated_timestamp timestamp [note: 'System timestamp when the damage estimate record was last modified, supporting audit trail and version control.']

  Note: 'Property or vehicle damage estimate: estimator type (staff/IA/vendor), estimate date, RCV amount, ACV amount, depreciation, repair vs. total-loss decision, and vendor reference. Supports APD and property claim settlement.'
}

Table claims.service_vendor {
  service_vendor_id varchar [pk, note: 'Unique identifier for the service vendor record.']
  business_country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Service vendor business country determines international tax treatment, payment processing requirements, and regulatory compliance.']
  business_state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Service vendor business state determines licensing requirements, tax jurisdiction, and regulatory oversight.']
  onboarding_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Service vendor onboarding date determines vendor lifecycle for vendor tenure analysis, performance tracking, and vendor management metrics.']
  payee_id varchar [note: 'Foreign key linking to reservespayments.payee. Business justification: Service vendors (repair shops, medical providers, attorneys) are payees receiving claim payments.']
  average_cycle_time_days decimal(5,2) [note: 'Average number of days from assignment to completion for vendor services.']
  background_check_date date [note: 'Date of the most recent background check or compliance screening performed on the vendor.']
  background_check_status varchar [note: 'Result status of the most recent vendor background check or compliance screening.']
  bank_account_number varchar [note: 'Vendor bank account number for ACH or wire transfer payments.']
  bank_routing_number varchar [note: 'ABA routing number for the vendor bank account.']
  business_address_line1 varchar [note: 'Primary street address line for the vendor business location.']
  business_address_line2 varchar [note: 'Secondary address line for suite, unit, or building information.']
  business_city varchar [note: 'City where the vendor business is located.']
  business_postal_code varchar [note: 'ZIP or postal code for the vendor business address.']
  contract_effective_date date [note: 'Effective start date of the current vendor service agreement.']
  contract_expiration_date date [note: 'Expiration date of the current vendor service agreement.']
  created_timestamp timestamp [note: 'Timestamp when the vendor record was first created in the system.']
  customer_satisfaction_score decimal(3,2) [note: 'Average customer satisfaction rating on a scale of 0.00 to 5.00 from claimant surveys.']
  dba_name varchar [note: 'Trade name or DBA name under which the vendor operates if different from legal name.']
  insurance_certificate_number varchar [note: 'Certificate number for the vendor general liability or professional liability insurance policy.']
  insurance_coverage_amount decimal(15,2) [note: 'Total liability coverage amount in USD provided by the vendor insurance policy.']
  insurance_expiration_date date [note: 'Expiration date of the vendor liability insurance coverage.']
  licensed_states varchar [note: 'Comma-separated list of two-letter state codes where the vendor holds active licenses or approvals.']
  notes varchar [note: 'Free-text notes for special instructions, restrictions, or other relevant vendor information.']
  onboarding_date date [note: 'Date the vendor was onboarded and approved to receive claim assignments.']
  payment_method varchar [note: 'Preferred method of payment for vendor invoices.']
  payment_terms varchar [note: 'Standard payment terms agreed upon with the vendor for invoice settlement.']
  performance_tier varchar [note: 'Performance rating tier assigned based on quality metrics, cycle time, and customer satisfaction scores.']
  preferred_vendor_flag boolean [note: 'Indicates whether the vendor is designated as a preferred provider in the network.']
  primary_contact_email varchar [note: 'Primary email address for vendor correspondence and assignment notifications.']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the vendor organization.']
  primary_contact_phone varchar [note: 'Primary telephone number for reaching the vendor contact.']
  primary_license_expiration_date date [note: 'Expiration date of the vendor primary professional or business license.']
  primary_license_number varchar [note: 'Primary professional or business license number issued by the state regulatory authority.']
  primary_license_state varchar [note: 'State that issued the primary license for the vendor.']
  quality_score decimal(3,2) [note: 'Composite quality score on a scale of 0.00 to 5.00 based on work quality audits and customer feedback.']
  service_radius_miles varchar [note: 'Geographic service radius in miles from the vendor primary location.']
  termination_date date [note: 'Date the vendor relationship was terminated if no longer active.']
  termination_reason varchar [note: 'Reason for vendor termination such as performance issues, license revocation, or business closure.']
  total_assignments_ytd varchar [note: 'Total number of claim assignments sent to the vendor in the current calendar year.']
  updated_timestamp timestamp [note: 'Timestamp when the vendor record was last modified.']
  vendor_name varchar [note: 'Legal business name of the service vendor as registered with regulatory authorities.']
  vendor_status varchar [note: 'Current operational status of the vendor in the service network.']
  vendor_tin varchar [note: 'Federal Tax Identification Number (TIN) or Employer Identification Number (EIN) for the vendor.']
  vendor_type varchar [note: 'Classification of the service type provided by the vendor in claims handling. [ENUM-REF-CANDIDATE']
  w9_on_file_flag boolean [note: 'Indicates whether a current IRS Form W-9 is on file for the vendor.']

  Note: 'Third-party service vendor engaged on a claim: vendor type (body shop/restoration/IA/attorney/IME/nurse case manager), TIN, license, preferred-vendor flag, state approvals, and performance tier. SSOT for claim vendor master.'
}

Table claims.claim_status_history {
  claim_status_history_id varchar [pk, note: 'Unique identifier for each claim status transition record in the immutable audit log.']
  adjuster_id varchar [note: 'Reference to the claims adjuster assigned to the claim at the time of this status transition.']
  claim_id varchar [note: 'Reference to the claim that experienced this status transition.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Status history financial snapshots (reserve_amount, paid_amount, incurred_amount) require currency reference for claim lifecycle analysis, reserve development tracking, and audit trail of']
  examiner_adjuster_id varchar [note: 'Reference to the claims examiner responsible for oversight at the time of this status transition.']
  transition_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Claim status transition date determines transition period for status duration analysis, workflow efficiency metrics, and operational reporting.']
  acting_user_code varchar [note: 'System identifier of the user or automated process that initiated this status transition.']
  acting_user_name varchar [note: 'Full name of the user who performed the status change, captured for audit and regulatory reporting.']
  acting_user_role varchar [note: 'Business role or job function of the user at the time of the status transition, such as adjuster, examiner, or supervisor.']
  approval_required_indicator boolean [note: 'Flag indicating whether this status transition required supervisory or management approval per authority limits.']
  approval_timestamp timestamp [note: 'Date and time when supervisory approval was granted for this status transition.']
  approval_user_code varchar [note: 'System identifier of the supervisor or manager who approved this status transition, if approval was required.']
  comments varchar [note: 'Free-text notes or comments entered by the user at the time of the status change, providing additional context for the transition.']
  created_timestamp timestamp [note: 'System timestamp when this status history record was first inserted into the data warehouse, used for data lineage and audit purposes.']
  effective_date date [note: 'Business-effective date when the new status became active, which may differ from the system transition timestamp for backdated adjustments.']
  incurred_amount decimal(15,2) [note: 'Total incurred loss amount (paid plus outstanding reserve) at the time of this status transition.']
  new_status varchar [note: 'The claim status immediately after this transition was applied. [ENUM-REF-CANDIDATE: open|assigned|investigating|pending_info|approved|denied|closed|reopened — 8 candidates stripped; promote to reference product]']
  notification_sent_indicator boolean [note: 'Flag indicating whether automated notifications were sent to stakeholders as a result of this status change.']
  notification_timestamp timestamp [note: 'Date and time when stakeholder notifications were dispatched following this status transition.']
  paid_amount decimal(15,2) [note: 'Cumulative paid loss amount at the time of this status transition, used for loss development tracking.']
  prior_status varchar [note: 'The claim status immediately before this transition occurred. [ENUM-REF-CANDIDATE: open|assigned|investigating|pending_info|approved|denied|closed|reopened — 8 candidates stripped; promote to reference product]']
  regulatory_reportable_indicator boolean [note: 'Flag indicating whether this status transition must be included in regulatory reporting to state Departments of Insurance or NAIC.']
  reserve_amount decimal(15,2) [note: 'Total outstanding case reserve amount at the time of this status transition, captured for reserve development analysis.']
  sequence_number varchar [note: 'Ordinal position of this status change within the claims lifecycle, starting at 1.']
  sla_actual_hours decimal(10,2) [note: 'Actual number of hours the claim remained in the prior status before this transition, used for SLA compliance reporting.']
  sla_compliance_indicator boolean [note: 'Flag indicating whether the status transition met the defined SLA target for the prior status stage.']
  sla_target_hours decimal(10,2) [note: 'Number of hours allowed for this status stage per service level agreement, used for compliance monitoring.']
  system_source varchar [note: 'Name of the source system or application that recorded this status transition, such as ClaimCenter or Duck Creek Claims.']
  transaction_code varchar [note: 'Unique transaction identifier from the source system that created this status history record, used for reconciliation and traceability.']
  transition_reason_code varchar [note: 'Standardized code indicating why the status change occurred, aligned with business rules and regulatory requirements.']
  transition_reason_description varchar [note: 'Detailed explanation of the business rationale or event that triggered this status change.']
  transition_source varchar [note: 'Indicates whether the status change was initiated manually by a user, automatically by a workflow rule, or via system integration.']
  transition_timestamp timestamp [note: 'Precise date and time when the status change was recorded in the system, used for SLA compliance and audit trails.']
  workflow_step_code varchar [note: 'Identifier of the workflow step or business process stage that triggered this status transition, if applicable.']

  Note: 'Immutable log of every claim status transition: prior status, new status, transition reason, effective timestamp, and acting user. Supports SLA compliance, adjudication audit, and regulatory reporting.'
}

Table claims.fraud_referral {
  fraud_referral_id varchar [pk, note: 'Unique identifier for the fraud referral record.']
  adjuster_id varchar [note: 'Identifier of the SIU investigator assigned to conduct the fraud investigation.']
  claim_id varchar [note: 'Identifier of the claim being referred for fraud investigation.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Fraud investigations often focus on specific coverage misrepresentation or material concealment affecting a particular coverage.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Fraud amounts (estimated_fraud_amount, confirmed_fraud_amount, recovery_amount) require currency reference for fraud investigation, SIU reporting, law enforcement referrals, and recovery']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Fraud investigations for property claims must link to the location for scene investigation, occupancy verification, ownership validation, and prior loss history analysis.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Fraud investigations for auto claims must link to the vehicle for VIN verification, ownership validation, prior damage investigation, and salvage history check.']
  producers_producer_id varchar [note: 'Foreign key linking to producers.producers_producer. Business justification: Fraud investigations examine producer involvement in premium diversion, fictitious policies, staged losses, and collusion schemes.']
  referral_calendar_id varchar [note: 'Foreign key linking to shared.calendar. Business justification: Fraud referral date determines referral period for fraud detection rate analysis, investigation cycle time metrics, and SIU operational reporting.']
  scheduled_item_id varchar [note: 'Foreign key linking to riskexposure.scheduled_item. Business justification: Fraud investigations for scheduled item claims must link to the item for appraisal validation, ownership verification, purchase documentation review, and serial number']
  assigned_date date [note: 'Date the fraud referral was assigned to an SIU investigator.']
  confirmed_fraud_amount decimal(15,2) [note: 'Actual monetary value of the fraud substantiated through investigation, representing the loss prevented or identified.']
  created_by_user_code varchar [note: 'System user identifier of the person who created the fraud referral record.']
  created_timestamp timestamp [note: 'System timestamp when the fraud referral record was first created in the database.']
  denial_reason_code varchar [note: 'Standardized code representing the specific fraud-related reason for recommending claim denial.']
  denial_recommended_flag boolean [note: 'Indicator whether the SIU investigation recommends denying the claim based on fraud findings.']
  estimated_fraud_amount decimal(15,2) [note: 'Initial estimated monetary value of the suspected fraudulent claim or loss at the time of referral.']
  fraud_confirmed_flag boolean [note: 'Indicator whether fraud was definitively confirmed through the investigation.']
  fraud_indicator_code varchar [note: 'Standardized code representing the specific red flag or suspicious activity pattern that triggered the referral.']
  fraud_indicator_description varchar [note: 'Detailed explanation of the suspicious activity or red flags that prompted the fraud referral.']
  fraud_referral_status varchar [note: 'Current state of the fraud investigation workflow.']
  fraud_type varchar [note: 'Classification of the suspected fraud based on severity and intent.']
  investigation_close_date date [note: 'Date the fraud investigation was formally concluded and the case closed.']
  investigation_notes varchar [note: 'Comprehensive narrative documenting investigation activities, interviews conducted, evidence gathered, and findings.']
  investigation_start_date date [note: 'Date the SIU investigator formally began the fraud investigation activities.']
  law_enforcement_agency varchar [note: 'Name of the law enforcement or prosecutorial agency to which the fraud case was referred.']
  law_enforcement_case_number varchar [note: 'Case or docket number assigned by the law enforcement agency for tracking the criminal investigation.']
  law_enforcement_referral_date date [note: 'Date the fraud case was formally referred to law enforcement authorities.']
  law_enforcement_referral_flag boolean [note: 'Indicator whether the case was referred to law enforcement or prosecutorial authorities.']
  nicb_referral_date date [note: 'Date the fraud case was submitted to the National Insurance Crime Bureau.']
  nicb_referral_flag boolean [note: 'Indicator whether the fraud case was reported to the National Insurance Crime Bureau for industry-wide tracking.']
  outcome varchar [note: 'Final determination of the fraud investigation indicating whether fraud was substantiated.']
  outcome_date date [note: 'Date the final investigation outcome was determined and documented.']
  outcome_description varchar [note: 'Detailed narrative explaining the investigation findings, evidence reviewed, and rationale for the outcome determination.']
  policy_cancellation_recommended_flag boolean [note: 'Indicator whether the SIU investigation recommends canceling the policy due to material misrepresentation or fraud.']
  priority varchar [note: 'Urgency level assigned to the fraud referral based on severity, potential loss amount, and risk factors.']
  recovery_amount decimal(15,2) [note: 'Total monetary amount recovered from the fraudulent party through restitution, subrogation, or legal action.']
  recovery_date date [note: 'Date the recovery amount was received or collected from the fraudulent party.']
  referral_date date [note: 'Date the claim was referred to the Special Investigation Unit (SIU) for fraud investigation.']
  referral_number varchar [note: 'Business-facing unique number assigned to the fraud referral for tracking and communication purposes.']
  referral_reason varchar [note: 'Narrative explanation of why the claim was referred for fraud investigation, including specific concerns and evidence.']
  referral_source varchar [note: 'Origin of the fraud referral indicating who or what initiated the investigation request. [ENUM-REF-CANDIDATE: adjuster|examiner|underwriter|producer|automated_system|tip_line|external_agency|data_analytics — 8 candidates stripped; promote to reference']
  referral_timestamp timestamp [note: 'Precise date and time the fraud referral was created in the system.']
  referring_party_code varchar [note: 'Identifier of the person or entity who initiated the fraud referral.']
  referring_user_code varchar [note: 'System user identifier of the employee who submitted the fraud referral.']
  state_fraud_bureau_referral_date date [note: 'Date the fraud case was submitted to the state insurance fraud bureau.']
  state_fraud_bureau_referral_flag boolean [note: 'Indicator whether the fraud case was reported to the state insurance fraud bureau as required by statute.']
  updated_by_user_code varchar [note: 'System user identifier of the person who last modified the fraud referral record.']
  updated_timestamp timestamp [note: 'System timestamp when the fraud referral record was last modified.']

  Note: 'Operational SIU fraud referral record for a claim: referral date, referral reason, SIU investigator assigned, investigation status, outcome (confirmed fraud/unfounded/pending), and recovery amount. Supports SIU workflow.'
}

Table claims.service_assignment {
  service_assignment_id varchar [pk, note: 'Unique identifier for this service assignment record. Primary key.']
  claim_id varchar [note: 'Foreign key linking to the claim on which the vendor service was engaged.']
  service_vendor_id varchar [note: 'Foreign key linking to the service vendor engaged for this assignment.']
  assignment_date date [note: 'Date the vendor was assigned to the claim.']
  assignment_status varchar [note: 'Current lifecycle status of the vendor assignment.']
  assignment_type varchar [note: 'Type of service the vendor was engaged to provide on this claim.']
  completion_date date [note: 'Date the vendor completed their service on the claim.']
  invoice_amount decimal(15,2) [note: 'Total amount invoiced by the vendor for services rendered on this assignment.']
  performance_rating decimal(3,2) [note: 'Performance rating assigned to the vendor for this specific assignment on a scale of 0.00 to 5.00.']
  sla_compliance_flag boolean [note: 'Indicates whether the vendor met service level agreement requirements for this assignment.']

  Note: 'Association between claim and service_vendor capturing each engagement of a third-party vendor on a claim. Tracks assignment lifecycle, performance, and cost for vendor management and regulatory reporting..'
}

Table claims.claim_peril_causation {
  claim_peril_causation_id varchar [pk, note: 'Unique identifier for this claim-peril causation record']
  claim_id varchar [note: 'Foreign key linking to the claim for which peril causation is being determined']
  coverage_peril_id varchar [note: 'Foreign key linking to the peril that contributed to this claim loss event']
  determined_by_adjuster_id varchar [note: 'Reference to the adjuster who made the peril causation determination']
  adjuster_notes varchar [note: 'Narrative notes from adjuster explaining causation determination and coverage analysis']
  causation_sequence_order varchar [note: 'Order in which this peril occurred in the chain of causation for sequential loss events']
  claim_peril_causation_status varchar [note: 'Current status of the peril causation determination in the adjudication workflow']
  concurrent_causation_flag boolean [note: 'Indicates whether this peril operated concurrently with other perils to cause loss']
  coverage_applicable_flag boolean [note: 'Indicates whether coverage applies for this peril based on policy terms and exclusions']
  created_timestamp timestamp [note: 'Timestamp when this causation record was created in the claims system']
  exclusion_applied_flag boolean [note: 'Indicates whether a policy exclusion was applied to deny coverage for this peril']
  exclusion_reason varchar [note: 'Specific policy exclusion clause or reason coverage was denied for this peril']
  last_updated_timestamp timestamp [note: 'Timestamp when this causation record was last modified']
  loss_cause_determination_date date [note: 'Date when the adjuster determined this peril contributed to the loss event']
  peril_contribution_percentage decimal(5,2) [note: 'Percentage of total loss attributed to this peril for apportionment purposes']
  proximate_cause_flag boolean [note: 'Indicates whether this peril is the proximate cause of loss under coverage doctrine']
  subrogation_target_flag boolean [note: 'Indicates whether this peril causation supports subrogation against a responsible third party']

  Note: 'Association between claim and peril capturing which perils contributed to a loss event. Records proximate vs concurrent cause determinations, contribution percentages for apportionment, and causation analysis required for coverage application and'
}

Table claims.tpa {
  tpa_id varchar [pk, note: 'Primary key for tpa']
  address_line_1 varchar [note: 'First line of the TPA physical business address including street number and name.']
  address_line_2 varchar [note: 'Second line of the TPA physical business address for suite, floor, or building details.']
  audit_frequency varchar [note: 'Scheduled frequency at which the insurer conducts performance and compliance audits of the TPA.']
  average_claim_cycle_time_days varchar [note: 'Average number of days the TPA takes to close a claim from first notice of loss to final settlement.']
  city varchar [note: 'City name where the TPA business is located.']
  claims_handling_authority_limit decimal(18,2) [note: 'Maximum monetary amount the TPA is authorized to settle claims without escalation.']
  contract_effective_date date [note: 'Date when the TPA service contract becomes effective and binding.']
  contract_expiration_date date [note: 'Date when the TPA service contract expires or terminates.']
  country_code varchar [note: 'Three-letter ISO country code where the TPA business is domiciled.']
  created_timestamp timestamp [note: 'Date and time when the TPA record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for all monetary amounts associated with the TPA.']
  data_exchange_method varchar [note: 'Primary technical method used to exchange claim data between the insurer and TPA systems.']
  fee_structure_type varchar [note: 'Pricing model used to compensate the TPA for claims administration services.']
  last_audit_date date [note: 'Date of the most recent performance or compliance audit conducted on the TPA.']
  license_expiration_date date [note: 'Date when the TPA regulatory license expires and requires renewal.']
  license_number varchar [note: 'State or regulatory license number authorizing the TPA to administer insurance claims.']
  license_state varchar [note: 'State or jurisdiction that issued the TPA operating license.']
  next_audit_date date [note: 'Scheduled date for the next performance or compliance audit of the TPA.']
  notes varchar [note: 'Free-form text field for additional comments, special instructions, or historical context about the TPA relationship.']
  payment_processing_enabled boolean [note: 'Indicates whether the TPA is authorized to process and issue claim payments on behalf of the insurer.']
  performance_rating varchar [note: 'Current performance evaluation rating of the TPA based on service quality metrics.']
  postal_code varchar [note: 'Postal or ZIP code for the TPA business address.']
  primary_contact_email varchar [note: 'Email address of the primary business contact at the TPA for operational communication.']
  primary_contact_name varchar [note: 'Full name of the primary business contact person at the TPA organization.']
  primary_contact_phone varchar [note: 'Primary telephone number for reaching the TPA business contact.']
  reserve_setting_authority boolean [note: 'Indicates whether the TPA has authority to establish and adjust loss reserves.']
  service_scope_description varchar [note: 'Detailed description of the claims administration and related services provided by the TPA.']
  sla_response_time_hours varchar [note: 'Contractual maximum hours the TPA has to respond to new claim assignments or inquiries.']
  specialization_lines varchar [note: 'Comma-separated list of insurance lines of business the TPA specializes in handling.']
  standard_fee_amount decimal(18,2) [note: 'Standard fee charged by the TPA per claim or per period based on the fee structure type.']
  state_province varchar [note: 'State or province code where the TPA business is located.']
  tax_identification_number varchar [note: 'Federal tax identification number or employer identification number for the TPA entity.']
  tpa_code varchar [note: 'Unique alphanumeric business identifier code assigned to the TPA for operational reference.']
  tpa_name varchar [note: 'Legal business name of the third-party administrator organization.']
  tpa_status varchar [note: 'Current operational status of the TPA relationship.']
  tpa_type varchar [note: 'Classification of the TPA based on the scope of services provided.']
  updated_timestamp timestamp [note: 'Date and time when the TPA record was last modified in the system.']
  website_url varchar [note: 'Public website address of the TPA organization.']

  Note: 'Master reference table for tpa. Referenced by tpa_id.'
}

Table claims.attorney {
  attorney_id varchar [pk, note: 'Primary key for attorney']
  address_line_1 varchar [note: 'Primary street address line for the attorney office location.']
  address_line_2 varchar [note: 'Secondary address line for suite, floor, or building information.']
  attorney_status varchar [note: 'Current status of the attorney in relation to the insurer and bar association standing.']
  attorney_type varchar [note: 'Classification of the attorney role in relation to the insurer: defense counsel, plaintiff counsel, coverage counsel, panel attorney, or independent.']
  bar_admission_date date [note: 'Date when the attorney was admitted to the bar and licensed to practice law.']
  bar_number varchar [note: 'Unique bar association registration number issued to the attorney by the state licensing authority.']
  bar_state varchar [note: 'State or jurisdiction where the attorney is admitted to practice law.']
  city varchar [note: 'City where the attorney office is located.']
  country_code varchar [note: 'Three-letter ISO country code for the attorney office location.']
  created_timestamp timestamp [note: 'Timestamp when the attorney record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for the attorney billing rate.']
  email_address varchar [note: 'Primary email address for professional communication with the attorney.']
  fax_number varchar [note: 'Fax number for transmitting legal documents to the attorney.']
  first_name varchar [note: 'First or given name of the attorney.']
  full_name varchar [note: 'Complete legal name of the attorney as registered with the bar association.']
  hourly_rate decimal(15,2) [note: 'Standard hourly billing rate charged by the attorney for legal services.']
  last_name varchar [note: 'Last name or surname of the attorney.']
  law_firm_name varchar [note: 'Name of the law firm or legal practice with which the attorney is affiliated.']
  middle_name varchar [note: 'Middle name or initial of the attorney.']
  mobile_number varchar [note: 'Mobile phone number for urgent or after-hours contact with the attorney.']
  notes varchar [note: 'Free-form notes regarding the attorney relationship, performance, or special handling instructions.']
  panel_effective_date date [note: 'Date when the attorney was added to the insurer defense panel.']
  panel_member_flag boolean [note: 'Indicates whether the attorney is a member of the insurer approved defense panel.']
  panel_termination_date date [note: 'Date when the attorney was removed from the insurer defense panel.']
  phone_number varchar [note: 'Primary business phone number for contacting the attorney.']
  postal_code varchar [note: 'Postal or ZIP code for the attorney office location.']
  preferred_contact_method varchar [note: 'Preferred method for contacting the attorney for routine communications.']
  specialty varchar [note: 'Primary area of legal specialization such as personal injury, workers compensation, property damage, liability, or subrogation.']
  state_province varchar [note: 'State or province where the attorney office is located and where the attorney is licensed to practice.']
  suffix varchar [note: 'Professional or generational suffix appended to the attorney name.']
  tax_number varchar [note: 'Tax identification number for the attorney or law firm used for payment processing and tax reporting.']
  updated_timestamp timestamp [note: 'Timestamp when the attorney record was last modified.']

  Note: 'Master reference table for attorney. Referenced by attorney_id.'
}

Table reservespayments.reservespayments_loss_reserve {
  reservespayments_loss_reserve_id varchar [pk, note: 'Unique surrogate identifier for each loss reserve record. Primary key for the reservespayments_loss_reserve product.']
  adjuster_id varchar [note: 'Reference to the claims adjuster responsible for setting and maintaining the case reserve. Links to the adjuster/party master.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Loss reserves for CAT events need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  claim_coverage_id varchar [note: 'Foreign key linking to claims.claim_coverage. Business justification: Reserve establishment in P&C is coverage-specific (BI reserve vs PD reserve). Adjusters set reserves at coverage level for Schedule P reporting, reinsurance allocation, and coverage']
  claim_id varchar [note: 'Reference to the claim for which this loss reserve is established. Links reserve to the originating claim event.']
  coverage_policy_coverage_id varchar [note: 'Reference to the specific coverage part under which the loss reserve is held, enabling per-coverage reserve tracking.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reserve amounts in multi-currency operations require proper currency reference for financial consolidation, statutory reporting, and FX risk management.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Entity-level reserve aggregation is required for experience rating, loss runs, large deductible programs, retrospective rating plans, and renewal underwriting decisions across all']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Loss reserves for property claims must link to specific locations for actuarial analysis, cat modeling, territorial rate adequacy studies, and Schedule P reporting by location']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto physical damage reserves require vehicle linkage for total loss determination, salvage valuation, subrogation demand calculation, and vehicle-level loss history for renewal']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Loss reserves must be classified by LOB for statutory reporting, rate adequacy analysis, reinsurance treaty application, and management reporting. Lob_code denormalizes LOB master.']
  policy_id varchar [note: 'Reference to the policy under which the claim and reserve are established. Supports LOB segmentation and reserve adequacy analysis.']
  risk_unit_id varchar [note: 'Foreign key linking to riskexposure.risk_unit. Business justification: Reserves are established and tracked at the risk unit level to calculate accurate loss ratios, support rate adequacy analysis, and enable granular actuarial segmentation by class and']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Loss reserves must track jurisdictional state for statutory reporting, guaranty fund assessments, Schedule P filings, and state-specific reserve adequacy analysis.']
  accident_year varchar [note: 'Calendar year in which the loss event (Date of Loss) occurred. Primary dimension for loss development triangles and actuarial analysis.']
  actuarial_segment_code varchar [note: 'Code identifying the actuarial homogeneous risk segment to which this reserve belongs for loss development triangle construction.']
  alae_reserve_amount decimal(18,2) [note: 'Reserve for Allocated Loss Adjustment Expenses (ALAE) directly attributable to this claim, such as defense and cost containment expenses.']
  cat_event_indicator boolean [note: 'Indicates whether this reserve is associated with a declared catastrophe (CAT) event. Enables CAT loss aggregation and PML reporting.']
  created_timestamp timestamp [note: 'Timestamp when this loss reserve record was first created in the system. Audit trail for reserve establishment and data lineage.']
  current_reserve_amount decimal(18,2) [note: 'Current gross Outstanding Case Reserve (OCR) balance as of the valuation date, reflecting all adjustments since establishment.']
  date_of_loss date [note: 'Date on which the insured loss event occurred. Foundational field for accident-year segmentation and coverage trigger determination.']
  ibner_amount decimal(18,2) [note: 'Reserve for development on known claims where current case reserves are estimated to be inadequate (IBNER). Supplements OCR.']
  ibnr_amount decimal(18,2) [note: 'Actuarially estimated reserve for claims Incurred But Not Reported (IBNR) as of the valuation date. Allocated at LOB or segment level.']
  incurred_loss_amount decimal(18,2) [note: 'Total incurred loss = paid losses to date + current case reserve. Fundamental metric for loss ratio and reserve adequacy analysis.']
  initial_reserve_amount decimal(18,2) [note: 'Gross case reserve amount set at the time the reserve was first established. Baseline for reserve development and adequacy tracking.']
  large_loss_indicator boolean [note: 'Flags reserves exceeding the company-defined large loss threshold. Triggers enhanced management review and reinsurance notification.']
  large_loss_threshold_amount decimal(18,2) [note: 'Dollar threshold above which a reserve is classified as a large loss. Defined per LOB or treaty and used to trigger escalation workflows.']
  last_reserve_change_date date [note: 'Date of the most recent reserve adjustment. Supports reserve development tracking and adjuster activity monitoring.']
  litigation_indicator boolean [note: 'Indicates whether the claim associated with this reserve is in active litigation. Litigation claims typically carry higher ALAE reserves.']
  net_reserve_amount decimal(18,2) [note: 'Net reserve after deducting reinsurance recoverables, salvage, and subrogation from gross reserve. Represents retained risk exposure.']
  paid_alae_to_date decimal(18,2) [note: 'Cumulative ALAE payments made to date for this claim. Combined with paid losses to compute total incurred including LAE.']
  paid_losses_to_date decimal(18,2) [note: 'Cumulative gross loss payments made against this claim as of the valuation date. Used to compute incurred losses and reserve development.']
  policy_year varchar [note: 'Year in which the policy that generated the claim was written or incepted. Used for policy-year loss development analysis.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'Estimated reinsurance recoverable on unpaid losses ceded under treaty or facultative (FAC) arrangements as of the valuation date.']
  report_year varchar [note: 'Calendar year in which the claim was first reported to the insurer (FNOL year). Used for report-year development triangles.']
  reserve_adequacy_status varchar [note: 'Actuarial or adjuster assessment of whether the current reserve is adequate, deficient, or redundant relative to ultimate loss estimate.']
  reserve_change_reason varchar [note: 'Narrative or coded reason for the most recent reserve adjustment (e.g., new medical information, litigation update, coverage determination). [ENUM-REF-CANDIDATE: promote to reference product]']
  reserve_closed_date date [note: 'Date the reserve was closed or released to zero. Null if reserve remains open. Used for reserve development and closure analysis.']
  reserve_established_date date [note: 'Date the initial case reserve was first established following FNOL or claim adjudication. Principal business event date for the reserve lifecycle.']
  reserve_method varchar [note: 'Method used to establish or develop the reserve: case-by-case adjuster estimate, formula-based, actuarial bulk, or tabular method.']
  reserve_number varchar [note: 'Externally-known business identifier for the reserve record, used in bordereaux, actuarial reports, and statutory filings.']
  reserve_status varchar [note: 'Current lifecycle state of the loss reserve record. Drives reserve adequacy monitoring and statutory reporting workflows.']
  reserve_type varchar [note: 'Classification of the reserve: Outstanding Case Reserve (OCR), IBNR, IBNER, ALAE, ULAE, salvage, or subrogation. [ENUM-REF-CANDIDATE: case|ibnr|ibner|ulae|alae|salvage|subrogation — promote to reference product]']
  salvage_reserve_amount decimal(18,2) [note: 'Estimated recoverable amount from salvage of damaged property. Offsets gross reserve for net reserve reporting.']
  stat_line_code varchar [note: 'NAIC statutory line of business code used for Schedule P and other statutory filings. Maps to NAIC Annual Statement line definitions.']
  subrogation_reserve_amount decimal(18,2) [note: 'Estimated recoverable amount through subrogation rights against liable third parties. Reduces net reserve and improves loss ratio.']
  ulae_reserve_amount decimal(18,2) [note: 'Reserve for Unallocated Loss Adjustment Expenses (ULAE) not directly tied to a specific claim, allocated proportionally from company-wide estimates.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this loss reserve record. Supports incremental data loading and audit trail requirements.']
  valuation_date date [note: 'Accounting period end date as of which the reserve balance is measured. Aligns with statutory and GAAP reporting periods.']

  Note: 'SSOT for case reserves (OCR) established per claim. Tracks initial reserve, current reserve, IBNR allocation, IBNER adjustments, ALAE/ULAE splits, and reserve adequacy status per line of business.'
}

Table reservespayments.reservespayments_reserve_transaction {
  reservespayments_reserve_transaction_id varchar [pk, note: 'Unique surrogate identifier for each reserve transaction record in the loss reserve ledger.']
  adjuster_id varchar [note: 'Reference to the claims adjuster who authorized or initiated this reserve transaction.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Reserve transactions for CAT events need proper FK linkage to cat_event master. The cat_code string becomes redundant when FK allows JOIN.']
  claim_id varchar [note: 'Reference to the claim against which this reserve transaction is posted.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reserve transaction amounts require currency reference for GL posting, multi-currency accounting, and financial reporting. Replaces denormalized currency_code with proper FK.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Reserve development transactions must link to locations for cat event analysis, territorial loss trend monitoring, and location-specific reserve adequacy reviews required for']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Reserve transactions require LOB classification for GL posting, statutory reporting, and management analysis. Lob_code denormalizes LOB master data.']
  reservespayments_loss_reserve_id varchar [note: 'Reference to the parent loss reserve record that this transaction adjusts.']
  reversed_transaction_reservespayments_reserve_transaction_id varchar [note: 'Reference to the original reserve transaction that this entry reverses, enabling full audit chain reconstruction.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Reserve transactions require state reference for GL allocation, statutory reporting by jurisdiction, and state-specific accounting rules. State_code denormalizes state master.']
  accident_year varchar [note: 'The calendar year in which the loss event occurred, used for actuarial loss development triangles and IBNR estimation.']
  authorization_date date [note: 'The date on which the reserve transaction was formally authorized by the approving authority.']
  authorization_level varchar [note: 'The authority level required and applied to approve this reserve transaction per the insurer\'s reserve authority matrix.']
  claim_office_code varchar [note: 'Internal code identifying the claims handling office or unit responsible for managing the claim associated with this reserve.']
  cost_center_code varchar [note: 'Financial cost center to which this reserve transaction is allocated for management accounting and expense reporting.']
  coverage_type varchar [note: 'The specific coverage component to which this reserve applies (e.g., BI, PD, UM, UIM, PIP, MedPay, ALAE). [ENUM-REF-CANDIDATE: BI|PD|UM|UIM|PIP|MedPay|ALAE|GL|APD — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this reserve transaction record was first created in the system, used for audit trail and data lineage.']
  date_of_loss date [note: 'The Date of Loss (DOL) for the underlying claim, used for accident-year actuarial development triangles.']
  delta_amount decimal(18,2) [note: 'The signed change in reserve amount for this transaction. Positive values indicate an increase; negative values indicate a decrease or release.']
  effective_date date [note: 'The accounting effective date for this reserve movement, which may differ from transaction date for period-end adjustments.']
  gl_account_code varchar [note: 'The General Ledger (GL) account code to which this reserve transaction is posted in the financial ledger.']
  is_cat_event boolean [note: 'Indicates whether this reserve transaction is associated with a declared Catastrophe (CAT) event, enabling CAT-specific reserve aggregation.']
  net_reserve_delta decimal(18,2) [note: 'Reserve delta net of reinsurance recoverables, representing the insurer\'s retained exposure change for this transaction.']
  policy_number varchar [note: 'The policy number under which the claim and reserve are recorded, supporting statutory reporting by policy.']
  policy_year varchar [note: 'The year in which the policy was written, used for policy-year actuarial development and statutory reporting.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'The portion of this reserve delta expected to be recovered from reinsurers under treaty or facultative (FAC) arrangements.']
  report_year varchar [note: 'The calendar year in which the claim was first reported to the insurer, used for report-year actuarial triangles.']
  reserve_amount_after decimal(18,2) [note: 'Outstanding Case Reserve (OCR) balance immediately after this transaction is applied, representing the current reserve position.']
  reserve_amount_before decimal(18,2) [note: 'Outstanding Case Reserve (OCR) balance immediately prior to this transaction, enabling point-in-time reserve reconstruction.']
  reserve_close_date date [note: 'The date on which the reserve was closed to zero, populated only for CLOSE transaction types. Null for all other transaction types.']
  reserve_type varchar [note: 'Categorizes the reserve component: Loss (indemnity), Allocated Loss Adjustment Expense (ALAE), Unallocated LAE (ULAE), Incurred But Not Reported (IBNR), or IBNER. [ENUM-REF-CANDIDATE: LOSS|ALAE|ULAE|IBNR|IBNER|SUBROGATION — promote to reference product]']
  reversal_indicator boolean [note: 'Indicates whether this transaction is a reversal of a previously posted reserve entry, used for audit and reconciliation.']
  source_system_code varchar [note: 'Identifies the operational system of record that originated this reserve transaction (e.g., Guidewire ClaimCenter, Duck Creek, Milliman Arius).']
  source_transaction_ref varchar [note: 'The native transaction identifier from the originating system of record, enabling traceability back to the source.']
  stat_line_code varchar [note: 'NAIC statutory line of business code used for Annual Statement Schedule P and Schedule F reserve reporting.']
  transaction_date date [note: 'The business date on which the reserve movement was recorded, used for period-end reserve reporting and actuarial triangles.']
  transaction_number varchar [note: 'Externally visible business identifier for this reserve transaction, used in bordereaux and statutory reporting.']
  transaction_reason_code varchar [note: 'Coded reason for the reserve movement (e.g., new information, litigation update, settlement negotiation, CAT event). [ENUM-REF-CANDIDATE: NEW_INFO|LITIGATION|SETTLEMENT|CAT|COVERAGE_CHANGE|SUBROGATION|AUDIT — promote to reference product]']
  transaction_reason_notes varchar [note: 'Free-text narrative provided by the adjuster explaining the business rationale for this reserve movement.']
  transaction_status varchar [note: 'Current workflow state of the reserve transaction within the claims reserving system.']
  transaction_timestamp timestamp [note: 'Precise date and time the reserve transaction was entered into the claims system, supporting audit trail and intraday reconciliation.']
  transaction_type varchar [note: 'Classifies the nature of the reserve movement: initial set, upward development, downward development, closure, or reopening.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this reserve transaction record, supporting audit trail and change tracking.']

  Note: 'Transactional ledger of every reserve movement (set, increase, decrease, close) against a loss reserve. Captures transaction date, amount delta, reserve type (loss vs ALAE), and authorizing adjuster.'
}

Table reservespayments.ibnr_estimate {
  ibnr_estimate_id varchar [pk, note: 'Unique surrogate primary key for the IBNR estimate record. Role: TRANSACTION_HEADER.']
  actuarial_analyst_id varchar [note: 'Reference to the internal party record of the credentialed actuary or actuarial analyst responsible for preparing and signing off on this IBNR estimate.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: IBNR estimates for catastrophe events need proper FK linkage to cat_event master. The cat_code string becomes redundant when FK allows JOIN to cat_event.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Actuarial IBNR estimates require currency specification for statutory reserve filings, actuarial opinions, and multi-currency consolidation. Currency_code is denormalized reference.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: IBNR estimates for property lines require location-level exposure data (TIV, construction type, cat zone) for actuarial projections and to support territorial reserve adequacy']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: IBNR estimates are calculated and reported by line of business for actuarial analysis, statutory filings, and reserve adequacy. Replaces lob_code denormalization.']
  reserve_study_id varchar [note: 'Reference to the actuarial reserve study or analysis run that produced this IBNR estimate.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: State-level IBNR estimates are required for Schedule P statutory filings, state rate adequacy analysis, and regulatory reserve requirements. State_code is denormalized.']
  user_account_id varchar [note: 'Reference to the internal party record of the Appointed Actuary or senior reviewer who approved this IBNR estimate for statutory filing or financial reporting.']
  accident_year varchar [note: 'The calendar year in which the insured loss events are deemed to have occurred, used as the primary actuarial development dimension for IBNR triangles.']
  actuarial_method varchar [note: 'Primary actuarial method used to derive this estimate (e.g., Chain Ladder, Bornhuetter-Ferguson, Cape Cod, Clark LDF, Frequency-Severity). [ENUM-REF-CANDIDATE']
  actuarial_notes varchar [note: 'Free-text field for actuarial commentary, methodology rationale, data anomalies, or qualitative judgments supporting the IBNR estimate, as required by ASOP No. 43.']
  approval_timestamp timestamp [note: 'Date and time when the IBNR estimate was formally approved by the Appointed Actuary or designated reviewer, marking readiness for statutory filing.']
  case_reserve_amount decimal(18,2) [note: 'Total outstanding case reserves held on open claims for the LOB and accident year as of the evaluation date, representing the known but unpaid loss liability.']
  ceded_reserve_amount decimal(18,2) [note: 'Portion of the IBNR reserve ceded to reinsurers under applicable treaty and facultative agreements, equal to gross minus net reserve amounts.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level (as a percentage, e.g., 75.00 for 75th percentile) at which the IBNR estimate is stated, per actuarial range analysis or stochastic modeling.']
  created_timestamp timestamp [note: 'Date and time when this IBNR estimate record was first created in the data platform, used for audit trail and data lineage tracking.']
  data_source_system varchar [note: 'Name of the actuarial reserving or source system from which this IBNR estimate was extracted (e.g., Milliman Arius, Willis Towers Watson ResQ, Snowflake).']
  development_age_months varchar [note: 'Age of the accident year in months as of the evaluation date, representing the maturity point on the actuarial loss development triangle (e.g., 12, 24, 36, 48).']
  earned_premium_amount decimal(18,2) [note: 'Gross earned premium for the LOB and accident year used as the denominator in loss ratio calculations and as the exposure base for actuarial methods.']
  estimate_reference_number varchar [note: 'Externally-known alphanumeric identifier for this actuarial bulk-reserve estimate, used in bordereaux, statutory filings, and actuarial reports.']
  estimate_status varchar [note: 'Current lifecycle state of the IBNR estimate record within the actuarial review and approval workflow.']
  evaluation_date date [note: 'The as-of date through which loss data was compiled and the IBNR estimate was evaluated, typically a quarter-end or year-end statutory date.']
  expected_loss_ratio decimal(8,5) [note: 'A priori expected loss ratio used as the initial expected loss assumption in Bornhuetter-Ferguson and Cape Cod actuarial methods for this LOB and accident year.']
  filing_period varchar [note: 'Statutory reporting period for which this IBNR estimate is prepared, formatted as Q1-YYYY, Q2-YYYY, Q3-YYYY, Q4-YYYY, or ANNUAL-YYYY.']
  high_estimate_amount decimal(18,2) [note: 'Upper bound of the actuarial range of reasonable IBNR estimates, typically corresponding to a higher confidence percentile or adverse scenario.']
  ibner_amount decimal(18,2) [note: 'Actuarial IBNER reserve amount representing development on known open claims that are expected to develop beyond current case reserves as of the evaluation date.']
  ibnr_amount decimal(18,2) [note: 'Gross actuarial IBNR reserve amount in the reporting currency, representing estimated ultimate losses for claims not yet reported as of the evaluation date.']
  is_cat_estimate boolean [note: 'Indicates whether this IBNR estimate is specifically associated with a catastrophe event. True when cat_code is populated and the estimate is CAT-segregated.']
  ldf_selected decimal(10,6) [note: 'Actuarially selected cumulative loss development factor (tail factor) applied to reported or paid losses to project to ultimate for this accident year and evaluation age.']
  lob_name varchar [note: 'Human-readable name of the Line of Business corresponding to lob_code (e.g., Commercial General Liability, Workers Compensation, Auto Physical Damage).']
  low_estimate_amount decimal(18,2) [note: 'Lower bound of the actuarial range of reasonable IBNR estimates, typically corresponding to a lower confidence percentile or optimistic scenario.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the legal insurance entity for which this IBNR estimate is reported in statutory filings.']
  net_of_reinsurance_amount decimal(18,2) [note: 'IBNR reserve amount net of reinsurance recoveries, reflecting the retained liability after cession under quota share, XOL, and facultative treaties.']
  paid_losses_amount decimal(18,2) [note: 'Cumulative loss payments made for the LOB and accident year as of the evaluation date, used as the paid loss diagonal in actuarial development triangles.']
  percent_unreported decimal(8,5) [note: 'Estimated proportion of ultimate losses not yet reported as of the evaluation date, derived as 1 minus the inverse of the selected cumulative LDF.']
  prior_period_reserve_amount decimal(18,2) [note: 'Total bulk reserve amount from the immediately preceding evaluation period for the same LOB and accident year, used to compute reserve development and redundancy/deficiency.']
  reported_losses_amount decimal(18,2) [note: 'Cumulative paid losses plus outstanding case reserves (OCR) for the LOB and accident year as of the evaluation date, forming the reported diagonal of the loss triangle.']
  reserve_development_amount decimal(18,2) [note: 'Change in total reserve from prior period to current evaluation date (current minus prior). Positive indicates adverse development; negative indicates favorable development.']
  reserve_type varchar [note: 'Classifies the actuarial bulk reserve component: IBNR (Incurred But Not Reported), IBNER (Incurred But Not Enough Reported), ULAE, ALAE, OCR, or TOTAL.']
  statutory_basis varchar [note: 'Accounting basis under which this IBNR estimate is prepared: SAP (Statutory Accounting Principles), GAAP (US Generally Accepted Accounting Principles), or IFRS 17.']
  total_reserve_amount decimal(18,2) [note: 'Sum of IBNR, IBNER, and ULAE reserve amounts representing the total actuarial bulk reserve position for this LOB, accident year, and evaluation date.']
  ulae_amount decimal(18,2) [note: 'Actuarial bulk reserve for Unallocated Loss Adjustment Expenses not directly assignable to individual claims, estimated as a loading on IBNR and IBNER.']
  ultimate_loss_amount decimal(18,2) [note: 'Actuarially projected ultimate incurred loss amount for the LOB and accident year, equal to reported losses plus IBNR plus IBNER.']
  ultimate_loss_ratio decimal(8,5) [note: 'Actuarially estimated ultimate loss ratio for this LOB and accident year as of the evaluation date, computed as ultimate losses divided by earned premium.']
  updated_timestamp timestamp [note: 'Date and time when this IBNR estimate record was last modified in the data platform, supporting audit trail, change tracking, and incremental load processing.']

  Note: 'Actuarial bulk-reserve SSOT for IBNR, IBNER, and unallocated ULAE positions by LOB, accident year, and evaluation date, with optional CAT-code tagging.'
}

Table reservespayments.reserve_evaluation {
  reserve_evaluation_id varchar [pk, note: 'Unique surrogate identifier for each periodic actuarial reserve evaluation record. Primary key for the reserve_evaluation data product in the reservespayments domain.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Reserve evaluations for CAT events need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Reserve evaluations for actuarial opinions and regulatory filings require proper currency reference for Schedule P and international operations. Replaces currency_code denormalization.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Actuarial reserve evaluations and Schedule P reporting require entity-level aggregation for large account analysis, self-insured retention programs, and appointed actuary opinions']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Reserve evaluations segment by LOB for actuarial opinions, rate filing support, and regulatory reserve requirements. Lob_code is denormalized.']
  reserve_study_id varchar [note: 'Foreign key linking to reservespayments.reserve_study. Business justification: Reserve evaluations are produced as part of a reserve study and should reference the underlying study for analytical lineage.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Reserve evaluations must segment by state for regulatory filings, actuarial opinions, rate adequacy testing, and state-specific reserve requirements. Replaces state_code denormalization.']
  accident_year varchar [note: 'The calendar year in which the insured loss events occurred. Used as the primary axis for loss development triangles and NAIC Schedule P accident-year exhibits.']
  accounting_basis varchar [note: 'The accounting framework under which reserves are stated: SAP (Statutory Accounting Principles), US GAAP, or IFRS 17. Determines reserve measurement and disclosure requirements.']
  actuarial_opinion_reference varchar [note: 'Reference identifier or document number for the Appointed Actuary\'s Statement of Actuarial Opinion (SAO) that covers this reserve evaluation. Links to document management system.']
  alae_reserve_amount decimal(18,2) [note: 'Reserve for Allocated Loss Adjustment Expenses directly attributable to specific claims, such as defense costs and expert fees. Reported separately per NAIC Schedule P.']
  appointed_actuary_credential varchar [note: 'Professional credential of the Appointed Actuary (e.g., FCAS, MAAA). Required for NAIC actuarial opinion qualification and state DOI regulatory filings.']
  appointed_actuary_name varchar [note: 'Full name of the Appointed Actuary who signed the Statement of Actuarial Opinion for this reserve evaluation, as required by NAIC Model Law.']
  cat_reserve_amount decimal(18,2) [note: 'Portion of the total reserve attributable to catastrophe (CAT) events as designated by ISO/PCS or internal CAT codes. Reported separately for NAIC CAT exhibits and reinsurance recoverable analysis.']
  company_naic_code varchar [note: 'Five-digit NAIC company code identifying the legal insurance entity for which reserves are evaluated. Required for statutory filings and Schedule P exhibits.']
  created_timestamp timestamp [note: 'Timestamp when this reserve evaluation record was first created in the data platform. Supports audit trail, SOX compliance, and data lineage tracking.']
  ep_amount decimal(18,2) [note: 'Gross earned premium for the accident year and LOB as of the evaluation date. Denominator for ULR and LR calculations in actuarial reserve adequacy testing.']
  evaluation_date date [note: 'The as-of date for which loss reserves are evaluated, typically the last day of the reporting quarter or year-end. Anchors all reserve positions and development triangles.']
  evaluation_period_type varchar [note: 'Indicates whether this evaluation is a quarterly, annual, interim, or special (e.g., CAT event-driven) reserve review cycle.']
  evaluation_reference_number varchar [note: 'Externally-known alphanumeric identifier assigned to this reserve evaluation cycle, used in actuarial opinion filings, NAIC Schedule P submissions, and bordereaux reporting.']
  evaluation_status varchar [note: 'Current workflow state of the reserve evaluation, from initial draft through actuarial sign-off, management approval, and statutory filing. Drives sign-off and audit controls.']
  gross_case_reserve_amount decimal(18,2) [note: 'Total gross (before reinsurance) outstanding case reserve amount as of the evaluation date, representing the estimated liability for known reported claims. Expressed in USD.']
  gross_ibner_amount decimal(18,2) [note: 'Gross IBNER component of the total IBNR reserve, representing development on known claims where current case reserves are estimated to be inadequate.']
  gross_ibnr_amount decimal(18,2) [note: 'Gross IBNR reserve amount as of the evaluation date, covering losses incurred but not yet reported to the insurer. Includes pure IBNR and IBNER components.']
  gross_total_reserve_amount decimal(18,2) [note: 'Sum of gross case reserves and gross IBNR/IBNER as of the evaluation date. Represents the total gross reserve position before reinsurance recoverables.']
  incurred_losses_to_date decimal(18,2) [note: 'Cumulative gross incurred losses (paid plus case reserves) as of the evaluation date for the accident year and LOB. Primary input to the Bornhuetter-Ferguson and chain-ladder methods.']
  lob_description varchar [note: 'Human-readable description of the Line of Business corresponding to lob_code, such as \'Commercial General Liability\' or \'Workers Compensation\'.']
  loss_ratio decimal(8,4) [note: 'Ratio of incurred losses to earned premium as of the evaluation date. Distinct from ULR in that it uses incurred-to-date rather than ultimate estimates. Used in combined ratio reporting.']
  net_case_reserve_amount decimal(18,2) [note: 'Net (after reinsurance cession) outstanding case reserve amount as of the evaluation date. Reflects the insurer\'s retained liability on known reported claims.']
  net_ibnr_amount decimal(18,2) [note: 'Net IBNR reserve amount after reinsurance recoverables as of the evaluation date. Used for net reserve adequacy testing and statutory surplus calculations.']
  net_total_reserve_amount decimal(18,2) [note: 'Total net reserve position (case + IBNR) after reinsurance recoverables as of the evaluation date. Key metric for statutory surplus and solvency reporting.']
  opinion_type varchar [note: 'The type of actuarial opinion rendered on reserve adequacy: reasonable, deficient, excessive, qualified, or no opinion. Directly reported in NAIC statutory filings.']
  paid_losses_to_date decimal(18,2) [note: 'Cumulative gross losses paid from policy inception through the evaluation date for the accident year and LOB. Used as the base for loss development triangle construction.']
  policy_year varchar [note: 'The year in which the policies generating the evaluated losses were written or incepted. Supports policy-year loss development analysis alongside accident-year triangles.']
  prior_evaluation_date date [note: 'The as-of date of the immediately preceding reserve evaluation for the same accident year and LOB. Used to compute period-over-period reserve development.']
  reserve_basis varchar [note: 'The basis on which reserves are evaluated and triangles are constructed: accident year, policy year, report year, or calendar year. Determines triangle structure for Schedule P.']
  reserve_development_amount decimal(18,2) [note: 'Change in total reserve estimate from the prior evaluation period to the current evaluation date. Positive indicates adverse development; negative indicates favorable development.']
  reserving_system_source varchar [note: 'The actuarial reserving system from which this evaluation record was sourced (e.g., Milliman Arius, Willis Towers Watson ResQ). Supports data lineage and audit traceability.']
  ri_recoverable_amount decimal(18,2) [note: 'Estimated reinsurance recoverable on unpaid losses and LAE as of the evaluation date. Equals gross total reserve minus net total reserve. Reported on NAIC Schedule F.']
  schedule_p_line varchar [note: 'The specific NAIC Schedule P line (e.g., Line 1 - Homeowners, Line 5 - CGL) to which this reserve evaluation maps for statutory annual statement filing purposes.']
  ulae_reserve_amount decimal(18,2) [note: 'Reserve for Unallocated Loss Adjustment Expenses not directly tied to individual claims, such as general claims department overhead. Estimated via Kittel or similar methods.']
  ulr decimal(8,4) [note: 'Ratio of the actuarial ultimate loss estimate to earned premium for the accident year and LOB. Key actuarial adequacy metric: ULR = ultimate_loss_estimate / ep_amount.']
  ultimate_loss_estimate decimal(18,2) [note: 'Actuarially estimated ultimate loss amount for the accident year and LOB as of the evaluation date. Derived from loss development methods (chain-ladder, BF, Cape Cod).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this reserve evaluation record. Used for incremental data loads, change tracking, and audit compliance in the Databricks Silver layer.']

  Note: 'Periodic actuarial reserve evaluation SSOT (quarterly/annual): gross and net reserve positions, ULR/loss ratio, embedded loss development triangles, actuarial opinion reference, and NAIC Schedule P / state DOI statutory exhibits, signed off for statutory'
}

Table reservespayments.reservespayments_claim_payment {
  reservespayments_claim_payment_id varchar [pk, note: 'Unique surrogate primary key for the claim-payment junction record. Identifies a single allocation of a payment to a specific claim and coverage part.']
  adjuster_id varchar [note: 'Reference to the claims adjuster responsible for this payment allocation. Links to the employee or vendor adjuster record for workload and performance reporting.']
  claim_id varchar [note: 'Foreign key reference to the parent claim record. Links the payment allocation to the specific loss event being indemnified.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Claim payment amounts require currency reference for international claims, FX conversion, bank reconciliation, and financial reporting. Currency_code denormalizes currency master.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Entity-level payment history drives experience modification calculations, loss-sensitive pricing adjustments, dividend calculations, and large deductible program reconciliation']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Claim payments must be allocated to specific locations to calculate territorial loss costs, support rate filings, analyze loss patterns by construction type, and reconcile cat']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto claim payments require vehicle linkage for total loss settlement validation, salvage proceeds reconciliation, and vehicle-level loss history tracking for renewal rating and']
  part_id varchar [note: 'Reference to the specific coverage part (e.g., BI, PD, MedPay, PIP, ALAE) under which this payment allocation is made. Drives statutory and financial reporting.']
  payee_id varchar [note: 'Reference to the party record of the payment recipient. Links to the party master for payee name, tax ID, and address used on the disbursement instrument.']
  user_account_id varchar [note: 'Reference to the employee or adjuster who approved this payment allocation. Required for claims authority audit trail and SOX segregation-of-duties compliance.']
  accident_year varchar [note: 'Four-digit calendar year in which the loss event occurred. Primary dimension for actuarial loss development triangles and IBNR reserve estimation per NAIC Schedule P.']
  accounting_date date [note: 'Date on which this payment allocation is recognized in the general ledger. May differ from payment_date due to period-end cutoffs and accrual adjustments.']
  allocated_gross_amount decimal(18,2) [note: 'Gross dollar amount of the payment allocated to this claim and coverage part before deducting recoveries, SIR, or deductibles. Basis for GWP loss ratio calculations.']
  allocation_number varchar [note: 'Human-readable business identifier for this claim-payment allocation line. Used in bordereaux, adjuster notes, and payment reconciliation reports.']
  approval_status varchar [note: 'Workflow approval state for this payment allocation. Payments above authority thresholds require supervisor or management approval before disbursement per SOX controls.']
  approval_timestamp timestamp [note: 'Date and time the payment allocation was approved by the authorized approver. Supports SOX audit trail and claims payment timeliness regulatory reporting.']
  bank_clearance_date date [note: 'Date the payment instrument cleared the issuing bank account. Confirms actual cash outflow for treasury management and outstanding check reconciliation.']
  cat_event_code varchar [note: 'ISO or internal CAT event identifier linking this payment to a declared catastrophe (e.g., hurricane, wildfire, flood). Enables CAT loss aggregation and PML reporting.']
  check_number varchar [note: 'Check number or EFT/wire reference number assigned by the bank or payment processor. Used for bank reconciliation, stop-payment requests, and audit trail.']
  cost_center_code varchar [note: 'Internal cost center to which this payment is attributed for management accounting and expense allocation purposes. Supports departmental P&L reporting.']
  created_timestamp timestamp [note: 'Timestamp when this claim-payment junction record was first created in the system. Used for audit trail, data lineage, and SOX compliance.']
  deductible_offset_amount decimal(18,2) [note: 'Portion of the gross payment amount withheld or offset against the insured\'s applicable deductible or SIR for this coverage part. Reduces insurer net payment.']
  gl_account_code varchar [note: 'GL account code to which this payment allocation is posted in the financial ledger. Ensures correct statutory and GAAP financial statement classification.']
  is_cat_loss boolean [note: 'Flag indicating whether this payment is associated with a declared catastrophe event. Drives CAT XL reinsurance cession and regulatory CAT reporting.']
  is_large_loss boolean [note: 'Flag indicating whether this payment exceeds the insurer\'s large-loss threshold, triggering enhanced management review, facultative reinsurance consideration, and actuarial flagging.']
  lob_code varchar [note: 'NAIC or internal line-of-business code (e.g., HO, AUTO, GL, WC, CPP) classifying the policy under which this payment is made. Required for statutory Schedule P reporting.']
  loss_date date [note: 'Date on which the underlying loss event occurred. Denormalized here for statutory accident-year reporting and actuarial loss development triangle construction.']
  net_of_ri_amount decimal(18,2) [note: 'Net payment amount retained by the insurer after deducting reinsurance recoverables. Equals net_payment_amount minus reinsurance_recoverable_amount. Key NWP metric.']
  net_payment_amount decimal(18,2) [note: 'Net dollar amount paid on this allocation after subtracting recoveries, SIR, and deductible offsets. Equals allocated_gross_amount minus recovery_amount and deductible_offset_amount.']
  notes varchar [note: 'Free-text adjuster or examiner notes describing the basis for this payment allocation, coverage determination rationale, or special handling instructions.']
  payment_date date [note: 'Calendar date on which the payment was issued or disbursed to the payee. Used for cash-basis accounting, statutory reporting, and aging analysis.']
  payment_method varchar [note: 'Instrument used to disburse the payment: physical check, electronic funds transfer (EFT), wire transfer, bank draft, or virtual card. Used for treasury and AP reconciliation.']
  payment_status varchar [note: 'Current lifecycle state of this payment allocation. Tracks whether the disbursement is pending approval, issued, cleared by the bank, voided, stopped, or returned.']
  payment_type varchar [note: 'Categorizes the nature of the payment: indemnity (loss), ALAE, ULAE, MedPay, PIP, or recovery (subrogation/salvage). Drives statutory line-of-business reporting.']
  policy_year varchar [note: 'Four-digit year in which the policy that generated this claim was effective. Used for policy-year loss development analysis distinct from accident-year triangles.']
  recovery_amount decimal(18,2) [note: 'Dollar amount recovered via subrogation, salvage, or other recovery channels applied against this allocation. Reduces net loss incurred on the claim.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'Portion of the gross payment amount recoverable from reinsurers under applicable treaty or facultative (FAC) agreements. Used in cession bordereaux and NWP calculation.']
  report_date date [note: 'Date the claim was first reported to the insurer (FNOL date). Used for report-year loss development and IBNR actuarial analysis alongside the loss date.']
  reserve_type varchar [note: 'Identifies the reserve category this payment draws against: case reserve (OCR), IBNR, IBNER, ULAE reserve, or ALAE reserve. Drives actuarial reserve adequacy reporting.']
  salvage_amount decimal(18,2) [note: 'Dollar amount recovered through salvage of damaged property associated with this claim payment. Reduces net incurred loss and is reported separately in NAIC statutory filings.']
  subrogation_status varchar [note: 'Current status of subrogation pursuit for this payment allocation. Tracks whether a recovery opportunity has been identified, is being pursued, collected, or closed.']
  transaction_timestamp timestamp [note: 'Exact date and time the payment allocation transaction was recorded in the claims system. Serves as the principal business event timestamp for audit and reconciliation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this claim-payment junction record. Supports change data capture, audit trails, and incremental ETL processing.']
  void_date date [note: 'Date on which the payment was voided, if applicable. Null for active payments. Required for reissuance tracking and AP reconciliation under SOX controls.']
  void_reason varchar [note: 'Reason code explaining why the payment was voided. Supports audit, fraud detection, and reissuance workflows. Null when payment_status is not voided. [ENUM-REF-CANDIDATE: duplicate|stale|incorrect_payee|incorrect_amount|lost|reissued|other — 7 candidates']

  Note: 'Junction table for the many-to-many relationship between claims and payments. Captures payment allocation per claim, coverage part, payment type (indemnity, ALAE, MedPay, PIP), and net-of-recovery amount.'
}

Table reservespayments.payment_transaction {
  payment_transaction_id varchar [pk, note: 'Unique surrogate identifier for each outbound loss payment transaction record in the Silver layer lakehouse.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Payment transactions for CAT losses need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  claim_id varchar [note: 'Reference to the parent claim against which this payment is issued. Links payment to the claim adjudication lifecycle.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Payments must be allocated to specific coverages for GL accounting, Schedule P stat reporting by coverage type, and reinsurance recovery calculation.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Payment transactions require currency reference for GL posting, bank reconciliation, multi-currency operations, and financial consolidation. Replaces denormalized currency_code.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Large deductible programs, retrospective rating plans, and self-insured retention reconciliation require entity-level payment tracking to calculate premium adjustments and']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Payment transactions require location attribution for GL account posting, statutory reporting by state, territorial loss cost analysis, and cat event loss aggregation for']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto physical damage payments must reconcile to vehicle ACV, stated value, and loan/lease amounts; vehicle linkage enables total loss validation and salvage proceeds tracking.']
  original_payment_payment_transaction_id varchar [note: 'Self-referencing link to the original payment_transaction_id when this record is a reissue or replacement. Null for original payments.']
  payee_id varchar [note: 'Reference to the party (claimant, vendor, attorney, lienholder) receiving this payment. Satisfies PARTY_REFERENCE canonical category.']
  reservespayments_loss_reserve_id varchar [note: 'Reference to the case reserve line from which this payment is drawn, enabling reserve-to-payment reconciliation and OCR tracking.']
  accident_year varchar [note: 'Calendar year in which the loss event (DOL) occurred. Used for actuarial loss development triangles, IBNR estimation, and Schedule P reporting.']
  bank_account_number varchar [note: 'Payee bank account number for EFT or wire disbursement. Stored in tokenized or masked form per PCI DSS. Null for check payments.']
  bank_clearing_date date [note: 'Date the payment instrument cleared the issuing bank account. Used for cash management, bank reconciliation, and float analysis.']
  bank_routing_number varchar [note: 'ABA routing transit number of the payee financial institution for EFT or wire. Null for check payments.']
  check_number varchar [note: 'Physical or virtual check number printed on the instrument. Null for EFT and wire payments. Used for bank reconciliation and stop-payment processing.']
  cost_center_code varchar [note: 'Organizational cost center to which the payment expense is allocated. Used for departmental expense reporting and management accounting.']
  created_timestamp timestamp [note: 'Timestamp when this payment transaction record was first created in the source system. Satisfies RECORD_AUDIT_CREATED canonical category.']
  deduction_amount decimal(18,2) [note: 'Total amount withheld from gross payment for SIR offsets, deductibles, liens, or tax withholding before net disbursement to payee.']
  gl_account_code varchar [note: 'Oracle Financials or SAP FI GL account code to which this payment is posted. Enables financial close reconciliation and statutory balance sheet mapping.']
  gl_journal_reference varchar [note: 'Reference to the GL journal entry created in Oracle Financials or SAP FI for this payment. Supports audit trail and financial reconciliation.']
  gl_posting_date date [note: 'Date the payment was posted to the general ledger. May differ from payment_date due to period-end cutoff rules and accounting close schedules.']
  gross_amount decimal(18,2) [note: 'Total face value of the payment before any deductions, withholdings, or offsets. Represents the amount printed on the check or EFT instruction.']
  is_1099_reportable boolean [note: 'Indicates whether this payment must be reported to the IRS on Form 1099. Determined by payee type, payment type, and amount thresholds.']
  is_cat_loss boolean [note: 'Flags the payment as associated with a declared catastrophe event. Used for CAT loss aggregation, PML tracking, and CAT XL reinsurance recovery.']
  line_of_business_code varchar [note: 'NAIC line of business code classifying the insurance product line for this payment. Used in statutory Schedule P and combined ratio reporting.']
  loss_category varchar [note: 'Insurance loss category for statutory and GAAP reporting. Aligns with NAIC Schedule P loss development triangles and line-of-business reporting. [ENUM-REF-CANDIDATE: promote to reference product]']
  net_amount decimal(18,2) [note: 'Actual amount disbursed to the payee after all deductions. Equals gross_amount minus deduction_amount. Used for GL posting and cash management.']
  ofac_screening_status varchar [note: 'Result of OFAC SDN list screening for the payee prior to payment release. Blocked payments require compliance review before disbursement.']
  payee_tax_identification_number varchar [note: 'Federal tax identifier (SSN or FEIN) of the payee. Required for IRS 1099 reporting on claim payments exceeding statutory thresholds.']
  payee_type varchar [note: 'Classification of the payee role in the claim. Determines payment workflow, tax reporting (1099), and OFAC screening requirements. [ENUM-REF-CANDIDATE: promote to reference product]']
  payment_date date [note: 'Calendar date on which the payment was issued or authorized for disbursement. Principal business event date for statutory and GAAP loss reporting.']
  payment_method varchar [note: 'Instrument or channel used to disburse funds to the payee. Drives bank file format selection and reconciliation workflow.']
  payment_notes varchar [note: 'Free-text adjuster or AP notes describing special payment instructions, lien conditions, co-payee requirements, or other disbursement details.']
  payment_number varchar [note: 'Externally visible, human-readable payment reference number assigned at issuance. Used on check stubs, EFT remittance advice, and correspondence.']
  payment_status varchar [note: 'Current lifecycle state of the payment instrument. Tracks progression from draft through issuance, bank clearing, void, or reissue.']
  payment_type varchar [note: 'Categorizes the economic nature of the payment. Distinguishes indemnity from ALAE, ULAE, subrogation recovery, salvage, and other LAE components. [ENUM-REF-CANDIDATE: indemnity|alae|ulae|subrogation_recovery|salvage|medical|legal_fee|expert_fee — promote']
  policy_year varchar [note: 'Year in which the policy that generated this claim was written. Supports policy-year loss development analysis distinct from accident-year triangles.']
  reinsurance_recoverable_flag boolean [note: 'Indicates whether any portion of this payment is recoverable from a reinsurer under a treaty or facultative certificate. Triggers RI cession processing.']
  reissue_date date [note: 'Date a replacement payment was reissued following a void or stop-payment. Links to the original payment via original_payment_number.']
  ri_recoverable_amount decimal(18,2) [note: 'Portion of the gross payment expected to be recovered from reinsurers. Used in bordereaux processing and net loss reporting.']
  sir_deductible_amount decimal(18,2) [note: 'Amount of the payment attributable to the insured\'s SIR or policy deductible. Reduces net insurer loss and may trigger deductible billing to insured.']
  source_system_code varchar [note: 'Identifies the operational system of record that originated this payment transaction record for lineage and reconciliation purposes.']
  subrogation_flag boolean [note: 'Indicates this payment has an associated subrogation recovery opportunity. Triggers SubroFT workflow in ClaimCenter for third-party recovery pursuit.']
  tax_withholding_amount decimal(18,2) [note: 'Federal or state tax withheld from the payment per IRS backup withholding rules. Reported on IRS Form 1099 for qualifying payees.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this payment transaction record. Satisfies RECORD_AUDIT_UPDATED canonical category.']
  void_date date [note: 'Date the payment was voided. Null for active payments. Triggers reversal GL entries and reserve reinstatement in ClaimCenter.']
  void_reason varchar [note: 'Reason code explaining why the payment was voided. Required for audit trail and stop-payment processing. Null for non-voided payments. [ENUM-REF-CANDIDATE: promote to reference product]']

  Note: 'Master record of every outbound loss payment issued (check, EFT, wire). Tracks payee, payment method, gross amount, void/reissue status, bank clearing date, and GL posting reference. Source: ClaimCenter / Oracle AP.'
}

Table reservespayments.recovery_transaction {
  recovery_transaction_id varchar [pk, note: 'Unique surrogate identifier for each recovery transaction record in the reserves and payments domain.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Recovery transactions for CAT events need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  claim_id varchar [note: 'Reference to the claim against which this recovery is applied. Links recovery to the originating loss event.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Subrogation and salvage recoveries must be credited to the specific coverage that paid the loss for accurate loss ratio calculation, reserve release accounting, and']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Subrogation and salvage recovery amounts require currency reference for accounting, collection tracking, and financial reporting. Currency_code is denormalized.']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: Subrogation and salvage recoveries on facultatively reinsured claims must identify the fac certificate to allocate recovered amounts between cedant and fac reinsurer.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Subrogation and salvage recoveries must be allocated to locations for net loss ratio calculation, territorial rate adequacy analysis, and cat event loss reconciliation.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto salvage proceeds must reconcile to vehicle valuation, title transfer documentation, and total loss settlement amounts; vehicle linkage enables salvage audit and subrogation']
  policy_id varchar [note: 'Reference to the insurance policy under which the underlying claim was filed and recovery is pursued.']
  recovered_payment_transaction_id varchar [note: 'Foreign key linking to reservespayments.payment_transaction. Business justification: Recovery transactions (subrogation, salvage, reinsurance recoveries) often relate to specific payment transactions that were previously issued.']
  reinsurance_cession_id varchar [note: 'Foreign key linking to reinsurance.cession. Business justification: Recovery transactions on ceded policies must identify the specific cession to allocate recovered amounts (subrogation/salvage) between cedant and reinsurer per cession terms.']
  reinsurance_recoverable_id varchar [note: 'Foreign key linking to reservespayments.reinsurance_recoverable. Business justification: When recovery_transaction.recovery_type = \'Reinsurance Recovery\', it should link to the reinsurance_recoverable master record.']
  reservespayments_claim_payment_id varchar [note: 'Reference to the specific claim payment disbursement that this recovery offsets or partially recovers.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty or facultative (FAC) certificate under which the reinsurance recoverable is claimed. Null for non-reinsurance recovery types.']
  salvage_item_id varchar [note: 'Foreign key linking to reservespayments.salvage_item. Business justification: When recovery_transaction.recovery_type = \'Salvage\', it should link to the salvage_item master record. This enables tracking which salvage item generated which recovery.']
  subrogation_case_id varchar [note: 'Foreign key linking to reservespayments.subrogation_case. Business justification: When recovery_transaction.recovery_type = \'Subrogation\', it should link to the subrogation_case master record.']
  accident_year varchar [note: 'Four-digit year in which the underlying loss event (Date of Loss / DOL) occurred. Used for accident-year loss development and actuarial reserving triangles.']
  accounting_period varchar [note: 'Fiscal accounting period (YYYY-MM) in which the recovery is recognized for financial close and statutory reporting purposes.']
  at_fault_party_insurer varchar [note: 'Name of the liability insurer of the at-fault third party. Used to direct subrogation demands and track inter-company recovery negotiations.']
  at_fault_party_name varchar [note: 'Legal name of the third party against whom subrogation or recovery action is pursued. Restricted PII when the party is an individual.']
  at_fault_party_policy_number varchar [note: 'Policy number of the at-fault third party\'s liability insurance. Used to identify the adverse carrier and track subrogation demand status.']
  closed_date date [note: 'Date on which the recovery transaction was closed, either through full collection, settlement, or write-off. Null if still open.']
  collection_attorney_firm varchar [note: 'Name of the external law firm or collection agency engaged to pursue the recovery action. Used for vendor management and ALAE expense tracking.']
  collection_expense_amount decimal(18,2) [note: 'Allocated Loss Adjustment Expense (ALAE) incurred to collect this recovery, including attorney fees, investigation costs, and court costs.']
  company_naic_code varchar [note: 'Five-digit NAIC company code identifying the writing company entity. Required for statutory financial statements and Schedule F reinsurance reporting.']
  created_timestamp timestamp [note: 'Timestamp when this recovery transaction record was first created in the system of record. Used for audit trail and data lineage.']
  gl_account_code varchar [note: 'General Ledger account code to which the recovery proceeds are posted in the financial ledger. Ensures proper accounting treatment per SAP/STAT and US GAAP.']
  gross_recovery_amount decimal(18,2) [note: 'Total gross amount recovered before deducting collection expenses, attorney fees, or reinsurance shares. Represents the full inbound recovery value.']
  initiated_date date [note: 'Date on which the recovery action was formally initiated (e.g., subrogation demand letter sent, salvage auction listed, reinsurance proof of loss submitted).']
  is_cat_event boolean [note: 'Indicates whether the underlying claim is associated with a declared catastrophe (CAT) event. Used for CAT loss reporting and CAT XL reinsurance recovery tracking.']
  is_intercompany boolean [note: 'Indicates whether this recovery involves an affiliated entity within the same insurance group. Triggers intercompany elimination in consolidated financial statements.']
  lob_code varchar [note: 'NAIC or internal Line of Business code classifying the coverage under which the claim was filed (e.g., GL, APD, WC, PD, BI). Used for statutory reporting.']
  net_recovery_amount decimal(18,2) [note: 'Net recovery amount after deducting collection expenses from gross recovery. Represents the actual benefit to the insurer for loss ratio and reserve release purposes.']
  net_retained_recovery_amount decimal(18,2) [note: 'Recovery amount retained by the insurer after deducting both collection expenses and the reinsurance share. Used for net loss ratio and financial reporting.']
  notes varchar [note: 'Free-text narrative capturing adjuster comments, negotiation history, legal strategy notes, or other contextual information relevant to this recovery transaction.']
  policy_year varchar [note: 'Four-digit year in which the policy that generated the underlying claim was effective. Used for policy-year loss development and reinsurance treaty year allocation.']
  recovery_basis varchar [note: 'Accounting basis under which the recovery is recognized: cash (when received) or accrual (when probable and estimable). Aligns with statutory vs GAAP reporting.']
  recovery_date date [note: 'Calendar date on which the recovery was received or recognized, used as the principal business event date for accounting and loss reporting.']
  recovery_method varchar [note: 'Mechanism by which the recovery proceeds were received: check, wire transfer, ACH, offset against payable, or credit note from reinsurer.']
  recovery_reference_number varchar [note: 'Externally visible alphanumeric identifier assigned to this recovery transaction, used in bordereaux, correspondence, and statutory reporting.']
  recovery_status varchar [note: 'Current lifecycle state of the recovery transaction: open, in collection, collected, closed, or written off. Drives reserve release and cash posting.']
  recovery_type varchar [note: 'Classification of the inbound recovery: subrogation (SubroFT), salvage, reinsurance recoverable, second-injury fund, or other. Drives accounting treatment and reporting.']
  reserve_release_amount decimal(18,2) [note: 'Amount of outstanding case reserve (OCR) released upon collection or closure of this recovery transaction. Used for reserve development reporting.']
  ri_share_amount decimal(18,2) [note: 'Portion of the gross recovery that must be remitted to reinsurers per treaty or facultative (FAC) agreement terms. Reduces net recovery retained by the cedant.']
  second_injury_fund_state varchar [note: 'Two-letter state code of the Second Injury Fund from which recovery is sought in Workers Compensation (WC) claims. Null for non-WC or non-SIF recovery types.']
  state_code varchar [note: 'Two-letter US state code where the underlying loss occurred or the policy was issued. Required for state-level statutory reporting to Departments of Insurance.']
  statute_of_limitations_date date [note: 'Date by which legal action must be filed to preserve the recovery right. Critical for subrogation diary management and write-off decisions.']
  subrogation_demand_amount decimal(18,2) [note: 'Full demand amount asserted against the at-fault third party in a subrogation (SubroFT) action. May exceed gross recovery if partial collection occurs.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this recovery transaction record. Used for change tracking and incremental ETL.']
  write_off_amount decimal(18,2) [note: 'Amount of the expected recovery that was written off as uncollectible. Impacts net loss ratio and reserve release calculations.']
  write_off_reason varchar [note: 'Reason code explaining why a recovery was written off without full collection: uncollectible, statute expired, negotiated settlement, insolvency, or waived.']

  Note: 'Records all inbound recoveries against paid losses: subrogation (SubroFT), salvage, reinsurance recoverable, and second-injury fund. Tracks recovery type, gross recovery, net recovery, and collection status.'
}

Table reservespayments.subrogation_case {
  subrogation_case_id varchar [pk, note: 'Unique surrogate identifier for the subrogation case record on the Databricks Silver Layer.']
  adjuster_id varchar [note: 'Reference to the claims adjuster or subrogation specialist responsible for managing this recovery pursuit.']
  attorney_id varchar [note: 'Reference to the internal or external attorney assigned to manage litigation or formal legal pursuit of the subrogation case.']
  claim_id varchar [note: 'Reference to the underlying insurance claim from which this subrogation pursuit originates.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Subrogation pursuit decisions depend on coverage-specific terms: waiver of subrogation endorsements block recovery rights, deductible reimbursement rules vary by coverage.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Subrogation case financial amounts (demand, collected, settlement) require currency reference for international recoveries and accounting. Replaces currency_code denormalization.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property subrogation cases require location details (construction type, protection class, occupancy) for liability determination, demand calculation, and recovery potential']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto subrogation demands are based on vehicle damage estimates, repair costs, and total loss valuations; vehicle linkage enables demand calculation and recovery tracking.']
  policy_id varchar [note: 'Reference to the insurance policy under which the originating claim was covered.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Subrogation cases require state reference for statute of limitations, recovery laws, arbitration forum rules, and court jurisdiction. State_code denormalizes state master.']
  alae_paid_amount decimal(18,2) [note: 'Allocated Loss Adjustment Expense paid on the originating claim, included in the subrogation demand to the extent recoverable.']
  arbitration_filing_date date [note: 'Date on which the arbitration demand was formally filed with the selected arbitration forum.']
  arbitration_forum varchar [note: 'Arbitration forum selected for intercompany or third-party arbitration proceedings (e.g., AAIS, AAA, AICRB).']
  attorney_firm_name varchar [note: 'Name of the law firm retained to pursue subrogation recovery through litigation or formal legal demand.']
  case_number varchar [note: 'Externally visible alphanumeric identifier assigned to the subrogation case, used in correspondence and bordereaux reporting.']
  case_status varchar [note: 'Current lifecycle state of the subrogation pursuit. [ENUM-REF-CANDIDATE: open|in_demand|in_litigation|settled|closed_recovered|closed_no_recovery — promote to reference product]']
  case_type varchar [note: 'Classification of the subrogation pursuit by line of business or liability theory. [ENUM-REF-CANDIDATE: auto_liability|property_damage|workers_comp|general_liability|product_liability — promote to reference product]']
  closed_date date [note: 'Date on which the subrogation case was closed, either upon full recovery, settlement, or determination of no recovery.']
  collected_amount decimal(18,2) [note: 'Total amount actually collected from the liable third party or their insurer to date across all recovery payments.']
  court_jurisdiction varchar [note: 'State or federal court jurisdiction in which the subrogation lawsuit has been or will be filed.']
  created_timestamp timestamp [note: 'Timestamp when the subrogation case record was first created in the system of record.']
  date_of_loss date [note: 'Date on which the insured loss event occurred, establishing the basis for the subrogation right.']
  deductible_reimbursed_amount decimal(18,2) [note: 'Portion of the net recovery returned to the insured as reimbursement of their deductible, per policy terms and state law.']
  demand_amount decimal(18,2) [note: 'Total dollar amount formally demanded from the liable third party or their insurer, inclusive of losses and recoverable expenses.']
  demand_sent_date date [note: 'Date on which the formal demand letter was sent to the liable third party or their insurer.']
  gross_paid_loss_amount decimal(18,2) [note: 'Total indemnity loss amount paid by the insurer on the originating claim, representing the maximum theoretical subrogation recovery base.']
  liability_percentage decimal(5,2) [note: 'Percentage of fault attributed to the liable third party, used to calculate the proportionate recovery demand in comparative negligence states.']
  litigation_filed_flag boolean [note: 'Indicates whether a lawsuit has been formally filed in court to pursue the subrogation recovery.']
  lob_code varchar [note: 'NAIC or internal Line of Business code identifying the insurance product line under which the originating claim was filed.']
  net_recovery_amount decimal(18,2) [note: 'Net recovery after deducting all pursuit expenses from the collected amount. Equals collected_amount minus recovery_expense_amount.']
  notes varchar [note: 'Free-text field for adjuster or attorney notes documenting key developments, negotiations, and decisions in the subrogation pursuit.']
  opened_date date [note: 'Date on which the subrogation case was formally opened and assigned for pursuit.']
  priority_level varchar [note: 'Operational priority assigned to the subrogation case to guide adjuster workload management and pursuit urgency.']
  pursuit_method varchar [note: 'Method selected to pursue recovery from the liable third party, such as demand letter, arbitration, or formal litigation.']
  recovery_expense_amount decimal(18,2) [note: 'Total expenses incurred in pursuing the subrogation recovery, including attorney fees, court costs, and investigation costs.']
  ri_recoverable_flag boolean [note: 'Indicates whether a portion of the subrogation recovery is owed to reinsurers under applicable treaty or facultative agreements.']
  ri_recovery_share_amount decimal(18,2) [note: 'Dollar amount of the net subrogation recovery attributable to reinsurers, calculated per treaty or facultative terms.']
  settlement_amount decimal(18,2) [note: 'Agreed settlement amount accepted from the liable third party, which may be less than the full demand amount.']
  settlement_date date [note: 'Date on which a settlement agreement was executed with the liable third party or their insurer.']
  settlement_status varchar [note: 'Indicates whether a settlement agreement has been reached with the third party and the extent of that settlement.']
  statute_of_limitations_date date [note: 'Deadline by which legal action must be filed to preserve the subrogation right, per applicable state law.']
  third_party_claim_number varchar [note: 'Claim number assigned by the at-fault third party\'s insurer for the corresponding liability claim.']
  third_party_insurer_name varchar [note: 'Name of the insurance carrier providing liability coverage to the at-fault third party.']
  third_party_name varchar [note: 'Full legal name of the liable third party against whom subrogation is being pursued.']
  third_party_policy_number varchar [note: 'Policy number of the at-fault third party\'s liability insurance, used to facilitate demand and recovery negotiations.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the subrogation case record.']
  waiver_reason varchar [note: 'Reason code explaining why subrogation pursuit was waived or abandoned, required for regulatory and audit purposes.']

  Note: 'Master record for a subrogation pursuit against a liable third party. Tracks demand amount, collected amount, attorney assignment, statute of limitations date, settlement status, and net recovery after expenses.'
}

Table reservespayments.salvage_item {
  salvage_item_id varchar [pk, note: 'Unique surrogate identifier for a salvage item record in the reserves and payments domain.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Salvage items from CAT events need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  claim_id varchar [note: 'Reference to the parent claim from which this salvage item originated following a total-loss or partial-loss settlement.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Salvage proceeds must be credited to the specific coverage (typically physical damage/property) for reserve release, loss settlement accounting, and reinsurance recovery']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Salvage proceeds and valuations require currency reference for auction settlements, accounting entries, and financial reporting. Currency_code denormalizes currency master.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Property salvage items (damaged equipment, inventory, building materials) are tracked by location for disposal coordination, recovery allocation, and net loss calculation.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Total loss vehicles require VIN-level salvage tracking for title transfer, auction lot assignment, salvage proceeds reconciliation, and branded title reporting to state DMV.']
  service_vendor_id varchar [note: 'Reference to the salvage vendor or disposal service provider in the vendor/party master, used for payment processing and vendor performance tracking.']
  acv_at_loss decimal(18,2) [note: 'Actual Cash Value (ACV) of the property at the Date of Loss (DOL), representing the pre-loss fair market value used as the basis for total-loss settlement.']
  adjuster_notes varchar [note: 'Free-text notes entered by the claims adjuster regarding the salvage item condition, disposal challenges, vendor negotiations, or other relevant operational details.']
  auction_lot_number varchar [note: 'Lot number assigned by the auction house for salvage items disposed of through auction channels. Used for reconciliation of auction proceeds remittances.']
  branded_title_flag boolean [note: 'Indicates whether the salvage title carries a branded designation (e.g., salvage, rebuilt, flood, junk) as required by state DMV regulations.']
  company_naic_code varchar [note: 'Five-digit NAIC company code of the writing insurer entity, required for statutory financial reporting and state DOI salvage recovery disclosures.']
  condition_at_title varchar [note: 'Condition classification of the salvage item at the time title was acquired. [ENUM-REF-CANDIDATE: total_loss|major_damage|minor_damage|flood|fire|theft_recovery|hail|other — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when the salvage item record was first created in the claims administration system, providing the audit trail start point for the salvage lifecycle.']
  disposal_cost decimal(18,2) [note: 'Total costs incurred to dispose of the salvage item including towing, storage, auction fees, environmental remediation, and administrative expenses.']
  disposal_date date [note: 'Date on which the salvage item was physically disposed of through the selected disposal method, triggering recognition of salvage proceeds.']
  disposal_method varchar [note: 'Method used to dispose of the salvage item. [ENUM-REF-CANDIDATE: auction|scrap|direct_sale|donation|return_to_insured|parts_only|other — promote to reference product]']
  environmental_hazard_flag boolean [note: 'Indicates whether the salvage item presents environmental hazards (e.g., fuel leaks, refrigerants, asbestos) requiring special handling and disposal procedures.']
  item_description varchar [note: 'Free-text description of the salvage property including make, model, year, condition, and any distinguishing characteristics relevant to valuation and disposal.']
  item_type varchar [note: 'Category of the physical property taken into salvage title. [ENUM-REF-CANDIDATE: vehicle|real_property|personal_property|equipment|watercraft|aircraft|other — promote to reference product]']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the salvage item record, supporting audit trail requirements and incremental data lake ingestion.']
  lob_code varchar [note: 'NAIC Line of Business (LOB) code associated with the originating claim, used for statutory reporting and salvage recovery allocation by line.']
  make varchar [note: 'Manufacturer or brand of the salvage item (e.g., Ford, Caterpillar, Carrier). Primarily used for vehicle and equipment salvage valuation.']
  model varchar [note: 'Model designation of the salvage item as provided by the manufacturer, used in conjunction with make and year for ACV determination.']
  net_salvage_recovery decimal(18,2) [note: 'Net amount credited back to the claim calculated as salvage proceeds minus disposal costs. Reduces the ultimate net loss and is reported in statutory bordereaux.']
  odometer_reading varchar [note: 'Odometer reading in miles at the time of loss for vehicle salvage items. Used in ACV calculation and auction valuation. Null for non-vehicle items.']
  payment_reference_number varchar [note: 'Reference number of the payment transaction received from the salvage vendor or auction house, used for cash reconciliation in the financial ledger.']
  proceeds_received_date date [note: 'Date on which salvage proceeds were received and posted to the insurer\'s accounts receivable, triggering the net salvage credit to the claim reserve.']
  reserve_credit_applied_flag boolean [note: 'Indicates whether the net salvage recovery has been credited back to the claim loss reserve in the actuarial reserving system, reducing the outstanding case reserve.']
  ri_recoverable_flag boolean [note: 'Indicates whether a portion of the salvage recovery is ceded to reinsurers under applicable treaty or facultative arrangements, requiring bordereaux reporting.']
  ri_salvage_credit decimal(18,2) [note: 'Portion of net salvage recovery attributable to reinsurers under applicable cession arrangements. Reduces the reinsurance recoverable balance on the claim.']
  salvage_proceeds decimal(18,2) [note: 'Gross proceeds actually received from the disposal of the salvage item through auction, scrap, or direct sale before deducting disposal costs.']
  salvage_reference_number varchar [note: 'Externally-known unique identifier assigned to this salvage item by the salvage vendor, auction house, or internal salvage management system.']
  salvage_status varchar [note: 'Current lifecycle state of the salvage item from title acquisition through final disposal. [ENUM-REF-CANDIDATE: pending|titled|listed|sold|scrapped|donated|returned|closed — promote to reference product]']
  salvage_value_estimate decimal(18,2) [note: 'Estimated recoverable value of the salvage item at time of title acquisition, used for initial reserve credit and net loss calculation prior to actual disposal.']
  salvage_vendor_name varchar [note: 'Name of the salvage vendor, auction house, or scrap dealer engaged to manage the disposal of the salvage item (e.g., Copart, IAA, local scrap yard).']
  serial_number varchar [note: 'Manufacturer serial number for non-vehicle salvage items such as equipment, electronics, or machinery. Supports title transfer and ownership verification.']
  state_of_loss_code varchar [note: 'Two-letter US state code where the insured loss occurred. Governs applicable salvage regulations and statutory reporting jurisdiction.']
  storage_location varchar [note: 'Physical address or facility identifier where the salvage item is stored pending disposal. Used for logistics coordination and storage cost accrual.']
  storage_start_date date [note: 'Date the salvage item entered storage at the designated facility, used to calculate accrued storage costs and manage disposal timelines.']
  title_acquired_date date [note: 'Date on which the insurer formally acquired legal title to the salvage property following total-loss settlement payment to the insured.']
  title_brand_type varchar [note: 'Specific brand designation applied to the salvage title by the issuing state DMV. Affects resale value and auction proceeds estimation. [ENUM-REF-CANDIDATE: salvage|rebuilt|flood|junk|parts_only|lemon|none — 7 candidates stripped; promote to reference']
  title_state_code varchar [note: 'Two-letter US state code of the jurisdiction in which the salvage title was issued. Governs title transfer requirements and branded title regulations.']
  total_loss_settlement_date date [note: 'Date the total-loss claim settlement was paid to the insured, triggering the insurer\'s right to take salvage title to the damaged property.']
  vin varchar [note: '17-character Vehicle Identification Number (VIN) for salvage vehicles, conforming to ISO 3779. Null for non-vehicle salvage items.']
  year_manufactured varchar [note: 'Four-digit model year or year of manufacture of the salvage item, used for ACV calculation and depreciation schedules.']

  Note: 'Tracks physical salvage property taken title to after a total-loss settlement. Records ACV at loss, salvage proceeds, disposal method (auction, scrap), and net salvage recovery credited back to the claim.'
}

Table reservespayments.lae_allocation {
  lae_allocation_id varchar [pk, note: 'Unique surrogate primary key for each LAE allocation record in the Databricks Silver layer.']
  adjuster_id varchar [note: 'Reference to the claims adjuster responsible for the claim driving this LAE allocation. Supports adjuster-level LAE productivity and expense analysis.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: LAE allocations for CAT events need proper FK linkage to cat_event master. The cat_code string becomes redundant when FK allows JOIN to cat_event.']
  claim_id varchar [note: 'Reference to the individual claim to which this LAE allocation is attributed. Supports claim-level LAE analysis and combined ratio reporting.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: LAE (legal fees, adjuster costs) must be allocated to coverages for Schedule P stat reporting, reinsurance recovery (treaty terms specify ALAE/ULAE treatment by coverage)']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: LAE allocation amounts require currency reference for expense accounting, statutory exhibits, and multi-currency operations. Replaces denormalized currency_code.']
  fac_certificate_id varchar [note: 'Foreign key linking to reinsurance.fac_certificate. Business justification: LAE allocation on facultatively reinsured claims requires identifying the fac certificate to calculate recoverable ALAE per certificate terms.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Entity-level LAE tracking is required for large deductible programs, self-insured retention reconciliation, and experience modification calculations where LAE is included in']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: ALAE allocation to locations supports territorial expense ratio analysis, rate adequacy studies, and Schedule P reporting; location characteristics drive expense patterns.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto claim expenses (appraisal, towing, storage) are allocated to vehicles for total incurred calculation, loss ratio analysis, and vehicle-level profitability assessment.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: LAE must be allocated to LOB for statutory expense exhibits, profitability analysis, and rate adequacy testing. Lob_code denormalizes LOB master.']
  policy_id varchar [note: 'Reference to the policy under which the claim and associated LAE costs arise, enabling policy-level expense ratio analysis.']
  reversed_allocation_id varchar [note: 'Reference to the original LAE allocation record that this record reverses. Null when reversal_indicator is false. Supports audit trail and GL reconciliation.']
  service_vendor_id varchar [note: 'Reference to the external vendor (law firm, independent adjuster, expert witness, salvage company) whose invoice generated this ALAE cost.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: LAE allocation to state is required for statutory expense exhibits, state-specific cost analysis, and regulatory reporting. State_code is denormalized.']
  accident_year varchar [note: 'Calendar year in which the loss event (date of loss) occurred. Used for accident-year LAE development triangles in actuarial reserving.']
  accounting_basis varchar [note: 'Accounting framework under which this LAE allocation is recorded: Statutory (STAT/SAP), US GAAP, or IFRS 17 for international entities.']
  accounting_period_date date [note: 'First day of the accounting period (month/quarter/year) to which this LAE allocation is posted in the general ledger for statutory and GAAP financials.']
  allocated_amount decimal(18,2) [note: 'Gross allocated LAE amount in the reporting currency for this record. Core input to combined ratio (CR) and expense ratio (ER) calculations.']
  allocation_basis varchar [note: 'Statistical basis used when applying a pro-rata or exposure-based allocation method, such as claim count or earned premium (EP) weighting.']
  allocation_date date [note: 'The business event date on which the LAE cost was allocated to the claim or claim group. Used for period-matching in statutory and GAAP reporting.']
  allocation_method varchar [note: 'Method used to allocate LAE costs to claims or claim groups. Drives actuarial credibility and combined ratio (CR) accuracy per NAIC and FASB guidance.']
  allocation_number varchar [note: 'Externally visible business identifier for this LAE allocation record, used in bordereaux, statutory filings, and actuarial reports.']
  allocation_status varchar [note: 'Current workflow state of the LAE allocation record, controlling whether it is included in statutory and GAAP financial reporting.']
  authorization_date date [note: 'Date on which the required authorization level approved this LAE allocation, providing an audit trail for SOX and regulatory compliance.']
  authorization_level varchar [note: 'Approval authority level required and applied for this LAE allocation, supporting SOX internal controls and claims expense governance.']
  company_naic_code varchar [note: 'Five-digit NAIC company code identifying the writing company for statutory LAE reporting in the Annual Statement and Schedule P.']
  cost_center_code varchar [note: 'General ledger cost center to which the LAE expense is charged, enabling departmental expense tracking in Oracle Financials GL or SAP FI.']
  created_timestamp timestamp [note: 'Timestamp when this LAE allocation record was first created in the system, providing the audit trail creation point for SOX and data governance.']
  expense_category_code varchar [note: 'Standardized code classifying the type of LAE expense (e.g., legal fees, expert witness, adjuster fees, salvage/subrogation costs). [ENUM-REF-CANDIDATE: legal|adjuster|expert_witness|salvage_subro|medical_review|other — promote to reference product]']
  expense_category_description varchar [note: 'Human-readable description of the LAE expense category, providing context for actuarial and finance reporting beyond the category code.']
  gl_account_code varchar [note: 'Chart-of-accounts code in Oracle Financials GL or SAP FI to which this LAE allocation is posted for GAAP and statutory financial reporting.']
  is_cat_event boolean [note: 'Indicates whether this LAE allocation is associated with a catastrophe (CAT) event, enabling separate CAT LAE tracking for reinsurance and regulatory reporting.']
  lae_type varchar [note: 'Distinguishes Allocated Loss Adjustment Expense (ALAE) directly tied to a specific claim from Unallocated Loss Adjustment Expense (ULAE) spread across claim groups.']
  lob_description varchar [note: 'Human-readable description of the line of business associated with this LAE allocation, supporting management reporting and analytics.']
  net_lae_amount decimal(18,2) [note: 'Net LAE amount after deducting reinsurance recoverables. Used in net combined ratio (CR) and net expense ratio (ER) statutory and GAAP reporting.']
  notes varchar [note: 'Free-text notes from the adjuster, actuary, or finance team providing context for the LAE allocation decision, methodology choice, or unusual circumstances.']
  policy_year varchar [note: 'Year in which the policy was effective at the time of loss. Used for policy-year LAE development analysis and rate adequacy studies.']
  report_year varchar [note: 'Calendar year in which the claim was first reported (FNOL). Supports report-year LAE development triangles for IBNR and ULAE estimation.']
  reversal_indicator boolean [note: 'Indicates this record is a reversal of a previously posted LAE allocation. When true, the reversed_allocation_id identifies the original record.']
  ri_recoverable_lae_amount decimal(18,2) [note: 'Portion of the allocated LAE recoverable from reinsurers under treaty or facultative (FAC) agreements, used to derive net LAE for statutory reporting.']
  service_type varchar [note: 'Type of professional service generating the LAE cost. Supports granular expense ratio (ER) analysis by service category. [ENUM-REF-CANDIDATE: promote if values exceed 6]']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this LAE allocation record, supporting data lineage and reconciliation.']
  source_transaction_ref varchar [note: 'Native transaction identifier from the originating source system (e.g., Guidewire ClaimCenter payment ID), enabling cross-system audit and reconciliation.']
  stat_line_code varchar [note: 'NAIC statutory line code used to map this LAE allocation to the correct line in the Annual Statement Expense Exhibit and Schedule P.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this LAE allocation record, supporting change tracking, audit compliance, and Silver layer incremental loads.']
  vendor_invoice_number varchar [note: 'Invoice reference number from the external vendor providing LAE services, used for accounts payable reconciliation and audit trail.']

  Note: 'Allocates LAE (ALAE and ULAE) costs to individual claims or claim groups. Captures expense category, allocated amount, allocation method, and period. Supports combined ratio (CR) and expense ratio (ER) reporting.'
}

Table reservespayments.payment_authority {
  payment_authority_id varchar [pk, note: 'Unique surrogate identifier for a payment authority limit record governing adjuster disbursement thresholds in ClaimCenter.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Payment authority limits require currency specification for multi-jurisdiction operations and proper approval threshold enforcement. Currency_code is denormalized.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Payment authority limits vary by line of business risk profile, loss severity patterns, and underwriting complexity. Replaces lob_code denormalization.']
  payment_adjuster_id varchar [note: 'Reference to the claims adjuster or adjuster role to whom this payment authority limit is assigned.']
  payment_delegated_by_adjuster_id varchar [note: 'Reference to the supervisor or manager who granted this delegated payment authority, providing audit trail for SOX compliance.']
  payment_escalation_adjuster_id varchar [note: 'Reference to the next-level adjuster, supervisor, or manager to whom payments exceeding this authority limit are automatically escalated.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Payment authority limits may vary by state regulatory requirements, licensing jurisdiction, and state-specific approval thresholds. Replaces state_code denormalization.']
  tpa_id varchar [note: 'Reference to the TPA entity when this authority record governs payment limits for a third-party administrator handling claims on behalf of the insurer.']
  adjuster_role varchar [note: 'Functional role of the adjuster to which this authority applies, e.g., Staff Adjuster, Senior Adjuster, Supervisor, Manager. [ENUM-REF-CANDIDATE: staff_adjuster|senior_adjuster|supervisor|manager|director|vp — promote to reference product]']
  advance_payment_allowed boolean [note: 'Indicates whether the adjuster is authorized to issue advance payments on open claims under this authority record.']
  advance_payment_limit decimal(18,2) [note: 'Maximum dollar amount of an advance payment the adjuster may issue on an open claim when advance_payment_allowed is true.']
  aggregate_payment_limit decimal(18,2) [note: 'Maximum cumulative payment amount the adjuster may approve on a single claim across all transactions before escalation is required.']
  approval_workflow_code varchar [note: 'Code referencing the specific ClaimCenter approval workflow rule set triggered when a payment approaches or exceeds this authority limit.']
  approved_timestamp timestamp [note: 'Timestamp when this payment authority record was formally approved by the designated authority owner, distinct from creation and update timestamps.']
  authority_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this payment authority rule, used in bordereaux and audit references.']
  authority_level varchar [note: 'Hierarchical authority tier assigned to this record, from Level 1 (lowest, e.g., staff adjuster) to Level 5 (highest, e.g., VP Claims). Drives escalation routing.']
  authority_name varchar [note: 'Human-readable label for this payment authority limit record, e.g., \'Senior Adjuster BI Auto Limit\'.']
  authority_notes varchar [note: 'Free-text notes capturing special conditions, exceptions, or context for this payment authority record, e.g., temporary elevation during CAT response.']
  authority_status varchar [note: 'Current lifecycle state of the payment authority record, controlling whether it is enforceable in the claims payment workflow.']
  cat_event_limit decimal(18,2) [note: 'Special single-payment authority limit applicable during a declared CAT event, which may differ from the standard single_payment_limit.']
  claim_office_code varchar [note: 'Internal code identifying the claims handling office or unit to which this authority limit is scoped. Null indicates enterprise-wide applicability.']
  claim_type varchar [note: 'Distinguishes whether this authority applies to first-party, third-party, subrogation recovery payments, or all claim types.']
  company_naic_code varchar [note: 'Five-digit NAIC company code identifying the legal entity whose claims payment authority this record governs.']
  coverage_type varchar [note: 'Coverage category scoping this authority, e.g., BI, PD, PIP, MedPay, UM, UIM, APD, GL. Null indicates authority applies to all coverage types. [ENUM-REF-CANDIDATE: BI|PD|PIP|MedPay|UM|UIM|APD|GL|WC|PROP — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this payment authority record was first created in the system, providing audit trail for SOX and regulatory compliance.']
  delegation_basis varchar [note: 'Basis on which authority is delegated: by role (all holders of the role), individual (named adjuster), temporary delegation, TPA, or vendor.']
  delegation_date date [note: 'Date on which the payment authority was formally delegated or granted to the adjuster by the authorizing manager.']
  dual_approval_threshold decimal(18,2) [note: 'Dollar amount at or above which dual approval is required for a payment, when requires_dual_approval is true.']
  effective_date date [note: 'Date on which this payment authority limit becomes enforceable in the claims payment workflow.']
  escalation_path_description varchar [note: 'Narrative description of the escalation chain for payments exceeding this authority, e.g., \'Supervisor → Manager → VP Claims\'.']
  expiration_date date [note: 'Date on which this payment authority limit ceases to be enforceable. Null indicates the authority is open-ended with no scheduled expiry.']
  is_cat_authority boolean [note: 'Indicates whether this authority record is specifically designated for CAT event claims handling, enabling surge-capacity payment processing.']
  last_review_date date [note: 'Date on which this payment authority record was most recently reviewed and approved by the designated authority owner.']
  litigation_payment_allowed boolean [note: 'Indicates whether this authority permits payment on litigated claims. Litigated claims often require elevated authority or legal department co-approval.']
  next_review_date date [note: 'Scheduled date by which this payment authority record must next be reviewed, computed from last_review_date and review_frequency.']
  payment_type varchar [note: 'Category of payment governed by this authority: indemnity loss, ALAE, general expense, recovery/subrogation, advance payment, or all types.']
  requires_dual_approval boolean [note: 'Indicates whether payments at or near this authority limit require a second approver signature before disbursement, per SOX dual-control requirements.']
  reserve_change_limit decimal(18,2) [note: 'Maximum dollar amount of a single reserve increase or decrease the adjuster may authorize without supervisor approval.']
  review_frequency varchar [note: 'Scheduled frequency at which this payment authority limit must be reviewed and reaffirmed by management per internal controls policy.']
  settlement_authority_limit decimal(18,2) [note: 'Maximum total settlement amount the adjuster may approve to close a claim, distinct from single-payment limits.']
  single_payment_limit decimal(18,2) [note: 'Maximum dollar amount the adjuster may approve for a single payment transaction without escalation. Core threshold enforced in ClaimCenter payment workflow.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this payment authority record originates, e.g., GUIDEWIRE_CC for ClaimCenter.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this payment authority record, supporting change audit trail and SOX controls.']
  version_number varchar [note: 'Monotonically incrementing version counter for this payment authority record, enabling point-in-time reconstruction of authority limits for audit.']

  Note: 'Defines payment authority limits by adjuster role, LOB, and coverage type. Stores approval threshold, escalation path, effective date, and delegated authority level. Governs payment approval workflow in ClaimCenter.'
}

Table reservespayments.payment_approval {
  payment_approval_id varchar [pk, note: 'Unique surrogate identifier for the payment approval workflow record. Primary key for the payment_approval entity in the reserves_payments domain.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Payment approvals for CAT losses need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  claim_id varchar [note: 'Reference to the claim against which the payment is being requested and routed for approval.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Payment approval amounts require currency reference for authority validation, multi-currency threshold comparison, and audit trail. Replaces currency_code denormalization.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Payment authority limits vary by location risk characteristics (cat zone, construction type, TIV); location linkage enables risk-based approval routing and large loss escalation.']
  insured_vehicle_id varchar [note: 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto total loss settlements require vehicle valuation data (ACV, stated value, loan amount) for approval authority determination and settlement validation.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Payment approval thresholds may differ by LOB complexity, loss severity, and risk characteristics. Lob_code is denormalized.']
  payment_adjuster_id varchar [note: 'Reference to the party record of the supervisor or manager designated to approve or deny this payment request.']
  payment_authority_id varchar [note: 'Foreign key linking to reservespayments.payment_authority. Business justification: Payment approvals should reference the specific payment_authority record that defines the approval threshold and escalation rules.']
  payment_escalated_to_adjuster_id varchar [note: 'Reference to the party record of the higher-level approver to whom the request was escalated when the original approver could not decide.']
  payment_requestor_adjuster_id varchar [note: 'Reference to the adjuster or staff member who initiated the payment approval request.']
  payment_transaction_id varchar [note: 'Reference to the payment transaction record requiring supervisory approval before disbursement can proceed.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Payment approvals may require state-specific workflows for regulatory compliance, licensing requirements, and jurisdictional authority validation. State_code is denormalized.']
  approval_channel varchar [note: 'Method or channel through which the approver rendered their decision (system workflow, email, phone, in-person, or delegated authority).']
  approval_reference_number varchar [note: 'Externally visible alphanumeric reference number uniquely identifying this approval request, used in correspondence and audit trails.']
  approval_status varchar [note: 'Current workflow state of the payment approval request. Drives downstream disbursement eligibility and audit reporting.']
  approval_type varchar [note: 'Category of approval required based on payment amount, coverage type, or claim complexity. Determines routing and authority level.']
  approved_amount decimal(18,2) [note: 'Dollar amount authorized by the approver. May be less than requested amount in cases of partial approval. Null if not yet decided.']
  claim_office_code varchar [note: 'Code identifying the claims handling office or unit responsible for the claim associated with this payment approval request.']
  cost_center_code varchar [note: 'Financial cost center code used to allocate the approved payment expense to the appropriate business unit for management reporting.']
  created_timestamp timestamp [note: 'Date and time the payment approval record was first created in the system, used for audit trail and data lineage tracking.']
  decision_timestamp timestamp [note: 'Date and time the approver rendered a final decision (approved, denied, or escalated) on the payment request.']
  denial_reason_code varchar [note: 'Standardized code indicating the reason a payment approval was denied (e.g., coverage dispute, documentation incomplete, fraud referral). [ENUM-REF-CANDIDATE: promote to reference product]']
  denial_reason_notes varchar [note: 'Free-text narrative provided by the approver explaining the basis for denying the payment request, supplementing the denial reason code.']
  escalation_level varchar [note: 'Numeric count of escalation steps this approval request has undergone. Zero indicates no escalation; increments with each escalation event.']
  expiry_date date [note: 'Date after which the approval authorization expires if payment has not been disbursed. Prevents stale approvals from being executed.']
  fraud_referral_flag boolean [note: 'Indicates the payment was flagged for special investigation unit (SIU) review due to suspected fraud, requiring additional approval scrutiny.']
  gl_account_code varchar [note: 'GL account code to which the approved payment will be posted in the financial ledger upon disbursement.']
  is_cat_loss boolean [note: 'Indicates the payment is associated with a declared catastrophe event, which may trigger special authority or expedited approval protocols.']
  is_large_loss boolean [note: 'Flags the payment as a large loss requiring enhanced oversight, typically triggered when requested amount exceeds a defined threshold.']
  is_override boolean [note: 'Indicates whether this approval involved an override of a system-generated recommendation or standard authority limit.']
  is_sla_breached boolean [note: 'Indicates whether the approval decision was rendered after the SLA due date, triggering regulatory or operational escalation.']
  litigation_flag boolean [note: 'Indicates the underlying claim is in active litigation, requiring legal department review as part of the payment approval process.']
  override_justification varchar [note: 'Mandatory free-text explanation when an approver overrides a system recommendation or approves outside normal authority parameters.']
  payment_category varchar [note: 'Classification of the payment by loss category: indemnity, ALAE (Allocated Loss Adjustment Expense), ULAE, subrogation recovery, salvage, medical, or legal fee.']
  reinsurance_recoverable_flag boolean [note: 'Indicates a portion of the approved payment is expected to be recovered from a reinsurance treaty or facultative certificate.']
  request_date date [note: 'Calendar date on which the adjuster submitted the payment for supervisory or management approval.']
  request_timestamp timestamp [note: 'Precise date and time the payment approval request was submitted, used for SLA tracking and audit trail purposes.']
  requested_amount decimal(18,2) [note: 'Gross dollar amount submitted by the adjuster for approval. May differ from final approved amount if partially approved.']
  ri_recoverable_amount decimal(18,2) [note: 'Estimated dollar amount recoverable from reinsurers on the approved payment, used for net loss reporting and cession bordereaux.']
  sir_deductible_amount decimal(18,2) [note: 'Dollar amount of the SIR or policy deductible to be applied against the approved payment, reducing the insurer net payment obligation.']
  sla_due_date date [note: 'Target date by which the approver must render a decision per internal SLA or state-mandated prompt payment requirements.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this payment approval record (e.g., Guidewire ClaimCenter, Duck Creek Claims).']
  supporting_document_ref varchar [note: 'Reference identifier to the document management system (e.g., OpenText or FileNet) for supporting documentation attached to the approval request.']
  updated_timestamp timestamp [note: 'Date and time the payment approval record was last modified, supporting change tracking and data lineage in the Databricks Silver layer.']

  Note: 'Workflow record for payment requests requiring supervisory or management approval above adjuster authority. Tracks requested amount, approver, approval date, approval status, and override justification.'
}

Table reservespayments.payee {
  payee_id varchar [pk, note: 'Unique surrogate identifier for the payee master record in the reserves and payments domain.']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: International payees require country reference for OFAC screening, tax withholding rules, wire transfer routing, and sanctions compliance. Country_code denormalizes country master.']
  preferred_currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Payee currency preference drives payment processing, FX conversion decisions, and international wire transfers. Preferred_currency_code denormalizes currency master data.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Payee address state is required for 1099 reporting, state tax withholding, escheatment rules, and regulatory compliance. State_code denormalizes state master.']
  ach_authorization_date date [note: 'Date on which the payee authorized ACH direct deposit, establishing the NACHA-required authorization record.']
  address_line1 varchar [note: 'Primary street address line for the payee, used for check mailing and 1099 reporting.']
  address_line2 varchar [note: 'Secondary address line (suite, unit, floor) for the payee mailing address.']
  backup_withholding_flag boolean [note: 'Indicates whether IRS-mandated backup withholding at the statutory rate applies to payments made to this payee.']
  bank_account_number varchar [note: 'Payee bank account number for ACH or wire disbursements. Stored encrypted; used only for EFT payment processing.']
  bank_account_type varchar [note: 'Type of bank account (checking or savings) used for ACH disbursements to this payee.']
  bank_name varchar [note: 'Name of the financial institution holding the payee bank account, used for remittance documentation.']
  bank_routing_number varchar [note: 'ABA routing transit number identifying the payee financial institution for ACH and wire transfers.']
  city varchar [note: 'City of the payee mailing address used for check delivery and 1099 filing.']
  created_timestamp timestamp [note: 'Timestamp when the payee master record was first created in the system, establishing the audit trail origin.']
  dba_name varchar [note: 'Trade or operating name used by the payee if different from the legal name. DBA is common for repair vendors and medical providers.']
  email_address varchar [note: 'Primary email address for the payee, used for electronic remittance advice (ERA) delivery and payment notifications.']
  entity_type varchar [note: 'Indicates whether the payee is a natural person (individual) or a legal entity (organization), driving tax form and name field usage.']
  first_name varchar [note: 'Given name of the individual payee. Populated only when entity_type is individual.']
  form_1099_type varchar [note: 'Specifies the IRS 1099 form variant applicable to this payee (e.g., 1099-MISC for miscellaneous income, 1099-NEC for non-employee compensation).']
  is_1099_reportable boolean [note: 'Indicates whether payments to this payee must be reported to the IRS on Form 1099. Drives annual 1099 extract and filing.']
  is_attorney boolean [note: 'Indicates the payee is a legal representative (attorney or law firm) receiving settlement or fee payments on behalf of a claimant.']
  is_claimant boolean [note: 'Indicates the payee is a first-party or third-party claimant receiving indemnity loss payments.']
  is_medical_provider boolean [note: 'Indicates the payee is a licensed medical provider receiving direct payment for bodily injury (BI), PIP, or MedPay claim services.']
  last_name varchar [note: 'Family name of the individual payee. Populated only when entity_type is individual.']
  legal_name varchar [note: 'Full legal name of the payee as it must appear on checks and IRS 1099 forms. For individuals, this is the full name; for organizations, the registered legal name.']
  license_number varchar [note: 'State-issued professional or contractor license number for medical providers, repair vendors, or public adjusters.']
  license_state varchar [note: 'Two-letter state code of the jurisdiction that issued the payee professional or contractor license.']
  npi_number varchar [note: 'CMS-issued National Provider Identifier for medical provider payees. Required for BI, PIP, and MedPay direct payment processing.']
  number varchar [note: 'Externally visible business identifier assigned to the payee, used on checks, EFT remittances, and 1099 filings.']
  ofac_screen_date date [note: 'Most recent date on which the payee was screened against the OFAC SDN and consolidated sanctions lists.']
  ofac_screen_result varchar [note: 'Outcome of the most recent OFAC sanctions screening. Confirmed matches block payment disbursement.']
  ofac_screened_flag boolean [note: 'Indicates whether the payee has been screened against the OFAC Specially Designated Nationals (SDN) list prior to payment.']
  payee_status varchar [note: 'Current lifecycle status of the payee record, controlling eligibility to receive loss payments.']
  payee_type varchar [note: 'Categorizes the payee by their role in the claim payment process. [ENUM-REF-CANDIDATE: claimant|attorney|medical_provider|repair_vendor|mortgagee|lienholder|public_adjuster|other — promote to reference product]']
  payment_block_flag boolean [note: 'Indicates that all payments to this payee are currently blocked, typically due to OFAC match, fraud investigation, or legal hold.']
  payment_block_reason varchar [note: 'Reason code explaining why payments to this payee are blocked. Required when payment_block_flag is true.']
  payment_method varchar [note: 'Preferred disbursement method for loss payments to this payee (e.g., paper check, ACH direct deposit, wire transfer).']
  phone_number varchar [note: 'Primary contact phone number for the payee, used for payment inquiries and check reissuance coordination.']
  postal_code varchar [note: 'ZIP or ZIP+4 postal code for the payee mailing address.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this payee record originated (e.g., Guidewire ClaimCenter, Duck Creek Claims).']
  tax_id_type varchar [note: 'Classifies the tax_id as SSN (Social Security Number), FEIN (Federal Employer Identification Number), ITIN, or EIN for correct IRS reporting.']
  tax_identification_number varchar [note: 'IRS-issued Tax Identification Number: SSN for individuals or FEIN for organizations. Required for 1099 reporting and OFAC screening.']
  tin_verification_date date [note: 'Date on which the payee TIN was last verified through the IRS TIN matching program.']
  tin_verified_flag boolean [note: 'Indicates whether the payee TIN has been verified against IRS TIN matching program prior to issuing payment.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the payee master record, supporting audit and data lineage tracking.']
  w9_received_date date [note: 'Date on which the IRS Form W-9 was received from the payee, establishing the basis for backup withholding exemption.']
  w9_received_flag boolean [note: 'Indicates whether a completed IRS Form W-9 (Request for Taxpayer Identification Number) has been received from the payee.']

  Note: 'Master record of all parties eligible to receive loss payments: claimants, attorneys, medical providers, repair vendors, and mortgagees. Stores payee type, tax ID (SSN/FEIN), banking details, and 1099 reporting flag.'
}

Table reservespayments.reinsurance_recoverable {
  reinsurance_recoverable_id varchar [pk, note: 'Unique surrogate identifier for each reinsurance recoverable record in the Pc_Insurance lakehouse silver layer.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Reinsurance recoverables for CAT events need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  claim_id varchar [note: 'Reference to the underlying claim against which this reinsurance recoverable is tracked. Links to the claim master record in ClaimCenter or Duck Creek Claims.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Reinsurance treaties specify coverage scope, exclusions, and LAE treatment by coverage type.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: RI recoverable amounts require currency reference for bordereaux reporting, collection tracking, and multi-currency reinsurance accounting. Currency_code is denormalized.']
  insured_location_id varchar [note: 'Foreign key linking to riskexposure.insured_location. Business justification: Cat XL reinsurance recoveries are calculated based on location-level PML, treaty attachment points, and loss aggregation by event; location linkage enables cession calculation']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: RI recoverables must track LOB for treaty application, bordereaux reporting, and reinsurance accounting. Lob_code denormalizes LOB master.']
  occurrence_loss_id varchar [note: 'Foreign key linking to reinsurance.occurrence_loss. Business justification: Recoverables arising from catastrophic occurrences must link to occurrence_loss for occurrence-level aggregation, treaty exhaustion tracking, and reinstatement premium']
  policy_id varchar [note: 'Reference to the insurance policy under which the underlying claim was filed and the reinsurance cession applies.']
  reinsurer_id varchar [note: 'Reference to the reinsurer counterparty (party master) from whom the recoverable amount is due. Supports multi-reinsurer panel structures.']
  ri_treaty_id varchar [note: 'Reference to the reinsurance treaty or facultative (FAC) certificate under which this recoverable is ceded. Null for facultative if a separate fac_certificate_id is used.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: RI recoverables must track state for unauthorized reinsurer collateral requirements, state-specific credit rules, and regulatory reporting. State_code is denormalized.']
  treaty_layer_id varchar [note: 'Foreign key linking to reinsurance.treaty_layer. Business justification: Recoverables calculated against multi-layer treaties must identify the specific layer for accurate attachment/exhaustion tracking and layer-specific settlement.']
  accident_year varchar [note: 'The calendar year in which the loss event (date of loss) occurred. Used for actuarial loss development triangles and NAIC statutory Schedule F reporting.']
  accounting_basis varchar [note: 'Accounting framework under which this recoverable is recognized and reported: STAT (Statutory Accounting Principles per NAIC SAP), GAAP (US GAAP ASC 944), or IFRS17 for international entities.']
  authorized_reinsurer_flag boolean [note: 'Indicates whether the reinsurer is authorized (licensed) in the cedant\'s domicile state. Unauthorized reinsurers require collateral (LOC or trust) per NAIC Credit for Reinsurance Model Law.']
  bordereaux_period varchar [note: 'The quarterly or monthly bordereaux reporting period (e.g., 2024-Q1 or 2024-03) in which this recoverable was included in the cession bordereau submitted to the reinsurer.']
  cat_event_indicator boolean [note: 'Flags whether the underlying loss is associated with a catastrophe (CAT) event. Drives CAT XL treaty layer activation, PML tracking, and CAT bond recoverable reporting.']
  cession_reference varchar [note: 'The cession or bordereau line reference assigned by the reinsurance management system (SICS/ReinsuranceMaster) linking this recoverable to its originating cession transaction.']
  collateral_held_amount decimal(18,2) [note: 'Amount of collateral (letter of credit, trust fund, or funds withheld) held from the reinsurer to secure the recoverable, required for unauthorized reinsurers under NAIC Credit for Reinsurance rules.']
  collateral_type varchar [note: 'Type of collateral arrangement securing the recoverable from an unauthorized reinsurer: letter of credit (LOC), trust fund, funds withheld, cash deposit, or none for authorized reinsurers.']
  collectability_status varchar [note: 'Assessment of the likelihood of collecting the outstanding recoverable from the reinsurer. Drives NAIC Schedule F Part 3 aged-debt disclosure and allowance for uncollectible RI.']
  collected_amount decimal(18,2) [note: 'Cumulative amount actually received from the reinsurer to date against this recoverable. Used to compute the outstanding balance and monitor collection performance.']
  company_naic_code varchar [note: 'Five-digit NAIC company code of the Pc_Insurance legal entity (cedant) that holds this recoverable. Required for NAIC Schedule F statutory filing and multi-entity group reporting.']
  created_timestamp timestamp [note: 'Timestamp when this reinsurance recoverable record was first created in the system of record. Supports audit trail, data lineage, and SOX compliance requirements.']
  date_of_loss date [note: 'The date on which the insured loss event occurred (DOL). Used to determine treaty year applicability and to match the recoverable to the correct reinsurance period.']
  dispute_reason varchar [note: 'Free-text or coded description of the reason the reinsurer has disputed this recoverable (e.g., coverage interpretation, late reporting, policy conditions). Populated when collectability_status is in_dispute.']
  gl_account_code varchar [note: 'GL account code in Oracle Financials or SAP FI to which this reinsurance recoverable asset is posted. Supports financial close, balance sheet reconciliation, and SOX controls.']
  gross_alae_amount decimal(18,2) [note: 'Gross ALAE (Allocated Loss Adjustment Expense) incurred on the underlying claim before reinsurance. Included in recoverable calculations where the treaty covers LAE.']
  gross_loss_amount decimal(18,2) [note: 'Total gross incurred loss amount (paid plus outstanding case reserve) before any reinsurance recovery. Represents the cedant\'s 100% share prior to cession. Basis for RI share calculation.']
  last_collection_date date [note: 'Date of the most recent cash receipt from the reinsurer against this recoverable. Used for aged-debt analysis and NAIC Schedule F Part 3 overdue recoverable identification.']
  outstanding_recoverable_amount decimal(18,2) [note: 'Net amount still due from the reinsurer, calculated as total RI recoverable amount minus collected amount. Key balance sheet asset for STAT and GAAP reporting.']
  policy_year varchar [note: 'The year in which the policy that generated the underlying loss was written or incepted. Used alongside accident year for treaty period matching and bordereaux processing.']
  recoverable_number varchar [note: 'Externally-known business reference number uniquely identifying this recoverable record, used in bordereaux submissions and reinsurer correspondence.']
  recoverable_status varchar [note: 'Current lifecycle status of the recoverable. Drives collectability monitoring, aged-debt reporting, and STAT/GAAP balance sheet presentation. [ENUM-REF-CANDIDATE: open|collected|partially_collected|disputed|written_off|closed — promote to reference']
  recoverable_type varchar [note: 'Classifies the nature of the recoverable: paid loss, case reserve (OCR), IBNR, ALAE, ULAE, or salvage/subrogation. Drives actuarial and statutory schedule presentation.']
  reinsurance_type varchar [note: 'Indicates whether the recoverable arises under a proportional/non-proportional treaty arrangement or a facultative (FAC) certificate placed on a specific risk.']
  reinsurer_credit_rating varchar [note: 'A.M. Best or S&P financial strength rating of the reinsurer at the valuation date. Used to assess collectability risk and support NAIC Schedule F Part 3 disclosures.']
  reinsurer_naic_code varchar [note: 'Five-digit NAIC company code assigned to the reinsurer. Required for NAIC Schedule F statutory reporting and state DOI filings identifying authorized vs. unauthorized reinsurers.']
  retention_amount decimal(18,2) [note: 'The cedant\'s net retained loss amount after cession, representing the portion of gross loss not recoverable from the reinsurer. Equals gross loss minus RI recoverable loss amount.']
  ri_recoverable_alae_amount decimal(18,2) [note: 'The ALAE portion of the total reinsurance recoverable, calculated as gross ALAE multiplied by the RI share where the treaty includes LAE coverage.']
  ri_recoverable_loss_amount decimal(18,2) [note: 'The gross loss amount multiplied by the RI share percentage, representing the total loss amount recoverable from the reinsurer under this cession before any collections.']
  ri_recoverable_total_amount decimal(18,2) [note: 'Sum of RI recoverable loss and RI recoverable ALAE amounts. Represents the total gross amount due from the reinsurer before collections and any collectability adjustments.']
  ri_share_percent decimal(7,4) [note: 'The percentage of the gross loss ceded to the reinsurer under the applicable treaty or FAC certificate. For QS treaties this is the cession rate; for XOL it reflects the layer participation.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this recoverable record originated (e.g., SICS, Sapiens ReinsuranceMaster, Guidewire ClaimCenter). Supports data lineage.']
  treaty_type varchar [note: 'Structure of the reinsurance arrangement: QS (Quota Share), XOL (Excess of Loss), CAT XL (Catastrophe Excess of Loss), surplus share, or facultative-obligatory.']
  uncollectible_amount decimal(18,2) [note: 'Amount of the outstanding recoverable deemed uncollectible due to reinsurer insolvency, dispute, or credit impairment. Reduces the net asset on the NAIC Schedule F Part 3 aged analysis.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this reinsurance recoverable record. Used for incremental ETL processing, change tracking, and audit trail in the Snowflake lakehouse.']
  valuation_date date [note: 'The as-of date at which the recoverable amounts (gross loss, RI share, collected) are evaluated. Aligns with actuarial valuation periods and quarterly STAT close cycles.']

  Note: 'Tracks amounts recoverable from reinsurers on paid and reserved losses under treaty and facultative (FAC) agreements. Records cession reference, gross loss, RI share, collected amount, and collectability status.'
}

Table reservespayments.structured_settlement {
  structured_settlement_id varchar [pk, note: 'Unique surrogate identifier for the structured settlement record. Primary key for this entity.']
  claim_id varchar [note: 'Reference to the underlying claim for which this structured settlement was established in lieu of a lump-sum indemnity payment.']
  claimant_id varchar [note: 'Reference to the party record for the claimant or payee who is the beneficiary of the structured settlement periodic payments.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Structured settlements are established under specific liability coverages (typically bodily injury).']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Structured settlement amounts require currency reference for present value calculation, annuity pricing, and financial reporting. Replaces denormalized currency_code.']
  insured_entity_id varchar [note: 'Foreign key linking to riskexposure.insured_entity. Business justification: Workers compensation structured settlements require employer entity data for qualified assignment documentation, tax reporting, and experience modification calculation of present']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Structured settlements require LOB classification for financial reporting, profitability analysis, and management reporting. Replaces lob_code denormalization.']
  payment_transaction_id varchar [note: 'Reference to the originating payment transaction record that was converted or replaced by this structured settlement agreement.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Structured settlements require state reference for court approval requirements, state tax treatment, and regulatory compliance. Replaces state_code denormalization.']
  accident_year varchar [note: 'Calendar year in which the loss event occurred, used for actuarial loss development, statutory reporting, and reserve triangulation.']
  accounting_basis varchar [note: 'Accounting framework under which the structured settlement liability is measured and reported: Statutory (STAT), US GAAP, or IFRS 17.']
  agreement_date date [note: 'Date on which the structured settlement agreement was formally executed and signed by all parties.']
  annuity_contract_number varchar [note: 'Policy or contract number assigned by the annuity provider for the annuity contract that funds the structured settlement periodic payments.']
  annuity_cost_amount decimal(18,2) [note: 'Actual premium paid to the annuity provider to fund the structured settlement annuity contract, representing the insurer\'s cost of settlement.']
  annuity_provider_naic_code varchar [note: 'National Association of Insurance Commissioners (NAIC) company code for the annuity provider issuing the structured settlement annuity contract.']
  annuity_provider_name varchar [note: 'Legal name of the life insurance company that issues and funds the annuity contract underlying the structured settlement.']
  broker_name varchar [note: 'Name of the structured settlement consultant or broker who facilitated the placement of the annuity and negotiation of the settlement terms.']
  claimant_tax_identification_number varchar [note: 'Social Security Number (SSN) or Federal Employer Identification Number (FEIN) of the claimant for IRS tax reporting on structured settlement payments.']
  cola_rate decimal(6,4) [note: 'Annual cost-of-living adjustment (COLA) rate applied to periodic payments, expressed as a decimal (e.g., 0.0300 for 3%). Zero if no COLA applies.']
  company_naic_code varchar [note: 'Five-digit NAIC company code for the Pc_Insurance legal entity that is the settling insurer and obligor under this structured settlement.']
  court_approval_date date [note: 'Date on which a court of competent jurisdiction approved the structured settlement agreement, required for minor or incapacitated claimants.']
  court_approval_required_flag boolean [note: 'Indicates whether court approval is required for this structured settlement, typically for minor or incapacitated claimants under state law.']
  created_timestamp timestamp [note: 'Timestamp when this structured settlement record was first created in the system of record.']
  date_of_loss date [note: 'Date on which the insured loss event occurred that gave rise to the claim settled through this structured settlement agreement.']
  discount_rate decimal(6,4) [note: 'Actuarial discount rate used to calculate the present value of future periodic payments for reserving and financial reporting purposes.']
  effective_date date [note: 'Date on which the structured settlement becomes binding and periodic payments are scheduled to commence.']
  gl_account_code varchar [note: 'General Ledger (GL) account code in Oracle Financials or SAP FI to which the structured settlement liability and annuity cost are posted.']
  guarantee_period_years varchar [note: 'Number of years for which periodic payments are guaranteed regardless of the annuitant\'s survival, providing a minimum payment floor.']
  payment_end_date date [note: 'Date on which the last scheduled periodic payment is due, or null for life-contingent settlements with no fixed end date.']
  payment_frequency varchar [note: 'Frequency at which periodic payments are disbursed to the claimant under the structured settlement schedule.']
  payment_start_date date [note: 'Date on which the first periodic payment under the structured settlement is scheduled to be disbursed to the claimant.']
  periodic_payment_amount decimal(18,2) [note: 'Base amount of each scheduled periodic payment disbursed to the claimant, before any cost-of-living adjustment (COLA) is applied.']
  policy_number varchar [note: 'Policy number of the insurance policy under which the claim giving rise to this structured settlement was filed.']
  present_value_amount decimal(18,2) [note: 'Actuarially calculated present value of all future periodic payments under the structured settlement, used for reserving, accounting, and IFRS 17 liability measurement.']
  qualified_assignment_company varchar [note: 'Legal name of the qualified assignment company (QAC) that has assumed the periodic payment obligation from the insurer under IRC Section 130.']
  qualified_assignment_flag boolean [note: 'Indicates whether the periodic payment obligation has been assigned to a qualified assignment company under IRC Section 130, releasing the insurer from direct payment liability.']
  ri_recoverable_amount decimal(18,2) [note: 'Portion of the annuity cost or present value recoverable from reinsurers under applicable treaty or facultative (FAC) arrangements.']
  ri_recoverable_flag boolean [note: 'Indicates whether any portion of the structured settlement present value or annuity cost is recoverable from a reinsurance treaty or facultative certificate.']
  settlement_number varchar [note: 'Externally-known unique reference number assigned to the structured settlement agreement, used in correspondence with claimants, annuity providers, and qualified assignment companies.']
  settlement_status varchar [note: 'Current lifecycle state of the structured settlement agreement. [ENUM-REF-CANDIDATE: draft|pending_approval|active|in_force|terminated|voided — promote to reference product]']
  settlement_type varchar [note: 'Classification of the settlement payment structure. [ENUM-REF-CANDIDATE: periodic_payment|lump_sum_plus_periodic|life_contingent|life_with_period_certain|joint_and_survivor — promote to reference product]']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this structured settlement record was sourced (e.g., Guidewire ClaimCenter, Duck Creek Claims).']
  termination_date date [note: 'Date on which the structured settlement agreement ends, either upon expiry of the guarantee period, death of the annuitant, or other contractual termination event.']
  total_payout_amount decimal(18,2) [note: 'Sum of all scheduled periodic payments over the full term of the structured settlement, representing the gross undiscounted obligation.']
  updated_timestamp timestamp [note: 'Timestamp when this structured settlement record was last modified in the system of record.']

  Note: 'Records periodic-payment structured settlement agreements that replace lump-sum indemnity. Captures annuity provider, present value, payment schedule, guarantee period, and assignment to a qualified assignment company.'
}

Table reservespayments.development_triangle {
  development_triangle_id varchar [pk, note: 'Unique surrogate identifier for each loss development triangle record in the actuarial reserving system.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Development triangles for CAT events need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Development triangle amounts require currency reference for actuarial analysis, multi-currency consolidation, and rate filing support. Currency_code denormalizes currency master.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Development triangles are the primary actuarial tool for LOB-specific reserve analysis, loss development patterns, and rate adequacy. Lob_code is denormalized.']
  reserve_study_id varchar [note: 'Foreign key linking to reservespayments.reserve_study. Business justification: Development triangles are analytical artifacts produced as part of a reserve study.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Development triangles are segmented by state for rate filing support, state-specific loss development analysis, and regulatory actuarial exhibits. State_code is denormalized.']
  accident_year varchar [note: 'The calendar year in which the insured loss event occurred. Used as the primary origin period dimension in loss development triangles per actuarial convention.']
  accounting_basis varchar [note: 'Accounting framework under which the triangle data is prepared: STAT (Statutory Accounting Principles), GAAP (US Generally Accepted Accounting Principles), or IFRS.']
  actuarial_opinion_reference varchar [note: 'Reference number or identifier of the actuarial opinion memorandum (AOM) or reserve study report in which this triangle was included and certified.']
  actuarial_segment_code varchar [note: 'Internal actuarial segment or homogeneous group code used to stratify the triangle for reserving purposes, such as by territory, class of business, or risk size.']
  appointed_actuary_name varchar [note: 'Name of the appointed actuary or actuarial analyst responsible for certifying or reviewing the ultimate loss estimates derived from this triangle.']
  bf_ultimate_loss_estimate decimal(18,2) [note: 'Ultimate loss estimate produced by the Bornhuetter-Ferguson method, blending the development method projection with the a priori expected losses for this origin period.']
  cat_event_indicator boolean [note: 'Flag indicating whether this triangle cell includes catastrophe losses. When true, CAT losses may be separately triangulated or excluded for non-CAT reserve analysis.']
  closed_claim_count varchar [note: 'Number of closed claims for the origin period as of the evaluation date at the given development age. Used to compute closure rates and tail factor selections.']
  company_naic_code varchar [note: 'Five-digit NAIC company code identifying the legal insurance entity for which this triangle is prepared. Required for statutory Schedule P and annual statement filings.']
  created_timestamp timestamp [note: 'Timestamp when this development triangle record was first created in the Silver layer of the Databricks lakehouse. Used for audit trail and data governance.']
  cumulative_incurred_alae_amount decimal(18,2) [note: 'Total cumulative incurred ALAE (paid plus case reserves for ALAE) for the origin period at the given development age as of the evaluation date.']
  cumulative_incurred_loss_amount decimal(18,2) [note: 'Total cumulative incurred losses (paid plus case reserves, excluding IBNR) for the origin period at the given development age as of the evaluation date.']
  cumulative_ldf decimal(10,6) [note: 'Cumulative (age-to-ultimate) loss development factor for this origin period and development age. Product of all selected age-to-age LDFs from current age to ultimate.']
  cumulative_paid_alae_amount decimal(18,2) [note: 'Total cumulative paid Allocated Loss Adjustment Expenses for the origin period at the given development age. Tracked separately from indemnity losses per NAIC STAT.']
  cumulative_paid_loss_amount decimal(18,2) [note: 'Total cumulative paid losses (excluding LAE) for the origin period at the given development age as of the evaluation date. Core triangle cell value.']
  development_age_months varchar [note: 'Number of months elapsed from the start of the origin period (accident year, policy year, or report year) to the evaluation date. Standard triangle column dimension.']
  ep_amount decimal(18,2) [note: 'Earned premium for the origin period used as the exposure base in loss ratio and Bornhuetter-Ferguson ultimate loss calculations for this triangle segment.']
  evaluation_date date [note: 'The as-of date at which loss data in this triangle cell was evaluated and extracted from the claims system. Defines the diagonal of the development triangle.']
  evaluation_period_type varchar [note: 'Frequency interval at which triangle evaluations are performed: annual, semi-annual, quarterly, or monthly. Determines the spacing of diagonals in the triangle.']
  expected_loss_ratio decimal(10,6) [note: 'A priori expected loss ratio used as the Bornhuetter-Ferguson method input for this origin period and LOB segment. Expressed as a decimal (e.g., 0.65 for 65%).']
  ibner_amount decimal(18,2) [note: 'IBNER component representing expected adverse development on already-reported claims. Subset of total IBNR reflecting case reserve inadequacy for known claims.']
  ibnr_amount decimal(18,2) [note: 'IBNR reserve for the origin period, calculated as ultimate loss estimate minus cumulative incurred losses. Represents unreported and development on reported claims.']
  large_loss_indicator boolean [note: 'Flag indicating whether this triangle cell includes large individual losses that may distort development patterns. Large losses are often capped or excluded in LDF selections.']
  large_loss_threshold_amount decimal(18,2) [note: 'Dollar threshold above which an individual claim is classified as a large loss for this triangle segment. Used to define the capping level for LDF selection purposes.']
  lob_description varchar [note: 'Human-readable description of the Line of Business corresponding to lob_code, such as Commercial General Liability or Workers Compensation.']
  open_claim_count varchar [note: 'Number of open (unresolved) claims for the origin period as of the evaluation date at the given development age. Used in Bornhuetter-Ferguson and frequency-severity methods.']
  policy_year varchar [note: 'The year in which the policy that generated the loss was written or incepted. Used as an alternative origin period dimension alongside accident year.']
  report_year varchar [note: 'The calendar year in which the loss was first reported to the insurer. Used as an origin period dimension for claims-made and report-year triangles.']
  reported_claim_count varchar [note: 'Total number of claims reported (open plus closed) for the origin period as of the evaluation date. Used as the denominator in severity calculations.']
  reserve_basis varchar [note: 'Indicates whether the triangle data is on a gross (before reinsurance), net of reinsurance, or ceded basis. Critical for statutory and GAAP reserve reconciliation.']
  source_extract_timestamp timestamp [note: 'Timestamp when the triangle data was extracted from the source actuarial reserving system. Used for data lineage, reconciliation, and audit trail in the Snowflake lakehouse.']
  source_system_code varchar [note: 'Code identifying the operational system from which this triangle data was extracted (e.g., ARIUS for Milliman Arius, RESQ for WTW ResQ, CLAIMCENTER for Guidewire).']
  stat_line_code varchar [note: 'NAIC statutory line of business code used for Schedule P and other statutory filings. Maps internal LOB codes to NAIC-defined reporting lines.']
  tail_factor decimal(10,6) [note: 'Loss development factor applied beyond the last observed development age to project losses from the oldest observed age to ultimate. Critical for long-tail lines such as WC and CGL.']
  triangle_reference_number varchar [note: 'Externally-known alphanumeric identifier assigned to this triangle run or evaluation, used for cross-referencing actuarial reports and bordereaux.']
  triangle_status varchar [note: 'Lifecycle status of the development triangle record indicating whether it is a working draft, preliminary estimate, final actuarial selection, superseded, or archived.']
  triangle_type varchar [note: 'Classifies the triangle by the loss measure it tracks: paid loss, incurred loss, paid ALAE, incurred ALAE, paid LAE, or case reserve. [ENUM-REF-CANDIDATE: paid_loss|incurred_loss|paid_alae|incurred_alae|paid_lae|case_reserve — promote to reference product]']
  ultimate_loss_estimate decimal(18,2) [note: 'Projected ultimate loss amount for the origin period derived by applying the cumulative LDF to current paid or incurred losses. Primary output of the development method.']
  updated_timestamp timestamp [note: 'Timestamp when this development triangle record was last modified in the Silver layer. Tracks revisions to actuarial selections, corrections, or restatements.']
  wp_amount decimal(18,2) [note: 'Gross written premium for the origin period associated with this triangle segment. Used as an alternative exposure base and for premium development triangles.']

  Note: 'Stores loss development triangle data by LOB, accident year, and development age. Captures cumulative paid loss, cumulative incurred loss, and earned premium for each evaluation period. Source: Milliman Arius / WTW ResQ.'
}

Table reservespayments.stat_reserve_exhibit {
  stat_reserve_exhibit_id varchar [pk, note: 'Unique surrogate identifier for each statutory reserve exhibit record in the NAIC Annual Statement Schedule P filing.']
  cat_event_id varchar [note: 'Foreign key linking to reservespayments.cat_event. Business justification: Statutory reserve exhibits for CAT events need proper FK linkage to cat_event master. The cat_event_code string becomes redundant when FK allows JOIN.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Statutory reserve exhibit amounts require currency specification for regulatory filings and multi-currency statutory reporting. Replaces currency_code denormalization.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Statutory reserve exhibits report reserves by NAIC line of business for regulatory filings and Schedule P. Lob_code denormalizes LOB master.']
  reserve_evaluation_id varchar [note: 'Reference to the actuarial reserve evaluation record that underpins this statutory exhibit entry.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Statutory reserve exhibits are filed by state with state-specific formats, reporting requirements, and regulatory deadlines. State_code denormalizes state master.']
  accident_year varchar [note: 'The accident year (AY) for which losses and reserves are reported on this exhibit row, per NAIC Schedule P segmentation.']
  accounting_basis varchar [note: 'Accounting framework under which this statutory exhibit is prepared: SAP (Statutory Accounting Principles), GAAP, or IFRS 17.']
  actuarial_method varchar [note: 'Primary actuarial method used to estimate ultimate losses and IBNR for this accident year and LOB. [ENUM-REF-CANDIDATE: promote to reference product if methods expand]']
  actuarial_opinion_reference varchar [note: 'Reference identifier linking this exhibit row to the appointed actuary\'s opinion and memorandum supporting the reserve adequacy certification.']
  appointed_actuary_credential varchar [note: 'Professional credential of the appointed actuary (e.g., FCAS, MAAA) as required by the NAIC Actuarial Opinion and Memorandum Regulation. [ENUM-REF-CANDIDATE: FCAS|ACAS|FSA|ASA|MAAA|PhD|other — 7 candidates stripped; promote to reference product]']
  appointed_actuary_name varchar [note: 'Full name of the appointed actuary who certified the reserve adequacy opinion supporting this statutory exhibit filing.']
  cat_reserve_amount decimal(18,2) [note: 'Portion of the total reserve attributable to catastrophe (CAT) events for the accident year, disclosed separately for regulatory transparency.']
  company_naic_code varchar [note: 'Five-digit NAIC company code identifying the reporting insurance entity for statutory filing purposes.']
  created_timestamp timestamp [note: 'Timestamp when this statutory reserve exhibit record was first created in the data platform, used for audit trail and data lineage.']
  development_period_months varchar [note: 'Number of months of development from the accident year origin to the valuation date, used to position the data point in the loss development triangle.']
  ep_amount decimal(18,2) [note: 'Earned premium (EP) for the accident year used as the denominator in loss ratio calculations on this statutory exhibit.']
  exhibit_reference_number varchar [note: 'Externally-known alphanumeric identifier for this statutory reserve exhibit, used in DOI filings and NAIC Annual Statement submissions.']
  exhibit_status varchar [note: 'Current workflow state of the statutory reserve exhibit. [ENUM-REF-CANDIDATE: draft|under_review|certified|filed|amended|superseded — promote to reference product]']
  expected_loss_ratio decimal(10,6) [note: 'A priori expected loss ratio (ELR) used in Bornhuetter-Ferguson and Cape Cod actuarial methods for this accident year and LOB.']
  filing_date date [note: 'Date on which this statutory reserve exhibit was submitted to the NAIC or state DOI as part of the Annual Statement filing.']
  filing_year varchar [note: 'Calendar year of the NAIC Annual Statement filing to which this statutory reserve exhibit belongs (e.g., 2024).']
  gross_case_reserve_amount decimal(18,2) [note: 'Outstanding case reserve (OCR) on a gross basis for known open claims in the accident year at the valuation date, before reinsurance.']
  gross_ibnr_amount decimal(18,2) [note: 'Gross IBNR reserve for the accident year at the valuation date, representing estimated unreported losses and IBNER development, before reinsurance.']
  gross_incurred_alae_amount decimal(18,2) [note: 'Gross incurred ALAE (paid ALAE plus ALAE case reserves) for the accident year at the valuation date, before reinsurance recoveries.']
  gross_incurred_loss_amount decimal(18,2) [note: 'Gross incurred losses (paid plus case reserves) for the accident year at the valuation date, before reinsurance, per NAIC Schedule P reporting.']
  gross_paid_alae_amount decimal(18,2) [note: 'Cumulative gross paid allocated loss adjustment expense (ALAE) for the accident year and development period, before reinsurance recoveries.']
  gross_paid_loss_amount decimal(18,2) [note: 'Cumulative gross (before reinsurance) paid losses reported on this exhibit row for the accident year and development period, per NAIC Schedule P.']
  gross_total_reserve_amount decimal(18,2) [note: 'Total gross reserve (case reserve plus IBNR) for the accident year at the valuation date, before reinsurance recoveries, as reported on the statutory exhibit.']
  lob_description varchar [note: 'Human-readable description of the NAIC line of business (LOB) reported on this exhibit row (e.g., Private Passenger Auto Liability, Workers Compensation).']
  net_case_reserve_amount decimal(18,2) [note: 'Outstanding case reserve (OCR) on a net-of-reinsurance basis for the accident year at the valuation date.']
  net_ibnr_amount decimal(18,2) [note: 'Net IBNR reserve (gross IBNR less reinsurance recoverable on IBNR) for the accident year at the valuation date.']
  net_incurred_loss_amount decimal(18,2) [note: 'Net incurred losses (gross incurred less reinsurance recoverables) for the accident year at the valuation date, as reported on the statutory exhibit.']
  net_loss_ratio decimal(10,6) [note: 'Net loss ratio (LR) for the accident year: net incurred losses divided by earned premium (EP), as reported on the statutory exhibit.']
  net_paid_loss_amount decimal(18,2) [note: 'Cumulative net paid losses (gross paid losses less reinsurance recoveries received) for the accident year and development period.']
  net_total_reserve_amount decimal(18,2) [note: 'Total net reserve (net case reserve plus net IBNR) for the accident year at the valuation date, as reported on the statutory exhibit.']
  prior_valuation_date date [note: 'The prior year-end valuation date used as the baseline for measuring reserve development on this statutory exhibit row.']
  reserve_basis varchar [note: 'The basis on which reserves are segmented and reported: accident year, policy year, or report year, per NAIC Schedule P requirements.']
  reserve_development_amount decimal(18,2) [note: 'Favorable or unfavorable reserve development for the accident year between the prior and current valuation dates, as disclosed on Schedule P.']
  ri_recoverable_alae_amount decimal(18,2) [note: 'Estimated reinsurance recoverable on unpaid ALAE for the accident year at the valuation date.']
  ri_recoverable_loss_amount decimal(18,2) [note: 'Estimated reinsurance (RI) recoverable on unpaid losses for the accident year at the valuation date, reducing gross reserves to net.']
  schedule_p_part varchar [note: 'Identifies the specific part of NAIC Annual Statement Schedule P this row populates (e.g., Part1=Summary, Part2=Paid, Part3=Incurred, Part4=Bulk/IBNR).']
  selected_ldf decimal(10,6) [note: 'Actuarially selected cumulative loss development factor (LDF) applied to current incurred losses to project ultimate losses for this accident year.']
  ulr decimal(10,6) [note: 'Ultimate loss ratio (ULR) for the accident year: actuarially selected ultimate losses divided by earned premium (EP), per the actuarial opinion.']
  ultimate_loss_estimate decimal(18,2) [note: 'Actuarially selected ultimate loss estimate for the accident year, representing the expected total cost of all claims including future development.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this statutory reserve exhibit record, supporting audit trail and amendment tracking.']
  valuation_date date [note: 'The as-of date at which reserves are measured and reported on this statutory exhibit, typically December 31 of the filing year.']

  Note: 'Statutory reserve exhibit prepared for NAIC Annual Statement Schedule P and state DOI filings. Captures net and gross reserve positions, loss ratio, and actuarial opinion reference by LOB and accident year.'
}

Table reservespayments.cat_event {
  cat_event_id varchar [pk, note: 'Unique identifier for the cat_event data product (auto-inserted during validation).']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Catastrophe loss estimates require currency reference for industry loss comparisons, reinsurance treaty triggers, and financial reporting. Currency_code is denormalized.']
  ri_treaty_id varchar [note: 'Foreign key reference to the reinsurance treaty triggered by this catastrophe event, if applicable.']
  affected_counties varchar [note: 'Comma-separated list of county FIPS codes or county names within affected states where losses occurred.']
  affected_states varchar [note: 'Comma-separated list of US state codes where the catastrophe event caused insured losses (e.g., FL,GA,AL).']
  alae_amount decimal(18,2) [note: 'Total allocated loss adjustment expenses incurred for claims associated with this catastrophe event, in USD.']
  cat_bond_triggered_flag boolean [note: 'Indicates whether this catastrophe event triggered any catastrophe bond or insurance-linked securities held by the company.']
  cat_close_date date [note: 'Date when the catastrophe event was officially closed for new claim associations. Nullable if still open.']
  cat_code varchar [note: 'Industry-standard catastrophe event code assigned by ISO Property Claim Services (PCS) or similar authority. Format: 2-letter state/region + 6-digit serial.']
  cat_event_name varchar [note: 'Common name or designation of the catastrophe event (e.g., Hurricane Katrina, California Wildfire 2020).']
  cat_event_status varchar [note: 'Current lifecycle status of the catastrophe event for claims reporting and aggregation purposes.']
  cat_open_date date [note: 'Date when the catastrophe event was officially opened for claims reporting and tracking by the insurer.']
  cat_xl_triggered_flag boolean [note: 'Indicates whether this catastrophe event triggered the company\'s catastrophe excess of loss reinsurance treaty.']
  closed_claim_count varchar [note: 'Total number of claims associated with this catastrophe event that have been closed with payment or denial.']
  company_loss_estimate_amount decimal(18,2) [note: 'Estimated total gross loss for this insurer from the catastrophe event, in USD. Updated as claims develop.']
  company_ultimate_loss_amount decimal(18,2) [note: 'Actuarial estimate of ultimate net loss to the company after all claims are settled and reinsurance recoveries applied, in USD.']
  created_timestamp timestamp [note: 'Timestamp when this catastrophe event record was first created in the system.']
  declaration_date date [note: 'Date when the catastrophe event was officially declared by the company for internal tracking and reporting purposes.']
  event_description varchar [note: 'Detailed narrative description of the catastrophe event, including meteorological or geological characteristics and impact summary.']
  event_end_date date [note: 'Date when the catastrophe event concluded or ceased causing new losses. Nullable for ongoing events.']
  event_start_date date [note: 'Date when the catastrophe event began or first caused insured losses.']
  geographic_scope varchar [note: 'Classification of the catastrophe event geographic extent for exposure aggregation and reinsurance triggering.']
  ibnr_reserve_amount decimal(18,2) [note: 'Actuarial reserve estimate for losses incurred but not yet reported for this catastrophe event, in USD.']
  industry_loss_estimate_amount decimal(18,2) [note: 'Estimated total insured loss across the entire insurance industry for this catastrophe event, in USD.']
  industry_loss_estimate_date date [note: 'Date when the industry loss estimate was published or last updated.']
  industry_loss_estimate_source varchar [note: 'Organization or entity that provided the industry loss estimate (e.g., ISO/PCS, AIR Worldwide, RMS).']
  last_updated_timestamp timestamp [note: 'Timestamp when this catastrophe event record was last modified, reflecting the most recent claim or loss data update.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the legal entity reporting this catastrophe event for statutory purposes.']
  net_loss_amount decimal(18,2) [note: 'Net incurred loss after reinsurance recoveries for this catastrophe event, in USD.']
  open_claim_count varchar [note: 'Total number of claims associated with this catastrophe event that remain open and under active adjustment.']
  peril_type varchar [note: 'Primary peril or cause of loss associated with the catastrophe event. [ENUM-REF-CANDIDATE: hurricane|tornado|wildfire|earthquake|flood|hail|winter_storm|wind|other — 9 candidates stripped; promote to reference product]']
  pml_tier varchar [note: 'Classification tier indicating the severity of the catastrophe event relative to the company\'s PML thresholds for reinsurance attachment.']
  reported_claim_count varchar [note: 'Total number of claims reported and associated with this catastrophe event as of the last update.']
  ri_recoverable_amount decimal(18,2) [note: 'Total reinsurance recoverable amount expected or collected for losses from this catastrophe event, in USD.']
  source_system_code varchar [note: 'Code identifying the operational system that created or manages this catastrophe event record (e.g., ClaimCenter, ISO/PCS feed).']
  stat_reporting_required_flag boolean [note: 'Indicates whether this catastrophe event meets thresholds requiring special statutory reporting to state insurance departments.']
  total_case_reserve_amount decimal(18,2) [note: 'Sum of outstanding case reserves held for all open claims associated with this catastrophe event, in USD.']
  total_incurred_loss_amount decimal(18,2) [note: 'Sum of paid losses and outstanding case reserves for all claims associated with this catastrophe event, in USD.']
  total_paid_loss_amount decimal(18,2) [note: 'Sum of all loss payments made on claims associated with this catastrophe event, in USD.']
  ulae_amount decimal(18,2) [note: 'Estimated unallocated loss adjustment expenses attributable to this catastrophe event, in USD.']

  Note: 'Catastrophe event master: CAT code (ISO/PCS), event name, peril type, affected states/counties, open/close dates, industry loss estimate, and PML tier. SSOT for CAT claim aggregation and CAT XL triggering.'
}

Table reservespayments.reserve_study {
  reserve_study_id varchar [pk, note: 'Primary key for reserve_study']
  accident_year varchar [note: 'Calendar year in which the insured loss events occurred, used for cohort-based reserve analysis.']
  actuarial_method varchar [note: 'Actuarial technique applied in the study, such as chain ladder, Bornhuetter-Ferguson, expected loss ratio, or frequency-severity methods.']
  actuary_credential varchar [note: 'Professional actuarial designation held by the responsible actuary, such as Fellow or Associate of the Casualty Actuarial Society.']
  actuary_name varchar [note: 'Name of the credentialed actuary responsible for preparing and certifying the reserve study.']
  alae_reserve_amount decimal(18,2) [note: 'Reserve for loss adjustment expenses directly attributable to individual claims, such as legal and expert fees.']
  approval_date date [note: 'Date when the reserve study was formally approved by management or the board for financial reporting.']
  approved_by varchar [note: 'Name or identifier of the executive or committee that approved the reserve study.']
  case_reserve_amount decimal(18,2) [note: 'Sum of case reserves established by claims adjusters for known open claims as of the valuation date.']
  claim_count varchar [note: 'Number of claims included in the reserve study population for the specified cohort and coverage.']
  closed_claim_count varchar [note: 'Number of claims closed with payment or without payment as of the valuation date.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level percentage associated with the reserve estimate, typically ranging from 50 to 95 percent.']
  coverage_type varchar [note: 'Specific coverage or peril analyzed in the reserve study, providing granular segmentation within the line of business.']
  created_timestamp timestamp [note: 'Timestamp when the reserve study record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in the reserve study.']
  data_quality_rating varchar [note: 'Actuarial assessment of the quality and credibility of the underlying claims data used in the reserve study.']
  expected_loss_ratio decimal(7,4) [note: 'Ratio of expected ultimate losses to earned premium, used in Bornhuetter-Ferguson and expected loss ratio methods.']
  ibnr_claim_count_estimate varchar [note: 'Estimated number of claims incurred but not yet reported to the insurer as of the valuation date.']
  ibnr_reserve_amount decimal(18,2) [note: 'Actuarial estimate of reserves for claims incurred but not yet reported, including development on known claims.']
  line_of_business varchar [note: 'Insurance line of business covered by this reserve study, such as commercial auto, workers compensation, general liability, or property.']
  loss_development_factor decimal(10,4) [note: 'Multiplicative factor applied to paid or incurred losses to project ultimate losses, derived from historical development patterns.']
  modified_timestamp timestamp [note: 'Timestamp when the reserve study record was last modified or updated.']
  open_claim_count varchar [note: 'Number of claims still open and unpaid as of the valuation date, requiring case reserves.']
  paid_loss_amount decimal(18,2) [note: 'Total loss payments made to date for the claims in the study population, excluding loss adjustment expenses.']
  policy_year varchar [note: 'Policy year for which reserves are being studied, representing the year policies were written.']
  prior_reserve_amount decimal(18,2) [note: 'Reserve amount from the previous valuation or study, used for development and variance analysis.']
  report_year varchar [note: 'Calendar year in which claims were reported, used for report-year-based reserve development analysis.']
  reserve_change_amount decimal(18,2) [note: 'Net change in reserve estimate from the prior valuation, indicating reserve strengthening or release.']
  reserve_estimate_amount decimal(18,2) [note: 'Total reserve amount estimated by the study, representing the actuarial best estimate of unpaid claim liabilities.']
  reserve_high_estimate_amount decimal(18,2) [note: 'Upper bound of the reserve estimate range, representing an optimistic or high-severity scenario.']
  reserve_low_estimate_amount decimal(18,2) [note: 'Lower bound of the reserve estimate range, representing a conservative or pessimistic scenario.']
  salvage_subrogation_amount decimal(18,2) [note: 'Anticipated recoveries from salvage and subrogation, reducing net reserve requirements.']
  study_effective_date date [note: 'Date when the reserve study becomes effective for financial reporting and reserving purposes.']
  study_expiration_date date [note: 'Date when the reserve study is superseded or no longer applicable for reserving purposes.']
  study_name varchar [note: 'Descriptive name of the reserve study for identification and reporting purposes.']
  study_notes varchar [note: 'Free-text commentary and assumptions documented by the actuary regarding methodology, data quality, or special considerations.']
  study_number varchar [note: 'Business identifier for the reserve study, externally referenced in actuarial reports and regulatory filings.']
  study_status varchar [note: 'Current lifecycle status of the reserve study indicating its approval and publication state.']
  study_type varchar [note: 'Classification of reserve study: case reserves, incurred but not reported, unallocated loss adjustment expense, allocated loss adjustment expense, salvage and subrogation, or unallocated reserves.']
  ulae_reserve_amount decimal(18,2) [note: 'Reserve for loss adjustment expenses not attributable to individual claims, such as claims department overhead.']
  ultimate_loss_estimate_amount decimal(18,2) [note: 'Actuarial estimate of total losses that will ultimately be paid for the cohort, including paid and unpaid amounts.']
  valuation_date date [note: 'As-of date for which reserves are estimated and reported in this study.']

  Note: 'Master reference table for reserve_study. Referenced by reserve_study_id.'
}

Table reservespayments.actuarial_analyst {
  actuarial_analyst_id varchar [pk, note: 'Primary key for actuarial_analyst']
  party_id varchar [note: 'Company-issued employee identifier for the actuarial analyst.']
  supervisor_analyst_id varchar [note: 'Identifier of the supervising actuarial analyst for this analyst.']
  analyst_type varchar [note: 'Specialization area of the actuarial analyst within the organization.']
  appointed_actuary_flag boolean [note: 'Indicates whether the analyst is designated as the appointed actuary for statutory reporting purposes.']
  continuing_education_hours varchar [note: 'Total continuing education hours completed by the analyst in the current reporting period.']
  cost_center_code varchar [note: 'Financial cost center code to which the analyst salary and expenses are allocated.']
  created_timestamp timestamp [note: 'Timestamp when the actuarial analyst record was first created in the system.']
  credential_date date [note: 'Date when the analyst achieved their current professional credential.']
  credential_designation varchar [note: 'Specific professional designation held by the actuarial analyst.']
  credentialing_level varchar [note: 'Professional actuarial credentialing level achieved by the analyst.']
  department_code varchar [note: 'Code identifying the department where the actuarial analyst is assigned.']
  department_name varchar [note: 'Name of the department where the actuarial analyst is assigned.']
  email_address varchar [note: 'Primary business email address for the actuarial analyst.']
  employment_status varchar [note: 'Current employment status of the actuarial analyst.']
  first_name varchar [note: 'Legal first name of the actuarial analyst.']
  hire_date date [note: 'Date when the actuarial analyst was hired by the organization.']
  last_name varchar [note: 'Legal last name of the actuarial analyst.']
  last_training_date date [note: 'Date of the most recent professional training or continuing education completed by the analyst.']
  notes varchar [note: 'Additional notes or comments regarding the actuarial analyst record.']
  office_location varchar [note: 'Physical office location or site where the actuarial analyst is based.']
  phone_number varchar [note: 'Primary business phone number for the actuarial analyst.']
  primary_line_of_business varchar [note: 'Primary insurance line of business the analyst specializes in analyzing.']
  qualified_actuary_flag boolean [note: 'Indicates whether the analyst meets regulatory requirements as a qualified actuary for statutory filings.']
  remote_work_flag boolean [note: 'Indicates whether the analyst is authorized to work remotely.']
  security_clearance_level varchar [note: 'Data security clearance level granted to the analyst for accessing sensitive information.']
  signing_authority_flag boolean [note: 'Indicates whether the analyst has authority to sign actuarial opinions and statements.']
  termination_date date [note: 'Date when the actuarial analyst employment ended, if applicable.']
  updated_timestamp timestamp [note: 'Timestamp when the actuarial analyst record was last updated in the system.']
  work_schedule_type varchar [note: 'Employment schedule type for the actuarial analyst.']
  years_of_experience decimal(5,2) [note: 'Total years of actuarial experience accumulated by the analyst.']

  Note: 'Master reference table for actuarial_analyst. Referenced by actuarial_analyst_id.'
}

Table producers.producers_producer {
  producers_producer_id varchar [pk, note: 'Unique identifier for the producers_producer data product.']
  agency_id varchar [note: 'Reference to the parent agency or brokerage firm with which this individual producer is affiliated. Null for agency-level producer records. Supports hierarchical commission rollup.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Producer master record references default commission schedule via string code. Adding proper FK enables referential integrity.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Producer licensing and regulatory compliance require tracking the producer\'s domicile state. State DOI governs producer appointments, license renewals, and regulatory filings.']
  aml_certification_date date [note: 'Date on which the producer completed the most recent AML training certification. Used to track certification currency and trigger renewal reminders.']
  anti_money_laundering_certified boolean [note: 'Indicates whether the producer has completed required Anti-Money Laundering (AML) training certification. Mandatory for producers handling certain commercial and high-value personal lines.']
  appointment_effective_date date [note: 'Date on which the carrier\'s appointment of the producer became effective with the state Department of Insurance. Marks the start of the producer\'s authority to solicit business.']
  appointment_status varchar [note: 'Current lifecycle status of the producer\'s appointment with the carrier. Determines whether the producer is authorized to bind new business or service existing policies.']
  appointment_termination_date date [note: 'Date on which the carrier\'s appointment of the producer was terminated or expired. Null if the appointment is currently active. Required for NAIC termination filings.']
  background_check_date date [note: 'Date on which the most recent background check was completed for this producer. Used to determine if a refresh is required per carrier compliance policy.']
  background_check_status varchar [note: 'Status of the most recent background check conducted on the producer as part of the carrier\'s onboarding and ongoing compliance program. Required by many state DOIs.']
  binding_authority_granted boolean [note: 'Indicates whether the producer has been granted binding authority to commit the carrier to coverage without prior underwriting review. Drives workflow routing in PolicyCenter.']
  binding_authority_limit decimal(18,2) [note: 'Maximum single-risk premium or total insured value (TIV) in USD that the producer is authorized to bind without prior underwriting approval. Null if no binding authority is granted.']
  business_address_city varchar [note: 'City of the producer\'s principal place of business address.']
  business_address_line1 varchar [note: 'Primary street address line of the producer\'s principal place of business. Used for regulatory correspondence, appointment filings, and commission payment mailing.']
  business_address_state varchar [note: 'Two-letter USPS state code for the producer\'s principal place of business. Used for state-level regulatory filings and geographic distribution analytics.']
  business_address_zip varchar [note: 'US ZIP or ZIP+4 postal code for the producer\'s principal place of business. Used for geographic territory assignment and regulatory jurisdiction determination.']
  business_email varchar [note: 'Primary business email address for the producer. Used for policy documents, commission statements, regulatory notices, and system-generated alerts from PolicyCenter or Duck Creek.']
  business_phone varchar [note: 'Primary business telephone number for the producer\'s office. Used for underwriting communication, claims coordination, and regulatory correspondence.']
  contingent_commission_eligible boolean [note: 'Indicates whether the producer is eligible for contingent or profit-sharing commission based on loss ratio and volume performance thresholds defined in the producer agreement.']
  continuing_education_compliant boolean [note: 'Indicates whether the producer is current on state-mandated continuing education (CE) credit hours required for license renewal. Sourced from NIPR or AgentSync CE tracking.']
  created_timestamp timestamp [note: 'Timestamp when the producer record was first created in the producer management system. Audit trail field aligned with SOX data lineage requirements.']
  dba_name varchar [note: 'Trade or DBA name under which the producer operates if different from the legal name. Used on customer-facing documents and marketing materials.']
  e_and_o_carrier varchar [note: 'Name of the insurance carrier providing the producer\'s Errors and Omissions (E&O) professional liability coverage. Carrier requires active E&O as a condition of appointment.']
  e_and_o_expiration_date date [note: 'Expiration date of the producer\'s E&O professional liability policy. Compliance monitoring must alert before expiration to prevent appointment suspension.']
  e_and_o_limit_amount decimal(18,2) [note: 'Per-occurrence coverage limit of the producer\'s E&O professional liability policy in USD. Carrier may require a minimum limit as a condition of appointment for certain LOBs.']
  e_and_o_policy_number varchar [note: 'Policy number of the producer\'s active E&O professional liability insurance. Tracked to verify continuous coverage as a condition of maintaining carrier appointment.']
  entity_type varchar [note: 'Classification of the producer as an individual person or a business entity. Drives licensing requirements, commission structures, and regulatory reporting.']
  fein varchar [note: 'IRS-issued Federal Employer Identification Number for agency or corporate producer entities. Used for 1099 commission tax reporting and financial ledger payables processing.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the producer record in the producer management system. Used for change data capture (CDC) and data lineage tracking in the Snowflake lakehouse.']
  legal_name varchar [note: 'Full legal name of the producer as registered with the state Department of Insurance. For individuals, this is the full personal name; for agencies, the registered business name.']
  license_class varchar [note: 'Classification of the producer\'s license type as defined by the domicile state DOI (e.g., Property, Casualty, Personal Lines, Commercial Lines, Life, Accident & Health).']
  license_expiration_date date [note: 'Date on which the producer\'s domicile state insurance license expires. Carrier compliance systems must monitor this date to suspend appointment before license lapse.']
  license_number varchar [note: 'State-issued insurance producer license number in the producer\'s domicile state. Distinct from NPN; used for state-level regulatory filings and appointment verifications.']
  lines_of_authority varchar [note: 'Pipe-delimited list of lines of authority (LOA) for which the producer is licensed and appointed (e.g., Property|Casualty|Personal Lines). Governs which LOBs the producer may solicit.']
  managing_general_agent_code varchar [note: 'Code identifying the Managing General Agent (MGA) or wholesale broker through whom this producer accesses the carrier\'s products, if applicable. Used for MGA commission override calculations.']
  npn varchar [note: 'NIPR-assigned National Producer Number uniquely identifying the producer across all US states. Mandatory for regulatory licensing verification and NAIC reporting.']
  onboarding_date date [note: 'Date on which the producer completed the carrier\'s onboarding process and was first activated in the producer management system. Used for tenure analysis and cohort reporting.']
  preferred_lob varchar [note: 'Primary line of business (LOB) in which the producer specializes or generates the majority of written premium (e.g., Personal Auto, Homeowners, Commercial GL, BOP, WC). Used for territory and product alignment.']
  producer_code varchar [note: 'Carrier-assigned internal code uniquely identifying the producer within the policy administration system (Guidewire PolicyCenter or Duck Creek Policy). Used on policy DEC pages and commission statements.']
  producer_type varchar [note: 'Distribution channel classification indicating whether the producer is a captive agent (exclusive), independent agent, wholesale broker, or direct writer. Drives commission tier and appointment rules.']
  ssn_last4 varchar [note: 'Last four digits of the individual producer\'s SSN retained for identity verification and 1099 tax reporting. Full SSN must not be stored per PCI DSS and NIST SP 800-122 data minimization.']
  surplus_lines_licensed boolean [note: 'Indicates whether the producer holds a surplus lines license, authorizing placement of non-admitted coverage. Required for E&S market placements and surplus lines tax filings.']
  termination_reason varchar [note: 'Reason code for the termination of the producer appointment. Required for state DOI termination filings. \'For cause\' terminations trigger mandatory NAIC reporting within 30 days.']
  uw_authority_level varchar [note: 'Tiered underwriting authority level granted to the producer, controlling which risk classes and coverage limits the producer may quote and bind independently.']

  Note: 'SSOT master for every licensed insurance producer (agent or broker) appointed by the carrier. Owns producer identity, NPN, FEIN/SSN, entity type, and active status across all lines of business.'
}

Table producers.producer_license {
  producer_license_id varchar [pk, note: 'Unique surrogate identifier for a producer license record in the Pc_Insurance data platform. Primary key for the producer_license entity.']
  eno_policy_id varchar [note: 'Foreign key linking to producers.eno_policy. Business justification: Producer license tracks E&O coverage via string references. Adding proper FK to eno_policy enables referential integrity and eliminates redundant storage.']
  producers_producer_id varchar [note: 'Reference to the producer (agent or broker) who holds this license. Links the license record to the producer master entity.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Every producer license is issued by a specific state DOI. License verification, renewal tracking, and regulatory reporting require state reference.']
  appointment_date date [note: 'Date on which Pc_Insurance filed or received confirmation of the producer appointment with the issuing state DOI for this license.']
  appointment_required boolean [note: 'Indicates whether the issuing state requires a formal carrier appointment in addition to this license before the producer may transact business on behalf of Pc_Insurance.']
  appointment_status varchar [note: 'Current status of the producer\'s appointment with Pc_Insurance under this license and jurisdiction. Appointment is required before binding policies in states that mandate it.']
  appointment_termination_date date [note: 'Date on which the producer\'s appointment with Pc_Insurance was terminated for this license and jurisdiction. Null if the appointment is still active.']
  background_check_date date [note: 'Date on which the most recent background check was completed for this producer in connection with this license or appointment. Used for compliance audit and renewal tracking.']
  background_check_status varchar [note: 'Status of the background check conducted on the producer as part of the licensing or appointment process. Required by many states and carriers per DOI and SOX compliance.']
  ce_compliance_status varchar [note: 'Current compliance status of the producer with respect to continuing education (CE) requirements for this license. Drives renewal eligibility and compliance alerts.']
  ce_credits_completed varchar [note: 'Number of continuing education (CE) credit hours the producer has completed in the current renewal cycle toward satisfying the state DOI requirement for this license.']
  ce_credits_required varchar [note: 'Number of continuing education (CE) credit hours required by the issuing state DOI for renewal of this license within the current renewal cycle.']
  ce_due_date date [note: 'Deadline by which the producer must complete all required continuing education (CE) credits to qualify for license renewal in the issuing state.']
  continuing_education_required boolean [note: 'Indicates whether the issuing state requires the producer to complete continuing education (CE) credits as a condition of license renewal for this line of authority.']
  doi_last_verified_date date [note: 'Date on which this license record was last verified against the issuing state DOI or NIPR registry. Used to ensure data currency for compliance and appointment management.']
  doi_verification_status varchar [note: 'Status of the license verification against the issuing state Department of Insurance (DOI) records or NIPR. Flags discrepancies between internal records and official DOI data.']
  effective_date date [note: 'Date from which this producer license record is considered effective within Pc_Insurance systems. May differ from the DOI issue date if there was a processing lag.']
  expiration_date date [note: 'Date on which this producer license expires and must be renewed to remain in good standing with the issuing state DOI. Null if the license is perpetual.']
  inactivation_date date [note: 'Date on which this license record was marked inactive in Pc_Insurance systems due to expiration, revocation, or voluntary surrender. Null if the license remains active.']
  issue_date date [note: 'Date on which the state DOI originally issued this producer license. Used to calculate license tenure and seniority for compliance and commission purposes.']
  license_number varchar [note: 'Official license number assigned by the state Department of Insurance (DOI) to the producer. Used for regulatory verification and compliance tracking.']
  license_status varchar [note: 'Current regulatory status of the producer license as reported by the issuing state DOI. Drives eligibility to bind business in the jurisdiction.']
  license_type varchar [note: 'Classifies the license as individual, business entity, surplus lines, adjuster, or other category as defined by the issuing state DOI. [ENUM-REF-CANDIDATE: individual|business_entity|surplus_lines|adjuster|public_adjuster|managing_general_agent — promote']
  line_of_authority varchar [note: 'Specific line of authority granted by the DOI under this license (e.g., Property, Casualty, Life, Health, Personal Lines, Commercial Lines). Determines which products the producer may sell.']
  lob_code varchar [note: 'Standardized NAIC or internal Line of Business (LOB) code corresponding to the line of authority on this license. Used for regulatory reporting and system routing.']
  naic_producer_code varchar [note: 'National Association of Insurance Commissioners (NAIC) assigned producer code used for interstate licensing verification and regulatory reporting via the NIPR gateway.']
  notes varchar [note: 'Free-text field for compliance officers or producer management staff to record additional context, exceptions, or follow-up actions related to this producer license record.']
  npn varchar [note: 'Unique National Producer Number (NPN) assigned by NIPR/NAIC to the producer. Used for cross-state license verification, regulatory filings, and producer appointment records.']
  record_created_timestamp timestamp [note: 'Timestamp when this producer license record was first created in the Pc_Insurance data platform. Used for audit trail and data lineage per SOX and internal governance standards.']
  record_updated_timestamp timestamp [note: 'Timestamp when this producer license record was last modified in the Pc_Insurance data platform. Used for change tracking, audit trail, and incremental data pipeline processing.']
  regulatory_action_date date [note: 'Date of the most recent regulatory action taken against this producer license by the issuing state DOI. Null if no regulatory action has occurred.']
  regulatory_action_description varchar [note: 'Free-text description of the regulatory action taken against this producer license, including the nature of the violation and the DOI order or consent decree reference.']
  regulatory_action_indicator boolean [note: 'Indicates whether any regulatory action (e.g., suspension, revocation, fine, consent order) has been taken against this producer license by the issuing state DOI.']
  renewal_date date [note: 'Date on which the producer last successfully renewed this license with the issuing state DOI. Null if the license has never been renewed since original issuance.']
  resident_nonresident_indicator varchar [note: 'Indicates whether this license is a resident license (producer domiciled in the issuing state) or a non-resident license (producer licensed in another home state).']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this license record was sourced (e.g., AgentSync, Vertafore Sircon, NIPR). Used for data lineage and reconciliation.']
  source_system_license_code varchar [note: 'Native identifier for this license record in the originating operational system (e.g., AgentSync license record ID or Vertafore Sircon record key). Supports data lineage and reconciliation.']
  surplus_lines_eligible boolean [note: 'Indicates whether this license authorizes the producer to place business with non-admitted surplus lines carriers in the issuing state jurisdiction.']
  surplus_lines_license_number varchar [note: 'Separate surplus lines license number issued by the state DOI when the producer is authorized to place non-admitted surplus lines business. Null if not applicable.']
  termination_reason varchar [note: 'Reason code explaining why this license or appointment was terminated or cancelled. Used for regulatory reporting and producer compliance audit trails.']

  Note: 'State-issued insurance license held by a producer, including license number, line of authority (LOB), state jurisdiction, issue date, expiration date, and current status per DOI records.'
}

Table producers.appointment {
  appointment_id varchar [pk, note: 'Unique surrogate identifier for a producer appointment record in the Pc_Insurance system.']
  agency_id varchar [note: 'Reference to the agency or brokerage organization through which the individual producer is affiliated for this appointment.']
  commission_schedule_id varchar [note: 'Reference to the commission schedule governing base and contingent commission rates applicable to this appointment.']
  eno_policy_id varchar [note: 'Foreign key linking to producers.eno_policy. Business justification: Appointment tracks E&O coverage requirements but currently stores only expiry date and limit. Adding FK to eno_policy enables full policy details retrieval and referential integrity.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Appointments grant producers authority to write specific lines of business. Underwriting authority validation and commission calculation require LOB reference.']
  org_unit_id varchar [note: 'Reference to the Pc_Insurance legal carrier entity (e.g., admitted vs. surplus lines subsidiary) issuing this appointment.']
  producers_producer_id varchar [note: 'Reference to the licensed producer (agent or broker) receiving this carrier appointment.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Appointments are state-specific regulatory filings with state DOIs. Appointment tracking, termination reporting, and regulatory compliance require state reference.']
  appointed_by_user varchar [note: 'Username or employee ID of the carrier underwriting or producer management staff member who authorized this appointment.']
  appointment_status varchar [note: 'Current lifecycle state of the producer appointment as recognized by the carrier and state DOI.']
  appointment_type varchar [note: 'Classification of the producer appointment relationship. [ENUM-REF-CANDIDATE: agent|broker|managing_general_agent|surplus_lines_broker|reinsurance_intermediary|solicitor — promote to reference product]']
  background_check_date date [note: 'Date on which the most recent background check was completed for this producer appointment.']
  background_check_status varchar [note: 'Result of the carrier-required background screening conducted during producer onboarding prior to appointment activation.']
  base_commission_rate decimal(7,4) [note: 'Standard commission rate (as a decimal fraction) payable to the producer on new and renewal written premium under this appointment.']
  binding_authority_limit decimal(18,2) [note: 'Maximum single-risk premium or TIV the producer may bind without prior UW referral under this appointment. Null if no binding authority.']
  channel_type varchar [note: 'Distribution channel classification for this appointment, used in commission and production analytics.']
  contingent_commission_eligible boolean [note: 'Indicates whether the producer is eligible for contingent or profit-sharing commission under this appointment.']
  created_timestamp timestamp [note: 'Timestamp when this appointment record was first created in the Pc_Insurance data platform.']
  doi_approval_date date [note: 'Date the state DOI confirmed or approved the producer appointment filing. Null if pending or not required.']
  doi_filing_date date [note: 'Date the appointment was submitted to the state DOI for regulatory filing and approval.']
  doi_filing_reference varchar [note: 'State Department of Insurance confirmation or tracking number assigned when the appointment was filed with the regulator.']
  effective_date date [note: 'Date on which the carrier appointment becomes binding and the producer is authorized to solicit business.']
  expiration_date date [note: 'Date on which the carrier appointment expires or is scheduled to lapse. Null for perpetual appointments.']
  is_binding_authority boolean [note: 'Indicates whether the producer has been granted binding authority to commit coverage on behalf of Pc_Insurance without prior UW approval.']
  is_surplus_lines boolean [note: 'Indicates whether this appointment is for surplus lines (non-admitted) business, subject to separate state surplus lines regulations.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the Pc_Insurance legal entity under which this appointment is issued.']
  notes varchar [note: 'Free-text notes capturing special conditions, exceptions, or underwriting remarks associated with this producer appointment.']
  number varchar [note: 'Externally-known carrier-assigned appointment reference number used in DOI filings and bordereaux reporting.']
  producer_license_class varchar [note: 'Class of the underlying producer license authorizing this appointment, e.g., property, casualty, surplus lines.']
  producer_license_number varchar [note: 'State-issued insurance producer license number that underpins this appointment. Must be active in the appointment state.']
  source varchar [note: 'Indicates how this appointment was initiated: new business onboarding, renewal, transfer from another carrier entity, or reinstatement.']
  source_system_appointment_code varchar [note: 'Native primary key or record identifier for this appointment in the originating producer management system of record.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this appointment record was sourced, e.g., AgentSync or Vertafore Sircon.']
  termination_date date [note: 'Date on which the appointment was formally terminated prior to its scheduled expiration, if applicable.']
  termination_reason varchar [note: 'Reason code explaining why the appointment was terminated. Required for DOI termination filings per NAIC guidelines.']
  training_completed boolean [note: 'Indicates whether the producer has completed all mandatory carrier product and compliance training required for this appointment.']
  training_completion_date date [note: 'Date on which the producer completed all required carrier training for this appointment.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this appointment record in the Pc_Insurance data platform.']

  Note: 'Formal carrier appointment authorizing a producer to sell specific LOBs in a given state on behalf of Pc_Insurance. Tracks appointment status, effective/expiration dates, and DOI filing reference.'
}

Table producers.agency {
  agency_id varchar [pk, note: 'Unique surrogate identifier for the agency or brokerage firm record in the producers domain.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Agency master record references default commission schedule via string code. Adding proper FK enables referential integrity.']
  parent_agency_id varchar [note: 'Self-referencing identifier linking this agency to its parent agency or network group, enabling hierarchical rollup of production, commission, and loss data.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Agency domicile state determines regulatory jurisdiction, licensing requirements, and tax obligations. Agency onboarding and compliance tracking require state reference.']
  agency_code varchar [note: 'Externally-known alphanumeric code assigned to the agency by Pc_Insurance, used on policy declarations, bordereaux, and commission statements.']
  agency_status varchar [note: 'Current lifecycle status of the agency appointment with Pc_Insurance, governing whether the agency may bind new business or renew policies.']
  agency_type varchar [note: 'Classification of the agency by distribution channel role. [ENUM-REF-CANDIDATE: independent_agent|captive_agent|broker|managing_general_agent|surplus_lines_broker|wholesale_broker — promote to reference product]']
  annual_premium_volume decimal(18,2) [note: 'Most recently reported annual written premium (WP) volume placed by the agency across all carriers, used for producer tiering, contingent commission, and appetite decisions.']
  appointment_effective_date date [note: 'Date on which the agency appointment with Pc_Insurance became effective, marking the start of the contractual producer relationship and binding authority.']
  appointment_termination_date date [note: 'Date on which the agency appointment with Pc_Insurance was or will be terminated. Null for active appointments. Required for DOI termination notice filings.']
  background_check_date date [note: 'Date on which the most recent background check was completed for the agency principal(s), used to track compliance with periodic re-screening requirements.']
  background_check_status varchar [note: 'Status of the most recent background check conducted on the agency principal(s) as part of the producer onboarding and appointment compliance process.']
  binding_authority_flag boolean [note: 'Indicates whether the agency has been granted binding authority by Pc_Insurance to commit coverage on behalf of the insurer without prior underwriting approval.']
  binding_authority_limit decimal(18,2) [note: 'Maximum single-risk premium or total insured value (TIV) the agency is authorized to bind without prior underwriting approval, expressed in USD.']
  contingent_commission_eligible boolean [note: 'Indicates whether the agency is eligible for contingent or profit-sharing commission based on loss ratio (LR) and volume performance thresholds.']
  created_timestamp timestamp [note: 'Timestamp when the agency record was first created in the producer management system, providing the audit trail start point for the agency lifecycle.']
  dba_name varchar [note: 'Trade or assumed name under which the agency operates if different from its legal name. DBA is registered with the state and used in consumer-facing communications.']
  email_address varchar [note: 'Primary business email address for the agency, used for policy documents, commission statements, renewal notices, and regulatory correspondence.']
  eo_carrier_name varchar [note: 'Name of the insurance carrier providing the agency Errors and Omissions (E&O) professional liability coverage, required for appointment and ongoing compliance.']
  eo_coverage_amount decimal(18,2) [note: 'Per-occurrence limit of the agency E&O professional liability policy in USD. Pc_Insurance requires a minimum threshold for appointment eligibility.']
  eo_expiration_date date [note: 'Expiration date of the agency E&O professional liability policy. Pc_Insurance monitors this date to ensure continuous coverage and trigger renewal reminders.']
  eo_policy_number varchar [note: 'Policy number of the agency Errors and Omissions (E&O) professional liability insurance policy, used to verify coverage during appointment and renewal audits.']
  fax_number varchar [note: 'Business fax number for the agency, used for document transmission including policy applications, endorsement requests, and claims correspondence.']
  fein varchar [note: 'IRS-issued Federal Employer Identification Number (FEIN) for the agency entity, required for tax reporting, commission 1099 issuance, and regulatory filings.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the agency record in the producer management system, supporting audit trail, change detection, and incremental data pipeline processing.']
  legal_name varchar [note: 'Full legal registered name of the agency or brokerage firm as filed with the state Department of Insurance (DOI) and used on all regulatory and contractual documents.']
  loss_ratio decimal(7,4) [note: 'Most recently calculated loss ratio (LR) for the agency book of business with Pc_Insurance, expressed as a decimal. Used for contingent commission eligibility and UW appetite review.']
  managing_ga_flag boolean [note: 'Indicates whether the agency operates as a Managing General Agent (MGA) with delegated underwriting authority, distinct from a standard retail or wholesale broker.']
  naic_producer_code varchar [note: 'NAIC-assigned producer code uniquely identifying the agency across all state DOI licensing systems and NAIC databases for regulatory reporting.']
  network_code varchar [note: 'Code identifying the independent agency network or cluster group (e.g., Keystone, Argo) to which the agency belongs, used for network-level commission and volume tracking.']
  onboarding_completed_date date [note: 'Date on which the agency completed all onboarding requirements including licensing verification, E&O confirmation, background check, and system credentialing.']
  pc_insurance_gwp decimal(18,2) [note: 'Gross written premium (GWP) placed with Pc_Insurance by this agency in the most recent policy year, used for production performance tracking and commission tier qualification.']
  phone_number varchar [note: 'Primary business telephone number for the agency, used for underwriting communication, claims coordination, and producer management outreach.']
  preferred_lob_codes varchar [note: 'Comma-separated list of line of business (LOB) codes the agency is authorized or preferred to write, such as GL, BOP, WC, CPP, APD. Used for appetite and routing.']
  principal_address_line1 varchar [note: 'First line of the agency principal business address, used for regulatory correspondence, commission payments, and DOI licensing records.']
  principal_address_line2 varchar [note: 'Second line of the agency principal business address (suite, floor, unit). Supplements address_line1 for complete mailing address.']
  principal_city varchar [note: 'City of the agency principal business address, used for geographic segmentation, state licensing jurisdiction determination, and regulatory filings.']
  principal_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the agency principal business address. Typically USA for domestic agencies; supports surplus lines and international brokers.']
  principal_postal_code varchar [note: 'ZIP or ZIP+4 postal code for the agency principal business address, used for geographic rating territory assignment and regulatory correspondence.']
  surplus_lines_licensed boolean [note: 'Indicates whether the agency holds a surplus lines broker license, authorizing placement of non-admitted coverage with eligible surplus lines insurers.']
  termination_reason varchar [note: 'Reason code for the termination of the agency appointment. Required for state DOI termination notice filings per NAIC Producer Licensing Model Act.']
  territory_code varchar [note: 'Pc_Insurance internal territory or region code assigned to the agency for field underwriting management, production tracking, and geographic performance reporting.']
  website_url varchar [note: 'Public website URL for the agency, used for producer directory listings, digital marketing attribution, and consumer-facing producer locator tools.']
  years_in_business varchar [note: 'Number of years the agency has been in operation since its founding date. Used in underwriting appetite scoring and producer tiering for contingent commission eligibility.']

  Note: 'Master record for an agency or brokerage firm through which producers operate. Captures agency name, FEIN, DBA, principal address, agency type, and E&O coverage details.'
}

Table producers.agency_producer {
  agency_producer_id varchar [pk, note: 'Unique surrogate identifier for the agency-producer association record in the producers domain.']
  agency_id varchar [note: 'Reference to the agency entity with which the producer is associated.']
  agency_producers_producer_id varchar [note: 'Reference to the individual producer (agent or broker) associated with the agency.']
  commission_schedule_id varchar [note: 'Reference to the commission plan governing the producer\'s compensation under this agency association.']
  eno_policy_id varchar [note: 'Foreign key linking to producers.eno_policy. Business justification: Agency-producer association tracks E&O coverage via string policy_number. Adding proper FK to eno_policy enables referential integrity and eliminates redundant storage of policy details.']
  parent_producer_producers_producer_id varchar [note: 'Reference to the supervising or parent producer within the agency hierarchy. Null if the producer is at the top of the hierarchy.']
  appointment_date date [note: 'Date the producer was formally appointed by the carrier or state DOI under this agency relationship.']
  appointment_expiry_date date [note: 'Date on which the producer\'s state appointment under this agency expires and must be renewed to remain in good standing.']
  appointment_number varchar [note: 'State-issued or carrier-issued appointment number confirming the producer\'s authority to represent the agency and bind business on behalf of the insurer.']
  appointment_state varchar [note: 'Two-letter US state code for the jurisdiction in which the producer is appointed under this agency association.']
  association_role varchar [note: 'Role the producer holds within the agency, such as principal agent, sub-agent, or broker. [ENUM-REF-CANDIDATE: principal_agent|sub_agent|broker|managing_agent|surplus_lines_agent|appointed_agent — promote to reference product]']
  association_source varchar [note: 'Source system or process through which this agency-producer association record was created or last updated (e.g., AgentSync, Vertafore Sircon, manual entry).']
  association_status varchar [note: 'Current lifecycle status of the producer-agency relationship (e.g., active, suspended, terminated).']
  background_check_date date [note: 'Date on which the most recent background check was completed for this producer under this agency association.']
  background_check_status varchar [note: 'Status of the most recent background check conducted on the producer as part of agency onboarding or periodic compliance review.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has delegated binding authority to commit coverage on behalf of the insurer without prior underwriting approval.']
  binding_authority_limit decimal(18,2) [note: 'Maximum single-risk premium or Total Insured Value (TIV) the producer may bind under delegated authority without referral to underwriting.']
  ce_credits_completed varchar [note: 'Number of continuing education (CE) credit hours the producer has completed in the current compliance period under this agency association.']
  ce_credits_required varchar [note: 'Number of continuing education (CE) credit hours required for the producer to maintain compliance under this agency and state appointment.']
  channel_type varchar [note: 'Distribution channel classification for the producer within this agency (e.g., independent agent, captive agent, MGA, surplus lines broker).']
  commission_split_pct decimal(5,4) [note: 'Decimal fraction (0.0000–1.0000) representing the producer\'s share of the agency commission for business written under this association.']
  contingent_commission_eligible boolean [note: 'Indicates whether the producer is eligible for contingent or profit-sharing commission under this agency arrangement based on loss ratio and volume thresholds.']
  created_timestamp timestamp [note: 'Timestamp when this agency-producer association record was first created in the system.']
  effective_date date [note: 'Date on which the producer\'s association with the agency became or becomes effective.']
  external_association_ref varchar [note: 'Identifier for this agency-producer association in the source producer management system (AgentSync or Vertafore Sircon) for reconciliation and audit.']
  hierarchy_level varchar [note: 'Numeric level of the producer within the agency hierarchy (e.g., 1 = principal, 2 = senior agent, 3 = sub-agent). Used for commission override calculations.']
  is_primary_agency boolean [note: 'Indicates whether this agency is the producer\'s primary or home agency, as opposed to a secondary or additional appointment.']
  is_principal boolean [note: 'Indicates whether the producer is the principal agent of the agency, holding primary authority and accountability within the agency hierarchy.']
  lob_authorizations varchar [note: 'Comma-separated list of Lines of Business (LOB) the producer is authorized to write under this agency (e.g., GL, WC, APD, BOP). Derived from appointment scope.']
  mga_flag boolean [note: 'Indicates whether the producer operates as a Managing General Agent (MGA) with delegated underwriting and binding authority under this agency.']
  naic_pdb_status varchar [note: 'Status of the producer in the NAIC Producer Database (PDB), reflecting any adverse licensing or regulatory history across all states.']
  override_commission_pct decimal(5,4) [note: 'Additional override commission percentage earned by a principal or managing agent on business written by sub-agents within the hierarchy.']
  record_version varchar [note: 'Optimistic locking version counter incremented on each update to this association record, supporting concurrency control and change tracking.']
  regulatory_action_flag boolean [note: 'Indicates whether the producer has an open or historical regulatory action (e.g., DOI investigation, license suspension) relevant to this agency association.']
  surplus_lines_licensed boolean [note: 'Indicates whether the producer holds a surplus lines license under this agency association, permitting placement with non-admitted carriers.']
  termination_date date [note: 'Date on which the producer\'s association with the agency was or is scheduled to be terminated. Null if still active.']
  termination_notes varchar [note: 'Free-text notes providing additional context for the termination of the producer-agency association, used for compliance documentation.']
  termination_reason varchar [note: 'Reason code for the termination of the producer-agency association. [ENUM-REF-CANDIDATE: voluntary|involuntary|license_lapse|e_and_o_lapse|regulatory_action|merger|other — promote to reference product]']
  training_compliance_status varchar [note: 'Indicates whether the producer has met all required continuing education (CE) and product training obligations under this agency association.']
  updated_timestamp timestamp [note: 'Timestamp when this agency-producer association record was last modified.']

  Note: 'Junction table associating producers to agencies, capturing role, start/end dates, and whether the producer is the principal or sub-agent within the agency hierarchy.'
}

Table producers.eno_policy {
  eno_policy_id varchar [pk, note: 'Unique identifier for the eno_policy data product (auto-inserted during validation).']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: E&O policies track premium amounts and coverage limits in specific currencies. Financial reporting and compliance verification require currency reference. Removes denormalized currency_code.']
  producers_producer_id varchar [note: 'Reference to the licensed producer or agency entity that holds this E&O policy.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: E&O policies have state-specific regulatory requirements and coverage terms. Producer compliance verification and appointment eligibility require state reference.']
  additional_insured_indicator boolean [note: 'Indicates whether the appointing carrier is listed as an additional insured on the producer\'s E&O policy.']
  aggregate_limit_amount decimal(18,2) [note: 'Maximum total dollar amount the E&O policy will pay across all covered claims within the policy period.']
  annual_premium_amount decimal(18,2) [note: 'Total annual premium paid by the producer or agency for the E&O policy. Used in cost-of-distribution and producer profitability analysis.']
  auto_renewal_indicator boolean [note: 'Indicates whether the E&O policy is set to automatically renew upon expiration without requiring manual re-submission.']
  cancellation_date date [note: 'Date on which the E&O policy was cancelled mid-term, if applicable. Null if the policy was not cancelled before its expiration date.']
  cancellation_reason varchar [note: 'Reason code for mid-term cancellation of the E&O policy. Used in compliance reporting and producer risk assessment.']
  certificate_received_date date [note: 'Date on which the certificate of insurance evidencing E&O coverage was received and logged by the carrier\'s producer management team.']
  compliance_status varchar [note: 'Compliance determination for the E&O policy relative to carrier appointment requirements. Drives appointment eligibility and suspension workflows.']
  compliance_verified_by varchar [note: 'Name or user identifier of the compliance officer or system that last verified the E&O policy meets appointment requirements.']
  compliance_verified_date date [note: 'Most recent date on which the E&O policy was verified as compliant with carrier appointment requirements by the producer management team.']
  coverage_form_type varchar [note: 'Indicates whether the E&O policy is written on a claims-made or occurrence basis, which determines when coverage is triggered.']
  deductible_amount decimal(18,2) [note: 'Dollar amount the insured producer or agency must pay out-of-pocket per claim before E&O coverage responds.']
  effective_date date [note: 'Date on which the E&O policy coverage becomes active and binding. Used to validate appointment eligibility windows.']
  expiration_date date [note: 'Date on which the E&O policy coverage terminates. Triggers compliance alerts and appointment suspension workflows.']
  extended_reporting_period_days varchar [note: 'Number of days after policy expiration during which claims arising from prior acts may still be reported under a claims-made E&O policy.']
  insurer_naic_code varchar [note: 'Five-digit NAIC company code identifying the E&O insurer. Used for statutory reporting and carrier validation.']
  insurer_name varchar [note: 'Legal name of the insurance carrier providing the E&O coverage to the producer or agency.']
  lob_covered varchar [note: 'Comma-delimited list of lines of business (e.g., P&C, Life, Health) for which the E&O policy provides professional liability coverage.']
  minimum_required_limit_met boolean [note: 'Indicates whether the policy\'s per-occurrence and aggregate limits meet the carrier\'s minimum E&O requirements for appointment.']
  multi_state_indicator boolean [note: 'Indicates whether the E&O policy provides coverage across multiple state jurisdictions beyond the primary filing state.']
  named_insured varchar [note: 'Legal name of the individual producer or agency entity listed as the named insured on the E&O policy declarations page.']
  notes varchar [note: 'Free-text field for compliance officers to record observations, exceptions, or follow-up actions related to the E&O policy.']
  occurrence_limit_amount decimal(18,2) [note: 'Maximum dollar amount the E&O policy will pay for a single covered claim or occurrence. Validated against carrier minimum requirements.']
  policy_number varchar [note: 'Externally-assigned policy number issued by the E&O insurer, used for correspondence, audits, and appointment compliance verification.']
  policy_status varchar [note: 'Current lifecycle state of the E&O policy. Drives appointment eligibility and compliance holds within the producer management system.']
  policy_type varchar [note: 'Classifies the E&O policy as individual producer, agency-level, group program, or excess layer coverage.']
  prior_acts_coverage_indicator boolean [note: 'Indicates whether the E&O policy includes prior acts coverage, extending protection to acts occurring before the retroactive date.']
  record_created_timestamp timestamp [note: 'Timestamp when this E&O policy record was first created in the data platform. Supports audit trail and data lineage requirements.']
  record_updated_timestamp timestamp [note: 'Timestamp when this E&O policy record was last modified in the data platform. Used for change detection and incremental processing.']
  renewal_reminder_days varchar [note: 'Number of days before expiration that automated renewal reminder notifications are triggered to the producer and compliance team.']
  retroactive_date date [note: 'Earliest date from which acts, errors, or omissions are covered under a claims-made E&O policy. Null for occurrence-based forms.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this E&O policy record was ingested (e.g., AgentSync, Vertafore Sircon).']
  source_system_record_code varchar [note: 'Native primary key or record identifier from the originating producer management system for lineage and reconciliation purposes.']
  waiver_approved_by varchar [note: 'Name or user identifier of the compliance authority who approved the E&O compliance waiver for this producer.']
  waiver_expiration_date date [note: 'Date on which the compliance waiver expires, after which the producer must provide a compliant E&O policy to maintain appointment.']
  waiver_reason varchar [note: 'Documented justification for granting a compliance waiver when the E&O policy does not meet standard appointment requirements.']

  Note: 'Errors and Omissions (E&O) insurance policy held by a producer or agency. Tracks insurer, policy number, coverage limit, effective/expiration dates, and compliance status required for appointment.'
}

Table producers.commission_schedule {
  commission_schedule_id varchar [pk, note: 'Unique surrogate identifier for a commission schedule record. Primary key for the commission_schedule product in the producers domain.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission schedules specify rates and thresholds in specific currencies. Multi-currency commission calculation and financial reporting require currency reference.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Commission rates are structured by line of business due to varying risk profiles and market dynamics. Commission calculation and profitability analysis require LOB reference.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Commission schedules vary by state due to regulatory requirements and market conditions. Commission calculation and regulatory filing require state reference. Removes denormalized state_code.']
  superseded_by_commission_schedule_id varchar [note: 'Reference to the commission_schedule_id of the newer schedule that replaced this one. Null if this is the current active version. Supports schedule lineage and audit trails.']
  approval_date date [note: 'Date on which this commission schedule received final approval from the designated authority. Null if approval is still pending or the schedule was rejected.']
  approval_status varchar [note: 'Internal approval workflow status for this commission schedule. Schedules must be approved before activation. Supports SOX-compliant change management and audit trail requirements.']
  approved_by varchar [note: 'Name or employee identifier of the underwriting or finance authority who approved this commission schedule for activation. Required for SOX audit trail and governance compliance.']
  base_commission_rate decimal(7,4) [note: 'Standard base commission rate expressed as a decimal percentage of Written Premium (WP) earned by the producer for qualifying policies under this schedule.']
  cancellation_chargeback_rate decimal(7,4) [note: 'Rate at which previously paid commission is charged back to the producer upon policy cancellation (CANC). Applied to the unearned premium returned to the policyholder.']
  channel varchar [note: 'Distribution channel to which this commission schedule applies: independent agent, captive agent, direct, broker, or digital. Enables channel-specific commission differentiation.']
  combined_ratio_threshold decimal(7,4) [note: 'Maximum permissible Combined Ratio (CR) for the producer\'s portfolio to qualify for profit-sharing or contingent bonus. Incorporates both Loss Ratio (LR) and Expense Ratio (ER).']
  commission_schedule_description varchar [note: 'Free-text narrative describing the business purpose, eligibility criteria, and special conditions of this commission schedule. Used in producer agreements and internal documentation.']
  contingent_bonus_rate decimal(7,4) [note: 'Additional contingent bonus rate payable on top of the base commission when the producer meets profitability or volume thresholds defined in the bonus tier configuration.']
  created_timestamp timestamp [note: 'Timestamp when this commission schedule record was first created in the system. Supports audit trail, data lineage, and SOX compliance requirements.']
  dac_eligible boolean [note: 'Indicates whether commissions paid under this schedule qualify as Deferred Acquisition Costs (DAC) for GAAP accounting purposes under ASC 944, requiring capitalization and amortization.']
  effective_date date [note: 'Date on which this commission schedule becomes active and applicable to qualifying producer transactions. Policies bound on or after this date are subject to these rates.']
  endorsement_rate decimal(7,4) [note: 'Commission rate applied to mid-term endorsement (ENDT) transactions that generate additional premium. Applied to the net additional premium resulting from the endorsement.']
  expiration_date date [note: 'Date on which this commission schedule ceases to be applicable. Null indicates an open-ended schedule with no defined end date. Superseded schedules retain history.']
  filing_reference varchar [note: 'State DOI filing reference number or SERFF tracking number associated with the regulatory submission of this commission schedule. Null if no filing is required.']
  gl_account_code varchar [note: 'General Ledger (GL) account code in Oracle Financials or SAP FI to which commission expenses under this schedule are posted. Ensures accurate financial reporting and cost allocation.']
  loss_ratio_threshold decimal(7,4) [note: 'Maximum permissible Loss Ratio (LR) expressed as a decimal that the producer\'s book must not exceed to remain eligible for contingent bonus or profit-sharing commission under this schedule.']
  max_volume_premium decimal(18,2) [note: 'Upper Written Premium (WP) volume cap in USD above which this schedule tier no longer applies and the producer advances to the next tier. Null indicates no upper cap.']
  measurement_period varchar [note: 'Time period over which producer volume, loss ratio, and profitability metrics are measured to determine eligibility and payout under this commission schedule.']
  min_policy_count varchar [note: 'Minimum number of in-force policies the producer must maintain during the measurement period to qualify for this commission schedule or contingent bonus tier.']
  min_volume_premium decimal(18,2) [note: 'Minimum Written Premium (WP) volume in USD that a producer must generate within the measurement period to qualify for this commission schedule or contingent bonus tier.']
  new_business_rate decimal(7,4) [note: 'Specific commission rate applied to New Business (NB) policy transactions when the schedule differentiates NB from renewal rates. Overrides base_commission_rate for NB transactions.']
  notes varchar [note: 'Internal operational notes or comments regarding exceptions, amendments, or special handling instructions for this commission schedule. Not exposed in producer-facing documents.']
  override_rate decimal(7,4) [note: 'Override percentage applied to the base commission rate for managing general agents or hierarchical producers who earn a spread on sub-producer business.']
  payment_frequency varchar [note: 'Frequency at which earned commissions under this schedule are calculated and disbursed to the producer, e.g., monthly, quarterly, semi-annual, or annual.']
  producer_tier varchar [note: 'Producer performance or appointment tier to which this schedule applies. Tier determines eligibility for enhanced base rates, contingent bonuses, and override percentages.']
  producer_type varchar [note: 'Type of producer entity this schedule governs: independent agent, broker, Managing General Agent (MGA), MGA-E, or surplus lines broker. Affects regulatory disclosure and payout rules.']
  profit_sharing_rate decimal(7,4) [note: 'Rate applied to the producer\'s eligible profit base to calculate profit-sharing commission. Payable when the producer\'s book achieves profitability targets defined by loss and combined ratio thresholds.']
  regulatory_filing_required boolean [note: 'Indicates whether this commission schedule must be filed with the applicable State Department of Insurance (DOI) prior to use, as required by state producer compensation disclosure regulations.']
  renewal_rate decimal(7,4) [note: 'Specific commission rate applied to Renewal (REN) policy transactions. Typically lower than the New Business (NB) rate, reflecting reduced acquisition cost for retained policies.']
  schedule_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this commission schedule, used in producer agreements, bordereaux, and system configuration references.']
  schedule_name varchar [note: 'Human-readable name describing this commission schedule, used in producer-facing documents, commission statements, and reporting dashboards.']
  schedule_status varchar [note: 'Current lifecycle status of the commission schedule: draft (pending approval), active (in force), suspended (temporarily halted), expired (past end date), or superseded (replaced by newer version).']
  schedule_type varchar [note: 'Classifies the commission schedule as base, contingent, override, profit-sharing, or bonus. Drives calculation logic and payout eligibility rules in the commission engine.']
  stat_expense_code varchar [note: 'NAIC statutory expense code used to classify commission payments in the Annual Statement Underwriting and Investment Exhibit. Required for statutory financial reporting.']
  transaction_type varchar [note: 'Policy transaction type to which this schedule applies: New Business (NB), Renewal (REN), Endorsement (ENDT), Cancellation (CANC), or Reinstatement. Enables differential commission rates by transaction.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this commission schedule record. Used for change detection, incremental data loads, and audit trail maintenance.']
  version_number varchar [note: 'Monotonically incrementing version number for this commission schedule. Enables tracking of rate changes and amendments over time while preserving historical rate configurations.']

  Note: 'Reference schedule defining base commission rates, contingent bonus tiers, and override percentages by LOB, policy transaction type (NB, REN), and producer tier. SSOT for commission rate configuration.'
}

Table producers.commission_transaction {
  commission_transaction_id varchar [pk, note: 'Unique surrogate identifier for each commission transaction record in the producers domain. Primary key for the commission_transaction data product.']
  commission_schedule_id varchar [note: 'Reference to the commission schedule that defines the applicable rate tiers and rules governing this transaction.']
  commission_statement_id varchar [note: 'Reference to the commission statement (remittance advice) on which this transaction was included and settled.']
  coverage_policy_coverage_id varchar [note: 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Commission transactions must link to specific coverages for accurate allocation on multi-coverage policies, reinsurance commission calculations, and coverage-specific']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission transactions are denominated in specific currencies. Multi-currency accounting, payment processing, and financial reporting require currency reference.']
  endorsement_id varchar [note: 'Foreign key linking to coverage.coverage_endorsement. Business justification: Commissions on endorsements require direct linkage for proper accounting of mid-term premium changes, chargeback processing on cancellations, and reconciliation of']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Commission transactions are categorized by line of business for profitability analysis and producer performance reporting. LOB-level commission analysis requires LOB reference.']
  original_transaction_id varchar [note: 'For reversal or adjustment transactions, references the commission_transaction_id of the original transaction being corrected or reversed.']
  policy_id varchar [note: 'Reference to the policy that generated this commission transaction, linking commission to the underlying insured risk.']
  producers_producer_id varchar [note: 'Reference to the licensed producer (agent or broker) who earned or was adjusted for this commission transaction.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Commission transactions are allocated to states for premium tax reporting and regulatory compliance. State-level commission analysis and tax filing require state reference.']
  accounting_date date [note: 'The date on which this commission transaction is recognized in the general ledger for statutory and GAAP financial reporting purposes.']
  adjustment_amount decimal(18,2) [note: 'Dollar amount of any adjustment applied to the gross commission, including chargebacks on cancellations, pro-rata returns, or manual corrections. Negative for deductions.']
  approval_status varchar [note: 'Workflow approval state for this commission transaction: PENDING review, APPROVED for payment, REJECTED with reason, or ESCALATED to management.']
  approval_timestamp timestamp [note: 'Date and time when this commission transaction was approved for payment, providing an audit trail for SOX and internal controls compliance.']
  approved_by varchar [note: 'Username or employee ID of the internal staff member who approved this commission transaction for payment, supporting SOX audit trail requirements.']
  cancellation_reason_code varchar [note: 'Standardized code indicating the reason for policy cancellation when transaction_type is CANC, used to determine chargeback applicability and proration method.']
  chargeback_amount decimal(18,2) [note: 'Amount clawed back from the producer due to policy cancellation, mid-term endorsement reduction, or non-payment of premium. Positive value represents a debit to the producer.']
  commission_rate decimal(7,4) [note: 'The percentage rate applied to the GWP basis to calculate the gross commission amount, expressed as a decimal (e.g., 0.1200 = 12%).']
  commission_type varchar [note: 'Categorizes the nature of the commission: Standard, Contingent, Override, Bonus, Chargeback, or Supplemental. [ENUM-REF-CANDIDATE: STANDARD|CONTINGENT|OVERRIDE|BONUS|CHARGEBACK|SUPPLEMENTAL — promote to reference product]']
  contingent_commission_flag boolean [note: 'Indicates whether this transaction includes a contingent (profit-sharing) commission component subject to loss ratio performance thresholds.']
  cost_center_code varchar [note: 'The financial cost center responsible for this commission expense, used for internal management reporting and expense allocation.']
  created_timestamp timestamp [note: 'Date and time when this commission transaction record was first created in the data platform, used for audit trail and data lineage tracking.']
  dac_eligible_flag boolean [note: 'Indicates whether this commission qualifies as a Deferred Acquisition Cost (DAC) under US GAAP ASC 944, requiring deferral and amortization over the policy term.']
  earned_commission_amount decimal(18,2) [note: 'The portion of net commission recognized as earned in the current accounting period, pro-rated over the policy term for DAC and Earned Premium (EP) alignment.']
  gl_account_code varchar [note: 'The General Ledger (GL) account code to which this commission expense is posted in the statutory and GAAP financial ledger.']
  gross_commission_amount decimal(18,2) [note: 'The total commission earned before any adjustments, chargebacks, or withholdings. Calculated as GWP basis multiplied by the commission rate.']
  gwp_basis_amount decimal(18,2) [note: 'The Gross Written Premium (GWP) amount on which the commission rate is applied to calculate the earned commission for this transaction.']
  net_commission_amount decimal(18,2) [note: 'The final commission amount payable to the producer after applying all adjustments and chargebacks. Equals gross commission plus adjustment amount.']
  override_commission_amount decimal(18,2) [note: 'Additional override or bonus commission paid to a managing general agent (MGA) or supervising producer above the base commission rate.']
  payment_date date [note: 'The date on which the net commission amount was disbursed to the producer via check, ACH, or wire transfer.']
  payment_method varchar [note: 'The disbursement method used to pay the producer: ACH (direct deposit), CHECK, WIRE transfer, OFFSET against amounts owed, or CREDIT_MEMO.']
  payment_status varchar [note: 'Indicates whether the commission amount has been disbursed to the producer: UNPAID, PAID, PARTIALLY_PAID, or WITHHELD (e.g., pending E&O compliance).']
  policy_effective_date date [note: 'The date the underlying policy or endorsement became effective, used to align commission earning with the policy period for DAC and UEP calculations.']
  policy_expiration_date date [note: 'The date the underlying policy period ends, used to prorate earned commission over the policy term and compute Deferred Acquisition Cost (DAC).']
  pro_rata_factor decimal(7,6) [note: 'The pro-rata fraction applied to compute earned or returned commission on mid-term endorsements and cancellations, based on days remaining in the policy term.']
  reversal_flag boolean [note: 'Indicates whether this transaction is a reversal of a previously posted commission, used to identify offsetting entries in reconciliation and audit.']
  source_system_code varchar [note: 'Identifies the operational system of record that originated this commission transaction (e.g., GUIDEWIRE, DUCK_CREEK, SAPIENS, ORACLE, SAP).']
  source_transaction_reference varchar [note: 'The native transaction identifier from the originating system of record (e.g., Guidewire BillingCenter transaction ID), used for lineage and reconciliation.']
  tax_withholding_amount decimal(18,2) [note: 'Federal or state income tax withheld from the commission payment for 1099 or backup withholding compliance, reported on IRS Form 1099-MISC.']
  transaction_date date [note: 'The business event date on which the commission was earned or adjusted, typically aligned to the policy effective date or endorsement effective date.']
  transaction_number varchar [note: 'Externally visible business reference number for this commission transaction, used in producer remittance advice and reconciliation.']
  transaction_status varchar [note: 'Current lifecycle state of the commission transaction: PENDING (awaiting approval), APPROVED, PAID, REVERSED, VOIDED, or ON_HOLD. [ENUM-REF-CANDIDATE: PENDING|APPROVED|PAID|REVERSED|VOIDED|ON_HOLD — promote to reference product]']
  transaction_type varchar [note: 'Classifies the policy event that triggered this commission: New Business (NB), Renewal (REN), Endorsement (ENDT), Cancellation (CANC), Reinstatement, or Adjustment.']
  unearned_commission_amount decimal(18,2) [note: 'The portion of net commission deferred as unearned, corresponding to the Unearned Premium (UEP) reserve for the unexpired policy period.']
  updated_timestamp timestamp [note: 'Date and time when this commission transaction record was last modified, used for incremental data pipeline processing and audit trail.']
  withholding_amount decimal(18,2) [note: 'Amount withheld from the producer\'s commission payment for tax withholding, E&O premium offset, or compliance holds per regulatory or contractual requirements.']

  Note: 'Individual commission earned or adjusted for a producer on a specific policy transaction. FKs to producer, commission_schedule, and commission_statement. Captures GWP basis, rate, earned amount, type (NB, REN, ENDT, CANC), and payment status.'
}

Table producers.commission_statement {
  commission_statement_id varchar [pk, note: 'Unique surrogate identifier for the commission statement record. Primary key for the commission_statement data product in the producers domain.']
  agency_id varchar [note: 'Reference to the agency or brokerage entity associated with this statement. Supports agency-level commission aggregation and reporting.']
  commission_schedule_id varchar [note: 'Reference to the commission schedule or rate table applied to calculate earned commissions on this statement. Governs base and contingent rates.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Commission statements are denominated in specific currencies. Multi-currency statement generation, payment processing, and reconciliation require currency reference.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Commission statements are often produced by line of business for producer performance tracking and profitability analysis. LOB-level statement generation requires LOB reference.']
  producer_agreement_id varchar [note: 'Reference to the executed producer appointment agreement governing the commission terms, rates, and conditions applicable to this statement.']
  producers_producer_id varchar [note: 'Reference to the licensed producer (agent or broker) to whom this commission statement is issued. Links to the producer master record.']
  adjustment_amt decimal(18,2) [note: 'Net miscellaneous adjustments applied to the statement, including corrections from prior periods, manual overrides, or regulatory-mandated recalculations.']
  bonus_commission_amt decimal(18,2) [note: 'Discretionary or incentive bonus commission awarded to the producer for meeting new business, retention, or quality targets during the period.']
  cancellation_count varchar [note: 'Number of policy cancellations (CANC) attributed to this producer during the settlement period. Drives chargeback calculations and retention performance metrics.']
  chargeback_amt decimal(18,2) [note: 'Commission previously paid that is reclaimed due to policy cancellations, mid-term endorsements, or return premium events during the settlement period.']
  contingent_commission_amt decimal(18,2) [note: 'Profit-sharing or contingent commission earned based on loss ratio, volume, or growth performance thresholds agreed in the producer contract.']
  cost_center_code varchar [note: 'Financial cost center to which the commission expense is allocated for management accounting and expense ratio (ER) reporting purposes.']
  created_timestamp timestamp [note: 'Timestamp when this commission statement record was first created in the system. Audit trail field for data lineage and SOX compliance.']
  dac_eligible_amt decimal(18,2) [note: 'Portion of commission on this statement that qualifies as Deferred Acquisition Cost (DAC) under US GAAP ASC 944 or IFRS 17 for capitalization and amortization.']
  dispute_reason varchar [note: 'Free-text description of the reason provided by the producer or internal reviewer for disputing this commission statement. Populated when is_disputed is true.']
  dispute_resolution_date date [note: 'Date on which a disputed commission statement was formally resolved and approved for payment. Null if no dispute was raised or dispute is still open.']
  earned_commission_amt decimal(18,2) [note: 'Total commission earned by the producer during the settlement period before adjustments, chargebacks, or contingent additions. Core gross commission figure.']
  gl_account_code varchar [note: 'General Ledger (GL) account code to which the commission expense on this statement is posted in the financial ledger. Supports statutory and GAAP financial reporting.']
  gross_written_premium_amt decimal(18,2) [note: 'Total Gross Written Premium (GWP) on policies attributed to this producer during the settlement period. Basis for commission calculation.']
  is_disputed boolean [note: 'Indicates whether the producer has formally disputed any line items or the total amount on this commission statement. Triggers dispute resolution workflow.']
  loss_ratio decimal(7,4) [note: 'Loss Ratio (LR) for the producer\'s book of business during the settlement period. Used to determine eligibility for contingent commission and profit-sharing.']
  net_payable_amt decimal(18,2) [note: 'Final net amount payable to the producer after summing earned, contingent, and bonus commissions and subtracting chargebacks and adjustments.']
  new_business_policy_count varchar [note: 'Count of newly bound policies (NB) attributed to this producer during the settlement period. Supports new business incentive and bonus commission calculations.']
  notes varchar [note: 'Free-text notes or remarks added by commission administrators regarding special circumstances, manual overrides, or producer communications related to this statement.']
  payment_date date [note: 'Date on which the commission payment was or is scheduled to be remitted to the producer. Used for cash flow and accounts payable reporting.']
  payment_method varchar [note: 'Method used to remit the net commission payable to the producer (ACH direct deposit, paper check, wire transfer, or offset against amounts owed).']
  payment_reference varchar [note: 'Reference number of the payment transaction (ACH, check, wire) issued to settle this commission statement. Links to the accounts payable payment record.']
  policy_count varchar [note: 'Number of in-force or transacted policies attributed to this producer during the settlement period. Used for volume-based commission tier evaluation.']
  prior_period_balance_amt decimal(18,2) [note: 'Outstanding balance carried forward from the previous settlement period, including unpaid amounts or disputed items not yet resolved.']
  producer_type varchar [note: 'Classification of the producer receiving this statement. Determines applicable commission schedules, regulatory disclosures, and tax reporting requirements.']
  regulatory_disclosure_required boolean [note: 'Indicates whether this commission statement requires regulatory disclosure to the insured or state Department of Insurance per applicable market conduct rules.']
  renewal_policy_count varchar [note: 'Count of renewed policies (REN) attributed to this producer during the settlement period. Supports retention-based commission and No Claims Bonus (NCB) calculations.']
  settlement_frequency varchar [note: 'Frequency at which commission statements are generated and settled for this producer. Drives the statement cycle and payment schedule.']
  settlement_period_end_date date [note: 'Last calendar date of the commission settlement period covered by this statement. Defines the inclusive end of the earning window.']
  settlement_period_start_date date [note: 'First calendar date of the commission settlement period covered by this statement. Defines the inclusive start of the earning window.']
  source_system_code varchar [note: 'Code identifying the operational system of record that originated this commission statement (e.g., Duck Creek Billing, Guidewire BillingCenter, Sapiens IDIT).']
  statement_date date [note: 'The business date on which the commission statement was formally generated and issued to the producer. Represents the principal real-world event date.']
  statement_number varchar [note: 'Externally visible, human-readable identifier for the commission statement used in producer communications, remittance advice, and reconciliation.']
  statement_status varchar [note: 'Current lifecycle state of the commission statement, from initial draft through issuance, dispute resolution, approval, payment, and voiding.']
  statement_type varchar [note: 'Classification of the statement indicating whether it is a standard periodic statement, a supplemental issuance, a correction of a prior statement, or a final settlement.']
  tax_form_type varchar [note: 'IRS tax form type applicable to the commission payments on this statement (e.g., 1099-NEC for independent agents, W-2 for captive agents, none if below threshold).']
  tax_withheld_amt decimal(18,2) [note: 'Amount of income tax or backup withholding deducted from the commission payment per IRS or applicable state tax authority requirements.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this commission statement record. Supports audit trail, change detection, and incremental data pipeline processing.']

  Note: 'Periodic statement issued to a producer or agency summarizing commission transactions within a settlement period. FKs to producer. Tracks statement date, total earned, adjustments, net payable, and payment reference.'
}

Table producers.contingent_bonus {
  contingent_bonus_id varchar [pk, note: 'Unique surrogate identifier for a contingent or profit-sharing bonus record for a producer or agency.']
  agency_id varchar [note: 'Reference to the agency entity associated with this contingent bonus, supporting agency-level aggregation.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Contingent bonuses are denominated in specific currencies. Multi-currency bonus calculation, payment processing, and financial reporting require currency reference.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Contingent bonuses are calculated based on line of business performance metrics (loss ratio, growth, volume). LOB-specific bonus calculation requires LOB reference.']
  producers_producer_id varchar [note: 'Reference to the producer or agency for whom this contingent bonus is calculated.']
  actual_lr decimal(7,4) [note: 'Actual Loss Ratio (LR) achieved by the producer during the measurement period, calculated as incurred losses divided by earned premium.']
  adjustment_amount decimal(18,2) [note: 'Any positive or negative adjustment applied to the earned bonus amount for disputes, corrections, or contractual modifications prior to final payment.']
  approval_date date [note: 'Date on which the contingent bonus was approved by the authorized underwriting or finance authority for payment.']
  approved_by varchar [note: 'Name or employee identifier of the underwriting or finance authority who approved this contingent bonus for payment.']
  bonus_number varchar [note: 'Externally-known alphanumeric identifier for this contingent bonus record, used in producer statements and settlement documents.']
  bonus_rate decimal(7,4) [note: 'Percentage rate applied to the eligible premium base to calculate the contingent bonus earned amount, expressed as a decimal (e.g., 0.05 = 5%).']
  bonus_status varchar [note: 'Current lifecycle state of the contingent bonus record: calculated, approved, disputed, paid, voided, or pending review.']
  bonus_type varchar [note: 'Classification of the bonus arrangement: profit sharing, contingent commission, growth, retention, volume, or performance. [ENUM-REF-CANDIDATE: promote to reference product if values expand]']
  calculation_date date [note: 'Date on which the contingent bonus amount was formally calculated based on the measurement period results.']
  contract_reference varchar [note: 'Reference number or identifier of the producer agency agreement or contingent commission contract governing this bonus arrangement.']
  cost_center_code varchar [note: 'Finance cost center code to which the contingent bonus expense is allocated for management reporting and statutory expense reporting.']
  created_timestamp timestamp [note: 'Timestamp when this contingent bonus record was first created in the system, used for audit trail and data lineage.']
  dispute_reason varchar [note: 'Free-text description of the reason for a dispute raised against this contingent bonus calculation. Populated only when bonus_status is \'disputed\'.']
  earned_amount decimal(18,2) [note: 'Gross contingent bonus amount earned by the producer based on the bonus rate applied to the eligible premium base after meeting all thresholds.']
  ep_amount decimal(18,2) [note: 'Earned Premium (EP) for the producer\'s book during the measurement period, used as the denominator in loss ratio calculations.']
  gl_account_code varchar [note: 'General Ledger (GL) account code in Oracle Financials or SAP FI to which the contingent bonus expense is posted.']
  growth_qualified boolean [note: 'Indicates whether the producer met the minimum GWP growth rate target during the measurement period to qualify for the growth component.']
  growth_target_rate decimal(7,4) [note: 'Minimum GWP growth rate the producer must achieve to qualify for the growth component of the contingent bonus, expressed as a decimal.']
  gwp_amount decimal(18,2) [note: 'Total Gross Written Premium (GWP) produced by the producer during the measurement period, used as the premium volume base for bonus calculation.']
  gwp_growth_rate decimal(7,4) [note: 'Year-over-year GWP growth rate achieved by the producer during the measurement period, expressed as a decimal (e.g., 0.10 = 10%).']
  incurred_losses_amount decimal(18,2) [note: 'Total incurred losses including paid losses and case reserves for the producer\'s book during the measurement period.']
  lae_amount decimal(18,2) [note: 'Total Loss Adjustment Expense (LAE) including ALAE and ULAE attributable to the producer\'s book during the measurement period.']
  lr_qualified boolean [note: 'Indicates whether the producer met the LR threshold requirement during the measurement period. True if actual LR is at or below lr_threshold.']
  lr_threshold decimal(7,4) [note: 'Maximum allowable Loss Ratio (LR) that the producer must achieve to qualify for the contingent bonus. Bonus is forfeited if actual LR exceeds this threshold.']
  measurement_period_end_date date [note: 'End date of the performance measurement period over which loss ratio, premium volume, and growth are evaluated for this bonus.']
  measurement_period_start_date date [note: 'Start date of the performance measurement period over which loss ratio, premium volume, and growth are evaluated for this bonus.']
  net_payable_amount decimal(18,2) [note: 'Final net contingent bonus amount payable to the producer after applying all adjustments. Equals earned_amount plus adjustment_amount.']
  notes varchar [note: 'Free-text field for additional commentary, underwriter remarks, or audit notes related to this contingent bonus record.']
  nwp_amount decimal(18,2) [note: 'Net Written Premium (NWP) after reinsurance cessions for the producer during the measurement period, used in net-basis bonus calculations.']
  overall_qualified boolean [note: 'Indicates whether the producer met ALL qualification criteria (LR, volume, growth) and is eligible to receive the contingent bonus payment.']
  payment_date date [note: 'Date on which the contingent bonus was disbursed to the producer or agency. Null if not yet paid.']
  payment_method varchar [note: 'Method by which the contingent bonus is disbursed to the producer: ACH, check, wire transfer, or credit memo applied to future commissions.']
  prior_year_gwp_amount decimal(18,2) [note: 'Producer\'s GWP in the prior measurement period, used as the baseline for year-over-year growth rate calculation.']
  program_year varchar [note: 'Calendar or fiscal year of the contingent bonus program under which this record is calculated (e.g., 2024).']
  tax_form_type varchar [note: 'IRS tax form type applicable to this contingent bonus payment (e.g., 1099-NEC for independent producers, W-2 for captive agents).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this contingent bonus record, used for audit trail and incremental data processing.']
  volume_qualified boolean [note: 'Indicates whether the producer met the minimum premium volume target during the measurement period to qualify for the volume component.']
  volume_target_amount decimal(18,2) [note: 'Minimum GWP or NWP volume the producer must write during the measurement period to qualify for the volume component of the contingent bonus.']
  withholding_tax_amount decimal(18,2) [note: 'Federal or state withholding tax amount deducted from the contingent bonus payment where applicable per IRS or state tax regulations.']

  Note: 'Contingent or profit-sharing bonus calculated for a producer or agency based on loss ratio, premium volume, and growth targets over a measurement period. Tracks earned amount, LR threshold, and payment status.'
}

Table producers.producer_agreement {
  producer_agreement_id varchar [pk, note: 'Unique surrogate identifier for the producer agreement record in the Pc_Insurance data platform.']
  agency_id varchar [note: 'Reference to the agency or brokerage entity that is the contracting party when the agreement is at the agency level rather than the individual producer level.']
  commission_schedule_id varchar [note: 'Reference to the commission plan that governs base and contingent commission rates, profit-sharing tiers, and override structures applicable to this agreement.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Producer agreements define which lines of business the producer is authorized to write. Authority validation and commission calculation require LOB reference.']
  prior_agreement_producer_agreement_id varchar [note: 'Reference to the predecessor producer agreement that this version supersedes, enabling version chain traversal for audit and compliance.']
  producers_producer_id varchar [note: 'Reference to the licensed producer or agency that is party to this agreement.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Producer agreements specify governing law state and primary territory. Contract management, dispute resolution, and regulatory compliance require state reference.']
  agreement_number varchar [note: 'Externally visible, human-readable identifier assigned to this producer agreement, used on correspondence, bordereaux, and commission statements.']
  agreement_status varchar [note: 'Current lifecycle state of the producer agreement: draft, active, suspended, terminated, expired, or pending renewal.']
  agreement_type varchar [note: 'Classification of the contractual relationship: agency (appointed agent), broker, Managing General Agent (MGA), MGA with delegated authority, surplus lines broker, or direct writer.']
  appointment_state_codes varchar [note: 'Pipe-delimited list of US state codes where the producer holds a valid insurance license and appointment with Pc_Insurance, e.g., CA|TX|NY.']
  audit_rights_flag boolean [note: 'Indicates whether Pc_Insurance retains the contractual right to audit the producer\'s books, records, and premium trust accounts under this agreement.']
  auto_renewal_flag boolean [note: 'Indicates whether this producer agreement automatically renews for successive terms upon expiration unless either party provides written notice of non-renewal.']
  base_commission_rate decimal(7,4) [note: 'Standard commission rate expressed as a decimal fraction of Written Premium (WP) payable to the producer for new business and renewals under this agreement.']
  binding_authority_flag boolean [note: 'Indicates whether the producer has delegated binding authority to commit coverage on behalf of Pc_Insurance without prior underwriting approval.']
  binding_authority_limit decimal(18,2) [note: 'Maximum single-risk Total Insured Value (TIV) or premium amount in USD that the producer may bind without referral to Pc_Insurance underwriting.']
  compliance_training_required_flag boolean [note: 'Indicates whether the producer must complete Pc_Insurance-mandated compliance and product training as a condition of maintaining active agreement status.']
  contingent_commission_flag boolean [note: 'Indicates whether the producer is eligible for contingent or profit-sharing commission based on loss ratio or volume performance thresholds defined in the commission plan.']
  created_timestamp timestamp [note: 'Timestamp when this producer agreement record was first created in the Pc_Insurance data platform, used for audit trail and data lineage.']
  e_and_o_coverage_limit decimal(18,2) [note: 'Minimum required Errors and Omissions (E&O) professional liability coverage limit in USD that the producer must maintain as a condition of this agreement.']
  e_and_o_expiration_date date [note: 'Expiration date of the producer\'s current Errors and Omissions (E&O) insurance policy on file with Pc_Insurance for compliance monitoring.']
  e_and_o_required_flag boolean [note: 'Indicates whether the producer is contractually required to maintain Errors and Omissions (E&O) professional liability insurance as a condition of this agreement.']
  effective_date date [note: 'Date on which the producer agreement becomes legally binding and the producer is authorized to transact business on behalf of Pc_Insurance.']
  exclusivity_flag boolean [note: 'Indicates whether the producer is contractually restricted from placing competing lines of business with other insurers for the LOBs covered by this agreement.']
  execution_date date [note: 'Date on which both parties signed and executed the producer agreement. May differ from effective_date if the agreement is backdated or post-dated.']
  expiration_date date [note: 'Date on which the producer agreement expires or is scheduled to terminate. Null for evergreen agreements with no fixed end date.']
  insurer_signatory_name varchar [note: 'Full name of the Pc_Insurance officer or authorized representative who executed this agreement on behalf of the company.']
  last_compliance_review_date date [note: 'Date of the most recent compliance review or market conduct audit conducted on this producer agreement by Pc_Insurance or a state regulator.']
  lob_scope varchar [note: 'Pipe-delimited list of Lines of Business (LOBs) the producer is authorized to write under this agreement, e.g., personal_auto|homeowners|commercial_gl|bop|wc.']
  loss_ratio_threshold decimal(7,4) [note: 'Maximum permissible Loss Ratio (LR) expressed as a decimal fraction above which contingent commission is forfeited or binding authority may be suspended.']
  ncb_eligible_flag boolean [note: 'Indicates whether the producer\'s book of business qualifies for No Claims Bonus (NCB) incentive adjustments under the commission plan.']
  notice_period_days varchar [note: 'Number of calendar days advance written notice required by either party to terminate this agreement, as specified in the contract terms.']
  override_commission_rate decimal(7,4) [note: 'Additional override or bonus commission rate payable on top of the base rate, typically granted to Managing General Agents (MGAs) or high-volume producers.']
  premium_trust_required_flag boolean [note: 'Indicates whether the producer is required to maintain a separate premium trust account for policyholder funds collected on behalf of Pc_Insurance.']
  premium_volume_minimum decimal(18,2) [note: 'Minimum annual Written Premium (WP) volume in USD the producer commits to place with Pc_Insurance to maintain agreement terms and avoid renegotiation.']
  premium_volume_target decimal(18,2) [note: 'Annual Written Premium (WP) production target in USD agreed between Pc_Insurance and the producer for performance tracking and contingent commission qualification.']
  producer_signatory_name varchar [note: 'Full legal name of the individual who executed this agreement on behalf of the producer or agency.']
  renewal_term_months varchar [note: 'Duration in months of each automatic renewal term when auto_renewal_flag is true. Typically 12 months for annual agreements.']
  sub_producer_allowed_flag boolean [note: 'Indicates whether the producer is permitted to appoint sub-producers or sub-agents under this agreement to solicit business on their behalf.']
  surplus_lines_flag boolean [note: 'Indicates whether the producer is authorized to place surplus lines (non-admitted) business under this agreement, subject to state surplus lines regulations.']
  termination_date date [note: 'Actual date on which the producer agreement was terminated, cancelled, or non-renewed. Distinct from expiration_date which is the scheduled end date.']
  termination_reason varchar [note: 'Reason code for agreement termination when agreement_status is terminated or expired. [ENUM-REF-CANDIDATE: voluntary|non_renewal|regulatory_action|performance|fraud|mutual_consent|other — promote to reference product]']
  territory_scope varchar [note: 'Pipe-delimited list of US state codes or territories where the producer is authorized to solicit and bind business under this agreement, e.g., CA|TX|NY|FL.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this producer agreement record, used for change tracking, audit trail, and incremental data loading.']
  version_number varchar [note: 'Sequential version counter incremented each time the agreement terms are amended and a new version is executed. Version 1 is the original agreement.']

  Note: 'Contractual producer agreement between Pc_Insurance and a producer or agency defining compensation terms, binding authority, LOB scope, territory, and compliance obligations. Tracks version, effective dates, and signatory.'
}

Table producers.binding_authority {
  binding_authority_id varchar [pk, note: 'Unique surrogate identifier for a delegated binding authority record granted to a producer or Managing General Agent (MGA).']
  coverage_form_id varchar [note: 'Foreign key linking to coverage.coverage_form. Business justification: Binding authority grants specify which coverage forms producers can bind. Essential for underwriting controls, compliance validation, and preventing unauthorized coverage binding.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Binding authority limits are denominated in specific currencies. Multi-currency authority validation and risk management require currency reference. Removes denormalized currency_code.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Binding authorities are granted for specific lines of business. Authority validation and underwriting control require LOB reference.']
  producer_agreement_id varchar [note: 'Foreign key linking to producers.producer_agreement. Business justification: Binding authority is granted under a producer agreement. Currently tracked via string reference (agreement_ref).']
  producers_producer_id varchar [note: 'Reference to the licensed producer, agent, broker, or MGA to whom this binding authority is delegated.']
  admitted_carrier_flag boolean [note: 'Indicates whether the insurer backing this binding authority is an admitted (licensed) carrier in the applicable state jurisdictions.']
  aggregate_annual_limit decimal(18,2) [note: 'Maximum total gross written premium (GWP) or total insured value the producer may bind under this authority within a single policy year.']
  approval_date date [note: 'Date on which the binding authority was formally approved by the insurer\'s underwriting authority committee.']
  approved_by varchar [note: 'Name or employee ID of the underwriting officer or delegated authority committee member who approved this binding authority.']
  audit_frequency varchar [note: 'Frequency at which the insurer conducts underwriting audits of policies bound under this authority to verify compliance with guidelines.']
  authority_name varchar [note: 'Descriptive name or title of the binding authority arrangement, e.g., \'Commercial Property MGA Facility 2024\'.']
  authority_number varchar [note: 'Externally-known unique reference number assigned to this binding authority agreement, used on bordereaux and regulatory filings.']
  authority_status varchar [note: 'Current lifecycle state of the binding authority. Drives eligibility to bind new policies. [ENUM-REF-CANDIDATE: active|suspended|expired|terminated|pending_approval|under_review — promote to reference product]']
  authority_type varchar [note: 'Classification of the delegated authority arrangement. [ENUM-REF-CANDIDATE: MGA|Coverholder|Wholesale_Broker|Surplus_Lines|Program_Administrator|Lloyd_Coverholder — promote to reference product]']
  cat_exposed_flag boolean [note: 'Indicates whether risks bound under this authority may include catastrophe (CAT) exposed properties such as coastal wind or earthquake zones.']
  commission_rate_pct decimal(7,4) [note: 'Standard commission rate (as a percentage of gross written premium) payable to the producer for policies bound under this authority.']
  created_timestamp timestamp [note: 'Timestamp when this binding authority record was first created in the system of record, used for audit trail and data lineage.']
  effective_date date [note: 'Date on which the binding authority becomes operative and the producer may begin binding risks on behalf of the insurer.']
  eligible_coverage_classes varchar [note: 'Comma-delimited list of coverage class or program codes (e.g., personal_auto, commercial_property, inland_marine) permitted under this authority.']
  eligible_lob_codes varchar [note: 'Comma-delimited list of NAIC or ISO line-of-business codes (e.g., GL, CPP, BOP, WC, APD) that the producer is authorized to bind under this authority.']
  eligible_risk_classes varchar [note: 'Comma-delimited list of risk class or NAICS/SIC codes the producer may bind. Restricts authority to specific occupancy or industry segments.']
  excluded_risk_classes varchar [note: 'Comma-delimited list of NAICS/SIC or ISO risk class codes explicitly prohibited from being bound under this authority.']
  excluded_zip_codes varchar [note: 'Comma-delimited list of US ZIP codes or postal code prefixes explicitly excluded from the binding authority territory, e.g., CAT-prone coastal zones.']
  expiration_date date [note: 'Date on which the binding authority ceases to be valid. Null indicates an open-ended authority subject to termination notice.']
  is_suspended boolean [note: 'Indicates whether the binding authority is currently suspended. True prevents new policy binding; used for real-time eligibility checks.']
  last_audit_date date [note: 'Date of the most recent underwriting compliance audit conducted against this binding authority.']
  loss_ratio_threshold_pct decimal(7,4) [note: 'Maximum permissible loss ratio (LR) on business bound under this authority before suspension or commission clawback is triggered.']
  max_cat_tiv decimal(18,2) [note: 'Maximum aggregate total insured value (TIV) for CAT-exposed risks the producer may bind under this authority in a single policy year.']
  max_deductible_amount decimal(18,2) [note: 'Maximum deductible or SIR permitted on any single policy bound under this authority, in the authority currency.']
  max_policy_limit decimal(18,2) [note: 'The ceiling on the total insured value (TIV) or per-occurrence policy limit that the producer is authorized to bind on a single policy, in USD.']
  max_single_risk_limit decimal(18,2) [note: 'Maximum sum insured (SI) the producer may bind for any single risk location or insured object, in USD. Distinct from aggregate policy limit.']
  min_deductible_amount decimal(18,2) [note: 'Minimum deductible or self-insured retention (SIR) that must be applied to any policy bound under this authority, in the authority currency.']
  naic_company_code varchar [note: 'Five-digit NAIC company code of the insurer (carrier) on whose behalf the producer is authorized to bind policies under this authority.']
  next_audit_date date [note: 'Scheduled date for the next underwriting compliance audit of policies bound under this authority.']
  notice_period_days varchar [note: 'Number of calendar days advance notice required by either party to cancel or non-renew this binding authority agreement.']
  profit_commission_rate_pct decimal(7,4) [note: 'Contingent profit commission rate payable to the producer if the loss ratio (LR) on bound business falls below the agreed threshold.']
  program_code varchar [note: 'Internal program or facility code linking this binding authority to a specific underwriting program, rate filing, or product configuration in PolicyCenter.']
  rate_filing_reference varchar [note: 'State DOI rate and form filing reference number applicable to the products bound under this authority, ensuring regulatory compliance.']
  reinsurance_required_flag boolean [note: 'Indicates whether facultative (FAC) or treaty reinsurance (RI) placement is mandatory before the producer may bind risks under this authority.']
  renewal_type varchar [note: 'Indicates whether this binding authority renews automatically (auto), requires manual review (manual), or will not be renewed (non_renew) at expiration.']
  surplus_lines_flag boolean [note: 'Indicates whether this binding authority covers surplus lines (non-admitted) business, triggering surplus lines tax and stamping office filing requirements.']
  suspension_date date [note: 'Date on which the binding authority was suspended, preventing new policy binding until reinstatement. Null if never suspended.']
  suspension_reason varchar [note: 'Free-text explanation of why the binding authority was suspended, e.g., regulatory action, loss ratio breach, or compliance failure.']
  territory_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the primary country jurisdiction of this binding authority, e.g., USA, CAN, GBR.']
  territory_states varchar [note: 'Comma-delimited list of US state abbreviations (e.g., CA,TX,FL) defining the geographic territory within which the producer may bind risks.']
  underwriting_guidelines_version varchar [note: 'Version identifier of the underwriting guidelines document that governs risk selection and pricing for policies bound under this authority.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this binding authority record, supporting audit trail and change management requirements.']

  Note: 'Delegated binding authority granted to a producer or MGA specifying maximum policy limit, eligible LOBs, geographic territory, and risk class restrictions. Tracks authority ceiling, expiration, and suspension flags.'
}

Table producers.onboarding_case {
  onboarding_case_id varchar [pk, note: 'Unique surrogate identifier for the producer onboarding and compliance case record in the silver layer.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Onboarding case references commission schedule via string code. Adding proper FK enables referential integrity and eliminates need to JOIN on business key.']
  producers_producer_id varchar [note: 'Reference to the producer party record associated with this onboarding case.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Onboarding cases track producer resident state for licensing and appointment processing. State-specific onboarding workflows and regulatory compliance require state reference.']
  application_received_date date [note: 'Date the producer onboarding application was formally received and logged, marking the start of the onboarding case lifecycle.']
  appointment_effective_date date [note: 'Date the producer appointment becomes legally effective in each appointment state, enabling the producer to bind business on behalf of Pc_Insurance.']
  appointment_filing_date date [note: 'Date the producer appointment was formally filed with the applicable state Departments of Insurance following successful completion of all onboarding checks.']
  appointment_state_codes varchar [note: 'Pipe-delimited list of two-letter state codes where the producer is being appointed or has active appointments with Pc_Insurance, per DOI filing requirements.']
  assigned_uw_reviewer varchar [note: 'Name or employee identifier of the underwriting or compliance officer assigned to review and adjudicate the producer onboarding case.']
  background_check_date date [note: 'Date the background check screening was completed and results were received from the third-party screening provider during producer onboarding.']
  background_check_provider varchar [note: 'Name of the third-party vendor engaged to conduct the producer background screening, used for audit trail and vendor management tracking.']
  background_check_status varchar [note: 'Current status of the criminal background check conducted on the producer applicant as part of the onboarding compliance screening process.']
  binding_authority_granted boolean [note: 'Indicates whether the producer has been granted binding authority to commit Pc_Insurance to coverage without prior underwriting approval, per the producer agreement.']
  binding_authority_limit decimal(18,2) [note: 'Maximum single-risk premium or total insured value the producer is authorized to bind without prior UW approval, expressed in USD per the producer agreement.']
  case_closed_timestamp timestamp [note: 'Timestamp when the onboarding case was formally closed, either through approval and system activation, rejection, or withdrawal.']
  case_number varchar [note: 'Externally visible business identifier for the onboarding case, used in correspondence and regulatory filings with state Departments of Insurance.']
  case_opened_timestamp timestamp [note: 'Precise timestamp when the onboarding case record was created in the producer management system, serving as the audit creation marker.']
  case_status varchar [note: 'Current workflow state of the producer onboarding case lifecycle from application intake through appointment activation or rejection.']
  channel_type varchar [note: 'Distribution channel classification for the producer, distinguishing independent agents, captive agents, brokers, and MGAs for commission structure and contract assignment.']
  contingent_commission_eligible boolean [note: 'Indicates whether the producer qualifies for contingent or profit-sharing commission arrangements based on loss ratio and volume performance thresholds.']
  contracting_entity varchar [note: 'Legal name of the Pc_Insurance entity or subsidiary with which the producer agreement is being executed, relevant for multi-company carrier groups.']
  doi_disciplinary_review_date date [note: 'Date the DOI disciplinary history and market-conduct review was completed for the producer applicant during the onboarding compliance process.']
  doi_disciplinary_review_status varchar [note: 'Status of the review of DOI disciplinary actions, market-conduct orders, and license revocations against the producer across all appointment states.']
  e_o_coverage_verified boolean [note: 'Indicates whether the producer\'s Errors and Omissions (E&O) professional liability insurance coverage has been verified as meeting Pc_Insurance minimum requirements.']
  e_o_policy_expiry_date date [note: 'Expiration date of the producer\'s E&O professional liability policy, used to trigger renewal verification and prevent appointment lapses.']
  estimated_annual_premium_volume decimal(18,2) [note: 'Producer\'s estimated annual gross written premium (GWP) volume to be placed with Pc_Insurance, used for capacity planning and commission tier assignment.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the onboarding case record, used for change tracking and audit trail compliance.']
  license_verification_date date [note: 'Date on which the most recent producer license verification was completed against NIPR or state DOI records during the onboarding process.']
  license_verification_status varchar [note: 'Current status of the producer license verification check performed via NIPR or state DOI systems to confirm active, valid licensure in all appointment states.']
  lob_authorizations varchar [note: 'Pipe-delimited list of P&C lines of business the producer is authorized to sell, such as personal auto, homeowners, CGL, WC, BOP, and CPP.']
  naic_producer_code varchar [note: 'NAIC-assigned unique producer code used for interstate licensing, appointment filings, and statutory reporting across all state Departments of Insurance.']
  npn varchar [note: 'Unique National Producer Number assigned by NIPR/NAIC, used as the primary cross-state identifier for producer licensing and appointment verification.']
  ofac_screening_date date [note: 'Date the OFAC and sanctions screening was last performed on the producer applicant, required for BSA/AML compliance documentation.']
  ofac_screening_status varchar [note: 'Result of the OFAC Specially Designated Nationals (SDN) and sanctions list screening performed on the producer applicant as required by BSA/AML compliance.']
  prior_carrier_loss_ratio decimal(5,4) [note: 'Historical loss ratio (LR) reported by the producer from prior carrier relationships, used by UW to assess book quality during onboarding risk evaluation.']
  producer_agreement_type varchar [note: 'Type of producer agreement governing the relationship, determining commission schedules, binding authority, and regulatory obligations.']
  producer_dba_name varchar [note: 'Trade or DBA name under which the producer operates, if different from the legal name. Required for agency and broker appointment filings.']
  producer_legal_name varchar [note: 'Full legal name of the producer entity or individual as submitted on the onboarding application, used for DOI appointment filings and NAIC records.']
  producer_tax_number varchar [note: 'Federal Employer Identification Number (FEIN) for agencies or Social Security Number (SSN) for individual producers, required for IRS 1099 commission reporting.']
  producer_type varchar [note: 'Classification of the producer entity type, distinguishing individual agents from agencies, brokers, MGAs, and surplus lines brokers for licensing and commission purposes.']
  regulatory_compliance_notes varchar [note: 'Free-text field capturing compliance officer observations, state DOI correspondence notes, or market-conduct findings relevant to the onboarding case review.']
  rejection_reason_code varchar [note: 'Standardized code indicating the primary reason an onboarding case was rejected, used for regulatory reporting and adverse action notification compliance.']
  rejection_reason_notes varchar [note: 'Free-text narrative providing additional detail on the reason for onboarding case rejection, supplementing the rejection reason code for underwriting and compliance review.']
  system_activation_date date [note: 'Date the producer was activated in Pc_Insurance operational systems (PolicyCenter, BillingCenter) enabling quoting, binding, and commission processing.']
  years_in_business varchar [note: 'Number of years the producer entity or individual has been actively operating in the P&C insurance distribution market, used in UW risk scoring.']

  Note: 'Single authoritative producer onboarding and compliance case covering application intake, background check, license verification, DOI disciplinary and market-conduct review, and OFAC/sanctions screening through appointment filing and system activation.'
}

Table producers.termination {
  termination_id varchar [pk, note: 'Unique surrogate identifier for a producer appointment or agreement termination record in the Producer Management and Licensing System.']
  appointment_id varchar [note: 'Reference to the producer appointment record being terminated. Links this termination to the originating appointment in the producer management system.']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Terminations may be line-of-business specific when appointments are LOB-specific. Regulatory reporting and producer authority tracking require LOB reference. Removes denormalized lob_code.']
  producer_agreement_id varchar [note: 'Reference to the producer agency or broker agreement being terminated, if the termination applies to a contractual agreement rather than a state appointment.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Terminations are state-specific regulatory events requiring DOI notification. Regulatory reporting and compliance tracking require state reference. Removes denormalized state_of_appointment.']
  termination_producers_producer_id varchar [note: 'Reference to the producer (agent or broker) whose appointment or agreement is being terminated.']
  termination_successor_producer_producers_producer_id varchar [note: 'Reference to the producer appointed to service the terminated producer\'s book of business following the termination.']
  approval_date date [note: 'Date on which the termination action was formally approved internally, prior to issuance of notice to the producer and regulatory filing.']
  approved_by_user_code varchar [note: 'Internal user or employee ID of the person who approved the termination action, supporting dual-control and SOX audit requirements.']
  book_of_business_transfer_date date [note: 'Date on which the terminated producer\'s book of business was fully transferred to the successor producer or insurer servicing team.']
  book_of_business_transfer_status varchar [note: 'Status of the transfer of the terminated producer\'s book of business (policies) to another appointed producer or to the insurer\'s direct servicing team.']
  commission_currency_code varchar [note: 'ISO 4217 three-letter currency code for the pending commission amount (e.g., USD). Supports multi-currency operations for international entities.']
  commission_settlement_status varchar [note: 'Status of the final commission settlement process following termination, tracking whether outstanding commissions have been paid, disputed, or written off.']
  contest_outcome varchar [note: 'Result of the producer\'s formal contest or appeal of the termination decision.']
  contest_resolution_date date [note: 'Date on which a contested termination was resolved, either upholding the termination or reinstating the appointment. Null if not contested or unresolved.']
  created_timestamp timestamp [note: 'Timestamp when this termination record was first created in the data platform, used for audit trail and data lineage tracking.']
  e_and_o_coverage_expiry_date date [note: 'Date on which the producer\'s Errors and Omissions (E&O) professional liability coverage expires post-termination, relevant for tail coverage obligations.']
  effective_date date [note: 'The date on which the producer appointment or agreement termination becomes legally effective, as agreed or mandated by the applicable state DOI.']
  initiated_by_party varchar [note: 'Identifies which party initiated the termination: the insurer, the producer, a regulatory authority, or by mutual agreement.']
  initiated_by_user_code varchar [note: 'Internal user or employee ID of the person who initiated the termination action in the producer management system, for audit trail purposes.']
  internal_notes varchar [note: 'Confidential internal notes recorded by underwriting or compliance staff regarding the circumstances of the termination, not shared externally.']
  is_contested boolean [note: 'Indicates whether the producer has formally contested or appealed the termination, triggering a dispute resolution or regulatory review process.']
  is_for_cause boolean [note: 'Indicates whether the termination is for cause (e.g., fraud, misrepresentation, license violation), triggering mandatory state regulatory reporting obligations.']
  is_regulatory_reportable boolean [note: 'Indicates whether this termination must be reported to the state Department of Insurance (DOI) or NAIC within the mandated reporting window.']
  naic_company_code varchar [note: 'Five-digit NAIC company code identifying the insurer entity filing the termination, required for state DOI regulatory submissions.']
  notice_date date [note: 'Date on which formal written notice of termination was issued to the producer, used to calculate required notice periods per state regulation.']
  notice_period_days varchar [note: 'Number of calendar days of advance notice required by state regulation or contract before the termination becomes effective.']
  number varchar [note: 'Externally visible business identifier for this termination action, used in regulatory filings, correspondence, and bordereaux submissions.']
  pending_commission_amount decimal(18,2) [note: 'Total commission amount owed to the producer at the time of termination that remains unpaid, subject to final settlement per the agency agreement terms.']
  reason_code varchar [note: 'Standardized NAIC or state DOI reason code for the termination, used in regulatory filings and state notification submissions (e.g., NAIC reason codes for appointment terminations).']
  reason_description varchar [note: 'Free-text narrative explaining the business reason for the termination, supplementing the standardized reason code for internal documentation and audit purposes.']
  regulatory_report_due_date date [note: 'Deadline by which the termination must be reported to the applicable state DOI or NAIC, typically 30 days from the effective date per state statute.']
  regulatory_report_status varchar [note: 'Current status of the regulatory termination notification filing with the state DOI or NAIC, tracking compliance with mandatory reporting requirements.']
  regulatory_report_submitted_date date [note: 'Actual date on which the termination notification was submitted to the state DOI or NAIC, used to confirm timely compliance with reporting obligations.']
  reinstatement_eligible boolean [note: 'Indicates whether the terminated producer is eligible for future reinstatement of their appointment, based on the termination reason and regulatory standing.']
  reinstatement_eligible_date date [note: 'Earliest date on which the terminated producer may apply for reinstatement of their appointment, if applicable under state regulation or contract terms.']
  rescission_date date [note: 'Date on which a previously issued termination was rescinded or reversed, restoring the producer appointment. Null if the termination was not rescinded.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this termination record originated (e.g., AgentSync, Vertafore Sircon, Guidewire PolicyCenter).']
  source_system_record_code varchar [note: 'Native record identifier from the originating operational system (AgentSync, Vertafore Sircon, etc.) for lineage tracing and reconciliation.']
  state_notification_required boolean [note: 'Indicates whether the terminating state requires a formal notification filing with the DOI, distinct from the broader regulatory reportable flag.']
  termination_status varchar [note: 'Current workflow state of the termination action, tracking progress from initiation through regulatory confirmation or rescission.']
  termination_type varchar [note: 'Classifies the nature of the termination. [ENUM-REF-CANDIDATE: voluntary|involuntary|non_renewal|mutual_agreement|regulatory_action|death_disability — promote to reference product]']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this termination record in the data platform, supporting change tracking and audit compliance.']

  Note: 'Records the termination or non-renewal of a producer appointment or agreement, including termination reason code, for-cause flag, effective date, state notification requirement, and regulatory reporting status.'
}

Table producers.producer_compliance {
  producer_compliance_id varchar [pk, note: 'Unique surrogate identifier for the producer compliance onboarding and monitoring case record within the Pc_Insurance producer management system.']
  compliance_reviewer_producers_producer_id varchar [note: 'Identifier of the internal compliance officer or analyst assigned to review and adjudicate this producer compliance case. Links to the employee or user master record.']
  producers_producer_id varchar [note: 'Reference to the producer (agent or broker) whose compliance case this record tracks. Links to the producer master record in the producer management system.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Compliance cases are state-specific for licensing verification and regulatory action tracking. State DOI compliance monitoring requires state reference. Removes denormalized license_state.']
  activation_date date [note: 'Date on which the producer was formally activated and authorized to bind business on behalf of Pc_Insurance following successful completion of all compliance checks.']
  aml_training_date date [note: 'Date on which the producer completed the most recent AML training course. Used to determine whether re-training is required based on the applicable refresh cycle.']
  anti_money_laundering_trained boolean [note: 'Indicates whether the producer has completed mandatory AML training as required by FinCEN and NAIC guidelines. Required for appointment in certain lines of business.']
  appointed_lob_codes varchar [note: 'Comma-separated list of NAIC line of business codes for which the producer is authorized to sell under this compliance case (e.g., 04=Fire, 05=Allied Lines, 17=CGL).']
  appointment_eligibility_status varchar [note: 'Overall eligibility determination for producer appointment based on the aggregate outcome of all compliance checks. Drives the final activation decision in the producer management system.']
  background_check_date date [note: 'Date on which the background check was completed and results were received from the screening vendor. Null if the check has not yet been completed.']
  background_check_reference varchar [note: 'Vendor-assigned reference or order number for the background check transaction. Used to retrieve detailed results from the screening vendor portal.']
  background_check_status varchar [note: 'Current status of the criminal background check conducted on the producer as part of the onboarding compliance process. Adverse findings require underwriting review.']
  background_check_vendor varchar [note: 'Name of the third-party screening vendor that performed the background check (e.g., Sterling, First Advantage). Used for vendor management and audit trail.']
  case_close_date date [note: 'Calendar date on which the compliance case reached final disposition (approved, rejected, or closed). Null if the case is still open.']
  case_number varchar [note: 'Externally visible, human-readable identifier assigned to this compliance onboarding case. Used in correspondence with the producer and state DOI filings.']
  case_open_date date [note: 'Calendar date on which the compliance case was formally opened and submitted for review. Serves as the start anchor for SLA and regulatory turnaround tracking.']
  case_status varchar [note: 'Current lifecycle state of the compliance case from initial submission through final disposition. Drives workflow routing in the producer management system.']
  case_type varchar [note: 'Categorizes the nature of the compliance case: initial producer appointment, license renewal, reinstatement after lapse, disciplinary review, or periodic audit.']
  ce_credit_hours_verified decimal(5,2) [note: 'Number of continuing education credit hours confirmed as completed by the producer for the current license period. Compared against state-mandated minimums.']
  compliance_notes varchar [note: 'Free-text field for compliance officer annotations, escalation notes, or exception documentation related to this producer compliance case. Restricted to authorized compliance staff.']
  continuing_education_compliant boolean [note: 'Indicates whether the producer has met all state-mandated continuing education (CE) credit hour requirements for the current license period as verified through NIPR or state DOI.']
  created_timestamp timestamp [note: 'System timestamp when this compliance case record was first created in the data platform. Used for audit trail and data lineage purposes.']
  doi_disciplinary_detail varchar [note: 'Summary description of DOI disciplinary orders or regulatory actions against the producer, including state, order type, and effective date. Populated when doi_disciplinary_flag is true.']
  doi_disciplinary_flag boolean [note: 'Indicates whether the producer has any active or historical disciplinary orders on record with any state Department of Insurance. True triggers mandatory compliance review.']
  doi_disciplinary_order_date date [note: 'Date of the most recent DOI disciplinary order or regulatory action recorded against the producer. Used to assess recency and severity of compliance risk.']
  e_o_coverage_verified boolean [note: 'Indicates whether the producer\'s Errors and Omissions (E&O) professional liability insurance coverage has been verified as active and meeting minimum limits required by Pc_Insurance.']
  e_o_expiration_date date [note: 'Expiration date of the producer\'s E&O professional liability insurance policy. Triggers renewal alert workflow when within 60 days of expiry.']
  e_o_policy_number varchar [note: 'Policy number of the producer\'s active E&O professional liability insurance policy. Required for appointment and verified during onboarding compliance review.']
  ineligibility_reason varchar [note: 'Free-text explanation of why the producer was determined ineligible for appointment. Populated when appointment_eligibility_status is ineligible or conditional.']
  license_expiration_date date [note: 'Expiration date of the producer license as recorded in NIPR or the state DOI system. Used to trigger renewal reminders and compliance alerts.']
  license_verification_date date [note: 'Date on which the most recent license verification check was completed against NIPR or state DOI records for this compliance case.']
  license_verification_status varchar [note: 'Current status of the license verification check performed against NIPR or state DOI records. A verified status is required before producer activation.']
  market_conduct_finding_detail varchar [note: 'Narrative description of market conduct examination findings associated with the producer, including the examining state and finding category. Populated when flag is true.']
  market_conduct_finding_flag boolean [note: 'Indicates whether the producer has been cited in a state market conduct examination finding. True requires review by the compliance officer before appointment approval.']
  next_review_date date [note: 'Scheduled date for the next periodic compliance review of this producer, based on risk tier, license renewal cycle, or regulatory requirement. Drives automated review scheduling.']
  nipr_transaction_number varchar [note: 'Transaction identifier returned by NIPR when the appointment or license verification request was submitted. Used to reconcile NIPR responses with internal compliance records.']
  ofac_match_detail varchar [note: 'Descriptive detail of any OFAC match found during screening, including the matched list name and match score. Populated only when ofac_screening_status is match_found or escalated.']
  ofac_screening_date date [note: 'Date on which the most recent OFAC sanctions screening was performed for this producer. Periodic re-screening is required per AML compliance policy.']
  ofac_screening_status varchar [note: 'Result of the OFAC (Office of Foreign Assets Control) sanctions screening check. A clear status is required before the producer can be activated and bound to policies.']
  producer_license_number varchar [note: 'State-issued insurance producer license number being verified as part of this compliance case. Sourced from NIPR or state DOI licensing database.']
  review_completed_date date [note: 'Date on which the assigned compliance reviewer completed their assessment of all checks and rendered an appointment eligibility determination for this case.']
  state_appointment_filed boolean [note: 'Indicates whether the formal producer appointment has been filed with the applicable state DOI through NIPR. Required in states that mandate company-filed appointments.']
  state_appointment_filed_date date [note: 'Date on which the producer appointment was filed with the state DOI via NIPR. Populated only when state_appointment_filed is true.']
  updated_timestamp timestamp [note: 'System timestamp of the most recent modification to this compliance case record. Supports incremental data pipeline processing and audit trail requirements.']

  Note: 'Compliance and onboarding case for a producer tracking background check, license verification, DOI disciplinary orders, market conduct findings, and OFAC/sanctions screening status through activation.'
}

Table producers.territory {
  territory_id varchar [pk, note: 'Unique identifier for the territory data product (auto-inserted during validation).']
  agency_id varchar [note: 'Reference to the agency or brokerage organization associated with this territory assignment.']
  commission_schedule_id varchar [note: 'Foreign key linking to producers.commission_schedule. Business justification: Territory assignments reference commission schedules via string code. Adding proper FK enables referential integrity and eliminates need to JOIN on business key.']
  producers_producer_id varchar [note: 'Reference to the producer (agent or broker) to whom this geographic territory is assigned.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Territories are defined by state boundaries for producer assignment and commission allocation. Territory management and producer performance reporting require state reference.']
  appointment_date date [note: 'Date the producer was formally appointed by Pc_Insurance to write business in this territory, as filed with the state Department of Insurance (DOI).']
  cat_zone_code varchar [note: 'Designated Catastrophe (CAT) zone code (e.g., hurricane tier, earthquake zone, wildfire risk zone) assigned to this territory for PML and reinsurance purposes.']
  channel_code varchar [note: 'Distribution channel through which business is written in this territory: independent agent, captive agent, broker, direct, or Managing General Agent (MGA).']
  conflict_priority varchar [note: 'Integer priority rank used to resolve overlapping territory assignments for the same geography and LOB. Lower value indicates higher precedence.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) county code scoping the territory to a specific county within the state.']
  created_timestamp timestamp [note: 'Timestamp when this territory assignment record was first created in the system, used for audit trail and data lineage in the Databricks Silver Layer.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code applicable to monetary limits (e.g., max_tiv, premium targets) for this territory. Typically USD for domestic P&C.']
  division_code varchar [note: 'Internal division code (e.g., personal lines, commercial lines, specialty) used for production roll-up and P&L reporting in Oracle Financials GL.']
  effective_date date [note: 'Date on which the territory assignment becomes binding and the producer is authorized to solicit and bind business within the defined geographic scope.']
  expiration_date date [note: 'Date on which the territory assignment ends. Null indicates an open-ended assignment with no scheduled termination.']
  geographic_scope varchar [note: 'Granularity level of the geographic boundary definition: statewide, county, ZIP-code range, Metropolitan Statistical Area (MSA), or custom polygon.']
  is_cat_exposed boolean [note: 'Flags whether the territory falls within a designated Catastrophe (CAT) zone (e.g., hurricane, earthquake, wildfire), triggering underwriting restrictions.']
  is_exclusive boolean [note: 'Indicates whether the producer holds exclusive rights to solicit and bind business within this territory, preventing appointment of competing producers.']
  iso_territory_code varchar [note: 'Insurance Services Office (ISO) / Verisk territory code used for rate filings, loss cost multipliers, and actuarial territory relativities.']
  lob_code varchar [note: 'NAIC or internal Line of Business (LOB) code scoping the territory to specific insurance products (e.g., HO, AUTO, CGL, WC, BOP). [ENUM-REF-CANDIDATE: promote to reference product]']
  lob_description varchar [note: 'Human-readable description of the Line of Business (LOB) scope for this territory (e.g., \'Personal Auto\', \'Commercial General Liability\').']
  market_segment varchar [note: 'Broad market segment classification for the territory: personal lines, commercial lines, specialty, or excess and surplus (E&S) lines.']
  max_tiv decimal(18,2) [note: 'Maximum aggregate Total Insured Value (TIV) the producer is authorized to bind within this territory, enforcing capacity and concentration limits.']
  msa_code varchar [note: 'US Census Bureau Metropolitan Statistical Area (MSA) code when the territory is scoped to an MSA rather than individual counties or ZIP codes.']
  naic_territory_code varchar [note: 'National Association of Insurance Commissioners (NAIC) territory code used in statutory reporting and state rate filings.']
  new_business_allowed boolean [note: 'Indicates whether the producer is permitted to write New Business (NB) in this territory. May be restricted during CAT moratoriums or UW suspensions.']
  notes varchar [note: 'Free-text field for underwriting or territory management notes, such as special conditions, moratorium details, or conflict resolution decisions.']
  rating_territory_code varchar [note: 'Internal rating territory code used by the policy rating engine (Guidewire PolicyCenter / Duck Creek Rating) to apply territory-specific rate factors.']
  region_code varchar [note: 'Internal regional grouping code (e.g., NE, SE, MW, SW, W) used for production roll-up reporting and regional management oversight.']
  renewal_allowed boolean [note: 'Indicates whether policy renewals (REN) are permitted within this territory. May differ from new business authority during non-renewal orders.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this territory record originated (e.g., AgentSync, Vertafore Sircon, Guidewire PolicyCenter).']
  source_system_record_code varchar [note: 'Native primary key or record identifier from the originating source system, enabling traceability and reconciliation back to AgentSync, Sircon, or PolicyCenter.']
  termination_date date [note: 'Date the territory assignment was formally terminated. Null if the assignment is still active or has not yet been terminated.']
  termination_reason varchar [note: 'Reason code for the termination of the territory assignment, required for state DOI termination filings and producer management audit trails.']
  territory_code varchar [note: 'Externally-known alphanumeric code uniquely identifying the territory, used in bordereaux, commission statements, and regulatory filings.']
  territory_name varchar [note: 'Human-readable name of the territory (e.g., \'Northeast Commercial\', \'Gulf Coast Personal Lines\') used in producer portals and management reports.']
  territory_status varchar [note: 'Current lifecycle state of the territory assignment. Controls whether the producer may bind new business within the defined geographic scope.']
  territory_type varchar [note: 'Classification of the territory assignment indicating exclusivity and access rights granted to the producer. Drives conflict resolution and appointment rules.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this territory assignment record, supporting change tracking and incremental load processing in the Silver Layer.']
  uw_restriction_code varchar [note: 'Current underwriting (UW) restriction level applied to this territory. Drives policy binding authority and referral requirements in PolicyCenter.']
  written_premium_target decimal(18,2) [note: 'Annual Written Premium (WP) production target assigned to the producer for this territory, used in performance tracking and commission tier calculations.']
  zip_code_end varchar [note: 'Ending ZIP code of the contiguous ZIP-code range defining the geographic boundary of this territory assignment.']
  zip_code_start varchar [note: 'Starting ZIP code of the contiguous ZIP-code range defining the geographic boundary of this territory assignment.']

  Note: 'Geographic territory assigned to a producer or agency by state, county, and ZIP-code range with LOB scope. Supports territory management, conflict resolution, and production roll-up.'
}

Table producers.authority_territory {
  authority_territory_id varchar [pk, note: 'Unique surrogate identifier for this binding authority territory record']
  binding_authority_id varchar [note: 'Foreign key linking to the binding authority record granted to the producer or MGA']
  state_id varchar [note: 'Foreign key linking to the state or territory where this binding authority is operative']
  aggregate_limit_per_state decimal(18,2) [note: 'Maximum total gross written premium or total insured value the producer may bind annually within this state']
  compliance_status varchar [note: 'Current regulatory compliance status of the binding authority within this state jurisdiction']
  effective_date date [note: 'Date on which the binding authority becomes operative in this specific state jurisdiction']
  expiration_date date [note: 'Date on which the binding authority ceases to be valid in this specific state jurisdiction']
  max_policy_limit_per_state decimal(18,2) [note: 'State-specific ceiling on the total insured value or per-occurrence policy limit the producer may bind']
  premium_tax_rate_override decimal(5,4) [note: 'State-specific premium tax rate override applicable to policies bound under this authority in this state']
  state_approval_date date [note: 'Date on which the state Department of Insurance approved this binding authority for operation in the state']
  state_filing_reference varchar [note: 'Regulatory filing reference number or approval code issued by the state DOI for this binding authority']
  surplus_lines_eligible boolean [note: 'Indicates whether this binding authority permits surplus lines placements within this specific state']

  Note: 'Represents the delegated binding authority granted to a producer within a specific state jurisdiction. Captures state-specific limits, effective dates, and regulatory compliance requirements for each producer-state combination..'
}

Table shared.currency {
  currency_id varchar [pk, note: 'Unique identifier for the currency record. Primary key.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the primary country or region where this currency is the official tender.']
  country_name varchar [note: 'Full name of the primary country or region where this currency is the official tender.']
  created_timestamp timestamp [note: 'Timestamp when this currency record was first created in the system.']
  currency_name varchar [note: 'Full official name of the currency (e.g., United States Dollar, Euro, British Pound Sterling).']
  display_format varchar [note: 'Standard display format pattern for monetary amounts in this currency (e.g., $#,##0.00 for USD, €#.##0,00 for EUR).']
  effective_date date [note: 'Date when this currency became officially recognized and available for use in the system.']
  expiration_date date [note: 'Date when this currency was or will be retired or replaced (null for active currencies with no planned retirement).']
  is_active boolean [note: 'Indicates whether the currency is currently active and available for use in transactions.']
  is_crypto boolean [note: 'Indicates whether this is a cryptocurrency or digital asset rather than a fiat currency.']
  iso_code varchar [note: 'Three-letter alphabetic ISO 4217 currency code (e.g., USD, EUR, GBP, CAD, JPY).']
  minor_unit varchar [note: 'Number of decimal places for the minor unit (e.g., 2 for cents in USD, 0 for JPY which has no minor unit).']
  notes varchar [note: 'Additional notes or comments about the currency, including special handling instructions or historical context.']
  numeric_code varchar [note: 'Three-digit numeric ISO 4217 currency code (e.g., 840 for USD, 978 for EUR).']
  rounding_method varchar [note: 'Standard rounding method applied to monetary calculations in this currency.']
  sort_order varchar [note: 'Numeric sort order for displaying currencies in user interfaces and reports (lower numbers appear first).']
  symbol varchar [note: 'Standard symbol or glyph representing the currency (e.g., $, €, £, ¥).']
  updated_timestamp timestamp [note: 'Timestamp when this currency record was last modified in the system.']

  Note: 'Reference catalog of ISO 4217 currency codes used across premium, claims, reserve, and reinsurance monetary amounts. Stores code, name, minor unit, and active flag.'
}

Table shared.state {
  state_id varchar [pk, note: 'Unique identifier for the state or territory record.']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: States belong to countries - clear 1:N relationship. Adding FK to normalize the state-to-country relationship.']
  active_indicator boolean [note: 'Indicates whether the state record is currently active and available for policy issuance and regulatory operations.']
  catastrophe_exposure_zone varchar [note: 'Primary catastrophe exposure classification for the state used in underwriting and reinsurance placement. [ENUM-REF-CANDIDATE: Hurricane|Earthquake|Tornado|Flood|Wildfire|Multi-Peril|Low — 7 candidates stripped; promote to reference product]']
  coastal_state_indicator boolean [note: 'Indicates whether the state has coastal exposure requiring special wind and flood underwriting considerations.']
  created_timestamp timestamp [note: 'Timestamp when the state record was first created in the system.']
  doi_contact_email varchar [note: 'Primary contact email address for the state Department of Insurance.']
  doi_contact_phone varchar [note: 'Primary contact phone number for the state Department of Insurance.']
  doi_mailing_address varchar [note: 'Full mailing address for the state Department of Insurance used for regulatory correspondence and filings.']
  doi_name varchar [note: 'Official name of the state Department of Insurance or equivalent regulatory authority.']
  doi_website_url varchar [note: 'Official website URL for the state Department of Insurance for regulatory reference and filing access.']
  effective_date date [note: 'Date when the state record became effective in the system for operational use.']
  expiration_date date [note: 'Date when the state record expires or is no longer valid for operational use, null if indefinite.']
  filing_system_type varchar [note: 'Type of regulatory filing system used by the state for rate and form submissions.']
  fips_code varchar [note: 'Two-digit FIPS code assigned by the US Census Bureau for state identification.']
  form_filing_requirement varchar [note: 'Regulatory requirement type for insurance form filings in the state.']
  guaranty_fund_participation boolean [note: 'Indicates whether the state requires participation in the state guaranty fund for insurer insolvency protection.']
  iso_program_participation boolean [note: 'Indicates whether the state uses ISO rating programs and forms for property and casualty lines.']
  licensing_authority varchar [note: 'Name of the state authority responsible for producer and adjuster licensing and appointments.']
  naic_code varchar [note: 'NAIC-assigned code for state identification used in statutory reporting and regulatory filings.']
  ncci_participation boolean [note: 'Indicates whether the state participates in NCCI for workers compensation rating and statistical reporting.']
  nipr_participation boolean [note: 'Indicates whether the state participates in NIPR for streamlined producer licensing and appointment processing.']
  premium_tax_rate decimal(5,4) [note: 'State premium tax rate applied to gross written premium for admitted carriers, expressed as a decimal.']
  rate_filing_requirement varchar [note: 'Regulatory requirement type for insurance rate filings in the state.']
  region varchar [note: 'Geographic region classification for the state or territory used for market segmentation and analysis. [ENUM-REF-CANDIDATE: Northeast|Southeast|Midwest|Southwest|West|Pacific|Territories — 7 candidates stripped; promote to reference product]']
  residual_market_mechanism varchar [note: 'Name of the state residual market mechanism or assigned risk pool for high-risk placements.']
  stamping_office_name varchar [note: 'Name of the authorized stamping office for surplus lines policy processing in the state.']
  stamping_office_required boolean [note: 'Indicates whether the state requires surplus lines policies to be stamped by a licensed stamping office.']
  state_code varchar [note: 'Two-letter postal abbreviation for the state or territory as defined by USPS.']
  state_name varchar [note: 'Full legal name of the state or territory.']
  statutory_reporting_deadline varchar [note: 'Annual statutory financial statement filing deadline for the state, typically March 1 or state-specific date.']
  surplus_lines_eligible boolean [note: 'Indicates whether the state permits surplus lines insurance placements for non-admitted carriers.']
  surplus_lines_tax_rate decimal(5,4) [note: 'State surplus lines tax rate applied to non-admitted insurance placements, expressed as a decimal.']
  updated_timestamp timestamp [note: 'Timestamp when the state record was last modified in the system.']

  Note: 'Reference catalog of US states and territories used for filings, licensing, garaging, and jurisdiction. Stores FIPS code, postal abbreviation, DOI reference, and region.'
}

Table shared.country {
  country_id varchar [pk, note: 'Unique identifier for the country record. Primary key.']
  currency_id varchar [note: 'Foreign key linking to shared.currency. Business justification: Country references its official/primary currency. The existing country.currency_code (STRING) should be replaced with a proper FK to currency.currency_id (BIGINT surrogate key).']
  active_flag boolean [note: 'Indicates whether the country is currently active for underwriting, claims processing, and reinsurance operations. Inactive countries are retained for historical policy and claims data.']
  address_format_standard varchar [note: 'Standard address format convention for the country. Used for policy declarations, claims correspondence, and regulatory filings to ensure proper mail delivery.']
  cat_exposure_zone varchar [note: 'Catastrophe risk exposure classification for the country. Used for CAT XL (Catastrophe Excess of Loss) treaty structuring, PML calculations, and underwriting guidelines.']
  continent_code varchar [note: 'Two-letter continent code where the country is located. Used for high-level geographic risk aggregation and PML (Probable Maximum Loss) analysis. [ENUM-REF-CANDIDATE: AF|AN|AS|EU|NA|OC|SA — 7 candidates stripped; promote to reference product]']
  country_name varchar [note: 'Official short name of the country in English as recognized by ISO 3166. Used for display in policy documents, claims correspondence, and regulatory filings.']
  created_timestamp timestamp [note: 'Timestamp when this country record was first created in the data warehouse. Used for audit trail and data lineage tracking.']
  data_privacy_regime varchar [note: 'Primary data privacy and protection regulatory framework applicable in the country. Governs PII handling, consent requirements, and breach notification for policyholders and claimants.']
  effective_date date [note: 'Date when this country record became effective in the system. Used for temporal queries and historical reporting of country attributes.']
  expiration_date date [note: 'Date when this country record expires or was superseded. Null for currently active records. Used for slowly changing dimension management.']
  full_name varchar [note: 'Complete official name of the country including formal designations. Used for legal documents, treaties, and statutory reporting.']
  iso_alpha_2_code varchar [note: 'Two-letter country code as defined by ISO 3166-1 alpha-2 standard. Used for addresses, reinsurer domicile, and party identification.']
  iso_alpha_3_code varchar [note: 'Three-letter country code as defined by ISO 3166-1 alpha-3 standard. Used for regulatory reporting and reinsurance bordereaux.']
  iso_numeric_code varchar [note: 'Three-digit numeric country code as defined by ISO 3166-1 numeric standard. Used for systems requiring numeric identifiers.']
  last_modified_timestamp timestamp [note: 'Timestamp when this country record was last updated. Used for change tracking, audit compliance, and data quality monitoring.']
  naic_country_code varchar [note: 'Country code used in NAIC statutory reporting and annual statement filings. Required for Schedule P, Schedule F, and reinsurance disclosures.']
  phone_country_code varchar [note: 'International telephone dialing code prefix for the country. Used for FNOL (First Notice of Loss) contact validation and producer communication.']
  postal_code_format varchar [note: 'Regular expression pattern defining valid postal code formats for the country. Used for address validation in policy issuance, claims processing, and producer onboarding.']
  region_code varchar [note: 'UN geographic region classification code. Used for regional risk aggregation, catastrophe modeling, and reinsurance treaty structuring.']
  regulatory_jurisdiction_type varchar [note: 'Classification of the country for insurance regulatory purposes. Determines surplus lines tax treatment, alien insurer requirements, and DOI (Department of Insurance) reporting obligations.']
  reinsurance_domicile_flag boolean [note: 'Indicates whether the country is a recognized domicile for reinsurers. Used for credit for reinsurance determinations and collateral requirements under NAIC guidelines.']
  sanctions_status varchar [note: 'Current economic sanctions status applicable to the country. Impacts underwriting eligibility, reinsurance placement restrictions, and claims payment compliance under OFAC regulations.']
  sovereignty_status varchar [note: 'Classification of the country\'s political sovereignty status. Impacts regulatory jurisdiction, treaty applicability, and reinsurance placement authority.']
  subregion_code varchar [note: 'UN geographic subregion classification code. Used for granular risk segmentation and regulatory compliance reporting.']

  Note: 'Reference catalog of ISO 3166 country codes used for addresses, reinsurers, and party identification. Stores alpha-2, alpha-3, numeric code, and name.'
}

Table shared.org_unit {
  org_unit_id varchar [pk, note: 'Unique identifier for the organizational unit. Primary key.']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Org unit is domiciled in a country (regulatory jurisdiction, legal entity location). The existing org_unit.country_code (STRING) should be replaced with a proper FK to country.country_id']
  lob_code_id varchar [note: 'Foreign key linking to shared.lob_code. Business justification: Org unit is often specialized by line of business (e.g., a branch that only writes Workers Comp, or a business unit focused on Commercial General Liability).']
  parent_org_unit_id varchar [note: 'Identifier of the parent organizational unit in the hierarchy, enabling multi-level organizational structures.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Org unit located in a US state (for US-based units). The existing org_unit.state_province (STRING) should be replaced with a proper FK to state.state_id (BIGINT surrogate key).']
  address_line1 varchar [note: 'Primary street address line for the organizational unit physical location.']
  address_line2 varchar [note: 'Secondary address line for suite, floor, or building information of the organizational unit location.']
  budget_amount decimal(18,2) [note: 'Annual operating budget allocated to this organizational unit in the base currency.']
  city varchar [note: 'City name where the organizational unit is physically located.']
  cost_center_code varchar [note: 'General ledger cost center code used for financial accounting and expense allocation for this organizational unit.']
  created_timestamp timestamp [note: 'Date and time when this organizational unit record was first created in the system.']
  effective_date date [note: 'Date when this organizational unit became active and operational within the enterprise structure.']
  expiration_date date [note: 'Date when this organizational unit ceased operations or was closed. Null for currently active units.']
  fein varchar [note: 'Federal tax identification number assigned to this organizational unit for IRS reporting and tax purposes.']
  headcount varchar [note: 'Number of full-time equivalent employees assigned to this organizational unit.']
  hierarchy_level varchar [note: 'Numeric level in the organizational hierarchy where 1 is the top level and higher numbers represent deeper nesting.']
  is_licensed boolean [note: 'Indicates whether this organizational unit holds active insurance licenses to transact business in its jurisdiction.']
  manager_email varchar [note: 'Primary email address of the organizational unit manager for business communications.']
  manager_name varchar [note: 'Full name of the individual responsible for managing this organizational unit.']
  modified_timestamp timestamp [note: 'Date and time when this organizational unit record was last updated in the system.']
  naic_company_code varchar [note: 'Five-digit NAIC company code associated with this organizational unit for statutory reporting purposes.']
  org_unit_description varchar [note: 'Detailed narrative describing the organizational unit purpose, scope of operations, and business responsibilities.']
  phone_number varchar [note: 'Primary contact phone number for the organizational unit office or location.']
  postal_code varchar [note: 'Postal or ZIP code for the organizational unit location.']
  profit_center_code varchar [note: 'General ledger profit center code used for revenue and profitability tracking for this organizational unit.']
  regulatory_jurisdiction varchar [note: 'Primary state or federal regulatory authority governing this organizational unit operations and compliance.']
  time_zone varchar [note: 'IANA time zone identifier for the organizational unit location, used for scheduling and timestamp normalization.']
  unit_code varchar [note: 'Short alphanumeric code uniquely identifying the organizational unit for reporting and system integration purposes.']
  unit_name varchar [note: 'Full business name of the organizational unit as used in internal communications and reporting.']
  unit_status varchar [note: 'Current operational status of the organizational unit in its lifecycle.']
  unit_type varchar [note: 'Classification of the organizational unit indicating its role in the enterprise structure.']

  Note: 'Reference hierarchy of internal organizational units (branch, region, business unit, cost center) used to attribute policies, claims, and financial transactions.'
}

Table shared.lob_code {
  lob_code_id varchar [pk, note: 'Unique identifier for the line of business code record.']
  cat_exposure_flag boolean [note: 'Indicates whether this line of business has significant catastrophe exposure requiring CAT modeling and reinsurance.']
  claims_made_basis_flag boolean [note: 'Indicates whether this line is typically written on a claims-made basis (true) versus occurrence basis (false).']
  commission_rate_pct decimal(5,2) [note: 'Standard commission rate percentage paid to producers for new business in this line.']
  created_timestamp timestamp [note: 'Timestamp when this line of business code record was first created in the system.']
  effective_date date [note: 'Date when this line of business code became effective and available for policy issuance.']
  expiration_date date [note: 'Date when this line of business code expires or was discontinued (null if still active).']
  gaap_accounting_line varchar [note: 'GAAP accounting line classification for financial statement reporting under US GAAP or IFRS 17.']
  is_admitted boolean [note: 'Indicates whether this line of business is written on an admitted basis (true) or surplus lines basis (false).']
  is_monoline boolean [note: 'Indicates whether this line is typically written as a standalone monoline policy (true) or part of a package (false).']
  is_package_eligible boolean [note: 'Indicates whether this line can be included in commercial package policies (CPP, BOP).']
  iso_line_code varchar [note: 'ISO standard line of business code used for rating and statistical reporting.']
  lob_abbreviation varchar [note: 'Short abbreviation for the line of business used in operational systems and reporting.']
  lob_category varchar [note: 'High-level category classifying the line of business (personal, commercial, specialty, reinsurance).']
  lob_code varchar [note: 'Standard code representing the line of business (e.g., GL, CGL, BOP, WC, APD, PIP).']
  lob_code_description varchar [note: 'Detailed description of the line of business including coverage scope, typical insureds, and key characteristics.']
  lob_name varchar [note: 'Full descriptive name of the line of business (e.g., General Liability, Workers Compensation).']
  lob_status varchar [note: 'Current operational status of the line of business in the system.']
  lob_type varchar [note: 'Classification of the line by coverage type (property, casualty, liability, auto, workers compensation, package).']
  long_tail_flag boolean [note: 'Indicates whether this is a long-tail line with extended claim development periods (e.g., GL, WC).']
  loss_development_period_months varchar [note: 'Typical loss development period in months for claims in this line of business.']
  naic_line_code varchar [note: 'Official NAIC statutory reporting line code for regulatory filings and annual statements.']
  regulatory_notes varchar [note: 'Regulatory compliance notes including state-specific requirements, filing obligations, and restrictions.']
  reinsurance_ceded_pct decimal(5,2) [note: 'Typical percentage of premium ceded to reinsurers for this line of business.']
  renewal_commission_rate_pct decimal(5,2) [note: 'Standard commission rate percentage paid to producers for renewal business in this line.']
  requires_state_filing boolean [note: 'Indicates whether rates and forms for this line require state regulatory filing and approval.']
  risk_based_capital_factor decimal(5,4) [note: 'NAIC risk-based capital factor applied to reserves and premiums for this line in RBC calculations.']
  sort_order varchar [note: 'Numeric sort order for displaying lines of business in user interfaces and reports.']
  statutory_accounting_line varchar [note: 'Statutory accounting line classification for annual statement reporting and reserve calculations.']
  target_combined_ratio_pct decimal(5,2) [note: 'Target combined ratio percentage (loss ratio plus expense ratio) for profitability management.']
  target_expense_ratio_pct decimal(5,2) [note: 'Target expense ratio percentage including commissions and operating expenses for this line.']
  target_loss_ratio_pct decimal(5,2) [note: 'Target loss ratio percentage for underwriting and pricing this line of business.']
  underwriting_notes varchar [note: 'Special underwriting considerations, restrictions, or guidelines specific to this line of business.']
  updated_timestamp timestamp [note: 'Timestamp when this line of business code record was last modified.']

  Note: 'Reference catalog of lines of business and NAIC line codes (GL, CGL, BOP, WC, APD, PIP) used consistently across policy, coverage, premium, claims, and reserves.'
}

Table shared.calendar {
  calendar_id varchar [pk, note: 'Unique identifier for the calendar record.']
  accident_year varchar [note: 'The accident year for loss reserving and actuarial analysis, representing the year in which a loss event occurred.']
  accounting_period varchar [note: 'The accounting period identifier in YYYY-MM format, used for general ledger posting and financial close processes.']
  calendar_date date [note: 'The specific date represented in this calendar record.']
  cat_season_indicator varchar [note: 'Indicates the active catastrophe season for this date, used for catastrophe exposure management and reinsurance treaty activation.']
  created_timestamp timestamp [note: 'The timestamp when this calendar record was first created in the system, used for audit trail and data lineage tracking.']
  day_name varchar [note: 'The full name of the day of the week, used for human-readable reporting and operational dashboards. [ENUM-REF-CANDIDATE: Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday — 7 candidates stripped; promote to reference product]']
  day_of_month varchar [note: 'The day number within the calendar month (1-31), used for billing cycle and payment due date calculations.']
  day_of_week varchar [note: 'The day of the week as a numeric value (1=Monday, 7=Sunday), used for operational scheduling and claims intake patterns.']
  day_of_year varchar [note: 'The ordinal day number within the calendar year (1-366), used for daily premium earning and exposure calculations.']
  days_in_month varchar [note: 'The total number of days in the calendar month (28-31), used for pro-rata premium calculations and daily earning factors.']
  days_in_year varchar [note: 'The total number of days in the calendar year (365 or 366 for leap years), used for annual premium earning and exposure calculations.']
  effective_date date [note: 'The date from which this calendar record is effective, used for managing calendar dimension changes and historical accuracy.']
  expiration_date date [note: 'The date on which this calendar record expires or is superseded, used for managing calendar dimension changes and historical accuracy.']
  fiscal_month varchar [note: 'The fiscal month within the fiscal year (1-12), used for monthly accounting close and premium earning calculations.']
  fiscal_period_end_date date [note: 'The end date of the fiscal period to which this calendar date belongs, used for period cutoff and financial close validation.']
  fiscal_period_start_date date [note: 'The start date of the fiscal period to which this calendar date belongs, used for period-to-date calculations and reporting.']
  fiscal_quarter varchar [note: 'The fiscal quarter within the fiscal year (1-4), used for quarterly financial and regulatory reporting.']
  fiscal_week varchar [note: 'The fiscal week number within the fiscal year (1-53), used for operational reporting and performance tracking.']
  fiscal_year varchar [note: 'The fiscal year to which this date belongs, used for financial reporting and statutory compliance.']
  holiday_name varchar [note: 'The name of the holiday if this date is a recognized holiday, used for operational planning and customer communication.']
  is_business_day boolean [note: 'Indicates whether this date is a business day (excluding weekends and holidays), used for payment processing and SLA calculations.']
  is_current boolean [note: 'Indicates whether this calendar record is the current active version, used for filtering to the most recent calendar configuration.']
  is_holiday boolean [note: 'Indicates whether this date is a recognized company or statutory holiday, used for payment processing and service level agreements.']
  is_leap_year boolean [note: 'Indicates whether the calendar year is a leap year (366 days), used for accurate daily premium earning and exposure day calculations.']
  is_month_end boolean [note: 'Indicates whether this date is the last day of the calendar month, used for monthly accounting close and premium earning cutoffs.']
  is_quarter_end boolean [note: 'Indicates whether this date is the last day of the fiscal quarter, used for quarterly financial reporting and regulatory filings.']
  is_weekend boolean [note: 'Indicates whether this date falls on a weekend (Saturday or Sunday), used for operational scheduling and staffing models.']
  is_year_end boolean [note: 'Indicates whether this date is the last day of the fiscal year, used for annual statutory reporting and year-end close processes.']
  month varchar [note: 'The calendar month within the calendar year (1-12), used for policy effective dates and renewal cycles.']
  month_name varchar [note: 'The full name of the calendar month, used for human-readable reporting and executive dashboards. [ENUM-REF-CANDIDATE: January|February|March|April|May|June|July|August|September|October|November|December — 12 candidates stripped; promote to reference']
  policy_year varchar [note: 'The policy year for underwriting analysis, representing the year in which a policy was written or renewed.']
  quarter varchar [note: 'The calendar quarter within the calendar year (1-4), used for market analysis and external benchmarking.']
  report_year varchar [note: 'The report year for claims reporting analysis, representing the year in which a claim was reported to the insurer.']
  statutory_reporting_period varchar [note: 'The statutory reporting period identifier used for NAIC Annual Statement and quarterly filings, formatted as YYYY-QQ or YYYY-MM.']
  updated_timestamp timestamp [note: 'The timestamp when this calendar record was last modified, used for audit trail and change tracking.']
  week varchar [note: 'The calendar week number within the calendar year (1-53), used for operational scheduling and resource planning.']
  year varchar [note: 'The calendar year (Gregorian) to which this date belongs, used for policy term alignment and external reporting.']

  Note: 'Reference calendar of fiscal periods, accident years, and accounting months used for premium earning, reserve evaluation, and statutory reporting cadence.'
}

Table shared.user_account {
  user_account_id varchar [pk, note: 'Primary key for user_account']
  manager_user_account_id varchar [note: 'Reference to the user account of the direct manager or supervisor.']
  org_unit_id varchar [note: 'Foreign key linking to shared.org_unit. Business justification: Users belong to organizational units (branch, region, business unit, cost center). Adding FK to link users to their org unit.']
  account_expiration_date date [note: 'Date when the user account access rights expire and require renewal or deactivation.']
  account_locked_flag boolean [note: 'Indicator whether the user account is locked due to security policy violations or administrative action.']
  account_status varchar [note: 'Current lifecycle status of the user account indicating availability and access rights.']
  account_type varchar [note: 'Classification of the user account based on role and access level within the organization.']
  authentication_method varchar [note: 'Primary authentication mechanism used for user account access.']
  created_by_user_id varchar [note: 'Reference to the user account that created this user account record.']
  created_timestamp timestamp [note: 'Date and time when the user account record was first created in the system.']
  deactivated_by_user_id varchar [note: 'Reference to the user account that deactivated this user account.']
  deactivated_timestamp timestamp [note: 'Date and time when the user account was deactivated or terminated.']
  deactivation_reason varchar [note: 'Explanation or business justification for deactivating the user account.']
  email_address varchar [note: 'Primary email address associated with the user account for communication and authentication.']
  employee_code varchar [note: 'Unique identifier assigned to the user as an employee within the organization.']
  failed_login_attempts varchar [note: 'Count of consecutive unsuccessful login attempts since last successful authentication.']
  first_name varchar [note: 'Given name of the user.']
  full_name varchar [note: 'Complete legal name of the user.']
  job_title varchar [note: 'Official position or role title of the user within the organization.']
  language_preference varchar [note: 'Preferred language code for user interface and communication.']
  last_login_timestamp timestamp [note: 'Date and time of the most recent successful login to the user account.']
  last_modified_by_user_id varchar [note: 'Reference to the user account that most recently modified this user account record.']
  last_modified_timestamp timestamp [note: 'Date and time when the user account record was most recently updated.']
  last_name varchar [note: 'Family name or surname of the user.']
  license_expiration_date date [note: 'Date when the professional insurance license expires and requires renewal.']
  license_number varchar [note: 'Professional insurance license number for agents, brokers, or adjusters.']
  license_state varchar [note: 'State or jurisdiction code where the professional insurance license was issued.']
  multi_factor_enabled_flag boolean [note: 'Indicator whether multi-factor authentication is enabled for enhanced account security.']
  notes varchar [note: 'Additional comments or administrative notes regarding the user account.']
  password_last_changed_date date [note: 'Date when the user account password was last updated or reset.']
  phone_number varchar [note: 'Primary contact phone number for the user.']
  security_clearance_level varchar [note: 'Maximum data classification level the user is authorized to access.']
  time_zone varchar [note: 'Time zone preference for the user account used for scheduling and timestamp display.']
  username varchar [note: 'Unique login identifier for the user account.']

  Note: 'Master reference table for user_account. Referenced by generated_by_user_id.'
}

Table shared.party {
  party_id varchar [pk, note: 'Primary key for party']
  country_id varchar [note: 'Foreign key linking to shared.country. Business justification: Party addresses reference countries. Currently party has \'country_code\' as STRING. Adding country_id FK to normalize country reference and enable joins to country table for ISO codes, full']
  parent_party_id varchar [note: 'Reference to the parent or owning party in a corporate or organizational hierarchy.']
  state_id varchar [note: 'Foreign key linking to shared.state. Business justification: Party addresses reference states. Currently party has \'state_province\' as STRING. Adding state_id FK to normalize state reference and enable joins to state table for NAIC codes, DOI information']
  address_line_1 varchar [note: 'Primary street address line including street number, street name, and unit or suite number.']
  address_line_2 varchar [note: 'Secondary address line for additional location details such as building name, floor, or department.']
  city varchar [note: 'City or municipality name of the party address.']
  commission_rate decimal(5,4) [note: 'Default commission percentage rate paid to the party for policies sold or serviced. Applicable to agents and brokers.']
  created_timestamp timestamp [note: 'Date and time when the party record was first created in the system.']
  credit_score varchar [note: 'Numerical credit rating score used for underwriting and pricing decisions.']
  date_of_birth date [note: 'Birth date of the individual party. Applicable only when party_type is individual.']
  doing_business_as_name varchar [note: 'Trade name or DBA name under which the party conducts business, if different from legal name.']
  email_address varchar [note: 'Primary email address for electronic communication with the party.']
  established_date date [note: 'Date the party was first established or incorporated as a legal entity.']
  fax_number varchar [note: 'Facsimile transmission number for document delivery to the party.']
  first_name varchar [note: 'Given or first name of the individual party. Applicable only when party_type is individual.']
  gender varchar [note: 'Gender identity of the individual party. Applicable only when party_type is individual.']
  industry_code varchar [note: 'Standard industry classification code for the organization party business sector.']
  last_modified_timestamp timestamp [note: 'Date and time when the party record was most recently updated or modified.']
  last_name varchar [note: 'Family or surname of the individual party. Applicable only when party_type is individual.']
  legal_name varchar [note: 'Full legal name of the party as registered with governing authorities or as appears on official identification documents.']
  license_expiration_date date [note: 'Date on which the party professional license expires and requires renewal.']
  license_number varchar [note: 'Professional license or certification number for parties acting as agents, brokers, or adjusters.']
  license_state varchar [note: 'State or jurisdiction that issued the professional license to the party.']
  marital_status varchar [note: 'Current marital status of the individual party, used for underwriting and rating purposes.']
  middle_name varchar [note: 'Middle name or initial of the individual party. Applicable only when party_type is individual.']
  mobile_phone_number varchar [note: 'Mobile or cellular telephone number for the party, used for SMS and mobile communication.']
  national_producer_number varchar [note: 'Unique identifier assigned by the National Association of Insurance Commissioners for licensed insurance producers.']
  occupation varchar [note: 'Primary occupation or profession of the individual party, used for risk assessment and underwriting.']
  party_role varchar [note: 'Primary business role the party plays in insurance operations: insured, claimant, agent, broker, reinsurer, or vendor.']
  party_status varchar [note: 'Current lifecycle status of the party record in the system.']
  party_type varchar [note: 'Classification of the party as individual person, organization, trust, estate, government entity, or other legal entity type.']
  phone_number varchar [note: 'Primary telephone contact number for the party, including country and area codes.']
  postal_code varchar [note: 'Postal or ZIP code for mail delivery to the party address.']
  preferred_contact_method varchar [note: 'Party preferred channel for receiving communications: email, phone, postal mail, SMS, or online portal.']
  preferred_language varchar [note: 'Two-letter ISO language code indicating the party preferred language for communication.']
  relationship_end_date date [note: 'Date the business relationship with this party ended or was terminated.']
  relationship_manager_name varchar [note: 'Name of the internal employee or representative assigned to manage the business relationship with this party.']
  relationship_start_date date [note: 'Date the business relationship with this party began.']
  risk_rating varchar [note: 'Underwriting risk classification assigned to the party based on loss history, credit, and other risk factors.']
  suffix varchar [note: 'Name suffix such as Jr., Sr., III, Esq. Applicable only when party_type is individual.']
  tax_identification_number varchar [note: 'Government-issued tax identifier: Social Security Number for individuals or Employer Identification Number for organizations.']
  website_url varchar [note: 'Primary website address for the organization party.']

  Note: 'Master reference table for party. Referenced by assigned_to_party_id.'
}

