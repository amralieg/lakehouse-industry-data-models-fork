# RDFS Schema for Business: Ncdot

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/ncdot#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Ncdot ---
ind:Ncdot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Ncdot' ;
    rdfs:comment 'The North Carolina Department of Transportation (NCDOT) is a statewide public agency responsible for planning, building, managing, and maintaining North Carolinas multimodal transportation infrastructure.   NCDOT oversees and maintains the highways, rail systems, aviation facilities, ferries, and public transportation networks.  NCDOT provides essential citizen facing services - including driver licensing, vehicle registration, and regulatory oversight through the Division of Motor Vehicles.  NCDOTs mission extends into emergency response, statewide mobility strategy, environmental stewardship, and long range transportation planning.     Typical domains include: highway, rail, ferry, aviation, licensing, hr, itf, doh, dmv, dch' .

# --- Domain Classes ---
ind:Highway rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Highway' ;
    rdfs:comment 'Core highway operations including roadway construction, maintenance, pavement management, and highway performance monitoring. Manages the state highway system infrastructure, roadway assets, and maintenance activities aligned with FHWA HPMS standards. Encompasses DOH functions for state highway system operations and preservation.' .

ind:Dmv rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Dmv' ;
    rdfs:comment 'Division of Motor Vehicles providing citizen-facing services for driver licensing (DL, CDL), vehicle registration, titling, and regulatory oversight. Manages driver records (SADLS), vehicle titling and registration (STARS), motor vehicle records (MVR), and inspection programs (NCVIP).' .

ind:Bridge rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Bridge' ;
    rdfs:comment 'Bridge and structures management including inspection, maintenance, rehabilitation, and structural integrity monitoring. Implements NBIS standards, maintains NBI data, and manages the Bridge Management System (BMS) for state-owned bridges across the network.' .

ind:Traffic rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Traffic' ;
    rdfs:comment 'Traffic management and operations including signal systems, ITS infrastructure, ATMS, TMC operations, incident management (IMAP), and traffic control devices per MUTCD standards. Manages AADT, VMT, LOS metrics and traffic flow analytics.' .

ind:Project rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Project' ;
    rdfs:comment 'Transportation project management including STIP/TIP programming, project delivery, preliminary engineering (PE), construction engineering (CE), and project lifecycle tracking through SAP PS and HiCAMS systems.' .

ind:Ferry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Ferry' ;
    rdfs:comment 'Ferry operations and marine transportation services including vessel management, sailing schedules, route operations, terminal facilities, and maritime maintenance. Operates the second-largest state ferry system in the United States.' .

ind:Transit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Transit' ;
    rdfs:comment 'Public transit coordination, funding administration, and multimodal transportation services. Manages FTA grant programs, transit system support, and coordination with MPO/RPO planning organizations for statewide transit service.' .

ind:Aviation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Aviation' ;
    rdfs:comment 'Aviation regulation, airport facilities management, airport system planning, and safety oversight. Provides regulatory oversight and funding coordination for public airports across North Carolina in alignment with FAA standards.' .

ind:Rail rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Rail' ;
    rdfs:comment 'Rail regulation, safety oversight, rail infrastructure coordination, and railroad crossing safety. Manages FRA compliance, track inspection programs, and coordination for freight and passenger rail operations.' .

ind:Asset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Asset' ;
    rdfs:comment 'Enterprise asset management including equipment inventory, fleet management, facility assets, and lifecycle tracking through SAP PM and ATLAS systems. Manages asset condition, maintenance schedules, and capital asset accounting.' .

ind:Rightofway rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Rightofway' ;
    rdfs:comment 'Right-of-way acquisition, property management, real estate transactions, appraisals, and ROW corridor management. Manages land acquisition processes, easements, and property records through SAP RE module.' .

ind:Environmental rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Environmental' ;
    rdfs:comment 'Environmental compliance and permitting for transportation projects including NEPA documentation (EIS, EA, CE, FONSI), Section 404 Clean Water Act permits, and coordination with SHPO, USACE, NCDEQ for environmental stewardship.' .

ind:Safety rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Safety' ;
    rdfs:comment 'Safety and incident management including emergency response, IMAP operations, crash data analysis, HSIP program administration, and coordination with GHSP for highway safety initiatives and traffic incident management.' .

ind:Planning rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Planning' ;
    rdfs:comment 'Statewide transportation planning including LRTP, CTP development, transportation modeling, mobility strategy, and coordination with MPO/RPO organizations for long-range multimodal transportation planning and programming.' .

ind:Maintenance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Maintenance' ;
    rdfs:comment 'Maintenance operations for state transportation infrastructure including roadway maintenance, MOT activities, pavement preservation, vegetation management, work order management (SAP PM), and winter weather operations.' .

ind:Grant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Grant' ;
    rdfs:comment 'Grants and federal programs administration including FHWA, FTA, BUILD, INFRA, RAISE, and TIFIA funding. Manages federal funding compliance, OMB Uniform Guidance (2 CFR 200), grant reporting, and reimbursement processes.' .

ind:Finance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Finance' ;
    rdfs:comment 'Finance and budget management including financial accounting through SAP FI/CO, NCFS integration, budget planning, cost center management, GASB compliance, and governmental financial reporting for state and federal fiscal years.' .

ind:Procurement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Procurement' ;
    rdfs:comment 'Procurement and contracts management including vendor management, DBE/MBE/WBE/HUB programs, materials management through SAP MM, contract administration, letting processes, RFP/RFQ/IFB solicitations, and QA/QC oversight.' .

ind:Hr rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Hr' ;
    rdfs:comment 'Human resources management including workforce planning, employee records through Beacon and SAP HR, payroll administration, benefits management, training, and organizational development for NCDOT staff across all divisions.' .

ind:Gis rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ncdot ;
    rdfs:label 'Gis' ;
    rdfs:comment 'Geographic Information Systems providing spatial data management, mapping services, location-based analysis, and geospatial infrastructure through ArcGIS Enterprise supporting all NCDOT transportation planning and operations functions.' .

# --- Data Product Classes (Tables) ---
ind:Parcel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rightofway ;
    rdfs:label 'Parcel' ;
    rdfs:comment 'Master record of each land parcel within the agency\'s right-of-way inventory, including legal description, GIS coordinates, current ownership, land use, and status flags.' .

ind:Easement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rightofway ;
    rdfs:label 'Easement' ;
    rdfs:comment 'Details of easement rights granted on parcels, covering easement type, purpose, duration, parties, and associated survey documents.' .

ind:Landowner rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rightofway ;
    rdfs:label 'Landowner' ;
    rdfs:comment 'Master entity for individuals or organizations that own or lease land subject to right-of-way actions, containing contact information, tax identifiers, and relationship to parcels.' .

ind:AcquisitionRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rightofway ;
    rdfs:label 'Acquisition Request' ;
    rdfs:comment 'Transactional record of a request to acquire, lease, or otherwise obtain right-of-way interest, capturing request date, project linkage, required parcels, justification, and approval workflow steps.' .

ind:CompensationPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rightofway ;
    rdfs:label 'Compensation Payment' ;
    rdfs:comment 'Payment transaction issued to landowners for acquired or easement-impacted property, including payment amount, method, disbursement date, and linkage to the underlying acquisition request.' .

ind:AcquisitionStatus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rightofway ;
    rdfs:label 'Acquisition Status' ;
    rdfs:comment 'Reference table of standardized status codes used throughout the right-of-way acquisition lifecycle (e.g., pending, approved, in-survey, closed, cancelled).' .

ind:Driver rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Driver' ;
    rdfs:comment 'Master record for each licensed driver, containing personal identification, demographic data, driver status, and licensing history.' .

ind:License rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'License' ;
    rdfs:comment 'Issued driver license details, including license number, class, issue and expiration dates, endorsements, and restrictions.' .

ind:Vehicle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Vehicle' ;
    rdfs:comment 'Master record for each vehicle registered in North Carolina, storing VIN, make, model, year, body type, and ownership links.' .

ind:Registration rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Registration' ;
    rdfs:comment 'Registration details linking a vehicle to its owner, registration number, plate number, registration status, and renewal dates.' .

ind:Title rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Title' ;
    rdfs:comment 'Legal title information for a vehicle, including title number, lien status, transfer history, and current holder.' .

ind:Violation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Violation' ;
    rdfs:comment 'Transactional record of traffic citations issued to drivers, including violation code, date, location, fine amount, and adjudication status.' .

ind:Fee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Fee' ;
    rdfs:comment 'Reference table of all fee types charged by the DMV (e.g., license issuance, renewal, title transfer), with amount, applicable vehicle class, and regulatory code.' .

ind:Appointment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Appointment' ;
    rdfs:comment 'Transactional record of citizen appointments for DMV services, including service type, location, scheduled time, and status.' .

ind:Office rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Office' ;
    rdfs:comment 'Master record for each DMV office location, containing address, contact information, operating hours, and service capabilities.' .

ind:LicenseType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Reference data defining the categories of driver licenses (e.g., Class A, B, C, CDL), including eligibility criteria and privileges.' .

ind:VehicleClass rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Dmv ;
    rdfs:label 'Vehicle Class' ;
    rdfs:comment 'Reference table of vehicle classification codes used for registration, titling, and fee calculation (e.g., passenger, commercial, motorcycle).' .

ind:Vessel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ferry ;
    rdfs:label 'Vessel' ;
    rdfs:comment 'Master record for each ferry vessel in the fleet, including specifications, capacity, registration, and status.' .

ind:Terminal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ferry ;
    rdfs:label 'Terminal' ;
    rdfs:comment 'Master data for ferry terminals and docks, capturing location, facilities, operating hours, and capacity.' .

ind:SailingSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ferry ;
    rdfs:label 'Sailing Schedule' ;
    rdfs:comment 'Planned sailing instances for a given route, including departure/arrival times, assigned vessel, and available capacity.' .

ind:Passenger rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ferry ;
    rdfs:label 'Passenger' ;
    rdfs:comment 'Core master entity for ferry passengers, storing personal identification, contact information, and eligibility for discounts.' .

ind:Reservation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Ferry ;
    rdfs:label 'Reservation' ;
    rdfs:comment 'Reservation record capturing a passenger\'s intent to board a specific sailing, status, hold expiration, and associated ticket (if any).' .

ind:Project rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Project' ;
    rdfs:comment 'Master record for each transportation project, including identifiers, title, description, sponsor, status, and overall lifecycle information.' .

ind:Phase rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Phase' ;
    rdfs:comment 'Reference list of standard project phases (e.g., Planning, Preliminary Engineering, Design, Construction, Closeout) used to categorize project activities.' .

ind:Schedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Schedule' ;
    rdfs:comment 'Transactional schedule entries for a project, capturing work package, start/end dates, duration, and critical path information.' .

ind:ChangeOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Change Order' ;
    rdfs:comment 'Transactional record of scope, schedule, or cost changes to a project, including justification, impact analysis, and approval status.' .

ind:Milestone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Milestone' ;
    rdfs:comment 'Reference list of milestone types (e.g., Permit Received, Groundbreaking, Substantial Completion) used to track key project events.' .

ind:Resource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Resource' ;
    rdfs:comment 'Transactional records assigning labor, equipment, and material resources to specific work packages within a project, with start/end dates and utilization rates.' .

ind:Issue rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Issue' ;
    rdfs:comment 'Transactional log of project issues, including description, severity, owner, resolution steps, and closure date.' .

ind:Risk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Risk' ;
    rdfs:comment 'Transactional record of identified project risks, probability, impact, mitigation actions, and status.' .

ind:Document rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Project ;
    rdfs:label 'Document' ;
    rdfs:comment 'Reference metadata for project-related documents (drawings, permits, reports), including document type, version, author, and storage location.' .

ind:Route rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transit ;
    rdfs:label 'Route' ;
    rdfs:comment 'Master record for each transit route, including route identifier, short and long names, type (bus, rail, ferry), and operational attributes. Also consolidates: ferry.route, transit.route.' .

ind:Stop rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transit ;
    rdfs:label 'Stop' ;
    rdfs:comment 'Master record for every transit stop or station, with location coordinates, stop name, accessibility features, and parent agency.' .

ind:TransitSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transit ;
    rdfs:label 'Transit Schedule' ;
    rdfs:comment 'Definition of scheduled service times for a route, including headway, service days, and calendar exceptions.' .

ind:Trip rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transit ;
    rdfs:label 'Trip' ;
    rdfs:comment 'Instance of a vehicle operating on a specific route at a scheduled time, linking route, schedule, and assigned vehicle.' .

ind:Fare rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transit ;
    rdfs:label 'Fare' ;
    rdfs:comment 'Reference data defining fare structures, zones, rider categories, discounts, and transfer rules for the transit system. Also consolidates: ferry.fare, transit.fare.' .

ind:Ticket rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transit ;
    rdfs:label 'Ticket' ;
    rdfs:comment 'Transactional record of a ticket purchase or validation, capturing rider, fare applied, payment method, and timestamp. Also consolidates: ferry.ticket, transit.ticket.' .

ind:Rider rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transit ;
    rdfs:label 'Rider' ;
    rdfs:comment 'Master record for transit riders, including personal identifiers, eligibility (e.g., senior, student), contact information, and loyalty program status.' .

ind:Operator rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Operator' ;
    rdfs:comment 'Master record of rail operators (freight and passenger carriers) authorized to operate on North Carolina rail network, including contact information, operating authority, and status.' .

ind:TrackSegment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Track Segment' ;
    rdfs:comment 'Physical definition of each rail track segment, including segment identifier, start/end milepost, geometry, track class, ownership, and status.' .

ind:TrackStructure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Track Structure' ;
    rdfs:comment 'Master catalog of track-related structures (bridges, tunnels, signal cabinets, etc.) with attributes such as structure type, location, design standards, inspection schedule, and condition rating.' .

ind:TrainSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Train Schedule' ;
    rdfs:comment 'Planned train service schedules, including train identifier, origin/destination, departure/arrival times, service type, and assigned equipment.' .

ind:TrainMovement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Train Movement' ;
    rdfs:comment 'Real-time movement events for each train, capturing timestamp, location (track segment), speed, direction, and operational status.' .

ind:GradeCrossing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Grade Crossing' ;
    rdfs:comment 'Master list of at-grade railroad crossings, with crossing ID, location, protection type (gate, signal), road classification, and safety status.' .

ind:SignalType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Signal Type' ;
    rdfs:comment 'Reference table of signal types used on the rail network (e.g., absolute, permissive, interlocking) with code, description, and applicable track classes.' .

ind:TrackClassification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Rail ;
    rdfs:label 'Track Classification' ;
    rdfs:comment 'Reference codes defining track classes (Class 1-6) based on speed limits, track geometry, and maintenance standards.' .

ind:Asset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Asset' ;
    rdfs:comment 'Core master record for every physical asset owned by NCDOT, including equipment, vehicles, facilities, and infrastructure components.' .

ind:Type rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Type' ;
    rdfs:comment 'Reference list of asset categories and sub-categories (e.g., vehicle, bridge, building, heavy equipment).' .

ind:Location rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Location' ;
    rdfs:comment 'Standardized locations where assets are situated, such as depots, mileposts, sites, or GIS coordinates.' .

ind:Condition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Condition' ;
    rdfs:comment 'Standard condition codes used to rate asset health (e.g., excellent, good, fair, poor) based on IRI, PCI, etc.' .

ind:MaintenanceSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Maintenance Schedule' ;
    rdfs:comment 'Planned preventive maintenance schedule for each asset, including frequency, tasks, and responsible crew.' .

ind:Inspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Inspection' ;
    rdfs:comment 'Detailed inspection event for an asset, including inspector, findings, condition updates, and corrective actions. Also consolidates: asset.inspection, bridge.inspection. Also consolidates: asset.inspection, dmv.inspection.' .

ind:Procurement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Procurement' ;
    rdfs:comment 'Asset acquisition transaction capturing purchase order, vendor, cost, delivery, and receipt of new assets.' .

ind:Disposal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Disposal' ;
    rdfs:comment 'Record of asset disposal events, including sale, scrap, donation, or transfer, with disposition method and proceeds.' .

ind:Warranty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Warranty' ;
    rdfs:comment 'Warranty details linked to assets, covering coverage period, provider, claim process, and warranty status.' .

ind:Depreciation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Depreciation' ;
    rdfs:comment 'Periodic depreciation entries for capital assets, capturing depreciation method, amount, fiscal year, and book value.' .

ind:WorkOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Maintenance ;
    rdfs:label 'Work Order' ;
    rdfs:comment 'Record of a maintenance work order issued for roadway, bridge, or asset repair, including priority, status, schedule, and assigned resources. Also consolidates: asset.work_order, bridge.maintenance_work_order. Also consolidates: asset.work_order, highway.maintenance_work_order. Also consolidates: asset.work_order, rail.track_maintenance_order.' .

ind:Task rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Maintenance ;
    rdfs:label 'Task' ;
    rdfs:comment 'Master list of predefined maintenance tasks (e.g., pothole patch, vegetation control, snow removal) with standard labor codes, estimated duration, and required materials.' .

ind:MaintenanceSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Maintenance ;
    rdfs:label 'Maintenance Schedule' ;
    rdfs:comment 'Planned maintenance schedule linking work orders to calendar dates, locations, and resource windows for seasonal and routine activities.' .

ind:Material rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Maintenance ;
    rdfs:label 'Material' ;
    rdfs:comment 'Master data for all materials and supplies used in maintenance (e.g., asphalt, sealant, traffic cones) with unit of measure, cost, and inventory status.' .

ind:Crew rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Maintenance ;
    rdfs:label 'Crew' ;
    rdfs:comment 'Master record of maintenance crews, including crew leader, skill certifications, shift patterns, and contact information.' .

ind:CrashReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Crash Report' ;
    rdfs:comment 'Record of each roadway crash event including location, time, vehicles involved, severity, and contributing factors.' .

ind:ResponseAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Response Action' ;
    rdfs:comment 'Actions taken by emergency responders and NCDOT personnel in response to a safety incident, including dispatch, resources used, and timestamps.' .

ind:Program rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Program' ;
    rdfs:comment 'Master record of HSIP safety programs, including program ID, funding allocation, target safety measures, start/end dates, and responsible divisions.' .

ind:PublicAlert rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Public Alert' ;
    rdfs:comment 'Public safety alerts issued to motorists and citizens (e.g., road closures, hazardous conditions, weather impacts) with alert type, message, effective period, and dissemination channels.' .

ind:CorrectiveAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Corrective actions generated from safety inspections or incident investigations, tracking action ID, description, responsible party, due date, status, and closure details.' .

ind:Signal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Signal' ;
    rdfs:comment 'Master record for each traffic signal controller, covering location, hardware model, firmware version, and installed timing plans.' .

ind:SignalTimingPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Signal Timing Plan' ;
    rdfs:comment 'Definition of a signal timing plan (phasing, cycle length, offsets, coordination) that can be applied to a signal controller.' .

ind:Detector rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Detector' ;
    rdfs:comment 'Master record for traffic detectors (inductive loop, radar, video) including type, installation point, calibration data, and maintenance schedule.' .

ind:Flow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Flow' ;
    rdfs:comment 'Transactional record of traffic flow measurements captured by detectors: timestamp, vehicle count, average speed, occupancy, and classification.' .

ind:IncidentType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Incident Type' ;
    rdfs:comment 'Reference table of standardized incident type codes (e.g., crash, stalled vehicle, debris, weather) used to classify incident records.' .

ind:TollTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Toll Transaction' ;
    rdfs:comment 'Transactional record of toll collections: vehicle identifier, toll plaza, lane, amount, payment method, and collection timestamp. Also consolidates: highway.toll_transaction, traffic.toll_transaction.' .

ind:TollRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Toll Rate' ;
    rdfs:comment 'Reference table defining toll rates by vehicle class, time of day, and location for use in toll transaction processing.' .

ind:Alert rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Traffic ;
    rdfs:label 'Alert' ;
    rdfs:comment 'Transactional record of real-time traffic alerts (congestion, incidents, roadwork) sent to the public via mobile apps, variable message signs, and web portals.' .

ind:GrantProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Grant ;
    rdfs:label 'Grant Program' ;
    rdfs:comment 'Master record of federal and state grant programs administered by NCDOT, including program code, name, description, funding source (e.g., FHWA, FTA), eligibility criteria, statutory authority, and budget authority.' .

ind:Applicant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Grant ;
    rdfs:label 'Applicant' ;
    rdfs:comment 'Master entity representing organizations or individuals applying for NCDOT grants, with legal name, tax ID, contact information, classification (state agency, local government, private), and eligibility status.' .

ind:Application rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Grant ;
    rdfs:label 'Application' ;
    rdfs:comment 'Transactional record of a submitted grant application, linking applicant to program, containing submission date, requested amount, project description, supporting documents, and current status.' .

ind:Award rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Grant ;
    rdfs:label 'Award' ;
    rdfs:comment 'Operational record of a grant award decision, linking an application to approved funding, including award amount, award date, award number, conditions, and cost-share requirements. Also consolidates: aviation.grant_funding, grant.award.' .

ind:Disbursement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Grant ;
    rdfs:label 'Disbursement' ;
    rdfs:comment 'Transactional record of each fund transfer made to a grant awardee, capturing disbursement amount, date, payment method, associated award, and reporting period.' .

ind:Expense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Grant ;
    rdfs:label 'Expense' ;
    rdfs:comment 'Transactional record of expenses incurred by awardees and reported for reimbursement, including expense type, amount, date, supporting invoice, and linkage to the related award.' .

ind:ComplianceCheck rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Grant ;
    rdfs:label 'Compliance Check' ;
    rdfs:comment 'Operational record of compliance monitoring activities for a grant award, such as audit findings, status, corrective actions, and dates of review.' .

ind:Permit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Environmental ;
    rdfs:label 'Permit' ;
    rdfs:comment 'Master record for environmental permits issued for transportation projects, including permit type, status, effective and expiration dates, and associated regulatory conditions. Also consolidates: environmental.permit, rail.rail_permit.' .

ind:NepaDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Environmental ;
    rdfs:label 'Nepa Document' ;
    rdfs:comment 'Master entity for NEPA documentation (EIS, EA, CE, FONSI) linked to a project, capturing document type, preparation date, public comment period, and approval status.' .

ind:MitigationPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Environmental ;
    rdfs:label 'Mitigation Plan' ;
    rdfs:comment 'Master record describing mitigation measures required to offset identified environmental impacts, including actions, responsible parties, schedule, and monitoring criteria.' .

ind:MonitoringEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Environmental ;
    rdfs:label 'Monitoring Event' ;
    rdfs:comment 'Transactional record of field monitoring activities (water quality, air quality, species surveys, noise), capturing date, location, observed values, and compliance status.' .

ind:PermitApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Environmental ;
    rdfs:label 'Permit Application' ;
    rdfs:comment 'Transactional record of applications submitted by project owners for environmental permits, containing applicant details, project description, required permits, submission date, and review status. Also consolidates: environmental.permit_application, highway.permit_application.' .

ind:PermitFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Environmental ;
    rdfs:label 'Permit Fee' ;
    rdfs:comment 'Reference data defining fees associated with each permit type, including fee amount, cost basis, applicable statutes, and periodic updates.' .

ind:Segment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Segment' ;
    rdfs:comment 'Master record for each linear highway segment, including segment identifier, start and end milepoints, jurisdiction, and functional class.' .

ind:Lane rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Lane' ;
    rdfs:comment 'Definition of individual lanes within a segment, capturing lane number, width, and usage (e.g., HOV, truck). Also consolidates: highway.lane, traffic.lane.' .

ind:PavementSection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Pavement Section' ;
    rdfs:comment 'Master entity for pavement sections, linking to segment and storing surface type, design thickness, and construction year.' .

ind:PavementCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Pavement Condition' ;
    rdfs:comment 'Periodic condition assessments for pavement sections, storing PCI score, distress types, inspection date, and responsible crew.' .

ind:TrafficCount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Traffic Count' ;
    rdfs:comment 'Traffic volume counts captured at counting stations, including AADT, vehicle classification, and timestamp.' .

ind:ConstructionActivity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Construction Activity' ;
    rdfs:comment 'Record of construction activities on a segment, such as earthwork, paving, and bridge work, with start/end dates, crew, and equipment used.' .

ind:SensorReading rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Sensor Reading' ;
    rdfs:comment 'Telemetry from roadway sensors (e.g., temperature, moisture, strain), timestamped for condition monitoring and predictive maintenance.' .

ind:ServiceRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Service Request' ;
    rdfs:comment 'Requests submitted by the public (e.g., pothole report, signage issue), capturing location, description, priority, and resolution status.' .

ind:RoadwayClassification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Highway ;
    rdfs:label 'Roadway Classification' ;
    rdfs:comment 'Reference table defining roadway functional classes (e.g., Interstate, Principal Arterial, Collector) used for reporting and analysis.' .

ind:Airport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Airport' ;
    rdfs:comment 'Master record for each public airport in North Carolina, including location, ownership, and facility details.' .

ind:Runway rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Runway' ;
    rdfs:comment 'Physical characteristics of each runway (length, width, surface type, lighting, thresholds).' .

ind:NavigationAid rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Navigation Aid' ;
    rdfs:comment 'Details of navigation aids (VOR, NDB, ILS, GPS waypoints) supporting airspace operations.' .

ind:Aircraft rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Aircraft' ;
    rdfs:comment 'Master list of aircraft registered for operation within North Carolina, including type, owner, and airworthiness status.' .

ind:FlightSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Flight Schedule' ;
    rdfs:comment 'Planned flight departures and arrivals for each airline at NCDOT-managed airports, with gate assignments and times.' .

ind:FlightPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Flight Plan' ;
    rdfs:comment 'Submitted flight plan details for each flight, including route, altitude, fuel, and aircraft performance data.' .

ind:Airline rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Airline' ;
    rdfs:comment 'Master data for airline companies that operate flights to/from North Carolina airports, including contact and certification details.' .

ind:AirportFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Airport Fee' ;
    rdfs:comment 'Transactional records of fees charged to airlines for landing, parking, terminal use, and other airport services.' .

ind:PilotLicense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Aviation ;
    rdfs:label 'Pilot License' ;
    rdfs:comment 'Master records of pilot licenses issued, renewed, or revoked, with holder qualifications and medical status.' .

ind:Bridge rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Bridge ;
    rdfs:label 'Bridge' ;
    rdfs:comment 'Authoritative master record for each state-owned bridge, capturing unique bridge identifier, location (latitude/longitude), structure type, span length, year built, ownership, and key attributes for asset management and regulatory reporting.' .

ind:ConditionRating rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Bridge ;
    rdfs:label 'Condition Rating' ;
    rdfs:comment 'Lookup table defining numeric and descriptive condition rating codes (e.g., 0-9) used to rate superstructure, substructure, and deck conditions in inspection records.' .

ind:InspectionType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Bridge ;
    rdfs:label 'Inspection Type' ;
    rdfs:comment 'Lookup table defining types of bridge inspections (e.g., routine, special, post-event, underwater) used to classify inspection records.' .

ind:CostItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Bridge ;
    rdfs:label 'Cost Item' ;
    rdfs:comment 'Reference table of cost item codes used in budgeting and expense tracking for bridge projects, such as materials, labor, equipment, and indirect costs.' .

ind:MapLayer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gis ;
    rdfs:label 'Map Layer' ;
    rdfs:comment 'Master record for each map layer published in ArcGIS Enterprise, including layer name, source data set, scale range, and rendering properties.' .

ind:Feature rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gis ;
    rdfs:label 'Feature' ;
    rdfs:comment 'Master representation of a geographic feature (point, line, polygon) with geometry, attributes, and lifecycle status.' .

ind:SpatialReference rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gis ;
    rdfs:label 'Spatial Reference' ;
    rdfs:comment 'Reference table of spatial reference identifiers (EPSG codes) used to define coordinate systems for GIS data.' .

ind:GeocodeRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gis ;
    rdfs:label 'Geocode Request' ;
    rdfs:comment 'Transactional record of each address-to-coordinate lookup request, including input address, request timestamp, status, and resulting latitude/longitude.' .

ind:RoutingResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gis ;
    rdfs:label 'Routing Result' ;
    rdfs:comment 'Transactional record of a routing calculation, capturing origin, destination, travel mode, route geometry, distance, travel time, and any applied constraints.' .

ind:ProjectBoundary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gis ;
    rdfs:label 'Project Boundary' ;
    rdfs:comment 'Master definition of the geographic boundary for a transportation project, stored as a polygon geometry with associated project identifiers and versioning.' .

ind:TileCache rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gis ;
    rdfs:label 'Tile Cache' ;
    rdfs:comment 'Reference data describing cached map tiles, including tile matrix set, zoom levels, storage location, and refresh schedule.' .

ind:Plan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Plan' ;
    rdfs:comment 'Master record for each approved transportation plan, including LRTP, CTP, and other strategic planning documents with attributes such as plan name, description, effective dates, horizon years, and overall objectives.' .

ind:Scenario rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Scenario' ;
    rdfs:comment 'Definition of a specific planning scenario (e.g., baseline, growth, climate-impact) used in transportation modeling and analysis, with scenario name, description, assumptions, and validity period.' .

ind:Model rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Model' ;
    rdfs:comment 'Metadata for each transportation model (travel demand, freight, emissions) including model version, software, calibration parameters, and linked scenario.' .

ind:Corridor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Corridor' ;
    rdfs:comment 'Geographic definition of a corridor or network segment used in planning, with corridor code, name, geometry reference, and associated functional classification.' .

ind:PlannedProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Planned Project' ;
    rdfs:comment 'Transactional record of a planned infrastructure project, capturing project identifier, associated plan, corridor, scope, cost estimate, schedule, and status.' .

ind:Stakeholder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Stakeholder' ;
    rdfs:comment 'Master list of external and internal stakeholders involved in planning, such as MPOs, RPOs, local agencies, and advisory groups, with contact information and role.' .

ind:Policy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Policy' ;
    rdfs:comment 'Master record for policy documents that guide planning decisions, including policy identifier, title, description, effective date, and related statutes or regulations.' .

ind:PlanStatus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Reference table of possible statuses for a transportation plan (e.g., Draft, Approved, In-Review, Archived) with status code and description.' .

ind:FundingSource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Planning ;
    rdfs:label 'Funding Source' ;
    rdfs:comment 'Reference table of funding source types (e.g., FHWA, STIP, GARVEE) with source code and description.' .

ind:Vendor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Vendor' ;
    rdfs:comment 'Master record for each approved vendor, including legal entity details, tax IDs, contact information, certification status, and preferred categories.' .

ind:Contract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Contract' ;
    rdfs:comment 'Master contract entity capturing contract number, effective and expiration dates, scope, total value, payment terms, and linked vendor. Also consolidates: asset.contract, bridge.contract. Also consolidates: asset.contract, highway.contract. Also consolidates: asset.contract, maintenance.contract. Also consolidates: asset.contract, project.project_contract.' .

ind:Category rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Category' ;
    rdfs:comment 'Reference table defining procurement spend categories, hierarchy levels, and associated budgeting codes used across all purchasing activities.' .

ind:PurchaseRequisition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Purchase Requisition' ;
    rdfs:comment 'Transactional record of internal purchase requests, including requester, required items, justification, approved budget, and workflow status.' .

ind:PurchaseOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Purchase Order' ;
    rdfs:comment 'Transactional purchase order issued to a vendor, containing line items, quantities, unit prices, delivery dates, and linked contract where applicable.' .

ind:GoodsReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Goods Receipt' ;
    rdfs:comment 'Record of goods receipt confirming receipt of items against a purchase order, capturing received quantities, condition, inspection results, and storage location.' .

ind:Invoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Invoice' ;
    rdfs:comment 'Invoice generated for goods/services received, including line-item amounts, taxes, total payable, due dates, and payment terms.' .

ind:VendorPerformance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Vendor Performance' ;
    rdfs:comment 'Transactional log of periodic vendor performance assessments, including scorecards, on-time delivery metrics, quality incidents, and corrective actions.' .

ind:ProcurementPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Procurement ;
    rdfs:label 'Procurement Plan' ;
    rdfs:comment 'Master plan outlining anticipated procurement activities, budget allocations, project linkages, and timeline for the fiscal year.' .

ind:GeneralLedger rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'General Ledger' ;
    rdfs:comment 'Authoritative master record of the General Ledger, containing chart of accounts, balances, and hierarchical structure for all financial postings.' .

ind:CostCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Master definition of cost centers used for internal cost allocation, budgeting, and reporting across NCDOT divisions.' .

ind:Budget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Budget' ;
    rdfs:comment 'Master record of approved fiscal year budgets, including total appropriations, program allocations, and multi-year planning.' .

ind:BudgetLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Budget Line' ;
