    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalTransportRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Transport Required Flag' ;
    rdfs:comment 'Indicator whether emergency medical transport was required.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalName rdf:type rdf:Property ;
    rdfs:label 'Hospital Name' ;
    rdfs:comment 'Name of the hospital where injured persons were transported.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Investigation Required Flag' ;
    rdfs:comment 'Indicator whether a formal investigation is required for the incident.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigatingAgency rdf:type rdf:Property ;
    rdfs:label 'Investigating Agency' ;
    rdfs:comment 'Name of the agency conducting the formal investigation (NTSB, FAA, FRA, State Highway Patrol, etc.).' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationNumber rdf:type rdf:Property ;
    rdfs:label 'Investigation Number' ;
    rdfs:comment 'Official investigation case number assigned by the investigating agency.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationStatus rdf:type rdf:Property ;
    rdfs:label 'Investigation Status' ;
    rdfs:comment 'Current status of the formal investigation.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashReportNumber rdf:type rdf:Property ;
    rdfs:label 'Crash Report Number' ;
    rdfs:comment 'Official crash report number assigned by law enforcement for traffic crashes.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:narrativeDescription rdf:type rdf:Property ;
    rdfs:label 'Narrative Description' ;
    rdfs:comment 'Detailed narrative description of the incident circumstances, sequence of events, and observations.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadwayClearanceTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Roadway Clearance Time Minutes' ;
    rdfs:comment 'Time elapsed in minutes from incident occurrence to removal of vehicles and debris from travel lanes.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delayVehicleHours rdf:type rdf:Property ;
    rdfs:label 'Delay Vehicle Hours' ;
    rdfs:comment 'Estimated total vehicle delay caused by the incident measured in vehicle-hours.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghspReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Ghsp Reportable Flag' ;
    rdfs:comment 'Indicator whether the incident must be reported to the Governors Highway Safety Program.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Reportable Flag' ;
    rdfs:comment 'Indicator whether the incident must be reported to federal agencies (FHWA, NTSB, FAA, FRA).' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mediaNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Media Notification Flag' ;
    rdfs:comment 'Indicator whether media notification or public information release was issued for the incident.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportedByName rdf:type rdf:Property ;
    rdfs:label 'Reported By Name' ;
    rdfs:comment 'Name of the person who initially reported the incident.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedByPhone rdf:type rdf:Property ;
    rdfs:label 'Reported By Phone' ;
    rdfs:comment 'Contact phone number of the person who reported the incident.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToName rdf:type rdf:Property ;
    rdfs:label 'Assigned To Name' ;
    rdfs:comment 'Name of the NCDOT staff member or responder assigned to manage the incident response.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToEmail rdf:type rdf:Property ;
    rdfs:label 'Assigned To Email' ;
    rdfs:comment 'Email address of the NCDOT staff member assigned to manage the incident response.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originAirportId rdf:type rdf:Property ;
    rdfs:label 'Origin Airport Id' ;
    rdfs:comment 'FK to aviation.airport' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Airport .

ind:destinationAirportId rdf:type rdf:Property ;
    rdfs:label 'Destination Airport Id' ;
    rdfs:comment 'FK to aviation.airport' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Airport .

ind:operatingAirlineId rdf:type rdf:Property ;
    rdfs:label 'Operating Airline Id' ;
    rdfs:comment 'FK to aviation.airline' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Airline .

ind:diversionAirportId rdf:type rdf:Property ;
    rdfs:label 'Diversion Airport Id' ;
    rdfs:comment 'FK to aviation.airport' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Airport .

ind:crewAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Crew Assignment Id' ;
    rdfs:comment 'Foreign key linking to hr.crew_assignment. Business justification: Construction activities require assigned work crews. Operations teams use this daily to track which crew is performing roadwork, ensuring accountability and resource allocation for highway maintenance' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CrewAssignment .

ind:assignedEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Citizen service requests (potholes, debris, signage) are assigned to specific maintenance employees. Dispatch and operations use this to track work assignments, response times, and employee workload d' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:vehicleRegistrationId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Registration Id' ;
    rdfs:comment 'Foreign key linking to dmv.registration. Business justification: Ferry vessels are motor vehicles requiring DMV registration under NC law. DMV tracks vessel registration, title, and compliance. Ferry operations verify current registration status daily for regulator' ;
    rdfs:domain ind:Vessel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registration .

ind:inspectionRecordId rdf:type rdf:Property ;
    rdfs:label 'Inspection Record Id' ;
    rdfs:comment 'Foreign key linking to highway.inspection_record. Business justification: Maintenance events are often triggered by inspection findings. This links maintenance activities to the specific inspection that identified the need for repair or intervention.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionRecord .

ind:dmvOfficeId rdf:type rdf:Property ;
    rdfs:label 'Dmv Office Id' ;
    rdfs:comment 'Foreign key linking to dmv.office. Business justification: NCDOT assets (computers, furniture, kiosks, signage) are physically located at specific DMV offices. Asset management tracks which office holds each asset for inventory, maintenance scheduling, and pr' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Office .

ind:locationFeatureId rdf:type rdf:Property ;
    rdfs:label 'Location Feature Id' ;
    rdfs:comment 'Foreign key linking to gis.feature. Business justification: DMV offices are physical locations requiring precise geospatial representation for mapping, routing citizens to nearest office, and spatial analysis of service coverage areas.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feature .

ind:serviceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Service Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: DMV appointments are serviced by specific NCDOT employees. Tracking which employee handled each appointment is essential for performance metrics, workload management, and customer service quality assu' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestingOfficeId rdf:type rdf:Property ;
    rdfs:label 'Requesting Office Id' ;
    rdfs:comment 'Foreign key linking to dmv.office. Business justification: Purchase requisitions originate from specific DMV offices requesting supplies, equipment, or services. Procurement tracks which office initiated each request for budget allocation and approval workflo' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Office .

ind:ratedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Rated By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Condition ratings must be assigned by qualified bridge engineers. NCDOT tracks who performed the rating for professional liability, audit trails, and quality assurance purposes.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:estimatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Estimated By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Cost estimates for bridge maintenance and repairs must be prepared by qualified engineers or estimators. NCDOT tracks estimator accountability for budget planning and variance analysis.' ;
    rdfs:domain ind:CostItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:relatedSignalId rdf:type rdf:Property ;
    rdfs:label 'Related Signal Id' ;
    rdfs:comment 'Foreign key linking to traffic.signal. Business justification: Right-of-way acquisitions for intersection improvements or signal installations must reference the specific traffic signal project. ROW agents use this to justify acquisition scope and coordinate timi' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Signal .

ind:maintainedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Maintained By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Traffic signals require assigned maintenance personnel for routine inspections, repairs, and emergency response. Operations teams track which technician is responsible for each signal asset.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:createdByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Created By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Incident type classifications are defined and maintained by traffic management staff. System tracks which employee created or last modified incident type definitions for audit and accountability.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:issuedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Issued By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Traffic alerts (road closures, hazards, delays) are issued by authorized traffic management center operators. System must track which employee issued each alert for accountability and audit compliance' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:maintenanceContractId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Contract Id' ;
    rdfs:comment 'Foreign key linking to procurement.contract. Business justification: Traffic signals require ongoing maintenance contracts with vendors. NCDOT traffic operations references active maintenance contracts daily for service scheduling, warranty claims, and vendor accountab' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:installationContractId rdf:type rdf:Property ;
    rdfs:label 'Installation Contract Id' ;
    rdfs:comment 'Foreign key linking to procurement.contract. Business justification: Traffic detectors are installed under specific procurement contracts. Operations teams reference installation contracts for warranty issues, defect claims, and maintenance handoff documentation.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:trafficSignalId rdf:type rdf:Property ;
    rdfs:label 'Traffic Signal Id' ;
    rdfs:comment 'Foreign key linking to traffic.signal. Business justification: Purchase requisitions for signal equipment, replacement parts, or upgrades must reference the specific signal asset. Procurement staff uses this to validate budget allocation and asset management trac' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Signal .

ind:originatingProjectId rdf:type rdf:Property ;
    rdfs:label 'Originating Project Id' ;
    rdfs:comment 'Foreign key linking to project.project. Business justification: New assets (bridges, roads, signals) are created through capital projects. Asset management tracks which construction project built each asset for warranty, as-built documentation, and lifecycle histo' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Project .

ind:connectingTripId rdf:type rdf:Property ;
    rdfs:label 'Connecting Trip Id' ;
    rdfs:comment 'Foreign key linking to transit.trip. Business justification: Passengers book ferry reservations with connecting transit trips for seamless multimodal journeys. Trip planning systems use this to coordinate ferry-to-bus/rail transfers at terminals.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Trip .

ind:assignedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned To Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Project issues (delays, safety concerns, design problems) must be assigned to specific employees for resolution. Critical for issue tracking and accountability.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:sourceId rdf:type rdf:Property ;
    rdfs:label 'Source Id' ;
    rdfs:comment 'Foreign key linking to planning.funding_source. Business justification: Project funding must reference specific funding sources (federal grants, state bonds, local match). Finance department tracks which funding source each allocation comes from for compliance and reporti' ;
    rdfs:domain ind:Funding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FundingSource .

ind:grantAwardId rdf:type rdf:Property ;
    rdfs:label 'Grant Award Id' ;
    rdfs:comment 'Foreign key linking to grant.award. Business justification: Ferry vessels are often acquired or upgraded using federal/state transportation grants (FTA, BUILD, INFRA). NCDOT tracks which grant funded each vessel for compliance reporting and asset management.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Award .

ind:lineId rdf:type rdf:Property ;
    rdfs:label 'Line Id' ;
    rdfs:comment 'Foreign key linking to finance.budget_line. Business justification: Project expenditures are coded to specific budget line items for granular financial reporting and compliance with governmental accounting standards. Used in every expenditure transaction.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:captainEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Captain Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Every ferry vessel has an assigned captain who is an NCDOT employee. Operations and safety regulations require tracking the responsible captain for each vessel.' ;
    rdfs:domain ind:Vessel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:driverEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Driver Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Transit trips require assigned drivers who are NCDOT employees. Operations dispatch uses this daily to track which employee operated each trip for payroll, compliance, and incident management.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:boundaryFeatureId rdf:type rdf:Property ;
    rdfs:label 'Boundary Feature Id' ;
    rdfs:comment 'Foreign key linking to gis.feature. Business justification: Airport boundaries are spatial features managed in GIS. Aviation planners and safety officers use GIS features daily to define airspace restrictions, noise contours, and property boundaries for regula' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feature .

ind:centerlineFeatureId rdf:type rdf:Property ;
    rdfs:label 'Centerline Feature Id' ;
    rdfs:comment 'Foreign key linking to gis.feature. Business justification: Runway centerlines are precision spatial features in GIS. Airport engineers and surveyors reference these daily for maintenance planning, obstruction analysis, and FAA compliance reporting requiring e' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feature .

ind:assignedDepartmentId rdf:type rdf:Property ;
    rdfs:label 'Assigned Department Id' ;
    rdfs:comment 'Foreign key linking to hr.department. Business justification: State aircraft are assigned to specific NCDOT departments (Aviation Division, Emergency Management, Governor\'s Office). Used for asset management, cost allocation, and operational authority tracking.' ;
    rdfs:domain ind:Aircraft ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Department .

ind:primaryContactEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Rail operators require a designated NCDOT employee as primary contact for coordination, safety communications, and regulatory compliance. Operations teams use this daily for incident response and sche' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:responsibleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Responsible Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Maintenance schedules assign responsibility to specific employees or supervisors for ensuring work completion. Operations uses this to track accountability and workload distribution.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:authorizedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Authorized By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Asset disposal requires authorized employee approval for financial accountability and regulatory compliance. Audit trails must track who authorized disposal of state property.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:negotiatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Negotiated By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Easement agreements are negotiated by specific NCDOT right-of-way agents. Tracking the negotiating employee is critical for legal documentation, follow-up communications, and performance evaluation of' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:preparedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Prepared By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: NEPA documents must identify the qualified environmental specialist who prepared the analysis. Required for regulatory compliance and professional accountability in federal environmental review proces' ;
    rdfs:domain ind:NepaDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:submittedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Submitted By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Permit applications track which NCDOT employee submitted the application to regulatory agencies. Essential for correspondence routing, follow-up coordination, and internal accountability tracking.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:projectManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Project Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Every planned transportation project requires a designated project manager employee who is accountable for planning, coordination, and delivery. Used daily in project tracking and reporting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:programManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Program Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: Grant applications require assigned program managers from NCDOT staff to oversee review, compliance, and award processes. Essential for accountability and workflow management in grant administration.' ;
    rdfs:domain ind:Application ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Requested By Employee Id' ;
    rdfs:comment 'Foreign key linking to hr.employee. Business justification: GIS geocoding requests are submitted by NCDOT employees for incident locations, asset mapping, or planning analysis. System tracks which employee initiated each geocode request for audit and workload ' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:routeStopScheduleId rdf:type rdf:Property ;
    rdfs:label 'Route Stop Schedule Id' ;
    rdfs:comment 'Primary key for the route_stop_schedule association' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stopSequence rdf:type rdf:Property ;
    rdfs:label 'Stop Sequence' ;
    rdfs:comment 'The order in which this stop is visited along the route. Critical for trip planning and schedule display. Lower numbers indicate earlier stops in the route sequence.' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arrivalTime rdf:type rdf:Property ;
    rdfs:label 'Arrival Time' ;
    rdfs:comment 'The scheduled time when the transit vehicle arrives at this stop on this route. Format HH:MM:SS. Used for passenger information and schedule adherence monitoring.' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departureTime rdf:type rdf:Property ;
    rdfs:label 'Departure Time' ;
    rdfs:comment 'The scheduled time when the transit vehicle departs from this stop on this route. Format HH:MM:SS. May differ from arrival_time for timing points where vehicles wait.' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timepointFlag rdf:type rdf:Property ;
    rdfs:label 'Timepoint Flag' ;
    rdfs:comment 'Indicates whether this stop is a designated timepoint where the vehicle must adhere to exact scheduled times (true) or an approximate stop (false). Critical for operations and schedule adherence reporting.' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pickupType rdf:type rdf:Property ;
    rdfs:label 'Pickup Type' ;
    rdfs:comment 'Indicates pickup availability at this stop for this route: 0=regularly scheduled, 1=no pickup available, 2=must phone agency, 3=must coordinate with driver. Route-stop specific operational rule.' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dropOffType rdf:type rdf:Property ;
    rdfs:label 'Drop Off Type' ;
    rdfs:comment 'Indicates drop-off availability at this stop for this route: 0=regularly scheduled, 1=no drop-off available, 2=must phone agency, 3=must coordinate with driver. Route-stop specific operational rule.' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shapeDistTraveled rdf:type rdf:Property ;
    rdfs:label 'Shape Dist Traveled' ;
    rdfs:comment 'The distance traveled along the route shape from the origin to this stop, measured in miles or kilometers. Used for accurate map rendering and distance-based fare calculation for this specific route-stop combination.' ;
    rdfs:domain ind:RouteStopSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pavementTreatmentId rdf:type rdf:Property ;
    rdfs:label 'Pavement Treatment Id' ;
    rdfs:comment 'Primary key for the pavement_treatment association' ;
    rdfs:domain ind:PavementTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledWorkDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Work Date' ;
    rdfs:comment 'Planned date for the treatment work to be performed on this pavement section as part of the project schedule.' ;
    rdfs:domain ind:PavementTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preConditionRating rdf:type rdf:Property ;
    rdfs:label 'Pre Condition Rating' ;
    rdfs:comment 'Pavement condition index or rating assessed before the treatment was applied. Used to establish baseline condition and justify treatment selection.' ;
    rdfs:domain ind:PavementTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postConditionRating rdf:type rdf:Property ;
    rdfs:label 'Post Condition Rating' ;
    rdfs:comment 'Pavement condition index or rating assessed after the treatment was completed. Used to measure treatment effectiveness and expected service life extension.' ;
    rdfs:domain ind:PavementTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workScope rdf:type rdf:Property ;
    rdfs:label 'Work Scope' ;
    rdfs:comment 'Detailed description of the specific work performed on this pavement section, including materials used, layer thicknesses, and any special treatments or conditions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastOverlayYear rdf:type rdf:Property ;
    rdfs:label 'Last Overlay Year' ;
    rdfs:comment 'Year when the most recent overlay or resurfacing treatment was applied to the pavement section. [Moved from pavement_section: This attribute represents the most recent overlay treatment, which should be derived from the pavement_treatment association rather than stored redundantly on pavement_section. The association provides the complete treatment history.]' ;
    rdfs:domain ind:PavementTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:constructionImpactId rdf:type rdf:Property ;
    rdfs:label 'Construction Impact Id' ;
    rdfs:comment 'Primary key for the construction_impact association' ;
    rdfs:domain ind:ConstructionImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:impactStartDate rdf:type rdf:Property ;
    rdfs:label 'Impact Start Date' ;
    rdfs:comment 'Date when the construction activity begins to affect the transit route operations. Used for scheduling service modifications and public notifications.' ;
    rdfs:domain ind:ConstructionImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impactEndDate rdf:type rdf:Property ;
    rdfs:label 'Impact End Date' ;
    rdfs:comment 'Date when the construction activity impact on the transit route is expected to end and normal service resumes. Used for planning restoration of regular service.' ;
    rdfs:domain ind:ConstructionImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:detourRequired rdf:type rdf:Property ;
    rdfs:label 'Detour Required' ;
    rdfs:comment 'Indicates whether the transit route must be detoured due to this construction activity. Triggers detour planning and signage updates.' ;
    rdfs:domain ind:ConstructionImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceModificationType rdf:type rdf:Property ;
    rdfs:label 'Service Modification Type' ;
    rdfs:comment 'Classification of how the transit service must be modified due to the construction activity. Determines operational response and public communication strategy.' ;
    rdfs:domain ind:ConstructionImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationStatus rdf:type rdf:Property ;
    rdfs:label 'Notification Status' ;
    rdfs:comment 'Current status of public notification regarding this construction impact. Tracks whether affected riders have been informed of service changes.' ;
    rdfs:domain ind:ConstructionImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corridorSegmentId rdf:type rdf:Property ;
    rdfs:label 'Corridor Segment Id' ;
    rdfs:comment 'Primary key for the corridor_segment association' ;
    rdfs:domain ind:CorridorSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:milepostStart rdf:type rdf:Property ;
    rdfs:label 'Milepost Start' ;
    rdfs:comment 'Starting milepost of this segment within the corridor\'s milepost system. May differ from the segment\'s route-based milepoint as corridors can span multiple routes and use corridor-specific milepost references.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inclusionDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion Date' ;
    rdfs:comment 'Date when this segment was officially included in the corridor definition. Supports historical tracking of corridor boundary changes and is used in corridor study documentation and planning history.' ;
    rdfs:domain ind:CorridorSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:segmentRole rdf:type rdf:Property ;
    rdfs:label 'Segment Role' ;
    rdfs:comment 'Functional role of this segment within the corridor context (e.g., Primary mainline, Alternate route, Parallel facility, Connector, Future extension). Used for corridor analysis to distinguish between core corridor segments and supporting facilities.' ;
    rdfs:domain ind:CorridorSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentScenarioTreatmentId rdf:type rdf:Property ;
    rdfs:label 'Segment Scenario Treatment Id' ;
    rdfs:comment 'Primary key for the segment_scenario_treatment association' ;
    rdfs:domain ind:SegmentScenarioTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:implementationYear rdf:type rdf:Property ;
    rdfs:label 'Implementation Year' ;
    rdfs:comment 'The target year for implementing this treatment on this segment within the scenario timeline' ;
    rdfs:domain ind:SegmentScenarioTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conditionImprovement rdf:type rdf:Property ;
    rdfs:label 'Condition Improvement' ;
    rdfs:comment 'The expected improvement in pavement condition rating resulting from this treatment in this scenario' ;
    rdfs:domain ind:SegmentScenarioTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractSegmentId rdf:type rdf:Property ;
    rdfs:label 'Contract Segment Id' ;
    rdfs:comment 'Primary key for the contract_segment association' ;
    rdfs:domain ind:ContractSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:segmentStartMilepost rdf:type rdf:Property ;
    rdfs:label 'Segment Start Milepost' ;
    rdfs:comment 'Starting milepoint within the segment where contract work begins. May differ from segment begin_milepoint if contract covers only a portion of the segment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentEndMilepost rdf:type rdf:Property ;
    rdfs:label 'Segment End Milepost' ;
    rdfs:comment 'Ending milepoint within the segment where contract work ends. May differ from segment end_milepoint if contract covers only a portion of the segment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentContractValue rdf:type rdf:Property ;
    rdfs:label 'Segment Contract Value' ;
    rdfs:comment 'Portion of the total contract value allocated to work on this specific segment. Used for financial tracking and payment allocation.' ;
    rdfs:domain ind:ContractSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignmentId rdf:type rdf:Property ;
    rdfs:label 'Assignment Id' ;
    rdfs:comment 'Primary key for the assignment association' ;
    rdfs:domain ind:Assignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:role rdf:type rdf:Property ;
    rdfs:label 'Role' ;
    rdfs:comment 'The role or capacity in which the crew is assigned to this segment (e.g., Primary crew responsible for the work, Support crew assisting another crew, Emergency Response, Specialized work requiring specific certifications).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialApplicationId rdf:type rdf:Property ;
    rdfs:label 'Material Application Id' ;
    rdfs:comment 'Primary key for the material_application association' ;
    rdfs:domain ind:MaterialApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityUsed rdf:type rdf:Property ;
    rdfs:label 'Quantity Used' ;
    rdfs:comment 'The quantity of material applied to the pavement section in this specific application event, measured in the material\'s unit of measure' ;
    rdfs:domain ind:MaterialApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitCost rdf:type rdf:Property ;
    rdfs:label 'Unit Cost' ;
    rdfs:comment 'The cost per unit of material at the time of this specific application, which may differ from standard cost due to market conditions or procurement timing' ;
    rdfs:domain ind:MaterialApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicationNotes rdf:type rdf:Property ;
    rdfs:label 'Application Notes' ;
    rdfs:comment 'Free-text notes documenting any special conditions, issues, or observations during the material application' ;
    rdfs:domain ind:MaterialApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashInvolvementId rdf:type rdf:Property ;
    rdfs:label 'Crash Involvement Id' ;
    rdfs:comment 'Primary key for the crash_involvement association' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:driverRole rdf:type rdf:Property ;
    rdfs:label 'Driver Role' ;
    rdfs:comment 'The role of the driver in the crash event (e.g., Driver, Passenger, Witness). This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faultPercentage rdf:type rdf:Property ;
    rdfs:label 'Fault Percentage' ;
    rdfs:comment 'Percentage of fault assigned to this driver for this crash, determined during crash investigation. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injurySeverity rdf:type rdf:Property ;
    rdfs:label 'Injury Severity' ;
    rdfs:comment 'Severity of injury sustained by this driver in this crash. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:citationIssued rdf:type rdf:Property ;
    rdfs:label 'Citation Issued' ;
    rdfs:comment 'Boolean flag indicating whether a citation was issued to this driver at the scene of this crash. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vehicleUnitNumber rdf:type rdf:Property ;
    rdfs:label 'Vehicle Unit Number' ;
    rdfs:comment 'Unit number assigned to the vehicle this driver was associated with in the crash report (for multi-vehicle crashes)' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:airbagDeployed rdf:type rdf:Property ;
    rdfs:label 'Airbag Deployed' ;
    rdfs:comment 'Indicates whether the airbag deployed for this driver in this crash' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ejectedFromVehicle rdf:type rdf:Property ;
    rdfs:label 'Ejected From Vehicle' ;
    rdfs:comment 'Indicates whether this driver was ejected from the vehicle during this crash' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transportedToHospital rdf:type rdf:Property ;
    rdfs:label 'Transported To Hospital' ;
    rdfs:comment 'Indicates whether this driver was transported to a hospital from the crash scene' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contributingFactors rdf:type rdf:Property ;
    rdfs:label 'Contributing Factors' ;
    rdfs:comment 'Comma-separated list of contributing factors attributed to this driver for this crash (e.g., speeding, distraction, impairment)' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alcoholTestResult rdf:type rdf:Property ;
    rdfs:label 'Alcohol Test Result' ;
    rdfs:comment 'Blood alcohol content (BAC) test result for this driver in this crash, if tested' ;
    rdfs:domain ind:CrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleCrashInvolvementId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Crash Involvement Id' ;
    rdfs:comment 'Primary key for the vehicle_crash_involvement association' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleRole rdf:type rdf:Property ;
    rdfs:label 'Vehicle Role' ;
    rdfs:comment 'The role this specific vehicle played in the crash event (e.g., striking vehicle, struck vehicle, parked vehicle). Critical for liability determination and crash reconstruction.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damageSeverity rdf:type rdf:Property ;
    rdfs:label 'Damage Severity' ;
    rdfs:comment 'Assessment of damage sustained by this vehicle in this specific crash. Used for total loss determination, insurance claims, and crash severity analysis.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:towedIndicator rdf:type rdf:Property ;
    rdfs:label 'Towed Indicator' ;
    rdfs:comment 'Indicates whether this vehicle was towed from the crash scene due to damage or other factors. Important for crash severity metrics and operational response tracking.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occupantCount rdf:type rdf:Property ;
    rdfs:label 'Occupant Count' ;
    rdfs:comment 'Number of occupants in this specific vehicle at the time of the crash. Used for injury analysis and safety research.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleSequence rdf:type rdf:Property ;
    rdfs:label 'Vehicle Sequence' ;
    rdfs:comment 'Sequential number assigned to this vehicle within the crash report (Vehicle 1, Vehicle 2, etc.) for reference in narrative and diagrams.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preCrashAction rdf:type rdf:Property ;
    rdfs:label 'Pre Crash Action' ;
    rdfs:comment 'Action the vehicle was taking immediately prior to the crash (e.g., going straight, turning left, changing lanes, stopped). Critical for crash causation analysis.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointOfImpact rdf:type rdf:Property ;
    rdfs:label 'Point Of Impact' ;
    rdfs:comment 'Location on this vehicle where initial impact occurred. Used for crash reconstruction and injury pattern analysis.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributingFactor rdf:type rdf:Property ;
    rdfs:label 'Contributing Factor' ;
    rdfs:comment 'Primary contributing factor attributed to this vehicle or its driver (e.g., speed, failure to yield, distraction, impairment). Used for crash causation and prevention programs.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Recorded Timestamp' ;
    rdfs:comment 'Timestamp when this vehicle involvement record was created in the system during crash investigation.' ;
    rdfs:domain ind:VehicleCrashInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:engagementId rdf:type rdf:Property ;
    rdfs:label 'Engagement Id' ;
    rdfs:comment 'Primary key for the project_stakeholder_engagement association' ;
    rdfs:domain ind:StakeholderEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stakeholderRole rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Role' ;
    rdfs:comment 'The specific role this stakeholder plays in this project (e.g., Consulting Party, Affected Property Owner, Utility Coordinator, MPO Representative, Funding Partner, Advisory Board Member)' ;
    rdfs:domain ind:StakeholderEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementLevel rdf:type rdf:Property ;
    rdfs:label 'Engagement Level' ;
    rdfs:comment 'Required level of engagement for this stakeholder on this project (e.g., Inform, Consult, Involve, Collaborate, Empower) based on IAP2 spectrum or NCDOT policy' ;
    rdfs:domain ind:StakeholderEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementStartDate rdf:type rdf:Property ;
    rdfs:label 'Engagement Start Date' ;
    rdfs:comment 'Date when this stakeholder was formally engaged or added to the project stakeholder list' ;
    rdfs:domain ind:StakeholderEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementEndDate rdf:type rdf:Property ;
    rdfs:label 'Engagement End Date' ;
    rdfs:comment 'Date when this stakeholder\'s formal engagement with the project concluded or was terminated' ;
    rdfs:domain ind:StakeholderEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementStatus rdf:type rdf:Property ;
    rdfs:label 'Engagement Status' ;
    rdfs:comment 'Current status of this stakeholder engagement relationship (e.g., Active, Completed, On Hold, Withdrawn)' ;
    rdfs:domain ind:StakeholderEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'Dollar amount allocated from this specific grant award to this specific project. This is the portion of the award\'s total amount designated for this project, tracked separately because awards can fund multiple projects and projects receive funding from multiple awards.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phase rdf:type rdf:Property ;
    rdfs:label 'Phase' ;
    rdfs:comment 'Project lifecycle phase for which this funding allocation is designated (e.g., Planning, Design, Construction). A single award may fund multiple phases of the same project, requiring separate allocation records.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expendedToDate rdf:type rdf:Property ;
    rdfs:label 'Expended To Date' ;
    rdfs:comment 'Cumulative amount expended from this allocation as of the current date. Tracked at the project-award level to monitor drawdown against each funding source.' ;
    rdfs:domain ind:Funding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trackInspectionId rdf:type rdf:Property ;
    rdfs:label 'Track Inspection Id' ;
    rdfs:comment 'Primary key for the track_inspection association' ;
    rdfs:domain ind:TrackInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defectsFound rdf:type rdf:Property ;
    rdfs:label 'Defects Found' ;
    rdfs:comment 'Number of defects identified on this track segment during the inspection' ;
    rdfs:domain ind:TrackInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programVendorEligibilityId rdf:type rdf:Property ;
    rdfs:label 'Program Vendor Eligibility Id' ;
    rdfs:comment 'Primary key for the program_vendor_eligibility association' ;
    rdfs:domain ind:ProgramVendorEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prequalificationDate rdf:type rdf:Property ;
    rdfs:label 'Prequalification Date' ;
    rdfs:comment 'Date when the vendor was prequalified or approved for participation in this specific grant program. Explicitly identified in detection reasoning.' ;
    rdfs:domain ind:ProgramVendorEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programSpecificCertification rdf:type rdf:Property ;
    rdfs:label 'Program Specific Certification' ;
    rdfs:comment 'Type or identifier of program-specific certification required and held by the vendor for this grant program (e.g., DBE certification for DBE programs, SBTDC certification). Explicitly identified in detection reasoning.' ;
    rdfs:domain ind:ProgramVendorEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiry Date' ;
    rdfs:comment 'Date when the program-specific certification or eligibility expires and requires renewal for this vendor-program combination. Explicitly identified in detection reasoning.' ;
    rdfs:domain ind:ProgramVendorEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Determination Date' ;
    rdfs:comment 'Date when the eligibility determination was made by the grant program administrator for this vendor-program combination.' ;
    rdfs:domain ind:ProgramVendorEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:determinedBy rdf:type rdf:Property ;
    rdfs:label 'Determined By' ;
    rdfs:comment 'Name or identifier of the grant administrator or certifying official who determined eligibility for this vendor-program combination.' ;
    rdfs:domain ind:ProgramVendorEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityNotes rdf:type rdf:Property ;
    rdfs:label 'Eligibility Notes' ;
    rdfs:comment 'Free-text notes documenting special conditions, waivers, or additional requirements for this vendor\'s eligibility in this specific program.' ;
    rdfs:domain ind:ProgramVendorEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Contract Assignment Id' ;
    rdfs:comment 'Primary key for the contract_assignment association' ;
    rdfs:domain ind:ContractAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Date' ;
    rdfs:comment 'The date when the employee was formally assigned to this contract in this role. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibilityPercentage rdf:type rdf:Property ;
    rdfs:label 'Responsibility Percentage' ;
    rdfs:comment 'The percentage of the employee\'s time or workload allocated to this contract assignment. Used for workload balancing and capacity planning. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:ContractAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryContactFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Flag' ;
    rdfs:comment 'Indicates whether this employee is the primary point of contact for this contract. Used for routing inquiries and establishing accountability. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:ContractAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:projectAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Project Assignment Id' ;
    rdfs:comment 'Primary key for the project_assignment association' ;
    rdfs:domain ind:ProjectAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roleOnProject rdf:type rdf:Property ;
    rdfs:label 'Role On Project' ;
    rdfs:comment 'The specific role or function the employee performs on this project (e.g., Project Manager, Lead Engineer, Inspector). Explicitly identified in detection phase as relationship data.' ;
    rdfs:domain ind:ProjectAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryResponsibilityArea rdf:type rdf:Property ;
    rdfs:label 'Primary Responsibility Area' ;
    rdfs:comment 'The primary area of responsibility or work scope assigned to the employee for this project (e.g., Design, Construction Oversight, Environmental Compliance, ROW Acquisition). Explicitly identified in detection phase as relationship data.' ;
    rdfs:domain ind:ProjectAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusId rdf:type rdf:Property ;
    rdfs:label 'Status Id' ;
    rdfs:comment 'Foreign key linking to planning.plan_status. Business justification: Normalize plan status from STRING to FK reference. The plan_status attribute (STRING) should be replaced with plan_status_id FK to the plan_status reference table, which provides structured status man' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanStatus .

ind:issuingOfficeId rdf:type rdf:Property ;
    rdfs:label 'Issuing Office Id' ;
    rdfs:comment 'Foreign key linking to dmv.office. Business justification: Registration is issued at a DMV office. Adding issuing_office_id FK allows joining to office master for office code and name. Office details are authoritative in office table.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Office .

ind:sailingSailingScheduleId rdf:type rdf:Property ;
    rdfs:label 'Sailing Sailing Schedule Id' ;
    rdfs:comment 'Unique identifier for the specific ferry sailing to which crew members are assigned. Applicable for ferry operations crew assignments.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SailingSchedule .

ind:crewRole rdf:type rdf:Property ;
    rdfs:label 'Crew Role' ;
    rdfs:comment 'The specific role or position the employee holds within the crew for this assignment. Role or function the crew performs on this specific work order (e.g., lead, operator, laborer, specialist).' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewType rdf:type rdf:Property ;
    rdfs:label 'Crew Type' ;
    rdfs:comment 'Classification of the crew based on the type of work performed (e.g., paving, bridge, electrical, structural, painting, ferry operations).' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startDatetime rdf:type rdf:Property ;
    rdfs:label 'Start Datetime' ;
    rdfs:comment 'Date and time when the crew began work on this work order. Precise timestamp of work commencement.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:endDatetime rdf:type rdf:Property ;
    rdfs:label 'End Datetime' ;
    rdfs:comment 'Date and time when the crew completed or stopped work on this work order. Precise timestamp of work completion or cessation.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shiftDurationHours rdf:type rdf:Property ;
    rdfs:label 'Shift Duration Hours' ;
    rdfs:comment 'Total duration of the work shift in hours, calculated from shift start and end times.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Actual Hours Worked' ;
    rdfs:comment 'Actual number of hours worked by the employee during this crew assignment. Individual employee hours as opposed to aggregate crew hours.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ferryRoute rdf:type rdf:Property ;
    rdfs:label 'Ferry Route' ;
    rdfs:comment 'Designated ferry route name or identifier for crew assignments related to ferry operations.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vesselName rdf:type rdf:Property ;
    rdfs:label 'Vessel Name' ;
    rdfs:comment 'Name of the ferry vessel to which crew members are assigned for ferry operations.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentAssigned rdf:type rdf:Property ;
    rdfs:label 'Equipment Assigned' ;
    rdfs:comment 'Description or identifier of equipment, vehicles, or machinery assigned to the crew for this work assignment.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleNumber rdf:type rdf:Property ;
    rdfs:label 'Vehicle Number' ;
    rdfs:comment 'NCDOT fleet vehicle number or identifier for the vehicle assigned to the crew for this work assignment.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned By Employee Id' ;
    rdfs:comment 'Employee ID of the maintenance supervisor or dispatcher who created or authorized this crew assignment.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:payRate rdf:type rdf:Property ;
    rdfs:label 'Pay Rate' ;
    rdfs:comment 'Hourly pay rate for the employee during this crew assignment. Confidential compensation information.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workOrderDescription rdf:type rdf:Property ;
    rdfs:label 'Work Order Description' ;
    rdfs:comment 'Detailed description of the work order or activity to which the crew is assigned.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyBriefingCompleted rdf:type rdf:Property ;
    rdfs:label 'Safety Briefing Completed' ;
    rdfs:comment 'Indicator of whether the required safety briefing was completed before the crew began work on this assignment.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes' ;
    rdfs:comment 'Free-text notes or comments related to the crew assignment, including special instructions, observations, or issues.' ;
    rdfs:domain ind:CrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionTeamMembers rdf:type rdf:Property ;
    rdfs:label 'Inspection Team Members' ;
    rdfs:comment 'Names of additional team members who participated in the inspection. Documents the full inspection team composition for accountability and quality assurance purposes.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionOrganization rdf:type rdf:Property ;
    rdfs:label 'Inspection Organization' ;
    rdfs:comment 'The name of the organization or contractor that performed the inspection. Identifies whether the inspection was conducted by NCDOT staff or an external contractor.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deckGeometryRating rdf:type rdf:Property ;
    rdfs:label 'Deck Geometry Rating' ;
    rdfs:comment 'NBIS rating for deck geometry adequacy on a scale of 0-9. Evaluates whether the deck width, alignment, and geometry meet current standards.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:underclearanceVerticalFeet rdf:type rdf:Property ;
    rdfs:label 'Underclearance Vertical Feet' ;
    rdfs:comment 'Minimum vertical clearance under the bridge in feet. Critical for determining whether vehicles or vessels can safely pass under the structure.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underclearanceHorizontalFeet rdf:type rdf:Property ;
    rdfs:label 'Underclearance Horizontal Feet' ;
    rdfs:comment 'Minimum horizontal clearance under the bridge in feet. Measures the width available for traffic or waterway passage beneath the bridge.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterwayAdequacyRating rdf:type rdf:Property ;
    rdfs:label 'Waterway Adequacy Rating' ;
    rdfs:comment 'NBIS rating for waterway adequacy on a scale of 0-9. Assesses whether the waterway opening is sufficient to pass expected flood flows without causing excessive backwater.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approachRoadwayAlignmentRating rdf:type rdf:Property ;
    rdfs:label 'Approach Roadway Alignment Rating' ;
    rdfs:comment 'NBIS rating for approach roadway alignment on a scale of 0-9. Evaluates the adequacy of roadway alignment leading to and from the bridge.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scourCriticalIndicator rdf:type rdf:Property ;
    rdfs:label 'Scour Critical Indicator' ;
    rdfs:comment 'Indicator of scour criticality: Y (scour critical), N (not scour critical), U (unknown), or T (scour critical with temporary monitoring). Identifies bridges at risk of foundation failure due to scour.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scourConditionRating rdf:type rdf:Property ;
    rdfs:label 'Scour Condition Rating' ;
    rdfs:comment 'Rating of scour condition at bridge foundations on a scale of 0-9. Assesses the current state of scour at piers and abutments.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scourVulnerabilityDescription rdf:type rdf:Property ;
    rdfs:label 'Scour Vulnerability Description' ;
    rdfs:comment 'Detailed description of scour vulnerability, observed scour conditions, and any countermeasures in place. Documents scour risk assessment and mitigation measures.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fractureCriticalIndicator rdf:type rdf:Property ;
    rdfs:label 'Fracture Critical Indicator' ;
    rdfs:comment 'Indicates whether the bridge contains fracture critical members (FCM) that require special inspection. True if the bridge has tension members whose failure would cause collapse.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fractureCriticalDetails rdf:type rdf:Property ;
    rdfs:label 'Fracture Critical Details' ;
    rdfs:comment 'Detailed description of fracture critical members, their location, condition, and any findings from hands-on inspection of FCM components.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwaterInspectionIndicator rdf:type rdf:Property ;
    rdfs:label 'Underwater Inspection Indicator' ;
    rdfs:comment 'Indicates whether an underwater inspection was performed as part of this inspection event. True if submerged portions of the bridge were inspected.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwaterInspectionMethod rdf:type rdf:Property ;
    rdfs:label 'Underwater Inspection Method' ;
    rdfs:comment 'Method used for underwater inspection (e.g., diver inspection, remote operated vehicle, sonar). Documents the technique used to inspect submerged bridge components.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwaterFindings rdf:type rdf:Property ;
    rdfs:label 'Underwater Findings' ;
    rdfs:comment 'Detailed findings from underwater inspection, including condition of submerged piers, footings, scour conditions, and debris accumulation below the waterline.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedLoadLimitTons rdf:type rdf:Property ;
    rdfs:label 'Posted Load Limit Tons' ;
    rdfs:comment 'Maximum vehicle weight limit in tons if the bridge is posted for load restrictions. Specifies the maximum safe vehicle weight allowed on the bridge.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defectCodePrimary rdf:type rdf:Property ;
    rdfs:label 'Defect Code Primary' ;
    rdfs:comment 'Primary defect code identifying the most significant defect observed during inspection. Uses standardized defect coding system for classification.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectCodeSecondary rdf:type rdf:Property ;
    rdfs:label 'Defect Code Secondary' ;
    rdfs:comment 'Secondary defect code identifying additional significant defects observed during inspection. Captures the second most critical defect.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Defect Location Description' ;
    rdfs:comment 'Detailed description of the location of observed defects on the bridge structure, including span number, member identification, and specific location details.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectSeverity rdf:type rdf:Property ;
    rdfs:label 'Defect Severity' ;
    rdfs:comment 'Severity classification of the primary defect: minor, moderate, severe, or critical. Indicates the urgency and impact of the identified defect.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectExtentDescription rdf:type rdf:Property ;
    rdfs:label 'Defect Extent Description' ;
    rdfs:comment 'Description of the extent or spread of the defect across the structure, including measurements, affected area, and progression since previous inspection.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corrosionObservedIndicator rdf:type rdf:Property ;
    rdfs:label 'Corrosion Observed Indicator' ;
    rdfs:comment 'Indicates whether corrosion was observed during the inspection on steel or reinforced concrete elements. True if corrosion is present.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:corrosionSeverity rdf:type rdf:Property ;
    rdfs:label 'Corrosion Severity' ;
    rdfs:comment 'Severity of observed corrosion: none, light, moderate, severe, or critical. Classifies the extent and impact of corrosion on structural members.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crackingObservedIndicator rdf:type rdf:Property ;
    rdfs:label 'Cracking Observed Indicator' ;
    rdfs:comment 'Indicates whether cracking was observed in structural members during the inspection. True if cracks are present in concrete or steel components.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crackingType rdf:type rdf:Property ;
    rdfs:label 'Cracking Type' ;
    rdfs:comment 'Type of cracking observed: flexural, shear, fatigue, thermal, shrinkage, or other. Classifies the crack type to determine cause and structural significance.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spallingObservedIndicator rdf:type rdf:Property ;
    rdfs:label 'Spalling Observed Indicator' ;
    rdfs:comment 'Indicates whether concrete spalling was observed during the inspection. True if concrete surface deterioration with loss of material is present.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delaminationObservedIndicator rdf:type rdf:Property ;
    rdfs:label 'Delamination Observed Indicator' ;
    rdfs:comment 'Indicates whether concrete delamination was observed during the inspection. True if separation of concrete layers is detected.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementObservedIndicator rdf:type rdf:Property ;
    rdfs:label 'Settlement Observed Indicator' ;
    rdfs:comment 'Indicates whether foundation or approach settlement was observed during the inspection. True if vertical displacement of foundations or approaches is detected.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementMeasurementInches rdf:type rdf:Property ;
    rdfs:label 'Settlement Measurement Inches' ;
    rdfs:comment 'Measured settlement in inches, if applicable. Quantifies the amount of vertical displacement observed at foundations or approaches.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alignmentDeviationObservedIndicator rdf:type rdf:Property ;
    rdfs:label 'Alignment Deviation Observed Indicator' ;
    rdfs:comment 'Indicates whether structural alignment deviation was observed during the inspection. True if horizontal or vertical misalignment is detected.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:debrisAccumulationIndicator rdf:type rdf:Property ;
    rdfs:label 'Debris Accumulation Indicator' ;
    rdfs:comment 'Indicates whether debris accumulation was observed at the bridge, particularly at piers or in the waterway. True if debris is present.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:debrisDescription rdf:type rdf:Property ;
    rdfs:label 'Debris Description' ;
    rdfs:comment 'Description of debris accumulation, including location, type of debris, and potential impact on bridge hydraulics or structural integrity.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vegetationGrowthIndicator rdf:type rdf:Property ;
    rdfs:label 'Vegetation Growth Indicator' ;
    rdfs:comment 'Indicates whether vegetation growth was observed on the bridge structure or approaches. True if vegetation is present that may affect drainage or structural integrity.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paintCoatingCondition rdf:type rdf:Property ;
    rdfs:label 'Paint Coating Condition' ;
    rdfs:comment 'Condition of protective paint or coating on steel members: excellent, good, fair, poor, or failed. Assesses the effectiveness of corrosion protection systems.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bearingConditionRating rdf:type rdf:Property ;
    rdfs:label 'Bearing Condition Rating' ;
    rdfs:comment 'Condition rating for bridge bearings on a scale of 0-9. Evaluates the condition and functionality of bearing assemblies that support the superstructure.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expansionJointConditionRating rdf:type rdf:Property ;
    rdfs:label 'Expansion Joint Condition Rating' ;
    rdfs:comment 'Condition rating for expansion joints on a scale of 0-9. Assesses the condition of joints that accommodate bridge movement due to temperature and loading.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:railingConditionRating rdf:type rdf:Property ;
    rdfs:label 'Railing Condition Rating' ;
    rdfs:comment 'Condition rating for bridge railings on a scale of 0-9. Evaluates the condition and safety adequacy of bridge railings and barriers.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lightingConditionRating rdf:type rdf:Property ;
    rdfs:label 'Lighting Condition Rating' ;
    rdfs:comment 'Condition rating for bridge lighting systems on a scale of 0-9. Assesses the condition and functionality of bridge lighting infrastructure.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drainageConditionRating rdf:type rdf:Property ;
    rdfs:label 'Drainage Condition Rating' ;
    rdfs:comment 'Condition rating for bridge drainage systems on a scale of 0-9. Evaluates the condition and effectiveness of deck drainage and scupper systems.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendedAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Action' ;
    rdfs:comment 'Primary recommended action based on inspection findings: monitor, repair, rehabilitate, replace, or close. Specifies the recommended response to inspection findings.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedActionPriority rdf:type rdf:Property ;
    rdfs:label 'Recommended Action Priority' ;
    rdfs:comment 'Priority level for the recommended action: low, medium, high, or critical. Indicates the urgency of implementing the recommended action.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedActionDescription rdf:type rdf:Property ;
    rdfs:label 'Recommended Action Description' ;
    rdfs:comment 'Detailed description of the recommended action, including scope of work, specific repairs needed, and justification based on inspection findings.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyConcernIndicator rdf:type rdf:Property ;
    rdfs:label 'Safety Concern Indicator' ;
    rdfs:comment 'Indicates whether immediate safety concerns were identified during the inspection. True if conditions pose an immediate risk to public safety.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyConcernDescription rdf:type rdf:Property ;
    rdfs:label 'Safety Concern Description' ;
    rdfs:comment 'Detailed description of any immediate safety concerns identified during inspection, including nature of the hazard and recommended immediate actions.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyNotificationRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Emergency Notification Required Indicator' ;
    rdfs:comment 'Indicates whether emergency notification to management or regulatory authorities is required based on critical findings. True if immediate escalation is needed.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadRestrictionRecommendedIndicator rdf:type rdf:Property ;
    rdfs:label 'Load Restriction Recommended Indicator' ;
    rdfs:comment 'Indicates whether load restrictions are recommended based on inspection findings and structural capacity analysis. True if posting is recommended.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closureRecommendedIndicator rdf:type rdf:Property ;
    rdfs:label 'Closure Recommended Indicator' ;
    rdfs:comment 'Indicates whether bridge closure is recommended based on critical structural deficiencies or safety concerns. True if closure is recommended.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:photoDocumentationIndicator rdf:type rdf:Property ;
    rdfs:label 'Photo Documentation Indicator' ;
    rdfs:comment 'Indicates whether photographic documentation was captured during the inspection. True if photos were taken to document conditions.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionReportNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Number' ;
    rdfs:comment 'Unique report number or document identifier for the formal inspection report. Links the database record to the official inspection report document.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionReportDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Date' ;
    rdfs:comment 'Date on which the formal inspection report was completed and finalized. May differ from the inspection date if report preparation takes time.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionDurationHours rdf:type rdf:Property ;
    rdfs:label 'Inspection Duration Hours' ;
    rdfs:comment 'Total duration of the inspection in hours, from start to completion of field work. Used for resource planning and cost tracking.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trafficControlRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Required Indicator' ;
    rdfs:comment 'Indicates whether traffic control measures were required to safely conduct the inspection. True if lane closures or traffic management was needed.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Compliance Status' ;
    rdfs:comment 'Compliance status of the inspection relative to regulatory requirements and scheduled due dates: compliant, overdue, or early. Tracks adherence to inspection schedules.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Previous Inspection Date' ;
    rdfs:comment 'Date of the previous inspection for comparison and trend analysis. Enables tracking of condition changes over time.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionChangeSinceLastInspection rdf:type rdf:Property ;
    rdfs:label 'Condition Change Since Last Inspection' ;
    rdfs:comment 'Assessment of condition change since the previous inspection: improved, unchanged, deteriorated, or significantly deteriorated. Tracks condition trends.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bmsDataEntryDate rdf:type rdf:Property ;
    rdfs:label 'Bms Data Entry Date' ;
    rdfs:comment 'Date on which inspection data was entered into the Bridge Management System (BMS). Tracks data processing timeliness.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qaReviewRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Qa Review Required Indicator' ;
    rdfs:comment 'Indicates whether quality assurance review of the inspection is required based on bridge criticality or inspection findings. True if QA review is needed.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qaReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Qa Review Status' ;
    rdfs:comment 'Status of the quality assurance review: approved, approved with comments, rejected, or pending revision. Indicates QA outcome.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qaReviewComments rdf:type rdf:Property ;
    rdfs:label 'Qa Review Comments' ;
    rdfs:comment 'Comments from the quality assurance reviewer regarding inspection quality, findings, or required corrections. Documents QA feedback.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nbiSubmittalIndicator rdf:type rdf:Property ;
    rdfs:label 'Nbi Submittal Indicator' ;
    rdfs:comment 'Indicates whether this inspection data was submitted to the National Bridge Inventory (NBI) database. True if data was reported to FHWA.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nbiSubmittalDate rdf:type rdf:Property ;
    rdfs:label 'Nbi Submittal Date' ;
    rdfs:comment 'Date on which inspection data was submitted to the National Bridge Inventory. Tracks federal reporting compliance.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectFundingId rdf:type rdf:Property ;
    rdfs:label 'Project Funding Id' ;
    rdfs:comment 'Unique identifier for each project funding allocation record. Primary key for the project_funding association.' ;
    rdfs:domain ind:ProjectFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundingPhase rdf:type rdf:Property ;
    rdfs:label 'Funding Phase' ;
    rdfs:comment 'The specific project phase for which this funding is allocated (e.g., preliminary engineering, right-of-way acquisition, construction, environmental studies).' ;
    rdfs:domain ind:ProjectFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentageAllocated rdf:type rdf:Property ;
    rdfs:label 'Percentage Allocated' ;
    rdfs:comment 'The percentage of the total funding allocation or total project cost that this specific fund-to-project allocation represents.' ;
    rdfs:domain ind:ProjectFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Effective Date' ;
    rdfs:comment 'The date from which this fund-to-project allocation becomes active and available for obligation or expenditure.' ;
    rdfs:domain ind:ProjectFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Expiration Date' ;
    rdfs:comment 'The date after which this fund-to-project allocation is no longer valid or available for obligation, requiring reallocation or extension.' ;
    rdfs:domain ind:ProjectFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vehicleClassId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class Id' ;
    rdfs:comment 'Foreign key linking to dmv.vehicle_class. Business justification: Registration fee calculation and eligibility rules depend on vehicle classification. Adding vehicle_class_id FK allows direct access to classification rules, fee structures, and registration requireme' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VehicleClass .

ind:tollRouteId rdf:type rdf:Property ;
    rdfs:label 'Toll Route Id' ;
    rdfs:comment 'Primary key for toll_route' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TollRoute .

ind:tollAccountId rdf:type rdf:Property ;
    rdfs:label 'Toll Account Id' ;
    rdfs:comment 'Primary key for toll_account' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distanceNauticalMiles rdf:type rdf:Property ;
    rdfs:label 'Distance Nautical Miles' ;
    rdfs:comment 'Total distance of the ferry route measured in nautical miles from origin to destination terminal.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCrossingTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Crossing Time Minutes' ;
    rdfs:comment 'Standard estimated time in minutes for a ferry to complete the route under normal operating conditions.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceFrequency rdf:type rdf:Property ;
    rdfs:label 'Service Frequency' ;
    rdfs:comment 'Frequency pattern of ferry service on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalStartDate rdf:type rdf:Property ;
    rdfs:label 'Seasonal Start Date' ;
    rdfs:comment 'Start date for seasonal ferry routes. Null for year-round routes.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seasonalEndDate rdf:type rdf:Property ;
    rdfs:label 'Seasonal End Date' ;
    rdfs:comment 'End date for seasonal ferry routes. Null for year-round routes.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumVesselCapacityVehicles rdf:type rdf:Property ;
    rdfs:label 'Maximum Vessel Capacity Vehicles' ;
    rdfs:comment 'Maximum number of vehicles that can be accommodated on the largest vessel assigned to this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumVesselCapacityPassengers rdf:type rdf:Property ;
    rdfs:label 'Maximum Vessel Capacity Passengers' ;
    rdfs:comment 'Maximum number of passengers that can be accommodated on the largest vessel assigned to this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tollRequired rdf:type rdf:Property ;
    rdfs:label 'Toll Required' ;
    rdfs:comment 'Indicates whether a toll or fare is required for passengers or vehicles using this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reservationAvailable rdf:type rdf:Property ;
    rdfs:label 'Reservation Available' ;
    rdfs:comment 'Indicates whether advance reservations are available for this ferry route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adaAccessible rdf:type rdf:Property ;
    rdfs:label 'Ada Accessible' ;
    rdfs:comment 'Indicates whether the route is served by vessels that are fully accessible to passengers with disabilities in compliance with ADA requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatAllowed rdf:type rdf:Property ;
    rdfs:label 'Hazmat Allowed' ;
    rdfs:comment 'Indicates whether vehicles carrying hazardous materials are permitted on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialVehicleAllowed rdf:type rdf:Property ;
    rdfs:label 'Commercial Vehicle Allowed' ;
    rdfs:comment 'Indicates whether commercial vehicles such as trucks and buses are permitted on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oversizedVehicleAllowed rdf:type rdf:Property ;
    rdfs:label 'Oversized Vehicle Allowed' ;
    rdfs:comment 'Indicates whether oversized vehicles exceeding standard dimensions are permitted on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumVehicleLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Maximum Vehicle Length Feet' ;
    rdfs:comment 'Maximum length in feet for vehicles permitted on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumVehicleWeightTons rdf:type rdf:Property ;
    rdfs:label 'Maximum Vehicle Weight Tons' ;
    rdfs:comment 'Maximum weight in tons for vehicles permitted on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingAuthority rdf:type rdf:Property ;
    rdfs:label 'Operating Authority' ;
    rdfs:comment 'Name of the division or authority within NCDOT responsible for operating this ferry route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coastGuardApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Coast Guard Approval Number' ;
    rdfs:comment 'US Coast Guard approval or certification number for the ferry route if required for regulatory compliance.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilityCoordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Utility Coordination Required' ;
    rdfs:comment 'Indicates whether utility relocation or coordination is required for the work package.' ;
    rdfs:domain ind:WorkPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hicamsId rdf:type rdf:Property ;
    rdfs:label 'Hicams Id' ;
    rdfs:comment 'Unique identifier in the HiCAMS system for construction administration tracking.' ;
    rdfs:domain ind:WorkPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runNumber rdf:type rdf:Property ;
    rdfs:label 'Run Number' ;
    rdfs:comment 'Human-readable unique payment run number following the format PR followed by 8 digits (e.g., PR20240315). Used for business reference and tracking.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runDate rdf:type rdf:Property ;
    rdfs:label 'Run Date' ;
    rdfs:comment 'The date when the payment run was executed. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Total Payment Amount' ;
    rdfs:comment 'The total monetary amount of all payments included in this payment run, in US dollars.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentCount rdf:type rdf:Property ;
    rdfs:label 'Payment Count' ;
    rdfs:comment 'The total number of individual payment transactions included in this payment run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentProgram rdf:type rdf:Property ;
    rdfs:label 'Payment Program' ;
    rdfs:comment 'The SAP payment program or batch job identifier used to execute this payment run (e.g., F110 automatic payment program).' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountId rdf:type rdf:Property ;
    rdfs:label 'Bank Account Id' ;
    rdfs:comment 'The identifier for the NCDOT bank account from which payments in this run are disbursed.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:proposalRunDate rdf:type rdf:Property ;
    rdfs:label 'Proposal Run Date' ;
    rdfs:comment 'The date when the payment proposal was generated prior to final execution. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:executionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution Timestamp' ;
    rdfs:comment 'The precise date and time when the payment run execution was initiated. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processingDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Processing Duration Seconds' ;
    rdfs:comment 'The total time in seconds taken to execute and complete the payment run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:successfulPaymentCount rdf:type rdf:Property ;
    rdfs:label 'Successful Payment Count' ;
    rdfs:comment 'The number of individual payments that were successfully processed in this payment run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:failedPaymentCount rdf:type rdf:Property ;
    rdfs:label 'Failed Payment Count' ;
    rdfs:comment 'The number of individual payments that failed during this payment run execution.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentFileName rdf:type rdf:Property ;
    rdfs:label 'Payment File Name' ;
    rdfs:comment 'The name of the payment file or batch file generated by this payment run for transmission to the bank or payment processor.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentFilePath rdf:type rdf:Property ;
    rdfs:label 'Payment File Path' ;
    rdfs:comment 'The file system path or storage location where the payment file was saved.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Transmission Status' ;
    rdfs:comment 'The status of the payment file transmission to the bank or payment processor (e.g., not transmitted, transmitted, acknowledged, rejected, pending).' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transmission Timestamp' ;
    rdfs:comment 'The precise date and time when the payment file was transmitted to the bank or payment processor. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:routeClass rdf:type rdf:Property ;
    rdfs:label 'Route Class' ;
    rdfs:comment 'Maintenance classification level indicating priority and resource allocation for maintenance activities (primary, secondary, tertiary).' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeDirection rdf:type rdf:Property ;
    rdfs:label 'Route Direction' ;
    rdfs:comment 'Primary directional orientation of the route for navigation and maintenance planning purposes.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Total Length Miles' ;
    rdfs:comment 'Total length of the route measured in miles. Calculated as the difference between end and begin mileposts.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maintenanceDivision rdf:type rdf:Property ;
    rdfs:label 'Maintenance Division' ;
    rdfs:comment 'NCDOT division number responsible for the route. Higher-level organizational unit above maintenance district.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:truckRouteFlag rdf:type rdf:Property ;
    rdfs:label 'Truck Route Flag' ;
    rdfs:comment 'Indicates whether the route is designated for commercial truck traffic. Affects pavement maintenance frequency and winter weather priority.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:snowPriorityLevel rdf:type rdf:Property ;
    rdfs:label 'Snow Priority Level' ;
    rdfs:comment 'Winter weather operations priority level for snow and ice removal. Priority 1 routes are cleared first during winter weather events.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageDailyTraffic rdf:type rdf:Property ;
    rdfs:label 'Average Daily Traffic' ;
    rdfs:comment 'Average number of vehicles per day traveling on the route. Key metric for maintenance planning and resource allocation.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nationalHighwaySystemFlag rdf:type rdf:Property ;
    rdfs:label 'National Highway System Flag' ;
    rdfs:comment 'Indicates whether the route is part of the National Highway System. NHS routes receive federal funding and have specific maintenance standards.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:strategicHighwayNetworkFlag rdf:type rdf:Property ;
    rdfs:label 'Strategic Highway Network Flag' ;
    rdfs:comment 'Indicates whether the route is part of the Strategic Highway Network for national defense purposes. Affects maintenance standards and emergency response protocols.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hurricaneEvacuationRouteFlag rdf:type rdf:Property ;
    rdfs:label 'Hurricane Evacuation Route Flag' ;
    rdfs:comment 'Indicates whether the route is designated as a hurricane evacuation route. These routes receive priority maintenance and emergency response during hurricane events.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taskListType rdf:type rdf:Property ;
    rdfs:label 'Task List Type' ;
    rdfs:comment 'Classification of the task list indicating the category of maintenance or operational activity it represents.' ;
    rdfs:domain ind:TaskList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taskListCode rdf:type rdf:Property ;
    rdfs:label 'Task List Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the task list for reference and lookup purposes in SAP PM and other operational systems.' ;
    rdfs:domain ind:TaskList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCenterCode rdf:type rdf:Property ;
    rdfs:label 'Work Center Code' ;
    rdfs:comment 'Code identifying the primary work center or maintenance facility responsible for executing tasks in this task list.' ;
    rdfs:domain ind:TaskList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentCategory rdf:type rdf:Property ;
    rdfs:label 'Equipment Category' ;
    rdfs:comment 'Category of transportation infrastructure or equipment that this task list applies to.' ;
    rdfs:domain ind:TaskList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewSizeRequired rdf:type rdf:Property ;
    rdfs:label 'Crew Size Required' ;
    rdfs:comment 'Number of personnel required to safely and efficiently execute the task list.' ;
    rdfs:domain ind:TaskList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalApplicability rdf:type rdf:Property ;
    rdfs:label 'Seasonal Applicability' ;
    rdfs:comment 'Indicates the season(s) during which this task list is typically applicable or most effective.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialsRequired rdf:type rdf:Property ;
    rdfs:label 'Materials Required' ;
    rdfs:comment 'Description of standard materials, supplies, and consumables typically required to complete the task list.' ;
    rdfs:domain ind:TaskList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityRating rdf:type rdf:Property ;
    rdfs:label 'Capacity Rating' ;
    rdfs:comment 'Operational capacity rating of the work center measured in standard work hours per day or crew equivalents.' ;
    rdfs:domain ind:WorkCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operates247 rdf:type rdf:Property ;
    rdfs:label 'Operates 24 7' ;
    rdfs:comment 'Indicates whether the work center operates continuously 24 hours per day, 7 days per week (typical for emergency response centers).' ;
    rdfs:domain ind:WorkCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilitySizeSqft rdf:type rdf:Property ;
    rdfs:label 'Facility Size Sqft' ;
    rdfs:comment 'Total building and covered area of the work center facility measured in square feet.' ;
    rdfs:domain ind:WorkCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yardSizeAcres rdf:type rdf:Property ;
    rdfs:label 'Yard Size Acres' ;
    rdfs:comment 'Total outdoor yard and storage area of the work center measured in acres.' ;
    rdfs:domain ind:WorkCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equipmentStorageCapacity rdf:type rdf:Property ;
    rdfs:label 'Equipment Storage Capacity' ;
    rdfs:comment 'Maximum number of equipment units that can be stored at the work center facility.' ;
    rdfs:domain ind:WorkCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:materialStorageCapacityTons rdf:type rdf:Property ;
    rdfs:label 'Material Storage Capacity Tons' ;
    rdfs:comment 'Maximum material storage capacity measured in tons, typically for aggregates, salt, and other bulk materials used in maintenance operations.' ;
    rdfs:domain ind:WorkCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelFacilityAvailable rdf:type rdf:Property ;
    rdfs:label 'Fuel Facility Available' ;
    rdfs:comment 'Indicates whether the work center has on-site fuel storage and dispensing facilities for fleet vehicles.' ;
    rdfs:domain ind:WorkCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionId rdf:type rdf:Property ;
    rdfs:label 'Transaction Id' ;
    rdfs:comment 'Unique identifier of the business transaction or event being audited. Links to the source transaction in the operational system.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Type of business entity or object being audited (e.g., GL_ACCOUNT, COST_CENTER, BUDGET_LINE, VENDOR, EMPLOYEE).' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityId rdf:type rdf:Property ;
    rdfs:label 'Entity Id' ;
    rdfs:comment 'Unique identifier of the specific entity instance being audited within the entity type.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Action Timestamp' ;
    rdfs:comment 'Date and time when the audited action was performed. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:userId rdf:type rdf:Property ;
    rdfs:label 'User Id' ;
    rdfs:comment 'System user identifier of the person who performed the audited action.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userName rdf:type rdf:Property ;
    rdfs:label 'User Name' ;
    rdfs:comment 'Full name of the user who performed the audited action.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userRole rdf:type rdf:Property ;
    rdfs:label 'User Role' ;
    rdfs:comment 'Role or authorization level of the user at the time the action was performed (e.g., Accountant, Budget Manager, Approver, System Administrator).' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceModule rdf:type rdf:Property ;
    rdfs:label 'Source Module' ;
    rdfs:comment 'Specific module or component within the source system (e.g., SAP FI, SAP CO, NCFS GL, Beacon Budget).' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oldValue rdf:type rdf:Property ;
    rdfs:label 'Old Value' ;
    rdfs:comment 'Previous value of the field or attribute before the change was made. Null for create actions.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newValue rdf:type rdf:Property ;
    rdfs:label 'New Value' ;
    rdfs:comment 'New value of the field or attribute after the change was made. Null for delete actions.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldName rdf:type rdf:Property ;
    rdfs:label 'Field Name' ;
    rdfs:comment 'Name of the specific field or attribute that was changed in the audited entity.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed textual explanation or justification for the audited action provided by the user.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverId rdf:type rdf:Property ;
    rdfs:label 'Approver Id' ;
    rdfs:comment 'System user identifier of the person who approved the transaction, if applicable.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionCode rdf:type rdf:Property ;
    rdfs:label 'Exception Code' ;
    rdfs:comment 'Code identifying any compliance exception or policy violation detected in the audited transaction.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionDescription rdf:type rdf:Property ;
    rdfs:label 'Exception Description' ;
    rdfs:comment 'Detailed description of the compliance exception or policy violation, if any.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoNumber rdf:type rdf:Property ;
    rdfs:label 'Photo Number' ;
    rdfs:comment 'Business-assigned unique photo number used for tracking and referencing photos across NCDOT systems. Typically follows NCDOT photo numbering conventions.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filePath rdf:type rdf:Property ;
    rdfs:label 'File Path' ;
    rdfs:comment 'Storage location path or URI where the photo file is stored in the document management system or cloud storage.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:captureDate rdf:type rdf:Property ;
    rdfs:label 'Capture Date' ;
    rdfs:comment 'Date when the photo was originally captured or taken.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:captureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Capture Timestamp' ;
    rdfs:comment 'Precise timestamp when the photo was captured, including time zone information. May be extracted from EXIF metadata.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:uploadDate rdf:type rdf:Property ;
    rdfs:label 'Upload Date' ;
    rdfs:comment 'Date when the photo was uploaded to the NCDOT system.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uploadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Upload Timestamp' ;
    rdfs:comment 'Precise timestamp when the photo was uploaded to the system, including time zone information.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:photographerName rdf:type rdf:Property ;
    rdfs:label 'Photographer Name' ;
    rdfs:comment 'Name of the person or entity who captured the photo. May be NCDOT staff, contractor, or automated system.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photographerOrganization rdf:type rdf:Property ;
    rdfs:label 'Photographer Organization' ;
    rdfs:comment 'Organization or company that the photographer represents (e.g., NCDOT division, contractor company).' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imageWidthPixels rdf:type rdf:Property ;
    rdfs:label 'Image Width Pixels' ;
    rdfs:comment 'Width of the photo image in pixels.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:imageHeightPixels rdf:type rdf:Property ;
    rdfs:label 'Image Height Pixels' ;
    rdfs:comment 'Height of the photo image in pixels.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resolutionDpi rdf:type rdf:Property ;
    rdfs:label 'Resolution Dpi' ;
    rdfs:comment 'Resolution of the photo in dots per inch (DPI), indicating image quality.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orientation rdf:type rdf:Property ;
    rdfs:label 'Orientation' ;
    rdfs:comment 'Orientation of the photo (landscape, portrait, or square).' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cameraMake rdf:type rdf:Property ;
    rdfs:label 'Camera Make' ;
    rdfs:comment 'Manufacturer of the camera or device used to capture the photo. May be extracted from EXIF metadata.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cameraModel rdf:type rdf:Property ;
    rdfs:label 'Camera Model' ;
    rdfs:comment 'Model of the camera or device used to capture the photo. May be extracted from EXIF metadata.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containsPii rdf:type rdf:Property ;
    rdfs:label 'Contains Pii' ;
    rdfs:comment 'Flag indicating whether the photo contains personally identifiable information such as faces, license plates, or other identifying information.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copyrightHolder rdf:type rdf:Property ;
    rdfs:label 'Copyright Holder' ;
    rdfs:comment 'Entity or individual holding copyright to the photo. Typically NCDOT for staff-captured photos.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageRights rdf:type rdf:Property ;
    rdfs:label 'Usage Rights' ;
    rdfs:comment 'Description of usage rights and restrictions for the photo (e.g., internal use only, public domain, licensed).' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionDate rdf:type rdf:Property ;
    rdfs:label 'Retention Date' ;
    rdfs:comment 'Date when the photo is scheduled for review or deletion based on NCDOT records retention policy.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:thumbnailPath rdf:type rdf:Property ;
    rdfs:label 'Thumbnail Path' ;
    rdfs:comment 'Storage location path or URI for the thumbnail version of the photo used for preview and quick loading.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checksum rdf:type rdf:Property ;
    rdfs:label 'Checksum' ;
    rdfs:comment 'Cryptographic hash or checksum of the photo file used to verify file integrity and detect tampering.' ;
    rdfs:domain ind:PhotoReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupName rdf:type rdf:Property ;
    rdfs:label 'Group Name' ;
    rdfs:comment 'Name of the organization, school, church, or group making the reservation.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateContactName rdf:type rdf:Property ;
    rdfs:label 'Alternate Contact Name' ;
    rdfs:comment 'Full name of the secondary contact person for the group reservation.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateContactPhone rdf:type rdf:Property ;
    rdfs:label 'Alternate Contact Phone' ;
    rdfs:comment 'Secondary phone number for the alternate group reservation contact.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departureTerminal rdf:type rdf:Property ;
    rdfs:label 'Departure Terminal' ;
    rdfs:comment 'Name of the ferry terminal where the group will board the vessel.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrivalTerminal rdf:type rdf:Property ;
    rdfs:label 'Arrival Terminal' ;
    rdfs:comment 'Name of the ferry terminal where the group will disembark from the vessel.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledReturnDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Return Date' ;
    rdfs:comment 'Date when the group is scheduled to return on the ferry (for round-trip reservations). Format: yyyy-MM-dd.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledReturnTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Return Time' ;
    rdfs:comment 'Time when the group is scheduled to return on the ferry (for round-trip reservations). Format: HH:mm (24-hour).' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tripType rdf:type rdf:Property ;
    rdfs:label 'Trip Type' ;
    rdfs:comment 'Indicates whether the group reservation is for a one-way or round-trip journey.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupType rdf:type rdf:Property ;
    rdfs:label 'Group Type' ;
    rdfs:comment 'Category of the group making the reservation (e.g., school field trip, church group, corporate event, tour operator).' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservationDate rdf:type rdf:Property ;
    rdfs:label 'Reservation Date' ;
    rdfs:comment 'Date when the group reservation was created or booked. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reservationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reservation Timestamp' ;
    rdfs:comment 'Precise date and time when the group reservation was created. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:confirmationDate rdf:type rdf:Property ;
    rdfs:label 'Confirmation Date' ;
    rdfs:comment 'Date when the group reservation was confirmed by ferry operations staff. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalFareAmount rdf:type rdf:Property ;
    rdfs:label 'Total Fare Amount' ;
    rdfs:comment 'Total fare amount charged for the group reservation in US dollars.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountApplied rdf:type rdf:Property ;
    rdfs:label 'Discount Applied' ;
    rdfs:comment 'Indicates whether a discount was applied to the group reservation fare.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vesselAssigned rdf:type rdf:Property ;
    rdfs:label 'Vessel Assigned' ;
    rdfs:comment 'Name of the specific ferry vessel assigned to transport the group.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddress rdf:type rdf:Property ;
    rdfs:label 'Billing Address' ;
    rdfs:comment 'Mailing address for billing purposes related to the group reservation.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationTaxId rdf:type rdf:Property ;
    rdfs:label 'Organization Tax Id' ;
    rdfs:comment 'Federal tax identification number (EIN) for the organization making the group reservation, if applicable.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advanceNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Advance Notice Days' ;
    rdfs:comment 'Number of days in advance the group reservation was made before the scheduled departure date.' ;
    rdfs:domain ind:GroupReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:checklistCode rdf:type rdf:Property ;
    rdfs:label 'Checklist Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the checklist type in operational systems and work orders.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Indicates whether this checklist is mandated by federal, state, or local regulations versus being an internal NCDOT quality standard.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCompletionTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Completion Time Minutes' ;
    rdfs:comment 'Average time in minutes required to complete all items on this checklist during a typical inspection or quality check.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiredCertifications rdf:type rdf:Property ;
    rdfs:label 'Required Certifications' ;
    rdfs:comment 'List of professional certifications, licenses, or training credentials required for personnel authorized to use this checklist.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalChecklistItems rdf:type rdf:Property ;
    rdfs:label 'Total Checklist Items' ;
    rdfs:comment 'Total number of individual inspection points, questions, or verification items included in this checklist.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criticalItemsCount rdf:type rdf:Property ;
    rdfs:label 'Critical Items Count' ;
    rdfs:comment 'Number of checklist items designated as critical or mandatory that must pass for overall checklist compliance.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supervisorReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Supervisor Review Required Flag' ;
    rdfs:comment 'Indicates whether completed checklists must be reviewed and approved by a supervisor or quality assurance manager.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableAssetTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Asset Types' ;
    rdfs:comment 'Types of transportation infrastructure assets (roadways, bridges, signs, signals, etc.) that this checklist can be applied to.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableWorkOrderTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Work Order Types' ;
    rdfs:comment 'SAP PM work order types or maintenance activity codes that should reference this checklist during execution.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicApplicability rdf:type rdf:Property ;
    rdfs:label 'Geographic Applicability' ;
    rdfs:comment 'Geographic scope or regions within North Carolina where this checklist applies, accounting for regional variations in maintenance practices.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByChecklistQaChecklistId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Checklist Qa Checklist Id' ;
    rdfs:comment 'Reference to the newer checklist version that replaces this one when status is superseded, maintaining version history.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QaChecklist .

ind:revisionNotes rdf:type rdf:Property ;
    rdfs:label 'Revision Notes' ;
    rdfs:comment 'Summary of changes, updates, or corrections made in this version compared to the previous version of the checklist.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingMaterialUrl rdf:type rdf:Property ;
    rdfs:label 'Training Material Url' ;
    rdfs:comment 'Web link to training materials, instructional videos, or documentation that explains how to properly use this checklist.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalFormAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Form Available Flag' ;
    rdfs:comment 'Indicates whether this checklist is available in a digital or mobile application format for field use.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paperFormRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Paper Form Required Flag' ;
    rdfs:comment 'Indicates whether a paper copy of the completed checklist must be retained for regulatory or archival purposes.' ;
    rdfs:domain ind:QaChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sampleNumber rdf:type rdf:Property ;
    rdfs:label 'Sample Number' ;
    rdfs:comment 'Human-readable unique sample number assigned by field personnel or laboratory for tracking and reference purposes.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleType rdf:type rdf:Property ;
    rdfs:label 'Sample Type' ;
    rdfs:comment 'Category of environmental sample collected indicating the medium or material being tested.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleMatrix rdf:type rdf:Property ;
    rdfs:label 'Sample Matrix' ;
    rdfs:comment 'Specific environmental matrix or substrate from which the sample was collected, providing detailed context for the sample type.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionDate rdf:type rdf:Property ;
    rdfs:label 'Collection Date' ;
    rdfs:comment 'Date when the environmental sample was physically collected from the field location.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Collection Timestamp' ;
    rdfs:comment 'Precise date and time when the sample was collected, critical for time-sensitive analyses and regulatory compliance.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:collectionLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Collection Location Description' ;
    rdfs:comment 'Detailed textual description of the physical location where the sample was collected, including landmarks and access information.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depthFeet rdf:type rdf:Property ;
    rdfs:label 'Depth Feet' ;
    rdfs:comment 'Depth below ground surface or water surface at which the sample was collected, measured in feet.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectorName rdf:type rdf:Property ;
    rdfs:label 'Collector Name' ;
    rdfs:comment 'Name of the individual or organization responsible for collecting the environmental sample.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectorOrganization rdf:type rdf:Property ;
    rdfs:label 'Collector Organization' ;
    rdfs:comment 'Organization or agency that collected the sample, such as NCDOT, consultant firm, or regulatory agency.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratorySampleCode rdf:type rdf:Property ;
    rdfs:label 'Laboratory Sample Code' ;
    rdfs:comment 'Unique identifier assigned by the analytical laboratory for internal tracking and reporting.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisRequested rdf:type rdf:Property ;
    rdfs:label 'Analysis Requested' ;
    rdfs:comment 'Description of the analytical tests or parameters requested for this sample, such as heavy metals, VOCs, or biological indicators.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryProgram rdf:type rdf:Property ;
    rdfs:label 'Regulatory Program' ;
    rdfs:comment 'Federal or state environmental regulatory program under which the sample is being collected, such as NEPA, Clean Water Act Section 404, or NPDES.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplePurpose rdf:type rdf:Property ;
    rdfs:label 'Sample Purpose' ;
    rdfs:comment 'Primary purpose or objective for collecting this environmental sample within the project lifecycle.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleStatus rdf:type rdf:Property ;
    rdfs:label 'Sample Status' ;
    rdfs:comment 'Current status of the sample in the collection, analysis, and reporting workflow.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preservationMethod rdf:type rdf:Property ;
    rdfs:label 'Preservation Method' ;
    rdfs:comment 'Method used to preserve the sample integrity during transport and storage prior to analysis.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containerType rdf:type rdf:Property ;
    rdfs:label 'Container Type' ;
    rdfs:comment 'Type of container used to store and transport the sample, which must be appropriate for the analysis requested.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleVolume rdf:type rdf:Property ;
    rdfs:label 'Sample Volume' ;
    rdfs:comment 'Volume of sample collected, typically measured in milliliters or liters for liquid samples.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sampleWeightGrams rdf:type rdf:Property ;
    rdfs:label 'Sample Weight Grams' ;
    rdfs:comment 'Weight of sample collected, measured in grams, typically for soil, sediment, or biological samples.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldObservations rdf:type rdf:Property ;
    rdfs:label 'Field Observations' ;
    rdfs:comment 'Notes and observations recorded by field personnel at the time of sample collection, including weather, site conditions, and anomalies.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedByLabDate rdf:type rdf:Property ;
    rdfs:label 'Received By Lab Date' ;
    rdfs:comment 'Date when the sample was received by the analytical laboratory.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:analysisStartDate rdf:type rdf:Property ;
    rdfs:label 'Analysis Start Date' ;
    rdfs:comment 'Date when laboratory analysis of the sample began.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:analysisCompleteDate rdf:type rdf:Property ;
    rdfs:label 'Analysis Complete Date' ;
    rdfs:comment 'Date when all requested laboratory analyses were completed for this sample.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdingTimeCompliant rdf:type rdf:Property ;
    rdfs:label 'Holding Time Compliant' ;
    rdfs:comment 'Indicates whether the sample was analyzed within the required holding time period specified by EPA methods.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityControlLevel rdf:type rdf:Property ;
    rdfs:label 'Quality Control Level' ;
    rdfs:comment 'Level of quality control and quality assurance applied to the sample collection and analysis process.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateSampleIndicator rdf:type rdf:Property ;
    rdfs:label 'Duplicate Sample Indicator' ;
    rdfs:comment 'Indicates whether this sample is a field duplicate collected for quality control purposes.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blankSampleIndicator rdf:type rdf:Property ;
    rdfs:label 'Blank Sample Indicator' ;
    rdfs:comment 'Indicates whether this is a blank sample (field blank, trip blank, or equipment blank) used for quality control.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinatingAgency rdf:type rdf:Property ;
    rdfs:label 'Coordinating Agency' ;
    rdfs:comment 'Primary federal or state agency coordinating the environmental review or permitting process for which this sample was collected, such as USACE, NCDEQ, or SHPO.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataUsability rdf:type rdf:Property ;
    rdfs:label 'Data Usability' ;
    rdfs:comment 'Assessment of whether the sample data meets quality standards and is suitable for its intended regulatory or decision-making purpose.' ;
    rdfs:domain ind:Sample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:year rdf:type rdf:Property ;
    rdfs:label 'Year' ;
    rdfs:comment 'Four-digit calendar year. Used for annual STIP/TIP programming cycles and fiscal year reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quarter rdf:type rdf:Property ;
    rdfs:label 'Quarter' ;
    rdfs:comment 'Calendar quarter number (1-4). Used for quarterly project delivery reporting and performance tracking.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:month rdf:type rdf:Property ;
    rdfs:label 'Month' ;
    rdfs:comment 'Calendar month number (1-12). Used for monthly project progress reporting and resource planning.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monthName rdf:type rdf:Property ;
    rdfs:label 'Month Name' ;
    rdfs:comment 'Full name of the calendar month. Used for human-readable reporting and dashboard displays.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weekOfYear rdf:type rdf:Property ;
    rdfs:label 'Week Of Year' ;
    rdfs:comment 'Week number within the calendar year (1-53). Used for weekly construction progress tracking and resource allocation.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayOfMonth rdf:type rdf:Property ;
    rdfs:label 'Day Of Month' ;
    rdfs:comment 'Day number within the month (1-31). Used for daily project activity scheduling and milestone tracking.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayName rdf:type rdf:Property ;
    rdfs:label 'Day Name' ;
    rdfs:comment 'Full name of the day of the week. Used for human-readable scheduling and reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dayOfYear rdf:type rdf:Property ;
    rdfs:label 'Day Of Year' ;
    rdfs:comment 'Sequential day number within the calendar year (1-366). Used for project duration calculations and timeline analytics.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'Fiscal quarter number (1-4) within the NC state fiscal year. Used for quarterly budget reviews and project funding analysis.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Month' ;
    rdfs:comment 'Fiscal month number (1-12) within the NC state fiscal year. Used for monthly financial reporting and budget tracking.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isWorkday rdf:type rdf:Property ;
    rdfs:label 'Is Workday' ;
    rdfs:comment 'Indicates whether the date is a standard NCDOT workday (excludes weekends and holidays). Used for construction scheduling and project duration calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWeekend rdf:type rdf:Property ;
    rdfs:label 'Is Weekend' ;
    rdfs:comment 'Indicates whether the date falls on a weekend (Saturday or Sunday). Used for scheduling and resource planning.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHoliday rdf:type rdf:Property ;
    rdfs:label 'Is Holiday' ;
    rdfs:comment 'Indicates whether the date is a recognized NC state or federal holiday. Used for project scheduling and workday calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holidayName rdf:type rdf:Property ;
    rdfs:label 'Holiday Name' ;
    rdfs:comment 'Name of the holiday if the date is a recognized holiday. Used for scheduling communications and project planning.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isStipCycleStart rdf:type rdf:Property ;
    rdfs:label 'Is Stip Cycle Start' ;
    rdfs:comment 'Indicates whether this date marks the beginning of a STIP programming cycle. Critical for multi-year transportation project planning and funding allocation.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFiscalYearStart rdf:type rdf:Property ;
    rdfs:label 'Is Fiscal Year Start' ;
    rdfs:comment 'Indicates whether this date is the start of the NC state fiscal year (July 1). Used for annual budget initialization and financial reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFiscalYearEnd rdf:type rdf:Property ;
    rdfs:label 'Is Fiscal Year End' ;
    rdfs:comment 'Indicates whether this date is the end of the NC state fiscal year (June 30). Used for year-end financial closeout and reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workdaysInMonth rdf:type rdf:Property ;
    rdfs:label 'Workdays In Month' ;
    rdfs:comment 'Total number of workdays in the calendar month. Used for resource planning, project scheduling, and productivity calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workdaysRemainingInMonth rdf:type rdf:Property ;
    rdfs:label 'Workdays Remaining In Month' ;
    rdfs:comment 'Number of workdays remaining in the month from this date. Used for project deadline tracking and resource allocation.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:constructionSeason rdf:type rdf:Property ;
    rdfs:label 'Construction Season' ;
    rdfs:comment 'Construction season classification based on weather and operational conditions. Used for project scheduling and construction activity planning in North Carolina climate.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLettingDate rdf:type rdf:Property ;
    rdfs:label 'Is Letting Date' ;
    rdfs:comment 'Indicates whether this date is a scheduled contract letting date. Used for bid solicitation scheduling and contract award planning.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBoardMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Is Board Meeting Date' ;
    rdfs:comment 'Indicates whether this date is a scheduled NC Board of Transportation meeting date. Used for project approval scheduling and decision milestone tracking.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originStation rdf:type rdf:Property ;
    rdfs:label 'Origin Station' ;
    rdfs:comment 'Name or identifier of the starting station or terminal for this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationStation rdf:type rdf:Property ;
    rdfs:label 'Destination Station' ;
    rdfs:comment 'Name or identifier of the ending station or terminal for this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Max Speed Mph' ;
    rdfs:comment 'Maximum authorized operating speed for trains on this route, measured in miles per hour, as determined by track class and operating rules.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gradeCrossingCount rdf:type rdf:Property ;
    rdfs:label 'Grade Crossing Count' ;
    rdfs:comment 'Total number of at-grade highway-rail crossings along this route requiring safety oversight and inspection.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:electrifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Electrified Flag' ;
    rdfs:comment 'Indicates whether the route has overhead catenary or third-rail electrification for electric train operations.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraReportingMark rdf:type rdf:Property ;
    rdfs:label 'Fra Reporting Mark' ;
    rdfs:comment 'Standard railroad reporting mark assigned by the FRA to identify the railroad operating or owning this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualTrafficVolumeTons rdf:type rdf:Property ;
    rdfs:label 'Annual Traffic Volume Tons' ;
    rdfs:comment 'Total annual freight tonnage transported on this route, used for infrastructure planning and maintenance scheduling.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workBreakdownStructureLevel rdf:type rdf:Property ;
    rdfs:label 'Work Breakdown Structure Level' ;
    rdfs:comment 'Hierarchical level of the activity within the project work breakdown structure. Level 1 represents top-level project phases, with increasing numbers indicating more detailed task decomposition.' ;
    rdfs:domain ind:Activity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:effortHours rdf:type rdf:Property ;
    rdfs:label 'Effort Hours' ;
    rdfs:comment 'Estimated labor effort required to complete the activity measured in person-hours. Used for resource allocation and cost estimation.' ;
    rdfs:domain ind:Activity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Estimate Amount' ;
    rdfs:comment 'Standard estimated cost for completing this activity in US dollars. Used for project budgeting and financial planning in STIP/TIP programming.' ;
    rdfs:domain ind:Activity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:predecessorDependencyType rdf:type rdf:Property ;
    rdfs:label 'Predecessor Dependency Type' ;
    rdfs:comment 'Standard dependency relationship type for this activity relative to predecessor activities in project schedules. Defines scheduling logic for activity sequencing.' ;
    rdfs:domain ind:Activity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapActivityType rdf:type rdf:Property ;
    rdfs:label 'Sap Activity Type' ;
    rdfs:comment 'SAP PS (Project System) activity type code used for integration with SAP financial and project management modules. Four-character alphanumeric code.' ;
    rdfs:domain ind:Activity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hicamsActivityCode rdf:type rdf:Property ;
    rdfs:label 'Hicams Activity Code' ;
    rdfs:comment 'Activity code used in the HiCAMS system for construction project tracking and management. Enables cross-system activity tracking between SAP PS and HiCAMS.' ;
    rdfs:domain ind:Activity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockNumber rdf:type rdf:Property ;
    rdfs:label 'Block Number' ;
    rdfs:comment 'The alphanumeric designation assigned to the railroad block for operational identification and communication purposes.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockName rdf:type rdf:Property ;
    rdfs:label 'Block Name' ;
    rdfs:comment 'The descriptive name of the railroad block, often referencing geographic location or landmarks for easy identification by rail personnel.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockType rdf:type rdf:Property ;
    rdfs:label 'Block Type' ;
    rdfs:comment 'The classification of the block system governing train movements. Automatic blocks use signals controlled by train detection; manual blocks require dispatcher authorization; absolute blocks prohibit multiple trains; permissive blocks allow following movements; dark territory has no signal system.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxSpeedFreightMph rdf:type rdf:Property ;
    rdfs:label 'Max Speed Freight Mph' ;
    rdfs:comment 'The maximum authorized speed in miles per hour for freight trains operating within the block, as determined by track class and operating rules.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxSpeedPassengerMph rdf:type rdf:Property ;
    rdfs:label 'Max Speed Passenger Mph' ;
    rdfs:comment 'The maximum authorized speed in miles per hour for passenger trains operating within the block, as determined by track class and operating rules.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ptcEquipped rdf:type rdf:Property ;
    rdfs:label 'Ptc Equipped' ;
    rdfs:comment 'Indicates whether the block is equipped with Positive Train Control technology, which automatically prevents train-to-train collisions, overspeed derailments, and unauthorized entry into work zones.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ptcSystemName rdf:type rdf:Property ;
    rdfs:label 'Ptc System Name' ;
    rdfs:comment 'The name or designation of the specific PTC system installed on the block, such as Interoperable Electronic Train Management System (I-ETMS) or Advanced Civil Speed Enforcement System (ACSES).' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatcherTerritory rdf:type rdf:Property ;
    rdfs:label 'Dispatcher Territory' ;
    rdfs:comment 'The dispatcher territory or desk responsible for controlling train movements within the block, used for operational coordination.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Descriptive name of the work zone identifying the location or project (e.g., \'Raleigh-Durham Rail Crossing Upgrade\', \'Charlotte Freight Corridor Maintenance\').' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneType rdf:type rdf:Property ;
    rdfs:label 'Zone Type' ;
    rdfs:comment 'Classification of the work zone activity type indicating the nature of rail work being performed.' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railroadCrossingId rdf:type rdf:Property ;
    rdfs:label 'Railroad Crossing Id' ;
    rdfs:comment 'Federal Railroad Administration crossing inventory number if the work zone is associated with a specific railroad crossing.' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railLineName rdf:type rdf:Property ;
    rdfs:label 'Rail Line Name' ;
    rdfs:comment 'Name of the rail line or corridor where the work zone is located (e.g., \'Piedmont Corridor\', \'Carolina Coastal Line\').' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railOperatorName rdf:type rdf:Property ;
    rdfs:label 'Rail Operator Name' ;
    rdfs:comment 'Name of the freight or passenger rail operator responsible for or affected by the work zone (e.g., \'Norfolk Southern\', \'CSX Transportation\', \'Amtrak\').' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficControlPlanRequired rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Plan Required' ;
    rdfs:comment 'Indicates whether a traffic control plan is required for the work zone due to impact on roadway traffic at rail crossings.' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flaggingRequired rdf:type rdf:Property ;
    rdfs:label 'Flagging Required' ;
    rdfs:comment 'Indicates whether rail flagging personnel are required to be present during work zone operations for safety compliance.' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trackClosureRequired rdf:type rdf:Property ;
    rdfs:label 'Track Closure Required' ;
    rdfs:comment 'Indicates whether the work zone requires complete closure of rail track during work activities.' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatPresent rdf:type rdf:Property ;
    rdfs:label 'Hazmat Present' ;
    rdfs:comment 'Indicates whether hazardous materials are present in or transported through the work zone, requiring special safety protocols.' ;
    rdfs:domain ind:WorkZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:routeStatus rdf:type rdf:Property ;
    rdfs:label 'Route Status' ;
    rdfs:comment 'Current operational status of the route indicating whether it is active, under construction, planned for future development, decommissioned, or temporarily closed.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyRouteFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Route Flag' ;
    rdfs:comment 'Indicates whether the route is designated as an emergency evacuation or response route. Critical for emergency management planning.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scenicBywayFlag rdf:type rdf:Property ;
    rdfs:label 'Scenic Byway Flag' ;
    rdfs:comment 'Indicates whether the route is designated as a scenic byway with special aesthetic, cultural, or recreational significance.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tollFacilityFlag rdf:type rdf:Property ;
    rdfs:label 'Toll Facility Flag' ;
    rdfs:comment 'Indicates whether the route includes toll collection facilities. True if tolled, false if free.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acquisitionStatus rdf:type rdf:Property ;
    rdfs:label 'Acquisition Status' ;
    rdfs:comment 'Status of right-of-way acquisition for the route. Indicates whether ROW has been fully acquired, is in progress, planned, not required, or partially complete.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapReModuleReference rdf:type rdf:Property ;
    rdfs:label 'Sap Re Module Reference' ;
    rdfs:comment 'Reference identifier linking this route to the SAP Real Estate module for property management, appraisals, and ROW transactions.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficCountYear rdf:type rdf:Property ;
    rdfs:label 'Traffic Count Year' ;
    rdfs:comment 'Year when the average daily traffic count was last measured or estimated. Ensures traffic data currency and reliability.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatorType rdf:type rdf:Property ;
    rdfs:label 'Operator Type' ;
    rdfs:comment 'Classification of the operating entity managing the toll route.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tollCollectionMethod rdf:type rdf:Property ;
    rdfs:label 'Toll Collection Method' ;
    rdfs:comment 'Primary method used for collecting tolls on the route.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transponderSystem rdf:type rdf:Property ;
    rdfs:label 'Transponder System' ;
    rdfs:comment 'Name of the electronic toll collection transponder system used (e.g., NC Quick Pass, E-ZPass).' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interoperabilityEnabled rdf:type rdf:Property ;
    rdfs:label 'Interoperability Enabled' ;
    rdfs:comment 'Indicates whether the toll route accepts transponders from other toll systems through interoperability agreements.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postedSpeedLimitMph rdf:type rdf:Property ;
    rdfs:label 'Posted Speed Limit Mph' ;
    rdfs:comment 'Legal maximum speed limit posted on the toll route, measured in miles per hour.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openingDate rdf:type rdf:Property ;
    rdfs:label 'Opening Date' ;
    rdfs:comment 'Date when the toll route was officially opened to traffic.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:concessionStartDate rdf:type rdf:Property ;
    rdfs:label 'Concession Start Date' ;
    rdfs:comment 'Date when the toll concession agreement became effective, if applicable.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:concessionEndDate rdf:type rdf:Property ;
    rdfs:label 'Concession End Date' ;
    rdfs:comment 'Date when the toll concession agreement expires and control reverts to the public authority, if applicable.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interchangeCount rdf:type rdf:Property ;
    rdfs:label 'Interchange Count' ;
    rdfs:comment 'Total number of interchanges providing access to and from the toll route.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tollPlazaCount rdf:type rdf:Property ;
    rdfs:label 'Toll Plaza Count' ;
    rdfs:comment 'Total number of toll collection plazas along the route.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itsEnabled rdf:type rdf:Property ;
    rdfs:label 'Its Enabled' ;
    rdfs:comment 'Indicates whether the toll route is equipped with intelligent transportation systems infrastructure for traffic management and monitoring.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:atmsIntegrated rdf:type rdf:Property ;
    rdfs:label 'Atms Integrated' ;
    rdfs:comment 'Indicates whether the toll route is integrated with the statewide or regional advanced traffic management system.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentManagementCoverage rdf:type rdf:Property ;
    rdfs:label 'Incident Management Coverage' ;
    rdfs:comment 'Indicates whether the toll route is covered by incident management programs such as IMAP (Incident Management Assistance Patrol).' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hovLanesPresent rdf:type rdf:Property ;
    rdfs:label 'Hov Lanes Present' ;
    rdfs:comment 'Indicates whether the toll route includes dedicated high occupancy vehicle lanes.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:truckRestrictions rdf:type rdf:Property ;
    rdfs:label 'Truck Restrictions' ;
    rdfs:comment 'Description of any weight, size, or operational restrictions applicable to commercial trucks on the toll route.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatRestrictions rdf:type rdf:Property ;
    rdfs:label 'Hazmat Restrictions' ;
    rdfs:comment 'Description of any restrictions on the transport of hazardous materials on the toll route.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalMitigationFeatures rdf:type rdf:Property ;
    rdfs:label 'Environmental Mitigation Features' ;
    rdfs:comment 'Description of environmental protection or mitigation features implemented along the toll route (e.g., wildlife crossings, stormwater management).' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualVmt rdf:type rdf:Property ;
    rdfs:label 'Annual Vmt' ;
    rdfs:comment 'Total vehicle miles traveled annually on the toll route, calculated as AADT multiplied by route length and days in year.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gisRouteId rdf:type rdf:Property ;
    rdfs:label 'Gis Route Id' ;
    rdfs:comment 'Unique identifier used in the geographic information system for spatial referencing and mapping of the toll route.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Route .

ind:mutcdComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Mutcd Compliance Status' ;
    rdfs:comment 'Current compliance status of traffic control devices on the toll route with MUTCD standards.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyAccessPoints rdf:type rdf:Property ;
    rdfs:label 'Emergency Access Points' ;
    rdfs:comment 'Number of designated emergency vehicle access points along the toll route.' ;
    rdfs:domain ind:TollRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:compassBearing rdf:type rdf:Property ;
    rdfs:label 'Compass Bearing' ;
    rdfs:comment 'Numeric compass bearing in degrees (0-360) representing the direction. 0/360 = North, 90 = East, 180 = South, 270 = West. Used for precise geographic orientation in GIS and route planning systems.' ;
    rdfs:domain ind:Direction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gtfsDirectionId rdf:type rdf:Property ;
    rdfs:label 'Gtfs Direction Id' ;
    rdfs:comment 'GTFS-compliant direction identifier used in transit feed specifications. Binary value where 0 typically represents one direction (e.g., outbound) and 1 represents the opposite direction (e.g., inbound). Required for GTFS data exchange with trip planning applications.' ;
    rdfs:domain ind:Direction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Boolean flag indicating whether this is a primary direction for route planning. Primary directions (e.g., Northbound, Southbound) are typically used for major route designations, while secondary directions may be used for branches or variants.' ;
    rdfs:domain ind:Direction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oppositeDirectionId rdf:type rdf:Property ;
    rdfs:label 'Opposite Direction Id' ;
    rdfs:comment 'Reference to the direction_id of the opposite or return direction. For example, if this record is Northbound, this field would reference the direction_id for Southbound. Used for bidirectional route planning and schedule coordination.' ;
    rdfs:domain ind:Direction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feedName rdf:type rdf:Property ;
    rdfs:label 'Feed Name' ;
    rdfs:comment 'Descriptive name of the GTFS feed, typically identifying the transit agency or service area covered by the feed.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedPublisherName rdf:type rdf:Property ;
    rdfs:label 'Feed Publisher Name' ;
    rdfs:comment 'Name of the organization or entity that publishes and maintains the GTFS feed data.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedPublisherUrl rdf:type rdf:Property ;
    rdfs:label 'Feed Publisher Url' ;
    rdfs:comment 'Website URL of the organization that publishes the GTFS feed, providing access to transit information and updates.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedLanguage rdf:type rdf:Property ;
    rdfs:label 'Feed Language' ;
    rdfs:comment 'ISO 639-1 language code indicating the primary language used in the GTFS feed text fields (e.g., en, es, fr).' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedStartDate rdf:type rdf:Property ;
    rdfs:label 'Feed Start Date' ;
    rdfs:comment 'The earliest date for which transit service data is available in this GTFS feed.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feedEndDate rdf:type rdf:Property ;
    rdfs:label 'Feed End Date' ;
    rdfs:comment 'The latest date for which transit service data is available in this GTFS feed.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feedVersion rdf:type rdf:Property ;
    rdfs:label 'Feed Version' ;
    rdfs:comment 'Version identifier for the GTFS feed, used to track updates and changes to the transit data over time.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedContactEmail rdf:type rdf:Property ;
    rdfs:label 'Feed Contact Email' ;
    rdfs:comment 'Email address for technical or administrative contact regarding the GTFS feed data and issues.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedContactUrl rdf:type rdf:Property ;
    rdfs:label 'Feed Contact Url' ;
    rdfs:comment 'Web page URL providing contact information or support resources for the GTFS feed.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedUrl rdf:type rdf:Property ;
    rdfs:label 'Feed Url' ;
    rdfs:comment 'Direct URL where the GTFS feed data file can be downloaded or accessed.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedType rdf:type rdf:Property ;
    rdfs:label 'Feed Type' ;
    rdfs:comment 'Type of GTFS feed indicating whether it contains static schedule data, real-time updates, or both.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedStatus rdf:type rdf:Property ;
    rdfs:label 'Feed Status' ;
    rdfs:comment 'Current operational status of the GTFS feed indicating whether it is actively maintained and available for use.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpoRpoAffiliation rdf:type rdf:Property ;
    rdfs:label 'Mpo Rpo Affiliation' ;
    rdfs:comment 'Name of the MPO or RPO planning organization coordinating with this transit service for regional transportation planning.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedLicense rdf:type rdf:Property ;
    rdfs:label 'Feed License' ;
    rdfs:comment 'License or terms of use governing the distribution and usage of the GTFS feed data.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultRouteType rdf:type rdf:Property ;
    rdfs:label 'Default Route Type' ;
    rdfs:comment 'Primary mode of transit service represented in this GTFS feed (e.g., bus, rail, ferry, demand response).' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedTimezone rdf:type rdf:Property ;
    rdfs:label 'Feed Timezone' ;
    rdfs:comment 'IANA timezone identifier for the geographic area covered by the GTFS feed (e.g., America/New_York).' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedNotes rdf:type rdf:Property ;
    rdfs:label 'Feed Notes' ;
    rdfs:comment 'Additional notes or comments about the GTFS feed, including special considerations, limitations, or usage instructions.' ;
    rdfs:domain ind:GtfsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tripCount rdf:type rdf:Property ;
    rdfs:label 'Trip Count' ;
    rdfs:comment 'Total number of trips included in this block. Each trip represents one journey along a route from origin to destination.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depotLocation rdf:type rdf:Property ;
    rdfs:label 'Depot Location' ;
    rdfs:comment 'Name or identifier of the depot or garage where the vehicle begins and ends this block. Used for vehicle assignment and maintenance scheduling.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpoRpoRegion rdf:type rdf:Property ;
    rdfs:label 'Mpo Rpo Region' ;
    rdfs:comment 'The MPO or RPO planning region where this block operates. Used for coordinated transportation planning and regional service analysis.' ;
    rdfs:domain ind:Block ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaSquareMiles rdf:type rdf:Property ;
    rdfs:label 'Service Area Square Miles' ;
    rdfs:comment 'Total geographic area covered by the transit zone measured in square miles. Used for service planning and resource allocation.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:population rdf:type rdf:Property ;
    rdfs:label 'Population' ;
    rdfs:comment 'Total population residing within the transit zone boundaries. Used for service demand forecasting and funding formula calculations.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationDensityPerSquareMile rdf:type rdf:Property ;
    rdfs:label 'Population Density Per Square Mile' ;
    rdfs:comment 'Average number of residents per square mile within the zone. Key metric for determining service type and frequency requirements.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ftaFundingEligibility rdf:type rdf:Property ;
    rdfs:label 'Fta Funding Eligibility' ;
    rdfs:comment 'Primary FTA grant program(s) for which this zone qualifies. Determines available federal funding sources for transit services.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryTransitProvider rdf:type rdf:Property ;
    rdfs:label 'Primary Transit Provider' ;
    rdfs:comment 'Name of the primary transit agency or operator providing service within this zone. May be a public transit authority, county government, or contracted operator.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceMode rdf:type rdf:Property ;
    rdfs:label 'Service Mode' ;
    rdfs:comment 'Primary type of transit service operating within the zone. Determines operational requirements and performance metrics.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fareStructureType rdf:type rdf:Property ;
    rdfs:label 'Fare Structure Type' ;
    rdfs:comment 'Pricing model used for transit services within the zone. Impacts revenue forecasting and equity analysis.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundaryDescription rdf:type rdf:Property ;
    rdfs:label 'Boundary Description' ;
    rdfs:comment 'Textual description of the geographic boundaries defining the zone. Includes major roads, natural features, or jurisdictional limits used as boundaries.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationRequirements rdf:type rdf:Property ;
    rdfs:label 'Coordination Requirements' ;
    rdfs:comment 'Special coordination requirements or agreements with adjacent zones, regional authorities, or state agencies. Documents inter-jurisdictional service arrangements.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Status' ;
    rdfs:comment 'Current compliance status with ADA accessibility requirements for transit services within the zone. Critical for federal funding eligibility.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patternCode rdf:type rdf:Property ;
    rdfs:label 'Pattern Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the coordination pattern in traffic management systems and field operations.' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patternType rdf:type rdf:Property ;
    rdfs:label 'Pattern Type' ;
    rdfs:comment 'Classification of the coordination pattern based on its triggering mechanism and operational context.' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offsetReferenceSeconds rdf:type rdf:Property ;
    rdfs:label 'Offset Reference Seconds' ;
    rdfs:comment 'Time offset in seconds from the master reference point used to synchronize signals along the coordinated corridor.' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coordinationMode rdf:type rdf:Property ;
    rdfs:label 'Coordination Mode' ;
    rdfs:comment 'Operating mode that defines how traffic signals interact within this pattern (free-running, coordinated progression, actuated response, etc.).' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityDirection rdf:type rdf:Property ;
    rdfs:label 'Priority Direction' ;
    rdfs:comment 'Primary traffic flow direction that receives coordination priority and optimized green wave progression in this pattern.' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Target Speed Mph' ;
    rdfs:comment 'Design speed in miles per hour used to calculate signal timing offsets for optimal vehicle progression through the corridor.' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysOfWeek rdf:type rdf:Property ;
    rdfs:label 'Days Of Week' ;
    rdfs:comment 'Comma-separated list of days when this pattern is active (e.g., Monday,Tuesday,Wednesday,Thursday,Friday for weekday patterns).' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmcApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Tmc Approval Required' ;
    rdfs:comment 'Flag indicating whether TMC operator approval is required before this pattern can be activated.' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentResponseFlag rdf:type rdf:Property ;
    rdfs:label 'Incident Response Flag' ;
    rdfs:comment 'Indicates whether this pattern is designed for incident management and can be triggered by IMAP (Incident Management Assistance Patrol) events.' ;
    rdfs:domain ind:CoordinationPattern ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accountHolderName rdf:type rdf:Property ;
    rdfs:label 'Account Holder Name' ;
    rdfs:comment 'Full legal name of the individual or organization that owns the toll account.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'Five or nine-digit ZIP code for the mailing address.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoReplenishmentEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Replenishment Enabled' ;
    rdfs:comment 'Indicates whether the account is configured to automatically replenish the prepaid balance when it falls below the threshold.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replenishmentThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Replenishment Threshold Amount' ;
    rdfs:comment 'Minimum account balance in USD that triggers automatic replenishment when auto-replenishment is enabled.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replenishmentAmount rdf:type rdf:Property ;
    rdfs:label 'Replenishment Amount' ;
    rdfs:comment 'Dollar amount in USD added to the account balance when auto-replenishment is triggered.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'Current prepaid balance in USD available in the toll account for toll transactions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lowBalanceThreshold rdf:type rdf:Property ;
    rdfs:label 'Low Balance Threshold' ;
    rdfs:comment 'Balance amount in USD that triggers a low balance notification to the account holder.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountPlanCode rdf:type rdf:Property ;
    rdfs:label 'Discount Plan Code' ;
    rdfs:comment 'Code identifying the discount or pricing plan applied to the toll account. Determines toll rates and promotional discounts.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transponderCount rdf:type rdf:Property ;
    rdfs:label 'Transponder Count' ;
    rdfs:comment 'Number of active transponders or toll tags associated with this toll account.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastReplenishmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Replenishment Date' ;
    rdfs:comment 'Date when the account balance was last replenished either manually or automatically.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingCycleDay rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Day' ;
    rdfs:comment 'Day of the month when the billing cycle closes and statements are generated for post-paid accounts.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statementDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Statement Delivery Method' ;
    rdfs:comment 'Preferred method for delivering billing statements and account summaries to the account holder.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paperlessBillingEnabled rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Enabled' ;
    rdfs:comment 'Indicates whether the account holder has opted for paperless billing and electronic statements only.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationPreferences rdf:type rdf:Property ;
    rdfs:label 'Notification Preferences' ;
    rdfs:comment 'Account holder preferences for receiving account alerts, low balance warnings, and transaction notifications.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessTaxId rdf:type rdf:Property ;
    rdfs:label 'Business Tax Id' ;
    rdfs:comment 'Federal Employer Identification Number for business or government toll accounts. Used for tax reporting and business verification.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerServiceNotes rdf:type rdf:Property ;
    rdfs:label 'Customer Service Notes' ;
    rdfs:comment 'Internal notes and comments from customer service interactions regarding account issues, disputes, or special handling requirements.' ;
    rdfs:domain ind:TollAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemName rdf:type rdf:Property ;
    rdfs:label 'System Name' ;
    rdfs:comment 'Official name or designation of the ATMS system installation.' ;
    rdfs:domain ind:AtmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemCode rdf:type rdf:Property ;
    rdfs:label 'System Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the ATMS system for operational reference and integration purposes.' ;
    rdfs:domain ind:AtmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemType rdf:type rdf:Property ;
    rdfs:label 'System Type' ;
    rdfs:comment 'Classification of the ATMS system based on its primary function within the traffic management infrastructure.' ;
    rdfs:domain ind:AtmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmcLocation rdf:type rdf:Property ;
    rdfs:label 'Tmc Location' ;
    rdfs:comment 'Name or identifier of the Traffic Management Center responsible for monitoring and controlling this ATMS system.' ;
    rdfs:domain ind:AtmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationStatus rdf:type rdf:Property ;
    rdfs:label 'Integration Status' ;
    rdfs:comment 'Level of integration between the ATMS system and the central traffic management platform or other ITS systems.' ;
    rdfs:domain ind:AtmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mutcdComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Mutcd Compliance Flag' ;
    rdfs:comment 'Indicator of whether the ATMS system installation and operation complies with MUTCD standards and requirements.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imapEnabled rdf:type rdf:Property ;
    rdfs:label 'Imap Enabled' ;
    rdfs:comment 'Indicator of whether the ATMS system is configured to support IMAP incident detection and response operations.' ;
    rdfs:domain ind:AtmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tier rdf:type rdf:Property ;
    rdfs:label 'Tier' ;
    rdfs:comment 'Hierarchical tier classification indicating the priority or funding level of the transit service (Tier 1 being highest priority).' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingEligibility rdf:type rdf:Property ;
    rdfs:label 'Funding Eligibility' ;
    rdfs:comment 'Indicates which FTA grant programs this service level is eligible for, including Section 5307 (Urbanized Area), 5310 (Elderly/Disabled), 5311 (Rural), and 5339 (Bus and Bus Facilities).' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceFrequencyMin rdf:type rdf:Property ;
    rdfs:label 'Service Frequency Min' ;
    rdfs:comment 'Minimum service frequency in minutes between transit vehicles for this service level (e.g., 15 minutes for high-frequency service).' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceFrequencyMax rdf:type rdf:Property ;
    rdfs:label 'Service Frequency Max' ;
    rdfs:comment 'Maximum service frequency in minutes between transit vehicles for this service level (e.g., 60 minutes for standard service).' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageAreaType rdf:type rdf:Property ;
    rdfs:label 'Coverage Area Type' ;
    rdfs:comment 'Geographic classification of the service coverage area for this transit level.' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpoRpoCoordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Mpo Rpo Coordination Required' ;
    rdfs:comment 'Indicates whether coordination with MPO or RPO planning organizations is required for this service level.' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adaComplianceLevel rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Level' ;
    rdfs:comment 'Level of ADA compliance required for this transit service level, including accessibility standards for vehicles and facilities.' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleTypeRequirement rdf:type rdf:Property ;
    rdfs:label 'Vehicle Type Requirement' ;
    rdfs:comment 'Specification of vehicle types required or recommended for this service level (e.g., standard bus, articulated bus, cutaway van, minibus).' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumServiceHoursPerDay rdf:type rdf:Property ;
    rdfs:label 'Minimum Service Hours Per Day' ;
    rdfs:comment 'Minimum number of service hours per day required for this transit service level to maintain operational standards.' ;
    rdfs:domain ind:Level ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stationCode rdf:type rdf:Property ;
    rdfs:label 'Station Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the ATMS station for system identification and reporting.' ;
    rdfs:domain ind:AtmsStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationType rdf:type rdf:Property ;
    rdfs:label 'Station Type' ;
    rdfs:comment 'Classification of the ATMS station based on its primary function within the traffic management system.' ;
    rdfs:domain ind:AtmsStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalHours rdf:type rdf:Property ;
    rdfs:label 'Operational Hours' ;
    rdfs:comment 'Schedule or pattern defining when the ATMS station is actively operating and monitoring traffic.' ;
    rdfs:domain ind:AtmsStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceCode rdf:type rdf:Property ;
    rdfs:label 'Service Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the transit service in operational systems and schedules.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fareStructure rdf:type rdf:Property ;
    rdfs:label 'Fare Structure' ;
    rdfs:comment 'Pricing model used for passenger fares (flat rate, zone-based, distance-based, free service, or variable pricing).' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceHoursStart rdf:type rdf:Property ;
    rdfs:label 'Service Hours Start' ;
    rdfs:comment 'Time when daily service operations begin (24-hour format HH:MM).' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceHoursEnd rdf:type rdf:Property ;
    rdfs:label 'Service Hours End' ;
    rdfs:comment 'Time when daily service operations end (24-hour format HH:MM).' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyMinutes rdf:type rdf:Property ;
    rdfs:label 'Frequency Minutes' ;
    rdfs:comment 'Average time interval in minutes between consecutive vehicle departures during peak service hours.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routeLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Route Length Miles' ;
    rdfs:comment 'Total length of the service route in miles from origin to destination (one-way distance).' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gtfsFeedAvailable rdf:type rdf:Property ;
    rdfs:label 'Gtfs Feed Available' ;
    rdfs:comment 'Indicates whether the service publishes schedule and route data in GTFS format for trip planning applications.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:realTimeTracking rdf:type rdf:Property ;
    rdfs:label 'Real Time Tracking' ;
    rdfs:comment 'Indicates whether the service provides real-time vehicle location tracking and arrival predictions to passengers.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalCertification rdf:type rdf:Property ;
    rdfs:label 'Environmental Certification' ;
    rdfs:comment 'Environmental classification of the vehicle fleet used in the service based on emissions and fuel type.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditSessionId rdf:type rdf:Property ;
    rdfs:label 'Audit Session Id' ;
    rdfs:comment 'Primary key for audit_session' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sessionIdentifier rdf:type rdf:Property ;
    rdfs:label 'Session Identifier' ;
    rdfs:comment 'Business-readable unique session identifier code used for tracking and referencing audit sessions across systems.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionType rdf:type rdf:Property ;
    rdfs:label 'Session Type' ;
    rdfs:comment 'Classification of the audit session indicating the nature and scope of the audit being conducted.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditCategory rdf:type rdf:Property ;
    rdfs:label 'Audit Category' ;
    rdfs:comment 'Specific category or focus area of the audit session within the finance domain, such as SAP Financial Accounting (FI), Controlling (CO), or GASB compliance.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorName rdf:type rdf:Property ;
    rdfs:label 'Auditor Name' ;
    rdfs:comment 'Full name of the primary auditor or audit team lead responsible for conducting the audit session.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorOrganization rdf:type rdf:Property ;
    rdfs:label 'Auditor Organization' ;
    rdfs:comment 'Name of the organization or department conducting the audit (e.g., NC Office of State Auditor, internal audit team, external audit firm).' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditScope rdf:type rdf:Property ;
    rdfs:label 'Audit Scope' ;
    rdfs:comment 'Detailed description of the scope, objectives, and boundaries of the audit session, including specific accounts, transactions, or processes being examined.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskRating rdf:type rdf:Property ;
    rdfs:label 'Risk Rating' ;
    rdfs:comment 'Overall risk rating assigned to the audit session based on preliminary risk assessment of the area being audited.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceFramework rdf:type rdf:Property ;
    rdfs:label 'Compliance Framework' ;
    rdfs:comment 'Primary compliance framework or standard against which the audit is being conducted (e.g., GASB, GAAP, OMB Uniform Guidance, NC General Statutes).' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialWeaknessFlag rdf:type rdf:Property ;
    rdfs:label 'Material Weakness Flag' ;
    rdfs:comment 'Indicator of whether material weaknesses in internal controls were identified during the audit session.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Report Reference Number' ;
    rdfs:comment 'Official reference number assigned to the audit report for tracking and archival purposes.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementResponseReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Management Response Received Flag' ;
    rdfs:comment 'Indicator of whether management response to audit findings has been received and documented.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required Flag' ;
    rdfs:comment 'Indicator of whether follow-up audit procedures are required to verify implementation of corrective actions.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpDueDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Due Date' ;
    rdfs:comment 'The date by which follow-up audit procedures must be completed to verify corrective action implementation.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalAuditFlag rdf:type rdf:Property ;
    rdfs:label 'External Audit Flag' ;
    rdfs:comment 'Indicator of whether the audit session is being conducted by an external auditor or audit firm rather than internal audit staff.' ;
    rdfs:domain ind:AuditSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Financial Institution Name' ;
    rdfs:comment 'The name of the bank or financial institution where the account is held. Used for reconciliation and reporting.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routingNumber rdf:type rdf:Property ;
    rdfs:label 'Routing Number' ;
    rdfs:comment 'The nine-digit American Bankers Association (ABA) routing transit number that identifies the financial institution. Required for electronic funds transfers and wire transactions.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swiftCode rdf:type rdf:Property ;
    rdfs:label 'Swift Code' ;
    rdfs:comment 'The international bank identifier code used for international wire transfers and cross-border transactions. Also known as Bank Identifier Code (BIC).' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Gl Account Number' ;
    rdfs:comment 'The general ledger account number in SAP FI that corresponds to this bank account. Used for financial statement preparation and reconciliation.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:houseBankId rdf:type rdf:Property ;
    rdfs:label 'House Bank Id' ;
    rdfs:comment 'The SAP house bank identifier that groups bank accounts by financial institution. Used for payment processing and cash management in SAP.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:branchName rdf:type rdf:Property ;
    rdfs:label 'Branch Name' ;
    rdfs:comment 'The name of the specific bank branch where the account is maintained. Used for physical correspondence and in-person transactions.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:branchAddress rdf:type rdf:Property ;
    rdfs:label 'Branch Address' ;
    rdfs:comment 'The complete physical address of the bank branch managing this account. Includes street, city, state, and ZIP code.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Contact Phone Number' ;
    rdfs:comment 'The phone number of the primary contact person or customer service line at the financial institution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactEmailAddress rdf:type rdf:Property ;
    rdfs:label 'Contact Email Address' ;
    rdfs:comment 'The email address of the primary contact person at the financial institution for electronic correspondence.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestBearingFlag rdf:type rdf:Property ;
    rdfs:label 'Interest Bearing Flag' ;
    rdfs:comment 'Indicates whether the bank account earns interest on deposited funds. True if interest-bearing, false otherwise.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumBalanceRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Balance Required' ;
    rdfs:comment 'The minimum balance that must be maintained in the account to avoid fees or meet contractual requirements.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdraftProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Overdraft Protection Flag' ;
    rdfs:comment 'Indicates whether the account has overdraft protection enabled. True if overdraft protection is active, false otherwise.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fdicInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Fdic Insured Flag' ;
    rdfs:comment 'Indicates whether the bank account is insured by the Federal Deposit Insurance Corporation. True if FDIC insured, false otherwise.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciliation Date' ;
    rdfs:comment 'The date when the most recent bank reconciliation was completed for this account. Used to track compliance with reconciliation policies.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ncfsIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Ncfs Integration Flag' ;
    rdfs:comment 'Indicates whether this bank account is integrated with the North Carolina Financial System for automated transaction processing and reporting.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicPaymentEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Electronic Payment Enabled Flag' ;
    rdfs:comment 'Indicates whether the account is enabled for electronic payment methods such as ACH transfers, wire transfers, and electronic funds transfers.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:checkPrintingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Check Printing Enabled Flag' ;
    rdfs:comment 'Indicates whether the account is authorized for printing and issuing physical checks for payments.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onlineBankingAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Online Banking Access Flag' ;
    rdfs:comment 'Indicates whether online banking access is enabled for this account, allowing web-based account management and transaction monitoring.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .
