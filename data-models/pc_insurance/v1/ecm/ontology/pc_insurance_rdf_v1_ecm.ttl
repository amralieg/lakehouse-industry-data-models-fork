    rdfs:comment 'Effective date of the exposure portfolio snapshot used in this run.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geocodingAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'Geocoding Accuracy Percent' ;
    rdfs:comment 'Percentage of exposure locations successfully geocoded to precise coordinates.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographyScope rdf:type rdf:Property ;
    rdfs:label 'Geography Scope' ;
    rdfs:comment 'Geographic region or territory scope covered by this PML run.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCount rdf:type rdf:Property ;
    rdfs:label 'Location Count' ;
    rdfs:comment 'Number of insured locations included in the exposure portfolio for this run.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossAmplificationApplied rdf:type rdf:Property ;
