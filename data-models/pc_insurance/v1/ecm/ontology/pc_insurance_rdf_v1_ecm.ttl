# RDFS Schema for Business: Pc_Insurance

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/pc_insurance#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Pc_Insurance ---
ind:PcInsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Pc_Insurance' ;
    rdfs:comment 'A Property & Casualty insurer underwriting personal and commercial lines. Prospects submit risk information, underwriters evaluate and price it, and quotes are bound into policies that renew, endorse, cancel, and reinstate over time. Policies carry coverages with limits, deductibles, exclusions, and conditions that attach to insured risks (properties, buildings, vehicles, drivers). Premium is booked as written, earned, unearned, and return transactions with charges, taxes, fees, and producer commission. Claims record loss events, claimants, and per-coverage exposures, with reserves, payments, recoveries, and expenses tracked as financial movements. Risk is distributed through agents and brokers and ceded through reinsurance treaties and facultative agreements, with catastrophe and geography used to aggregate exposure.' .

# --- Domain Classes ---
ind:Party rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Party' ;
    rdfs:comment 'SSOT for all persons and organizations the insurer interacts with: policyholders, named/additional insureds, claimants, producers, adjusters, and payees. Owns identity, demographics, KYC, and deduplication.' .

ind:Underwriting rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Underwriting' ;
    rdfs:comment 'Manages the front-of-pipe lifecycle from submission intake and clearance through risk appetite screening, eligibility, risk scoring, referral management, and quote generation. Owns ACORD 125/126/140 submission data, UW decisions, and bound quotes.' .

ind:Policy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Policy' ;
    rdfs:comment 'Authoritative record of the insurance contract lifecycle. Owns Policy (one row per policy), Policy Term (one row per policy per term), and Policy Transaction (NB, REN, END, CAN, RI, NR).' .

ind:Coverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Coverage' ;
    rdfs:comment 'Bridge between the policy contract and the insured risk. Owns Coverage (one row per coverage per policy term) with attached Limit, Deductible, Exclusion, and Condition.' .

ind:Premium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Premium' ;
    rdfs:comment 'Transactional ledger for all premium activity. Owns Premium Transaction (one row per financial transaction: Written, Earned, Unearned, Return) tied to Policy, Policy Term, Coverage, Insured Risk, and Accounting Period, with Charge, Tax, Fee, and' .

ind:Billing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Billing' ;
    rdfs:comment 'Manages invoicing, collections, disbursements, delinquency, and installment plan processing for policyholders and payees. Owns billing accounts, invoices, payment transactions, payment plans, returned payments, and write-offs.' .

ind:Reinsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Reinsurance' ;
    rdfs:comment 'Manages risk transfer to reinsurers. Owns Reinsurance Agreement, Treaty (QS/XOL/SL/CAT XL), Facultative Agreement, Cession, and Reinsurance Recovery linked to ceded Policy and Claim.' .

ind:Riskexposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Riskexposure' ;
    rdfs:comment 'Provisional description for user-specified domain \'risk_exposure\'. Awaiting a generated description of what this domain owns.' .

ind:Claims rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Claims' ;
    rdfs:comment 'Provisional description for user-specified domain \'claims\'. Awaiting a generated description of what this domain owns.' .

ind:Claimfinancials rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Claimfinancials' ;
    rdfs:comment 'Provisional description for user-specified domain \'claim_financials\'. Awaiting a generated description of what this domain owns.' .

ind:Producers rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Producers' ;
    rdfs:comment 'Provisional description for user-specified domain \'producers\'. Awaiting a generated description of what this domain owns.' .

ind:Catastrophegeography rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Catastrophegeography' ;
    rdfs:comment 'Provisional description for user-specified domain \'catastrophe_geography\'. Awaiting a generated description of what this domain owns.' .

ind:Shared rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Shared' ;
    rdfs:comment 'Cross-domain shared reference entities (currency, UoM, calendar, classification) consolidated for Single Source of Truth (SSOT).' .

# --- Data Product Classes (Tables) ---
ind:Party rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Party' ;
    rdfs:comment 'SSOT master record for every person or organization the insurer interacts with. One row per party. Owns golden-record identity, KYC status, dedup keys, and MDM flags. Tax IDs and external keys live in identifier, not here.' .

ind:Role rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Role' ;
    rdfs:comment 'Assigns a role to a party with effective and expiration dates. One row per party-role assignment. Roles include policyholder, named insured, additional insured, claimant, producer, adjuster, and payee. Never embeds role on the party record.' .

ind:Individual rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Individual' ;
    rdfs:comment 'Person-specific subtype of party. Stores legal name, date of birth, gender, marital status, driver license number, and MVR consent flag for natural persons underwritten or involved in claims. External IDs live in identifier.' .

ind:Organization rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Organization' ;
    rdfs:comment 'Legal-entity subtype of party. Stores legal name, FEIN, NAIC code, SIC/NAICS code, entity type (corp, LLC, partnership), state of incorporation, and D&B DUNS for commercial insureds and counterparties.' .

ind:Address rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Address' ;
    rdfs:comment 'Physical and mailing addresses for a party. One row per address per party. Stores address type (mailing, risk, billing), street, city, state, ZIP+4, county, country, geocode, and effective dates.' .

ind:Contact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Contact' ;
    rdfs:comment 'Communication contact points for a party: phone, email, fax, and preferred contact method. One row per contact point per party. Tracks opt-in/opt-out flags, contact type, and effective dates for GLBA compliance.' .

ind:Identifier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Identifier' ;
    rdfs:comment 'External and internal identifiers assigned to a party: SSN, FEIN, NPN, NAIC code, driver license, passport, PAS party ID, MDM golden ID. One row per identifier per party. Supports deduplication and cross-system matching.' .

ind:Relationship rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Relationship' ;
    rdfs:comment 'Directed relationship between two parties: spouse, parent-subsidiary, named insured to additional insured, employer-employee. One row per relationship. Carries relationship type, effective dates, and primary-party flag.' .

ind:KycVerification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Kyc Verification' ;
    rdfs:comment 'KYC and identity-verification record for a party. Tracks verification method, verification date, result (pass/fail/review), OFAC screening status, PEP flag, adverse-media flag, and the analyst who performed the check.' .

ind:ConsentRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Consent Record' ;
    rdfs:comment 'Captures explicit consent or opt-out events for a party: marketing, electronic delivery, telematics, credit pull, MVR pull. One row per consent event. Stores consent type, channel, timestamp, and regulatory basis (GLBA/CCPA/GDPR).' .

ind:MergeEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Merge Event' ;
    rdfs:comment 'MDM deduplication event that merges a survivor party with one or more duplicate parties. One row per merge operation. Stores survivor party, merged party, merge date, merge reason, and the operator who approved the merge.' .

ind:Segment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Segment' ;
    rdfs:comment 'Business segmentation classification assigned to a party: personal lines, commercial lines, preferred, standard, non-standard, high-net-worth. One row per segment assignment per party. Supports underwriting appetite and marketing targeting.' .

ind:PartyDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Party Document' ;
    rdfs:comment 'Documents associated with a party: government-issued ID, proof of address, ACORD applications, CoI, MVR report, loss runs. One row per document. Stores document type, source system, storage URI, received date, and expiry date.' .

ind:LossPayee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Loss Payee' ;
    rdfs:comment 'Loss payee or mortgagee interest attached to a party and a policy or insured risk. One row per interest. Stores interest type (mortgagee, loss payee, additional insured), lender name, loan number, and effective dates.' .

ind:License rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'License' ;
    rdfs:comment 'Professional licenses held by a party: producer license, adjuster license, contractor license. One row per license. Stores license type, license number, issuing state, issue date, expiry date, and active status for NIPR/DOI compliance.' .

ind:ProducersProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producers Producer' ;
    rdfs:comment 'Master record for every licensed insurance producer (agent or broker). One row per producer. Stores NPN, license numbers, resident state, producer type, appointment status, and E&O coverage details.' .

ind:Agency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Agency' ;
    rdfs:comment 'Master record for an insurance agency or brokerage firm. One row per agency. Captures agency name, FEIN, NAIC code, principal address, agency type, and parent agency hierarchy for MGA and wholesale relationships.' .

ind:ProducerLicense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer License' ;
    rdfs:comment 'Individual state license held by a producer. One row per producer per state per license class. Tracks license number, line of authority, issue date, expiration date, and DOI status for compliance and appointment eligibility.' .

ind:AgencyProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Agency Producer' ;
    rdfs:comment 'Association between a producer and an agency capturing the employment or affiliation relationship. One row per producer-agency pairing. Stores role, start date, end date, and primary-agency flag.' .

ind:ProducerAppointment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Appointment' ;
    rdfs:comment 'Formal appointment and binding authority granted by the insurer to a producer to sell specific lines in a state. One row per producer per insurer per state per LOB.' .

ind:DistributionChannel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Distribution Channel' ;
    rdfs:comment 'Reference classification of how business reaches the insurer (captive, independent, broker, direct, MGA, wholesale, affinity, digital). One row per channel. Drives commission schedule selection and producer underwriting authority rules.' .

ind:CommissionSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Schedule' ;
    rdfs:comment 'Contractual commission rate set for a producer or agency by LOB, transaction type (NB/REN/END), and coverage type over an effective period. One row per schedule version. Holds all rate lines (base, contingent, override) as embedded detail.' .

ind:CommissionRule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Rule' ;
    rdfs:comment 'Individual rate rule within a commission schedule. One row per rule. Specifies transaction type (NB, REN, END), LOB, coverage type, base rate, contingent rate, override rate, and effective date range.' .

ind:CommissionTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Transaction' ;
    rdfs:comment 'One row per commission financial movement earned by a producer on a premium transaction. Captures earned amount, claw-back amount, transaction type, accounting period, and payment status. Child of premium transaction.' .

ind:CommissionStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Statement' ;
    rdfs:comment 'Periodic statement issued to a producer or agency summarizing commission transactions due for a billing cycle. One row per statement. Tracks statement date, total earned, total adjustments, net payable, and payment status.' .

ind:CommissionPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Payment' ;
    rdfs:comment 'Actual disbursement made to a producer or agency against a commission statement. One row per payment. Records payment date, amount, payment method, check or ACH reference, and reconciliation status.' .

ind:ContingentCommission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Contingent Commission' ;
    rdfs:comment 'Profit-sharing or contingent commission agreement between the insurer and an agency. One row per agreement per performance period. Stores target LR, target growth, earned amount, and calculation basis for year-end settlement.' .

ind:ProducersProducerPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producers Producer Policy' ;
    rdfs:comment 'Association linking a producer to a policy with role (writing agent, servicing agent, broker of record). One row per producer-policy-role. Supports split-commission scenarios and broker-of-record changes with effective dating.' .

ind:UnderwritingAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Underwriting Authority' ;
    rdfs:comment 'Defines the binding authority granted to a producer or agency by LOB, coverage type, and limit tier. One row per authority grant. Tracks max TIV, max single-risk limit, eligible states, and authority expiration date.' .

ind:ProducerPerformance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Performance' ;
    rdfs:comment 'Periodic operational scorecard and tier assignment for a producer or agency. One row per producer per period. Stores GWP, NWP, PIF count, LR, retention, new-business count, and the assigned tier (Preferred/Standard/Probationary) with the tier definition' .

ind:ProducerTier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Tier' ;
    rdfs:comment 'Classification tier assigned to a producer or agency based on performance criteria (Preferred, Standard, Probationary). One row per tier definition. Drives commission override rates, underwriting authority levels, and marketing support.' .

ind:ErrorsOmissionsPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Errors Omissions Policy' ;
    rdfs:comment 'E&O insurance policy held by a producer or agency as required for appointment. One row per E&O policy. Tracks insurer, policy number, coverage limit, effective date, expiration date, and compliance verification status.' .

ind:ProducerComplianceEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Compliance Event' ;
    rdfs:comment 'Record of a compliance-relevant event for a producer: license renewal, CE completion, background check, DOI action, or termination for cause. One row per event. Supports appointment eligibility and regulatory audit trails.' .

ind:BrokerOfRecordChange rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Broker Of Record Change' ;
    rdfs:comment 'Formal BOR change request and approval record transferring a policy from one producer to another. One row per BOR change. Tracks requesting producer, outgoing producer, effective date, insured consent date, and commission split impact.' .

ind:RiAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Agreement' ;
    rdfs:comment 'Master record for a reinsurance agreement between the cedant and one or more reinsurers. One row per agreement. Captures agreement type (Treaty/Facultative), status, inception/expiry, governing law, and currency.' .

ind:Treaty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty' ;
    rdfs:comment 'Defines a proportional or non-proportional treaty under a reinsurance agreement. One row per treaty. Captures treaty type (QS/XOL/SL/CAT XL), layer, retention, limit, ROL, and UNL basis.' .

ind:TreatyLayer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty Layer' ;
    rdfs:comment 'Individual attachment/exhaustion layer within an XOL or CAT XL treaty. One row per layer per treaty. Stores attachment point, limit per occurrence, annual aggregate limit, and reinstatement terms.' .

ind:FacAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Fac Agreement' ;
    rdfs:comment 'Facultative reinsurance agreement covering a single risk or policy. One row per FAC placement. Captures cedant, reinsurer, ceded percentage, premium rate, inception/expiry, and the linked policy or submission.' .

ind:Reinsurer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Reinsurer' ;
    rdfs:comment 'Master record for each reinsurance counterparty (assuming company, Lloyd\'s syndicate, or pool). One row per reinsurer. Stores legal name, NAIC code, AM Best rating, domicile, and authorized/unauthorized status for Schedule F credit.' .

ind:RiParticipant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Participant' ;
    rdfs:comment 'Allocation of a reinsurer\'s share within a treaty or FAC agreement. One row per reinsurer per agreement. Captures signed line percentage, written line percentage, and participation effective dates.' .

ind:ReinsuranceCession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Reinsurance Cession' ;
    rdfs:comment 'Records risk transfer of a policy term to a treaty layer or FAC. Grain: one row per policy term per treaty layer (or FAC). Direction flag (outward/retro) distinguishes cession from retrocession.' .

ind:RiPremiumTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Premium Transaction' ;
    rdfs:comment 'Ceded premium ledger. One row per financial movement (written, earned, unearned, return, reinstatement) for a cession. FK to cession, accounting period, treaty layer. Reinstatement rows carry occurrence reference and reinstated limit.' .

ind:RiClaimCession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Claim Cession' ;
    rdfs:comment 'Links a claim exposure to a reinsurance treaty layer or FAC agreement for loss recovery eligibility. One row per claim exposure per treaty layer. Stores ceded loss amount, ceded LAE, and UNL calculation basis.' .

ind:RiRecovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Recovery' ;
    rdfs:comment 'Single ceded loss ledger. Grain: one row per movement per ri_claim_cession per accounting period, discriminated by movement_type: case/IBNR/LAE reserve position, or cash recovery (loss/LAE/DCC, subrogation, salvage).' .

ind:Bordereaux rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Bordereaux' ;
    rdfs:comment 'Periodic bordereau submission record sent to reinsurers summarizing ceded premium and loss activity. One row per bordereaux run per treaty per reporting period. Captures submission date, period, status, and totals.' .

ind:ReinsuranceBordereauxLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Reinsurance Bordereaux Line' ;
    rdfs:comment 'Individual line item within a bordereaux submission, representing one cession or claim cession. One row per cession per bordereaux. Stores ceded premium, ceded loss, ceded LAE, and policy/claim reference keys. Belongs to a parent bordereaux run.' .

ind:RiReinstatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Reinstatement' ;
    rdfs:comment 'Records the reinstatement of treaty limit after a loss occurrence exhausts a layer. One row per reinstatement event per treaty layer. Captures reinstatement premium, reinstated limit, occurrence reference, and effective date.' .

ind:RiSettlement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Settlement' ;
    rdfs:comment 'Net cash settlement between cedant and reinsurer, per reinsurer per period, netting ceded premium payable against loss recoverable. Includes profit commission (loss ratio, sliding-scale rate, commission amount) as a settlement component.' .

ind:RiCollateral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Collateral' ;
    rdfs:comment 'Tracks collateral (letters of credit, trust funds, funds withheld) posted by unauthorized reinsurers to support ceded reserves. One row per collateral instrument. Stores type, amount, expiry, and regulatory jurisdiction.' .

ind:ScheduleFEntry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Schedule F Entry' ;
    rdfs:comment 'Statutory Schedule F reporting entry per reinsurer per reporting year. One row per reinsurer per year. Captures assumed and ceded premium, losses, reserves, and collectibility status for NAIC Annual Statement filing.' .

ind:Reserve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Reserve' ;
    rdfs:comment 'One row per reserve position per claim exposure per accounting period. Tracks Case, IBNR, and LAE reserves with opening balance, incremental movement (strengthening/release with reason code and authorizing adjuster), and closing balance.' .

ind:ClaimPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Claim Payment' ;
    rdfs:comment 'One row per payment disbursement per claim exposure per accounting period. Records indemnity, medical, and LAE payments with payee, method, check/EFT reference, void/reissue/stop-payment status, and AP batch grouping (batch id, bank account, settlement' .

ind:Recovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Recovery' ;
    rdfs:comment 'One row per recovery transaction per claim exposure per accounting period. SSOT for ALL claim recoveries: recovery_type (subrogation, salvage, reinsurance), responsible party, demand/collected/net amounts.' .

ind:Subrogation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Subrogation' ;
    rdfs:comment 'Master record for a subrogation pursuit against a liable third party. Tracks demand amount, collected amount, attorney assignment, litigation status, settlement date, and net recovery after expenses per claim.' .

ind:Salvage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Salvage' ;
    rdfs:comment 'Master record for salvage activity on a total-loss insured item. Tracks salvage value estimate, auction proceeds, title transfer status, storage costs, net salvage amount, and disposition method per claim exposure.' .

ind:ClaimExpense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Claim Expense' ;
    rdfs:comment 'One row per expense transaction per claim exposure and accounting period. Classifies LAE into ALAE/ULAE, DCC, and AO categories with vendor, invoice reference, approval status, and GL account. Grain: one row per expense movement.' .

ind:LossTriangle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Loss Triangle' ;
    rdfs:comment 'Actuarial loss development triangle per accident year, policy year, or calendar year cohort. Stores paid losses, incurred losses, case reserves, and IBNR by development period for Schedule P and reserving analytics.' .

ind:IbnrEstimate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Ibnr Estimate' ;
    rdfs:comment 'Actuarial IBNR and IBNER estimate per LOB, accident year, and valuation date. Records selected ultimate, expected loss ratio, development factor, tail factor, and actuary sign-off. SSOT for IBNR positions.' .

ind:ClaimfinancialsAccountingPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Claimfinancials Accounting Period' ;
    rdfs:comment 'Reference calendar for financial close cycles. Defines calendar year, accident year, policy year, and fiscal period boundaries used to bucket premium, loss, and expense transactions for statutory and GAAP reporting.' .

ind:FinancialTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Financial Transaction' ;
    rdfs:comment 'One row per atomic double-entry posting generated by a claim financial event (reserve, payment, recovery, expense), keyed to claim exposure and accounting period.' .

ind:ReinsuranceRecovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Reinsurance Recovery' ;
    rdfs:comment 'One row per reinsurance recovery billing per claim exposure and treaty or facultative agreement. Tracks ceded loss amount, ceded LAE, recovery billed, recovery collected, and outstanding balance. Links claim to reinsurance cession.' .

ind:ClaimFinancialSnapshot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Claim Financial Snapshot' ;
    rdfs:comment 'Point-in-time financial position per claim exposure as of a valuation date. Stores total incurred (paid + case reserve), IBNR allocation, ceded amounts, net retained position, and prior-period comparison for statutory reporting.' .

ind:LaeAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Lae Allocation' ;
    rdfs:comment 'Allocates unallocated LAE (ULAE) to individual claim exposures using an actuarial allocation method (paid-to-paid, Kittel, etc.). Records allocated ULAE amount, method code, allocation basis, and accounting period.' .

ind:Payee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Payee' ;
    rdfs:comment 'Master record for a party designated to receive claim payments. Captures payee name, tax ID (SSN/FEIN), address, bank account for EFT, 1099 reporting flag, and payee type (claimant, attorney, vendor, lienholder).' .

ind:StatutoryReserveFiling rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Statutory Reserve Filing' ;
    rdfs:comment 'Statutory reserve position submitted to state DOI or NAIC. Captures LOB, state, accident year, case reserve, IBNR, total incurred, filing date, actuary certification, and SAP vs GAAP basis for regulatory compliance.' .

ind:ClaimfinancialsBordereauxLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Claimfinancials Bordereaux Line' ;
    rdfs:comment 'One row per claim line in a reinsurance bordereaux submission. Captures claim reference, ceded loss, ceded LAE, recovery status, treaty or facultative reference, and reporting period for reinsurer settlement.' .

ind:PremiumTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Premium Transaction' ;
    rdfs:comment 'Grain: one row per financial premium movement (Written, Earned, Unearned, Return). Ties to Policy, Policy Term, Coverage, Insured Risk, and Accounting Period. Core ledger of all premium activity; premium is never stored as a single number on the policy.' .

ind:PremiumAccountingPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Premium Accounting Period' ;
    rdfs:comment 'Reference calendar period (month, quarter, year) used to bucket premium, loss, and expense transactions for statutory and GAAP reporting. Supports CY, AY, and PY views required by Schedule P and IFRS 17.' .

ind:Charge rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Charge' ;
    rdfs:comment 'Child of Premium Transaction. One row per charge component (base premium, surcharge, credit, minimum premium) within a transaction. Enables granular decomposition of gross written premium by rating element and LOB.' .

ind:TaxLevy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Tax Levy' ;
    rdfs:comment 'Child of Premium Transaction. One row per state or surplus-lines tax, stamping fee, or regulatory assessment applied to a premium transaction. Tracks tax type, jurisdiction, rate, and computed amount for statutory remittance.' .

ind:PolicyFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Policy Fee' ;
    rdfs:comment 'Child of Premium Transaction. One row per non-premium fee (policy fee, inspection fee, installment fee) charged on a transaction. Fees are non-taxable in most jurisdictions and tracked separately from taxable premium.' .

ind:Commission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Commission' ;
    rdfs:comment 'Child of Premium Transaction. One row per producer commission calculation on a transaction: type (new/renewal/contingent), rate, basis, and computed payable. Calculation-only; commission settlement/payout is owned by the producers domain.' .

ind:EarnedPremiumSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Earned Premium Schedule' ;
    rdfs:comment 'Pro-rata or short-rate earning schedule for a Coverage within a Policy Term. Defines daily or monthly earned and unearned premium amounts used to compute EP at any in-force date. Supports IFRS 17 and Schedule P actuarial triangles.' .

ind:PremiumEndorsement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Premium Endorsement' ;
    rdfs:comment 'Records the net premium change (additional or return) generated by a Policy Transaction endorsement, cancellation, or reinstatement. Links the endorsing Policy Transaction to the resulting Premium Transactions and charge breakdown.' .

ind:RateTable rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Rate Table' ;
    rdfs:comment 'Versioned rate table published by the rating engine for a specific LOB, state, and effective date. Stores base rates, factors, and minimum premiums. Provides the authoritative rate version used to price each Policy Term.' .

ind:Audit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Audit' ;
    rdfs:comment 'Result of a final or interim audit for auditable policies (WC, GL, CGL). Captures audited exposure basis, audited premium, variance from estimated/deposit premium, and deposit reconciliation status. Triggers additional or return premium transactions.' .

ind:InstallmentPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Installment Plan' ;
    rdfs:comment 'Installment schedule elected for a Policy Term with per-installment lines: number, due dates, billed/paid amounts, fees, and status. Feeds delinquency and cancellation-for-non-payment.' .

ind:BearingCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Bearing Coverage' ;
    rdfs:comment 'Association table linking a Premium Transaction to the specific Coverage and Insured Risk it applies to. Grain: one row per coverage allocation per premium transaction. Prevents fan-out double-counting when premium splits across multiple coverages.' .

ind:CededPremium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Ceded Premium' ;
    rdfs:comment 'Records premium ceded to reinsurers under a Treaty or Facultative Agreement per Policy Term and Coverage; ceded written/earned/unearned by accounting period. Candidate for relocation to Reinsurance, which owns the cession ledger.' .

ind:MinimumEarnedPremium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Minimum Earned Premium' ;
    rdfs:comment 'Defines the minimum earned premium threshold for a Coverage or Policy Term that applies on short-rate or flat cancellation. Ensures the insurer retains a floor amount regardless of cancellation timing or return premium calculation.' .

ind:RetrospectiveAdjustment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Retrospective Adjustment' ;
    rdfs:comment 'Records a retro premium adjustment for retrospectively-rated policies. Captures adjustment number, evaluation date, standard premium, loss conversion factor, retro premium computed, and variance from prior adjustment.' .

ind:Rule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Rule' ;
    rdfs:comment 'Business rule governing how premium is computed, split, earned, or floored for a LOB, state, or coverage type. Stores rule type (pro-rata, short-rate, flat, minimum-earned), effective date range, threshold amounts, and conditions.' .

ind:DepositPremium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Deposit Premium' ;
    rdfs:comment 'Tracks the estimated deposit premium collected at policy inception for auditable or retro-rated policies. Stores deposit amount, basis of estimate, and reconciliation status against final audit or retro adjustment.' .

ind:Policy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy' ;
    rdfs:comment 'Master record of the insurance contract. One row per policy. Captures LOB, program, state, carrier, inception/expiration dates, policy number, status, and binding metadata. SSOT for all downstream term, transaction, coverage, and claim linkage.' .

ind:Term rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Term' ;
    rdfs:comment 'Time-bounded period of a policy. One row per policy per term. Carries term effective/expiration dates, term sequence number, renewal indicator, and in-force status enabling reconstruction of coverages and premium at any date including loss date.' .

ind:PolicyTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Transaction' ;
    rdfs:comment 'Lifecycle event applied to a policy term. One row per transaction. Type (NB, REN, END, CAN, RI, NR) with type-specific attributes: effective/processed date, reason code, premium impact, cancellation basis and return-premium method, reinstatement lapse' .

ind:Policyholder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policyholder' ;
    rdfs:comment 'Association between a policy and the party acting as named insured/policyholder. One row per policyholder per policy. Carries role type, effective/expiration dates, and primary-insured flag.' .

ind:PolicyInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Interest' ;
    rdfs:comment 'Additional interests on a policy (additional insured, loss payee, mortgagee, lienholder). One row per interest per policy term. Captures interest type, party reference, certificate number, effective dates, and notification requirements per ISO/ACORD' .

ind:PolicyForm rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Form' ;
    rdfs:comment 'ISO/ACORD forms and endorsement forms attached to a policy term. One row per form attachment. Records form number, edition date, form type (base, endorsement, exclusion), attachment sequence, and mandatory/optional flag per state filing.' .

ind:Line rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Line' ;
    rdfs:comment 'Line-of-business breakdown within a policy. One row per LOB per policy term. Supports multi-line CPP and BOP structures. Carries NAIC LOB code, sub-line, program code, and LOB-level written premium for statutory Schedule P reporting.' .

ind:PolicyProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Producer' ;
    rdfs:comment 'Association linking a policy to its producing agent or broker. One row per producer role per policy. Captures producer NPN, agency code, distribution channel, split percentage, and effective dates. Feeds commission settlement in the producers domain.' .

ind:ReinsuranceLink rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Reinsurance Link' ;
    rdfs:comment 'Carries the reinsurance treaty and facultative agreement keys on the policy so cession and recovery records in the reinsurance domain can join back. One row per reinsurance placement per policy term.' .

ind:PolicyCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Condition' ;
    rdfs:comment 'Policy-level conditions and warranties attached to the contract (e.g., protective safeguard warranty, occupancy condition). One row per condition per policy term. Distinct from coverage-level conditions; applies across all coverages on the term.' .

ind:PolicyType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'Reference classification of policy types (HO3, HO6, PAP, BOP, CGL, CPP, CA, WC, EPLI, D&O, E&O). One row per policy type. Carries NAIC line code, ISO program code, personal/commercial flag, and monoline/package indicator.' .

ind:StateReg rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'State Reg' ;
    rdfs:comment 'State-specific regulatory attributes for a policy. One row per policy per state. Captures admitted/surplus lines status, stamping office filing number, state-mandated coverage flags, assigned risk pool indicator, and FAIR plan eligibility.' .

ind:Fee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Fee' ;
    rdfs:comment 'Policy-level fees assessed at issuance or renewal (policy fee, inspection fee, installment fee, surplus lines tax). One row per fee per policy transaction. Carries fee type, amount, taxable flag, and remittance destination.' .

ind:PolicyDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Document' ;
    rdfs:comment 'Documents and notices issued on a policy including application, binder, jacket, endorsement, certificate, declarations page (DEC), and regulatory notices. One row per document generated at a policy transaction.' .

ind:CatastropheEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Catastrophe Event' ;
    rdfs:comment 'Master record of a named CAT event (hurricane, quake, wildfire, flood, tornado), one row per event. Captures event type, peril, date range, footprint, industry loss estimate, PML class, ISO CAT serial number, event name, and affected states for statutory' .

ind:CatZone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Cat Zone' ;
    rdfs:comment 'Insurer-defined CAT zone or territory used for exposure aggregation and PML modeling. One row per zone. Zones map to peril types (wind, quake, flood) and carry AAL and PML thresholds for reinsurance treaty attachment.' .

ind:Geography rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Geography' ;
    rdfs:comment 'Enterprise geography hierarchy node (country, state, county, ZIP, CRESTA zone, census tract). One row per geography unit. Provides the spatial backbone for territory rating, CAT aggregation, and regulatory reporting.' .

ind:GeographyHierarchy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Geography Hierarchy' ;
    rdfs:comment 'Parent-child closure table for the geography hierarchy. Stores ancestor-descendant pairs with depth level so any node can be rolled up to state, region, or national level for exposure aggregation and Schedule P reporting.' .

ind:Territory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Territory' ;
    rdfs:comment 'Rating territory as filed with the DOI per state and LOB. One row per territory per LOB per state. Carries territory code, effective date, filed rate relativities, residual-market/wind-pool designation flags, and links to the geography hierarchy for' .

ind:CatastrophegeographyPeril rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Catastrophegeography Peril' ;
    rdfs:comment 'Reference catalog of insured perils (wind, hail, earthquake, flood, fire, theft, liability). One row per peril. Carries NAIC peril code, CAT vs. non-CAT flag, reinsurance treaty peril mapping, and ISO cause-of-loss code.' .

ind:HazardScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Hazard Score' ;
    rdfs:comment 'Point-in-time hazard score assigned to a geographic location for a specific peril by the CAT model (RMS/AIR). One row per location per peril per model version. Stores AAL, PML return periods, and hazard band for underwriting eligibility.' .

ind:ExposureSummary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Exposure Summary' ;
    rdfs:comment 'Single authoritative accumulation snapshot: aggregated TIV, policy count, and concentration by geography node, peril, and LOB as of an accounting date. One row per geography per peril per LOB per as-of date.' .

ind:CatEventLoss rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Cat Event Loss' ;
    rdfs:comment 'CAT-attribution loss ESTIMATE per CAT event per LOB per geography (one row each). Holds modeled/actual gross, ceded, and net loss and IBNR loading for Schedule P CAT reporting only -- NOT the financial ledger; authoritative payments/reserves live in' .

ind:CatEventZoneXref rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Cat Event Zone Xref' ;
    rdfs:comment 'Association between a CAT event and the CAT zones it impacted. One row per CAT event per zone. Carries impact severity band, wind speed or shake intensity, and storm surge flag used to filter exposed policies for FNOL triage.' .

ind:LocationGeocode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Location Geocode' ;
    rdfs:comment 'Per-location SSOT for geocode and hazard: one row per insured location. Stores lat/long, FIPS, CRESTA zone, FEMA FIRM flood zone, base flood elevation, FIRM panel, fire protection class, and model-derived AAL/PML/hazard band per peril and CAT model' .

ind:FloodZone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Flood Zone' ;
    rdfs:comment 'FEMA National Flood Insurance Program (NFIP) flood zone classification. One row per FIRM panel zone. Carries flood zone designation (AE, VE, X), base flood elevation, FIRM panel number, and effective date for underwriting eligibility and rating.' .

ind:PmlRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Pml Run' ;
    rdfs:comment 'A probabilistic PML modeling run executed against the exposure portfolio. One row per run. Captures model vendor, model version, run date, return period set, gross and net PML at each return period, and the exposure snapshot used as input.' .

ind:PmlReturnPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Pml Return Period' ;
    rdfs:comment 'Individual return-period result within a PML run. One row per PML run per return period (e.g., 100-yr, 250-yr, 500-yr). Stores gross loss, ceded loss, net retained loss, AAL, and coefficient of variation for reinsurance treaty sizing.' .

ind:AccumulationLimit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Accumulation Limit' ;
    rdfs:comment 'Insurer-defined maximum aggregate exposure limit per CAT zone, peril, and LOB. One row per zone per peril per LOB. Enforces underwriting appetite constraints; triggers referral or declination when TIV in zone exceeds the approved accumulation cap.' .

ind:CatModelVersion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Cat Model Version' ;
    rdfs:comment 'Reference record for a CAT model vendor version (e.g., RMS v23, AIR Touchstone 2024). One row per vendor per version. Tracks release date, supported perils, geographic coverage, and the effective date range for which results are authoritative.' .

ind:PolicyCatExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Policy Cat Exposure' ;
    rdfs:comment 'Association linking an in-force policy to a CAT event or CAT zone for exposure tracking. One row per policy per CAT event or zone. Carries TIV, coverage type, and estimated gross loss used in FNOL triage and reinsurance bordereaux generation.' .

ind:IsoCatSerial rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Iso Cat Serial' ;
    rdfs:comment 'ISO-assigned CAT serial number record for a recognized industry CAT event. One row per ISO CAT serial. Carries ISO serial number, event name, peril, date range, affected states, and industry insured loss estimate for statutory CAT reporting.' .

ind:Submission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Submission' ;
    rdfs:comment 'ACORD 125/126/140 submission record capturing prospect risk information submitted for UW evaluation. Grain: one row per submission. Tracks source, status, line of business, and submission date.' .

ind:SubmissionParty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Submission Party' ;
    rdfs:comment 'Associates parties (applicant, named insured, additional insured, producer) to a submission with role and effective dates. Junction table carrying role-specific UW attributes per submission.' .

ind:UwDecision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Uw Decision' ;
    rdfs:comment 'Underwriter accept/decline/refer/modify decision for a submission or quote, including referral escalation (absorbs uw_referral): assigned UW, priority, SLA due date, resolution. Grain: one row per UW decision event.' .

ind:UwReferral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Uw Referral' ;
    rdfs:comment 'Tracks submissions or quotes escalated beyond standard UW authority for senior review. Captures referral reason, assigned UW, priority, SLA due date, and resolution outcome.' .

ind:RiskAppetiteRule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Risk Appetite Rule' ;
    rdfs:comment 'Business-managed, versioned, effective-dated UW governance (absorbs uw_guideline): eligibility/appetite rules, guideline criteria, class restrictions, mandatory-endorsement and pricing constraints by LOB, state, and class that trigger accept, decline, or' .

ind:EligibilityCheck rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Eligibility Check' ;
    rdfs:comment 'Records the outcome of automated eligibility and risk appetite screening for a submission. Grain: one row per eligibility evaluation. Captures rule set version, pass/fail flags, and triggered rule IDs.' .

ind:UnderwritingRiskScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Underwriting Risk Score' ;
    rdfs:comment 'UW risk scoring result for a submission or insured risk. Grain: one row per scoring event. Captures model version, composite score, component scores (COPE, MVR, CLUE), and score band classification.' .

ind:Quote rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Quote' ;
    rdfs:comment 'Priced insurance proposal generated from a submission. Grain: one row per quote. Captures quoted premium, LOB, effective date, expiration date, quote status, and binding eligibility flag.' .

ind:QuoteCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Quote Coverage' ;
    rdfs:comment 'Coverage line proposed within a quote: quoted limit, deductible, form number, and coverage-level premium. Junction between quote and coverage form. Grain: one row per coverage per quote; prevents premium fan-out.' .

ind:QuoteOption rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Quote Option' ;
    rdfs:comment 'Alternative pricing scenario or coverage option presented within a single quote (e.g., higher deductible, broader form). Enables multi-option proposals. One row per option per quote.' .

ind:RatingWorksheet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Rating Worksheet' ;
    rdfs:comment 'Detailed rating calculation produced by the rating engine for a quote or policy transaction: rate table version, base rate, surcharges, credits, and final rated premium. Grain: one row per rating run per quote.' .

ind:RatingFactor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Rating Factor' ;
    rdfs:comment 'Individual rating factor applied within a rating worksheet (e.g., territory factor, class factor, experience mod, schedule credit). One row per factor per worksheet. Supports full rate reconstruction.' .

ind:UwGuideline rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Uw Guideline' ;
    rdfs:comment 'Underwriting guideline document defining acceptable risk criteria, class restrictions, mandatory endorsements, and pricing constraints by LOB and state. Versioned and effective-dated for audit.' .

ind:UwCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Uw Condition' ;
    rdfs:comment 'Condition or requirement imposed by the underwriter on a submission or quote (e.g., loss control survey required, protective device warranty). Tracks fulfillment status and due date.' .

ind:LossHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Loss History' ;
    rdfs:comment 'Prior loss record for a submission or insured risk from CLUE, MVR, or applicant disclosure: loss date, cause, paid amount, open/closed status. Grain: one row per prior loss. Used in appetite and pricing.' .

ind:UnderwritingMvrReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Underwriting Mvr Report' ;
    rdfs:comment 'Motor Vehicle Record report ordered for a driver during auto UW. Captures report order date, source, violation count, license status, and UW impact flag. One row per MVR order.' .

ind:InspectionOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Inspection Order' ;
    rdfs:comment 'External UW report/order covering property inspection AND motor vehicle record (absorbs underwriting_mvr_report). Grain: one row per order. Captures order_type (interior/exterior/COPE/MVR), vendor, order date, status, findings, violation/license data, and' .

ind:ClearanceCheck rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Clearance Check' ;
    rdfs:comment 'Submission screening result covering duplicate/clearance detection AND eligibility/risk-appetite evaluation (absorbs eligibility_check). Grain: one row per screening event per submission.' .

ind:SubmissionDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Submission Document' ;
    rdfs:comment 'Document attached to a submission (ACORD applications, loss runs, photos, financials, schedules). Tracks document type, source, upload date, and review status. One row per document.' .

ind:BindRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Bind Request' ;
    rdfs:comment 'Formal request to bind a quoted policy, submitted by producer or applicant. Grain: one row per bind request. Captures requested effective date, payment plan, and bind confirmation or rejection reason.' .

ind:Binder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Binder' ;
    rdfs:comment 'Temporary insurance contract issued upon bind confirmation, providing coverage before the formal policy is issued. Captures binder number, effective/expiration dates, LOB, and issuing authority.' .

ind:SubmissionStatusHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Submission Status History' ;
    rdfs:comment 'Audit trail of submission status transitions (Received, In Review, Referred, Quoted, Bound, Declined, Withdrawn). One row per status change. Supports SLA tracking and workflow analytics.' .

ind:InsuredRisk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Insured Risk' ;
    rdfs:comment 'Supertype master for every insurable object underwritten on a policy. One row per insured risk. Subtypes property_risk and auto_risk extend it via shared PK (explicit subtype FK).' .

ind:PropertyRisk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Property Risk' ;
    rdfs:comment 'Property-line subtype of insured_risk. One row per property risk. Captures COPE attributes (Construction, Occupancy, Protection, Exposure), ITV, year built, square footage, and ISO construction class for rating and CAT modeling.' .

ind:Location rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Location' ;
    rdfs:comment 'Physical address and geocoded site associated with a property risk. One row per insured location. Stores street address, lat/long, FIPS code, territory code, flood zone, and links to geography hierarchy for CAT aggregation.' .

ind:Building rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Building' ;
    rdfs:comment 'Individual structure on an insured location. One row per building. Captures number of stories, roof type, roof year, frame type, sprinkler indicator, replacement cost value, and ISO building class for property rating.' .

ind:AutoRisk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Auto Risk' ;
    rdfs:comment 'Auto-line subtype of insured_risk. One row per auto risk unit. Captures garaging state, primary use, annual mileage, radius of operation, and links to vehicle and driver records for PAP and CA rating.' .

ind:Vehicle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Vehicle' ;
    rdfs:comment 'Motor vehicle associated with an auto risk. One row per vehicle. Stores VIN, year, make, model, body type, ISO symbol, stated value, anti-theft device indicator, and safety rating for auto rating and claims.' .

ind:Driver rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Driver' ;
    rdfs:comment 'Licensed operator associated with an auto risk. One row per driver. Captures license number/state, DOB, gender, marital status, years licensed, SR-22 indicator, and MVR order/receipt/status and clean-record fields (absorbed from mvr_report) for auto' .

ind:DriverViolation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Driver Violation' ;
    rdfs:comment 'Single SSOT for loss, violation, accident, and prior-loss history attached to a driver or insured risk, sourced from CLUE, MVR, or self-reported application data. One row per incident.' .

ind:RiskScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Point-in-time risk score attached to an insured risk for exposure grading. One row per scoring event per risk. Stores score value, model version, score date, component scores, and referral threshold flag.' .

ind:RiskInspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Inspection' ;
    rdfs:comment 'Physical or virtual inspection of an insured risk that produces exposure facts of record (condition, hazards, valuation checks). One row per inspection. Stores inspection type, ordered/completed dates, inspector party, findings summary, and recommendation' .

ind:RiskImprovement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Improvement' ;
    rdfs:comment 'Required or recommended risk improvement condition attached to an insured risk. One row per improvement item. Captures condition type, due date, compliance date, status, and premium impact for UW condition tracking.' .

ind:ExposureSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Exposure Schedule' ;
    rdfs:comment 'Scheduled list of insured risks or values attached to a policy term for commercial lines (location schedule, fleet schedule). One row per schedule entry per risk unit. Captures effective/expiration dates, scheduled value, and risk unit reference.' .

ind:RiskCharacteristic rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Characteristic' ;
    rdfs:comment 'Extensible per-risk attribute bag for line-specific characteristics not captured in core subtypes (pool presence, alarm type, business description, SIC/NAICS). One row per characteristic per insured risk. Enables new LOB onboarding without schema rebuild.' .

ind:Account rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Account' ;
    rdfs:comment 'Master billing account linking a policyholder or payee to invoicing and collections. One row per billing account. Tracks account type (direct bill, agency bill), status, payment method, and balance.' .

ind:Invoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Invoice' ;
    rdfs:comment 'Billing document issued to a policyholder or agency for premium charges, fees, and taxes due. One row per invoice. Grain: one invoice per billing cycle per billing account. Tracks due date, amount billed, and status.' .

ind:InvoiceItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Invoice Item' ;
    rdfs:comment 'Line-level detail on an invoice representing a single charge, tax, fee, or commission amount. One row per line item per invoice. Links to premium charge, coverage, and policy term for reconciliation.' .

ind:Payment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment' ;
    rdfs:comment 'Record of a payment received from a policyholder, agency, or third party against a billing account. One row per payment transaction. Captures payment method, amount, receipt date, and application status.' .

ind:PaymentApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Application' ;
    rdfs:comment 'Links a payment to one or more invoices or invoice items, and holds all unapplied/suspense cash pending identification of the correct account or invoice. One row per application or suspense holding.' .

ind:PaymentPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Plan' ;
    rdfs:comment 'Installment plan template defining the number of installments, down payment percentage, installment frequency, and applicable fees for a billing account or policy. Master record for plan configuration.' .

ind:InstallmentSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Installment Schedule' ;
    rdfs:comment 'Scheduled installment records generated for a billing account under a payment plan. One row per installment. Tracks scheduled due date, scheduled amount, actual paid amount, and installment status (due, paid, past due).' .

ind:ReturnedPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Returned Payment' ;
    rdfs:comment 'Record of a payment returned by the bank (NSF, stop payment, account closed). One row per returned payment event. Captures return reason code, return date, original payment reference, and any returned payment fee assessed.' .

ind:Delinquency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Delinquency' ;
    rdfs:comment 'Delinquency lifecycle for a billing account that missed installments, including all workflow actions (past-due, cancellation, reinstatement, write-off trigger) and notices issued during collections. One row per delinquency event per account.' .

ind:DelinquencyAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Delinquency Action' ;
    rdfs:comment 'Individual workflow action taken within a delinquency process (notice issued, cancellation initiated, reinstatement offered, write-off triggered). One row per action per delinquency. Tracks action type, action date, and outcome.' .

ind:WriteOff rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Write Off' ;
    rdfs:comment 'Record of a premium balance written off as uncollectible. One row per write-off transaction. Captures write-off amount, write-off reason (bad debt, small balance, regulatory), approval authority, and accounting period.' .

ind:Disbursement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Disbursement' ;
    rdfs:comment 'Outbound payment to a producer, claimant, or payee, including producer commission payable pending settlement. One row per disbursement. Captures payee party, producer, policy, disbursement type (commission, refund, return premium), earned/withheld amount' .

ind:CommissionPayable rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Commission Payable' ;
    rdfs:comment 'Payable record for producer commission earned on a policy or premium transaction, pending disbursement. One row per commission payable. Tracks producer, policy, earned amount, withheld amount, and settlement status.' .

ind:BillingTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Billing Transaction' ;
    rdfs:comment 'Atomic financial movement posted to a billing account (charge, credit, payment, reversal, fee, tax, write-off). One row per financial movement. Single ledger SSOT for account balance; payment, invoice_item, and write_off post here via enforced FK for' .

ind:Notice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Notice' ;
    rdfs:comment 'Regulatory or contractual notice generated and sent to a policyholder during the billing lifecycle (invoice notice, past-due notice, cancellation notice, reinstatement notice). One row per notice. Tracks notice type, send date, and delivery channel.' .

ind:PaymentMethod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Stored payment instrument on file for a billing account (credit card, ACH/EFT, check, escrow). One row per payment method per billing account. Captures instrument type, masked account details, expiry, and EFT authorization status.' .

ind:AccountPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Account Policy' ;
    rdfs:comment 'Association linking a billing account to one or more policies. One row per billing-account-to-policy relationship. Supports agency bill and direct bill splits, and multi-policy billing account consolidation.' .

ind:EscrowAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Escrow Account' ;
    rdfs:comment 'Escrow account record for mortgagee-billed policies where a lender collects and remits premium. One row per escrow account. Tracks lender party, escrow balance, disbursement schedule, and reconciliation status.' .

ind:SuspenseItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Suspense Item' ;
    rdfs:comment 'Unallocated payment or credit held in suspense pending identification of the correct billing account or invoice. One row per suspense item. Tracks received amount, source, suspense reason, and resolution date.' .

ind:Coverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage' ;
    rdfs:comment 'One row per coverage per policy term. Bridge between the policy contract and insured risk. Captures coverage type, LOB, form number, effective/expiration dates, and status. Links to Policy Term and Insured Risk.' .

ind:Limit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Limit' ;
    rdfs:comment 'Limit attached to a coverage: occurrence limit, aggregate limit, per-person limit, split limits. Supports stacked, CSL, and sublimit structures. One row per limit per coverage.' .

ind:Deductible rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Deductible' ;
    rdfs:comment 'Deductible attached to a coverage: flat, percentage, SIR, or disappearing. Captures amount, basis, application method, and waiver flags. One row per deductible per coverage.' .

ind:Exclusion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Exclusion' ;
    rdfs:comment 'Exclusion attached to a coverage: ISO or manuscript exclusion code, description, endorsement reference, and effective dates. One row per exclusion per coverage.' .

ind:CoverageCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Condition' ;
    rdfs:comment 'Condition attached to a coverage: coinsurance, reporting, inspection, warranty, or margin clause. SOLE owner of coinsurance percentage, agreed-value indicator, margin percentage, penalty method, plus clause text, compliance status, and effective dates.' .

ind:CoverageForm rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Form' ;
    rdfs:comment 'ISO or manuscript form attached to a coverage or policy term. Tracks form number, edition date, form type (base, endorsement, exclusion), and filing status with the DOI.' .

ind:Part rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Part' ;
    rdfs:comment 'Named coverage part within a CPP or BOP (e.g., Commercial Property, CGL, Commercial Auto). Groups coverages under a single policy package. One row per coverage part per policy term.' .

ind:CoverageEndorsement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Endorsement' ;
    rdfs:comment 'Endorsement modifying a base coverage: endorsement number, form reference, effective date, premium impact, and change description. One row per endorsement per coverage.' .

ind:AdditionalInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Additional Interest' ;
    rdfs:comment 'Additional interest or additional insured attached to a coverage: party reference, interest type (AI, loss payee, mortgagee, lienholder), certificate holder flag, and effective dates.' .

ind:Rate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Rate' ;
    rdfs:comment 'Rate element applied to a coverage during pricing: rate code, rate basis, rate value, territory factor, class factor, and effective date. Supports reconstruction of premium at any point in time.' .

ind:CoverageType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'Reference catalog of coverage types: coverage code, name, LOB, ISO coverage symbol, mandatory/optional flag. Standardizes coverage classification across lines. One row per coverage type.' .

ind:CoveragePeril rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Peril' ;
    rdfs:comment 'Reference catalog of insured perils: peril code, name, peril group (fire, wind, flood, theft, liability), CAT indicator, and NAIC peril classification. Referenced by coverage_peril_link and claims. One row per peril.' .

ind:PerilLink rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Peril Link' ;
    rdfs:comment 'Association between a coverage and the perils it insures. Captures whether the peril is included or excluded, sublimit override, and deductible override at the peril level. One row per peril per coverage.' .

ind:LossEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Loss Event' ;
    rdfs:comment 'Master record of a physical loss occurrence (storm, fire, collision, liability event). One row per occurrence. Links multiple claims arising from the same event. Supports CAT aggregation and PML analysis.' .

ind:Claim rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim' ;
    rdfs:comment 'Core claim record. Grain: one row per reported loss. Captures FNOL intake, line of business, accident date, report date, status, and FK links to policy, loss_event, and reinsurance cession keys for recovery linkage.' .

ind:Claimant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claimant' ;
    rdfs:comment 'Party involved in a claim as first-party insured or third-party claimant. Grain: one row per party per claim. Captures claimant type (FP/TP), injury or damage description, and links to Party domain.' .

ind:ClaimExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Exposure' ;
    rdfs:comment 'Coverage line within a claim. Grain: one row per coverage per claim. Junction between Claim and Coverage/Insured Risk. Drives all financial postings; prevents fan-out double-counting of reserves and payments.' .

ind:ClaimStatus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Status' ;
    rdfs:comment 'Lifecycle status history for a claim. Grain: one row per status transition per claim. Tracks Open, Pending, Closed, Reopened, Denied, Litigated transitions with effective timestamps and reason codes.' .

ind:Adjuster rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Adjuster' ;
    rdfs:comment 'Staff or independent adjuster assigned to handle claims. Captures adjuster type (staff/IA/TPA), license number, state appointments, assignment capacity, and links to Party domain for identity.' .

ind:AdjusterAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Adjuster Assignment' ;
    rdfs:comment 'Assignment of an adjuster to a claim or claim exposure. Grain: one row per assignment. Tracks assignment date, reassignment reason, workload at assignment, and primary vs supervisory role. FK to adjuster and claim.' .

ind:Fnol rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Fnol' ;
    rdfs:comment 'First Notice of Loss intake record. Grain: one row per FNOL submission. Captures report channel, reporter party, initial loss description, date/time of loss, and triage flags before a formal claim is opened.' .

ind:Litigation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Litigation' ;
    rdfs:comment 'Litigation record attached to a claim. Tracks lawsuit filing date, plaintiff attorney, defense counsel, court jurisdiction, trial date, verdict, and settlement amount. One row per lawsuit per claim.' .

ind:SiuReferral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Siu Referral' ;
    rdfs:comment 'Special Investigations Unit referral for a claim suspected of fraud. Grain: one row per referral. Captures referral reason, SIU analyst assigned, investigation outcome, and disposition (confirmed fraud, cleared, pending). FK to claim.' .

ind:ClaimNote rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Note' ;
    rdfs:comment 'Diary and activity notes recorded against a claim or claim exposure. Grain: one row per note entry. Captures author, note type (diary, coverage, legal, medical), entry timestamp, and visibility classification.' .

ind:ClaimDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Document' ;
    rdfs:comment 'Documents attached to a claim: police reports, medical records, repair estimates, photos, demand letters. Grain: one row per document. Captures document type, source, received date, and storage reference.' .

ind:MedicalBill rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Medical Bill' ;
    rdfs:comment 'Medical bill submitted against a bodily injury or workers comp claim exposure. Grain: one row per bill. Captures provider, procedure codes, billed amount, allowed amount, paid amount, and bill review outcome.' .

ind:RepairEstimate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Repair Estimate' ;
    rdfs:comment 'Property or auto repair estimate associated with a claim exposure. Grain: one row per estimate. Captures estimator, repair facility, estimate date, line-item costs, agreed value, and supplement history.' .

ind:SalvageDisposition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Salvage Disposition' ;
    rdfs:comment 'Recovery-pursuit record per claim exposure covering both salvage disposition (auto total-loss, damaged goods) and subrogation against liable third parties. Grain: one row per recovery item.' .

ind:Currency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Currency' ;
    rdfs:comment 'Reference catalog of ISO 4217 currencies used across premium, claim, billing, and reinsurance financial transactions. One row per currency code. Carries code, name, minor unit, and active flag.' .

ind:LineOfBusiness rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Line Of Business' ;
    rdfs:comment 'Reference catalog of P&C lines of business (HO, PAP, CGL, BOP, CPP, WC, Commercial Auto, Umbrella). One row per LOB. SSOT for LOB codes referenced by policy, coverage, premium, claim, and reinsurance.' .

ind:Calendar rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Calendar' ;
    rdfs:comment 'Enterprise calendar reference of fiscal, accident, policy, and calendar-year periods. One row per period. Complements domain-local accounting_period tables by providing a single cross-domain date dimension.' .

ind:UnitOfMeasure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'Reference catalog of units of measure (square footage, mileage, payroll, sales receipts) used as premium exposure bases. One row per UoM. SSOT for exposure-basis units across rating and premium audit.' .

ind:ClassificationCode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Classification Code' ;
    rdfs:comment 'Reference catalog of industry classification codes (ISO GL class, WC class, SIC, NAICS) used for rating and eligibility. One row per class code. SSOT consumed by underwriting, coverage rate, and premium.' .

ind:CatEventZoneImpact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Cat Event Zone Impact' ;
    rdfs:comment 'Records the impact of a catastrophe event on a specific CAT zone. One row per event per zone. Captures modeled loss, exposure metrics, physical parameters, and timestamps for loss estimation, reinsurance triggers, and regulatory reporting..' .

ind:CatastropheEventGeographyExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Catastrophe Event Geography Exposure' ;
    rdfs:comment 'Association between catastrophe events and affected geographies capturing exposure metrics. One row per catastrophe event per geography unit. Tracks TIV, policy count, insured risk count, concentration index, PML, AAL, and premium for each event-geography' .

ind:CoverageInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Interest' ;
    rdfs:comment 'One row per party-role per coverage. Captures the insurable interest a party holds in a specific coverage, including interest type, role, effective dates, and interest percentage. Enables multiple parties with different interests on one coverage..' .

ind:CoverageCession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Cession' ;
    rdfs:comment 'One row per coverage per treaty layer. Records the reinsurance placement linking a ceded coverage to a specific treaty layer with cession terms, attachment point, limit, and retention amount..' .

ind:Eligibility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Eligibility' ;
    rdfs:comment 'Association between coverage types and reinsurance agreements defining which coverages are eligible for cession under each treaty or facultative agreement. One row per coverage type per agreement..' .

ind:ProducerCoverageAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Producer Coverage Authority' ;
    rdfs:comment 'Binding authority granted to a producer for a specific coverage type. Captures authority level, binding limits, effective dates, and referral thresholds per producer-coverage combination. One row per producer per coverage type per authority period..' .

ind:AgencyCoverageAppointment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Agency Coverage Appointment' ;
    rdfs:comment 'Represents the appointment authority granting an agency the right to write a specific coverage type. Captures commission rate, binding authority, limits, and appointment status per agency-coverage combination. One row per agency per coverage type..' .

ind:TypePeril rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Type Peril' ;
    rdfs:comment 'Defines which perils are covered under each coverage type, with peril-specific deductible structures, sublimits, and coverage triggers. One row per coverage type per applicable peril..' .

ind:RateTableAuthorization rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Rate Table Authorization' ;
    rdfs:comment 'Grants a producer or agency the authority to use a specific rate table for binding coverage. One row per producer-rate_table authorization. Tracks effective dates, expiration, override permissions, and deviation limits for that combination..' .

ind:TreatyLayerPerilTerm rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty Layer Peril Term' ;
    rdfs:comment 'Captures peril-specific reinsurance terms within a treaty layer. Each record links one treaty layer to one peril with attachment points, limits, retention, cession percentages, and rates that vary by peril..' .

ind:AgreementPerilCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Agreement Peril Coverage' ;
    rdfs:comment 'Captures which perils are covered, excluded, or subject to special terms within each reinsurance agreement. One row per agreement per peril. Tracks inclusion/exclusion flags, peril-specific sublimits, retentions, and clauses..' .

ind:TreatyZoneTerms rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty Zone Terms' ;
    rdfs:comment 'Defines zone-specific reinsurance treaty terms for catastrophe exposure management. One row per treaty per cat zone. Captures zone-level cession percentages, retentions, attachment points, limits, and exclusions used for underwriting guidelines and' .

ind:FacultativeQuotation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Facultative Quotation' ;
    rdfs:comment 'Captures each reinsurer\'s quoted terms for a specific facultative submission quote. Grain: one row per quote per reinsurer. Stores quoted share, premium, acceptance status, and quote date for facultative placement..' .

ind:FacultativeMarketing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Facultative Marketing' ;
    rdfs:comment 'Tracks facultative reinsurance marketing activity per submission. Each record links one submission to one reinsurer approached for facultative interest, capturing contact date, interest level, and indicative terms provided during the marketing phase..' .

ind:PolicyProducerPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Producer Policy' ;
    rdfs:comment 'Association between producers and policies capturing the producer\'s role, commission terms, and servicing rights. One row per producer per policy. Tracks writing, servicing, and split commission arrangements across the policy lifecycle..' .

ind:ProducerAgencyAppointment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Agency Appointment' ;
    rdfs:comment 'Association between a producer and an agency capturing appointment-specific authority, commission splits, and LOB restrictions. One row per producer per agency appointment.' .

ind:CoverageTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Transaction' ;
    rdfs:comment 'Event recording a policy transaction\'s impact on a specific coverage. One row per coverage per transaction. Captures transaction-specific changes: premium delta, limit adjustments, effective dates, and status changes for audit and endorsement processing..' .

ind:FormAttachment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Form Attachment' ;
    rdfs:comment 'One row per form attached to a coverage. Captures the attachment of ISO/ACORD forms and endorsements to specific coverages, recording attachment sequence, effective dates, mandatory status, and premium impact per coverage..' .

ind:NoticeTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Notice Template' ;
    rdfs:comment 'Master reference table for notice_template. Referenced by template_id.' .

ind:SharedLimitGroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Shared Limit Group' ;
    rdfs:comment 'Master reference table for shared_limit_group. Referenced by shared_limit_group_id.' .

ind:RatingRuleSet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Rating Rule Set' ;
    rdfs:comment 'Master reference table for rating_rule_set. Referenced by rating_rule_set_id.' .

ind:Household rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Household' ;
    rdfs:comment 'Master reference table for household. Referenced by household_id.' .

ind:PartyGroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Party Group' ;
    rdfs:comment 'Master reference table for party_group. Referenced by group_id.' .

ind:DocumentTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Document Template' ;
    rdfs:comment 'Master reference table for document_template. Referenced by template_id.' .

# --- Attribute Properties ---
ind:accountId rdf:type rdf:Property ;
    rdfs:label 'Account Id' ;
    rdfs:comment 'Unique identifier for the billing account. Primary key.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingAddressId rdf:type rdf:Property ;
    rdfs:label 'Billing Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Billing accounts require validated billing address distinct from policyholder address for invoice delivery, collections correspondence, and regulatory cancellation notices.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:currencyId rdf:type rdf:Property ;
    rdfs:label 'Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: Billing accounts maintain balances in specific currencies and require currency master data for balance calculations, aging reports, and multi-currency consolidation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:geographyId rdf:type rdf:Property ;
    rdfs:label 'Geography Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.geography. Business justification: Account billing geography determines tax jurisdiction codes, payment plan regulatory eligibility, escheatment rules, and state-specific billing regulations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:partyId rdf:type rdf:Property ;
    rdfs:label 'Party Id' ;
    rdfs:comment 'Reference to the party (policyholder or payee) who owns this billing account.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:policyId rdf:type rdf:Property ;
    rdfs:label 'Policy Id' ;
    rdfs:comment 'Reference to the policy associated with this billing account.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:producersProducerId rdf:type rdf:Property ;
    rdfs:label 'Producers Producer Id' ;
    rdfs:comment 'Reference to the producer or agent responsible for this account, used for commission allocation and servicing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:submissionId rdf:type rdf:Property ;
    rdfs:label 'Submission Id' ;
    rdfs:comment 'Foreign key linking to coverage.submission. Business justification: Billing accounts are often established during underwriting for quoted business to prepare payment collection infrastructure before binding.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Submission .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the billing account indicating whether it is active, suspended, closed, delinquent, pending activation, or cancelled.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of billing account indicating who collects premium: direct bill (insurer bills policyholder), agency bill (producer collects), list bill, or account current.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Enabled' ;
    rdfs:comment 'Indicates whether automatic payment processing is enabled for this account. True means payments are automatically withdrawn on due date.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingContactName rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Name' ;
    rdfs:comment 'Name of the person or entity designated to receive billing communications and invoices for this account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingEmail rdf:type rdf:Property ;
    rdfs:label 'Billing Email' ;
    rdfs:comment 'Email address for delivery of electronic invoices, payment confirmations, and billing notices.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'Frequency at which invoices are generated for this account: monthly, quarterly, semi-annual, annual, or on-demand.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingMethod rdf:type rdf:Property ;
    rdfs:label 'Billing Method' ;
    rdfs:comment 'Method by which the policyholder is billed: invoice, automatic payment, payroll deduction, escrow, or mortgagee bill.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPhone rdf:type rdf:Property ;
    rdfs:label 'Billing Phone' ;
    rdfs:comment 'Primary phone number for billing inquiries, payment reminders, and delinquency notifications.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date the billing account was cancelled, either due to policy cancellation, non-payment, or policyholder request.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Business reason for account cancellation: non-payment, policy cancellation, policyholder request, fraud, or other. [ENUM-REF-CANDIDATE: non_payment|policy_cancelled|policyholder_request|fraud|underwriting|rewrite|duplicate|other — promote to reference' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionPayableFlag rdf:type rdf:Property ;
    rdfs:label 'Commission Payable Flag' ;
    rdfs:comment 'Indicates whether producer commission is payable on premium collected through this account. False for direct accounts with no producer involvement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Date and time this billing account record was first created in the system.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:creditBalance rdf:type rdf:Property ;
    rdfs:label 'Credit Balance' ;
    rdfs:comment 'Total credit amount available on the account from overpayments, return premiums, or cancellations. Positive value indicates credit owed to policyholder.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'Current outstanding balance on the account, representing total amount owed by the policyholder. Positive indicates amount due; negative indicates credit.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'Number of days the oldest unpaid invoice on this account is overdue. Zero indicates account is current.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delinquencyStatus rdf:type rdf:Property ;
    rdfs:label 'Delinquency Status' ;
    rdfs:comment 'Classification of account delinquency based on days past due: current, 1-30 days, 31-60 days, 61-90 days, over 90 days, or in collections.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'Date the billing account became active and began accepting charges and payments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date the billing account is scheduled to close or expire, typically aligned with policy expiration or account closure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after payment due date before policy cancellation for non-payment is initiated, as required by state regulation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'Monetary amount of the most recent payment received on this account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date the most recent payment was received and posted to this account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Next Invoice Date' ;
    rdfs:comment 'Scheduled date for the next invoice to be generated for this account based on billing frequency and payment plan.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Payment Due Date' ;
    rdfs:comment 'Date by which the next payment is due to avoid delinquency or late fees.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:number rdf:type rdf:Property ;
    rdfs:label 'Number' ;
    rdfs:comment 'Externally visible unique account number assigned to the billing account for customer reference and payment processing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outstandingFees rdf:type rdf:Property ;
    rdfs:label 'Outstanding Fees' ;
    rdfs:comment 'Total unpaid fees currently due on this account, including installment fees, late fees, and service charges.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingPremium rdf:type rdf:Property ;
    rdfs:label 'Outstanding Premium' ;
    rdfs:comment 'Total unpaid premium amount currently due on this account, excluding fees, taxes, and other charges.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingTaxes rdf:type rdf:Property ;
    rdfs:label 'Outstanding Taxes' ;
    rdfs:comment 'Total unpaid taxes currently due on this account, including premium taxes, surplus lines taxes, and stamping fees.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paperlessBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Flag' ;
    rdfs:comment 'Indicates whether the policyholder has opted for electronic delivery of invoices and billing statements instead of paper mail.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Preferred payment instrument for this account: credit card, debit card, ACH (Automated Clearing House), check, wire transfer, or cash.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPlanType rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Type' ;
    rdfs:comment 'Installment plan structure for premium payments: full pay, monthly, quarterly, semi-annual, or custom installment schedule.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unappliedCash rdf:type rdf:Property ;
    rdfs:label 'Unapplied Cash' ;
    rdfs:comment 'Amount of cash received but not yet applied to specific invoices or charges, held in suspense pending allocation.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Date and time this billing account record was last modified or updated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Total amount written off as uncollectible on this account due to bankruptcy, insolvency, or collection failure.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'Date the uncollectible balance was written off and removed from accounts receivable.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountPolicyId rdf:type rdf:Property ;
    rdfs:label 'Account Policy Id' ;
    rdfs:comment 'Unique identifier for the billing account to policy association. One row per billing-account-to-policy relationship.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyId rdf:type rdf:Property ;
    rdfs:label 'Agency Id' ;
    rdfs:comment 'Reference to the agency responsible for this policy within the billing account context.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:billToPartyId rdf:type rdf:Property ;
    rdfs:label 'Bill To Party Id' ;
    rdfs:comment 'Reference to the party who receives invoices for this policy. May differ from policyholder in agency bill scenarios.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:billingAccountId rdf:type rdf:Property ;
    rdfs:label 'Billing Account Id' ;
    rdfs:comment 'Reference to the billing account that owns this policy relationship.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:paymentPlanId rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Id' ;
    rdfs:comment 'Reference to the payment plan governing this policy on the billing account.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentPlan .

ind:policyholderId rdf:type rdf:Property ;
    rdfs:label 'Policyholder Id' ;
    rdfs:comment 'Reference to the policyholder party for this policy. Captured for reporting and reconciliation purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policyholder .

ind:addedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Added By User Code' ;
    rdfs:comment 'Identifier of the user who added this policy to the billing account.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Method used to allocate payments across policies on this billing account.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'Percentage of account-level payments to allocate to this policy. Used for proportional allocation rules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationPriority rdf:type rdf:Property ;
    rdfs:label 'Allocation Priority' ;
    rdfs:comment 'Priority order for allocating payments when multiple policies exist on the same billing account. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cancellationNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Date' ;
    rdfs:comment 'Date when a cancellation notice was issued for this policy due to non-payment on the billing account.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationPendingFlag rdf:type rdf:Property ;
    rdfs:label 'Cancellation Pending Flag' ;
    rdfs:comment 'Indicates whether this policy is pending cancellation due to billing account delinquency.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consolidationFlag rdf:type rdf:Property ;
    rdfs:label 'Consolidation Flag' ;
    rdfs:comment 'Indicates whether this policy is part of a multi-policy consolidated billing arrangement.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delinquencyFlag rdf:type rdf:Property ;
    rdfs:label 'Delinquency Flag' ;
    rdfs:comment 'Indicates whether this policy is currently delinquent on the billing account.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReferenceCode rdf:type rdf:Property ;
    rdfs:label 'External Reference Code' ;
    rdfs:comment 'External system reference identifier for this account-policy relationship. Used for integration and reconciliation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Installment Billing Flag' ;
    rdfs:comment 'Indicates whether this policy is billed on an installment basis within the billing account.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-form notes regarding this account-policy relationship. Used for special billing instructions or exceptions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipStatus rdf:type rdf:Property ;
    rdfs:label 'Relationship Status' ;
    rdfs:comment 'Current lifecycle status of the account-to-policy association.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'Type of relationship between the billing account and policy. Supports multi-policy consolidation and split billing scenarios.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:removedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Removed By User Code' ;
    rdfs:comment 'Identifier of the user who removed this policy from the billing account.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Code identifying the source billing system that created this account-policy relationship.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:splitBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Split Billing Flag' ;
    rdfs:comment 'Indicates whether this policy uses split billing between direct bill and agency bill methods.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Date when the account-policy relationship was terminated due to cancellation, non-renewal, or account closure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:terminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Code' ;
    rdfs:comment 'Code indicating why the account-policy relationship was terminated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Description' ;
    rdfs:comment 'Detailed explanation of why the account-policy relationship was terminated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeId rdf:type rdf:Property ;
    rdfs:label 'Notice Id' ;
    rdfs:comment 'Unique identifier for the billing notice record. Primary key.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Notice .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Reference to the invoice that triggered this notice, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:partyDocumentId rdf:type rdf:Property ;
    rdfs:label 'Party Document Id' ;
    rdfs:comment 'Reference to the generated document or PDF file stored in the document management system.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PartyDocument .

ind:recipientContactId rdf:type rdf:Property ;
    rdfs:label 'Recipient Contact Id' ;
    rdfs:comment 'Foreign key linking to party.contact. Business justification: Billing notices must be sent to verified contact records with opt-in status, deliverability tracking, and consent compliance.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contact .

ind:noticeTemplateId rdf:type rdf:Property ;
    rdfs:label 'Notice Template Id' ;
    rdfs:comment 'Reference to the template used to generate this notice, for consistency and compliance tracking.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NoticeTemplate .

ind:amountDue rdf:type rdf:Property ;
    rdfs:label 'Amount Due' ;
    rdfs:comment 'The total amount due as stated in the notice, if applicable.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:body rdf:type rdf:Property ;
    rdfs:label 'Body' ;
    rdfs:comment 'The full text content or body of the notice message sent to the policyholder.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Effective Date' ;
    rdfs:comment 'The effective date of policy cancellation, if this is a cancellation notice.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'The code representing the reason for cancellation, if this is a cancellation notice.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Description' ;
    rdfs:comment 'The detailed description of the reason for cancellation, if this is a cancellation notice.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the amounts stated in the notice.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'The channel or method used to deliver the notice to the policyholder: mail, email, SMS, online portal, fax, or courier.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Date' ;
    rdfs:comment 'The date the notice was confirmed delivered to the policyholder, if delivery confirmation is available.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'The format or medium of the notice delivery: electronic, paper, or hybrid.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Delivery Status' ;
    rdfs:comment 'The status of the delivery attempt: pending, delivered, bounced, undeliverable, or read.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'The URL or file path where the notice document can be accessed or retrieved.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'The date by which payment is due, as communicated in the notice.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:failureReason rdf:type rdf:Property ;
    rdfs:label 'Failure Reason' ;
    rdfs:comment 'The reason the notice delivery failed, if applicable.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Generated By User Code' ;
    rdfs:comment 'The user or system account that generated or triggered the notice.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:language rdf:type rdf:Property ;
    rdfs:label 'Language' ;
    rdfs:comment 'Two-letter ISO 639-1 language code indicating the language in which the notice was generated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRetryDate rdf:type rdf:Property ;
    rdfs:label 'Last Retry Date' ;
    rdfs:comment 'The date of the most recent delivery retry attempt.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeDate rdf:type rdf:Property ;
    rdfs:label 'Notice Date' ;
    rdfs:comment 'The date the notice was generated or issued by the billing system.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeNumber rdf:type rdf:Property ;
    rdfs:label 'Notice Number' ;
    rdfs:comment 'Externally visible unique number assigned to this billing notice for tracking and reference purposes.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeStatus rdf:type rdf:Property ;
    rdfs:label 'Notice Status' ;
    rdfs:comment 'Current lifecycle status of the notice: draft, pending, sent, delivered, failed, or cancelled.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeType rdf:type rdf:Property ;
    rdfs:label 'Notice Type' ;
    rdfs:comment 'Classification of the notice indicating its purpose: invoice notice, past-due notice, cancellation notice, reinstatement notice, payment reminder, or non-renewal notice.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'The total outstanding balance on the billing account at the time the notice was generated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'The state or jurisdiction whose regulations govern this notice requirement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Required Flag' ;
    rdfs:comment 'Indicates whether this notice is required by state or federal regulation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementDeadline rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Deadline' ;
    rdfs:comment 'The deadline by which the policyholder must act to reinstate the policy, if this is a reinstatement notice.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retryCount rdf:type rdf:Property ;
    rdfs:label 'Retry Count' ;
    rdfs:comment 'The number of times delivery of this notice has been attempted.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sendDate rdf:type rdf:Property ;
    rdfs:label 'Send Date' ;
    rdfs:comment 'The date the notice was actually sent or transmitted to the policyholder.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sendTimestamp rdf:type rdf:Property ;
    rdfs:label 'Send Timestamp' ;
    rdfs:comment 'The precise timestamp when the notice was sent or transmitted to the policyholder.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sentByUserCode rdf:type rdf:Property ;
    rdfs:label 'Sent By User Code' ;
    rdfs:comment 'The user or system account that sent or transmitted the notice.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subject rdf:type rdf:Property ;
    rdfs:label 'Subject' ;
    rdfs:comment 'The subject line or title of the notice, summarizing its purpose for the recipient.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateVersion rdf:type rdf:Property ;
    rdfs:label 'Template Version' ;
    rdfs:comment 'The version number of the template used to generate this notice, for audit and compliance purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingTransactionId rdf:type rdf:Property ;
    rdfs:label 'Billing Transaction Id' ;
    rdfs:comment 'Unique identifier for the billing transaction. Primary key.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingTransaction .

ind:claimfinancialsAccountingPeriodId rdf:type rdf:Property ;
    rdfs:label 'Claimfinancials Accounting Period Id' ;
    rdfs:comment 'Reference to the accounting period in which this transaction is recognized.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimfinancialsAccountingPeriod .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Reference to the payment record if this transaction represents a payment posting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:policyTermId rdf:type rdf:Property ;
    rdfs:label 'Policy Term Id' ;
    rdfs:comment 'Reference to the specific policy term period for this transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Term .

ind:reversedTransactionBillingTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Transaction Billing Transaction Id' ;
    rdfs:comment 'Reference to the original transaction that this transaction reverses, if applicable.' ;
    rdfs:domain ind:BillingTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingTransaction .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'Monetary value of the transaction. Positive for debits (charges), negative for credits (payments, reversals).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Balance Impact Amount' ;
    rdfs:comment 'Net impact of this transaction on the billing account balance. Signed value reflecting debit or credit effect.' ;
    rdfs:domain ind:BillingTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeCode rdf:type rdf:Property ;
    rdfs:label 'Charge Code' ;
    rdfs:comment 'Specific code identifying the type of charge, fee, or tax represented by this transaction.' ;
    rdfs:domain ind:BillingTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeDescription rdf:type rdf:Property ;
    rdfs:label 'Charge Description' ;
    rdfs:comment 'Human-readable description of the charge, fee, tax, or financial movement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUserCode rdf:type rdf:Property ;
    rdfs:label 'Created By User Code' ;
    rdfs:comment 'Identifier of the user or system process that created this transaction record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debitCreditIndicator rdf:type rdf:Property ;
    rdfs:label 'Debit Credit Indicator' ;
    rdfs:comment 'Indicates whether the transaction is a debit (increases balance owed) or credit (decreases balance owed).' ;
    rdfs:domain ind:BillingTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'General ledger account code to which this transaction is posted for financial reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Modified By User Code' ;
    rdfs:comment 'Identifier of the user or system process that last modified this transaction record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Date and time when this transaction record was last modified.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'Date when the transaction was posted to the general ledger for accounting purposes.' ;
    rdfs:domain ind:BillingTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'Date when the reversal transaction was executed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this transaction is a reversal of a previous transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'Code indicating the reason for reversing the original transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Description' ;
    rdfs:comment 'Detailed explanation of why the transaction was reversed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseFlag rdf:type rdf:Property ;
    rdfs:label 'Suspense Flag' ;
    rdfs:comment 'Indicates whether this transaction is held in suspense pending allocation or resolution.' ;
    rdfs:domain ind:BillingTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suspenseReasonCode rdf:type rdf:Property ;
    rdfs:label 'Suspense Reason Code' ;
    rdfs:comment 'Code indicating why the transaction is held in suspense (e.g., unidentified payment, policy not found).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'Business date when the transaction occurred or was effective.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'Human-readable unique transaction number for external reference and audit trail.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle status of the transaction in the billing ledger.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transaction Timestamp' ;
    rdfs:comment 'Precise date and time when the transaction was recorded in the billing system.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Classification of the financial movement: charge, credit, payment, reversal, adjustment, fee, tax, commission, or write-off. [ENUM-REF-CANDIDATE: charge|credit|payment|reversal|adjustment|fee|tax|commission|write_off — 9 candidates stripped; promote to' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffFlag rdf:type rdf:Property ;
    rdfs:label 'Write Off Flag' ;
    rdfs:comment 'Indicates whether this transaction represents a write-off of uncollectible amounts.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:writeOffReasonCode rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason Code' ;
    rdfs:comment 'Code indicating the reason for writing off the amount (e.g., bankruptcy, uncollectible, small balance).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionPayableId rdf:type rdf:Property ;
    rdfs:label 'Commission Payable Id' ;
    rdfs:comment 'Unique identifier for the commission payable record. Primary key.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimId rdf:type rdf:Property ;
    rdfs:label 'Claim Id' ;
    rdfs:comment 'Foreign key linking to claims.claim. Business justification: Commission clawback/adjustments occur when large claims make a policy unprofitable after commission was paid. Producers may owe back commission.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:commissionId rdf:type rdf:Property ;
    rdfs:label 'Commission Id' ;
    rdfs:comment 'Foreign key linking to premium.commission. Business justification: Commission_payable already links to premium_transaction, but business requires direct link to commission record to reconcile commission basis, rate, split percentages, overrides, and' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Commission .

ind:commissionRuleId rdf:type rdf:Property ;
    rdfs:label 'Commission Rule Id' ;
    rdfs:comment 'Foreign key linking to producers.commission_rule. Business justification: Commission payables must reference the specific commission rule that calculated the rate and amount for regulatory audit, variance analysis, and dispute resolution.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionRule .

ind:commissionScheduleId rdf:type rdf:Property ;
    rdfs:label 'Commission Schedule Id' ;
    rdfs:comment 'Identifier of the commission schedule or rate table used to calculate this payable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionSchedule .

ind:disbursementId rdf:type rdf:Property ;
    rdfs:label 'Disbursement Id' ;
    rdfs:comment 'Foreign key linking to billing.disbursement. Business justification: Commission payables are paid via disbursements. When a commission_payable is paid, it should reference the disbursement that paid it.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Disbursement .

ind:lineOfBusinessId rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Id' ;
    rdfs:comment 'Foreign key linking to shared.line_of_business. Business justification: Commission structures, rates, and payment terms differ significantly by line of business: personal lines typically have lower commission rates than commercial lines; specialty lines' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LineOfBusiness .

ind:premiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Premium Transaction Id' ;
    rdfs:comment 'Identifier of the premium transaction that triggered this commission payable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumTransaction .

ind:quoteId rdf:type rdf:Property ;
    rdfs:label 'Quote Id' ;
    rdfs:comment 'Foreign key linking to coverage.quote. Business justification: Commission may be earned and payable on quoted business under binding authority or MGA arrangements where quote represents bindable premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Quote .

ind:reinsuranceCessionId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Id' ;
    rdfs:comment 'Foreign key linking to reinsurance.cession. Business justification: Producer commission statements must reconcile gross vs. net premium to calculate correct commission amounts.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReinsuranceCession .

ind:reversedPayableCommissionPayableId rdf:type rdf:Property ;
    rdfs:label 'Reversed Payable Commission Payable Id' ;
    rdfs:comment 'Identifier of the original commission payable that this record reverses.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionPayable .

ind:approvedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Approved By User Code' ;
    rdfs:comment 'Identifier of the user who approved this commission payable for payment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time when the commission payable was approved for payment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:chargebackAmount rdf:type rdf:Property ;
    rdfs:label 'Chargeback Amount' ;
    rdfs:comment 'Amount of commission subject to chargeback from the producer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargebackFlag rdf:type rdf:Property ;
    rdfs:label 'Chargeback Flag' ;
    rdfs:comment 'Indicates whether this commission payable is subject to chargeback due to policy cancellation or non-payment.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionBasis rdf:type rdf:Property ;
    rdfs:label 'Commission Basis' ;
    rdfs:comment 'Premium basis on which the commission was calculated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionRate rdf:type rdf:Property ;
    rdfs:label 'Commission Rate' ;
    rdfs:comment 'Percentage rate applied to the premium to calculate the commission amount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionType rdf:type rdf:Property ;
    rdfs:label 'Commission Type' ;
    rdfs:comment 'Classification of commission payable by type or tier.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earnedDate rdf:type rdf:Property ;
    rdfs:label 'Earned Date' ;
    rdfs:comment 'Date on which the commission was earned based on the premium transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:glPostingDate rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Date' ;
    rdfs:comment 'Date on which the commission payable was posted to the general ledger.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Commission Amount' ;
    rdfs:comment 'Total commission amount earned before any withholdings or adjustments.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Date and time when this commission payable record was last updated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:netPayableAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payable Amount' ;
    rdfs:comment 'Net commission amount payable to the producer after withholdings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideFlag rdf:type rdf:Property ;
    rdfs:label 'Override Flag' ;
    rdfs:comment 'Indicates whether this is an override commission paid to a higher-level producer or manager.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paidDate rdf:type rdf:Property ;
    rdfs:label 'Paid Date' ;
    rdfs:comment 'Date on which the commission was actually disbursed to the producer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payableDate rdf:type rdf:Property ;
    rdfs:label 'Payable Date' ;
    rdfs:comment 'Date on which the commission becomes payable to the producer.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payableNumber rdf:type rdf:Property ;
    rdfs:label 'Payable Number' ;
    rdfs:comment 'Business identifier or reference number for this commission payable record.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payableStatus rdf:type rdf:Property ;
    rdfs:label 'Payable Status' ;
    rdfs:comment 'Current lifecycle status of the commission payable.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'Reference number of the payment transaction that settled this commission payable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Amount' ;
    rdfs:comment 'Premium amount on which the commission was calculated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitFlag rdf:type rdf:Property ;
    rdfs:label 'Split Flag' ;
    rdfs:comment 'Indicates whether this commission is part of a split arrangement among multiple producers.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:splitPercentage rdf:type rdf:Property ;
    rdfs:label 'Split Percentage' ;
    rdfs:comment 'Percentage of the total commission allocated to this producer in a split arrangement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withheldAmount rdf:type rdf:Property ;
    rdfs:label 'Withheld Amount' ;
    rdfs:comment 'Amount withheld from gross commission for chargebacks, advances, or other deductions.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdingReasonCode rdf:type rdf:Property ;
    rdfs:label 'Withholding Reason Code' ;
    rdfs:comment 'Code indicating the reason for any commission withholding.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdingReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Withholding Reason Description' ;
    rdfs:comment 'Detailed description of the reason for commission withholding.' ;
    rdfs:domain ind:CommissionPayable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delinquencyId rdf:type rdf:Property ;
    rdfs:label 'Delinquency Id' ;
    rdfs:comment 'Unique identifier for the delinquency event. Primary key.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Delinquency .

ind:catastropheEventId rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Event Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.catastrophe_event. Business justification: Catastrophe-triggered delinquencies require event linkage for regulatory forbearance programs, loss mitigation tracking, and state-mandated grace period extensions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatastropheEvent .

ind:assignedCollectorUserCode rdf:type rdf:Property ;
    rdfs:label 'Assigned Collector User Code' ;
    rdfs:comment 'User ID of the collections specialist assigned to work this delinquency case.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionsAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Flag' ;
    rdfs:comment 'Indicates whether the delinquent account was referred to an external collections agency.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionsAgencyName rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Name' ;
    rdfs:comment 'Name of the external collections agency to which the account was referred.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsReferralDate rdf:type rdf:Property ;
    rdfs:label 'Collections Referral Date' ;
    rdfs:comment 'Date the delinquent account was referred to the collections agency.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstMissedInstallmentDate rdf:type rdf:Property ;
    rdfs:label 'First Missed Installment Date' ;
    rdfs:comment 'Due date of the first installment that was not paid, initiating the delinquency.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstNoticeDate rdf:type rdf:Property ;
    rdfs:label 'First Notice Date' ;
    rdfs:comment 'Date the first delinquency notice was sent to the policyholder.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gracePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Grace Period End Date' ;
    rdfs:comment 'Date the grace period expired, after which the account was marked delinquent.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Last Notice Date' ;
    rdfs:comment 'Date the most recent delinquency or cancellation notice was sent.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Late payment fees assessed during the delinquency period, per state regulations and policy terms.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticeSentCount rdf:type rdf:Property ;
    rdfs:label 'Notice Sent Count' ;
    rdfs:comment 'Total number of delinquency notices sent to the policyholder during this delinquency event.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pastDueAmount rdf:type rdf:Property ;
    rdfs:label 'Past Due Amount' ;
    rdfs:comment 'Portion of the total amount due that is overdue and subject to collections action.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanDefaultFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Default Flag' ;
    rdfs:comment 'Indicates whether the delinquency was caused by a payment plan default.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Additional penalties or interest charges applied to the delinquent balance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Code indicating the root cause of delinquency, such as missed payment, returned check, or payment plan default.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed explanation of why the account became delinquent.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Amount' ;
    rdfs:comment 'Total amount paid to reinstate the policy, including past-due premium, fees, and penalties.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Date' ;
    rdfs:comment 'Date the policy was reinstated after the delinquency was cured and all past-due amounts were paid.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionMethod rdf:type rdf:Property ;
    rdfs:label 'Resolution Method' ;
    rdfs:comment 'Method by which the delinquency was resolved.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolvedDate rdf:type rdf:Property ;
    rdfs:label 'Resolved Date' ;
    rdfs:comment 'Date the delinquency was fully resolved through payment, reinstatement, cancellation, or write-off.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnedPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Flag' ;
    rdfs:comment 'Indicates whether the delinquency was triggered by a returned or dishonored payment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnedPaymentReason rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Reason' ;
    rdfs:comment 'Reason the payment was returned, such as insufficient funds, closed account, or stop payment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'Date the billing account first became delinquent, typically the day after the grace period expired.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'Precise timestamp when the delinquency event was triggered in the billing system.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:totalAmountDue rdf:type rdf:Property ;
    rdfs:label 'Total Amount Due' ;
    rdfs:comment 'Total outstanding balance owed on the billing account at the time of delinquency, including premium, fees, and penalties.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delinquencyActionId rdf:type rdf:Property ;
    rdfs:label 'Delinquency Action Id' ;
    rdfs:comment 'Unique identifier for each delinquency action record. Primary key.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedActionDelinquencyActionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Action Delinquency Action Id' ;
    rdfs:comment 'Foreign key to the original delinquency action that this action reverses, if applicable.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DelinquencyAction .

ind:uwDecisionId rdf:type rdf:Property ;
    rdfs:label 'Uw Decision Id' ;
    rdfs:comment 'Foreign key linking to coverage.uw_decision. Business justification: Cancellation for non-payment may trigger reinstatement underwriting review or conditional reinstatement decisions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UwDecision .

ind:actionDate rdf:type rdf:Property ;
    rdfs:label 'Action Date' ;
    rdfs:comment 'Business date when the delinquency action was initiated or executed.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actionOutcomeCode rdf:type rdf:Property ;
    rdfs:label 'Action Outcome Code' ;
    rdfs:comment 'Result or outcome of the delinquency action after execution.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Action Reason Code' ;
    rdfs:comment 'Coded reason or trigger that caused this delinquency action to be initiated.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Action Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why this delinquency action was taken.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Action Sequence Number' ;
    rdfs:comment 'Sequential order of this action within the parent delinquency process.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current status of the delinquency action in its workflow lifecycle.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Action Timestamp' ;
    rdfs:comment 'Precise timestamp when the delinquency action was initiated or executed.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Action Type Code' ;
    rdfs:comment 'Type of delinquency action taken: notice issued, reminder sent, cancellation initiated, reinstatement offered, write-off triggered, or referral to collections.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date when this delinquency action was approved or authorized for execution.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationTypeCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Type Code' ;
    rdfs:comment 'Type of cancellation initiated if action type is cancellation, such as non-payment cancellation or flat cancellation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Code' ;
    rdfs:comment 'Identifier of the external collections agency to which the account was referred, if applicable.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Collections Referral Flag' ;
    rdfs:comment 'Indicates whether the delinquent account was referred to external collections agency as part of this action.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'Date when the delinquency action was fully completed or finalized.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:initiatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Code' ;
    rdfs:comment 'Identifier of the system user or automated process that initiated this delinquency action.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether this delinquency action complies with all applicable state and federal regulatory requirements.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Deadline Date' ;
    rdfs:comment 'Last date by which the policyholder can accept the reinstatement offer and restore coverage.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementOfferedFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Offered Flag' ;
    rdfs:comment 'Indicates whether a reinstatement offer was extended to the policyholder as part of this action.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'Planned date for the delinquency action to be executed, if scheduled in advance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter state code where the delinquency action is governed, determining applicable regulatory rules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimPaymentId rdf:type rdf:Property ;
    rdfs:label 'Claim Payment Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.claim_payment. Business justification: Disbursements execute claim payments via check/EFT. Linking disbursement to the specific claim_payment record enables reconciliation of authorized claim payments vs actual cash' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimPayment .

ind:payeeAddressId rdf:type rdf:Property ;
    rdfs:label 'Payee Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Commission and claim disbursement checks require USPS-validated payee address for delivery. Denormalized address fields should reference party.address master to leverage geocoding, DPV' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:payeePartyId rdf:type rdf:Property ;
    rdfs:label 'Payee Party Id' ;
    rdfs:comment 'Party receiving the disbursement payment, linking to the party master.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:reversedDisbursementId rdf:type rdf:Property ;
    rdfs:label 'Reversed Disbursement Id' ;
    rdfs:comment 'Identifier of the original disbursement being reversed, if this is a reversal transaction.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Disbursement .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'Physical check number if the disbursement was issued via check.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'Date the disbursement cleared the bank or payment processor.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commissionBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Basis Amount' ;
    rdfs:comment 'Base premium or transaction amount on which the commission was calculated.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disbursementDate rdf:type rdf:Property ;
    rdfs:label 'Disbursement Date' ;
    rdfs:comment 'Date the disbursement was issued or scheduled for payment.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disbursementStatus rdf:type rdf:Property ;
    rdfs:label 'Disbursement Status' ;
    rdfs:comment 'Current lifecycle status of the disbursement transaction.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disbursementType rdf:type rdf:Property ;
    rdfs:label 'Disbursement Type' ;
    rdfs:comment 'Classification of the disbursement purpose: commission payable, premium refund, return premium, claim payment, or recovery. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Amount' ;
    rdfs:comment 'Total gross amount of the disbursement before any withholdings or adjustments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Issued By User Code' ;
    rdfs:comment 'User identifier of the person who issued or processed the disbursement.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'Net amount disbursed to the payee after all withholdings and adjustments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payeeName rdf:type rdf:Property ;
    rdfs:label 'Payee Name' ;
    rdfs:comment 'Full legal name of the payee receiving the disbursement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeTaxNumber rdf:type rdf:Property ;
    rdfs:label 'Payee Tax Number' ;
    rdfs:comment 'Tax identification number (TIN, EIN, or SSN) of the payee for IRS reporting and withholding.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timestamp rdf:type rdf:Property ;
    rdfs:label 'Timestamp' ;
    rdfs:comment 'Precise date and time the disbursement transaction was created or issued.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'Date the disbursement was voided or cancelled, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escrowAccountId rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Id' ;
    rdfs:comment 'Unique identifier for the escrow account record. Primary key.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escrowMortgageePartyId rdf:type rdf:Property ;
    rdfs:label 'Escrow Mortgagee Party Id' ;
    rdfs:comment 'Reference to the lender or mortgagee party who collects and remits premium through escrow.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:escrowPolicyholderPartyId rdf:type rdf:Property ;
    rdfs:label 'Escrow Policyholder Party Id' ;
    rdfs:comment 'Reference to the policyholder party whose premium is paid via escrow.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:analysisDate rdf:type rdf:Property ;
    rdfs:label 'Analysis Date' ;
    rdfs:comment 'Date of the most recent escrow analysis performed to review balance adequacy and adjust collection amounts.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:autoPayFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Flag' ;
    rdfs:comment 'Indicates whether automatic disbursement is enabled for scheduled premium payments from the escrow account.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Current Balance Amount' ;
    rdfs:comment 'Current balance held in the escrow account available for premium disbursement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delinquencyDate rdf:type rdf:Property ;
    rdfs:label 'Delinquency Date' ;
    rdfs:comment 'Date when the escrow account first became delinquent due to shortage or non-payment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disbursementFrequency rdf:type rdf:Property ;
    rdfs:label 'Disbursement Frequency' ;
    rdfs:comment 'Scheduled frequency at which the mortgagee remits premium payments from the escrow account to the insurer.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyAmount rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Amount' ;
    rdfs:comment 'Amount of variance identified during reconciliation between escrow disbursements and expected premium charges.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discrepancyReason rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Reason' ;
    rdfs:comment 'Explanation of the cause of any reconciliation discrepancy, such as timing differences, rate changes, or payment errors.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastDisbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Last Disbursement Amount' ;
    rdfs:comment 'Amount of the most recent premium disbursement from the escrow account.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastDisbursementDate rdf:type rdf:Property ;
    rdfs:label 'Last Disbursement Date' ;
    rdfs:comment 'Date of the most recent premium disbursement from the escrow account to the insurer.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciliation Date' ;
    rdfs:comment 'Date when the escrow account was last reconciled against policy premium obligations and billing records.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loanNumber rdf:type rdf:Property ;
    rdfs:label 'Loan Number' ;
    rdfs:comment 'Mortgagee loan number associated with the escrow account, linking the insurance premium to the underlying mortgage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextDisbursementDate rdf:type rdf:Property ;
    rdfs:label 'Next Disbursement Date' ;
    rdfs:comment 'Scheduled date for the next premium disbursement from the escrow account to the insurer.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Next Reconciliation Date' ;
    rdfs:comment 'Scheduled date for the next escrow account reconciliation review.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Current status of escrow account reconciliation indicating whether disbursements match expected premium obligations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Required Balance Amount' ;
    rdfs:comment 'Minimum balance amount required to be maintained in the escrow account per agreement terms.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:servicerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Servicer Contact Email' ;
    rdfs:comment 'Primary email address for contacting the escrow servicer regarding disbursements and account inquiries.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Servicer Contact Phone' ;
    rdfs:comment 'Primary phone number for contacting the escrow servicer regarding disbursements and account inquiries.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicerName rdf:type rdf:Property ;
    rdfs:label 'Servicer Name' ;
    rdfs:comment 'Name of the loan servicer or financial institution managing the escrow account on behalf of the mortgagee.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortageAmount rdf:type rdf:Property ;
    rdfs:label 'Shortage Amount' ;
    rdfs:comment 'Amount by which the current escrow balance falls short of the required balance, triggering potential collection action.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surplusAmount rdf:type rdf:Property ;
    rdfs:label 'Surplus Amount' ;
    rdfs:comment 'Amount by which the current escrow balance exceeds the required balance, potentially eligible for refund.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearToDateDisbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Year To Date Disbursement Amount' ;
    rdfs:comment 'Total amount disbursed from the escrow account to the insurer during the current calendar year.' ;
    rdfs:domain ind:EscrowAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentScheduleId rdf:type rdf:Property ;
    rdfs:label 'Installment Schedule Id' ;
    rdfs:comment 'Unique identifier for the installment schedule record. Primary key.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'End date of the billing period covered by this installment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'Start date of the billing period covered by this installment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:delinquencyDays rdf:type rdf:Property ;
    rdfs:label 'Delinquency Days' ;
    rdfs:comment 'Number of days this installment is past due. Zero if paid on time or not yet due.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Down Payment Flag' ;
    rdfs:comment 'Indicates whether this installment represents the initial down payment for the policy term.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Allocation Amount' ;
    rdfs:comment 'Portion of the installment amount allocated to fees such as policy fees or installment fees.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalInstallmentFlag rdf:type rdf:Property ;
    rdfs:label 'Final Installment Flag' ;
    rdfs:comment 'Indicates whether this is the final installment in the payment plan.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installmentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Fee Amount' ;
    rdfs:comment 'Fee charged for paying in installments rather than in full. Zero if no installment fee applies.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentNumber rdf:type rdf:Property ;
    rdfs:label 'Installment Number' ;
    rdfs:comment 'Sequential number of this installment within the payment plan. First installment is 1.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentStatus rdf:type rdf:Property ;
    rdfs:label 'Installment Status' ;
    rdfs:comment 'Current status of the installment in its lifecycle.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'User ID or name of the person or system that last modified this installment record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Notice Sent Date' ;
    rdfs:comment 'Date on which a payment reminder or delinquency notice was sent for this installment. Null if no notice sent.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outstandingAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Amount' ;
    rdfs:comment 'The remaining unpaid balance on this installment. Calculated as scheduled amount minus paid amount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'The actual amount paid against this installment. May differ from scheduled amount due to partial payments or adjustments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentChannel rdf:type rdf:Property ;
    rdfs:label 'Payment Channel' ;
    rdfs:comment 'Channel through which the payment was or is expected to be received. [ENUM-REF-CANDIDATE: web|mobile_app|phone|mail|agent|branch|auto_pay — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'Date on which payment was actually received for this installment. Null if unpaid.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Allocation Amount' ;
    rdfs:comment 'Portion of the installment amount allocated to premium charges.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnedPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Date' ;
    rdfs:comment 'Date on which a payment for this installment was returned. Null if no return occurred.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledAmount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Amount' ;
    rdfs:comment 'The amount scheduled to be paid for this installment as originally calculated.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledDueDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Due Date' ;
    rdfs:comment 'Date on which the installment payment is scheduled to be due.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Allocation Amount' ;
    rdfs:comment 'Portion of the installment amount allocated to taxes and surcharges.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waivedAmount rdf:type rdf:Property ;
    rdfs:label 'Waived Amount' ;
    rdfs:comment 'Portion of the installment amount that has been waived or forgiven. Zero if no waiver applied.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Business reason for waiving all or part of the installment. Null if no waiver applied.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amountPaid rdf:type rdf:Property ;
    rdfs:label 'Amount Paid' ;
    rdfs:comment 'Total amount paid against this invoice to date.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Amount' ;
    rdfs:comment 'Total commission payable to the producer or agency on this invoice.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Invoice Description' ;
    rdfs:comment 'Free-text description or memo providing additional context about this invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Amount' ;
    rdfs:comment 'Total fees and surcharges included in this invoice.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'Date the invoice was issued to the policyholder or agency.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'Current lifecycle status of the invoice in the billing workflow. [ENUM-REF-CANDIDATE: draft|issued|billed|paid|partially_paid|overdue|cancelled|written_off — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Type of invoice based on the underlying policy transaction or billing event. [ENUM-REF-CANDIDATE: new_business|renewal|endorsement|cancellation|reinstatement|audit|installment|commission — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Business reason or code explaining why this invoice was reversed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Total tax charges included in this invoice.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalInstallments rdf:type rdf:Property ;
    rdfs:label 'Total Installments' ;
    rdfs:comment 'Total number of installments in the payment plan for this policy term.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Business reason or code explaining why this invoice balance was written off.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenOffDate rdf:type rdf:Property ;
    rdfs:label 'Written Off Date' ;
    rdfs:comment 'Date on which the outstanding balance of this invoice was written off as uncollectible.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceItemId rdf:type rdf:Property ;
    rdfs:label 'Invoice Item Id' ;
    rdfs:comment 'Unique identifier for the invoice item. Primary key.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceItem .

ind:chargeId rdf:type rdf:Property ;
    rdfs:label 'Charge Id' ;
    rdfs:comment 'Reference to the premium charge record this item bills. Null for taxes, fees, or commissions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Charge .

ind:claimExposureId rdf:type rdf:Property ;
    rdfs:label 'Claim Exposure Id' ;
    rdfs:comment 'Foreign key linking to claims.claim_exposure. Business justification: Invoice line items bill exposure-specific charges: per-coverage deductibles, per-exposure salvage credits, coverage-level subrogation recoveries.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimExposure .

ind:coverageId rdf:type rdf:Property ;
    rdfs:label 'Coverage Id' ;
    rdfs:comment 'Reference to the coverage this item charges for. Null for policy-level fees or taxes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coverage .

ind:reversedItemInvoiceItemId rdf:type rdf:Property ;
    rdfs:label 'Reversed Item Invoice Item Id' ;
    rdfs:comment 'Reference to the original invoice item this item reverses. Populated only when reversal_flag is true.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceItem .

ind:riskexposureInsuredRiskId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Insured Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.insured_risk. Business justification: Commercial lines billing often requires risk-level premium detail for schedule-rated policies with multiple locations/buildings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredRisk .

ind:taxLevyId rdf:type rdf:Property ;
    rdfs:label 'Tax Levy Id' ;
    rdfs:comment 'Foreign key linking to premium.tax_levy. Business justification: Invoice items for taxes must reference the specific tax_levy record that calculated the tax amount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxLevy .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'User identifier or system process that created this invoice item record. Supports audit and compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemAmount rdf:type rdf:Property ;
    rdfs:label 'Item Amount' ;
    rdfs:comment 'Monetary amount of this invoice line item in the invoice currency. Positive for charges, negative for credits or refunds.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:itemCategory rdf:type rdf:Property ;
    rdfs:label 'Item Category' ;
    rdfs:comment 'Further categorization of the item within its type. For premium: written, earned, unearned, return. For fees: installment, surcharge, penalty. [ENUM-REF-CANDIDATE: written|earned|unearned|return|installment|surcharge|penalty — 7 candidates stripped' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemCode rdf:type rdf:Property ;
    rdfs:label 'Item Code' ;
    rdfs:comment 'Internal billing code or accounting code for the item type. Used for general ledger posting and reporting.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemDescription rdf:type rdf:Property ;
    rdfs:label 'Item Description' ;
    rdfs:comment 'Human-readable description of the invoice item displayed to the policyholder. Explains what is being charged.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemType rdf:type rdf:Property ;
    rdfs:label 'Item Type' ;
    rdfs:comment 'Classification of the invoice line item indicating what is being billed: premium charge, tax, fee, commission, adjustment, or refund.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number within the invoice for ordering and display purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prorationFactor rdf:type rdf:Property ;
    rdfs:label 'Proration Factor' ;
    rdfs:comment 'Decimal factor applied to calculate prorated premium for mid-term endorsements or cancellations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prorationMethod rdf:type rdf:Property ;
    rdfs:label 'Proration Method' ;
    rdfs:comment 'Method used to prorate premium for mid-term changes. Daily, monthly, short-rate, pro-rata, or full-term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction' ;
    rdfs:comment 'State, county, or municipal jurisdiction imposing the tax. Populated only when item_type is tax.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRate rdf:type rdf:Property ;
    rdfs:label 'Tax Rate' ;
    rdfs:comment 'Tax rate applied to calculate the tax amount. Expressed as a decimal (e.g., 0.06 for 6%). Populated only when item_type is tax.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxableBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Taxable Base Amount' ;
    rdfs:comment 'Base premium amount the tax is calculated on. Populated only when item_type is tax.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updatedByUser rdf:type rdf:Property ;
    rdfs:label 'Updated By User' ;
    rdfs:comment 'User identifier or system process that last modified this invoice item record. Supports audit and compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waivedFlag rdf:type rdf:Property ;
    rdfs:label 'Waived Flag' ;
    rdfs:comment 'Indicates whether this fee or charge was waived by underwriting or management approval. True if waived, false otherwise.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payerPartyId rdf:type rdf:Property ;
    rdfs:label 'Payer Party Id' ;
    rdfs:comment 'Reference to the party (person or organization) who made the payment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:appliedAmount rdf:type rdf:Property ;
    rdfs:label 'Applied Amount' ;
    rdfs:comment 'Portion of the payment amount that has been applied to outstanding invoices or charges.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedDate rdf:type rdf:Property ;
    rdfs:label 'Applied Date' ;
    rdfs:comment 'Date the payment was applied to the billing account or invoice.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Authorization code provided by the payment processor for card transactions.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountLastFour rdf:type rdf:Property ;
    rdfs:label 'Bank Account Last Four' ;
    rdfs:comment 'Last four digits of the bank account used for ACH or wire transfer payments.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'Nine-digit ABA routing number for ACH or wire transfer payments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardLastFour rdf:type rdf:Property ;
    rdfs:label 'Card Last Four' ;
    rdfs:comment 'Last four digits of the payment card used, for identification purposes only.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardType rdf:type rdf:Property ;
    rdfs:label 'Card Type' ;
    rdfs:comment 'Type of payment card used (Visa, MasterCard, American Express, Discover).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'Interface or channel through which the payment was received (web, mobile, agent portal, mail, phone, in-person).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReturned rdf:type rdf:Property ;
    rdfs:label 'Is Returned' ;
    rdfs:comment 'Indicates whether the payment was returned due to insufficient funds or other reasons.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'Instrument or mechanism used to make the payment (credit card, ACH, check, wire, cash).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nsfFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Nsf Fee Amount' ;
    rdfs:comment 'Fee charged to the policyholder for a returned payment due to insufficient funds.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current lifecycle status of the payment transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the payment purpose (premium, down payment, installment, reinstatement, endorsement, refund).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processor rdf:type rdf:Property ;
    rdfs:label 'Processor' ;
    rdfs:comment 'Name of the payment gateway or processor that handled the transaction.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'Date the payment was received by the insurer.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receiptTimestamp rdf:type rdf:Property ;
    rdfs:label 'Receipt Timestamp' ;
    rdfs:comment 'Precise date and time the payment was received and recorded in the billing system.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Number' ;
    rdfs:comment 'External reference number provided by the payer or payment processor (e.g., check number, confirmation number).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnReasonCode rdf:type rdf:Property ;
    rdfs:label 'Return Reason Code' ;
    rdfs:comment 'Code indicating the reason for payment return (e.g., NSF, account closed, stop payment).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Return Reason Description' ;
    rdfs:comment 'Detailed explanation of why the payment was returned.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnedDate rdf:type rdf:Property ;
    rdfs:label 'Returned Date' ;
    rdfs:comment 'Date the payment was returned by the financial institution.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversedDate rdf:type rdf:Property ;
    rdfs:label 'Reversed Date' ;
    rdfs:comment 'Date the payment was reversed, if applicable.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Origin or source of the payment (policyholder, agency, third party, escrow, reinsurer).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionId rdf:type rdf:Property ;
    rdfs:label 'Transaction Id' ;
    rdfs:comment 'Unique transaction identifier from the payment gateway or processor.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unappliedAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Amount' ;
    rdfs:comment 'Portion of the payment amount that remains unapplied and available for future allocation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Payment Application Id' ;
    rdfs:comment 'Unique identifier for the payment application record. Primary key.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedApplicationPaymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Reversed Application Payment Application Id' ;
    rdfs:comment 'Reference to the original payment application record that this reversal is correcting. Null if not a reversal.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentApplication .

ind:allocationRuleCode rdf:type rdf:Property ;
    rdfs:label 'Allocation Rule Code' ;
    rdfs:comment 'Code identifying the business rule used to allocate this payment across invoices or items.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'Date on which the payment was applied to the invoice or moved to suspense.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationMethod rdf:type rdf:Property ;
    rdfs:label 'Application Method' ;
    rdfs:comment 'Method by which the payment was applied: automatic matching, manual user action, system rule, batch process, or override.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationNumber rdf:type rdf:Property ;
    rdfs:label 'Application Number' ;
    rdfs:comment 'Business-readable identifier for this payment application transaction.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Application Reason Code' ;
    rdfs:comment 'Code indicating the reason for the application, unapplied status, or suspense holding.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Application Reason Description' ;
    rdfs:comment 'Detailed explanation of why the payment was applied, held unapplied, or placed in suspense.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current status of the payment application in the billing lifecycle.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Application Timestamp' ;
    rdfs:comment 'Precise date and time when the payment application was recorded in the billing system.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:applicationType rdf:type rdf:Property ;
    rdfs:label 'Application Type' ;
    rdfs:comment 'Type of payment application: applied to invoice, held as unapplied cash, held in suspense, reversal of prior application, or adjustment.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Applied By User Code' ;
    rdfs:comment 'User identifier of the billing representative who manually applied this payment. Null if automatic.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseAmount rdf:type rdf:Property ;
    rdfs:label 'Suspense Amount' ;
    rdfs:comment 'Monetary amount held in suspense pending resolution of account or invoice discrepancies.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:suspenseClearedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Suspense Cleared By User Code' ;
    rdfs:comment 'User identifier of the billing representative who cleared the suspense and applied the payment.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseClearedDate rdf:type rdf:Property ;
    rdfs:label 'Suspense Cleared Date' ;
    rdfs:comment 'Date on which the suspense holding was resolved and the payment was applied. Null if still in suspense.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentMethodId rdf:type rdf:Property ;
    rdfs:label 'Payment Method Id' ;
    rdfs:comment 'Unique identifier for the payment method record. Primary key.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentRecordId rdf:type rdf:Property ;
    rdfs:label 'Consent Record Id' ;
    rdfs:comment 'Foreign key linking to party.consent_record. Business justification: NACHA rules and state regulations require explicit documented consent for EFT/ACH debits.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecord .

ind:autopayEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Autopay Enrollment Date' ;
    rdfs:comment 'Date when the payment method was enrolled in automatic payment processing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankAccountType rdf:type rdf:Property ;
    rdfs:label 'Bank Account Type' ;
    rdfs:comment 'Type of bank account: checking, savings, business checking, or business savings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'Name of the financial institution for Automated Clearing House (ACH) or Electronic Funds Transfer (EFT) payment methods.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardExpiryMonth rdf:type rdf:Property ;
    rdfs:label 'Card Expiry Month' ;
    rdfs:comment 'Expiration month of the credit or debit card (1-12). Populated only for card-based methods.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cardExpiryYear rdf:type rdf:Property ;
    rdfs:label 'Card Expiry Year' ;
    rdfs:comment 'Expiration year of the credit or debit card (four-digit year). Populated only for card-based methods.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cardholderName rdf:type rdf:Property ;
    rdfs:label 'Cardholder Name' ;
    rdfs:comment 'Name of the cardholder as it appears on the credit or debit card.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eftAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Eft Authorization Date' ;
    rdfs:comment 'Date when the Electronic Funds Transfer authorization was granted by the account holder.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eftAuthorizationReference rdf:type rdf:Property ;
    rdfs:label 'Eft Authorization Reference' ;
    rdfs:comment 'Reference number or identifier for the EFT authorization agreement or signed form.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eftAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Eft Authorization Status' ;
    rdfs:comment 'Status of the Electronic Funds Transfer authorization indicating whether the account holder has granted permission for automatic debits.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutopayEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Autopay Enabled' ;
    rdfs:comment 'Indicates whether this payment method is enrolled in automatic payment processing for recurring invoices.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDefault rdf:type rdf:Property ;
    rdfs:label 'Is Default' ;
    rdfs:comment 'Indicates whether this is the default payment method for the billing account.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Verification Date' ;
    rdfs:comment 'Date when the payment method was last verified or validated by the payment processor or financial institution.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:methodName rdf:type rdf:Property ;
    rdfs:label 'Method Name' ;
    rdfs:comment 'User-friendly display name or nickname for the payment method (e.g., Personal Visa, Business Checking).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodStatus rdf:type rdf:Property ;
    rdfs:label 'Method Status' ;
    rdfs:comment 'Current lifecycle status of the payment method indicating whether it is available for use.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodType rdf:type rdf:Property ;
    rdfs:label 'Method Type' ;
    rdfs:comment 'Type of payment instrument: credit card, debit card, Automated Clearing House (ACH), Electronic Funds Transfer (EFT), check, escrow, or wire transfer. [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|eft|check|escrow|wire_transfer — 7 candidates stripped' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentToken rdf:type rdf:Property ;
    rdfs:label 'Payment Token' ;
    rdfs:comment 'Tokenized representation of the payment instrument provided by the payment processor for secure storage and recurring transactions.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityRank rdf:type rdf:Property ;
    rdfs:label 'Priority Rank' ;
    rdfs:comment 'Numeric ranking indicating the order of preference for this payment method when multiple methods are available (1 = highest priority).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processorMerchantCode rdf:type rdf:Property ;
    rdfs:label 'Processor Merchant Code' ;
    rdfs:comment 'Merchant identifier assigned by the payment processor for transaction routing and reconciliation.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorName rdf:type rdf:Property ;
    rdfs:label 'Processor Name' ;
    rdfs:comment 'Name of the third-party payment processor or gateway handling transactions for this payment method (e.g., Stripe, PayPal, Authorize.Net).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Updated By User Code' ;
    rdfs:comment 'Identifier of the user or system process that last modified the payment method record.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Usage Limit Amount' ;
    rdfs:comment 'Maximum transaction amount allowed for a single payment using this method. Nullable if no limit is imposed.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Status of the payment method verification process indicating whether the instrument has been validated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether underwriter or management approval is required before a policy can be bound with this plan.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoPayEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Eligible Flag' ;
    rdfs:comment 'Indicates whether this payment plan allows policyholders to enroll in automatic recurring payment processing.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationShortRatePenaltyPercentage rdf:type rdf:Property ;
    rdfs:label 'Cancellation Short Rate Penalty Percentage' ;
    rdfs:comment 'Percentage penalty applied to unearned premium when policyholder cancels mid-term under installment plan.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Description' ;
    rdfs:comment 'Detailed explanation of the payment plan terms, conditions, and intended use for underwriter and agent reference.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayOrder rdf:type rdf:Property ;
    rdfs:label 'Display Order' ;
    rdfs:comment 'Numeric sequence controlling the presentation order of payment plans in user interfaces and quote proposals.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downPaymentMinimumAmount rdf:type rdf:Property ;
    rdfs:label 'Down Payment Minimum Amount' ;
    rdfs:comment 'Minimum dollar amount required for down payment regardless of percentage calculation.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downPaymentPercentage rdf:type rdf:Property ;
    rdfs:label 'Down Payment Percentage' ;
    rdfs:comment 'Percentage of total premium required as initial down payment at policy binding expressed as decimal.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalPlanCode rdf:type rdf:Property ;
    rdfs:label 'External Plan Code' ;
    rdfs:comment 'Third-party or legacy system payment plan identifier used for integration and data migration mapping.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentFeePercentage rdf:type rdf:Property ;
    rdfs:label 'Installment Fee Percentage' ;
    rdfs:comment 'Percentage-based fee applied to each installment amount expressed as decimal for proportional billing.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Installment Frequency' ;
    rdfs:comment 'Recurring interval at which installment payments are scheduled and invoiced to the policyholder.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latePaymentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Fee Amount' ;
    rdfs:comment 'Fixed dollar penalty assessed when an installment payment is received after the grace period expires.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Premium Amount' ;
    rdfs:comment 'Maximum total policy premium allowed for this payment plan. Policies exceeding this may require different terms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Amount' ;
    rdfs:comment 'Minimum total policy premium required to qualify for this payment plan. Policies below this threshold must pay in full.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfInstallments rdf:type rdf:Property ;
    rdfs:label 'Number Of Installments' ;
    rdfs:comment 'Total count of scheduled payment installments in the plan excluding the down payment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planCode rdf:type rdf:Property ;
    rdfs:label 'Plan Code' ;
    rdfs:comment 'Business identifier code for the payment plan template used for external reference and billing system integration.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'Descriptive name of the payment plan displayed to policyholders and agents.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle status of the payment plan indicating availability for new policies.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Classification of the payment plan structure indicating how premium is collected.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTypeCode rdf:type rdf:Property ;
    rdfs:label 'Policy Type Code' ;
    rdfs:comment 'Policy type classification code restricting plan availability to specific policy forms or packages.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerCommissionImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Producer Commission Impact Flag' ;
    rdfs:comment 'Indicates whether installment fees affect producer commission calculation or are retained entirely by the insurer.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'State Department of Insurance filing number or reference for approved payment plan terms and fee schedules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Fee Amount' ;
    rdfs:comment 'Fixed dollar fee charged to reinstate a policy that was cancelled for non-payment under this plan.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnedPaymentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Fee Amount' ;
    rdfs:comment 'Fixed dollar fee assessed when a payment is returned due to insufficient funds or account closure.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnedPaymentId rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Id' ;
    rdfs:comment 'Unique identifier for the returned payment event. Primary key.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bankReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Reference Number' ;
    rdfs:comment 'Reference number provided by the bank or payment processor for the return transaction.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationNoticeSentFlag rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Sent Flag' ;
    rdfs:comment 'Indicates whether a policy cancellation notice was sent as a result of the returned payment.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delinquencyTriggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Delinquency Triggered Flag' ;
    rdfs:comment 'Indicates whether the returned payment triggered a delinquency status on the billing account or policy.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Original Payment Amount' ;
    rdfs:comment 'Dollar amount of the original payment that was returned.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Original Payment Date' ;
    rdfs:comment 'Date the original payment was submitted before being returned.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Processed By User Code' ;
    rdfs:comment 'Identifier of the billing system user who processed or reviewed the returned payment event.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Date' ;
    rdfs:comment 'Date the payment was resubmitted after the initial return, if applicable.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Resubmission Flag' ;
    rdfs:comment 'Indicates whether the payment was resubmitted after being returned.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnDate rdf:type rdf:Property ;
    rdfs:label 'Return Date' ;
    rdfs:comment 'Date the payment was returned by the bank or payment processor.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Return Fee Amount' ;
    rdfs:comment 'Fee assessed to the policyholder for the returned payment, if applicable.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnFeeAssessedFlag rdf:type rdf:Property ;
    rdfs:label 'Return Fee Assessed Flag' ;
    rdfs:comment 'Indicates whether a returned payment fee was assessed to the billing account.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnNumber rdf:type rdf:Property ;
    rdfs:label 'Return Number' ;
    rdfs:comment 'Business identifier for the returned payment event, typically assigned by the billing system.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnStatus rdf:type rdf:Property ;
    rdfs:label 'Return Status' ;
    rdfs:comment 'Current processing status of the returned payment event. Values include pending, confirmed, reversed (if the return was later corrected), waived (fee waived), or disputed.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnTimestamp rdf:type rdf:Property ;
    rdfs:label 'Return Timestamp' ;
    rdfs:comment 'Precise date and time the payment return was recorded in the billing system.' ;
    rdfs:domain ind:ReturnedPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:suspenseItemId rdf:type rdf:Property ;
    rdfs:label 'Suspense Item Id' ;
    rdfs:comment 'Unique identifier for the suspense item. Primary key. One row per unallocated payment or credit held in suspense pending identification of the correct billing account or invoice.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agingDays rdf:type rdf:Property ;
    rdfs:label 'Aging Days' ;
    rdfs:comment 'Number of days the item has been held in suspense, calculated from receipt date to current date or resolution date. Used for aging reports and escalation.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'Portion of the received amount that has been successfully allocated to a billing account or invoice. Zero if still fully in suspense.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Allocated By User Code' ;
    rdfs:comment 'User ID of the billing representative or system process that resolved and allocated the suspense item.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocatedDate rdf:type rdf:Property ;
    rdfs:label 'Allocated Date' ;
    rdfs:comment 'Date the suspense item was successfully allocated to a billing account or invoice. Null if still in suspense.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payerName rdf:type rdf:Property ;
    rdfs:label 'Payer Name' ;
    rdfs:comment 'Name of the individual or organization who remitted the payment, as provided on the payment instrument or remittance advice.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerReference rdf:type rdf:Property ;
    rdfs:label 'Payer Reference' ;
    rdfs:comment 'Any reference information provided by the payer (e.g., policy number, invoice number, account number) that may aid in allocation.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedAmount rdf:type rdf:Property ;
    rdfs:label 'Received Amount' ;
    rdfs:comment 'Total monetary amount received and placed into suspense. Represents the full value of the unallocated payment or credit.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingSuspenseAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Suspense Amount' ;
    rdfs:comment 'Unallocated balance still held in suspense. Equals received amount minus allocated amount minus any write-offs or reversals.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remittanceAdvice rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice' ;
    rdfs:comment 'Free-text remittance advice or memo provided with the payment, containing payer notes or allocation instructions.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseNumber rdf:type rdf:Property ;
    rdfs:label 'Suspense Number' ;
    rdfs:comment 'Human-readable business identifier for the suspense item, typically system-generated for tracking and reference.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Suspense Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why the item was placed into suspense, providing context beyond the reason code.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseStatus rdf:type rdf:Property ;
    rdfs:label 'Suspense Status' ;
    rdfs:comment 'Current lifecycle status of the suspense item: open (newly received), pending research (under investigation), allocated (resolved and applied), reversed (payment returned), written off, or expired.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseType rdf:type rdf:Property ;
    rdfs:label 'Suspense Type' ;
    rdfs:comment 'Classification of the suspense item by origin: unidentified payment (no account/invoice match), unidentified credit (refund or adjustment), overpayment, misdirected payment, partial payment, or other.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why the suspense item was written off.' ;
    rdfs:domain ind:SuspenseItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffId rdf:type rdf:Property ;
    rdfs:label 'Write Off Id' ;
    rdfs:comment 'Unique identifier for the write-off transaction. Primary key.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedWriteOffId rdf:type rdf:Property ;
    rdfs:label 'Reversed Write Off Id' ;
    rdfs:comment 'Original write-off transaction that this record reverses.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WriteOff .

ind:approvalAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Authority Level' ;
    rdfs:comment 'Organizational level required to approve this write-off.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Precise date and time when the write-off was approved.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:collectionAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Flag' ;
    rdfs:comment 'Indicates whether the account was referred to a collection agency before write-off.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glJournalEntryCode rdf:type rdf:Property ;
    rdfs:label 'Gl Journal Entry Code' ;
    rdfs:comment 'Journal entry identifier in the general ledger for this write-off.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestAmount rdf:type rdf:Property ;
    rdfs:label 'Interest Amount' ;
    rdfs:comment 'Portion of the write-off representing accrued interest.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Original Invoice Date' ;
    rdfs:comment 'Date of the original invoice that contained the written-off balance.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Policy Effective Date' ;
    rdfs:comment 'Effective date of the policy associated with the written-off balance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Policy Expiration Date' ;
    rdfs:comment 'Expiration date of the policy associated with the written-off balance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:principalAmount rdf:type rdf:Property ;
    rdfs:label 'Principal Amount' ;
    rdfs:comment 'Portion of the write-off representing the original premium balance.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryExpectedFlag rdf:type rdf:Property ;
    rdfs:label 'Recovery Expected Flag' ;
    rdfs:comment 'Indicates whether future recovery of the written-off amount is anticipated.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryProbabilityPercent rdf:type rdf:Property ;
    rdfs:label 'Recovery Probability Percent' ;
    rdfs:comment 'Estimated likelihood of recovering the written-off balance, expressed as a percentage.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Flag' ;
    rdfs:comment 'Indicates whether this write-off must be reported to regulatory authorities.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statutoryCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Statutory Category Code' ;
    rdfs:comment 'NAIC statutory accounting category for the write-off.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffStatus rdf:type rdf:Property ;
    rdfs:label 'Write Off Status' ;
    rdfs:comment 'Current lifecycle state of the write-off transaction.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffType rdf:type rdf:Property ;
    rdfs:label 'Write Off Type' ;
    rdfs:comment 'Category of write-off indicating the business reason for the action. [ENUM-REF-CANDIDATE: bad_debt|small_balance|regulatory|administrative|bankruptcy|deceased|statute_of_limitations — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accumulationLimitId rdf:type rdf:Property ;
    rdfs:label 'Accumulation Limit Id' ;
    rdfs:comment 'Unique identifier for the accumulation limit record. Primary key.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catModelVersionId rdf:type rdf:Property ;
    rdfs:label 'Cat Model Version Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.cat_model_version. Business justification: Accumulation limits are informed by CAT model versions for PML-based thresholds. Adding cat_model_version_id FK for model lineage tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatModelVersion .

ind:catZoneId rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Id' ;
    rdfs:comment 'Reference to the catastrophe zone to which this accumulation limit applies.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatZone .

ind:catastrophegeographyPerilId rdf:type rdf:Property ;
    rdfs:label 'Catastrophegeography Peril Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.peril. Business justification: Accumulation limits are set per peril. Adding peril_id FK to peril reference table for referential integrity. peril_code remains for operational queries.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatastrophegeographyPeril .

ind:reinsuranceTreatyId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Id' ;
    rdfs:comment 'Reference to the reinsurance treaty that provides capacity supporting this accumulation limit, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Treaty .

ind:accumulationLimitStatus rdf:type rdf:Property ;
    rdfs:label 'Accumulation Limit Status' ;
    rdfs:comment 'Current lifecycle status of the accumulation limit: active, suspended, expired, pending approval, or withdrawn.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Role or title of the individual or committee authorized to approve this accumulation limit, such as Chief Underwriting Officer or Risk Committee.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the person who approved this accumulation limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availableCapacity rdf:type rdf:Property ;
    rdfs:label 'Available Capacity' ;
    rdfs:comment 'Remaining capacity available under this accumulation limit, calculated as limit amount minus utilization amount.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessJustification rdf:type rdf:Property ;
    rdfs:label 'Business Justification' ;
    rdfs:comment 'Textual explanation of the business rationale for setting this accumulation limit at the specified level.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Timestamp' ;
    rdfs:comment 'Timestamp when the utilization and available capacity were last calculated for this accumulation limit.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cededPercent rdf:type rdf:Property ;
    rdfs:label 'Ceded Percent' ;
    rdfs:comment 'Percentage of exposure ceded to reinsurers under treaties applicable to this zone and peril.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Data Quality Score' ;
    rdfs:comment 'Score from 0 to 100 indicating the quality and completeness of the underlying exposure data used to calculate utilization against this limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'Textual description of the geographic area covered by this accumulation limit, such as state, region, or custom zone definition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hardThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Hard Threshold Percent' ;
    rdfs:comment 'Utilization percentage at which new business is declined or suspended, typically 95-100 percent of the limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date on which this accumulation limit was last reviewed by underwriting or risk management.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:limitAmount rdf:type rdf:Property ;
    rdfs:label 'Limit Amount' ;
    rdfs:comment 'Maximum aggregate exposure amount allowed in this zone for this peril and line of business. Enforces underwriting appetite constraints.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitBasis rdf:type rdf:Property ;
    rdfs:label 'Limit Basis' ;
    rdfs:comment 'Basis on which the limit is applied: per occurrence, aggregate across all events, or annual aggregate.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Type of exposure measure this limit applies to: Total Insured Value, Gross Written Premium, policy count, insured risk count, Probable Maximum Loss, or Average Annual Loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVendor rdf:type rdf:Property ;
    rdfs:label 'Model Vendor' ;
    rdfs:comment 'Vendor of the catastrophe model used to define exposure and set this limit: RMS, AIR, Karen Clark, EQECAT, internal model, or other.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'Version identifier of the catastrophe model used to calculate exposure and set this accumulation limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Net Retention Amount' ;
    rdfs:comment 'Amount of exposure retained net of reinsurance under this accumulation limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next review of this accumulation limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Override Allowed Flag' ;
    rdfs:comment 'Indicates whether underwriters are permitted to override this accumulation limit with appropriate authority. True if override allowed, false otherwise.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Override Authority Level' ;
    rdfs:comment 'Minimum authority level required to override this accumulation limit, such as Senior Underwriter, Chief Underwriting Officer, or Risk Committee.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilCode rdf:type rdf:Property ;
    rdfs:label 'Peril Code' ;
    rdfs:comment 'Code identifying the catastrophe peril for this limit, such as hurricane, earthquake, flood, wildfire, tornado, hail.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlReturnPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Pml Return Period Years' ;
    rdfs:comment 'Return period in years for the Probable Maximum Loss calculation used to inform this limit, such as 100, 250, 500, or 1000 years.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference' ;
    rdfs:comment 'Citation or reference to the specific regulation, statute, or guideline that mandates or informs this accumulation limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Indicates whether this accumulation limit is mandated by regulatory or statutory requirements. True if mandated, false otherwise.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Frequency' ;
    rdfs:comment 'Frequency at which this accumulation limit is reviewed and potentially adjusted: daily, weekly, monthly, quarterly, annually, or event-driven.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:softThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Soft Threshold Percent' ;
    rdfs:comment 'Utilization percentage at which referral or enhanced monitoring is triggered, typically 80-90 percent of the limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdAction rdf:type rdf:Property ;
    rdfs:label 'Threshold Action' ;
    rdfs:comment 'Action to be taken when utilization exceeds defined thresholds: allow with monitoring, refer to senior underwriter, decline new business, or suspend writing.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilizationAmount rdf:type rdf:Property ;
    rdfs:label 'Utilization Amount' ;
    rdfs:comment 'Current aggregate exposure amount utilized against this limit, calculated from in-force policies and insured risks in the zone.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizationPercent rdf:type rdf:Property ;
    rdfs:label 'Utilization Percent' ;
    rdfs:comment 'Percentage of the accumulation limit currently utilized, calculated as utilization amount divided by limit amount times 100.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catEventLossId rdf:type rdf:Property ;
    rdfs:label 'Cat Event Loss Id' ;
    rdfs:comment 'Unique identifier for the catastrophe event loss record. Primary key for this table.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatyId rdf:type rdf:Property ;
    rdfs:label 'Treaty Id' ;
    rdfs:comment 'Foreign key linking to reinsurance.treaty. Business justification: Catastrophe event loss estimates drive treaty layer attachment and exhaustion calculations for reinsurance purchasing decisions, capital modeling, and reinstatement premium triggers.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Treaty .

ind:accidentYear rdf:type rdf:Property ;
    rdfs:label 'Accident Year' ;
    rdfs:comment 'Accident year in which the catastrophe event occurred, used for loss development and reserving.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alaeAmount rdf:type rdf:Property ;
    rdfs:label 'Alae Amount' ;
    rdfs:comment 'Allocated loss adjustment expenses directly attributable to this CAT event loss segment.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageAnnualLoss rdf:type rdf:Property ;
    rdfs:label 'Average Annual Loss' ;
    rdfs:comment 'Average annual loss estimate for this segment based on catastrophe modeling.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Amount' ;
    rdfs:comment 'Portion of gross loss ceded to reinsurers under treaty or facultative agreements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCountEstimate rdf:type rdf:Property ;
    rdfs:label 'Claim Count Estimate' ;
    rdfs:comment 'Estimated or actual number of claims arising from this CAT event within this segment.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Percent' ;
    rdfs:comment 'Statistical confidence level for modeled loss estimates (e.g., 90%, 95%, 99%).' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimateDate rdf:type rdf:Property ;
    rdfs:label 'Estimate Date' ;
    rdfs:comment 'Date on which this CAT loss estimate was generated or last updated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimateStatus rdf:type rdf:Property ;
    rdfs:label 'Estimate Status' ;
    rdfs:comment 'Current status of this CAT loss estimate in the reporting lifecycle.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyCode rdf:type rdf:Property ;
    rdfs:label 'Geography Code' ;
    rdfs:comment 'Geographic zone or territory code for aggregating exposure (state, region, or custom zone).' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossLossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Loss Amount' ;
    rdfs:comment 'Total estimated or actual loss before reinsurance cessions and recoveries.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnrLoadingAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Loading Amount' ;
    rdfs:comment 'Additional reserve loading for incurred but not reported losses within this CAT event and segment.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossEstimateType rdf:type rdf:Property ;
    rdfs:label 'Loss Estimate Type' ;
    rdfs:comment 'Indicates whether the loss is modeled (pre-event), actual (post-event), hybrid, preliminary, or final.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Percent' ;
    rdfs:comment 'Loss ratio for this CAT event segment, calculated as net loss divided by earned premium.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netLossAmount rdf:type rdf:Property ;
    rdfs:label 'Net Loss Amount' ;
    rdfs:comment 'Net loss retained by the insurer after reinsurance cessions (gross minus ceded).' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyCount rdf:type rdf:Property ;
    rdfs:label 'Policy Count' ;
    rdfs:comment 'Number of policies in force within this CAT event, LOB, and geography segment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:probableMaximumLoss rdf:type rdf:Property ;
    rdfs:label 'Probable Maximum Loss' ;
    rdfs:comment 'Probable maximum loss estimate for this segment at a specified return period (e.g., 250-year PML).' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportYear rdf:type rdf:Property ;
    rdfs:label 'Report Year' ;
    rdfs:comment 'Calendar year in which this CAT loss estimate was reported or filed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:returnPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Return Period Years' ;
    rdfs:comment 'Return period in years for the PML estimate (e.g., 100, 250, 500 years).' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalInsuredValue rdf:type rdf:Property ;
    rdfs:label 'Total Insured Value' ;
    rdfs:comment 'Total insured value of all exposures within this CAT event, LOB, and geography segment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ulaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ulae Amount' ;
    rdfs:comment 'Unallocated loss adjustment expenses apportioned to this CAT event loss segment.' ;
    rdfs:domain ind:CatEventLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catEventZoneXrefId rdf:type rdf:Property ;
    rdfs:label 'Cat Event Zone Xref Id' ;
    rdfs:comment 'Unique identifier for the catastrophe event zone cross-reference record. One row per CAT event per zone.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Source of the impact data for this zone: model-generated, observed from weather stations, or hybrid combining both.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposedPolicyCount rdf:type rdf:Property ;
    rdfs:label 'Exposed Policy Count' ;
    rdfs:comment 'Number of in-force policies with insured risks located in this zone at the time of the catastrophe event. Used for FNOL triage and exposure reporting.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exposedTivAmount rdf:type rdf:Property ;
    rdfs:label 'Exposed Tiv Amount' ;
    rdfs:comment 'Total insured value of all insured risks located in this zone at the time of the catastrophe event. Used for PML and AAL calculations.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Exposure End Timestamp' ;
    rdfs:comment 'Timestamp when the catastrophe event ceased impacting this zone. Used to define the loss occurrence window.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exposureStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Exposure Start Timestamp' ;
    rdfs:comment 'Timestamp when the catastrophe event began impacting this zone. Used to determine policy in-force status at loss inception.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:firePerimeterFlag rdf:type rdf:Property ;
    rdfs:label 'Fire Perimeter Flag' ;
    rdfs:comment 'Indicates whether this zone was within the fire perimeter during a wildfire catastrophe event. Used to identify direct fire exposure.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fireProximityMiles rdf:type rdf:Property ;
    rdfs:label 'Fire Proximity Miles' ;
    rdfs:comment 'Distance in miles from the zone centroid to the nearest wildfire perimeter. Null for non-wildfire perils.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:floodDepthFt rdf:type rdf:Property ;
    rdfs:label 'Flood Depth Ft' ;
    rdfs:comment 'Maximum flood water depth in feet recorded in this zone during the catastrophe event. Null for non-flood perils.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fnolPriorityScore rdf:type rdf:Property ;
    rdfs:label 'Fnol Priority Score' ;
    rdfs:comment 'Calculated priority score for FNOL triage based on severity, exposure, and modeled loss. Higher scores indicate higher priority for claims outreach.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geocodingAccuracy rdf:type rdf:Property ;
    rdfs:label 'Geocoding Accuracy' ;
    rdfs:comment 'Accuracy level of the geocoding used to assign insured risks to this zone. Impacts confidence in exposure aggregation.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hailSizeInches rdf:type rdf:Property ;
    rdfs:label 'Hail Size Inches' ;
    rdfs:comment 'Maximum hail diameter in inches recorded in this zone during the catastrophe event. Null for non-hail perils.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impactSeverityBand rdf:type rdf:Property ;
    rdfs:label 'Impact Severity Band' ;
    rdfs:comment 'Categorical severity classification of the catastrophe impact within this zone. Used to prioritize FNOL triage and reserve estimation.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modeledDamagePercent rdf:type rdf:Property ;
    rdfs:label 'Modeled Damage Percent' ;
    rdfs:comment 'Catastrophe model-predicted average damage percentage to insured structures in this zone. Used for reserve estimation and exposure aggregation.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modeledLossRatio rdf:type rdf:Property ;
    rdfs:label 'Modeled Loss Ratio' ;
    rdfs:comment 'Catastrophe model-predicted loss ratio for this zone based on exposure and hazard intensity. Used for initial reserve estimation and FNOL prioritization.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakGroundAcceleration rdf:type rdf:Property ;
    rdfs:label 'Peak Ground Acceleration' ;
    rdfs:comment 'Peak ground acceleration in g-force units recorded in this zone during an earthquake event. Null for non-earthquake perils.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rainfallInches rdf:type rdf:Property ;
    rdfs:label 'Rainfall Inches' ;
    rdfs:comment 'Total rainfall accumulation in inches recorded in this zone during the catastrophe event. Null for non-precipitation perils.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shakeIntensity rdf:type rdf:Property ;
    rdfs:label 'Shake Intensity' ;
    rdfs:comment 'Modified Mercalli Intensity scale value representing earthquake shaking intensity in this zone. Null for non-earthquake perils.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormSurgeFlag rdf:type rdf:Property ;
    rdfs:label 'Storm Surge Flag' ;
    rdfs:comment 'Indicates whether storm surge was present in this zone during the catastrophe event. Used to filter coastal exposure for FNOL triage.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stormSurgeHeightFt rdf:type rdf:Property ;
    rdfs:label 'Storm Surge Height Ft' ;
    rdfs:comment 'Maximum storm surge height in feet above normal tide level recorded in this zone. Null if storm surge was not present.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subPerilCode rdf:type rdf:Property ;
    rdfs:label 'Sub Peril Code' ;
    rdfs:comment 'Code identifying the secondary or sub-peril type for this catastrophe event zone impact. Examples: STORM_SURGE, WIND_DRIVEN_RAIN, LIQUEFACTION.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tornadoRating rdf:type rdf:Property ;
    rdfs:label 'Tornado Rating' ;
    rdfs:comment 'Enhanced Fujita scale rating for tornado intensity in this zone. Null for non-tornado perils.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windGustMph rdf:type rdf:Property ;
    rdfs:label 'Wind Gust Mph' ;
    rdfs:comment 'Peak wind gust speed in miles per hour recorded in this zone during the catastrophe event. Null for non-wind perils.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Wind Speed Mph' ;
    rdfs:comment 'Maximum sustained wind speed in miles per hour recorded in this zone during the catastrophe event. Null for non-wind perils.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Code identifying the geographic zone impacted by the catastrophe event. Typically county FIPS, ZIP code, or model-specific zone identifier.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneType rdf:type rdf:Property ;
    rdfs:label 'Zone Type' ;
    rdfs:comment 'Type of geographic zone definition used for this cross-reference. Determines the granularity and source of zone boundaries.' ;
    rdfs:domain ind:CatEventZoneXref ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByVersionCatModelVersionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Version Cat Model Version Id' ;
    rdfs:comment 'Reference to the newer catastrophe model version that replaces this version when it is deprecated.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatModelVersion .

ind:approvedJurisdictions rdf:type rdf:Property ;
    rdfs:label 'Approved Jurisdictions' ;
    rdfs:comment 'Comma-separated list of state or jurisdiction codes where this model version has received regulatory approval for rate filing.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkComparisonFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Comparison Flag' ;
    rdfs:comment 'Indicates whether this model version has been benchmarked against prior versions or alternative vendor models.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catModelVersionStatus rdf:type rdf:Property ;
    rdfs:label 'Cat Model Version Status' ;
    rdfs:comment 'Current lifecycle status of this catastrophe model version within the organization.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateScenario rdf:type rdf:Property ;
    rdfs:label 'Climate Scenario' ;
    rdfs:comment 'Climate change scenario or baseline climate period used in this model version for hazard frequency and severity.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCodes rdf:type rdf:Property ;
    rdfs:label 'Country Codes' ;
    rdfs:comment 'Comma-separated list of ISO 3-letter country codes where this model version is applicable.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationUrl rdf:type rdf:Property ;
    rdfs:label 'Documentation Url' ;
    rdfs:comment 'URL or file path to the vendor technical documentation and methodology guide for this model version.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSetSize rdf:type rdf:Property ;
    rdfs:label 'Event Set Size' ;
    rdfs:comment 'Number of simulated catastrophe events in the stochastic event set for probabilistic models.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialModuleVersion rdf:type rdf:Property ;
    rdfs:label 'Financial Module Version' ;
    rdfs:comment 'Version identifier for the financial loss calculation and insurance terms module used in this model release.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicCoverage rdf:type rdf:Property ;
    rdfs:label 'Geographic Coverage' ;
    rdfs:comment 'Description of the geographic regions and territories covered by this model version.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardModuleVersion rdf:type rdf:Property ;
    rdfs:label 'Hazard Module Version' ;
    rdfs:comment 'Version identifier for the hazard generation and intensity module used in this model release.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Date when the organization license to use this model version expires and requires renewal.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lobApplicability rdf:type rdf:Property ;
    rdfs:label 'Lob Applicability' ;
    rdfs:comment 'Comma-separated list of insurance line of business codes for which this model version is designed and validated.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelName rdf:type rdf:Property ;
    rdfs:label 'Model Name' ;
    rdfs:comment 'Official name of the catastrophe model product line from the vendor.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelType rdf:type rdf:Property ;
    rdfs:label 'Model Type' ;
    rdfs:comment 'Classification of the modeling methodology used by this version.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlReturnPeriods rdf:type rdf:Property ;
    rdfs:label 'Pml Return Periods' ;
    rdfs:comment 'Comma-separated list of return period years for which this model version can calculate PML estimates.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryUseCase rdf:type rdf:Property ;
    rdfs:label 'Primary Use Case' ;
    rdfs:comment 'Primary business function for which this model version is designated within the organization.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Status' ;
    rdfs:comment 'Status of regulatory approval or acceptance of this model version by relevant state insurance departments.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseDate rdf:type rdf:Property ;
    rdfs:label 'Release Date' ;
    rdfs:comment 'Date when the vendor officially released this model version to the market.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionLevel rdf:type rdf:Property ;
    rdfs:label 'Resolution Level' ;
    rdfs:comment 'Spatial resolution or granularity at which this model version performs hazard and vulnerability analysis.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:simulationYears rdf:type rdf:Property ;
    rdfs:label 'Simulation Years' ;
    rdfs:comment 'Number of years of simulated catastrophe activity represented in the stochastic event set.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stateProvinceCoverage rdf:type rdf:Property ;
    rdfs:label 'State Province Coverage' ;
    rdfs:comment 'Comma-separated list of state or province codes covered by this model version for sub-national analysis.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportedPerils rdf:type rdf:Property ;
    rdfs:label 'Supported Perils' ;
    rdfs:comment 'Comma-separated list of peril codes that this model version can analyze and score.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageRestrictions rdf:type rdf:Property ;
    rdfs:label 'Usage Restrictions' ;
    rdfs:comment 'Description of any contractual or technical restrictions on how this model version may be used within the organization.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date when internal actuarial and catastrophe modeling teams completed validation testing of this model version.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Status of internal validation and acceptance testing for this model version.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'Name of the catastrophe modeling vendor who developed and maintains this model version. [ENUM-REF-CANDIDATE: RMS|AIR|CoreLogic|KCC|EQECAT|JBA|Fathom|Other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Version identifier assigned by the vendor to this specific model release.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vulnerabilityFunctionsVersion rdf:type rdf:Property ;
    rdfs:label 'Vulnerability Functions Version' ;
    rdfs:comment 'Version identifier for the damage and vulnerability functions used in this model release.' ;
    rdfs:domain ind:CatModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aalAmount rdf:type rdf:Property ;
    rdfs:label 'Aal Amount' ;
    rdfs:comment 'Average annual loss amount in USD expected from catastrophe events in this zone, used for reinsurance treaty pricing and capital allocation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:concentrationThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Concentration Threshold Amount' ;
    rdfs:comment 'Maximum total insured value in USD allowed in this zone before underwriting referral or capacity restrictions are triggered.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:concentrationThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Concentration Threshold Percentage' ;
    rdfs:comment 'Maximum percentage of total company exposure allowed in this zone before underwriting referral or capacity restrictions are triggered.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO country code where this catastrophe zone is located, used for international exposure reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Iso Territory Code' ;
    rdfs:comment 'ISO-standardized territory code used for rating and catastrophe zone classification in ISO-based rating plans.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCatEventDate rdf:type rdf:Property ;
    rdfs:label 'Last Cat Event Date' ;
    rdfs:comment 'Date of the most recent catastrophe event that impacted this zone, used for loss history and model validation.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCatEventLossAmount rdf:type rdf:Property ;
    rdfs:label 'Last Cat Event Loss Amount' ;
    rdfs:comment 'Total incurred loss amount in USD from the most recent catastrophe event in this zone, used for model validation and pricing.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastCatEventName rdf:type rdf:Property ;
    rdfs:label 'Last Cat Event Name' ;
    rdfs:comment 'Name of the most recent catastrophe event that impacted this zone, such as Hurricane Ian or Northridge Earthquake.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'Timestamp when this catastrophe zone record was most recently modified, including model updates or threshold changes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:modelUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Model Update Date' ;
    rdfs:comment 'Date when the catastrophe model version for this zone was last updated or recalibrated.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modelingVendor rdf:type rdf:Property ;
    rdfs:label 'Modeling Vendor' ;
    rdfs:comment 'Catastrophe modeling vendor whose model defines this zone: RMS, AIR, CoreLogic, KCC, or Internal proprietary model.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moratoriumEndDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium End Date' ;
    rdfs:comment 'Date when the current catastrophe moratorium is scheduled to end for this zone. Null if no moratorium or open-ended.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:moratoriumFlag rdf:type rdf:Property ;
    rdfs:label 'Moratorium Flag' ;
    rdfs:comment 'Indicates whether a catastrophe moratorium is currently in effect, prohibiting new business or policy changes in this zone.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moratoriumStartDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium Start Date' ;
    rdfs:comment 'Date when the current catastrophe moratorium began for this zone. Null if no moratorium is in effect.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:naicTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Naic Territory Code' ;
    rdfs:comment 'NAIC-standardized territory code mapping this catastrophe zone to regulatory reporting categories.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilType rdf:type rdf:Property ;
    rdfs:label 'Peril Type' ;
    rdfs:comment 'Primary catastrophe peril associated with this zone: wind, earthquake, flood, hail, wildfire, or tornado.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pml100YearAmount rdf:type rdf:Property ;
    rdfs:label 'Pml 100 Year Amount' ;
    rdfs:comment 'Probable maximum loss amount in USD for a 100-year return period event in this zone, used for reinsurance attachment point determination.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pml250YearAmount rdf:type rdf:Property ;
    rdfs:label 'Pml 250 Year Amount' ;
    rdfs:comment 'Probable maximum loss amount in USD for a 250-year return period event in this zone, used for catastrophe excess of loss treaty structuring.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pml500YearAmount rdf:type rdf:Property ;
    rdfs:label 'Pml 500 Year Amount' ;
    rdfs:comment 'Probable maximum loss amount in USD for a 500-year return period event in this zone, used for regulatory capital and solvency modeling.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Code' ;
    rdfs:comment 'Code used for catastrophe zone reporting to state departments of insurance and NAIC annual statement Schedule P catastrophe supplement.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceAttachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Attachment Point' ;
    rdfs:comment 'Loss amount in USD at which catastrophe excess of loss reinsurance coverage attaches for events in this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceLimit rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Limit' ;
    rdfs:comment 'Maximum reinsurance recovery amount in USD available for catastrophe events in this zone under current treaty structure.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tivAmount rdf:type rdf:Property ;
    rdfs:label 'Tiv Amount' ;
    rdfs:comment 'Total insured value in USD of all policies and insured risks currently assigned to this catastrophe zone.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwritingRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Underwriting Restriction Flag' ;
    rdfs:comment 'Indicates whether new business or renewal underwriting restrictions are currently in effect for this catastrophe zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zoneDescription rdf:type rdf:Property ;
    rdfs:label 'Zone Description' ;
    rdfs:comment 'Detailed description of the catastrophe zone, including geographic boundaries, peril characteristics, and modeling assumptions.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Human-readable name of the catastrophe zone, such as Florida Wind Zone 1 or California Earthquake Zone A.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneStatus rdf:type rdf:Property ;
    rdfs:label 'Zone Status' ;
    rdfs:comment 'Current lifecycle status of the catastrophe zone: active for rating, inactive, suspended, or under review for model updates.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneTier rdf:type rdf:Property ;
    rdfs:label 'Zone Tier' ;
    rdfs:comment 'Risk tier classification of the catastrophe zone based on loss frequency and severity: tier 1 highest risk, tier 4 lowest risk.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acresBurned rdf:type rdf:Property ;
    rdfs:label 'Acres Burned' ;
    rdfs:comment 'Total number of acres burned during the wildfire event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualLossAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Loss Amount' ;
    rdfs:comment 'Actual reported insured loss amount for this catastrophe event after claims settlement in USD.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affectedCountries rdf:type rdf:Property ;
    rdfs:label 'Affected Countries' ;
    rdfs:comment 'Comma-separated list of ISO 3-letter country codes where the catastrophe event caused insured losses.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedStates rdf:type rdf:Property ;
    rdfs:label 'Affected States' ;
    rdfs:comment 'Comma-separated list of US state postal codes where the catastrophe event caused insured losses.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catBondTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Bond Trigger Flag' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered a catastrophe bond payout.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:declarationDate rdf:type rdf:Property ;
    rdfs:label 'Declaration Date' ;
    rdfs:comment 'Date when the event was officially declared a catastrophe by industry or regulatory bodies.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:epicenterLatitude rdf:type rdf:Property ;
    rdfs:label 'Epicenter Latitude' ;
    rdfs:comment 'Latitude coordinate of the catastrophe event epicenter or origin point.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:epicenterLongitude rdf:type rdf:Property ;
    rdfs:label 'Epicenter Longitude' ;
    rdfs:comment 'Longitude coordinate of the catastrophe event epicenter or origin point.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Claim Count' ;
    rdfs:comment 'Estimated total number of insurance claims expected to be filed industry-wide for this catastrophe event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Detailed narrative description of the catastrophe event including impact, path, and key characteristics.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDurationDays rdf:type rdf:Property ;
    rdfs:label 'Event Duration Days' ;
    rdfs:comment 'Total number of days the catastrophe event lasted from start to end.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventEndDate rdf:type rdf:Property ;
    rdfs:label 'Event End Date' ;
    rdfs:comment 'Date when the catastrophe event concluded or was declared over.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventName rdf:type rdf:Property ;
    rdfs:label 'Event Name' ;
    rdfs:comment 'Official name assigned to the catastrophe event (e.g., Hurricane Katrina, Northridge Earthquake).' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStartDate rdf:type rdf:Property ;
    rdfs:label 'Event Start Date' ;
    rdfs:comment 'Date when the catastrophe event began.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current lifecycle status of the catastrophe event record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'High-level classification of the catastrophe event origin.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalDisasterDeclarationFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Disaster Declaration Flag' ;
    rdfs:comment 'Indicates whether a federal disaster declaration was issued for this catastrophe event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:femaDisasterNumber rdf:type rdf:Property ;
    rdfs:label 'Fema Disaster Number' ;
    rdfs:comment 'Official FEMA disaster declaration number assigned to the event.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicFootprintDescription rdf:type rdf:Property ;
    rdfs:label 'Geographic Footprint Description' ;
    rdfs:comment 'Narrative description of the geographic area impacted by the catastrophe event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryLossEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Industry Loss Estimate Amount' ;
    rdfs:comment 'Estimated total insured loss across the entire insurance industry for this catastrophe event in USD.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:industryLossEstimateCurrency rdf:type rdf:Property ;
    rdfs:label 'Industry Loss Estimate Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the industry loss estimate.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoCatSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Iso Cat Serial Number' ;
    rdfs:comment 'Industry-standard ISO serial number uniquely identifying the catastrophe event for cross-carrier reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossDevelopmentFactor rdf:type rdf:Property ;
    rdfs:label 'Loss Development Factor' ;
    rdfs:comment 'Factor representing the ratio of ultimate loss to reported loss, used for IBNR estimation.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:magnitudeScale rdf:type rdf:Property ;
    rdfs:label 'Magnitude Scale' ;
    rdfs:comment 'Name of the scale used to measure event magnitude (e.g., Richter, Moment Magnitude, Saffir-Simpson, Enhanced Fujita).' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:magnitudeValue rdf:type rdf:Property ;
    rdfs:label 'Magnitude Value' ;
    rdfs:comment 'Quantitative measure of event intensity (e.g., Richter scale for earthquakes, Saffir-Simpson for hurricanes).' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modeledLossAmount rdf:type rdf:Property ;
    rdfs:label 'Modeled Loss Amount' ;
    rdfs:comment 'Loss amount calculated by catastrophe modeling software for this event in USD.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nfipParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Nfip Participation Flag' ;
    rdfs:comment 'Indicates whether the event triggered NFIP claims and participation.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pmlAmount rdf:type rdf:Property ;
    rdfs:label 'Pml Amount' ;
    rdfs:comment 'Probable maximum loss amount for this catastrophe event based on exposure modeling in USD.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmlClass rdf:type rdf:Property ;
    rdfs:label 'Pml Class' ;
    rdfs:comment 'Classification of the event based on probable maximum loss severity.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precipitationInches rdf:type rdf:Property ;
    rdfs:label 'Precipitation Inches' ;
    rdfs:comment 'Total precipitation recorded during the event in inches, applicable to flood and storm events.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Trigger Flag' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered reinsurance treaty or facultative coverage.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stormSurgeFeet rdf:type rdf:Property ;
    rdfs:label 'Storm Surge Feet' ;
    rdfs:comment 'Maximum storm surge height recorded in feet, applicable to hurricanes and coastal flooding events.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureSummaryId rdf:type rdf:Property ;
    rdfs:label 'Exposure Summary Id' ;
    rdfs:comment 'Unique identifier for the exposure summary record. Primary key.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExposureSummary .

ind:asOfDate rdf:type rdf:Property ;
    rdfs:label 'As Of Date' ;
    rdfs:comment 'The accounting or valuation date for which this exposure snapshot was calculated. Enables point-in-time exposure reporting.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:concentrationIndex rdf:type rdf:Property ;
    rdfs:label 'Concentration Index' ;
    rdfs:comment 'A normalized measure of exposure concentration within this geography, peril, and LOB. Higher values indicate greater concentration risk. Calculated as TIV divided by geographic area or policy count.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constructionClass rdf:type rdf:Property ;
    rdfs:label 'Construction Class' ;
    rdfs:comment 'The predominant construction type of insured risks within this exposure aggregation: frame, masonry, steel, concrete, or mixed construction.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureBasis rdf:type rdf:Property ;
    rdfs:label 'Exposure Basis' ;
    rdfs:comment 'The basis on which exposure is measured: TIV (Total Insured Value), LIMIT (Policy Limit), PREMIUM (Written Premium), UNIT_COUNT (Number of Units/Risks).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gwpAmount rdf:type rdf:Property ;
    rdfs:label 'Gwp Amount' ;
    rdfs:comment 'The gross written premium aggregated across all policies within this geography, peril, and LOB combination as of the as-of date. Represents premium exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuredRiskCount rdf:type rdf:Property ;
    rdfs:label 'Insured Risk Count' ;
    rdfs:comment 'The number of distinct insured risks (locations, buildings, vehicles, drivers) contributing to this exposure aggregation as of the as-of date.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nwpAmount rdf:type rdf:Property ;
    rdfs:label 'Nwp Amount' ;
    rdfs:comment 'The net written premium (gross written premium less ceded reinsurance premium) aggregated across all policies within this geography, peril, and LOB combination as of the as-of date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupancyClass rdf:type rdf:Property ;
    rdfs:label 'Occupancy Class' ;
    rdfs:comment 'The predominant occupancy class of insured risks within this exposure aggregation: residential, commercial, industrial, agricultural, or mixed use.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionClass rdf:type rdf:Property ;
    rdfs:label 'Protection Class' ;
    rdfs:comment 'The ISO Public Protection Classification (PPC) or fire protection class code representing the quality of fire protection services in this geography. Lower numbers indicate better protection (1-10 scale).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionAmount rdf:type rdf:Property ;
    rdfs:label 'Retention Amount' ;
    rdfs:comment 'The company retention amount (deductible or self-insured retention) before reinsurance coverage applies for this geography, peril, and LOB combination.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treatySharePercent rdf:type rdf:Property ;
    rdfs:label 'Treaty Share Percent' ;
    rdfs:comment 'The percentage of exposure ceded to reinsurance treaties for this geography, peril, and LOB combination. Used for net exposure calculations.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:floodZoneId rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Id' ;
    rdfs:comment 'Unique identifier for the flood zone record. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FloodZone .

ind:areaSquareMiles rdf:type rdf:Property ;
    rdfs:label 'Area Square Miles' ;
    rdfs:comment 'Total geographic area of this flood zone in square miles.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseFloodElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Base Flood Elevation Feet' ;
    rdfs:comment 'Elevation in feet above mean sea level of the 1-percent-annual-chance flood, used for rating and building requirements.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRateFactor rdf:type rdf:Property ;
    rdfs:label 'Base Rate Factor' ;
    rdfs:comment 'Multiplicative rating factor applied to base premium for properties in this flood zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catastropheZoneCode rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Zone Code' ;
    rdfs:comment 'Internal catastrophe zone code linking this flood zone to catastrophe exposure aggregation and PML modeling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coastalBarrierFlag rdf:type rdf:Property ;
    rdfs:label 'Coastal Barrier Flag' ;
    rdfs:comment 'Indicates whether this zone is within a Coastal Barrier Resources System area where federal flood insurance is prohibited.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communityName rdf:type rdf:Property ;
    rdfs:label 'Community Name' ;
    rdfs:comment 'Name of the local government jurisdiction participating in NFIP where this flood zone is located.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communityNumber rdf:type rdf:Property ;
    rdfs:label 'Community Number' ;
    rdfs:comment 'Six-digit FEMA community identifier for the jurisdiction participating in the National Flood Insurance Program.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyFipsCode rdf:type rdf:Property ;
    rdfs:label 'County Fips Code' ;
    rdfs:comment 'Five-digit FIPS code identifying the county where this flood zone is located.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depthFeet rdf:type rdf:Property ;
    rdfs:label 'Depth Feet' ;
    rdfs:comment 'Average or typical flood depth in feet for shallow flooding areas such as AO zones.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalConversionDate rdf:type rdf:Property ;
    rdfs:label 'Digital Conversion Date' ;
    rdfs:comment 'Date when this flood zone was converted from paper FIRM to digital format as part of FEMA Map Modernization.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:elevationDatum rdf:type rdf:Property ;
    rdfs:label 'Elevation Datum' ;
    rdfs:comment 'Vertical datum reference system used for base flood elevation measurement.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmPanelNumber rdf:type rdf:Property ;
    rdfs:label 'Firm Panel Number' ;
    rdfs:comment 'Ten-digit FEMA FIRM panel identifier uniquely identifying the map panel containing this flood zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodFrequencyPercent rdf:type rdf:Property ;
    rdfs:label 'Flood Frequency Percent' ;
    rdfs:comment 'Annual probability of flooding expressed as a percentage for this zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:floodHazardDescription rdf:type rdf:Property ;
    rdfs:label 'Flood Hazard Description' ;
    rdfs:comment 'Narrative description of the flood hazard characteristics and risk profile for this zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodSource rdf:type rdf:Property ;
    rdfs:label 'Flood Source' ;
    rdfs:comment 'Name or description of the water body or flooding source creating the hazard in this zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZoneStatus rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Status' ;
    rdfs:comment 'Current lifecycle status of this flood zone record indicating whether it is in force or has been replaced.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodwayFlag rdf:type rdf:Property ;
    rdfs:label 'Floodway Flag' ;
    rdfs:comment 'Indicates whether this zone includes a regulatory floodway with additional building and development restrictions.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geocodeLatitude rdf:type rdf:Property ;
    rdfs:label 'Geocode Latitude' ;
    rdfs:comment 'Latitude coordinate of the centroid or representative point of this flood zone for spatial analysis.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geocodeLongitude rdf:type rdf:Property ;
    rdfs:label 'Geocode Longitude' ;
    rdfs:comment 'Longitude coordinate of the centroid or representative point of this flood zone for spatial analysis.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geometryWkt rdf:type rdf:Property ;
    rdfs:label 'Geometry Wkt' ;
    rdfs:comment 'Well-Known Text representation of the flood zone polygon boundary for GIS and spatial queries.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceMandatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Mandatory Flag' ;
    rdfs:comment 'Indicates whether flood insurance is federally mandated for mortgaged properties in this zone per NFIP requirements.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Verified Date' ;
    rdfs:comment 'Date when this flood zone record was last verified against official FEMA FIRM data for accuracy.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:letterOfMapChangeNumber rdf:type rdf:Property ;
    rdfs:label 'Letter Of Map Change Number' ;
    rdfs:comment 'FEMA-issued identifier for any Letter of Map Amendment or Letter of Map Revision affecting this zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lomcEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Lomc Effective Date' ;
    rdfs:comment 'Date when the most recent Letter of Map Change became effective for this flood zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preliminaryFlag rdf:type rdf:Property ;
    rdfs:label 'Preliminary Flag' ;
    rdfs:comment 'Indicates whether this flood zone is from a preliminary FIRM not yet officially adopted for regulatory use.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ratingTerritory rdf:type rdf:Property ;
    rdfs:label 'Rating Territory' ;
    rdfs:comment 'Internal rating territory code used for premium calculation and risk segmentation for this flood zone.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceTreatyApplicability rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Applicability' ;
    rdfs:comment 'Indicator of which reinsurance treaties apply to flood losses originating in this zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionDate rdf:type rdf:Property ;
    rdfs:label 'Revision Date' ;
    rdfs:comment 'Date of the most recent revision or amendment to this flood zone boundary or designation.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialFloodHazardAreaFlag rdf:type rdf:Property ;
    rdfs:label 'Special Flood Hazard Area Flag' ;
    rdfs:comment 'Indicates whether this zone is designated as a Special Flood Hazard Area with 1-percent-annual-chance flood risk.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:staticBfeFeet rdf:type rdf:Property ;
    rdfs:label 'Static Bfe Feet' ;
    rdfs:comment 'Base flood elevation excluding wave effects, used in coastal areas to separate stillwater elevation from wave action.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:studyType rdf:type rdf:Property ;
    rdfs:label 'Study Type' ;
    rdfs:comment 'Type of hydrologic and hydraulic study used to determine flood elevations and boundaries for this zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingEligibilityCode rdf:type rdf:Property ;
    rdfs:label 'Underwriting Eligibility Code' ;
    rdfs:comment 'Insurer-specific code indicating underwriting eligibility and appetite for properties in this flood zone.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:velocityFps rdf:type rdf:Property ;
    rdfs:label 'Velocity Fps' ;
    rdfs:comment 'Average flood water velocity in feet per second for high-velocity coastal zones such as V zones.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waveHeightFeet rdf:type rdf:Property ;
    rdfs:label 'Wave Height Feet' ;
    rdfs:comment 'Design wave height in feet for coastal high hazard areas subject to wave action.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zoneDesignation rdf:type rdf:Property ;
    rdfs:label 'Zone Designation' ;
    rdfs:comment 'FEMA flood zone classification code indicating flood risk level and insurance requirements. [ENUM-REF-CANDIDATE: A|AE|AH|AO|AR|A99|V|VE|X|B|C|D — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneSubtype rdf:type rdf:Property ;
    rdfs:label 'Zone Subtype' ;
    rdfs:comment 'Additional classification detail within the primary zone designation for specialized flood hazard areas.' ;
    rdfs:domain ind:FloodZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentGeographyId rdf:type rdf:Property ;
    rdfs:label 'Parent Geography Id' ;
    rdfs:comment 'Reference to the parent geography node in the hierarchy, enabling recursive drill-up from ZIP to county to state to country.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:catastropheZone rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Zone' ;
    rdfs:comment 'Catastrophe exposure zone classification (e.g., hurricane, earthquake, wildfire, flood) for PML (Probable Maximum Loss) and AAL (Average Annual Loss) modeling.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusTractCode rdf:type rdf:Property ;
    rdfs:label 'Census Tract Code' ;
    rdfs:comment 'US Census Bureau tract identifier, an 11-digit code combining state, county, and tract, used for demographic and socioeconomic analysis.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coastalIndicator rdf:type rdf:Property ;
    rdfs:label 'Coastal Indicator' ;
    rdfs:comment 'Flag indicating whether the geography unit is within a coastal exposure zone, subject to hurricane, storm surge, or coastal flood risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:countyCode rdf:type rdf:Property ;
    rdfs:label 'County Code' ;
    rdfs:comment 'FIPS county code, a five-digit identifier combining state and county codes, used for granular territory rating and catastrophe aggregation.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crestaZoneCode rdf:type rdf:Property ;
    rdfs:label 'Cresta Zone Code' ;
    rdfs:comment 'CRESTA zone identifier for catastrophe modeling and reinsurance reporting, standardizing geographic aggregation for CAT exposure.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earthquakeZone rdf:type rdf:Property ;
    rdfs:label 'Earthquake Zone' ;
    rdfs:comment 'Seismic hazard zone classification for earthquake exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZone rdf:type rdf:Property ;
    rdfs:label 'Flood Zone' ;
    rdfs:comment 'FEMA flood hazard zone designation (e.g., A, AE, X, V) for flood exposure assessment and NFIP (National Flood Insurance Program) compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyStatus rdf:type rdf:Property ;
    rdfs:label 'Geography Status' ;
    rdfs:comment 'Current lifecycle status of the geography record: active for in-use geographies, inactive for discontinued, deprecated for superseded, pending for future.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyType rdf:type rdf:Property ;
    rdfs:label 'Geography Type' ;
    rdfs:comment 'Classification of the geography node: country, state, county, ZIP, CRESTA zone, or census tract.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hailZone rdf:type rdf:Property ;
    rdfs:label 'Hail Zone' ;
    rdfs:comment 'Hail hazard zone classification for severe convective storm exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Updated Date' ;
    rdfs:comment 'Date when this geography record was last updated, supporting data quality audits and change tracking.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate in decimal degrees for the centroid of the geography unit, enabling spatial analysis and catastrophe modeling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate in decimal degrees for the centroid of the geography unit, enabling spatial analysis and catastrophe modeling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medianHouseholdIncome rdf:type rdf:Property ;
    rdfs:label 'Median Household Income' ;
    rdfs:comment 'Median household income in US dollars for the geography unit, used for socioeconomic segmentation and underwriting.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographyName rdf:type rdf:Property ;
    rdfs:label 'Geography Name' ;
    rdfs:comment 'Human-readable name of the geography unit, such as United States, California, Los Angeles County, or 90210.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:population rdf:type rdf:Property ;
    rdfs:label 'Population' ;
    rdfs:comment 'Total population count for the geography unit, used for exposure density analysis and market sizing.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Code' ;
    rdfs:comment 'Insurer-defined territory code used in rating and pricing, mapping geography to rate tables and underwriting rules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'IANA time zone identifier for the geography unit, used for timestamp normalization and operational scheduling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tornadoZone rdf:type rdf:Property ;
    rdfs:label 'Tornado Zone' ;
    rdfs:comment 'Tornado hazard zone classification for severe convective storm exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urbanRuralCode rdf:type rdf:Property ;
    rdfs:label 'Urban Rural Code' ;
    rdfs:comment 'US Census Bureau urban-rural classification code, used for demographic segmentation and territory rating.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wildfireZone rdf:type rdf:Property ;
    rdfs:label 'Wildfire Zone' ;
    rdfs:comment 'Wildfire hazard zone classification for wildfire exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windZone rdf:type rdf:Property ;
    rdfs:label 'Wind Zone' ;
    rdfs:comment 'Wind hazard zone classification for hurricane and windstorm exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipCode rdf:type rdf:Property ;
    rdfs:label 'Zip Code' ;
    rdfs:comment 'Five-digit or nine-digit ZIP code (ZIP+4) for US locations, used in rating, underwriting, and catastrophe exposure aggregation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyHierarchyId rdf:type rdf:Property ;
    rdfs:label 'Geography Hierarchy Id' ;
    rdfs:comment 'Unique identifier for each ancestor-descendant pair in the geography hierarchy closure table.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryAncestorGeographyId rdf:type rdf:Property ;
    rdfs:label 'Primary Ancestor Geography Id' ;
    rdfs:comment 'Identifier of the ancestor node in the geography hierarchy. Links to the parent or higher-level geography entity.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:aggregationWeight rdf:type rdf:Property ;
    rdfs:label 'Aggregation Weight' ;
    rdfs:comment 'Weighting factor applied when aggregating exposure or premium from descendant to ancestor. Used for proportional allocation in overlapping territories or catastrophe zones.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ancestorGeographyType rdf:type rdf:Property ;
    rdfs:label 'Ancestor Geography Type' ;
    rdfs:comment 'Classification of the ancestor geography node. Indicates the hierarchical level such as national, region, state, territory, county, zip, or catastrophe zone.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catZoneIndicator rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Indicator' ;
    rdfs:comment 'Indicates whether this hierarchy path includes a catastrophe zone node. True when the relationship is used for catastrophe exposure aggregation and Probable Maximum Loss (PML) modeling.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depthLevel rdf:type rdf:Property ;
    rdfs:label 'Depth Level' ;
    rdfs:comment 'Number of levels between ancestor and descendant. Zero indicates self-reference, one indicates direct parent-child, higher values indicate multi-level relationships.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:descendantGeographyType rdf:type rdf:Property ;
    rdfs:label 'Descendant Geography Type' ;
    rdfs:comment 'Classification of the descendant geography node. Indicates the hierarchical level such as national, region, state, territory, county, zip, or catastrophe zone.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyStatus rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Status' ;
    rdfs:comment 'Current status of this hierarchy relationship. Active indicates in use, inactive indicates retired, pending indicates future effective, superseded indicates replaced by newer version.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyVersion rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Version' ;
    rdfs:comment 'Version identifier for the geography hierarchy structure. Allows tracking of hierarchy changes over time for regulatory reporting and historical analysis.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLeafNode rdf:type rdf:Property ;
    rdfs:label 'Is Leaf Node' ;
    rdfs:comment 'Indicates whether the descendant node is a leaf node with no children. True for terminal nodes such as zip codes or specific locations.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRootNode rdf:type rdf:Property ;
    rdfs:label 'Is Root Node' ;
    rdfs:comment 'Indicates whether the ancestor node is a root node with no parent. True for top-level nodes such as national or enterprise-wide geography.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lobCode rdf:type rdf:Property ;
    rdfs:label 'Lob Code' ;
    rdfs:comment 'Line of business code for which this hierarchy path is applicable. Allows different geographic hierarchies for different product lines such as Personal Auto (PAP), Homeowners (HO), or Commercial General Liability (CGL).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Naic Company Code' ;
    rdfs:comment 'NAIC company code for which this hierarchy path is applicable. Supports multi-company operations with different geographic structures.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pathLength rdf:type rdf:Property ;
    rdfs:label 'Path Length' ;
    rdfs:comment 'Total number of edges in the path from ancestor to descendant. Used for traversal optimization and distance calculation.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:schedulePTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Schedule P Territory Code' ;
    rdfs:comment 'NAIC Schedule P territory code associated with this hierarchy path. Used for statutory financial reporting and loss reserve disclosure by geographic territory.' ;
    rdfs:domain ind:GeographyHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardScoreId rdf:type rdf:Property ;
    rdfs:label 'Hazard Score Id' ;
    rdfs:comment 'Unique identifier for the hazard score record. Primary key.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:locationId rdf:type rdf:Property ;
    rdfs:label 'Location Id' ;
    rdfs:comment 'Reference to the geographic location being scored.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:buildingAreaSqft rdf:type rdf:Property ;
    rdfs:label 'Building Area Sqft' ;
    rdfs:comment 'Total building area in square feet at the location.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catModelVendor rdf:type rdf:Property ;
    rdfs:label 'Cat Model Vendor' ;
    rdfs:comment 'Vendor providing the catastrophe model: RMS, AIR, EQECAT, Karen Clark, or internal proprietary model.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionType rdf:type rdf:Property ;
    rdfs:label 'Construction Type' ;
    rdfs:comment 'ISO construction class of the building at the location: frame, joisted masonry, non-combustible, masonry non-combustible, modified fire resistive, or fire resistive.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceToCoastMiles rdf:type rdf:Property ;
    rdfs:label 'Distance To Coast Miles' ;
    rdfs:comment 'Distance from the location to the nearest coastline in miles, relevant for hurricane and storm surge modeling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elevationFeet rdf:type rdf:Property ;
    rdfs:label 'Elevation Feet' ;
    rdfs:comment 'Elevation of the location above sea level in feet, relevant for flood and storm surge modeling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibilityReason rdf:type rdf:Property ;
    rdfs:label 'Eligibility Reason' ;
    rdfs:comment 'Explanation for underwriting eligibility determination, including any risk appetite thresholds exceeded or met.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceedanceProbability rdf:type rdf:Property ;
    rdfs:label 'Exceedance Probability' ;
    rdfs:comment 'Annual probability that losses will exceed a specified threshold for this location and peril, expressed as a decimal between 0 and 1.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geocodeQuality rdf:type rdf:Property ;
    rdfs:label 'Geocode Quality' ;
    rdfs:comment 'Precision level of the geocoding used for hazard scoring: rooftop, parcel, street, ZIP code, city, or county level.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardBand rdf:type rdf:Property ;
    rdfs:label 'Hazard Band' ;
    rdfs:comment 'Categorical risk band assigned based on hazard score: low, moderate, high, severe, or extreme. Used for underwriting eligibility screening.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardScore rdf:type rdf:Property ;
    rdfs:label 'Hazard Score' ;
    rdfs:comment 'Normalized hazard intensity score for the location and peril, typically ranging from 0 to 100 or 0 to 1000 depending on vendor scale.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Model Confidence Level' ;
    rdfs:comment 'Confidence level in the hazard score based on data quality and model certainty: high, medium, or low.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelRunDate rdf:type rdf:Property ;
    rdfs:label 'Model Run Date' ;
    rdfs:comment 'Date when the catastrophe model was executed to produce this hazard score.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:numberOfStories rdf:type rdf:Property ;
    rdfs:label 'Number Of Stories' ;
    rdfs:comment 'Total number of above-ground stories in the building at the location.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupancyType rdf:type rdf:Property ;
    rdfs:label 'Occupancy Type' ;
    rdfs:comment 'Primary use or occupancy classification of the building at the location.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pml1000Year rdf:type rdf:Property ;
    rdfs:label 'Pml 1000 Year' ;
    rdfs:comment 'Estimated loss amount at the 1000-year return period for this location and peril, expressed in USD.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pml100Year rdf:type rdf:Property ;
    rdfs:label 'Pml 100 Year' ;
    rdfs:comment 'Estimated loss amount at the 100-year return period for this location and peril, expressed in USD.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pml250Year rdf:type rdf:Property ;
    rdfs:label 'Pml 250 Year' ;
    rdfs:comment 'Estimated loss amount at the 250-year return period for this location and peril, expressed in USD.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pml500Year rdf:type rdf:Property ;
    rdfs:label 'Pml 500 Year' ;
    rdfs:comment 'Estimated loss amount at the 500-year return period for this location and peril, expressed in USD.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Score Effective Date' ;
    rdfs:comment 'Date from which this hazard score is effective for underwriting and pricing decisions.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scoreExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Score Expiration Date' ;
    rdfs:comment 'Date after which this hazard score is no longer valid and should be refreshed.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:soilType rdf:type rdf:Property ;
    rdfs:label 'Soil Type' ;
    rdfs:comment 'Soil classification at the location, relevant for earthquake modeling: rock, stiff soil, soft soil, or very soft soil.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Underwriting Eligibility Flag' ;
    rdfs:comment 'Indicates whether the location passes underwriting eligibility criteria based on hazard score and band. True if eligible, false if ineligible.' ;
    rdfs:domain ind:HazardScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearBuilt rdf:type rdf:Property ;
    rdfs:label 'Year Built' ;
    rdfs:comment 'Year the building at the location was originally constructed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isoCatSerialId rdf:type rdf:Property ;
    rdfs:label 'Iso Cat Serial Id' ;
    rdfs:comment 'Unique identifier for the ISO CAT serial record. Primary key.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedCounties rdf:type rdf:Property ;
    rdfs:label 'Affected Counties' ;
    rdfs:comment 'Comma-separated list of county names or FIPS codes within affected states where losses occurred, providing granular geographic detail for exposure analysis.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedLobCodes rdf:type rdf:Property ;
    rdfs:label 'Affected Lob Codes' ;
    rdfs:comment 'Comma-separated list of insurance line of business codes impacted by the catastrophe, such as HO for homeowners, PAP for personal auto, CGL for commercial general liability.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catBondTrigger rdf:type rdf:Property ;
    rdfs:label 'Cat Bond Trigger' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered catastrophe bond or insurance-linked securities ILS payout conditions based on parametric or indemnity triggers.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catEventName rdf:type rdf:Property ;
    rdfs:label 'Cat Event Name' ;
    rdfs:comment 'Official name of the catastrophe event as designated by ISO PCS, such as Hurricane Katrina, Northridge Earthquake, or Texas Winter Storm Uri.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earthquakeMagnitude rdf:type rdf:Property ;
    rdfs:label 'Earthquake Magnitude' ;
    rdfs:comment 'Richter or moment magnitude scale measurement of earthquake intensity for seismic catastrophe events, used for loss modeling and exposure analysis.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventCategory rdf:type rdf:Property ;
    rdfs:label 'Event Category' ;
    rdfs:comment 'High-level classification of the catastrophe event origin, distinguishing between natural disasters, man-made events, terrorism, pandemic, or cyber incidents.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hurricaneCategory rdf:type rdf:Property ;
    rdfs:label 'Hurricane Category' ;
    rdfs:comment 'Saffir-Simpson hurricane wind scale category at landfall for hurricane events, ranging from Tropical Depression TD, Tropical Storm TS, to Category 1 through 5.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryInsuredLossEstimate rdf:type rdf:Property ;
    rdfs:label 'Industry Insured Loss Estimate' ;
    rdfs:comment 'ISO PCS estimated total insured loss amount across all insurers for this catastrophe event, expressed in US dollars, used for industry benchmarking and market share analysis.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isoSerialEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Iso Serial Effective Date' ;
    rdfs:comment 'Date when the ISO CAT serial number was officially assigned and became effective for industry use in claim coding and loss reporting.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isoSerialExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Iso Serial Expiration Date' ;
    rdfs:comment 'Date when the ISO CAT serial number expires or is superseded, typically null for active catastrophe designations unless event is reclassified or withdrawn.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossEstimateDate rdf:type rdf:Property ;
    rdfs:label 'Loss Estimate Date' ;
    rdfs:comment 'Date when the industry insured loss estimate was published or last updated by ISO PCS, reflecting the valuation point for the estimate.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossEstimateStatus rdf:type rdf:Property ;
    rdfs:label 'Loss Estimate Status' ;
    rdfs:comment 'Current status of the industry loss estimate indicating whether it is preliminary, revised with updated data, final, or withdrawn due to threshold changes.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicCatCode rdf:type rdf:Property ;
    rdfs:label 'Naic Cat Code' ;
    rdfs:comment 'NAIC-assigned catastrophe code used for statutory annual statement Schedule P reporting, enabling consistent regulatory catastrophe loss tracking.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcsThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Pcs Threshold Amount' ;
    rdfs:comment 'Minimum insured loss amount in US dollars required for ISO PCS to designate an event as a catastrophe, used to validate threshold compliance.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pcsThresholdMet rdf:type rdf:Property ;
    rdfs:label 'Pcs Threshold Met' ;
    rdfs:comment 'Indicates whether the catastrophe event met the ISO PCS minimum loss threshold for designation as an industry catastrophe, typically 25 million USD in insured losses.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perilDescription rdf:type rdf:Property ;
    rdfs:label 'Peril Description' ;
    rdfs:comment 'Full text description of the catastrophe peril type for business user clarity and reporting purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryState rdf:type rdf:Property ;
    rdfs:label 'Primary State' ;
    rdfs:comment 'Two-letter postal code of the state with the highest concentration of insured losses for this catastrophe event, used for primary jurisdiction reporting.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required' ;
    rdfs:comment 'Indicates whether this catastrophe event requires special regulatory reporting to state departments of insurance or NAIC beyond standard annual statement filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceTreatyTrigger rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Trigger' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered reinsurance treaty coverage thresholds, requiring cession and recovery processing for affected policies and claims.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schedulePReportable rdf:type rdf:Property ;
    rdfs:label 'Schedule P Reportable' ;
    rdfs:comment 'Indicates whether losses from this catastrophe event must be separately identified in NAIC Annual Statement Schedule P Part 3 catastrophe loss reporting.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serialStatus rdf:type rdf:Property ;
    rdfs:label 'Serial Status' ;
    rdfs:comment 'Current lifecycle status of the ISO CAT serial number indicating whether it is active for use, inactive, superseded by a revised serial, or withdrawn.' ;
    rdfs:domain ind:IsoCatSerial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityClassification rdf:type rdf:Property ;
    rdfs:label 'Severity Classification' ;
    rdfs:comment 'Qualitative severity rating of the catastrophe event based on insured loss magnitude, geographic scope, and impact on the insurance industry.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPrecipitationInches rdf:type rdf:Property ;
    rdfs:label 'Total Precipitation Inches' ;
    rdfs:comment 'Total rainfall or liquid equivalent precipitation in inches recorded during the catastrophe event, relevant for flood and storm loss analysis.' ;
    rdfs:domain ind:IsoCatSerial ;
