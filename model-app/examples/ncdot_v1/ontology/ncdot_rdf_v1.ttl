    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fareCardType rdf:type rdf:Property ;
    rdfs:label 'Fare Card Type' ;
    rdfs:comment 'Type of fare card issued to the rider, corresponding to their eligibility category.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fareCardIssueDate rdf:type rdf:Property ;
    rdfs:label 'Fare Card Issue Date' ;
    rdfs:comment 'Date when the current fare card was issued to the rider.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fareCardExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Fare Card Expiration Date' ;
    rdfs:comment 'Date when the current fare card expires and requires renewal.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fareCardStatus rdf:type rdf:Property ;
    rdfs:label 'Fare Card Status' ;
    rdfs:comment 'Current status of the rider\'s fare card.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loyaltyProgramMember rdf:type rdf:Property ;
    rdfs:label 'Loyalty Program Member' ;
    rdfs:comment 'Indicates whether the rider is enrolled in the transit agency\'s loyalty or rewards program.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loyaltyProgramTier rdf:type rdf:Property ;
    rdfs:label 'Loyalty Program Tier' ;
    rdfs:comment 'Current tier level in the loyalty program, determining benefits and rewards.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loyaltyEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Loyalty Enrollment Date' ;
    rdfs:comment 'Date when the rider enrolled in the loyalty program.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationChannel rdf:type rdf:Property ;
    rdfs:label 'Registration Channel' ;
    rdfs:comment 'Channel through which the rider registered with the transit system.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusReason rdf:type rdf:Property ;
    rdfs:label 'Status Reason' ;
    rdfs:comment 'Reason for the current account status (e.g., non-payment, policy violation, voluntary suspension).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'Date of the rider\'s most recent transit activity (trip, fare payment, or account interaction).' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentMethodOnFile rdf:type rdf:Property ;
    rdfs:label 'Payment Method On File' ;
    rdfs:comment 'Primary payment method stored on file for the rider\'s account.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoReloadEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Reload Enabled' ;
    rdfs:comment 'Indicates whether automatic fare card reloading is enabled for the rider\'s account.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoReloadThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Auto Reload Threshold Amount' ;
    rdfs:comment 'Balance threshold that triggers automatic reload of the fare card.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoReloadAmount rdf:type rdf:Property ;
    rdfs:label 'Auto Reload Amount' ;
    rdfs:comment 'Dollar amount automatically loaded to the fare card when the threshold is reached.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lowIncomeVerified rdf:type rdf:Property ;
    rdfs:label 'Low Income Verified' ;
    rdfs:comment 'Indicates whether the rider has been verified as low-income for reduced fare eligibility.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incomeVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Income Verification Date' ;
    rdfs:comment 'Date when the rider\'s income status was last verified for reduced fare programs.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studentIdNumber rdf:type rdf:Property ;
    rdfs:label 'Student Id Number' ;
    rdfs:comment 'Student ID number from educational institution, used for student fare eligibility verification.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schoolName rdf:type rdf:Property ;
    rdfs:label 'School Name' ;
    rdfs:comment 'Name of the educational institution the rider attends, for student fare eligibility.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studentEnrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Student Enrollment Status' ;
    rdfs:comment 'Current enrollment status of the student rider.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veteranStatus rdf:type rdf:Property ;
    rdfs:label 'Veteran Status' ;
    rdfs:comment 'Indicates whether the rider is a military veteran eligible for veteran fare discounts.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veteranIdNumber rdf:type rdf:Property ;
    rdfs:label 'Veteran Id Number' ;
    rdfs:comment 'Veteran identification number for fare discount verification.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareNumber rdf:type rdf:Property ;
    rdfs:label 'Medicare Number' ;
    rdfs:comment 'Medicare beneficiary number for riders eligible for Medicare-based fare discounts.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidNumber rdf:type rdf:Property ;
    rdfs:label 'Medicaid Number' ;
    rdfs:comment 'Medicaid beneficiary number for riders eligible for Medicaid-based fare discounts or non-emergency medical transportation.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerName rdf:type rdf:Property ;
    rdfs:label 'Employer Name' ;
    rdfs:comment 'Name of the rider\'s employer, used for employer-sponsored transit pass programs.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerSubsidyEligible rdf:type rdf:Property ;
    rdfs:label 'Employer Subsidy Eligible' ;
    rdfs:comment 'Indicates whether the rider is eligible for employer-subsidized transit benefits.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInMarketing rdf:type rdf:Property ;
    rdfs:label 'Opt In Marketing' ;
    rdfs:comment 'Indicates whether the rider has opted in to receive marketing communications.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInSurveys rdf:type rdf:Property ;
    rdfs:label 'Opt In Surveys' ;
    rdfs:comment 'Indicates whether the rider has opted in to participate in customer satisfaction surveys.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInDataSharing rdf:type rdf:Property ;
    rdfs:label 'Opt In Data Sharing' ;
    rdfs:comment 'Indicates whether the rider has consented to sharing their data with partner organizations or for research purposes.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termsOfServiceAcceptedDate rdf:type rdf:Property ;
    rdfs:label 'Terms Of Service Accepted Date' ;
    rdfs:comment 'Date when the rider accepted the transit system\'s terms of service.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:photoIdVerified rdf:type rdf:Property ;
    rdfs:label 'Photo Id Verified' ;
    rdfs:comment 'Indicates whether the rider\'s identity has been verified with a government-issued photo ID.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:photoIdState rdf:type rdf:Property ;
    rdfs:label 'Photo Id State' ;
    rdfs:comment 'State that issued the photo identification.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'Name of the source system from which the rider record originated (e.g., web application, mobile app, in-person registration).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longName rdf:type rdf:Property ;
    rdfs:label 'Long Name' ;
    rdfs:comment 'Full descriptive name of the route including origin and destination (e.g., \'Downtown to Airport Express\').' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:color rdf:type rdf:Property ;
    rdfs:label 'Color' ;
    rdfs:comment 'Hexadecimal color code used to represent the route on maps and signage (e.g., \'FF0000\' for red).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:textColor rdf:type rdf:Property ;
    rdfs:label 'Text Color' ;
    rdfs:comment 'Hexadecimal color code for text displayed on route color background to ensure readability.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLevel rdf:type rdf:Property ;
    rdfs:label 'Service Level' ;
    rdfs:comment 'Classification of service level indicating stop frequency and speed (local stops at all stations, express skips stops, etc.).' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageTripDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Average Trip Duration Minutes' ;
    rdfs:comment 'Average time in minutes for a complete trip from origin to destination under normal operating conditions.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfStops rdf:type rdf:Property ;
    rdfs:label 'Number Of Stops' ;
    rdfs:comment 'Total count of designated stops along the route where passengers can board or alight.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bidirectionalFlag rdf:type rdf:Property ;
    rdfs:label 'Bidirectional Flag' ;
    rdfs:comment 'Indicates whether the route operates in both directions (true) or is unidirectional (false).' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bikeAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Bike Allowed Flag' ;
    rdfs:comment 'Indicates whether bicycles are permitted on vehicles operating this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakFareAmount rdf:type rdf:Property ;
    rdfs:label 'Peak Fare Amount' ;
    rdfs:comment 'Fare amount in US dollars charged during peak travel periods if differential pricing applies.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceFrequencyPeakMinutes rdf:type rdf:Property ;
    rdfs:label 'Service Frequency Peak Minutes' ;
    rdfs:comment 'Average time interval in minutes between vehicle departures during peak service hours.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceFrequencyOffpeakMinutes rdf:type rdf:Property ;
    rdfs:label 'Service Frequency Offpeak Minutes' ;
    rdfs:comment 'Average time interval in minutes between vehicle departures during off-peak service hours.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weekdayServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Weekday Service Flag' ;
    rdfs:comment 'Indicates whether the route operates on weekdays (Monday through Friday).' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holidayServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Holiday Service Flag' ;
    rdfs:comment 'Indicates whether the route operates on designated public holidays.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Service Flag' ;
    rdfs:comment 'Indicates whether the route operates only during specific seasons (e.g., summer tourist routes).' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceStartDate rdf:type rdf:Property ;
    rdfs:label 'Service Start Date' ;
    rdfs:comment 'Date when the route first began operation or current service configuration started.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceEndDate rdf:type rdf:Property ;
    rdfs:label 'Service End Date' ;
    rdfs:comment 'Date when the route service ended or is scheduled to end (null for ongoing routes).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:realTimeTrackingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Real Time Tracking Enabled Flag' ;
    rdfs:comment 'Indicates whether vehicles on this route are equipped with GPS/AVL for real-time passenger information.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ftaGrantFundedFlag rdf:type rdf:Property ;
    rdfs:label 'Fta Grant Funded Flag' ;
    rdfs:comment 'Indicates whether this route receives Federal Transit Administration grant funding.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualOperatingCost rdf:type rdf:Property ;
    rdfs:label 'Annual Operating Cost' ;
    rdfs:comment 'Total annual operating cost in US dollars for maintaining service on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualRidership rdf:type rdf:Property ;
    rdfs:label 'Annual Ridership' ;
    rdfs:comment 'Total number of passenger boardings on this route during the most recent fiscal year.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageDailyRidership rdf:type rdf:Property ;
    rdfs:label 'Average Daily Ridership' ;
    rdfs:comment 'Average number of passenger boardings per service day on this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:onTimePerformancePercentage rdf:type rdf:Property ;
    rdfs:label 'On Time Performance Percentage' ;
    rdfs:comment 'Percentage of trips completing service within the defined on-time window (typically within 5 minutes of schedule).' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyIncidentCountAnnual rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Count Annual' ;
    rdfs:comment 'Total number of reportable safety incidents on this route during the most recent fiscal year.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:environmentalJusticeRouteFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Justice Route Flag' ;
    rdfs:comment 'Indicates whether this route primarily serves environmental justice communities as defined by federal guidelines.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:titleViProtectedFlag rdf:type rdf:Property ;
    rdfs:label 'Title Vi Protected Flag' ;
    rdfs:comment 'Indicates whether this route is subject to Title VI civil rights protections due to service to minority populations.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractOperatorFlag rdf:type rdf:Property ;
    rdfs:label 'Contract Operator Flag' ;
    rdfs:comment 'Indicates whether this route is operated by a contracted third-party provider rather than directly by NCDOT.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Contract Expiration Date' ;
    rdfs:comment 'Date when the current operating contract for this route expires.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ncdotDivision rdf:type rdf:Property ;
    rdfs:label 'Ncdot Division' ;
    rdfs:comment 'NCDOT organizational division responsible for oversight of this route (e.g., Division of Public Transportation).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerName rdf:type rdf:Property ;
    rdfs:label 'Manager Name' ;
    rdfs:comment 'Name of the NCDOT staff member or contractor responsible for managing this route.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gtfsRouteId rdf:type rdf:Property ;
    rdfs:label 'Gtfs Route Id' ;
    rdfs:comment 'Unique route identifier used in General Transit Feed Specification (GTFS) data feeds for public consumption.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Route .

ind:ntdRouteId rdf:type rdf:Property ;
    rdfs:label 'Ntd Route Id' ;
    rdfs:comment 'Route identifier used for reporting to the Federal Transit Administration National Transit Database.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Route .

ind:lastServiceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Service Review Date' ;
    rdfs:comment 'Date of the most recent comprehensive service review or performance evaluation for this route.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextServiceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Service Review Date' ;
    rdfs:comment 'Scheduled date for the next comprehensive service review or performance evaluation.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicCommentPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period Flag' ;
    rdfs:comment 'Indicates whether this route is currently subject to a public comment period for proposed service changes.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:majorServiceChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Major Service Change Flag' ;
    rdfs:comment 'Indicates whether this route has undergone or is planned for a major service change requiring Title VI analysis.' ;
    rdfs:domain ind:Route ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainMovementId rdf:type rdf:Property ;
    rdfs:label 'Train Movement Id' ;
    rdfs:comment 'Unique identifier for each train movement event record.' ;
    rdfs:domain ind:TrainMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainIdentifier rdf:type rdf:Property ;
    rdfs:label 'Train Identifier' ;
    rdfs:comment 'Unique identifier assigned to the train consist for operational tracking purposes.' ;
    rdfs:domain ind:TrainMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locomotiveNumber rdf:type rdf:Property ;
    rdfs:label 'Locomotive Number' ;
    rdfs:comment 'Identification number of the lead locomotive pulling the train.' ;
