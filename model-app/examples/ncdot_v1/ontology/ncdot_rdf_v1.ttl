    rdfs:comment 'Unit of measurement for the material quantity consumed.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentCount rdf:type rdf:Property ;
    rdfs:label 'Equipment Count' ;
    rdfs:comment 'Number of equipment units deployed for the maintenance event.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyIncident rdf:type rdf:Property ;
    rdfs:label 'Safety Incident' ;
    rdfs:comment 'Flag indicating whether a safety incident or injury occurred during the maintenance event.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
