ind:propertyTaxPaidFlag rdf:type rdf:Property ;
    rdfs:label 'Property Tax Paid Flag' ;
    rdfs:comment 'Indicates whether property taxes have been paid for the current tax year. Required for registration renewal.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyTaxPaidDate rdf:type rdf:Property ;
    rdfs:label 'Property Tax Paid Date' ;
    rdfs:comment 'Date when property taxes were paid for the current tax year.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:highwayUseTaxPaidDate rdf:type rdf:Property ;
    rdfs:label 'Highway Use Tax Paid Date' ;
    rdfs:comment 'Date when highway use tax was paid for this vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Registration Fee Amount' ;
    rdfs:comment 'Amount of registration fee paid for the current registration period.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registrationFeePaidDate rdf:type rdf:Property ;
    rdfs:label 'Registration Fee Paid Date' ;
    rdfs:comment 'Date when the registration fee was paid.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:garagedZipCode rdf:type rdf:Property ;
    rdfs:label 'Garaged Zip Code' ;
    rdfs:comment 'ZIP code where the vehicle is primarily garaged or stored.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:useType rdf:type rdf:Property ;
    rdfs:label 'Use Type' ;
    rdfs:comment 'Primary use classification for the vehicle affecting registration requirements and fees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commercialUseFlag rdf:type rdf:Property ;
    rdfs:label 'Commercial Use Flag' ;
    rdfs:comment 'Indicates whether the vehicle is used for commercial purposes requiring additional permits or endorsements.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fleetFlag rdf:type rdf:Property ;
    rdfs:label 'Fleet Flag' ;
    rdfs:comment 'Indicates whether the vehicle is part of a commercial or government fleet.' ;
