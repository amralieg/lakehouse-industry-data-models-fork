    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupancyType rdf:type rdf:Property ;
    rdfs:label 'Occupancy Type' ;
    rdfs:comment 'The use or occupancy of the property. Part of COPE attributes for underwriting and rating. Examples: owner-occupied, tenant-occupied, retail, office, manufacturing, warehouse.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plumbingType rdf:type rdf:Property ;
    rdfs:label 'Plumbing Type' ;
    rdfs:comment 'The type of plumbing material. Examples: copper, PVC, galvanized, PEX. Impacts water damage risk.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyStatus rdf:type rdf:Property ;
    rdfs:label 'Property Status' ;
    rdfs:comment 'Current lifecycle status of the property risk record within the policy term.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementCostValue rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Value' ;
    rdfs:comment 'The estimated cost to replace the property with materials of like kind and quality at current prices.' ;
    rdfs:domain ind:Riskexposure ;
