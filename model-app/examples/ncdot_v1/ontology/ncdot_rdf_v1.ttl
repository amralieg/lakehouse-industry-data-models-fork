    rdfs:range xsd:string .

ind:ratePercent rdf:type rdf:Property ;
    rdfs:label 'Rate Percent' ;
    rdfs:comment 'The annual depreciation rate expressed as a percentage of the depreciable base, used in declining balance methods.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
