    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAppraisalDate rdf:type rdf:Property ;
    rdfs:label 'Last Appraisal Date' ;
    rdfs:comment 'The date of the most recent professional appraisal or valuation of the asset.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impairmentIndicator rdf:type rdf:Property ;
