    rdfs:range xsd:date .

ind:compaRatioTarget rdf:type rdf:Property ;
    rdfs:label 'Compa Ratio Target' ;
    rdfs:comment 'Target comparative ratio (actual salary divided by midpoint salary) for positions in this grade. Typically 1.00 represents market rate.' ;
    rdfs:domain ind:SalaryGrade ;
    rdf:type owl:DatatypeProperty ;
