ind:elevationCertificateDate rdf:type rdf:Property ;
    rdfs:label 'Elevation Certificate Date' ;
    rdfs:comment 'Date when the Elevation Certificate was completed by a licensed surveyor or engineer.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:elevationDifferenceFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Difference Ft' ;
    rdfs:comment 'Difference between the lowest floor elevation and the base flood elevation, used for rating purposes.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
