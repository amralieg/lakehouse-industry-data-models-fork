ind:consistConfiguration rdf:type rdf:Property ;
    rdfs:label 'Consist Configuration' ;
    rdfs:comment 'Detailed description of the train consist including car types and arrangement (e.g., locomotive-coach-coach-cafe-coach).' ;
    rdfs:domain ind:TrainSchedule ;
