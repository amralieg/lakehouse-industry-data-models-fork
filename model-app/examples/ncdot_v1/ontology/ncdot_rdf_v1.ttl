ind:passengerCarEquivalentTruck rdf:type rdf:Property ;
    rdfs:label 'Passenger Car Equivalent Truck' ;
    rdfs:comment 'The factor used to convert truck volumes to passenger car equivalents for capacity analysis.' ;
