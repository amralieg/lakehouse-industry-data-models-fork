ind:securityLevel rdf:type rdf:Property ;
    rdfs:label 'Security Level' ;
    rdfs:comment 'Classification level controlling access to the note: public, internal, confidential, or restricted.' ;
    rdfs:domain ind:ClaimNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subject rdf:type rdf:Property ;
    rdfs:label 'Subject' ;
    rdfs:comment 'Brief subject line or title summarizing the content of the note.' ;
    rdfs:domain ind:ClaimNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:topic rdf:type rdf:Property ;
    rdfs:label 'Topic' ;
    rdfs:comment 'Keyword or topic tag for categorizing and searching notes by subject matter.' ;
    rdfs:domain ind:ClaimNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visibilityScope rdf:type rdf:Property ;
