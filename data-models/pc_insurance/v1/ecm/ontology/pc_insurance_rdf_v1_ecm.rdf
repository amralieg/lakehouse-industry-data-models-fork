    rdfs:comment 'Date when the field survey or inspection was conducted.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyMethod rdf:type rdf:Property ;
