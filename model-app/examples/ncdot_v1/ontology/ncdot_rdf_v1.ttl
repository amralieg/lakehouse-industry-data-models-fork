    rdfs:comment 'Planned fiscal or calendar year for project completion.' ;
    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:section106ReviewRequired rdf:type rdf:Property ;
