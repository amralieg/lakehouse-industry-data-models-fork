    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'Cumulative paid loss amount at the time of this status transition, used for loss development tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Status' ;
    rdfs:comment 'The claim status immediately before this transition occurred. [ENUM-REF-CANDIDATE: open|assigned|investigating|pending_info|approved|denied|closed|reopened — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportableIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable Indicator' ;
    rdfs:comment 'Flag indicating whether this status transition must be included in regulatory reporting to state Departments of Insurance or NAIC.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Amount' ;
    rdfs:comment 'Total outstanding case reserve amount at the time of this status transition, captured for reserve development analysis.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Ordinal position of this status change within the claims lifecycle, starting at 1.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaActualHours rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Hours' ;
    rdfs:comment 'Actual number of hours the claim remained in the prior status before this transition, used for SLA compliance reporting.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaComplianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Indicator' ;
    rdfs:comment 'Flag indicating whether the status transition met the defined SLA target for the prior status stage.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Hours' ;
    rdfs:comment 'Number of hours allowed for this status stage per service level agreement, used for compliance monitoring.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:systemSource rdf:type rdf:Property ;
    rdfs:label 'System Source' ;
    rdfs:comment 'Name of the source system or application that recorded this status transition, such as ClaimCenter or Duck Creek Claims.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Code' ;
    rdfs:comment 'Unique transaction identifier from the source system that created this status history record, used for reconciliation and traceability.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Code' ;
    rdfs:comment 'Standardized code indicating why the status change occurred, aligned with business rules and regulatory requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Description' ;
    rdfs:comment 'Detailed explanation of the business rationale or event that triggered this status change.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionSource rdf:type rdf:Property ;
    rdfs:label 'Transition Source' ;
    rdfs:comment 'Indicates whether the status change was initiated manually by a user, automatically by a workflow rule, or via system integration.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transition Timestamp' ;
    rdfs:comment 'Precise date and time when the status change was recorded in the system, used for SLA compliance and audit trails.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:workflowStepCode rdf:type rdf:Property ;
    rdfs:label 'Workflow Step Code' ;
    rdfs:comment 'Identifier of the workflow step or business process stage that triggered this status transition, if applicable.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantId rdf:type rdf:Property ;
    rdfs:label 'Claimant Id' ;
    rdfs:comment 'Unique identifier for the claimant record. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claimant .

ind:attorneyId rdf:type rdf:Property ;
    rdfs:label 'Attorney Id' ;
    rdfs:comment 'Foreign key linking to claims.attorney. Business justification: Claimants are represented by attorneys when they assert claims. One attorney represents many claimants; one claimant has one attorney (when represented).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Attorney .

ind:countryId rdf:type rdf:Property ;
    rdfs:label 'Country Id' ;
    rdfs:comment 'Foreign key linking to shared.country. Business justification: Claimant country determines payment processing requirements, tax withholding rules, data privacy compliance (GDPR, etc.), and international communication protocols.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Country .

ind:settlementCalendarId rdf:type rdf:Property ;
    rdfs:label 'Settlement Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Claimant settlement date determines settlement period for settlement rate analysis, average time to settle metrics, and financial close reporting.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line1' ;
    rdfs:comment 'Primary street address line for the claimant residence or business location.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line2' ;
    rdfs:comment 'Secondary address line for apartment, suite, or unit number.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodyPartInjured rdf:type rdf:Property ;
    rdfs:label 'Body Part Injured' ;
    rdfs:comment 'Specific body part or area injured in the claim event, using standardized anatomical terminology.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality of the claimant address.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantStatus rdf:type rdf:Property ;
    rdfs:label 'Claimant Status' ;
    rdfs:comment 'Current lifecycle status of the claimant record: active, settled, closed, withdrawn, litigated, or denied.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantType rdf:type rdf:Property ;
    rdfs:label 'Claimant Type' ;
    rdfs:comment 'Classification of the claimant entity: person, organization, estate, trust, minor, or dependent.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Date of birth of the claimant if the claimant is a person, used for identification and age verification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dbaName rdf:type rdf:Property ;
    rdfs:label 'Dba Name' ;
    rdfs:comment 'Trade name or doing business as name for the claimant organization if different from legal name.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandAmount rdf:type rdf:Property ;
    rdfs:label 'Demand Amount' ;
    rdfs:comment 'Amount demanded by the claimant or their attorney for settlement of the claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faultPercentage rdf:type rdf:Property ;
    rdfs:label 'Fault Percentage' ;
    rdfs:comment 'Percentage of fault attributed to this claimant in comparative negligence determination, ranging from 0.00 to 100.00.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injuryDescription rdf:type rdf:Property ;
    rdfs:label 'Injury Description' ;
    rdfs:comment 'Detailed narrative description of the injury or damage sustained by the claimant.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injurySeverity rdf:type rdf:Property ;
    rdfs:label 'Injury Severity' ;
    rdfs:comment 'Severity classification of the claimant injury: minor, moderate, severe, critical, or fatal.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryType rdf:type rdf:Property ;
    rdfs:label 'Injury Type' ;
    rdfs:comment 'Classification of the injury or damage sustained by the claimant. [ENUM-REF-CANDIDATE: bodily_injury|property_damage|personal_injury_protection|medical_payments|lost_wages|pain_suffering|wrongful_death — promote to reference product]' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRepresented rdf:type rdf:Property ;
    rdfs:label 'Is Represented' ;
    rdfs:comment 'Indicates whether the claimant is represented by legal counsel.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobilePhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Mobile Phone Number' ;
    rdfs:comment 'Mobile phone number for SMS and mobile communication with the claimant.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'Legal name of the organization if the claimant is a business entity.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyCode rdf:type rdf:Property ;
    rdfs:label 'Party Code' ;
    rdfs:comment 'Reference to the party master record representing this claimant.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the claimant address.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:representationDate rdf:type rdf:Property ;
    rdfs:label 'Representation Date' ;
    rdfs:comment 'Date when the claimant retained legal representation for this claim.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:role rdf:type rdf:Property ;
    rdfs:label 'Role' ;
    rdfs:comment 'Role of the claimant in relation to the claim: insured party, third-party claimant, lienholder, additional insured, mortgagee, or loss payee.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount' ;
    rdfs:comment 'Final negotiated settlement amount agreed upon for this claimant.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ssn rdf:type rdf:Property ;
    rdfs:label 'Ssn' ;
    rdfs:comment 'Social Security Number of the claimant for tax reporting and identification purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'State, province, or region of the claimant address.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsClaimPaymentId rdf:type rdf:Property ;
    rdfs:label 'Claims Claim Payment Id' ;
    rdfs:comment 'Unique identifier for the claim payment transaction record.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsReserveTransactionId rdf:type rdf:Property ;
    rdfs:label 'Claims Reserve Transaction Id' ;
    rdfs:comment 'Reference to the reserve transaction that authorized or funded this payment.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimsReserveTransaction .

ind:payeeId rdf:type rdf:Property ;
    rdfs:label 'Payee Id' ;
    rdfs:comment 'Reference to the party entity receiving the payment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payee .

ind:paymentCalendarId rdf:type rdf:Property ;
    rdfs:label 'Payment Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Payment date determines payment period for cash flow analysis, paid loss development, and financial reporting. Essential for Schedule P paid loss reporting and cash management.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:paymentTransactionId rdf:type rdf:Property ;
    rdfs:label 'Payment Transaction Id' ;
    rdfs:comment 'Foreign key linking to reservespayments.payment_transaction. Business justification: Payment reconciliation requires linking operational payment records (claims domain) to financial payment transactions (reservespayments domain).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentTransaction .

ind:accountingDate rdf:type rdf:Property ;
    rdfs:label 'Accounting Date' ;
    rdfs:comment 'Date the payment was posted to the general ledger for financial reporting purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Name or identifier of the adjuster, supervisor, or system that approved the payment.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date the payment was approved for issuance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catastropheCode rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Code' ;
    rdfs:comment 'ISO or PCS catastrophe event code if the payment is related to a declared catastrophe.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'Physical or virtual check number assigned to the payment, if payment method is check.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'Date the payment cleared the bank or financial institution.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'User ID or name of the person or system that created the payment record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'General ledger account code to which the payment is posted for financial reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Payment Amount' ;
    rdfs:comment 'Total payment amount before any deductions, offsets, or withholdings.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isJointPayee rdf:type rdf:Property ;
    rdfs:label 'Is Joint Payee' ;
    rdfs:comment 'Indicates whether the payment is issued to multiple payees jointly (e.g., insured and mortgagee).' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportable1099 rdf:type rdf:Property ;
    rdfs:label 'Is Reportable 1099' ;
    rdfs:comment 'Indicates whether the payment is reportable to the IRS on Form 1099-MISC.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jointPayeeName rdf:type rdf:Property ;
    rdfs:label 'Joint Payee Name' ;
    rdfs:comment 'Name of the second payee if payment is issued jointly.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossCategory rdf:type rdf:Property ;
    rdfs:label 'Loss Category' ;
    rdfs:comment 'High-level classification of the loss type for which payment is made: property, liability, auto physical damage, workers compensation, medical, legal, or other.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Final disbursed amount after all deductions, offsets, and withholdings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offsetAmount rdf:type rdf:Property ;
    rdfs:label 'Offset Amount' ;
    rdfs:comment 'Amount offset against the payment for prior overpayments, subrogation, or other recoveries.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payeeTaxNumber rdf:type rdf:Property ;
    rdfs:label 'Payee Tax Number' ;
    rdfs:comment 'Tax identification number (SSN or FEIN) of the payee for IRS 1099 reporting purposes.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeType rdf:type rdf:Property ;
    rdfs:label 'Payee Type' ;
    rdfs:comment 'Classification of the payment recipient: claimant, insured, vendor, medical provider, legal counsel, mortgagee, lienholder, or other party. [ENUM-REF-CANDIDATE: claimant|insured|vendor|medical_provider|legal_counsel|mortgagee|lienholder|other — 8' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentBatchCode rdf:type rdf:Property ;
    rdfs:label 'Payment Batch Code' ;
    rdfs:comment 'Identifier for the batch or run in which this payment was processed, if applicable.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'Date the payment was issued or disbursed to the payee.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentMemo rdf:type rdf:Property ;
    rdfs:label 'Payment Memo' ;
    rdfs:comment 'Free-text memo or note describing the purpose or context of the payment.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Instrument used to disburse payment: check, EFT (Electronic Funds Transfer), wire transfer, ACH (Automated Clearing House), debit card, or virtual card.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Business identifier for the payment transaction, often sequential within a claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current lifecycle status of the payment: pending approval, approved, issued, cleared by bank, voided, stopped, or returned. [ENUM-REF-CANDIDATE: pending|approved|issued|cleared|voided|stopped|returned — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of payment: indemnity, ALAE (Allocated Loss Adjustment Expense), ULAE (Unallocated Loss Adjustment Expense), medical, expense, subrogation recovery, salvage recovery, or deductible reimbursement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvagePotentialFlag rdf:type rdf:Property ;
    rdfs:label 'Salvage Potential Flag' ;
    rdfs:comment 'Indicates whether the payment has potential for salvage recovery from damaged property.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter US state or Canadian province code where the payment is allocated for regulatory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationPotentialFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Potential Flag' ;
    rdfs:comment 'Indicates whether the payment has potential for subrogation recovery from a third party.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Reference Number' ;
    rdfs:comment 'Electronic payment confirmation or trace number from the financial institution or payment processor.' ;
    rdfs:domain ind:ClaimsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedByUser rdf:type rdf:Property ;
    rdfs:label 'Updated By User' ;
    rdfs:comment 'User ID or name of the person or system that last modified the payment record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'Date the payment was voided or cancelled, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Amount' ;
    rdfs:comment 'Tax or legal withholding amount deducted from the gross payment per regulatory or court order.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsLossReserveId rdf:type rdf:Property ;
    rdfs:label 'Claims Loss Reserve Id' ;
    rdfs:comment 'Unique identifier for the loss reserve record.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveSetCalendarId rdf:type rdf:Property ;
    rdfs:label 'Reserve Set Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Reserve set date determines reserve period for reserve movement analysis, reserve adequacy testing, and financial reporting.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:accidentYear rdf:type rdf:Property ;
    rdfs:label 'Accident Year' ;
    rdfs:comment 'Calendar year in which the loss event occurred, used for actuarial development triangle analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialSegmentCode rdf:type rdf:Property ;
    rdfs:label 'Actuarial Segment Code' ;
    rdfs:comment 'Code identifying the actuarial segment or homogeneous risk group to which this reserve is assigned for reserving and pricing analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverUserCode rdf:type rdf:Property ;
    rdfs:label 'Approver User Code' ;
    rdfs:comment 'User ID of the manager or actuary who approved this reserve, for audit trail and authority verification.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidToDateAmount rdf:type rdf:Property ;
    rdfs:label 'Paid To Date Amount' ;
    rdfs:comment 'Cumulative amount paid on this claim or coverage line as of the reserve set date, used to calculate ultimate loss estimate.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Reserve Amount' ;
    rdfs:comment 'Previous reserve amount before this adjustment, used to calculate reserve development and redundancy/deficiency.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportYear rdf:type rdf:Property ;
    rdfs:label 'Report Year' ;
    rdfs:comment 'Calendar year in which the claim was first reported, used for IBNR and development analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Reserve Approval Status' ;
    rdfs:comment 'Approval workflow status for reserves requiring management or actuarial sign-off: pending, approved, rejected, or escalated.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveBasis rdf:type rdf:Property ;
    rdfs:label 'Reserve Basis' ;
    rdfs:comment 'Basis or methodology used to establish the reserve: adjuster estimate, actuarial model, medical report, legal opinion, or settlement demand.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveCategory rdf:type rdf:Property ;
    rdfs:label 'Reserve Category' ;
    rdfs:comment 'Category of loss reserve: indemnity (pure loss), ALAE (Allocated Loss Adjustment Expense), ULAE (Unallocated Loss Adjustment Expense), defense costs, or medical payments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Change Amount' ;
    rdfs:comment 'Net change in reserve amount from prior valuation, positive for increases and negative for decreases.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Reserve Confidence Level' ;
    rdfs:comment 'Confidence level in the reserve estimate: low, medium, high, or very high, reflecting uncertainty in the valuation.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Effective Date' ;
    rdfs:comment 'Date from which this reserve amount is effective for financial and actuarial reporting purposes.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reserveNotes rdf:type rdf:Property ;
    rdfs:label 'Reserve Notes' ;
    rdfs:comment 'Free-text notes or comments from the adjuster or actuary explaining the rationale, assumptions, or special considerations for this reserve.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveNumber rdf:type rdf:Property ;
    rdfs:label 'Reserve Number' ;
    rdfs:comment 'Business identifier for the reserve transaction, often system-generated or sequential.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reserve Reason Code' ;
    rdfs:comment 'Code indicating the reason for reserve establishment or adjustment (e.g., new claim, medical update, legal development, settlement negotiation).' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveSetDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Set Date' ;
    rdfs:comment 'Date on which this reserve amount was established or last revised by the adjuster or actuary.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reserveSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Reserve Source System' ;
    rdfs:comment 'Name of the source system from which this reserve record originated (e.g., ClaimCenter, Duck Creek Claims, Arius).' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveSourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Reserve Source System Code' ;
    rdfs:comment 'Unique identifier of this reserve record in the source system, for traceability and reconciliation.' ;
    rdfs:domain ind:ClaimsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveStatus rdf:type rdf:Property ;
    rdfs:label 'Reserve Status' ;
    rdfs:comment 'Current lifecycle status of the reserve entry: open (active), closed (finalized), superseded (replaced by newer estimate), or pending review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveType rdf:type rdf:Property ;
    rdfs:label 'Reserve Type' ;
    rdfs:comment 'Classification of reserve: case (Outstanding Case Reserve/OCR), IBNR (Incurred But Not Reported), IBNER (Incurred But Not Enough Reported), salvage, or subrogation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ultimateLossEstimate rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Estimate' ;
    rdfs:comment 'Estimated total loss (paid plus outstanding reserve) expected to be incurred on this claim or coverage line at final settlement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Date' ;
    rdfs:comment 'As-of date for which this reserve valuation is calculated, typically quarter-end or year-end for statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:claimsAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Claims Adjuster Id' ;
    rdfs:comment 'Identifier of the claims adjuster who authorized or executed this reserve movement.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:claimsSupervisorAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Claims Supervisor Adjuster Id' ;
    rdfs:comment 'Identifier of the supervisor who approved this reserve change if approval was required.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:effectiveCalendarId rdf:type rdf:Property ;
    rdfs:label 'Effective Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Reserve transaction effective date determines transaction period for reserve movement tracking, loss development analysis, and financial reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:reversedTransactionClaimsReserveTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Transaction Claims Reserve Transaction Id' ;
    rdfs:comment 'Identifier of the original transaction being reversed, if this is a reversal entry.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimsReserveTransaction .

ind:accountingPeriod rdf:type rdf:Property ;
    rdfs:label 'Accounting Period' ;
    rdfs:comment 'Year-month accounting period to which this reserve transaction is posted for financial reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether supervisory approval was required for this reserve transaction based on authority limits.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bulkReserveFlag rdf:type rdf:Property ;
    rdfs:label 'Bulk Reserve Flag' ;
    rdfs:comment 'Indicates whether this transaction is part of a bulk reserve adjustment across multiple claims.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Code' ;
    rdfs:comment 'Code identifying the specific policy coverage under which this reserve is held.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossDevelopmentFactor rdf:type rdf:Property ;
    rdfs:label 'Loss Development Factor' ;
    rdfs:comment 'Actuarial development factor applied to adjust reserves based on historical loss emergence patterns.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Net Reserve Amount' ;
    rdfs:comment 'Net reserve after deducting reinsurance recoverables, representing the company\'s retained exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newReserveAmount rdf:type rdf:Property ;
    rdfs:label 'New Reserve Amount' ;
    rdfs:comment 'Reserve balance after applying this transaction, in policy currency.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilCode rdf:type rdf:Property ;
    rdfs:label 'Peril Code' ;
    rdfs:comment 'Code identifying the cause of loss or peril associated with this reserve.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingStatus rdf:type rdf:Property ;
    rdfs:label 'Posting Status' ;
    rdfs:comment 'Current lifecycle status of this reserve transaction in the financial ledger.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code indicating the business reason for this reserve adjustment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why this reserve change was made, supporting actuarial review and audit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Amount' ;
    rdfs:comment 'Portion of this reserve that is expected to be recovered from reinsurers under treaty or facultative agreements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveMethod rdf:type rdf:Property ;
    rdfs:label 'Reserve Method' ;
    rdfs:comment 'Methodology used to calculate this reserve: case-by-case, formula-driven, actuarial model, or bulk reserve.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this transaction reverses a prior reserve transaction due to error correction or adjustment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salvageSubrogationEstimate rdf:type rdf:Property ;
    rdfs:label 'Salvage Subrogation Estimate' ;
    rdfs:comment 'Estimated amount expected to be recovered through salvage or subrogation, reducing net reserve exposure.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Code' ;
    rdfs:comment 'Unique identifier of this transaction in the source claims system for reconciliation and traceability.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Amount' ;
    rdfs:comment 'Signed delta applied in this transaction; positive for increases, negative for decreases.' ;
    rdfs:domain ind:ClaimsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Effective Date' ;
    rdfs:comment 'Accounting date on which this reserve change takes effect for financial and statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'Business-facing sequence or reference number for this reserve movement within the claim lifecycle.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transaction Timestamp' ;
    rdfs:comment 'Precise date and time when this reserve transaction was recorded in the system.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Category of reserve movement: initial set, increase, decrease, reopen, close, or transfer between reserve types.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damageEstimateId rdf:type rdf:Property ;
    rdfs:label 'Damage Estimate Id' ;
    rdfs:comment 'Unique identifier for the damage estimate record.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Approved By Adjuster Id' ;
    rdfs:comment 'Reference to the claims adjuster who reviewed and approved this estimate for payment authorization.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:estimateCalendarId rdf:type rdf:Property ;
    rdfs:label 'Estimate Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Damage estimate date determines estimate period for estimate cycle time analysis, estimator performance metrics, and operational reporting.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:serviceVendorId rdf:type rdf:Property ;
    rdfs:label 'Service Vendor Id' ;
    rdfs:comment 'Foreign key linking to claims.service_vendor. Business justification: Damage estimates are often prepared by third-party vendors (body shops, restoration companies, independent adjusters).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceVendor .

ind:acvAmount rdf:type rdf:Property ;
    rdfs:label 'Acv Amount' ;
    rdfs:comment 'Net settlement value after depreciation, calculated as RCV minus depreciation, representing the pre-loss market value of the damaged property.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:damageEstimateStatus rdf:type rdf:Property ;
    rdfs:label 'Damage Estimate Status' ;
    rdfs:comment 'Current workflow status of the damage estimate: draft in progress, submitted for review, approved for payment, rejected for revision, revised and resubmitted, or final.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damageType rdf:type rdf:Property ;
    rdfs:label 'Damage Type' ;
    rdfs:comment 'High-level classification of the damaged asset: property (building/structure), vehicle (auto physical damage), equipment, or other.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Amount' ;
    rdfs:comment 'Calculated depreciation deducted from RCV based on age, condition, and useful life of damaged components, used to determine ACV.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equipmentAmount rdf:type rdf:Property ;
    rdfs:label 'Equipment Amount' ;
    rdfs:comment 'Total estimated equipment rental or specialized tool cost component of the RCV, such as scaffolding, lifts, or drying equipment.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimateDate rdf:type rdf:Property ;
    rdfs:label 'Estimate Date' ;
    rdfs:comment 'Date when the damage estimate was prepared or finalized by the estimator.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimateMethodology rdf:type rdf:Property ;
    rdfs:label 'Estimate Methodology' ;
    rdfs:comment 'Method used to prepare the estimate: detailed on-site inspection, summary estimate, desk review of documentation, or photo-based remote estimate.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimateNumber rdf:type rdf:Property ;
    rdfs:label 'Estimate Number' ;
    rdfs:comment 'Business identifier for the damage estimate, often used in external communications and vendor coordination.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimateSoftware rdf:type rdf:Property ;
    rdfs:label 'Estimate Software' ;
    rdfs:comment 'Name of the estimating software or platform used to prepare the estimate (e.g., Xactimate, Mitchell, CCC ONE), important for data integration and audit.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimateType rdf:type rdf:Property ;
    rdfs:label 'Estimate Type' ;
    rdfs:comment 'Classification of the estimate in the claim lifecycle: initial assessment, supplemental for additional damage, revised for corrections, or final settlement estimate.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatorLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Estimator License Number' ;
    rdfs:comment 'Professional license or certification number of the estimator, required for appraisers and engineers in many jurisdictions.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatorPartyCode rdf:type rdf:Property ;
    rdfs:label 'Estimator Party Code' ;
    rdfs:comment 'Reference to the party (individual or organization) who prepared the damage estimate.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatorType rdf:type rdf:Property ;
    rdfs:label 'Estimator Type' ;
    rdfs:comment 'Category of the party who prepared the estimate: staff adjuster, independent adjuster (IA), third-party vendor, licensed appraiser, or structural engineer.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Date' ;
    rdfs:comment 'Date when the physical inspection of the damaged property or vehicle was conducted.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:laborAmount rdf:type rdf:Property ;
    rdfs:label 'Labor Amount' ;
    rdfs:comment 'Total estimated labor cost component of the RCV, representing the cost of skilled trades and technicians to perform repairs.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineItemCount rdf:type rdf:Property ;
    rdfs:label 'Line Item Count' ;
    rdfs:comment 'Number of individual line items or components included in the detailed estimate, indicating scope and complexity.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:materialsAmount rdf:type rdf:Property ;
    rdfs:label 'Materials Amount' ;
    rdfs:comment 'Total estimated materials and parts cost component of the RCV, representing the cost of replacement components and supplies.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPayableAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payable Amount' ;
    rdfs:comment 'Final amount payable to the insured or claimant after applying depreciation, deductible, and any other adjustments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overheadProfitAmount rdf:type rdf:Property ;
    rdfs:label 'Overhead Profit Amount' ;
    rdfs:comment 'Contractor overhead and profit allowance included in the RCV, typically applied when general contractor coordination is required.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rcvAmount rdf:type rdf:Property ;
    rdfs:label 'Rcv Amount' ;
    rdfs:comment 'Total estimated cost to repair or replace the damaged property with new materials of like kind and quality, without deduction for depreciation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Explanation provided when an estimate is rejected, detailing discrepancies, missing information, or policy coverage issues requiring correction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repairVsTotalDecision rdf:type rdf:Property ;
    rdfs:label 'Repair Vs Total Decision' ;
    rdfs:comment 'Determination of whether the damaged property should be repaired or declared a total loss based on cost-to-repair versus pre-loss value threshold.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValue rdf:type rdf:Property ;
    rdfs:label 'Salvage Value' ;
    rdfs:comment 'Estimated residual value of the damaged property if declared a total loss, representing the amount recoverable through salvage sale.' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Sales tax or other applicable taxes included in the estimate, based on jurisdiction and taxability of repair services and materials.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLossThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Total Loss Threshold Percentage' ;
    rdfs:comment 'Percentage threshold used to determine total loss, typically when repair cost exceeds this percentage of pre-loss value (commonly 70-80 percent).' ;
    rdfs:domain ind:DamageEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disbursementId rdf:type rdf:Property ;
    rdfs:label 'Disbursement Id' ;
    rdfs:comment 'Unique identifier for the claim payment disbursement transaction.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarId rdf:type rdf:Property ;
    rdfs:label 'Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Disbursement date determines disbursement period for cash flow analysis, bank reconciliation, and treasury management. Essential for cash management and disbursement volume tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Reference to the logical payment authorization that this disbursement fulfills.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:bankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number' ;
    rdfs:comment 'Payee bank account number for electronic funds transfer (EFT/ACH/Wire) disbursements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'Name of the financial institution receiving the electronic disbursement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'ABA routing transit number for the payee financial institution, used for electronic disbursements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disbursementDate rdf:type rdf:Property ;
    rdfs:label 'Disbursement Date' ;
    rdfs:comment 'Date the disbursement was issued or initiated (check date or EFT origination date).' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disbursementStatus rdf:type rdf:Property ;
    rdfs:label 'Disbursement Status' ;
    rdfs:comment 'Current lifecycle status of the disbursement transaction.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eftTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Eft Trace Number' ;
    rdfs:comment 'Unique trace or confirmation number assigned by the ACH or wire transfer system for electronic disbursements.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glPostingDate rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Date' ;
    rdfs:comment 'Accounting date when the disbursement transaction was posted to the general ledger.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Amount' ;
    rdfs:comment 'Total authorized payment amount before any deductions, withholdings, or offsets.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isVoid rdf:type rdf:Property ;
    rdfs:label 'Is Void' ;
    rdfs:comment 'Indicator whether the disbursement has been voided or cancelled.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Issued By User Code' ;
    rdfs:comment 'User identifier of the person or system that issued or generated the disbursement instrument.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issued Timestamp' ;
    rdfs:comment 'Date and time when the disbursement was physically or electronically issued to the payee.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:memo rdf:type rdf:Property ;
    rdfs:label 'Memo' ;
    rdfs:comment 'Free-text memo or note describing the purpose or context of the disbursement, often printed on check stub or remittance advice.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'Payment instrument or mechanism used to disburse funds to the payee. [ENUM-REF-CANDIDATE: check|eft|wire|ach|debit_card|paypal|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'Actual amount paid to the payee after all withholdings and offsets (gross minus withholding minus offset).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payeeAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Payee Address Line1' ;
    rdfs:comment 'Primary street address line for the payee receiving the disbursement.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Payee Address Line2' ;
    rdfs:comment 'Secondary address line for the payee (suite, apartment, building number).' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeCity rdf:type rdf:Property ;
    rdfs:label 'Payee City' ;
    rdfs:comment 'City name for the payee mailing address.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeCountry rdf:type rdf:Property ;
    rdfs:label 'Payee Country' ;
    rdfs:comment 'Three-letter ISO country code for the payee mailing address.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeePostalCode rdf:type rdf:Property ;
    rdfs:label 'Payee Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the payee mailing address.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeState rdf:type rdf:Property ;
    rdfs:label 'Payee State' ;
    rdfs:comment 'State or province code for the payee mailing address.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'Business reason or explanation for voiding the disbursement (e.g., duplicate payment, incorrect amount, payee request).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Assigned Adjuster Id' ;
    rdfs:comment 'Identifier of the adjuster assigned to handle the claim from this FNOL.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:claimantEmail rdf:type rdf:Property ;
    rdfs:label 'Claimant Email' ;
    rdfs:comment 'Email address for the claimant.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantPhone rdf:type rdf:Property ;
    rdfs:label 'Claimant Phone' ;
    rdfs:comment 'Primary contact phone number for the claimant.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dolTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dol Timestamp' ;
    rdfs:comment 'Precise date and time when the loss event occurred, if known.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Loss Amount' ;
    rdfs:comment 'Initial estimate of the loss amount as reported at FNOL.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fnolStatus rdf:type rdf:Property ;
    rdfs:label 'Fnol Status' ;
    rdfs:comment 'Current status of the FNOL record in the intake workflow.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryIndicator rdf:type rdf:Property ;
    rdfs:label 'Injury Indicator' ;
    rdfs:comment 'Flag indicating whether bodily injury was reported.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intakeChannel rdf:type rdf:Property ;
    rdfs:label 'Intake Channel' ;
    rdfs:comment 'Channel through which the FNOL was received.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intakeUserCode rdf:type rdf:Property ;
    rdfs:label 'Intake User Code' ;
    rdfs:comment 'Identifier of the user or system that recorded the FNOL.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCatLoss rdf:type rdf:Property ;
    rdfs:label 'Is Cat Loss' ;
    rdfs:comment 'Flag indicating whether the loss is part of a catastrophe event.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossLocationLatitude rdf:type rdf:Property ;
    rdfs:label 'Loss Location Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the loss location.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossLocationLongitude rdf:type rdf:Property ;
    rdfs:label 'Loss Location Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the loss location.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policeReportFiled rdf:type rdf:Property ;
    rdfs:label 'Police Report Filed' ;
    rdfs:comment 'Flag indicating whether a police report was filed for the loss.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policeReportNumber rdf:type rdf:Property ;
    rdfs:label 'Police Report Number' ;
    rdfs:comment 'Police report number if a report was filed.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyDamageIndicator rdf:type rdf:Property ;
    rdfs:label 'Property Damage Indicator' ;
    rdfs:comment 'Flag indicating whether property damage was reported.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date when the loss was first reported to the insurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reported Timestamp' ;
    rdfs:comment 'Precise date and time when the loss was first reported to the insurer.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reporterName rdf:type rdf:Property ;
    rdfs:label 'Reporter Name' ;
    rdfs:comment 'Full name of the person who reported the loss.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reporterPartyCode rdf:type rdf:Property ;
    rdfs:label 'Reporter Party Code' ;
    rdfs:comment 'Reference to the party who reported the loss, if different from the claimant.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reporterRelationship rdf:type rdf:Property ;
    rdfs:label 'Reporter Relationship' ;
    rdfs:comment 'Relationship of the reporter to the insured or claimant.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessPresent rdf:type rdf:Property ;
    rdfs:label 'Witness Present' ;
    rdfs:comment 'Flag indicating whether witnesses were present at the loss event.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudReferralId rdf:type rdf:Property ;
    rdfs:label 'Fraud Referral Id' ;
    rdfs:comment 'Unique identifier for the fraud referral record.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralCalendarId rdf:type rdf:Property ;
    rdfs:label 'Referral Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Fraud referral date determines referral period for fraud detection rate analysis, investigation cycle time metrics, and SIU operational reporting.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date the fraud referral was assigned to an SIU investigator.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:confirmedFraudAmount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Fraud Amount' ;
    rdfs:comment 'Actual monetary value of the fraud substantiated through investigation, representing the loss prevented or identified.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:denialReasonCode rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Code' ;
    rdfs:comment 'Standardized code representing the specific fraud-related reason for recommending claim denial.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Denial Recommended Flag' ;
    rdfs:comment 'Indicator whether the SIU investigation recommends denying the claim based on fraud findings.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedFraudAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Fraud Amount' ;
    rdfs:comment 'Initial estimated monetary value of the suspected fraudulent claim or loss at the time of referral.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fraudConfirmedFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Confirmed Flag' ;
    rdfs:comment 'Indicator whether fraud was definitively confirmed through the investigation.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudIndicatorCode rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Code' ;
    rdfs:comment 'Standardized code representing the specific red flag or suspicious activity pattern that triggered the referral.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudIndicatorDescription rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Description' ;
    rdfs:comment 'Detailed explanation of the suspicious activity or red flags that prompted the fraud referral.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudReferralStatus rdf:type rdf:Property ;
    rdfs:label 'Fraud Referral Status' ;
    rdfs:comment 'Current state of the fraud investigation workflow.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudType rdf:type rdf:Property ;
    rdfs:label 'Fraud Type' ;
    rdfs:comment 'Classification of the suspected fraud based on severity and intent.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCloseDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Close Date' ;
    rdfs:comment 'Date the fraud investigation was formally concluded and the case closed.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationNotes rdf:type rdf:Property ;
    rdfs:label 'Investigation Notes' ;
    rdfs:comment 'Comprehensive narrative documenting investigation activities, interviews conducted, evidence gathered, and findings.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Start Date' ;
    rdfs:comment 'Date the SIU investigator formally began the fraud investigation activities.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementAgency rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Agency' ;
    rdfs:comment 'Name of the law enforcement or prosecutorial agency to which the fraud case was referred.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Case Number' ;
    rdfs:comment 'Case or docket number assigned by the law enforcement agency for tracking the criminal investigation.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementReferralDate rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Date' ;
    rdfs:comment 'Date the fraud case was formally referred to law enforcement authorities.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Flag' ;
    rdfs:comment 'Indicator whether the case was referred to law enforcement or prosecutorial authorities.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nicbReferralDate rdf:type rdf:Property ;
    rdfs:label 'Nicb Referral Date' ;
    rdfs:comment 'Date the fraud case was submitted to the National Insurance Crime Bureau.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nicbReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Nicb Referral Flag' ;
    rdfs:comment 'Indicator whether the fraud case was reported to the National Insurance Crime Bureau for industry-wide tracking.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcome rdf:type rdf:Property ;
    rdfs:label 'Outcome' ;
    rdfs:comment 'Final determination of the fraud investigation indicating whether fraud was substantiated.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeDate rdf:type rdf:Property ;
    rdfs:label 'Outcome Date' ;
    rdfs:comment 'Date the final investigation outcome was determined and documented.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outcomeDescription rdf:type rdf:Property ;
    rdfs:label 'Outcome Description' ;
    rdfs:comment 'Detailed narrative explaining the investigation findings, evidence reviewed, and rationale for the outcome determination.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCancellationRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Policy Cancellation Recommended Flag' ;
    rdfs:comment 'Indicator whether the SIU investigation recommends canceling the policy due to material misrepresentation or fraud.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount' ;
    rdfs:comment 'Total monetary amount recovered from the fraudulent party through restitution, subrogation, or legal action.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Date' ;
    rdfs:comment 'Date the recovery amount was received or collected from the fraudulent party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referralDate rdf:type rdf:Property ;
    rdfs:label 'Referral Date' ;
    rdfs:comment 'Date the claim was referred to the Special Investigation Unit (SIU) for fraud investigation.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referralNumber rdf:type rdf:Property ;
    rdfs:label 'Referral Number' ;
    rdfs:comment 'Business-facing unique number assigned to the fraud referral for tracking and communication purposes.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralReason rdf:type rdf:Property ;
    rdfs:label 'Referral Reason' ;
    rdfs:comment 'Narrative explanation of why the claim was referred for fraud investigation, including specific concerns and evidence.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralSource rdf:type rdf:Property ;
    rdfs:label 'Referral Source' ;
    rdfs:comment 'Origin of the fraud referral indicating who or what initiated the investigation request. [ENUM-REF-CANDIDATE: adjuster|examiner|underwriter|producer|automated_system|tip_line|external_agency|data_analytics — 8 candidates stripped; promote to reference' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralTimestamp rdf:type rdf:Property ;
    rdfs:label 'Referral Timestamp' ;
    rdfs:comment 'Precise date and time the fraud referral was created in the system.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referringPartyCode rdf:type rdf:Property ;
    rdfs:label 'Referring Party Code' ;
    rdfs:comment 'Identifier of the person or entity who initiated the fraud referral.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referringUserCode rdf:type rdf:Property ;
    rdfs:label 'Referring User Code' ;
    rdfs:comment 'System user identifier of the employee who submitted the fraud referral.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFraudBureauReferralDate rdf:type rdf:Property ;
    rdfs:label 'State Fraud Bureau Referral Date' ;
    rdfs:comment 'Date the fraud case was submitted to the state insurance fraud bureau.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateFraudBureauReferralFlag rdf:type rdf:Property ;
    rdfs:label 'State Fraud Bureau Referral Flag' ;
    rdfs:comment 'Indicator whether the fraud case was reported to the state insurance fraud bureau as required by statute.' ;
    rdfs:domain ind:FraudReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:litigationId rdf:type rdf:Property ;
    rdfs:label 'Litigation Id' ;
    rdfs:comment 'Unique identifier for the litigation record.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defenseCounselServiceVendorId rdf:type rdf:Property ;
    rdfs:label 'Defense Counsel Service Vendor Id' ;
    rdfs:comment 'Foreign key linking to claims.service_vendor. Business justification: Defense counsel (law firms) are service vendors engaged by the insurer to defend claims in litigation.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceVendor .

ind:plaintiffAttorneyId rdf:type rdf:Property ;
    rdfs:label 'Plaintiff Attorney Id' ;
    rdfs:comment 'Foreign key linking to claims.attorney. Business justification: Litigation involves a plaintiff attorney who represents the claimant in suit. One attorney can represent plaintiffs in many litigations; one litigation has one plaintiff attorney.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Attorney .

ind:plaintiffClaimantId rdf:type rdf:Property ;
    rdfs:label 'Plaintiff Claimant Id' ;
    rdfs:comment 'Foreign key linking to claims.claimant. Business justification: In litigation, the plaintiff is typically a claimant asserting a loss under the policy (or the insured in a coverage dispute).' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claimant .

ind:suitFiledCalendarId rdf:type rdf:Property ;
    rdfs:label 'Suit Filed Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Litigation suit filed date determines litigation period for litigation rate analysis, defense cost tracking, and operational metrics.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:alaeIncurred rdf:type rdf:Property ;
    rdfs:label 'Alae Incurred' ;
    rdfs:comment 'Total allocated loss adjustment expense incurred for litigation defense and legal costs.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alaePaid rdf:type rdf:Property ;
    rdfs:label 'Alae Paid' ;
    rdfs:comment 'Total allocated loss adjustment expense paid to date for litigation.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealFiledIndicator rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Indicator' ;
    rdfs:comment 'Flag indicating whether an appeal has been filed following verdict.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:badFaithIndicator rdf:type rdf:Property ;
    rdfs:label 'Bad Faith Indicator' ;
    rdfs:comment 'Flag indicating whether the litigation involves bad faith allegations against the insurer.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseDescription rdf:type rdf:Property ;
    rdfs:label 'Case Description' ;
    rdfs:comment 'Detailed narrative description of the litigation case and allegations.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtCounty rdf:type rdf:Property ;
    rdfs:label 'Court County' ;
    rdfs:comment 'County where the court is located.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Court Jurisdiction' ;
    rdfs:comment 'Name and jurisdiction of the court where the suit is filed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtState rdf:type rdf:Property ;
