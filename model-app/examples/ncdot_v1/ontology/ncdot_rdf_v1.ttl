    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchasePriceAmount rdf:type rdf:Property ;
    rdfs:label 'Purchase Price Amount' ;
    rdfs:comment 'Purchase price paid for the vehicle as declared on the title application. Used for calculating highway use tax.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
