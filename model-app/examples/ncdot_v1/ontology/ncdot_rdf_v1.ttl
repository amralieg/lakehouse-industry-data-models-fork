    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousState rdf:type rdf:Property ;
    rdfs:label 'Previous State' ;
    rdfs:comment 'The two-letter state code where the vehicle was previously registered, if transferred from another state.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:odometerReading rdf:type rdf:Property ;
    rdfs:label 'Odometer Reading' ;
    rdfs:comment 'The odometer reading in miles at the time of registration or renewal.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:odometerReadingDate rdf:type rdf:Property ;
    rdfs:label 'Odometer Reading Date' ;
    rdfs:comment 'The date when the odometer reading was recorded.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Status' ;
    rdfs:comment 'The current status of the vehicle safety and emissions inspection.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Expiration Date' ;
    rdfs:comment 'The date when the current vehicle inspection expires.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionStationNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Station Number' ;
    rdfs:comment 'The identifier of the North Carolina Vehicle Inspection Program (NCVIP) station that performed the last inspection.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsTestRequired rdf:type rdf:Property ;
    rdfs:label 'Emissions Test Required' ;
    rdfs:comment 'Indicates whether an emissions test is required for this vehicle registration.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceCompanyName rdf:type rdf:Property ;
    rdfs:label 'Insurance Company Name' ;
    rdfs:comment 'The name of the insurance company providing liability coverage for the vehicle.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurancePolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Policy Number' ;
    rdfs:comment 'The policy number for the vehicle liability insurance.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Insurance Effective Date' ;
    rdfs:comment 'The date when the vehicle insurance coverage becomes effective.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuranceExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Insurance Expiration Date' ;
    rdfs:comment 'The date when the vehicle insurance coverage expires.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuranceVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Insurance Verification Status' ;
    rdfs:comment 'The status of insurance verification for the vehicle registration.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityPlacardIssued rdf:type rdf:Property ;
