    rdfs:comment 'Indicates whether the train provides accommodation for passenger bicycles.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reservationRequired rdf:type rdf:Property ;
    rdfs:label 'Reservation Required' ;
    rdfs:comment 'Indicates whether passengers must make advance reservations to board this train service.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ticketingSystem rdf:type rdf:Property ;
