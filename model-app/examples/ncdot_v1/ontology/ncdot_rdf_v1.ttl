ind:msrpAmount rdf:type rdf:Property ;
    rdfs:label 'Msrp Amount' ;
    rdfs:comment 'Original manufacturer suggested retail price when the vehicle was new.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trimLevel rdf:type rdf:Property ;
    rdfs:label 'Trim Level' ;
    rdfs:comment 'Specific trim level or package designation for the vehicle model (e.g., LX, EX, Limited, Sport).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:series rdf:type rdf:Property ;
    rdfs:label 'Series' ;
    rdfs:comment 'Vehicle series designation within the model line (e.g., 1500, 2500 for trucks).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cabType rdf:type rdf:Property ;
    rdfs:label 'Cab Type' ;
    rdfs:comment 'Cab configuration for trucks and commercial vehicles (e.g., regular cab, crew cab, extended cab).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bedLengthInches rdf:type rdf:Property ;
    rdfs:label 'Bed Length Inches' ;
    rdfs:comment 'Length of the cargo bed for pickup trucks measured in inches.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wheelchairAccessibleFlag rdf:type rdf:Property ;
