ind:targetLossRatioPct rdf:type rdf:Property ;
    rdfs:label 'Target Loss Ratio Pct' ;
    rdfs:comment 'Target loss ratio percentage for underwriting and pricing this line of business.' ;
    rdfs:domain ind:LobCode ;
