ind:lastDepartureTime rdf:type rdf:Property ;
    rdfs:label 'Last Departure Time' ;
    rdfs:comment 'Time of the last scheduled departure for the service day in HH:MM:SS format.' ;
    rdfs:domain ind:Ncdot ;
