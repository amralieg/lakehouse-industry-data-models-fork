ind:environmentalComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Status' ;
    rdfs:comment 'Status of environmental compliance for the train service under NEPA and other environmental regulations.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noiseMitigationRequired rdf:type rdf:Property ;
