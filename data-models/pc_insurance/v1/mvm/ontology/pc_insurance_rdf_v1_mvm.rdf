ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Classification of the PML run based on its business purpose and frequency.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:simulationCount rdf:type rdf:Property ;
    rdfs:label 'Simulation Count' ;
    rdfs:comment 'Number of stochastic simulations executed in this modeling run.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Treaty Effective Date' ;
    rdfs:comment 'Effective date of the reinsurance treaty used in net PML calculations.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vulnerabilitySetVersion rdf:type rdf:Property ;
    rdfs:label 'Vulnerability Set Version' ;
    rdfs:comment 'Version identifier of the vulnerability functions used in this run.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accumulationLimitId rdf:type rdf:Property ;
    rdfs:label 'Accumulation Limit Id' ;
    rdfs:comment 'Unique identifier for the accumulation limit record. Primary key.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approverPartyId rdf:type rdf:Property ;
    rdfs:label 'Approver Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Underwriting governance and audit trails require tracking which internal party (underwriter, executive) approved each cat accumulation limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:reinsuranceTreatyId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Id' ;
    rdfs:comment 'Reference to the reinsurance treaty that provides capacity supporting this accumulation limit, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Treaty .

ind:accumulationLimitStatus rdf:type rdf:Property ;
    rdfs:label 'Accumulation Limit Status' ;
    rdfs:comment 'Current lifecycle status of the accumulation limit: active, suspended, expired, pending approval, or withdrawn.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Role or title of the individual or committee authorized to approve this accumulation limit, such as Chief Underwriting Officer or Risk Committee.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availableCapacity rdf:type rdf:Property ;
    rdfs:label 'Available Capacity' ;
    rdfs:comment 'Remaining capacity available under this accumulation limit, calculated as limit amount minus utilization amount.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessJustification rdf:type rdf:Property ;
    rdfs:label 'Business Justification' ;
    rdfs:comment 'Textual explanation of the business rationale for setting this accumulation limit at the specified level.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Timestamp' ;
    rdfs:comment 'Timestamp when the utilization and available capacity were last calculated for this accumulation limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cededPercent rdf:type rdf:Property ;
    rdfs:label 'Ceded Percent' ;
    rdfs:comment 'Percentage of exposure ceded to reinsurers under treaties applicable to this zone and peril.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hardThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Hard Threshold Percent' ;
    rdfs:comment 'Utilization percentage at which new business is declined or suspended, typically 95-100 percent of the limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitBasis rdf:type rdf:Property ;
    rdfs:label 'Limit Basis' ;
    rdfs:comment 'Basis on which the limit is applied: per occurrence, aggregate across all events, or annual aggregate.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Type of exposure measure this limit applies to: Total Insured Value, Gross Written Premium, policy count, insured risk count, Probable Maximum Loss, or Average Annual Loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Net Retention Amount' ;
    rdfs:comment 'Amount of exposure retained net of reinsurance under this accumulation limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Override Allowed Flag' ;
    rdfs:comment 'Indicates whether underwriters are permitted to override this accumulation limit with appropriate authority. True if override allowed, false otherwise.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Override Authority Level' ;
    rdfs:comment 'Minimum authority level required to override this accumulation limit, such as Senior Underwriter, Chief Underwriting Officer, or Risk Committee.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference' ;
    rdfs:comment 'Citation or reference to the specific regulation, statute, or guideline that mandates or informs this accumulation limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Indicates whether this accumulation limit is mandated by regulatory or statutory requirements. True if mandated, false otherwise.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Frequency' ;
    rdfs:comment 'Frequency at which this accumulation limit is reviewed and potentially adjusted: daily, weekly, monthly, quarterly, annually, or event-driven.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:softThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Soft Threshold Percent' ;
    rdfs:comment 'Utilization percentage at which referral or enhanced monitoring is triggered, typically 80-90 percent of the limit.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdAction rdf:type rdf:Property ;
    rdfs:label 'Threshold Action' ;
    rdfs:comment 'Action to be taken when utilization exceeds defined thresholds: allow with monitoring, refer to senior underwriter, decline new business, or suspend writing.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilizationAmount rdf:type rdf:Property ;
    rdfs:label 'Utilization Amount' ;
    rdfs:comment 'Current aggregate exposure amount utilized against this limit, calculated from in-force policies and insured risks in the zone.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizationPercent rdf:type rdf:Property ;
    rdfs:label 'Utilization Percent' ;
    rdfs:comment 'Percentage of the accumulation limit currently utilized, calculated as utilization amount divided by limit amount times 100.' ;
    rdfs:domain ind:AccumulationLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyCatExposureId rdf:type rdf:Property ;
    rdfs:label 'Policy Cat Exposure Id' ;
    rdfs:comment 'Unique identifier for the policy catastrophe exposure record. One row per policy per CAT event or zone.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:asOfDate rdf:type rdf:Property ;
    rdfs:label 'As Of Date' ;
    rdfs:comment 'Snapshot date for which this catastrophe exposure record is valid, supporting point-in-time analysis.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bordereauxReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Reporting Flag' ;
    rdfs:comment 'Indicates whether this exposure must be reported to reinsurers via bordereaux submissions.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buildingAreaSqft rdf:type rdf:Property ;
    rdfs:label 'Building Area Sqft' ;
    rdfs:comment 'Total building area in square feet, used for exposure density and loss estimation.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constructionClass rdf:type rdf:Property ;
    rdfs:label 'Construction Class' ;
    rdfs:comment 'Construction type classification (frame, masonry, fire-resistive, non-combustible) per COPE framework.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleType rdf:type rdf:Property ;
    rdfs:label 'Deductible Type' ;
    rdfs:comment 'Type of deductible applied to catastrophe losses (flat dollar, percentage of TIV, franchise).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedGrossLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Gross Loss Amount' ;
    rdfs:comment 'Modeled or estimated gross loss amount for this exposure, used in FNOL triage and reinsurance bordereaux.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedNetLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Net Loss Amount' ;
    rdfs:comment 'Estimated net loss after deductible and policy limits, used for reserving and reinsurance recovery estimation.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Exposure Effective Date' ;
    rdfs:comment 'Date when the catastrophe exposure begins for this policy and location.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exposureExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Exposure Expiration Date' ;
    rdfs:comment 'Date when the catastrophe exposure ends for this policy and location.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exposureStatus rdf:type rdf:Property ;
    rdfs:label 'Exposure Status' ;
    rdfs:comment 'Current status of the catastrophe exposure record (active, expired, cancelled, suspended).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fnolTriagePriority rdf:type rdf:Property ;
    rdfs:label 'Fnol Triage Priority' ;
    rdfs:comment 'Priority level for FNOL triage based on estimated loss severity and policy characteristics.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelRunDate rdf:type rdf:Property ;
    rdfs:label 'Model Run Date' ;
    rdfs:comment 'Date when the catastrophe model was executed to generate loss estimates for this exposure.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:numberOfStories rdf:type rdf:Property ;
    rdfs:label 'Number Of Stories' ;
    rdfs:comment 'Number of stories or floors in the insured building, used for wind and earthquake modeling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupancyClass rdf:type rdf:Property ;
    rdfs:label 'Occupancy Class' ;
    rdfs:comment 'Occupancy classification of the insured property (residential, commercial, industrial, agricultural) per COPE framework.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionClass rdf:type rdf:Property ;
    rdfs:label 'Protection Class' ;
    rdfs:comment 'Fire protection class or ISO Public Protection Classification (PPC) for the location.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceProgramCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Program Code' ;
    rdfs:comment 'Code identifying the reinsurance program or treaty applicable to this catastrophe exposure.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatySharePercent rdf:type rdf:Property ;
    rdfs:label 'Treaty Share Percent' ;
    rdfs:comment 'Percentage of exposure ceded to reinsurance treaties, used for bordereaux generation and net exposure calculation.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearBuilt rdf:type rdf:Property ;
    rdfs:label 'Year Built' ;
    rdfs:comment 'Year the insured building or structure was originally constructed, used for vulnerability assessment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:submissionApplicantPartyId rdf:type rdf:Property ;
    rdfs:label 'Submission Applicant Party Id' ;
    rdfs:comment 'Foreign key to the party table identifying the applicant or prospect submitting the risk for underwriting evaluation.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:submissionPartyId rdf:type rdf:Property ;
    rdfs:label 'Submission Party Id' ;
    rdfs:comment 'Foreign key to the underwriter assigned to evaluate this submission.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:clearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Clearance Status' ;
    rdfs:comment 'Status of submission intake clearance process indicating whether all required information and documents have been received.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditReportDate rdf:type rdf:Property ;
    rdfs:label 'Credit Report Date' ;
    rdfs:comment 'Date the credit report or insurance score was pulled for this submission.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all monetary amounts in this submission.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReason rdf:type rdf:Property ;
    rdfs:label 'Decline Reason' ;
    rdfs:comment 'Business reason for declining the submission if status is declined such as adverse loss history, unacceptable risk, or outside appetite.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status' ;
    rdfs:comment 'Result of automated eligibility screening indicating whether the submission meets basic acceptance criteria.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAnnualPremium rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Premium' ;
    rdfs:comment 'Estimated or indicative annual premium for this submission prior to final rating.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Completed Date' ;
    rdfs:comment 'Date the required inspection was completed if applicable.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Inspection Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether a physical inspection of the insured property or risk is required before binding.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Line Of Business' ;
    rdfs:comment 'Insurance line of business for this submission such as Personal Auto, Homeowners, Commercial General Liability, Workers Compensation.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossHistoryReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Loss History Reviewed Flag' ;
    rdfs:comment 'Boolean flag indicating whether prior loss history was reviewed via CLUE, ISO, or other loss database.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrReportDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Report Date' ;
    rdfs:comment 'Date the Motor Vehicle Record report was pulled for auto submissions.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyTypeCode rdf:type rdf:Property ;
    rdfs:label 'Policy Type Code' ;
    rdfs:comment 'Code identifying the type of policy being submitted such as HO3, PAP, BOP, CGL, WC.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCarrierNaicCode rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Naic Code' ;
    rdfs:comment 'NAIC company code of the prior insurance carrier.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteCount rdf:type rdf:Property ;
    rdfs:label 'Quote Count' ;
    rdfs:comment 'Number of quotes generated from this submission.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralReason rdf:type rdf:Property ;
    rdfs:label 'Referral Reason' ;
    rdfs:comment 'Business reason or rule that triggered the referral requirement such as high TIV, adverse loss history, or non-standard risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether this submission requires referral to senior underwriter or management for approval.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskCountry rdf:type rdf:Property ;
    rdfs:label 'Risk Country' ;
    rdfs:comment 'Three-letter ISO country code where the insured risk is located.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskState rdf:type rdf:Property ;
    rdfs:label 'Risk State' ;
    rdfs:comment 'Two-letter state code where the primary insured risk is located.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Channel or origin through which the submission was received. [ENUM-REF-CANDIDATE: agent|broker|direct|web_portal|mobile_app|call_center|renewal|endorsement — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'Current lifecycle status of the submission in the underwriting workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|quoted|bound|declined|withdrawn|expired — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionType rdf:type rdf:Property ;
    rdfs:label 'Submission Type' ;
    rdfs:comment 'Classification of the submission as new business, renewal, rewrite, or remarketing of existing risk.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Submitted By User Code' ;
    rdfs:comment 'User identifier or login of the person who created or submitted this submission record.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawnReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Reason' ;
    rdfs:comment 'Reason the submission was withdrawn by the applicant or producer before binding.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryUwApprovedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Uw Approved By Party Id' ;
    rdfs:comment 'Reference to the party who provided final approval for the underwriting decision, if approval was required.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:tertiaryUwReferredToUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Uw Referred To Underwriter Party Id' ;
    rdfs:comment 'Reference to the senior underwriter or specialist to whom the submission was escalated.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:appetiteMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Appetite Match Flag' ;
    rdfs:comment 'Indicates whether the submission aligns with the insurers current risk appetite and strategic guidelines.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignedUnderwriterName rdf:type rdf:Property ;
    rdfs:label 'Assigned Underwriter Name' ;
    rdfs:comment 'Full name of the underwriter who rendered this decision, for reporting and audit purposes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:automatedDecisionFlag rdf:type rdf:Property ;
    rdfs:label 'Automated Decision Flag' ;
    rdfs:comment 'Indicates whether the underwriting decision was rendered by an automated rules engine or AI model versus a human underwriter.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionsRequired rdf:type rdf:Property ;
    rdfs:label 'Conditions Required' ;
    rdfs:comment 'List of conditions or requirements that must be met for conditional acceptance, such as inspections, loss control measures, or additional documentation.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Decision Effective Date' ;
    rdfs:comment 'The date from which the underwriting decision becomes effective, relevant for conditional acceptances or modified terms.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Decision Expiration Date' ;
    rdfs:comment 'The date when the underwriting decision expires if not acted upon, typically for quotes or conditional offers.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionModelVersion rdf:type rdf:Property ;
    rdfs:label 'Decision Model Version' ;
    rdfs:comment 'Version identifier of the automated underwriting model or rules engine used to render the decision, for audit and reproducibility.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionNumber rdf:type rdf:Property ;
    rdfs:label 'Decision Number' ;
    rdfs:comment 'Business-facing unique identifier for the underwriting decision, used in correspondence and workflow tracking.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionRationale rdf:type rdf:Property ;
    rdfs:label 'Decision Rationale' ;
    rdfs:comment 'Detailed explanation of the reasoning behind the underwriting decision, including risk factors and business considerations.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionStatus rdf:type rdf:Property ;
    rdfs:label 'Decision Status' ;
    rdfs:comment 'Current lifecycle status of the underwriting decision within the workflow. [ENUM-REF-CANDIDATE: pending|in_review|approved|rejected|escalated|withdrawn|expired — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decision Timestamp' ;
    rdfs:comment 'The date and time when the underwriting decision was rendered by the underwriter.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:decisionType rdf:type rdf:Property ;
    rdfs:label 'Decision Type' ;
    rdfs:comment 'The type of underwriting decision rendered: accept, decline, refer to senior UW, modify terms, counter-offer, or conditional acceptance.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReasonCode rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Code' ;
    rdfs:comment 'Standardized code indicating the primary reason for declining the submission, aligned with regulatory disclosure requirements.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Description' ;
    rdfs:comment 'Human-readable description of the decline reason, provided to the applicant per regulatory requirements.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Eligibility Flag' ;
    rdfs:comment 'Indicates whether the submission meets all eligibility criteria for the requested line of business and coverage.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endorsementsRequired rdf:type rdf:Property ;
    rdfs:label 'Endorsements Required' ;
    rdfs:comment 'List of endorsements or policy forms that must be attached as part of the underwriting decision.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionsAdded rdf:type rdf:Property ;
    rdfs:label 'Exclusions Added' ;
    rdfs:comment 'List of exclusions added to the policy as part of the underwriting decision to mitigate specific risks.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Modified Deductible Amount' ;
    rdfs:comment 'The revised deductible amount proposed by the underwriter if the decision type is modify or counter-offer.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Modified Limit Amount' ;
    rdfs:comment 'The revised coverage limit proposed by the underwriter if the decision type is modify or counter-offer.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Modified Premium Amount' ;
    rdfs:comment 'The revised premium amount proposed by the underwriter if the decision type is modify or counter-offer.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referralDueDate rdf:type rdf:Property ;
    rdfs:label 'Referral Due Date' ;
    rdfs:comment 'Service Level Agreement (SLA) due date by which the referral must be resolved to meet business commitments.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referralPriority rdf:type rdf:Property ;
    rdfs:label 'Referral Priority' ;
    rdfs:comment 'Priority level assigned to the referral, determining the urgency of senior underwriter review.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralReasonCode rdf:type rdf:Property ;
    rdfs:label 'Referral Reason Code' ;
    rdfs:comment 'Standardized code indicating why the submission was referred to a senior underwriter or specialist for further review.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Referral Reason Description' ;
    rdfs:comment 'Detailed explanation of why the submission requires escalation or specialist review.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaActualHours rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Hours' ;
    rdfs:comment 'The actual number of hours taken to render the underwriting decision, measured from submission intake to decision timestamp.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Met Flag' ;
    rdfs:comment 'Indicates whether the underwriting decision was rendered within the committed service level agreement timeframe.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Hours' ;
    rdfs:comment 'The target number of hours within which the underwriting decision should be rendered per business commitments.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:underwriterAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Underwriter Authority Level' ;
    rdfs:comment 'The authority level of the underwriter who made the decision, indicating approval limits and escalation tier.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryUwAssignedUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Uw Assigned Underwriter Party Id' ;
    rdfs:comment 'Identifier of the senior underwriter or specialist assigned to review and resolve the referral.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:approvalConditions rdf:type rdf:Property ;
    rdfs:label 'Approval Conditions' ;
    rdfs:comment 'Specific conditions or requirements that must be met for approval, such as additional documentation, coverage modifications, or premium adjustments.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityLevelRequired rdf:type rdf:Property ;
    rdfs:label 'Authority Level Required' ;
    rdfs:comment 'Level of underwriting authority required to approve this referral based on risk, premium, or policy limits.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheExposureFlag rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Exposure Flag' ;
    rdfs:comment 'Indicates whether the referral involves significant catastrophe exposure requiring senior review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:createdByUserCode rdf:type rdf:Property ;
    rdfs:label 'Created By User Code' ;
    rdfs:comment 'User identifier of the person or system that created the referral record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'Number of times the referral has been escalated to higher authority levels. Zero indicates no escalation.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastModifiedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User Code' ;
    rdfs:comment 'User identifier of the person or system that last modified the referral record.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorLossAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Loss Amount' ;
    rdfs:comment 'Total dollar amount of prior losses for the insured or risk that contributed to the referral decision.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorLossCount rdf:type rdf:Property ;
    rdfs:label 'Prior Loss Count' ;
    rdfs:comment 'Number of prior losses reported for the insured or risk that contributed to the referral decision.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Business priority assigned to the referral for queue management and SLA tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productCode rdf:type rdf:Property ;
    rdfs:label 'Product Code' ;
    rdfs:comment 'Internal product code identifying the specific insurance product being underwritten.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralAssignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Referral Assigned Timestamp' ;
    rdfs:comment 'Date and time when the referral was assigned to a senior underwriter for review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referralCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Referral Created Timestamp' ;
    rdfs:comment 'Date and time when the referral was first created in the underwriting workbench.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referralNumber rdf:type rdf:Property ;
    rdfs:label 'Referral Number' ;
    rdfs:comment 'Business-facing unique referral number displayed to underwriters and stakeholders.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralStatus rdf:type rdf:Property ;
    rdfs:label 'Referral Status' ;
    rdfs:comment 'Current lifecycle status of the referral: pending, under review, approved, declined, withdrawn, escalated, or returned. [ENUM-REF-CANDIDATE: pending|under_review|approved|declined|withdrawn|escalated|returned — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralType rdf:type rdf:Property ;
    rdfs:label 'Referral Type' ;
    rdfs:comment 'Type of transaction that triggered the referral: new business, renewal, endorsement, cancellation, reinstatement, or quote revision.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Concern Flag' ;
    rdfs:comment 'Indicates whether the referral involves regulatory compliance concerns requiring legal or compliance review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Required Flag' ;
    rdfs:comment 'Indicates whether reinsurance placement or facultative coverage is required as part of the referral review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Detailed notes from the reviewing underwriter explaining the resolution decision and any special conditions or requirements.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'Final decision outcome of the referral review: approved, approved with conditions, declined, withdrawn, escalated, or returned for rework.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Date and time when the referral was resolved with a final decision.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Target date by which the referral must be resolved per underwriting service level agreements.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:slaDueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sla Due Timestamp' ;
    rdfs:comment 'Precise date and time by which the referral must be resolved per underwriting service level agreements.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:basePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Base Premium Amount' ;
    rdfs:comment 'Base premium before application of discounts, surcharges, taxes, and fees.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundByUserCode rdf:type rdf:Property ;
    rdfs:label 'Bound By User Code' ;
    rdfs:comment 'Identifier of the user who bound the quote.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:boundTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bound Timestamp' ;
    rdfs:comment 'Timestamp when the quote was bound and converted to a policy.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:distributionChannel rdf:type rdf:Property ;
    rdfs:label 'Distribution Channel' ;
    rdfs:comment 'Channel through which the quote was originated and distributed.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossFreeYears rdf:type rdf:Property ;
    rdfs:label 'Loss Free Years' ;
    rdfs:comment 'Number of consecutive years without a claim, used for rating and discount eligibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Expiration Date' ;
    rdfs:comment 'Expiration date of the prior policy, used to assess continuity of coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:quoteStatus rdf:type rdf:Property ;
    rdfs:label 'Quote Status' ;
    rdfs:comment 'Current lifecycle status of the quote.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quotedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Quoted Premium Amount' ;
    rdfs:comment 'Total premium amount quoted to the customer, including all charges, taxes, and fees.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingEngineVersion rdf:type rdf:Property ;
    rdfs:label 'Rating Engine Version' ;
    rdfs:comment 'Version of the rating engine or pricing algorithm used to calculate the quoted premium.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingTier rdf:type rdf:Property ;
    rdfs:label 'Rating Tier' ;
    rdfs:comment 'Risk tier assigned during underwriting that determines pricing level.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Flag' ;
    rdfs:comment 'Indicates whether the quote was referred to senior underwriting for manual review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Total tax amount included in the quoted premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundCoverageId rdf:type rdf:Property ;
    rdfs:label 'Bound Coverage Id' ;
    rdfs:comment 'Foreign key linking to coverage.coverage. Business justification: Quote coverages become bound policy coverages when a quote is accepted. This lineage link enables tracking quote-to-policy conversion, comparing quoted vs bound terms, and supporting audit' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coverage .

ind:aggregateLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Amount' ;
    rdfs:comment 'Maximum amount the insurer will pay for all claims during the policy term. Null if no aggregate limit applies.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:classCode rdf:type rdf:Property ;
    rdfs:label 'Class Code' ;
    rdfs:comment 'ISO or NCCI class code for this coverage. Used in rating and risk classification.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCodes rdf:type rdf:Property ;
    rdfs:label 'Condition Codes' ;
    rdfs:comment 'Comma-separated list of condition codes applied to this coverage. References standard condition forms.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Code' ;
    rdfs:comment 'Standard code identifying the coverage type. Examples: BIPD, COLL, COMP, FIRE, THEFT, GL, WC.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Description' ;
    rdfs:comment 'Detailed description of what this coverage protects against, including scope and key terms.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageName rdf:type rdf:Property ;
    rdfs:label 'Coverage Name' ;
    rdfs:comment 'Human-readable name of the coverage. Examples: Bodily Injury, Property Damage, Collision, Comprehensive, Fire, General Liability.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Current status of this coverage line within the quote. Indicates whether coverage was quoted, declined, or referred.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageType rdf:type rdf:Property ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'Classification of the coverage layer. Indicates whether this is primary, excess, umbrella, or supplemental coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declinationReason rdf:type rdf:Property ;
    rdfs:label 'Declination Reason' ;
    rdfs:comment 'Reason the applicant declined this coverage. Null if coverage was not declined.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAppliesTo rdf:type rdf:Property ;
    rdfs:label 'Deductible Applies To' ;
    rdfs:comment 'Scope of deductible application. Per occurrence, per claim, per policy term, or aggregate across all claims.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementCodes rdf:type rdf:Property ;
    rdfs:label 'Endorsement Codes' ;
    rdfs:comment 'Comma-separated list of endorsement form numbers modifying this coverage. References ISO or proprietary endorsements.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCodes rdf:type rdf:Property ;
    rdfs:label 'Exclusion Codes' ;
    rdfs:comment 'Comma-separated list of exclusion codes applied to this coverage. References standard exclusion forms.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureUnits rdf:type rdf:Property ;
    rdfs:label 'Exposure Units' ;
    rdfs:comment 'Quantity of exposure units used in premium calculation. Examples: number of vehicles, square footage, payroll amount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extendedReportingPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Extended Reporting Period Months' ;
    rdfs:comment 'Length of extended reporting period in months for claims-made coverage. Null if not applicable.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isDeclined rdf:type rdf:Property ;
    rdfs:label 'Is Declined' ;
    rdfs:comment 'Indicates whether the applicant declined this optional coverage. True if declined, false otherwise.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Indicates whether this coverage is mandatory by law or regulation. True if required, false if optional.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perAccidentLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Accident Limit Amount' ;
    rdfs:comment 'Maximum amount payable per accident or occurrence. Null if not applicable.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perPersonLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Person Limit Amount' ;
    rdfs:comment 'Maximum amount payable per person for bodily injury or medical payments. Null if not applicable.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumBasis rdf:type rdf:Property ;
    rdfs:label 'Premium Basis' ;
    rdfs:comment 'Rating basis for premium calculation. Examples: per vehicle, per square foot, per payroll dollar, per revenue dollar, flat.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quotedDate rdf:type rdf:Property ;
    rdfs:label 'Quoted Date' ;
    rdfs:comment 'Date this coverage line was quoted. Business event timestamp for the quote generation.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroactiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date' ;
    rdfs:comment 'Retroactive date for claims-made coverage. Claims arising from incidents before this date are not covered.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfInsuredRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Self Insured Retention Amount' ;
    rdfs:comment 'Self-insured retention amount the insured must pay before coverage applies. Differs from deductible in claims handling.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationMethod rdf:type rdf:Property ;
    rdfs:label 'Valuation Method' ;
    rdfs:comment 'Method used to value losses under this coverage. Actual cash value, replacement cost, agreed value, stated amount, or market value.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Days' ;
    rdfs:comment 'Number of days before coverage becomes effective after policy inception. Null if no waiting period applies.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingFactorId rdf:type rdf:Property ;
    rdfs:label 'Rating Factor Id' ;
    rdfs:comment 'Unique identifier for the rating factor record.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideUserPartyId rdf:type rdf:Property ;
    rdfs:label 'Override User Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Factor-level overrides (schedule rating, experience mod adjustments) require user attribution for regulatory audit (rate filing compliance), pricing integrity validation, and underwriting' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:calculationFormula rdf:type rdf:Property ;
    rdfs:label 'Calculation Formula' ;
    rdfs:comment 'Mathematical expression or rule describing how this factor is computed or applied in the rating algorithm.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorBasis rdf:type rdf:Property ;
    rdfs:label 'Factor Basis' ;
    rdfs:comment 'The underlying risk characteristic or attribute that this factor is based on (e.g., ZIP code, NAICS code, loss history).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorCategory rdf:type rdf:Property ;
    rdfs:label 'Factor Category' ;
    rdfs:comment 'Classification of the factor type within the rating algorithm structure. [ENUM-REF-CANDIDATE: base_rate|territory|class_code|experience_mod|schedule_credit|schedule_debit|coverage_adjustment|limit_factor|deductible_credit — 9 candidates stripped; promote' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorCode rdf:type rdf:Property ;
    rdfs:label 'Factor Code' ;
    rdfs:comment 'Short code or abbreviation identifying the factor type for system processing and reporting.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorDescription rdf:type rdf:Property ;
    rdfs:label 'Factor Description' ;
    rdfs:comment 'Detailed explanation of what the factor represents and how it impacts the premium calculation.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorName rdf:type rdf:Property ;
    rdfs:label 'Factor Name' ;
    rdfs:comment 'Business name of the rating factor (e.g., Territory Factor, Class Code Factor, Experience Modification).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorSequence rdf:type rdf:Property ;
    rdfs:label 'Factor Sequence' ;
    rdfs:comment 'Ordinal position of this factor within the rating worksheet calculation sequence.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:factorSource rdf:type rdf:Property ;
    rdfs:label 'Factor Source' ;
    rdfs:comment 'Origin of the factor value (ISO table, proprietary rating plan, manual underwriter override, actuarial model, or state filing).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorType rdf:type rdf:Property ;
    rdfs:label 'Factor Type' ;
    rdfs:comment 'Indicates how the factor value is applied in the calculation (multiplicative, additive, percentage, or flat).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorValue rdf:type rdf:Property ;
    rdfs:label 'Factor Value' ;
    rdfs:comment 'Numeric value of the rating factor applied in the premium calculation (multiplier or additive amount).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isFiled rdf:type rdf:Property ;
    rdfs:label 'Is Filed' ;
    rdfs:comment 'Indicates whether this factor is part of a state-filed rating plan and subject to regulatory approval.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxFactorValue rdf:type rdf:Property ;
    rdfs:label 'Max Factor Value' ;
    rdfs:comment 'Maximum allowable value for this factor, enforcing underwriting or regulatory constraints.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minFactorValue rdf:type rdf:Property ;
    rdfs:label 'Min Factor Value' ;
    rdfs:comment 'Minimum allowable value for this factor, enforcing underwriting or regulatory constraints.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideTimestamp rdf:type rdf:Property ;
    rdfs:label 'Override Timestamp' ;
    rdfs:comment 'Date and time when the manual override was applied to this rating factor.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ratingFactorStatus rdf:type rdf:Property ;
    rdfs:label 'Rating Factor Status' ;
    rdfs:comment 'Current lifecycle status of the rating factor within the rating engine.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Table Effective Date' ;
    rdfs:comment 'Date when the rating table version became effective for use in premium calculations.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tableName rdf:type rdf:Property ;
    rdfs:label 'Table Name' ;
    rdfs:comment 'Name of the rating table or rule set from which this factor was retrieved.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableVersion rdf:type rdf:Property ;
    rdfs:label 'Table Version' ;
    rdfs:comment 'Version identifier of the rating table used to derive this factor, ensuring auditability and regulatory compliance.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossHistoryId rdf:type rdf:Property ;
    rdfs:label 'Loss History Id' ;
    rdfs:comment 'Unique identifier for the prior loss record.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossDateCalendarId rdf:type rdf:Property ;
    rdfs:label 'Loss Date Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Loss date is the primary dimension for accident year analysis, loss development triangles, IBNR reserve calculations, and statutory reporting (Schedule P).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:verifiedByAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Verified By Adjuster Id' ;
    rdfs:comment 'Foreign key to the adjuster party who performed the verification.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:atFaultFlag rdf:type rdf:Property ;
    rdfs:label 'At Fault Flag' ;
    rdfs:comment 'Indicates whether the applicant or insured party was determined to be at fault for the loss.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catastropheCode rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Code' ;
    rdfs:comment 'Industry catastrophe event code if the loss was part of a declared CAT event.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheFlag rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Flag' ;
    rdfs:comment 'Indicates whether the prior loss was part of a declared catastrophe event.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Status' ;
    rdfs:comment 'Status of the prior claim at the time of reporting (open, closed, settled, denied, withdrawn).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueReportOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Clue Report Order Number' ;
    rdfs:comment 'Order number for the CLUE report from which this loss record was extracted.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedFromRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Excluded From Rating Flag' ;
    rdfs:comment 'Indicates whether this prior loss is excluded from rating calculations (e.g., not-at-fault, CAT event).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionReason rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason' ;
    rdfs:comment 'Reason the prior loss is excluded from rating (not at fault, catastrophe, outside lookback period).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnCurrentClaim rdf:type rdf:Property ;
    rdfs:label 'Impact On Current Claim' ;
    rdfs:comment 'Assessment of how the verified prior loss information affects the handling or settlement of the current claim.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnRating rdf:type rdf:Property ;
    rdfs:label 'Impact On Rating' ;
    rdfs:comment 'Underwriting decision on how the prior loss impacts rating (surcharge, decline, refer, no impact, credit).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incurredAmount rdf:type rdf:Property ;
    rdfs:label 'Incurred Amount' ;
    rdfs:comment 'Total incurred amount (paid plus outstanding reserves) for the prior loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lookbackPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Months' ;
    rdfs:comment 'Number of months in the lookback period for this loss type as defined by underwriting guidelines.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossCauseCode rdf:type rdf:Property ;
    rdfs:label 'Loss Cause Code' ;
    rdfs:comment 'Standardized code for the cause of loss (fire, theft, collision, liability, water damage, wind, hail).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Loss Cause Description' ;
    rdfs:comment 'Human-readable description of the loss cause.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossDescription rdf:type rdf:Property ;
    rdfs:label 'Loss Description' ;
    rdfs:comment 'Narrative description of the prior loss event as reported by applicant or third-party source.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossType rdf:type rdf:Property ;
    rdfs:label 'Loss Type' ;
    rdfs:comment 'Classification of the loss by type (first party, third party, liability, property, auto, workers compensation).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrReportOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Mvr Report Order Number' ;
    rdfs:comment 'Order number for the MVR report from which this loss record was extracted.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'Total amount paid on the prior loss claim by the carrier.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Amount' ;
    rdfs:comment 'Outstanding reserve amount on the prior loss at the time of reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Surcharge Amount' ;
    rdfs:comment 'Premium surcharge amount applied due to this prior loss.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surchargePercentage rdf:type rdf:Property ;
    rdfs:label 'Surcharge Percentage' ;
    rdfs:comment 'Premium surcharge percentage applied due to this prior loss.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Dollar difference between prior loss reported amount and verified claim amount, if applicable.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceExplanation rdf:type rdf:Property ;
    rdfs:label 'Variance Explanation' ;
    rdfs:comment 'Adjuster notes explaining any discrepancies found between the prior loss record and actual claim data.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Verified Flag' ;
    rdfs:comment 'Indicates whether the prior loss has been verified by underwriting or third-party source. [Moved from loss_history: Verification is claim-specific. A prior loss may be verified against one claim but not another, so the flag belongs to the association, not' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withinLookbackFlag rdf:type rdf:Property ;
    rdfs:label 'Within Lookback Flag' ;
    rdfs:comment 'Indicates whether the prior loss falls within the applicable lookback period for underwriting and rating.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindRequestId rdf:type rdf:Property ;
    rdfs:label 'Bind Request Id' ;
    rdfs:comment 'Unique identifier for the bind request. Primary key. Grain: one row per bind request.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryBindApplicantPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Bind Applicant Party Id' ;
    rdfs:comment 'Reference to the party requesting to bind the policy. Primary insured or named insured.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:automatedBindFlag rdf:type rdf:Property ;
    rdfs:label 'Automated Bind Flag' ;
    rdfs:comment 'Indicates whether the bind request was approved automatically by system rules without underwriter review.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Bind Approval Date' ;
    rdfs:comment 'Date the underwriter or system approved the bind request. Policy issuance proceeds after approval.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindApprovalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bind Approval Timestamp' ;
    rdfs:comment 'Precise date and time the bind request was approved. Used for SLA compliance and audit trail.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bindAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Bind Authority Level' ;
    rdfs:comment 'Authority level required to approve this bind request. Determined by risk characteristics and premium size.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindConditionsMetFlag rdf:type rdf:Property ;
    rdfs:label 'Bind Conditions Met Flag' ;
    rdfs:comment 'Indicates whether all required bind conditions have been satisfied. Must be true for bind approval.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindConditionsRequired rdf:type rdf:Property ;
    rdfs:label 'Bind Conditions Required' ;
    rdfs:comment 'List of conditions that must be satisfied before bind approval. Inspection, loss control, additional documentation.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindRejectionDate rdf:type rdf:Property ;
    rdfs:label 'Bind Rejection Date' ;
    rdfs:comment 'Date the bind request was rejected by underwriter or system. Ends bind request lifecycle.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindRejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Bind Rejection Reason Code' ;
    rdfs:comment 'Standardized code indicating why the bind request was rejected. Links to rejection reason reference table.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindRejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Bind Rejection Reason Description' ;
    rdfs:comment 'Detailed explanation of why the bind request was rejected. Provided to producer and applicant.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindRequestDate rdf:type rdf:Property ;
    rdfs:label 'Bind Request Date' ;
    rdfs:comment 'Date the bind request was submitted by producer or applicant. Business event timestamp for bind initiation.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindRequestStatus rdf:type rdf:Property ;
    rdfs:label 'Bind Request Status' ;
    rdfs:comment 'Current lifecycle status of the bind request. Tracks progression from submission through final disposition.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateOfInsuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Certificate Of Insurance Required Flag' ;
    rdfs:comment 'Indicates whether a certificate of insurance must be issued at bind. Common for commercial liability.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:downPaymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Down Payment Received Date' ;
    rdfs:comment 'Date the down payment was received and cleared. Triggers bind approval workflow.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:downPaymentReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Down Payment Received Flag' ;
    rdfs:comment 'Indicates whether the down payment has been received and cleared. Required for bind approval.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lob rdf:type rdf:Property ;
    rdfs:label 'Lob' ;
    rdfs:comment 'Insurance line of business for the bind request. Personal Auto, Homeowners, Commercial General Liability, etc.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortgageeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Mortgagee Required Flag' ;
    rdfs:comment 'Indicates whether mortgagee or loss payee information is required before bind. Common for property coverage.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorCarrierCancellationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Cancellation Required Flag' ;
    rdfs:comment 'Indicates whether proof of prior carrier cancellation is required before bind. Prevents dual coverage.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestedEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Requested Effective Date' ;
    rdfs:comment 'Date the applicant or producer requests coverage to begin. May differ from quote effective date.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Requested Expiration Date' ;
    rdfs:comment 'Date the applicant or producer requests coverage to end. Typically one year from effective date.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timestamp rdf:type rdf:Property ;
    rdfs:label 'Timestamp' ;
    rdfs:comment 'Precise date and time the bind request was received. Used for SLA tracking and audit trail.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:binderInsuredPartyId rdf:type rdf:Property ;
    rdfs:label 'Binder Insured Party Id' ;
    rdfs:comment 'Reference to the party being insured under this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:binderPartyId rdf:type rdf:Property ;
    rdfs:label 'Binder Party Id' ;
    rdfs:comment 'Reference to the underwriter who authorized this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:bindDate rdf:type rdf:Property ;
    rdfs:label 'Bind Date' ;
    rdfs:comment 'Date when the binder was issued and coverage became effective.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:binderStatus rdf:type rdf:Property ;
    rdfs:label 'Binder Status' ;
    rdfs:comment 'Current lifecycle status of the binder contract.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindingAuthorityType rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Type' ;
    rdfs:comment 'Type of authority under which this binder was issued.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Reason for binder cancellation, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Limit Amount' ;
    rdfs:comment 'Maximum liability limit provided under this binder.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'Reference URL or path to the binder document in the document management system.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Company Code' ;
    rdfs:comment 'NAIC company code of the insurer issuing this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingState rdf:type rdf:Property ;
    rdfs:label 'Issuing State' ;
    rdfs:comment 'State jurisdiction where the binder was issued.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Modified By User Code' ;
    rdfs:comment 'User identifier of the person who last modified this binder record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Policy Issued Date' ;
    rdfs:comment 'Date when the formal policy was issued to replace this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:replacedByPolicyFlag rdf:type rdf:Property ;
    rdfs:label 'Replaced By Policy Flag' ;
    rdfs:comment 'Indicates whether this binder was replaced by a formal policy issuance.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termDays rdf:type rdf:Property ;
    rdfs:label 'Term Days' ;
    rdfs:comment 'Duration of binder coverage in days, typically 30-90 days.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:writingProducerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Writing Producer Producers Producer Id' ;
    rdfs:comment 'Foreign key linking to producers.producers_producer. Business justification: Producer book-of-business reporting, commission calculation, and binding authority compliance all require tracing each insured risk to the writing producer.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:constructionCode rdf:type rdf:Property ;
    rdfs:label 'Construction Code' ;
    rdfs:comment 'ISO or NAIC construction type code. Part of COPE data for property risks.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureBasis rdf:type rdf:Property ;
    rdfs:label 'Exposure Basis' ;
    rdfs:comment 'Unit of measure for rating exposure. Examples: square footage, payroll, sales, number of vehicles, number of employees.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZoneCode rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Code' ;
    rdfs:comment 'FEMA flood zone designation for this risk. Determines flood coverage eligibility and pricing.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardScore rdf:type rdf:Property ;
    rdfs:label 'Hazard Score' ;
    rdfs:comment 'Catastrophe hazard score for this risk location. Derived from catastrophe modeling platforms.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Date' ;
    rdfs:comment 'Date when the most recent physical inspection of this risk was completed.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Status' ;
    rdfs:comment 'Current status of the inspection requirement for this risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itvPercentage rdf:type rdf:Property ;
    rdfs:label 'Itv Percentage' ;
    rdfs:comment 'Ratio of sum insured to total insured value, expressed as percentage. Used to identify underinsurance and apply coinsurance penalties.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupancyCode rdf:type rdf:Property ;
    rdfs:label 'Occupancy Code' ;
    rdfs:comment 'ISO or NAIC occupancy classification code. Part of COPE data for property risks.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Description' ;
    rdfs:comment 'Free-text narrative describing the insured risk. Appears on policy declarations and endorsements.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskNumber rdf:type rdf:Property ;
    rdfs:label 'Risk Number' ;
    rdfs:comment 'Business identifier for the insured risk, unique within the policy. Used on declarations pages and endorsements.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Status' ;
    rdfs:comment 'Current lifecycle status of the insured risk within the policy term.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sumInsuredAmount rdf:type rdf:Property ;
    rdfs:label 'Sum Insured Amount' ;
    rdfs:comment 'Sum insured representing the policy limit applicable to this risk. May differ from total insured value based on underwriting decisions.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Date' ;
    rdfs:comment 'Date when the insured value was last assessed or updated. Used for insurance-to-value calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:propertyOwnerPartyId rdf:type rdf:Property ;
    rdfs:label 'Property Owner Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Property underwriting requires direct link to property owner party for title verification, loss payee validation, and insured interest determination.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:actualCashValue rdf:type rdf:Property ;
    rdfs:label 'Actual Cash Value' ;
    rdfs:comment 'The replacement cost value minus depreciation. Used for certain policy forms and loss settlement.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basementFinishType rdf:type rdf:Property ;
    rdfs:label 'Basement Finish Type' ;
    rdfs:comment 'The level of finish in the basement, if present. Impacts valuation and loss potential.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basementIndicator rdf:type rdf:Property ;
    rdfs:label 'Basement Indicator' ;
    rdfs:comment 'Indicates whether the property has a basement. Impacts flood and water damage risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:burglarAlarmIndicator rdf:type rdf:Property ;
    rdfs:label 'Burglar Alarm Indicator' ;
    rdfs:comment 'Indicates whether the property has a burglar or intrusion alarm system. May provide premium credit.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:centralStationMonitoringIndicator rdf:type rdf:Property ;
    rdfs:label 'Central Station Monitoring Indicator' ;
    rdfs:comment 'Indicates whether alarm systems are monitored by a central station. Provides additional premium credit.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:constructionType rdf:type rdf:Property ;
    rdfs:label 'Construction Type' ;
    rdfs:comment 'The construction class of the building. Part of COPE attributes. Examples: frame, joisted masonry, non-combustible, masonry non-combustible, modified fire resistive, fire resistive.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coolingType rdf:type rdf:Property ;
    rdfs:label 'Cooling Type' ;
    rdfs:comment 'The type of cooling or air conditioning system. Examples: central air, window units, evaporative, none.' ;
