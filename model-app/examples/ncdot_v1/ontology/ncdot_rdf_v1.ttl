    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittalNumber rdf:type rdf:Property ;
    rdfs:label 'Submittal Number' ;
    rdfs:comment 'Sequential submittal tracking number for contractor or consultant document submissions.' ;
