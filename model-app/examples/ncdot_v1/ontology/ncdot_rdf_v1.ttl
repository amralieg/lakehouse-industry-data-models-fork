    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystName rdf:type rdf:Property ;
    rdfs:label 'Analyst Name' ;
    rdfs:comment 'The name of the NCDOT budget analyst responsible for budget preparation, monitoring, and reporting.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystEmail rdf:type rdf:Property ;
    rdfs:label 'Analyst Email' ;
    rdfs:comment 'The email address of the NCDOT budget analyst responsible for budget preparation, monitoring, and reporting.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingAllocationId rdf:type rdf:Property ;
    rdfs:label 'Funding Allocation Id' ;
    rdfs:comment 'Unique identifier for each funding allocation record. Primary key for the funding allocation entity.' ;
