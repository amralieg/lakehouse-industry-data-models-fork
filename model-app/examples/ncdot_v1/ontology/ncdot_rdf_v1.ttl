    rdfs:range xsd:string .

ind:federalAidEligible rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Eligible' ;
    rdfs:comment 'Indicates whether this pavement section is eligible for federal funding assistance.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sensorReadingId rdf:type rdf:Property ;
    rdfs:label 'Sensor Reading Id' ;
    rdfs:comment 'Unique identifier for each sensor reading record captured from roadway monitoring equipment.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sensorType rdf:type rdf:Property ;
    rdfs:label 'Sensor Type' ;
    rdfs:comment 'Classification of the sensor type indicating what physical property or condition is being measured.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensorManufacturer rdf:type rdf:Property ;
    rdfs:label 'Sensor Manufacturer' ;
    rdfs:comment 'Name of the manufacturer or vendor that produced the sensor device.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensorModel rdf:type rdf:Property ;
    rdfs:label 'Sensor Model' ;
    rdfs:comment 'Model number or designation of the sensor device as specified by the manufacturer.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensorSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Sensor Serial Number' ;
    rdfs:comment 'Unique serial number assigned by the manufacturer to the individual sensor unit.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reading Timestamp' ;
    rdfs:comment 'Precise date and time when the sensor reading was captured, formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readingValue rdf:type rdf:Property ;
    rdfs:label 'Reading Value' ;
    rdfs:comment 'Numeric value of the measurement captured by the sensor at the reading timestamp.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readingQualityCode rdf:type rdf:Property ;
    rdfs:label 'Reading Quality Code' ;
    rdfs:comment 'Quality assessment code indicating the reliability and validity of the sensor reading.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingStatus rdf:type rdf:Property ;
    rdfs:label 'Reading Status' ;
    rdfs:comment 'Current processing status of the sensor reading within the data management lifecycle.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementLayer rdf:type rdf:Property ;
    rdfs:label 'Pavement Layer' ;
    rdfs:comment 'Pavement structural layer where the sensor is embedded or monitoring (applicable for pavement sensors).' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationDepthMm rdf:type rdf:Property ;
    rdfs:label 'Installation Depth Mm' ;
    rdfs:comment 'Depth in millimeters at which the sensor is installed below the pavement surface or reference point.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureCelsius rdf:type rdf:Property ;
    rdfs:label 'Temperature Celsius' ;
    rdfs:comment 'Temperature measurement in degrees Celsius captured by temperature sensors for pavement or ambient conditions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moisturePercent rdf:type rdf:Property ;
    rdfs:label 'Moisture Percent' ;
    rdfs:comment 'Moisture content percentage measured in pavement layers or subgrade materials.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strainMicrostrain rdf:type rdf:Property ;
    rdfs:label 'Strain Microstrain' ;
    rdfs:comment 'Strain measurement in microstrain units indicating deformation or stress in pavement structure.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pressurePsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Psi' ;
    rdfs:comment 'Pressure measurement in pounds per square inch for stress or load monitoring.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vibrationFrequencyHz rdf:type rdf:Property ;
    rdfs:label 'Vibration Frequency Hz' ;
    rdfs:comment 'Vibration frequency measurement in Hertz for structural health monitoring.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trafficVolumeCount rdf:type rdf:Property ;
    rdfs:label 'Traffic Volume Count' ;
    rdfs:comment 'Number of vehicles counted by traffic counter sensors during the measurement interval.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Vehicle Speed Mph' ;
    rdfs:comment 'Vehicle speed measurement in miles per hour captured by traffic monitoring sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleWeightTons rdf:type rdf:Property ;
    rdfs:label 'Vehicle Weight Tons' ;
    rdfs:comment 'Vehicle weight measurement in tons captured by weigh-in-motion sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rutDepthMm rdf:type rdf:Property ;
    rdfs:label 'Rut Depth Mm' ;
    rdfs:comment 'Pavement rutting depth measurement in millimeters captured by automated profiling sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crackDensityPercent rdf:type rdf:Property ;
    rdfs:label 'Crack Density Percent' ;
    rdfs:comment 'Percentage of pavement surface area affected by cracking as measured by automated distress detection sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:airTemperatureCelsius rdf:type rdf:Property ;
    rdfs:label 'Air Temperature Celsius' ;
    rdfs:comment 'Ambient air temperature measurement in degrees Celsius from weather station sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:precipitationMm rdf:type rdf:Property ;
    rdfs:label 'Precipitation Mm' ;
    rdfs:comment 'Precipitation amount in millimeters measured during the reading interval by weather sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:windSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Wind Speed Mph' ;
    rdfs:comment 'Wind speed measurement in miles per hour from weather station sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:windDirectionDegrees rdf:type rdf:Property ;
    rdfs:label 'Wind Direction Degrees' ;
    rdfs:comment 'Wind direction in degrees (0-360) from true north measured by weather station sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:relativeHumidityPercent rdf:type rdf:Property ;
    rdfs:label 'Relative Humidity Percent' ;
    rdfs:comment 'Relative humidity percentage measured by weather station sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:visibilityMeters rdf:type rdf:Property ;
    rdfs:label 'Visibility Meters' ;
    rdfs:comment 'Visibility distance in meters measured by weather station sensors for roadway safety monitoring.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freezingPointCelsius rdf:type rdf:Property ;
    rdfs:label 'Freezing Point Celsius' ;
    rdfs:comment 'Calculated freezing point temperature of the pavement surface considering chemical treatments.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saltConcentrationPercent rdf:type rdf:Property ;
    rdfs:label 'Salt Concentration Percent' ;
    rdfs:comment 'Salt or chemical treatment concentration percentage on the pavement surface measured by environmental sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noiseLevelDecibels rdf:type rdf:Property ;
    rdfs:label 'Noise Level Decibels' ;
    rdfs:comment 'Ambient noise level measurement in decibels from roadway noise monitoring sensors.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batteryVoltage rdf:type rdf:Property ;
    rdfs:label 'Battery Voltage' ;
    rdfs:comment 'Current battery voltage of the sensor device for remote monitoring of power status.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signalStrengthDbm rdf:type rdf:Property ;
    rdfs:label 'Signal Strength Dbm' ;
    rdfs:comment 'Communication signal strength in dBm for wireless sensor connectivity monitoring.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataTransmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Data Transmission Status' ;
    rdfs:comment 'Status of data transmission from the sensor to the central data collection system.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calibrationDueDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Due Date' ;
    rdfs:comment 'Scheduled date for the next required sensor calibration based on maintenance intervals.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:aggregationPeriodMinutes rdf:type rdf:Property ;
    rdfs:label 'Aggregation Period Minutes' ;
    rdfs:comment 'Time period in minutes over which sensor readings are aggregated for reporting (e.g., 5-minute, 15-minute intervals).' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alertThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Alert Threshold Value' ;
    rdfs:comment 'Configured threshold value that triggers an alert or notification when exceeded by sensor readings.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alertTriggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Alert Triggered Flag' ;
    rdfs:comment 'Indicates whether this sensor reading triggered an alert condition based on configured thresholds.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertSeverity rdf:type rdf:Property ;
    rdfs:label 'Alert Severity' ;
    rdfs:comment 'Severity level of the alert triggered by this sensor reading.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationMethod rdf:type rdf:Property ;
    rdfs:label 'Validation Method' ;
    rdfs:comment 'Method used to validate the accuracy and quality of the sensor reading.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validatedBy rdf:type rdf:Property ;
    rdfs:label 'Validated By' ;
    rdfs:comment 'Username or identifier of the person or system that validated the sensor reading.' ;
    rdfs:domain ind:SensorReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataClassification rdf:type rdf:Property ;
    rdfs:label 'Data Classification' ;
    rdfs:comment 'Security classification level of the sensor reading data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionActivityId rdf:type rdf:Property ;
    rdfs:label 'Construction Activity Id' ;
    rdfs:comment 'Unique identifier for the construction activity record. Primary key for tracking individual construction activities on highway segments.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConstructionActivity .

ind:subcontractorName rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Name' ;
    rdfs:comment 'Name of the subcontractor performing specialized work for this construction activity, if applicable.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workDaysCompleted rdf:type rdf:Property ;
    rdfs:label 'Work Days Completed' ;
    rdfs:comment 'Number of actual working days spent on the construction activity, excluding weather delays and non-work days.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completionPercentage rdf:type rdf:Property ;
    rdfs:label 'Completion Percentage' ;
    rdfs:comment 'Percentage of the construction activity that has been completed. Used for progress tracking and payment calculations. Value between 0 and 100.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityPlanned rdf:type rdf:Property ;
    rdfs:label 'Quantity Planned' ;
    rdfs:comment 'Planned quantity of work to be performed for this construction activity, measured in the appropriate unit (e.g., cubic yards, square feet, linear feet).' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityCompleted rdf:type rdf:Property ;
    rdfs:label 'Quantity Completed' ;
    rdfs:comment 'Actual quantity of work completed for this construction activity, measured in the appropriate unit. Used for payment and progress reporting.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payItemNumber rdf:type rdf:Property ;
    rdfs:label 'Pay Item Number' ;
    rdfs:comment 'NCDOT standard pay item number associated with this construction activity. Used for contract payment and cost accounting.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payItemDescription rdf:type rdf:Property ;
    rdfs:label 'Pay Item Description' ;
    rdfs:comment 'Standard description of the pay item associated with this construction activity as defined in NCDOT specifications.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialSource rdf:type rdf:Property ;
    rdfs:label 'Material Source' ;
    rdfs:comment 'Source location or supplier of the primary material used in the construction activity. Used for quality control and supply chain tracking.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherDelayHours rdf:type rdf:Property ;
    rdfs:label 'Weather Delay Hours' ;
    rdfs:comment 'Total hours of work delay attributed to adverse weather conditions. Used for schedule variance analysis and contract time adjustments.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laneClosureCount rdf:type rdf:Property ;
    rdfs:label 'Lane Closure Count' ;
    rdfs:comment 'Number of traffic lanes closed during the construction activity. Used for traffic impact analysis and public communication.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workZoneSpeedLimit rdf:type rdf:Property ;
    rdfs:label 'Work Zone Speed Limit' ;
    rdfs:comment 'Posted speed limit in miles per hour within the construction work zone. Enforced for worker and motorist safety.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyIncidentCount rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Count' ;
    rdfs:comment 'Number of safety incidents or near-misses that occurred during the construction activity. Used for safety performance tracking.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oshaRecordableIncident rdf:type rdf:Property ;
    rdfs:label 'Osha Recordable Incident' ;
    rdfs:comment 'Indicates whether an OSHA-recordable safety incident occurred during the construction activity. Used for regulatory compliance reporting.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:erosionControlMeasures rdf:type rdf:Property ;
    rdfs:label 'Erosion Control Measures' ;
    rdfs:comment 'Description of erosion and sediment control measures implemented during the construction activity to comply with environmental regulations.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormwaterCompliance rdf:type rdf:Property ;
    rdfs:label 'Stormwater Compliance' ;
    rdfs:comment 'Indicates whether the construction activity is in compliance with stormwater management requirements and permits.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityControlTestCount rdf:type rdf:Property ;
    rdfs:label 'Quality Control Test Count' ;
    rdfs:comment 'Number of quality control tests performed during the construction activity. Used for quality assurance documentation.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualityAssurancePassed rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Passed' ;
    rdfs:comment 'Indicates whether the construction activity passed all required quality assurance inspections and tests.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:changeOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Change Order Number' ;
    rdfs:comment 'Identifier for any contract change order affecting this construction activity. Used for tracking scope and cost modifications.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeOrderImpact rdf:type rdf:Property ;
    rdfs:label 'Change Order Impact' ;
    rdfs:comment 'Type of impact the change order has on the construction activity (scope, cost, or schedule).' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dailyReportNumber rdf:type rdf:Property ;
    rdfs:label 'Daily Report Number' ;
    rdfs:comment 'Identifier for the daily construction report documenting this activity. Used for project documentation and record-keeping.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nightWorkPremium rdf:type rdf:Property ;
    rdfs:label 'Night Work Premium' ;
    rdfs:comment 'Indicates whether night work premium rates apply to this construction activity. Used for cost accounting and payment processing.' ;
    rdfs:domain ind:ConstructionActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:runwayId rdf:type rdf:Property ;
    rdfs:label 'Runway Id' ;
    rdfs:comment 'Unique identifier for the runway within the NCDOT aviation system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Runway .

ind:designation rdf:type rdf:Property ;
    rdfs:label 'Designation' ;
    rdfs:comment 'The runway identifier based on magnetic heading rounded to nearest 10 degrees, with optional parallel runway designator (L/R/C). Example: 18L, 36R, 09.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lengthFt rdf:type rdf:Property ;
    rdfs:label 'Length Ft' ;
    rdfs:comment 'The total physical length of the runway measured in feet from threshold to threshold.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surfaceTreatment rdf:type rdf:Property ;
    rdfs:label 'Surface Treatment' ;
    rdfs:comment 'Special surface treatment applied to enhance friction, drainage, or performance characteristics.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementClassificationNumber rdf:type rdf:Property ;
    rdfs:label 'Pavement Classification Number' ;
    rdfs:comment 'The bearing strength of the runway pavement expressed using the Aircraft Classification Number/Pavement Classification Number (ACN/PCN) method.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseEndDesignation rdf:type rdf:Property ;
    rdfs:label 'Base End Designation' ;
    rdfs:comment 'The designation of the lower-numbered runway end (e.g., 09 in a 09/27 runway).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseEndLatitude rdf:type rdf:Property ;
    rdfs:label 'Base End Latitude' ;
    rdfs:comment 'The geographic latitude coordinate of the base end threshold in decimal degrees.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseEndLongitude rdf:type rdf:Property ;
    rdfs:label 'Base End Longitude' ;
    rdfs:comment 'The geographic longitude coordinate of the base end threshold in decimal degrees.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseEndElevationFt rdf:type rdf:Property ;
    rdfs:label 'Base End Elevation Ft' ;
    rdfs:comment 'The elevation of the base end threshold above mean sea level measured in feet.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseEndDisplacedThresholdFt rdf:type rdf:Property ;
    rdfs:label 'Base End Displaced Threshold Ft' ;
    rdfs:comment 'The distance in feet that the landing threshold is displaced from the physical runway end at the base end. Zero if no displacement.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baseEndGradientPercent rdf:type rdf:Property ;
    rdfs:label 'Base End Gradient Percent' ;
    rdfs:comment 'The effective gradient (slope) of the runway from the base end perspective, expressed as a percentage.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reciprocalEndDesignation rdf:type rdf:Property ;
    rdfs:label 'Reciprocal End Designation' ;
    rdfs:comment 'The designation of the higher-numbered runway end (e.g., 27 in a 09/27 runway).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reciprocalEndLatitude rdf:type rdf:Property ;
    rdfs:label 'Reciprocal End Latitude' ;
    rdfs:comment 'The geographic latitude coordinate of the reciprocal end threshold in decimal degrees.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reciprocalEndLongitude rdf:type rdf:Property ;
    rdfs:label 'Reciprocal End Longitude' ;
    rdfs:comment 'The geographic longitude coordinate of the reciprocal end threshold in decimal degrees.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reciprocalEndElevationFt rdf:type rdf:Property ;
    rdfs:label 'Reciprocal End Elevation Ft' ;
    rdfs:comment 'The elevation of the reciprocal end threshold above mean sea level measured in feet.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reciprocalEndDisplacedThresholdFt rdf:type rdf:Property ;
    rdfs:label 'Reciprocal End Displaced Threshold Ft' ;
    rdfs:comment 'The distance in feet that the landing threshold is displaced from the physical runway end at the reciprocal end. Zero if no displacement.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reciprocalEndGradientPercent rdf:type rdf:Property ;
    rdfs:label 'Reciprocal End Gradient Percent' ;
    rdfs:comment 'The effective gradient (slope) of the runway from the reciprocal end perspective, expressed as a percentage.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:magneticBearingBaseEnd rdf:type rdf:Property ;
    rdfs:label 'Magnetic Bearing Base End' ;
    rdfs:comment 'The magnetic azimuth bearing of the base end runway centerline in degrees (0-360).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:magneticBearingReciprocalEnd rdf:type rdf:Property ;
    rdfs:label 'Magnetic Bearing Reciprocal End' ;
    rdfs:comment 'The magnetic azimuth bearing of the reciprocal end runway centerline in degrees (0-360).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trueBearingBaseEnd rdf:type rdf:Property ;
    rdfs:label 'True Bearing Base End' ;
    rdfs:comment 'The true (geographic) azimuth bearing of the base end runway centerline in degrees (0-360).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trueBearingReciprocalEnd rdf:type rdf:Property ;
    rdfs:label 'True Bearing Reciprocal End' ;
    rdfs:comment 'The true (geographic) azimuth bearing of the reciprocal end runway centerline in degrees (0-360).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:edgeLightingType rdf:type rdf:Property ;
    rdfs:label 'Edge Lighting Type' ;
    rdfs:comment 'The intensity classification of the runway edge lighting system installed along the runway sides.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:centerlineLighting rdf:type rdf:Property ;
    rdfs:label 'Centerline Lighting' ;
    rdfs:comment 'Indicates whether the runway is equipped with centerline lighting for low-visibility operations.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:touchdownZoneLighting rdf:type rdf:Property ;
    rdfs:label 'Touchdown Zone Lighting' ;
    rdfs:comment 'Indicates whether the runway is equipped with touchdown zone lighting to enhance visibility during approach and landing.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approachLightingSystemBaseEnd rdf:type rdf:Property ;
    rdfs:label 'Approach Lighting System Base End' ;
    rdfs:comment 'The type of approach lighting system installed at the base end of the runway to aid pilots during approach.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approachLightingSystemReciprocalEnd rdf:type rdf:Property ;
    rdfs:label 'Approach Lighting System Reciprocal End' ;
    rdfs:comment 'The type of approach lighting system installed at the reciprocal end of the runway to aid pilots during approach.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visualGlideSlopeIndicatorBaseEnd rdf:type rdf:Property ;
    rdfs:label 'Visual Glide Slope Indicator Base End' ;
    rdfs:comment 'The type of visual approach slope indicator system installed at the base end (e.g., VASI, PAPI).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visualGlideSlopeIndicatorReciprocalEnd rdf:type rdf:Property ;
    rdfs:label 'Visual Glide Slope Indicator Reciprocal End' ;
    rdfs:comment 'The type of visual approach slope indicator system installed at the reciprocal end (e.g., VASI, PAPI).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endIdentifierLights rdf:type rdf:Property ;
    rdfs:label 'End Identifier Lights' ;
    rdfs:comment 'Indicates whether the runway is equipped with Runway End Identifier Lights (REIL) to provide rapid identification of the runway end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentApproachBaseEnd rdf:type rdf:Property ;
    rdfs:label 'Instrument Approach Base End' ;
    rdfs:comment 'The type of published instrument approach procedure available for the base end of the runway.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentApproachReciprocalEnd rdf:type rdf:Property ;
    rdfs:label 'Instrument Approach Reciprocal End' ;
    rdfs:comment 'The type of published instrument approach procedure available for the reciprocal end of the runway.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ilsCategoryBaseEnd rdf:type rdf:Property ;
    rdfs:label 'Ils Category Base End' ;
    rdfs:comment 'The precision approach category of the ILS system at the base end, indicating minimum visibility and decision height capabilities.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ilsCategoryReciprocalEnd rdf:type rdf:Property ;
    rdfs:label 'Ils Category Reciprocal End' ;
    rdfs:comment 'The precision approach category of the ILS system at the reciprocal end, indicating minimum visibility and decision height capabilities.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visibilityValueBaseEndFt rdf:type rdf:Property ;
    rdfs:label 'Visibility Value Base End Ft' ;
    rdfs:comment 'The minimum visibility in feet required for operations at the base end under instrument meteorological conditions.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:visibilityValueReciprocalEndFt rdf:type rdf:Property ;
    rdfs:label 'Visibility Value Reciprocal End Ft' ;
    rdfs:comment 'The minimum visibility in feet required for operations at the reciprocal end under instrument meteorological conditions.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decisionHeightBaseEndFt rdf:type rdf:Property ;
    rdfs:label 'Decision Height Base End Ft' ;
    rdfs:comment 'The decision height for precision approaches at the base end, measured in feet above ground level.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decisionHeightReciprocalEndFt rdf:type rdf:Property ;
    rdfs:label 'Decision Height Reciprocal End Ft' ;
    rdfs:comment 'The decision height for precision approaches at the reciprocal end, measured in feet above ground level.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protectionZoneBaseEndAcres rdf:type rdf:Property ;
    rdfs:label 'Protection Zone Base End Acres' ;
    rdfs:comment 'The area of the Runway Protection Zone at the base end, measured in acres, which is a trapezoidal area intended to enhance safety.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protectionZoneReciprocalEndAcres rdf:type rdf:Property ;
    rdfs:label 'Protection Zone Reciprocal End Acres' ;
    rdfs:comment 'The area of the Runway Protection Zone at the reciprocal end, measured in acres, which is a trapezoidal area intended to enhance safety.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:objectFreeAreaWidthFt rdf:type rdf:Property ;
    rdfs:label 'Object Free Area Width Ft' ;
    rdfs:comment 'The width of the Object Free Area centered on the runway, which must be clear of objects that could endanger aircraft.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyAreaWidthFt rdf:type rdf:Property ;
    rdfs:label 'Safety Area Width Ft' ;
    rdfs:comment 'The width of the Runway Safety Area, a defined surface surrounding the runway prepared to reduce risk of damage to aircraft in case of undershoot, overshoot, or excursion.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyAreaLengthBaseEndFt rdf:type rdf:Property ;
    rdfs:label 'Safety Area Length Base End Ft' ;
    rdfs:comment 'The length of the Runway Safety Area extending beyond the base end threshold.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyAreaLengthReciprocalEndFt rdf:type rdf:Property ;
    rdfs:label 'Safety Area Length Reciprocal End Ft' ;
    rdfs:comment 'The length of the Runway Safety Area extending beyond the reciprocal end threshold.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blastPadBaseEndLengthFt rdf:type rdf:Property ;
    rdfs:label 'Blast Pad Base End Length Ft' ;
    rdfs:comment 'The length of the blast pad (also called stopway or overrun) at the base end, designed to prevent erosion from jet blast.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blastPadReciprocalEndLengthFt rdf:type rdf:Property ;
    rdfs:label 'Blast Pad Reciprocal End Length Ft' ;
    rdfs:comment 'The length of the blast pad (also called stopway or overrun) at the reciprocal end, designed to prevent erosion from jet blast.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceToraBaseEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Tora Base End Ft' ;
    rdfs:comment 'The length of runway declared available and suitable for the ground run of an aircraft taking off from the base end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceToraReciprocalEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Tora Reciprocal End Ft' ;
    rdfs:comment 'The length of runway declared available and suitable for the ground run of an aircraft taking off from the reciprocal end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceTodaBaseEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Toda Base End Ft' ;
    rdfs:comment 'The length of the take-off run available plus the length of the clearway, if provided, from the base end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceTodaReciprocalEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Toda Reciprocal End Ft' ;
    rdfs:comment 'The length of the take-off run available plus the length of the clearway, if provided, from the reciprocal end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceAsdaBaseEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Asda Base End Ft' ;
    rdfs:comment 'The length of the take-off run available plus the length of the stopway, if provided, from the base end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceAsdaReciprocalEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Asda Reciprocal End Ft' ;
    rdfs:comment 'The length of the take-off run available plus the length of the stopway, if provided, from the reciprocal end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceLdaBaseEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Lda Base End Ft' ;
    rdfs:comment 'The length of runway declared available and suitable for landing from the base end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declaredDistanceLdaReciprocalEndFt rdf:type rdf:Property ;
    rdfs:label 'Declared Distance Lda Reciprocal End Ft' ;
    rdfs:comment 'The length of runway declared available and suitable for landing from the reciprocal end.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weightBearingCapacitySingleWheelLbs rdf:type rdf:Property ;
    rdfs:label 'Weight Bearing Capacity Single Wheel Lbs' ;
    rdfs:comment 'The maximum weight in pounds that the runway pavement can support for aircraft with single wheel landing gear configuration.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weightBearingCapacityDualWheelLbs rdf:type rdf:Property ;
    rdfs:label 'Weight Bearing Capacity Dual Wheel Lbs' ;
    rdfs:comment 'The maximum weight in pounds that the runway pavement can support for aircraft with dual wheel landing gear configuration.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weightBearingCapacityDualTandemLbs rdf:type rdf:Property ;
    rdfs:label 'Weight Bearing Capacity Dual Tandem Lbs' ;
    rdfs:comment 'The maximum weight in pounds that the runway pavement can support for aircraft with dual tandem landing gear configuration.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closureStartDate rdf:type rdf:Property ;
    rdfs:label 'Closure Start Date' ;
    rdfs:comment 'The date when the runway closure or restriction period begins, formatted as yyyy-MM-dd.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closureEndDate rdf:type rdf:Property ;
    rdfs:label 'Closure End Date' ;
    rdfs:comment 'The anticipated date when the runway closure or restriction period ends, formatted as yyyy-MM-dd.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastMajorRehabilitationYear rdf:type rdf:Property ;
    rdfs:label 'Last Major Rehabilitation Year' ;
    rdfs:comment 'The year when the runway last underwent major rehabilitation or reconstruction work.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:faaAirportReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Faa Airport Reference Code' ;
    rdfs:comment 'The FAA Airport Reference Code indicating the design aircraft category and approach speed (e.g., B-II, C-III, D-V).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designAircraftType rdf:type rdf:Property ;
    rdfs:label 'Design Aircraft Type' ;
    rdfs:comment 'The specific aircraft type or family that the runway was designed to accommodate (e.g., Boeing 737, Cessna 172).' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalAircraftWingspanFt rdf:type rdf:Property ;
    rdfs:label 'Critical Aircraft Wingspan Ft' ;
    rdfs:comment 'The wingspan of the critical design aircraft that determines runway and taxiway separation standards.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frictionCoefficient rdf:type rdf:Property ;
    rdfs:label 'Friction Coefficient' ;
    rdfs:comment 'The measured friction coefficient of the runway surface, indicating skid resistance and braking performance.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:snowRemovalEquipmentAvailable rdf:type rdf:Property ;
    rdfs:label 'Snow Removal Equipment Available' ;
    rdfs:comment 'Indicates whether dedicated snow removal equipment is available for this runway.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deicingCapability rdf:type rdf:Property ;
    rdfs:label 'Deicing Capability' ;
    rdfs:comment 'Indicates whether the runway has deicing or anti-icing treatment capability.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wildlifeHazardMitigation rdf:type rdf:Property ;
    rdfs:label 'Wildlife Hazard Mitigation' ;
    rdfs:comment 'Indicates whether a wildlife hazard mitigation program is in place for this runway.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noiseAbatementProcedure rdf:type rdf:Property ;
    rdfs:label 'Noise Abatement Procedure' ;
    rdfs:comment 'Indicates whether noise abatement procedures are established for operations on this runway.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:obstructionClearanceCompliant rdf:type rdf:Property ;
    rdfs:label 'Obstruction Clearance Compliant' ;
    rdfs:comment 'Indicates whether the runway meets FAA obstruction clearance standards for approach and departure surfaces.' ;
    rdfs:domain ind:Runway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flightPlanId rdf:type rdf:Property ;
    rdfs:label 'Flight Plan Id' ;
    rdfs:comment 'Unique identifier for the submitted flight plan record.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:faaFlightPlanNumber rdf:type rdf:Property ;
    rdfs:label 'Faa Flight Plan Number' ;
    rdfs:comment 'Official FAA-assigned flight plan number used for tracking and coordination with air traffic control.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aircraftRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Aircraft Registration Number' ;
    rdfs:comment 'FAA-issued aircraft registration number (tail number) identifying the specific aircraft.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aircraftCategory rdf:type rdf:Property ;
    rdfs:label 'Aircraft Category' ;
    rdfs:comment 'Classification of aircraft by propulsion and design type.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flightRules rdf:type rdf:Property ;
    rdfs:label 'Flight Rules' ;
    rdfs:comment 'Type of flight rules under which the flight will operate: IFR (Instrument Flight Rules), VFR (Visual Flight Rules), DVFR (Defense Visual Flight Rules), or SVFR (Special Visual Flight Rules).' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departureAirportCode rdf:type rdf:Property ;
    rdfs:label 'Departure Airport Code' ;
    rdfs:comment 'ICAO or FAA airport identifier code for the departure airport.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departureAirportName rdf:type rdf:Property ;
    rdfs:label 'Departure Airport Name' ;
    rdfs:comment 'Full name of the departure airport facility.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationAirportCode rdf:type rdf:Property ;
    rdfs:label 'Destination Airport Code' ;
    rdfs:comment 'ICAO or FAA airport identifier code for the destination airport.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateAirportCode1 rdf:type rdf:Property ;
    rdfs:label 'Alternate Airport Code 1' ;
    rdfs:comment 'ICAO or FAA airport identifier code for the primary alternate airport in case destination is unavailable.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateAirportCode2 rdf:type rdf:Property ;
    rdfs:label 'Alternate Airport Code 2' ;
    rdfs:comment 'ICAO or FAA airport identifier code for the secondary alternate airport.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeDescription rdf:type rdf:Property ;
    rdfs:label 'Route Description' ;
    rdfs:comment 'Detailed textual description of the planned flight route including waypoints, airways, and navigation fixes.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cruiseAltitudeFeet rdf:type rdf:Property ;
    rdfs:label 'Cruise Altitude Feet' ;
    rdfs:comment 'Planned cruising altitude for the flight measured in feet above mean sea level.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedFlightTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Flight Time Minutes' ;
    rdfs:comment 'Estimated total flight time from departure to arrival measured in minutes.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fuelOnBoardHours rdf:type rdf:Property ;
    rdfs:label 'Fuel On Board Hours' ;
    rdfs:comment 'Total fuel available on the aircraft expressed in hours of flight time at cruise consumption rate.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelOnBoardGallons rdf:type rdf:Property ;
    rdfs:label 'Fuel On Board Gallons' ;
    rdfs:comment 'Total fuel quantity loaded on the aircraft measured in gallons.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelOnBoardPounds rdf:type rdf:Property ;
    rdfs:label 'Fuel On Board Pounds' ;
    rdfs:comment 'Total fuel weight loaded on the aircraft measured in pounds.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfPassengers rdf:type rdf:Property ;
    rdfs:label 'Number Of Passengers' ;
    rdfs:comment 'Total count of passengers on board the aircraft for this flight.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfCrew rdf:type rdf:Property ;
    rdfs:label 'Number Of Crew' ;
    rdfs:comment 'Total count of crew members operating the aircraft for this flight.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pilotInCommandName rdf:type rdf:Property ;
    rdfs:label 'Pilot In Command Name' ;
    rdfs:comment 'Full name of the pilot in command responsible for the flight operation.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pilotInCommandLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Pilot In Command License Number' ;
    rdfs:comment 'FAA-issued pilot certificate number for the pilot in command.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pilotContactPhone rdf:type rdf:Property ;
    rdfs:label 'Pilot Contact Phone' ;
    rdfs:comment 'Primary contact phone number for the pilot in command.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aircraftColor rdf:type rdf:Property ;
    rdfs:label 'Aircraft Color' ;
    rdfs:comment 'Primary color or color scheme of the aircraft for visual identification purposes.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivalEquipment rdf:type rdf:Property ;
    rdfs:label 'Survival Equipment' ;
    rdfs:comment 'Description of survival and emergency equipment carried on the aircraft (e.g., life rafts, ELT, survival kits).' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyLocatorTransmitter rdf:type rdf:Property ;
    rdfs:label 'Emergency Locator Transmitter' ;
    rdfs:comment 'Indicates whether the aircraft is equipped with an emergency locator transmitter.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifeJacketsOnBoard rdf:type rdf:Property ;
    rdfs:label 'Life Jackets On Board' ;
    rdfs:comment 'Indicates whether life jackets are available on board for all occupants.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dinghiesCount rdf:type rdf:Property ;
    rdfs:label 'Dinghies Count' ;
    rdfs:comment 'Count of inflatable dinghies or life rafts carried on board the aircraft.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dinghiesCapacity rdf:type rdf:Property ;
    rdfs:label 'Dinghies Capacity' ;
    rdfs:comment 'Total passenger capacity of all dinghies or life rafts on board.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Filed Timestamp' ;
    rdfs:comment 'Date and time when the flight plan was officially filed with the FAA.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:activatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Activated Timestamp' ;
    rdfs:comment 'Date and time when the flight plan was activated by air traffic control.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Sequential number tracking amendments made to the original flight plan.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastAmendedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Amended Timestamp' ;
    rdfs:comment 'Date and time of the most recent amendment to the flight plan.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:amendmentDescription rdf:type rdf:Property ;
    rdfs:label 'Amendment Description' ;
    rdfs:comment 'Description of changes made in the most recent flight plan amendment.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:navigationEquipment rdf:type rdf:Property ;
    rdfs:label 'Navigation Equipment' ;
    rdfs:comment 'ICAO equipment codes indicating navigation and communication equipment on board (e.g., GPS, VOR, DME, ILS).' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationEquipment rdf:type rdf:Property ;
    rdfs:label 'Communication Equipment' ;
    rdfs:comment 'ICAO equipment codes indicating communication equipment capabilities on board.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveillanceEquipment rdf:type rdf:Property ;
    rdfs:label 'Surveillance Equipment' ;
    rdfs:comment 'ICAO equipment codes indicating surveillance equipment such as ADS-B, ADS-C, or Mode S.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceBasedNavigationCapable rdf:type rdf:Property ;
    rdfs:label 'Performance Based Navigation Capable' ;
    rdfs:comment 'Indicates whether the aircraft is equipped and certified for Performance Based Navigation procedures.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rvsmApproved rdf:type rdf:Property ;
    rdfs:label 'Rvsm Approved' ;
    rdfs:comment 'Indicates whether the aircraft is approved for operations in Reduced Vertical Separation Minimum airspace.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wakeTurbulenceCategory rdf:type rdf:Property ;
    rdfs:label 'Wake Turbulence Category' ;
    rdfs:comment 'FAA wake turbulence classification based on aircraft maximum takeoff weight.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aircraftWeightPounds rdf:type rdf:Property ;
    rdfs:label 'Aircraft Weight Pounds' ;
    rdfs:comment 'Total gross weight of the aircraft at departure including fuel, passengers, cargo, and equipment.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cargoWeightPounds rdf:type rdf:Property ;
    rdfs:label 'Cargo Weight Pounds' ;
    rdfs:comment 'Total weight of cargo and baggage loaded on the aircraft.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hazardousMaterialsOnBoard rdf:type rdf:Property ;
    rdfs:label 'Hazardous Materials On Board' ;
    rdfs:comment 'Indicates whether the aircraft is carrying hazardous materials requiring special handling.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatDescription rdf:type rdf:Property ;
    rdfs:label 'Hazmat Description' ;
    rdfs:comment 'Description of hazardous materials being transported including UN numbers and classifications.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialHandlingCodes rdf:type rdf:Property ;
    rdfs:label 'Special Handling Codes' ;
    rdfs:comment 'Codes indicating special handling requirements such as medical emergency, law enforcement, or VIP transport.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchAndRescueInfo rdf:type rdf:Property ;
    rdfs:label 'Search And Rescue Info' ;
    rdfs:comment 'Contact information and details for search and rescue coordination in case of emergency.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overwaterFlight rdf:type rdf:Property ;
    rdfs:label 'Overwater Flight' ;
    rdfs:comment 'Indicates whether the flight route includes extended overwater segments.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internationalFlight rdf:type rdf:Property ;
    rdfs:label 'International Flight' ;
    rdfs:comment 'Indicates whether the flight crosses international borders requiring customs and immigration procedures.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customsNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Customs Notification Required' ;
    rdfs:comment 'Indicates whether advance customs notification is required for this flight.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:departureCountryCode rdf:type rdf:Property ;
    rdfs:label 'Departure Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the departure airport location.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationCountryCode rdf:type rdf:Property ;
    rdfs:label 'Destination Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the destination airport location.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingOrganization rdf:type rdf:Property ;
    rdfs:label 'Filing Organization' ;
    rdfs:comment 'Name of the organization or operator that filed the flight plan.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Operator Contact Phone' ;
    rdfs:comment 'Primary contact phone number for the aircraft operator or flight coordinator.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorAddress rdf:type rdf:Property ;
    rdfs:label 'Operator Address' ;
    rdfs:comment 'Mailing address of the aircraft operator or registered owner.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeBaseAirportCode rdf:type rdf:Property ;
    rdfs:label 'Home Base Airport Code' ;
    rdfs:comment 'ICAO or FAA airport identifier code for the aircraft\'s home base or primary operating location.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditionsDeparture rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions Departure' ;
    rdfs:comment 'Weather category at departure airport: VFR (Visual Flight Rules), MVFR (Marginal VFR), IFR (Instrument Flight Rules), or LIFR (Low IFR).' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditionsDestination rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions Destination' ;
    rdfs:comment 'Weather category at destination airport: VFR, MVFR, IFR, or LIFR.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notamReferences rdf:type rdf:Property ;
    rdfs:label 'Notam References' ;
    rdfs:comment 'Reference numbers for relevant NOTAMs affecting the flight route or airports.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tfrApplicable rdf:type rdf:Property ;
    rdfs:label 'Tfr Applicable' ;
    rdfs:comment 'Indicates whether any Temporary Flight Restrictions apply to the planned route.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tfrAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Tfr Authorization Number' ;
    rdfs:comment 'Authorization number if special permission was granted to operate within a TFR area.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icaoFlightPlanFormat rdf:type rdf:Property ;
    rdfs:label 'Icao Flight Plan Format' ;
    rdfs:comment 'Indicates whether the flight plan was filed using ICAO standard format versus FAA domestic format.' ;
    rdfs:domain ind:FlightPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionRatingId rdf:type rdf:Property ;
    rdfs:label 'Condition Rating Id' ;
    rdfs:comment 'Unique identifier for the condition rating code. Primary key for the condition rating lookup table.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingCode rdf:type rdf:Property ;
    rdfs:label 'Rating Code' ;
    rdfs:comment 'Numeric or alphanumeric code representing the condition rating value (0-9 or N for Not Applicable) used in bridge inspection records to rate structural elements.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingValue rdf:type rdf:Property ;
    rdfs:label 'Rating Value' ;
    rdfs:comment 'Integer representation of the condition rating for computational and analytical purposes. Values range from 0 (failed condition) to 9 (excellent condition).' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingDescription rdf:type rdf:Property ;
    rdfs:label 'Rating Description' ;
    rdfs:comment 'Full textual description of the condition rating level, providing detailed explanation of the structural condition represented by the rating code.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingShortDescription rdf:type rdf:Property ;
    rdfs:label 'Rating Short Description' ;
    rdfs:comment 'Abbreviated or summary description of the condition rating for display in reports and user interfaces.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionState rdf:type rdf:Property ;
    rdfs:label 'Condition State' ;
    rdfs:comment 'Qualitative classification of the structural condition state corresponding to the numeric rating code.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableElementType rdf:type rdf:Property ;
    rdfs:label 'Applicable Element Type' ;
    rdfs:comment 'Type of bridge structural element to which this condition rating applies (deck, superstructure, substructure, culvert, channel, or all elements).' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nbiItemNumber rdf:type rdf:Property ;
    rdfs:label 'Nbi Item Number' ;
    rdfs:comment 'The NBI data item number(s) that use this condition rating code (e.g., Item 58 for Deck, Item 59 for Superstructure, Item 60 for Substructure, Item 62 for Culvert).' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresActionFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Action Flag' ;
    rdfs:comment 'Boolean indicator whether this condition rating level triggers required maintenance, rehabilitation, or replacement action.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actionPriorityLevel rdf:type rdf:Property ;
    rdfs:label 'Action Priority Level' ;
    rdfs:comment 'Priority level for maintenance or rehabilitation action associated with this condition rating (none, routine, priority, urgent, emergency).' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadPostingThresholdFlag rdf:type rdf:Property ;
    rdfs:label 'Load Posting Threshold Flag' ;
    rdfs:comment 'Indicates whether this condition rating meets or falls below the threshold that may require bridge load posting or weight restrictions.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closureThresholdFlag rdf:type rdf:Property ;
    rdfs:label 'Closure Threshold Flag' ;
    rdfs:comment 'Indicates whether this condition rating meets or falls below the threshold that may require bridge closure for safety reasons.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sufficiencyRatingImpact rdf:type rdf:Property ;
    rdfs:label 'Sufficiency Rating Impact' ;
    rdfs:comment 'Qualitative assessment of how this condition rating level impacts the overall bridge sufficiency rating calculation.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionFrequencyImpact rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Impact' ;
    rdfs:comment 'Description of how this condition rating affects the required bridge inspection frequency per NBIS standards.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Eligibility Flag' ;
    rdfs:comment 'Indicates whether bridges with this condition rating are eligible for federal rehabilitation or replacement funding programs.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bmsHealthIndexWeight rdf:type rdf:Property ;
    rdfs:label 'Bms Health Index Weight' ;
    rdfs:comment 'Numeric weight or factor used in BMS health index calculations for bridges with this condition rating.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deteriorationRateFactor rdf:type rdf:Property ;
    rdfs:label 'Deterioration Rate Factor' ;
    rdfs:comment 'Factor representing the expected rate of structural deterioration for elements at this condition rating level, used in predictive modeling.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceLifeImpactYears rdf:type rdf:Property ;
    rdfs:label 'Service Life Impact Years' ;
    rdfs:comment 'Estimated remaining service life in years for bridge elements at this condition rating level before requiring major intervention.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costMultiplier rdf:type rdf:Property ;
    rdfs:label 'Cost Multiplier' ;
    rdfs:comment 'Multiplier factor applied to base rehabilitation costs for bridges at this condition rating level, reflecting increased complexity and cost of repair.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aashtoElementConditionState rdf:type rdf:Property ;
    rdfs:label 'Aashto Element Condition State' ;
    rdfs:comment 'Corresponding AASHTO element-level condition state code (CS1-CS5) for element-level bridge inspection methodology.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectClassification rdf:type rdf:Property ;
    rdfs:label 'Defect Classification' ;
    rdfs:comment 'Classification of the severity of structural defects typically associated with this condition rating level.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialLossPercentageRange rdf:type rdf:Property ;
    rdfs:label 'Material Loss Percentage Range' ;
    rdfs:comment 'Typical range of material section loss (as percentage) associated with this condition rating level for steel and concrete elements.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:structuralCapacityImpact rdf:type rdf:Property ;
    rdfs:label 'Structural Capacity Impact' ;
    rdfs:comment 'Qualitative assessment of the impact this condition rating has on the structural load-carrying capacity of the bridge element.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicSafetyRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Public Safety Risk Level' ;
    rdfs:comment 'Risk level to public safety associated with bridge elements at this condition rating, used for prioritization and resource allocation.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingCategory rdf:type rdf:Property ;
    rdfs:label 'Reporting Category' ;
    rdfs:comment 'Simplified three-tier reporting category (Good, Fair, Poor) used for federal performance measure reporting and FHWA submissions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:map21PerformanceFlag rdf:type rdf:Property ;
    rdfs:label 'Map21 Performance Flag' ;
    rdfs:comment 'Indicates whether this condition rating is used in MAP-21 and subsequent federal transportation performance measure calculations.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByRatingCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Rating Code' ;
    rdfs:comment 'The condition rating code that replaced this code if it has been superseded or retired.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageNotes rdf:type rdf:Property ;
    rdfs:label 'Usage Notes' ;
    rdfs:comment 'Additional notes, guidelines, or instructions for bridge inspectors on proper application and interpretation of this condition rating code.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorGuidance rdf:type rdf:Property ;
    rdfs:label 'Inspector Guidance' ;
    rdfs:comment 'Detailed field guidance for bridge inspectors describing observable conditions and criteria for assigning this rating during inspections.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photographicExampleReference rdf:type rdf:Property ;
    rdfs:label 'Photographic Example Reference' ;
    rdfs:comment 'Reference identifier or URL to photographic examples illustrating typical conditions associated with this rating code.' ;
    rdfs:domain ind:ConditionRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routingResultId rdf:type rdf:Property ;
    rdfs:label 'Routing Result Id' ;
    rdfs:comment 'Unique identifier for the routing calculation result record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RoutingResult .

ind:calculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Timestamp' ;
    rdfs:comment 'Date and time when the routing calculation was performed.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:geocodeRequestId rdf:type rdf:Property ;
    rdfs:label 'Geocode Request Id' ;
    rdfs:comment 'Unique identifier for the routing request that generated this result.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeocodeRequest .

ind:originLatitude rdf:type rdf:Property ;
    rdfs:label 'Origin Latitude' ;
    rdfs:comment 'Latitude coordinate of the routing origin point in decimal degrees.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originLongitude rdf:type rdf:Property ;
    rdfs:label 'Origin Longitude' ;
    rdfs:comment 'Longitude coordinate of the routing origin point in decimal degrees.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originAddress rdf:type rdf:Property ;
    rdfs:label 'Origin Address' ;
    rdfs:comment 'Street address or location description of the routing origin.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originCounty rdf:type rdf:Property ;
    rdfs:label 'Origin County' ;
    rdfs:comment 'North Carolina county where the routing origin is located.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originMunicipality rdf:type rdf:Property ;
    rdfs:label 'Origin Municipality' ;
    rdfs:comment 'City or town where the routing origin is located.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationLatitude rdf:type rdf:Property ;
    rdfs:label 'Destination Latitude' ;
    rdfs:comment 'Latitude coordinate of the routing destination point in decimal degrees.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:destinationLongitude rdf:type rdf:Property ;
    rdfs:label 'Destination Longitude' ;
    rdfs:comment 'Longitude coordinate of the routing destination point in decimal degrees.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:destinationAddress rdf:type rdf:Property ;
    rdfs:label 'Destination Address' ;
    rdfs:comment 'Street address or location description of the routing destination.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationCounty rdf:type rdf:Property ;
    rdfs:label 'Destination County' ;
    rdfs:comment 'North Carolina county where the routing destination is located.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationMunicipality rdf:type rdf:Property ;
    rdfs:label 'Destination Municipality' ;
    rdfs:comment 'City or town where the routing destination is located.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:travelMode rdf:type rdf:Property ;
    rdfs:label 'Travel Mode' ;
    rdfs:comment 'Mode of transportation used for the routing calculation.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeGeometryWkt rdf:type rdf:Property ;
    rdfs:label 'Route Geometry Wkt' ;
    rdfs:comment 'Well-Known Text representation of the route geometry linestring.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeDistanceKilometers rdf:type rdf:Property ;
    rdfs:label 'Route Distance Kilometers' ;
    rdfs:comment 'Total distance of the calculated route measured in kilometers.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:travelTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Travel Time Minutes' ;
    rdfs:comment 'Estimated travel time for the route in minutes under normal traffic conditions.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:travelTimeWithTrafficMinutes rdf:type rdf:Property ;
    rdfs:label 'Travel Time With Traffic Minutes' ;
    rdfs:comment 'Estimated travel time for the route in minutes accounting for current traffic conditions.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tollCostUsd rdf:type rdf:Property ;
    rdfs:label 'Toll Cost Usd' ;
    rdfs:comment 'Total estimated toll costs along the route in US dollars.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:includesTollRoadsFlag rdf:type rdf:Property ;
    rdfs:label 'Includes Toll Roads Flag' ;
    rdfs:comment 'Indicates whether the route includes any toll roads.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesFerryFlag rdf:type rdf:Property ;
    rdfs:label 'Includes Ferry Flag' ;
    rdfs:comment 'Indicates whether the route includes ferry crossings.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ferryCrossingCount rdf:type rdf:Property ;
    rdfs:label 'Ferry Crossing Count' ;
    rdfs:comment 'Number of ferry crossings included in the route.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:includesUnpavedRoadsFlag rdf:type rdf:Property ;
    rdfs:label 'Includes Unpaved Roads Flag' ;
    rdfs:comment 'Indicates whether the route includes unpaved or gravel roads.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictionApplied rdf:type rdf:Property ;
    rdfs:label 'Restriction Applied' ;
    rdfs:comment 'Description of any routing restrictions or constraints applied to the calculation.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleHeightRestrictionFeet rdf:type rdf:Property ;
    rdfs:label 'Vehicle Height Restriction Feet' ;
    rdfs:comment 'Maximum vehicle height restriction applied to the routing calculation in feet.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleWeightRestrictionTons rdf:type rdf:Property ;
    rdfs:label 'Vehicle Weight Restriction Tons' ;
    rdfs:comment 'Maximum vehicle weight restriction applied to the routing calculation in tons.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleLengthRestrictionFeet rdf:type rdf:Property ;
    rdfs:label 'Vehicle Length Restriction Feet' ;
    rdfs:comment 'Maximum vehicle length restriction applied to the routing calculation in feet.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:avoidHighwaysFlag rdf:type rdf:Property ;
    rdfs:label 'Avoid Highways Flag' ;
    rdfs:comment 'Indicates whether the routing calculation was configured to avoid highways.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:avoidTollsFlag rdf:type rdf:Property ;
    rdfs:label 'Avoid Tolls Flag' ;
    rdfs:comment 'Indicates whether the routing calculation was configured to avoid toll roads.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calculationStatus rdf:type rdf:Property ;
    rdfs:label 'Calculation Status' ;
    rdfs:comment 'Status of the routing calculation execution.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorMessage rdf:type rdf:Property ;
    rdfs:label 'Error Message' ;
    rdfs:comment 'Error message or description if the routing calculation failed or encountered issues.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Calculation Duration Seconds' ;
    rdfs:comment 'Time taken to complete the routing calculation in seconds.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waypointCount rdf:type rdf:Property ;
    rdfs:label 'Waypoint Count' ;
    rdfs:comment 'Number of intermediate waypoints included in the routing calculation.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:turnCount rdf:type rdf:Property ;
    rdfs:label 'Turn Count' ;
    rdfs:comment 'Total number of turns or maneuvers in the calculated route.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:highwayMiles rdf:type rdf:Property ;
    rdfs:label 'Highway Miles' ;
    rdfs:comment 'Total distance traveled on highway facilities in miles.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localRoadMiles rdf:type rdf:Property ;
    rdfs:label 'Local Road Miles' ;
    rdfs:comment 'Total distance traveled on local roads in miles.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interstateMiles rdf:type rdf:Property ;
    rdfs:label 'Interstate Miles' ;
    rdfs:comment 'Total distance traveled on interstate highways in miles.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nhsMiles rdf:type rdf:Property ;
    rdfs:label 'Nhs Miles' ;
    rdfs:comment 'Total distance traveled on National Highway System routes in miles.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeOfDay rdf:type rdf:Property ;
    rdfs:label 'Time Of Day' ;
    rdfs:comment 'Time period classification when the routing calculation was performed.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentCount rdf:type rdf:Property ;
    rdfs:label 'Incident Count' ;
    rdfs:comment 'Number of traffic incidents along the route at the time of calculation.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:constructionZoneCount rdf:type rdf:Property ;
    rdfs:label 'Construction Zone Count' ;
    rdfs:comment 'Number of active construction zones along the route.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:elevationGainFeet rdf:type rdf:Property ;
    rdfs:label 'Elevation Gain Feet' ;
    rdfs:comment 'Total elevation gain along the route in feet.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elevationLossFeet rdf:type rdf:Property ;
    rdfs:label 'Elevation Loss Feet' ;
    rdfs:comment 'Total elevation loss along the route in feet.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Maximum Elevation Feet' ;
    rdfs:comment 'Highest elevation point along the route in feet above sea level.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Minimum Elevation Feet' ;
    rdfs:comment 'Lowest elevation point along the route in feet above sea level.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonEmissionsKg rdf:type rdf:Property ;
    rdfs:label 'Carbon Emissions Kg' ;
    rdfs:comment 'Estimated carbon dioxide emissions for the route in kilograms.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:routeConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Route Confidence Score' ;
    rdfs:comment 'Confidence score for the routing calculation accuracy on a scale of 0-100.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:routingEngineVersion rdf:type rdf:Property ;
    rdfs:label 'Routing Engine Version' ;
    rdfs:comment 'Version of the routing calculation engine used.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkDatasetVersion rdf:type rdf:Property ;
    rdfs:label 'Network Dataset Version' ;
    rdfs:comment 'Version of the transportation network dataset used for routing.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationName rdf:type rdf:Property ;
    rdfs:label 'Application Name' ;
    rdfs:comment 'Name of the application or system that initiated the routing request.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionId rdf:type rdf:Property ;
    rdfs:label 'Session Id' ;
    rdfs:comment 'Session identifier for the user or application session that generated the routing request.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUnit rdf:type rdf:Property ;
    rdfs:label 'Business Unit' ;
    rdfs:comment 'NCDOT business unit or division that requested the routing calculation.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purposeCode rdf:type rdf:Property ;
    rdfs:label 'Purpose Code' ;
    rdfs:comment 'Business purpose or use case for the routing calculation.' ;
    rdfs:domain ind:RoutingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spatialReferenceId rdf:type rdf:Property ;
    rdfs:label 'Spatial Reference Id' ;
    rdfs:comment 'Unique identifier for the spatial reference system record. Primary key for the spatial reference table.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SpatialReference .

ind:epsgCode rdf:type rdf:Property ;
    rdfs:label 'Epsg Code' ;
    rdfs:comment 'Standardized numeric code identifying the coordinate reference system as defined by the EPSG Geodetic Parameter Dataset. Primary identifier used across GIS applications.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:srid rdf:type rdf:Property ;
    rdfs:label 'Srid' ;
    rdfs:comment 'Spatial Reference System Identifier used in spatial databases to uniquely identify coordinate systems. Often synonymous with EPSG code.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authority rdf:type rdf:Property ;
    rdfs:label 'Authority' ;
    rdfs:comment 'Organization or body that defines and maintains the spatial reference system standard.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityCode rdf:type rdf:Property ;
    rdfs:label 'Authority Code' ;
    rdfs:comment 'Code assigned by the authority organization to uniquely identify this spatial reference system within their namespace.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectionName rdf:type rdf:Property ;
    rdfs:label 'Projection Name' ;
    rdfs:comment 'Name of the mathematical projection method used to transform coordinates from the ellipsoid to a planar surface. Applicable only to projected coordinate systems.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datumName rdf:type rdf:Property ;
    rdfs:label 'Datum Name' ;
    rdfs:comment 'Name of the geodetic datum defining the reference ellipsoid and its relationship to the Earth. Examples include NAD83, WGS84, NAD27.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ellipsoidName rdf:type rdf:Property ;
    rdfs:label 'Ellipsoid Name' ;
    rdfs:comment 'Name of the mathematical ellipsoid model used to approximate the shape of the Earth for this coordinate system.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:semiMajorAxis rdf:type rdf:Property ;
    rdfs:label 'Semi Major Axis' ;
    rdfs:comment 'Length of the semi-major axis (equatorial radius) of the reference ellipsoid, measured in meters.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inverseFlattening rdf:type rdf:Property ;
    rdfs:label 'Inverse Flattening' ;
    rdfs:comment 'Inverse of the flattening parameter of the reference ellipsoid, defining the ellipsoid\'s shape. Calculated as a/(a-b) where a is semi-major axis and b is semi-minor axis.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primeMeridianName rdf:type rdf:Property ;
    rdfs:label 'Prime Meridian Name' ;
    rdfs:comment 'Name of the prime meridian (zero longitude reference) used by this coordinate system. Most commonly Greenwich.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primeMeridianOffset rdf:type rdf:Property ;
    rdfs:label 'Prime Meridian Offset' ;
    rdfs:comment 'Angular offset in degrees of the prime meridian from the Greenwich meridian. Zero for Greenwich-based systems.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:linearUnitName rdf:type rdf:Property ;
    rdfs:label 'Linear Unit Name' ;
    rdfs:comment 'Name of the linear unit of measurement used for coordinate values in projected coordinate systems.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:linearUnitConversionFactor rdf:type rdf:Property ;
    rdfs:label 'Linear Unit Conversion Factor' ;
    rdfs:comment 'Conversion factor to transform the linear unit to meters. For example, US survey foot = 0.3048006096012192 meters.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:angularUnitName rdf:type rdf:Property ;
    rdfs:label 'Angular Unit Name' ;
    rdfs:comment 'Name of the angular unit of measurement used for coordinate values in geographic coordinate systems.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:angularUnitConversionFactor rdf:type rdf:Property ;
    rdfs:label 'Angular Unit Conversion Factor' ;
    rdfs:comment 'Conversion factor to transform the angular unit to radians. For example, degree = 0.0174532925199433 radians.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:falseEasting rdf:type rdf:Property ;
    rdfs:label 'False Easting' ;
    rdfs:comment 'Value added to all x-coordinates in a projected coordinate system to ensure all coordinates are positive. Measured in the linear unit of the projection.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:falseNorthing rdf:type rdf:Property ;
    rdfs:label 'False Northing' ;
    rdfs:comment 'Value added to all y-coordinates in a projected coordinate system to ensure all coordinates are positive. Measured in the linear unit of the projection.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:centralMeridian rdf:type rdf:Property ;
    rdfs:label 'Central Meridian' ;
    rdfs:comment 'Longitude of the central meridian for the map projection, measured in angular units. Defines the line of zero distortion for many projections.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardParallel1 rdf:type rdf:Property ;
    rdfs:label 'Standard Parallel 1' ;
    rdfs:comment 'Latitude of the first standard parallel for conic projections, measured in angular units. Defines a line of true scale.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardParallel2 rdf:type rdf:Property ;
    rdfs:label 'Standard Parallel 2' ;
    rdfs:comment 'Latitude of the second standard parallel for conic projections, measured in angular units. Defines a second line of true scale.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:latitudeOfOrigin rdf:type rdf:Property ;
    rdfs:label 'Latitude Of Origin' ;
    rdfs:comment 'Latitude at which the projection plane intersects the ellipsoid, measured in angular units. Origin point for coordinate calculations.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scaleFactor rdf:type rdf:Property ;
    rdfs:label 'Scale Factor' ;
    rdfs:comment 'Scale reduction factor applied at the central meridian or origin to minimize overall distortion across the projection zone.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wkt rdf:type rdf:Property ;
    rdfs:label 'Wkt' ;
    rdfs:comment 'Complete Well-Known Text string representation of the coordinate reference system including all parameters and definitions.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proj4Text rdf:type rdf:Property ;
    rdfs:label 'Proj4 Text' ;
    rdfs:comment 'PROJ.4 format string defining the coordinate reference system parameters for use with PROJ library and compatible software.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esriWkt rdf:type rdf:Property ;
    rdfs:label 'Esri Wkt' ;
    rdfs:comment 'ESRI-specific Well-Known Text representation of the coordinate reference system, which may differ from OGC WKT in syntax and parameter names.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areaOfUseDescription rdf:type rdf:Property ;
    rdfs:label 'Area Of Use Description' ;
    rdfs:comment 'Textual description of the geographic area or region where this coordinate reference system is intended to be used and provides accurate results.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areaOfUseWestBound rdf:type rdf:Property ;
    rdfs:label 'Area Of Use West Bound' ;
    rdfs:comment 'Western longitude boundary of the area where this coordinate reference system is valid, measured in decimal degrees.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaOfUseEastBound rdf:type rdf:Property ;
    rdfs:label 'Area Of Use East Bound' ;
    rdfs:comment 'Eastern longitude boundary of the area where this coordinate reference system is valid, measured in decimal degrees.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaOfUseNorthBound rdf:type rdf:Property ;
    rdfs:label 'Area Of Use North Bound' ;
    rdfs:comment 'Northern latitude boundary of the area where this coordinate reference system is valid, measured in decimal degrees.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaOfUseSouthBound rdf:type rdf:Property ;
    rdfs:label 'Area Of Use South Bound' ;
    rdfs:comment 'Southern latitude boundary of the area where this coordinate reference system is valid, measured in decimal degrees.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'Description of the intended application domain and use cases for this coordinate reference system, such as large-scale mapping, engineering surveys, or navigation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Accuracy Meters' ;
    rdfs:comment 'Estimated positional accuracy or precision of coordinates expressed in this reference system, measured in meters.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deprecatedFlag rdf:type rdf:Property ;
    rdfs:label 'Deprecated Flag' ;
    rdfs:comment 'Indicates whether this spatial reference system has been deprecated or superseded by a newer definition. True if deprecated, false if current.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deprecatedDate rdf:type rdf:Property ;
    rdfs:label 'Deprecated Date' ;
    rdfs:comment 'Date on which this spatial reference system was officially deprecated or superseded, formatted as yyyy-MM-dd.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersededByEpsgCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Epsg Code' ;
    rdfs:comment 'EPSG code of the spatial reference system that supersedes or replaces this deprecated system.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:informationSource rdf:type rdf:Property ;
    rdfs:label 'Information Source' ;
    rdfs:comment 'Citation or reference to the authoritative source document or organization that defines this spatial reference system.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionDate rdf:type rdf:Property ;
    rdfs:label 'Revision Date' ;
    rdfs:comment 'Date of the most recent revision or update to the spatial reference system definition, formatted as yyyy-MM-dd.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ncdotUsageFlag rdf:type rdf:Property ;
    rdfs:label 'Ncdot Usage Flag' ;
    rdfs:comment 'Indicates whether this spatial reference system is actively used in NCDOT GIS operations and data products. True if used by NCDOT, false otherwise.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncdotPrimaryFlag rdf:type rdf:Property ;
    rdfs:label 'Ncdot Primary Flag' ;
    rdfs:comment 'Indicates whether this is a primary or standard coordinate system for NCDOT statewide operations. True if primary standard, false otherwise.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statePlaneZone rdf:type rdf:Property ;
    rdfs:label 'State Plane Zone' ;
    rdfs:comment 'Identifier for the State Plane Coordinate System zone applicable to North Carolina, if this spatial reference represents a state plane system.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utmZone rdf:type rdf:Property ;
    rdfs:label 'Utm Zone' ;
    rdfs:comment 'UTM zone identifier if this spatial reference represents a UTM coordinate system. Format includes zone number and hemisphere (e.g., 17N, 18S).' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verticalDatumName rdf:type rdf:Property ;
    rdfs:label 'Vertical Datum Name' ;
    rdfs:comment 'Name of the vertical datum or reference surface used for elevation measurements, such as NAVD88 or NGVD29.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinateSystemType rdf:type rdf:Property ;
    rdfs:label 'Coordinate System Type' ;
    rdfs:comment 'Mathematical type of the coordinate system defining how coordinates are structured and interpreted.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:axisCount rdf:type rdf:Property ;
    rdfs:label 'Axis Count' ;
    rdfs:comment 'Number of coordinate axes in the coordinate system. Typically 2 for 2D systems, 3 for 3D systems including elevation.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:axis1Name rdf:type rdf:Property ;
    rdfs:label 'Axis 1 Name' ;
    rdfs:comment 'Name of the first coordinate axis, such as Easting, Longitude, or X.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:axis1Orientation rdf:type rdf:Property ;
    rdfs:label 'Axis 1 Orientation' ;
    rdfs:comment 'Direction or orientation of the first coordinate axis in the coordinate system.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:axis2Name rdf:type rdf:Property ;
    rdfs:label 'Axis 2 Name' ;
    rdfs:comment 'Name of the second coordinate axis, such as Northing, Latitude, or Y.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:axis2Orientation rdf:type rdf:Property ;
    rdfs:label 'Axis 2 Orientation' ;
    rdfs:comment 'Direction or orientation of the second coordinate axis in the coordinate system.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:axis3Name rdf:type rdf:Property ;
    rdfs:label 'Axis 3 Name' ;
    rdfs:comment 'Name of the third coordinate axis for 3D systems, typically Elevation, Height, or Z.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:axis3Orientation rdf:type rdf:Property ;
    rdfs:label 'Axis 3 Orientation' ;
    rdfs:comment 'Direction or orientation of the third coordinate axis in 3D coordinate systems.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformationMethod rdf:type rdf:Property ;
    rdfs:label 'Transformation Method' ;
    rdfs:comment 'Name of the mathematical method or algorithm used to transform coordinates between this system and other reference systems.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformationAccuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Transformation Accuracy Meters' ;
    rdfs:comment 'Expected accuracy of coordinate transformations from this reference system to other systems, measured in meters.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arcgisCompatibleFlag rdf:type rdf:Property ;
    rdfs:label 'Arcgis Compatible Flag' ;
    rdfs:comment 'Indicates whether this spatial reference system is natively supported and compatible with ESRI ArcGIS Enterprise platform used by NCDOT.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ogcUrn rdf:type rdf:Property ;
    rdfs:label 'Ogc Urn' ;
    rdfs:comment 'OGC URN identifier for this coordinate reference system, used in web services and standards-compliant applications.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoCode rdf:type rdf:Property ;
    rdfs:label 'Iso Code' ;
    rdfs:comment 'ISO 19111 standard code or identifier for this coordinate reference system.' ;
    rdfs:domain ind:SpatialReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airlineId rdf:type rdf:Property ;
    rdfs:label 'Airline Id' ;
    rdfs:comment 'Unique identifier for the airline company. Primary key for the airline master data product.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Airline .

ind:tradeName rdf:type rdf:Property ;
    rdfs:label 'Trade Name' ;
    rdfs:comment 'Commercial operating name or brand name used by the airline for marketing and customer-facing operations. May differ from legal name.' ;
    rdfs:domain ind:Airline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingStatus rdf:type rdf:Property ;
    rdfs:label 'Operating Status' ;
    rdfs:comment 'Current operational status of the airline indicating whether it is actively operating flights or has ceased operations.' ;
    rdfs:domain ind:Airline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationStatus rdf:type rdf:Property ;
