    rdfs:comment 'NAIC risk-based capital factor applied to reserves and premiums for this line in RBC calculations.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statutoryAccountingLine rdf:type rdf:Property ;
    rdfs:label 'Statutory Accounting Line' ;
    rdfs:comment 'Statutory accounting line classification for annual statement reporting and reserve calculations.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCombinedRatioPct rdf:type rdf:Property ;
