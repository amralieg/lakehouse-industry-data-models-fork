ind:isPaid rdf:type rdf:Property ;
    rdfs:label 'Is Paid' ;
    rdfs:comment 'Indicates whether the leave is paid or unpaid.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:organizationalUnit rdf:type rdf:Property ;
    rdfs:label 'Organizational Unit' ;
    rdfs:comment 'Division or organizational unit where the employee is assigned (e.g., DOH, DMV, Ferry Division).' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
