    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioDescription rdf:type rdf:Property ;
    rdfs:label 'Scenario Description' ;
    rdfs:comment 'Detailed description of the planning scenario including assumptions about future conditions and investments.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:developer rdf:type rdf:Property ;
    rdfs:label 'Developer' ;
    rdfs:comment 'The consultant firm, agency staff, or organization that developed the transportation model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileLocation rdf:type rdf:Property ;
    rdfs:label 'File Location' ;
    rdfs:comment 'The file system path or repository location where the model files and data are stored.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Update Date' ;
    rdfs:comment 'The planned date for the next major update or recalibration of the transportation model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peerReviewCompleted rdf:type rdf:Property ;
    rdfs:label 'Peer Review Completed' ;
    rdfs:comment 'Indicates whether the model has undergone independent peer review by external experts.' ;
