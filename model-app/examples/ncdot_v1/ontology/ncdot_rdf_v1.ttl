    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationNumber rdf:type rdf:Property ;
    rdfs:label 'Registration Number' ;
    rdfs:comment 'Current registration number assigned to the vehicle in North Carolina.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationStatus rdf:type rdf:Property ;
    rdfs:label 'Registration Status' ;
    rdfs:comment 'Current status of the vehicle registration indicating whether the vehicle is legally authorized for road use.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Registration Effective Date' ;
    rdfs:comment 'Date when the current registration period began.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Expiration Date' ;
    rdfs:comment 'Date when the current registration expires and renewal is required.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationRenewalMonth rdf:type rdf:Property ;
    rdfs:label 'Registration Renewal Month' ;
    rdfs:comment 'Month (1-12) when annual registration renewal is due for this vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licensePlateNumber rdf:type rdf:Property ;
    rdfs:label 'License Plate Number' ;
    rdfs:comment 'Current license plate number displayed on the vehicle. Personally identifiable as it can be linked to the registered owner.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensePlateType rdf:type rdf:Property ;
    rdfs:label 'License Plate Type' ;
    rdfs:comment 'Category of license plate issued to the vehicle indicating special status or owner preference.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensePlateIssueDate rdf:type rdf:Property ;
    rdfs:label 'License Plate Issue Date' ;
    rdfs:comment 'Date when the current license plate was issued to this vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emissionsTestRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Emissions Test Required Flag' ;
    rdfs:comment 'Indicates whether the vehicle is subject to emissions testing based on model year, county of registration, and vehicle type.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emissionsTestStatus rdf:type rdf:Property ;
    rdfs:label 'Emissions Test Status' ;
    rdfs:comment 'Result of the most recent emissions test if applicable.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Insurance Company Code' ;
    rdfs:comment 'Code identifying the insurance company providing liability coverage for the vehicle as reported to DMV.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienHolderAddress rdf:type rdf:Property ;
    rdfs:label 'Lien Holder Address' ;
    rdfs:comment 'Mailing address of the lien holder for title and lien release correspondence.' ;
