    rdfs:comment 'Minimum education level required for the position as specified in the position description and classification standards.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredEducationLevel rdf:type rdf:Property ;
    rdfs:label 'Preferred Education Level' ;
    rdfs:comment 'Preferred education level for the position that exceeds the minimum requirement.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumExperienceYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Experience Years' ;
    rdfs:comment 'Minimum number of years of relevant work experience required for the position.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preferredExperienceYears rdf:type rdf:Property ;
    rdfs:label 'Preferred Experience Years' ;
    rdfs:comment 'Preferred number of years of relevant work experience for the position that exceeds the minimum requirement.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:professionalCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Professional Certification Required' ;
    rdfs:comment 'Indicates whether a professional certification or license is required for the position (e.g., PE license for engineers, CPA for accountants).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unionEligible rdf:type rdf:Property ;
    rdfs:label 'Union Eligible' ;
    rdfs:comment 'Indicates whether the position is eligible for union membership or collective bargaining representation.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bargainingUnit rdf:type rdf:Property ;
    rdfs:label 'Bargaining Unit' ;
    rdfs:comment 'Name or code of the collective bargaining unit to which the position belongs if union eligible.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardPayEligible rdf:type rdf:Property ;
    rdfs:label 'Hazard Pay Eligible' ;
    rdfs:comment 'Indicates whether the position is eligible for hazard pay or hazardous duty compensation due to dangerous working conditions.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onCallEligible rdf:type rdf:Property ;
    rdfs:label 'On Call Eligible' ;
    rdfs:comment 'Indicates whether the position is eligible for on-call duty pay or compensation for being available outside regular work hours.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelRequirementPercentage rdf:type rdf:Property ;
    rdfs:label 'Travel Requirement Percentage' ;
    rdfs:comment 'Estimated percentage of work time that requires travel for the position (0-100).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleProvided rdf:type rdf:Property ;
    rdfs:label 'Vehicle Provided' ;
    rdfs:comment 'Indicates whether a state vehicle is provided to the position for official business use.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:essentialFunctions rdf:type rdf:Property ;
    rdfs:label 'Essential Functions' ;
    rdfs:comment 'Description of the essential functions and primary duties of the position as defined under ADA requirements.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicalRequirements rdf:type rdf:Property ;
    rdfs:label 'Physical Requirements' ;
    rdfs:comment 'Description of physical requirements and demands of the position (e.g., lifting, standing, outdoor work).' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workingConditions rdf:type rdf:Property ;
    rdfs:label 'Working Conditions' ;
    rdfs:comment 'Description of typical working conditions and environment for the position (e.g., office, field, outdoor, hazardous).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:abolishedDate rdf:type rdf:Property ;
    rdfs:label 'Abolished Date' ;
    rdfs:comment 'Date when the position was officially abolished or eliminated from the organizational structure.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:frozenDate rdf:type rdf:Property ;
    rdfs:label 'Frozen Date' ;
    rdfs:comment 'Date when the position was frozen and made unavailable for hiring due to budget constraints or organizational changes.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgeted rdf:type rdf:Property ;
    rdfs:label 'Budgeted' ;
    rdfs:comment 'Indicates whether the position is included in the approved budget for the current fiscal year.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetFiscalYear rdf:type rdf:Property ;
    rdfs:label 'Budget Fiscal Year' ;
    rdfs:comment 'Fiscal year for which the position is budgeted (e.g., 2024 for FY 2024).' ;
    rdfs:domain ind:Position ;
