    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTiming rdf:type rdf:Property ;
    rdfs:label 'Payment Timing' ;
    rdfs:comment 'Timing of commission payment: immediate upon booking, monthly, quarterly, annual, or upon premium collection.' ;
