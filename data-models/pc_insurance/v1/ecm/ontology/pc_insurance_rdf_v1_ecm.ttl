    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncciCode rdf:type rdf:Property ;
    rdfs:label 'Ncci Code' ;
    rdfs:comment 'The NCCI classification code for workers compensation rating and classification.' ;
    rdfs:domain ind:ClassificationCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Number' ;
    rdfs:comment 'The state Department of Insurance filing number or SERFF tracking number associated with this classification code approval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryName rdf:type rdf:Property ;
    rdfs:label 'Country Name' ;
    rdfs:comment 'Full name of the primary country or territory that issues the currency.' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayFormat rdf:type rdf:Property ;
    rdfs:label 'Display Format' ;
    rdfs:comment 'Standard display format pattern for currency amounts (e.g., $1,234.56 or 1.234,56 €).' ;
    rdfs:domain ind:Shared ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCrypto rdf:type rdf:Property ;
    rdfs:label 'Is Crypto' ;
    rdfs:comment 'Indicates whether the currency is a cryptocurrency or digital asset rather than fiat currency.' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPreciousMetal rdf:type rdf:Property ;
    rdfs:label 'Is Precious Metal' ;
    rdfs:comment 'Indicates whether the currency represents a precious metal commodity (e.g., XAU for gold, XAG for silver).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorUnit rdf:type rdf:Property ;
    rdfs:label 'Minor Unit' ;
    rdfs:comment 'Number of decimal places for the currency\'s minor unit (e.g., 2 for USD cents, 0 for JPY).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currencyName rdf:type rdf:Property ;
    rdfs:label 'Currency Name' ;
    rdfs:comment 'Full official name of the currency (e.g., United States Dollar, Euro, British Pound Sterling).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numericCode rdf:type rdf:Property ;
    rdfs:label 'Numeric Code' ;
    rdfs:comment 'Three-digit numeric ISO 4217 currency code (e.g., 840 for USD, 978 for EUR).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roundingMethod rdf:type rdf:Property ;
    rdfs:label 'Rounding Method' ;
    rdfs:comment 'Standard rounding method applied to currency amounts (standard, up, down, nearest).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:symbol rdf:type rdf:Property ;
    rdfs:label 'Symbol' ;
    rdfs:comment 'Standard symbol used to represent the currency (e.g., $, €, £, ¥).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheExposed rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Exposed' ;
    rdfs:comment 'Indicates whether this line of business is exposed to catastrophe perils such as hurricane, earthquake, wildfire, requiring CAT modeling and PML analysis.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:combinedRatioTargetPct rdf:type rdf:Property ;
    rdfs:label 'Combined Ratio Target Pct' ;
    rdfs:comment 'Target combined ratio percentage for this line of business, calculated as loss ratio plus expense ratio, used for profitability assessment.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Default Commission Pct' ;
    rdfs:comment 'Standard commission percentage paid to producers for new business in this line of business, subject to producer appointment and agency agreement terms.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultPolicyTermMonths rdf:type rdf:Property ;
    rdfs:label 'Default Policy Term Months' ;
    rdfs:comment 'Standard policy term duration in months for this line of business, typically 12 months for annual policies or 6 months for semi-annual policies.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineOfBusinessDescription rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Description' ;
    rdfs:comment 'Detailed business description of the line of business, including coverage scope, typical insured risks, and key characteristics.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseRatioTargetPct rdf:type rdf:Property ;
    rdfs:label 'Expense Ratio Target Pct' ;
    rdfs:comment 'Target expense ratio percentage for this line of business, including commission, underwriting expenses, and general overhead allocation.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAdmitted rdf:type rdf:Property ;
    rdfs:label 'Is Admitted' ;
    rdfs:comment 'Indicates whether this line of business is written on an admitted basis, subject to state guaranty fund protection and rate/form regulation.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSurplusLines rdf:type rdf:Property ;
    rdfs:label 'Is Surplus Lines' ;
    rdfs:comment 'Indicates whether this line of business is written on a surplus lines basis, requiring stamping office approval and diligent search documentation.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoLineCode rdf:type rdf:Property ;
    rdfs:label 'Iso Line Code' ;
    rdfs:comment 'ISO standard code for the line of business, used for forms, rating, and industry benchmarking.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineOfBusinessStatus rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Status' ;
    rdfs:comment 'Current operational status of the line of business, indicating whether it is actively written, inactive, discontinued, or pending regulatory approval.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Lob Abbreviation' ;
    rdfs:comment 'Standard industry abbreviation for the line of business, such as HO, PAP, CGL, BOP, CPP, WC, CA.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobType rdf:type rdf:Property ;
    rdfs:label 'Lob Type' ;
    rdfs:comment 'Primary type classification of the line of business, indicating whether it is Property, Casualty, Liability, Auto, Workers Compensation, or Package coverage.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioTargetPct rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Target Pct' ;
    rdfs:comment 'Target loss ratio percentage for this line of business, used for pricing, underwriting guidelines, and profitability monitoring.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date when the line of business received regulatory approval from the state Department of Insurance for writing new business.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceTreatyApplicable rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Applicable' ;
    rdfs:comment 'Indicates whether this line of business is covered under one or more reinsurance treaties, requiring cession and bordereaux reporting.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresStateFiling rdf:type rdf:Property ;
    rdfs:label 'Requires State Filing' ;
    rdfs:comment 'Indicates whether rates, forms, and policy language for this line of business require prior approval or filing with state regulators.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schedulePLineNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule P Line Number' ;
    rdfs:comment 'NAIC Schedule P line number for statutory loss reserve reporting, used in annual statement filings and actuarial reserve analysis.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsPackagePolicy rdf:type rdf:Property ;
    rdfs:label 'Supports Package Policy' ;
    rdfs:comment 'Indicates whether this line of business can be combined with other lines into a package policy such as Commercial Package Policy or Business Owners Policy.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baseUnitCode rdf:type rdf:Property ;
    rdfs:label 'Base Unit Code' ;
    rdfs:comment 'Code of the base unit within the same category to which this unit converts. Null if this is the base unit or standalone.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conversionFactorToBase rdf:type rdf:Property ;
    rdfs:label 'Conversion Factor To Base' ;
    rdfs:comment 'Numeric multiplier to convert this unit to the base unit within its category. Null if this is the base unit or conversion not applicable.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:decimalPrecision rdf:type rdf:Property ;
    rdfs:label 'Decimal Precision' ;
    rdfs:comment 'Number of decimal places to which values in this unit should be rounded for rating and premium audit calculations.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exposureBasisFlag rdf:type rdf:Property ;
    rdfs:label 'Exposure Basis Flag' ;
    rdfs:comment 'Indicates whether this unit of measure is used as a premium exposure basis in rating and pricing calculations.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoStandardCode rdf:type rdf:Property ;
    rdfs:label 'Iso Standard Code' ;
    rdfs:comment 'International Organization for Standardization code for this unit of measure if applicable per ISO 80000 or ISO 31 standards.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemOfMeasurement rdf:type rdf:Property ;
    rdfs:label 'System Of Measurement' ;
    rdfs:comment 'Measurement system to which this unit belongs for conversion and standardization purposes.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitOfMeasureStatus rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure Status' ;
    rdfs:comment 'Current lifecycle status of the unit of measure in the reference catalog.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uomAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Uom Abbreviation' ;
    rdfs:comment 'Standard abbreviated form of the unit of measure used in forms, declarations, and rating worksheets.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uomCategory rdf:type rdf:Property ;
    rdfs:label 'Uom Category' ;
    rdfs:comment 'High-level classification grouping units by measurement dimension for exposure basis categorization. [ENUM-REF-CANDIDATE: area|distance|count|currency|time|weight|volume|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uomCode rdf:type rdf:Property ;
    rdfs:label 'Uom Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the unit of measure. Used as business key in rating and premium audit systems.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uomName rdf:type rdf:Property ;
    rdfs:label 'Uom Name' ;
    rdfs:comment 'Full descriptive name of the unit of measure for display and reporting purposes.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageDescription rdf:type rdf:Property ;
    rdfs:label 'Usage Description' ;
    rdfs:comment 'Detailed explanation of how and where this unit of measure is used in underwriting, rating, premium audit, and exposure aggregation.' ;
    rdfs:domain ind:UnitOfMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindRequestId rdf:type rdf:Property ;
    rdfs:label 'Bind Request Id' ;
    rdfs:comment 'Unique identifier for the bind request. Primary key. Grain: one row per bind request.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BindRequest .

ind:bindApplicantPartyId rdf:type rdf:Property ;
    rdfs:label 'Bind Applicant Party Id' ;
    rdfs:comment 'Reference to the party requesting to bind the policy. Primary insured or named insured.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:bindPartyId rdf:type rdf:Property ;
    rdfs:label 'Bind Party Id' ;
    rdfs:comment 'Reference to the underwriter assigned to review and approve or reject the bind request.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:binderId rdf:type rdf:Property ;
    rdfs:label 'Binder Id' ;
    rdfs:comment 'Foreign key linking to coverage.binder. Business justification: Bind request results in a binder being issued when approved. 1 bind_request → 1 binder. FK populated when bind is approved and binder issued.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Binder .

ind:boundPolicyId rdf:type rdf:Property ;
    rdfs:label 'Bound Policy Id' ;
    rdfs:comment 'Reference to the policy created when bind request was approved. Links bind request to issued policy.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:automatedBindFlag rdf:type rdf:Property ;
    rdfs:label 'Automated Bind Flag' ;
    rdfs:comment 'Indicates whether the bind request was approved automatically by system rules without underwriter review.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Bind Approval Date' ;
    rdfs:comment 'Date the underwriter or system approved the bind request. Policy issuance proceeds after approval.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindApprovalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bind Approval Timestamp' ;
    rdfs:comment 'Precise date and time the bind request was approved. Used for SLA compliance and audit trail.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bindAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Bind Authority Level' ;
    rdfs:comment 'Authority level required to approve this bind request. Determined by risk characteristics and premium size.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindConditionsMetFlag rdf:type rdf:Property ;
    rdfs:label 'Bind Conditions Met Flag' ;
    rdfs:comment 'Indicates whether all required bind conditions have been satisfied. Must be true for bind approval.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindConditionsRequired rdf:type rdf:Property ;
    rdfs:label 'Bind Conditions Required' ;
    rdfs:comment 'List of conditions that must be satisfied before bind approval. Inspection, loss control, additional documentation.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindRejectionDate rdf:type rdf:Property ;
    rdfs:label 'Bind Rejection Date' ;
    rdfs:comment 'Date the bind request was rejected by underwriter or system. Ends bind request lifecycle.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindRejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Bind Rejection Reason Code' ;
    rdfs:comment 'Standardized code indicating why the bind request was rejected. Links to rejection reason reference table.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindRejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Bind Rejection Reason Description' ;
    rdfs:comment 'Detailed explanation of why the bind request was rejected. Provided to producer and applicant.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindRequestDate rdf:type rdf:Property ;
    rdfs:label 'Bind Request Date' ;
    rdfs:comment 'Date the bind request was submitted by producer or applicant. Business event timestamp for bind initiation.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindRequestStatus rdf:type rdf:Property ;
    rdfs:label 'Bind Request Status' ;
    rdfs:comment 'Current lifecycle status of the bind request. Tracks progression from submission through final disposition.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateOfInsuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Certificate Of Insurance Required Flag' ;
    rdfs:comment 'Indicates whether a certificate of insurance must be issued at bind. Common for commercial liability.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:downPaymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Down Payment Received Date' ;
    rdfs:comment 'Date the down payment was received and cleared. Triggers bind approval workflow.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:downPaymentReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Down Payment Received Flag' ;
    rdfs:comment 'Indicates whether the down payment has been received and cleared. Required for bind approval.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Completed Date' ;
    rdfs:comment 'Date the required inspection was completed. Satisfies bind condition for inspection requirement.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mortgageeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Mortgagee Required Flag' ;
    rdfs:comment 'Indicates whether mortgagee or loss payee information is required before bind. Common for property coverage.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorCarrierCancellationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Cancellation Required Flag' ;
    rdfs:comment 'Indicates whether proof of prior carrier cancellation is required before bind. Prevents dual coverage.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestedEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Requested Effective Date' ;
    rdfs:comment 'Date the applicant or producer requests coverage to begin. May differ from quote effective date.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Requested Expiration Date' ;
    rdfs:comment 'Date the applicant or producer requests coverage to end. Typically one year from effective date.' ;
    rdfs:domain ind:BindRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:slaActualHours rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Hours' ;
    rdfs:comment 'Actual number of hours taken to process bind request. Calculated from request to approval or rejection.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Met Flag' ;
    rdfs:comment 'Indicates whether the bind request was processed within the SLA target. Used for performance reporting.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Hours' ;
    rdfs:comment 'Target number of hours for bind request processing. Used for performance tracking and producer expectations.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:binderInsuredPartyId rdf:type rdf:Property ;
    rdfs:label 'Binder Insured Party Id' ;
    rdfs:comment 'Reference to the party being insured under this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:binderPartyId rdf:type rdf:Property ;
    rdfs:label 'Binder Party Id' ;
    rdfs:comment 'Reference to the underwriter who authorized this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:bindDate rdf:type rdf:Property ;
    rdfs:label 'Bind Date' ;
    rdfs:comment 'Date when the binder was issued and coverage became effective.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:binderStatus rdf:type rdf:Property ;
    rdfs:label 'Binder Status' ;
    rdfs:comment 'Current lifecycle status of the binder contract.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindingAuthorityType rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Type' ;
    rdfs:comment 'Type of authority under which this binder was issued.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Company Code' ;
    rdfs:comment 'NAIC company code of the insurer issuing this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Policy Issued Date' ;
    rdfs:comment 'Date when the formal policy was issued to replace this binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:replacedByPolicyFlag rdf:type rdf:Property ;
    rdfs:label 'Replaced By Policy Flag' ;
    rdfs:comment 'Indicates whether this binder was replaced by a formal policy issuance.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskState rdf:type rdf:Property ;
    rdfs:label 'Risk State' ;
    rdfs:comment 'State where the insured risk is located.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termDays rdf:type rdf:Property ;
    rdfs:label 'Term Days' ;
    rdfs:comment 'Duration of binder coverage in days, typically 30-90 days.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clearanceCheckId rdf:type rdf:Property ;
    rdfs:label 'Clearance Check Id' ;
    rdfs:comment 'Unique identifier for each clearance and eligibility screening event performed on a submission.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClearanceCheck .

ind:clearanceOverrideUserPartyId rdf:type rdf:Property ;
    rdfs:label 'Clearance Override User Party Id' ;
    rdfs:comment 'User ID of the underwriter who performed the manual override of the screening result.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:clearancePartyId rdf:type rdf:Property ;
    rdfs:label 'Clearance Party Id' ;
    rdfs:comment 'Identifier of the underwriter assigned to review or override the clearance screening results.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:primaryRiskAppetiteRuleId rdf:type rdf:Property ;
    rdfs:label 'Primary Risk Appetite Rule Id' ;
    rdfs:comment 'Foreign key linking to coverage.risk_appetite_rule. Business justification: Clearance check applies appetite rules (absorbed eligibility functionality). FK captures the primary rule that triggered the check result.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskAppetiteRule .

ind:checkDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Check Duration Seconds' ;
    rdfs:comment 'Total elapsed time in seconds for the clearance and eligibility screening process to complete.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:checkStatus rdf:type rdf:Property ;
    rdfs:label 'Check Status' ;
    rdfs:comment 'Current processing status of the clearance check execution.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkTimestamp rdf:type rdf:Property ;
    rdfs:label 'Check Timestamp' ;
    rdfs:comment 'Date and time when the clearance and eligibility screening was executed.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:checkType rdf:type rdf:Property ;
    rdfs:label 'Check Type' ;
    rdfs:comment 'Type of screening performed: clearance for duplicates, eligibility for risk appetite, or combined screening.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceResult rdf:type rdf:Property ;
    rdfs:label 'Clearance Result' ;
    rdfs:comment 'Overall result of the clearance screening: pass indicates no duplicates or conflicts detected.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionCode rdf:type rdf:Property ;
    rdfs:label 'Decision Code' ;
    rdfs:comment 'Standardized code representing the final clearance and eligibility decision outcome.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionReason rdf:type rdf:Property ;
    rdfs:label 'Decision Reason' ;
    rdfs:comment 'Detailed explanation of the clearance and eligibility decision, including contributing factors and rule outcomes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateDetectedFlag rdf:type rdf:Property ;
    rdfs:label 'Duplicate Detected Flag' ;
    rdfs:comment 'Indicates whether a duplicate submission or policy was detected during clearance screening.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:duplicateMatchScore rdf:type rdf:Property ;
    rdfs:label 'Duplicate Match Score' ;
    rdfs:comment 'Confidence score for duplicate detection, ranging from 0.00 to 100.00, with higher values indicating stronger match.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duplicatePolicyNumbers rdf:type rdf:Property ;
    rdfs:label 'Duplicate Policy Numbers' ;
    rdfs:comment 'Comma-separated list of existing policy numbers identified as duplicates or conflicts.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateSubmissionIds rdf:type rdf:Property ;
    rdfs:label 'Duplicate Submission Ids' ;
    rdfs:comment 'Comma-separated list of submission IDs identified as potential duplicates during clearance.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityResult rdf:type rdf:Property ;
    rdfs:label 'Eligibility Result' ;
    rdfs:comment 'Overall eligibility determination based on risk appetite and underwriting guidelines evaluation.' ;
    rdfs:domain ind:ClearanceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failFlag rdf:type rdf:Property ;
    rdfs:label 'Fail Flag' ;
    rdfs:comment 'Indicates whether the submission failed clearance or eligibility screening and should be declined.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:failedRuleIds rdf:type rdf:Property ;
    rdfs:label 'Failed Rule Ids' ;
    rdfs:comment 'Comma-separated list of rule IDs that failed during screening, contributing to ineligibility or referral.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passFlag rdf:type rdf:Property ;
    rdfs:label 'Pass Flag' ;
    rdfs:comment 'Indicates whether the submission passed all clearance and eligibility screening criteria without exceptions.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:productCode rdf:type rdf:Property ;
    rdfs:label 'Product Code' ;
    rdfs:comment 'Specific insurance product code being evaluated during clearance screening.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreBand rdf:type rdf:Property ;
    rdfs:label 'Risk Score Band' ;
    rdfs:comment 'Categorical band or range into which the calculated risk score falls for classification purposes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSetName rdf:type rdf:Property ;
    rdfs:label 'Rule Set Name' ;
    rdfs:comment 'Name of the rule set configuration used for clearance and eligibility evaluation.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSetVersion rdf:type rdf:Property ;
    rdfs:label 'Rule Set Version' ;
    rdfs:comment 'Version identifier of the clearance and eligibility rule set applied during this screening.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredRuleIds rdf:type rdf:Property ;
    rdfs:label 'Triggered Rule Ids' ;
    rdfs:comment 'Comma-separated list of all rule IDs that were triggered during clearance and eligibility screening.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCheckId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Check Id' ;
    rdfs:comment 'Unique identifier for the eligibility evaluation record. Primary key.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilityCheck .

ind:eligibilityOverrideUserPartyId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Override User Party Id' ;
    rdfs:comment 'User ID of the underwriter who performed the override.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:eligibilityPartyId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Party Id' ;
    rdfs:comment 'Foreign key to the underwriter assigned to review the eligibility check.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:eligibilityDecision rdf:type rdf:Property ;
    rdfs:label 'Eligibility Decision' ;
    rdfs:comment 'Final eligibility decision: eligible, ineligible, conditional, or refer.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionInsuredPartyId rdf:type rdf:Property ;
    rdfs:label 'Inspection Insured Party Id' ;
    rdfs:comment 'Foreign key to the party being insured and subject to the inspection.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:inspectionPartyId rdf:type rdf:Property ;
    rdfs:label 'Inspection Party Id' ;
    rdfs:comment 'Foreign key to the underwriter who ordered the inspection.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:orderingAgencyId rdf:type rdf:Property ;
    rdfs:label 'Ordering Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Agencies often coordinate inspection orders as part of submission workflow or renewal servicing.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Cost charged by the vendor for the inspection service.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionFindings rdf:type rdf:Property ;
    rdfs:label 'Inspection Findings' ;
    rdfs:comment 'Summary of key findings from the inspection report, including any risk concerns or recommendations.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Mvr License Number' ;
    rdfs:comment 'Driver\'s license number as reported on the MVR.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrLicenseStatus rdf:type rdf:Property ;
    rdfs:label 'Mvr License Status' ;
    rdfs:comment 'Current status of the driver\'s license as reported on the MVR.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrState rdf:type rdf:Property ;
    rdfs:label 'Mvr State' ;
    rdfs:comment 'State that issued the driver\'s license and MVR report.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderDate rdf:type rdf:Property ;
    rdfs:label 'Order Date' ;
    rdfs:comment 'Date the inspection order was placed with the vendor.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderNumber rdf:type rdf:Property ;
    rdfs:label 'Order Number' ;
    rdfs:comment 'Business-facing unique order number assigned by the underwriting system or vendor.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current lifecycle status of the inspection order. [ENUM-REF-CANDIDATE: pending|ordered|scheduled|in_progress|completed|cancelled|failed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Type of inspection ordered: property interior, exterior, COPE (Construction Occupancy Protection Exposure), MVR (Motor Vehicle Record), or combined. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passFailIndicator rdf:type rdf:Property ;
    rdfs:label 'Pass Fail Indicator' ;
    rdfs:comment 'Indicator of whether the inspection passed, failed, or passed with conditions.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyCondition rdf:type rdf:Property ;
    rdfs:label 'Property Condition' ;
    rdfs:comment 'Overall condition rating of the inspected property, if applicable.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Required Flag' ;
    rdfs:comment 'Flag indicating whether the inspection findings require underwriter referral or management review.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Report Document Url' ;
    rdfs:comment 'URL or file path to the stored inspection report document.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportFormat rdf:type rdf:Property ;
    rdfs:label 'Report Format' ;
    rdfs:comment 'Format of the inspection report document received from the vendor.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Reference Number' ;
    rdfs:comment 'Vendor\'s internal reference or tracking number for the inspection order.' ;
    rdfs:domain ind:InspectionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossHistoryId rdf:type rdf:Property ;
    rdfs:label 'Loss History Id' ;
    rdfs:comment 'Unique identifier for the prior loss record.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LossHistory .

ind:verifiedByAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Verified By Adjuster Id' ;
    rdfs:comment 'Foreign key to the adjuster party who performed the verification.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:atFaultFlag rdf:type rdf:Property ;
    rdfs:label 'At Fault Flag' ;
    rdfs:comment 'Indicates whether the applicant or insured party was determined to be at fault for the loss.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clueReportOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Clue Report Order Number' ;
    rdfs:comment 'Order number for the CLUE report from which this loss record was extracted.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedFromRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Excluded From Rating Flag' ;
    rdfs:comment 'Indicates whether this prior loss is excluded from rating calculations (e.g., not-at-fault, CAT event).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionReason rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason' ;
    rdfs:comment 'Reason the prior loss is excluded from rating (not at fault, catastrophe, outside lookback period).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnCurrentClaim rdf:type rdf:Property ;
    rdfs:label 'Impact On Current Claim' ;
    rdfs:comment 'Assessment of how the verified prior loss information affects the handling or settlement of the current claim.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnRating rdf:type rdf:Property ;
    rdfs:label 'Impact On Rating' ;
    rdfs:comment 'Underwriting decision on how the prior loss impacts rating (surcharge, decline, refer, no impact, credit).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lookbackPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Months' ;
    rdfs:comment 'Number of months in the lookback period for this loss type as defined by underwriting guidelines.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossCauseCode rdf:type rdf:Property ;
    rdfs:label 'Loss Cause Code' ;
    rdfs:comment 'Standardized code for the cause of loss (fire, theft, collision, liability, water damage, wind, hail).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Loss Cause Description' ;
    rdfs:comment 'Human-readable description of the loss cause.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossType rdf:type rdf:Property ;
    rdfs:label 'Loss Type' ;
    rdfs:comment 'Classification of the loss by type (first party, third party, liability, property, auto, workers compensation).' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrReportOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Mvr Report Order Number' ;
    rdfs:comment 'Order number for the MVR report from which this loss record was extracted.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCarrierNaicCode rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code for the carrier that handled the prior loss.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Surcharge Amount' ;
    rdfs:comment 'Premium surcharge amount applied due to this prior loss.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surchargePercentage rdf:type rdf:Property ;
    rdfs:label 'Surcharge Percentage' ;
    rdfs:comment 'Premium surcharge percentage applied due to this prior loss.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Dollar difference between prior loss reported amount and verified claim amount, if applicable.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceExplanation rdf:type rdf:Property ;
    rdfs:label 'Variance Explanation' ;
    rdfs:comment 'Adjuster notes explaining any discrepancies found between the prior loss record and actual claim data.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withinLookbackFlag rdf:type rdf:Property ;
    rdfs:label 'Within Lookback Flag' ;
    rdfs:comment 'Indicates whether the prior loss falls within the applicable lookback period for underwriting and rating.' ;
    rdfs:domain ind:LossHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:basePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Base Premium Amount' ;
    rdfs:comment 'Base premium before application of discounts, surcharges, taxes, and fees.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundByUserCode rdf:type rdf:Property ;
    rdfs:label 'Bound By User Code' ;
    rdfs:comment 'Identifier of the user who bound the quote.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:boundTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bound Timestamp' ;
    rdfs:comment 'Timestamp when the quote was bound and converted to a policy.' ;
    rdfs:domain ind:Quote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:declineReason rdf:type rdf:Property ;
    rdfs:label 'Decline Reason' ;
    rdfs:comment 'Reason the quote was declined if status is declined.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteStatus rdf:type rdf:Property ;
    rdfs:label 'Quote Status' ;
    rdfs:comment 'Current lifecycle status of the quote.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quotedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Quoted Premium Amount' ;
    rdfs:comment 'Total premium amount quoted to the customer, including all charges, taxes, and fees.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingEngineVersion rdf:type rdf:Property ;
    rdfs:label 'Rating Engine Version' ;
    rdfs:comment 'Version of the rating engine or pricing algorithm used to calculate the quoted premium.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundCoverageId rdf:type rdf:Property ;
    rdfs:label 'Bound Coverage Id' ;
    rdfs:comment 'Foreign key linking to coverage.coverage. Business justification: Quote coverages become bound policy coverages when a quote is accepted. This lineage link enables tracking quote-to-policy conversion, comparing quoted vs bound terms, and supporting audit' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coverage .

ind:quoteOptionId rdf:type rdf:Property ;
    rdfs:label 'Quote Option Id' ;
    rdfs:comment 'Foreign key linking to coverage.quote_option. Business justification: Coverage can be associated with a specific quote option/scenario. Many coverages can belong to one option.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QuoteOption .

ind:classCode rdf:type rdf:Property ;
    rdfs:label 'Class Code' ;
    rdfs:comment 'ISO or NCCI class code for this coverage. Used in rating and risk classification.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCodes rdf:type rdf:Property ;
    rdfs:label 'Condition Codes' ;
    rdfs:comment 'Comma-separated list of condition codes applied to this coverage. References standard condition forms.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declinationReason rdf:type rdf:Property ;
    rdfs:label 'Declination Reason' ;
    rdfs:comment 'Reason the applicant declined this coverage. Null if coverage was not declined.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAppliesTo rdf:type rdf:Property ;
    rdfs:label 'Deductible Applies To' ;
    rdfs:comment 'Scope of deductible application. Per occurrence, per claim, per policy term, or aggregate across all claims.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementCodes rdf:type rdf:Property ;
    rdfs:label 'Endorsement Codes' ;
    rdfs:comment 'Comma-separated list of endorsement form numbers modifying this coverage. References ISO or proprietary endorsements.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCodes rdf:type rdf:Property ;
    rdfs:label 'Exclusion Codes' ;
    rdfs:comment 'Comma-separated list of exclusion codes applied to this coverage. References standard exclusion forms.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extendedReportingPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Extended Reporting Period Months' ;
    rdfs:comment 'Length of extended reporting period in months for claims-made coverage. Null if not applicable.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isDeclined rdf:type rdf:Property ;
    rdfs:label 'Is Declined' ;
    rdfs:comment 'Indicates whether the applicant declined this optional coverage. True if declined, false otherwise.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perAccidentLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Accident Limit Amount' ;
    rdfs:comment 'Maximum amount payable per accident or occurrence. Null if not applicable.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perPersonLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Person Limit Amount' ;
    rdfs:comment 'Maximum amount payable per person for bodily injury or medical payments. Null if not applicable.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quotedDate rdf:type rdf:Property ;
    rdfs:label 'Quoted Date' ;
    rdfs:comment 'Date this coverage line was quoted. Business event timestamp for the quote generation.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfInsuredRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Self Insured Retention Amount' ;
    rdfs:comment 'Self-insured retention amount the insured must pay before coverage applies. Differs from deductible in claims handling.' ;
    rdfs:domain ind:QuoteCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quotedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Quoted By Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Quote option creation attribution for producer performance tracking (quote-to-bind ratio), pricing governance (who quoted what rates), and commission calculation validation.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:coveragePackageCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Package Code' ;
    rdfs:comment 'Internal or ISO code representing the bundled coverage package offered in this option.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Amount' ;
    rdfs:comment 'Amount of each subsequent installment payment for this option.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentCount rdf:type rdf:Property ;
    rdfs:label 'Installment Count' ;
    rdfs:comment 'Number of installment payments for this option under the selected payment plan.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isDefaultOption rdf:type rdf:Property ;
    rdfs:label 'Is Default Option' ;
    rdfs:comment 'Indicates whether this is the default or recommended option presented to the prospect.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSelected rdf:type rdf:Property ;
    rdfs:label 'Is Selected' ;
    rdfs:comment 'Indicates whether the prospect selected this option for binding.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optionDescription rdf:type rdf:Property ;
    rdfs:label 'Option Description' ;
    rdfs:comment 'Detailed narrative describing the coverage, limits, deductibles, and key features of this option.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optionName rdf:type rdf:Property ;
    rdfs:label 'Option Name' ;
    rdfs:comment 'Business-friendly name or label for this option, such as Standard Coverage or Enhanced Protection.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optionNumber rdf:type rdf:Property ;
    rdfs:label 'Option Number' ;
    rdfs:comment 'Sequential number of this option within the parent quote for ordering and display.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:optionStatus rdf:type rdf:Property ;
    rdfs:label 'Option Status' ;
    rdfs:comment 'Current status of this option: active, withdrawn, expired, bound, or declined.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optionType rdf:type rdf:Property ;
    rdfs:label 'Option Type' ;
    rdfs:comment 'Classification of the option by packaging strategy: standard, enhanced, economy, custom, package, or a la carte.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyFormCode rdf:type rdf:Property ;
    rdfs:label 'Policy Form Code' ;
    rdfs:comment 'ISO or proprietary form code identifying the coverage form used in this option, such as HO-3 or CGL.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingClass rdf:type rdf:Property ;
    rdfs:label 'Rating Class' ;
    rdfs:comment 'Detailed rating classification code used to price this option.' ;
    rdfs:domain ind:QuoteOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingFactorId rdf:type rdf:Property ;
    rdfs:label 'Rating Factor Id' ;
    rdfs:comment 'Unique identifier for the rating factor record.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideUserPartyId rdf:type rdf:Property ;
    rdfs:label 'Override User Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Factor-level overrides (schedule rating, experience mod adjustments) require user attribution for regulatory audit (rate filing compliance), pricing integrity validation, and underwriting' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:calculationFormula rdf:type rdf:Property ;
    rdfs:label 'Calculation Formula' ;
    rdfs:comment 'Mathematical expression or rule describing how this factor is computed or applied in the rating algorithm.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorBasis rdf:type rdf:Property ;
    rdfs:label 'Factor Basis' ;
    rdfs:comment 'The underlying risk characteristic or attribute that this factor is based on (e.g., ZIP code, NAICS code, loss history).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorCategory rdf:type rdf:Property ;
    rdfs:label 'Factor Category' ;
    rdfs:comment 'Classification of the factor type within the rating algorithm structure. [ENUM-REF-CANDIDATE: base_rate|territory|class_code|experience_mod|schedule_credit|schedule_debit|coverage_adjustment|limit_factor|deductible_credit — 9 candidates stripped; promote' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorCode rdf:type rdf:Property ;
    rdfs:label 'Factor Code' ;
    rdfs:comment 'Short code or abbreviation identifying the factor type for system processing and reporting.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorDescription rdf:type rdf:Property ;
    rdfs:label 'Factor Description' ;
    rdfs:comment 'Detailed explanation of what the factor represents and how it impacts the premium calculation.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorName rdf:type rdf:Property ;
    rdfs:label 'Factor Name' ;
    rdfs:comment 'Business name of the rating factor (e.g., Territory Factor, Class Code Factor, Experience Modification).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorSequence rdf:type rdf:Property ;
    rdfs:label 'Factor Sequence' ;
    rdfs:comment 'Ordinal position of this factor within the rating worksheet calculation sequence.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:factorSource rdf:type rdf:Property ;
    rdfs:label 'Factor Source' ;
    rdfs:comment 'Origin of the factor value (ISO table, proprietary rating plan, manual underwriter override, actuarial model, or state filing).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorType rdf:type rdf:Property ;
    rdfs:label 'Factor Type' ;
    rdfs:comment 'Indicates how the factor value is applied in the calculation (multiplicative, additive, percentage, or flat).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorValue rdf:type rdf:Property ;
    rdfs:label 'Factor Value' ;
    rdfs:comment 'Numeric value of the rating factor applied in the premium calculation (multiplier or additive amount).' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isFiled rdf:type rdf:Property ;
    rdfs:label 'Is Filed' ;
    rdfs:comment 'Indicates whether this factor is part of a state-filed rating plan and subject to regulatory approval.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxFactorValue rdf:type rdf:Property ;
    rdfs:label 'Max Factor Value' ;
    rdfs:comment 'Maximum allowable value for this factor, enforcing underwriting or regulatory constraints.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minFactorValue rdf:type rdf:Property ;
    rdfs:label 'Min Factor Value' ;
    rdfs:comment 'Minimum allowable value for this factor, enforcing underwriting or regulatory constraints.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingFactorStatus rdf:type rdf:Property ;
    rdfs:label 'Rating Factor Status' ;
    rdfs:comment 'Current lifecycle status of the rating factor within the rating engine.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Table Effective Date' ;
    rdfs:comment 'Date when the rating table version became effective for use in premium calculations.' ;
    rdfs:domain ind:RatingFactor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingRuleSetId rdf:type rdf:Property ;
    rdfs:label 'Rating Rule Set Id' ;
    rdfs:comment 'Identifier of the specific rule set or rating plan applied in this calculation.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RatingRuleSet .

ind:finalPremium rdf:type rdf:Property ;
    rdfs:label 'Final Premium' ;
    rdfs:comment 'Final premium amount after minimum premium rules and any manual overrides, representing the amount to be charged.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:manualPremium rdf:type rdf:Property ;
    rdfs:label 'Manual Premium' ;
    rdfs:comment 'Premium calculated by applying the base rate to the exposure base before any modifications.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremiumAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Applied Flag' ;
    rdfs:comment 'Indicator whether the minimum premium override was applied because the rated premium fell below the threshold.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateTableEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Table Effective Date' ;
    rdfs:comment 'Effective date of the rate tables used in this calculation.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateTableVersion rdf:type rdf:Property ;
    rdfs:label 'Rate Table Version' ;
    rdfs:comment 'Version identifier of the rate tables applied in this rating calculation, critical for audit and regulatory compliance.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratedPremium rdf:type rdf:Property ;
    rdfs:label 'Rated Premium' ;
    rdfs:comment 'Final calculated premium after all rating factors, surcharges, credits, and modifiers have been applied.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Rating Calculation Method' ;
    rdfs:comment 'Method by which the rating was performed: fully automated, manual, or hybrid with human intervention.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rating Effective Date' ;
    rdfs:comment 'Effective date for which the rating calculation applies, typically the policy or coverage effective date.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingEngineName rdf:type rdf:Property ;
    rdfs:label 'Rating Engine Name' ;
    rdfs:comment 'Name of the rating engine or pricing system that performed the calculation (e.g., ISO ERC, Earnix, proprietary engine).' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingNotes rdf:type rdf:Property ;
    rdfs:label 'Rating Notes' ;
    rdfs:comment 'Free-text notes or comments regarding the rating calculation, exceptions, or special considerations.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingRunNumber rdf:type rdf:Property ;
    rdfs:label 'Rating Run Number' ;
    rdfs:comment 'Business identifier for this rating calculation run, used for tracking and audit purposes.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingStatus rdf:type rdf:Property ;
    rdfs:label 'Rating Status' ;
    rdfs:comment 'Current status of the rating calculation workflow.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Rating Timestamp' ;
    rdfs:comment 'Date and time when the rating calculation was executed.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleModifier rdf:type rdf:Property ;
    rdfs:label 'Schedule Modifier' ;
    rdfs:comment 'Schedule rating modifier applied for specific risk characteristics at underwriter discretion.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Total Credit Amount' ;
    rdfs:comment 'Sum of all credits or discounts applied to reduce the premium (e.g., multi-policy, safety features, claims-free).' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalSurchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Surcharge Amount' ;
    rdfs:comment 'Sum of all surcharges applied to the manual premium (e.g., for claims history, risk characteristics).' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationErrorMessage rdf:type rdf:Property ;
    rdfs:label 'Validation Error Message' ;
    rdfs:comment 'Error or warning message generated during validation of the rating calculation.' ;
    rdfs:domain ind:RatingWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAppetiteRuleId rdf:type rdf:Property ;
    rdfs:label 'Risk Appetite Rule Id' ;
    rdfs:comment 'Unique identifier for the risk appetite rule. Primary key.' ;
    rdfs:domain ind:RiskAppetiteRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessOwner rdf:type rdf:Property ;
    rdfs:label 'Business Owner' ;
    rdfs:comment 'Name or identifier of the business unit or individual responsible for maintaining and approving changes to this rule.' ;
    rdfs:domain ind:RiskAppetiteRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionAction rdf:type rdf:Property ;
    rdfs:label 'Decision Action' ;
    rdfs:comment 'Underwriting action triggered when the rule condition is met: accept automatically, decline submission, refer to underwriter, quote with conditions, or require mandatory endorsement.' ;
    rdfs:domain ind:RiskAppetiteRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Allowed Flag' ;
    rdfs:comment 'Indicates whether underwriters are permitted to override this rule with appropriate authority. True allows exceptions; False enforces strict compliance.' ;
    rdfs:domain ind:RiskAppetiteRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mandatoryEndorsementCode rdf:type rdf:Property ;
    rdfs:label 'Mandatory Endorsement Code' ;
    rdfs:comment 'ISO or proprietary endorsement form code that must be attached to the policy when this rule triggers a require endorsement action.' ;
    rdfs:domain ind:RiskAppetiteRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Pricing Adjustment Factor' ;
    rdfs:comment 'Multiplicative factor applied to base premium when the rule triggers a pricing constraint, typically representing a surcharge or credit.' ;
    rdfs:domain ind:RiskAppetiteRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referralReasonCode rdf:type rdf:Property ;
    rdfs:label 'Referral Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for underwriter referral when the rule triggers a refer action.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Threshold Unit' ;
    rdfs:comment 'Unit of measure for the threshold value: currency amount, percentage, count, ratio, or risk score.' ;
    rdfs:domain ind:RiskAppetiteRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionApplicantPartyId rdf:type rdf:Property ;
    rdfs:label 'Submission Applicant Party Id' ;
    rdfs:comment 'Foreign key to the party table identifying the applicant or prospect submitting the risk for underwriting evaluation.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:submissionPartyId rdf:type rdf:Property ;
    rdfs:label 'Submission Party Id' ;
    rdfs:comment 'Foreign key to the underwriter assigned to evaluate this submission.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:clearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Clearance Status' ;
    rdfs:comment 'Status of submission intake clearance process indicating whether all required information and documents have been received.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditReportDate rdf:type rdf:Property ;
    rdfs:label 'Credit Report Date' ;
    rdfs:comment 'Date the credit report or insurance score was pulled for this submission.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status' ;
    rdfs:comment 'Result of automated eligibility screening indicating whether the submission meets basic acceptance criteria.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAnnualPremium rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Premium' ;
    rdfs:comment 'Estimated or indicative annual premium for this submission prior to final rating.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossHistoryReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Loss History Reviewed Flag' ;
    rdfs:comment 'Boolean flag indicating whether prior loss history was reviewed via CLUE, ISO, or other loss database.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrReportDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Report Date' ;
    rdfs:comment 'Date the Motor Vehicle Record report was pulled for auto submissions.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskCountry rdf:type rdf:Property ;
    rdfs:label 'Risk Country' ;
    rdfs:comment 'Three-letter ISO country code where the insured risk is located.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'Current lifecycle status of the submission in the underwriting workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|quoted|bound|declined|withdrawn|expired — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionType rdf:type rdf:Property ;
    rdfs:label 'Submission Type' ;
    rdfs:comment 'Classification of the submission as new business, renewal, rewrite, or remarketing of existing risk.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Submitted By User Code' ;
    rdfs:comment 'User identifier or login of the person who created or submitted this submission record.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawnReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Reason' ;
    rdfs:comment 'Reason the submission was withdrawn by the applicant or producer before binding.' ;
    rdfs:domain ind:Submission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDocumentId rdf:type rdf:Property ;
    rdfs:label 'Submission Document Id' ;
    rdfs:comment 'Unique identifier for the submission document. Primary key. One row per document attached to a submission.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:submissionReceivedFromPartyId rdf:type rdf:Property ;
    rdfs:label 'Submission Received From Party Id' ;
    rdfs:comment 'Party identifier of the external party from whom the document was received. May differ from uploader.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:submissionUploadedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Submission Uploaded By Party Id' ;
    rdfs:comment 'Party identifier of the individual or organization that uploaded the document. Links to party master.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:submittingAgencyId rdf:type rdf:Property ;
    rdfs:label 'Submitting Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Agencies are often the source of submission documents in P&C workflows. Direct agency tracking supports agency performance metrics (document completeness, timeliness), workflow routing' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:archiveDate rdf:type rdf:Property ;
    rdfs:label 'Archive Date' ;
    rdfs:comment 'Date when the document was moved to archive storage or marked for long-term retention.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:checksum rdf:type rdf:Property ;
    rdfs:label 'Checksum' ;
    rdfs:comment 'Hash or checksum value of the document file for integrity verification and duplicate detection.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDocumentDescription rdf:type rdf:Property ;
    rdfs:label 'Submission Document Description' ;
    rdfs:comment 'Detailed description of the document content, purpose, or context within the submission.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentFormat rdf:type rdf:Property ;
    rdfs:label 'Document Format' ;
    rdfs:comment 'File format or MIME type of the document. Indicates the technical format for storage and retrieval. [ENUM-REF-CANDIDATE: PDF|JPEG|PNG|TIFF|DOCX|XLSX|XML|CSV|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentName rdf:type rdf:Property ;
    rdfs:label 'Document Name' ;
    rdfs:comment 'Human-readable name or title of the document as provided by the submitter or system.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSource rdf:type rdf:Property ;
    rdfs:label 'Document Source' ;
    rdfs:comment 'Origin or provider of the document. Indicates who submitted or generated the document.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extractedText rdf:type rdf:Property ;
    rdfs:label 'Extracted Text' ;
    rdfs:comment 'Full text content extracted from the document via OCR or native text extraction for search and analysis.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filePath rdf:type rdf:Property ;
    rdfs:label 'File Path' ;
    rdfs:comment 'Storage location or URI where the document file is persisted in the document management system.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ocrConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Ocr Confidence Score' ;
    rdfs:comment 'Confidence score from OCR processing indicating the accuracy of text extraction. Range 0.00 to 100.00.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ocrProcessedFlag rdf:type rdf:Property ;
    rdfs:label 'Ocr Processed Flag' ;
    rdfs:comment 'Indicates whether the document has been processed through optical character recognition for text extraction.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:purgeEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Purge Eligible Date' ;
    rdfs:comment 'Date when the document becomes eligible for deletion per retention policy and regulatory requirements.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Free-text notes or comments entered by the reviewer regarding the document content or quality.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Status of underwriter review process for this document. Tracks progress through review workflow.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Timestamp' ;
    rdfs:comment 'Precise timestamp when the document review was completed. Captures exact moment of review completion.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:uploadDate rdf:type rdf:Property ;
    rdfs:label 'Upload Date' ;
    rdfs:comment 'Date when the document was uploaded or attached to the submission. Business event date.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uploadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Upload Timestamp' ;
    rdfs:comment 'Precise timestamp when the document was uploaded to the system. Captures exact moment of document receipt.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:uploadedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Uploaded By User Code' ;
    rdfs:comment 'System user identifier of the person who uploaded the document. Tracks accountability for document submission.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDate rdf:type rdf:Property ;
    rdfs:label 'Consent Date' ;
    rdfs:comment 'Date when this party provided consent for underwriting and rating activities.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentToRateFlag rdf:type rdf:Property ;
    rdfs:label 'Consent To Rate Flag' ;
    rdfs:comment 'Indicates whether this party has provided consent to be rated for insurance purposes.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insurableInterestType rdf:type rdf:Property ;
    rdfs:label 'Insurable Interest Type' ;
    rdfs:comment 'Type of insurable interest this party holds in the risk being underwritten.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryParty rdf:type rdf:Property ;
    rdfs:label 'Is Primary Party' ;
    rdfs:comment 'Indicates whether this party is the primary party for this role on the submission.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Date' ;
    rdfs:comment 'Date when KYC verification was completed for this party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:kycVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Status' ;
    rdfs:comment 'Status of Know Your Customer verification for this party at submission time.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lapseDurationDays rdf:type rdf:Property ;
    rdfs:label 'Lapse Duration Days' ;
    rdfs:comment 'Number of days of coverage lapse if prior coverage lapse flag is true.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossPayeeRank rdf:type rdf:Property ;
    rdfs:label 'Loss Payee Rank' ;
    rdfs:comment 'Priority ranking for loss payment distribution when multiple loss payees exist, applicable for loss payee roles.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mvrOrderedFlag rdf:type rdf:Property ;
    rdfs:label 'Mvr Ordered Flag' ;
    rdfs:comment 'Indicates whether a Motor Vehicle Record was ordered for this party, applicable for auto submissions.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partyRoleCode rdf:type rdf:Property ;
    rdfs:label 'Party Role Code' ;
    rdfs:comment 'The role this party plays in the submission context. [ENUM-REF-CANDIDATE: APPLICANT|NAMED_INSURED|ADDITIONAL_INSURED|PRODUCER|BROKER|AGENT|LOSS_PAYEE — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCoverageLapseFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Lapse Flag' ;
    rdfs:comment 'Indicates whether this party experienced a lapse in coverage prior to this submission.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:producerAppointmentStatus rdf:type rdf:Property ;
    rdfs:label 'Producer Appointment Status' ;
    rdfs:comment 'Status of the producer appointment at the time of submission, applicable for producer roles.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Producer Commission Rate' ;
    rdfs:comment 'Commission rate percentage applicable to this producer for this submission.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:producerNpn rdf:type rdf:Property ;
    rdfs:label 'Producer Npn' ;
    rdfs:comment 'National Producer Number for the producer party, required for producer and agent roles.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToApplicant rdf:type rdf:Property ;
    rdfs:label 'Relationship To Applicant' ;
    rdfs:comment 'Relationship of this party to the primary applicant on the submission. [ENUM-REF-CANDIDATE: SELF|SPOUSE|PARENT|CHILD|SIBLING|BUSINESS_PARTNER|EMPLOYEE|OTHER — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleSequence rdf:type rdf:Property ;
    rdfs:label 'Role Sequence' ;
    rdfs:comment 'Ordering sequence when multiple parties hold the same role on a submission.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:underwritingReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Underwriting Referral Flag' ;
    rdfs:comment 'Indicates whether this party triggered an underwriting referral during submission evaluation.' ;
    rdfs:domain ind:SubmissionParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearsWithPriorCarrier rdf:type rdf:Property ;
    rdfs:label 'Years With Prior Carrier' ;
    rdfs:comment 'Number of years this party was insured with the prior carrier, used for continuity credit evaluation.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:submissionStatusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Submission Status History Id' ;
    rdfs:comment 'Unique identifier for each submission status change record. Primary key.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:changedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Changed By Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Workflow audit trail requires party linkage for regulatory compliance (who touched submission when), SLA breach analysis, underwriter performance metrics, and fraud investigation support.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:referredToUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Referred To Underwriter Party Id' ;
    rdfs:comment 'Foreign key to the senior underwriter or manager to whom the submission was referred.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:coverageTransactionId rdf:type rdf:Property ;
    rdfs:label 'Coverage Transaction Id' ;
    rdfs:comment 'Unique transaction identifier from the source system for this status change event.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageTransaction .

ind:changedByRole rdf:type rdf:Property ;
    rdfs:label 'Changed By Role' ;
    rdfs:comment 'Business role of the user who changed the status, such as Underwriter, CSR, or System.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedByUserName rdf:type rdf:Property ;
    rdfs:label 'Changed By User Name' ;
    rdfs:comment 'Full name of the user who initiated this status change.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comments rdf:type rdf:Property ;
    rdfs:label 'Comments' ;
    rdfs:comment 'Free-text comments or notes entered by the user at the time of status change.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationHours rdf:type rdf:Property ;
    rdfs:label 'Duration Hours' ;
    rdfs:comment 'Number of hours the submission remained in this status. Null for current status.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaBreachHours rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Hours' ;
    rdfs:comment 'Number of hours by which the SLA was breached. Null if SLA was met.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statusCategory rdf:type rdf:Property ;
    rdfs:label 'Status Category' ;
    rdfs:comment 'High-level category grouping related statuses for workflow analytics.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusEffectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status Effective Timestamp' ;
    rdfs:comment 'Date and time when this status became effective. Primary business event timestamp for this record.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statusEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status End Timestamp' ;
    rdfs:comment 'Date and time when this status ended and transitioned to next status. Null for current status.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statusName rdf:type rdf:Property ;
    rdfs:label 'Status Name' ;
    rdfs:comment 'Human-readable name of the submission status.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Status Sequence Number' ;
    rdfs:comment 'Sequential order of this status change within the submission lifecycle. Starts at 1 for first status.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:systemSource rdf:type rdf:Property ;
    rdfs:label 'System Source' ;
    rdfs:comment 'Source system or module that recorded this status change, such as PolicyCenter or Underwriting Workbench.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Code' ;
    rdfs:comment 'Code indicating the reason for the status transition.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Description' ;
    rdfs:comment 'Detailed explanation of why the status changed.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionType rdf:type rdf:Property ;
    rdfs:label 'Transition Type' ;
    rdfs:comment 'Indicates whether the status change was automatic, manual, or system-triggered.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStage rdf:type rdf:Property ;
    rdfs:label 'Workflow Stage' ;
    rdfs:comment 'The workflow stage or phase associated with this status in the submission lifecycle.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingMvrReportId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Mvr Report Id' ;
    rdfs:comment 'Unique identifier for the Motor Vehicle Record report ordered during auto underwriting.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskexposureDriverId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Driver Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.driver. Business justification: MVR reports are ordered for specific drivers during auto underwriting. Direct link to driver entity is essential for driver-specific underwriting decisions, rate tier assignments' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Driver .

ind:underwritingDriverPartyId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Driver Party Id' ;
    rdfs:comment 'Reference to the party record of the driver whose Motor Vehicle Record was pulled.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:underwritingPartyId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Party Id' ;
    rdfs:comment 'Reference to the underwriter who reviewed the Motor Vehicle Record report.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:accidentCount rdf:type rdf:Property ;
    rdfs:label 'Accident Count' ;
    rdfs:comment 'Total number of accidents reported on the Motor Vehicle Record within the review period.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:atFaultAccidentCount rdf:type rdf:Property ;
    rdfs:label 'At Fault Accident Count' ;
    rdfs:comment 'Number of accidents where the driver was determined to be at fault.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declineRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Decline Recommended Flag' ;
    rdfs:comment 'Indicates whether the Motor Vehicle Record findings suggest the submission should be declined.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:driverLicenseClass rdf:type rdf:Property ;
    rdfs:label 'Driver License Class' ;
    rdfs:comment 'License class or type indicating the vehicle categories the driver is authorized to operate.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverLicenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Driver License Expiration Date' ;
    rdfs:comment 'Date when the driver license expires or expired.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driverLicenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'Driver License Issue Date' ;
    rdfs:comment 'Date when the driver license was originally issued.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driverLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Driver License Number' ;
    rdfs:comment 'Driver license number for which the Motor Vehicle Record was pulled.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverLicenseState rdf:type rdf:Property ;
    rdfs:label 'Driver License State' ;
    rdfs:comment 'State or jurisdiction that issued the driver license.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverLicenseStatus rdf:type rdf:Property ;
    rdfs:label 'Driver License Status' ;
    rdfs:comment 'Current status of the driver license as reported in the Motor Vehicle Record.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duiDwiCount rdf:type rdf:Property ;
    rdfs:label 'Dui Dwi Count' ;
    rdfs:comment 'Number of Driving Under the Influence or Driving While Intoxicated convictions reported on the Motor Vehicle Record.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:majorViolationCount rdf:type rdf:Property ;
    rdfs:label 'Major Violation Count' ;
    rdfs:comment 'Number of major violations such as Driving Under the Influence, reckless driving, or hit-and-run reported on the Motor Vehicle Record.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorViolationCount rdf:type rdf:Property ;
    rdfs:label 'Minor Violation Count' ;
    rdfs:comment 'Number of minor violations such as speeding or improper lane change reported on the Motor Vehicle Record.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mostRecentAccidentDate rdf:type rdf:Property ;
    rdfs:label 'Most Recent Accident Date' ;
    rdfs:comment 'Date of the most recent accident reported on the Motor Vehicle Record.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mostRecentViolationDate rdf:type rdf:Property ;
    rdfs:label 'Most Recent Violation Date' ;
    rdfs:comment 'Date of the most recent moving violation reported on the Motor Vehicle Record.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mvrScore rdf:type rdf:Property ;
    rdfs:label 'Mvr Score' ;
    rdfs:comment 'Numeric risk score assigned by the vendor based on the driver driving history.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrTier rdf:type rdf:Property ;
    rdfs:label 'Mvr Tier' ;
    rdfs:comment 'Risk tier classification assigned based on the Motor Vehicle Record findings.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportOrderDate rdf:type rdf:Property ;
    rdfs:label 'Report Order Date' ;
    rdfs:comment 'Date when the Motor Vehicle Record report was ordered from the vendor.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Report Order Number' ;
    rdfs:comment 'External order number or reference assigned by the Motor Vehicle Record vendor.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Report Received Date' ;
    rdfs:comment 'Date when the Motor Vehicle Record report was received from the vendor.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportStatus rdf:type rdf:Property ;
    rdfs:label 'Report Status' ;
    rdfs:comment 'Current status of the Motor Vehicle Record report in the underwriting workflow.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Review Period Years' ;
    rdfs:comment 'Number of years of driving history covered by this Motor Vehicle Record report.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspensionCount rdf:type rdf:Property ;
    rdfs:label 'Suspension Count' ;
    rdfs:comment 'Number of times the driver license has been suspended within the review period.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vendorReportNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Report Number' ;
    rdfs:comment 'Unique identifier assigned by the vendor to this Motor Vehicle Record report.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationCount rdf:type rdf:Property ;
    rdfs:label 'Violation Count' ;
    rdfs:comment 'Total number of moving violations reported on the Motor Vehicle Record within the review period.' ;
    rdfs:domain ind:UnderwritingMvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoDeclineFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Decline Flag' ;
    rdfs:comment 'Indicates whether this score triggered an automatic decline decision. True if risk is outside appetite.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoDeclineReason rdf:type rdf:Property ;
    rdfs:label 'Auto Decline Reason' ;
    rdfs:comment 'Business reason for automatic decline. Describes which rule or threshold caused the decline decision.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheScore rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Score' ;
    rdfs:comment 'Component score for catastrophe exposure including hurricane, earthquake, wildfire, and flood risk.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCount3yr rdf:type rdf:Property ;
    rdfs:label 'Claim Count 3yr' ;
    rdfs:comment 'Number of claims filed in the prior 3 years. Key indicator of loss frequency.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimCount5yr rdf:type rdf:Property ;
    rdfs:label 'Claim Count 5yr' ;
    rdfs:comment 'Number of claims filed in the prior 5 years. Extended loss history view for high-value risks.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clueScore rdf:type rdf:Property ;
    rdfs:label 'Clue Score' ;
    rdfs:comment 'Component score derived from prior loss history via CLUE database. Reflects historical claim frequency and severity.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeScore rdf:type rdf:Property ;
    rdfs:label 'Composite Score' ;
    rdfs:comment 'Overall composite risk score calculated by the model. Primary output of the scoring process.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copeScore rdf:type rdf:Property ;
    rdfs:label 'Cope Score' ;
    rdfs:comment 'Component score for property risk factors: construction type, occupancy class, fire protection, and external exposure.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:itvRatio rdf:type rdf:Property ;
    rdfs:label 'Itv Ratio' ;
    rdfs:comment 'Ratio of insured value to actual replacement cost. Used to assess adequacy of coverage limits.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lapseInCoverageDays rdf:type rdf:Property ;
    rdfs:label 'Lapse In Coverage Days' ;
    rdfs:comment 'Number of days without insurance coverage prior to this application. Zero indicates continuous coverage.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorCarrierScore rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Score' ;
    rdfs:comment 'Component score reflecting prior insurance history, carrier quality, and continuity of coverage.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreBand rdf:type rdf:Property ;
    rdfs:label 'Score Band' ;
    rdfs:comment 'Risk classification band derived from the composite score. Used for underwriting decisioning and pricing tier assignment.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreModelName rdf:type rdf:Property ;
    rdfs:label 'Score Model Name' ;
    rdfs:comment 'Name of the risk scoring model used (e.g., ISO ERC, proprietary UW model, third-party vendor model).' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreModelVersion rdf:type rdf:Property ;
    rdfs:label 'Score Model Version' ;
    rdfs:comment 'Version identifier of the scoring model used. Enables tracking of model changes over time.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreReasonCode1 rdf:type rdf:Property ;
    rdfs:label 'Score Reason Code 1' ;
    rdfs:comment 'Primary reason code explaining the score result. Top adverse action factor per FCRA requirements.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreReasonCode2 rdf:type rdf:Property ;
    rdfs:label 'Score Reason Code 2' ;
    rdfs:comment 'Secondary reason code explaining the score result. Second adverse action factor per FCRA requirements.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreReasonCode3 rdf:type rdf:Property ;
    rdfs:label 'Score Reason Code 3' ;
    rdfs:comment 'Tertiary reason code explaining the score result. Third adverse action factor per FCRA requirements.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreReasonCode4 rdf:type rdf:Property ;
    rdfs:label 'Score Reason Code 4' ;
    rdfs:comment 'Quaternary reason code explaining the score result. Fourth adverse action factor per FCRA requirements.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreRunCode rdf:type rdf:Property ;
    rdfs:label 'Score Run Code' ;
    rdfs:comment 'Unique identifier for the scoring batch or run. Enables traceability and audit of scoring execution.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoringEngine rdf:type rdf:Property ;
    rdfs:label 'Scoring Engine' ;
    rdfs:comment 'Name of the scoring engine or platform that executed the model (e.g., ISO ERC, Earnix, proprietary).' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalIncurred3yr rdf:type rdf:Property ;
    rdfs:label 'Total Incurred 3yr' ;
    rdfs:comment 'Total incurred loss amount (paid plus reserves) for claims in the prior 3 years. Measures loss severity.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uwReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Flag' ;
    rdfs:comment 'Indicates whether this score triggered a referral to manual underwriting review. True if referral required.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uwReferralReason rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Reason' ;
    rdfs:comment 'Business reason for underwriting referral. Describes which rule or threshold triggered manual review.' ;
    rdfs:domain ind:UnderwritingRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwConditionId rdf:type rdf:Property ;
    rdfs:label 'Uw Condition Id' ;
    rdfs:comment 'Unique identifier for the underwriting condition record.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:uwApprovedByUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Approved By Underwriter Party Id' ;
    rdfs:comment 'Reference to the underwriter or manager who approved the condition or its waiver.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:uwPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Party Id' ;
    rdfs:comment 'Reference to the underwriter party who imposed this condition.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:uwReferredToUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Referred To Underwriter Party Id' ;
    rdfs:comment 'Reference to the senior underwriter or manager to whom the condition was referred.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:uwWaivedByUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Waived By Underwriter Party Id' ;
    rdfs:comment 'Reference to the underwriter party who waived this condition.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:conditionNumber rdf:type rdf:Property ;
    rdfs:label 'Condition Number' ;
    rdfs:comment 'Business-facing identifier or sequence number for the condition within the submission or quote.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfilledDate rdf:type rdf:Property ;
    rdfs:label 'Fulfilled Date' ;
    rdfs:comment 'Date on which the condition was marked as fulfilled or satisfied.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fulfillmentMethod rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Method' ;
    rdfs:comment 'Method or mechanism by which the condition is expected to be fulfilled. [ENUM-REF-CANDIDATE: document_upload|inspection|survey|attestation|endorsement|payment|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentNotes rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Notes' ;
    rdfs:comment 'Additional notes or comments regarding the fulfillment of the condition.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBindingCondition rdf:type rdf:Property ;
    rdfs:label 'Is Binding Condition' ;
    rdfs:comment 'Indicates whether the condition must be fulfilled before the policy can be bound.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRenewalCondition rdf:type rdf:Property ;
    rdfs:label 'Is Renewal Condition' ;
    rdfs:comment 'Indicates whether the condition must be fulfilled before the policy can be renewed.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumImpactPercentage rdf:type rdf:Property ;
    rdfs:label 'Premium Impact Percentage' ;
    rdfs:comment 'Percentage by which the premium is adjusted if the condition is fulfilled or not fulfilled.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level assigned to the condition for tracking and fulfillment sequencing.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralRequired rdf:type rdf:Property ;
    rdfs:label 'Referral Required' ;
    rdfs:comment 'Indicates whether the condition requires referral to senior underwriting or management for approval.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waivedDate rdf:type rdf:Property ;
    rdfs:label 'Waived Date' ;
    rdfs:comment 'Date on which the condition was waived by the underwriter or authorized party.' ;
    rdfs:domain ind:UwCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uwApprovedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Approved By Party Id' ;
    rdfs:comment 'Reference to the party who provided final approval for the underwriting decision, if approval was required.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:appetiteMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Appetite Match Flag' ;
    rdfs:comment 'Indicates whether the submission aligns with the insurers current risk appetite and strategic guidelines.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignedUnderwriterName rdf:type rdf:Property ;
    rdfs:label 'Assigned Underwriter Name' ;
    rdfs:comment 'Full name of the underwriter who rendered this decision, for reporting and audit purposes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:automatedDecisionFlag rdf:type rdf:Property ;
    rdfs:label 'Automated Decision Flag' ;
    rdfs:comment 'Indicates whether the underwriting decision was rendered by an automated rules engine or AI model versus a human underwriter.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionsRequired rdf:type rdf:Property ;
    rdfs:label 'Conditions Required' ;
    rdfs:comment 'List of conditions or requirements that must be met for conditional acceptance, such as inspections, loss control measures, or additional documentation.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Decision Effective Date' ;
    rdfs:comment 'The date from which the underwriting decision becomes effective, relevant for conditional acceptances or modified terms.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Decision Expiration Date' ;
    rdfs:comment 'The date when the underwriting decision expires if not acted upon, typically for quotes or conditional offers.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionModelVersion rdf:type rdf:Property ;
    rdfs:label 'Decision Model Version' ;
    rdfs:comment 'Version identifier of the automated underwriting model or rules engine used to render the decision, for audit and reproducibility.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionNumber rdf:type rdf:Property ;
    rdfs:label 'Decision Number' ;
    rdfs:comment 'Business-facing unique identifier for the underwriting decision, used in correspondence and workflow tracking.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionRationale rdf:type rdf:Property ;
    rdfs:label 'Decision Rationale' ;
    rdfs:comment 'Detailed explanation of the reasoning behind the underwriting decision, including risk factors and business considerations.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionStatus rdf:type rdf:Property ;
    rdfs:label 'Decision Status' ;
    rdfs:comment 'Current lifecycle status of the underwriting decision within the workflow. [ENUM-REF-CANDIDATE: pending|in_review|approved|rejected|escalated|withdrawn|expired — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decision Timestamp' ;
    rdfs:comment 'The date and time when the underwriting decision was rendered by the underwriter.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:decisionType rdf:type rdf:Property ;
    rdfs:label 'Decision Type' ;
    rdfs:comment 'The type of underwriting decision rendered: accept, decline, refer to senior UW, modify terms, counter-offer, or conditional acceptance.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReasonCode rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Code' ;
    rdfs:comment 'Standardized code indicating the primary reason for declining the submission, aligned with regulatory disclosure requirements.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Description' ;
    rdfs:comment 'Human-readable description of the decline reason, provided to the applicant per regulatory requirements.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementsRequired rdf:type rdf:Property ;
    rdfs:label 'Endorsements Required' ;
    rdfs:comment 'List of endorsements or policy forms that must be attached as part of the underwriting decision.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionsAdded rdf:type rdf:Property ;
    rdfs:label 'Exclusions Added' ;
    rdfs:comment 'List of exclusions added to the policy as part of the underwriting decision to mitigate specific risks.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Modified Deductible Amount' ;
    rdfs:comment 'The revised deductible amount proposed by the underwriter if the decision type is modify or counter-offer.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Modified Limit Amount' ;
    rdfs:comment 'The revised coverage limit proposed by the underwriter if the decision type is modify or counter-offer.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Modified Premium Amount' ;
    rdfs:comment 'The revised premium amount proposed by the underwriter if the decision type is modify or counter-offer.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referralDueDate rdf:type rdf:Property ;
    rdfs:label 'Referral Due Date' ;
    rdfs:comment 'Service Level Agreement (SLA) due date by which the referral must be resolved to meet business commitments.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referralPriority rdf:type rdf:Property ;
    rdfs:label 'Referral Priority' ;
    rdfs:comment 'Priority level assigned to the referral, determining the urgency of senior underwriter review.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Referral Reason Description' ;
    rdfs:comment 'Detailed explanation of why the submission requires escalation or specialist review.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Underwriter Authority Level' ;
    rdfs:comment 'The authority level of the underwriter who made the decision, indicating approval limits and escalation tier.' ;
    rdfs:domain ind:UwDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwGuidelineId rdf:type rdf:Property ;
    rdfs:label 'Uw Guideline Id' ;
    rdfs:comment 'Unique identifier for the underwriting guideline document. Primary key.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catZoneRestrictions rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Restrictions' ;
    rdfs:comment 'List of catastrophe zones, flood zones, or high-hazard territories where coverage is restricted or requires special approval under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classRestrictions rdf:type rdf:Property ;
    rdfs:label 'Class Restrictions' ;
    rdfs:comment 'List of restricted or prohibited risk classes, SIC codes, NAICS codes, or business types that are ineligible under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Clue Required Flag' ;
    rdfs:comment 'Indicates whether a CLUE report is required to assess prior loss history under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageLimitsMax rdf:type rdf:Property ;
    rdfs:label 'Coverage Limits Max' ;
    rdfs:comment 'Maximum allowable coverage limit amount for policies underwritten under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageLimitsMin rdf:type rdf:Property ;
    rdfs:label 'Coverage Limits Min' ;
    rdfs:comment 'Minimum allowable coverage limit amount for policies underwritten under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditScoreMinThreshold rdf:type rdf:Property ;
    rdfs:label 'Credit Score Min Threshold' ;
    rdfs:comment 'Minimum acceptable credit score for eligibility under this guideline. Null if no threshold applies.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creditScoreRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Credit Score Required Flag' ;
    rdfs:comment 'Indicates whether a credit-based insurance score is required for underwriting under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:declinationReasons rdf:type rdf:Property ;
    rdfs:label 'Declination Reasons' ;
    rdfs:comment 'Documented reasons for automatic declination or rejection of submissions that fail to meet guideline criteria.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria' ;
    rdfs:comment 'Detailed eligibility requirements including acceptable risk classes, occupancy types, construction standards, and other qualifying factors.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guidelineCode rdf:type rdf:Property ;
    rdfs:label 'Guideline Code' ;
    rdfs:comment 'Business identifier code for the underwriting guideline, used for external reference and system integration.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guidelineName rdf:type rdf:Property ;
    rdfs:label 'Guideline Name' ;
    rdfs:comment 'Descriptive name of the underwriting guideline document.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guidelineType rdf:type rdf:Property ;
    rdfs:label 'Guideline Type' ;
    rdfs:comment 'Classification of the guideline purpose: risk appetite, eligibility screening, pricing constraints, coverage requirements, referral rules, or declination criteria.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossHistoryYears rdf:type rdf:Property ;
    rdfs:label 'Loss History Years' ;
    rdfs:comment 'Number of years of prior loss history required for underwriting evaluation under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mandatoryEndorsements rdf:type rdf:Property ;
    rdfs:label 'Mandatory Endorsements' ;
    rdfs:comment 'Required policy endorsements, forms, or coverage modifications that must be attached when this guideline applies.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxPriorClaimsAllowed rdf:type rdf:Property ;
    rdfs:label 'Max Prior Claims Allowed' ;
    rdfs:comment 'Maximum number of prior claims permitted within the loss history period for eligibility under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mvrRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Mvr Required Flag' ;
    rdfs:comment 'Indicates whether a motor vehicle record check is required for auto line underwriting under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pricingConstraints rdf:type rdf:Property ;
    rdfs:label 'Pricing Constraints' ;
    rdfs:comment 'Pricing rules, rate caps, minimum premiums, and other actuarial constraints that apply to quotes generated under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralTriggers rdf:type rdf:Property ;
    rdfs:label 'Referral Triggers' ;
    rdfs:comment 'Conditions or thresholds that require underwriter referral or senior approval before binding, such as high TIV, adverse loss history, or non-standard risks.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAppetiteDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Appetite Description' ;
    rdfs:comment 'Narrative description of acceptable risk criteria, target customer segments, and strategic underwriting objectives for this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tivMax rdf:type rdf:Property ;
    rdfs:label 'Tiv Max' ;
    rdfs:comment 'Maximum total insured value allowed for property risks under this guideline without senior underwriter approval.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tivMin rdf:type rdf:Property ;
    rdfs:label 'Tiv Min' ;
    rdfs:comment 'Minimum total insured value required for property risks under this guideline.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uwGuidelineStatus rdf:type rdf:Property ;
    rdfs:label 'Uw Guideline Status' ;
    rdfs:comment 'Current lifecycle status of the guideline document.' ;
    rdfs:domain ind:UwGuideline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwAssignedUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Assigned Underwriter Party Id' ;
    rdfs:comment 'Identifier of the senior underwriter or specialist assigned to review and resolve the referral.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:approvalConditions rdf:type rdf:Property ;
    rdfs:label 'Approval Conditions' ;
    rdfs:comment 'Specific conditions or requirements that must be met for approval, such as additional documentation, coverage modifications, or premium adjustments.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityLevelRequired rdf:type rdf:Property ;
    rdfs:label 'Authority Level Required' ;
    rdfs:comment 'Level of underwriting authority required to approve this referral based on risk, premium, or policy limits.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheExposureFlag rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Exposure Flag' ;
    rdfs:comment 'Indicates whether the referral involves significant catastrophe exposure requiring senior review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'Number of times the referral has been escalated to higher authority levels. Zero indicates no escalation.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastModifiedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User Code' ;
    rdfs:comment 'User identifier of the person or system that last modified the referral record.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralAssignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Referral Assigned Timestamp' ;
    rdfs:comment 'Date and time when the referral was assigned to a senior underwriter for review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referralCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Referral Created Timestamp' ;
    rdfs:comment 'Date and time when the referral was first created in the underwriting workbench.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referralType rdf:type rdf:Property ;
    rdfs:label 'Referral Type' ;
    rdfs:comment 'Type of transaction that triggered the referral: new business, renewal, endorsement, cancellation, reinstatement, or quote revision.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Concern Flag' ;
    rdfs:comment 'Indicates whether the referral involves regulatory compliance concerns requiring legal or compliance review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Required Flag' ;
    rdfs:comment 'Indicates whether reinsurance placement or facultative coverage is required as part of the referral review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Detailed notes from the reviewing underwriter explaining the resolution decision and any special conditions or requirements.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'Final decision outcome of the referral review: approved, approved with conditions, declined, withdrawn, escalated, or returned for rework.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Date and time when the referral was resolved with a final decision.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Target date by which the referral must be resolved per underwriting service level agreements.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:slaDueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sla Due Timestamp' ;
    rdfs:comment 'Precise date and time by which the referral must be resolved per underwriting service level agreements.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:catEventZoneImpactId rdf:type rdf:Property ;
    rdfs:label 'Cat Event Zone Impact Id' ;
    rdfs:comment 'Unique identifier for this catastrophe event zone impact record. Primary key.' ;
    rdfs:domain ind:CatEventZoneImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catastropheEventGeographyExposureId rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Event Geography Exposure Id' ;
    rdfs:comment 'Unique identifier for this catastrophe event geography exposure record. Primary key.' ;
    rdfs:domain ind:CatastropheEventGeographyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageInterestId rdf:type rdf:Property ;
    rdfs:label 'Coverage Interest Id' ;
    rdfs:comment 'Primary key for coverage_interest' ;
    rdfs:domain ind:CoverageInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificateRequired rdf:type rdf:Property ;
    rdfs:label 'Certificate Required' ;
    rdfs:comment 'Indicates whether this party requires a certificate of insurance for this coverage. Drives certificate issuance workflow.' ;
    rdfs:domain ind:CoverageInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryInterest rdf:type rdf:Property ;
    rdfs:label 'Is Primary Interest' ;
    rdfs:comment 'Indicates whether this is the primary insurable interest for this coverage. Drives first-loss payment priority.' ;
    rdfs:domain ind:CoverageInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverOfSubrogation rdf:type rdf:Property ;
    rdfs:label 'Waiver Of Subrogation' ;
    rdfs:comment 'Indicates whether the insurer has waived subrogation rights against this party for this coverage. Affects recovery processing.' ;
    rdfs:domain ind:CoverageInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageCessionId rdf:type rdf:Property ;
    rdfs:label 'Coverage Cession Id' ;
    rdfs:comment 'Primary key for coverage_cession' ;
    rdfs:domain ind:CoverageCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Id' ;
    rdfs:comment 'Unique surrogate identifier for the coverage eligibility record. Primary key.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cessionPriority rdf:type rdf:Property ;
    rdfs:label 'Cession Priority' ;
    rdfs:comment 'Numeric priority order when multiple agreements cover the same coverage type. Lower numbers cede first.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defaultCessionPct rdf:type rdf:Property ;
    rdfs:label 'Default Cession Pct' ;
    rdfs:comment 'Default percentage of premium and loss to cede for this coverage type under this agreement, subject to policy-level override.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Eligible Indicator' ;
    rdfs:comment 'True if this coverage type is eligible for cession under this agreement; false if explicitly excluded.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:producerCoverageAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Producer Coverage Authority Id' ;
    rdfs:comment 'Unique surrogate identifier for each producer-coverage authority record. Primary key.' ;
    rdfs:domain ind:ProducerCoverageAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorityLevel rdf:type rdf:Property ;
    rdfs:label 'Authority Level' ;
    rdfs:comment 'Level of binding authority granted: FULL_BIND allows binding without referral, QUOTE_ONLY requires underwriter approval, REFER_ALL prohibits binding, CONDITIONAL allows binding within limits.' ;
    rdfs:domain ind:ProducerCoverageAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxLimit rdf:type rdf:Property ;
    rdfs:label 'Max Limit' ;
    rdfs:comment 'Maximum coverage limit in USD the producer may bind for this coverage type without underwriter referral. Null if no limit applies or authority is REFER_ALL.' ;
    rdfs:domain ind:ProducerCoverageAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referralThreshold rdf:type rdf:Property ;
    rdfs:label 'Referral Threshold' ;
    rdfs:comment 'Premium or TIV threshold above which producer must refer the risk to underwriting even if binding authority is granted. Null if no threshold applies.' ;
    rdfs:domain ind:ProducerCoverageAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agencyCoverageAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Agency Coverage Appointment Id' ;
    rdfs:comment 'Unique identifier for the agency coverage appointment. Primary key.' ;
    rdfs:domain ind:AgencyCoverageAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typePerilId rdf:type rdf:Property ;
    rdfs:label 'Type Peril Id' ;
    rdfs:comment 'Unique identifier for this coverage type peril applicability record. Primary key.' ;
    rdfs:domain ind:TypePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typeCoverageTypeId rdf:type rdf:Property ;
    rdfs:label 'Type Coverage Type Id' ;
    rdfs:comment 'Foreign key linking to the coverage type being configured.' ;
    rdfs:domain ind:TypePeril ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageType .

ind:isStandardCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Standard Coverage' ;
    rdfs:comment 'True if this peril is covered by default under this coverage type; false if endorsement or separate election is required.' ;
    rdfs:domain ind:TypePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateTableAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Rate Table Authorization Id' ;
    rdfs:comment 'Unique identifier for this rate table authorization record. Primary key.' ;
    rdfs:domain ind:RateTableAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviationPercentageLimit rdf:type rdf:Property ;
    rdfs:label 'Deviation Percentage Limit' ;
    rdfs:comment 'Maximum percentage the producer may deviate from the published rate table without referral.' ;
    rdfs:domain ind:RateTableAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treatyLayerPerilTermId rdf:type rdf:Property ;
    rdfs:label 'Treaty Layer Peril Term Id' ;
    rdfs:comment 'Unique surrogate identifier for this treaty layer peril term record. Primary key.' ;
    rdfs:domain ind:TreatyLayerPerilTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:perilAttachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Peril Attachment Point' ;
    rdfs:comment 'Dollar amount of loss per occurrence for this specific peril at which the reinsurance layer begins to respond. May differ from the layer-wide attachment point.' ;
    rdfs:domain ind:TreatyLayerPerilTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilCessionPct rdf:type rdf:Property ;
    rdfs:label 'Peril Cession Pct' ;
    rdfs:comment 'Percentage of loss within this layer ceded to reinsurers for this specific peril. May differ from the layer-wide cession percentage to reflect peril-specific risk appetite.' ;
    rdfs:domain ind:TreatyLayerPerilTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilInclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Peril Inclusion Flag' ;
    rdfs:comment 'Indicates whether this peril is explicitly included in the treaty layer coverage. False indicates exclusion or sublimit application.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perilLimit rdf:type rdf:Property ;
    rdfs:label 'Peril Limit' ;
    rdfs:comment 'Maximum dollar amount recoverable from reinsurers under this layer for a single occurrence of this specific peril. May differ from the layer-wide limit.' ;
    rdfs:domain ind:TreatyLayerPerilTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilRetention rdf:type rdf:Property ;
    rdfs:label 'Peril Retention' ;
    rdfs:comment 'Dollar amount of loss for this specific peril that the cedant retains before the reinsurance layer responds. May differ from the layer-wide retention.' ;
    rdfs:domain ind:TreatyLayerPerilTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilRolPct rdf:type rdf:Property ;
    rdfs:label 'Peril Rol Pct' ;
    rdfs:comment 'Rate on Line expressed as a decimal for this specific peril; the reinsurance premium for this peril divided by the peril-specific limit. Reflects peril-specific pricing.' ;
    rdfs:domain ind:TreatyLayerPerilTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilSublimitFlag rdf:type rdf:Property ;
    rdfs:label 'Peril Sublimit Flag' ;
    rdfs:comment 'Indicates whether this peril is subject to a sublimit within the treaty layer, requiring separate tracking of aggregate exposure and exhaustion.' ;
    rdfs:domain ind:TreatyLayerPerilTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:agreementPerilCoverageId rdf:type rdf:Property ;
    rdfs:label 'Agreement Peril Coverage Id' ;
    rdfs:comment 'Unique surrogate identifier for the agreement peril coverage record. Primary key.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:perilAttachmentPointAmt rdf:type rdf:Property ;
    rdfs:label 'Peril Attachment Point Amt' ;
    rdfs:comment 'Loss threshold at which reinsurance coverage attaches for this specific peril, if different from agreement-level attachment.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilCoverageBasis rdf:type rdf:Property ;
    rdfs:label 'Peril Coverage Basis' ;
    rdfs:comment 'Coverage trigger basis specific to this peril: Losses Occurring, Claims Made, or Risk Attaching.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilExclusionClause rdf:type rdf:Property ;
    rdfs:label 'Peril Exclusion Clause' ;
    rdfs:comment 'Text of the exclusion clause or endorsement reference if the peril is excluded from coverage under this agreement.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilReinstatementProvision rdf:type rdf:Property ;
    rdfs:label 'Peril Reinstatement Provision' ;
    rdfs:comment 'Special reinstatement terms applicable to this peril, such as limited reinstatements for CAT perils.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilSpecificRetentionAmt rdf:type rdf:Property ;
    rdfs:label 'Peril Specific Retention Amt' ;
    rdfs:comment 'Cedant retention amount specific to this peril, if different from the agreement-level retention.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilSublimitAmt rdf:type rdf:Property ;
    rdfs:label 'Peril Sublimit Amt' ;
    rdfs:comment 'Maximum reinsurance recovery amount specific to this peril within the agreement, if different from the overall limit.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilTerritoryRestriction rdf:type rdf:Property ;
    rdfs:label 'Peril Territory Restriction' ;
    rdfs:comment 'Geographic scope restriction specific to this peril within the agreement, if narrower than the overall territory scope.' ;
    rdfs:domain ind:AgreementPerilCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyZoneTermsId rdf:type rdf:Property ;
    rdfs:label 'Treaty Zone Terms Id' ;
    rdfs:comment 'Unique surrogate identifier for a treaty zone terms record. Primary key.' ;
    rdfs:domain ind:TreatyZoneTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:underwritingRestrictionCode rdf:type rdf:Property ;
    rdfs:label 'Underwriting Restriction Code' ;
    rdfs:comment 'Code indicating underwriting restrictions imposed by reinsurers for this zone under this treaty: none, moratorium, reduced limit, increased retention, or excluded.' ;
    rdfs:domain ind:TreatyZoneTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneAttachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Zone Attachment Point' ;
    rdfs:comment 'Dollar amount at which reinsurance coverage attaches for losses in this catastrophe zone. Used for zone-specific excess of loss structuring.' ;
    rdfs:domain ind:TreatyZoneTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zoneCessionPct rdf:type rdf:Property ;
    rdfs:label 'Zone Cession Pct' ;
    rdfs:comment 'Percentage of risk ceded to reinsurers for policies in this catastrophe zone under this treaty. May differ from treaty-level cession percentage for concentration management.' ;
    rdfs:domain ind:TreatyZoneTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zoneExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Zone Exclusion Flag' ;
    rdfs:comment 'Indicates whether this catastrophe zone is explicitly excluded from reinsurance coverage under this treaty. Used for high-risk zone carve-outs.' ;
    rdfs:domain ind:TreatyZoneTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zoneLimit rdf:type rdf:Property ;
    rdfs:label 'Zone Limit' ;
    rdfs:comment 'Maximum reinsurance recovery available under this treaty for losses occurring in this catastrophe zone. Used for concentration control and regulatory capital optimization.' ;
    rdfs:domain ind:TreatyZoneTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zoneRetentionAmt rdf:type rdf:Property ;
    rdfs:label 'Zone Retention Amt' ;
    rdfs:comment 'Cedant net retained loss amount before reinsurance attaches for losses in this catastrophe zone. May be higher than treaty-level retention for high-risk zones.' ;
    rdfs:domain ind:TreatyZoneTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facultativeQuotationId rdf:type rdf:Property ;
    rdfs:label 'Facultative Quotation Id' ;
    rdfs:comment 'Unique surrogate identifier for each facultative quotation record. Primary key.' ;
    rdfs:domain ind:FacultativeQuotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facultativeMarketingId rdf:type rdf:Property ;
    rdfs:label 'Facultative Marketing Id' ;
    rdfs:comment 'Foreign key linking to coverage.facultative_marketing. Business justification: Facultative quotations result from marketing activity. Currently facultative_quotation links to quote and reinsurer, but not to the marketing activity that generated it.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacultativeMarketing .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'Date on which the ceding company accepted the reinsurer\'s facultative quotation.' ;
    rdfs:domain ind:FacultativeQuotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokeragePercentage rdf:type rdf:Property ;
    rdfs:label 'Brokerage Percentage' ;
    rdfs:comment 'Brokerage fee percentage applicable to this facultative quotation if placed through a broker.' ;
    rdfs:domain ind:FacultativeQuotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quotedSharePercentage rdf:type rdf:Property ;
    rdfs:label 'Quoted Share Percentage' ;
    rdfs:comment 'Percentage of the risk that the reinsurer is willing to assume under this facultative quotation.' ;
    rdfs:domain ind:FacultativeQuotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termsAndConditions rdf:type rdf:Property ;
    rdfs:label 'Terms And Conditions' ;
    rdfs:comment 'Special terms, conditions, or exclusions attached to the reinsurer\'s facultative quotation.' ;
    rdfs:domain ind:FacultativeQuotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactDate rdf:type rdf:Property ;
    rdfs:label 'Contact Date' ;
    rdfs:comment 'Date on which the reinsurer was contacted or approached regarding this submission.' ;
    rdfs:domain ind:FacultativeMarketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indicativeRate rdf:type rdf:Property ;
    rdfs:label 'Indicative Rate' ;
    rdfs:comment 'Indicative facultative rate or pricing percentage provided by the reinsurer during marketing phase.' ;
    rdfs:domain ind:FacultativeMarketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indicativeTermsProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Indicative Terms Provided Flag' ;
    rdfs:comment 'Boolean flag indicating whether the reinsurer provided indicative terms or pricing for this submission.' ;
    rdfs:domain ind:FacultativeMarketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketingStatus rdf:type rdf:Property ;
    rdfs:label 'Marketing Status' ;
    rdfs:comment 'Current status of the facultative marketing effort with this reinsurer for this submission.' ;
    rdfs:domain ind:FacultativeMarketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerInterestLevel rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Interest Level' ;
    rdfs:comment 'Categorical assessment of the reinsurers interest in participating on this submission.' ;
    rdfs:domain ind:FacultativeMarketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDate rdf:type rdf:Property ;
    rdfs:label 'Response Date' ;
    rdfs:comment 'Date on which the reinsurer responded with their interest level or indicative terms.' ;
    rdfs:domain ind:FacultativeMarketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyProducerPolicyId rdf:type rdf:Property ;
    rdfs:label 'Policy Producer Policy Id' ;
    rdfs:comment 'Primary key for policy_producer_policy' ;
    rdfs:domain ind:PolicyProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:producerAgencyAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Producer Agency Appointment Id' ;
    rdfs:comment 'Unique surrogate identifier for each producer-agency appointment record. Primary key.' ;
    rdfs:domain ind:ProducerAgencyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:changeDescription rdf:type rdf:Property ;
    rdfs:label 'Change Description' ;
    rdfs:comment 'Detailed narrative describing the specific changes made to this coverage in this transaction. Printed on endorsement declarations.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCoverageAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Is Coverage Added Flag' ;
    rdfs:comment 'Indicates whether this transaction added this coverage to the policy. True for new coverages added via endorsement.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCoverageRemovedFlag rdf:type rdf:Property ;
    rdfs:label 'Is Coverage Removed Flag' ;
    rdfs:comment 'Indicates whether this transaction removed this coverage from the policy. True for coverages deleted via endorsement or cancellation.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'New Deductible Amount' ;
    rdfs:comment 'Deductible amount after this transaction. Null if deductible unchanged.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newLimitAmount rdf:type rdf:Property ;
    rdfs:label 'New Limit Amount' ;
    rdfs:comment 'Coverage limit after this transaction was applied. Current limit for this coverage as of this transaction.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Change Amount' ;
    rdfs:comment 'Net change in written premium for this specific coverage resulting from this transaction. Positive for increases, negative for decreases.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Deductible Amount' ;
    rdfs:comment 'Deductible amount before this transaction. Null if deductible unchanged.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Limit Amount' ;
    rdfs:comment 'Coverage limit before this transaction was applied. Used for audit trail and premium calculation verification.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proratedPremiumFactor rdf:type rdf:Property ;
    rdfs:label 'Prorated Premium Factor' ;
    rdfs:comment 'Proration factor applied to calculate premium change for midterm transactions. Based on days remaining in term.' ;
    rdfs:domain ind:CoverageTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:formAttachmentId rdf:type rdf:Property ;
    rdfs:label 'Form Attachment Id' ;
    rdfs:comment 'Unique identifier for the coverage form attachment record. Primary key.' ;
    rdfs:domain ind:FormAttachment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Form Premium Amount' ;
    rdfs:comment 'The additional premium amount charged for this form attachment on this specific coverage, if premium-bearing.' ;
    rdfs:domain ind:FormAttachment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attachmentAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Attachment Allowed Flag' ;
    rdfs:comment 'Indicates whether attachments such as invoices or policy documents can be included with this notice.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentType rdf:type rdf:Property ;
    rdfs:label 'Attachment Type' ;
    rdfs:comment 'Type of document or file that may be attached to notices generated from this template.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:footerText rdf:type rdf:Property ;
    rdfs:label 'Footer Text' ;
    rdfs:comment 'Standard footer text included at the bottom of all notices generated from this template.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUsedDate rdf:type rdf:Property ;
    rdfs:label 'Last Used Date' ;
    rdfs:comment 'Most recent date on which this template was used to generate a notice.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalDisclaimer rdf:type rdf:Property ;
    rdfs:label 'Legal Disclaimer' ;
    rdfs:comment 'Legal disclaimer or compliance statement required to be included in the notice.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeFieldList rdf:type rdf:Property ;
    rdfs:label 'Merge Field List' ;
    rdfs:comment 'Comma-separated list of merge field names available for dynamic data insertion in this template.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Reference' ;
    rdfs:comment 'Reference to the specific regulatory statute, rule, or requirement that mandates this notice.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replyToEmail rdf:type rdf:Property ;
    rdfs:label 'Reply To Email' ;
    rdfs:comment 'Email address to which recipient replies should be directed for notices generated from this template.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryCountLimit rdf:type rdf:Property ;
    rdfs:label 'Retry Count Limit' ;
    rdfs:comment 'Maximum number of delivery retry attempts allowed for notices generated from this template.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sendTimingRule rdf:type rdf:Property ;
    rdfs:label 'Send Timing Rule' ;
    rdfs:comment 'Business rule defining when the notice should be sent relative to a triggering event, such as days before due date.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:senderEmail rdf:type rdf:Property ;
    rdfs:label 'Sender Email' ;
    rdfs:comment 'Email address from which notices are sent when using this template.' ;
    rdfs:domain ind:NoticeTemplate ;
