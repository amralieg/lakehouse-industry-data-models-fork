    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialNeedsDescription rdf:type rdf:Property ;
    rdfs:label 'Special Needs Description' ;
    rdfs:comment 'Description of special accommodations or accessibility requirements requested by the passenger.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatFlag rdf:type rdf:Property ;
    rdfs:label 'Hazmat Flag' ;
    rdfs:comment 'Indicates whether the vehicle is carrying hazardous materials requiring special handling.' ;
    rdfs:domain ind:Reservation ;
