ind:assessedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Assessed Value Amount' ;
    rdfs:comment 'Current assessed value of the vehicle for property tax purposes as determined by county tax assessor.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
