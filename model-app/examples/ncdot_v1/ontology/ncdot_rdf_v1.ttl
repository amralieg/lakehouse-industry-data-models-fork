ind:spanOfControlMax rdf:type rdf:Property ;
    rdfs:label 'Span Of Control Max' ;
    rdfs:comment 'Maximum number of direct reports typically expected for supervisory positions in this grade.' ;
    rdfs:domain ind:SalaryGrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

