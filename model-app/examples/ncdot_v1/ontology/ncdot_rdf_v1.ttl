ind:sailingStatus rdf:type rdf:Property ;
    rdfs:label 'Sailing Status' ;
    rdfs:comment 'Current operational status of the scheduled sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sailingType rdf:type rdf:Property ;
    rdfs:label 'Sailing Type' ;
    rdfs:comment 'Classification of the sailing based on its purpose and service level.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceDayType rdf:type rdf:Property ;
    rdfs:label 'Service Day Type' ;
    rdfs:comment 'Classification of the day on which the sailing occurs, used for schedule planning and capacity management.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonCode rdf:type rdf:Property ;
    rdfs:label 'Season Code' ;
    rdfs:comment 'Code representing the operational season during which this sailing is scheduled (e.g., SUMMER, WINTER, PEAK).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availableVehicleSpaces rdf:type rdf:Property ;
    rdfs:label 'Available Vehicle Spaces' ;
    rdfs:comment 'Number of vehicle spaces currently available for booking on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:availablePassengerSpaces rdf:type rdf:Property ;
    rdfs:label 'Available Passenger Spaces' ;
    rdfs:comment 'Number of passenger spaces currently available for booking on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reservedVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Reserved Vehicle Count' ;
    rdfs:comment 'Number of vehicles that have been reserved for this sailing through advance booking.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reservedPassengerCount rdf:type rdf:Property ;
    rdfs:label 'Reserved Passenger Count' ;
    rdfs:comment 'Number of passengers that have been reserved for this sailing through advance booking.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standbyVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Standby Vehicle Count' ;
    rdfs:comment 'Number of vehicles currently on standby waiting for available space on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standbyPassengerCount rdf:type rdf:Property ;
    rdfs:label 'Standby Passenger Count' ;
    rdfs:comment 'Number of passengers currently on standby waiting for available space on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reservationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reservation Required Flag' ;
    rdfs:comment 'Indicates whether advance reservation is required for this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reservationOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reservation Open Timestamp' ;
    rdfs:comment 'Date and time when reservations for this sailing become available for booking.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reservationCloseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reservation Close Timestamp' ;
    rdfs:comment 'Date and time when reservations for this sailing are no longer accepted.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fareScheduleId rdf:type rdf:Property ;
    rdfs:label 'Fare Schedule Id' ;
    rdfs:comment 'Identifier for the fare schedule applicable to this sailing, determining pricing for vehicles and passengers.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Schedule .

ind:baseVehicleFareAmount rdf:type rdf:Property ;
    rdfs:label 'Base Vehicle Fare Amount' ;
    rdfs:comment 'Standard fare amount charged for a standard vehicle on this sailing, in US dollars.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basePassengerFareAmount rdf:type rdf:Property ;
    rdfs:label 'Base Passenger Fare Amount' ;
    rdfs:comment 'Standard fare amount charged for a passenger on this sailing, in US dollars.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crewAssignedCount rdf:type rdf:Property ;
    rdfs:label 'Crew Assigned Count' ;
    rdfs:comment 'Number of crew members assigned to operate this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:captainName rdf:type rdf:Property ;
    rdfs:label 'Captain Name' ;
    rdfs:comment 'Name of the captain assigned to command this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditionCode rdf:type rdf:Property ;
    rdfs:label 'Weather Condition Code' ;
    rdfs:comment 'Code representing the forecasted or actual weather conditions for this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windSpeedKnots rdf:type rdf:Property ;
    rdfs:label 'Wind Speed Knots' ;
    rdfs:comment 'Wind speed at the time of sailing, measured in knots.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waveHeightFeet rdf:type rdf:Property ;
    rdfs:label 'Wave Height Feet' ;
    rdfs:comment 'Significant wave height at the time of sailing, measured in feet.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:visibilityMiles rdf:type rdf:Property ;
    rdfs:label 'Visibility Miles' ;
    rdfs:comment 'Visibility distance at the time of sailing, measured in statute miles.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureFahrenheit rdf:type rdf:Property ;
    rdfs:label 'Temperature Fahrenheit' ;
    rdfs:comment 'Air temperature at the time of sailing, measured in degrees Fahrenheit.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Alert Flag' ;
    rdfs:comment 'Indicates whether a weather alert or advisory is in effect that may impact this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Code indicating the reason for sailing cancellation, if applicable.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Description' ;
    rdfs:comment 'Detailed description of the reason for sailing cancellation.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delayMinutes rdf:type rdf:Property ;
    rdfs:label 'Delay Minutes' ;
    rdfs:comment 'Number of minutes by which the sailing was delayed from its scheduled departure time.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delayReasonCode rdf:type rdf:Property ;
    rdfs:label 'Delay Reason Code' ;
    rdfs:comment 'Code indicating the primary reason for sailing delay.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delayReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Delay Reason Description' ;
    rdfs:comment 'Detailed description of the reason for sailing delay.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualDepartureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Departure Timestamp' ;
    rdfs:comment 'Actual date and time when the vessel departed from the origin terminal.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualArrivalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Arrival Timestamp' ;
    rdfs:comment 'Actual date and time when the vessel arrived at the destination terminal.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Actual Duration Minutes' ;
    rdfs:comment 'Actual duration of the sailing from departure to arrival, measured in minutes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:boardingStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Boarding Start Timestamp' ;
    rdfs:comment 'Date and time when boarding of vehicles and passengers began for this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:boardingEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Boarding End Timestamp' ;
    rdfs:comment 'Date and time when boarding of vehicles and passengers was completed for this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Actual Vehicle Count' ;
    rdfs:comment 'Actual number of vehicles that boarded and traveled on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualPassengerCount rdf:type rdf:Property ;
    rdfs:label 'Actual Passenger Count' ;
    rdfs:comment 'Actual number of passengers that boarded and traveled on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commercialVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Commercial Vehicle Count' ;
    rdfs:comment 'Number of commercial vehicles (trucks, buses, etc.) that traveled on this sailing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oversizedVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Oversized Vehicle Count' ;
    rdfs:comment 'Number of oversized vehicles requiring special accommodation that traveled on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:motorcycleCount rdf:type rdf:Property ;
    rdfs:label 'Motorcycle Count' ;
    rdfs:comment 'Number of motorcycles that traveled on this sailing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bicycleCount rdf:type rdf:Property ;
    rdfs:label 'Bicycle Count' ;
    rdfs:comment 'Number of bicycles that traveled on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pedestrianCount rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Count' ;
    rdfs:comment 'Number of walk-on passengers without vehicles that traveled on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adaPassengerCount rdf:type rdf:Property ;
    rdfs:label 'Ada Passenger Count' ;
    rdfs:comment 'Number of passengers requiring Americans with Disabilities Act (ADA) accommodations on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorityBoardingCount rdf:type rdf:Property ;
    rdfs:label 'Priority Boarding Count' ;
    rdfs:comment 'Number of vehicles or passengers granted priority boarding status for this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hazmatVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Hazmat Vehicle Count' ;
    rdfs:comment 'Number of vehicles carrying hazardous materials that traveled on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hazmatPermitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Hazmat Permit Required Flag' ;
    rdfs:comment 'Indicates whether special permits are required for hazardous materials transport on this sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fuelConsumptionGallons rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumption Gallons' ;
    rdfs:comment 'Amount of fuel consumed by the vessel during this sailing, measured in gallons.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsCo2Kg rdf:type rdf:Property ;
    rdfs:label 'Emissions Co2 Kg' ;
    rdfs:comment 'Estimated carbon dioxide emissions produced during this sailing, measured in kilograms.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incidentFlag rdf:type rdf:Property ;
    rdfs:label 'Incident Flag' ;
    rdfs:comment 'Indicates whether any safety or operational incident occurred during this sailing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentTypeCode rdf:type rdf:Property ;
    rdfs:label 'Incident Type Code' ;
    rdfs:comment 'Code classifying the type of incident that occurred during the sailing, if applicable.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentDescription rdf:type rdf:Property ;
    rdfs:label 'Incident Description' ;
    rdfs:comment 'Detailed description of any incident that occurred during the sailing.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Incident Reported Flag' ;
    rdfs:comment 'Indicates whether the incident was formally reported to regulatory authorities.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maintenanceFlag rdf:type rdf:Property ;
    rdfs:label 'Maintenance Flag' ;
    rdfs:comment 'Indicates whether this sailing is designated for vessel maintenance or testing purposes.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Inspection Required Flag' ;
    rdfs:comment 'Indicates whether a regulatory inspection is required before or after this sailing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publishedFlag rdf:type rdf:Property ;
    rdfs:label 'Published Flag' ;
    rdfs:comment 'Indicates whether this sailing schedule has been published to the public through official channels.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publishedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Published Timestamp' ;
    rdfs:comment 'Date and time when this sailing schedule was published to the public.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Version Number' ;
    rdfs:comment 'Version number of the schedule, incremented when changes are made to the sailing details.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'Date when this sailing schedule becomes effective and operational.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'Date when this sailing schedule is no longer effective and is superseded by a new schedule.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicAnnouncement rdf:type rdf:Property ;
    rdfs:label 'Public Announcement' ;
    rdfs:comment 'Public-facing announcement or message regarding this sailing, such as service alerts or special notices.' ;
    rdfs:domain ind:SailingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminalId rdf:type rdf:Property ;
    rdfs:label 'Terminal Id' ;
    rdfs:comment 'Unique identifier for the ferry terminal. Primary key for the terminal master data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Terminal .

ind:waterBodyName rdf:type rdf:Property ;
    rdfs:label 'Water Body Name' ;
    rdfs:comment 'Name of the water body (sound, river, inlet, etc.) where the terminal is located.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dockCount rdf:type rdf:Property ;
    rdfs:label 'Dock Count' ;
    rdfs:comment 'Total number of docking berths available at the terminal for ferry vessels.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parkingSpaces rdf:type rdf:Property ;
    rdfs:label 'Parking Spaces' ;
    rdfs:comment 'Total number of parking spaces available at the terminal for long-term and short-term parking.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:restroomFacilities rdf:type rdf:Property ;
    rdfs:label 'Restroom Facilities' ;
    rdfs:comment 'Indicates whether public restroom facilities are available at the terminal.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waitingArea rdf:type rdf:Property ;
    rdfs:label 'Waiting Area' ;
    rdfs:comment 'Indicates whether a covered or enclosed waiting area is available for passengers.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ticketingOffice rdf:type rdf:Property ;
    rdfs:label 'Ticketing Office' ;
    rdfs:comment 'Indicates whether a staffed ticketing office is present at the terminal.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:foodService rdf:type rdf:Property ;
    rdfs:label 'Food Service' ;
    rdfs:comment 'Indicates whether food or beverage services (vending machines, concessions, etc.) are available at the terminal.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:securityCameras rdf:type rdf:Property ;
    rdfs:label 'Security Cameras' ;
    rdfs:comment 'Indicates whether CCTV security camera systems are installed at the terminal.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lightingType rdf:type rdf:Property ;
    rdfs:label 'Lighting Type' ;
    rdfs:comment 'Primary type of lighting system installed at the terminal for nighttime operations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelStation rdf:type rdf:Property ;
    rdfs:label 'Fuel Station' ;
    rdfs:comment 'Indicates whether a fuel station for ferry vessels is located at or adjacent to the terminal.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maintenanceFacility rdf:type rdf:Property ;
    rdfs:label 'Maintenance Facility' ;
    rdfs:comment 'Indicates whether vessel maintenance and repair facilities are available at the terminal.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatingHoursStart rdf:type rdf:Property ;
    rdfs:label 'Operating Hours Start' ;
    rdfs:comment 'Standard daily opening time for terminal operations in HH:MM format (24-hour clock).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingHoursEnd rdf:type rdf:Property ;
    rdfs:label 'Operating Hours End' ;
    rdfs:comment 'Standard daily closing time for terminal operations in HH:MM format (24-hour clock).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operates24Hours rdf:type rdf:Property ;
    rdfs:label 'Operates 24 Hours' ;
    rdfs:comment 'Indicates whether the terminal operates continuously 24 hours per day.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalOperation rdf:type rdf:Property ;
    rdfs:label 'Seasonal Operation' ;
    rdfs:comment 'Indicates whether the terminal operates only during specific seasons rather than year-round.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalStartMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal Start Month' ;
    rdfs:comment 'Month number (1-12) when seasonal operations begin, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalEndMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal End Month' ;
    rdfs:comment 'Month number (1-12) when seasonal operations end, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionYear rdf:type rdf:Property ;
    rdfs:label 'Construction Year' ;
    rdfs:comment 'Year when the terminal was originally constructed and opened for operations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastRenovationYear rdf:type rdf:Property ;
    rdfs:label 'Last Renovation Year' ;
    rdfs:comment 'Year when the terminal last underwent major renovation or reconstruction.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityCondition rdf:type rdf:Property ;
    rdfs:label 'Facility Condition' ;
    rdfs:comment 'Overall condition assessment of the terminal facilities based on inspection and maintenance records.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dockDepthFeet rdf:type rdf:Property ;
    rdfs:label 'Dock Depth Feet' ;
    rdfs:comment 'Water depth at the dock in feet, measured at mean low water, indicating the maximum vessel draft that can be accommodated.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approachChannelDepthFeet rdf:type rdf:Property ;
    rdfs:label 'Approach Channel Depth Feet' ;
    rdfs:comment 'Depth of the approach channel leading to the terminal in feet, measured at mean low water.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waveProtection rdf:type rdf:Property ;
    rdfs:label 'Wave Protection' ;
    rdfs:comment 'Type of wave protection or shelter provided to the terminal docking area.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tidalRangeFeet rdf:type rdf:Property ;
    rdfs:label 'Tidal Range Feet' ;
    rdfs:comment 'Average tidal range at the terminal location in feet, representing the difference between high and low tide.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyAccessRoute rdf:type rdf:Property ;
    rdfs:label 'Emergency Access Route' ;
    rdfs:comment 'Description of the primary emergency vehicle access route to the terminal.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evacuationCapacity rdf:type rdf:Property ;
    rdfs:label 'Evacuation Capacity' ;
    rdfs:comment 'Maximum number of people that can be evacuated from the terminal per hour during emergency operations.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stormSurgeElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Storm Surge Elevation Feet' ;
    rdfs:comment 'Design elevation in feet above mean sea level for storm surge protection, indicating the terminal\'s resilience to flooding.' ;
    rdfs:domain ind:Terminal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:floodZone rdf:type rdf:Property ;
    rdfs:label 'Flood Zone' ;
