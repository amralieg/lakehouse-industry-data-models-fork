    rdfs:comment 'Amount of premium earned during the accounting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'Exchange rate applied to convert foreign currency premium to reporting currency.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureDays rdf:type rdf:Property ;
    rdfs:label 'Exposure Days' ;
    rdfs:comment 'Number of days of exposure covered by this earned premium transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gaapRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Gaap Revenue Amount' ;
    rdfs:comment 'Earned premium recognized as revenue under GAAP accounting standards.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ifrs17RevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Ifrs17 Revenue Amount' ;
    rdfs:comment 'Earned premium recognized under IFRS 17 premium allocation approach.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netEpAmount rdf:type rdf:Property ;
    rdfs:label 'Net Ep Amount' ;
    rdfs:comment 'Earned premium retained by the insurer after reinsurance cessions.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postingDate rdf:type rdf:Property ;
