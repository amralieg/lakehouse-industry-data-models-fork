    rdfs:range xsd:dateTime .

ind:priorityBoardingFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Boarding Flag' ;
    rdfs:comment 'Indicates whether the reservation qualifies for priority boarding privileges.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waitlistPosition rdf:type rdf:Property ;
    rdfs:label 'Waitlist Position' ;
    rdfs:comment 'Position in the waitlist queue if the sailing was fully booked at time of reservation.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passengerId rdf:type rdf:Property ;
    rdfs:label 'Passenger Id' ;
    rdfs:comment 'Identifier of the registered customer account if the passenger has an account in the system.' ;
    rdfs:domain ind:Ferry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Passenger .

ind:groupReservationId rdf:type rdf:Property ;
    rdfs:label 'Group Reservation Id' ;
    rdfs:comment 'Identifier linking this reservation to a group booking if part of a larger party.' ;
    rdfs:domain ind:Ferry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GroupReservation .

ind:vesselId rdf:type rdf:Property ;
    rdfs:label 'Vessel Id' ;
    rdfs:comment 'Identifier of the specific ferry vessel assigned to the sailing at time of reservation.' ;
