ind:rangeSpreadPercentage rdf:type rdf:Property ;
    rdfs:label 'Range Spread Percentage' ;
    rdfs:comment 'Percentage spread between minimum and maximum salary for this grade. Calculated as (max - min) / min * 100.' ;
    rdfs:domain ind:SalaryGrade ;
    rdf:type owl:DatatypeProperty ;
