    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPeriod100NetPml rdf:type rdf:Property ;
    rdfs:label 'Return Period 100 Net Pml' ;
    rdfs:comment 'Net PML amount at 100-year return period after reinsurance recoveries.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
