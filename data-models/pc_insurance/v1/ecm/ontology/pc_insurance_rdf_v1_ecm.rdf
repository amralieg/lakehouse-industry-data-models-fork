ind:characteristicName rdf:type rdf:Property ;
    rdfs:label 'Characteristic Name' ;
    rdfs:comment 'Name of the underwriting characteristic being captured (e.g., roof_age, alarm_type, driver_age, years_in_business, sprinkler_system).' ;
