    rdfs:comment 'Unique identifier for the planned infrastructure project within the transportation planning system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlannedProject .

ind:projectStatus rdf:type rdf:Property ;
    rdfs:label 'Project Status' ;
    rdfs:comment 'Current lifecycle status of the planned project within the planning and programming process.' ;
