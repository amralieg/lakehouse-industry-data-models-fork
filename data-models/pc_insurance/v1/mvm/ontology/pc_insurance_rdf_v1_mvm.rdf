ind:fireAlarmIndicator rdf:type rdf:Property ;
    rdfs:label 'Fire Alarm Indicator' ;
    rdfs:comment 'Indicates whether the property has a fire alarm or smoke detection system. May provide premium credit.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:foundationType rdf:type rdf:Property ;
    rdfs:label 'Foundation Type' ;
    rdfs:comment 'The type of foundation supporting the structure. Impacts flood and earthquake risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heatingType rdf:type rdf:Property ;
    rdfs:label 'Heating Type' ;
    rdfs:comment 'The type of heating system. Examples: forced air, electric, oil, gas, heat pump, wood stove. Impacts fire and equipment breakdown risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceToValuePercentage rdf:type rdf:Property ;
    rdfs:label 'Insurance To Value Percentage' ;
