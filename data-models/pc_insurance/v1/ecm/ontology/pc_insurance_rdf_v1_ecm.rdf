ind:fullTimeEmployeeCount rdf:type rdf:Property ;
    rdfs:label 'Full Time Employee Count' ;
    rdfs:comment 'Number of full-time employees working in this classification during the policy period.' ;
    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:governingClassIndicator rdf:type rdf:Property ;
