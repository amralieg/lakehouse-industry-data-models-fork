    rdfs:range xsd:boolean .

ind:maximumPremiumThreshold rdf:type rdf:Property ;
    rdfs:label 'Maximum Premium Threshold' ;
    rdfs:comment 'Maximum written premium amount beyond which this commission schedule no longer applies or a different tier begins.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremiumThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Threshold' ;
    rdfs:comment 'Minimum written premium amount required for this commission schedule to apply.' ;
