ind:regulatoryApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Required Flag' ;
    rdfs:comment 'Indicates whether this shared limit group structure requires state insurance department approval before use.' ;
    rdfs:domain ind:SharedLimitGroup ;
