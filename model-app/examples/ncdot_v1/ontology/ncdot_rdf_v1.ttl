ind:responsiblePerson rdf:type rdf:Property ;
    rdfs:label 'Responsible Person' ;
    rdfs:comment 'The name of the employee or manager responsible for the asset and its depreciation accounting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Adjustment Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this depreciation entry is an adjustment or correction to a previously posted entry.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
