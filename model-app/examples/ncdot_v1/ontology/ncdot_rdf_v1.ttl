ind:beneficiaryRelationship rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Relationship' ;
    rdfs:comment 'Relationship of the beneficiary to the employee (spouse, child, parent, sibling, domestic partner, other relative, estate, trust, other).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
