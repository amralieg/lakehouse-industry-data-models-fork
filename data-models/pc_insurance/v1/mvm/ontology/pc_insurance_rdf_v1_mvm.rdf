ind:statedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Stated Value Amount' ;
    rdfs:comment 'Agreed or stated value of the vehicle for valuation purposes, used in classic or specialty auto policies.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleOwnership rdf:type rdf:Property ;
    rdfs:label 'Vehicle Ownership' ;
    rdfs:comment 'Ownership status of the vehicle: owned, leased, financed, or hired, relevant for coverage and loss payee requirements.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleUseDescription rdf:type rdf:Property ;
    rdfs:label 'Vehicle Use Description' ;
    rdfs:comment 'Free-text description of the vehicles specific use, captured during underwriting for risk assessment.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredOwnerPartyId rdf:type rdf:Property ;
    rdfs:label 'Registered Owner Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Vehicle registered owner (title holder) is distinct from policyholder (auto_risk.party_id). Underwriting and claims require registered owner for lien verification, total loss settlement, and' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:absIndicator rdf:type rdf:Property ;
    rdfs:label 'Abs Indicator' ;
    rdfs:comment 'Indicates whether the vehicle is equipped with anti-lock braking system. Safety feature for rating.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:airbagCount rdf:type rdf:Property ;
    rdfs:label 'Airbag Count' ;
    rdfs:comment 'Number of airbags installed in the vehicle. Safety feature used for rating.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:antiTheftDeviceIndicator rdf:type rdf:Property ;
    rdfs:label 'Anti Theft Device Indicator' ;
    rdfs:comment 'Indicates whether the vehicle is equipped with an anti-theft device. May qualify for premium discount.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:antiTheftDeviceType rdf:type rdf:Property ;
    rdfs:label 'Anti Theft Device Type' ;
    rdfs:comment 'Type of anti-theft device installed. Used for discount eligibility and rating.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodyType rdf:type rdf:Property ;
    rdfs:label 'Body Type' ;
    rdfs:comment 'Body style or configuration of the vehicle used for rating and classification. [ENUM-REF-CANDIDATE: sedan|coupe|suv|truck|van|wagon|convertible|hatchback — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commuteMiles rdf:type rdf:Property ;
    rdfs:label 'Commute Miles' ;
    rdfs:comment 'One-way commute distance in miles. Used for rating and risk classification.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:engineSize rdf:type rdf:Property ;
    rdfs:label 'Engine Size' ;
    rdfs:comment 'Engine displacement in liters. Used for vehicle classification and rating.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelType rdf:type rdf:Property ;
    rdfs:label 'Fuel Type' ;
    rdfs:comment 'Type of fuel or power source used by the vehicle. May affect rating and eligibility for green vehicle discounts.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossVehicleWeight rdf:type rdf:Property ;
    rdfs:label 'Gross Vehicle Weight' ;
    rdfs:comment 'Maximum loaded weight of the vehicle in pounds. Used for commercial auto classification.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isoSymbol rdf:type rdf:Property ;
    rdfs:label 'Iso Symbol' ;
    rdfs:comment 'ISO vehicle symbol used for rating and premium calculation. Represents vehicle risk classification.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensePlateNumber rdf:type rdf:Property ;
    rdfs:label 'License Plate Number' ;
    rdfs:comment 'Current license plate or registration number assigned to the vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensePlateState rdf:type rdf:Property ;
    rdfs:label 'License Plate State' ;
    rdfs:comment 'Two-letter state code where the vehicle is registered.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienholderName rdf:type rdf:Property ;
    rdfs:label 'Lienholder Name' ;
    rdfs:comment 'Name of the financial institution or party holding a lien on the vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:make rdf:type rdf:Property ;
    rdfs:label 'Make' ;
    rdfs:comment 'Manufacturer or brand of the vehicle (e.g., Ford, Toyota, Honda).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:model rdf:type rdf:Property ;
    rdfs:label 'Model' ;
    rdfs:comment 'Specific model name or designation of the vehicle (e.g., Camry, F-150, Civic).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:odometerReading rdf:type rdf:Property ;
    rdfs:label 'Odometer Reading' ;
    rdfs:comment 'Current odometer reading in miles. Used for valuation and claims verification.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:odometerReadingDate rdf:type rdf:Property ;
    rdfs:label 'Odometer Reading Date' ;
    rdfs:comment 'Date the odometer reading was recorded.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ownershipType rdf:type rdf:Property ;
    rdfs:label 'Ownership Type' ;
    rdfs:comment 'Type of ownership arrangement for the vehicle. Affects loss payee and coverage requirements.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseDate rdf:type rdf:Property ;
    rdfs:label 'Purchase Date' ;
    rdfs:comment 'Date the vehicle was purchased by the current owner.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:purchasePrice rdf:type rdf:Property ;
    rdfs:label 'Purchase Price' ;
    rdfs:comment 'Original purchase price paid for the vehicle.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registrationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Expiration Date' ;
    rdfs:comment 'Date the vehicle registration expires. Used for compliance verification.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:safetyRating rdf:type rdf:Property ;
    rdfs:label 'Safety Rating' ;
    rdfs:comment 'NHTSA or IIHS safety rating for the vehicle. Used for underwriting and rating decisions.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageIndicator rdf:type rdf:Property ;
    rdfs:label 'Salvage Indicator' ;
    rdfs:comment 'Indicates whether the vehicle has a salvage or rebuilt title. Affects underwriting eligibility and valuation.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seatingCapacity rdf:type rdf:Property ;
    rdfs:label 'Seating Capacity' ;
    rdfs:comment 'Number of passengers the vehicle is designed to carry. Used for liability rating.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statedValue rdf:type rdf:Property ;
    rdfs:label 'Stated Value' ;
    rdfs:comment 'Declared or agreed value of the vehicle for insurance purposes. Used for coverage limits and premium calculation.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageType rdf:type rdf:Property ;
    rdfs:label 'Usage Type' ;
    rdfs:comment 'Primary use classification of the vehicle. Critical rating factor for premium calculation.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:useDescription rdf:type rdf:Property ;
    rdfs:label 'Use Description' ;
    rdfs:comment 'Detailed description of how the vehicle is used. Provides additional context for underwriting and rating.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleStatus rdf:type rdf:Property ;
    rdfs:label 'Vehicle Status' ;
    rdfs:comment 'Current status of the vehicle on the policy. Tracks lifecycle from addition through removal.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:year rdf:type rdf:Property ;
    rdfs:label 'Year' ;
    rdfs:comment 'Model year of the vehicle as designated by the manufacturer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryVehicleId rdf:type rdf:Property ;
    rdfs:label 'Primary Vehicle Id' ;
    rdfs:comment 'Foreign key to the vehicle this driver primarily operates, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:age rdf:type rdf:Property ;
    rdfs:label 'Age' ;
    rdfs:comment 'Current age of the driver in years, calculated from date of birth.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clueReportOrderDate rdf:type rdf:Property ;
    rdfs:label 'Clue Report Order Date' ;
    rdfs:comment 'Date the CLUE report was ordered to review the driver prior claim and loss history.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clueReportReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Clue Report Receipt Date' ;
    rdfs:comment 'Date the CLUE report was received and available for underwriting review.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:defensiveDrivingCourseDate rdf:type rdf:Property ;
    rdfs:label 'Defensive Driving Course Date' ;
    rdfs:comment 'Date the driver completed the defensive driving course, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:defensiveDrivingCourseIndicator rdf:type rdf:Property ;
    rdfs:label 'Defensive Driving Course Indicator' ;
    rdfs:comment 'Indicates whether the driver has completed an approved defensive driving or driver training course.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:driverType rdf:type rdf:Property ;
    rdfs:label 'Driver Type' ;
    rdfs:comment 'Classification of the driver role on the policy: principal operator, additional driver, excluded driver, or occasional operator.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedDriverIndicator rdf:type rdf:Property ;
    rdfs:label 'Excluded Driver Indicator' ;
    rdfs:comment 'Indicates whether this driver has been formally excluded from coverage under the policy by endorsement.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:excludedDriverReason rdf:type rdf:Property ;
    rdfs:label 'Excluded Driver Reason' ;
    rdfs:comment 'Reason the driver was excluded from coverage, such as poor driving record, unlicensed, or policyholder request.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodStudentIndicator rdf:type rdf:Property ;
    rdfs:label 'Good Student Indicator' ;
    rdfs:comment 'Indicates whether the driver qualifies for a good student discount based on academic performance.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'License Issue Date' ;
    rdfs:comment 'Date the driver license was originally issued.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseState rdf:type rdf:Property ;
    rdfs:label 'License State' ;
    rdfs:comment 'Two-letter state or jurisdiction code where the driver license was issued.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrAccidentCount rdf:type rdf:Property ;
    rdfs:label 'Mvr Accident Count' ;
    rdfs:comment 'Total number of at-fault accidents recorded on the driver MVR within the underwriting review period.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mvrCleanRecordIndicator rdf:type rdf:Property ;
    rdfs:label 'Mvr Clean Record Indicator' ;
    rdfs:comment 'Indicates whether the driver has a clean MVR with no violations, accidents, or suspensions in the review period.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrDuiIndicator rdf:type rdf:Property ;
    rdfs:label 'Mvr Dui Indicator' ;
    rdfs:comment 'Indicates whether the driver has a DUI or DWI conviction recorded on the MVR within the review period.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrMostRecentViolationDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Most Recent Violation Date' ;
    rdfs:comment 'Date of the most recent moving violation recorded on the driver MVR.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mvrReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Receipt Date' ;
    rdfs:comment 'Date the Motor Vehicle Record report was received and available for underwriting review.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mvrStatus rdf:type rdf:Property ;
    rdfs:label 'Mvr Status' ;
    rdfs:comment 'Current status of the MVR report: ordered, received, clean record, violations found, pending review, or error in retrieval.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrViolationCount rdf:type rdf:Property ;
    rdfs:label 'Mvr Violation Count' ;
    rdfs:comment 'Total number of moving violations recorded on the driver MVR within the underwriting review period.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupation rdf:type rdf:Property ;
    rdfs:label 'Occupation' ;
    rdfs:comment 'The driver occupation or job title, used as a rating factor in some jurisdictions.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupationClass rdf:type rdf:Property ;
    rdfs:label 'Occupation Class' ;
    rdfs:comment 'Standardized occupation classification code or category for rating purposes.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToNamedInsured rdf:type rdf:Property ;
    rdfs:label 'Relationship To Named Insured' ;
    rdfs:comment 'The driver relationship to the named insured on the policy: self, spouse, child, parent, sibling, or other.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:score rdf:type rdf:Property ;
    rdfs:label 'Score' ;
    rdfs:comment 'Numeric risk score assigned to the driver based on MVR, CLUE, and other underwriting factors.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sr22ExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Sr22 Expiration Date' ;
    rdfs:comment 'Date the SR-22 filing requirement expires, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sr22FilingDate rdf:type rdf:Property ;
    rdfs:label 'Sr22 Filing Date' ;
    rdfs:comment 'Date the SR-22 certificate was filed with the state, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sr22Indicator rdf:type rdf:Property ;
    rdfs:label 'Sr22 Indicator' ;
    rdfs:comment 'Indicates whether an SR-22 certificate of financial responsibility filing is required for this driver.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearsLicensed rdf:type rdf:Property ;
    rdfs:label 'Years Licensed' ;
    rdfs:comment 'Number of years the driver has held a valid driver license, used for experience-based rating.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskScoreId rdf:type rdf:Property ;
    rdfs:label 'Risk Score Id' ;
    rdfs:comment 'Unique identifier for the risk_score data product (auto-inserted during validation).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskScore .

ind:riskInspectionId rdf:type rdf:Property ;
    rdfs:label 'Risk Inspection Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.risk_inspection. Business justification: A risk score is frequently triggered by or derived from an inspection event. Linking risk_score to the risk_inspection that informed it creates a traceable audit chain from' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskInspection .

ind:acceptableFlag rdf:type rdf:Property ;
    rdfs:label 'Acceptable Flag' ;
    rdfs:comment 'Boolean flag indicating whether this risk score falls within acceptable underwriting guidelines.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catExposureScore rdf:type rdf:Property ;
    rdfs:label 'Cat Exposure Score' ;
    rdfs:comment 'Component score representing catastrophe exposure risk (hurricane, earthquake, flood, wildfire).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constructionScore rdf:type rdf:Property ;
    rdfs:label 'Construction Score' ;
    rdfs:comment 'Component score based on construction type, materials, and building characteristics.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:driverScore rdf:type rdf:Property ;
    rdfs:label 'Driver Score' ;
    rdfs:comment 'Component score for auto risks based on driver characteristics (age, experience, violations, accidents).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossHistoryScore rdf:type rdf:Property ;
    rdfs:label 'Loss History Score' ;
    rdfs:comment 'Component score based on prior loss and claims history for this risk or similar risks.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moralHazardScore rdf:type rdf:Property ;
    rdfs:label 'Moral Hazard Score' ;
    rdfs:comment 'Component score representing moral hazard factors (claims history, fraud indicators, financial stability).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupancyScore rdf:type rdf:Property ;
    rdfs:label 'Occupancy Score' ;
    rdfs:comment 'Component score based on occupancy type and usage characteristics of the insured risk.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protectionClassScore rdf:type rdf:Property ;
    rdfs:label 'Protection Class Score' ;
    rdfs:comment 'Component score based on fire protection class and other protective device factors.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Score Confidence Level' ;
    rdfs:comment 'Statistical confidence level or reliability percentage for the calculated risk score.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreDate rdf:type rdf:Property ;
    rdfs:label 'Score Date' ;
    rdfs:comment 'Date when the risk score was calculated and assigned.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scoreGrade rdf:type rdf:Property ;
    rdfs:label 'Score Grade' ;
    rdfs:comment 'Letter grade representation of the risk score for simplified classification and communication.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreNotes rdf:type rdf:Property ;
    rdfs:label 'Score Notes' ;
    rdfs:comment 'Free-text notes or comments regarding the risk score calculation, exceptions, or special considerations.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreStatus rdf:type rdf:Property ;
    rdfs:label 'Score Status' ;
    rdfs:comment 'Current status of this risk score record (Active, Superseded, Voided, Archived).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreTier rdf:type rdf:Property ;
    rdfs:label 'Score Tier' ;
    rdfs:comment 'Underwriting tier classification based on the risk score (Preferred, Standard, Substandard, Declined).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreTimestamp rdf:type rdf:Property ;
    rdfs:label 'Score Timestamp' ;
    rdfs:comment 'Precise timestamp when the risk score was generated by the rating or underwriting system.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scoreType rdf:type rdf:Property ;
    rdfs:label 'Score Type' ;
    rdfs:comment 'Type or purpose of the risk score (Underwriting, Renewal, Endorsement, Reunderwriting, Catastrophe, Credit).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreValue rdf:type rdf:Property ;
    rdfs:label 'Score Value' ;
    rdfs:comment 'Numeric risk score value assigned to the insured risk. Higher values typically indicate higher risk.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:territoryScore rdf:type rdf:Property ;
    rdfs:label 'Territory Score' ;
    rdfs:comment 'Component score reflecting geographic territory risk factors (crime, weather, loss frequency).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Threshold Exceeded Flag' ;
    rdfs:comment 'Boolean flag indicating whether the risk score exceeded acceptable underwriting thresholds.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thresholdValue rdf:type rdf:Property ;
    rdfs:label 'Threshold Value' ;
    rdfs:comment 'The threshold value against which this risk score was compared for acceptance decisions.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleScore rdf:type rdf:Property ;
    rdfs:label 'Vehicle Score' ;
    rdfs:comment 'Component score for auto risks based on vehicle characteristics (make, model, year, safety features).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectorPartyId rdf:type rdf:Property ;
    rdfs:label 'Inspector Party Id' ;
    rdfs:comment 'Foreign key to the party (individual or organization) who conducted the inspection.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:orderingProducerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Ordering Producer Producers Producer Id' ;
    rdfs:comment 'Foreign key linking to producers.producers_producer. Business justification: Producers order or are notified of property/auto inspections for risks they wrote.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'Date the physical or virtual inspection was completed and findings recorded.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electricalCondition rdf:type rdf:Property ;
    rdfs:label 'Electrical Condition' ;
    rdfs:comment 'Condition assessment of the electrical system: excellent, good, fair, poor, or hazardous.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireProtectionPresent rdf:type rdf:Property ;
    rdfs:label 'Fire Protection Present' ;
    rdfs:comment 'Indicates whether fire protection systems (sprinklers, alarms, extinguishers) are present at the location.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fireProtectionType rdf:type rdf:Property ;
    rdfs:label 'Fire Protection Type' ;
    rdfs:comment 'Type of fire protection system observed: automatic sprinkler, fire alarm, standpipe, extinguishers, or combination.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardsIdentified rdf:type rdf:Property ;
    rdfs:label 'Hazards Identified' ;
    rdfs:comment 'Summary of hazards or deficiencies identified during the inspection that may increase loss potential.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hvacCondition rdf:type rdf:Property ;
    rdfs:label 'Hvac Condition' ;
    rdfs:comment 'Condition assessment of the heating, ventilation, and air conditioning system.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionMethod rdf:type rdf:Property ;
    rdfs:label 'Inspection Method' ;
    rdfs:comment 'Method used to conduct the inspection: on-site physical, desktop review, aerial (drone/satellite), virtual (video), or hybrid.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Number' ;
    rdfs:comment 'Business identifier for the inspection, often used in correspondence and reporting.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionPurpose rdf:type rdf:Property ;
    rdfs:label 'Inspection Purpose' ;
    rdfs:comment 'Business reason for the inspection: underwriting risk assessment, loss control, compliance verification, valuation, or post-loss evaluation.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionReportUrl rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Url' ;
    rdfs:comment 'URL or document reference to the full inspection report stored in the document management system.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionType rdf:type rdf:Property ;
    rdfs:label 'Inspection Type' ;
    rdfs:comment 'Category of inspection: new business underwriting, renewal, mid-term endorsement, loss control, compliance, reinspection, catastrophe, or special request. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionVendor rdf:type rdf:Property ;
    rdfs:label 'Inspection Vendor' ;
    rdfs:comment 'Name of the third-party inspection service provider, if applicable.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderedDate rdf:type rdf:Property ;
    rdfs:label 'Ordered Date' ;
    rdfs:comment 'Date the inspection was requested or ordered by underwriting or claims.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallCondition rdf:type rdf:Property ;
    rdfs:label 'Overall Condition' ;
    rdfs:comment 'Inspector\'s overall assessment of the risk condition: excellent, good, fair, poor, or unacceptable.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photosCount rdf:type rdf:Property ;
    rdfs:label 'Photos Count' ;
    rdfs:comment 'Number of photographs taken during the inspection and attached to the report.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:plumbingCondition rdf:type rdf:Property ;
    rdfs:label 'Plumbing Condition' ;
    rdfs:comment 'Condition assessment of the plumbing system: excellent, good, fair, poor, or hazardous.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendations rdf:type rdf:Property ;
    rdfs:label 'Recommendations' ;
    rdfs:comment 'Inspector\'s recommendations for risk improvement, hazard mitigation, or underwriting action.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roofAgeYears rdf:type rdf:Property ;
    rdfs:label 'Roof Age Years' ;
    rdfs:comment 'Estimated age of the roof in years since installation or last replacement.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roofCondition rdf:type rdf:Property ;
    rdfs:label 'Roof Condition' ;
    rdfs:comment 'Condition assessment of the roof: excellent, good, fair, poor, or needs replacement.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'Date the inspection appointment was scheduled with the insured or property contact.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:securitySystemPresent rdf:type rdf:Property ;
    rdfs:label 'Security System Present' ;
    rdfs:comment 'Indicates whether security systems (burglar alarm, surveillance, access control) are present at the location.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwritingAction rdf:type rdf:Property ;
    rdfs:label 'Underwriting Action' ;
    rdfs:comment 'Recommended underwriting action based on inspection findings: accept, accept with conditions, decline, refer, or request reinspection.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationCurrency rdf:type rdf:Property ;
    rdfs:label 'Valuation Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the valuation estimate.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationEstimate rdf:type rdf:Property ;
    rdfs:label 'Valuation Estimate' ;
    rdfs:comment 'Inspector\'s estimated replacement cost or insurable value of the property, if applicable.' ;
    rdfs:domain ind:RiskInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accountId rdf:type rdf:Property ;
    rdfs:label 'Account Id' ;
    rdfs:comment 'Unique identifier for the billing account. Primary key.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingAddressId rdf:type rdf:Property ;
    rdfs:label 'Billing Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Billing accounts require validated billing address distinct from policyholder address for invoice delivery, collections correspondence, and regulatory cancellation notices.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the billing account indicating whether it is active, suspended, closed, delinquent, pending activation, or cancelled.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of billing account indicating who collects premium: direct bill (insurer bills policyholder), agency bill (producer collects), list bill, or account current.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Enabled' ;
    rdfs:comment 'Indicates whether automatic payment processing is enabled for this account. True means payments are automatically withdrawn on due date.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingContactName rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Name' ;
    rdfs:comment 'Name of the person or entity designated to receive billing communications and invoices for this account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingEmail rdf:type rdf:Property ;
    rdfs:label 'Billing Email' ;
    rdfs:comment 'Email address for delivery of electronic invoices, payment confirmations, and billing notices.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'Frequency at which invoices are generated for this account: monthly, quarterly, semi-annual, annual, or on-demand.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPhone rdf:type rdf:Property ;
    rdfs:label 'Billing Phone' ;
    rdfs:comment 'Primary phone number for billing inquiries, payment reminders, and delinquency notifications.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditBalance rdf:type rdf:Property ;
    rdfs:label 'Credit Balance' ;
    rdfs:comment 'Total credit amount available on the account from overpayments, return premiums, or cancellations. Positive value indicates credit owed to policyholder.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'Current outstanding balance on the account, representing total amount owed by the policyholder. Positive indicates amount due; negative indicates credit.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'Number of days the oldest unpaid invoice on this account is overdue. Zero indicates account is current.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delinquencyStatus rdf:type rdf:Property ;
    rdfs:label 'Delinquency Status' ;
    rdfs:comment 'Classification of account delinquency based on days past due: current, 1-30 days, 31-60 days, 61-90 days, over 90 days, or in collections.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'Monetary amount of the most recent payment received on this account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date the most recent payment was received and posted to this account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Next Invoice Date' ;
    rdfs:comment 'Scheduled date for the next invoice to be generated for this account based on billing frequency and payment plan.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Payment Due Date' ;
    rdfs:comment 'Date by which the next payment is due to avoid delinquency or late fees.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outstandingFees rdf:type rdf:Property ;
    rdfs:label 'Outstanding Fees' ;
    rdfs:comment 'Total unpaid fees currently due on this account, including installment fees, late fees, and service charges.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingPremium rdf:type rdf:Property ;
    rdfs:label 'Outstanding Premium' ;
    rdfs:comment 'Total unpaid premium amount currently due on this account, excluding fees, taxes, and other charges.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingTaxes rdf:type rdf:Property ;
    rdfs:label 'Outstanding Taxes' ;
    rdfs:comment 'Total unpaid taxes currently due on this account, including premium taxes, surplus lines taxes, and stamping fees.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paperlessBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Flag' ;
    rdfs:comment 'Indicates whether the policyholder has opted for electronic delivery of invoices and billing statements instead of paper mail.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanType rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Type' ;
    rdfs:comment 'Installment plan structure for premium payments: full pay, monthly, quarterly, semi-annual, or custom installment schedule.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unappliedCash rdf:type rdf:Property ;
    rdfs:label 'Unapplied Cash' ;
    rdfs:comment 'Amount of cash received but not yet applied to specific invoices or charges, held in suspense pending allocation.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Total amount written off as uncollectible on this account due to bankruptcy, insolvency, or collection failure.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'Date the uncollectible balance was written off and removed from accounts receivable.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billToPartyId rdf:type rdf:Property ;
    rdfs:label 'Bill To Party Id' ;
    rdfs:comment 'Reference to the party to whom this invoice is addressed, may differ from policyholder.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:amountPaid rdf:type rdf:Property ;
    rdfs:label 'Amount Paid' ;
    rdfs:comment 'Total amount paid against this invoice to date.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'End date of the coverage or billing period represented by this invoice.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'Start date of the coverage or billing period represented by this invoice.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Invoice Description' ;
    rdfs:comment 'Free-text description or memo providing additional context about this invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glPostingDate rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Date' ;
    rdfs:comment 'Date on which this invoice was posted to the general ledger for accounting purposes.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'Current lifecycle status of the invoice in the billing workflow. [ENUM-REF-CANDIDATE: draft|issued|billed|paid|partially_paid|overdue|cancelled|written_off — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Type of invoice based on the underlying policy transaction or billing event. [ENUM-REF-CANDIDATE: new_business|renewal|endorsement|cancellation|reinstatement|audit|installment|commission — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidDate rdf:type rdf:Property ;
    rdfs:label 'Paid Date' ;
    rdfs:comment 'Date on which this invoice was fully paid.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Business reason or code explaining why this invoice was reversed.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAmountDue rdf:type rdf:Property ;
    rdfs:label 'Total Amount Due' ;
    rdfs:comment 'Total amount due on this invoice including premium, taxes, and fees.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalInstallments rdf:type rdf:Property ;
    rdfs:label 'Total Installments' ;
    rdfs:comment 'Total number of installments in the payment plan for this policy term.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Business reason or code explaining why this invoice balance was written off.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenOffDate rdf:type rdf:Property ;
    rdfs:label 'Written Off Date' ;
    rdfs:comment 'Date on which the outstanding balance of this invoice was written off as uncollectible.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceItemId rdf:type rdf:Property ;
    rdfs:label 'Invoice Item Id' ;
    rdfs:comment 'Unique identifier for the invoice item. Primary key.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceItem .

ind:reversedItemInvoiceItemId rdf:type rdf:Property ;
    rdfs:label 'Reversed Item Invoice Item Id' ;
    rdfs:comment 'Reference to the original invoice item this item reverses. Populated only when reversal_flag is true.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceItem .

ind:itemAmount rdf:type rdf:Property ;
    rdfs:label 'Item Amount' ;
    rdfs:comment 'Monetary amount of this invoice line item in the invoice currency. Positive for charges, negative for credits or refunds.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:itemCategory rdf:type rdf:Property ;
    rdfs:label 'Item Category' ;
    rdfs:comment 'Further categorization of the item within its type. For premium: written, earned, unearned, return. For fees: installment, surcharge, penalty. [ENUM-REF-CANDIDATE: written|earned|unearned|return|installment|surcharge|penalty — 7 candidates stripped' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemCode rdf:type rdf:Property ;
    rdfs:label 'Item Code' ;
    rdfs:comment 'Internal billing code or accounting code for the item type. Used for general ledger posting and reporting.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemType rdf:type rdf:Property ;
    rdfs:label 'Item Type' ;
    rdfs:comment 'Classification of the invoice line item indicating what is being billed: premium charge, tax, fee, commission, adjustment, or refund.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number within the invoice for ordering and display purposes.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prorationMethod rdf:type rdf:Property ;
    rdfs:label 'Proration Method' ;
    rdfs:comment 'Method used to prorate premium for mid-term changes. Daily, monthly, short-rate, pro-rata, or full-term.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction' ;
    rdfs:comment 'State, county, or municipal jurisdiction imposing the tax. Populated only when item_type is tax.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxableBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Taxable Base Amount' ;
    rdfs:comment 'Base premium amount the tax is calculated on. Populated only when item_type is tax.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updatedByUser rdf:type rdf:Property ;
    rdfs:label 'Updated By User' ;
    rdfs:comment 'User identifier or system process that last modified this invoice item record. Supports audit and compliance.' ;
    rdfs:domain ind:InvoiceItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Business reason the fee or charge was waived. Populated only when waived_flag is true.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerPartyId rdf:type rdf:Property ;
    rdfs:label 'Payer Party Id' ;
    rdfs:comment 'Reference to the party (person or organization) who made the payment.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:paymentMethodId rdf:type rdf:Property ;
    rdfs:label 'Payment Method Id' ;
    rdfs:comment 'Foreign key linking to billing.payment_method. Business justification: payment.method (STRING) is a denormalized copy of the payment instrument type that is authoritatively stored in payment_method.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentMethod .

ind:appliedAmount rdf:type rdf:Property ;
    rdfs:label 'Applied Amount' ;
    rdfs:comment 'Portion of the payment amount that has been applied to outstanding invoices or charges.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedDate rdf:type rdf:Property ;
    rdfs:label 'Applied Date' ;
    rdfs:comment 'Date the payment was applied to the billing account or invoice.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Authorization code provided by the payment processor for card transactions.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountLastFour rdf:type rdf:Property ;
    rdfs:label 'Bank Account Last Four' ;
    rdfs:comment 'Last four digits of the bank account used for ACH or wire transfer payments.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardLastFour rdf:type rdf:Property ;
    rdfs:label 'Card Last Four' ;
    rdfs:comment 'Last four digits of the payment card used, for identification purposes only.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardType rdf:type rdf:Property ;
    rdfs:label 'Card Type' ;
    rdfs:comment 'Type of payment card used (Visa, MasterCard, American Express, Discover).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'Interface or channel through which the payment was received (web, mobile, agent portal, mail, phone, in-person).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReturned rdf:type rdf:Property ;
    rdfs:label 'Is Returned' ;
    rdfs:comment 'Indicates whether the payment was returned due to insufficient funds or other reasons.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nsfFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Nsf Fee Amount' ;
    rdfs:comment 'Fee charged to the policyholder for a returned payment due to insufficient funds.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:processor rdf:type rdf:Property ;
    rdfs:label 'Processor' ;
    rdfs:comment 'Name of the payment gateway or processor that handled the transaction.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'Date the payment was received by the insurer.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receiptTimestamp rdf:type rdf:Property ;
    rdfs:label 'Receipt Timestamp' ;
    rdfs:comment 'Precise date and time the payment was received and recorded in the billing system.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Number' ;
    rdfs:comment 'External reference number provided by the payer or payment processor (e.g., check number, confirmation number).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnReasonCode rdf:type rdf:Property ;
    rdfs:label 'Return Reason Code' ;
    rdfs:comment 'Code indicating the reason for payment return (e.g., NSF, account closed, stop payment).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Return Reason Description' ;
    rdfs:comment 'Detailed explanation of why the payment was returned.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnedDate rdf:type rdf:Property ;
    rdfs:label 'Returned Date' ;
    rdfs:comment 'Date the payment was returned by the financial institution.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversedDate rdf:type rdf:Property ;
    rdfs:label 'Reversed Date' ;
    rdfs:comment 'Date the payment was reversed, if applicable.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unappliedAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Amount' ;
    rdfs:comment 'Portion of the payment amount that remains unapplied and available for future allocation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Payment Application Id' ;
    rdfs:comment 'Unique identifier for the payment application record. Primary key.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentScheduleId rdf:type rdf:Property ;
    rdfs:label 'Installment Schedule Id' ;
    rdfs:comment 'Foreign key linking to billing.installment_schedule. Business justification: A payment_application records how a payment is allocated. Linking it to the specific installment_schedule row being satisfied closes the reconciliation loop: the scheduled' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InstallmentSchedule .

ind:reversedApplicationPaymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Reversed Application Payment Application Id' ;
    rdfs:comment 'Reference to the original payment application record that this reversal is correcting. Null if not a reversal.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentApplication .

ind:allocationPriority rdf:type rdf:Property ;
    rdfs:label 'Allocation Priority' ;
    rdfs:comment 'Numeric priority order for applying this payment when multiple invoices or items are eligible. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationRuleCode rdf:type rdf:Property ;
    rdfs:label 'Allocation Rule Code' ;
    rdfs:comment 'Code identifying the business rule used to allocate this payment across invoices or items.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationMethod rdf:type rdf:Property ;
    rdfs:label 'Application Method' ;
    rdfs:comment 'Method by which the payment was applied: automatic matching, manual user action, system rule, batch process, or override.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationNumber rdf:type rdf:Property ;
    rdfs:label 'Application Number' ;
    rdfs:comment 'Business-readable identifier for this payment application transaction.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Application Reason Code' ;
    rdfs:comment 'Code indicating the reason for the application, unapplied status, or suspense holding.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Application Reason Description' ;
    rdfs:comment 'Detailed explanation of why the payment was applied, held unapplied, or placed in suspense.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current status of the payment application in the billing lifecycle.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Application Timestamp' ;
    rdfs:comment 'Precise date and time when the payment application was recorded in the billing system.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:applicationType rdf:type rdf:Property ;
    rdfs:label 'Application Type' ;
    rdfs:comment 'Type of payment application: applied to invoice, held as unapplied cash, held in suspense, reversal of prior application, or adjustment.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Applied By User Code' ;
    rdfs:comment 'User identifier of the billing representative who manually applied this payment. Null if automatic.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delinquencyFlag rdf:type rdf:Property ;
    rdfs:label 'Delinquency Flag' ;
    rdfs:comment 'Indicates whether this payment application was made to cure a delinquent account or invoice.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReferenceCode rdf:type rdf:Property ;
    rdfs:label 'External Reference Code' ;
    rdfs:comment 'External system identifier for this payment application, used for cross-system reconciliation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseAmount rdf:type rdf:Property ;
    rdfs:label 'Suspense Amount' ;
    rdfs:comment 'Monetary amount held in suspense pending resolution of account or invoice discrepancies.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:suspenseClearedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Suspense Cleared By User Code' ;
    rdfs:comment 'User identifier of the billing representative who cleared the suspense and applied the payment.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspenseClearedDate rdf:type rdf:Property ;
    rdfs:label 'Suspense Cleared Date' ;
    rdfs:comment 'Date on which the suspense holding was resolved and the payment was applied. Null if still in suspense.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:suspenseReasonCode rdf:type rdf:Property ;
    rdfs:label 'Suspense Reason Code' ;
    rdfs:comment 'Code indicating the specific reason why this payment was placed in suspense rather than applied.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffFlag rdf:type rdf:Property ;
    rdfs:label 'Write Off Flag' ;
    rdfs:comment 'Indicates whether this application record represents a write-off of uncollectible amounts rather than a cash payment.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:writeOffReasonCode rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason Code' ;
    rdfs:comment 'Code indicating the reason for writing off the amount. Null if not a write-off.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Eligible Flag' ;
    rdfs:comment 'Indicates whether this payment plan allows policyholders to enroll in automatic recurring payment processing.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationShortRatePenaltyPercentage rdf:type rdf:Property ;
    rdfs:label 'Cancellation Short Rate Penalty Percentage' ;
    rdfs:comment 'Percentage penalty applied to unearned premium when policyholder cancels mid-term under installment plan.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Description' ;
    rdfs:comment 'Detailed explanation of the payment plan terms, conditions, and intended use for underwriter and agent reference.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayOrder rdf:type rdf:Property ;
    rdfs:label 'Display Order' ;
    rdfs:comment 'Numeric sequence controlling the presentation order of payment plans in user interfaces and quote proposals.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downPaymentMinimumAmount rdf:type rdf:Property ;
    rdfs:label 'Down Payment Minimum Amount' ;
    rdfs:comment 'Minimum dollar amount required for down payment regardless of percentage calculation.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downPaymentPercentage rdf:type rdf:Property ;
    rdfs:label 'Down Payment Percentage' ;
    rdfs:comment 'Percentage of total premium required as initial down payment at policy binding expressed as decimal.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalPlanCode rdf:type rdf:Property ;
    rdfs:label 'External Plan Code' ;
    rdfs:comment 'Third-party or legacy system payment plan identifier used for integration and data migration mapping.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Fee Amount' ;
    rdfs:comment 'Fixed dollar fee charged per installment payment to cover administrative and processing costs.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentFeePercentage rdf:type rdf:Property ;
    rdfs:label 'Installment Fee Percentage' ;
    rdfs:comment 'Percentage-based fee applied to each installment amount expressed as decimal for proportional billing.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Installment Frequency' ;
    rdfs:comment 'Recurring interval at which installment payments are scheduled and invoiced to the policyholder.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latePaymentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Fee Amount' ;
    rdfs:comment 'Fixed dollar penalty assessed when an installment payment is received after the grace period expires.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planCode rdf:type rdf:Property ;
    rdfs:label 'Plan Code' ;
    rdfs:comment 'Business identifier code for the payment plan template used for external reference and billing system integration.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'Descriptive name of the payment plan displayed to policyholders and agents.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Classification of the payment plan structure indicating how premium is collected.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerCommissionImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Producer Commission Impact Flag' ;
    rdfs:comment 'Indicates whether installment fees affect producer commission calculation or are retained entirely by the insurer.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnedPaymentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Fee Amount' ;
    rdfs:comment 'Fixed dollar fee assessed when a payment is returned due to insufficient funds or account closure.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delinquencyDays rdf:type rdf:Property ;
    rdfs:label 'Delinquency Days' ;
    rdfs:comment 'Number of days this installment is past due. Zero if paid on time or not yet due.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Down Payment Flag' ;
    rdfs:comment 'Indicates whether this installment represents the initial down payment for the policy term.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Allocation Amount' ;
    rdfs:comment 'Portion of the installment amount allocated to fees such as policy fees or installment fees.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalInstallmentFlag rdf:type rdf:Property ;
    rdfs:label 'Final Installment Flag' ;
    rdfs:comment 'Indicates whether this is the final installment in the payment plan.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gracePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Grace Period End Date' ;
    rdfs:comment 'Date after which the installment is considered past due if unpaid. Typically scheduled due date plus grace period days.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:installmentStatus rdf:type rdf:Property ;
    rdfs:label 'Installment Status' ;
    rdfs:comment 'Current status of the installment in its lifecycle.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Notice Sent Date' ;
    rdfs:comment 'Date on which a payment reminder or delinquency notice was sent for this installment. Null if no notice sent.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeType rdf:type rdf:Property ;
    rdfs:label 'Notice Type' ;
    rdfs:comment 'Type of notice sent to the policyholder regarding this installment. Null if no notice sent.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentChannel rdf:type rdf:Property ;
    rdfs:label 'Payment Channel' ;
    rdfs:comment 'Channel through which the payment was or is expected to be received. [ENUM-REF-CANDIDATE: web|mobile_app|phone|mail|agent|branch|auto_pay — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'Date on which payment was actually received for this installment. Null if unpaid.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Allocation Amount' ;
    rdfs:comment 'Portion of the installment amount allocated to premium charges.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnedPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Date' ;
    rdfs:comment 'Date on which a payment for this installment was returned. Null if no return occurred.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnedPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Flag' ;
    rdfs:comment 'Indicates whether a payment for this installment was returned or reversed due to insufficient funds or other reason.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnedPaymentReason rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Reason' ;
    rdfs:comment 'Reason code or description for why the payment was returned. Null if no return occurred.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledAmount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Amount' ;
    rdfs:comment 'The amount scheduled to be paid for this installment as originally calculated.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledDueDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Due Date' ;
    rdfs:comment 'Date on which the installment payment is scheduled to be due.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Allocation Amount' ;
    rdfs:comment 'Portion of the installment amount allocated to taxes and surcharges.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waivedAmount rdf:type rdf:Property ;
    rdfs:label 'Waived Amount' ;
    rdfs:comment 'Portion of the installment amount that has been waived or forgiven. Zero if no waiver applied.' ;
    rdfs:domain ind:InstallmentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delinquencyId rdf:type rdf:Property ;
    rdfs:label 'Delinquency Id' ;
    rdfs:comment 'Unique identifier for the delinquency event. Primary key.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Delinquency .

ind:contactPartyId rdf:type rdf:Property ;
    rdfs:label 'Contact Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Collections outreach requires identifying the responsible party (named insured, guarantor) directly on the delinquency record.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:assignedCollectorUserCode rdf:type rdf:Property ;
    rdfs:label 'Assigned Collector User Code' ;
    rdfs:comment 'User ID of the collections specialist assigned to work this delinquency case.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionsAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Flag' ;
    rdfs:comment 'Indicates whether the delinquent account was referred to an external collections agency.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionsAgencyName rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Name' ;
    rdfs:comment 'Name of the external collections agency to which the account was referred.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsReferralDate rdf:type rdf:Property ;
    rdfs:label 'Collections Referral Date' ;
    rdfs:comment 'Date the delinquent account was referred to the collections agency.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstMissedInstallmentDate rdf:type rdf:Property ;
    rdfs:label 'First Missed Installment Date' ;
    rdfs:comment 'Due date of the first installment that was not paid, initiating the delinquency.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstNoticeDate rdf:type rdf:Property ;
    rdfs:label 'First Notice Date' ;
    rdfs:comment 'Date the first delinquency notice was sent to the policyholder.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Last Notice Date' ;
    rdfs:comment 'Date the most recent delinquency or cancellation notice was sent.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeSentCount rdf:type rdf:Property ;
    rdfs:label 'Notice Sent Count' ;
    rdfs:comment 'Total number of delinquency notices sent to the policyholder during this delinquency event.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pastDueAmount rdf:type rdf:Property ;
    rdfs:label 'Past Due Amount' ;
    rdfs:comment 'Portion of the total amount due that is overdue and subject to collections action.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanDefaultFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Default Flag' ;
    rdfs:comment 'Indicates whether the delinquency was caused by a payment plan default.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Additional penalties or interest charges applied to the delinquent balance.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Amount' ;
    rdfs:comment 'Total amount paid to reinstate the policy, including past-due premium, fees, and penalties.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resolutionMethod rdf:type rdf:Property ;
    rdfs:label 'Resolution Method' ;
    rdfs:comment 'Method by which the delinquency was resolved.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolvedDate rdf:type rdf:Property ;
    rdfs:label 'Resolved Date' ;
    rdfs:comment 'Date the delinquency was fully resolved through payment, reinstatement, cancellation, or write-off.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'Precise timestamp when the delinquency event was triggered in the billing system.' ;
    rdfs:domain ind:Delinquency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:delinquencyActionId rdf:type rdf:Property ;
    rdfs:label 'Delinquency Action Id' ;
    rdfs:comment 'Unique identifier for each delinquency action record. Primary key.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedActionDelinquencyActionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Action Delinquency Action Id' ;
    rdfs:comment 'Foreign key to the original delinquency action that this action reverses, if applicable.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DelinquencyAction .

ind:actionDate rdf:type rdf:Property ;
    rdfs:label 'Action Date' ;
    rdfs:comment 'Business date when the delinquency action was initiated or executed.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actionOutcomeCode rdf:type rdf:Property ;
    rdfs:label 'Action Outcome Code' ;
    rdfs:comment 'Result or outcome of the delinquency action after execution.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Action Reason Code' ;
    rdfs:comment 'Coded reason or trigger that caused this delinquency action to be initiated.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Action Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why this delinquency action was taken.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Action Sequence Number' ;
    rdfs:comment 'Sequential order of this action within the parent delinquency process.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current status of the delinquency action in its workflow lifecycle.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Action Timestamp' ;
    rdfs:comment 'Precise timestamp when the delinquency action was initiated or executed.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Action Type Code' ;
    rdfs:comment 'Type of delinquency action taken: notice issued, reminder sent, cancellation initiated, reinstatement offered, write-off triggered, or referral to collections.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Approved By User Code' ;
    rdfs:comment 'Identifier of the system user who approved or authorized this delinquency action, if approval required.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Code' ;
    rdfs:comment 'Identifier of the external collections agency to which the account was referred, if applicable.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Collections Referral Flag' ;
    rdfs:comment 'Indicates whether the delinquent account was referred to external collections agency as part of this action.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:initiatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Code' ;
    rdfs:comment 'Identifier of the system user or automated process that initiated this delinquency action.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether this delinquency action complies with all applicable state and federal regulatory requirements.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Deadline Date' ;
    rdfs:comment 'Last date by which the policyholder can accept the reinstatement offer and restore coverage.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementOfferedFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Offered Flag' ;
    rdfs:comment 'Indicates whether a reinstatement offer was extended to the policyholder as part of this action.' ;
    rdfs:domain ind:DelinquencyAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payeeAddressId rdf:type rdf:Property ;
    rdfs:label 'Payee Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Commission and claim disbursement checks require USPS-validated payee address for delivery. Denormalized address fields should reference party.address master to leverage geocoding, DPV' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:payeeAgencyId rdf:type rdf:Property ;
    rdfs:label 'Payee Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Agency commission disbursement: checks are cut to agencies (not individual producers) for agency-bill commission settlements.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:reversedDisbursementId rdf:type rdf:Property ;
    rdfs:label 'Reversed Disbursement Id' ;
    rdfs:comment 'Identifier of the original disbursement being reversed, if this is a reversal transaction.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Disbursement .

ind:commissionBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Basis Amount' ;
    rdfs:comment 'Base premium or transaction amount on which the commission was calculated.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disbursementDate rdf:type rdf:Property ;
    rdfs:label 'Disbursement Date' ;
    rdfs:comment 'Date the disbursement was issued or scheduled for payment.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disbursementStatus rdf:type rdf:Property ;
    rdfs:label 'Disbursement Status' ;
    rdfs:comment 'Current lifecycle status of the disbursement transaction.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disbursementType rdf:type rdf:Property ;
    rdfs:label 'Disbursement Type' ;
    rdfs:comment 'Classification of the disbursement purpose: commission payable, premium refund, return premium, claim payment, or recovery. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Issued By User Code' ;
    rdfs:comment 'User identifier of the person who issued or processed the disbursement.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeTaxNumber rdf:type rdf:Property ;
    rdfs:label 'Payee Tax Number' ;
    rdfs:comment 'Tax identification number (TIN, EIN, or SSN) of the payee for IRS reporting and withholding.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withheldAmount rdf:type rdf:Property ;
    rdfs:label 'Withheld Amount' ;
    rdfs:comment 'Amount withheld from the disbursement for tax, offset, or other deductions.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autopayEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Autopay Enrollment Date' ;
    rdfs:comment 'Date when the payment method was enrolled in automatic payment processing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cardExpiryMonth rdf:type rdf:Property ;
    rdfs:label 'Card Expiry Month' ;
    rdfs:comment 'Expiration month of the credit or debit card (1-12). Populated only for card-based methods.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cardExpiryYear rdf:type rdf:Property ;
    rdfs:label 'Card Expiry Year' ;
    rdfs:comment 'Expiration year of the credit or debit card (four-digit year). Populated only for card-based methods.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cardholderName rdf:type rdf:Property ;
    rdfs:label 'Cardholder Name' ;
    rdfs:comment 'Name of the cardholder as it appears on the credit or debit card.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eftAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Eft Authorization Date' ;
    rdfs:comment 'Date when the Electronic Funds Transfer authorization was granted by the account holder.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eftAuthorizationReference rdf:type rdf:Property ;
    rdfs:label 'Eft Authorization Reference' ;
    rdfs:comment 'Reference number or identifier for the EFT authorization agreement or signed form.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eftAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Eft Authorization Status' ;
    rdfs:comment 'Status of the Electronic Funds Transfer authorization indicating whether the account holder has granted permission for automatic debits.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutopayEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Autopay Enabled' ;
    rdfs:comment 'Indicates whether this payment method is enrolled in automatic payment processing for recurring invoices.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDefault rdf:type rdf:Property ;
    rdfs:label 'Is Default' ;
    rdfs:comment 'Indicates whether this is the default payment method for the billing account.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Verification Date' ;
    rdfs:comment 'Date when the payment method was last verified or validated by the payment processor or financial institution.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:methodName rdf:type rdf:Property ;
    rdfs:label 'Method Name' ;
    rdfs:comment 'User-friendly display name or nickname for the payment method (e.g., Personal Visa, Business Checking).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodStatus rdf:type rdf:Property ;
    rdfs:label 'Method Status' ;
    rdfs:comment 'Current lifecycle status of the payment method indicating whether it is available for use.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodType rdf:type rdf:Property ;
    rdfs:label 'Method Type' ;
    rdfs:comment 'Type of payment instrument: credit card, debit card, Automated Clearing House (ACH), Electronic Funds Transfer (EFT), check, escrow, or wire transfer. [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|eft|check|escrow|wire_transfer — 7 candidates stripped' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentToken rdf:type rdf:Property ;
    rdfs:label 'Payment Token' ;
    rdfs:comment 'Tokenized representation of the payment instrument provided by the payment processor for secure storage and recurring transactions.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityRank rdf:type rdf:Property ;
    rdfs:label 'Priority Rank' ;
    rdfs:comment 'Numeric ranking indicating the order of preference for this payment method when multiple methods are available (1 = highest priority).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processorMerchantCode rdf:type rdf:Property ;
    rdfs:label 'Processor Merchant Code' ;
    rdfs:comment 'Merchant identifier assigned by the payment processor for transaction routing and reconciliation.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorName rdf:type rdf:Property ;
    rdfs:label 'Processor Name' ;
    rdfs:comment 'Name of the third-party payment processor or gateway handling transactions for this payment method (e.g., Stripe, PayPal, Authorize.Net).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Updated By User Code' ;
    rdfs:comment 'Identifier of the user or system process that last modified the payment method record.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Usage Limit Amount' ;
    rdfs:comment 'Maximum transaction amount allowed for a single payment using this method. Nullable if no limit is imposed.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accountPolicyId rdf:type rdf:Property ;
    rdfs:label 'Account Policy Id' ;
    rdfs:comment 'Unique identifier for the billing account to policy association. One row per billing-account-to-policy relationship.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:addedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Added By User Code' ;
    rdfs:comment 'Identifier of the user who added this policy to the billing account.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Method used to allocate payments across policies on this billing account.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'Percentage of account-level payments to allocate to this policy. Used for proportional allocation rules.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationPendingFlag rdf:type rdf:Property ;
    rdfs:label 'Cancellation Pending Flag' ;
    rdfs:comment 'Indicates whether this policy is pending cancellation due to billing account delinquency.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consolidationFlag rdf:type rdf:Property ;
    rdfs:label 'Consolidation Flag' ;
    rdfs:comment 'Indicates whether this policy is part of a multi-policy consolidated billing arrangement.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installmentBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Installment Billing Flag' ;
    rdfs:comment 'Indicates whether this policy is billed on an installment basis within the billing account.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:removedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Removed By User Code' ;
    rdfs:comment 'Identifier of the user who removed this policy from the billing account.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:splitBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Split Billing Flag' ;
    rdfs:comment 'Indicates whether this policy uses split billing between direct bill and agency bill methods.' ;
    rdfs:domain ind:AccountPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorCoverageId rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Id' ;
    rdfs:comment 'Foreign key to the previous version of this coverage, if this is an endorsement or renewal.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coverage .

ind:servicingAgencyId rdf:type rdf:Property ;
    rdfs:label 'Servicing Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Tracks the agency of record for in-force coverage, supporting producer servicing assignments, commission calculations on earned premium, policy change routing, and producer performance' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:servicingProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Servicing Producers Producer Id' ;
    rdfs:comment 'Foreign key linking to producers.producers_producer. Business justification: Identifies the individual producer of record for the coverage, enabling producer-level commission allocation, book of business tracking, servicing responsibility assignment, and' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:isMandatoryCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory Coverage' ;
    rdfs:comment 'Indicates whether this coverage is required by law or regulation.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOptionalCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Optional Coverage' ;
    rdfs:comment 'Indicates whether this coverage was elected by the insured as optional.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Primary Coverage' ;
    rdfs:comment 'Indicates whether this is the primary coverage on the policy term.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Iso Coverage Code' ;
    rdfs:comment 'Standardized ISO code for this coverage type.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicLineCode rdf:type rdf:Property ;
    rdfs:label 'Naic Line Code' ;
    rdfs:comment 'NAIC line of business code for statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perOccurrenceLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit Amount' ;
    rdfs:comment 'Maximum amount payable per occurrence or event under this coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingBasis rdf:type rdf:Property ;
    rdfs:label 'Rating Basis' ;
    rdfs:comment 'Unit of measure used for rating (e.g., per $1000 of coverage, per vehicle, per square foot).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Sub Coverage Code' ;
    rdfs:comment 'Code for sub-coverage or endorsement modifying the base coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitId rdf:type rdf:Property ;
    rdfs:label 'Limit Id' ;
    rdfs:comment 'Unique identifier for the limit record. Primary key.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aggregateLimitPeriod rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Period' ;
    rdfs:comment 'Time period over which the aggregate limit applies: policy period, calendar year, accident year, or rolling 12 months.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToCoveragePart rdf:type rdf:Property ;
    rdfs:label 'Applies To Coverage Part' ;
    rdfs:comment 'Specific coverage part or section to which this limit applies (e.g., Coverage A, Coverage B, Medical Payments). Null if limit applies to entire coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToPeril rdf:type rdf:Property ;
    rdfs:label 'Applies To Peril' ;
    rdfs:comment 'Specific peril or cause of loss to which this limit applies (e.g., fire, wind, flood, earthquake, theft). Null if limit applies to all covered perils.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitCode rdf:type rdf:Property ;
    rdfs:label 'Limit Code' ;
    rdfs:comment 'Standard code or abbreviation for the limit type, often used in rating and policy administration systems (e.g., ISO limit codes).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitDescription rdf:type rdf:Property ;
    rdfs:label 'Limit Description' ;
    rdfs:comment 'Detailed textual description of the limit, including any special conditions, exclusions, or clarifications.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erosionMethod rdf:type rdf:Property ;
    rdfs:label 'Erosion Method' ;
    rdfs:comment 'Method by which the limit is eroded or depleted: per claim, per payment, or aggregate depletion over the policy period.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exhaustedDate rdf:type rdf:Property ;
    rdfs:label 'Exhausted Date' ;
    rdfs:comment 'Date on which the limit was fully exhausted by claim payments. Null if limit has not been exhausted.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCombinedSingleLimit rdf:type rdf:Property ;
    rdfs:label 'Is Combined Single Limit' ;
    rdfs:comment 'Indicates whether this is a combined single limit (CSL) covering bodily injury and property damage under one limit.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSharedLimit rdf:type rdf:Property ;
    rdfs:label 'Is Shared Limit' ;
    rdfs:comment 'Indicates whether this limit is shared across multiple coverages, insured risks, or policy terms.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStacked rdf:type rdf:Property ;
    rdfs:label 'Is Stacked' ;
    rdfs:comment 'Indicates whether this limit can be stacked with other limits (e.g., uninsured/underinsured motorist coverage).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoLimitCode rdf:type rdf:Property ;
    rdfs:label 'Iso Limit Code' ;
    rdfs:comment 'Standard ISO code for the limit type, used for rating and statistical reporting.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitStatus rdf:type rdf:Property ;
    rdfs:label 'Limit Status' ;
    rdfs:comment 'Current status of the limit: active, suspended, exhausted (fully depleted by claims), cancelled, or expired.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicLimitCode rdf:type rdf:Property ;
    rdfs:label 'Naic Limit Code' ;
    rdfs:comment 'NAIC standard code for the limit type, used for regulatory and statutory reporting.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Limit Amount' ;
    rdfs:comment 'Current remaining amount of the limit after deducting claim payments and reserves. Null if not tracked or if limit is not aggregate.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'Scope of the limit: primary, excess, umbrella, or sublimit within a broader coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:splitLimitBodilyInjuryPerAccident rdf:type rdf:Property ;
    rdfs:label 'Split Limit Bodily Injury Per Accident' ;
    rdfs:comment 'For split limits, the maximum amount payable for bodily injury per accident (all persons combined).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitLimitBodilyInjuryPerPerson rdf:type rdf:Property ;
    rdfs:label 'Split Limit Bodily Injury Per Person' ;
    rdfs:comment 'For split limits, the maximum amount payable for bodily injury per person per accident.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitLimitPropertyDamagePerAccident rdf:type rdf:Property ;
    rdfs:label 'Split Limit Property Damage Per Accident' ;
    rdfs:comment 'For split limits, the maximum amount payable for property damage per accident.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleId rdf:type rdf:Property ;
    rdfs:label 'Deductible Id' ;
    rdfs:comment 'Unique identifier for the deductible record. Primary key.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acordCode rdf:type rdf:Property ;
    rdfs:label 'Acord Code' ;
    rdfs:comment 'ACORD standard code for this deductible type, used for data exchange and reporting.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToLaeFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Lae Flag' ;
    rdfs:comment 'Indicates whether the deductible applies to Loss Adjustment Expenses in addition to the loss amount. True if LAE is subject to deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToSalvageFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Salvage Flag' ;
    rdfs:comment 'Indicates whether salvage recoveries reduce the deductible amount. True if salvage offsets deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToSubrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Subrogation Flag' ;
    rdfs:comment 'Indicates whether subrogation recoveries reduce the deductible amount. True if subrogation offsets deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleDescription rdf:type rdf:Property ;
    rdfs:label 'Deductible Description' ;
    rdfs:comment 'Free-text description of the deductible terms, conditions, and any special provisions or endorsements.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disappearingThreshold rdf:type rdf:Property ;
    rdfs:label 'Disappearing Threshold' ;
    rdfs:comment 'Loss amount at which a disappearing deductible fully disappears. Deductible reduces proportionally as loss approaches this threshold.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isoFormCode rdf:type rdf:Property ;
    rdfs:label 'Iso Form Code' ;
    rdfs:comment 'ISO form code or endorsement number that defines this deductible structure (e.g., IL 03 10, CP 03 10).' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Deductible Amount' ;
    rdfs:comment 'Maximum dollar amount for percentage-based or disappearing deductibles. Caps the deductible at this ceiling.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Deductible Amount' ;
    rdfs:comment 'Minimum dollar amount for percentage-based deductibles. Ensures deductible does not fall below this floor.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverAuthority rdf:type rdf:Property ;
    rdfs:label 'Waiver Authority' ;
    rdfs:comment 'Name or role of the person or system that authorized the deductible waiver.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Date' ;
    rdfs:comment 'Date on which the deductible waiver was granted.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Flag' ;
    rdfs:comment 'Indicates whether the deductible has been waived for this coverage. True if waived, False otherwise.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionId rdf:type rdf:Property ;
    rdfs:label 'Exclusion Id' ;
    rdfs:comment 'Unique identifier for the exclusion record. Primary key.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:excludedPartyId rdf:type rdf:Property ;
    rdfs:label 'Excluded Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Named exclusions (excluded driver in personal auto, excluded partner in commercial liability) explicitly identify a specific party to be excluded from coverage.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:specificInsuredRiskId rdf:type rdf:Property ;
    rdfs:label 'Specific Insured Risk Id' ;
    rdfs:comment 'Foreign key to a specific insured risk if this exclusion applies only to that risk. Null if exclusion applies to all risks under the coverage.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredRisk .

ind:supersededByExclusionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Exclusion Id' ;
    rdfs:comment 'Foreign key to the exclusion record that supersedes this one, if this exclusion has been replaced by a later endorsement. Null if current.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Exclusion .

ind:appliesToAllInsuredRisks rdf:type rdf:Property ;
    rdfs:label 'Applies To All Insured Risks' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies blanket to all insured risks under the coverage or only to specific risks.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToFirstParty rdf:type rdf:Property ;
    rdfs:label 'Applies To First Party' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies to first-party coverage under the policy.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToThirdParty rdf:type rdf:Property ;
    rdfs:label 'Applies To Third Party' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies to third-party liability coverage under the policy.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buybackEndorsementAvailable rdf:type rdf:Property ;
    rdfs:label 'Buyback Endorsement Available' ;
    rdfs:comment 'Boolean flag indicating whether a standard endorsement exists to buy back coverage for this exclusion.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buybackPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Buyback Premium Amount' ;
    rdfs:comment 'Additional premium charged to waive or buy back this exclusion, if applicable. Null if exclusion is not waivable.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusionCategory rdf:type rdf:Property ;
    rdfs:label 'Exclusion Category' ;
    rdfs:comment 'High-level classification of what dimension the exclusion applies to: specific peril, property type, activity, location, person, time period, condition, or other.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsMadeTrigger rdf:type rdf:Property ;
    rdfs:label 'Claims Made Trigger' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies only to claims-made policies or claims-made coverage triggers.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionCode rdf:type rdf:Property ;
    rdfs:label 'Exclusion Code' ;
    rdfs:comment 'Standard code identifying the exclusion type. May be ISO (Insurance Services Office) standard code or carrier-specific manuscript code.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionDescription rdf:type rdf:Property ;
    rdfs:label 'Exclusion Description' ;
    rdfs:comment 'Detailed narrative description of what perils, circumstances, or losses are excluded from coverage under this exclusion clause.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Endorsement Effective Date' ;
    rdfs:comment 'Date on which the endorsement introducing this exclusion became effective.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Exclusion Status' ;
    rdfs:comment 'Current lifecycle status of the exclusion: active and in force, inactive, superseded by a later endorsement, deleted, or pending approval.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionType rdf:type rdf:Property ;
    rdfs:label 'Exclusion Type' ;
    rdfs:comment 'Classification of the exclusion origin: ISO standard form, manuscript custom language, endorsement-based, statutory requirement, regulatory mandate, or carrier-specific.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoFormNumber rdf:type rdf:Property ;
    rdfs:label 'Iso Form Number' ;
    rdfs:comment 'ISO standard form number if this exclusion is derived from an ISO policy form or endorsement.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageText rdf:type rdf:Property ;
    rdfs:label 'Language Text' ;
    rdfs:comment 'Full legal text of the exclusion clause as it appears in the policy contract or endorsement.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionName rdf:type rdf:Property ;
    rdfs:label 'Exclusion Name' ;
    rdfs:comment 'Short business-friendly name of the exclusion for display and reporting purposes.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceTrigger rdf:type rdf:Property ;
    rdfs:label 'Occurrence Trigger' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies to occurrence-based policies or occurrence coverage triggers.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryMandateFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate Flag' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion is mandated by state or federal regulation and cannot be waived.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateMandateCode rdf:type rdf:Property ;
    rdfs:label 'State Mandate Code' ;
    rdfs:comment 'State jurisdiction code if this exclusion is mandated by a specific state Department of Insurance regulation.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waivableFlag rdf:type rdf:Property ;
    rdfs:label 'Waivable Flag' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion can be waived or bought back through an endorsement or additional premium.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateId rdf:type rdf:Property ;
    rdfs:label 'Rate Id' ;
    rdfs:comment 'Unique identifier for the rate element applied to a coverage during pricing.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:basisCode rdf:type rdf:Property ;
    rdfs:label 'Basis Code' ;
    rdfs:comment 'The unit of measure to which the rate applies: per hundred of coverage, per thousand, per unit, per vehicle, per location, per employee, per payroll unit, or flat amount.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCode rdf:type rdf:Property ;
    rdfs:label 'Rate Code' ;
    rdfs:comment 'The unique code identifying the rate element in the rating engine or rate table.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsuranceFactor rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Factor' ;
    rdfs:comment 'Factor applied when coinsurance provisions are in effect, adjusting premium based on the ratio of insurance to value.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleCreditFactor rdf:type rdf:Property ;
    rdfs:label 'Deductible Credit Factor' ;
    rdfs:comment 'Credit factor applied to reduce premium when a deductible is selected, reflecting reduced carrier exposure.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:experienceModifier rdf:type rdf:Property ;
    rdfs:label 'Experience Modifier' ;
    rdfs:comment 'Experience modification factor applied to adjust premium based on the insureds historical loss experience. Typically ranges from 0.500 to 2.000.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:factor rdf:type rdf:Property ;
    rdfs:label 'Factor' ;
    rdfs:comment 'Multiplicative factor applied to base rate for territory, class, or experience adjustments. Typically a decimal multiplier.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Filing Approval Date' ;
    rdfs:comment 'The date on which the state Department of Insurance (DOI) approved this rate for use.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingStateCode rdf:type rdf:Property ;
    rdfs:label 'Filing State Code' ;
    rdfs:comment 'Two-letter state code where this rate was filed and approved. Rates are state-specific in Property and Casualty insurance.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:increasedLimitsFactor rdf:type rdf:Property ;
    rdfs:label 'Increased Limits Factor' ;
    rdfs:comment 'Factor applied when coverage limits exceed the base limit, reflecting the increased exposure. Common in liability coverages.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Override Approval Date' ;
    rdfs:comment 'Date on which the rate override was approved.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Override Approved By' ;
    rdfs:comment 'Name or identifier of the underwriter or manager who approved the rate override.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingVariableName rdf:type rdf:Property ;
    rdfs:label 'Rating Variable Name' ;
    rdfs:comment 'Name of the rating variable or input factor used in the rating algorithm for this rate element.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingVariableValue rdf:type rdf:Property ;
    rdfs:label 'Rating Variable Value' ;
    rdfs:comment 'The value of the rating variable at the time of rating, captured for premium reconstruction and audit purposes.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCreditDebitAmount rdf:type rdf:Property ;
    rdfs:label 'Schedule Credit Debit Amount' ;
    rdfs:comment 'Dollar amount of schedule credit (negative) or debit (positive) applied for underwriting judgment factors such as management quality, safety programs, or loss control.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCreditDebitPercentage rdf:type rdf:Property ;
    rdfs:label 'Schedule Credit Debit Percentage' ;
    rdfs:comment 'Percentage credit (negative) or debit (positive) applied for underwriting judgment factors. Expressed as a percentage of base premium.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Cat Serial Number' ;
    rdfs:comment 'Industry-standard catastrophe serial number assigned by ISO or PCS for declared catastrophe events.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedTotalLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Total Loss Amount' ;
    rdfs:comment 'Initial estimated total financial impact of the loss event across all affected claims and coverages.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fatalityOccurred rdf:type rdf:Property ;
    rdfs:label 'Fatality Occurred' ;
    rdfs:comment 'Indicates whether a fatality occurred as part of this loss event, requiring special handling and reporting.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fireDepartmentNotified rdf:type rdf:Property ;
    rdfs:label 'Fire Department Notified' ;
    rdfs:comment 'Indicates whether the fire department was notified and responded to this loss event.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fireReportNumber rdf:type rdf:Property ;
    rdfs:label 'Fire Report Number' ;
    rdfs:comment 'Official fire department report number or incident number for fire-related losses.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryOccurred rdf:type rdf:Property ;
    rdfs:label 'Injury Occurred' ;
    rdfs:comment 'Indicates whether bodily injury occurred as part of this loss event, triggering liability and medical coverage.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCatastropheLoss rdf:type rdf:Property ;
    rdfs:label 'Is Catastrophe Loss' ;
    rdfs:comment 'Indicates whether this loss event is part of a declared catastrophe event for aggregation and reinsurance purposes.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLargeLoss rdf:type rdf:Property ;
    rdfs:label 'Is Large Loss' ;
    rdfs:comment 'Indicates whether this loss exceeds the threshold for large loss reporting and special handling.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:largeLossThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Large Loss Threshold Amount' ;
    rdfs:comment 'Monetary threshold amount that defines a large loss for this event, used for reinsurance and escalation.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossComplexityCode rdf:type rdf:Property ;
    rdfs:label 'Loss Complexity Code' ;
    rdfs:comment 'Classification of the loss event by complexity, used for adjuster assignment and workflow routing.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossDiscoveryDate rdf:type rdf:Property ;
    rdfs:label 'Loss Discovery Date' ;
    rdfs:comment 'Date when the loss was first discovered or became known to the insured or insurer.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossEventStatus rdf:type rdf:Property ;
    rdfs:label 'Loss Event Status' ;
    rdfs:comment 'Current lifecycle state of the loss event in the claims workflow.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossEventType rdf:type rdf:Property ;
    rdfs:label 'Loss Event Type' ;
    rdfs:comment 'Classification of the physical loss occurrence by peril or cause of loss. [ENUM-REF-CANDIDATE: fire|water_damage|wind|hail|theft|vandalism|collision|liability|weather|flood|earthquake|explosion|other — 13 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossLocationAddress rdf:type rdf:Property ;
    rdfs:label 'Loss Location Address' ;
    rdfs:comment 'Street address where the loss event occurred. Used for catastrophe aggregation and geographic analysis.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossLocationCity rdf:type rdf:Property ;
    rdfs:label 'Loss Location City' ;
    rdfs:comment 'City where the loss event occurred.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossLocationCountry rdf:type rdf:Property ;
    rdfs:label 'Loss Location Country' ;
    rdfs:comment 'Three-letter ISO country code where the loss event occurred.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossLocationLatitude rdf:type rdf:Property ;
    rdfs:label 'Loss Location Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the loss location, used for catastrophe modeling and spatial analysis.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossLocationLongitude rdf:type rdf:Property ;
    rdfs:label 'Loss Location Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the loss location, used for catastrophe modeling and spatial analysis.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossLocationPostalCode rdf:type rdf:Property ;
    rdfs:label 'Loss Location Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the loss location, used for geocoding and catastrophe zone assignment.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossLocationState rdf:type rdf:Property ;
    rdfs:label 'Loss Location State' ;
    rdfs:comment 'State or province where the loss event occurred. Critical for regulatory reporting and territorial analysis.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossOccurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Loss Occurrence Date' ;
    rdfs:comment 'The calendar date on which the physical loss event occurred. Critical for policy coverage determination and loss reserving.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossOccurrenceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Loss Occurrence Timestamp' ;
    rdfs:comment 'Precise date and time when the loss event occurred, used for detailed event sequencing and catastrophe modeling.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lossReportedDate rdf:type rdf:Property ;
    rdfs:label 'Loss Reported Date' ;
    rdfs:comment 'Date when the loss was formally reported to the insurer, triggering First Notice of Loss (FNOL) processing.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossSeverityCode rdf:type rdf:Property ;
    rdfs:label 'Loss Severity Code' ;
    rdfs:comment 'Classification of the loss event by severity level, used for triage and resource allocation.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfFatalities rdf:type rdf:Property ;
    rdfs:label 'Number Of Fatalities' ;
    rdfs:comment 'Count of fatalities resulting from this loss event.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfInjuries rdf:type rdf:Property ;
    rdfs:label 'Number Of Injuries' ;
    rdfs:comment 'Count of individuals injured in this loss event.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policeReportFiled rdf:type rdf:Property ;
    rdfs:label 'Police Report Filed' ;
    rdfs:comment 'Indicates whether a police report was filed for this loss event, relevant for theft, vandalism, and liability claims.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policeReportNumber rdf:type rdf:Property ;
    rdfs:label 'Police Report Number' ;
    rdfs:comment 'Official police report number or case number associated with this loss event.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reopenedDate rdf:type rdf:Property ;
    rdfs:label 'Reopened Date' ;
    rdfs:comment 'Date when a previously closed loss event was reopened for additional investigation or claims processing.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:thirdPartyInvolved rdf:type rdf:Property ;
    rdfs:label 'Third Party Involved' ;
    rdfs:comment 'Indicates whether a third party is involved in this loss event, triggering liability investigation.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weatherCondition rdf:type rdf:Property ;
    rdfs:label 'Weather Condition' ;
    rdfs:comment 'Description of weather conditions at the time of loss, relevant for weather-related perils.' ;
    rdfs:domain ind:LossEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimAdjusterPartyId rdf:type rdf:Property ;
    rdfs:label 'Claim Adjuster Party Id' ;
    rdfs:comment 'Foreign key to the party record of the assigned adjuster.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:primaryClaimantPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Claimant Party Id' ;
    rdfs:comment 'Foreign key to the party record of the primary claimant.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:claimantType rdf:type rdf:Property ;
    rdfs:label 'Claimant Type' ;
    rdfs:comment 'Indicates whether the claimant is a first-party or third-party claimant.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fnolDate rdf:type rdf:Property ;
    rdfs:label 'Fnol Date' ;
    rdfs:comment 'Date when the claim was first reported to the insurer.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fnolTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fnol Timestamp' ;
    rdfs:comment 'Precise timestamp when the claim was first reported to the insurer.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:litigationDate rdf:type rdf:Property ;
    rdfs:label 'Litigation Date' ;
    rdfs:comment 'Date when litigation was initiated for this claim.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossTime rdf:type rdf:Property ;
    rdfs:label 'Loss Time' ;
    rdfs:comment 'Precise time when the loss or accident occurred, if known.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reinsuranceFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Flag' ;
    rdfs:comment 'Indicates whether this claim is subject to reinsurance cession.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salvageFlag rdf:type rdf:Property ;
    rdfs:label 'Salvage Flag' ;
    rdfs:comment 'Indicates whether salvage recovery is applicable for this claim.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siuFlag rdf:type rdf:Property ;
    rdfs:label 'Siu Flag' ;
    rdfs:comment 'Indicates whether this claim has been referred to the Special Investigations Unit for fraud investigation.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statusReason rdf:type rdf:Property ;
    rdfs:label 'Status Reason' ;
    rdfs:comment 'Reason or explanation for the current claim status.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Flag' ;
    rdfs:comment 'Indicates whether subrogation is being pursued for this claim.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attorneyContactEmail rdf:type rdf:Property ;
    rdfs:label 'Attorney Contact Email' ;
    rdfs:comment 'Primary email address for the claimant\'s attorney or law firm.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attorneyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Attorney Contact Phone' ;
    rdfs:comment 'Primary contact phone number for the claimant\'s attorney or law firm.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attorneyName rdf:type rdf:Property ;
    rdfs:label 'Attorney Name' ;
    rdfs:comment 'Full name of the attorney or law firm representing the claimant, if applicable.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantStatus rdf:type rdf:Property ;
    rdfs:label 'Claimant Status' ;
    rdfs:comment 'Current lifecycle status of the claimant within the claim: active, closed, withdrawn, settled, denied, or pending investigation.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPreference rdf:type rdf:Property ;
    rdfs:label 'Contact Preference' ;
    rdfs:comment 'Preferred method of communication for the claimant: email, phone, mail, SMS, or online portal.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateOfInjury rdf:type rdf:Property ;
    rdfs:label 'Date Of Injury' ;
    rdfs:comment 'The specific date on which the claimant sustained the injury or damage, which may differ from the loss event date in some cases.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:faultIndicator rdf:type rdf:Property ;
    rdfs:label 'Fault Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the claimant is determined to be at fault in the loss event. True if at fault, False otherwise.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:guardianContactPhone rdf:type rdf:Property ;
    rdfs:label 'Guardian Contact Phone' ;
    rdfs:comment 'Primary contact phone number for the claimant\'s legal guardian or parent.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalName rdf:type rdf:Property ;
    rdfs:label 'Hospital Name' ;
    rdfs:comment 'Name of the hospital or medical facility where the claimant received treatment, if applicable.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalizationFlag rdf:type rdf:Property ;
    rdfs:label 'Hospitalization Flag' ;
    rdfs:comment 'Boolean flag indicating whether the claimant was hospitalized as a result of the loss event. True if hospitalized, False otherwise.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:injuryDescription rdf:type rdf:Property ;
    rdfs:label 'Injury Description' ;
    rdfs:comment 'Detailed narrative description of the injury or damage sustained by the claimant, as reported during First Notice of Loss (FNOL) or investigation.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injurySeverityCode rdf:type rdf:Property ;
    rdfs:label 'Injury Severity Code' ;
    rdfs:comment 'Standardized severity classification of the injury: minor, moderate, major, catastrophic, or fatal.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryType rdf:type rdf:Property ;
    rdfs:label 'Injury Type' ;
    rdfs:comment 'Type of injury or damage sustained by the claimant: bodily injury, property damage, both, or none.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityPercentage rdf:type rdf:Property ;
    rdfs:label 'Liability Percentage' ;
    rdfs:comment 'Percentage of liability attributed to this claimant in comparative negligence or contributory negligence scenarios, ranging from 0.00 to 100.00.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicalTreatmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Treatment Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether the claimant required or is receiving medical treatment for injuries sustained. True if treatment required, False otherwise.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorFlag rdf:type rdf:Property ;
    rdfs:label 'Minor Flag' ;
    rdfs:comment 'Boolean flag indicating whether the claimant is a minor (under 18 years of age). True if minor, False otherwise.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Email' ;
    rdfs:comment 'Primary email address to reach the claimant for claim-related communications.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Phone' ;
    rdfs:comment 'Primary phone number to reach the claimant for claim-related communications.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseSignedDate rdf:type rdf:Property ;
    rdfs:label 'Release Signed Date' ;
    rdfs:comment 'Date on which the claimant signed the legal release document.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:releaseSignedFlag rdf:type rdf:Property ;
    rdfs:label 'Release Signed Flag' ;
    rdfs:comment 'Boolean flag indicating whether the claimant has signed a legal release waiving further claims. True if signed, False otherwise.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:representedByAttorneyFlag rdf:type rdf:Property ;
    rdfs:label 'Represented By Attorney Flag' ;
    rdfs:comment 'Boolean flag indicating whether the claimant is represented by legal counsel. True if represented, False otherwise.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementDemandAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Demand Amount' ;
    rdfs:comment 'The monetary amount demanded by the claimant or their attorney for settlement of the claim.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementOfferAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Offer Amount' ;
    rdfs:comment 'The monetary amount offered by the insurer to settle the claimant\'s portion of the claim.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationPotentialFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Potential Flag' ;
    rdfs:comment 'Boolean flag indicating whether this claimant presents potential for subrogation recovery. True if potential exists, False otherwise.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:treatingPhysicianName rdf:type rdf:Property ;
    rdfs:label 'Treating Physician Name' ;
    rdfs:comment 'Full name of the primary physician treating the claimant for injuries sustained in the loss event.' ;
    rdfs:domain ind:Claimant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimPartyRole rdf:type rdf:Property ;
    rdfs:label 'Claim Party Role' ;
    rdfs:comment 'Indicates whether the claimant is a first party (insured) or third party (external claimant).' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureNumber rdf:type rdf:Property ;
    rdfs:label 'Exposure Number' ;
    rdfs:comment 'Business identifier for the exposure, often a concatenation of claim number and coverage line sequence.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Flag' ;
    rdfs:comment 'True if this exposure has been flagged for potential fraud by SIU or fraud detection systems.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Lae Paid Amount' ;
    rdfs:comment 'Total allocated loss adjustment expense paid to date on this exposure.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laeReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Lae Reserve Amount' ;
    rdfs:comment 'Current outstanding allocated loss adjustment expense reserve for this exposure.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Liability Indicator' ;
    rdfs:comment 'True if this exposure involves liability coverage; false for property or other first-party coverages.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCause rdf:type rdf:Property ;
    rdfs:label 'Loss Cause' ;
    rdfs:comment 'Peril or cause of loss for this exposure (e.g., Fire, Theft, Collision, Wind, Hail, Water Damage, Vandalism).' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outstandingReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Reserve Amount' ;
    rdfs:comment 'Current outstanding case reserve for this exposure. Snapshot value for reporting.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceCededFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Ceded Flag' ;
    rdfs:comment 'True if this exposure has been ceded to reinsurance under treaty or facultative agreements.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date the exposure was first reported to the insurer. Used for IBNR lag analysis and reporting year assignment.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salvagePotentialFlag rdf:type rdf:Property ;
    rdfs:label 'Salvage Potential Flag' ;
    rdfs:comment 'True if the exposure has potential for salvage recovery (e.g., damaged vehicle or property).' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementType rdf:type rdf:Property ;
    rdfs:label 'Settlement Type' ;
    rdfs:comment 'Type of settlement reached for this exposure. Nullable until settled.' ;
    rdfs:domain ind:ClaimExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimStatusId rdf:type rdf:Property ;
    rdfs:label 'Claim Status Id' ;
    rdfs:comment 'Unique identifier for each claim status transition record. Primary key.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryStatusClaimId rdf:type rdf:Property ;
    rdfs:label 'Primary Status Claim Id' ;
    rdfs:comment 'Foreign key to the parent claim for which this status transition applies.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:approvedByUserName rdf:type rdf:Property ;
    rdfs:label 'Approved By User Name' ;
    rdfs:comment 'Full name of the supervisor or manager who approved this status transition, for audit trail purposes.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureTypeCode rdf:type rdf:Property ;
    rdfs:label 'Closure Type Code' ;
    rdfs:comment 'Classification of how the claim was closed, applicable only when status is CLOSED. Supports loss ratio and settlement analytics.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Timestamp' ;
    rdfs:comment 'Date and time when this status became effective, supporting point-in-time queries and regulatory reporting.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expirationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expiration Timestamp' ;
    rdfs:comment 'Date and time when this status ceased to be effective, nullable for current status. Enables temporal queries.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fraudInvestigationFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Investigation Flag' ;
    rdfs:comment 'Indicates whether the claim is under fraud investigation by Special Investigations Unit at this status point.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCurrentStatus rdf:type rdf:Property ;
    rdfs:label 'Is Current Status' ;
    rdfs:comment 'Boolean flag indicating whether this is the current active status for the claim. True for latest, false for historical.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:litigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Litigation Start Date' ;
    rdfs:comment 'Date when litigation commenced for this claim, nullable if not litigated. Supports legal expense tracking.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:previousStatusCode rdf:type rdf:Property ;
    rdfs:label 'Previous Status Code' ;
    rdfs:comment 'Status code immediately prior to this transition, enabling lifecycle reconstruction and audit trail.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reopenCount rdf:type rdf:Property ;
    rdfs:label 'Reopen Count' ;
    rdfs:comment 'Cumulative number of times the claim has been reopened as of this status transition, indicating claim complexity.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusCode rdf:type rdf:Property ;
    rdfs:label 'Status Code' ;
    rdfs:comment 'Current lifecycle status of the claim at this transition point.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusDurationDays rdf:type rdf:Property ;
    rdfs:label 'Status Duration Days' ;
    rdfs:comment 'Number of calendar days the claim remained in this status, calculated for cycle time and performance analytics.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusNotes rdf:type rdf:Property ;
    rdfs:label 'Status Notes' ;
    rdfs:comment 'Free-text notes or comments recorded by the adjuster or system at the time of status transition, supporting claim documentation.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusReasonCode rdf:type rdf:Property ;
    rdfs:label 'Status Reason Code' ;
    rdfs:comment 'Coded reason explaining why the status transition occurred, aligned with business rules and regulatory requirements.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Status Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of the reason for the status change, supporting audit and regulatory review.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusSetByUserCode rdf:type rdf:Property ;
    rdfs:label 'Status Set By User Code' ;
    rdfs:comment 'System identifier of the user or automated process that triggered this status transition.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusSetByUserName rdf:type rdf:Property ;
    rdfs:label 'Status Set By User Name' ;
    rdfs:comment 'Full name of the user who set this status, supporting audit and accountability requirements.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemSourceCode rdf:type rdf:Property ;
    rdfs:label 'System Source Code' ;
    rdfs:comment 'Code identifying the source system that recorded this status transition, supporting multi-system integration and data lineage.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStepCode rdf:type rdf:Property ;
    rdfs:label 'Workflow Step Code' ;
    rdfs:comment 'Code representing the workflow step or stage in the claims process at this status transition.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStepName rdf:type rdf:Property ;
    rdfs:label 'Workflow Step Name' ;
    rdfs:comment 'Human-readable name of the workflow step or stage in the claims adjudication process.' ;
    rdfs:domain ind:ClaimStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Adjuster Id' ;
    rdfs:comment 'Reference to the supervising adjuster or claims manager overseeing this adjuster\'s work.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:adjusterStatus rdf:type rdf:Property ;
    rdfs:label 'Adjuster Status' ;
    rdfs:comment 'Current operational status of the adjuster indicating availability for claim assignments.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheQualifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Qualified Flag' ;
    rdfs:comment 'Indicates whether the adjuster is qualified and available for catastrophe event deployments.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationDesignations rdf:type rdf:Property ;
    rdfs:label 'Certification Designations' ;
    rdfs:comment 'Professional certifications held by the adjuster such as AIC, CPCU, SCLA, or other industry designations.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentCaseloadCount rdf:type rdf:Property ;
    rdfs:label 'Current Caseload Count' ;
    rdfs:comment 'Number of open claims currently assigned to the adjuster.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fieldAdjusterFlag rdf:type rdf:Property ;
    rdfs:label 'Field Adjuster Flag' ;
    rdfs:comment 'Indicates whether the adjuster conducts on-site field inspections versus desk-only adjusting.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hireDate rdf:type rdf:Property ;
    rdfs:label 'Hire Date' ;
    rdfs:comment 'Date the adjuster was hired or contracted by the insurer or TPA.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:homeOfficeLocation rdf:type rdf:Property ;
    rdfs:label 'Home Office Location' ;
    rdfs:comment 'Primary office or geographic location where the adjuster is based.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageSkills rdf:type rdf:Property ;
    rdfs:label 'Language Skills' ;
    rdfs:comment 'Comma-separated list of languages the adjuster is fluent in for claimant communication.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformanceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Performance Review Date' ;
    rdfs:comment 'Date of the most recent formal performance review.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxCaseloadCapacity rdf:type rdf:Property ;
    rdfs:label 'Max Caseload Capacity' ;
    rdfs:comment 'Maximum number of concurrent claims the adjuster can handle based on workload management policies.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxClaimAuthority rdf:type rdf:Property ;
    rdfs:label 'Max Claim Authority' ;
    rdfs:comment 'Maximum dollar amount the adjuster is authorized to settle without supervisory approval.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:multiStateLicensedFlag rdf:type rdf:Property ;
    rdfs:label 'Multi State Licensed Flag' ;
    rdfs:comment 'Indicates whether the adjuster holds licenses in multiple states.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Most recent performance evaluation rating for the adjuster.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritory rdf:type rdf:Property ;
    rdfs:label 'Service Territory' ;
    rdfs:comment 'Geographic territory or region the adjuster is assigned to cover for claim investigations.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyLines rdf:type rdf:Property ;
    rdfs:label 'Specialty Lines' ;
    rdfs:comment 'Comma-separated list of insurance lines the adjuster specializes in handling, such as property, auto, liability, workers compensation.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCompanyName rdf:type rdf:Property ;
    rdfs:label 'Vendor Company Name' ;
    rdfs:comment 'Name of the independent adjusting firm or TPA if the adjuster is not a staff employee.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContractNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Contract Number' ;
    rdfs:comment 'Contract identifier for independent or TPA adjusters linking to the vendor agreement.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsExperience rdf:type rdf:Property ;
    rdfs:label 'Years Experience' ;
    rdfs:comment 'Total years of claims adjusting experience across all employers.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjusterAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Adjuster Assignment Id' ;
    rdfs:comment 'Unique identifier for the adjuster assignment record. Primary key.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Primary Adjuster Id' ;
    rdfs:comment 'The adjuster assigned to handle the claim or exposure.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:assignedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Assigned By User Code' ;
    rdfs:comment 'The system user or supervisor who made the assignment. Null for automatic assignments.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Assignment Authority Level' ;
    rdfs:comment 'The level of authority the adjuster has in this assignment: full settlement authority, limited, or advisory only.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Date' ;
    rdfs:comment 'The date the adjuster was assigned to the claim or exposure.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assignment Method' ;
    rdfs:comment 'The method used to assign the adjuster: automatic routing, manual selection, or rule-based assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes' ;
    rdfs:comment 'Free-text notes or instructions provided at the time of assignment, such as special handling requirements or context.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assignment Number' ;
    rdfs:comment 'Business identifier for the assignment, often used in workflow systems and correspondence.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentRole rdf:type rdf:Property ;
    rdfs:label 'Assignment Role' ;
    rdfs:comment 'The role the adjuster plays in this assignment: primary handler, supervisor, specialist, or support. [ENUM-REF-CANDIDATE: primary|secondary|supervisor|desk|field|independent|catastrophe|specialist — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Assignment Source System' ;
    rdfs:comment 'The system that originated this assignment record: ClaimCenter, legacy system, or external vendor platform.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Assignment Source System Code' ;
    rdfs:comment 'The unique identifier for this assignment in the source system, used for reconciliation and traceability.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current lifecycle status of the adjuster assignment. [ENUM-REF-CANDIDATE: assigned|active|suspended|completed|closed|reassigned|withdrawn — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assignment Timestamp' ;
    rdfs:comment 'The precise date and time the assignment was created in the system.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentType rdf:type rdf:Property ;
    rdfs:label 'Assignment Type' ;
    rdfs:comment 'The nature of the assignment: initial assignment, reassignment, escalation, or specialist referral.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'The date the adjuster completed their work on the assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Expected Completion Date' ;
    rdfs:comment 'The target date by which the adjuster is expected to complete their work on this assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geographicTerritory rdf:type rdf:Property ;
    rdfs:label 'Geographic Territory' ;
    rdfs:comment 'The geographic territory or region this assignment covers, relevant for field adjusters.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Indicates whether this assignment is currently active. False for completed, closed, or superseded assignments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryAdjuster rdf:type rdf:Property ;
    rdfs:label 'Is Primary Adjuster' ;
    rdfs:comment 'Indicates whether this adjuster is the primary handler for the claim or exposure. True for primary, false for secondary or support roles.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSupervisorAssignment rdf:type rdf:Property ;
    rdfs:label 'Is Supervisor Assignment' ;
    rdfs:comment 'Indicates whether this is a supervisory assignment for oversight and quality review rather than primary handling.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reassignmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reassignment Reason Code' ;
    rdfs:comment 'Standardized code indicating why the claim was reassigned from a previous adjuster.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reassignmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reassignment Reason Description' ;
    rdfs:comment 'Detailed explanation of why the assignment was transferred to this adjuster.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Reserve Authority Limit' ;
    rdfs:comment 'The maximum reserve amount the adjuster can set without supervisor approval for this assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceLevelAgreementDays rdf:type rdf:Property ;
    rdfs:label 'Service Level Agreement Days' ;
    rdfs:comment 'The number of days within which the adjuster must take initial action or complete key milestones per service level agreement.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:settlementAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Settlement Authority Limit' ;
    rdfs:comment 'The maximum settlement amount the adjuster can approve without escalation for this assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialtyLine rdf:type rdf:Property ;
    rdfs:label 'Specialty Line' ;
    rdfs:comment 'The line of business specialty for which the adjuster was assigned: property, auto, liability, workers compensation, etc.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workloadAtAssignment rdf:type rdf:Property ;
    rdfs:label 'Workload At Assignment' ;
    rdfs:comment 'The number of open claims the adjuster had at the time of this assignment, used for workload balancing analysis.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fnolId rdf:type rdf:Property ;
    rdfs:label 'Fnol Id' ;
    rdfs:comment 'Unique identifier for the FNOL submission record.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Assigned Adjuster Id' ;
    rdfs:comment 'Reference to the adjuster assigned to investigate the FNOL, if assigned during intake.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:reporterPartyId rdf:type rdf:Property ;
    rdfs:label 'Reporter Party Id' ;
    rdfs:comment 'Reference to the party who reported the loss (policyholder, agent, claimant, or third party).' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:reporterPartyRoleId rdf:type rdf:Property ;
    rdfs:label 'Reporter Party Role Id' ;
    rdfs:comment 'Reference to the specific role the reporter was acting in at the time of report (policyholder, named insured, agent, claimant).' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Role .

ind:catEventFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Event Flag' ;
    rdfs:comment 'Indicates whether the loss is associated with a declared catastrophe event.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimOpenedFlag rdf:type rdf:Property ;
    rdfs:label 'Claim Opened Flag' ;
    rdfs:comment 'Indicates whether a formal claim record has been created from this FNOL submission.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Loss Amount' ;
    rdfs:comment 'Initial estimate of the loss amount provided by the reporter at the time of FNOL.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fatalityFlag rdf:type rdf:Property ;
    rdfs:label 'Fatality Flag' ;
    rdfs:comment 'Indicates whether a fatality occurred as part of the loss event.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fnolStatus rdf:type rdf:Property ;
    rdfs:label 'Fnol Status' ;
    rdfs:comment 'Current status of the FNOL submission in the intake and triage workflow.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryFlag rdf:type rdf:Property ;
    rdfs:label 'Injury Flag' ;
    rdfs:comment 'Indicates whether bodily injury was reported as part of the loss.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policeDepartment rdf:type rdf:Property ;
    rdfs:label 'Police Department' ;
    rdfs:comment 'Name of the police department or law enforcement agency that took the report.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policeReportFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Police Report Filed Flag' ;
    rdfs:comment 'Indicates whether a police report was filed for the loss event.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyDamageFlag rdf:type rdf:Property ;
    rdfs:label 'Property Damage Flag' ;
    rdfs:comment 'Indicates whether property damage was reported as part of the loss.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Reason the FNOL was rejected or not converted to a formal claim, if applicable.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportChannel rdf:type rdf:Property ;
    rdfs:label 'Report Channel' ;
    rdfs:comment 'Channel through which the loss was reported.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Timestamp' ;
    rdfs:comment 'Precise date and time the FNOL was submitted or received by the system.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reporterContactEmail rdf:type rdf:Property ;
    rdfs:label 'Reporter Contact Email' ;
    rdfs:comment 'Email address of the reporter for follow-up communication.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reporterContactPhone rdf:type rdf:Property ;
    rdfs:label 'Reporter Contact Phone' ;
    rdfs:comment 'Phone number of the reporter for follow-up communication.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Third Party Involved Flag' ;
    rdfs:comment 'Indicates whether a third party (non-insured) is involved in the loss event.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triagePriority rdf:type rdf:Property ;
    rdfs:label 'Triage Priority' ;
    rdfs:comment 'Priority level assigned to the FNOL for adjuster assignment and investigation, based on severity and complexity.' ;
    rdfs:domain ind:Fnol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defenseCounselPartyId rdf:type rdf:Property ;
    rdfs:label 'Defense Counsel Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Defense attorneys are parties requiring tracking for legal billing, conflict checks, panel counsel management, and regulatory reporting.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:appealDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Date' ;
    rdfs:comment 'Date the appeal was filed.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Flag' ;
    rdfs:comment 'Indicates whether an appeal has been filed following the verdict.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:causeOfAction rdf:type rdf:Property ;
    rdfs:label 'Cause Of Action' ;
    rdfs:comment 'Legal basis or grounds for the lawsuit, such as negligence, breach of contract, or bad faith.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date the litigation was formally closed in the claims system.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:confidentialityFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Flag' ;
    rdfs:comment 'Indicates whether the litigation settlement or details are subject to a confidentiality agreement.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:courtJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Court Jurisdiction' ;
    rdfs:comment 'Name of the court or jurisdiction where the lawsuit is filed, including district or county.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtType rdf:type rdf:Property ;
    rdfs:label 'Court Type' ;
    rdfs:comment 'Type or level of court handling the litigation.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defenseCostIncurred rdf:type rdf:Property ;
    rdfs:label 'Defense Cost Incurred' ;
    rdfs:comment 'Total defense and cost containment expenses incurred for this litigation.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dismissalDate rdf:type rdf:Property ;
    rdfs:label 'Dismissal Date' ;
    rdfs:comment 'Date the lawsuit was dismissed by the court.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dismissalReason rdf:type rdf:Property ;
    rdfs:label 'Dismissal Reason' ;
    rdfs:comment 'Reason provided for the dismissal of the lawsuit, such as lack of jurisdiction or settlement.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawsuitNumber rdf:type rdf:Property ;
    rdfs:label 'Lawsuit Number' ;
    rdfs:comment 'Court-assigned case number or docket number for the lawsuit.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:litigationType rdf:type rdf:Property ;
    rdfs:label 'Litigation Type' ;
    rdfs:comment 'Classification of the litigation based on the nature of the dispute.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediationDate rdf:type rdf:Property ;
    rdfs:label 'Mediation Date' ;
    rdfs:comment 'Date of scheduled or completed mediation session.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plaintiffAttorneyFirm rdf:type rdf:Property ;
    rdfs:label 'Plaintiff Attorney Firm' ;
    rdfs:comment 'Law firm name representing the plaintiff.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plaintiffAttorneyName rdf:type rdf:Property ;
    rdfs:label 'Plaintiff Attorney Name' ;
    rdfs:comment 'Name of the attorney or law firm representing the plaintiff.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plaintiffAttorneyPhone rdf:type rdf:Property ;
    rdfs:label 'Plaintiff Attorney Phone' ;
    rdfs:comment 'Contact phone number for the plaintiff attorney.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plaintiffName rdf:type rdf:Property ;
    rdfs:label 'Plaintiff Name' ;
    rdfs:comment 'Name of the plaintiff or claimant who filed the lawsuit.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trialDate rdf:type rdf:Property ;
    rdfs:label 'Trial Date' ;
    rdfs:comment 'Scheduled date for the trial or hearing.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:venueCounty rdf:type rdf:Property ;
    rdfs:label 'Venue County' ;
    rdfs:comment 'County where the lawsuit is being heard.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueState rdf:type rdf:Property ;
    rdfs:label 'Venue State' ;
    rdfs:comment 'State where the lawsuit is being heard.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verdictAmount rdf:type rdf:Property ;
    rdfs:label 'Verdict Amount' ;
    rdfs:comment 'Monetary award determined by the court or jury in the verdict.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:verdictDate rdf:type rdf:Property ;
    rdfs:label 'Verdict Date' ;
    rdfs:comment 'Date the court or jury rendered a verdict.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verdictType rdf:type rdf:Property ;
    rdfs:label 'Verdict Type' ;
    rdfs:comment 'Outcome of the verdict indicating which party prevailed.' ;
    rdfs:domain ind:Litigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryName rdf:type rdf:Property ;
    rdfs:label 'Country Name' ;
    rdfs:comment 'Full name of the primary country or territory that issues the currency.' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayFormat rdf:type rdf:Property ;
    rdfs:label 'Display Format' ;
    rdfs:comment 'Standard display format pattern for currency amounts (e.g., $1,234.56 or 1.234,56 €).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCrypto rdf:type rdf:Property ;
    rdfs:label 'Is Crypto' ;
    rdfs:comment 'Indicates whether the currency is a cryptocurrency or digital asset rather than fiat currency.' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPreciousMetal rdf:type rdf:Property ;
    rdfs:label 'Is Precious Metal' ;
    rdfs:comment 'Indicates whether the currency represents a precious metal commodity (e.g., XAU for gold, XAG for silver).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorUnit rdf:type rdf:Property ;
    rdfs:label 'Minor Unit' ;
    rdfs:comment 'Number of decimal places for the currency\'s minor unit (e.g., 2 for USD cents, 0 for JPY).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currencyName rdf:type rdf:Property ;
    rdfs:label 'Currency Name' ;
    rdfs:comment 'Full official name of the currency (e.g., United States Dollar, Euro, British Pound Sterling).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numericCode rdf:type rdf:Property ;
    rdfs:label 'Numeric Code' ;
    rdfs:comment 'Three-digit numeric ISO 4217 currency code (e.g., 840 for USD, 978 for EUR).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roundingMethod rdf:type rdf:Property ;
    rdfs:label 'Rounding Method' ;
    rdfs:comment 'Standard rounding method applied to currency amounts (standard, up, down, nearest).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric value used to control the display order of currencies in user interfaces and reports.' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:symbol rdf:type rdf:Property ;
    rdfs:label 'Symbol' ;
    rdfs:comment 'Standard symbol used to represent the currency (e.g., $, €, £, ¥).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheExposed rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Exposed' ;
    rdfs:comment 'Indicates whether this line of business is exposed to catastrophe perils such as hurricane, earthquake, wildfire, requiring CAT modeling and PML analysis.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:combinedRatioTargetPct rdf:type rdf:Property ;
    rdfs:label 'Combined Ratio Target Pct' ;
    rdfs:comment 'Target combined ratio percentage for this line of business, calculated as loss ratio plus expense ratio, used for profitability assessment.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Default Commission Pct' ;
    rdfs:comment 'Standard commission percentage paid to producers for new business in this line of business, subject to producer appointment and agency agreement terms.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultPolicyTermMonths rdf:type rdf:Property ;
    rdfs:label 'Default Policy Term Months' ;
    rdfs:comment 'Standard policy term duration in months for this line of business, typically 12 months for annual policies or 6 months for semi-annual policies.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineOfBusinessDescription rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Description' ;
    rdfs:comment 'Detailed business description of the line of business, including coverage scope, typical insured risks, and key characteristics.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseRatioTargetPct rdf:type rdf:Property ;
    rdfs:label 'Expense Ratio Target Pct' ;
    rdfs:comment 'Target expense ratio percentage for this line of business, including commission, underwriting expenses, and general overhead allocation.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAdmitted rdf:type rdf:Property ;
    rdfs:label 'Is Admitted' ;
    rdfs:comment 'Indicates whether this line of business is written on an admitted basis, subject to state guaranty fund protection and rate/form regulation.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSurplusLines rdf:type rdf:Property ;
    rdfs:label 'Is Surplus Lines' ;
    rdfs:comment 'Indicates whether this line of business is written on a surplus lines basis, requiring stamping office approval and diligent search documentation.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoLineCode rdf:type rdf:Property ;
    rdfs:label 'Iso Line Code' ;
    rdfs:comment 'ISO standard code for the line of business, used for forms, rating, and industry benchmarking.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineOfBusinessStatus rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Status' ;
    rdfs:comment 'Current operational status of the line of business, indicating whether it is actively written, inactive, discontinued, or pending regulatory approval.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Lob Abbreviation' ;
    rdfs:comment 'Standard industry abbreviation for the line of business, such as HO, PAP, CGL, BOP, CPP, WC, CA.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobType rdf:type rdf:Property ;
    rdfs:label 'Lob Type' ;
    rdfs:comment 'Primary type classification of the line of business, indicating whether it is Property, Casualty, Liability, Auto, Workers Compensation, or Package coverage.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioTargetPct rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Target Pct' ;
    rdfs:comment 'Target loss ratio percentage for this line of business, used for pricing, underwriting guidelines, and profitability monitoring.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date when the line of business received regulatory approval from the state Department of Insurance for writing new business.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceTreatyApplicable rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Applicable' ;
    rdfs:comment 'Indicates whether this line of business is covered under one or more reinsurance treaties, requiring cession and bordereaux reporting.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresStateFiling rdf:type rdf:Property ;
    rdfs:label 'Requires State Filing' ;
    rdfs:comment 'Indicates whether rates, forms, and policy language for this line of business require prior approval or filing with state regulators.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schedulePLineNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule P Line Number' ;
    rdfs:comment 'NAIC Schedule P line number for statutory loss reserve reporting, used in annual statement filings and actuarial reserve analysis.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsPackagePolicy rdf:type rdf:Property ;
    rdfs:label 'Supports Package Policy' ;
    rdfs:comment 'Indicates whether this line of business can be combined with other lines into a package policy such as Commercial Package Policy or Business Owners Policy.' ;
    rdfs:domain ind:LineOfBusiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dayCount rdf:type rdf:Property ;
    rdfs:label 'Day Count' ;
    rdfs:comment 'Number of days in the period, used for premium earning and reserve calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYearStartMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year Start Month' ;
    rdfs:comment 'Calendar month (1-12) when the fiscal year begins for this organization.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gaapPeriodKey rdf:type rdf:Property ;
    rdfs:label 'Gaap Period Key' ;
    rdfs:comment 'Period identifier for GAAP financial reporting and consolidation.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ifrs17PeriodKey rdf:type rdf:Property ;
    rdfs:label 'Ifrs17 Period Key' ;
    rdfs:comment 'Period identifier for IFRS 17 insurance contracts standard reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isClosed rdf:type rdf:Property ;
    rdfs:label 'Is Closed' ;
    rdfs:comment 'Indicates whether the period is closed for financial transactions and reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCurrentPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Current Period' ;
    rdfs:comment 'Indicates whether this period includes the current system date.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLeapYear rdf:type rdf:Property ;
    rdfs:label 'Is Leap Year' ;
    rdfs:comment 'Indicates whether the calendar year is a leap year (366 days).' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:month rdf:type rdf:Property ;
    rdfs:label 'Month' ;
    rdfs:comment 'Calendar month number (1-12) within the calendar year.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:naicReportingQuarter rdf:type rdf:Property ;
    rdfs:label 'Naic Reporting Quarter' ;
    rdfs:comment 'Quarter number (1-4) for NAIC quarterly statement filing.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:naicReportingYear rdf:type rdf:Property ;
    rdfs:label 'Naic Reporting Year' ;
    rdfs:comment 'Four-digit year for NAIC Annual Statement and Schedule P/F reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodKey rdf:type rdf:Property ;
    rdfs:label 'Period Key' ;
    rdfs:comment 'Business identifier for the period in standard format (e.g., 2024-Q1, 2024-01, AY2024, PY2024-01-01).' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quarter rdf:type rdf:Property ;
    rdfs:label 'Quarter' ;
    rdfs:comment 'Calendar quarter number (1-4) within the calendar year.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingPeriodKey rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Key' ;
    rdfs:comment 'Standardized key for regulatory and statutory reporting (e.g., 2024Q1, 202401).' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapPeriodKey rdf:type rdf:Property ;
    rdfs:label 'Sap Period Key' ;
    rdfs:comment 'Period identifier for Statutory Accounting Principles reporting and compliance.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:week rdf:type rdf:Property ;
    rdfs:label 'Week' ;
    rdfs:comment 'ISO week number (1-53) within the calendar year.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:masterHouseholdId rdf:type rdf:Property ;
    rdfs:label 'Master Household Id' ;
    rdfs:comment 'Reference to the master household record if this household has been merged or is a duplicate.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Household .

ind:primaryAddressId rdf:type rdf:Property ;
    rdfs:label 'Primary Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Household needs FK to address for primary address. The household table has denormalized address fields (primary_address_line_1, primary_address_line_2, primary_city, primary_state_province' ;
    rdfs:domain ind:Household ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:primaryContactPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Household needs FK to party for primary contact. The household table has primary_phone_number and primary_email_address, but these are household-level summary fields that may differ from' ;
    rdfs:domain ind:Household ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:adultCount rdf:type rdf:Property ;
    rdfs:label 'Adult Count' ;
    rdfs:comment 'Number of adults aged 18 or older in the household, used for underwriting and rating purposes.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deduplicationKey rdf:type rdf:Property ;
    rdfs:label 'Deduplication Key' ;
    rdfs:comment 'Composite key used for household matching and deduplication across systems and data sources.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentCount rdf:type rdf:Property ;
    rdfs:label 'Dependent Count' ;
    rdfs:comment 'Number of dependents under age 18 in the household, used for underwriting and rating purposes.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:establishedDate rdf:type rdf:Property ;
    rdfs:label 'Established Date' ;
    rdfs:comment 'Date when the household was first established as a customer or prospect in the system.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstPolicyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'First Policy Effective Date' ;
    rdfs:comment 'Date when the first policy for this household became effective, used for tenure and loyalty analysis.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:householdNumber rdf:type rdf:Property ;
    rdfs:label 'Household Number' ;
    rdfs:comment 'Business-facing unique household identifier used in customer communications and policy documents.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdStatus rdf:type rdf:Property ;
    rdfs:label 'Household Status' ;
    rdfs:comment 'Current lifecycle status of the household record in the system.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdType rdf:type rdf:Property ;
    rdfs:label 'Household Type' ;
    rdfs:comment 'Classification of the household structure for underwriting and risk segmentation purposes.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Date' ;
    rdfs:comment 'Date when the most recent KYC verification was completed for the household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:kycVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Status' ;
    rdfs:comment 'Status of identity verification and anti-money laundering checks for the household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In Flag' ;
    rdfs:comment 'Indicates whether the household has consented to receive marketing communications.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberCount rdf:type rdf:Property ;
    rdfs:label 'Member Count' ;
    rdfs:comment 'Total number of individuals associated with this household for underwriting and risk assessment.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:householdName rdf:type rdf:Property ;
    rdfs:label 'Household Name' ;
    rdfs:comment 'Primary display name for the household, typically derived from the primary policyholder or head of household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paperlessDeliveryFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Delivery Flag' ;
    rdfs:comment 'Indicates whether the household has elected to receive policy documents and communications electronically.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryEmailAddress rdf:type rdf:Property ;
    rdfs:label 'Primary Email Address' ;
    rdfs:comment 'Primary email address for household communications and policy correspondence.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Primary Language Code' ;
    rdfs:comment 'Two-letter ISO language code representing the preferred communication language for the household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Primary Phone Number' ;
    rdfs:comment 'Primary contact telephone number for the household in E.164 format.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionId rdf:type rdf:Property ;
    rdfs:label 'Condition Id' ;
    rdfs:comment 'BIGINT' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conditionPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Condition Policy Transaction Id' ;
    rdfs:comment 'Policy transaction (endorsement, new business, renewal) that introduced or last modified this condition.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:waivedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Waived By Party Id' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:breachConsequence rdf:type rdf:Property ;
    rdfs:label 'Breach Consequence' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCategory rdf:type rdf:Property ;
    rdfs:label 'Condition Category' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCode rdf:type rdf:Property ;
    rdfs:label 'Condition Code' ;
    rdfs:comment 'Carrier or ISO form code identifying the standard condition text, e.g. ISO form number or internal code.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDueDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Due Date' ;
    rdfs:comment 'Date by which the insured must demonstrate compliance with the condition.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Required' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Required Flag' ;
    rdfs:comment 'BOOLEAN' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Verified Date' ;
    rdfs:comment 'Date on which underwriting confirmed the insured satisfied this condition.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Verified Flag' ;
    rdfs:comment 'BOOLEAN' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionStatus rdf:type rdf:Property ;
    rdfs:label 'Condition Status' ;
    rdfs:comment 'STRING' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionType rdf:type rdf:Property ;
    rdfs:label 'Condition Type' ;
    rdfs:comment 'Classifies the condition: WARRANTY, CONDITION_PRECEDENT, CONDITION_SUBSEQUENT, SPECIAL_PROVISION, REPORTING_REQUIREMENT, OTHER.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionDescription rdf:type rdf:Property ;
    rdfs:label 'Condition Description' ;
    rdfs:comment 'Full text or summary of the contractual condition as it appears on the policy form.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSatisfied rdf:type rdf:Property ;
    rdfs:label 'Is Satisfied' ;
    rdfs:comment 'Tracks whether the insured has fulfilled the condition. NULL = not yet evaluated; TRUE = satisfied; FALSE = breached.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoConditionCode rdf:type rdf:Property ;
    rdfs:label 'Iso Condition Code' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonComplianceAction rdf:type rdf:Property ;
    rdfs:label 'Non Compliance Action' ;
    rdfs:comment 'Action taken if condition is not met: CANCEL, ENDORSE, SURCHARGE, NOTIFY, NONE.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionDate rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Date' ;
    rdfs:comment 'Date on which the condition was confirmed satisfied or breached. Null until evaluated.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceFormNumber rdf:type rdf:Property ;
    rdfs:label 'Source Form Number' ;
    rdfs:comment 'STRING' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemConditionRef rdf:type rdf:Property ;
    rdfs:label 'Source System Condition Ref' ;
    rdfs:comment 'STRING' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:text rdf:type rdf:Property ;
    rdfs:label 'Text' ;
    rdfs:comment 'Full policy language or manuscript wording of the condition as it appears in the contract.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
