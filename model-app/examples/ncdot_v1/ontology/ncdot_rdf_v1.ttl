ind:liabilityCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Liability Coverage Amount' ;
    rdfs:comment 'Dollar amount of liability insurance coverage for the train service.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalFundingSource rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Source' ;
    rdfs:comment 'Federal funding program or grant supporting this train service (e.g., FTA Section 5311, RAISE, INFRA).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFundingSource rdf:type rdf:Property ;
    rdfs:label 'State Funding Source' ;
    rdfs:comment 'State funding program or appropriation supporting this train service.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingCostPerMile rdf:type rdf:Property ;
    rdfs:label 'Operating Cost Per Mile' ;
    rdfs:comment 'Average operating cost in dollars per mile for this train service.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fareRevenuePerTrip rdf:type rdf:Property ;
    rdfs:label 'Fare Revenue Per Trip' ;
    rdfs:comment 'Average fare revenue collected per trip for passenger services.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subsidyRequired rdf:type rdf:Property ;
    rdfs:label 'Subsidy Required' ;
    rdfs:comment 'Indicates whether this train service requires public subsidy to operate due to operating costs exceeding fare revenue.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduleVersion rdf:type rdf:Property ;
    rdfs:label 'Schedule Version' ;
    rdfs:comment 'Version identifier for the train schedule to track schedule changes and updates over time.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishedDate rdf:type rdf:Property ;
    rdfs:label 'Published Date' ;
    rdfs:comment 'Date when this train schedule was officially published and made available to the public.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduleNotes rdf:type rdf:Property ;
    rdfs:label 'Schedule Notes' ;
    rdfs:comment 'Additional notes or special instructions related to the train schedule (e.g., holiday modifications, temporary changes).' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicTimetableUrl rdf:type rdf:Property ;
    rdfs:label 'Public Timetable Url' ;
    rdfs:comment 'Web URL where the public can access the detailed timetable for this train service.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realTimeTrackingAvailable rdf:type rdf:Property ;
    rdfs:label 'Real Time Tracking Available' ;
    rdfs:comment 'Indicates whether real-time GPS tracking and status updates are available for this train service.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobileTicketingEnabled rdf:type rdf:Property ;
    rdfs:label 'Mobile Ticketing Enabled' ;
    rdfs:comment 'Indicates whether passengers can purchase and display tickets using mobile devices for this train service.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intermodalConnections rdf:type rdf:Property ;
    rdfs:label 'Intermodal Connections' ;
    rdfs:comment 'Description of available connections to other transportation modes (bus, ferry, air) at origin and destination stations.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentName rdf:type rdf:Property ;
    rdfs:label 'Segment Name' ;
    rdfs:comment 'Common name or designation for the track segment used for operational reference and communication.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentCode rdf:type rdf:Property ;
    rdfs:label 'Segment Code' ;
    rdfs:comment 'Standardized alphanumeric code assigned to the track segment for identification and reporting purposes.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railroadOwnerName rdf:type rdf:Property ;
    rdfs:label 'Railroad Owner Name' ;
    rdfs:comment 'Name of the railroad company or entity that owns the track segment.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railroadOperatorName rdf:type rdf:Property ;
    rdfs:label 'Railroad Operator Name' ;
    rdfs:comment 'Name of the railroad company or entity that operates train services on the track segment.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackType rdf:type rdf:Property ;
    rdfs:label 'Track Type' ;
    rdfs:comment 'Functional classification of the track segment based on its operational purpose and usage pattern.' ;
    rdfs:domain ind:Rail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startMilepost rdf:type rdf:Property ;
    rdfs:label 'Start Milepost' ;
    rdfs:comment 'Beginning milepost marker for the track segment, measured from a designated reference point on the rail line.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Segment Length Miles' ;
    rdfs:comment 'Total length of the track segment measured in miles, calculated as the difference between end and start mileposts.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineName rdf:type rdf:Property ;
    rdfs:label 'Line Name' ;
    rdfs:comment 'Name of the railroad line or route that contains the track segment.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackNumber rdf:type rdf:Property ;
    rdfs:label 'Track Number' ;
    rdfs:comment 'Numeric or alphanumeric designation for the specific track within a multi-track corridor (e.g., Track 1, Track 2, Main 1).' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackGaugeInches rdf:type rdf:Property ;
    rdfs:label 'Track Gauge Inches' ;
    rdfs:comment 'Distance between the inner faces of the two rails, measured in inches. Standard gauge in North America is 56.5 inches (4 feet 8.5 inches).' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:railWeightLbsPerYard rdf:type rdf:Property ;
    rdfs:label 'Rail Weight Lbs Per Yard' ;
    rdfs:comment 'Weight of the rail per yard of length, measured in pounds. Common weights include 115, 132, 136, and 141 lbs/yd.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:railType rdf:type rdf:Property ;
    rdfs:label 'Rail Type' ;
    rdfs:comment 'Specification or profile type of the rail (e.g., RE, AREA, BS, UIC standards).' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railManufacturer rdf:type rdf:Property ;
    rdfs:label 'Rail Manufacturer' ;
    rdfs:comment 'Name of the company that manufactured the rail installed on the track segment.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railInstallationDate rdf:type rdf:Property ;
    rdfs:label 'Rail Installation Date' ;
    rdfs:comment 'Date when the current rail was installed on the track segment.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tieType rdf:type rdf:Property ;
    rdfs:label 'Tie Type' ;
    rdfs:comment 'Material type of the railroad ties (crossties) supporting the rails on the track segment.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tieSpacingInches rdf:type rdf:Property ;
    rdfs:label 'Tie Spacing Inches' ;
    rdfs:comment 'Average distance between railroad ties, measured center-to-center in inches.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ballastType rdf:type rdf:Property ;
    rdfs:label 'Ballast Type' ;
    rdfs:comment 'Type of material used for track ballast that provides drainage and distributes load from ties to subgrade.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ballastDepthInches rdf:type rdf:Property ;
    rdfs:label 'Ballast Depth Inches' ;
    rdfs:comment 'Depth of ballast material beneath the ties, measured in inches.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumSpeedFreightMph rdf:type rdf:Property ;
    rdfs:label 'Maximum Speed Freight Mph' ;
    rdfs:comment 'Maximum authorized speed for freight trains on the track segment, measured in miles per hour.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumSpeedPassengerMph rdf:type rdf:Property ;
    rdfs:label 'Maximum Speed Passenger Mph' ;
    rdfs:comment 'Maximum authorized speed for passenger trains on the track segment, measured in miles per hour.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumAxleLoadTons rdf:type rdf:Property ;
    rdfs:label 'Maximum Axle Load Tons' ;
    rdfs:comment 'Maximum weight per axle that the track segment is designed to support, measured in tons.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curvatureDegree rdf:type rdf:Property ;
    rdfs:label 'Curvature Degree' ;
    rdfs:comment 'Degree of curvature of the track segment, measured as the central angle subtended by a 100-foot chord.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:superelevationInches rdf:type rdf:Property ;
    rdfs:label 'Superelevation Inches' ;
    rdfs:comment 'Amount of banking or cant applied to curved track, measured as the elevation difference between outer and inner rails in inches.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gradePercent rdf:type rdf:Property ;
    rdfs:label 'Grade Percent' ;
    rdfs:comment 'Average gradient or slope of the track segment, expressed as a percentage (positive for uphill, negative for downhill).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electrificationStatus rdf:type rdf:Property ;
    rdfs:label 'Electrification Status' ;
    rdfs:comment 'Indicates whether the track segment has overhead catenary or third rail electrification for electric train operations.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electrificationVoltage rdf:type rdf:Property ;
    rdfs:label 'Electrification Voltage' ;
    rdfs:comment 'Voltage of the electrical system if the track is electrified, measured in volts.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tunnelCount rdf:type rdf:Property ;
    rdfs:label 'Tunnel Count' ;
    rdfs:comment 'Number of railroad tunnels located within the track segment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualTrafficDensityMgt rdf:type rdf:Property ;
    rdfs:label 'Annual Traffic Density Mgt' ;
    rdfs:comment 'Total annual tonnage of freight and passenger trains passing over the track segment, measured in million gross tons.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dailyTrainCount rdf:type rdf:Property ;
    rdfs:label 'Daily Train Count' ;
    rdfs:comment 'Average number of trains operating on the track segment per day.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hazmatRoute rdf:type rdf:Property ;
    rdfs:label 'Hazmat Route' ;
    rdfs:comment 'Indicates whether the track segment is designated as a route for transporting hazardous materials.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keyRoute rdf:type rdf:Property ;
    rdfs:label 'Key Route' ;
    rdfs:comment 'Indicates whether the track segment is designated as a key route for strategic military or economic transportation purposes.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geometryWkt rdf:type rdf:Property ;
    rdfs:label 'Geometry Wkt' ;
    rdfs:comment 'Spatial geometry of the track segment centerline represented in Well-Known Text format for GIS applications.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startLatitude rdf:type rdf:Property ;
    rdfs:label 'Start Latitude' ;
    rdfs:comment 'Latitude coordinate of the track segment starting point in decimal degrees.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startLongitude rdf:type rdf:Property ;
    rdfs:label 'Start Longitude' ;
    rdfs:comment 'Longitude coordinate of the track segment starting point in decimal degrees.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endLatitude rdf:type rdf:Property ;
    rdfs:label 'End Latitude' ;
    rdfs:comment 'Latitude coordinate of the track segment ending point in decimal degrees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endLongitude rdf:type rdf:Property ;
    rdfs:label 'End Longitude' ;
    rdfs:comment 'Longitude coordinate of the track segment ending point in decimal degrees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:municipalityName rdf:type rdf:Property ;
    rdfs:label 'Municipality Name' ;
    rdfs:comment 'Name of the city or town in which the track segment is located, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightOfWayWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Width Feet' ;
    rdfs:comment 'Width of the railroad right-of-way corridor measured in feet.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceHeightFeet rdf:type rdf:Property ;
    rdfs:label 'Clearance Height Feet' ;
    rdfs:comment 'Minimum vertical clearance above the rail for overhead structures, measured in feet.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearanceWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Clearance Width Feet' ;
    rdfs:comment 'Minimum horizontal clearance from track centerline to adjacent structures, measured in feet.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drainageAdequacy rdf:type rdf:Property ;
    rdfs:label 'Drainage Adequacy' ;
    rdfs:comment 'Assessment of the adequacy of drainage infrastructure along the track segment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vegetationControlStatus rdf:type rdf:Property ;
    rdfs:label 'Vegetation Control Status' ;
    rdfs:comment 'Current status of vegetation management along the track right-of-way.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalSensitivity rdf:type rdf:Property ;
    rdfs:label 'Environmental Sensitivity' ;
    rdfs:comment 'Level of environmental sensitivity of the area surrounding the track segment, considering wetlands, endangered species habitat, and other environmental factors.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRehabilitationYear rdf:type rdf:Property ;
    rdfs:label 'Last Rehabilitation Year' ;
    rdfs:comment 'Year when the track segment last underwent major rehabilitation or reconstruction.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedRemainingLifeYears rdf:type rdf:Property ;
    rdfs:label 'Estimated Remaining Life Years' ;
    rdfs:comment 'Estimated number of years remaining before the track segment will require major rehabilitation or replacement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defectCount rdf:type rdf:Property ;
    rdfs:label 'Defect Count' ;
    rdfs:comment 'Number of track defects identified during the most recent inspection that require monitoring or remediation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criticalDefectCount rdf:type rdf:Property ;
    rdfs:label 'Critical Defect Count' ;
    rdfs:comment 'Number of critical track defects requiring immediate remediation or speed restrictions.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:speedRestrictionActive rdf:type rdf:Property ;
    rdfs:label 'Speed Restriction Active' ;
    rdfs:comment 'Indicates whether temporary speed restrictions are currently in effect on the track segment due to track conditions or maintenance activities.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictedSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Restricted Speed Mph' ;
    rdfs:comment 'Temporary reduced speed limit in effect on the track segment, measured in miles per hour.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noiseSensitiveArea rdf:type rdf:Property ;
    rdfs:label 'Noise Sensitive Area' ;
    rdfs:comment 'Indicates whether the track segment passes through an area designated as noise-sensitive, requiring special operational considerations.' ;
    rdfs:domain ind:TrackSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quietZone rdf:type rdf:Property ;
    rdfs:label 'Quiet Zone' ;
    rdfs:comment 'Indicates whether the track segment is within an FRA-approved quiet zone where routine train horn sounding is prohibited.' ;
    rdfs:domain ind:Rail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signalTypeId rdf:type rdf:Property ;
    rdfs:label 'Signal Type Id' ;
    rdfs:comment 'Unique identifier for the signal type record. Primary key for the signal type reference table.' ;
    rdfs:domain ind:Rail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SignalType .

ind:authorityType rdf:type rdf:Property ;
    rdfs:label 'Authority Type' ;
    rdfs:comment 'Type of movement authority conveyed by the signal (e.g., absolute authority requiring stop at red, permissive authority allowing restricted speed past red, conditional authority based on specific conditions).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableTrackClass rdf:type rdf:Property ;
    rdfs:label 'Applicable Track Class' ;
    rdfs:comment 'Track classes for which this signal type is applicable or required, based on FRA track safety standards (e.g., Class 1-9, Excepted Track). May be a comma-separated list or range.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumTrackClass rdf:type rdf:Property ;
    rdfs:label 'Minimum Track Class' ;
    rdfs:comment 'Minimum FRA track class rating required for installation and operation of this signal type (0-9, where higher numbers indicate higher speed and safety requirements).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aspectDisplayType rdf:type rdf:Property ;
    rdfs:label 'Aspect Display Type' ;
    rdfs:comment 'Physical display mechanism used to convey signal aspects (e.g., color light, position light, searchlight, semaphore, color position light, cab display).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfAspects rdf:type rdf:Property ;
    rdfs:label 'Number Of Aspects' ;
    rdfs:comment 'Total number of distinct aspects (indications) that this signal type can display (e.g., 2-aspect, 3-aspect, 4-aspect systems).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blockSystemType rdf:type rdf:Property ;
    rdfs:label 'Block System Type' ;
    rdfs:comment 'Type of block system in which this signal type operates. ABS (Automatic Block Signal), APB (Automatic Permissive Block), CTC (Centralized Traffic Control), Manual Block, Track Warrant Control, Dark Territory, PTC (Positive Train Control).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interlockingCapable rdf:type rdf:Property ;
    rdfs:label 'Interlocking Capable' ;
    rdfs:comment 'Indicates whether this signal type can be used in interlocking applications where switches, signals, and other appliances are interconnected to prevent conflicting movements.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gradeCrossingProtection rdf:type rdf:Property ;
    rdfs:label 'Grade Crossing Protection' ;
    rdfs:comment 'Indicates whether this signal type is used for highway-rail grade crossing protection and warning systems.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ptcCompatible rdf:type rdf:Property ;
    rdfs:label 'Ptc Compatible' ;
    rdfs:comment 'Indicates whether this signal type is compatible with Positive Train Control (PTC) systems as mandated by the Rail Safety Improvement Act of 2008.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Fra Compliance Required' ;
    rdfs:comment 'Indicates whether this signal type requires compliance with FRA signal system regulations and inspection standards.' ;
    rdfs:domain ind:Rail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:testingIntervalDays rdf:type rdf:Property ;
    rdfs:label 'Testing Interval Days' ;
    rdfs:comment 'Required functional testing interval in days for signals of this type to ensure proper operation and safety compliance.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:powerSourceType rdf:type rdf:Property ;
    rdfs:label 'Power Source Type' ;
    rdfs:comment 'Primary power source type used for signals of this type (e.g., AC commercial power, DC battery, solar, hybrid systems, wayside power distribution).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backupPowerRequired rdf:type rdf:Property ;
    rdfs:label 'Backup Power Required' ;
    rdfs:comment 'Indicates whether backup power systems are required for this signal type to maintain operation during primary power failures.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationProtocol rdf:type rdf:Property ;
    rdfs:label 'Communication Protocol' ;
    rdfs:comment 'Communication protocol or standard used for data transmission and control of this signal type (e.g., hardwired relay logic, serial communication, Ethernet/IP, wireless protocols).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failSafeMode rdf:type rdf:Property ;
    rdfs:label 'Fail Safe Mode' ;
    rdfs:comment 'Default fail-safe state or mode that the signal assumes in case of system failure or malfunction (e.g., most restrictive aspect, stop indication, dark/no display, flashing red).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railroadType rdf:type rdf:Property ;
    rdfs:label 'Railroad Type' ;
    rdfs:comment 'Type of railroad operations for which this signal type is typically used (e.g., freight, passenger, commuter, light rail, heavy rail, mixed operations).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingRulesReference rdf:type rdf:Property ;
    rdfs:label 'Operating Rules Reference' ;
    rdfs:comment 'Reference to the specific operating rules or rulebook sections that govern the use and interpretation of this signal type (e.g., GCOR, NORAC, CROR rule numbers).' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationStandard rdf:type rdf:Property ;
    rdfs:label 'Installation Standard' ;
    rdfs:comment 'Technical standard or specification governing the installation of this signal type, including placement, visibility, and clearance requirements.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visibilityRequirementFeet rdf:type rdf:Property ;
    rdfs:label 'Visibility Requirement Feet' ;
    rdfs:comment 'Minimum required visibility distance in feet for signals of this type, ensuring adequate sighting distance for train operators.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approachLightingRequired rdf:type rdf:Property ;
    rdfs:label 'Approach Lighting Required' ;
    rdfs:comment 'Indicates whether approach lighting or advance warning is required for this signal type to enhance visibility and operator awareness.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remoteMonitoringCapable rdf:type rdf:Property ;
    rdfs:label 'Remote Monitoring Capable' ;
    rdfs:comment 'Indicates whether this signal type supports remote monitoring capabilities for real-time status tracking and fault detection.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventLoggingRequired rdf:type rdf:Property ;
    rdfs:label 'Event Logging Required' ;
    rdfs:comment 'Indicates whether event logging and data recording are required for this signal type to support safety investigations and compliance audits.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manufacturerSpecification rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Specification' ;
    rdfs:comment 'Reference to manufacturer specifications or approved equipment lists for signals of this type, ensuring compliance with technical standards.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifecycleExpectancyYears rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Expectancy Years' ;
    rdfs:comment 'Expected operational lifecycle or service life in years for signals of this type before major overhaul or replacement is typically required.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualMaintenanceCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Annual Maintenance Cost Estimate' ;
    rdfs:comment 'Estimated annual maintenance cost in US dollars for signals of this type, including routine inspections, testing, and preventive maintenance.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalRating rdf:type rdf:Property ;
    rdfs:label 'Environmental Rating' ;
    rdfs:comment 'Environmental protection rating or classification for signals of this type (e.g., NEMA ratings, IP ratings for dust and water resistance).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureRangeMinF rdf:type rdf:Property ;
    rdfs:label 'Temperature Range Min F' ;
    rdfs:comment 'Minimum operating temperature in degrees Fahrenheit for reliable operation of this signal type.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:temperatureRangeMaxF rdf:type rdf:Property ;
    rdfs:label 'Temperature Range Max F' ;
    rdfs:comment 'Maximum operating temperature in degrees Fahrenheit for reliable operation of this signal type.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weatherResistant rdf:type rdf:Property ;
    rdfs:label 'Weather Resistant' ;
    rdfs:comment 'Indicates whether this signal type is designed and rated for outdoor installation with resistance to weather conditions including rain, snow, ice, and extreme temperatures.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:obsoleteIndicator rdf:type rdf:Property ;
    rdfs:label 'Obsolete Indicator' ;
    rdfs:comment 'Indicates whether this signal type is considered obsolete or deprecated, typically due to technological advancement or regulatory changes.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replacementSignalTypeCode rdf:type rdf:Property ;
    rdfs:label 'Replacement Signal Type Code' ;
    rdfs:comment 'Code of the recommended replacement signal type for obsolete or deprecated signal types, supporting modernization planning.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date when this signal type received regulatory approval from FRA or other governing bodies.' ;
    rdfs:domain ind:SignalType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trackClassificationId rdf:type rdf:Property ;
    rdfs:label 'Track Classification Id' ;
    rdfs:comment 'Unique identifier for the track classification record. Primary key for the track classification reference data.' ;
    rdfs:domain ind:Rail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrackClassification .

ind:maxFreightSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Max Freight Speed Mph' ;
    rdfs:comment 'Maximum allowable speed in miles per hour for freight trains operating on this track class as defined by FRA regulations.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxPassengerSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Max Passenger Speed Mph' ;
    rdfs:comment 'Maximum allowable speed in miles per hour for passenger trains operating on this track class as defined by FRA regulations.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minRailWeightLbsPerYard rdf:type rdf:Property ;
    rdfs:label 'Min Rail Weight Lbs Per Yard' ;
    rdfs:comment 'Minimum rail weight in pounds per yard required for this track classification to ensure structural integrity and safety.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxCrosslevelDeviationInches rdf:type rdf:Property ;
    rdfs:label 'Max Crosslevel Deviation Inches' ;
    rdfs:comment 'Maximum allowable crosslevel (transverse level) deviation in inches between the two rails, measured over a specified distance. Critical for preventing derailments.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxProfileDeviationInches rdf:type rdf:Property ;
    rdfs:label 'Max Profile Deviation Inches' ;
    rdfs:comment 'Maximum allowable vertical profile (surface) deviation in inches along the longitudinal axis of the track.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxAlignmentDeviationInches rdf:type rdf:Property ;
    rdfs:label 'Max Alignment Deviation Inches' ;
    rdfs:comment 'Maximum allowable horizontal alignment (gauge) deviation in inches from the centerline of the track.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxGaugeDeviationInches rdf:type rdf:Property ;
    rdfs:label 'Max Gauge Deviation Inches' ;
    rdfs:comment 'Maximum allowable deviation in inches from the standard track gauge (distance between the inner faces of the rail heads). Standard gauge is 56.5 inches.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardGaugeInches rdf:type rdf:Property ;
    rdfs:label 'Standard Gauge Inches' ;
    rdfs:comment 'Standard track gauge measurement in inches for this classification. In North America, standard gauge is 56.5 inches (4 feet 8.5 inches).' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minTieConditionIndex rdf:type rdf:Property ;
    rdfs:label 'Min Tie Condition Index' ;
    rdfs:comment 'Minimum acceptable tie condition index score for crossties supporting this track class. Higher scores indicate better tie condition.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minBallastDepthInches rdf:type rdf:Property ;
    rdfs:label 'Min Ballast Depth Inches' ;
    rdfs:comment 'Minimum required ballast depth in inches beneath the crossties to provide adequate track support and drainage.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geometryInspectionFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Geometry Inspection Frequency Days' ;
    rdfs:comment 'Required frequency in days for conducting automated track geometry inspections using specialized equipment.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:internalRailInspectionFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Internal Rail Inspection Frequency Days' ;
    rdfs:comment 'Required frequency in days for conducting internal rail defect inspections using ultrasonic or other non-destructive testing methods.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualTonnageMgt rdf:type rdf:Property ;
    rdfs:label 'Annual Tonnage Mgt' ;
    rdfs:comment 'Typical annual tonnage in million gross tons (MGT) carried on tracks of this classification. Used for maintenance planning and lifecycle analysis.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curvatureRestrictionDegrees rdf:type rdf:Property ;
    rdfs:label 'Curvature Restriction Degrees' ;
    rdfs:comment 'Maximum allowable track curvature in degrees for this track class. Sharper curves may require speed restrictions.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:superelevationMaxInches rdf:type rdf:Property ;
    rdfs:label 'Superelevation Max Inches' ;
    rdfs:comment 'Maximum allowable superelevation (banking) in inches on curved track sections for this classification to balance centrifugal forces.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fraRegulationReference rdf:type rdf:Property ;
    rdfs:label 'Fra Regulation Reference' ;
    rdfs:comment 'Specific FRA regulation citation (e.g., 49 CFR 213.9) that defines this track classification and its requirements.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aashtoStandardReference rdf:type rdf:Property ;
    rdfs:label 'Aashto Standard Reference' ;
    rdfs:comment 'Applicable AASHTO standard reference for rail-highway grade crossing design and safety requirements related to this track class.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aremaStandardReference rdf:type rdf:Property ;
    rdfs:label 'Arema Standard Reference' ;
    rdfs:comment 'Applicable AREMA Manual for Railway Engineering chapter or section reference for track design and maintenance standards.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenancePriorityLevel rdf:type rdf:Property ;
    rdfs:label 'Maintenance Priority Level' ;
    rdfs:comment 'Relative maintenance priority level (1=highest, 5=lowest) assigned to tracks of this classification for resource allocation and scheduling.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defectRemediationTimeframeHours rdf:type rdf:Property ;
    rdfs:label 'Defect Remediation Timeframe Hours' ;
    rdfs:comment 'Maximum allowable timeframe in hours for remediating identified track defects for this classification before speed restrictions or service suspension is required.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:speedRestrictionThresholdMph rdf:type rdf:Property ;
    rdfs:label 'Speed Restriction Threshold Mph' ;
    rdfs:comment 'Speed in miles per hour to which operations must be restricted when track geometry or condition falls below acceptable standards but does not require immediate service suspension.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresContinuousWeldedRail rdf:type rdf:Property ;
    rdfs:label 'Requires Continuous Welded Rail' ;
    rdfs:comment 'Indicates whether this track classification requires continuous welded rail (CWR) construction rather than jointed rail for improved ride quality and reduced maintenance.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresConcreteTies rdf:type rdf:Property ;
    rdfs:label 'Requires Concrete Ties' ;
    rdfs:comment 'Indicates whether this track classification requires concrete crossties rather than wood ties for enhanced durability and track stability.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signalSystemRequirement rdf:type rdf:Property ;
    rdfs:label 'Signal System Requirement' ;
    rdfs:comment 'Type of signal system required for safe operations on this track classification (e.g., none, manual block, automatic block, cab signal, positive train control).' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positiveTrainControlRequired rdf:type rdf:Property ;
    rdfs:label 'Positive Train Control Required' ;
    rdfs:comment 'Indicates whether Positive Train Control (PTC) system is required on tracks of this classification per federal mandate.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gradeCrossingWarningRequirement rdf:type rdf:Property ;
    rdfs:label 'Grade Crossing Warning Requirement' ;
    rdfs:comment 'Minimum required warning device type at highway-rail grade crossings for this track classification (e.g., crossbucks, flashing lights, gates).' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passengerServiceAllowed rdf:type rdf:Property ;
    rdfs:label 'Passenger Service Allowed' ;
    rdfs:comment 'Indicates whether passenger rail service is permitted on tracks of this classification based on safety and infrastructure standards.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:freightServiceAllowed rdf:type rdf:Property ;
    rdfs:label 'Freight Service Allowed' ;
    rdfs:comment 'Indicates whether freight rail service is permitted on tracks of this classification.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxAxleLoadTons rdf:type rdf:Property ;
    rdfs:label 'Max Axle Load Tons' ;
    rdfs:comment 'Maximum allowable axle load in tons for rail cars operating on this track classification to prevent excessive wear and structural damage.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bridgeInspectionFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Bridge Inspection Frequency Months' ;
    rdfs:comment 'Required frequency in months for inspecting railroad bridges on tracks of this classification.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tunnelInspectionFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Tunnel Inspection Frequency Months' ;
    rdfs:comment 'Required frequency in months for inspecting railroad tunnels on tracks of this classification.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vegetationControlRequirement rdf:type rdf:Property ;
    rdfs:label 'Vegetation Control Requirement' ;
    rdfs:comment 'Level of vegetation control required along the right-of-way for this track classification to maintain visibility and prevent track degradation.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drainageSystemRequirement rdf:type rdf:Property ;
    rdfs:label 'Drainage System Requirement' ;
    rdfs:comment 'Level of drainage system infrastructure required for this track classification to prevent water damage and maintain track stability.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:winterMaintenancePriority rdf:type rdf:Property ;
    rdfs:label 'Winter Maintenance Priority' ;
    rdfs:comment 'Priority level for snow and ice removal and winter maintenance activities on tracks of this classification.' ;
    rdfs:domain ind:TrackClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossingNumber rdf:type rdf:Property ;
    rdfs:label 'Crossing Number' ;
    rdfs:comment 'The official FRA-assigned crossing inventory number, a unique 7-character identifier (6 digits + 1 letter) used nationally to identify railroad crossings.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossingName rdf:type rdf:Property ;
    rdfs:label 'Crossing Name' ;
    rdfs:comment 'Common or local name of the grade crossing, typically referencing the intersecting roadway or nearby landmark.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railroadDivision rdf:type rdf:Property ;
    rdfs:label 'Railroad Division' ;
    rdfs:comment 'The operational division or subdivision of the railroad company responsible for this crossing segment.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railroadSubdivision rdf:type rdf:Property ;
    rdfs:label 'Railroad Subdivision' ;
    rdfs:comment 'The specific railroad subdivision or line segment where the crossing is located.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfTracks rdf:type rdf:Property ;
    rdfs:label 'Number Of Tracks' ;
    rdfs:comment 'Total count of railroad tracks crossing the roadway at this location.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roadName rdf:type rdf:Property ;
    rdfs:label 'Road Name' ;
    rdfs:comment 'Official name or designation of the public or private road that crosses the railroad tracks.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadNumber rdf:type rdf:Property ;
    rdfs:label 'Road Number' ;
    rdfs:comment 'Official route number or designation for the roadway (e.g., US-1, NC-55, SR-401).' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadClassification rdf:type rdf:Property ;
    rdfs:label 'Road Classification' ;
    rdfs:comment 'Functional classification of the roadway: interstate, US highway, state highway, county road, city street, private road, or other.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadSurfaceType rdf:type rdf:Property ;
    rdfs:label 'Road Surface Type' ;
    rdfs:comment 'Type of road surface material at the crossing: paved (asphalt/concrete), gravel, dirt, or other.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadLanes rdf:type rdf:Property ;
    rdfs:label 'Road Lanes' ;
    rdfs:comment 'Total number of traffic lanes on the roadway at the crossing location.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aadtYear rdf:type rdf:Property ;
    rdfs:label 'Aadt Year' ;
    rdfs:comment 'The year for which the AADT value was calculated or last updated.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Vehicle Count' ;
    rdfs:comment 'Estimated number of vehicles crossing per day when actual AADT data is not available.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainCountPerDay rdf:type rdf:Property ;
    rdfs:label 'Train Count Per Day' ;
    rdfs:comment 'Average number of trains passing through the crossing per day.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainSpeedMaxMph rdf:type rdf:Property ;
    rdfs:label 'Train Speed Max Mph' ;
    rdfs:comment 'Maximum authorized speed for trains at this crossing location, measured in miles per hour.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protectionType rdf:type rdf:Property ;
    rdfs:label 'Protection Type' ;
    rdfs:comment 'Type of warning device or protection installed at the crossing: gates with lights, flashing lights only, crossbucks, stop sign, other, or none.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeWarningDevice rdf:type rdf:Property ;
    rdfs:label 'Active Warning Device' ;
    rdfs:comment 'Indicates whether the crossing has active warning devices (gates, flashing lights) that activate when trains approach.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gateConfiguration rdf:type rdf:Property ;
    rdfs:label 'Gate Configuration' ;
    rdfs:comment 'Configuration of crossing gates if present: full gates (blocking all lanes), half gates (blocking approaching lanes only), none, or other.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flashingLightUnits rdf:type rdf:Property ;
    rdfs:label 'Flashing Light Units' ;
    rdfs:comment 'Count of flashing light signal units installed at the crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bellPresent rdf:type rdf:Property ;
    rdfs:label 'Bell Present' ;
    rdfs:comment 'Indicates whether an audible bell warning device is installed at the crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crossbuckPresent rdf:type rdf:Property ;
    rdfs:label 'Crossbuck Present' ;
    rdfs:comment 'Indicates whether standard railroad crossbuck warning signs are installed at the crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stopSignPresent rdf:type rdf:Property ;
    rdfs:label 'Stop Sign Present' ;
    rdfs:comment 'Indicates whether a stop sign is installed at the crossing requiring vehicles to stop before proceeding.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pavementMarkingsPresent rdf:type rdf:Property ;
    rdfs:label 'Pavement Markings Present' ;
    rdfs:comment 'Indicates whether pavement markings (railroad crossing symbols, stop lines) are present on the roadway approach.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:advanceWarningSigns rdf:type rdf:Property ;
    rdfs:label 'Advance Warning Signs' ;
    rdfs:comment 'Indicates whether advance warning signs are installed on the roadway approach to alert drivers of the upcoming crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crossingAngleDegrees rdf:type rdf:Property ;
    rdfs:label 'Crossing Angle Degrees' ;
    rdfs:comment 'The angle in degrees at which the roadway intersects the railroad tracks (90 degrees is perpendicular).' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crossingSurfaceType rdf:type rdf:Property ;
    rdfs:label 'Crossing Surface Type' ;
    rdfs:comment 'Type of crossing surface material between and adjacent to the rails: timber, concrete panels, rubber, asphalt, or other.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossingSurfaceCondition rdf:type rdf:Property ;
    rdfs:label 'Crossing Surface Condition' ;
    rdfs:comment 'Current condition assessment of the crossing surface: good, fair, poor, or critical.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sightDistanceAdequate rdf:type rdf:Property ;
    rdfs:label 'Sight Distance Adequate' ;
    rdfs:comment 'Indicates whether the sight distance at the crossing meets minimum safety standards for drivers to see approaching trains.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sightDistanceFeet rdf:type rdf:Property ;
    rdfs:label 'Sight Distance Feet' ;
    rdfs:comment 'Measured sight distance in feet from the roadway approach to the railroad tracks, used to assess visibility of approaching trains.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quietZoneEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Quiet Zone Effective Date' ;
    rdfs:comment 'The date when the quiet zone designation became effective at this crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:crossingStatus rdf:type rdf:Property ;
    rdfs:label 'Crossing Status' ;
    rdfs:comment 'Current operational status of the crossing: active (in use), closed (no longer in use), abandoned (tracks removed), or proposed (planned).' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpgradeDate rdf:type rdf:Property ;
    rdfs:label 'Last Upgrade Date' ;
    rdfs:comment 'Date when the crossing warning systems or infrastructure were last upgraded or improved.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accidentCount5yr rdf:type rdf:Property ;
    rdfs:label 'Accident Count 5yr' ;
    rdfs:comment 'Total number of reported accidents or incidents at this crossing over the past five years.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fatalityCount5yr rdf:type rdf:Property ;
    rdfs:label 'Fatality Count 5yr' ;
    rdfs:comment 'Total number of fatalities resulting from accidents at this crossing over the past five years.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:injuryCount5yr rdf:type rdf:Property ;
    rdfs:label 'Injury Count 5yr' ;
    rdfs:comment 'Total number of injuries resulting from accidents at this crossing over the past five years.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hazardIndex rdf:type rdf:Property ;
    rdfs:label 'Hazard Index' ;
    rdfs:comment 'Calculated hazard index score used to prioritize crossing safety improvements, based on traffic volume, train frequency, and accident history.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorityRanking rdf:type rdf:Property ;
    rdfs:label 'Priority Ranking' ;
    rdfs:comment 'Relative priority ranking of this crossing for safety improvements compared to other crossings in the state inventory.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:improvementProjectPlanned rdf:type rdf:Property ;
    rdfs:label 'Improvement Project Planned' ;
    rdfs:comment 'Indicates whether a safety improvement project is planned or programmed for this crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:improvementProjectNumber rdf:type rdf:Property ;
    rdfs:label 'Improvement Project Number' ;
    rdfs:comment 'NCDOT project identification number for any planned or ongoing improvement project at this crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementType rdf:type rdf:Property ;
    rdfs:label 'Improvement Type' ;
    rdfs:comment 'Description of the type of safety improvement planned: upgrade warning devices, install gates, improve sight distance, close crossing, etc.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementEstimatedCost rdf:type rdf:Property ;
    rdfs:label 'Improvement Estimated Cost' ;
    rdfs:comment 'Estimated cost in US dollars for planned crossing safety improvements.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:section130Eligible rdf:type rdf:Property ;
    rdfs:label 'Section 130 Eligible' ;
    rdfs:comment 'Indicates whether the crossing is eligible for federal Section 130 Railway-Highway Crossings Program funding.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pedestrianCrossing rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Crossing' ;
    rdfs:comment 'Indicates whether the crossing includes designated pedestrian crossing facilities (sidewalks, pathways).' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bicycleCrossing rdf:type rdf:Property ;
    rdfs:label 'Bicycle Crossing' ;
    rdfs:comment 'Indicates whether the crossing includes designated bicycle crossing facilities or is part of a bicycle route.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyNotificationSign rdf:type rdf:Property ;
    rdfs:label 'Emergency Notification Sign' ;
    rdfs:comment 'Indicates whether an Emergency Notification System (ENS) sign with railroad contact information is posted at the crossing.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ensPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Ens Phone Number' ;
    rdfs:comment 'Emergency phone number posted on the ENS sign for reporting crossing malfunctions or emergencies to the railroad.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossingApproachGradePercent rdf:type rdf:Property ;
    rdfs:label 'Crossing Approach Grade Percent' ;
    rdfs:comment 'Steepness of the roadway approach to the crossing expressed as a percentage grade (rise over run).' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:illuminationPresent rdf:type rdf:Property ;
    rdfs:label 'Illumination Present' ;
    rdfs:comment 'Indicates whether street lighting or dedicated crossing illumination is present at the crossing location.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nearbyTrafficSignal rdf:type rdf:Property ;
    rdfs:label 'Nearby Traffic Signal' ;
    rdfs:comment 'Indicates whether a traffic signal is located near the crossing that may require interconnection or coordination with crossing warning devices.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preemptionInterconnect rdf:type rdf:Property ;
    rdfs:label 'Preemption Interconnect' ;
    rdfs:comment 'Indicates whether the crossing warning system is interconnected with nearby traffic signals for preemption coordination.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialVehicleRestriction rdf:type rdf:Property ;
    rdfs:label 'Commercial Vehicle Restriction' ;
    rdfs:comment 'Indicates whether commercial vehicles or hazardous materials carriers are required to stop at this crossing regardless of warning device activation.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schoolBusStopRequired rdf:type rdf:Property ;
    rdfs:label 'School Bus Stop Required' ;
    rdfs:comment 'Indicates whether school buses are required to stop at this crossing before proceeding.' ;
    rdfs:domain ind:GradeCrossing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:comments rdf:type rdf:Property ;
    rdfs:label 'Comments' ;
    rdfs:comment 'Free-text field for additional notes, observations, or special conditions related to the crossing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeId rdf:type rdf:Property ;
    rdfs:label 'Type Id' ;
    rdfs:comment 'Unique identifier for the asset type record. Primary key for the asset type reference table.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Ncdot .

ind:assetClass rdf:type rdf:Property ;
    rdfs:label 'Asset Class' ;
    rdfs:comment 'SAP PM asset class designation used for financial accounting, depreciation calculation, and lifecycle management integration.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold Amount' ;
    rdfs:comment 'Minimum dollar value required for an asset of this type to be capitalized rather than expensed, per GASB standards and NCDOT policy.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method' ;
    rdfs:comment 'Standard depreciation method applied to assets of this type for financial reporting (e.g., Straight Line, Declining Balance, Units of Production).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValuePercentage rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Percentage' ;
    rdfs:comment 'Expected residual value as a percentage of original cost at end of useful life for assets of this type.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maintenanceStrategy rdf:type rdf:Property ;
    rdfs:label 'Maintenance Strategy' ;
    rdfs:comment 'Standard maintenance approach for assets of this type (e.g., Preventive, Predictive, Reactive, Condition-Based, Time-Based, Risk-Based).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresFederalReporting rdf:type rdf:Property ;
    rdfs:label 'Requires Federal Reporting' ;
    rdfs:comment 'Indicates whether assets of this type must be reported to federal agencies such as FHWA, FTA, FAA, or FRA.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalReportingSystem rdf:type rdf:Property ;
    rdfs:label 'Federal Reporting System' ;
    rdfs:comment 'Federal reporting system where assets of this type must be reported (e.g., HPMS for highways, NBI for bridges, FTA NTD for transit, FAA 5010 for airports).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMobile rdf:type rdf:Property ;
    rdfs:label 'Is Mobile' ;
    rdfs:comment 'Indicates whether assets of this type are mobile (vehicles, equipment) or fixed (infrastructure, buildings).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresOperatorCertification rdf:type rdf:Property ;
    rdfs:label 'Requires Operator Certification' ;
    rdfs:comment 'Indicates whether operation of assets of this type requires specific operator certification or licensing (e.g., CDL for commercial vehicles, specialized equipment certifications).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisLayerName rdf:type rdf:Property ;
    rdfs:label 'Gis Layer Name' ;
    rdfs:comment 'Name of the GIS layer in ArcGIS Enterprise where assets of this type are spatially represented and managed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresGpsTracking rdf:type rdf:Property ;
    rdfs:label 'Requires Gps Tracking' ;
    rdfs:comment 'Indicates whether assets of this type require GPS tracking for location monitoring and fleet management (typically mobile assets).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceRequired rdf:type rdf:Property ;
    rdfs:label 'Insurance Required' ;
    rdfs:comment 'Indicates whether assets of this type must carry insurance coverage per NCDOT risk management policy.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceType rdf:type rdf:Property ;
    rdfs:label 'Insurance Type' ;
    rdfs:comment 'Type of insurance coverage required for assets of this type (e.g., Liability, Comprehensive, Collision, Property).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionRatingSystem rdf:type rdf:Property ;
    rdfs:label 'Condition Rating System' ;
    rdfs:comment 'Standard condition assessment system used for assets of this type (e.g., PCI for pavement, NBI for bridges, IRI for roughness, custom rating scales).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMeasurementRequired rdf:type rdf:Property ;
    rdfs:label 'Performance Measurement Required' ;
    rdfs:comment 'Indicates whether assets of this type are subject to performance measurement and reporting under federal or state performance management programs.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalityLevel rdf:type rdf:Property ;
    rdfs:label 'Criticality Level' ;
    rdfs:comment 'Default criticality classification for assets of this type based on impact to transportation network, public safety, and operational continuity.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementCycleYears rdf:type rdf:Property ;
    rdfs:label 'Replacement Cycle Years' ;
    rdfs:comment 'Standard replacement cycle in years for assets of this type based on lifecycle analysis and NCDOT capital planning.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:warrantyPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Warranty Period Months' ;
    rdfs:comment 'Typical manufacturer or contractor warranty period in months for new assets of this type.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresSafetyInspection rdf:type rdf:Property ;
    rdfs:label 'Requires Safety Inspection' ;
    rdfs:comment 'Indicates whether assets of this type require periodic safety inspections per OSHA, FMCSA, or NCDOT safety standards.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyInspectionFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Safety Inspection Frequency Days' ;
    rdfs:comment 'Required interval in days between safety inspections for assets of this type.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disposalMethod rdf:type rdf:Property ;
    rdfs:label 'Disposal Method' ;
    rdfs:comment 'Standard method for disposing of assets of this type at end of useful life (e.g., Auction, Trade-In, Scrap, Demolition, Transfer, Donation).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresEnvironmentalAssessment rdf:type rdf:Property ;
    rdfs:label 'Requires Environmental Assessment' ;
    rdfs:comment 'Indicates whether disposal or major modification of assets of this type requires environmental assessment per NEPA or state environmental regulations.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:barcodeRequired rdf:type rdf:Property ;
    rdfs:label 'Barcode Required' ;
    rdfs:comment 'Indicates whether assets of this type must be tagged with barcodes for inventory tracking in ATLAS or SAP PM systems.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rfidRequired rdf:type rdf:Property ;
    rdfs:label 'Rfid Required' ;
    rdfs:comment 'Indicates whether assets of this type must be tagged with RFID for automated tracking and inventory management.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:historicalPreservationApplicable rdf:type rdf:Property ;
    rdfs:label 'Historical Preservation Applicable' ;
    rdfs:comment 'Indicates whether assets of this type may be subject to historical preservation review under Section 106 of the National Historic Preservation Act.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mutcdComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Mutcd Compliance Required' ;
    rdfs:comment 'Indicates whether assets of this type must comply with MUTCD standards for traffic control devices.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aashtoStandardsApplicable rdf:type rdf:Property ;
    rdfs:label 'Aashto Standards Applicable' ;
    rdfs:comment 'Indicates whether assets of this type must be designed, constructed, or maintained according to AASHTO standards.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emissionsTier rdf:type rdf:Property ;
    rdfs:label 'Emissions Tier' ;
    rdfs:comment 'EPA emissions tier classification for mobile assets of this type, indicating compliance with federal emissions standards.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procurementMethod rdf:type rdf:Property ;
    rdfs:label 'Procurement Method' ;
    rdfs:comment 'Typical procurement method used for acquiring assets of this type (e.g., Competitive Bid, Sole Source, Cooperative Purchase, State Contract).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresDbeParticipation rdf:type rdf:Property ;
    rdfs:label 'Requires Dbe Participation' ;
    rdfs:comment 'Indicates whether procurement of assets of this type requires DBE participation goals per federal regulations.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stipEligible rdf:type rdf:Property ;
    rdfs:label 'Stip Eligible' ;
    rdfs:comment 'Indicates whether assets of this type are eligible for funding through the State Transportation Improvement Program.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalFundingEligible rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Eligible' ;
    rdfs:comment 'Indicates whether assets of this type are eligible for federal transportation funding (FHWA, FTA, FAA, FRA programs).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalFundingCategory rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Category' ;
    rdfs:comment 'Primary federal funding program category applicable to assets of this type (e.g., NHS, STP, HSIP, CMAQ, BUILD, INFRA, RAISE, FTA programs).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterDefault rdf:type rdf:Property ;
    rdfs:label 'Cost Center Default' ;
    rdfs:comment 'Default SAP cost center for financial tracking of assets of this type.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountDefault rdf:type rdf:Property ;
    rdfs:label 'Gl Account Default' ;
    rdfs:comment 'Default general ledger account code in SAP FI for capitalizing assets of this type.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyId rdf:type rdf:Property ;
    rdfs:label 'Warranty Id' ;
    rdfs:comment 'Unique identifier for the warranty record. Primary key for the warranty data product.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerName rdf:type rdf:Property ;
    rdfs:label 'Provider Name' ;
    rdfs:comment 'Name of the organization or entity providing the warranty coverage, such as manufacturer, dealer, or third-party warranty company.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerContactName rdf:type rdf:Property ;
    rdfs:label 'Provider Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the warranty provider organization for warranty administration and claims.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerPhone rdf:type rdf:Property ;
    rdfs:label 'Provider Phone' ;
    rdfs:comment 'Primary phone number for contacting the warranty provider for claims, inquiries, or service requests.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerEmail rdf:type rdf:Property ;
    rdfs:label 'Provider Email' ;
    rdfs:comment 'Primary email address for warranty provider correspondence, claims submission, and service coordination.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerAddress rdf:type rdf:Property ;
    rdfs:label 'Provider Address' ;
    rdfs:comment 'Physical mailing address of the warranty provider organization for formal correspondence and documentation.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerWebsite rdf:type rdf:Property ;
    rdfs:label 'Provider Website' ;
    rdfs:comment 'Website URL for the warranty provider where warranty information, claim forms, and service details can be accessed.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationMonths rdf:type rdf:Property ;
    rdfs:label 'Duration Months' ;
    rdfs:comment 'Total duration of warranty coverage expressed in months from start date to end date.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Description' ;
    rdfs:comment 'Detailed description of what is covered under the warranty, including parts, labor, services, and specific components or systems.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusions rdf:type rdf:Property ;
    rdfs:label 'Exclusions' ;
    rdfs:comment 'Description of items, conditions, or circumstances explicitly excluded from warranty coverage, such as wear items, misuse, or environmental damage.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termsAndConditions rdf:type rdf:Property ;
    rdfs:label 'Terms And Conditions' ;
    rdfs:comment 'Full text or summary of the legal terms and conditions governing the warranty agreement, including obligations and limitations.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Total cost paid for the warranty coverage, including purchase price or premium for extended warranty or service contract.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the warranty cost amount.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Amount that must be paid by NCDOT before warranty coverage applies to a claim or repair.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Limit Amount' ;
    rdfs:comment 'Maximum dollar amount that the warranty will pay for covered repairs or replacements during the warranty period.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimProcessDescription rdf:type rdf:Property ;
    rdfs:label 'Claim Process Description' ;
    rdfs:comment 'Step-by-step description of the process for filing a warranty claim, including required documentation, approval workflow, and timelines.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimSubmissionMethod rdf:type rdf:Property ;
    rdfs:label 'Claim Submission Method' ;
    rdfs:comment 'Method by which warranty claims must be submitted to the provider, such as online portal, email, phone, mail, or in-person.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimResponseTimeDays rdf:type rdf:Property ;
    rdfs:label 'Claim Response Time Days' ;
    rdfs:comment 'Number of business days within which the warranty provider commits to respond to a submitted claim.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewableFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Flag' ;
    rdfs:comment 'Indicates whether the warranty can be renewed or extended beyond the original end date.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proratedFlag rdf:type rdf:Property ;
    rdfs:label 'Prorated Flag' ;
    rdfs:comment 'Indicates whether warranty coverage or reimbursement is prorated based on time or usage at the time of claim.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partsCoveredFlag rdf:type rdf:Property ;
    rdfs:label 'Parts Covered Flag' ;
    rdfs:comment 'Indicates whether replacement parts are covered under the warranty.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laborCoveredFlag rdf:type rdf:Property ;
    rdfs:label 'Labor Covered Flag' ;
    rdfs:comment 'Indicates whether labor costs for repairs are covered under the warranty.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelCoveredFlag rdf:type rdf:Property ;
    rdfs:label 'Travel Covered Flag' ;
    rdfs:comment 'Indicates whether travel costs for service technicians are covered under the warranty.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mileageLimit rdf:type rdf:Property ;
    rdfs:label 'Mileage Limit' ;
    rdfs:comment 'Maximum mileage or usage limit for vehicle or equipment warranties, beyond which coverage may be voided or reduced.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hoursLimit rdf:type rdf:Property ;
    rdfs:label 'Hours Limit' ;
    rdfs:comment 'Maximum operating hours limit for equipment warranties, beyond which coverage may be voided or reduced.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Maintenance Required Flag' ;
    rdfs:comment 'Indicates whether regular maintenance is required to keep the warranty valid and enforceable.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maintenanceFrequency rdf:type rdf:Property ;
    rdfs:label 'Maintenance Frequency' ;
    rdfs:comment 'Required frequency of maintenance to maintain warranty validity, such as monthly, quarterly, annually, or per usage interval.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedServiceProviderRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Service Provider Required Flag' ;
    rdfs:comment 'Indicates whether repairs must be performed by authorized service providers to maintain warranty validity.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registrationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Registration Required Flag' ;
    rdfs:comment 'Indicates whether the warranty must be registered with the provider within a specified timeframe to activate coverage.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registrationDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Registration Deadline Date' ;
    rdfs:comment 'Last date by which the warranty must be registered to activate coverage, after which registration may be denied.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentLocation rdf:type rdf:Property ;
    rdfs:label 'Document Location' ;
    rdfs:comment 'File path, URL, or storage location where the warranty document is stored in NCDOT document management systems.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceBondFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Bond Flag' ;
    rdfs:comment 'Indicates whether the warranty is backed by a performance bond to guarantee fulfillment of warranty obligations.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceBondAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Bond Amount' ;
    rdfs:comment 'Dollar amount of the performance bond securing the warranty obligations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationPolicy rdf:type rdf:Property ;
    rdfs:label 'Cancellation Policy' ;
    rdfs:comment 'Description of the policy and process for cancelling the warranty, including any refund provisions or penalties.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleUnit rdf:type rdf:Property ;
    rdfs:label 'Responsible Unit' ;
    rdfs:comment 'Specific organizational unit or cost center within NCDOT responsible for warranty administration and claim processing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonName rdf:type rdf:Property ;
    rdfs:label 'Contact Person Name' ;
    rdfs:comment 'Name of the NCDOT employee or contact person responsible for managing this warranty and coordinating claims.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Person Phone' ;
    rdfs:comment 'Phone number of the NCDOT contact person responsible for warranty management.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Person Email' ;
    rdfs:comment 'Email address of the NCDOT contact person responsible for warranty management.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapEquipmentNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Equipment Number' ;
    rdfs:comment 'Equipment number from SAP PM (Plant Maintenance) module identifying the asset covered by this warranty.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atlasAssetId rdf:type rdf:Property ;
    rdfs:label 'Atlas Asset Id' ;
    rdfs:comment 'Asset identifier from NCDOT ATLAS system for the asset covered by this warranty.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:complianceFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Flag' ;
    rdfs:comment 'Indicates whether the warranty is in compliance with all terms, conditions, and maintenance requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceLastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Last Verified Date' ;
    rdfs:comment 'Date when warranty compliance with terms and maintenance requirements was last verified.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionId rdf:type rdf:Property ;
    rdfs:label 'Condition Id' ;
    rdfs:comment 'Unique identifier for the asset condition rating record. Primary key for the condition data product.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Condition .

ind:numericRating rdf:type rdf:Property ;
    rdfs:label 'Numeric Rating' ;
    rdfs:comment 'Numeric representation of the condition rating on a standardized scale. Enables quantitative analysis and trending of asset condition over time.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingScaleMin rdf:type rdf:Property ;
    rdfs:label 'Rating Scale Min' ;
    rdfs:comment 'Minimum value of the rating scale used for this condition type (e.g., 0 for a 0-100 scale, 1 for a 1-10 scale).' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingScaleMax rdf:type rdf:Property ;
    rdfs:label 'Rating Scale Max' ;
    rdfs:comment 'Maximum value of the rating scale used for this condition type (e.g., 100 for a 0-100 scale, 10 for a 1-10 scale).' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdLower rdf:type rdf:Property ;
    rdfs:label 'Threshold Lower' ;
    rdfs:comment 'Lower boundary threshold value that defines the minimum numeric rating for this condition level. Assets with ratings at or above this value fall into this condition category.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdUpper rdf:type rdf:Property ;
    rdfs:label 'Threshold Upper' ;
    rdfs:comment 'Upper boundary threshold value that defines the maximum numeric rating for this condition level. Assets with ratings below or at this value fall into this condition category.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Severity classification indicating the urgency of maintenance or replacement needs associated with this condition rating.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionRequired rdf:type rdf:Property ;
    rdfs:label 'Action Required' ;
    rdfs:comment 'Type of maintenance or management action typically required when an asset is rated at this condition level.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Action Timeframe Days' ;
    rdfs:comment 'Recommended timeframe in days within which maintenance action should be taken for assets at this condition level.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iriMin rdf:type rdf:Property ;
    rdfs:label 'Iri Min' ;
    rdfs:comment 'Minimum International Roughness Index value (inches per mile) associated with this pavement condition rating. IRI measures pavement surface roughness and ride quality.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:iriMax rdf:type rdf:Property ;
    rdfs:label 'Iri Max' ;
    rdfs:comment 'Maximum International Roughness Index value (inches per mile) associated with this pavement condition rating. IRI measures pavement surface roughness and ride quality.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pciMin rdf:type rdf:Property ;
    rdfs:label 'Pci Min' ;
    rdfs:comment 'Minimum Pavement Condition Index value (0-100 scale) associated with this pavement condition rating. PCI is a numerical rating of pavement surface condition.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pciMax rdf:type rdf:Property ;
    rdfs:label 'Pci Max' ;
    rdfs:comment 'Maximum Pavement Condition Index value (0-100 scale) associated with this pavement condition rating. PCI is a numerical rating of pavement surface surface condition.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:psiMin rdf:type rdf:Property ;
    rdfs:label 'Psi Min' ;
    rdfs:comment 'Minimum Present Serviceability Index value (0-5 scale) associated with this pavement condition rating. PSI measures the ability of pavement to serve traffic.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:psiMax rdf:type rdf:Property ;
    rdfs:label 'Psi Max' ;
    rdfs:comment 'Maximum Present Serviceability Index value (0-5 scale) associated with this pavement condition rating. PSI measures the ability of pavement to serve traffic.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nbiRating rdf:type rdf:Property ;
    rdfs:label 'Nbi Rating' ;
    rdfs:comment 'National Bridge Inventory condition rating code (0-9 or N) for bridge components. Used for federal bridge condition reporting.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sufficiencyRatingMin rdf:type rdf:Property ;
    rdfs:label 'Sufficiency Rating Min' ;
    rdfs:comment 'Minimum bridge sufficiency rating (0-100 scale) associated with this condition level. Sufficiency rating evaluates bridge adequacy and safety.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sufficiencyRatingMax rdf:type rdf:Property ;
    rdfs:label 'Sufficiency Rating Max' ;
    rdfs:comment 'Maximum bridge sufficiency rating (0-100 scale) associated with this condition level. Sufficiency rating evaluates bridge adequacy and safety.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:colorCode rdf:type rdf:Property ;
    rdfs:label 'Color Code' ;
    rdfs:comment 'Hexadecimal color code used for visual representation of this condition rating in dashboards, maps, and reports (e.g., #00FF00 for green/good condition).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggersWorkOrder rdf:type rdf:Property ;
    rdfs:label 'Triggers Work Order' ;
    rdfs:comment 'Indicates whether assignment of this condition rating automatically triggers creation of a maintenance work order in SAP PM or ATLAS.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingPriority rdf:type rdf:Property ;
    rdfs:label 'Funding Priority' ;
    rdfs:comment 'Priority level (1-10) for funding allocation to assets at this condition level. Lower numbers indicate higher priority for capital investment.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:replacementThreshold rdf:type rdf:Property ;
    rdfs:label 'Replacement Threshold' ;
    rdfs:comment 'Indicates whether this condition level represents the threshold at which asset replacement should be considered rather than continued maintenance.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyConcern rdf:type rdf:Property ;
    rdfs:label 'Safety Concern' ;
    rdfs:comment 'Indicates whether this condition level represents a safety concern requiring immediate attention or public notification.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Public Notification Required' ;
    rdfs:comment 'Indicates whether assets at this condition level require public notification or posting of warnings (e.g., bridge weight restrictions, road condition advisories).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hpmsConditionType rdf:type rdf:Property ;
    rdfs:label 'Hpms Condition Type' ;
    rdfs:comment 'HPMS condition classification (Good, Fair, Poor) used for federal reporting. Required for National Highway System reporting to FHWA.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasb34Category rdf:type rdf:Property ;
    rdfs:label 'Gasb 34 Category' ;
    rdfs:comment 'GASB 34 condition category for infrastructure asset reporting. Used for financial reporting of capital assets under modified approach.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceCostFactor rdf:type rdf:Property ;
    rdfs:label 'Maintenance Cost Factor' ;
    rdfs:comment 'Multiplier factor representing the relative maintenance cost for assets at this condition level compared to baseline. Used for budget forecasting.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationRateAnnual rdf:type rdf:Property ;
    rdfs:label 'Depreciation Rate Annual' ;
    rdfs:comment 'Annual depreciation rate (as decimal) typically applied to assets at this condition level for financial accounting purposes.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationId rdf:type rdf:Property ;
    rdfs:label 'Location Id' ;
    rdfs:comment 'Unique identifier for the asset location record. Primary key for the location entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:functionalLocation rdf:type rdf:Property ;
    rdfs:label 'Functional Location' ;
    rdfs:comment 'SAP Plant Maintenance (PM) functional location identifier representing the hierarchical structure of the location within the asset management system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planningPlant rdf:type rdf:Property ;
    rdfs:label 'Planning Plant' ;
    rdfs:comment 'SAP planning plant code associated with the location for maintenance planning and scheduling purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenancePlant rdf:type rdf:Property ;
    rdfs:label 'Maintenance Plant' ;
    rdfs:comment 'SAP maintenance plant code responsible for maintenance activities at this location.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCenter rdf:type rdf:Property ;
    rdfs:label 'Work Center' ;
    rdfs:comment 'SAP work center identifier associated with the location for capacity planning and work assignment.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elevation rdf:type rdf:Property ;
    rdfs:label 'Elevation' ;
    rdfs:comment 'Elevation above sea level in feet for the location.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spatialAccuracy rdf:type rdf:Property ;
    rdfs:label 'Spatial Accuracy' ;
    rdfs:comment 'Classification of the spatial coordinate accuracy indicating the method and precision of location determination.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offsetDistance rdf:type rdf:Property ;
    rdfs:label 'Offset Distance' ;
    rdfs:comment 'Perpendicular offset distance in feet from the route centerline to the location.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offsetDirection rdf:type rdf:Property ;
    rdfs:label 'Offset Direction' ;
    rdfs:comment 'Direction of the offset from the route centerline (e.g., left, right, or cardinal direction).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directionOfTravel rdf:type rdf:Property ;
    rdfs:label 'Direction Of Travel' ;
    rdfs:comment 'Direction of travel associated with the location if on a directional roadway.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lrsRouteId rdf:type rdf:Property ;
    rdfs:label 'Lrs Route Id' ;
    rdfs:comment 'Linear Referencing System route identifier used in NCDOT GIS and asset management systems.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Route .

ind:lrsMeasure rdf:type rdf:Property ;
    rdfs:label 'Lrs Measure' ;
    rdfs:comment 'Linear Referencing System measure value representing the location along the LRS route.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilitySize rdf:type rdf:Property ;
    rdfs:label 'Facility Size' ;
    rdfs:comment 'Total size of the facility in square feet, applicable for fixed facilities such as depots and offices.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacity rdf:type rdf:Property ;
    rdfs:label 'Capacity' ;
    rdfs:comment 'Maximum capacity of the location for asset storage or personnel, expressed in appropriate units (vehicles, equipment units, or persons).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnit rdf:type rdf:Property ;
    rdfs:label 'Capacity Unit' ;
    rdfs:comment 'Unit of measure for the location capacity value.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Date' ;
    rdfs:comment 'Date of the most recent condition assessment for the facility.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:environmentalDesignation rdf:type rdf:Property ;
    rdfs:label 'Environmental Designation' ;
    rdfs:comment 'Special environmental designation or constraint applicable to the location.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityLevel rdf:type rdf:Property ;
    rdfs:label 'Security Level' ;
    rdfs:comment 'Security classification level for the location indicating access control requirements.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessRestrictions rdf:type rdf:Property ;
    rdfs:label 'Access Restrictions' ;
    rdfs:comment 'Description of any access restrictions or special requirements for entering the location.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingHours rdf:type rdf:Property ;
    rdfs:label 'Operating Hours' ;
    rdfs:comment 'Standard operating hours for the location (e.g., \'24/7\', \'Monday-Friday 8:00-17:00\').' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'Name of the primary contact person responsible for the location.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatStoragePermitted rdf:type rdf:Property ;
    rdfs:label 'Hazmat Storage Permitted' ;
    rdfs:comment 'Indicates whether the location is permitted for hazardous materials storage.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fuelStorageCapacity rdf:type rdf:Property ;
    rdfs:label 'Fuel Storage Capacity' ;
    rdfs:comment 'Total fuel storage capacity at the location in gallons, if applicable.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilitiesAvailable rdf:type rdf:Property ;
    rdfs:label 'Utilities Available' ;
    rdfs:comment 'List of utilities available at the location (e.g., \'electricity, water, sewer, natural gas\').' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingCount rdf:type rdf:Property ;
    rdfs:label 'Building Count' ;
    rdfs:comment 'Total number of buildings or structures at the location.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:atlasLocationId rdf:type rdf:Property ;
    rdfs:label 'Atlas Location Id' ;
    rdfs:comment 'Unique location identifier in the NCDOT ATLAS asset management system.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timsLocationId rdf:type rdf:Property ;
    rdfs:label 'Tims Location Id' ;
    rdfs:comment 'Location identifier in the NCDOT TIMS system for incident management and traffic operations.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentLocationCode rdf:type rdf:Property ;
    rdfs:label 'Parent Location Code' ;
    rdfs:comment 'Location code of the parent location in a hierarchical location structure (e.g., a depot within a district).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric level in the location hierarchy (e.g., 1=Division, 2=District, 3=Facility).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCurrent rdf:type rdf:Property ;
    rdfs:label 'Is Current' ;
    rdfs:comment 'Indicates whether this is the current active record for the location in a slowly changing dimension model.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taskId rdf:type rdf:Property ;
    rdfs:label 'Task Id' ;
    rdfs:comment 'Unique identifier for the predefined maintenance task. Primary key for the task master list.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Task .

ind:laborCode rdf:type rdf:Property ;
    rdfs:label 'Labor Code' ;
    rdfs:comment 'Standard labor classification code from SAP PM used for crew assignment and cost tracking.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDurationHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Hours' ;
    rdfs:comment 'Standard estimated time in hours required to complete the task under normal conditions. Used for work order scheduling and resource planning.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCrewSize rdf:type rdf:Property ;
    rdfs:label 'Estimated Crew Size' ;
    rdfs:comment 'Standard number of personnel required to perform the task efficiently and safely.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standardQuantity rdf:type rdf:Property ;
    rdfs:label 'Standard Quantity' ;
    rdfs:comment 'Typical quantity of work performed per task execution in the specified unit of measure.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:season rdf:type rdf:Property ;
    rdfs:label 'Season' ;
    rdfs:comment 'Season(s) during which the task is typically performed, particularly relevant for weather-dependent operations like winter operations or vegetation management.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:motRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Mot Required Flag' ;
    rdfs:comment 'Indicates whether the task requires Maintenance of Traffic (MOT) setup including traffic control devices, lane closures, or detours.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:motType rdf:type rdf:Property ;
    rdfs:label 'Mot Type' ;
    rdfs:comment 'Type of Maintenance of Traffic (MOT) setup required for the task if MOT is needed.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyRequirements rdf:type rdf:Property ;
    rdfs:label 'Safety Requirements' ;
    rdfs:comment 'Specific safety requirements, personal protective equipment (PPE), and precautions required for task execution.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalConsiderations rdf:type rdf:Property ;
    rdfs:label 'Environmental Considerations' ;
    rdfs:comment 'Environmental compliance requirements, restrictions, or considerations for the task (e.g., herbicide application restrictions, erosion control measures).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentRequired rdf:type rdf:Property ;
    rdfs:label 'Equipment Required' ;
    rdfs:comment 'List of standard equipment and vehicles required to perform the task (e.g., dump truck, mower, plow, striping machine).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialList rdf:type rdf:Property ;
    rdfs:label 'Material List' ;
    rdfs:comment 'List of standard materials required for the task with typical quantities (e.g., asphalt mix, salt, herbicide, paint).' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Material Cost Estimate' ;
    rdfs:comment 'Estimated cost of materials required for standard task execution in US dollars.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:skillRequirements rdf:type rdf:Property ;
    rdfs:label 'Skill Requirements' ;
    rdfs:comment 'Required skills, certifications, or qualifications for personnel performing the task (e.g., CDL, pesticide applicator license, traffic control certification).' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Training Required Flag' ;
    rdfs:comment 'Indicates whether specialized training is required before personnel can perform the task.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingDescription rdf:type rdf:Property ;
    rdfs:label 'Training Description' ;
    rdfs:comment 'Description of required training programs or certifications if training_required_flag is true.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalLocationCategory rdf:type rdf:Property ;
    rdfs:label 'Functional Location Category' ;
    rdfs:comment 'Category of functional location (asset type) where the task is typically performed in SAP PM.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceStandard rdf:type rdf:Property ;
    rdfs:label 'Performance Standard' ;
    rdfs:comment 'Quality or performance standard that must be met upon task completion (e.g., pavement smoothness, vegetation clearance height).' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Warranty Period Days' ;
    rdfs:comment 'Standard warranty or guarantee period in days for the completed task, after which rework is considered a new task.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyResponseFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Flag' ;
    rdfs:comment 'Indicates whether the task is classified as an emergency response activity requiring immediate action.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseTimeTargetHours rdf:type rdf:Property ;
    rdfs:label 'Response Time Target Hours' ;
    rdfs:comment 'Target response time in hours from notification to task initiation, particularly relevant for emergency and high-priority tasks.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completionTimeTargetHours rdf:type rdf:Property ;
    rdfs:label 'Completion Time Target Hours' ;
    rdfs:comment 'Target time in hours from task initiation to completion, used for performance measurement and SLA tracking.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Contract Eligible Flag' ;
    rdfs:comment 'Indicates whether the task can be performed by external contractors rather than in-house maintenance crews.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractType rdf:type rdf:Property ;
    rdfs:label 'Contract Type' ;
    rdfs:comment 'Preferred execution method indicating whether the task should be performed in-house, by contractor, or either.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Stip Eligible Flag' ;
    rdfs:comment 'Indicates whether the task is eligible for inclusion in the State Transportation Improvement Program (STIP) for federal funding.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalProgram rdf:type rdf:Property ;
    rdfs:label 'Federal Program' ;
    rdfs:comment 'Specific federal funding program if applicable (e.g., HSIP, CMAQ, STP, NHS).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccount rdf:type rdf:Property ;
    rdfs:label 'Gl Account' ;
    rdfs:comment 'General Ledger (GL) account code in SAP for posting task-related expenses.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityType rdf:type rdf:Property ;
    rdfs:label 'Activity Type' ;
    rdfs:comment 'SAP CO activity type for internal cost allocation and activity-based costing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hpmsCode rdf:type rdf:Property ;
    rdfs:label 'Hpms Code' ;
    rdfs:comment 'Highway Performance Monitoring System (HPMS) activity code for federal reporting to FHWA.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mutcdReference rdf:type rdf:Property ;
    rdfs:label 'Mutcd Reference' ;
    rdfs:comment 'Reference to relevant section(s) of the Manual on Uniform Traffic Control Devices (MUTCD) if the task involves traffic control or signage.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aashtoReference rdf:type rdf:Property ;
    rdfs:label 'Aashto Reference' ;
    rdfs:comment 'Reference to relevant American Association of State Highway and Transportation Officials (AASHTO) standard or guideline for the task.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardOperatingProcedure rdf:type rdf:Property ;
    rdfs:label 'Standard Operating Procedure' ;
    rdfs:comment 'Reference to NCDOT Standard Operating Procedure (SOP) document number or title governing task execution.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'User ID or name of the person who created the task in the master list.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByTaskId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Task Id' ;
    rdfs:comment 'Task ID of the newer task that supersedes this task if the task has been replaced or deprecated.' ;
    rdfs:domain ind:Task ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Task .

ind:inspectionId rdf:type rdf:Property ;
    rdfs:label 'Inspection Id' ;
    rdfs:comment 'Unique identifier for the asset inspection event. Primary key for the asset inspection record.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Inspection .

ind:date rdf:type rdf:Property ;
    rdfs:label 'Date' ;
    rdfs:comment 'The date on which the asset inspection was performed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'The precise date and time when the inspection activity began.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:endTimestamp rdf:type rdf:Property ;
    rdfs:label 'End Timestamp' ;
    rdfs:comment 'The precise date and time when the inspection activity was completed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'The methodology or technique used to conduct the inspection, such as visual observation, instrumented testing, or remote sensing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Inspector Employee Id' ;
    rdfs:comment 'The unique employee identifier for the inspector in the NCDOT human resources system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:inspectorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification Number' ;
    rdfs:comment 'The certification or license number held by the inspector authorizing them to perform this type of inspection.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCertificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification Expiration Date' ;
    rdfs:comment 'The date on which the inspector\'s certification expires and requires renewal.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:teamMembers rdf:type rdf:Property ;
    rdfs:label 'Team Members' ;
    rdfs:comment 'Names or identifiers of additional team members who participated in the inspection activity.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationHours rdf:type rdf:Property ;
    rdfs:label 'Duration Hours' ;
    rdfs:comment 'The total number of hours spent conducting the inspection from start to completion.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousConditionRating rdf:type rdf:Property ;
    rdfs:label 'Previous Condition Rating' ;
    rdfs:comment 'The condition rating from the most recent prior inspection, used for trend analysis.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousConditionScore rdf:type rdf:Property ;
    rdfs:label 'Previous Condition Score' ;
    rdfs:comment 'The numeric condition score from the most recent prior inspection.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deckConditionRating rdf:type rdf:Property ;
    rdfs:label 'Deck Condition Rating' ;
    rdfs:comment 'For bridge inspections, the condition rating of the bridge deck using the NBI rating scale (0-9 or N for not applicable).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:superstructureConditionRating rdf:type rdf:Property ;
    rdfs:label 'Superstructure Condition Rating' ;
    rdfs:comment 'For bridge inspections, the condition rating of the bridge superstructure using the NBI rating scale (0-9 or N for not applicable).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substructureConditionRating rdf:type rdf:Property ;
    rdfs:label 'Substructure Condition Rating' ;
    rdfs:comment 'For bridge inspections, the condition rating of the bridge substructure using the NBI rating scale (0-9 or N for not applicable).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementConditionIndex rdf:type rdf:Property ;
    rdfs:label 'Pavement Condition Index' ;
    rdfs:comment 'For pavement inspections, the PCI score representing the overall condition of the pavement surface (0-100 scale).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internationalRoughnessIndex rdf:type rdf:Property ;
    rdfs:label 'International Roughness Index' ;
    rdfs:comment 'For pavement inspections, the IRI measurement in inches per mile or meters per kilometer, indicating pavement roughness.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:presentServiceabilityIndex rdf:type rdf:Property ;
    rdfs:label 'Present Serviceability Index' ;
    rdfs:comment 'For pavement inspections, the PSI rating representing the current serviceability of the pavement (0-5 scale).' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defectsIdentified rdf:type rdf:Property ;
    rdfs:label 'Defects Identified' ;
    rdfs:comment 'A detailed description of all defects, deficiencies, or issues identified during the inspection.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalFindingsFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Findings Flag' ;
    rdfs:comment 'Indicates whether any critical safety or structural issues were identified that require immediate attention.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalFindingsDescription rdf:type rdf:Property ;
    rdfs:label 'Critical Findings Description' ;
    rdfs:comment 'Detailed description of any critical findings that pose immediate safety or operational risks.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyConcerns rdf:type rdf:Property ;
    rdfs:label 'Safety Concerns' ;
    rdfs:comment 'Description of any safety concerns or hazards identified during the inspection that may affect public safety or worker safety.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionsRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions Required' ;
    rdfs:comment 'Description of the corrective actions, repairs, or maintenance activities recommended based on inspection findings.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPriority rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Priority' ;
    rdfs:comment 'The priority level assigned to the recommended corrective actions based on severity and risk.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRepairCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Repair Cost' ;
    rdfs:comment 'The estimated cost in US dollars to complete the recommended corrective actions or repairs.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recommendedActionDate rdf:type rdf:Property ;
    rdfs:label 'Recommended Action Date' ;
    rdfs:comment 'The recommended date by which corrective actions should be completed to address identified deficiencies.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'The unique identifier or reference number for the formal inspection report document.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportUrl rdf:type rdf:Property ;
    rdfs:label 'Report Url' ;
    rdfs:comment 'The URL or file path to the digital inspection report document stored in the document management system.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photosTakenCount rdf:type rdf:Property ;
    rdfs:label 'Photos Taken Count' ;
    rdfs:comment 'The number of photographs taken during the inspection to document asset condition and defects.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:photoStorageLocation rdf:type rdf:Property ;
    rdfs:label 'Photo Storage Location' ;
    rdfs:comment 'The file path or URL where inspection photographs are stored in the document management system.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditions rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions' ;
    rdfs:comment 'The weather conditions present during the inspection, which may affect inspection quality or findings.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentUsed rdf:type rdf:Property ;
    rdfs:label 'Equipment Used' ;
    rdfs:comment 'Description of specialized equipment, tools, or instruments used during the inspection (e.g., drones, ultrasonic testing equipment).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryStandardReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Standard Reference' ;
    rdfs:comment 'Reference to the specific regulatory standard, code, or specification against which compliance was evaluated.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadRating rdf:type rdf:Property ;
    rdfs:label 'Load Rating' ;
    rdfs:comment 'For bridge inspections, the load rating indicating the maximum safe load capacity of the structure.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadPostingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Load Posting Required Flag' ;
    rdfs:comment 'For bridge inspections, indicates whether load posting signs are required based on the load rating evaluation.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trafficControlType rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Type' ;
    rdfs:comment 'The type of traffic control measures implemented during the inspection activity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cost rdf:type rdf:Property ;
    rdfs:label 'Cost' ;
    rdfs:comment 'The total cost in US dollars incurred to perform the inspection, including labor, equipment, and materials.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Work Order Number' ;
    rdfs:comment 'The work order number in SAP PM or maintenance management system associated with the inspection activity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationNumber rdf:type rdf:Property ;
    rdfs:label 'Notification Number' ;
    rdfs:comment 'The SAP notification number created to document defects or issues identified during the inspection.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpsAccuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Gps Accuracy Meters' ;
    rdfs:comment 'The accuracy of the GPS coordinates captured during the inspection, measured in meters.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cycleYear rdf:type rdf:Property ;
    rdfs:label 'Cycle Year' ;
    rdfs:comment 'The calendar year or inspection cycle year in which this inspection was scheduled and performed.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:program rdf:type rdf:Property ;
    rdfs:label 'Program' ;
    rdfs:comment 'The name or identifier of the inspection program or initiative under which this inspection was conducted (e.g., NBIS, HSIP, Pavement Management).' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalId rdf:type rdf:Property ;
    rdfs:label 'Disposal Id' ;
    rdfs:comment 'Unique identifier for the asset disposal event record.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timestamp rdf:type rdf:Property ;
    rdfs:label 'Timestamp' ;
    rdfs:comment 'Precise timestamp when the disposal transaction was recorded in the system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reason rdf:type rdf:Property ;
    rdfs:label 'Reason' ;
    rdfs:comment 'Business justification or reason for disposing of the asset.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionProceedsAmount rdf:type rdf:Property ;
    rdfs:label 'Disposition Proceeds Amount' ;
    rdfs:comment 'Total monetary proceeds received from the disposal of the asset, in US dollars.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispositionProceedsCurrency rdf:type rdf:Property ;
    rdfs:label 'Disposition Proceeds Currency' ;
    rdfs:comment 'Currency code for the proceeds amount, typically USD for NCDOT transactions.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'The net book value (original cost minus accumulated depreciation) of the asset at the time of disposal.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalAcquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Original Acquisition Cost' ;
    rdfs:comment 'The original purchase or construction cost of the asset when it was first acquired.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation' ;
    rdfs:comment 'Total depreciation accumulated on the asset from acquisition date to disposal date.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gainLossAmount rdf:type rdf:Property ;
    rdfs:label 'Gain Loss Amount' ;
    rdfs:comment 'Calculated gain or loss on disposal, computed as proceeds minus net book value.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buyerType rdf:type rdf:Property ;
    rdfs:label 'Buyer Type' ;
    rdfs:comment 'Classification of the buyer or recipient of the disposed asset.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Buyer Contact Email' ;
    rdfs:comment 'Email address of the buyer or recipient for transaction correspondence.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Buyer Contact Phone' ;
    rdfs:comment 'Phone number of the buyer or recipient for transaction correspondence.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferRecipientAgency rdf:type rdf:Property ;
    rdfs:label 'Transfer Recipient Agency' ;
    rdfs:comment 'Name of the government agency or NCDOT division that received the asset in a transfer disposal.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionHouseName rdf:type rdf:Property ;
    rdfs:label 'Auction House Name' ;
    rdfs:comment 'Name of the auction house or broker used to facilitate the sale of the asset.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionLotNumber rdf:type rdf:Property ;
    rdfs:label 'Auction Lot Number' ;
    rdfs:comment 'Lot number assigned to the asset in the auction catalog.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scrapDealerName rdf:type rdf:Property ;
    rdfs:label 'Scrap Dealer Name' ;
    rdfs:comment 'Name of the scrap dealer or recycling company that received the asset for scrapping or recycling.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scrapWeightLbs rdf:type rdf:Property ;
    rdfs:label 'Scrap Weight Lbs' ;
    rdfs:comment 'Weight of the scrapped asset in pounds, used for scrap value calculation.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scrapMaterialType rdf:type rdf:Property ;
    rdfs:label 'Scrap Material Type' ;
    rdfs:comment 'Primary material type of the scrapped asset for recycling classification.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalClearanceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Clearance Required Flag' ;
    rdfs:comment 'Indicates whether environmental clearance or assessment was required prior to disposal due to hazardous materials or contamination.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalClearanceAgency rdf:type rdf:Property ;
    rdfs:label 'Environmental Clearance Agency' ;
    rdfs:comment 'Name of the regulatory agency that provided environmental clearance (e.g., NCDEQ, EPA).' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardousMaterialFlag rdf:type rdf:Property ;
    rdfs:label 'Hazardous Material Flag' ;
    rdfs:comment 'Indicates whether the disposed asset contained or was contaminated with hazardous materials.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazardousMaterialType rdf:type rdf:Property ;
    rdfs:label 'Hazardous Material Type' ;
    rdfs:comment 'Description of the hazardous material present in the asset (e.g., asbestos, lead paint, PCBs, fuel, oil).' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Name of the facility, yard, or site where the disposal transaction took place.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationAddress rdf:type rdf:Property ;
    rdfs:label 'Location Address' ;
    rdfs:comment 'Physical address of the disposal location.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCity rdf:type rdf:Property ;
    rdfs:label 'Location City' ;
    rdfs:comment 'City where the disposal took place.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCounty rdf:type rdf:Property ;
    rdfs:label 'Location County' ;
    rdfs:comment 'North Carolina county where the disposal took place.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationState rdf:type rdf:Property ;
    rdfs:label 'Location State' ;
    rdfs:comment 'State code where the disposal took place, typically NC for NCDOT assets.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationZipCode rdf:type rdf:Property ;
    rdfs:label 'Location Zip Code' ;
    rdfs:comment 'ZIP code of the disposal location.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether formal management or board approval was required for the disposal based on asset value or policy thresholds.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'Name of the individual or committee that approved the disposal.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverTitle rdf:type rdf:Property ;
    rdfs:label 'Approver Title' ;
    rdfs:comment 'Job title or role of the approver (e.g., Division Engineer, Chief Financial Officer, Board of Transportation).' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Authorization Number' ;
    rdfs:comment 'Unique authorization or approval reference number for the disposal transaction.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'SAP document number or transaction reference for the disposal posting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalFundingFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Flag' ;
    rdfs:comment 'Indicates whether the asset was originally acquired with federal funding, requiring compliance with federal disposal regulations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalSharePercentage rdf:type rdf:Property ;
    rdfs:label 'Federal Share Percentage' ;
    rdfs:comment 'Percentage of the original asset cost funded by federal sources, used to calculate federal reimbursement obligations on disposal proceeds.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalReimbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Federal Reimbursement Amount' ;
    rdfs:comment 'Amount of disposal proceeds that must be returned to the federal funding agency per grant requirements.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:titleTransferDate rdf:type rdf:Property ;
    rdfs:label 'Title Transfer Date' ;
    rdfs:comment 'Date on which legal title and ownership of the asset was transferred to the buyer or recipient.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Title Document Number' ;
    rdfs:comment 'Vehicle title number or property deed number documenting the transfer of ownership.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Vehicle Identification Number' ;
    rdfs:comment '17-character VIN for disposed vehicles, used for DMV title transfer and tracking.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Equipment Serial Number' ;
    rdfs:comment 'Manufacturer serial number of the disposed equipment or machinery.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerName rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Name' ;
    rdfs:comment 'Name of the manufacturer or original equipment manufacturer (OEM) of the disposed asset.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNumber rdf:type rdf:Property ;
    rdfs:label 'Model Number' ;
    rdfs:comment 'Manufacturer model number or designation of the disposed asset.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearManufactured rdf:type rdf:Property ;
    rdfs:label 'Year Manufactured' ;
    rdfs:comment 'Year in which the asset was manufactured or constructed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageAtDisposalYears rdf:type rdf:Property ;
    rdfs:label 'Age At Disposal Years' ;
    rdfs:comment 'Age of the asset in years at the time of disposal, calculated from acquisition date to disposal date.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:replacementAssetId rdf:type rdf:Property ;
    rdfs:label 'Replacement Asset Id' ;
    rdfs:comment 'Identifier of the new asset that replaced the disposed asset, if applicable.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:insuranceClaimFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Flag' ;
    rdfs:comment 'Indicates whether an insurance claim was filed in connection with the disposal (e.g., for damaged or stolen assets).' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Number' ;
    rdfs:comment 'Insurance claim reference number if a claim was filed related to the disposal.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurancePayoutAmount rdf:type rdf:Property ;
    rdfs:label 'Insurance Payout Amount' ;
    rdfs:comment 'Amount received from insurance company for the disposed asset.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initiatedBy rdf:type rdf:Property ;
    rdfs:label 'Initiated By' ;
    rdfs:comment 'Name of the employee or role that initiated the disposal request.' ;
    rdfs:domain ind:Disposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procurementId rdf:type rdf:Property ;
    rdfs:label 'Procurement Id' ;
    rdfs:comment 'Unique identifier for the asset procurement transaction.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Procurement .

ind:vendorType rdf:type rdf:Property ;
    rdfs:label 'Vendor Type' ;
    rdfs:comment 'Classification of the vendor relationship type.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorDbeStatus rdf:type rdf:Property ;
    rdfs:label 'Vendor Dbe Status' ;
    rdfs:comment 'Vendor certification status as Disadvantaged Business Enterprise, Minority Business Enterprise, Women Business Enterprise, or Historically Underutilized Business.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requisitionDate rdf:type rdf:Property ;
    rdfs:label 'Requisition Date' ;
    rdfs:comment 'Date when the internal purchase requisition was created.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderDate rdf:type rdf:Property ;
    rdfs:label 'Order Date' ;
    rdfs:comment 'Date when the purchase order was issued to the vendor.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Expected Delivery Date' ;
    rdfs:comment 'Originally scheduled or promised delivery date for the asset.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'Date when the asset was officially received and accepted by NCDOT.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inServiceDate rdf:type rdf:Property ;
    rdfs:label 'In Service Date' ;
    rdfs:comment 'Date when the asset was placed into active service or operation.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capitalizationDate rdf:type rdf:Property ;
