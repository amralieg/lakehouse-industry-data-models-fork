ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Legal structure of the insured: individual, sole proprietor, partnership, LLC, corporation, trust, estate, or government entity. [ENUM-REF-CANDIDATE: individual|sole_proprietor|partnership|llc|corporation|trust|estate|government — 8 candidates stripped' ;
    rdfs:domain ind:PcInsurance ;
