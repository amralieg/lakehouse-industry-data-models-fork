    rdfs:range xsd:decimal .

ind:appealStatus rdf:type rdf:Property ;
    rdfs:label 'Appeal Status' ;
    rdfs:comment 'Current status of any appeal filed regarding the permit.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNoticeRequired rdf:type rdf:Property ;
    rdfs:label 'Public Notice Required' ;
    rdfs:comment 'Indicates whether public notice was required for the permit application.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicCommentPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period Start' ;
    rdfs:comment 'Start date of the public comment period for the permit application.' ;
    rdfs:domain ind:Environmental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicCommentsReceived rdf:type rdf:Property ;
    rdfs:label 'Public Comments Received' ;
    rdfs:comment 'Total number of public comments received during the comment period.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consultationRequired rdf:type rdf:Property ;
    rdfs:label 'Consultation Required' ;
    rdfs:comment 'Indicates whether consultation with other agencies was required for the permit.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consultingAgencies rdf:type rdf:Property ;
    rdfs:label 'Consulting Agencies' ;
    rdfs:comment 'List of agencies consulted during the permit review process.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endangeredSpeciesConsultation rdf:type rdf:Property ;
    rdfs:label 'Endangered Species Consultation' ;
    rdfs:comment 'Indicates whether Endangered Species Act Section 7 consultation was required.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:biologicalOpinionIssued rdf:type rdf:Property ;
    rdfs:label 'Biological Opinion Issued' ;
    rdfs:comment 'Indicates whether a biological opinion was issued by USFWS or NOAA for the project.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:historicPreservationConsultation rdf:type rdf:Property ;
    rdfs:label 'Historic Preservation Consultation' ;
    rdfs:comment 'Indicates whether Section 106 historic preservation consultation was required.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shpoConcurrenceReceived rdf:type rdf:Property ;
    rdfs:label 'Shpo Concurrence Received' ;
    rdfs:comment 'Indicates whether concurrence was received from the State Historic Preservation Office.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:erosionControlPlanApproved rdf:type rdf:Property ;
    rdfs:label 'Erosion Control Plan Approved' ;
    rdfs:comment 'Indicates whether the erosion and sediment control plan was approved.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bondRequired rdf:type rdf:Property ;
    rdfs:label 'Bond Required' ;
    rdfs:comment 'Indicates whether a performance or financial assurance bond is required for the permit.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bondAmount rdf:type rdf:Property ;
    rdfs:label 'Bond Amount' ;
    rdfs:comment 'Dollar amount of the performance or financial assurance bond required.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bondStatus rdf:type rdf:Property ;
    rdfs:label 'Bond Status' ;
    rdfs:comment 'Current status of the performance or financial assurance bond.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feePaymentDate rdf:type rdf:Property ;
    rdfs:label 'Fee Payment Date' ;
    rdfs:comment 'Date when the permit fee was paid to the regulatory agency.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ncdotProjectManager rdf:type rdf:Property ;
    rdfs:label 'Ncdot Project Manager' ;
    rdfs:comment 'Name of the NCDOT project manager responsible for the permitted project.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncdotEnvironmentalCoordinator rdf:type rdf:Property ;
    rdfs:label 'Ncdot Environmental Coordinator' ;
    rdfs:comment 'Name of the NCDOT environmental coordinator responsible for permit compliance.' ;
    rdfs:domain ind:Permit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationPlanId rdf:type rdf:Property ;
    rdfs:label 'Mitigation Plan Id' ;
    rdfs:comment 'Unique identifier for the mitigation plan record. Primary key for the mitigation plan entity.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planTitle rdf:type rdf:Property ;
    rdfs:label 'Plan Title' ;
    rdfs:comment 'Descriptive title of the mitigation plan identifying the primary environmental impact being addressed.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planDescription rdf:type rdf:Property ;
    rdfs:label 'Plan Description' ;
    rdfs:comment 'Comprehensive description of the mitigation plan including objectives, scope, and overall approach to offsetting environmental impacts.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactMagnitude rdf:type rdf:Property ;
    rdfs:label 'Impact Magnitude' ;
    rdfs:comment 'Qualitative assessment of the severity or magnitude of the environmental impact being mitigated.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactLinearFeet rdf:type rdf:Property ;
    rdfs:label 'Impact Linear Feet' ;
    rdfs:comment 'Linear measurement of environmental impact in feet (e.g., feet of stream affected, feet of right-of-way disturbance).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mitigationAction rdf:type rdf:Property ;
    rdfs:label 'Mitigation Action' ;
    rdfs:comment 'Detailed description of the specific mitigation action or measure to be implemented to offset the identified environmental impact.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationLocation rdf:type rdf:Property ;
    rdfs:label 'Mitigation Location' ;
    rdfs:comment 'Geographic description or address of the location where mitigation activities will be performed.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationCounty rdf:type rdf:Property ;
    rdfs:label 'Mitigation County' ;
    rdfs:comment 'North Carolina county where the mitigation activities will take place.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationLatitude rdf:type rdf:Property ;
    rdfs:label 'Mitigation Latitude' ;
    rdfs:comment 'Latitude coordinate of the mitigation site location in decimal degrees.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mitigationLongitude rdf:type rdf:Property ;
    rdfs:label 'Mitigation Longitude' ;
    rdfs:comment 'Longitude coordinate of the mitigation site location in decimal degrees.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mitigationLinearFeet rdf:type rdf:Property ;
    rdfs:label 'Mitigation Linear Feet' ;
    rdfs:comment 'Linear measurement of mitigation activity in feet (e.g., feet of stream restored, feet of buffer established).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleParty rdf:type rdf:Property ;
    rdfs:label 'Responsible Party' ;
    rdfs:comment 'Name of the organization or entity responsible for implementing the mitigation plan (e.g., NCDOT, contractor, third-party mitigation bank).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitIssuingAgency rdf:type rdf:Property ;
    rdfs:label 'Permit Issuing Agency' ;
    rdfs:comment 'Government agency that issued the environmental permit requiring this mitigation (e.g., USACE - US Army Corps of Engineers, NCDEQ - NC Department of Environmental Quality, EPA - Environmental Protection Agency, USFWS - US Fish and Wildlife Service, SHPO - State Historic Preservation Office).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAgencyContact rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency Contact' ;
    rdfs:comment 'Name of the primary contact at the regulatory agency overseeing this mitigation plan.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current status of the mitigation plan in its lifecycle: draft (being developed), submitted (under review), approved (authorized for implementation), in_progress (actively being implemented), completed (implementation finished), monitoring (post-implementation monitoring phase), closed (all requirements satisfied), suspended (temporarily halted), cancelled (no longer required).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Planned Completion Date' ;
    rdfs:comment 'Scheduled date for completing all mitigation activities.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringStartDate rdf:type rdf:Property ;
    rdfs:label 'Monitoring Start Date' ;
    rdfs:comment 'Date when post-implementation monitoring period begins.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringEndDate rdf:type rdf:Property ;
    rdfs:label 'Monitoring End Date' ;
    rdfs:comment 'Date when post-implementation monitoring period is scheduled to end.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringCriteria rdf:type rdf:Property ;
    rdfs:label 'Monitoring Criteria' ;
    rdfs:comment 'Specific measurable criteria that must be met to demonstrate successful mitigation (e.g., vegetation survival rates, water quality parameters, species population targets).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Success Criteria Met' ;
    rdfs:comment 'Indicator of whether the mitigation plan has met all defined success criteria.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditCostPerUnit rdf:type rdf:Property ;
    rdfs:label 'Credit Cost Per Unit' ;
    rdfs:comment 'Cost per mitigation credit purchased from a mitigation bank or in-lieu fee program.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceBondRequired rdf:type rdf:Property ;
    rdfs:label 'Performance Bond Required' ;
    rdfs:comment 'Indicator of whether a performance bond is required to guarantee completion of mitigation activities.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adaptiveManagementRequired rdf:type rdf:Property ;
    rdfs:label 'Adaptive Management Required' ;
    rdfs:comment 'Indicator of whether adaptive management approach is required to adjust mitigation activities based on monitoring results.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinationAgency1 rdf:type rdf:Property ;
    rdfs:label 'Coordination Agency 1' ;
    rdfs:comment 'Name of the first regulatory or resource agency requiring coordination for this mitigation plan (e.g., USACE, NCDEQ, USFWS).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationAgency2 rdf:type rdf:Property ;
    rdfs:label 'Coordination Agency 2' ;
    rdfs:comment 'Name of the second regulatory or resource agency requiring coordination for this mitigation plan.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationAgency3 rdf:type rdf:Property ;
    rdfs:label 'Coordination Agency 3' ;
    rdfs:comment 'Name of the third regulatory or resource agency requiring coordination for this mitigation plan.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicCommentPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period End' ;
    rdfs:comment 'End date of the public comment period for this mitigation plan, if applicable.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:environmentalJusticeConsideration rdf:type rdf:Property ;
    rdfs:label 'Environmental Justice Consideration' ;
    rdfs:comment 'Description of environmental justice considerations and how the mitigation plan addresses impacts to minority or low-income populations.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentRepositoryPath rdf:type rdf:Property ;
    rdfs:label 'Document Repository Path' ;
    rdfs:comment 'File path or URL to the document repository location where mitigation plan documentation is stored (e.g., SharePoint, ProjectWise).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionDeadline rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Deadline' ;
    rdfs:comment 'Deadline date by which corrective actions must be completed.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:longTermManagementPlan rdf:type rdf:Property ;
    rdfs:label 'Long Term Management Plan' ;
    rdfs:comment 'Description of the long-term management plan for the mitigation site after the monitoring period ends, including maintenance responsibilities and funding mechanisms.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conservationEasementRequired rdf:type rdf:Property ;
    rdfs:label 'Conservation Easement Required' ;
    rdfs:comment 'Indicator of whether a conservation easement or deed restriction is required to protect the mitigation site in perpetuity.' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:easementHolder rdf:type rdf:Property ;
    rdfs:label 'Easement Holder' ;
    rdfs:comment 'Name of the organization or entity holding the conservation easement for the mitigation site (e.g., land trust, government agency).' ;
    rdfs:domain ind:MitigationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentId rdf:type rdf:Property ;
    rdfs:label 'Segment Id' ;
    rdfs:comment 'Unique identifier for each linear highway segment in the state highway system. Primary key for the segment master record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Segment .

ind:beginMilepoint rdf:type rdf:Property ;
    rdfs:label 'Begin Milepoint' ;
    rdfs:comment 'Starting milepoint of the highway segment measured from the route origin. Used to define the linear referencing system position.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endMilepoint rdf:type rdf:Property ;
    rdfs:label 'End Milepoint' ;
    rdfs:comment 'Ending milepoint of the highway segment measured from the route origin. Used to define the linear referencing system position.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Code' ;
    rdfs:comment 'Code indicating the governmental entity responsible for the segment (e.g., 1=State Highway Agency, 2=County, 3=Town/Township, 4=City/Municipal).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionName rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Name' ;
    rdfs:comment 'Name of the governmental entity responsible for maintaining and operating the highway segment.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipCode rdf:type rdf:Property ;
    rdfs:label 'Ownership Code' ;
    rdfs:comment 'Code indicating the governmental entity that owns the segment, which may differ from the jurisdiction responsible for maintenance.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nhsType rdf:type rdf:Property ;
    rdfs:label 'Nhs Type' ;
    rdfs:comment 'Classification of the NHS designation if the segment is part of the NHS (e.g., Interstate, Principal Arterial, Intermodal Connector).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strahnetIndicator rdf:type rdf:Property ;
    rdfs:label 'Strahnet Indicator' ;
    rdfs:comment 'Flag indicating whether the segment is part of the Strategic Highway Network, a system of highways important to national defense and emergency mobilization.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:urbanCode rdf:type rdf:Property ;
    rdfs:label 'Urban Code' ;
    rdfs:comment 'Census-defined urban area code if the segment is located within an urbanized area or urban cluster.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urbanAreaName rdf:type rdf:Property ;
    rdfs:label 'Urban Area Name' ;
    rdfs:comment 'Name of the urban area in which the segment is located, if applicable.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityType rdf:type rdf:Property ;
    rdfs:label 'Facility Type' ;
    rdfs:comment 'Type of highway facility represented by the segment (e.g., mainline, ramp, collector-distributor road).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:throughLanes rdf:type rdf:Property ;
    rdfs:label 'Through Lanes' ;
    rdfs:comment 'Total number of through traffic lanes in the predominant direction of travel, excluding auxiliary lanes, turn lanes, and shoulders.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:directionOfInventory rdf:type rdf:Property ;
    rdfs:label 'Direction Of Inventory' ;
    rdfs:comment 'Cardinal direction or milepoint direction used for inventory and reporting purposes (e.g., North, South, Increasing milepoint).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medianType rdf:type rdf:Property ;
    rdfs:label 'Median Type' ;
    rdfs:comment 'Type of median separating opposing traffic flows (e.g., None, Unprotected, Curbed, Positive Barrier).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medianWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Median Width Feet' ;
    rdfs:comment 'Width of the median measured in feet from edge of traveled way to edge of traveled way.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accessControl rdf:type rdf:Property ;
    rdfs:label 'Access Control' ;
    rdfs:comment 'Level of access control for the segment indicating the degree to which access is limited (e.g., Full for Interstate, Partial, None).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terrainType rdf:type rdf:Property ;
    rdfs:label 'Terrain Type' ;
    rdfs:comment 'General terrain classification of the area through which the segment passes (Flat, Rolling, or Mountainous).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surfaceType rdf:type rdf:Property ;
    rdfs:label 'Surface Type' ;
    rdfs:comment 'Type of pavement surface material on the segment (e.g., Asphalt, Concrete, Composite, Unpaved).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementConditionRating rdf:type rdf:Property ;
    rdfs:label 'Pavement Condition Rating' ;
    rdfs:comment 'Numeric rating representing the overall condition of the pavement surface, typically on a 0-100 scale where higher values indicate better condition.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:iriValue rdf:type rdf:Property ;
    rdfs:label 'Iri Value' ;
    rdfs:comment 'International Roughness Index measurement in inches per mile, representing pavement smoothness and ride quality. Lower values indicate smoother pavement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:psiValue rdf:type rdf:Property ;
    rdfs:label 'Psi Value' ;
    rdfs:comment 'Present Serviceability Index rating on a 0-5 scale representing pavement serviceability and user comfort. Higher values indicate better serviceability.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ruttingDepthInches rdf:type rdf:Property ;
    rdfs:label 'Rutting Depth Inches' ;
    rdfs:comment 'Average depth of pavement rutting measured in inches, indicating surface deformation in wheel paths.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crackingPercent rdf:type rdf:Property ;
    rdfs:label 'Cracking Percent' ;
    rdfs:comment 'Percentage of pavement surface area exhibiting cracking distress.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastOverlayDate rdf:type rdf:Property ;
    rdfs:label 'Last Overlay Date' ;
    rdfs:comment 'Date when the most recent pavement overlay or resurfacing was completed on the segment.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastRehabilitationDate rdf:type rdf:Property ;
    rdfs:label 'Last Rehabilitation Date' ;
    rdfs:comment 'Date when the most recent major pavement rehabilitation work was completed on the segment.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shoulderTypeRight rdf:type rdf:Property ;
    rdfs:label 'Shoulder Type Right' ;
    rdfs:comment 'Type of shoulder material on the right side of the traveled way in the direction of inventory.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shoulderWidthRightFeet rdf:type rdf:Property ;
    rdfs:label 'Shoulder Width Right Feet' ;
    rdfs:comment 'Width of the right shoulder measured in feet from the edge of traveled way.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shoulderTypeLeft rdf:type rdf:Property ;
    rdfs:label 'Shoulder Type Left' ;
    rdfs:comment 'Type of shoulder material on the left side of the traveled way in the direction of inventory.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shoulderWidthLeftFeet rdf:type rdf:Property ;
    rdfs:label 'Shoulder Width Left Feet' ;
    rdfs:comment 'Width of the left shoulder measured in feet from the edge of traveled way.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laneWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Lane Width Feet' ;
    rdfs:comment 'Width of a typical through lane on the segment measured in feet.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aadtSingleUnitTrucks rdf:type rdf:Property ;
    rdfs:label 'Aadt Single Unit Trucks' ;
    rdfs:comment 'Annual average daily traffic count for single-unit trucks (typically 2-axle, 6-tire vehicles or larger single-frame trucks).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aadtCombinationTrucks rdf:type rdf:Property ;
    rdfs:label 'Aadt Combination Trucks' ;
    rdfs:comment 'Annual average daily traffic count for combination trucks (tractor-trailer units with 5 or more axles).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:kFactor rdf:type rdf:Property ;
    rdfs:label 'K Factor' ;
    rdfs:comment 'Proportion of annual average daily traffic occurring during the peak hour, used for capacity and design analysis.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dFactor rdf:type rdf:Property ;
    rdfs:label 'D Factor' ;
    rdfs:comment 'Directional distribution factor representing the percentage of peak hour traffic traveling in the peak direction.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakParkingIndicator rdf:type rdf:Property ;
    rdfs:label 'Peak Parking Indicator' ;
    rdfs:comment 'Flag indicating whether parking is allowed on the segment during peak traffic hours.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signalType rdf:type rdf:Property ;
    rdfs:label 'Signal Type' ;
    rdfs:comment 'Type of traffic signal control present on the segment, if any (e.g., No Signal, Fixed Time, Actuated, Adaptive).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tollIndicator rdf:type rdf:Property ;
    rdfs:label 'Toll Indicator' ;
    rdfs:comment 'Flag indicating whether the segment is a toll facility requiring payment for use.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tollType rdf:type rdf:Property ;
    rdfs:label 'Toll Type' ;
    rdfs:comment 'Type of toll collection system used on the segment if it is a toll facility.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hovType rdf:type rdf:Property ;
    rdfs:label 'Hov Type' ;
    rdfs:comment 'Type of high-occupancy vehicle facility or restriction on the segment, if applicable (e.g., HOV 2+, HOV 3+, HOT Lane).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpoCode rdf:type rdf:Property ;
    rdfs:label 'Mpo Code' ;
    rdfs:comment 'Code for the Metropolitan Planning Organization with jurisdiction over the segment, if located within an MPO boundary.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpoCode rdf:type rdf:Property ;
    rdfs:label 'Rpo Code' ;
    rdfs:comment 'Code for the Rural Planning Organization with jurisdiction over the segment, if located within an RPO boundary.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseType rdf:type rdf:Property ;
    rdfs:label 'Base Type' ;
    rdfs:comment 'Type of base material used in the pavement structure beneath the surface layer.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseThicknessInches rdf:type rdf:Property ;
    rdfs:label 'Base Thickness Inches' ;
    rdfs:comment 'Thickness of the base layer in the pavement structure measured in inches.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surfaceThicknessInches rdf:type rdf:Property ;
    rdfs:label 'Surface Thickness Inches' ;
    rdfs:comment 'Thickness of the surface pavement layer measured in inches.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drainageRating rdf:type rdf:Property ;
    rdfs:label 'Drainage Rating' ;
    rdfs:comment 'Qualitative rating of the drainage system effectiveness for the segment.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barrierType rdf:type rdf:Property ;
    rdfs:label 'Barrier Type' ;
    rdfs:comment 'Type of roadside barrier or median barrier installed on the segment for safety purposes.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rumbleStripIndicator rdf:type rdf:Property ;
    rdfs:label 'Rumble Strip Indicator' ;
    rdfs:comment 'Flag indicating whether rumble strips are installed on the segment for driver alertness.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bikeLaneIndicator rdf:type rdf:Property ;
    rdfs:label 'Bike Lane Indicator' ;
    rdfs:comment 'Flag indicating whether dedicated bicycle lanes are present on the segment.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sidewalkIndicator rdf:type rdf:Property ;
    rdfs:label 'Sidewalk Indicator' ;
    rdfs:comment 'Flag indicating whether sidewalks are present along the segment.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adaCompliantIndicator rdf:type rdf:Property ;
    rdfs:label 'Ada Compliant Indicator' ;
    rdfs:comment 'Flag indicating whether the segment meets ADA accessibility requirements for pedestrian facilities.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pavementWarrantyIndicator rdf:type rdf:Property ;
    rdfs:label 'Pavement Warranty Indicator' ;
    rdfs:comment 'Flag indicating whether the pavement on the segment is under a performance warranty from the contractor.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pavementWarrantyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Pavement Warranty Expiration Date' ;
    rdfs:comment 'Date when the pavement performance warranty expires, if applicable.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scenicBywayIndicator rdf:type rdf:Property ;
    rdfs:label 'Scenic Byway Indicator' ;
    rdfs:comment 'Flag indicating whether the segment is designated as a scenic byway.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyRouteIndicator rdf:type rdf:Property ;
    rdfs:label 'Emergency Route Indicator' ;
    rdfs:comment 'Flag indicating whether the segment is designated as an emergency evacuation or response route.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hurricaneEvacuationRoute rdf:type rdf:Property ;
    rdfs:label 'Hurricane Evacuation Route' ;
    rdfs:comment 'Flag indicating whether the segment is part of the designated hurricane evacuation route network.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itsEquippedIndicator rdf:type rdf:Property ;
    rdfs:label 'Its Equipped Indicator' ;
    rdfs:comment 'Flag indicating whether the segment is equipped with ITS infrastructure such as cameras, sensors, or dynamic message signs.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisCenterlineFeatureId rdf:type rdf:Property ;
    rdfs:label 'Gis Centerline Feature Id' ;
    rdfs:comment 'Unique identifier linking the segment to the GIS centerline feature in the spatial database.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feature .

ind:linearReferencingMethod rdf:type rdf:Property ;
    rdfs:label 'Linear Referencing Method' ;
    rdfs:comment 'Method used for linear referencing and location identification on the segment (e.g., Route-Milepoint, Link-Node).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:winterMaintenanceRoute rdf:type rdf:Property ;
    rdfs:label 'Winter Maintenance Route' ;
    rdfs:comment 'Classification of the segment for winter weather maintenance operations (snow and ice removal priority).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laneId rdf:type rdf:Property ;
    rdfs:label 'Lane Id' ;
    rdfs:comment 'Unique identifier for the lane within the highway system. Primary key for the lane entity.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Lane .

ind:widthFt rdf:type rdf:Property ;
    rdfs:label 'Width Ft' ;
    rdfs:comment 'The width of the lane measured in feet. Standard lane widths typically range from 10 to 12 feet.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageRestriction rdf:type rdf:Property ;
    rdfs:label 'Usage Restriction' ;
    rdfs:comment 'Specific restrictions or requirements for using this lane (e.g., HOV 2+, trucks only, no trucks, buses only, time-of-day restrictions).' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surfaceCondition rdf:type rdf:Property ;
    rdfs:label 'Surface Condition' ;
    rdfs:comment 'Current condition rating of the lane surface based on visual inspection and condition assessment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciScore rdf:type rdf:Property ;
    rdfs:label 'Pci Score' ;
    rdfs:comment 'Numerical rating of pavement condition on a scale of 0-100, where 100 represents excellent condition. Used for pavement management and maintenance prioritization.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ruttingDepthIn rdf:type rdf:Property ;
    rdfs:label 'Rutting Depth In' ;
    rdfs:comment 'Maximum depth of rutting (wheel path depressions) measured in inches. Indicator of pavement structural distress.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:markingType rdf:type rdf:Property ;
    rdfs:label 'Marking Type' ;
    rdfs:comment 'Type of pavement marking delineating the lane boundaries (solid white, dashed white, solid yellow, dashed yellow, double yellow, none).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:markingCondition rdf:type rdf:Property ;
    rdfs:label 'Marking Condition' ;
    rdfs:comment 'Current condition of the lane markings based on visibility and retroreflectivity assessment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:markingRetroreflectivity rdf:type rdf:Property ;
    rdfs:label 'Marking Retroreflectivity' ;
    rdfs:comment 'Measured retroreflectivity of lane markings in millicandelas per lux per square meter (mcd/lx/m²). Indicates nighttime visibility performance.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shoulderWidthLeftFt rdf:type rdf:Property ;
    rdfs:label 'Shoulder Width Left Ft' ;
    rdfs:comment 'Width of the left shoulder adjacent to this lane, measured in feet.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shoulderWidthRightFt rdf:type rdf:Property ;
    rdfs:label 'Shoulder Width Right Ft' ;
    rdfs:comment 'Width of the right shoulder adjacent to this lane, measured in feet.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medianWidthFt rdf:type rdf:Property ;
    rdfs:label 'Median Width Ft' ;
    rdfs:comment 'Width of the median measured in feet. Applicable for lanes adjacent to median.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:barrierOffsetFt rdf:type rdf:Property ;
    rdfs:label 'Barrier Offset Ft' ;
    rdfs:comment 'Distance from the edge of the lane to the nearest barrier, measured in feet.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:truckAadt rdf:type rdf:Property ;
    rdfs:label 'Truck Aadt' ;
    rdfs:comment 'The annual average daily traffic volume for trucks and heavy vehicles on this lane.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakHourVolume rdf:type rdf:Property ;
    rdfs:label 'Peak Hour Volume' ;
    rdfs:comment 'Maximum hourly traffic volume observed on this lane during peak periods.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:losRating rdf:type rdf:Property ;
    rdfs:label 'Los Rating' ;
    rdfs:comment 'Level of Service rating (A through F) indicating traffic flow quality and congestion level. A represents free flow, F represents forced flow/breakdown.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityVehiclesPerHour rdf:type rdf:Property ;
    rdfs:label 'Capacity Vehicles Per Hour' ;
    rdfs:comment 'Maximum number of vehicles that can pass through this lane per hour under prevailing conditions.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hovMinimumOccupancy rdf:type rdf:Property ;
    rdfs:label 'Hov Minimum Occupancy' ;
    rdfs:comment 'Minimum number of occupants required for a vehicle to use this HOV lane (e.g., 2 for HOV 2+, 3 for HOV 3+). Null if not an HOV lane.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hovEnforcementHours rdf:type rdf:Property ;
    rdfs:label 'Hov Enforcement Hours' ;
    rdfs:comment 'Time periods during which HOV restrictions are enforced (e.g., 6:00 AM - 9:00 AM, 4:00 PM - 7:00 PM). Null if not an HOV lane.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tollFacilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Toll Facility Indicator' ;
    rdfs:comment 'Indicates whether this lane is part of a toll facility requiring payment for use.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tollRateStructure rdf:type rdf:Property ;
    rdfs:label 'Toll Rate Structure' ;
    rdfs:comment 'Type of toll rate structure applied to this lane (flat, distance-based, time-of-day, dynamic pricing, none).' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itsSensorType rdf:type rdf:Property ;
    rdfs:label 'Its Sensor Type' ;
    rdfs:comment 'Type of ITS sensors deployed in this lane (e.g., loop detectors, radar, video detection, bluetooth, RFID).' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lightingCondition rdf:type rdf:Property ;
    rdfs:label 'Lighting Condition' ;
    rdfs:comment 'Current condition of roadway lighting infrastructure serving this lane.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossSlopePercent rdf:type rdf:Property ;
    rdfs:label 'Cross Slope Percent' ;
    rdfs:comment 'Transverse slope of the lane surface expressed as a percentage. Critical for drainage and safety.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curveRadiusFt rdf:type rdf:Property ;
    rdfs:label 'Curve Radius Ft' ;
    rdfs:comment 'Radius of horizontal curvature in feet. Null for tangent (straight) sections.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:superelevationPercent rdf:type rdf:Property ;
    rdfs:label 'Superelevation Percent' ;
    rdfs:comment 'Banking of the roadway on horizontal curves expressed as a percentage. Used to counteract centrifugal force.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sightDistanceFt rdf:type rdf:Property ;
    rdfs:label 'Sight Distance Ft' ;
    rdfs:comment 'Available stopping sight distance for this lane measured in feet. Critical safety metric.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastResurfacingDate rdf:type rdf:Property ;
    rdfs:label 'Last Resurfacing Date' ;
    rdfs:comment 'Date of the most recent resurfacing or overlay work performed on this lane.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Maintenance Date' ;
    rdfs:comment 'Planned date for the next scheduled maintenance activity on this lane.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pavementAgeYears rdf:type rdf:Property ;
    rdfs:label 'Pavement Age Years' ;
    rdfs:comment 'Age of the current pavement surface in years since last major rehabilitation or reconstruction.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remainingServiceLifeYears rdf:type rdf:Property ;
    rdfs:label 'Remaining Service Life Years' ;
    rdfs:comment 'Estimated remaining service life of the pavement before major rehabilitation is required, expressed in years.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetValueDollars rdf:type rdf:Property ;
    rdfs:label 'Asset Value Dollars' ;
    rdfs:comment 'Estimated replacement value of this lane asset in dollars for asset management and financial reporting.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maintenanceDistrict rdf:type rdf:Property ;
    rdfs:label 'Maintenance District' ;
    rdfs:comment 'NCDOT maintenance district responsible for this lane (e.g., District 1, District 2, etc.).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beginLatitude rdf:type rdf:Property ;
    rdfs:label 'Begin Latitude' ;
    rdfs:comment 'Latitude coordinate of the beginning point of this lane in decimal degrees.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beginLongitude rdf:type rdf:Property ;
    rdfs:label 'Begin Longitude' ;
    rdfs:comment 'Longitude coordinate of the beginning point of this lane in decimal degrees.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closureStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closure Start Timestamp' ;
    rdfs:comment 'Date and time when the lane closure began.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closureEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closure End Timestamp' ;
    rdfs:comment 'Date and time when the lane closure is expected to end or actually ended.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:incidentFrequencyAnnual rdf:type rdf:Property ;
    rdfs:label 'Incident Frequency Annual' ;
    rdfs:comment 'Number of traffic incidents (crashes, breakdowns, etc.) occurring in this lane annually.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crashRatePerMillionVmt rdf:type rdf:Property ;
    rdfs:label 'Crash Rate Per Million Vmt' ;
    rdfs:comment 'Number of crashes per million vehicle miles traveled on this lane. Key safety performance metric.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stormwaterPermitId rdf:type rdf:Property ;
    rdfs:label 'Stormwater Permit Id' ;
    rdfs:comment 'Identifier for the stormwater management permit associated with this lane, if applicable.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Permit .

ind:noiseBarrierPresentIndicator rdf:type rdf:Property ;
    rdfs:label 'Noise Barrier Present Indicator' ;
    rdfs:comment 'Indicates whether noise barriers are present adjacent to this lane for noise mitigation.' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalAidEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Eligible Indicator' ;
    rdfs:comment 'Indicates whether this lane is eligible for federal aid funding programs.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Data Collection Date' ;
    rdfs:comment 'Date when the lane attribute data was collected or last updated.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pavementSectionId rdf:type rdf:Property ;
    rdfs:label 'Pavement Section Id' ;
    rdfs:comment 'Unique identifier for the pavement section within the highway system. Primary key for the pavement section master entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PavementSection .

ind:sectionLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Section Length Miles' ;
    rdfs:comment 'Total length of the pavement section measured in miles. Calculated as end_milepost minus begin_milepost.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surfaceTypeCode rdf:type rdf:Property ;
    rdfs:label 'Surface Type Code' ;
    rdfs:comment 'Code representing the pavement surface type. AC=Asphalt Concrete, PCC=Portland Cement Concrete, COMP=Composite, UNPAVED=Gravel or Dirt, BRICK=Brick or Block, OTHER=Other surface types.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surfaceTypeDescription rdf:type rdf:Property ;
    rdfs:label 'Surface Type Description' ;
    rdfs:comment 'Detailed description of the pavement surface type and composition, including specific materials and construction methods used.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementStructureType rdf:type rdf:Property ;
    rdfs:label 'Pavement Structure Type' ;
    rdfs:comment 'Classification of the pavement structural design. FLEXIBLE=asphalt layers on aggregate base, RIGID=concrete slab, COMPOSITE=asphalt overlay on concrete base.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designThicknessInches rdf:type rdf:Property ;
    rdfs:label 'Design Thickness Inches' ;
    rdfs:comment 'Total design thickness of the pavement structure measured in inches, including all layers from surface to subgrade.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surfaceCourseThicknessInches rdf:type rdf:Property ;
    rdfs:label 'Surface Course Thickness Inches' ;
    rdfs:comment 'Thickness of the surface course layer measured in inches. The wearing surface that provides skid resistance and smoothness.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseCourseThicknessInches rdf:type rdf:Property ;
    rdfs:label 'Base Course Thickness Inches' ;
    rdfs:comment 'Thickness of the base course layer measured in inches. Provides structural support and load distribution.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:functionalClassDescription rdf:type rdf:Property ;
    rdfs:label 'Functional Class Description' ;
    rdfs:comment 'Descriptive name of the functional classification (e.g., Interstate, Principal Arterial, Minor Collector, Local).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urbanRuralDesignation rdf:type rdf:Property ;
    rdfs:label 'Urban Rural Designation' ;
    rdfs:comment 'Classification of the pavement section location as urban, rural, or small urban area based on Census Bureau definitions and population density.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shoulderWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Shoulder Width Feet' ;
    rdfs:comment 'Average width of the paved or unpaved shoulder measured in feet. Provides emergency stopping area and lateral support for pavement structure.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esalDesignValue rdf:type rdf:Property ;
    rdfs:label 'Esal Design Value' ;
    rdfs:comment 'Design traffic loading expressed as cumulative 18,000-pound equivalent single axle loads over the pavement design life. Used for structural pavement design.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iriCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Iri Collection Date' ;
    rdfs:comment 'Date when the IRI measurement was collected using automated pavement condition survey equipment.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pciValue rdf:type rdf:Property ;
    rdfs:label 'Pci Value' ;
    rdfs:comment 'Pavement Condition Index rating on a scale of 0 to 100, where 100 represents excellent condition and 0 represents failed pavement. Composite measure based on distress type, severity, and extent.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pciCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Pci Collection Date' ;
    rdfs:comment 'Date when the PCI rating was determined through visual distress survey or automated assessment.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:crackingSeverity rdf:type rdf:Property ;
    rdfs:label 'Cracking Severity' ;
    rdfs:comment 'Overall severity rating of pavement cracking distresses including alligator cracking, longitudinal cracking, and transverse cracking. Ranges from NONE to SEVERE.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alligatorCrackingPercent rdf:type rdf:Property ;
    rdfs:label 'Alligator Cracking Percent' ;
    rdfs:comment 'Percentage of pavement section area affected by alligator (fatigue) cracking. Interconnected cracks forming a pattern resembling alligator skin, indicating structural failure.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longitudinalCrackingFeet rdf:type rdf:Property ;
    rdfs:label 'Longitudinal Cracking Feet' ;
    rdfs:comment 'Total linear feet of longitudinal cracking parallel to the pavement centerline. Often occurs along construction joints or wheel paths.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transverseCrackingCount rdf:type rdf:Property ;
    rdfs:label 'Transverse Cracking Count' ;
    rdfs:comment 'Number of transverse cracks perpendicular to the pavement centerline. Often caused by thermal contraction or reflection from underlying layers.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patchingPercent rdf:type rdf:Property ;
    rdfs:label 'Patching Percent' ;
    rdfs:comment 'Percentage of pavement section area that has been patched or repaired. Indicates previous maintenance activity and potential for future deterioration.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faultingInches rdf:type rdf:Property ;
    rdfs:label 'Faulting Inches' ;
    rdfs:comment 'Difference in elevation across concrete pavement joints measured in inches. Applicable to rigid pavements only. Caused by pumping and erosion of base materials.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallConditionRating rdf:type rdf:Property ;
    rdfs:label 'Overall Condition Rating' ;
    rdfs:comment 'Composite overall condition rating of the pavement section based on multiple distress indicators and performance measures. Used for prioritization and decision-making.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentPriorityRank rdf:type rdf:Property ;
    rdfs:label 'Treatment Priority Rank' ;
    rdfs:comment 'Numerical ranking of this pavement section for treatment priority within the network. Lower numbers indicate higher priority for maintenance or rehabilitation.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendedTreatmentType rdf:type rdf:Property ;
    rdfs:label 'Recommended Treatment Type' ;
    rdfs:comment 'Type of pavement treatment recommended based on current condition and deterioration modeling. Categories align with NCDOT pavement preservation strategies.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedTreatmentYear rdf:type rdf:Property ;
    rdfs:label 'Recommended Treatment Year' ;
    rdfs:comment 'Fiscal year when the recommended pavement treatment should be performed based on condition forecasting and budget optimization.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedTreatmentCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Treatment Cost' ;
    rdfs:comment 'Estimated cost in US dollars to perform the recommended pavement treatment. Based on unit costs and section characteristics.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:designLifeYears rdf:type rdf:Property ;
    rdfs:label 'Design Life Years' ;
    rdfs:comment 'Expected design life of the pavement structure in years. Typically 20 years for flexible pavements and 30-40 years for rigid pavements.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:climateZone rdf:type rdf:Property ;
    rdfs:label 'Climate Zone' ;
    rdfs:comment 'North Carolina climate zone classification for the pavement section location. Affects pavement design parameters and deterioration rates. COASTAL=eastern coastal plain, PIEDMONT=central region, MOUNTAIN=western mountains.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frostPenetrationDepthInches rdf:type rdf:Property ;
    rdfs:label 'Frost Penetration Depth Inches' ;
    rdfs:comment 'Expected depth of frost penetration into the pavement structure and subgrade measured in inches. Critical for pavement design in freeze-thaw climates.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subgradeType rdf:type rdf:Property ;
    rdfs:label 'Subgrade Type' ;
    rdfs:comment 'Classification of the subgrade soil type underlying the pavement structure. Affects bearing capacity and pavement design requirements.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subgradeResilientModulusPsi rdf:type rdf:Property ;
    rdfs:label 'Subgrade Resilient Modulus Psi' ;
    rdfs:comment 'Resilient modulus of the subgrade soil measured in pounds per square inch. Represents the elastic stiffness of the subgrade under repeated loading. Key input for mechanistic pavement design.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:structuralNumber rdf:type rdf:Property ;
    rdfs:label 'Structural Number' ;
    rdfs:comment 'AASHTO Structural Number representing the overall structural capacity of the pavement. Calculated from layer thicknesses and material coefficients. Higher values indicate stronger pavement structure.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadTransferEfficiencyPercent rdf:type rdf:Property ;
    rdfs:label 'Load Transfer Efficiency Percent' ;
    rdfs:comment 'Percentage of load transferred across joints or cracks in rigid pavements. Measured using deflection testing. Higher values indicate better load transfer and structural performance.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deflectionBasinArea rdf:type rdf:Property ;
    rdfs:label 'Deflection Basin Area' ;
    rdfs:comment 'Area under the deflection basin curve measured during Falling Weight Deflectometer testing. Indicates overall pavement structural capacity and remaining life.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frictionNumber rdf:type rdf:Property ;
    rdfs:label 'Friction Number' ;
    rdfs:comment 'Skid resistance measurement representing the friction between vehicle tires and pavement surface. Critical for safety. Measured using standardized friction testing equipment.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frictionTestDate rdf:type rdf:Property ;
    rdfs:label 'Friction Test Date' ;
    rdfs:comment 'Date when the most recent pavement friction testing was performed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:textureDepthMm rdf:type rdf:Property ;
    rdfs:label 'Texture Depth Mm' ;
    rdfs:comment 'Mean texture depth of the pavement surface measured in millimeters. Affects skid resistance, noise, and splash/spray. Measured using sand patch or laser methods.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permeabilityRating rdf:type rdf:Property ;
    rdfs:label 'Permeability Rating' ;
    rdfs:comment 'Rating of pavement surface permeability to water infiltration. Affects durability and moisture-related distresses. Permeable pavements allow water to drain through the surface.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionCost rdf:type rdf:Property ;
    rdfs:label 'Construction Cost' ;
    rdfs:comment 'Actual construction cost in US dollars for building or rehabilitating this pavement section. Includes materials, labor, and equipment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalAidProgram rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Program' ;
    rdfs:comment 'Specific federal aid program providing funding for this pavement section (e.g., NHPP, STP, HSIP, CMAQ). Applicable only for federally funded projects.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipProjectIndicator rdf:type rdf:Property ;
    rdfs:label 'Stip Project Indicator' ;
    rdfs:comment 'Flag indicating whether this pavement section is part of a project included in the North Carolina State Transportation Improvement Program.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hpmsSampleIndicator rdf:type rdf:Property ;
    rdfs:label 'Hpms Sample Indicator' ;
    rdfs:comment 'Flag indicating whether this pavement section is part of the HPMS sample for federal reporting. HPMS sample sections require more detailed data collection and reporting.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisLatitude rdf:type rdf:Property ;
    rdfs:label 'Gis Latitude' ;
    rdfs:comment 'Latitude coordinate of the pavement section midpoint in decimal degrees. Used for spatial analysis and mapping.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gisLongitude rdf:type rdf:Property ;
    rdfs:label 'Gis Longitude' ;
    rdfs:comment 'Longitude coordinate of the pavement section midpoint in decimal degrees. Used for spatial analysis and mapping.' ;
    rdfs:domain ind:PavementSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flightScheduleId rdf:type rdf:Property ;
    rdfs:label 'Flight Schedule Id' ;
    rdfs:comment 'Unique identifier for the flight schedule record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FlightSchedule .

ind:flightNumber rdf:type rdf:Property ;
    rdfs:label 'Flight Number' ;
    rdfs:comment 'Airline-assigned flight number identifying the scheduled flight service.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airlineName rdf:type rdf:Property ;
    rdfs:label 'Airline Name' ;
    rdfs:comment 'Full legal name of the airline operating the flight.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airportName rdf:type rdf:Property ;
    rdfs:label 'Airport Name' ;
    rdfs:comment 'Full official name of the NCDOT-managed airport facility.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flightType rdf:type rdf:Property ;
    rdfs:label 'Flight Type' ;
    rdfs:comment 'Indicates whether this schedule entry represents an arriving or departing flight.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDepartureTime rdf:type rdf:Property ;
    rdfs:label 'Estimated Departure Time' ;
    rdfs:comment 'Current estimated departure time based on operational conditions.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualArrivalTime rdf:type rdf:Property ;
    rdfs:label 'Actual Arrival Time' ;
    rdfs:comment 'Actual recorded time when the aircraft arrived at the gate or parking position.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gateNumber rdf:type rdf:Property ;
    rdfs:label 'Gate Number' ;
    rdfs:comment 'Airport gate assignment for passenger boarding or deplaning.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminal rdf:type rdf:Property ;
    rdfs:label 'Terminal' ;
    rdfs:comment 'Airport terminal building where the flight operates.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aircraftType rdf:type rdf:Property ;
    rdfs:label 'Aircraft Type' ;
    rdfs:comment 'ICAO aircraft type designator for the aircraft operating the flight.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aircraftRegistration rdf:type rdf:Property ;
    rdfs:label 'Aircraft Registration' ;
    rdfs:comment 'FAA registration number (tail number) of the specific aircraft assigned to the flight.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originAirportName rdf:type rdf:Property ;
    rdfs:label 'Origin Airport Name' ;
    rdfs:comment 'Full name of the airport where the flight originates.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationAirportName rdf:type rdf:Property ;
    rdfs:label 'Destination Airport Name' ;
    rdfs:comment 'Full name of the airport where the flight is destined.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flightStatus rdf:type rdf:Property ;
    rdfs:label 'Flight Status' ;
    rdfs:comment 'Current operational status of the scheduled flight.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delayCode rdf:type rdf:Property ;
    rdfs:label 'Delay Code' ;
    rdfs:comment 'IATA delay code indicating the reason for flight delay if applicable.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delayReason rdf:type rdf:Property ;
    rdfs:label 'Delay Reason' ;
    rdfs:comment 'Detailed description of the reason for flight delay.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Code' ;
    rdfs:comment 'Code indicating the reason for flight cancellation if applicable.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baggageClaim rdf:type rdf:Property ;
    rdfs:label 'Baggage Claim' ;
    rdfs:comment 'Baggage claim carousel or area assignment for arriving passengers.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkInCounter rdf:type rdf:Property ;
    rdfs:label 'Check In Counter' ;
    rdfs:comment 'Check-in counter or desk assignment for departing passengers.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardingTime rdf:type rdf:Property ;
    rdfs:label 'Boarding Time' ;
    rdfs:comment 'Scheduled time when passenger boarding begins.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:boardingStatus rdf:type rdf:Property ;
    rdfs:label 'Boarding Status' ;
    rdfs:comment 'Current status of the passenger boarding process.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeshareIndicator rdf:type rdf:Property ;
    rdfs:label 'Codeshare Indicator' ;
    rdfs:comment 'Indicates whether the flight is operated under a codeshare agreement.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:codeshareAirlineCodes rdf:type rdf:Property ;
    rdfs:label 'Codeshare Airline Codes' ;
    rdfs:comment 'Comma-separated list of airline codes participating in the codeshare agreement.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingAirlineName rdf:type rdf:Property ;
    rdfs:label 'Operating Airline Name' ;
    rdfs:comment 'Full name of the airline actually operating the flight.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flightDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Flight Duration Minutes' ;
    rdfs:comment 'Scheduled flight time from departure to arrival in minutes.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:route rdf:type rdf:Property ;
    rdfs:label 'Route' ;
    rdfs:comment 'Planned flight route including waypoints and airways.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:altitudeFeet rdf:type rdf:Property ;
    rdfs:label 'Altitude Feet' ;
    rdfs:comment 'Planned cruising altitude for the flight in feet above sea level.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runwayAssignment rdf:type rdf:Property ;
    rdfs:label 'Runway Assignment' ;
    rdfs:comment 'Assigned runway for takeoff or landing.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parkingPosition rdf:type rdf:Property ;
    rdfs:label 'Parking Position' ;
    rdfs:comment 'Assigned aircraft parking position or stand on the airport apron.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalIndicator rdf:type rdf:Property ;
    rdfs:label 'International Indicator' ;
    rdfs:comment 'Indicates whether the flight crosses international borders requiring customs and immigration.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customsRequired rdf:type rdf:Property ;
    rdfs:label 'Customs Required' ;
    rdfs:comment 'Indicates whether customs processing is required for this flight.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysOfOperation rdf:type rdf:Property ;
    rdfs:label 'Days Of Operation' ;
    rdfs:comment 'Days of the week on which the flight operates (e.g., 1234567 for daily, 15 for Monday and Friday).' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slotTime rdf:type rdf:Property ;
    rdfs:label 'Slot Time' ;
    rdfs:comment 'Allocated airport slot time for takeoff or landing at slot-controlled airports.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:onTimePerformanceIndicator rdf:type rdf:Property ;
    rdfs:label 'On Time Performance Indicator' ;
    rdfs:comment 'Indicator of whether the flight operated within on-time performance thresholds.' ;
    rdfs:domain ind:FlightSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadwayClassificationId rdf:type rdf:Property ;
    rdfs:label 'Roadway Classification Id' ;
    rdfs:comment 'Unique identifier for the roadway functional classification record. Primary key for the roadway classification reference table.' ;
    rdfs:domain ind:Highway ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RoadwayClassification .

ind:functionalClassName rdf:type rdf:Property ;
    rdfs:label 'Functional Class Name' ;
    rdfs:comment 'Full descriptive name of the functional classification (e.g., Interstate, Principal Arterial - Other Freeways and Expressways, Minor Arterial, Major Collector, Local).' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalClassAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Functional Class Abbreviation' ;
    rdfs:comment 'Standard abbreviated form of the functional classification name used in reporting and mapping (e.g., INT, PA, MA, MC, LOC).' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nhsEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Nhs Eligibility Flag' ;
    rdfs:comment 'Indicates whether roadways with this functional classification are eligible for inclusion in the National Highway System. NHS designation affects federal funding and reporting requirements.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hpmsReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Hpms Reporting Required Flag' ;
    rdfs:comment 'Indicates whether roadways with this functional classification must be reported in the annual HPMS submission to FHWA.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hpmsSamplePanelFlag rdf:type rdf:Property ;
    rdfs:label 'Hpms Sample Panel Flag' ;
    rdfs:comment 'Indicates whether roadways with this functional classification are included in the HPMS sample panel for detailed data collection.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:typicalAadtRangeMin rdf:type rdf:Property ;
    rdfs:label 'Typical Aadt Range Min' ;
    rdfs:comment 'Minimum typical Annual Average Daily Traffic volume expected for roadways in this functional classification. Used for planning and classification validation.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalAadtRangeMax rdf:type rdf:Property ;
    rdfs:label 'Typical Aadt Range Max' ;
    rdfs:comment 'Maximum typical Annual Average Daily Traffic volume expected for roadways in this functional classification. Used for planning and classification validation.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:designSpeedMinMph rdf:type rdf:Property ;
    rdfs:label 'Design Speed Min Mph' ;
    rdfs:comment 'Minimum design speed in miles per hour typically associated with this functional classification, based on AASHTO design standards.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:designSpeedMaxMph rdf:type rdf:Property ;
    rdfs:label 'Design Speed Max Mph' ;
    rdfs:comment 'Maximum design speed in miles per hour typically associated with this functional classification, based on AASHTO design standards.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accessControlType rdf:type rdf:Property ;
    rdfs:label 'Access Control Type' ;
    rdfs:comment 'Level of access control typically associated with this functional classification. Full access control means access only at interchanges; partial means limited access points; none means unrestricted access.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryFunctionDescription rdf:type rdf:Property ;
    rdfs:label 'Primary Function Description' ;
    rdfs:comment 'Detailed description of the primary transportation function served by roadways in this classification (e.g., long-distance travel, regional connectivity, local access).' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobilityEmphasisPercentage rdf:type rdf:Property ;
    rdfs:label 'Mobility Emphasis Percentage' ;
    rdfs:comment 'Percentage emphasis on mobility (movement of traffic) versus land access for this functional classification. Higher values indicate greater emphasis on mobility.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:landAccessEmphasisPercentage rdf:type rdf:Property ;
    rdfs:label 'Land Access Emphasis Percentage' ;
    rdfs:comment 'Percentage emphasis on land access versus mobility for this functional classification. Higher values indicate greater emphasis on providing access to adjacent properties.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalTripLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Typical Trip Length Miles' ;
    rdfs:comment 'Average trip length in miles for trips using roadways in this functional classification. Used for travel demand modeling and planning.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cmaqEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cmaq Eligible Flag' ;
    rdfs:comment 'Indicates whether roadways with this functional classification are eligible for Congestion Mitigation and Air Quality improvement program funding.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stpEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Stp Eligible Flag' ;
    rdfs:comment 'Indicates whether roadways with this functional classification are eligible for Surface Transportation Program funding.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pavementConditionMonitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Pavement Condition Monitoring Frequency' ;
    rdfs:comment 'Standard frequency for pavement condition monitoring and assessment for roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itsDeploymentPriority rdf:type rdf:Property ;
    rdfs:label 'Its Deployment Priority' ;
    rdfs:comment 'Priority level for deployment of Intelligent Transportation Systems infrastructure on roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficSignalWarrantApplicability rdf:type rdf:Property ;
    rdfs:label 'Traffic Signal Warrant Applicability' ;
    rdfs:comment 'Indicates whether MUTCD traffic signal warrants typically apply to intersections on roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalReviewLevel rdf:type rdf:Property ;
    rdfs:label 'Environmental Review Level' ;
    rdfs:comment 'Typical level of environmental review required under NEPA for projects on roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightOfWayTypicalWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Typical Width Feet' ;
    rdfs:comment 'Typical right-of-way width in feet for roadways in this functional classification, based on NCDOT design standards.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalLaneCount rdf:type rdf:Property ;
    rdfs:label 'Typical Lane Count' ;
    rdfs:comment 'Typical number of through lanes (both directions combined) for roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalLaneWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Typical Lane Width Feet' ;
    rdfs:comment 'Typical width of travel lanes in feet for roadways in this functional classification, per AASHTO design standards.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalShoulderWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Typical Shoulder Width Feet' ;
    rdfs:comment 'Typical shoulder width in feet for roadways in this functional classification, per AASHTO design standards.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bicycleAccommodationRequirement rdf:type rdf:Property ;
    rdfs:label 'Bicycle Accommodation Requirement' ;
    rdfs:comment 'Policy requirement for bicycle accommodation on roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pedestrianAccommodationRequirement rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Accommodation Requirement' ;
    rdfs:comment 'Policy requirement for pedestrian accommodation (sidewalks, crosswalks) on roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:truckRouteDesignationEligible rdf:type rdf:Property ;
    rdfs:label 'Truck Route Designation Eligible' ;
    rdfs:comment 'Indicates whether roadways in this functional classification are typically eligible for designation as truck routes.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oversizeOverweightPermitRouteEligible rdf:type rdf:Property ;
    rdfs:label 'Oversize Overweight Permit Route Eligible' ;
    rdfs:comment 'Indicates whether roadways in this functional classification are typically eligible for oversize/overweight permit routing.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postedSpeedLimitMinMph rdf:type rdf:Property ;
    rdfs:label 'Posted Speed Limit Min Mph' ;
    rdfs:comment 'Typical minimum posted speed limit in miles per hour for roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postedSpeedLimitMaxMph rdf:type rdf:Property ;
    rdfs:label 'Posted Speed Limit Max Mph' ;
    rdfs:comment 'Typical maximum posted speed limit in miles per hour for roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vmtContributionPercentage rdf:type rdf:Property ;
    rdfs:label 'Vmt Contribution Percentage' ;
    rdfs:comment 'Approximate percentage of statewide Vehicle Miles Traveled contributed by roadways in this functional classification. Used for system performance analysis.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:centerlineMilesPercentage rdf:type rdf:Property ;
    rdfs:label 'Centerline Miles Percentage' ;
    rdfs:comment 'Approximate percentage of total state highway system centerline miles represented by roadways in this functional classification.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:congestionMonitoringRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Congestion Monitoring Required Flag' ;
    rdfs:comment 'Indicates whether roadways in this functional classification are subject to federal congestion monitoring and reporting requirements.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pavementPerformanceTargetPci rdf:type rdf:Property ;
    rdfs:label 'Pavement Performance Target Pci' ;
    rdfs:comment 'Target Pavement Condition Index score for roadways in this functional classification, used for asset management and performance measurement.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyPerformanceMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Performance Monitoring Flag' ;
    rdfs:comment 'Indicates whether roadways in this functional classification are included in safety performance monitoring and Highway Safety Improvement Program analysis.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:activeStatus rdf:type rdf:Property ;
    rdfs:label 'Active Status' ;
    rdfs:comment 'Current status of this functional classification code in the reference table. Inactive or deprecated codes are retained for historical reporting.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhwaApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Fhwa Approval Date' ;
    rdfs:comment 'Date when this functional classification was approved by FHWA for use in federal reporting and funding programs.' ;
    rdfs:domain ind:RoadwayClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:navigationAidId rdf:type rdf:Property ;
    rdfs:label 'Navigation Aid Id' ;
    rdfs:comment 'Unique identifier for the navigation aid facility. Primary key for the navigation aid entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NavigationAid .

ind:facilityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Facility Identifier' ;
    rdfs:comment 'The official FAA-assigned identifier code for the navigation aid facility, typically 2-5 alphanumeric characters used in aeronautical charts and flight planning.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityName rdf:type rdf:Property ;
    rdfs:label 'Facility Name' ;
    rdfs:comment 'The official name of the navigation aid facility, typically named after the nearest city, airport, or geographic landmark.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityStatus rdf:type rdf:Property ;
    rdfs:label 'Facility Status' ;
    rdfs:comment 'Current operational status of the navigation aid facility indicating availability for use in air navigation.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'The TACAN or DME channel number used for distance measuring equipment, typically a 1-3 digit number optionally followed by X or Y designation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:morseCodeIdentifier rdf:type rdf:Property ;
    rdfs:label 'Morse Code Identifier' ;
    rdfs:comment 'The 1-4 character Morse code identifier transmitted by the navigation aid for positive identification by pilots, typically matching the facility identifier.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elevationFeet rdf:type rdf:Property ;
    rdfs:label 'Elevation Feet' ;
    rdfs:comment 'The elevation of the navigation aid antenna above mean sea level (MSL) measured in feet.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:magneticVariation rdf:type rdf:Property ;
    rdfs:label 'Magnetic Variation' ;
    rdfs:comment 'The magnetic variation (declination) at the navigation aid location in degrees, representing the angular difference between true north and magnetic north. Positive values indicate easterly variation, negative indicate westerly.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceVolumeClass rdf:type rdf:Property ;
    rdfs:label 'Service Volume Class' ;
    rdfs:comment 'The FAA-designated service volume class indicating the intended operational range and altitude coverage of the navigation aid (e.g., Terminal for airport vicinity, Low Altitude up to 18,000 feet, High Altitude above 18,000 feet).' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceRangeNauticalMiles rdf:type rdf:Property ;
    rdfs:label 'Service Range Nautical Miles' ;
    rdfs:comment 'The maximum operational range of the navigation aid in nautical miles within which reliable signal reception is expected under normal conditions.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:powerOutputWatts rdf:type rdf:Property ;
    rdfs:label 'Power Output Watts' ;
    rdfs:comment 'The radio frequency power output of the navigation aid transmitter measured in watts.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:associatedAirportCode rdf:type rdf:Property ;
    rdfs:label 'Associated Airport Code' ;
    rdfs:comment 'The ICAO or FAA location identifier of the airport with which this navigation aid is primarily associated, if applicable.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associatedRunway rdf:type rdf:Property ;
    rdfs:label 'Associated Runway' ;
    rdfs:comment 'The runway designation (e.g., 18L, 27, 09R) that this navigation aid serves, particularly relevant for ILS, localizer, and approach lighting systems.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningDate rdf:type rdf:Property ;
    rdfs:label 'Commissioning Date' ;
    rdfs:comment 'The date when the navigation aid facility was officially commissioned and placed into operational service.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decommissioningDate rdf:type rdf:Property ;
    rdfs:label 'Decommissioning Date' ;
    rdfs:comment 'The date when the navigation aid facility was officially decommissioned and removed from operational service, if applicable.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Inspection Date' ;
    rdfs:comment 'The date when the next scheduled inspection of the navigation aid facility is planned.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedServiceLifeYears rdf:type rdf:Property ;
    rdfs:label 'Expected Service Life Years' ;
    rdfs:comment 'The expected operational service life of the navigation aid equipment measured in years from installation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:replacementCostAmount rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Amount' ;
    rdfs:comment 'The estimated cost in US dollars to replace the navigation aid equipment with equivalent new equipment.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faaFacilityNumber rdf:type rdf:Property ;
    rdfs:label 'Faa Facility Number' ;
    rdfs:comment 'The unique facility number assigned by the FAA for administrative and tracking purposes in the National Flight Data Center database.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notamAccountabilityCode rdf:type rdf:Property ;
    rdfs:label 'Notam Accountability Code' ;
    rdfs:comment 'The code used to identify this navigation aid in NOTAM (Notice to Airmen) publications when reporting status changes or outages.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringCategory rdf:type rdf:Property ;
    rdfs:label 'Monitoring Category' ;
    rdfs:comment 'The FAA-designated monitoring category indicating the level of automated monitoring and alarm capability for the navigation aid facility.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backupPowerAvailable rdf:type rdf:Property ;
    rdfs:label 'Backup Power Available' ;
    rdfs:comment 'Indicates whether the navigation aid facility has backup power capability (generator or battery) to maintain operations during primary power outages.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backupPowerDurationHours rdf:type rdf:Property ;
    rdfs:label 'Backup Power Duration Hours' ;
    rdfs:comment 'The number of hours the navigation aid can operate on backup power before requiring refueling or recharging.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remoteMonitoringEnabled rdf:type rdf:Property ;
    rdfs:label 'Remote Monitoring Enabled' ;
    rdfs:comment 'Indicates whether the navigation aid facility is equipped with remote monitoring capability allowing real-time status monitoring from a central facility.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siteAddress rdf:type rdf:Property ;
    rdfs:label 'Site Address' ;
    rdfs:comment 'The physical street address or location description of the navigation aid facility site.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteCity rdf:type rdf:Property ;
    rdfs:label 'Site City' ;
    rdfs:comment 'The city or municipality where the navigation aid facility is located.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteCounty rdf:type rdf:Property ;
    rdfs:label 'Site County' ;
    rdfs:comment 'The county in North Carolina where the navigation aid facility is located.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteState rdf:type rdf:Property ;
    rdfs:label 'Site State' ;
    rdfs:comment 'The two-letter state code where the navigation aid facility is located (typically NC for North Carolina).' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteZipCode rdf:type rdf:Property ;
    rdfs:label 'Site Zip Code' ;
    rdfs:comment 'The US Postal Service ZIP code for the navigation aid facility location.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:artccCode rdf:type rdf:Property ;
    rdfs:label 'Artcc Code' ;
    rdfs:comment 'The three-letter code identifying the Air Route Traffic Control Center responsible for the airspace where this navigation aid operates.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approachProcedurePublished rdf:type rdf:Property ;
    rdfs:label 'Approach Procedure Published' ;
    rdfs:comment 'Indicates whether there is a published instrument approach procedure that utilizes this navigation aid.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chartSupplementPage rdf:type rdf:Property ;
    rdfs:label 'Chart Supplement Page' ;
    rdfs:comment 'The page reference in the FAA Chart Supplement (formerly Airport/Facility Directory) where this navigation aid is documented.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Environmental Assessment Date' ;
    rdfs:comment 'The date when the most recent environmental assessment or environmental impact statement was completed for the navigation aid facility in compliance with NEPA requirements.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:historicalPreservationStatus rdf:type rdf:Property ;
    rdfs:label 'Historical Preservation Status' ;
    rdfs:comment 'The status of Section 106 historical preservation review for the navigation aid facility site.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cybersecurityAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Cybersecurity Assessment Date' ;
    rdfs:comment 'The date of the most recent cybersecurity assessment or audit of the navigation aid facility systems and controls.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cybersecurityRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Cybersecurity Risk Level' ;
    rdfs:comment 'The assessed cybersecurity risk level for the navigation aid facility based on NIST framework evaluation.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Record Effective Date' ;
    rdfs:comment 'The date from which this navigation aid record information is considered effective and accurate.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Record Expiration Date' ;
    rdfs:comment 'The date after which this navigation aid record information is no longer considered current, used for historical tracking.' ;
    rdfs:domain ind:NavigationAid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trafficCountId rdf:type rdf:Property ;
    rdfs:label 'Traffic Count Id' ;
    rdfs:comment 'Unique identifier for the traffic count record.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stationName rdf:type rdf:Property ;
    rdfs:label 'Station Name' ;
    rdfs:comment 'Descriptive name of the traffic counting station location.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countDate rdf:type rdf:Property ;
    rdfs:label 'Count Date' ;
    rdfs:comment 'Date when the traffic count was collected.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:countTimestamp rdf:type rdf:Property ;
    rdfs:label 'Count Timestamp' ;
    rdfs:comment 'Precise timestamp when the traffic count was recorded.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:countYear rdf:type rdf:Property ;
    rdfs:label 'Count Year' ;
    rdfs:comment 'Year in which the traffic count was collected.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:countPeriod rdf:type rdf:Property ;
    rdfs:label 'Count Period' ;
    rdfs:comment 'Time period over which the traffic count was aggregated.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countDurationHours rdf:type rdf:Property ;
    rdfs:label 'Count Duration Hours' ;
    rdfs:comment 'Duration in hours over which the traffic count was collected.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:countType rdf:type rdf:Property ;
    rdfs:label 'Count Type' ;
    rdfs:comment 'Type of traffic count collection method (continuous, short-duration, coverage, or special).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countMethod rdf:type rdf:Property ;
    rdfs:label 'Count Method' ;
    rdfs:comment 'Method or technology used to collect the traffic count data.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalVolume rdf:type rdf:Property ;
    rdfs:label 'Total Volume' ;
    rdfs:comment 'Total number of vehicles counted during the count period.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adt rdf:type rdf:Property ;
    rdfs:label 'Adt' ;
    rdfs:comment 'Average Daily Traffic - the average number of vehicles passing a point during a specific time period (less than one year).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakHourTime rdf:type rdf:Property ;
    rdfs:label 'Peak Hour Time' ;
    rdfs:comment 'Time of day when the peak hour volume occurred.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleClass1Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 1 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 1 (motorcycles).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass2Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 2 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 2 (passenger cars).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass3Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 3 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 3 (other two-axle, four-tire vehicles including pickups, vans, SUVs).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass4Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 4 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 4 (buses).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass5Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 5 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 5 (two-axle, six-tire, single-unit trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass6Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 6 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 6 (three-axle single-unit trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass7Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 7 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 7 (four or more axle single-unit trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass8Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 8 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 8 (four or less axle single-trailer trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass9Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 9 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 9 (five-axle single-trailer trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass10Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 10 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 10 (six or more axle single-trailer trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass11Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 11 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 11 (five or less axle multi-trailer trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass12Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 12 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 12 (six-axle multi-trailer trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClass13Count rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class 13 Count' ;
    rdfs:comment 'Count of FHWA vehicle classification Class 13 (seven or more axle multi-trailer trucks).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passengerVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Passenger Vehicle Count' ;
    rdfs:comment 'Total count of passenger vehicles (Classes 1-3).' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageSpeed rdf:type rdf:Property ;
    rdfs:label 'Average Speed' ;
    rdfs:comment 'Average vehicle speed in miles per hour during the count period.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:85thPercentileSpeed rdf:type rdf:Property ;
    rdfs:label '85th Percentile Speed' ;
    rdfs:comment 'Speed at or below which 85 percent of vehicles are traveling.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seasonalFactor rdf:type rdf:Property ;
    rdfs:label 'Seasonal Factor' ;
    rdfs:comment 'Adjustment factor used to convert short-duration counts to annual estimates.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:axleCorrectionFactor rdf:type rdf:Property ;
    rdfs:label 'Axle Correction Factor' ;
    rdfs:comment 'Factor used to convert axle counts to vehicle counts.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weekdayWeekendIndicator rdf:type rdf:Property ;
    rdfs:label 'Weekday Weekend Indicator' ;
    rdfs:comment 'Indicates whether the count was collected on a weekday or weekend.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionActivityIndicator rdf:type rdf:Property ;
    rdfs:label 'Construction Activity Indicator' ;
    rdfs:comment 'Indicates whether construction activity was present during the count period that may have affected traffic volumes.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataQualityCode rdf:type rdf:Property ;
    rdfs:label 'Data Quality Code' ;
    rdfs:comment 'Assessment of the quality and reliability of the traffic count data.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Status of data validation and quality assurance review.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date when the traffic count data was validated.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validatorName rdf:type rdf:Property ;
    rdfs:label 'Validator Name' ;
    rdfs:comment 'Name of the person or system that validated the traffic count data.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionAgency rdf:type rdf:Property ;
    rdfs:label 'Collection Agency' ;
    rdfs:comment 'Agency or organization responsible for collecting the traffic count data.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentType rdf:type rdf:Property ;
    rdfs:label 'Equipment Type' ;
    rdfs:comment 'Type or model of traffic counting equipment used.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hpmsSubmissionYear rdf:type rdf:Property ;
    rdfs:label 'Hpms Submission Year' ;
    rdfs:comment 'Year in which this traffic count data was submitted to FHWA HPMS.' ;
    rdfs:domain ind:TrafficCount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceRequestId rdf:type rdf:Property ;
    rdfs:label 'Service Request Id' ;
    rdfs:comment 'Unique identifier for the service request submitted by the public or internal stakeholders.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceRequest .

ind:requestSubtype rdf:type rdf:Property ;
    rdfs:label 'Request Subtype' ;
    rdfs:comment 'Detailed subcategory providing additional classification granularity for the service request type.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submitted Timestamp' ;
    rdfs:comment 'Precise timestamp when the service request was submitted into the system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:acknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Timestamp' ;
    rdfs:comment 'Timestamp when the service request was acknowledged by NCDOT staff.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assigned Timestamp' ;
    rdfs:comment 'Timestamp when the service request was assigned to a maintenance crew or contractor.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inProgressTimestamp rdf:type rdf:Property ;
    rdfs:label 'In Progress Timestamp' ;
    rdfs:comment 'Timestamp when work on the service request was initiated by the assigned crew.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completed Timestamp' ;
    rdfs:comment 'Timestamp when the service request work was completed and verified.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closed Timestamp' ;
    rdfs:comment 'Timestamp when the service request was officially closed in the system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:targetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Target Completion Date' ;
    rdfs:comment 'Planned date by which the service request should be completed based on priority and resource availability.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinateAccuracy rdf:type rdf:Property ;
    rdfs:label 'Coordinate Accuracy' ;
    rdfs:comment 'Accuracy level of the geographic coordinates provided for the service request location.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:address rdf:type rdf:Property ;
    rdfs:label 'Address' ;
    rdfs:comment 'Street address nearest to the service request location.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossStreet rdf:type rdf:Property ;
    rdfs:label 'Cross Street' ;
    rdfs:comment 'Nearest cross street or intersection to help identify the service request location.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requesterType rdf:type rdf:Property ;
    rdfs:label 'Requester Type' ;
    rdfs:comment 'Type or category of the individual or entity submitting the service request.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requesterName rdf:type rdf:Property ;
    rdfs:label 'Requester Name' ;
    rdfs:comment 'Full name of the individual submitting the service request.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requesterEmail rdf:type rdf:Property ;
    rdfs:label 'Requester Email' ;
    rdfs:comment 'Email address of the requester for communication and status updates.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requesterPhone rdf:type rdf:Property ;
    rdfs:label 'Requester Phone' ;
    rdfs:comment 'Contact phone number of the requester for follow-up communication.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requesterAddress rdf:type rdf:Property ;
    rdfs:label 'Requester Address' ;
    rdfs:comment 'Mailing address of the requester if provided for correspondence.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPreference rdf:type rdf:Property ;
    rdfs:label 'Contact Preference' ;
    rdfs:comment 'Preferred method of communication for status updates as indicated by the requester.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionChannel rdf:type rdf:Property ;
    rdfs:label 'Submission Channel' ;
    rdfs:comment 'Channel or method through which the service request was submitted.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedCrewId rdf:type rdf:Property ;
    rdfs:label 'Assigned Crew Id' ;
    rdfs:comment 'Identifier for the maintenance crew assigned to resolve the service request.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:resolutionCode rdf:type rdf:Property ;
    rdfs:label 'Resolution Code' ;
    rdfs:comment 'Standardized code indicating the outcome or resolution of the service request.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laborHours rdf:type rdf:Property ;
    rdfs:label 'Labor Hours' ;
    rdfs:comment 'Total labor hours expended to complete the service request work.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyImpact rdf:type rdf:Property ;
    rdfs:label 'Safety Impact' ;
    rdfs:comment 'Assessment of the safety impact or hazard level posed by the reported issue.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficImpact rdf:type rdf:Property ;
    rdfs:label 'Traffic Impact' ;
    rdfs:comment 'Type of traffic impact or disruption caused by the issue or the repair work.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoUrl rdf:type rdf:Property ;
    rdfs:label 'Photo Url' ;
    rdfs:comment 'URL or file path to photo documentation of the issue submitted by the requester.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoCount rdf:type rdf:Property ;
    rdfs:label 'Photo Count' ;
    rdfs:comment 'Number of photos attached to the service request for documentation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectionCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Completed Date' ;
    rdfs:comment 'Date when the inspection of the service request issue was completed.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:environmentalClearance rdf:type rdf:Property ;
    rdfs:label 'Environmental Clearance' ;
    rdfs:comment 'Type of environmental clearance required or obtained for the service request work.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateOfRequestId rdf:type rdf:Property ;
    rdfs:label 'Duplicate Of Request Id' ;
    rdfs:comment 'Identifier of the original service request if this request is marked as a duplicate.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceRequest .

ind:slaResolutionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Resolution Hours' ;
    rdfs:comment 'Target number of hours for resolution of the service request based on priority.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaMet rdf:type rdf:Property ;
    rdfs:label 'Sla Met' ;
    rdfs:comment 'Indicates whether the service request was resolved within the SLA target timeframe.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:citizenSatisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Citizen Satisfaction Rating' ;
    rdfs:comment 'Satisfaction rating provided by the requester on a scale of 1 to 5 after resolution.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:citizenFeedback rdf:type rdf:Property ;
    rdfs:label 'Citizen Feedback' ;
    rdfs:comment 'Additional feedback or comments provided by the requester after resolution.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalated rdf:type rdf:Property ;
    rdfs:label 'Escalated' ;
    rdfs:comment 'Indicates whether the service request was escalated to higher management or specialized teams.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Reason why the service request was escalated.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airportId rdf:type rdf:Property ;
    rdfs:label 'Airport Id' ;
    rdfs:comment 'Unique identifier for each public airport in North Carolina. Primary key for the airport master record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Airport .

ind:faaSiteNumber rdf:type rdf:Property ;
    rdfs:label 'Faa Site Number' ;
    rdfs:comment 'Unique FAA-assigned site identifier for the airport. Standard format is state code followed by facility code (e.g., 12-NC).' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locid rdf:type rdf:Property ;
    rdfs:label 'Locid' ;
    rdfs:comment 'Three or four-character airport location identifier assigned by FAA. Used for flight planning and air traffic control.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iataCode rdf:type rdf:Property ;
    rdfs:label 'Iata Code' ;
    rdfs:comment 'Three-letter IATA airport code for commercial service airports. Used in airline ticketing and baggage handling systems.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icaoCode rdf:type rdf:Property ;
    rdfs:label 'Icao Code' ;
    rdfs:comment 'Four-letter ICAO airport code used internationally for flight operations and weather reporting.' ;
    rdfs:domain ind:Aviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerAddress rdf:type rdf:Property ;
    rdfs:label 'Owner Address' ;
    rdfs:comment 'Mailing address of the airport owner for official correspondence and legal notices.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:region rdf:type rdf:Property ;
    rdfs:label 'Region' ;
    rdfs:comment 'FAA regional office jurisdiction responsible for regulatory oversight of the airport.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npiasRole rdf:type rdf:Property ;
    rdfs:label 'Npias Role' ;
    rdfs:comment 'Airport classification within the FAA National Plan of Integrated Airport Systems, determining eligibility for federal funding.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npiasHubType rdf:type rdf:Property ;
    rdfs:label 'Npias Hub Type' ;
    rdfs:comment 'Hub classification for commercial service airports based on percentage of annual passenger boardings.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faaRegionCode rdf:type rdf:Property ;
    rdfs:label 'Faa Region Code' ;
    rdfs:comment 'Three-letter code identifying the FAA regional office with jurisdiction over the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adoOffice rdf:type rdf:Property ;
    rdfs:label 'Ado Office' ;
    rdfs:comment 'FAA Airports District Office responsible for certification and compliance oversight.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlTower rdf:type rdf:Property ;
    rdfs:label 'Control Tower' ;
    rdfs:comment 'Indicates whether the airport has an FAA air traffic control tower.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:towerType rdf:type rdf:Property ;
    rdfs:label 'Tower Type' ;
    rdfs:comment 'Type of air traffic control tower operation: FAA-staffed, contract tower, or no tower.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unicomFrequency rdf:type rdf:Property ;
    rdfs:label 'Unicom Frequency' ;
    rdfs:comment 'Radio frequency for pilot-to-pilot and pilot-to-FBO communications at non-towered airports.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ctafFrequency rdf:type rdf:Property ;
    rdfs:label 'Ctaf Frequency' ;
    rdfs:comment 'Radio frequency designated for airport advisory communications and traffic coordination.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherReporting rdf:type rdf:Property ;
    rdfs:label 'Weather Reporting' ;
    rdfs:comment 'Type of automated weather observation system available at the airport (AWOS, ASOS, AWSS, or none).' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notamFacility rdf:type rdf:Property ;
    rdfs:label 'Notam Facility' ;
    rdfs:comment 'Identifier used for issuing NOTAMs (Notices to Airmen) for the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelTypesAvailable rdf:type rdf:Property ;
    rdfs:label 'Fuel Types Available' ;
    rdfs:comment 'Types of aviation fuel available at the airport (e.g., 100LL, Jet A, Mogas). Pipe-separated list.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:landingFeeRequired rdf:type rdf:Property ;
    rdfs:label 'Landing Fee Required' ;
    rdfs:comment 'Indicates whether the airport charges landing fees for aircraft operations.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customsService rdf:type rdf:Property ;
    rdfs:label 'Customs Service' ;
    rdfs:comment 'Indicates whether U.S. Customs and Border Protection services are available for international arrivals.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:militaryJointUse rdf:type rdf:Property ;
    rdfs:label 'Military Joint Use' ;
    rdfs:comment 'Indicates whether the airport is jointly used by civilian and military operations.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:basedAircraftCount rdf:type rdf:Property ;
    rdfs:label 'Based Aircraft Count' ;
    rdfs:comment 'Number of aircraft permanently based at the airport. Used for planning and funding calculations.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:singleEngineAircraft rdf:type rdf:Property ;
    rdfs:label 'Single Engine Aircraft' ;
    rdfs:comment 'Number of single-engine aircraft based at the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:multiEngineAircraft rdf:type rdf:Property ;
    rdfs:label 'Multi Engine Aircraft' ;
    rdfs:comment 'Number of multi-engine aircraft based at the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jetAircraft rdf:type rdf:Property ;
    rdfs:label 'Jet Aircraft' ;
    rdfs:comment 'Number of jet aircraft based at the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:helicopterAircraft rdf:type rdf:Property ;
    rdfs:label 'Helicopter Aircraft' ;
    rdfs:comment 'Number of helicopters based at the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gliderAircraft rdf:type rdf:Property ;
    rdfs:label 'Glider Aircraft' ;
    rdfs:comment 'Number of gliders based at the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ultralightAircraft rdf:type rdf:Property ;
    rdfs:label 'Ultralight Aircraft' ;
    rdfs:comment 'Number of ultralight aircraft based at the airport.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualOperations rdf:type rdf:Property ;
    rdfs:label 'Annual Operations' ;
    rdfs:comment 'Total number of aircraft takeoffs and landings at the airport per year. Used for capacity planning and funding.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualCommercialOperations rdf:type rdf:Property ;
    rdfs:label 'Annual Commercial Operations' ;
    rdfs:comment 'Number of commercial airline operations (takeoffs and landings) per year.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualEnplanements rdf:type rdf:Property ;
    rdfs:label 'Annual Enplanements' ;
    rdfs:comment 'Number of passengers boarding commercial flights at the airport annually. Key metric for NPIAS classification.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patternAltitude rdf:type rdf:Property ;
    rdfs:label 'Pattern Altitude' ;
    rdfs:comment 'Standard altitude in feet above ground level for aircraft flying the traffic pattern.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:beacon rdf:type rdf:Property ;
    rdfs:label 'Beacon' ;
    rdfs:comment 'Indicates whether the airport has a rotating beacon for visual identification at night.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lightingSchedule rdf:type rdf:Property ;
    rdfs:label 'Lighting Schedule' ;
    rdfs:comment 'Operating schedule for airport lighting systems.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentedCircle rdf:type rdf:Property ;
    rdfs:label 'Segmented Circle' ;
    rdfs:comment 'Indicates whether the airport has a segmented circle visual aid for wind direction and traffic pattern information.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyServices rdf:type rdf:Property ;
    rdfs:label 'Emergency Services' ;
    rdfs:comment 'Description of emergency response capabilities available at or near the airport (fire, medical, rescue).' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arffIndex rdf:type rdf:Property ;
    rdfs:label 'Arff Index' ;
    rdfs:comment 'FAA certification level for aircraft rescue and firefighting capabilities based on aircraft size and operations.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:part139Certificate rdf:type rdf:Property ;
    rdfs:label 'Part 139 Certificate' ;
    rdfs:comment 'Indicates whether the airport holds an FAA Part 139 operating certificate required for scheduled commercial service.' ;
    rdfs:domain ind:Airport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateClass rdf:type rdf:Property ;
