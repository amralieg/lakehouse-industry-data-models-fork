    rdfs:comment 'Specific actions or modifications recommended to reduce risk exposure and improve insurability.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportUrl rdf:type rdf:Property ;
    rdfs:label 'Report Url' ;
    rdfs:comment 'Web link or file path to access the complete survey report document.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDate rdf:type rdf:Property ;
