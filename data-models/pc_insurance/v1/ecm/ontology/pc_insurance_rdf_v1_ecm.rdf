    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteSubtype rdf:type rdf:Property ;
    rdfs:label 'Note Subtype' ;
    rdfs:comment 'Further classification or subcategory of the note type for granular categorization.' ;
    rdfs:domain ind:ClaimNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteTimestamp rdf:type rdf:Property ;
    rdfs:label 'Note Timestamp' ;
    rdfs:comment 'Precise date and time when the note was created in the system.' ;
    rdfs:domain ind:ClaimNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:noteType rdf:type rdf:Property ;
    rdfs:label 'Note Type' ;
    rdfs:comment 'Classification of the note indicating its purpose: diary, coverage analysis, legal, medical, general, activity log, reserve, or payment. [ENUM-REF-CANDIDATE: diary|coverage|legal|medical|general|activity|reserve|payment — 8 candidates stripped; promote to' ;
    rdfs:domain ind:ClaimNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level assigned to the note indicating urgency or importance: low, normal, high, or urgent.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegedFlag rdf:type rdf:Property ;
    rdfs:label 'Privileged Flag' ;
    rdfs:comment 'Indicator whether the note is protected by attorney-client privilege or work product doctrine.' ;
    rdfs:domain ind:ClaimNote ;
