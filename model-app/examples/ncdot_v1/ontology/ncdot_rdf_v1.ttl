    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Response Required Flag' ;
    rdfs:comment 'Boolean indicator of whether the document requires a formal response or action from the recipient.' ;
