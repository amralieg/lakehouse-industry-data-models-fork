    rdfs:comment 'Date and time when the note was last updated or modified.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:litigationFlag rdf:type rdf:Property ;
    rdfs:label 'Litigation Flag' ;
    rdfs:comment 'Indicator whether the note is related to litigation or legal proceedings and subject to discovery.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noteDate rdf:type rdf:Property ;
    rdfs:label 'Note Date' ;
    rdfs:comment 'Business date on which the note was created or the event it describes occurred.' ;
    rdfs:domain ind:ClaimNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noteNumber rdf:type rdf:Property ;
    rdfs:label 'Note Number' ;
    rdfs:comment 'Business-readable sequential or formatted identifier for the note within the claim.' ;
