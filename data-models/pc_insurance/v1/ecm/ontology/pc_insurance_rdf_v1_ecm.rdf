ind:lomaLomrEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Loma Lomr Effective Date' ;
    rdfs:comment 'Date when the LOMA or LOMR became effective, modifying the flood zone designation.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lomaLomrIndicator rdf:type rdf:Property ;
    rdfs:label 'Loma Lomr Indicator' ;
    rdfs:comment 'Flag indicating whether a LOMA or LOMR has been issued by FEMA for this location, potentially changing the flood zone designation.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowestFloorElevationFt rdf:type rdf:Property ;
    rdfs:label 'Lowest Floor Elevation Ft' ;
    rdfs:comment 'Elevation of the lowest floor of the insured structure in feet above sea level.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mandatoryPurchaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Mandatory Purchase Indicator' ;
    rdfs:comment 'Flag indicating whether federal flood insurance purchase is mandatory for mortgage compliance at this location.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'Username or identifier of the system user who last modified the flood zone assignment record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nfipCommunityName rdf:type rdf:Property ;
    rdfs:label 'Nfip Community Name' ;
    rdfs:comment 'Name of the NFIP participating community jurisdiction covering the insured location.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredRiskPolicyEligible rdf:type rdf:Property ;
    rdfs:label 'Preferred Risk Policy Eligible' ;
    rdfs:comment 'Flag indicating whether the location qualifies for NFIP Preferred Risk Policy lower-cost coverage.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:redeterminationRequiredDate rdf:type rdf:Property ;
    rdfs:label 'Redetermination Required Date' ;
    rdfs:comment 'Date by which a new flood zone determination must be obtained to maintain compliance.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sfhaIndicator rdf:type rdf:Property ;
    rdfs:label 'Sfha Indicator' ;
    rdfs:comment 'Flag indicating whether the location is within a Special Flood Hazard Area subject to mandatory flood insurance purchase requirements.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveyorLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Surveyor License Number' ;
    rdfs:comment 'Professional license number of the surveyor or engineer who completed the Elevation Certificate.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyorName rdf:type rdf:Property ;
    rdfs:label 'Surveyor Name' ;
    rdfs:comment 'Name of the licensed surveyor or engineer who completed the Elevation Certificate.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glOperationId rdf:type rdf:Property ;
    rdfs:label 'Gl Operation Id' ;
    rdfs:comment 'Unique identifier for the general liability operation record.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualPayrollAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Payroll Amount' ;
    rdfs:comment 'Total annual payroll for employees engaged in this operation, used as rating exposure basis for certain class codes.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualReceiptsAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Receipts Amount' ;
    rdfs:comment 'Total gross receipts or sales revenue generated by this operation during the policy term, used as rating exposure basis.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaSqft rdf:type rdf:Property ;
    rdfs:label 'Area Sqft' ;
    rdfs:comment 'Total square footage of premises or operational area, used as rating exposure basis for area-rated classes.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hazardGrade rdf:type rdf:Property ;
    rdfs:label 'Hazard Grade' ;
    rdfs:comment 'Underwriting assessment of the relative hazard or risk level of this operation: low, moderate, high, or severe.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoGlClassCode rdf:type rdf:Property ;
    rdfs:label 'Iso Gl Class Code' ;
    rdfs:comment 'ISO standard classification code identifying the type of business operation for rating and underwriting purposes.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoGlClassDescription rdf:type rdf:Property ;
    rdfs:label 'Iso Gl Class Description' ;
    rdfs:comment 'Full text description of the ISO GL class code as published in the ISO rating manual.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfEmployees rdf:type rdf:Property ;
    rdfs:label 'Number Of Employees' ;
    rdfs:comment 'Total count of full-time equivalent employees engaged in this operation during the policy term.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfUnits rdf:type rdf:Property ;
    rdfs:label 'Number Of Units' ;
    rdfs:comment 'Count of discrete units produced, sold, or serviced by this operation, used as rating exposure basis for unit-rated classes.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operationDescription rdf:type rdf:Property ;
    rdfs:label 'Operation Description' ;
    rdfs:comment 'Detailed narrative describing the nature, scope, and activities of the insured business operation.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationName rdf:type rdf:Property ;
    rdfs:label 'Operation Name' ;
    rdfs:comment 'Short descriptive name or title of the business operation being insured.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationNumber rdf:type rdf:Property ;
    rdfs:label 'Operation Number' ;
    rdfs:comment 'Business-assigned sequential or coded identifier for this operation within the policy.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationStatus rdf:type rdf:Property ;
    rdfs:label 'Operation Status' ;
    rdfs:comment 'Current lifecycle status of the GL operation record within the policy term.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationType rdf:type rdf:Property ;
    rdfs:label 'Operation Type' ;
    rdfs:comment 'Category of GL exposure this operation represents: premises operations, products liability, completed operations, or other.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premisesOperationsSplitPct rdf:type rdf:Property ;
    rdfs:label 'Premises Operations Split Pct' ;
    rdfs:comment 'Percentage of total receipts or exposure allocated to premises and ongoing operations hazard.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productsCompletedOpsSplitPct rdf:type rdf:Property ;
    rdfs:label 'Products Completed Ops Split Pct' ;
    rdfs:comment 'Percentage of total receipts or exposure allocated to products and completed operations hazard, as opposed to premises operations.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratePerExposureUnit rdf:type rdf:Property ;
    rdfs:label 'Rate Per Exposure Unit' ;
    rdfs:comment 'The manual rate applied per unit of exposure (per hundred of payroll, per thousand of receipts, per square foot) for this operation.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:removedDate rdf:type rdf:Property ;
    rdfs:label 'Removed Date' ;
    rdfs:comment 'Date on which this operation was removed from the policy prior to natural expiration.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subcontractorReceiptsAmount rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Receipts Amount' ;
    rdfs:comment 'Total payments made to uninsured subcontractors for work performed under this operation, subject to additional premium.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subcontractorWorkIndicator rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Work Indicator' ;
    rdfs:comment 'Flag indicating whether this operation involves the use of subcontractors or independent contractors.' ;
    rdfs:domain ind:GlOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwritingNotes rdf:type rdf:Property ;
    rdfs:label 'Underwriting Notes' ;
    rdfs:comment 'Free-text underwriting comments, special conditions, or risk assessment notes related to this operation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentEntityInsuredEntityId rdf:type rdf:Property ;
    rdfs:label 'Parent Entity Insured Entity Id' ;
    rdfs:comment 'Reference to the parent insured entity if this entity is a subsidiary or division, used for account hierarchy.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredEntity .

ind:annualRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue Amount' ;
    rdfs:comment 'Reported annual gross revenue of the entity in USD, used for exposure rating and premium calculation.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entityNumber rdf:type rdf:Property ;
    rdfs:label 'Entity Number' ;
    rdfs:comment 'Business-assigned unique identifier for the insured entity, used in policy documents and correspondence.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityStatus rdf:type rdf:Property ;
    rdfs:label 'Entity Status' ;
    rdfs:comment 'Current lifecycle status of the insured entity record within the system.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSubsidiary rdf:type rdf:Property ;
    rdfs:label 'Is Subsidiary' ;
    rdfs:comment 'Indicates whether this entity is a subsidiary of another insured entity, used for account structure analysis.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossFreeYears rdf:type rdf:Property ;
    rdfs:label 'Loss Free Years' ;
    rdfs:comment 'Number of consecutive years without a reported claim, used for experience rating and premium discounts.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mailingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the mailing address of the insured entity.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactTitle rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Title' ;
    rdfs:comment 'Job title or role of the primary contact person within the insured entity organization.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Email' ;
    rdfs:comment 'Primary email address for policy correspondence, billing notices, and renewal communications.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Expiration Date' ;
    rdfs:comment 'Expiration date of the prior insurance policy, used to assess coverage continuity and lapse risk.' ;
    rdfs:domain ind:InsuredEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:alarmType rdf:type rdf:Property ;
    rdfs:label 'Alarm Type' ;
    rdfs:comment 'Type of burglar or fire alarm system at the insured location. Central station and direct-to-fire alarms qualify for rating credits under ISO protective device schedules.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingValue rdf:type rdf:Property ;
    rdfs:label 'Building Value' ;
    rdfs:comment 'Insured replacement cost or actual cash value of the building structure at this location, excluding contents and business income. Component of TIV used in property rating.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessIncomeValue rdf:type rdf:Property ;
    rdfs:label 'Business Income Value' ;
    rdfs:comment 'Insured value for business income and extra expense coverage at this location. Represents maximum indemnity for lost revenue following a covered loss event.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contentsValue rdf:type rdf:Property ;
    rdfs:label 'Contents Value' ;
    rdfs:comment 'Insured value of business personal property and contents at this location. Separate from building value; used for contents coverage rating and TIV accumulation.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County or parish in which the insured location is situated. Used for NFIP flood zone mapping, CAT modeling, and certain state-specific rating territories.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceToFireStationMiles rdf:type rdf:Property ;
    rdfs:label 'Distance To Fire Station Miles' ;
    rdfs:comment 'Distance in miles from the insured location to the nearest responding fire station. Key input to ISO Public Protection Classification (PPC) and fire rating factor determination.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earthquakeZone rdf:type rdf:Property ;
    rdfs:label 'Earthquake Zone' ;
    rdfs:comment 'Seismic hazard zone classification (0-4) for the insured location per ISO or USGS standards. Zone 4 is highest seismic risk. Used for earthquake rating and PML modeling.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZone rdf:type rdf:Property ;
    rdfs:label 'Flood Zone' ;
    rdfs:comment 'FEMA National Flood Insurance Program (NFIP) flood zone designation for the insured location (e.g., AE, X, VE). Determines flood coverage eligibility, mandatory purchase requirements, and rating.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geocodeQuality rdf:type rdf:Property ;
    rdfs:label 'Geocode Quality' ;
    rdfs:comment 'Precision level of the geocoded coordinates for the insured location. Rooftop is highest precision; zip_centroid is lowest. Affects CAT model confidence and rating accuracy.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned to the insured location, used on policy declarations pages and bordereaux submissions to identify the premises.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Human-readable name or description of the insured premises (e.g., \'Main Street Warehouse\', \'Downtown Office\'). Used on declarations pages and loss reports.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current lifecycle state of the insured location record. Active locations are covered under a policy; inactive or expired locations are no longer in force.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Classification of the insured premises by operational role: primary business site, secondary site, storage facility, temporary, mobile, or other. Drives rating and coverage eligibility.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyType rdf:type rdf:Property ;
    rdfs:label 'Occupancy Type' ;
    rdfs:comment 'ISO occupancy classification describing how the insured building is used (e.g., office, retail, manufacturing, habitational). Core COPE attribute driving underwriting and rating. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sprinklerType rdf:type rdf:Property ;
    rdfs:label 'Sprinkler Type' ;
    rdfs:comment 'Type of automatic fire sprinkler system installed at the insured location. Part of COPE protection assessment; presence and type provide rating credits and reduce fire PML.' ;
    rdfs:domain ind:InsuredLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCashValueAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cash Value Amount' ;
    rdfs:comment 'Current market value of the vehicle accounting for depreciation, used for claim settlement.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:antiTheftDevice rdf:type rdf:Property ;
    rdfs:label 'Anti Theft Device' ;
    rdfs:comment 'Type of anti-theft device installed on the vehicle, may qualify for premium discount.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodyType rdf:type rdf:Property ;
    rdfs:label 'Body Type' ;
    rdfs:comment 'Physical body style of the vehicle such as sedan, coupe, SUV, pickup, van.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collisionSymbol rdf:type rdf:Property ;
    rdfs:label 'Collision Symbol' ;
    rdfs:comment 'Rating symbol for collision coverage based on vehicle repair costs and safety features.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compSymbol rdf:type rdf:Property ;
    rdfs:label 'Comp Symbol' ;
    rdfs:comment 'Rating symbol for comprehensive coverage based on vehicle theft and damage risk.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Garaging Address Line1' ;
    rdfs:comment 'Primary street address where the vehicle is principally garaged or parked overnight.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Garaging Address Line2' ;
    rdfs:comment 'Secondary address line for garaging location such as apartment or unit number.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingCity rdf:type rdf:Property ;
    rdfs:label 'Garaging City' ;
    rdfs:comment 'City where the vehicle is principally garaged.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Garaging Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the garaging location.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingCounty rdf:type rdf:Property ;
    rdfs:label 'Garaging County' ;
    rdfs:comment 'County where the vehicle is garaged, used for rating and regulatory reporting.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Garaging Postal Code' ;
    rdfs:comment 'ZIP code of the garaging location, critical for territory rating.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingStateCode rdf:type rdf:Property ;
    rdfs:label 'Garaging State Code' ;
    rdfs:comment 'Two-letter state code where the vehicle is principally garaged, used for rating and regulatory compliance.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRideshareVehicle rdf:type rdf:Property ;
    rdfs:label 'Is Rideshare Vehicle' ;
    rdfs:comment 'Indicates whether the vehicle is used for rideshare services such as Uber or Lyft.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSalvageTitle rdf:type rdf:Property ;
    rdfs:label 'Is Salvage Title' ;
    rdfs:comment 'Indicates whether the vehicle has a salvage or rebuilt title, affecting insurability and valuation.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licensePlateNumber rdf:type rdf:Property ;
    rdfs:label 'License Plate Number' ;
    rdfs:comment 'Current license plate number registered to the vehicle.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensePlateState rdf:type rdf:Property ;
    rdfs:label 'License Plate State' ;
    rdfs:comment 'State of registration for the license plate.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienholderAddress rdf:type rdf:Property ;
    rdfs:label 'Lienholder Address' ;
    rdfs:comment 'Mailing address of the lienholder for loss payee and certificate purposes.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienholderName rdf:type rdf:Property ;
    rdfs:label 'Lienholder Name' ;
    rdfs:comment 'Name of the financial institution or entity holding a lien or loan on the vehicle.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanLeaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Loan Lease Indicator' ;
    rdfs:comment 'Indicates whether the vehicle is owned outright, financed, or leased.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseDate rdf:type rdf:Property ;
    rdfs:label 'Purchase Date' ;
    rdfs:comment 'Date the insured purchased or acquired the vehicle.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:purchasePriceAmount rdf:type rdf:Property ;
    rdfs:label 'Purchase Price Amount' ;
    rdfs:comment 'Original purchase price paid for the vehicle by the insured.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:removalDate rdf:type rdf:Property ;
    rdfs:label 'Removal Date' ;
    rdfs:comment 'Date the vehicle was removed from the policy if applicable.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:safetyFeatures rdf:type rdf:Property ;
    rdfs:label 'Safety Features' ;
    rdfs:comment 'Comma-separated list of safety features such as airbags, ABS, ESC that may affect rating.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Stated Value Amount' ;
    rdfs:comment 'Agreed-upon value of the vehicle for insurance purposes, typically used for classic or specialty vehicles.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleNumber rdf:type rdf:Property ;
    rdfs:label 'Vehicle Number' ;
    rdfs:comment 'Sequential number assigned to the vehicle within the policy for identification purposes.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleStatus rdf:type rdf:Property ;
    rdfs:label 'Vehicle Status' ;
    rdfs:comment 'Current lifecycle status of the vehicle on the policy.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleSymbol rdf:type rdf:Property ;
    rdfs:label 'Vehicle Symbol' ;
    rdfs:comment 'ISO or proprietary rating symbol assigned to the vehicle based on make, model, and year for premium calculation.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleType rdf:type rdf:Property ;
    rdfs:label 'Vehicle Type' ;
    rdfs:comment 'High-level classification of the vehicle for policy and coverage determination.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleUse rdf:type rdf:Property ;
    rdfs:label 'Vehicle Use' ;
    rdfs:comment 'Primary use classification of the vehicle for rating and underwriting purposes.' ;
    rdfs:domain ind:InsuredVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:year rdf:type rdf:Property ;
    rdfs:label 'Year' ;
    rdfs:comment 'Model year of the vehicle as designated by the manufacturer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mvrReportId rdf:type rdf:Property ;
    rdfs:label 'Mvr Report Id' ;
    rdfs:comment 'Unique identifier for the motor vehicle report record.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accidentCount rdf:type rdf:Property ;
    rdfs:label 'Accident Count' ;
    rdfs:comment 'Total number of accidents reported on the MVR within the lookback period.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:atFaultAccidentCount rdf:type rdf:Property ;
    rdfs:label 'At Fault Accident Count' ;
    rdfs:comment 'Number of accidents where the driver was determined to be at fault.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Cost charged by the provider for obtaining the MVR report.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCurrency rdf:type rdf:Property ;
    rdfs:label 'Cost Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the MVR cost amount.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duiCount rdf:type rdf:Property ;
    rdfs:label 'Dui Count' ;
    rdfs:comment 'Number of DUI or DWI convictions reported on the MVR.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isAcceptableForUnderwriting rdf:type rdf:Property ;
    rdfs:label 'Is Acceptable For Underwriting' ;
    rdfs:comment 'Indicates whether the MVR results meet underwriting acceptability criteria for policy issuance.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:majorViolationCount rdf:type rdf:Property ;
    rdfs:label 'Major Violation Count' ;
    rdfs:comment 'Number of major violations such as DUI, reckless driving, or hit-and-run reported on the MVR.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorViolationCount rdf:type rdf:Property ;
    rdfs:label 'Minor Violation Count' ;
    rdfs:comment 'Number of minor violations such as speeding or failure to signal reported on the MVR.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mvrTier rdf:type rdf:Property ;
    rdfs:label 'Mvr Tier' ;
    rdfs:comment 'Underwriting tier assignment based on MVR score and driving history.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notAtFaultAccidentCount rdf:type rdf:Property ;
    rdfs:label 'Not At Fault Accident Count' ;
    rdfs:comment 'Number of accidents where the driver was not determined to be at fault.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orderedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Ordered By User Code' ;
    rdfs:comment 'User identifier of the underwriter or system user who ordered the MVR report.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionCount rdf:type rdf:Property ;
    rdfs:label 'Suspension Count' ;
    rdfs:comment 'Number of license suspensions reported on the MVR within the lookback period.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:violationCount rdf:type rdf:Property ;
    rdfs:label 'Violation Count' ;
    rdfs:comment 'Total number of moving violations reported on the MVR within the lookback period.' ;
    rdfs:domain ind:MvrReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pmlEstimateId rdf:type rdf:Property ;
    rdfs:label 'Pml Estimate Id' ;
    rdfs:comment 'Unique identifier for the PML estimate record.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByEstimatePmlEstimateId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Estimate Pml Estimate Id' ;
    rdfs:comment 'Reference to the newer PML estimate that supersedes this one, if applicable.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PmlEstimate .

ind:annualAggregateDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Aggregate Deductible Amount' ;
    rdfs:comment 'Annual aggregate deductible applied in the PML calculation for the policy or location.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceLevelPercentage rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Percentage' ;
    rdfs:comment 'Statistical confidence level associated with the PML estimate, typically 90% or 95%.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exceedanceProbability rdf:type rdf:Property ;
    rdfs:label 'Exceedance Probability' ;
    rdfs:comment 'Probability that the actual loss will exceed the estimated PML amount.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPmlAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Pml Amount' ;
    rdfs:comment 'Estimated probable maximum loss amount before reinsurance recoveries.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelRunCode rdf:type rdf:Property ;
    rdfs:label 'Model Run Code' ;
    rdfs:comment 'Unique identifier for the specific model execution batch that produced this estimate.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelRunDate rdf:type rdf:Property ;
    rdfs:label 'Model Run Date' ;
    rdfs:comment 'Date when the catastrophe model was executed to produce this PML estimate.' ;
    rdfs:domain ind:PmlEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modelVendor rdf:type rdf:Property ;
    rdfs:label 'Model Vendor' ;
    rdfs:comment 'Vendor or provider of the catastrophe model used to generate the PML estimate.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
