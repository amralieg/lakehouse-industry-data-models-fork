ind:sailingScheduleId rdf:type rdf:Property ;
    rdfs:label 'Sailing Schedule Id' ;
    rdfs:comment 'Identifier of the specific scheduled sailing for which this reservation is made.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SailingSchedule .

ind:routeCode rdf:type rdf:Property ;
    rdfs:label 'Route Code' ;
    rdfs:comment 'Code identifying the ferry route (e.g., HAT for Hatteras-Ocracoke, CED for Cedar Island-Ocracoke).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departureTerminalCode rdf:type rdf:Property ;
    rdfs:label 'Departure Terminal Code' ;
    rdfs:comment 'Code identifying the departure terminal for the reserved sailing.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrivalTerminalCode rdf:type rdf:Property ;
    rdfs:label 'Arrival Terminal Code' ;
    rdfs:comment 'Code identifying the arrival terminal for the reserved sailing.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDepartureTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Departure Time' ;
    rdfs:comment 'Scheduled departure date and time for the reserved sailing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledArrivalTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Arrival Time' ;
    rdfs:comment 'Scheduled arrival date and time for the reserved sailing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vehicleType rdf:type rdf:Property ;
    rdfs:label 'Vehicle Type' ;
    rdfs:comment 'Type of vehicle associated with the reservation, or passenger-only if no vehicle.' ;
