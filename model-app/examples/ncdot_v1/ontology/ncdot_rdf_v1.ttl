ind:stolenDate rdf:type rdf:Property ;
    rdfs:label 'Stolen Date' ;
    rdfs:comment 'Date when the vehicle was reported stolen. Null if vehicle has not been reported stolen.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveredFlag rdf:type rdf:Property ;
    rdfs:label 'Recovered Flag' ;
    rdfs:comment 'Indicates whether a previously stolen vehicle has been recovered.' ;
