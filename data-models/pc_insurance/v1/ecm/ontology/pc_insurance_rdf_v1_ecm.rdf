    rdfs:comment 'Indicates whether rates and forms for this line require state regulatory filing and approval.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskBasedCapitalFactor rdf:type rdf:Property ;
