ind:fundingSourceCode rdf:type rdf:Property ;
    rdfs:label 'Funding Source Code' ;
    rdfs:comment 'Primary funding source code identifying the specific federal, state, or local program providing the budget allocation (e.g., HSIP, CMAQ, STP, BUILD, INFRA, RAISE).' ;
    rdfs:domain ind:Ncdot ;
