    rdfs:comment 'Indicates whether this PML run is used for regulatory reporting or filing purposes.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnPeriod1000GrossPml rdf:type rdf:Property ;
