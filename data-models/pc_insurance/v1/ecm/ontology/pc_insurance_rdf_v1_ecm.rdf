    rdfs:range xsd:string .

ind:userAccountId rdf:type rdf:Property ;
    rdfs:label 'User Account Id' ;
    rdfs:comment 'User identifier of the person or system account that initiated document generation.' ;
    rdfs:domain ind:PcInsurance ;
