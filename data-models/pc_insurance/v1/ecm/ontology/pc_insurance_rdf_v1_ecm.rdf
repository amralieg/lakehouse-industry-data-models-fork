ind:additionalInsuredId rdf:type rdf:Property ;
    rdfs:label 'Additional Insured Id' ;
    rdfs:comment 'Unique surrogate identifier for the additional insured endorsement record on a policy. Primary key for the additional_insured entity in the coverage domain.' ;
