    rdfs:range xsd:string .

ind:initiatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Code' ;
    rdfs:comment 'System user identifier of the person who initiated the status change.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedByUserName rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Name' ;
    rdfs:comment 'Full name of the user who initiated the status transition.' ;
