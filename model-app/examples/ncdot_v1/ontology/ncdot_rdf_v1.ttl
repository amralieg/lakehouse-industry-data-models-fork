ind:adjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason' ;
    rdfs:comment 'Explanation or reason code for depreciation adjustments or corrections.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
