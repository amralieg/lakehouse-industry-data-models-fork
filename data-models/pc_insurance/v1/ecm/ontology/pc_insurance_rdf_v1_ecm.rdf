    rdfs:range xsd:string .

ind:cmsUrl rdf:type rdf:Property ;
    rdfs:label 'Cms Url' ;
    rdfs:comment 'Direct URL or path to retrieve the document file from the content management system.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Date' ;
    rdfs:comment 'Date when the document was delivered or sent to the recipient.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
