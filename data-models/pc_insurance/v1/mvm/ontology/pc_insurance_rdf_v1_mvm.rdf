    rdfs:range xsd:decimal .

ind:surplusLinesStampingOffice rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Stamping Office' ;
    rdfs:comment 'Name of the surplus lines stamping office or service office that processed the filing, if applicable.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeId rdf:type rdf:Property ;
    rdfs:label 'Fee Id' ;
    rdfs:comment 'Unique identifier for the fee record. Primary key.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalFeeId rdf:type rdf:Property ;
    rdfs:label 'Original Fee Id' ;
    rdfs:comment 'Foreign key to the original fee record that this record reverses, if this is a reversal transaction.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fee .

ind:billingMethodCode rdf:type rdf:Property ;
    rdfs:label 'Billing Method Code' ;
    rdfs:comment 'Code indicating the billing method under which this fee is collected: direct bill, agency bill, list bill, or account current.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionBureauCode rdf:type rdf:Property ;
    rdfs:label 'Inspection Bureau Code' ;
    rdfs:comment 'Code identifying the inspection bureau to which inspection fees are remitted.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentNumber rdf:type rdf:Property ;
    rdfs:label 'Installment Number' ;
    rdfs:comment 'Installment sequence number for installment fees, indicating which payment installment this fee applies to.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:refundDate rdf:type rdf:Property ;
    rdfs:label 'Refund Date' ;
    rdfs:comment 'Date on which the fee was refunded, if applicable.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundReasonCode rdf:type rdf:Property ;
    rdfs:label 'Refund Reason Code' ;
    rdfs:comment 'Code indicating the reason the fee was refunded, if applicable.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundedFlag rdf:type rdf:Property ;
    rdfs:label 'Refunded Flag' ;
    rdfs:comment 'Indicates whether this fee was refunded to the policyholder. True if refunded, False otherwise.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remittanceDestinationCode rdf:type rdf:Property ;
    rdfs:label 'Remittance Destination Code' ;
    rdfs:comment 'Code indicating the entity to which this fee must be remitted: carrier, state Department of Insurance, surplus lines stamping office, inspection bureau, or third party.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittancePayeeName rdf:type rdf:Property ;
    rdfs:label 'Remittance Payee Name' ;
    rdfs:comment 'Name of the entity or organization to which the fee is remitted.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemFeeCode rdf:type rdf:Property ;
    rdfs:label 'Source System Fee Code' ;
    rdfs:comment 'Unique identifier for this fee in the source system, used for reconciliation and traceability.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesStampingOfficeCode rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Stamping Office Code' ;
    rdfs:comment 'Code identifying the surplus lines stamping office to which surplus lines fees are remitted.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxableFlag rdf:type rdf:Property ;
    rdfs:label 'Taxable Flag' ;
    rdfs:comment 'Indicates whether this fee is subject to sales tax or other levies. True if taxable, False otherwise.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:binderId rdf:type rdf:Property ;
    rdfs:label 'Binder Id' ;
    rdfs:comment 'Foreign key linking to coverage.binder. Business justification: Binder documents are a specific document type issued before the formal policy. Linking policy_document to the binder it represents supports binder document retrieval, regulatory' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Binder .

ind:recipientPartyId rdf:type rdf:Property ;
    rdfs:label 'Recipient Party Id' ;
    rdfs:comment 'Foreign key to the party who is the intended recipient of this document (policyholder, named insured, additional insured, loss payee, etc.).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:recipientPartyRoleId rdf:type rdf:Property ;
    rdfs:label 'Recipient Party Role Id' ;
    rdfs:comment 'Foreign key to the party role of the recipient at the time of document issuance.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Role .

ind:supersededDocumentPolicyDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Document Policy Document Id' ;
    rdfs:comment 'Foreign key to the prior document that this document replaces or supersedes, if applicable.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:deliveryConfirmationFlag rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Flag' ;
    rdfs:comment 'Indicates whether delivery confirmation was received from the recipient (True) or not (False).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryConfirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Timestamp' ;
    rdfs:comment 'Date and time when delivery confirmation was received, if applicable.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deliveryDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Date' ;
    rdfs:comment 'Date the document was delivered or sent to the recipient.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which the document was delivered to the policyholder or recipient.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDescription rdf:type rdf:Property ;
    rdfs:label 'Document Description' ;
    rdfs:comment 'Detailed description of the document content, purpose, or summary of changes for endorsements.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'Business-facing unique document number or control number assigned to this document for tracking and reference.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current lifecycle status of the document in the document management workflow. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|issued|delivered|voided|superseded|archived — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Type of policy document issued. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'File format of the stored document (e.g., PDF, DOCX, HTML).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'File Size Bytes' ;
    rdfs:comment 'Size of the document file in bytes.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formEditionDate rdf:type rdf:Property ;
    rdfs:label 'Form Edition Date' ;
    rdfs:comment 'Edition date of the form template used, indicating the version of the standard form applied.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:generationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Generation Timestamp' ;
    rdfs:comment 'Date and time when the document was generated by the policy administration or document management system.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:hash rdf:type rdf:Property ;
    rdfs:label 'Hash' ;
    rdfs:comment 'Cryptographic hash (e.g., SHA-256) of the document file for integrity verification and tamper detection.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'ISO 639-1 two-letter language code indicating the language in which the document was generated.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pageCount rdf:type rdf:Property ;
    rdfs:label 'Page Count' ;
    rdfs:comment 'Total number of pages in the generated document.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recipientAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Recipient Address Line1' ;
    rdfs:comment 'First line of the mailing address to which the document was sent.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Recipient Address Line2' ;
    rdfs:comment 'Second line of the mailing address (suite, apartment, etc.).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientCity rdf:type rdf:Property ;
    rdfs:label 'Recipient City' ;
    rdfs:comment 'City of the recipient mailing address.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientCountryCode rdf:type rdf:Property ;
    rdfs:label 'Recipient Country Code' ;
    rdfs:comment 'Three-letter ISO country code of the recipient mailing address.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientEmail rdf:type rdf:Property ;
    rdfs:label 'Recipient Email' ;
    rdfs:comment 'Email address to which the document was sent, if delivered electronically.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientName rdf:type rdf:Property ;
    rdfs:label 'Recipient Name' ;
    rdfs:comment 'Name of the recipient as it appears on the document for delivery purposes.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientPostalCode rdf:type rdf:Property ;
    rdfs:label 'Recipient Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the recipient mailing address.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientStateCode rdf:type rdf:Property ;
    rdfs:label 'Recipient State Code' ;
    rdfs:comment 'Two-letter state or province code of the recipient mailing address.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'Reference number or identifier of the regulatory filing or approval associated with this document form.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Required Flag' ;
    rdfs:comment 'Indicates whether this document is required by state or federal regulation (True) or is optional/carrier-initiated (False).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:storageLocationUri rdf:type rdf:Property ;
    rdfs:label 'Storage Location Uri' ;
    rdfs:comment 'URI or path to the document file in the document management system or content repository.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateVersion rdf:type rdf:Property ;
    rdfs:label 'Template Version' ;
    rdfs:comment 'Version number of the document template used at the time of generation.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:title rdf:type rdf:Property ;
    rdfs:label 'Title' ;
    rdfs:comment 'Human-readable title or name of the document as it appears on the document itself.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidFlag rdf:type rdf:Property ;
    rdfs:label 'Void Flag' ;
    rdfs:comment 'Indicates whether this document has been voided and is no longer valid (True) or remains valid (False).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voidReasonCode rdf:type rdf:Property ;
    rdfs:label 'Void Reason Code' ;
    rdfs:comment 'Code indicating the reason the document was voided (e.g., error, reissue, policy cancellation).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acresBurned rdf:type rdf:Property ;
    rdfs:label 'Acres Burned' ;
    rdfs:comment 'Total number of acres burned during the wildfire event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualLossAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Loss Amount' ;
    rdfs:comment 'Actual reported insured loss amount for this catastrophe event after claims settlement in USD.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affectedCountries rdf:type rdf:Property ;
    rdfs:label 'Affected Countries' ;
    rdfs:comment 'Comma-separated list of ISO 3-letter country codes where the catastrophe event caused insured losses.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedStates rdf:type rdf:Property ;
    rdfs:label 'Affected States' ;
    rdfs:comment 'Comma-separated list of US state postal codes where the catastrophe event caused insured losses.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catBondTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Bond Trigger Flag' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered a catastrophe bond payout.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Source system or organization that provided the catastrophe event data (e.g., ISO, PCS, RMS, AIR, NOAA, USGS).' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declarationDate rdf:type rdf:Property ;
    rdfs:label 'Declaration Date' ;
    rdfs:comment 'Date when the event was officially declared a catastrophe by industry or regulatory bodies.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:epicenterLatitude rdf:type rdf:Property ;
    rdfs:label 'Epicenter Latitude' ;
    rdfs:comment 'Latitude coordinate of the catastrophe event epicenter or origin point.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:epicenterLongitude rdf:type rdf:Property ;
    rdfs:label 'Epicenter Longitude' ;
    rdfs:comment 'Longitude coordinate of the catastrophe event epicenter or origin point.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Claim Count' ;
    rdfs:comment 'Estimated total number of insurance claims expected to be filed industry-wide for this catastrophe event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Detailed narrative description of the catastrophe event including impact, path, and key characteristics.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDurationDays rdf:type rdf:Property ;
    rdfs:label 'Event Duration Days' ;
    rdfs:comment 'Total number of days the catastrophe event lasted from start to end.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventEndDate rdf:type rdf:Property ;
    rdfs:label 'Event End Date' ;
    rdfs:comment 'Date when the catastrophe event concluded or was declared over.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventName rdf:type rdf:Property ;
    rdfs:label 'Event Name' ;
    rdfs:comment 'Official name assigned to the catastrophe event (e.g., Hurricane Katrina, Northridge Earthquake).' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStartDate rdf:type rdf:Property ;
    rdfs:label 'Event Start Date' ;
    rdfs:comment 'Date when the catastrophe event began.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current lifecycle status of the catastrophe event record.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'High-level classification of the catastrophe event origin.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalDisasterDeclarationFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Disaster Declaration Flag' ;
    rdfs:comment 'Indicates whether a federal disaster declaration was issued for this catastrophe event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:femaDisasterNumber rdf:type rdf:Property ;
    rdfs:label 'Fema Disaster Number' ;
    rdfs:comment 'Official FEMA disaster declaration number assigned to the event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicFootprintDescription rdf:type rdf:Property ;
    rdfs:label 'Geographic Footprint Description' ;
    rdfs:comment 'Narrative description of the geographic area impacted by the catastrophe event.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryLossEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Industry Loss Estimate Amount' ;
    rdfs:comment 'Estimated total insured loss across the entire insurance industry for this catastrophe event in USD.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isoCatSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Iso Cat Serial Number' ;
    rdfs:comment 'Industry-standard ISO serial number uniquely identifying the catastrophe event for cross-carrier reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossDevelopmentFactor rdf:type rdf:Property ;
    rdfs:label 'Loss Development Factor' ;
    rdfs:comment 'Factor representing the ratio of ultimate loss to reported loss, used for IBNR estimation.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:magnitudeScale rdf:type rdf:Property ;
    rdfs:label 'Magnitude Scale' ;
    rdfs:comment 'Name of the scale used to measure event magnitude (e.g., Richter, Moment Magnitude, Saffir-Simpson, Enhanced Fujita).' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:magnitudeValue rdf:type rdf:Property ;
    rdfs:label 'Magnitude Value' ;
    rdfs:comment 'Quantitative measure of event intensity (e.g., Richter scale for earthquakes, Saffir-Simpson for hurricanes).' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modeledLossAmount rdf:type rdf:Property ;
    rdfs:label 'Modeled Loss Amount' ;
    rdfs:comment 'Loss amount calculated by catastrophe modeling software for this event in USD.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nfipParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Nfip Participation Flag' ;
    rdfs:comment 'Indicates whether the event triggered NFIP claims and participation.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perilType rdf:type rdf:Property ;
    rdfs:label 'Peril Type' ;
    rdfs:comment 'Primary peril classification of the catastrophe event.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlClass rdf:type rdf:Property ;
    rdfs:label 'Pml Class' ;
    rdfs:comment 'Classification of the event based on probable maximum loss severity.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precipitationInches rdf:type rdf:Property ;
    rdfs:label 'Precipitation Inches' ;
    rdfs:comment 'Total precipitation recorded during the event in inches, applicable to flood and storm events.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Trigger Flag' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered reinsurance treaty or facultative coverage.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Return Period Years' ;
    rdfs:comment 'Statistical return period in years indicating the expected frequency of an event of this magnitude.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stormSurgeFeet rdf:type rdf:Property ;
    rdfs:label 'Storm Surge Feet' ;
    rdfs:comment 'Maximum storm surge height recorded in feet, applicable to hurricanes and coastal flooding events.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:windSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Wind Speed Mph' ;
    rdfs:comment 'Maximum sustained wind speed recorded during the event in miles per hour, applicable to hurricanes and tornadoes.' ;
    rdfs:domain ind:CatastropheEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:concentrationThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Concentration Threshold Amount' ;
    rdfs:comment 'Maximum total insured value in USD allowed in this zone before underwriting referral or capacity restrictions are triggered.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:concentrationThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Concentration Threshold Percentage' ;
    rdfs:comment 'Maximum percentage of total company exposure allowed in this zone before underwriting referral or capacity restrictions are triggered.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastCatEventDate rdf:type rdf:Property ;
    rdfs:label 'Last Cat Event Date' ;
    rdfs:comment 'Date of the most recent catastrophe event that impacted this zone, used for loss history and model validation.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCatEventLossAmount rdf:type rdf:Property ;
    rdfs:label 'Last Cat Event Loss Amount' ;
    rdfs:comment 'Total incurred loss amount in USD from the most recent catastrophe event in this zone, used for model validation and pricing.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastCatEventName rdf:type rdf:Property ;
    rdfs:label 'Last Cat Event Name' ;
    rdfs:comment 'Name of the most recent catastrophe event that impacted this zone, such as Hurricane Ian or Northridge Earthquake.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'Timestamp when this catastrophe zone record was most recently modified, including model updates or threshold changes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:modelUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Model Update Date' ;
    rdfs:comment 'Date when the catastrophe model version for this zone was last updated or recalibrated.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'Version identifier of the catastrophe model used to define this zone, such as RMS v21.0 or AIR v18.1.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelingVendor rdf:type rdf:Property ;
    rdfs:label 'Modeling Vendor' ;
    rdfs:comment 'Catastrophe modeling vendor whose model defines this zone: RMS, AIR, CoreLogic, KCC, or Internal proprietary model.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moratoriumEndDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium End Date' ;
    rdfs:comment 'Date when the current catastrophe moratorium is scheduled to end for this zone. Null if no moratorium or open-ended.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:moratoriumFlag rdf:type rdf:Property ;
    rdfs:label 'Moratorium Flag' ;
    rdfs:comment 'Indicates whether a catastrophe moratorium is currently in effect, prohibiting new business or policy changes in this zone.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moratoriumStartDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium Start Date' ;
    rdfs:comment 'Date when the current catastrophe moratorium began for this zone. Null if no moratorium is in effect.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:naicTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Naic Territory Code' ;
    rdfs:comment 'NAIC-standardized territory code mapping this catastrophe zone to regulatory reporting categories.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pml100YearAmount rdf:type rdf:Property ;
    rdfs:label 'Pml 100 Year Amount' ;
    rdfs:comment 'Probable maximum loss amount in USD for a 100-year return period event in this zone, used for reinsurance attachment point determination.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pml250YearAmount rdf:type rdf:Property ;
    rdfs:label 'Pml 250 Year Amount' ;
    rdfs:comment 'Probable maximum loss amount in USD for a 250-year return period event in this zone, used for catastrophe excess of loss treaty structuring.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pml500YearAmount rdf:type rdf:Property ;
    rdfs:label 'Pml 500 Year Amount' ;
    rdfs:comment 'Probable maximum loss amount in USD for a 500-year return period event in this zone, used for regulatory capital and solvency modeling.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Code' ;
    rdfs:comment 'Code used for catastrophe zone reporting to state departments of insurance and NAIC annual statement Schedule P catastrophe supplement.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceAttachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Attachment Point' ;
    rdfs:comment 'Loss amount in USD at which catastrophe excess of loss reinsurance coverage attaches for events in this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceLimit rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Limit' ;
    rdfs:comment 'Maximum reinsurance recovery amount in USD available for catastrophe events in this zone under current treaty structure.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tivAmount rdf:type rdf:Property ;
    rdfs:label 'Tiv Amount' ;
    rdfs:comment 'Total insured value in USD of all policies and insured risks currently assigned to this catastrophe zone.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwritingRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Underwriting Restriction Flag' ;
    rdfs:comment 'Indicates whether new business or renewal underwriting restrictions are currently in effect for this catastrophe zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Insurer-defined alphanumeric code uniquely identifying the catastrophe zone for rating and exposure aggregation.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneDescription rdf:type rdf:Property ;
    rdfs:label 'Zone Description' ;
    rdfs:comment 'Detailed description of the catastrophe zone, including geographic boundaries, peril characteristics, and modeling assumptions.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Human-readable name of the catastrophe zone, such as Florida Wind Zone 1 or California Earthquake Zone A.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneStatus rdf:type rdf:Property ;
    rdfs:label 'Zone Status' ;
    rdfs:comment 'Current lifecycle status of the catastrophe zone: active for rating, inactive, suspended, or under review for model updates.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneTier rdf:type rdf:Property ;
    rdfs:label 'Zone Tier' ;
    rdfs:comment 'Risk tier classification of the catastrophe zone based on loss frequency and severity: tier 1 highest risk, tier 4 lowest risk.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentGeographyId rdf:type rdf:Property ;
    rdfs:label 'Parent Geography Id' ;
    rdfs:comment 'Reference to the parent geography node in the hierarchy, enabling recursive drill-up from ZIP to county to state to country.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:catastropheZone rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Zone' ;
    rdfs:comment 'Catastrophe exposure zone classification (e.g., hurricane, earthquake, wildfire, flood) for PML (Probable Maximum Loss) and AAL (Average Annual Loss) modeling.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusTractCode rdf:type rdf:Property ;
    rdfs:label 'Census Tract Code' ;
    rdfs:comment 'US Census Bureau tract identifier, an 11-digit code combining state, county, and tract, used for demographic and socioeconomic analysis.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyCode rdf:type rdf:Property ;
    rdfs:label 'Geography Code' ;
    rdfs:comment 'Standard code for the geography unit: ISO 3166 country code, FIPS state/county code, ZIP code, CRESTA zone code, or census tract identifier.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyCode rdf:type rdf:Property ;
    rdfs:label 'County Code' ;
    rdfs:comment 'FIPS county code, a five-digit identifier combining state and county codes, used for granular territory rating and catastrophe aggregation.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crestaZoneCode rdf:type rdf:Property ;
    rdfs:label 'Cresta Zone Code' ;
    rdfs:comment 'CRESTA zone identifier for catastrophe modeling and reinsurance reporting, standardizing geographic aggregation for CAT exposure.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earthquakeZone rdf:type rdf:Property ;
    rdfs:label 'Earthquake Zone' ;
    rdfs:comment 'Seismic hazard zone classification for earthquake exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZone rdf:type rdf:Property ;
    rdfs:label 'Flood Zone' ;
    rdfs:comment 'FEMA flood hazard zone designation (e.g., A, AE, X, V) for flood exposure assessment and NFIP (National Flood Insurance Program) compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyStatus rdf:type rdf:Property ;
    rdfs:label 'Geography Status' ;
    rdfs:comment 'Current lifecycle status of the geography record: active for in-use geographies, inactive for discontinued, deprecated for superseded, pending for future.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyType rdf:type rdf:Property ;
    rdfs:label 'Geography Type' ;
    rdfs:comment 'Classification of the geography node: country, state, county, ZIP, CRESTA zone, or census tract.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hailZone rdf:type rdf:Property ;
    rdfs:label 'Hail Zone' ;
    rdfs:comment 'Hail hazard zone classification for severe convective storm exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Updated Date' ;
    rdfs:comment 'Date when this geography record was last updated, supporting data quality audits and change tracking.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medianHouseholdIncome rdf:type rdf:Property ;
    rdfs:label 'Median Household Income' ;
    rdfs:comment 'Median household income in US dollars for the geography unit, used for socioeconomic segmentation and underwriting.' ;
    rdfs:domain ind:Catastrophegeography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographyName rdf:type rdf:Property ;
    rdfs:label 'Geography Name' ;
    rdfs:comment 'Human-readable name of the geography unit, such as United States, California, Los Angeles County, or 90210.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:population rdf:type rdf:Property ;
    rdfs:label 'Population' ;
    rdfs:comment 'Total population count for the geography unit, used for exposure density analysis and market sizing.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingTerritory rdf:type rdf:Property ;
    rdfs:label 'Rating Territory' ;
    rdfs:comment 'Actuarial rating territory grouping for premium calculation, aggregating geographies into homogeneous risk pools.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tornadoZone rdf:type rdf:Property ;
    rdfs:label 'Tornado Zone' ;
    rdfs:comment 'Tornado hazard zone classification for severe convective storm exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urbanRuralCode rdf:type rdf:Property ;
    rdfs:label 'Urban Rural Code' ;
    rdfs:comment 'US Census Bureau urban-rural classification code, used for demographic segmentation and territory rating.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wildfireZone rdf:type rdf:Property ;
    rdfs:label 'Wildfire Zone' ;
    rdfs:comment 'Wildfire hazard zone classification for wildfire exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windZone rdf:type rdf:Property ;
    rdfs:label 'Wind Zone' ;
    rdfs:comment 'Wind hazard zone classification for hurricane and windstorm exposure, used in catastrophe modeling and underwriting.' ;
    rdfs:domain ind:Geography ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aalContributionPct rdf:type rdf:Property ;
    rdfs:label 'Aal Contribution Pct' ;
    rdfs:comment 'Percentage contribution of this territory to the overall portfolio AAL for catastrophe risk management.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRate rdf:type rdf:Property ;
    rdfs:label 'Base Rate' ;
    rdfs:comment 'The base premium rate per unit of exposure for this territory, as filed with the DOI.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countyList rdf:type rdf:Property ;
    rdfs:label 'County List' ;
    rdfs:comment 'Comma-separated list of county names or FIPS codes included in this territory definition.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crimeIndex rdf:type rdf:Property ;
    rdfs:label 'Crime Index' ;
    rdfs:comment 'Composite crime index score for the territory, used in underwriting and pricing for property and liability lines.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureBase rdf:type rdf:Property ;
    rdfs:label 'Exposure Base' ;
    rdfs:comment 'The unit of exposure to which the rate or loss cost applies, such as per policy, per vehicle, per location, per 100 of payroll.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingStatus rdf:type rdf:Property ;
    rdfs:label 'Filing Status' ;
    rdfs:comment 'Current regulatory status of the rate filing containing this territory definition.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Classification of the territory by geographic characteristics relevant to risk assessment and pricing.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossCost rdf:type rdf:Property ;
    rdfs:label 'Loss Cost' ;
    rdfs:comment 'The expected loss cost per unit of exposure for this territory, used in actuarial pricing and rate development.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moratoriumEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium Effective Date' ;
    rdfs:comment 'Date on which the current moratorium became effective, if applicable.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:moratoriumExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium Expiration Date' ;
    rdfs:comment 'Date on which the current moratorium is scheduled to expire, if applicable.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:territoryName rdf:type rdf:Property ;
    rdfs:label 'Territory Name' ;
    rdfs:comment 'Human-readable name or description of the territory, often referencing geographic boundaries or county groupings.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlContributionPct rdf:type rdf:Property ;
    rdfs:label 'Pml Contribution Pct' ;
    rdfs:comment 'Percentage contribution of this territory to the overall portfolio PML for catastrophe risk management.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:populationDensity rdf:type rdf:Property ;
    rdfs:label 'Population Density' ;
    rdfs:comment 'Average population density per square mile for the territory, used in risk assessment and pricing.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protectionClassRange rdf:type rdf:Property ;
    rdfs:label 'Protection Class Range' ;
    rdfs:comment 'Range of ISO Public Protection Classification codes applicable to this territory for property rating.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateRelativity rdf:type rdf:Property ;
    rdfs:label 'Rate Relativity' ;
    rdfs:comment 'The filed rate relativity factor for this territory, representing the multiplicative adjustment to base rates.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residualMarketFlag rdf:type rdf:Property ;
    rdfs:label 'Residual Market Flag' ;
    rdfs:comment 'Indicates whether this territory is designated as a residual or involuntary market territory requiring special handling.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tivConcentration rdf:type rdf:Property ;
    rdfs:label 'Tiv Concentration' ;
    rdfs:comment 'Total insured value concentration within this territory, used for exposure management and catastrophe aggregation.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherZone rdf:type rdf:Property ;
    rdfs:label 'Weather Zone' ;
    rdfs:comment 'Code identifying the weather or climate zone for this territory, relevant for catastrophe and weather-related perils.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windPoolFlag rdf:type rdf:Property ;
    rdfs:label 'Wind Pool Flag' ;
    rdfs:comment 'Indicates whether this territory is subject to state wind pool or catastrophe fund requirements for coastal exposure.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zipCodeList rdf:type rdf:Property ;
    rdfs:label 'Zip Code List' ;
    rdfs:comment 'Comma-separated list of ZIP codes or ZIP code ranges included in this territory definition.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catModelPerilCode rdf:type rdf:Property ;
    rdfs:label 'Cat Model Peril Code' ;
    rdfs:comment 'Peril code used in catastrophe modeling platforms such as RMS RiskLink or AIR Touchstone for exposure and loss estimation.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastrophegeographyPerilCategory rdf:type rdf:Property ;
    rdfs:label 'Catastrophegeography Peril Category' ;
    rdfs:comment 'High-level classification of the peril into natural disasters, man-made events, liability exposures, or other categories.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastrophegeographyPerilCode rdf:type rdf:Property ;
    rdfs:label 'Catastrophegeography Peril Code' ;
    rdfs:comment 'Standard alphanumeric code identifying the peril type, used across policy administration and claims systems.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastrophegeographyPerilDescription rdf:type rdf:Property ;
    rdfs:label 'Catastrophegeography Peril Description' ;
    rdfs:comment 'Detailed description of the peril, including scope, typical coverage scenarios, and exclusions.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastrophegeographyPerilName rdf:type rdf:Property ;
    rdfs:label 'Catastrophegeography Peril Name' ;
    rdfs:comment 'Full business name of the peril, such as Wind, Hail, Earthquake, Flood, Fire, Theft, or Liability.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastrophegeographyPerilStatus rdf:type rdf:Property ;
    rdfs:label 'Catastrophegeography Peril Status' ;
    rdfs:comment 'Current lifecycle status of the peril definition: active for use, inactive, deprecated, or pending regulatory approval.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormApplicability rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Applicability' ;
    rdfs:comment 'Comma-separated list of ISO or proprietary coverage forms where this peril is included or excluded, such as HO-3, DP-1, CP 10 30, CGL.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementRequired rdf:type rdf:Property ;
    rdfs:label 'Endorsement Required' ;
    rdfs:comment 'ISO or proprietary endorsement form number required to add coverage for this peril, if not included in base policy.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Fraud Risk Level' ;
    rdfs:comment 'Assessment of the relative fraud risk associated with claims for this peril, used for SIU referral and investigation prioritization.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyClassification rdf:type rdf:Property ;
    rdfs:label 'Frequency Classification' ;
    rdfs:comment 'Actuarial classification of the perils expected frequency of occurrence: high, medium, low, or rare.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRestriction rdf:type rdf:Property ;
    rdfs:label 'Geographic Restriction' ;
    rdfs:comment 'Description of geographic zones or territories where this peril is restricted, excluded, or subject to special underwriting rules.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCatPeril rdf:type rdf:Property ;
    rdfs:label 'Is Cat Peril' ;
    rdfs:comment 'Indicates whether the peril is classified as a catastrophe peril for exposure aggregation, PML modeling, and reinsurance treaty purposes.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCoveredByStandardPolicy rdf:type rdf:Property ;
    rdfs:label 'Is Covered By Standard Policy' ;
    rdfs:comment 'Indicates whether the peril is typically covered under standard policy forms or requires special endorsement or separate policy.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isExcludedByDefault rdf:type rdf:Property ;
    rdfs:label 'Is Excluded By Default' ;
    rdfs:comment 'Indicates whether the peril is excluded from standard coverage and requires explicit endorsement or separate policy to be covered.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportableToNaic rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To Naic' ;
    rdfs:comment 'Indicates whether losses from this peril must be reported separately in NAIC Annual Statement Schedule P or other statutory filings.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSubjectToStateRegulation rdf:type rdf:Property ;
    rdfs:label 'Is Subject To State Regulation' ;
    rdfs:comment 'Indicates whether coverage for this peril is subject to special state-level regulatory requirements, rate approval, or mandatory availability.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoCauseOfLossCode rdf:type rdf:Property ;
    rdfs:label 'Iso Cause Of Loss Code' ;
    rdfs:comment 'ISO-standardized cause-of-loss code used in policy forms, rating, and claims adjudication.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobApplicability rdf:type rdf:Property ;
    rdfs:label 'Lob Applicability' ;
    rdfs:comment 'Comma-separated list of lines of business where this peril is relevant, such as Homeowners, Commercial Property, Auto Physical Damage, General Liability.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicPerilCode rdf:type rdf:Property ;
    rdfs:label 'Naic Peril Code' ;
    rdfs:comment 'NAIC-standardized numeric code for statutory reporting and regulatory filings, used in Schedule P and Annual Statement.' ;
    rdfs:domain ind:Peril ;
    rdf:type owl:DatatypeProperty ;
