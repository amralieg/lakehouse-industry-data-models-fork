    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gainLossOnDisposal rdf:type rdf:Property ;
    rdfs:label 'Gain Loss On Disposal' ;
    rdfs:comment 'The calculated gain or loss on disposal of the asset, computed as disposal proceeds minus net book value, in US dollars.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
