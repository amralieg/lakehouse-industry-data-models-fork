    rdfs:comment 'Boolean flag indicating whether the asset has been identified as impaired under GASB 42 impairment standards.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impairmentDate rdf:type rdf:Property ;
    rdfs:label 'Impairment Date' ;
    rdfs:comment 'The date when asset impairment was recognized and recorded.' ;
