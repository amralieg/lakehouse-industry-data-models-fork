    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commissionRatePercent rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Percent' ;
    rdfs:comment 'The average or blended commission rate percentage applied to calculate the commission amount for this statement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Current Balance Amount' ;
    rdfs:comment 'The current outstanding balance on the agency bill statement after applying all transactions and payments.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delinquencyDays rdf:type rdf:Property ;
    rdfs:label 'Delinquency Days' ;
    rdfs:comment 'Number of days the statement balance is past due, calculated from the due date to the current date.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'The date by which the net amount due must be paid by the producer to avoid delinquency.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endorsementCount rdf:type rdf:Property ;
    rdfs:label 'Endorsement Count' ;
    rdfs:comment 'Number of policy endorsements processed during the statement period that affected premium and are included in this bill.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feesAmount rdf:type rdf:Property ;
    rdfs:label 'Fees Amount' ;
    rdfs:comment 'Total fees charged on the policies included in this statement, such as policy fees or installment fees.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lobSummary rdf:type rdf:Property ;
    rdfs:label 'Lob Summary' ;
    rdfs:comment 'Comma-separated list or summary of lines of business included in this agency bill statement for reference and categorization.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netAmountDue rdf:type rdf:Property ;
    rdfs:label 'Net Amount Due' ;
    rdfs:comment 'The net balance owed by the producer to the insurer or vice versa after all premiums, commissions, taxes, fees, and adjustments.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newBusinessCount rdf:type rdf:Property ;
    rdfs:label 'New Business Count' ;
    rdfs:comment 'Number of new business policies written during the statement period and included in this bill.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentReceivedAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Received Amount' ;
    rdfs:comment 'Total payments received from the producer during the statement period, applied against the outstanding balance.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTermsDays rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Days' ;
    rdfs:comment 'Number of days from the statement date within which payment is expected, defining the payment terms for the producer.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyCount rdf:type rdf:Property ;
    rdfs:label 'Policy Count' ;
    rdfs:comment 'Total number of policies included in this agency bill statement for the billing period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:premiumTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Tax Amount' ;
    rdfs:comment 'Total premium taxes applicable to the policies included in this agency bill statement.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:producerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Producer Contact Email' ;
    rdfs:comment 'Email address of the primary contact person at the producer agency for statement correspondence.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerContactName rdf:type rdf:Property ;
    rdfs:label 'Producer Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the producer agency for inquiries related to this statement.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Producer Contact Phone' ;
    rdfs:comment 'Phone number of the primary contact person at the producer agency for statement inquiries.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Status indicating whether the agency bill statement has been reconciled with producer records and payments.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalCount rdf:type rdf:Property ;
    rdfs:label 'Renewal Count' ;
    rdfs:comment 'Number of renewal policies processed during the statement period and included in this bill.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statementDate rdf:type rdf:Property ;
    rdfs:label 'Statement Date' ;
    rdfs:comment 'The date on which the agency bill statement was generated and issued to the producer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Statement Delivery Method' ;
    rdfs:comment 'The method by which this agency bill statement was delivered to the producer.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementFormat rdf:type rdf:Property ;
    rdfs:label 'Statement Format' ;
    rdfs:comment 'The file format in which the agency bill statement was generated and delivered.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementNumber rdf:type rdf:Property ;
    rdfs:label 'Statement Number' ;
    rdfs:comment 'Unique business identifier for the agency bill statement, typically formatted as a sequential or date-based code.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Statement Period End Date' ;
    rdfs:comment 'The ending date of the billing period covered by this agency bill statement.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Statement Period Start Date' ;
    rdfs:comment 'The beginning date of the billing period covered by this agency bill statement.' ;
    rdfs:domain ind:AgencyBillStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementStatus rdf:type rdf:Property ;
    rdfs:label 'Statement Status' ;
    rdfs:comment 'Current lifecycle status of the agency bill statement indicating its payment and processing state.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCountryId rdf:type rdf:Property ;
    rdfs:label 'Billing Country Id' ;
    rdfs:comment 'Foreign key linking to shared.country. Business justification: International billing requires country reference for address validation, regulatory jurisdiction, postal code format, and payment processing rules.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Country .

ind:billingCurrencyId rdf:type rdf:Property ;
    rdfs:label 'Billing Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: Billing in multiple currencies requires currency master for exchange rates, payment processing, and account balance calculation. Billing_currency_code denormalized, replace with FK.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:billingStateId rdf:type rdf:Property ;
    rdfs:label 'Billing State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Billing accounts need state reference for premium tax calculation, regulatory compliance, and address validation. Billing_state_code denormalized, replace with FK.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:State .

ind:accountName rdf:type rdf:Property ;
    rdfs:label 'Account Name' ;
    rdfs:comment 'Descriptive name for the billing account, typically matching the payer or primary insured name.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'Externally visible unique account number used for customer communication and payment reference.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the billing account reflecting payment standing and operational state.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the billing account based on the payer relationship and business segment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autopayFlag rdf:type rdf:Property ;
    rdfs:label 'Autopay Flag' ;
    rdfs:comment 'Indicates whether automatic payment is enabled for this billing account via bank draft or credit card.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line1' ;
    rdfs:comment 'First line of the billing address to which statements and notices are sent.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line2' ;
    rdfs:comment 'Second line of the billing address for suite, apartment, or additional location details.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCity rdf:type rdf:Property ;
    rdfs:label 'Billing City' ;
    rdfs:comment 'City name for the billing address.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactEmail rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Email' ;
    rdfs:comment 'Primary email address for billing communications, statements, and payment notifications.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactPhone rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Phone' ;
    rdfs:comment 'Primary phone number for billing inquiries and payment reminders.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Billing Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the billing address.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after the due date during which payment may be received without penalty or cancellation.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'Amount of the most recent payment received and posted to this billing account.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date on which the most recent payment was received and posted to this billing account.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastStatementDate rdf:type rdf:Property ;
    rdfs:label 'Last Statement Date' ;
    rdfs:comment 'Date on which the most recent billing statement was generated and sent to the payer.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextDueAmount rdf:type rdf:Property ;
    rdfs:label 'Next Due Amount' ;
    rdfs:comment 'Amount of the next scheduled installment payment due on this billing account.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Due Date' ;
    rdfs:comment 'Date on which the next installment payment is due for this billing account.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paperlessBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Flag' ;
    rdfs:comment 'Indicates whether the payer has elected to receive billing statements electronically instead of by mail.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pastDueAmount rdf:type rdf:Property ;
    rdfs:label 'Past Due Amount' ;
    rdfs:comment 'Portion of the current balance that is past the due date and subject to collection action.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Frequency' ;
    rdfs:comment 'Frequency at which premium installments are due on this billing account.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalBilledAmount rdf:type rdf:Property ;
    rdfs:label 'Total Billed Amount' ;
    rdfs:comment 'Cumulative amount billed to this account since inception, including all premium charges and fees.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Paid Amount' ;
    rdfs:comment 'Cumulative amount paid by the payer on this account since inception, including all applied payments.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unappliedPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Payment Amount' ;
    rdfs:comment 'Total amount of payments received but not yet applied to specific invoices or charges.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dacTransactionId rdf:type rdf:Property ;
    rdfs:label 'Dac Transaction Id' ;
    rdfs:comment 'Unique identifier for the DAC transaction record.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:premiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Premium Transaction Id' ;
    rdfs:comment 'Unique identifier of the transaction in the source system, used for reconciliation and audit trail purposes.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumTransaction .

ind:accountingStandard rdf:type rdf:Property ;
    rdfs:label 'Accounting Standard' ;
    rdfs:comment 'Accounting standard under which this DAC transaction is recorded: US GAAP ASC 944, IFRS 17, or Statutory Accounting Principles.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amortizationAmount rdf:type rdf:Property ;
    rdfs:label 'Amortization Amount' ;
    rdfs:comment 'Amount of DAC amortized in this transaction, expensed over the policy term in proportion to earned premium or expected gross profits.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amortizationMethod rdf:type rdf:Property ;
    rdfs:label 'Amortization Method' ;
    rdfs:comment 'Method used to amortize DAC: straight-line over policy term, proportional to earned premium, or proportional to expected gross profits per US GAAP ASC 944.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amortizationPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Amortization Period Months' ;
    rdfs:comment 'Total number of months over which the DAC asset is amortized, typically matching the policy term.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalizedAmount rdf:type rdf:Property ;
    rdfs:label 'Capitalized Amount' ;
    rdfs:comment 'Total acquisition cost amount capitalized as a DAC asset for the policy, including commissions, underwriting expenses, and other deferrable costs.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'Cost center or organizational unit code for financial reporting and expense allocation purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dacBalance rdf:type rdf:Property ;
    rdfs:label 'Dac Balance' ;
    rdfs:comment 'Remaining unamortized DAC asset balance after this transaction, representing future expense to be recognized.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impairmentAmount rdf:type rdf:Property ;
    rdfs:label 'Impairment Amount' ;
    rdfs:comment 'Amount of DAC impairment recognized if the recoverability test indicates the asset is not recoverable from future profits.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherAcquisitionCostAmount rdf:type rdf:Property ;
    rdfs:label 'Other Acquisition Cost Amount' ;
    rdfs:comment 'Other deferrable acquisition costs not classified as commission or underwriting expense, included in DAC capitalization.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Posted By User Code' ;
    rdfs:comment 'Identifier of the user or system account that posted this DAC transaction to the financial ledger.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoverabilityTestDate rdf:type rdf:Property ;
    rdfs:label 'Recoverability Test Date' ;
    rdfs:comment 'Date when the DAC asset recoverability test was last performed to ensure the asset is not impaired per US GAAP ASC 944.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoverabilityTestResult rdf:type rdf:Property ;
    rdfs:label 'Recoverability Test Result' ;
    rdfs:comment 'Result of the most recent DAC recoverability test: pass indicates no impairment, fail indicates write-down required.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'Business date when the DAC transaction occurred or was recognized for accounting purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:underwritingExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Underwriting Expense Amount' ;
    rdfs:comment 'Underwriting and policy issuance expenses that are deferrable and included in the DAC capitalization.' ;
    rdfs:domain ind:DacTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Amount of DAC written off due to policy cancellation, lapse, or other termination event before the end of the policy term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnedPremiumId rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Id' ;
    rdfs:comment 'Unique identifier for the earned premium transaction record.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalEarnedPremiumId rdf:type rdf:Property ;
    rdfs:label 'Original Earned Premium Id' ;
    rdfs:comment 'Reference to the original earned premium record if this is a reversal or adjustment.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EarnedPremium .

ind:adjustmentDescription rdf:type rdf:Property ;
    rdfs:label 'Adjustment Description' ;
    rdfs:comment 'Detailed explanation of any adjustment made to the earned premium calculation.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Code indicating the reason for any adjustment to the earned premium calculation.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Timestamp' ;
    rdfs:comment 'Date and time when the earned premium calculation was performed.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cededEpAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Ep Amount' ;
    rdfs:comment 'Portion of earned premium ceded to reinsurers during this period.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
