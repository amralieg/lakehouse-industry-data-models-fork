ind:peakStartTime rdf:type rdf:Property ;
    rdfs:label 'Peak Start Time' ;
    rdfs:comment 'Time when peak service period begins in HH:MM:SS format.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakEndTime rdf:type rdf:Property ;
    rdfs:label 'Peak End Time' ;
    rdfs:comment 'Time when peak service period ends in HH:MM:SS format.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyType rdf:type rdf:Property ;
    rdfs:label 'Frequency Type' ;
    rdfs:comment 'Indicates whether service operates on exact scheduled times or frequency-based intervals.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bikesAllowedFlag rdf:type rdf:Property ;
