    rdfs:comment 'Standard form number used for the E&O policy contract.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyType rdf:type rdf:Property ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'Type of E&O policy coverage structure.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorActsCoverage rdf:type rdf:Property ;
    rdfs:label 'Prior Acts Coverage' ;
    rdfs:comment 'Indicates whether the E&O policy includes coverage for acts prior to the policy effective date.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'Timestamp when this E&O policy record was first created in the system.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'Timestamp when this E&O policy record was last updated in the system.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:renewalNoticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Notice Sent Date' ;
    rdfs:comment 'Date when renewal notice was sent to the producer or agency.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateFilingConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'State Filing Confirmation Number' ;
    rdfs:comment 'Confirmation number received from state Department of Insurance for E&O policy filing.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFilingDate rdf:type rdf:Property ;
    rdfs:label 'State Filing Date' ;
    rdfs:comment 'Date when the E&O policy was filed with the state Department of Insurance.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateFilingRequired rdf:type rdf:Property ;
    rdfs:label 'State Filing Required' ;
    rdfs:comment 'Indicates whether this E&O policy must be filed with state Department of Insurance.' ;
    rdfs:domain ind:ErrorsOmissionsPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:producerAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Producer Appointment Id' ;
    rdfs:comment 'Unique identifier for the producer appointment record. Primary key.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Appointment Id' ;
    rdfs:comment 'Reference to the previous appointment record if this is a renewal or replacement.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducerAppointment .

ind:producerLicenseId rdf:type rdf:Property ;
    rdfs:label 'Producer License Id' ;
    rdfs:comment 'Foreign key linking to producers.producer_license. Business justification: Appointments are granted based on a valid license in that state and LOB. Links the appointment to the underlying license that authorizes the producer to sell. N:1 relationship.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducerLicense .

ind:appointmentAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Agreement Date' ;
    rdfs:comment 'Date when the appointment agreement was signed by both parties.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Appointment Agreement Number' ;
    rdfs:comment 'Reference number of the legal contract governing this appointment.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentNumber rdf:type rdf:Property ;
    rdfs:label 'Appointment Number' ;
    rdfs:comment 'Unique business identifier for this appointment issued by the insurer or state DOI.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentSource rdf:type rdf:Property ;
    rdfs:label 'Appointment Source' ;
    rdfs:comment 'Origin or method by which the producer appointment was established.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentStateCode rdf:type rdf:Property ;
    rdfs:label 'Appointment State Code' ;
    rdfs:comment 'Two-letter state code where the appointment is granted and registered.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentTier rdf:type rdf:Property ;
    rdfs:label 'Appointment Tier' ;
    rdfs:comment 'Performance or volume tier assigned to the producer for this appointment.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentType rdf:type rdf:Property ;
    rdfs:label 'Appointment Type' ;
    rdfs:comment 'Classification of the appointment relationship between producer and insurer.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiReportedDate rdf:type rdf:Property ;
    rdfs:label 'Doi Reported Date' ;
    rdfs:comment 'Date when the appointment was reported to the state Department of Insurance.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eoInsuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Eo Insurance Required Flag' ;
    rdfs:comment 'Indicates whether the producer must maintain E&O insurance as a condition of appointment.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eoMinimumCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Eo Minimum Coverage Amount' ;
    rdfs:comment 'Minimum E&O insurance coverage amount required to maintain the appointment.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:niprTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Nipr Transaction Number' ;
    rdfs:comment 'Unique transaction identifier assigned by NIPR for this appointment filing.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Flag' ;
    rdfs:comment 'Indicates whether this appointment is a renewal of a prior appointment.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationForCauseFlag rdf:type rdf:Property ;
    rdfs:label 'Termination For Cause Flag' ;
    rdfs:comment 'Indicates whether the appointment was terminated for cause requiring regulatory reporting.' ;
    rdfs:domain ind:ProducerAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:producerComplianceEventId rdf:type rdf:Property ;
    rdfs:label 'Producer Compliance Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each producer compliance event record. Primary key. One row per compliance-relevant event per producer.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealFiled rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed' ;
    rdfs:comment 'Indicates whether the producer has filed a formal appeal against this compliance event or DOI action.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealResolution rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolution' ;
    rdfs:comment 'Outcome of the producer\'s appeal against this compliance event. Populated only when appeal_filed is True and the appeal has been adjudicated.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolution Date' ;
    rdfs:comment 'Date on which the appeal was formally resolved. Populated when appeal_resolution is not PENDING.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Appointment Eligibility Flag' ;
    rdfs:comment 'Indicates whether the producer remains eligible for appointment following this compliance event. False if DOI action, adverse background check, or termination for cause.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backgroundCheckResult rdf:type rdf:Property ;
    rdfs:label 'Background Check Result' ;
    rdfs:comment 'Outcome of the background check screening. ADVERSE results may trigger appointment ineligibility review per NAIC and state DOI guidelines.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckVendor rdf:type rdf:Property ;
    rdfs:label 'Background Check Vendor' ;
    rdfs:comment 'Name of the third-party vendor that conducted the background check. Populated for BACKGROUND_CHECK event types.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceCourseCode rdf:type rdf:Property ;
    rdfs:label 'Ce Course Code' ;
    rdfs:comment 'State-assigned or provider-assigned identifier for the CE course completed. Used for regulatory verification of CE compliance.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceCourseName rdf:type rdf:Property ;
    rdfs:label 'Ce Course Name' ;
    rdfs:comment 'Name of the continuing education course completed by the producer. Populated for CE_COMPLETION event types.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceCreditHours rdf:type rdf:Property ;
    rdfs:label 'Ce Credit Hours' ;
    rdfs:comment 'Number of CE credit hours earned by the producer for this course or event. Contributes to the state-mandated CE hour requirement.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceProviderName rdf:type rdf:Property ;
    rdfs:label 'Ce Provider Name' ;
    rdfs:comment 'Name of the approved CE provider or institution that delivered the course. Used for provider compliance verification.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiActionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Doi Action Effective Date' ;
    rdfs:comment 'Date on which the DOI regulatory action became effective. Used to determine the period during which the producer was subject to the action.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiActionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Doi Action Expiration Date' ;
    rdfs:comment 'Date on which the DOI regulatory action expires or is lifted. Null if the action is permanent or ongoing.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiActionNumber rdf:type rdf:Property ;
    rdfs:label 'Doi Action Number' ;
    rdfs:comment 'Official reference or docket number assigned by the DOI for the regulatory action. Used for regulatory audit trail and cross-referencing.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiActionType rdf:type rdf:Property ;
    rdfs:label 'Doi Action Type' ;
    rdfs:comment 'Type of regulatory action taken by the DOI against the producer. Populated for DOI_ACTION event types. Drives appointment eligibility flags.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDate rdf:type rdf:Property ;
    rdfs:label 'Event Date' ;
    rdfs:comment 'The real-world date on which the compliance event occurred or was formally recorded (e.g., CE course completion date, DOI action effective date).' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventNotes rdf:type rdf:Property ;
    rdfs:label 'Event Notes' ;
    rdfs:comment 'Free-text notes or narrative details recorded by compliance staff regarding this event. Supports audit trail and investigative context.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSubtype rdf:type rdf:Property ;
    rdfs:label 'Event Subtype' ;
    rdfs:comment 'Further classification within the event type (e.g., for DOI_ACTION: SUSPENSION, REVOCATION, FINE, CEASE_AND_DESIST; for CE_COMPLETION: ETHICS, FLOOD, GENERAL). [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'Precise date and time the compliance event was captured or reported in the Producer/Agency Management System, including timezone offset.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fineAmount rdf:type rdf:Property ;
    rdfs:label 'Fine Amount' ;
    rdfs:comment 'Monetary fine assessed against the producer as part of a DOI action. Expressed in USD. Populated for DOI_ACTION events with FINE subtype.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:licenseRenewalDate rdf:type rdf:Property ;
    rdfs:label 'License Renewal Date' ;
    rdfs:comment 'Date on which the producer license was successfully renewed. Populated for LICENSE_RENEWAL event types upon completion.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportedDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reported Date' ;
    rdfs:comment 'Date on which this compliance event was reported to the state DOI or NIPR. Null if not yet reported or reporting not required.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedBy rdf:type rdf:Property ;
    rdfs:label 'Reported By' ;
    rdfs:comment 'The party or system that reported or initiated this compliance event. Supports audit trail and source-of-truth tracking.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingStateCode rdf:type rdf:Property ;
    rdfs:label 'Reporting State Code' ;
    rdfs:comment 'Two-letter US state code of the Department of Insurance or jurisdiction that issued, recorded, or is the subject of this compliance event.' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceEventReference rdf:type rdf:Property ;
    rdfs:label 'Source Event Reference' ;
    rdfs:comment 'The native identifier of this event in the originating source system (e.g., NIPR transaction ID, DOI docket number, agency management system record ID).' ;
    rdfs:domain ind:ProducerComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceDueDate rdf:type rdf:Property ;
    rdfs:label 'Ce Due Date' ;
    rdfs:comment 'Date by which continuing education requirements must be completed for renewal.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ceEthicsHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Ethics Hours Required' ;
    rdfs:comment 'Ethics-specific continuing education hours required for license renewal in this state.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceHoursCompleted rdf:type rdf:Property ;
    rdfs:label 'Ce Hours Completed' ;
    rdfs:comment 'Total continuing education hours completed toward current renewal cycle.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Hours Required' ;
    rdfs:comment 'Total continuing education hours required for license renewal in this state.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:denialDate rdf:type rdf:Property ;
    rdfs:label 'Denial Date' ;
    rdfs:comment 'Date the license application was denied by the state Department of Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiActionDate rdf:type rdf:Property ;
    rdfs:label 'Doi Action Date' ;
    rdfs:comment 'Date the regulatory action was taken by the state Department of Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiActionDescription rdf:type rdf:Property ;
    rdfs:label 'Doi Action Description' ;
    rdfs:comment 'Detailed description of the regulatory action taken by the state Department of Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiActionFlag rdf:type rdf:Property ;
    rdfs:label 'Doi Action Flag' ;
    rdfs:comment 'Indicates whether any regulatory action has been taken against this license by the state DOI.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fingerprintDate rdf:type rdf:Property ;
    rdfs:label 'Fingerprint Date' ;
    rdfs:comment 'Date fingerprints were submitted to the state Department of Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fingerprintRequired rdf:type rdf:Property ;
    rdfs:label 'Fingerprint Required' ;
    rdfs:comment 'Indicates whether the state requires fingerprinting for this license.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loaCasualty rdf:type rdf:Property ;
    rdfs:label 'Loa Casualty' ;
    rdfs:comment 'Indicates whether the license includes authority to sell casualty insurance lines.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loaHealth rdf:type rdf:Property ;
    rdfs:label 'Loa Health' ;
    rdfs:comment 'Indicates whether the license includes authority to sell health insurance products.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loaLife rdf:type rdf:Property ;
    rdfs:label 'Loa Life' ;
    rdfs:comment 'Indicates whether the license includes authority to sell life insurance products.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loaPersonalLines rdf:type rdf:Property ;
    rdfs:label 'Loa Personal Lines' ;
    rdfs:comment 'Indicates whether the license includes authority to sell personal lines insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loaProperty rdf:type rdf:Property ;
    rdfs:label 'Loa Property' ;
    rdfs:comment 'Indicates whether the license includes authority to sell property insurance lines.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loaVariableAnnuity rdf:type rdf:Property ;
    rdfs:label 'Loa Variable Annuity' ;
    rdfs:comment 'Indicates whether the license includes authority to sell variable annuity products.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reciprocityStateCode rdf:type rdf:Property ;
    rdfs:label 'Reciprocity State Code' ;
    rdfs:comment 'Two-letter state code of the resident state if this is a non-resident license granted through reciprocity.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerPerformanceId rdf:type rdf:Property ;
    rdfs:label 'Producer Performance Id' ;
    rdfs:comment 'Unique identifier for the producer performance record. Primary key.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:producerTierId rdf:type rdf:Property ;
    rdfs:label 'Producer Tier Id' ;
    rdfs:comment 'Foreign key linking to producers.producer_tier. Business justification: Performance evaluations assign a tier to the producer based on performance criteria. Replace STRING tier_assignment and tier_definition_code with FK to producer_tier. N:1 relationship.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducerTier .

ind:averageClaimSeverity rdf:type rdf:Property ;
    rdfs:label 'Average Claim Severity' ;
    rdfs:comment 'Average incurred loss per claim for policies produced by the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averagePolicyPremium rdf:type rdf:Property ;
    rdfs:label 'Average Policy Premium' ;
    rdfs:comment 'Average written premium per policy for the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationCount rdf:type rdf:Property ;
    rdfs:label 'Cancellation Count' ;
    rdfs:comment 'Number of policies cancelled during the evaluation period for this producer.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimCount rdf:type rdf:Property ;
    rdfs:label 'Claim Count' ;
    rdfs:comment 'Number of claims reported for policies produced by the producer during the evaluation period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimFrequency rdf:type rdf:Property ;
    rdfs:label 'Claim Frequency' ;
    rdfs:comment 'Number of claims per policy in force for the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:combinedRatio rdf:type rdf:Property ;
    rdfs:label 'Combined Ratio' ;
    rdfs:comment 'Sum of loss ratio and expense ratio for the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionEarnedAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Earned Amount' ;
    rdfs:comment 'Total commission earned by the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceViolationsCount rdf:type rdf:Property ;
    rdfs:label 'Compliance Violations Count' ;
    rdfs:comment 'Number of compliance violations recorded for the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contingentCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Amount' ;
    rdfs:comment 'Contingent commission earned by the producer based on performance during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerComplaintCount rdf:type rdf:Property ;
    rdfs:label 'Customer Complaint Count' ;
    rdfs:comment 'Number of customer complaints filed against the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dwpAmount rdf:type rdf:Property ;
    rdfs:label 'Dwp Amount' ;
    rdfs:comment 'Direct premium written by the producer before reinsurance during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eoClaimCount rdf:type rdf:Property ;
    rdfs:label 'Eo Claim Count' ;
    rdfs:comment 'Number of errors and omissions claims filed against the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evaluationPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period End Date' ;
    rdfs:comment 'End date of the performance evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period Start Date' ;
    rdfs:comment 'Start date of the performance evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationStatus rdf:type rdf:Property ;
    rdfs:label 'Evaluation Status' ;
    rdfs:comment 'Current status of the performance evaluation record.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseRatio rdf:type rdf:Property ;
    rdfs:label 'Expense Ratio' ;
    rdfs:comment 'Ratio of underwriting expenses to written premium for the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lobMixScore rdf:type rdf:Property ;
    rdfs:label 'Lob Mix Score' ;
    rdfs:comment 'Score reflecting the diversity and strategic alignment of lines of business written by the producer.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newBusinessCount rdf:type rdf:Property ;
    rdfs:label 'New Business Count' ;
    rdfs:comment 'Number of new business policies written by the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paidLossesAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Losses Amount' ;
    rdfs:comment 'Total paid losses for policies produced by the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceScore rdf:type rdf:Property ;
    rdfs:label 'Performance Score' ;
    rdfs:comment 'Composite performance score calculated from weighted metrics for the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pifCount rdf:type rdf:Property ;
    rdfs:label 'Pif Count' ;
    rdfs:comment 'Number of active policies in force at the end of the evaluation period for this producer.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quoteCount rdf:type rdf:Property ;
    rdfs:label 'Quote Count' ;
    rdfs:comment 'Number of quotes generated by the producer during the evaluation period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quoteToBindRatio rdf:type rdf:Property ;
    rdfs:label 'Quote To Bind Ratio' ;
    rdfs:comment 'Percentage of quotes that resulted in bound policies during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rankWithinAgency rdf:type rdf:Property ;
    rdfs:label 'Rank Within Agency' ;
    rdfs:comment 'Producers rank within their agency based on performance score for the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rankWithinRegion rdf:type rdf:Property ;
    rdfs:label 'Rank Within Region' ;
    rdfs:comment 'Producers rank within their geographic region based on performance score for the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalCount rdf:type rdf:Property ;
    rdfs:label 'Renewal Count' ;
    rdfs:comment 'Number of policies renewed by the producer during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retentionRate rdf:type rdf:Property ;
    rdfs:label 'Retention Rate' ;
    rdfs:comment 'Percentage of policies retained at renewal during the evaluation period.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Tier Effective Date' ;
    rdfs:comment 'Date when the assigned tier becomes effective for the producer.' ;
    rdfs:domain ind:ProducerPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:producersProducerPolicyId rdf:type rdf:Property ;
    rdfs:label 'Producers Producer Policy Id' ;
    rdfs:comment 'Unique identifier for the producer-policy association record. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducerPolicy .

ind:priorProducerPolicyId rdf:type rdf:Property ;
    rdfs:label 'Prior Producer Policy Id' ;
    rdfs:comment 'Foreign key to the previous producer-policy record this assignment replaces, used to maintain historical chain of producer assignments.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:supersededByProducerPolicyProducersProducerPolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Producer Policy Producers Producer Policy Id' ;
    rdfs:comment 'Foreign key to the producer-policy record that supersedes this assignment, used to track broker of record changes and producer reassignments.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducerPolicy .

ind:appointmentVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Verification Date' ;
    rdfs:comment 'Date when the producer appointment was last verified for this policy.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Appointment Verified Flag' ;
    rdfs:comment 'Indicates whether the producer appointment with the writing company has been verified for this policy.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason Code' ;
    rdfs:comment 'Code indicating the reason for this producer assignment: initial sale, broker of record change, servicing transfer, or split commission arrangement.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSourceCode rdf:type rdf:Property ;
    rdfs:label 'Assignment Source Code' ;
    rdfs:comment 'Source system or process that created this producer-policy assignment: policy issuance, broker of record change, endorsement, renewal, or manual adjustment.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideCommissionFlag rdf:type rdf:Property ;
    rdfs:label 'Override Commission Flag' ;
    rdfs:comment 'Indicates whether the commission rate for this producer-policy assignment overrides the default schedule rate.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideReasonCode rdf:type rdf:Property ;
    rdfs:label 'Override Reason Code' ;
    rdfs:comment 'Code indicating the reason for commission rate override, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryProducerFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Producer Flag' ;
    rdfs:comment 'Indicates whether this producer is the primary producer of record for the policy. Only one producer per policy should have this flag set to true.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:producerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Producer License Number' ;
    rdfs:comment 'State-issued license number of the producer for the jurisdiction where the policy is written.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerLicenseStateCode rdf:type rdf:Property ;
    rdfs:label 'Producer License State Code' ;
    rdfs:comment 'Two-letter state code where the producer holds the license applicable to this policy.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerRoleCode rdf:type rdf:Property ;
    rdfs:label 'Producer Role Code' ;
    rdfs:comment 'Role the producer plays on this policy: writing agent, servicing agent, broker of record, sub-producer, referring agent, or managing general agent.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerRoleDescription rdf:type rdf:Property ;
    rdfs:label 'Producer Role Description' ;
    rdfs:comment 'Detailed description of the producer role and responsibilities on this policy.' ;
    rdfs:domain ind:ProducersProducerPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicingProducerFlag rdf:type rdf:Property ;
    rdfs:label 'Servicing Producer Flag' ;
    rdfs:comment 'Indicates whether this producer is responsible for ongoing policy servicing and customer support.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoDowngradeEligible rdf:type rdf:Property ;
    rdfs:label 'Auto Downgrade Eligible' ;
    rdfs:comment 'Indicates whether producers in this tier are automatically downgraded to lower tiers upon failing to meet criteria.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoUpgradeEligible rdf:type rdf:Property ;
    rdfs:label 'Auto Upgrade Eligible' ;
    rdfs:comment 'Indicates whether producers in this tier are automatically considered for upgrade to higher tiers upon meeting criteria.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bonusEligible rdf:type rdf:Property ;
    rdfs:label 'Bonus Eligible' ;
    rdfs:comment 'Indicates whether producers in this tier qualify for performance bonus programs.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionOverrideRate rdf:type rdf:Property ;
    rdfs:label 'Commission Override Rate' ;
    rdfs:comment 'Default commission rate override percentage applied to producers in this tier, expressed as decimal (e.g., 0.0250 for 2.5%).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dedicatedSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Dedicated Support Flag' ;
    rdfs:comment 'Indicates whether producers in this tier receive dedicated account management or underwriting support.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evaluationPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period Months' ;
    rdfs:comment 'Number of months over which producer performance is evaluated for tier assignment or maintenance.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lobRestrictions rdf:type rdf:Property ;
    rdfs:label 'Lob Restrictions' ;
    rdfs:comment 'Comma-separated list of line of business codes that producers in this tier are restricted from writing.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingSupportLevel rdf:type rdf:Property ;
    rdfs:label 'Marketing Support Level' ;
    rdfs:comment 'Level of marketing and promotional support provided to producers in this tier (basic, standard, premium, platinum).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumLossRatioThreshold rdf:type rdf:Property ;
    rdfs:label 'Maximum Loss Ratio Threshold' ;
    rdfs:comment 'Maximum acceptable loss ratio for producers in this tier, expressed as decimal (e.g., 0.6500 for 65%).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumGwpThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Gwp Threshold' ;
    rdfs:comment 'Minimum annual gross written premium required to qualify for or maintain this tier, in USD.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPolicyCountThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Policy Count Threshold' ;
    rdfs:comment 'Minimum number of active policies required to qualify for or maintain this tier.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumRetentionRateThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Retention Rate Threshold' ;
    rdfs:comment 'Minimum policy retention rate required to qualify for or maintain this tier, expressed as decimal (e.g., 0.8500 for 85%).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorityServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Service Flag' ;
    rdfs:comment 'Indicates whether producers in this tier receive priority processing for quotes, endorsements, and claims.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:probationPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Probation Period Months' ;
    rdfs:comment 'Number of months a producer remains in probationary status before tier re-evaluation, if applicable.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialProgramAccess rdf:type rdf:Property ;
    rdfs:label 'Special Program Access' ;
    rdfs:comment 'Comma-separated list of special underwriting programs or niche products accessible to producers in this tier.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technologyAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Technology Access Level' ;
    rdfs:comment 'Level of technology tools and digital platforms available to producers in this tier (basic, standard, advanced, premium).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryRestrictions rdf:type rdf:Property ;
    rdfs:label 'Territory Restrictions' ;
    rdfs:comment 'Comma-separated list of territory or state codes where producers in this tier have writing restrictions.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierCode rdf:type rdf:Property ;
    rdfs:label 'Tier Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the tier (e.g., PREF, STD, PROB, ELITE, BRONZE).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierDescription rdf:type rdf:Property ;
    rdfs:label 'Tier Description' ;
    rdfs:comment 'Detailed description of the tier classification, including eligibility criteria and benefits.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierName rdf:type rdf:Property ;
    rdfs:label 'Tier Name' ;
    rdfs:comment 'Full business name of the tier (e.g., Preferred, Standard, Probationary, Elite, Bronze).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierRank rdf:type rdf:Property ;
    rdfs:label 'Tier Rank' ;
    rdfs:comment 'Numeric ranking of the tier within the hierarchy, where lower numbers indicate higher performance tiers.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierStatus rdf:type rdf:Property ;
    rdfs:label 'Tier Status' ;
    rdfs:comment 'Current lifecycle status of the tier definition (active, inactive, suspended, retired).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Training Access Level' ;
    rdfs:comment 'Level of training programs and educational resources available to producers in this tier.' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Underwriting Authority Level' ;
    rdfs:comment 'Level of underwriting authority granted to producers in this tier (none, limited, standard, enhanced, full).' ;
    rdfs:domain ind:ProducerTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountReference rdf:type rdf:Property ;
    rdfs:label 'Bank Account Reference' ;
    rdfs:comment 'Tokenized or masked reference to the producer\'s bank account used for ACH commission disbursements. Full account data stored in payment vault.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingEducationHoursCompleted rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Hours Completed' ;
    rdfs:comment 'Number of continuing education credit hours completed in the current CE cycle. Tracked against state-mandated minimums.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isSurplusLinesLicensed rdf:type rdf:Property ;
    rdfs:label 'Is Surplus Lines Licensed' ;
    rdfs:comment 'Indicates whether the producer holds a surplus lines broker license, enabling placement of non-admitted coverage.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'License Effective Date' ;
    rdfs:comment 'Date the producer\'s resident state license became effective. Used to verify active licensure at time of policy binding.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:producerRole rdf:type rdf:Property ;
    rdfs:label 'Producer Role' ;
    rdfs:comment 'Functional role of the producer in the distribution channel. [ENUM-REF-CANDIDATE: agent|broker|managing_general_agent|surplus_lines_broker|independent_agent|captive_agent — promote to reference product]' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerType rdf:type rdf:Property ;
    rdfs:label 'Producer Type' ;
    rdfs:comment 'Indicates whether the producer is a natural person (individual) or a business entity (agency/firm). Drives licensing and appointment rules.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryActionFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Flag' ;
    rdfs:comment 'Indicates whether the producer has any open or historical regulatory actions, fines, or license sanctions on record.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sinceDate rdf:type rdf:Property ;
    rdfs:label 'Since Date' ;
    rdfs:comment 'Date the producer first became appointed with Pc_Insurance. Used for tenure-based commission tier calculations and relationship analytics.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:underwritingAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Authority Id' ;
    rdfs:comment 'Unique identifier for the underwriting authority grant record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnderwritingAuthority .

ind:auditFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Frequency' ;
    rdfs:comment 'Frequency at which policies bound under this authority must be audited: monthly, quarterly, semi-annual, annual, or per policy.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditRequired rdf:type rdf:Property ;
    rdfs:label 'Audit Required' ;
    rdfs:comment 'Indicates whether policies bound under this authority require post-binding underwriting audit or review.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorityStatus rdf:type rdf:Property ;
    rdfs:label 'Authority Status' ;
    rdfs:comment 'Current lifecycle status of the underwriting authority grant.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityType rdf:type rdf:Property ;
    rdfs:label 'Authority Type' ;
    rdfs:comment 'Classification of the authority level granted: binding, quoting, referral, limited binding, full binding, or conditional.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blanketCoverageAllowed rdf:type rdf:Property ;
    rdfs:label 'Blanket Coverage Allowed' ;
    rdfs:comment 'Indicates whether the producer may bind blanket coverage policies under this authority.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationAllowed rdf:type rdf:Property ;
    rdfs:label 'Cancellation Allowed' ;
    rdfs:comment 'Indicates whether this authority permits canceling policies.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coinsuranceAllowed rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Allowed' ;
    rdfs:comment 'Indicates whether the producer may bind policies with coinsurance clauses under this authority.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:constructionRestrictions rdf:type rdf:Property ;
    rdfs:label 'Construction Restrictions' ;
    rdfs:comment 'Construction types or building classes excluded from this authority per COPE criteria.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleMax rdf:type rdf:Property ;
    rdfs:label 'Deductible Max' ;
    rdfs:comment 'Maximum deductible amount the producer may offer when binding coverage under this authority.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleMin rdf:type rdf:Property ;
    rdfs:label 'Deductible Min' ;
    rdfs:comment 'Minimum deductible amount the producer must apply when binding coverage under this authority.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleStates rdf:type rdf:Property ;
    rdfs:label 'Eligible States' ;
    rdfs:comment 'Comma-separated list of state codes where this authority is valid and may be exercised.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementAllowed rdf:type rdf:Property ;
    rdfs:label 'Endorsement Allowed' ;
    rdfs:comment 'Indicates whether this authority permits issuing policy endorsements.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:excludedStates rdf:type rdf:Property ;
    rdfs:label 'Excluded States' ;
    rdfs:comment 'Comma-separated list of state codes explicitly excluded from this authority grant.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitTier rdf:type rdf:Property ;
    rdfs:label 'Limit Tier' ;
    rdfs:comment 'Tiered classification of authority limits: tier 1 (lowest), tier 2, tier 3, tier 4, or unlimited.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxPremiumThreshold rdf:type rdf:Property ;
    rdfs:label 'Max Premium Threshold' ;
    rdfs:comment 'Maximum written premium amount the producer may bind without underwriting referral.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxSingleRiskLimit rdf:type rdf:Property ;
    rdfs:label 'Max Single Risk Limit' ;
    rdfs:comment 'Maximum policy limit the producer may bind on a single insured risk without referral to underwriting.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTiv rdf:type rdf:Property ;
    rdfs:label 'Max Tiv' ;
    rdfs:comment 'Maximum total insured value the producer may bind without underwriting referral.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minPremiumThreshold rdf:type rdf:Property ;
    rdfs:label 'Min Premium Threshold' ;
    rdfs:comment 'Minimum written premium amount required for the producer to exercise binding authority on a policy.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newBusinessAllowed rdf:type rdf:Property ;
    rdfs:label 'New Business Allowed' ;
    rdfs:comment 'Indicates whether this authority permits binding new business policies.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occupancyRestrictions rdf:type rdf:Property ;
    rdfs:label 'Occupancy Restrictions' ;
    rdfs:comment 'Specific occupancy types or uses excluded from this binding authority per Construction, Occupancy, Protection, Exposure (COPE) criteria.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionClassMax rdf:type rdf:Property ;
    rdfs:label 'Protection Class Max' ;
    rdfs:comment 'Maximum ISO protection class rating allowed for binding under this authority without referral.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protectionClassMin rdf:type rdf:Property ;
    rdfs:label 'Protection Class Min' ;
    rdfs:comment 'Minimum ISO protection class rating required for the producer to bind coverage under this authority.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralCriteria rdf:type rdf:Property ;
    rdfs:label 'Referral Criteria' ;
    rdfs:comment 'Business rules or conditions that trigger mandatory referral to underwriting despite binding authority.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementAllowed rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Allowed' ;
    rdfs:comment 'Indicates whether this authority permits reinstating lapsed or canceled policies.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalAllowed rdf:type rdf:Property ;
    rdfs:label 'Renewal Allowed' ;
    rdfs:comment 'Indicates whether this authority permits binding renewal policies.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalEligible rdf:type rdf:Property ;
    rdfs:label 'Renewal Eligible' ;
    rdfs:comment 'Indicates whether this authority grant is eligible for renewal upon expiration.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date when the underwriting authority was revoked or terminated prior to expiration.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revocationReason rdf:type rdf:Property ;
    rdfs:label 'Revocation Reason' ;
    rdfs:comment 'Business reason or cause for revoking the underwriting authority prior to expiration.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskClassRestrictions rdf:type rdf:Property ;
    rdfs:label 'Risk Class Restrictions' ;
    rdfs:comment 'Comma-separated list of risk classes or NAICS codes for which this authority is restricted or excluded.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bordereauxBrokerPartyId rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Broker Party Id' ;
    rdfs:comment 'Reference to the reinsurance broker party facilitating this bordereaux submission, if applicable.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:bordereauxPartyId rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Party Id' ;
    rdfs:comment 'Reference to the ceding company party submitting this bordereaux.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorBordereauxId rdf:type rdf:Property ;
    rdfs:label 'Prior Bordereaux Id' ;
    rdfs:comment 'Reference to the previous bordereaux submission this amendment replaces, if applicable.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bordereaux .

ind:acceptedDate rdf:type rdf:Property ;
    rdfs:label 'Accepted Date' ;
    rdfs:comment 'Date the bordereaux submission was accepted by the reinsurer.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Sequential number indicating how many times this bordereaux has been amended. Zero for original submission.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bordereauxStatus rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Status' ;
    rdfs:comment 'Current status of the bordereaux submission in its lifecycle.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededEarnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Earned Premium Amount' ;
    rdfs:comment 'Total ceded earned premium amount reported in this bordereaux for the reporting period.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededOutstandingLossReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Outstanding Loss Reserve Amount' ;
    rdfs:comment 'Total ceded outstanding loss reserve amount reported in this bordereaux as of the reporting period end date.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededUlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Ulae Amount' ;
    rdfs:comment 'Total ceded unallocated loss adjustment expense amount reported in this bordereaux for the reporting period.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededUnearnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Unearned Premium Amount' ;
    rdfs:comment 'Total ceded unearned premium amount reported in this bordereaux as of the reporting period end date.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededWrittenPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Written Premium Amount' ;
    rdfs:comment 'Total ceded written premium amount reported in this bordereaux for the reporting period.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalizedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Finalized Timestamp' ;
    rdfs:comment 'Timestamp when this bordereaux submission was finalized and locked from further changes.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:netBalanceDueAmount rdf:type rdf:Property ;
    rdfs:label 'Net Balance Due Amount' ;
    rdfs:comment 'Net amount due to or from the reinsurer based on this bordereaux submission, after offsetting premium and loss amounts.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preparedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Prepared By User Code' ;
    rdfs:comment 'Identifier of the user who prepared this bordereaux submission.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectedDate rdf:type rdf:Property ;
    rdfs:label 'Rejected Date' ;
    rdfs:comment 'Date the bordereaux submission was rejected by the reinsurer, if applicable.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'End date of the period covered by this bordereaux submission.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'Start date of the period covered by this bordereaux submission.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionFormat rdf:type rdf:Property ;
    rdfs:label 'Submission Format' ;
    rdfs:comment 'Data format used for the bordereaux submission. [ENUM-REF-CANDIDATE: acord|proprietary|excel|csv|xml|json|pdf — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'Method used to submit the bordereaux to the reinsurer.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyLayerId rdf:type rdf:Property ;
    rdfs:label 'Treaty Layer Id' ;
    rdfs:comment 'Reference to the specific treaty layer (e.g., first excess layer, second excess layer) within the reinsurance agreement to which this cession attaches.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatyLayer .

ind:bookingDate rdf:type rdf:Property ;
    rdfs:label 'Booking Date' ;
    rdfs:comment 'Date on which this cession was recorded in the Reinsurance Management System and booked to the general ledger for statutory reporting.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cededCaseReserve rdf:type rdf:Property ;
    rdfs:label 'Ceded Case Reserve' ;
    rdfs:comment 'Reinsurer\'s share of the case reserve for known reported losses ceded under this cession. Used for ceded reserve reporting on Schedule F.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededGwp rdf:type rdf:Property ;
    rdfs:label 'Ceded Gwp' ;
    rdfs:comment 'Gross Written Premium (GWP) ceded to the reinsurer for this policy term. Represents the cedant\'s cost of reinsurance before ceding commission.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededIbnrReserve rdf:type rdf:Property ;
    rdfs:label 'Ceded Ibnr Reserve' ;
    rdfs:comment 'Reinsurer\'s share of the IBNR reserve for losses incurred but not yet reported under this cession. Required for ceded IBNR disclosure on Schedule F.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLimit rdf:type rdf:Property ;
    rdfs:label 'Ceded Limit' ;
    rdfs:comment 'Maximum reinsurer liability under this cession. For XOL treaties, this is the layer limit; for QS, it is the proportional share of the policy limit.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededTiv rdf:type rdf:Property ;
    rdfs:label 'Ceded Tiv' ;
    rdfs:comment 'Total Insured Value (TIV) transferred to the reinsurer under this cession. Represents the gross exposure ceded for property lines.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Pct' ;
    rdfs:comment 'Ceding commission expressed as a percentage of ceded written premium. Used to calculate the ceding commission amount for QS treaties.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralType rdf:type rdf:Property ;
    rdfs:label 'Collateral Type' ;
    rdfs:comment 'Type of collateral instrument posted by the reinsurer to secure obligations. Required for unauthorized reinsurers per NAIC credit for reinsurance rules.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
    rdfs:comment 'Indicates whether this is an outward cession (cedant to reinsurer) or a retrocession (reinsurer ceding further). Distinguishes primary cession from retro.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exhaustionPoint rdf:type rdf:Property ;
    rdfs:label 'Exhaustion Point' ;
    rdfs:comment 'Dollar amount at which the reinsurer\'s layer is fully exhausted (attachment point plus ceded limit). Defines the upper boundary of the reinsurer\'s liability.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundsHeldAmount rdf:type rdf:Property ;
    rdfs:label 'Funds Held Amount' ;
    rdfs:comment 'Amount of reinsurance premium held by the cedant as funds held under the reinsurance agreement, rather than remitted to the reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCatastropheCession rdf:type rdf:Property ;
    rdfs:label 'Is Catastrophe Cession' ;
    rdfs:comment 'Indicates whether this cession is associated with a catastrophe event (CAT XL treaty). Flags cessions for CAT PML aggregation and catastrophe bordereaux reporting.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateOnLine rdf:type rdf:Property ;
    rdfs:label 'Rate On Line' ;
    rdfs:comment 'Rate on Line (ROL) expressed as a percentage of the ceded limit. Key pricing metric for XOL and CAT XL layers; equals ceded premium divided by ceded limit.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceCessionStatus rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Status' ;
    rdfs:comment 'Current lifecycle state of the cession record within the reinsurance management workflow.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Authorization Status' ;
    rdfs:comment 'NAIC authorization classification of the assuming reinsurer: authorized, accredited, certified, unauthorized, or reciprocal. Drives collateral and credit requirements.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerDomicileCountry rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Domicile Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the reinsurer\'s domicile. Determines whether the reinsurer is authorized, accredited, or unauthorized under NAIC Schedule F.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerNaicCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code of the assuming reinsurer. Required for NAIC Schedule F statutory reporting and reinsurer credit risk assessment.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharePct rdf:type rdf:Property ;
    rdfs:label 'Share Pct' ;
    rdfs:comment 'Proportional share (as a percentage) ceded to the reinsurer. Applicable for Quota Share treaties. For XOL, this represents the reinsurer\'s participation percentage in the layer.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateNetLoss rdf:type rdf:Property ;
    rdfs:label 'Ultimate Net Loss' ;
    rdfs:comment 'Ultimate Net Loss (UNL) ceded under this cession, representing the reinsurer\'s share of total incurred losses including LAE. Key metric for XOL treaty performance.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facBrokerPartyId rdf:type rdf:Property ;
    rdfs:label 'Fac Broker Party Id' ;
    rdfs:comment 'Reference to the party record for the reinsurance intermediary/broker who placed this FAC agreement on behalf of the cedant.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:facCedantPartyId rdf:type rdf:Property ;
    rdfs:label 'Fac Cedant Party Id' ;
    rdfs:comment 'Reference to the party record representing the ceding insurer (Pc_Insurance) transferring risk under this FAC agreement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:facReinsurerPartyId rdf:type rdf:Property ;
    rdfs:label 'Fac Reinsurer Party Id' ;
    rdfs:comment 'Reference to the party record representing the assuming reinsurer accepting the ceded risk under this FAC placement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:uwReferralId rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Id' ;
    rdfs:comment 'Foreign key linking to coverage.uw_referral. Business justification: High-risk submissions triggering underwriting referrals often require facultative reinsurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UwReferral .

ind:authorizedReinsurerFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Reinsurer Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is authorized/accredited in the cedant\'s state of domicile. Affects Schedule F credit and collateral requirements.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokerCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Broker Commission Rate' ;
    rdfs:comment 'Percentage of ceded premium payable to the reinsurance broker as intermediary commission for placing this FAC agreement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Amount' ;
    rdfs:comment 'Dollar amount of premium ceded to the reinsurer under this FAC agreement. Reduces net written premium (NWP) for the cedant.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Fac Certificate Number' ;
    rdfs:comment 'Certificate number issued by the reinsurer confirming acceptance of the facultative placement. Used for claims recovery and bordereaux reconciliation.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facPremiumRate rdf:type rdf:Property ;
    rdfs:label 'Fac Premium Rate' ;
    rdfs:comment 'Rate applied to the ceded limit or TIV to derive the FAC reinsurance premium. Expressed as a decimal (e.g., 0.005000 = 0.50%). Also known as Rate on Line (ROL) for XOL placements.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Fac Reference Number' ;
    rdfs:comment 'Externally-known business identifier assigned to this FAC placement, used in bordereaux reporting and reinsurer correspondence. Unique per placement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facType rdf:type rdf:Property ;
    rdfs:label 'Fac Type' ;
    rdfs:comment 'Structural type of the facultative placement: pro-rata (quota share basis) or excess of loss. Determines how premium and losses are shared.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossParticipationRate rdf:type rdf:Property ;
    rdfs:label 'Loss Participation Rate' ;
    rdfs:comment 'Percentage of losses the cedant participates in alongside the reinsurer under profit-sharing or loss-sensitive FAC structures.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalInsuredTiv rdf:type rdf:Property ;
    rdfs:label 'Original Insured Tiv' ;
    rdfs:comment 'Total Insured Value of the underlying risk at the time of FAC placement. Used to calculate ceded exposure and Rate on Line (ROL).' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementBasis rdf:type rdf:Property ;
    rdfs:label 'Placement Basis' ;
    rdfs:comment 'Basis on which the FAC agreement responds: risks attaching (policies incepting during the period) or losses occurring (losses during the period).' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerUnderwriterName rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Underwriter Name' ;
    rdfs:comment 'Name of the underwriter at the assuming reinsurer who accepted and bound this FAC placement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retrocessionFlag rdf:type rdf:Property ;
    rdfs:label 'Retrocession Flag' ;
    rdfs:comment 'Indicates whether this FAC agreement is a retrocession (reinsurance of reinsurance), where the cedant is itself a reinsurer passing risk further.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduleFCategory rdf:type rdf:Property ;
    rdfs:label 'Schedule F Category' ;
    rdfs:comment 'NAIC Schedule F classification of the reinsurer for statutory reporting: authorized, unauthorized, certified, or reciprocal jurisdiction reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slipReference rdf:type rdf:Property ;
    rdfs:label 'Slip Reference' ;
    rdfs:comment 'Market slip or cover note reference number associated with this FAC placement, used in London Market or broker-placed reinsurance transactions.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialConditions rdf:type rdf:Property ;
    rdfs:label 'Special Conditions' ;
    rdfs:comment 'Free-text description of any special terms, conditions, exclusions, or warranties specific to this facultative placement not captured in structured fields.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterName rdf:type rdf:Property ;
    rdfs:label 'Underwriter Name' ;
    rdfs:comment 'Name of the cedant\'s underwriter responsible for placing and managing this facultative reinsurance agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceBordereauxLineId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Bordereaux Line Id' ;
    rdfs:comment 'Unique surrogate primary key for one bordereaux line item representing a single cession or claim cession within a bordereaux submission run. Grain: one row per cession per bordereaux.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bordereauxLineType rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Line Type' ;
    rdfs:comment 'Classifies the nature of this bordereaux line: premium cession, claim cession, adjustment, return premium, or reinstatement. Drives financial processing logic.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededLaePaid rdf:type rdf:Property ;
    rdfs:label 'Ceded Lae Paid' ;
    rdfs:comment 'Loss Adjustment Expense (LAE) paid by the reinsurer under this cession line. Includes ALAE and ULAE components ceded per agreement terms.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLaeReserve rdf:type rdf:Property ;
    rdfs:label 'Ceded Lae Reserve' ;
    rdfs:comment 'Outstanding LAE reserve amount ceded to the reinsurer for this line. Represents the reinsurer\'s share of unpaid loss adjustment expenses.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossPaid rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Paid' ;
    rdfs:comment 'Losses paid by the reinsurer under this cession line to date. Represents actual cash recoveries received from the reinsurer for indemnity payments.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossReserve rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Reserve' ;
    rdfs:comment 'Outstanding case reserve amount ceded to the reinsurer for this line. Represents the reinsurer\'s share of unpaid loss reserves (OSLR/RBNS).' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuredName rdf:type rdf:Property ;
    rdfs:label 'Insured Name' ;
    rdfs:comment 'Name of the insured party on the ceded policy as reported on the bordereaux. Required by reinsurers for risk identification and facultative certificate matching.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRetrocession rdf:type rdf:Property ;
    rdfs:label 'Is Retrocession' ;
    rdfs:comment 'Indicates whether this cession line represents a retrocession (cession of assumed reinsurance) rather than a direct cession. True = retrocession; False = direct cession.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Line Sequence Number' ;
    rdfs:comment 'Sequential line number of this record within the parent bordereaux run. Used for ordering, reconciliation, and error identification during bordereaux processing.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemReference rdf:type rdf:Property ;
    rdfs:label 'Source System Reference' ;
    rdfs:comment 'The originating system\'s unique identifier for this bordereaux line record (e.g., Sapiens ReinsurancePro internal line ID). Supports data lineage and reconciliation.' ;
    rdfs:domain ind:ReinsuranceBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyYear rdf:type rdf:Property ;
    rdfs:label 'Treaty Year' ;
    rdfs:comment 'The underwriting or accident year of the reinsurance treaty applicable to this cession line. Used for treaty-year loss development and Schedule F segmentation.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentReinsurerId rdf:type rdf:Property ;
    rdfs:label 'Parent Reinsurer Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the parent reinsurer entity for group-level exposure aggregation, credit limit monitoring, and group Schedule F reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reinsurer .

ind:amBestOutlook rdf:type rdf:Property ;
    rdfs:label 'Am Best Outlook' ;
    rdfs:comment 'AM Best rating outlook indicating the likely direction of the reinsurer\'s financial strength rating over the medium term. Informs counterparty risk monitoring.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amBestRating rdf:type rdf:Property ;
    rdfs:label 'Am Best Rating' ;
    rdfs:comment 'AM Best Financial Strength Rating (FSR) assigned to the reinsurer. Used in underwriting guidelines to validate counterparty credit quality and treaty eligibility thresholds.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amBestRatingDate rdf:type rdf:Property ;
    rdfs:label 'Am Best Rating Date' ;
    rdfs:comment 'Date on which the current AM Best Financial Strength Rating was assigned or last affirmed. Used to assess rating currency and trigger counterparty review workflows.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Approval Expiry Date' ;
    rdfs:comment 'Date on which the current internal approval for the reinsurer expires and must be renewed by the credit committee. Drives counterparty review scheduling.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedFlag rdf:type rdf:Property ;
    rdfs:label 'Approved Flag' ;
    rdfs:comment 'Indicates whether the reinsurer has been formally approved by the cedant\'s internal credit and counterparty risk committee for placement of new reinsurance agreements.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Authorization Status' ;
    rdfs:comment 'Indicates whether the reinsurer is authorized, unauthorized, certified, or accredited in the cedant\'s domicile state. Determines Schedule F credit for reinsurance and collateral obligations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerIntermediaryName rdf:type rdf:Property ;
    rdfs:label 'Broker Intermediary Name' ;
    rdfs:comment 'Name of the reinsurance broker or intermediary through which business is placed with this reinsurer. Used for commission tracking and intermediary credit risk assessment.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Code' ;
    rdfs:comment 'Internal alphanumeric code assigned to uniquely identify the reinsurer within the Reinsurance Management System for bordereaux and cession processing.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Amount' ;
    rdfs:comment 'Maximum aggregate ceded exposure (in USD) approved for this reinsurer by the internal credit committee. Enforced at cession booking to prevent counterparty concentration breaches.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:domicileCountry rdf:type rdf:Property ;
    rdfs:label 'Domicile Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the reinsurer is legally domiciled. Used for Schedule F foreign reinsurer classification and credit determination.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domicileState rdf:type rdf:Property ;
    rdfs:label 'Domicile State' ;
    rdfs:comment 'Two-letter US state or territory code where the reinsurer is domiciled, if a domestic entity. Used for state-level authorization and credit for reinsurance analysis.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalExciseTaxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Excise Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is exempt from US Federal Excise Tax on reinsurance premiums under a tax treaty or qualified jurisdiction status per IRC Section 4371.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:groupName rdf:type rdf:Property ;
    rdfs:label 'Group Name' ;
    rdfs:comment 'Name of the reinsurance group or holding company to which this reinsurer belongs. Used for group-level credit exposure aggregation and counterparty concentration risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lloydsSyndicateNumber rdf:type rdf:Property ;
    rdfs:label 'Lloyds Syndicate Number' ;
    rdfs:comment 'Four-digit Lloyd\'s of London syndicate number. Populated only when reinsurer_type is lloyds_syndicate. Required for Lloyd\'s-specific bordereaux and premium trust fund reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumAmBestRating rdf:type rdf:Property ;
    rdfs:label 'Minimum Am Best Rating' ;
    rdfs:comment 'Minimum AM Best Financial Strength Rating required by internal policy for this reinsurer to remain eligible for new cessions. Triggers review if current rating falls below threshold.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moodysRating rdf:type rdf:Property ;
    rdfs:label 'Moodys Rating' ;
    rdfs:comment 'Moody\'s Investors Service insurance financial strength rating for the reinsurer. Used as a tertiary credit quality indicator in counterparty risk frameworks.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poolName rdf:type rdf:Property ;
    rdfs:label 'Pool Name' ;
    rdfs:comment 'Name of the reinsurance pool or facility when the reinsurer participates as a pool member. Used for pool-level aggregation in bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerStatus rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Status' ;
    rdfs:comment 'Current operational status of the reinsurer in the cedant\'s system. Controls eligibility for new cessions and triggers collection escalation for run-off or insolvent counterparties.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerType rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Type' ;
    rdfs:comment 'Classification of the reinsurer entity structure. Drives Schedule F credit treatment and collateral requirements. [ENUM-REF-CANDIDATE: assuming_company|lloyds_syndicate|pool|captive|government|other — promote to reference product]' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Inception Date' ;
    rdfs:comment 'Date on which the cedant first entered into a reinsurance agreement with this counterparty. Used for relationship tenure analysis and counterparty history reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Abbreviated or commonly used trading name of the reinsurer used in bordereaux reports, internal systems, and operational communications.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spRating rdf:type rdf:Property ;
    rdfs:label 'Sp Rating' ;
    rdfs:comment 'S&P Global Ratings financial strength rating for the reinsurer. Supplementary credit quality indicator used alongside AM Best for counterparty risk assessment.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxWithholdingRate rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Rate' ;
    rdfs:comment 'Federal excise tax or withholding rate applicable to premium payments to this reinsurer, expressed as a decimal (e.g., 0.01 = 1%). Applies to foreign unauthorized reinsurers per IRC Section 4371.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokerAgencyId rdf:type rdf:Property ;
    rdfs:label 'Broker Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Treaty agreements are placed through reinsurance brokers (agencies). Formalizing broker_name as FK enables producer performance tracking on treaty placements, commission reconciliation, and' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:aggregateLimitAmt rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Amt' ;
    rdfs:comment 'Maximum cumulative reinsurance recovery across all losses in the treaty period. Caps total reinsurer exposure for Stop Loss and aggregate XOL structures. Null if no aggregate cap.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arbitrationClause rdf:type rdf:Property ;
    rdfs:label 'Arbitration Clause' ;
    rdfs:comment 'Indicates whether the agreement contains a mandatory arbitration clause for dispute resolution in lieu of litigation. True if arbitration is required.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentPointAmt rdf:type rdf:Property ;
    rdfs:label 'Attachment Point Amt' ;
    rdfs:comment 'The loss threshold at which the reinsurance layer attaches and begins to respond for XOL and CAT XL treaties. Expressed in agreement currency. Null for proportional treaties.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizedStatus rdf:type rdf:Property ;
    rdfs:label 'Authorized Status' ;
    rdfs:comment 'Regulatory authorization status of the lead reinsurer in the cedant\'s domicile state: Authorized, Unauthorized, Certified (under NAIC Credit for Reinsurance Model Law), or Reciprocal.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catEventScope rdf:type rdf:Property ;
    rdfs:label 'Cat Event Scope' ;
    rdfs:comment 'Defines the loss aggregation basis for CAT XL treaties: Per Risk, Per Occurrence, Per Event (hours clause), or Aggregate. Determines how losses from a single CAT event are combined.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cedantLegalEntity rdf:type rdf:Property ;
    rdfs:label 'Cedant Legal Entity' ;
    rdfs:comment 'Legal name of the ceding company (cedant) that is transferring risk under this agreement. Corresponds to the licensed insurance entity on the NAIC Annual Statement.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cedantNaicCode rdf:type rdf:Property ;
    rdfs:label 'Cedant Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code identifying the cedant legal entity. Required for NAIC Schedule F statutory reporting and regulatory filings.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralRequired rdf:type rdf:Property ;
    rdfs:label 'Collateral Required' ;
    rdfs:comment 'Indicates whether the reinsurer is required to post collateral (LOC, trust, funds withheld) due to unauthorized/alien reinsurer status. Drives Schedule F credit allowance.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depositPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium Amt' ;
    rdfs:comment 'Initial premium paid by the cedant at inception of the treaty year, subject to adjustment at year-end based on actual subject premium. Used in ROL and premium settlement calculations.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundsWithheld rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld' ;
    rdfs:comment 'Indicates whether the cedant withholds ceded premium reserves rather than remitting to the reinsurer. Affects Schedule F credit and collateral requirements under SAP SSAP No. 62R.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingLaw rdf:type rdf:Property ;
    rdfs:label 'Governing Law' ;
    rdfs:comment 'Legal jurisdiction whose laws govern interpretation and enforcement of the agreement (e.g., \'New York\', \'England and Wales\'). Required for dispute resolution and regulatory compliance.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoursClauseHrs rdf:type rdf:Property ;
    rdfs:label 'Hours Clause Hrs' ;
    rdfs:comment 'Number of consecutive hours within which losses from a single occurrence are aggregated for CAT XL recovery purposes (e.g., 72 hours for wind, 168 hours for flood). Null if not applicable.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insolvencyClause rdf:type rdf:Property ;
    rdfs:label 'Insolvency Clause' ;
    rdfs:comment 'Indicates whether the agreement contains an insolvency clause ensuring reinsurer obligations survive cedant insolvency. Required under SAP SSAP No. 62R for credit as reinsurance.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadReinsurerNaicCode rdf:type rdf:Property ;
    rdfs:label 'Lead Reinsurer Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code for the lead reinsurer. Required for Schedule F counterparty identification and credit risk assessment under SAP SSAP No. 62R.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadReinsurerName rdf:type rdf:Property ;
    rdfs:label 'Lead Reinsurer Name' ;
    rdfs:comment 'Legal name of the lead reinsurer on the agreement. For syndicated treaties, this is the lead market that sets terms. Used in bordereaux and Schedule F counterparty reporting.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitAmt rdf:type rdf:Property ;
    rdfs:label 'Limit Amt' ;
    rdfs:comment 'Maximum amount the reinsurer will pay per risk, per occurrence, or in aggregate under this agreement. Defines the top of the reinsurance layer for XOL treaties.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCorridorPct rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Pct' ;
    rdfs:comment 'Loss ratio band within which the cedant retains losses before the reinsurer re-engages, used in Stop Loss and aggregate structures. Null if no loss corridor provision.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Amt' ;
    rdfs:comment 'Minimum reinsurance premium guaranteed to the reinsurer regardless of actual subject premium volume. Protects reinsurer against cedant portfolio shrinkage.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offsetClause rdf:type rdf:Property ;
    rdfs:label 'Offset Clause' ;
    rdfs:comment 'Indicates whether the agreement permits mutual offset of amounts owed between cedant and reinsurer. Relevant for credit risk management and Schedule F balance netting.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Pct' ;
    rdfs:comment 'Percentage of reinsurer profit returned to the cedant under a profit commission clause. Calculated on the treaty year result after losses and expenses. Null if no profit commission.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programLayer rdf:type rdf:Property ;
    rdfs:label 'Program Layer' ;
    rdfs:comment 'Identifies the layer within a multi-layer reinsurance program (e.g., \'Layer 1\', \'Layer 2\', \'Top Layer\'). Used to sequence layers for loss allocation and PML modeling.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementCount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Count' ;
    rdfs:comment 'Number of times the reinsurance limit may be reinstated after a loss exhausts the layer. Common in CAT XL treaties. Zero indicates no reinstatement provision.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinstatementPremiumPct rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Pct' ;
    rdfs:comment 'Percentage of the original reinsurance premium charged to reinstate the limit after a loss. Expressed as a percentage of the annual deposit premium (e.g., 100% = pro-rata reinstatement).' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retentionAmt rdf:type rdf:Property ;
    rdfs:label 'Retention Amt' ;
    rdfs:comment 'The cedant\'s net retained amount per risk or per occurrence before reinsurance responds. For XOL, this is the attachment point (SIR). For QS, this is the retained share in currency.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rolPct rdf:type rdf:Property ;
    rdfs:label 'Rol Pct' ;
    rdfs:comment 'Rate on Line expressed as a percentage: reinsurance premium divided by the reinsurance limit. Key pricing metric for XOL and CAT XL layers used in actuarial and underwriting analysis.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signedDate rdf:type rdf:Property ;
    rdfs:label 'Signed Date' ;
    rdfs:comment 'The date the reinsurance agreement was formally executed and signed by all parties. May differ from inception date for retroactive or late-signed treaties.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:territoryScope rdf:type rdf:Property ;
    rdfs:label 'Territory Scope' ;
    rdfs:comment 'Geographic scope of risks covered by the agreement (e.g., \'USA and Canada\', \'Worldwide excluding War Zones\'). Drives exposure aggregation and CAT model alignment.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unlBasis rdf:type rdf:Property ;
    rdfs:label 'Unl Basis' ;
    rdfs:comment 'Defines how Ultimate Net Loss is calculated for recovery purposes: Gross (before other RI), Net of Inuring RI (after lower layers), or Net of All RI. Critical for layered program structures.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riClaimCessionId rdf:type rdf:Property ;
    rdfs:label 'Ri Claim Cession Id' ;
    rdfs:comment 'Unique surrogate primary key for the reinsurance claim cession record. One row per claim exposure per treaty layer or facultative agreement.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiClaimCession .

ind:catEventCode rdf:type rdf:Property ;
    rdfs:label 'Cat Event Code' ;
    rdfs:comment 'Industry-standard catastrophe event code (e.g., ISO PCS serial number) identifying the CAT event for aggregation under CAT XL treaty layers.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cessionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cession Effective Date' ;
    rdfs:comment 'Date on which this claim cession becomes effective under the reinsurance agreement, typically aligned with the loss date or treaty inception.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cessionStatus rdf:type rdf:Property ;
    rdfs:label 'Cession Status' ;
    rdfs:comment 'Current lifecycle state of the claim cession record within the reinsurance recovery workflow.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cessionType rdf:type rdf:Property ;
    rdfs:label 'Cession Type' ;
    rdfs:comment 'Indicates whether the cession is under a treaty arrangement, a facultative (FAC) agreement, or a retrocession.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commutationFlag rdf:type rdf:Property ;
    rdfs:label 'Commutation Flag' ;
    rdfs:comment 'Indicates whether this cession has been subject to a commutation agreement with the reinsurer, settling all future obligations in a lump sum.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCatClaim rdf:type rdf:Property ;
    rdfs:label 'Is Cat Claim' ;
    rdfs:comment 'Indicates whether this claim cession is associated with a declared catastrophe event, triggering CAT XL treaty layer eligibility review.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:layerLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Layer Limit Amount' ;
    rdfs:comment 'Maximum reinsurance recovery available under this treaty layer for the ceded claim exposure. Defines the per-occurrence or per-risk limit.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Layer Retention Amount' ;
    rdfs:comment 'The cedant\'s retained loss amount at the applicable treaty layer before reinsurance recovery applies. Represents the SIR or attachment point retention.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryBilledDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Billed Date' ;
    rdfs:comment 'Date on which the reinsurance recovery was formally billed to the reinsurer for this claim cession.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Received Date' ;
    rdfs:comment 'Date on which payment was received from the reinsurer for this cession, used for cash flow and Schedule F counterparty aging analysis.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceType rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Type' ;
    rdfs:comment 'Classification of the reinsurance structure: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), CAT XL, or facultative variants. [ENUM-REF-CANDIDATE: quota_share|excess_of_loss|stop_loss|cat_xl|facultative_proportional|facultative_non_proportional —' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerParticipationPct rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Participation Pct' ;
    rdfs:comment 'The reinsurer\'s share of the treaty layer as a decimal (e.g., 0.5000 = 50%), used when multiple reinsurers participate in a single layer.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rolRate rdf:type rdf:Property ;
    rdfs:label 'Rol Rate' ;
    rdfs:comment 'Rate on Line (ROL) applicable to this treaty layer, expressed as a decimal. Used for pricing analysis and reinsurance cost allocation.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unlAmount rdf:type rdf:Property ;
    rdfs:label 'Unl Amount' ;
    rdfs:comment 'Ultimate Net Loss (UNL) calculation basis for this cession, representing the net loss after salvage, subrogation, and other recoveries, used to determine XOL trigger.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riCollateralId rdf:type rdf:Property ;
    rdfs:label 'Ri Collateral Id' ;
    rdfs:comment 'Unique surrogate identifier for each collateral instrument record posted by an unauthorized reinsurer. Primary key; one row per collateral instrument.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adequacyStatus rdf:type rdf:Property ;
    rdfs:label 'Adequacy Status' ;
    rdfs:comment 'Assessment of whether the available collateral amount meets or exceeds the required amount. Drives regulatory credit-for-reinsurance eligibility and remediation actions.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availableAmt rdf:type rdf:Property ;
    rdfs:label 'Available Amt' ;
    rdfs:comment 'Current drawable or available balance of the collateral instrument, net of any prior draws or reductions. Used for credit-for-reinsurance calculations.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokerName rdf:type rdf:Property ;
    rdfs:label 'Broker Name' ;
    rdfs:comment 'Name of the reinsurance intermediary broker who arranged the collateral instrument on behalf of the reinsurer. Used for broker reconciliation and commission tracking.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedReinsurerRating rdf:type rdf:Property ;
    rdfs:label 'Certified Reinsurer Rating' ;
    rdfs:comment 'NAIC certified reinsurer rating tier (CR-1 through CR-6) that determines the reduced collateral percentage required. Applicable only when reinsurer_certified_flag is true.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralNotes rdf:type rdf:Property ;
    rdfs:label 'Collateral Notes' ;
    rdfs:comment 'Free-text notes capturing special conditions, amendment history, or operational remarks about the collateral instrument not captured in structured fields.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralNumber rdf:type rdf:Property ;
    rdfs:label 'Collateral Number' ;
    rdfs:comment 'Externally assigned reference number for the collateral instrument (e.g., letter of credit number, trust account number) as issued by the financial institution.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralPurpose rdf:type rdf:Property ;
    rdfs:label 'Collateral Purpose' ;
    rdfs:comment 'Business purpose for which the collateral is held. Determines how the available amount is applied against ceded liabilities for credit-for-reinsurance calculations.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralStatus rdf:type rdf:Property ;
    rdfs:label 'Collateral Status' ;
    rdfs:comment 'Current lifecycle state of the collateral instrument. Active = in force and available; Drawn = cedant has drawn on the instrument; Released = returned to reinsurer.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyAmt rdf:type rdf:Property ;
    rdfs:label 'Deficiency Amt' ;
    rdfs:comment 'Shortfall between the required collateral amount and the available amount. Positive value indicates a deficiency requiring remediation or reduction of reinsurance credit.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drawDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Draw Deadline Date' ;
    rdfs:comment 'Last date by which the cedant must submit a draw request before the instrument expires. Critical for operational risk management and treasury planning.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:drawnAmt rdf:type rdf:Property ;
    rdfs:label 'Drawn Amt' ;
    rdfs:comment 'Cumulative amount drawn by the cedant against this collateral instrument to date. Reduces the available amount and triggers reinsurer replenishment obligations.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evergreenFlag rdf:type rdf:Property ;
    rdfs:label 'Evergreen Flag' ;
    rdfs:comment 'Indicates whether the collateral instrument contains an evergreen clause that automatically renews unless the issuer provides advance notice of non-renewal to the cedant.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'External Reference Number' ;
    rdfs:comment 'Reference number assigned by the reinsurer or broker to this collateral arrangement. Facilitates reconciliation with counterparty records and bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faceAmt rdf:type rdf:Property ;
    rdfs:label 'Face Amt' ;
    rdfs:comment 'Gross face value of the collateral instrument as stated in the instrument document. Represents the maximum drawable or available amount before any reductions.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuingInstitutionCountry rdf:type rdf:Property ;
    rdfs:label 'Issuing Institution Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the issuing financial institution. Regulators may require the issuer to be domiciled in an approved jurisdiction.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Issuing Institution Name' ;
    rdfs:comment 'Name of the bank, trust company, or financial institution that issued or holds the collateral instrument (e.g., the bank issuing the letter of credit).' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastValuationDate rdf:type rdf:Property ;
    rdfs:label 'Last Valuation Date' ;
    rdfs:comment 'Date on which the collateral instrument was most recently valued or reconciled against ceded reserve liabilities. Supports quarterly and annual adequacy reviews.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lcIssuingBankSwift rdf:type rdf:Property ;
    rdfs:label 'Lc Issuing Bank Swift' ;
    rdfs:comment 'SWIFT/BIC code of the bank issuing the letter of credit. Populated only when collateral_type = letter_of_credit. Used for bank identity verification.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonRenewalNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Non Renewal Notice Days' ;
    rdfs:comment 'Number of calendar days advance notice the issuing institution must provide before non-renewal of an evergreen collateral instrument, as specified in the instrument.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reducedCollateralPct rdf:type rdf:Property ;
    rdfs:label 'Reduced Collateral Pct' ;
    rdfs:comment 'Percentage of ceded liabilities that must be collateralized for certified reinsurers (e.g., 0.10 for CR-1 = 10%). Null for non-certified unauthorized reinsurers requiring 100%.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsurerCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Certified Flag' ;
    rdfs:comment 'Indicates whether the reinsurer holds certified reinsurer status under the NAIC Credit for Reinsurance Model Law, which may reduce collateral requirements.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiredAmt rdf:type rdf:Property ;
    rdfs:label 'Required Amt' ;
    rdfs:comment 'Minimum collateral amount required by the cedant or regulator to support ceded reserves and obtain credit for reinsurance. Drives adequacy monitoring.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trustAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Trust Account Number' ;
    rdfs:comment 'Account number of the trust fund if the collateral type is a trust fund arrangement. Populated only when collateral_type = trust_fund; null otherwise.' ;
    rdfs:domain ind:RiCollateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riParticipantId rdf:type rdf:Property ;
    rdfs:label 'Ri Participant Id' ;
    rdfs:comment 'Unique surrogate identifier for a reinsurer\'s participation record within a treaty or facultative agreement. One row per reinsurer per agreement.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riPartyId rdf:type rdf:Property ;
    rdfs:label 'Ri Party Id' ;
    rdfs:comment 'Reference to the reinsurance intermediary (broker) who placed this participant\'s line. Used for broker commission settlement and bordereaux routing.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:riReinsurerPartyId rdf:type rdf:Property ;
    rdfs:label 'Ri Reinsurer Party Id' ;
    rdfs:comment 'Reference to the Party record representing the reinsurer entity participating in this agreement.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:accountCurrentBasis rdf:type rdf:Property ;
    rdfs:label 'Account Current Basis' ;
    rdfs:comment 'Basis on which the account current (bordereaux) is prepared for this participant: written premium basis, earned premium basis, or cash basis.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerageCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Brokerage Commission Pct' ;
    rdfs:comment 'Percentage of ceded premium payable to the reinsurance broker for placing this participant\'s line. Applied to the participant\'s share of written premium.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionSharePct rdf:type rdf:Property ;
    rdfs:label 'Cession Share Pct' ;
    rdfs:comment 'Effective share of each cession allocated to this participant, derived from signed line and order hereon. Used to compute this reinsurer\'s portion of premium and loss.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commutationAmount rdf:type rdf:Property ;
    rdfs:label 'Commutation Amount' ;
    rdfs:comment 'Lump-sum amount agreed upon in the commutation to settle all outstanding reserves and future obligations for this reinsurer\'s participation share.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cutThroughClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Cut Through Clause Flag' ;
    rdfs:comment 'Indicates whether a cut-through endorsement exists allowing the cedant\'s policyholders to claim directly against this reinsurer in the event of the cedant\'s insolvency.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundsWithheldFlag rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld Flag' ;
    rdfs:comment 'Indicates whether the cedant withholds ceded premium from this reinsurer under a funds-withheld arrangement, used as collateral for unauthorized reinsurers.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insolvencyClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Insolvency Clause Flag' ;
    rdfs:comment 'Indicates whether the standard insolvency clause is included, requiring the reinsurer to pay claims even if the cedant becomes insolvent, per NAIC model law requirements.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcAmount rdf:type rdf:Property ;
    rdfs:label 'Lc Amount' ;
    rdfs:comment 'Dollar amount of the letter of credit posted by this reinsurer as collateral. Required for Schedule F credit for reinsurance calculations for unauthorized reinsurers.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lcRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Lc Required Flag' ;
    rdfs:comment 'Indicates whether this reinsurer is required to post a letter of credit as collateral for credit for reinsurance purposes under state regulation.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offsetClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Offset Clause Flag' ;
    rdfs:comment 'Indicates whether the participation agreement includes an offset clause allowing mutual debts between cedant and reinsurer to be netted in settlement.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderHereonPct rdf:type rdf:Property ;
    rdfs:label 'Order Hereon Pct' ;
    rdfs:comment 'The cedant\'s order percentage representing the total share of risk placed with the reinsurance market. Used to scale signed and written lines to the actual ceded amount.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:participantReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Participant Reference Number' ;
    rdfs:comment 'Externally-known unique identifier assigned by the reinsurance management system to this participation line, used in bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participantStatus rdf:type rdf:Property ;
    rdfs:label 'Participant Status' ;
    rdfs:comment 'Current lifecycle state of the reinsurer\'s participation in the agreement. Controls whether cessions and recoveries can be posted against this participant.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationType rdf:type rdf:Property ;
    rdfs:label 'Participation Type' ;
    rdfs:comment 'Classifies the reinsurer\'s role in the panel: leader sets terms, followers subscribe, sole reinsurer takes 100%. Drives bordereaux and settlement logic.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signedLinePct rdf:type rdf:Property ;
    rdfs:label 'Signed Line Pct' ;
    rdfs:comment 'The percentage of the agreement\'s risk that the reinsurer has formally signed and committed to. Signed lines across all participants must sum to 100% for a fully placed agreement.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signingDate rdf:type rdf:Property ;
    rdfs:label 'Signing Date' ;
    rdfs:comment 'Date on which the reinsurer formally signed the slip or contract, confirming their committed signed line percentage. Distinct from placement date.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trustFundAmount rdf:type rdf:Property ;
    rdfs:label 'Trust Fund Amount' ;
    rdfs:comment 'Amount held in a reinsurance trust fund by this reinsurer as an alternative collateral mechanism for credit for reinsurance under NAIC model law.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writtenLinePct rdf:type rdf:Property ;
    rdfs:label 'Written Line Pct' ;
    rdfs:comment 'The percentage of the agreement initially offered to and accepted by the reinsurer before signing-down. May differ from signed line when the placement is oversubscribed.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riPremiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Ri Premium Transaction Id' ;
    rdfs:comment 'Unique surrogate key for each reinsurance ceded premium financial movement. One row per written, earned, unearned, return, or reinstatement transaction for a cession. TRANSACTION_HEADER role.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cedingCommission rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission' ;
    rdfs:comment 'Commission paid by the reinsurer to the cedant to offset acquisition and administrative costs. Expressed as a flat amount per transaction. Reduces the net cost of reinsurance.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occurrenceReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Occurrence Reference Code' ;
    rdfs:comment 'Reference to the loss occurrence or catastrophe event that triggered a reinstatement premium. Populated only for transaction_type = Reinstatement. Links to the loss event record.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:profitCommission rdf:type rdf:Property ;
    rdfs:label 'Profit Commission' ;
    rdfs:comment 'Contingent commission earned by the cedant when the reinsurer\'s loss ratio on the treaty falls below a specified threshold. Booked as a reduction in net reinsurance cost.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatedLimit rdf:type rdf:Property ;
    rdfs:label 'Reinstated Limit' ;
    rdfs:comment 'The amount of treaty limit reinstated following a loss occurrence, for which the reinstatement_premium is charged. Applicable only when transaction_type = Reinstatement.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremium rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium' ;
    rdfs:comment 'Additional premium paid to the reinsurer to reinstate exhausted treaty limit following a loss occurrence. Applicable to XOL and CAT XL treaties. Linked to occurrence_reference_id.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency Amount' ;
    rdfs:comment 'Ceded written premium converted to the cedant\'s statutory reporting currency (USD) using the exchange_rate. Used for NAIC Annual Statement and Schedule F USD-denominated filings.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Risk Effective Date' ;
    rdfs:comment 'The date from which the reinsurer\'s coverage obligation begins for this cession. May differ from policy_effective_date for mid-term facultative placements or endorsements.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Risk Expiration Date' ;
    rdfs:comment 'The date on which the reinsurer\'s coverage obligation ends for this cession. Used to determine the ceded unearned premium reserve at any balance sheet date.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billedDate rdf:type rdf:Property ;
    rdfs:label 'Billed Date' ;
    rdfs:comment 'The date on which the recovery was billed to the reinsurer via bordereaux or facultative certificate.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catCode rdf:type rdf:Property ;
    rdfs:label 'Cat Code' ;
    rdfs:comment 'Industry-standard catastrophe code (e.g., PCS number) identifying the catastrophic event.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededSharePercentage rdf:type rdf:Property ;
    rdfs:label 'Ceded Share Percentage' ;
    rdfs:comment 'The percentage of the underlying loss that is ceded to the reinsurer under the agreement (e.g., 50.00 for 50% quota share).' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facultativeCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Facultative Certificate Number' ;
    rdfs:comment 'The certificate number for facultative reinsurance agreements, if applicable.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementDate rdf:type rdf:Property ;
    rdfs:label 'Movement Date' ;
    rdfs:comment 'The business date on which this recovery movement was recorded or effective.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:movementType rdf:type rdf:Property ;
    rdfs:label 'Movement Type' ;
    rdfs:comment 'Discriminator indicating the type of financial movement: reserve position (case/IBNR/LAE) or cash recovery (loss/LAE/DCC payment, subrogation, salvage). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount Usd' ;
    rdfs:comment 'The recovery amount converted to USD for statutory and consolidated reporting purposes.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Amount' ;
    rdfs:comment 'The amount of reinstatement premium payable to the reinsurer to restore coverage after a loss recovery.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremiumFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Flag' ;
    rdfs:comment 'Boolean indicator (True/False) whether a reinstatement premium is due to the reinsurer as a result of this recovery.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riReinstatementId rdf:type rdf:Property ;
    rdfs:label 'Ri Reinstatement Id' ;
    rdfs:comment 'Unique surrogate primary key for each treaty layer reinstatement event. One row per reinstatement event per treaty layer occurrence.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exhaustedLimitAmt rdf:type rdf:Property ;
    rdfs:label 'Exhausted Limit Amt' ;
    rdfs:comment 'The amount of the treaty layer limit that was exhausted by the triggering loss occurrence, forming the basis for calculating the reinstatement premium.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAutomatic rdf:type rdf:Property ;
    rdfs:label 'Is Automatic' ;
    rdfs:comment 'Indicates whether the reinstatement is triggered automatically upon layer exhaustion (true) or requires explicit reinsurer consent and notification (false).' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFreeReinstatement rdf:type rdf:Property ;
    rdfs:label 'Is Free Reinstatement' ;
    rdfs:comment 'Indicates whether this reinstatement is provided at no additional premium cost per treaty wording (true = free reinstatement; false = premium-bearing reinstatement).' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:layerLimitAmt rdf:type rdf:Property ;
    rdfs:label 'Layer Limit Amt' ;
    rdfs:comment 'The original per-occurrence limit of the treaty layer being reinstated, expressed in the treaty currency. Represents the maximum ceded recovery per occurrence.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxReinstatementsAllowed rdf:type rdf:Property ;
    rdfs:label 'Max Reinstatements Allowed' ;
    rdfs:comment 'Maximum number of reinstatements permitted under the treaty layer per treaty year as specified in the treaty wording, used to validate reinstatement_sequence.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Occurrence Date' ;
    rdfs:comment 'Date of the loss occurrence that triggered the layer exhaustion and necessitated this reinstatement, used for accident year and treaty year attribution.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:occurrenceReference rdf:type rdf:Property ;
    rdfs:label 'Occurrence Reference' ;
    rdfs:comment 'External reference code or name for the loss occurrence that exhausted the layer (e.g., CAT event code, storm name, occurrence number per treaty wording).' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalPremiumBasisAmt rdf:type rdf:Property ;
    rdfs:label 'Original Premium Basis Amt' ;
    rdfs:comment 'The original treaty premium (annual deposit or minimum premium) used as the basis for computing the reinstatement premium under pro-rata-of-original-premium treaty structures.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatedLimitAmt rdf:type rdf:Property ;
    rdfs:label 'Reinstated Limit Amt' ;
    rdfs:comment 'The amount of treaty layer limit reinstated by this event. May equal the full layer limit or a partial amount if only partially exhausted or partially reinstated.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementNumber rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Number' ;
    rdfs:comment 'Externally-known business identifier for this reinstatement event, assigned by the Reinsurance Management System for bordereaux and counterparty communication.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Amt' ;
    rdfs:comment 'Gross reinstatement premium payable to the reinsurer for restoring the exhausted layer limit, calculated as reinstated limit multiplied by the reinstatement premium rate.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremiumCurrency rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the reinstatement premium amount (e.g., USD, GBP, EUR), matching the treaty settlement currency.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementSequence rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Sequence' ;
    rdfs:comment 'Ordinal sequence of this reinstatement within the treaty layer for the treaty year (1st reinstatement, 2nd reinstatement, etc.), as defined in the treaty wording.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinstatementStatus rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Status' ;
    rdfs:comment 'Current workflow status of the reinstatement event, tracking progression from pending confirmation through premium invoicing and payment settlement.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementType rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Type' ;
    rdfs:comment 'Classification of the reinstatement as automatic (triggered by loss), conditional (subject to reinsurer consent), free (no additional premium), or paid (premium-bearing).' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerConfirmationRef rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Confirmation Ref' ;
    rdfs:comment 'Reference number or acknowledgment code provided by the reinsurer confirming acceptance of the reinstatement, required for conditional reinstatements.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerReinstatementPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Reinstatement Premium Amt' ;
    rdfs:comment 'Reinsurer\'s proportional share of the reinstatement premium, derived from the gross reinstatement premium multiplied by the reinsurer share percentage.' ;
    rdfs:domain ind:RiReinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsurerSharePct rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Share Pct' ;
    rdfs:comment 'Percentage share of the treaty layer held by the reinsurer (or lead reinsurer on a co-reinsurance panel), used to apportion the reinstated limit and reinstatement premium.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riSettlementId rdf:type rdf:Property ;
    rdfs:label 'Ri Settlement Id' ;
    rdfs:comment 'Unique surrogate primary key for each reinsurance net cash settlement record between cedant and reinsurer per period.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustmentPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Premium Amount' ;
    rdfs:comment 'Premium adjustment amount resulting from audit or retrospective rating, representing the difference between deposit and final premium.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bordereauxReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Reference Number' ;
    rdfs:comment 'Reference number of the bordereaux submission to the reinsurer that supports the cession and loss data underlying this settlement.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededPremiumEarnedAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Earned Amount' ;
    rdfs:comment 'Portion of ceded written premium earned during the settlement period, used for loss ratio and profit commission calculations.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPremiumWrittenAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Written Amount' ;
    rdfs:comment 'Gross written premium ceded to the reinsurer for the settlement period, representing the cedant\'s premium payable obligation.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionSharePercent rdf:type rdf:Property ;
    rdfs:label 'Cession Share Percent' ;
    rdfs:comment 'Percentage of risk ceded to this reinsurer under a quota share or surplus share treaty, expressed as a decimal (e.g., 0.3000 = 30%).' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium Amount' ;
    rdfs:comment 'Provisional deposit premium paid to the reinsurer at inception, subject to adjustment at final audit based on actual subject premium.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundsWithheldAmount rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld Amount' ;
    rdfs:comment 'Amount of ceded premium withheld by the cedant as collateral under a funds-withheld reinsurance arrangement, reducing the cash settlement.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestOnFundsWithheldAmount rdf:type rdf:Property ;
    rdfs:label 'Interest On Funds Withheld Amount' ;
    rdfs:comment 'Interest credited to the reinsurer on funds withheld by the cedant, per the contractual interest rate in the reinsurance agreement.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laeRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Lae Recoverable Amount' ;
    rdfs:comment 'Allocated and unallocated loss adjustment expenses (ALAE/ULAE) recoverable from the reinsurer under the agreement terms.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Loss Recoverable Amount' ;
    rdfs:comment 'Total loss amounts recoverable from the reinsurer for paid and outstanding claims within the settlement period.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Net Settlement Amount' ;
    rdfs:comment 'Net cash amount due after offsetting ceded premium payable against loss recoverable, commissions, and profit commission. Positive = cedant owes reinsurer.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profitCommissionLossRatio rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Loss Ratio' ;
    rdfs:comment 'Ceded loss ratio used as the input to the profit commission sliding-scale formula, expressed as a decimal (e.g., 0.5500 = 55%).' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementDirection rdf:type rdf:Property ;
    rdfs:label 'Settlement Direction' ;
    rdfs:comment 'Indicates whether the net settlement amount is payable by the cedant to the reinsurer or receivable by the cedant from the reinsurer.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementNotes rdf:type rdf:Property ;
    rdfs:label 'Settlement Notes' ;
    rdfs:comment 'Free-text notes capturing any special terms, adjustments, or commentary relevant to this settlement for operational and audit purposes.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Number' ;
    rdfs:comment 'Externally-known business identifier for this settlement, used in bordereaux reporting and reinsurer correspondence.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Period End Date' ;
    rdfs:comment 'Last day of the period covered by this settlement, defining the close of the bordereaux reporting window.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Period Start Date' ;
    rdfs:comment 'First day of the period covered by this settlement, used to align ceded premium and loss recoverable to the correct bordereaux period.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subjectPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Subject Premium Amount' ;
    rdfs:comment 'Gross net written premium of the cedant\'s book subject to the reinsurance agreement, used as the base for ceded premium and ROL calculations.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateNetLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ultimate Net Loss Amount' ;
    rdfs:comment 'Ultimate Net Loss as defined in the reinsurance agreement, representing the cedant\'s retained loss after all recoveries, used for XOL trigger evaluation.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleFEntryId rdf:type rdf:Property ;
    rdfs:label 'Schedule F Entry Id' ;
    rdfs:comment 'Unique surrogate identifier for each Schedule F statutory reporting entry. One row per reinsurer per reporting year per cedant legal entity.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentDate rdf:type rdf:Property ;
    rdfs:label 'Amendment Date' ;
    rdfs:comment 'Date of the most recent amendment to this Schedule F entry, if the original filing was corrected or restated after initial submission.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assumedPremiumWrittenAmt rdf:type rdf:Property ;
    rdfs:label 'Assumed Premium Written Amt' ;
    rdfs:comment 'Total written premium assumed from other cedants by this entity under retrocession or assumed reinsurance arrangements, reported on Schedule F.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededContingentCommissionAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Contingent Commission Amt' ;
    rdfs:comment 'Profit or contingent commission receivable from the reinsurer based on favorable loss experience, per treaty terms. Reported on Schedule F.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededIbnrAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Ibnr Amt' ;
    rdfs:comment 'Actuarial IBNR reserve attributable to ceded business with this reinsurer as of year-end, per Schedule F Part 3 reporting requirements.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLaeReserveAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Lae Reserve Amt' ;
    rdfs:comment 'Reserve for ceded loss adjustment expenses (ALAE and ULAE) attributable to this reinsurer as of the reporting year-end.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossesOutstandingAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Losses Outstanding Amt' ;
    rdfs:comment 'Case reserves for ceded losses outstanding as of year-end, representing amounts owed by the reinsurer on reported but unsettled claims.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossesPaidAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Losses Paid Amt' ;
    rdfs:comment 'Actual loss payments recovered from this reinsurer during the reporting year on ceded claims, per Schedule F Part 3.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPremiumEarnedAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Earned Amt' ;
    rdfs:comment 'Portion of ceded written premium earned during the reporting year, used in loss ratio and Schedule F collectibility analysis.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPremiumWrittenAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Written Amt' ;
    rdfs:comment 'Total gross written premium ceded to this reinsurer during the reporting year, as reported on Schedule F Part 3. Basis for NWP calculation.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededUnearnedPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Ceded Unearned Premium Amt' ;
    rdfs:comment 'Unearned portion of ceded premium as of the reporting year-end, representing the reinsurers liability for unexpired risk.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionReceivedAmt rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Received Amt' ;
    rdfs:comment 'Ceding commission received from the reinsurer during the reporting year, offsetting the cedants acquisition costs on ceded business.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralHeldAmt rdf:type rdf:Property ;
    rdfs:label 'Collateral Held Amt' ;
    rdfs:comment 'Total collateral held by the cedant (letters of credit, trust funds, funds withheld) to secure unauthorized reinsurer obligations per Schedule F.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Collectibility Status' ;
    rdfs:comment 'Assessment of the reinsurers ability and willingness to pay. Drives Schedule F provision for reinsurance recoverables and surplus impact.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeAmt rdf:type rdf:Property ;
    rdfs:label 'Dispute Amt' ;
    rdfs:comment 'Dollar amount of reinsurance recoverables currently in formal dispute or arbitration with this reinsurer as of the reporting year-end.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryStatus rdf:type rdf:Property ;
    rdfs:label 'Entry Status' ;
    rdfs:comment 'Current lifecycle status of this Schedule F entry within the statutory filing workflow.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundsWithheldAmt rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld Amt' ;
    rdfs:comment 'Amount of reinsurance premium withheld by the cedant under a funds-withheld arrangement, serving as collateral for reinsurer obligations.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netBalanceDueAmt rdf:type rdf:Property ;
    rdfs:label 'Net Balance Due Amt' ;
    rdfs:comment 'Net amount due from (positive) or to (negative) the reinsurer as of year-end, representing the net settlement position on Schedule F.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdueBalanceAmt rdf:type rdf:Property ;
    rdfs:label 'Overdue Balance Amt' ;
    rdfs:comment 'Portion of the net balance due that is overdue per contractual payment terms, triggering collectibility review and potential Schedule F provision.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdueDays rdf:type rdf:Property ;
    rdfs:label 'Overdue Days' ;
    rdfs:comment 'Number of days the oldest unpaid balance has been outstanding beyond contractual due date. Drives Schedule F collectibility aging buckets.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:provisionForReinsuranceAmt rdf:type rdf:Property ;
    rdfs:label 'Provision For Reinsurance Amt' ;
    rdfs:comment 'Statutory provision charged to surplus for potentially uncollectible reinsurance recoverables from this reinsurer, per Schedule F Part 4 calculation.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingAgency rdf:type rdf:Property ;
    rdfs:label 'Rating Agency' ;
    rdfs:comment 'Name of the credit rating agency that issued the reinsurers financial strength rating used in Schedule F collectibility evaluation.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rbcActionLevel rdf:type rdf:Property ;
    rdfs:label 'Rbc Action Level' ;
    rdfs:comment 'NAIC Risk-Based Capital action level of the reinsurer, indicating financial solvency standing. Informs collectibility and Schedule F provision decisions.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerRating rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Rating' ;
    rdfs:comment 'Financial strength rating of the reinsurer from a recognized rating agency (e.g., A.M. Best, S&P) as of the reporting year-end. Used in collectibility assessment.' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Year' ;
    rdfs:comment 'Calendar year for which this Schedule F entry is filed, corresponding to the NAIC Annual Statement reporting period (e.g., 2024).' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduleFPart rdf:type rdf:Property ;
    rdfs:label 'Schedule F Part' ;
    rdfs:comment 'Identifies which part of NAIC Schedule F this entry populates (e.g., Part 3 = Ceded Reinsurance, Part 4 = Provision for Reinsurance).' ;
    rdfs:domain ind:ScheduleFEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermediaryAgencyId rdf:type rdf:Property ;
    rdfs:label 'Intermediary Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Treaties track intermediary/broker by name; should formalize as FK to agency. Enables broker performance analysis on treaty placements, commission tracking for reinsurance intermediation' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:aggregateDeductible rdf:type rdf:Property ;
    rdfs:label 'Aggregate Deductible' ;
    rdfs:comment 'Cumulative loss amount the cedant must absorb before aggregate stop loss or aggregate XOL reinsurance attaches. Also known as the annual aggregate retention.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokeragePct rdf:type rdf:Property ;
    rdfs:label 'Brokerage Pct' ;
    rdfs:comment 'Percentage of ceded premium paid to the reinsurance intermediary as brokerage commission. Expressed as a decimal (e.g., 0.0250 = 2.5%).' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catastropheEventType rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Event Type' ;
    rdfs:comment 'Peril type covered by a CAT XL treaty. Restricts recovery eligibility to specified catastrophe perils. Null for non-CAT treaties. [ENUM-REF-CANDIDATE: WINDSTORM|EARTHQUAKE|FLOOD|WILDFIRE|HAIL|ALL_PERILS|OTHER — promote to reference product]' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositPremium rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium' ;
    rdfs:comment 'Provisional premium paid at treaty inception, subject to adjustment at year-end based on actual subject premium. Common in proportional and adjustable XOL treaties.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inceptionYear rdf:type rdf:Property ;
    rdfs:label 'Inception Year' ;
    rdfs:comment 'Calendar year in which the treaty incepted. Used for underwriting year (UY) and policy year (PY) loss triangle segmentation in actuarial reserving.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:layerNumber rdf:type rdf:Property ;
    rdfs:label 'Layer Number' ;
    rdfs:comment 'Sequential layer number within a tower of XOL or CAT XL protection (e.g., Layer 1, Layer 2). Distinguishes multiple treaties in the same program year.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:limit rdf:type rdf:Property ;
    rdfs:label 'Limit' ;
    rdfs:comment 'Maximum reinsurance recovery available under this treaty per occurrence or in aggregate. Defines the top of the layer for XOL/CAT XL treaties.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCorridorLower rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Lower' ;
    rdfs:comment 'Lower bound of the loss ratio corridor retained by the cedant in a Stop Loss treaty. Expressed as a decimal loss ratio (e.g., 0.7000 = 70%). Null for non-SL treaties.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCorridorUpper rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Upper' ;
    rdfs:comment 'Upper bound of the loss ratio corridor at which Stop Loss reinsurance attaches. Expressed as a decimal loss ratio (e.g., 0.9000 = 90%). Null for non-SL treaties.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremium rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium' ;
    rdfs:comment 'Minimum reinsurance premium guaranteed to the reinsurer regardless of ceded subject premium volume. Protects reinsurer against low-volume years.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treatyName rdf:type rdf:Property ;
    rdfs:label 'Treaty Name' ;
    rdfs:comment 'Descriptive name of the treaty (e.g., \'Property CAT XL Layer 1 2024\'). Used for human identification in reinsurance management system and bordereaux.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceLimit rdf:type rdf:Property ;
    rdfs:label 'Occurrence Limit' ;
    rdfs:comment 'Maximum reinsurance recovery per single occurrence or event under this treaty. Distinct from aggregate limit. Applies to per-occurrence XOL and CAT XL structures.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementPct rdf:type rdf:Property ;
    rdfs:label 'Placement Pct' ;
    rdfs:comment 'Total percentage of treaty capacity placed with all reinsurers combined. A value less than 1.0000 indicates a partially placed treaty with net retained gap.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premium rdf:type rdf:Property ;
    rdfs:label 'Premium' ;
    rdfs:comment 'Total reinsurance premium ceded to reinsurers under this treaty for the treaty period. For QS treaties, this is the ceded written premium. For XOL, this is the flat or deposit premium.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retentionPct rdf:type rdf:Property ;
    rdfs:label 'Retention Pct' ;
    rdfs:comment 'Percentage of risk retained by the cedant under a proportional (QS or Surplus) treaty. Expressed as a decimal (e.g., 0.2500 = 25%). Null for non-proportional treaties.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subjectPremiumBasis rdf:type rdf:Property ;
    rdfs:label 'Subject Premium Basis' ;
    rdfs:comment 'Defines the premium base used to calculate ceded premium under proportional treaties: Gross Written Premium (GWP), Net Written Premium (NWP), Direct Premium Written (DPW), or Net Earned.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyStatus rdf:type rdf:Property ;
    rdfs:label 'Treaty Status' ;
    rdfs:comment 'Current lifecycle state of the treaty. Controls whether new cessions can be written against it and whether recoveries are eligible.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underlyingLayerId rdf:type rdf:Property ;
    rdfs:label 'Underlying Layer Id' ;
    rdfs:comment 'Self-referencing identifier of the immediately underlying treaty layer in a multi-layer tower. Null for the first layer above the cedant retention.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatyLayer .

ind:accountingBasis rdf:type rdf:Property ;
    rdfs:label 'Accounting Basis' ;
    rdfs:comment 'Basis on which losses are covered: losses_occurring (losses that occur during the treaty period) or risks_attaching (policies attaching during the treaty period).' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualAggregateDeductible rdf:type rdf:Property ;
    rdfs:label 'Annual Aggregate Deductible' ;
    rdfs:comment 'Cumulative loss amount the cedant must retain across all occurrences before the annual aggregate limit of this layer begins to respond.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualAggregateLimit rdf:type rdf:Property ;
    rdfs:label 'Annual Aggregate Limit' ;
    rdfs:comment 'Maximum total dollar amount recoverable from reinsurers under this layer across all occurrences within the treaty year. Null if no aggregate cap applies.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokerReference rdf:type rdf:Property ;
    rdfs:label 'Broker Reference' ;
    rdfs:comment 'Reinsurance broker\'s reference number or slip identifier for this layer as used in placement correspondence and market submissions.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cedantRetentionPct rdf:type rdf:Property ;
    rdfs:label 'Cedant Retention Pct' ;
    rdfs:comment 'Percentage of loss within this layer retained by the cedant (co-participation). Expressed as a decimal (e.g., 0.1000 = 10%). Remainder is ceded to reinsurers.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPct rdf:type rdf:Property ;
    rdfs:label 'Ceded Pct' ;
    rdfs:comment 'Percentage of loss within this layer ceded to reinsurers. Equals 1 minus cedant_retention_pct. Stored explicitly for bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexBasis rdf:type rdf:Property ;
    rdfs:label 'Index Basis' ;
    rdfs:comment 'Name or description of the index used for the index clause (e.g., CPI, Marshall & Swift construction cost index). Null if index_clause_flag is false.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Index Clause Flag' ;
    rdfs:comment 'Indicates whether an index or stability clause applies to this layer, adjusting the attachment point and limit in line with an inflation or price index.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:layerCode rdf:type rdf:Property ;
    rdfs:label 'Layer Code' ;
    rdfs:comment 'Externally-known alphanumeric code identifying this layer as referenced in bordereaux, reinsurer slips, and Schedule F filings.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerLimit rdf:type rdf:Property ;
    rdfs:label 'Layer Limit' ;
    rdfs:comment 'Maximum dollar amount recoverable from reinsurers under this layer for a single occurrence or event. Defines the exhaustion point as attachment_point + layer_limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerName rdf:type rdf:Property ;
    rdfs:label 'Layer Name' ;
    rdfs:comment 'Descriptive name for this layer (e.g., \'1st XOL Layer\', \'2nd CAT XL Layer\') used in reinsurer communications and internal reporting.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerNotes rdf:type rdf:Property ;
    rdfs:label 'Layer Notes' ;
    rdfs:comment 'Free-text field for underwriter or reinsurance analyst notes regarding special terms, conditions, or exceptions applicable to this layer not captured in structured fields.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerStatus rdf:type rdf:Property ;
    rdfs:label 'Layer Status' ;
    rdfs:comment 'Current lifecycle state of the treaty layer indicating whether it is actively in force, expired, cancelled, pending placement, or suspended.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerType rdf:type rdf:Property ;
    rdfs:label 'Layer Type' ;
    rdfs:comment 'Classification of the reinsurance layer structure. XOL=Excess of Loss, CAT_XL=Catastrophe Excess of Loss, QS=Quota Share, SL=Stop Loss, WORKING=working layer, CLASH=clash cover.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobScope rdf:type rdf:Property ;
    rdfs:label 'Lob Scope' ;
    rdfs:comment 'Comma-delimited list of Lines of Business covered by this layer (e.g., HO, PAP, CGL, BOP). Defines the subject business eligible for recovery under this layer.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossOccurrenceDefinition rdf:type rdf:Property ;
    rdfs:label 'Loss Occurrence Definition' ;
    rdfs:comment 'Contractual definition of a single occurrence for this layer (e.g., 168-hour clause for windstorm, 72-hour clause for earthquake). Critical for CAT XL aggregation.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilScope rdf:type rdf:Property ;
    rdfs:label 'Peril Scope' ;
    rdfs:comment 'Comma-delimited list of perils covered by this layer (e.g., WIND, QUAKE, FLOOD, FIRE, ALL). Determines which catastrophe events trigger recovery under this layer.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placedPct rdf:type rdf:Property ;
    rdfs:label 'Placed Pct' ;
    rdfs:comment 'Percentage of this layer that has been placed with reinsurers. A value less than 1.0 indicates the layer is not fully subscribed.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementBasis rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Basis' ;
    rdfs:comment 'Basis on which reinstatement premium is calculated: pro_rata (proportional to loss), flat (fixed percentage), or free (no additional premium charged).' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurancePremium rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Premium' ;
    rdfs:comment 'Gross reinsurance premium payable by the cedant to reinsurers for this layer for the treaty period. Used in bordereaux and Schedule F premium reporting.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoRiskId rdf:type rdf:Property ;
    rdfs:label 'Auto Risk Id' ;
    rdfs:comment 'Unique identifier for the auto_risk data product (auto-inserted during validation).' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AutoRisk .

ind:garagingAddressId rdf:type rdf:Property ;
    rdfs:label 'Garaging Address Id' ;
    rdfs:comment 'Foreign key to the address where the vehicle is principally garaged, used for territory rating.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:primaryDriverId rdf:type rdf:Property ;
    rdfs:label 'Primary Driver Id' ;
    rdfs:comment 'Foreign key to the driver record designated as the primary operator of this vehicle.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Driver .

ind:actualCashValueAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cash Value Amount' ;
    rdfs:comment 'Estimated actual cash value of the vehicle at policy inception, used for underwriting and claims settlement.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualMileage rdf:type rdf:Property ;
    rdfs:label 'Annual Mileage' ;
    rdfs:comment 'Estimated annual mileage driven, used as a rating factor for exposure and loss frequency.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:antiTheftDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Anti Theft Device Code' ;
    rdfs:comment 'Code indicating the type of anti-theft device installed, used for premium discounts and underwriting.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUseClass rdf:type rdf:Property ;
    rdfs:label 'Business Use Class' ;
    rdfs:comment 'Detailed business use classification code for commercial vehicles, aligned with SIC or NAICS codes.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueReportIndicator rdf:type rdf:Property ;
    rdfs:label 'Clue Report Indicator' ;
    rdfs:comment 'Flag indicating whether a CLUE report was obtained for underwriting this auto risk.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:garagingState rdf:type rdf:Property ;
    rdfs:label 'Garaging State' ;
    rdfs:comment 'Two-letter state code where the vehicle is principally garaged, critical for rating and regulatory compliance.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:garagingZipCode rdf:type rdf:Property ;
    rdfs:label 'Garaging Zip Code' ;
    rdfs:comment 'ZIP or postal code of the garaging location, used for territory and catastrophe exposure rating.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossFreeYears rdf:type rdf:Property ;
    rdfs:label 'Loss Free Years' ;
    rdfs:comment 'Number of consecutive years without a claim on this vehicle, used for experience rating and discounts.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryUse rdf:type rdf:Property ;
    rdfs:label 'Primary Use' ;
    rdfs:comment 'Primary use classification of the vehicle: pleasure, commuting, business, farm, or artisan, used in rating and underwriting.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Expiration Date' ;
    rdfs:comment 'Expiration date of the prior policy, used to assess continuity of coverage and lapse risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:radiusOfOperation rdf:type rdf:Property ;
    rdfs:label 'Radius Of Operation' ;
    rdfs:comment 'Geographic radius classification for commercial auto: local, intermediate, or long distance, used in commercial auto rating.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateGroup rdf:type rdf:Property ;
    rdfs:label 'Rate Group' ;
    rdfs:comment 'Carrier-specific rate group classification for the vehicle, used in proprietary rating algorithms.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingSymbol rdf:type rdf:Property ;
    rdfs:label 'Rating Symbol' ;
    rdfs:comment 'ISO rating symbol assigned to the vehicle based on make, model, and year, used in premium calculation.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskNumber rdf:type rdf:Property ;
    rdfs:label 'Risk Number' ;
    rdfs:comment 'Business identifier for the auto risk unit, often displayed on declarations pages and used in rating.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Status' ;
    rdfs:comment 'Current lifecycle status of the auto risk unit within the policy term.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyFeatureCode rdf:type rdf:Property ;
    rdfs:label 'Safety Feature Code' ;
    rdfs:comment 'Code representing safety features such as airbags, ABS, or electronic stability control, used for rating discounts.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Stated Value Amount' ;
    rdfs:comment 'Agreed or stated value of the vehicle for valuation purposes, used in classic or specialty auto policies.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tiv rdf:type rdf:Property ;
    rdfs:label 'Tiv' ;
    rdfs:comment 'Total insured value of the auto risk, representing maximum exposure for catastrophe and reinsurance aggregation.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleOwnership rdf:type rdf:Property ;
    rdfs:label 'Vehicle Ownership' ;
    rdfs:comment 'Ownership status of the vehicle: owned, leased, financed, or hired, relevant for coverage and loss payee requirements.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleUseDescription rdf:type rdf:Property ;
    rdfs:label 'Vehicle Use Description' ;
    rdfs:comment 'Free-text description of the vehicles specific use, captured during underwriting for risk assessment.' ;
    rdfs:domain ind:AutoRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCashValue rdf:type rdf:Property ;
    rdfs:label 'Actual Cash Value' ;
    rdfs:comment 'Replacement cost value minus depreciation. Used for certain coverage types and loss settlement.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basementFinishType rdf:type rdf:Property ;
    rdfs:label 'Basement Finish Type' ;
    rdfs:comment 'Classification of basement finish: finished, partially finished, unfinished, or none.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basementIndicator rdf:type rdf:Property ;
    rdfs:label 'Basement Indicator' ;
    rdfs:comment 'Indicates whether the building has a basement. True if basement present, false otherwise.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buildingStatus rdf:type rdf:Property ;
    rdfs:label 'Building Status' ;
    rdfs:comment 'Current operational status of the building: active, vacant, under construction, under renovation, or demolished.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:burglarAlarmIndicator rdf:type rdf:Property ;
    rdfs:label 'Burglar Alarm Indicator' ;
    rdfs:comment 'Indicates whether the building has a burglar or intrusion alarm system installed. True if present, false otherwise.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:centralStationMonitoringIndicator rdf:type rdf:Property ;
    rdfs:label 'Central Station Monitoring Indicator' ;
    rdfs:comment 'Indicates whether fire or burglar alarms are monitored by a central station. True if monitored, false otherwise.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coolingType rdf:type rdf:Property ;
    rdfs:label 'Cooling Type' ;
    rdfs:comment 'Primary cooling system type (e.g., central air, window units, evaporative, none). Impacts equipment breakdown risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceToFireHydrantFeet rdf:type rdf:Property ;
    rdfs:label 'Distance To Fire Hydrant Feet' ;
    rdfs:comment 'Distance in feet from the building to the nearest fire hydrant. Used for protection class rating.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earthquakeRetrofitIndicator rdf:type rdf:Property ;
    rdfs:label 'Earthquake Retrofit Indicator' ;
    rdfs:comment 'Indicates whether the building has been retrofitted for earthquake resistance. True if retrofitted, false otherwise.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electricalSystemYear rdf:type rdf:Property ;
    rdfs:label 'Electrical System Year' ;
    rdfs:comment 'Calendar year the electrical system was last updated or replaced. Used for age-based risk assessment.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exteriorWallMaterial rdf:type rdf:Property ;
    rdfs:label 'Exterior Wall Material' ;
    rdfs:comment 'Primary material used for exterior walls (e.g., brick, wood siding, vinyl, stucco). Impacts fire and wind rating.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireAlarmIndicator rdf:type rdf:Property ;
    rdfs:label 'Fire Alarm Indicator' ;
    rdfs:comment 'Indicates whether the building has a fire alarm system installed. True if present, false otherwise.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:floodVentsIndicator rdf:type rdf:Property ;
    rdfs:label 'Flood Vents Indicator' ;
    rdfs:comment 'Indicates whether the building has flood vents installed per NFIP (National Flood Insurance Program) standards. True if present, false otherwise.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:foundationType rdf:type rdf:Property ;
    rdfs:label 'Foundation Type' ;
    rdfs:comment 'Type of building foundation: slab, crawl space, basement, pier, or other. Impacts flood and earthquake risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heatingType rdf:type rdf:Property ;
    rdfs:label 'Heating Type' ;
    rdfs:comment 'Primary heating system type (e.g., forced air, hot water, electric, steam). Impacts fire and equipment breakdown risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hvacSystemYear rdf:type rdf:Property ;
    rdfs:label 'Hvac System Year' ;
    rdfs:comment 'Calendar year the HVAC system was last updated or replaced. Used for equipment breakdown risk assessment.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isoBuildingClass rdf:type rdf:Property ;
    rdfs:label 'Iso Building Class' ;
    rdfs:comment 'ISO classification code for the building type used in property rating and underwriting.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingName rdf:type rdf:Property ;
    rdfs:label 'Building Name' ;
    rdfs:comment 'Descriptive name or label for the building, if applicable.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfUnits rdf:type rdf:Property ;
    rdfs:label 'Number Of Units' ;
    rdfs:comment 'Total count of dwelling units or rental units in the building, if applicable (e.g., for apartment buildings).' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:plumbingSystemYear rdf:type rdf:Property ;
    rdfs:label 'Plumbing System Year' ;
    rdfs:comment 'Calendar year the plumbing system was last updated or replaced. Used for water damage risk assessment.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:replacementCostValue rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Value' ;
    rdfs:comment 'Estimated cost to replace the building with materials of like kind and quality at current prices. Used for coverage limits and ITV (Insurance to Value) calculation.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roofMaterial rdf:type rdf:Property ;
    rdfs:label 'Roof Material' ;
    rdfs:comment 'Primary material used for the roof covering (e.g., asphalt shingle, metal, tile, slate). Impacts wind and hail rating.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roofType rdf:type rdf:Property ;
    rdfs:label 'Roof Type' ;
    rdfs:comment 'Classification of the roof structure: flat, gable, hip, mansard, gambrel, shed, or other. [ENUM-REF-CANDIDATE: flat|gable|hip|mansard|gambrel|shed|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roofYear rdf:type rdf:Property ;
    rdfs:label 'Roof Year' ;
    rdfs:comment 'Calendar year the roof was last replaced or substantially renovated. Used for age-based rating adjustments.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sprinklerIndicator rdf:type rdf:Property ;
    rdfs:label 'Sprinkler Indicator' ;
    rdfs:comment 'Indicates whether the building has an automatic fire sprinkler system installed. True if sprinklered, false otherwise.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sprinklerType rdf:type rdf:Property ;
    rdfs:label 'Sprinkler Type' ;
    rdfs:comment 'Classification of the fire sprinkler system: wet pipe, dry pipe, pre-action, deluge, or none.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalSquareFootage rdf:type rdf:Property ;
    rdfs:label 'Total Square Footage' ;
    rdfs:comment 'Total floor area of the building in square feet. Used for exposure calculation and rating.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vacancyIndicator rdf:type rdf:Property ;
    rdfs:label 'Vacancy Indicator' ;
    rdfs:comment 'Indicates whether the building is currently vacant. True if vacant, false if occupied. Impacts underwriting and rating.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vacancyStartDate rdf:type rdf:Property ;
    rdfs:label 'Vacancy Start Date' ;
    rdfs:comment 'Date the building became vacant, if applicable. Used for vacancy clause enforcement.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:windMitigationFeatures rdf:type rdf:Property ;
    rdfs:label 'Wind Mitigation Features' ;
    rdfs:comment 'Description of wind mitigation features present (e.g., hurricane straps, impact-resistant windows, reinforced roof deck). Used for wind rating credits.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverId rdf:type rdf:Property ;
    rdfs:label 'Driver Id' ;
    rdfs:comment 'Unique identifier for the driver data product (auto-inserted during validation).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Driver .

ind:primaryVehicleId rdf:type rdf:Property ;
    rdfs:label 'Primary Vehicle Id' ;
    rdfs:comment 'Foreign key to the vehicle this driver primarily operates, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:age rdf:type rdf:Property ;
    rdfs:label 'Age' ;
    rdfs:comment 'Current age of the driver in years, calculated from date of birth.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clueReportOrderDate rdf:type rdf:Property ;
    rdfs:label 'Clue Report Order Date' ;
    rdfs:comment 'Date the CLUE report was ordered to review the driver prior claim and loss history.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clueReportReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Clue Report Receipt Date' ;
    rdfs:comment 'Date the CLUE report was received and available for underwriting review.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:defensiveDrivingCourseDate rdf:type rdf:Property ;
    rdfs:label 'Defensive Driving Course Date' ;
    rdfs:comment 'Date the driver completed the defensive driving course, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:defensiveDrivingCourseIndicator rdf:type rdf:Property ;
    rdfs:label 'Defensive Driving Course Indicator' ;
    rdfs:comment 'Indicates whether the driver has completed an approved defensive driving or driver training course.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:driverType rdf:type rdf:Property ;
    rdfs:label 'Driver Type' ;
    rdfs:comment 'Classification of the driver role on the policy: principal operator, additional driver, excluded driver, or occasional operator.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedDriverIndicator rdf:type rdf:Property ;
    rdfs:label 'Excluded Driver Indicator' ;
    rdfs:comment 'Indicates whether this driver has been formally excluded from coverage under the policy by endorsement.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:excludedDriverReason rdf:type rdf:Property ;
    rdfs:label 'Excluded Driver Reason' ;
    rdfs:comment 'Reason the driver was excluded from coverage, such as poor driving record, unlicensed, or policyholder request.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodStudentIndicator rdf:type rdf:Property ;
    rdfs:label 'Good Student Indicator' ;
    rdfs:comment 'Indicates whether the driver qualifies for a good student discount based on academic performance.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrAccidentCount rdf:type rdf:Property ;
    rdfs:label 'Mvr Accident Count' ;
    rdfs:comment 'Total number of at-fault accidents recorded on the driver MVR within the underwriting review period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mvrCleanRecordIndicator rdf:type rdf:Property ;
    rdfs:label 'Mvr Clean Record Indicator' ;
    rdfs:comment 'Indicates whether the driver has a clean MVR with no violations, accidents, or suspensions in the review period.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrDuiIndicator rdf:type rdf:Property ;
    rdfs:label 'Mvr Dui Indicator' ;
    rdfs:comment 'Indicates whether the driver has a DUI or DWI conviction recorded on the MVR within the review period.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrMostRecentViolationDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Most Recent Violation Date' ;
    rdfs:comment 'Date of the most recent moving violation recorded on the driver MVR.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mvrReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Receipt Date' ;
    rdfs:comment 'Date the Motor Vehicle Record report was received and available for underwriting review.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mvrStatus rdf:type rdf:Property ;
    rdfs:label 'Mvr Status' ;
    rdfs:comment 'Current status of the MVR report: ordered, received, clean record, violations found, pending review, or error in retrieval.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrViolationCount rdf:type rdf:Property ;
    rdfs:label 'Mvr Violation Count' ;
    rdfs:comment 'Total number of moving violations recorded on the driver MVR within the underwriting review period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupation rdf:type rdf:Property ;
    rdfs:label 'Occupation' ;
    rdfs:comment 'The driver occupation or job title, used as a rating factor in some jurisdictions.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupationClass rdf:type rdf:Property ;
    rdfs:label 'Occupation Class' ;
    rdfs:comment 'Standardized occupation classification code or category for rating purposes.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingTier rdf:type rdf:Property ;
    rdfs:label 'Rating Tier' ;
    rdfs:comment 'Underwriting tier assigned to the driver based on risk profile: preferred, standard, non-standard, or declined.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToNamedInsured rdf:type rdf:Property ;
    rdfs:label 'Relationship To Named Insured' ;
    rdfs:comment 'The driver relationship to the named insured on the policy: self, spouse, child, parent, sibling, or other.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:score rdf:type rdf:Property ;
    rdfs:label 'Score' ;
    rdfs:comment 'Numeric risk score assigned to the driver based on MVR, CLUE, and other underwriting factors.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sr22ExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Sr22 Expiration Date' ;
    rdfs:comment 'Date the SR-22 filing requirement expires, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sr22FilingDate rdf:type rdf:Property ;
    rdfs:label 'Sr22 Filing Date' ;
    rdfs:comment 'Date the SR-22 certificate was filed with the state, if applicable.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sr22Indicator rdf:type rdf:Property ;
    rdfs:label 'Sr22 Indicator' ;
    rdfs:comment 'Indicates whether an SR-22 certificate of financial responsibility filing is required for this driver.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearsLicensed rdf:type rdf:Property ;
    rdfs:label 'Years Licensed' ;
    rdfs:comment 'Number of years the driver has held a valid driver license, used for experience-based rating.' ;
    rdfs:domain ind:Driver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:driverViolationId rdf:type rdf:Property ;
    rdfs:label 'Driver Violation Id' ;
    rdfs:comment 'Unique identifier for the driver violation incident record.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualSpeed rdf:type rdf:Property ;
    rdfs:label 'Actual Speed' ;
    rdfs:comment 'Actual speed of the vehicle at the time of the incident, in miles per hour.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:atFaultIndicator rdf:type rdf:Property ;
    rdfs:label 'At Fault Indicator' ;
    rdfs:comment 'Flag indicating whether the driver was determined to be at fault for the incident.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chargeableIndicator rdf:type rdf:Property ;
    rdfs:label 'Chargeable Indicator' ;
    rdfs:comment 'Flag indicating whether this incident is chargeable for underwriting and rating purposes.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:convictionDate rdf:type rdf:Property ;
    rdfs:label 'Conviction Date' ;
    rdfs:comment 'Date when the driver was convicted of the violation, if applicable.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:convictionStatus rdf:type rdf:Property ;
    rdfs:label 'Conviction Status' ;
    rdfs:comment 'Legal outcome of the violation: convicted, pending, dismissed, or not guilty.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duiIndicator rdf:type rdf:Property ;
    rdfs:label 'Dui Indicator' ;
    rdfs:comment 'Flag indicating whether the incident involved driving under the influence of alcohol or drugs.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fatalityIndicator rdf:type rdf:Property ;
    rdfs:label 'Fatality Indicator' ;
    rdfs:comment 'Flag indicating whether the incident resulted in a fatality.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:faultPercentage rdf:type rdf:Property ;
    rdfs:label 'Fault Percentage' ;
    rdfs:comment 'Percentage of fault assigned to the driver for the incident, ranging from 0.00 to 100.00.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incidentDate rdf:type rdf:Property ;
    rdfs:label 'Incident Date' ;
    rdfs:comment 'Date when the violation, accident, or loss occurred.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentType rdf:type rdf:Property ;
    rdfs:label 'Incident Type' ;
    rdfs:comment 'Classification of the incident: violation, accident, claim, or prior loss.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryIndicator rdf:type rdf:Property ;
    rdfs:label 'Injury Indicator' ;
    rdfs:comment 'Flag indicating whether the incident resulted in bodily injury.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lightCondition rdf:type rdf:Property ;
    rdfs:label 'Light Condition' ;
    rdfs:comment 'Lighting condition at the time of the incident: daylight, dusk, dawn, dark, or dark with street lighting.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationDescription rdf:type rdf:Property ;
    rdfs:label 'Location Description' ;
    rdfs:comment 'Textual description of the location where the incident occurred (e.g., street address, intersection, highway mile marker).' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lookbackExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Lookback Expiration Date' ;
    rdfs:comment 'Date after which this incident is no longer considered in underwriting or rating lookback periods.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossAmount rdf:type rdf:Property ;
    rdfs:label 'Loss Amount' ;
    rdfs:comment 'Total dollar amount of the loss or claim associated with this incident.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pointsAssessed rdf:type rdf:Property ;
    rdfs:label 'Points Assessed' ;
    rdfs:comment 'Number of points assessed against the driver license for this violation.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingImpactPoints rdf:type rdf:Property ;
    rdfs:label 'Rating Impact Points' ;
    rdfs:comment 'Numeric points or factor applied to the rating algorithm as a result of this incident.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roadCondition rdf:type rdf:Property ;
    rdfs:label 'Road Condition' ;
    rdfs:comment 'Road surface condition at the time of the incident: dry, wet, icy, snowy, muddy, or other.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Underwriting severity classification of the incident: minor, moderate, major, or severe.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Source Reference Number' ;
    rdfs:comment 'External reference or tracking number from the source system (e.g., MVR report number, CLUE claim number).' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:speedLimit rdf:type rdf:Property ;
    rdfs:label 'Speed Limit' ;
    rdfs:comment 'Posted speed limit at the location of the incident, in miles per hour.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:speedingIndicator rdf:type rdf:Property ;
    rdfs:label 'Speeding Indicator' ;
    rdfs:comment 'Flag indicating whether the incident involved a speeding violation.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwritingImpactCode rdf:type rdf:Property ;
    rdfs:label 'Underwriting Impact Code' ;
    rdfs:comment 'Internal code representing the underwriting impact or surcharge tier resulting from this incident.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationCode rdf:type rdf:Property ;
    rdfs:label 'Violation Code' ;
    rdfs:comment 'Standardized code representing the type of violation per state or NAIC classification.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationDescription rdf:type rdf:Property ;
    rdfs:label 'Violation Description' ;
    rdfs:comment 'Detailed narrative description of the violation or incident.' ;
    rdfs:domain ind:DriverViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureScheduleId rdf:type rdf:Property ;
    rdfs:label 'Exposure Schedule Id' ;
    rdfs:comment 'Unique identifier for each scheduled exposure entry. Primary key for the exposure schedule table.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blanketGroupCode rdf:type rdf:Property ;
    rdfs:label 'Blanket Group Code' ;
    rdfs:comment 'Identifier grouping multiple schedule entries under a single blanket limit. Null if not part of a blanket arrangement.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingNumber rdf:type rdf:Property ;
    rdfs:label 'Building Number' ;
    rdfs:comment 'Building identifier within a location for property schedules (e.g., Building 1, Warehouse B). Null for non-property schedules.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Equipment Serial Number' ;
    rdfs:comment 'Manufacturer serial number for scheduled equipment or machinery. Null for non-equipment schedules.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Exposure Schedule Status' ;
    rdfs:comment 'Current status of this schedule entry: Active (in force), Deleted (removed from schedule), Suspended, Pending (not yet effective), or Expired.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZoneDesignation rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Designation' ;
    rdfs:comment 'FEMA flood zone designation for the scheduled location (e.g., A, AE, X, V). Null if not in a flood zone.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Line Of Business' ;
    rdfs:comment 'Insurance line of business to which this scheduled exposure applies (e.g., Commercial Property, Commercial Auto, Inland Marine). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationNumber rdf:type rdf:Property ;
    rdfs:label 'Location Number' ;
    rdfs:comment 'Business-assigned location identifier for property schedules (e.g., Location 001, Site A). Null for non-property schedules.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyCode rdf:type rdf:Property ;
    rdfs:label 'Occupancy Code' ;
    rdfs:comment 'ISO or carrier-specific occupancy classification code for the scheduled risk (e.g., manufacturing, retail, office).' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumBasis rdf:type rdf:Property ;
    rdfs:label 'Premium Basis' ;
    rdfs:comment 'Rating basis used to calculate premium for this scheduled item (e.g., per $100 of value, per vehicle, per square foot, flat charge).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorScheduledValueAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Scheduled Value Amount' ;
    rdfs:comment 'Previous insured value before the most recent endorsement or change. Null for new entries.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskUnitDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Unit Description' ;
    rdfs:comment 'Business description of the scheduled risk unit (e.g., Main Warehouse Building, 2023 Ford F-150 Fleet Vehicle, CNC Milling Machine).' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleEntryNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Entry Number' ;
    rdfs:comment 'Sequential or business-assigned identifier for this entry within the schedule (e.g., Location 001, Vehicle 005).' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Premium Amount' ;
    rdfs:comment 'Premium amount calculated for this specific scheduled item, before taxes and fees.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledValueAmount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Value Amount' ;
    rdfs:comment 'Insured value or limit assigned to this specific scheduled item (e.g., building value, vehicle stated amount, equipment replacement cost).' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledValueCurrency rdf:type rdf:Property ;
    rdfs:label 'Scheduled Value Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the scheduled value amount (e.g., USD, CAD, EUR).' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAreaSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Total Area Square Feet' ;
    rdfs:comment 'Total square footage of scheduled building or facility. Null for non-property schedules.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Vehicle Identification Number' ;
    rdfs:comment '17-character VIN for scheduled vehicles in commercial auto fleet schedules. Null for non-auto schedules.' ;
    rdfs:domain ind:ExposureSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionCode rdf:type rdf:Property ;
    rdfs:label 'Construction Code' ;
    rdfs:comment 'ISO or NAIC construction type code. Part of COPE data for property risks.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZoneCode rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Code' ;
    rdfs:comment 'FEMA flood zone designation for this risk. Determines flood coverage eligibility and pricing.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Inspection Required Flag' ;
    rdfs:comment 'Indicates whether a physical inspection is required for this risk before binding or renewal.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Status' ;
    rdfs:comment 'Current status of the inspection requirement for this risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itvPercentage rdf:type rdf:Property ;
    rdfs:label 'Itv Percentage' ;
    rdfs:comment 'Ratio of sum insured to total insured value, expressed as percentage. Used to identify underinsurance and apply coinsurance penalties.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorLossAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Loss Amount' ;
    rdfs:comment 'Total dollar amount of prior losses for this risk or similar risks. Used in underwriting evaluation and pricing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorLossCount rdf:type rdf:Property ;
    rdfs:label 'Prior Loss Count' ;
    rdfs:comment 'Number of prior losses reported for this risk or similar risks. Used in underwriting evaluation and pricing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Rating Territory Code' ;
    rdfs:comment 'Territory code used for rating and pricing this risk. Links to rating tables and catastrophe zones.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Description' ;
    rdfs:comment 'Free-text narrative describing the insured risk. Appears on policy declarations and endorsements.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sumInsuredAmount rdf:type rdf:Property ;
    rdfs:label 'Sum Insured Amount' ;
    rdfs:comment 'Sum insured representing the policy limit applicable to this risk. May differ from total insured value based on underwriting decisions.' ;
    rdfs:domain ind:InsuredRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alarmType rdf:type rdf:Property ;
    rdfs:label 'Alarm Type' ;
    rdfs:comment 'Type of fire or burglar alarm system installed at the location. Used for rating credits.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingLimit rdf:type rdf:Property ;
    rdfs:label 'Building Limit' ;
    rdfs:comment 'Coverage limit for the building structure at this location. Part of TIV calculation.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessIncomeLimit rdf:type rdf:Property ;
    rdfs:label 'Business Income Limit' ;
    rdfs:comment 'Coverage limit for business interruption or time element coverage at this location. Part of TIV calculation.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coastalDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Coastal Distance Miles' ;
    rdfs:comment 'Distance in miles from the location to the nearest coastline. Used for hurricane and storm surge exposure assessment.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contentsLimit rdf:type rdf:Property ;
    rdfs:label 'Contents Limit' ;
    rdfs:comment 'Coverage limit for business personal property and contents at this location. Part of TIV calculation.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countyName rdf:type rdf:Property ;
    rdfs:label 'County Name' ;
    rdfs:comment 'County or parish name for the location. Used for regulatory and catastrophe aggregation.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earthquakeDeductiblePercent rdf:type rdf:Property ;
    rdfs:label 'Earthquake Deductible Percent' ;
    rdfs:comment 'Percentage deductible applied to earthquake losses at this location. Common in seismic zones.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fireStationDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Fire Station Distance Miles' ;
    rdfs:comment 'Distance in miles from the location to the nearest fire station. Used for protection class rating.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geocodeAccuracy rdf:type rdf:Property ;
    rdfs:label 'Geocode Accuracy' ;
    rdfs:comment 'Precision level of the geocoded coordinates. Rooftop is most precise, county is least precise.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hydrantDistanceFeet rdf:type rdf:Property ;
    rdfs:label 'Hydrant Distance Feet' ;
    rdfs:comment 'Distance in feet from the location to the nearest fire hydrant. Used for protection class rating.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current lifecycle status of the location within the policy. Active locations are in force and contribute to exposure.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Business or site name for the insured location. Human-readable label for the property.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windDeductiblePercent rdf:type rdf:Property ;
    rdfs:label 'Wind Deductible Percent' ;
    rdfs:comment 'Percentage deductible applied to wind and hail losses at this location. Common in coastal and high-wind areas.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearRenovated rdf:type rdf:Property ;
    rdfs:label 'Year Renovated' ;
    rdfs:comment 'Year of most recent major renovation or update to the building. Used for underwriting and rating adjustments.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyOwnerPartyId rdf:type rdf:Property ;
    rdfs:label 'Property Owner Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Property underwriting requires direct link to property owner party for title verification, loss payee validation, and insured interest determination.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:electricalSystemType rdf:type rdf:Property ;
    rdfs:label 'Electrical System Type' ;
    rdfs:comment 'The type of electrical system. Examples: circuit breaker, fuse box, knob and tube. Impacts fire risk.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceToValuePercentage rdf:type rdf:Property ;
    rdfs:label 'Insurance To Value Percentage' ;
    rdfs:comment 'The ratio of insured value to replacement cost value, expressed as a percentage. Used to assess adequacy of coverage and apply coinsurance penalties.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isoConstructionCode rdf:type rdf:Property ;
    rdfs:label 'Iso Construction Code' ;
    rdfs:comment 'ISO standard construction classification code used for rating and catastrophe modeling.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plumbingType rdf:type rdf:Property ;
    rdfs:label 'Plumbing Type' ;
    rdfs:comment 'The type of plumbing material. Examples: copper, PVC, galvanized, PEX. Impacts water damage risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryBuildingId rdf:type rdf:Property ;
    rdfs:label 'Primary Building Id' ;
    rdfs:comment 'Foreign key to the building record if this property risk is a structure.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyStatus rdf:type rdf:Property ;
    rdfs:label 'Property Status' ;
    rdfs:comment 'Current lifecycle status of the property risk record within the policy term.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roofShape rdf:type rdf:Property ;
    rdfs:label 'Roof Shape' ;
    rdfs:comment 'The architectural shape of the roof. Impacts wind resistance and catastrophe modeling.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sprinklerSystemIndicator rdf:type rdf:Property ;
    rdfs:label 'Sprinkler System Indicator' ;
    rdfs:comment 'Indicates whether the property has an automatic fire sprinkler system. Provides premium credit and reduces fire loss potential.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:squareFootage rdf:type rdf:Property ;
    rdfs:label 'Square Footage' ;
    rdfs:comment 'Total square footage of the property. Used for rating, valuation, and catastrophe exposure aggregation.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCharacteristicId rdf:type rdf:Property ;
    rdfs:label 'Risk Characteristic Id' ;
    rdfs:comment 'Unique identifier for the risk characteristic record. Primary key.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessDescription rdf:type rdf:Property ;
    rdfs:label 'Business Description' ;
    rdfs:comment 'Free-text description of the business operations or activities at the insured risk location.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:characteristicName rdf:type rdf:Property ;
    rdfs:label 'Characteristic Name' ;
    rdfs:comment 'The name or label of the risk characteristic attribute being captured.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:characteristicStatus rdf:type rdf:Property ;
    rdfs:label 'Characteristic Status' ;
    rdfs:comment 'The current status of this characteristic record in the system.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:characteristicType rdf:type rdf:Property ;
    rdfs:label 'Characteristic Type' ;
    rdfs:comment 'The category or domain of the characteristic being captured. [ENUM-REF-CANDIDATE: physical|operational|financial|occupancy|construction|protection|exposure|business|driver|vehicle|location — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:characteristicValue rdf:type rdf:Property ;
    rdfs:label 'Characteristic Value' ;
    rdfs:comment 'The value of the characteristic attribute for this insured risk.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsFreeYears rdf:type rdf:Property ;
    rdfs:label 'Claims Free Years' ;
    rdfs:comment 'The number of consecutive years without a claim for this insured risk.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distanceToHydrantFeet rdf:type rdf:Property ;
    rdfs:label 'Distance To Hydrant Feet' ;
    rdfs:comment 'The distance in feet from the insured building to the nearest fire hydrant.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dogBreed rdf:type rdf:Property ;
    rdfs:label 'Dog Breed' ;
    rdfs:comment 'The breed of dog present at the insured location if applicable.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverTrainingIndicator rdf:type rdf:Property ;
    rdfs:label 'Driver Training Indicator' ;
    rdfs:comment 'Indicates whether the driver has completed an approved driver training course.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:garagingLocation rdf:type rdf:Property ;
    rdfs:label 'Garaging Location' ;
    rdfs:comment 'The type of location where the insured vehicle is regularly parked or garaged.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfEmployees rdf:type rdf:Property ;
    rdfs:label 'Number Of Employees' ;
    rdfs:comment 'The total number of employees at the insured business location.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:poolIndicator rdf:type rdf:Property ;
    rdfs:label 'Pool Indicator' ;
    rdfs:comment 'Indicates whether the property has a swimming pool present.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorInsuranceIndicator rdf:type rdf:Property ;
    rdfs:label 'Prior Insurance Indicator' ;
    rdfs:comment 'Indicates whether the insured had continuous prior insurance coverage.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roofAgeYears rdf:type rdf:Property ;
    rdfs:label 'Roof Age Years' ;
    rdfs:comment 'The age of the roof in years since last replacement or installation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trampolineIndicator rdf:type rdf:Property ;
    rdfs:label 'Trampoline Indicator' ;
    rdfs:comment 'Indicates whether the property has a trampoline present.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vehicleUsageType rdf:type rdf:Property ;
    rdfs:label 'Vehicle Usage Type' ;
    rdfs:comment 'The primary usage classification of the insured vehicle.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wiringType rdf:type rdf:Property ;
    rdfs:label 'Wiring Type' ;
    rdfs:comment 'The type of electrical wiring present in the insured building.' ;
    rdfs:domain ind:RiskCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskImprovementId rdf:type rdf:Property ;
    rdfs:label 'Risk Improvement Id' ;
    rdfs:comment 'Unique identifier for the risk improvement condition record.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Actual cost incurred by the insured to complete the improvement condition, if reported.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Date' ;
    rdfs:comment 'Date on which the insured completed the improvement condition and compliance was verified.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceMethod rdf:type rdf:Property ;
    rdfs:label 'Compliance Method' ;
    rdfs:comment 'Method by which compliance with the improvement condition was verified.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Amount' ;
    rdfs:comment 'Estimated cost to the insured to complete the improvement condition, used for underwriting and customer communication.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extensionCount rdf:type rdf:Property ;
    rdfs:label 'Extension Count' ;
    rdfs:comment 'Number of times the due date for this improvement condition has been extended.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:followUpDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Date' ;
    rdfs:comment 'Scheduled date for follow-up action or review of the improvement condition status.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required Flag' ;
    rdfs:comment 'Indicates whether follow-up action is required from underwriting or customer service regarding this improvement condition.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imposedDate rdf:type rdf:Property ;
    rdfs:label 'Imposed Date' ;
    rdfs:comment 'Date on which the improvement condition was imposed by the underwriter.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:improvementCategory rdf:type rdf:Property ;
    rdfs:label 'Improvement Category' ;
    rdfs:comment 'Broad category of the improvement condition based on the risk mitigation area.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementCode rdf:type rdf:Property ;
    rdfs:label 'Improvement Code' ;
    rdfs:comment 'Standardized code representing the improvement condition, often from ISO or carrier-specific code tables.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementDescription rdf:type rdf:Property ;
    rdfs:label 'Improvement Description' ;
    rdfs:comment 'Detailed narrative description of the improvement condition, including specific actions required or recommended.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementNumber rdf:type rdf:Property ;
    rdfs:label 'Improvement Number' ;
    rdfs:comment 'Business identifier for the improvement condition, often displayed on declarations page and correspondence.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementStatus rdf:type rdf:Property ;
    rdfs:label 'Improvement Status' ;
    rdfs:comment 'Current lifecycle status of the improvement condition tracking workflow.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementType rdf:type rdf:Property ;
    rdfs:label 'Improvement Type' ;
    rdfs:comment 'Classification of the improvement condition: required (mandatory for coverage), recommended (suggested), or optional (voluntary).' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionReportReference rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Reference' ;
    rdfs:comment 'Reference number or document identifier for the inspection report verifying completion of the improvement condition.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCompany rdf:type rdf:Property ;
    rdfs:label 'Inspector Company' ;
    rdfs:comment 'Name of the inspection company or vendor organization that performed the verification.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorName rdf:type rdf:Property ;
    rdfs:label 'Inspector Name' ;
    rdfs:comment 'Name of the inspector or third-party vendor who verified completion of the improvement condition.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastExtensionDate rdf:type rdf:Property ;
    rdfs:label 'Last Extension Date' ;
    rdfs:comment 'Date of the most recent extension granted for the improvement condition due date.' ;
    rdfs:domain ind:RiskImprovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'User identifier or name of the person who last modified this risk improvement condition record.' ;
