    rdfs:comment 'Estimated payroll amount provided at policy inception, used for initial premium calculation subject to audit adjustment.' ;
    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executiveOfficerPayroll rdf:type rdf:Property ;
