ind:nepaInvolvement rdf:type rdf:Property ;
    rdfs:label 'Nepa Involvement' ;
    rdfs:comment 'Indicates whether the agency is involved in NEPA environmental review processes for transportation projects.' ;
    rdfs:domain ind:Agency ;
