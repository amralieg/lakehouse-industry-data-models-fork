    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDaysRequested rdf:type rdf:Property ;
    rdfs:label 'Total Days Requested' ;
    rdfs:comment 'Total number of leave days requested for this leave period.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceBeforeRequest rdf:type rdf:Property ;
    rdfs:label 'Balance Before Request' ;
    rdfs:comment 'Available leave balance in hours before this request was submitted.' ;
