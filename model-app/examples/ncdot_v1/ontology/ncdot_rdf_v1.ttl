    rdfs:comment 'Reference to the original depreciation entry identifier if this entry is a reversal or adjustment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Ncdot .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'The SAP document type code indicating the category of financial transaction (e.g., AF for asset posting).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingKey rdf:type rdf:Property ;
    rdfs:label 'Posting Key' ;
    rdfs:comment 'The SAP posting key that controls the type of posting (debit or credit) and account type.' ;
    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'The currency exchange rate applied if the asset was acquired in a foreign currency.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maintenanceScheduleId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Schedule Id' ;
    rdfs:comment 'Unique identifier for the planned preventive maintenance schedule record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaintenanceSchedule .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Descriptive name or title of the maintenance schedule plan.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Classification of the maintenance schedule based on the triggering methodology (preventive, predictive, condition-based, time-based, usage-based, seasonal, regulatory, or inspection).' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyValue rdf:type rdf:Property ;
    rdfs:label 'Frequency Value' ;
    rdfs:comment 'Numeric value representing how often the maintenance activity should occur (e.g., every 30 days, every 5000 miles).' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyUnit rdf:type rdf:Property ;
    rdfs:label 'Frequency Unit' ;
    rdfs:comment 'Unit of measurement for the maintenance frequency (days, weeks, months, years, hours, miles, kilometers, cycles, or events).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyDescription rdf:type rdf:Property ;
    rdfs:label 'Frequency Description' ;
    rdfs:comment 'Human-readable description of the maintenance frequency (e.g., \'Every 6 months\', \'Every 10,000 miles\').' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderType rdf:type rdf:Property ;
