ind:gradeType rdf:type rdf:Property ;
    rdfs:label 'Grade Type' ;
    rdfs:comment 'Classification type of the salary grade indicating employment category (e.g., classified civil service, unclassified, temporary).' ;
    rdfs:domain ind:SalaryGrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spanOfControlMin rdf:type rdf:Property ;
    rdfs:label 'Span Of Control Min' ;
    rdfs:comment 'Minimum number of direct reports typically expected for supervisory positions in this grade.' ;
