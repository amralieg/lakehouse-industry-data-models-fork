ind:noteCalendarId rdf:type rdf:Property ;
    rdfs:label 'Note Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Claim note date determines note period for activity tracking, diary management, and audit trail. Essential for claim activity analysis and operational metrics.' ;
    rdfs:domain ind:ClaimNote ;
