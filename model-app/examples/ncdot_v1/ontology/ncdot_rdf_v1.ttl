    rdfs:comment 'Flag indicating whether the benefit plan complies with HIPAA privacy and security requirements.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planNotes rdf:type rdf:Property ;
    rdfs:label 'Plan Notes' ;
    rdfs:comment 'Additional notes, comments, or special instructions related to the benefit plan administration or coverage.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapHrPlanId rdf:type rdf:Property ;
    rdfs:label 'Sap Hr Plan Id' ;
    rdfs:comment 'Unique identifier for the benefit plan in the SAP HR system for integration and cross-reference purposes.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:beaconPlanId rdf:type rdf:Property ;
    rdfs:label 'Beacon Plan Id' ;
