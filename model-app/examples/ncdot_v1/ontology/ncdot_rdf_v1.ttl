    rdfs:comment 'Classification code for the type of work order that will be generated from this schedule.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taskListId rdf:type rdf:Property ;
    rdfs:label 'Task List Id' ;
    rdfs:comment 'Reference identifier to the standard task list or maintenance plan that defines the specific activities to be performed.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaskList .

ind:taskDescription rdf:type rdf:Property ;
    rdfs:label 'Task Description' ;
    rdfs:comment 'Detailed description of the maintenance tasks and activities to be performed during the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLaborHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Hours' ;
    rdfs:comment 'Estimated total labor hours required to complete the maintenance tasks.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleCrewId rdf:type rdf:Property ;
    rdfs:label 'Responsible Crew Id' ;
    rdfs:comment 'Identifier of the maintenance crew or team responsible for executing the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:responsibleCrewName rdf:type rdf:Property ;
    rdfs:label 'Responsible Crew Name' ;
    rdfs:comment 'Name of the maintenance crew or team assigned to perform the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCenterId rdf:type rdf:Property ;
    rdfs:label 'Work Center Id' ;
    rdfs:comment 'Identifier of the work center or maintenance facility where the scheduled maintenance will be performed.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkCenter .

ind:workCenterName rdf:type rdf:Property ;
    rdfs:label 'Work Center Name' ;
    rdfs:comment 'Name of the work center or maintenance facility assigned to the schedule.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannerGroup rdf:type rdf:Property ;
    rdfs:label 'Planner Group' ;
    rdfs:comment 'Organizational group responsible for planning and scheduling the maintenance activities.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentNumber rdf:type rdf:Property ;
    rdfs:label 'Equipment Number' ;
    rdfs:comment 'Technical equipment number or tag identifier for the asset in the maintenance management system.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Date' ;
    rdfs:comment 'The next calculated date when the maintenance activity is due to be performed.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Last Completed Date' ;
    rdfs:comment 'Date when the maintenance activity was last successfully completed.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cycleStartDate rdf:type rdf:Property ;
    rdfs:label 'Cycle Start Date' ;
    rdfs:comment 'Date marking the beginning of the current maintenance cycle for recurring schedules.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:schedulingIndicator rdf:type rdf:Property ;
    rdfs:label 'Scheduling Indicator' ;
    rdfs:comment 'Indicator specifying the method used to determine when maintenance is scheduled (time-based, performance-based, condition-based, or calendar-based).' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'Number of days in advance that the work order should be created before the scheduled maintenance date.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:toleranceBeforeDays rdf:type rdf:Property ;
    rdfs:label 'Tolerance Before Days' ;
    rdfs:comment 'Number of days before the scheduled date that the maintenance can be performed early without affecting the schedule.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:toleranceAfterDays rdf:type rdf:Property ;
    rdfs:label 'Tolerance After Days' ;
    rdfs:comment 'Number of days after the scheduled date that the maintenance can be performed late without being considered overdue.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shutdownRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Shutdown Required Flag' ;
    rdfs:comment 'Indicates whether the asset must be taken out of service or shut down to perform the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyCriticalFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Critical Flag' ;
    rdfs:comment 'Indicates whether the maintenance schedule is related to safety-critical components or systems.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Required Flag' ;
    rdfs:comment 'Indicates whether the maintenance is mandated by regulatory requirements or compliance standards.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference' ;
    rdfs:comment 'Citation or reference to the specific regulation, standard, or compliance requirement mandating the maintenance.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Warranty Related Flag' ;
    rdfs:comment 'Indicates whether the maintenance schedule is required to maintain warranty coverage for the asset.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partsRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Parts Required Flag' ;
    rdfs:comment 'Indicates whether replacement parts or materials are required for the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialToolsRequired rdf:type rdf:Property ;
    rdfs:label 'Special Tools Required' ;
    rdfs:comment 'Description of any specialized tools, equipment, or machinery required to perform the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:motPlanId rdf:type rdf:Property ;
    rdfs:label 'Mot Plan Id' ;
    rdfs:comment 'Reference identifier to the approved Maintenance of Traffic plan for the scheduled maintenance activity.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:notificationLeadDays rdf:type rdf:Property ;
    rdfs:label 'Notification Lead Days' ;
    rdfs:comment 'Number of days in advance that stakeholders should be notified before the scheduled maintenance occurs.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectionIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Inspection Interval Months' ;
    rdfs:comment 'Required interval in months between inspections for compliance with inspection standards.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usageThreshold rdf:type rdf:Property ;
    rdfs:label 'Usage Threshold' ;
    rdfs:comment 'Usage metric threshold (e.g., miles, hours, cycles) that triggers the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageUnit rdf:type rdf:Property ;
    rdfs:label 'Usage Unit' ;
    rdfs:comment 'Unit of measurement for the usage threshold (miles, kilometers, hours, cycles, gallons, or events).' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaResponseHours rdf:type rdf:Property ;
    rdfs:label 'Sla Response Hours' ;
    rdfs:comment 'Maximum number of hours allowed for response to the scheduled maintenance under service level agreements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaCompletionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Completion Hours' ;
    rdfs:comment 'Maximum number of hours allowed for completion of the scheduled maintenance under service level agreements.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityAssuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Required Flag' ;
    rdfs:comment 'Indicates whether quality assurance inspection or verification is required after maintenance completion.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qaChecklistId rdf:type rdf:Property ;
    rdfs:label 'Qa Checklist Id' ;
    rdfs:comment 'Reference identifier to the quality assurance checklist or inspection form to be used.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QaChecklist .

ind:documentationRequired rdf:type rdf:Property ;
    rdfs:label 'Documentation Required' ;
    rdfs:comment 'Description of documentation, records, or reports that must be completed as part of the scheduled maintenance.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'User identifier or name of the person who last modified the maintenance schedule record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderId rdf:type rdf:Property ;
    rdfs:label 'Work Order Id' ;
    rdfs:comment 'Unique identifier for the maintenance work order. Primary key for the work order record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:orderNumber rdf:type rdf:Property ;
    rdfs:label 'Order Number' ;
    rdfs:comment 'Human-readable work order number used for tracking and reference in SAP PM and field operations.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Classification of the work order based on the nature of maintenance activity (preventive, corrective, emergency, routine maintenance, winter weather operations, vegetation management, pavement preservation, bridge maintenance, MOT activities, or inspection).' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'Category of transportation infrastructure asset or equipment being maintained.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceUnit rdf:type rdf:Property ;
    rdfs:label 'Maintenance Unit' ;
    rdfs:comment 'Specific maintenance unit or crew identifier responsible for executing the work order.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:problemDescription rdf:type rdf:Property ;
    rdfs:label 'Problem Description' ;
    rdfs:comment 'Description of the problem, defect, or condition that triggered the maintenance work order.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCategory rdf:type rdf:Property ;
    rdfs:label 'Work Category' ;
    rdfs:comment 'Specific category of maintenance activity being performed.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'Date when the maintenance need was first reported or identified.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requiredCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Required Completion Date' ;
    rdfs:comment 'Mandatory completion date for the work order, often driven by safety, regulatory, or operational requirements.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualDurationHours rdf:type rdf:Property ;
    rdfs:label 'Actual Duration Hours' ;
    rdfs:comment 'Actual number of labor hours spent completing the maintenance work.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laborCost rdf:type rdf:Property ;
    rdfs:label 'Labor Cost' ;
    rdfs:comment 'Total labor cost for the work order, including wages and benefits for maintenance personnel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:materialCost rdf:type rdf:Property ;
    rdfs:label 'Material Cost' ;
    rdfs:comment 'Total cost of materials consumed in completing the work order.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equipmentCost rdf:type rdf:Property ;
    rdfs:label 'Equipment Cost' ;
    rdfs:comment 'Total cost of equipment usage for the work order, including rental, fuel, and operating costs.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractorCost rdf:type rdf:Property ;
    rdfs:label 'Contractor Cost' ;
    rdfs:comment 'Total cost paid to external contractors for work performed under this work order.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supervisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Employee Id' ;
    rdfs:comment 'Employee identifier for the maintenance supervisor assigned to the work order.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:systemCondition rdf:type rdf:Property ;
    rdfs:label 'System Condition' ;
    rdfs:comment 'SAP PM system condition code indicating the technical status or processing state of the work order.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userStatus rdf:type rdf:Property ;
    rdfs:label 'User Status' ;
    rdfs:comment 'User-defined status providing additional business context for the work order state.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Completion Confirmation Number' ;
    rdfs:comment 'SAP PM confirmation number documenting the completion of work order activities.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionNotes rdf:type rdf:Property ;
    rdfs:label 'Completion Notes' ;
    rdfs:comment 'Detailed notes documenting work performed, findings, and any follow-up actions required upon completion.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficControlPlanNumber rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Plan Number' ;
    rdfs:comment 'Identifier for the approved Traffic Control Plan (TCP) or Transportation Management Plan (TMP) governing MOT activities.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laneClosureType rdf:type rdf:Property ;
    rdfs:label 'Lane Closure Type' ;
    rdfs:comment 'Type of lane closure required for maintenance work execution.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitRequired rdf:type rdf:Property ;
    rdfs:label 'Permit Required' ;
    rdfs:comment 'Indicates whether environmental, regulatory, or operational permits are required for the work.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Flag' ;
    rdfs:comment 'Indicates whether a safety incident occurred during work order execution.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentReportNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Report Number' ;
    rdfs:comment 'Identifier for safety incident report if an incident occurred during work execution.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyWorkFlag rdf:type rdf:Property ;
    rdfs:label 'Warranty Work Flag' ;
    rdfs:comment 'Indicates whether the work order is performed under warranty from a previous construction or maintenance contract.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyContractNumber rdf:type rdf:Property ;
    rdfs:label 'Warranty Contract Number' ;
    rdfs:comment 'Contract number for warranty work if applicable.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:femaEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Fema Eligible Flag' ;
    rdfs:comment 'Indicates whether the work order costs are eligible for Federal Emergency Management Agency (FEMA) reimbursement.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Internal Order Number' ;
    rdfs:comment 'SAP CO internal order number for cost collection and budget tracking.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetYear rdf:type rdf:Property ;
    rdfs:label 'Budget Year' ;
    rdfs:comment 'Federal Fiscal Year (FFY) or State Fiscal Year (SFY) for which the work order is budgeted.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetConditionBefore rdf:type rdf:Property ;
    rdfs:label 'Asset Condition Before' ;
    rdfs:comment 'Condition rating of the asset before maintenance work was performed.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetConditionAfter rdf:type rdf:Property ;
    rdfs:label 'Asset Condition After' ;
    rdfs:comment 'Condition rating of the asset after maintenance work was completed.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementConditionIndexBefore rdf:type rdf:Property ;
    rdfs:label 'Pavement Condition Index Before' ;
    rdfs:comment 'Pavement Condition Index score before maintenance work, ranging from 0 (failed) to 100 (excellent).' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pavementConditionIndexAfter rdf:type rdf:Property ;
    rdfs:label 'Pavement Condition Index After' ;
    rdfs:comment 'Pavement Condition Index score after maintenance work, ranging from 0 (failed) to 100 (excellent).' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionResult rdf:type rdf:Property ;
    rdfs:label 'Inspection Result' ;
    rdfs:comment 'Result of post-completion quality assurance inspection.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyIdentifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Deficiency Identified Flag' ;
    rdfs:comment 'Indicates whether deficiencies or additional work needs were identified during or after work completion.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpWorkOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Follow Up Work Order Number' ;
    rdfs:comment 'Work order number for follow-up or corrective work if deficiencies were identified.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialQuantity rdf:type rdf:Property ;
    rdfs:label 'Material Quantity' ;
    rdfs:comment 'Total quantity of primary material used in the work order (e.g., tons of asphalt, cubic yards of concrete, gallons of herbicide).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:materialUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Material Unit Of Measure' ;
    rdfs:comment 'Unit of measure for material quantity (ton, cubic yard, gallon, linear foot, square foot, each, pound, bag).' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentHours rdf:type rdf:Property ;
    rdfs:label 'Equipment Hours' ;
    rdfs:comment 'Total equipment operating hours logged for the work order.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleMiles rdf:type rdf:Property ;
    rdfs:label 'Vehicle Miles' ;
    rdfs:comment 'Total vehicle miles traveled during work order execution, relevant for mobile maintenance operations.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpsLatitude rdf:type rdf:Property ;
    rdfs:label 'Gps Latitude' ;
    rdfs:comment 'GPS latitude coordinate of the primary work location in decimal degrees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpsLongitude rdf:type rdf:Property ;
    rdfs:label 'Gps Longitude' ;
    rdfs:comment 'GPS longitude coordinate of the primary work location in decimal degrees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activityCode rdf:type rdf:Property ;
    rdfs:label 'Activity Code' ;
    rdfs:comment 'Standardized code representing the type of maintenance activity (e.g., pavement patching, vegetation control, winter operations).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledEndDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Date' ;
    rdfs:comment 'Planned date when the maintenance activity is scheduled to be completed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:materialRequired rdf:type rdf:Property ;
    rdfs:label 'Material Required' ;
    rdfs:comment 'Description of materials required for the scheduled maintenance activity (e.g., asphalt, aggregate, herbicide).' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedMaterialQuantity rdf:type rdf:Property ;
    rdfs:label 'Estimated Material Quantity' ;
    rdfs:comment 'Estimated quantity of materials required for the maintenance activity.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalRestrictions rdf:type rdf:Property ;
    rdfs:label 'Environmental Restrictions' ;
    rdfs:comment 'Description of any environmental restrictions or considerations for the scheduled maintenance activity (e.g., protected species, wetlands, water quality).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurringFlag rdf:type rdf:Property ;
    rdfs:label 'Recurring Flag' ;
    rdfs:comment 'Indicates whether this is a recurring maintenance schedule that repeats on a regular basis.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrencePattern rdf:type rdf:Property ;
    rdfs:label 'Recurrence Pattern' ;
    rdfs:comment 'Pattern of recurrence for recurring maintenance schedules (e.g., weekly, monthly, annually).' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentScheduleId rdf:type rdf:Property ;
    rdfs:label 'Parent Schedule Id' ;
    rdfs:comment 'Reference to the parent maintenance schedule if this is an instance of a recurring schedule.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Schedule .

ind:plannerName rdf:type rdf:Property ;
    rdfs:label 'Planner Name' ;
    rdfs:comment 'Name of the maintenance planner who created or is responsible for this schedule.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficImpactLevel rdf:type rdf:Property ;
    rdfs:label 'Traffic Impact Level' ;
    rdfs:comment 'Expected level of impact on traffic flow from the scheduled maintenance activity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Notification Required Flag' ;
    rdfs:comment 'Indicates whether public notification is required for the scheduled maintenance activity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Coordination Required' ;
    rdfs:comment 'Description of coordination required with other agencies, utilities, or stakeholders for the scheduled maintenance activity.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilityCoordinationFlag rdf:type rdf:Property ;
    rdfs:label 'Utility Coordination Flag' ;
    rdfs:comment 'Indicates whether coordination with utility companies is required for the maintenance activity.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completionCriteria rdf:type rdf:Property ;
    rdfs:label 'Completion Criteria' ;
    rdfs:comment 'Criteria that must be met for the maintenance activity to be considered complete.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postponementReason rdf:type rdf:Property ;
    rdfs:label 'Postponement Reason' ;
    rdfs:comment 'Reason for postponement if the maintenance schedule was postponed.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rescheduledDate rdf:type rdf:Property ;
    rdfs:label 'Rescheduled Date' ;
    rdfs:comment 'New scheduled date if the maintenance activity was rescheduled.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nhsFlag rdf:type rdf:Property ;
    rdfs:label 'Nhs Flag' ;
    rdfs:comment 'Indicates whether the roadway segment is part of the National Highway System.' ;
    rdfs:domain ind:MaintenanceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baseZipCode rdf:type rdf:Property ;
    rdfs:label 'Base Zip Code' ;
    rdfs:comment 'ZIP code of the crew\'s base location.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Leader Employee Id' ;
    rdfs:comment 'Employee identifier for the crew leader or supervisor. May reference Beacon HR system employee ID.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:leaderName rdf:type rdf:Property ;
    rdfs:label 'Leader Name' ;
    rdfs:comment 'Full name of the crew leader or supervisor responsible for the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaderPhone rdf:type rdf:Property ;
    rdfs:label 'Leader Phone' ;
    rdfs:comment 'Primary contact phone number for the crew leader.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaderEmail rdf:type rdf:Property ;
    rdfs:label 'Leader Email' ;
    rdfs:comment 'Email address for the crew leader for work-related communication.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:size rdf:type rdf:Property ;
    rdfs:label 'Size' ;
    rdfs:comment 'Total number of personnel assigned to the crew, including the crew leader.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftPattern rdf:type rdf:Property ;
    rdfs:label 'Shift Pattern' ;
    rdfs:comment 'Standard work shift pattern for the crew (e.g., day shift, night shift, rotating, on-call for emergency response).' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftStartTime rdf:type rdf:Property ;
    rdfs:label 'Shift Start Time' ;
    rdfs:comment 'Standard start time for the crew\'s work shift in HH:MM format.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftEndTime rdf:type rdf:Property ;
    rdfs:label 'Shift End Time' ;
    rdfs:comment 'Standard end time for the crew\'s work shift in HH:MM format.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySpecialization rdf:type rdf:Property ;
    rdfs:label 'Primary Specialization' ;
    rdfs:comment 'Primary area of technical specialization or expertise for the crew (e.g., asphalt paving, bridge repair, snow removal).' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySpecialization rdf:type rdf:Property ;
    rdfs:label 'Secondary Specialization' ;
    rdfs:comment 'Secondary area of technical specialization or cross-training capability for the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdlRequired rdf:type rdf:Property ;
    rdfs:label 'Cdl Required' ;
    rdfs:comment 'Indicates whether crew members are required to hold a valid Commercial Driver License (CDL) for operating maintenance vehicles.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatCertified rdf:type rdf:Property ;
    rdfs:label 'Hazmat Certified' ;
    rdfs:comment 'Indicates whether the crew is certified to handle hazardous materials in maintenance operations.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:motCertified rdf:type rdf:Property ;
    rdfs:label 'Mot Certified' ;
    rdfs:comment 'Indicates whether the crew is certified for Maintenance of Traffic (MOT) operations and work zone traffic control.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flaggerCertified rdf:type rdf:Property ;
    rdfs:label 'Flagger Certified' ;
    rdfs:comment 'Indicates whether crew members hold valid flagger certification for traffic control in work zones.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:firstAidCertified rdf:type rdf:Property ;
    rdfs:label 'First Aid Certified' ;
    rdfs:comment 'Indicates whether crew members are certified in first aid and emergency medical response.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentOperatorCertified rdf:type rdf:Property ;
    rdfs:label 'Equipment Operator Certified' ;
    rdfs:comment 'Indicates whether crew members are certified to operate heavy maintenance equipment (e.g., graders, excavators, mowers).' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bridgeInspectionCertified rdf:type rdf:Property ;
    rdfs:label 'Bridge Inspection Certified' ;
    rdfs:comment 'Indicates whether crew members are certified for bridge inspection activities under National Bridge Inspection Standards (NBIS).' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pesticideApplicatorCertified rdf:type rdf:Property ;
    rdfs:label 'Pesticide Applicator Certified' ;
    rdfs:comment 'Indicates whether crew members hold valid pesticide applicator certification for vegetation management.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceAreaRouteNumbers rdf:type rdf:Property ;
    rdfs:label 'Service Area Route Numbers' ;
    rdfs:comment 'Comma-separated list of highway route numbers within the crew\'s assigned service area (e.g., \'US-1, NC-55, I-40\').' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaMileage rdf:type rdf:Property ;
    rdfs:label 'Service Area Mileage' ;
    rdfs:comment 'Total centerline miles of roadway within the crew\'s assigned maintenance service area.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceAreaLaneMiles rdf:type rdf:Property ;
    rdfs:label 'Service Area Lane Miles' ;
    rdfs:comment 'Total lane miles within the crew\'s assigned maintenance service area.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyResponseCapable rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Capable' ;
    rdfs:comment 'Indicates whether the crew is equipped and trained for emergency response operations (e.g., incident clearance, storm response).' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:winterOperationsCapable rdf:type rdf:Property ;
    rdfs:label 'Winter Operations Capable' ;
    rdfs:comment 'Indicates whether the crew is equipped and trained for winter weather operations (snow and ice removal).' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderSystem rdf:type rdf:Property ;
    rdfs:label 'Work Order System' ;
    rdfs:comment 'System used for work order management and assignment for this crew (e.g., SAP Plant Maintenance (PM), legacy system).' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radioCallSign rdf:type rdf:Property ;
    rdfs:label 'Radio Call Sign' ;
    rdfs:comment 'Radio call sign or identifier used for crew communication on NCDOT radio networks.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchPhone rdf:type rdf:Property ;
    rdfs:label 'Dispatch Phone' ;
    rdfs:comment 'Primary phone number for dispatching and coordinating crew assignments.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpsTrackingEnabled rdf:type rdf:Property ;
    rdfs:label 'Gps Tracking Enabled' ;
    rdfs:comment 'Indicates whether the crew\'s vehicles are equipped with GPS tracking through Automatic Vehicle Location (AVL) systems.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyRecordRating rdf:type rdf:Property ;
    rdfs:label 'Safety Record Rating' ;
    rdfs:comment 'Overall safety performance rating for the crew based on incident history and safety compliance.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSafetyTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Last Safety Training Date' ;
    rdfs:comment 'Date of the most recent safety training completed by the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextSafetyTrainingDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Safety Training Due Date' ;
    rdfs:comment 'Date when the next mandatory safety training is due for the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCertificationReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Certification Review Date' ;
    rdfs:comment 'Date of the most recent review of crew member certifications and qualifications.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Overall performance rating for the crew based on work quality, productivity, and service delivery metrics.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageResponseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Average Response Time Minutes' ;
    rdfs:comment 'Average time in minutes for the crew to respond to work order assignments or emergency calls.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workOrdersCompletedYtd rdf:type rdf:Property ;
    rdfs:label 'Work Orders Completed Ytd' ;
    rdfs:comment 'Total number of work orders completed by the crew in the current fiscal year.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeWorkOrders rdf:type rdf:Property ;
    rdfs:label 'Active Work Orders' ;
    rdfs:comment 'Current number of active work orders assigned to the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:equipmentAssignedCount rdf:type rdf:Property ;
    rdfs:label 'Equipment Assigned Count' ;
    rdfs:comment 'Total number of vehicles and equipment units assigned to the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryVehicleFleetNumber rdf:type rdf:Property ;
    rdfs:label 'Primary Vehicle Fleet Number' ;
    rdfs:comment 'Fleet number of the primary vehicle assigned to the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalHoursPerWeek rdf:type rdf:Property ;
    rdfs:label 'Operational Hours Per Week' ;
    rdfs:comment 'Standard number of operational hours per week for the crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seasonalCrew rdf:type rdf:Property ;
    rdfs:label 'Seasonal Crew' ;
    rdfs:comment 'Indicates whether the crew operates on a seasonal basis (e.g., summer paving crews, winter operations crews).' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractCrew rdf:type rdf:Property ;
    rdfs:label 'Contract Crew' ;
    rdfs:comment 'Indicates whether the crew is a contracted external crew rather than NCDOT employees.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Start Date' ;
    rdfs:comment 'Start date of the contract for contracted crew services.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract End Date' ;
    rdfs:comment 'End date of the contract for contracted crew services.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:establishedDate rdf:type rdf:Property ;
    rdfs:label 'Established Date' ;
    rdfs:comment 'Date when the crew was officially established and became operational.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'Date when the crew was deactivated or disbanded, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deactivationReason rdf:type rdf:Property ;
    rdfs:label 'Deactivation Reason' ;
    rdfs:comment 'Reason for crew deactivation (e.g., reorganization, budget cuts, end of seasonal operations).' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialId rdf:type rdf:Property ;
    rdfs:label 'Material Id' ;
    rdfs:comment 'Unique identifier for the material master record in the maintenance inventory system.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Material .

ind:longDescription rdf:type rdf:Property ;
    rdfs:label 'Long Description' ;
    rdfs:comment 'Extended description providing detailed specifications, usage instructions, or technical characteristics of the material.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:group rdf:type rdf:Property ;
    rdfs:label 'Group' ;
    rdfs:comment 'Hierarchical grouping code used for procurement and reporting purposes, aligning materials with similar characteristics or usage patterns.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Base Unit Of Measure' ;
    rdfs:comment 'The fundamental unit of measure used for inventory valuation and stock keeping, to which all alternative units are converted.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternativeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Alternative Unit Of Measure' ;
    rdfs:comment 'Secondary unit of measure that may be used for ordering or issuing the material, with conversion factor to base unit (e.g., ordering in pallets but tracking in bags).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardCost rdf:type rdf:Property ;
    rdfs:label 'Standard Cost' ;
    rdfs:comment 'The standard unit cost of the material used for budgeting, cost estimation, and variance analysis in maintenance work orders.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:movingAveragePrice rdf:type rdf:Property ;
    rdfs:label 'Moving Average Price' ;
    rdfs:comment 'The weighted average cost of the material calculated based on historical procurement transactions, used for inventory valuation.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPurchasePrice rdf:type rdf:Property ;
    rdfs:label 'Last Purchase Price' ;
    rdfs:comment 'The most recent unit price paid for procurement of this material, used for cost trending and vendor performance analysis.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceUnit rdf:type rdf:Property ;
    rdfs:label 'Price Unit' ;
    rdfs:comment 'The quantity to which the price refers (e.g., price per 1 unit, per 100 units, per 1000 units), used for materials sold in bulk.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valuationClass rdf:type rdf:Property ;
    rdfs:label 'Valuation Class' ;
    rdfs:comment 'Accounting classification code that determines the general ledger accounts to which material movements and valuations are posted.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockOnHand rdf:type rdf:Property ;
    rdfs:label 'Stock On Hand' ;
    rdfs:comment 'Current available inventory quantity of the material across all storage locations, measured in base unit of measure.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservedStock rdf:type rdf:Property ;
    rdfs:label 'Reserved Stock' ;
    rdfs:comment 'Quantity of material currently reserved for specific work orders or maintenance activities but not yet issued.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableStock rdf:type rdf:Property ;
    rdfs:label 'Available Stock' ;
    rdfs:comment 'Unreserved inventory quantity available for new work order assignments, calculated as stock on hand minus reserved stock.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumStockLevel rdf:type rdf:Property ;
    rdfs:label 'Minimum Stock Level' ;
    rdfs:comment 'The minimum inventory quantity that should be maintained to avoid stockouts and ensure continuous maintenance operations. Triggers reorder point.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumStockLevel rdf:type rdf:Property ;
    rdfs:label 'Maximum Stock Level' ;
    rdfs:comment 'The maximum inventory quantity that should be stocked to avoid excess inventory carrying costs and storage constraints.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reorderPoint rdf:type rdf:Property ;
    rdfs:label 'Reorder Point' ;
    rdfs:comment 'The inventory level at which a procurement request should be automatically triggered to replenish stock before reaching minimum level.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reorderQuantity rdf:type rdf:Property ;
    rdfs:label 'Reorder Quantity' ;
    rdfs:comment 'The standard quantity to order when replenishing inventory, calculated to optimize procurement costs and storage capacity.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyStock rdf:type rdf:Property ;
    rdfs:label 'Safety Stock' ;
    rdfs:comment 'Buffer inventory maintained to protect against demand variability and supply chain disruptions, especially critical for winter weather and emergency response materials.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shelfLifeDays rdf:type rdf:Property ;
    rdfs:label 'Shelf Life Days' ;
    rdfs:comment 'Maximum number of days the material can be stored before expiration or degradation affects its usability, critical for chemicals, sealants, and paints.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:storageBin rdf:type rdf:Property ;
    rdfs:label 'Storage Bin' ;
    rdfs:comment 'Specific bin, rack, or location identifier within the storage facility for precise material placement and retrieval.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageCondition rdf:type rdf:Property ;
    rdfs:label 'Storage Condition' ;
    rdfs:comment 'Required environmental conditions for safe and effective storage of the material (e.g., climate-controlled for certain chemicals, outdoor covered for aggregates).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardousMaterialIndicator rdf:type rdf:Property ;
    rdfs:label 'Hazardous Material Indicator' ;
    rdfs:comment 'Flag indicating whether the material is classified as hazardous and requires special handling, storage, and disposal procedures per OSHA and EPA regulations.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazardClass rdf:type rdf:Property ;
    rdfs:label 'Hazard Class' ;
    rdfs:comment 'DOT hazard classification code for hazardous materials (e.g., Class 3 Flammable Liquids, Class 8 Corrosives), used for transportation and storage compliance.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unNumber rdf:type rdf:Property ;
    rdfs:label 'Un Number' ;
    rdfs:comment 'Four-digit UN identification number for hazardous materials used in international and domestic transportation (e.g., UN1203 for gasoline).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:msdsAvailable rdf:type rdf:Property ;
    rdfs:label 'Msds Available' ;
    rdfs:comment 'Indicator of whether a Material Safety Data Sheet (now Safety Data Sheet - SDS) is on file and accessible for this material, required for hazardous substances.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:msdsDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Msds Document Number' ;
    rdfs:comment 'Reference number or document identifier for the MSDS/SDS document stored in the document management system.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerPartNumber rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Part Number' ;
    rdfs:comment 'The manufacturer\'s unique part number or model number for the material, used for precise identification and cross-referencing.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorPartNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Part Number' ;
    rdfs:comment 'The vendor\'s catalog or part number for the material, used in purchase orders and receiving documentation.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procurementType rdf:type rdf:Property ;
    rdfs:label 'Procurement Type' ;
    rdfs:comment 'Indicates how the material is typically procured: externally from vendors, internally produced, or both methods available.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchasingGroup rdf:type rdf:Property ;
    rdfs:label 'Purchasing Group' ;
    rdfs:comment 'Code identifying the procurement team or buyer responsible for purchasing this material category.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specificationNumber rdf:type rdf:Property ;
    rdfs:label 'Specification Number' ;
    rdfs:comment 'NCDOT or AASHTO specification number defining the technical requirements, quality standards, and testing procedures for the material.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specificationDescription rdf:type rdf:Property ;
    rdfs:label 'Specification Description' ;
    rdfs:comment 'Brief description of the specification requirements or quality standards that the material must meet.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityInspectionRequired rdf:type rdf:Property ;
    rdfs:label 'Quality Inspection Required' ;
    rdfs:comment 'Flag indicating whether incoming material receipts require quality inspection and approval before being available for use in maintenance operations.' ;
    rdfs:domain ind:Maintenance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serializedMaterial rdf:type rdf:Property ;
    rdfs:label 'Serialized Material' ;
    rdfs:comment 'Indicates whether individual units of this material are tracked by unique serial numbers for warranty, maintenance history, or asset management purposes.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:batchManaged rdf:type rdf:Property ;
    rdfs:label 'Batch Managed' ;
    rdfs:comment 'Indicates whether the material is managed in batches or lots for traceability, quality control, and expiration tracking (critical for chemicals, asphalt mixes, and time-sensitive materials).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:abcIndicator rdf:type rdf:Property ;
    rdfs:label 'Abc Indicator' ;
    rdfs:comment 'ABC analysis classification based on consumption value and criticality: A (high value/critical), B (moderate), C (low value/routine), X (no movement). Used for inventory optimization.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:xyzIndicator rdf:type rdf:Property ;
    rdfs:label 'Xyz Indicator' ;
    rdfs:comment 'XYZ analysis classification based on consumption variability: X (constant demand), Y (variable demand), Z (sporadic demand). Used for forecasting and safety stock planning.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalMaterial rdf:type rdf:Property ;
    rdfs:label 'Seasonal Material' ;
    rdfs:comment 'Flag indicating whether the material has seasonal demand patterns (e.g., salt and brine for winter weather operations, asphalt for summer paving season).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalMaterial rdf:type rdf:Property ;
    rdfs:label 'Critical Material' ;
    rdfs:comment 'Flag indicating whether the material is critical for emergency response, safety operations, or high-priority maintenance activities requiring guaranteed availability.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentallySensitive rdf:type rdf:Property ;
    rdfs:label 'Environmentally Sensitive' ;
    rdfs:comment 'Indicates whether the material requires special environmental handling, disposal, or reporting per EPA and NCDEQ regulations (e.g., herbicides, petroleum products).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recyclableMaterial rdf:type rdf:Property ;
    rdfs:label 'Recyclable Material' ;
    rdfs:comment 'Flag indicating whether the material or its packaging can be recycled, supporting NCDOT environmental stewardship and sustainability goals.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weightPerUnit rdf:type rdf:Property ;
    rdfs:label 'Weight Per Unit' ;
    rdfs:comment 'Weight of one base unit of the material, used for transportation planning, load calculations, and freight cost estimation.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightUnit rdf:type rdf:Property ;
    rdfs:label 'Weight Unit' ;
    rdfs:comment 'Unit of measure for the weight per unit value (e.g., LB for pounds, TON for tons).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumePerUnit rdf:type rdf:Property ;
    rdfs:label 'Volume Per Unit' ;
    rdfs:comment 'Volume occupied by one base unit of the material, used for storage space planning and transportation capacity calculations.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeUnit rdf:type rdf:Property ;
    rdfs:label 'Volume Unit' ;
    rdfs:comment 'Unit of measure for the volume per unit value (e.g., GAL for gallons, CU_YD for cubic yards).' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discontinuationDate rdf:type rdf:Property ;
    rdfs:label 'Discontinuation Date' ;
    rdfs:comment 'Date when the material was or will be discontinued and no longer available for new work orders, though existing stock may still be used.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:replacementMaterialNumber rdf:type rdf:Property ;
    rdfs:label 'Replacement Material Number' ;
    rdfs:comment 'Material number of the replacement or successor material to be used when this material is discontinued or obsolete.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plantCode rdf:type rdf:Property ;
    rdfs:label 'Plant Code' ;
    rdfs:comment 'SAP plant code representing the organizational unit (e.g., division, district, or facility) responsible for managing this material.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastGoodsReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Last Goods Receipt Date' ;
    rdfs:comment 'Date of the most recent goods receipt transaction for this material, indicating when inventory was last replenished.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastGoodsIssueDate rdf:type rdf:Property ;
    rdfs:label 'Last Goods Issue Date' ;
    rdfs:comment 'Date of the most recent goods issue transaction for this material, indicating when it was last used in maintenance operations.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annualConsumptionQuantity rdf:type rdf:Property ;
    rdfs:label 'Annual Consumption Quantity' ;
    rdfs:comment 'Total quantity of the material consumed in the previous 12 months, used for demand forecasting and inventory optimization.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageMonthlyConsumption rdf:type rdf:Property ;
    rdfs:label 'Average Monthly Consumption' ;
    rdfs:comment 'Average quantity of the material consumed per month based on historical usage patterns, used for reorder point calculations.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxClassification rdf:type rdf:Property ;
    rdfs:label 'Tax Classification' ;
    rdfs:comment 'Tax category code determining applicable sales tax, use tax, or exemptions for the material procurement.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityCode rdf:type rdf:Property ;
    rdfs:label 'Commodity Code' ;
    rdfs:comment 'Standard commodity classification code (e.g., UNSPSC, NIGP) used for procurement reporting, spend analysis, and vendor categorization.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalSupplyClass rdf:type rdf:Property ;
    rdfs:label 'Federal Supply Class' ;
    rdfs:comment 'Four-digit Federal Supply Classification code used for materials procured with federal funding or through federal supply schedules.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbeEligible rdf:type rdf:Property ;
    rdfs:label 'Dbe Eligible' ;
    rdfs:comment 'Indicates whether this material can be sourced from DBE-certified vendors to meet federal DBE participation requirements on federally funded projects.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hubEligible rdf:type rdf:Property ;
    rdfs:label 'Hub Eligible' ;
    rdfs:comment 'Indicates whether this material can be sourced from HUB-certified vendors to meet North Carolina HUB participation goals.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buyAmericaCompliant rdf:type rdf:Property ;
    rdfs:label 'Buy America Compliant' ;
    rdfs:comment 'Indicates whether the material meets Buy America requirements for domestic content on federally funded transportation projects.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:countryOfOrigin rdf:type rdf:Property ;
    rdfs:label 'Country Of Origin' ;
    rdfs:comment 'Three-letter ISO country code indicating where the material is manufactured or produced, relevant for Buy America compliance and trade regulations.' ;
    rdfs:domain ind:Material ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentTypeId rdf:type rdf:Property ;
    rdfs:label 'Incident Type Id' ;
    rdfs:comment 'Unique identifier for the incident type record. Primary key for the incident type reference table.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IncidentType .

ind:requiresImapResponse rdf:type rdf:Property ;
    rdfs:label 'Requires Imap Response' ;
    rdfs:comment 'Indicates whether this incident type typically requires IMAP (Incident Management Assistance Patrol) response. True if IMAP dispatch is standard protocol.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresLawEnforcement rdf:type rdf:Property ;
    rdfs:label 'Requires Law Enforcement' ;
    rdfs:comment 'Indicates whether this incident type typically requires law enforcement response (e.g., State Highway Patrol).' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresFireRescue rdf:type rdf:Property ;
    rdfs:label 'Requires Fire Rescue' ;
    rdfs:comment 'Indicates whether this incident type typically requires fire and rescue services response.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresEms rdf:type rdf:Property ;
    rdfs:label 'Requires Ems' ;
    rdfs:comment 'Indicates whether this incident type typically requires Emergency Medical Services (EMS) response.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresHazmatTeam rdf:type rdf:Property ;
    rdfs:label 'Requires Hazmat Team' ;
    rdfs:comment 'Indicates whether this incident type typically requires hazardous materials (HAZMAT) team response.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresMaintenanceCrew rdf:type rdf:Property ;
    rdfs:label 'Requires Maintenance Crew' ;
    rdfs:comment 'Indicates whether this incident type typically requires NCDOT maintenance crew response (e.g., for debris removal, road repairs).' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresTowService rdf:type rdf:Property ;
    rdfs:label 'Requires Tow Service' ;
    rdfs:comment 'Indicates whether this incident type typically requires tow service for vehicle removal.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:typicalLaneClosureCount rdf:type rdf:Property ;
    rdfs:label 'Typical Lane Closure Count' ;
    rdfs:comment 'Typical number of lanes closed or affected by this incident type. Used for traffic impact estimation.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Typical Duration Minutes' ;
    rdfs:comment 'Average or typical duration in minutes for incidents of this type, from detection to clearance. Used for traffic management planning.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresDmsNotification rdf:type rdf:Property ;
    rdfs:label 'Requires Dms Notification' ;
    rdfs:comment 'Indicates whether this incident type typically requires notification via DMS (Dynamic Message Sign) to alert motorists.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresMediaNotification rdf:type rdf:Property ;
    rdfs:label 'Requires Media Notification' ;
    rdfs:comment 'Indicates whether this incident type typically requires notification to media outlets for public awareness.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requires511Update rdf:type rdf:Property ;
    rdfs:label 'Requires 511 Update' ;
    rdfs:comment 'Indicates whether this incident type requires update to the 511 traveler information system.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresCctvMonitoring rdf:type rdf:Property ;
    rdfs:label 'Requires Cctv Monitoring' ;
    rdfs:comment 'Indicates whether this incident type typically requires active CCTV (Closed-Circuit Television) monitoring by TMC (Traffic Management Center) operators.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:motRequired rdf:type rdf:Property ;
    rdfs:label 'Mot Required' ;
    rdfs:comment 'Indicates whether this incident type typically requires formal MOT (Maintenance of Traffic) setup per MUTCD (Manual on Uniform Traffic Control Devices) standards.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tcpRequired rdf:type rdf:Property ;
    rdfs:label 'Tcp Required' ;
    rdfs:comment 'Indicates whether this incident type typically requires a formal TCP (Traffic Control Plan).' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportableToFhwa rdf:type rdf:Property ;
    rdfs:label 'Reportable To Fhwa' ;
    rdfs:comment 'Indicates whether incidents of this type must be reported to FHWA (Federal Highway Administration) for federal tracking and compliance.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportableToNhtsa rdf:type rdf:Property ;
    rdfs:label 'Reportable To Nhtsa' ;
    rdfs:comment 'Indicates whether incidents of this type must be reported to NHTSA (National Highway Traffic Safety Administration) for safety tracking.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affectsAadt rdf:type rdf:Property ;
    rdfs:label 'Affects Aadt' ;
    rdfs:comment 'Indicates whether this incident type significantly affects AADT (Annual Average Daily Traffic) measurements and should be factored into traffic volume analysis.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affectsVmt rdf:type rdf:Property ;
    rdfs:label 'Affects Vmt' ;
    rdfs:comment 'Indicates whether this incident type significantly affects VMT (Vehicle Miles Traveled) calculations and should be considered in mobility metrics.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affectsLos rdf:type rdf:Property ;
    rdfs:label 'Affects Los' ;
    rdfs:comment 'Indicates whether this incident type significantly degrades LOS (Level of Service) and should be tracked for performance monitoring.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hsipEligible rdf:type rdf:Property ;
    rdfs:label 'Hsip Eligible' ;
    rdfs:comment 'Indicates whether incidents of this type may qualify for HSIP (Highway Safety Improvement Program) funding for countermeasures.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:abbreviation rdf:type rdf:Property ;
    rdfs:label 'Abbreviation' ;
    rdfs:comment 'Short abbreviation for the incident type used in constrained display spaces and reports.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Parent Category Code' ;
    rdfs:comment 'Code of the parent category if this incident type is part of a hierarchical classification structure. Null for top-level categories.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isWeatherRelated rdf:type rdf:Property ;
    rdfs:label 'Is Weather Related' ;
    rdfs:comment 'Indicates whether this incident type is weather-related (e.g., ice, snow, flooding, fog). Used for weather impact analysis.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isConstructionRelated rdf:type rdf:Property ;
    rdfs:label 'Is Construction Related' ;
    rdfs:comment 'Indicates whether this incident type is related to construction or work zone activities.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSpecialEvent rdf:type rdf:Property ;
    rdfs:label 'Is Special Event' ;
    rdfs:comment 'Indicates whether this incident type is related to planned special events (e.g., parades, sporting events, festivals) requiring traffic management.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresInvestigation rdf:type rdf:Property ;
    rdfs:label 'Requires Investigation' ;
    rdfs:comment 'Indicates whether incidents of this type typically require formal investigation (e.g., crash reconstruction, safety analysis).' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicNotificationMessageTemplate rdf:type rdf:Property ;
    rdfs:label 'Public Notification Message Template' ;
    rdfs:comment 'Standard message template used for public notifications (DMS, 511, social media) for this incident type. May include placeholders for location and time.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDelayFactor rdf:type rdf:Property ;
    rdfs:label 'Estimated Delay Factor' ;
    rdfs:comment 'Multiplier factor used to estimate traffic delay caused by this incident type. Applied to baseline travel time calculations.' ;
    rdfs:domain ind:IncidentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tollRateId rdf:type rdf:Property ;
    rdfs:label 'Toll Rate Id' ;
    rdfs:comment 'Unique identifier for the toll rate record. Primary key for the toll rate reference table.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TollRate .

ind:rateCode rdf:type rdf:Property ;
    rdfs:label 'Rate Code' ;
    rdfs:comment 'Unique business code identifying the toll rate configuration. Used for operational reference and reporting.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateName rdf:type rdf:Property ;
    rdfs:label 'Rate Name' ;
    rdfs:comment 'Descriptive name for the toll rate configuration (e.g., \'Peak Hour Class 2 Rate\', \'Weekend Discount Rate\').' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateDescription rdf:type rdf:Property ;
    rdfs:label 'Rate Description' ;
    rdfs:comment 'Detailed description of the toll rate including applicability conditions, special provisions, and business rules.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleClassCode rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class Code' ;
    rdfs:comment 'Code representing the vehicle classification (e.g., Class 1 for 2-axle vehicles, Class 2 for 3-axle vehicles) per FHWA vehicle classification standards.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleClassDescription rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class Description' ;
    rdfs:comment 'Detailed description of the vehicle class (e.g., \'Passenger Cars\', \'Two-Axle Six-Tire Single Unit Trucks\', \'Multi-Trailer Trucks\').' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateAmount rdf:type rdf:Property ;
    rdfs:label 'Rate Amount' ;
    rdfs:comment 'The toll charge amount in US dollars for this rate configuration.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateType rdf:type rdf:Property ;
    rdfs:label 'Rate Type' ;
    rdfs:comment 'Classification of the toll rate based on pricing strategy (base rate, time-of-day pricing, dynamic pricing, etc.).' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeOfDayPeriod rdf:type rdf:Property ;
    rdfs:label 'Time Of Day Period' ;
    rdfs:comment 'Time period classification for time-of-day pricing (e.g., AM peak, PM peak, off-peak).' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startTime rdf:type rdf:Property ;
    rdfs:label 'Start Time' ;
    rdfs:comment 'Start time of day when this toll rate becomes effective (HH:MM:SS format, 24-hour clock).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endTime rdf:type rdf:Property ;
    rdfs:label 'End Time' ;
    rdfs:comment 'End time of day when this toll rate expires (HH:MM:SS format, 24-hour clock).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dayOfWeek rdf:type rdf:Property ;
    rdfs:label 'Day Of Week' ;
    rdfs:comment 'Day(s) of the week when this toll rate is applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transponderType rdf:type rdf:Property ;
    rdfs:label 'Transponder Type' ;
    rdfs:comment 'Type of electronic toll collection transponder for which this rate applies (e.g., NC Quick Pass, E-ZPass).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountType rdf:type rdf:Property ;
    rdfs:label 'Discount Type' ;
    rdfs:comment 'Type of discount program associated with this toll rate (e.g., frequent user, senior citizen, military, carpool/HOV).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumRateAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Rate Amount' ;
    rdfs:comment 'Minimum toll charge amount that can be applied, regardless of discounts or dynamic pricing adjustments.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumRateAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Rate Amount' ;
    rdfs:comment 'Maximum toll charge amount that can be applied, used as a cap for dynamic pricing scenarios.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dynamicPricingEnabled rdf:type rdf:Property ;
    rdfs:label 'Dynamic Pricing Enabled' ;
    rdfs:comment 'Indicates whether this rate is subject to dynamic pricing adjustments based on traffic conditions or demand.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:congestionThresholdLos rdf:type rdf:Property ;
    rdfs:label 'Congestion Threshold Los' ;
    rdfs:comment 'Level of Service (LOS) threshold that triggers dynamic pricing adjustments. LOS ranges from A (free flow) to F (forced flow).' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holidayScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Holiday Schedule Code' ;
    rdfs:comment 'Code referencing the holiday schedule that determines when special holiday rates apply.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialEventCode rdf:type rdf:Property ;
    rdfs:label 'Special Event Code' ;
    rdfs:comment 'Code identifying special events (e.g., major sporting events, festivals) that trigger special toll rates.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateScheduleVersion rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Version' ;
    rdfs:comment 'Version number of the toll rate schedule to track rate changes over time.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalResolutionNumber rdf:type rdf:Property ;
    rdfs:label 'Approval Resolution Number' ;
    rdfs:comment 'Official resolution or ordinance number documenting the approval of this toll rate.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Public Notice Date' ;
    rdfs:comment 'Date when public notice of this toll rate change was published, as required by state regulations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountCode rdf:type rdf:Property ;
    rdfs:label 'Account Code' ;
    rdfs:comment 'General ledger account code for revenue recognition from this toll rate.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Rate Calculation Method' ;
    rdfs:comment 'Method used to calculate the toll charge (e.g., flat rate per passage, distance-based, zone-based, time-of-day based, dynamic algorithm).' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceMiles rdf:type rdf:Property ;
    rdfs:label 'Distance Miles' ;
    rdfs:comment 'Length of the toll segment in miles for distance-based toll calculations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratePerMile rdf:type rdf:Property ;
    rdfs:label 'Rate Per Mile' ;
    rdfs:comment 'Toll charge per mile for distance-based toll calculations.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Code identifying the toll zone for zone-based toll calculations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryPointCode rdf:type rdf:Property ;
    rdfs:label 'Entry Point Code' ;
    rdfs:comment 'Code identifying the entry point on the toll facility for distance-based or zone-based tolling.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exitPointCode rdf:type rdf:Property ;
    rdfs:label 'Exit Point Code' ;
    rdfs:comment 'Code identifying the exit point on the toll facility for distance-based or zone-based tolling.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interoperabilityAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Interoperability Agency Code' ;
    rdfs:comment 'Code identifying partner toll agencies for interoperable toll collection (e.g., E-ZPass network members).' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reciprocityAgreementCode rdf:type rdf:Property ;
    rdfs:label 'Reciprocity Agreement Code' ;
    rdfs:comment 'Code referencing reciprocity agreements with other toll agencies for rate harmonization.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Violation Penalty Amount' ;
    rdfs:comment 'Additional penalty amount charged for toll violations (e.g., unpaid tolls, invalid transponder) associated with this rate.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administrativeFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Administrative Fee Amount' ;
    rdfs:comment 'Administrative processing fee charged for certain payment methods or violation processing.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether this toll rate is exempt from state or local taxes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalSurchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Environmental Surcharge Amount' ;
    rdfs:comment 'Additional environmental surcharge amount included in the toll rate to fund environmental mitigation programs.' ;
    rdfs:domain ind:TollRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tollTransactionId rdf:type rdf:Property ;
    rdfs:label 'Toll Transaction Id' ;
    rdfs:comment 'Unique identifier for each toll transaction record. Primary key for the toll transaction entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TollTransaction .

ind:transactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transaction Timestamp' ;
    rdfs:comment 'Precise date and time when the toll transaction was recorded at the collection point.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vehicleIdentifier rdf:type rdf:Property ;
    rdfs:label 'Vehicle Identifier' ;
    rdfs:comment 'Unique identifier for the vehicle that passed through the toll point. May be license plate, transponder ID, or other vehicle identification method.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensePlateState rdf:type rdf:Property ;
    rdfs:label 'License Plate State' ;
    rdfs:comment 'State or jurisdiction that issued the vehicle license plate.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transponderEquipmentId rdf:type rdf:Property ;
    rdfs:label 'Transponder Equipment Id' ;
    rdfs:comment 'Electronic toll collection transponder identifier (e.g., NC Quick Pass, E-ZPass) used for automated toll payment.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Equipment .

ind:transponderAgency rdf:type rdf:Property ;
    rdfs:label 'Transponder Agency' ;
    rdfs:comment 'Agency or toll authority that issued the electronic toll collection transponder.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tollPlazaName rdf:type rdf:Property ;
    rdfs:label 'Toll Plaza Name' ;
    rdfs:comment 'Business name or location description of the toll plaza.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tollLaneId rdf:type rdf:Property ;
    rdfs:label 'Toll Lane Id' ;
    rdfs:comment 'Specific lane identifier within the toll plaza where the vehicle passed through.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Lane .

ind:laneType rdf:type rdf:Property ;
    rdfs:label 'Lane Type' ;
    rdfs:comment 'Type of toll collection lane (electronic, manual, mixed mode, express, or high-occupancy vehicle).' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleWeight rdf:type rdf:Property ;
    rdfs:label 'Vehicle Weight' ;
    rdfs:comment 'Gross vehicle weight in pounds captured by weigh-in-motion sensors, if available.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tollAmount rdf:type rdf:Property ;
    rdfs:label 'Toll Amount' ;
    rdfs:comment 'Base toll amount charged for the transaction before any adjustments, discounts, or fees.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Surcharge Amount' ;
    rdfs:comment 'Additional surcharge applied to the transaction (e.g., video toll surcharge, administrative fee).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Payment Timestamp' ;
    rdfs:comment 'Date and time when payment was processed or received for the toll transaction.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:accountId rdf:type rdf:Property ;
    rdfs:label 'Account Id' ;
    rdfs:comment 'Customer toll account identifier linked to the transaction for prepaid or postpaid billing.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationFlag rdf:type rdf:Property ;
    rdfs:label 'Violation Flag' ;
    rdfs:comment 'Indicates whether the transaction represents a toll violation (vehicle passed without valid payment).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:violationType rdf:type rdf:Property ;
    rdfs:label 'Violation Type' ;
    rdfs:comment 'Type of toll violation if applicable (no transponder, insufficient funds, unreadable plate, etc.).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imageCapturedFlag rdf:type rdf:Property ;
    rdfs:label 'Image Captured Flag' ;
    rdfs:comment 'Indicates whether photographic evidence was captured for the transaction (typically for video tolling or violations).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frontImageUrl rdf:type rdf:Property ;
    rdfs:label 'Front Image Url' ;
    rdfs:comment 'Storage location or URL for the front vehicle image captured during the transaction.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rearImageUrl rdf:type rdf:Property ;
    rdfs:label 'Rear Image Url' ;
    rdfs:comment 'Storage location or URL for the rear vehicle image (license plate) captured during the transaction.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleSpeed rdf:type rdf:Property ;
    rdfs:label 'Vehicle Speed' ;
    rdfs:comment 'Speed of the vehicle in miles per hour when passing through the toll point.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupancyCount rdf:type rdf:Property ;
    rdfs:label 'Occupancy Count' ;
    rdfs:comment 'Number of occupants detected in the vehicle, used for High-Occupancy Vehicle (HOV) lane enforcement.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hovEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hov Eligible Flag' ;
    rdfs:comment 'Indicates whether the vehicle met High-Occupancy Vehicle requirements for reduced or waived toll.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dynamicPricingFlag rdf:type rdf:Property ;
    rdfs:label 'Dynamic Pricing Flag' ;
    rdfs:comment 'Indicates whether dynamic or congestion-based pricing was applied to this transaction.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:congestionLevel rdf:type rdf:Property ;
    rdfs:label 'Congestion Level' ;
    rdfs:comment 'Traffic congestion level at the time of transaction, used for dynamic pricing decisions.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryPlazaLocationId rdf:type rdf:Property ;
    rdfs:label 'Entry Plaza Location Id' ;
    rdfs:comment 'Toll plaza identifier where the vehicle entered the toll facility (for distance-based tolling).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:entryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Entry Timestamp' ;
    rdfs:comment 'Date and time when the vehicle entered the toll facility (for distance-based tolling).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exitPlazaLocationId rdf:type rdf:Property ;
    rdfs:label 'Exit Plaza Location Id' ;
    rdfs:comment 'Toll plaza identifier where the vehicle exited the toll facility (for distance-based tolling).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:exitTimestamp rdf:type rdf:Property ;
    rdfs:label 'Exit Timestamp' ;
    rdfs:comment 'Date and time when the vehicle exited the toll facility (for distance-based tolling).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:distanceTraveled rdf:type rdf:Property ;
    rdfs:label 'Distance Traveled' ;
    rdfs:comment 'Distance in miles traveled on the toll facility between entry and exit points.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tripDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Trip Duration Minutes' ;
    rdfs:comment 'Duration of the trip on the toll facility in minutes, calculated from entry to exit.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueCategory rdf:type rdf:Property ;
    rdfs:label 'Revenue Category' ;
    rdfs:comment 'Revenue classification category for financial reporting and analysis.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptionCode rdf:type rdf:Property ;
    rdfs:label 'Exemption Code' ;
    rdfs:comment 'Code indicating the reason for toll exemption if applicable (emergency vehicle, government vehicle, etc.).' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Exemption Flag' ;
    rdfs:comment 'Indicates whether the vehicle was exempt from toll payment.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Date by which payment is due for invoiced toll transactions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'Current status of collection efforts for unpaid toll transactions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether the toll transaction has been disputed by the customer.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Reason provided by the customer for disputing the toll transaction.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Date' ;
    rdfs:comment 'Date when the dispute was resolved or closed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundDate rdf:type rdf:Property ;
    rdfs:label 'Refund Date' ;
    rdfs:comment 'Date when the refund was processed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postedDate rdf:type rdf:Property ;
    rdfs:label 'Posted Date' ;
    rdfs:comment 'Date when the transaction was posted to the customer account or financial system.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'Date when the toll revenue was recognized in the financial system per GASB standards.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:equipmentStatus rdf:type rdf:Property ;
    rdfs:label 'Equipment Status' ;
    rdfs:comment 'Operational status of the toll collection equipment at the time of transaction.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Data Quality Flag' ;
    rdfs:comment 'Indicator of data quality for the transaction record (valid, suspect, invalid, or corrected).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctionFlag rdf:type rdf:Property ;
    rdfs:label 'Correction Flag' ;
    rdfs:comment 'Indicates whether the transaction record has been manually corrected or adjusted.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Id' ;
    rdfs:comment 'Reference to the original transaction identifier if this record is a correction or reversal.' ;
    rdfs:domain ind:TollTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TollTransaction .

ind:batchId rdf:type rdf:Property ;
    rdfs:label 'Batch Id' ;
    rdfs:comment 'Batch identifier for grouped transaction processing and reconciliation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programId rdf:type rdf:Property ;
    rdfs:label 'Program Id' ;
    rdfs:comment 'Unique identifier for the Highway Safety Improvement Program (HSIP) safety program record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Program .

ind:targetCrashReductionPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Crash Reduction Percentage' ;
    rdfs:comment 'Target percentage reduction in crashes expected from the safety program implementation.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetFatalityReduction rdf:type rdf:Property ;
    rdfs:label 'Target Fatality Reduction' ;
    rdfs:comment 'Target number of fatalities expected to be prevented through the safety program.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetSeriousInjuryReduction rdf:type rdf:Property ;
    rdfs:label 'Target Serious Injury Reduction' ;
    rdfs:comment 'Target number of serious injuries (KABCO A-level) expected to be prevented through the safety program.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetPdoCrashReduction rdf:type rdf:Property ;
    rdfs:label 'Target Pdo Crash Reduction' ;
    rdfs:comment 'Target number of property damage only crashes expected to be prevented.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceMeasure rdf:type rdf:Property ;
    rdfs:label 'Performance Measure' ;
    rdfs:comment 'Primary performance measure used to evaluate program effectiveness (e.g., crash rate reduction, fatality rate, serious injury rate).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineCrashCount rdf:type rdf:Property ;
    rdfs:label 'Baseline Crash Count' ;
    rdfs:comment 'Number of crashes recorded in the target area during the baseline period before program implementation.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baselineFatalityCount rdf:type rdf:Property ;
    rdfs:label 'Baseline Fatality Count' ;
    rdfs:comment 'Number of fatalities recorded in the target area during the baseline period.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baselineSeriousInjuryCount rdf:type rdf:Property ;
    rdfs:label 'Baseline Serious Injury Count' ;
    rdfs:comment 'Number of serious injuries recorded in the target area during the baseline period.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baselinePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Period Start Date' ;
    rdfs:comment 'Start date of the baseline period used for crash data analysis.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baselinePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Period End Date' ;
    rdfs:comment 'End date of the baseline period used for crash data analysis.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetPopulation rdf:type rdf:Property ;
    rdfs:label 'Target Population' ;
    rdfs:comment 'Specific population or user group targeted by the safety program (e.g., pedestrians, bicyclists, commercial vehicle drivers, teen drivers).' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'Geographic coverage area of the safety program (e.g., statewide, regional, specific corridor, intersection).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashTypeTargeted rdf:type rdf:Property ;
    rdfs:label 'Crash Type Targeted' ;
    rdfs:comment 'Specific crash type or pattern the program aims to address (e.g., rear-end, angle, head-on, roadway departure, pedestrian-involved).' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countermeasureDescription rdf:type rdf:Property ;
    rdfs:label 'Countermeasure Description' ;
    rdfs:comment 'Detailed description of the safety countermeasure or intervention being implemented (e.g., rumble strips, high-friction surface treatment, signal upgrades, pedestrian refuge islands).' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countermeasureType rdf:type rdf:Property ;
    rdfs:label 'Countermeasure Type' ;
    rdfs:comment 'Classification of the safety countermeasure by implementation approach.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashModificationFactor rdf:type rdf:Property ;
    rdfs:label 'Crash Modification Factor' ;
    rdfs:comment 'Crash Modification Factor representing the expected effectiveness of the countermeasure in reducing crashes (e.g., 0.75 indicates 25% reduction).' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitCostRatio rdf:type rdf:Property ;
    rdfs:label 'Benefit Cost Ratio' ;
    rdfs:comment 'Calculated benefit-cost ratio for the safety program, comparing expected safety benefits to program costs.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nepaStatus rdf:type rdf:Property ;
    rdfs:label 'Nepa Status' ;
    rdfs:comment 'Status of NEPA environmental review process: Categorical Exclusion (CE), Environmental Assessment (EA), Environmental Impact Statement (EIS), Finding of No Significant Impact (FONSI), Record of Decision (ROD).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationAgency rdf:type rdf:Property ;
    rdfs:label 'Coordination Agency' ;
    rdfs:comment 'External agency or organization coordinating with NCDOT on the safety program (e.g., GHSP, local law enforcement, FHWA, NHTSA).' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationPhase rdf:type rdf:Property ;
    rdfs:label 'Implementation Phase' ;
    rdfs:comment 'Current phase of program implementation in the project lifecycle.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:letDate rdf:type rdf:Property ;
    rdfs:label 'Let Date' ;
    rdfs:comment 'Date when the contract was let for bidding or awarded.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:substantialCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Substantial Completion Date' ;
    rdfs:comment 'Date when the safety program reached substantial completion and became operational.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Final Acceptance Date' ;
    rdfs:comment 'Date when the safety program was formally accepted and closed out.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationStatus rdf:type rdf:Property ;
    rdfs:label 'Evaluation Status' ;
    rdfs:comment 'Status of the post-implementation safety effectiveness evaluation.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Completion Date' ;
    rdfs:comment 'Date when the post-implementation evaluation was completed.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualCrashReductionPercentage rdf:type rdf:Property ;
    rdfs:label 'Actual Crash Reduction Percentage' ;
    rdfs:comment 'Actual percentage reduction in crashes achieved after program implementation, based on evaluation data.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualFatalityReduction rdf:type rdf:Property ;
    rdfs:label 'Actual Fatality Reduction' ;
    rdfs:comment 'Actual number of fatalities prevented based on post-implementation evaluation.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualSeriousInjuryReduction rdf:type rdf:Property ;
    rdfs:label 'Actual Serious Injury Reduction' ;
    rdfs:comment 'Actual number of serious injuries prevented based on post-implementation evaluation.' ;
    rdfs:domain ind:Program ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detectorId rdf:type rdf:Property ;
    rdfs:label 'Detector Id' ;
    rdfs:comment 'Unique identifier for the traffic detector device. Primary key for the detector master record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Detector .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'Date when the detector was activated and began collecting traffic data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:laneNumber rdf:type rdf:Property ;
    rdfs:label 'Lane Number' ;
    rdfs:comment 'Lane number being monitored by the detector, numbered from left to right in the direction of travel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detectionZoneLengthFt rdf:type rdf:Property ;
    rdfs:label 'Detection Zone Length Ft' ;
    rdfs:comment 'Length of the detection zone in feet over which the detector can sense vehicles.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:detectionZoneWidthFt rdf:type rdf:Property ;
    rdfs:label 'Detection Zone Width Ft' ;
    rdfs:comment 'Width of the detection zone in feet across the lane monitored by the detector.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mountingType rdf:type rdf:Property ;
    rdfs:label 'Mounting Type' ;
    rdfs:comment 'Method by which the detector is physically mounted or installed at the location.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mountingHeightFt rdf:type rdf:Property ;
    rdfs:label 'Mounting Height Ft' ;
    rdfs:comment 'Height above the roadway surface at which the detector is mounted, applicable for overhead and side-mounted detectors.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:communicationMethod rdf:type rdf:Property ;
    rdfs:label 'Communication Method' ;
    rdfs:comment 'Technology used to transmit data from the detector to the Traffic Management Center (TMC) or data collection system.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipAddress rdf:type rdf:Property ;
    rdfs:label 'Ip Address' ;
    rdfs:comment 'Network IP address assigned to the detector for communication and remote access.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCollectionIntervalSeconds rdf:type rdf:Property ;
    rdfs:label 'Data Collection Interval Seconds' ;
    rdfs:comment 'Time interval in seconds at which the detector aggregates and reports traffic data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataTypesCollected rdf:type rdf:Property ;
    rdfs:label 'Data Types Collected' ;
    rdfs:comment 'Types of traffic data collected by the detector such as volume, speed, occupancy, classification, headway, or gap.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleClassificationCapability rdf:type rdf:Property ;
    rdfs:label 'Vehicle Classification Capability' ;
    rdfs:comment 'Indicates whether the detector has the capability to classify vehicles by type (e.g., passenger car, truck, motorcycle).' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:speedMeasurementCapability rdf:type rdf:Property ;
    rdfs:label 'Speed Measurement Capability' ;
    rdfs:comment 'Indicates whether the detector can measure individual vehicle speeds.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occupancyMeasurementCapability rdf:type rdf:Property ;
    rdfs:label 'Occupancy Measurement Capability' ;
    rdfs:comment 'Indicates whether the detector can measure lane occupancy percentage.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calibrationDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Date' ;
    rdfs:comment 'Date when the detector was last calibrated to ensure accuracy of measurements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calibrationTechnician rdf:type rdf:Property ;
    rdfs:label 'Calibration Technician' ;
    rdfs:comment 'Name or identifier of the technician who performed the most recent calibration.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calibrationFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Calibration Frequency Days' ;
    rdfs:comment 'Required frequency in days between calibration activities for the detector.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextCalibrationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Calibration Due Date' ;
    rdfs:comment 'Scheduled date for the next required calibration of the detector.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accuracyRatingPercent rdf:type rdf:Property ;
    rdfs:label 'Accuracy Rating Percent' ;
    rdfs:comment 'Measured accuracy rating of the detector expressed as a percentage, based on validation studies or calibration results.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastMaintenanceType rdf:type rdf:Property ;
    rdfs:label 'Last Maintenance Type' ;
    rdfs:comment 'Type of maintenance activity performed during the most recent maintenance event.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Maintenance Frequency Days' ;
    rdfs:comment 'Scheduled frequency in days between routine maintenance activities for the detector.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextMaintenanceDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Maintenance Due Date' ;
    rdfs:comment 'Scheduled date for the next routine maintenance activity on the detector.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maintenanceContractor rdf:type rdf:Property ;
    rdfs:label 'Maintenance Contractor' ;
    rdfs:comment 'Name of the contractor or vendor responsible for performing maintenance on the detector.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedLifespanYears rdf:type rdf:Property ;
    rdfs:label 'Expected Lifespan Years' ;
    rdfs:comment 'Expected operational lifespan of the detector in years based on manufacturer specifications and industry standards.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:replacementDueDate rdf:type rdf:Property ;
    rdfs:label 'Replacement Due Date' ;
    rdfs:comment 'Projected date when the detector should be replaced based on expected lifespan and condition assessment.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:powerSource rdf:type rdf:Property ;
    rdfs:label 'Power Source' ;
    rdfs:comment 'Primary source of electrical power for the detector operation.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerConsumptionWatts rdf:type rdf:Property ;
    rdfs:label 'Power Consumption Watts' ;
    rdfs:comment 'Average electrical power consumption of the detector measured in watts.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Firmware Version' ;
    rdfs:comment 'Version number of the firmware currently installed on the detector.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastFirmwareUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Firmware Update Date' ;
    rdfs:comment 'Date when the detector firmware was last updated or patched.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uptimePercentage rdf:type rdf:Property ;
    rdfs:label 'Uptime Percentage' ;
    rdfs:comment 'Percentage of time the detector has been operational and collecting data over a defined period.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureCount rdf:type rdf:Property ;
    rdfs:label 'Failure Count' ;
    rdfs:comment 'Total number of recorded failures or malfunctions of the detector since installation or over a defined period.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastFailureDate rdf:type rdf:Property ;
    rdfs:label 'Last Failure Date' ;
    rdfs:comment 'Date when the most recent detector failure or malfunction occurred.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastFailureReason rdf:type rdf:Property ;
    rdfs:label 'Last Failure Reason' ;
    rdfs:comment 'Description or categorization of the cause of the most recent detector failure.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meanTimeBetweenFailuresDays rdf:type rdf:Property ;
    rdfs:label 'Mean Time Between Failures Days' ;
    rdfs:comment 'Average number of days between detector failures, calculated from historical failure data.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meanTimeToRepairHours rdf:type rdf:Property ;
    rdfs:label 'Mean Time To Repair Hours' ;
    rdfs:comment 'Average time in hours required to repair the detector and restore it to operational status after a failure.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:atmsIntegrationStatus rdf:type rdf:Property ;
    rdfs:label 'Atms Integration Status' ;
    rdfs:comment 'Status indicating whether the detector is integrated with the NCDOT Advanced Traffic Management System for real-time traffic monitoring and control.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmcMonitoringEnabled rdf:type rdf:Property ;
    rdfs:label 'Tmc Monitoring Enabled' ;
    rdfs:comment 'Indicates whether the detector is actively monitored by the Traffic Management Center operations staff.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hpmsReportingStation rdf:type rdf:Property ;
    rdfs:label 'Hpms Reporting Station' ;
    rdfs:comment 'Indicates whether this detector serves as an official HPMS reporting station for federal highway performance data submission.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aadtCalculationEnabled rdf:type rdf:Property ;
    rdfs:label 'Aadt Calculation Enabled' ;
    rdfs:comment 'Indicates whether data from this detector is used in the calculation of Annual Average Daily Traffic statistics.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatingTemperatureMinF rdf:type rdf:Property ;
    rdfs:label 'Operating Temperature Min F' ;
    rdfs:comment 'Minimum operating temperature in Fahrenheit at which the detector can function properly.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingTemperatureMaxF rdf:type rdf:Property ;
    rdfs:label 'Operating Temperature Max F' ;
    rdfs:comment 'Maximum operating temperature in Fahrenheit at which the detector can function properly.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownership rdf:type rdf:Property ;
    rdfs:label 'Ownership' ;
    rdfs:comment 'Entity that owns the detector equipment and is responsible for its operation and maintenance.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleDistrict rdf:type rdf:Property ;
    rdfs:label 'Responsible District' ;
    rdfs:comment 'NCDOT district or regional office responsible for the detector within their geographic area.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetTag rdf:type rdf:Property ;
    rdfs:label 'Asset Tag' ;
    rdfs:comment 'NCDOT asset management tag or identifier assigned to the detector for inventory and tracking purposes.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalAidProject rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Project' ;
    rdfs:comment 'Indicates whether the detector was installed as part of a federally-funded transportation project.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:decommissionDate rdf:type rdf:Property ;
    rdfs:label 'Decommission Date' ;
    rdfs:comment 'Date when the detector was decommissioned and removed from service.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decommissionReason rdf:type rdf:Property ;
    rdfs:label 'Decommission Reason' ;
    rdfs:comment 'Reason for decommissioning the detector such as end of life, roadway reconstruction, technology upgrade, or relocation.' ;
    rdfs:domain ind:Detector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicAlertId rdf:type rdf:Property ;
    rdfs:label 'Public Alert Id' ;
    rdfs:comment 'Unique identifier for the public safety alert record.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alertNumber rdf:type rdf:Property ;
    rdfs:label 'Alert Number' ;
    rdfs:comment 'Human-readable unique alert number assigned to the public safety alert for reference and tracking purposes.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertType rdf:type rdf:Property ;
    rdfs:label 'Alert Type' ;
    rdfs:comment 'Classification of the public safety alert indicating the nature of the hazard or condition being communicated to the public.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertCategory rdf:type rdf:Property ;
    rdfs:label 'Alert Category' ;
    rdfs:comment 'High-level categorization of the alert for prioritization and filtering purposes.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:message rdf:type rdf:Property ;
    rdfs:label 'Message' ;
    rdfs:comment 'Detailed message content describing the safety alert, hazardous condition, or public notification being communicated.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortMessage rdf:type rdf:Property ;
    rdfs:label 'Short Message' ;
    rdfs:comment 'Abbreviated version of the alert message suitable for display on Dynamic Message Signs (DMS) and mobile notifications with character limitations.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Start Timestamp' ;
    rdfs:comment 'Date and time when the public alert becomes active and should be disseminated to the public.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective End Timestamp' ;
    rdfs:comment 'Date and time when the public alert expires and should no longer be displayed or disseminated.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:issuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issued Timestamp' ;
    rdfs:comment 'Date and time when the alert was officially issued by NCDOT or authorized personnel.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Date and time when the alert was last modified or updated with new information.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mileMarkerStart rdf:type rdf:Property ;
    rdfs:label 'Mile Marker Start' ;
    rdfs:comment 'Beginning mile marker location where the alert condition starts on the roadway.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mileMarkerEnd rdf:type rdf:Property ;
    rdfs:label 'Mile Marker End' ;
    rdfs:comment 'Ending mile marker location where the alert condition ends on the roadway.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geospatialBoundary rdf:type rdf:Property ;
    rdfs:label 'Geospatial Boundary' ;
    rdfs:comment 'Well-Known Text (WKT) representation of the geographic area or polygon affected by the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disseminationChannels rdf:type rdf:Property ;
    rdfs:label 'Dissemination Channels' ;
    rdfs:comment 'Comma-separated list of channels through which the alert is being disseminated (e.g., DMS, website, mobile app, social media, 511, email, SMS).' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmsDisplayed rdf:type rdf:Property ;
    rdfs:label 'Dms Displayed' ;
    rdfs:comment 'Indicates whether the alert is being displayed on Dynamic Message Signs along the roadway.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:websitePublished rdf:type rdf:Property ;
    rdfs:label 'Website Published' ;
    rdfs:comment 'Indicates whether the alert has been published to the NCDOT public website.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobileAppPublished rdf:type rdf:Property ;
    rdfs:label 'Mobile App Published' ;
    rdfs:comment 'Indicates whether the alert has been published to the NCDOT mobile application.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:socialMediaPublished rdf:type rdf:Property ;
    rdfs:label 'Social Media Published' ;
    rdfs:comment 'Indicates whether the alert has been published to NCDOT social media channels.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fiveOneOnePublished rdf:type rdf:Property ;
    rdfs:label 'Five One One Published' ;
    rdfs:comment 'Indicates whether the alert has been published to the 511 traveler information system.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roadCondition rdf:type rdf:Property ;
    rdfs:label 'Road Condition' ;
    rdfs:comment 'Current condition of the roadway surface or infrastructure related to the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lanesAffected rdf:type rdf:Property ;
    rdfs:label 'Lanes Affected' ;
    rdfs:comment 'Description of which lanes are affected by the alert (e.g., left lane, right two lanes, all lanes, shoulder).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfLanesClosed rdf:type rdf:Property ;
    rdfs:label 'Number Of Lanes Closed' ;
    rdfs:comment 'Count of travel lanes closed due to the alert condition.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detourAvailable rdf:type rdf:Property ;
    rdfs:label 'Detour Available' ;
    rdfs:comment 'Indicates whether an official detour route is available for motorists to bypass the affected area.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detourDescription rdf:type rdf:Property ;
    rdfs:label 'Detour Description' ;
    rdfs:comment 'Description of the detour route and directions for motorists to follow.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDelayMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Delay Minutes' ;
    rdfs:comment 'Estimated travel delay in minutes that motorists may experience due to the alert condition.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expectedClearanceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expected Clearance Timestamp' ;
    rdfs:comment 'Estimated date and time when the alert condition is expected to be cleared or resolved.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualClearanceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Clearance Timestamp' ;
    rdfs:comment 'Actual date and time when the alert condition was cleared or resolved.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:issuingOrganization rdf:type rdf:Property ;
    rdfs:label 'Issuing Organization' ;
    rdfs:comment 'Name of the NCDOT division or external organization that issued the alert (e.g., DOH, DMV, IMAP, TMC, National Weather Service).' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingDivision rdf:type rdf:Property ;
    rdfs:label 'Issuing Division' ;
    rdfs:comment 'NCDOT division code responsible for issuing the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedIncidentNumber rdf:type rdf:Property ;
    rdfs:label 'Related Incident Number' ;
    rdfs:comment 'Reference number of the traffic incident or emergency event that triggered the alert.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedProjectNumber rdf:type rdf:Property ;
    rdfs:label 'Related Project Number' ;
    rdfs:comment 'NCDOT project number if the alert is related to construction or maintenance activities.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imapInvolved rdf:type rdf:Property ;
    rdfs:label 'Imap Involved' ;
    rdfs:comment 'Indicates whether IMAP units are responding to or involved in the incident related to this alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyResponseRequired rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Required' ;
    rdfs:comment 'Indicates whether emergency response services (police, fire, EMS) are required or involved.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatInvolved rdf:type rdf:Property ;
    rdfs:label 'Hazmat Involved' ;
    rdfs:comment 'Indicates whether hazardous materials are involved in the incident related to the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evacuationRequired rdf:type rdf:Property ;
    rdfs:label 'Evacuation Required' ;
    rdfs:comment 'Indicates whether evacuation of the area is required due to the alert condition.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bridgeInvolved rdf:type rdf:Property ;
    rdfs:label 'Bridge Involved' ;
    rdfs:comment 'Indicates whether a bridge structure is involved in or affected by the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bridgeNumber rdf:type rdf:Property ;
    rdfs:label 'Bridge Number' ;
    rdfs:comment 'NCDOT bridge identification number if a bridge is involved in the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ferryRouteAffected rdf:type rdf:Property ;
    rdfs:label 'Ferry Route Affected' ;
    rdfs:comment 'Name or identifier of the ferry route affected by the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicTransitImpact rdf:type rdf:Property ;
    rdfs:label 'Public Transit Impact' ;
    rdfs:comment 'Indicates whether public transit services are impacted by the alert condition.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialEventName rdf:type rdf:Property ;
    rdfs:label 'Special Event Name' ;
    rdfs:comment 'Name of the special event if the alert is related to a planned event affecting traffic.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionActivity rdf:type rdf:Property ;
    rdfs:label 'Construction Activity' ;
    rdfs:comment 'Description of construction or maintenance activity related to the alert.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workZoneType rdf:type rdf:Property ;
    rdfs:label 'Work Zone Type' ;
    rdfs:comment 'Classification of the work zone if the alert is related to construction or maintenance activities.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:motPlanNumber rdf:type rdf:Property ;
    rdfs:label 'Mot Plan Number' ;
    rdfs:comment 'Reference number of the maintenance of traffic plan for the alert area.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertLanguage rdf:type rdf:Property ;
    rdfs:label 'Alert Language' ;
    rdfs:comment 'Language code for the alert message (en=English, es=Spanish, fr=French).' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Alert Source System' ;
    rdfs:comment 'Name of the system or application that originated the alert (e.g., TIMS, ATMS, TMC, IMAP).' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertVersion rdf:type rdf:Property ;
    rdfs:label 'Alert Version' ;
    rdfs:comment 'Version number of the alert indicating how many times it has been updated or revised.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalRequired rdf:type rdf:Property ;
    rdfs:label 'Approval Required' ;
    rdfs:comment 'Indicates whether the alert requires supervisory or management approval before dissemination.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:audienceType rdf:type rdf:Property ;
    rdfs:label 'Audience Type' ;
    rdfs:comment 'Target audience for the alert message.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAreaSquareMiles rdf:type rdf:Property ;
    rdfs:label 'Impact Area Square Miles' ;
    rdfs:comment 'Estimated geographic area in square miles affected by the alert condition.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedAffectedVehicles rdf:type rdf:Property ;
    rdfs:label 'Estimated Affected Vehicles' ;
    rdfs:comment 'Estimated number of vehicles that may be affected by the alert condition based on AADT (Annual Average Daily Traffic) data.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alertUrl rdf:type rdf:Property ;
    rdfs:label 'Alert Url' ;
    rdfs:comment 'Web URL where additional information about the alert can be accessed by the public.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaAttachments rdf:type rdf:Property ;
    rdfs:label 'Media Attachments' ;
    rdfs:comment 'Comma-separated list of URLs or file paths to images, videos, or documents associated with the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cctvCameraIds rdf:type rdf:Property ;
    rdfs:label 'Cctv Camera Ids' ;
    rdfs:comment 'Comma-separated list of CCTV camera IDs that provide visual coverage of the alert location.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmsDeviceIds rdf:type rdf:Property ;
    rdfs:label 'Dms Device Ids' ;
    rdfs:comment 'Comma-separated list of DMS device IDs where the alert message is being displayed.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertRecurrencePattern rdf:type rdf:Property ;
    rdfs:label 'Alert Recurrence Pattern' ;
    rdfs:comment 'Indicates if the alert is a one-time event or follows a recurring pattern (e.g., daily construction activities).' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRestriction rdf:type rdf:Property ;
    rdfs:label 'Legal Restriction' ;
    rdfs:comment 'Description of any legal restrictions or regulatory requirements associated with the alert (e.g., mandatory detour, road closure order).' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementAgency rdf:type rdf:Property ;
    rdfs:label 'Enforcement Agency' ;
    rdfs:comment 'Name of the law enforcement agency responsible for enforcing restrictions related to the alert.' ;
    rdfs:domain ind:PublicAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signalTimingPlanId rdf:type rdf:Property ;
    rdfs:label 'Signal Timing Plan Id' ;
    rdfs:comment 'Unique identifier for the signal timing plan record.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'Descriptive name or label for the signal timing plan (e.g., AM Peak, PM Peak, Weekend, Free).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planNumber rdf:type rdf:Property ;
    rdfs:label 'Plan Number' ;
    rdfs:comment 'Numeric identifier or code assigned to the timing plan within the traffic signal controller or ATMS.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Classification of the timing plan based on operational mode (e.g., time of day, traffic responsive, manual override, coordination, free operation, preemption, transition).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleLengthSeconds rdf:type rdf:Property ;
    rdfs:label 'Cycle Length Seconds' ;
    rdfs:comment 'Total duration of one complete signal cycle in seconds, representing the time from the beginning of one green phase to the beginning of the next identical green phase.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:offsetSeconds rdf:type rdf:Property ;
    rdfs:label 'Offset Seconds' ;
    rdfs:comment 'Time offset in seconds used for signal coordination, representing the time relationship between the start of the local cycle and a system reference point to create green wave progression.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phaseSequence rdf:type rdf:Property ;
    rdfs:label 'Phase Sequence' ;
    rdfs:comment 'Ordered sequence of signal phases within the timing plan, typically represented as a comma-separated list of phase numbers (e.g., 2,6,4,8).' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phase1GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 1 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 1 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase1YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 1 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 1 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase1RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 1 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 1 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase2GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 2 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 2 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase2YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 2 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 2 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase2RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 2 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 2 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase3GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 3 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 3 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase3YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 3 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 3 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase3RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 3 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 3 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase4GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 4 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 4 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase4YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 4 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 4 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase4RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 4 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 4 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase5GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 5 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 5 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase5YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 5 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 5 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase5RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 5 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 5 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase6GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 6 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 6 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase6YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 6 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 6 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase6RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 6 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 6 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase7GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 7 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 7 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase7YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 7 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 7 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase7RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 7 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 7 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase8GreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 8 Green Time Seconds' ;
    rdfs:comment 'Duration of green signal display for phase 8 in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase8YellowTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 8 Yellow Time Seconds' ;
    rdfs:comment 'Duration of yellow signal display for phase 8 in seconds, providing clearance interval.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phase8RedClearanceSeconds rdf:type rdf:Property ;
    rdfs:label 'Phase 8 Red Clearance Seconds' ;
    rdfs:comment 'Duration of all-red clearance interval for phase 8 in seconds, providing additional safety time before conflicting movements begin.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pedestrianWalkTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Walk Time Seconds' ;
    rdfs:comment 'Duration of the WALK signal display for pedestrian crossings in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pedestrianClearanceTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Clearance Time Seconds' ;
    rdfs:comment 'Duration of the flashing DON\'T WALK or countdown signal for pedestrian clearance in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumGreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Minimum Green Time Seconds' ;
    rdfs:comment 'Minimum duration that a green signal must be displayed for actuated phases in seconds.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumGreenTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Maximum Green Time Seconds' ;
    rdfs:comment 'Maximum duration that a green signal can be displayed for actuated phases in seconds before forcing a phase change.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleExtensionSeconds rdf:type rdf:Property ;
    rdfs:label 'Vehicle Extension Seconds' ;
    rdfs:comment 'Time increment in seconds by which the green phase is extended when a vehicle is detected during actuated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeBeforeReductionSeconds rdf:type rdf:Property ;
    rdfs:label 'Time Before Reduction Seconds' ;
    rdfs:comment 'Duration in seconds before the controller begins reducing the green extension time in volume-density actuated control.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeToReduceSeconds rdf:type rdf:Property ;
    rdfs:label 'Time To Reduce Seconds' ;
    rdfs:comment 'Rate at which the vehicle extension time is reduced in seconds during gap reduction in actuated control.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumGapSeconds rdf:type rdf:Property ;
    rdfs:label 'Minimum Gap Seconds' ;
    rdfs:comment 'Minimum allowable gap time in seconds between vehicles during gap reduction in actuated signal control.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:splitPercentagePhase1 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 1' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 1 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPercentagePhase2 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 2' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 2 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPercentagePhase3 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 3' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 3 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPercentagePhase4 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 4' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 4 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPercentagePhase5 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 5' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 5 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPercentagePhase6 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 6' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 6 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPercentagePhase7 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 7' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 7 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPercentagePhase8 rdf:type rdf:Property ;
    rdfs:label 'Split Percentage Phase 8' ;
    rdfs:comment 'Percentage of the total cycle length allocated to phase 8 green time in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preemptionEnabled rdf:type rdf:Property ;
    rdfs:label 'Preemption Enabled' ;
    rdfs:comment 'Indicates whether emergency vehicle or railroad preemption is enabled for this timing plan.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityEnabled rdf:type rdf:Property ;
    rdfs:label 'Priority Enabled' ;
    rdfs:comment 'Indicates whether transit signal priority is enabled for this timing plan.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeOfDayStart rdf:type rdf:Property ;
    rdfs:label 'Time Of Day Start' ;
    rdfs:comment 'Time of day when this timing plan becomes active in HH:MM format (e.g., 07:00 for AM peak).' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeOfDayEnd rdf:type rdf:Property ;
    rdfs:label 'Time Of Day End' ;
    rdfs:comment 'Time of day when this timing plan becomes inactive in HH:MM format (e.g., 09:00 for end of AM peak).' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Design Speed Mph' ;
    rdfs:comment 'Design speed in miles per hour used for calculating signal timing parameters such as yellow and clearance intervals.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approachGradePercent rdf:type rdf:Property ;
    rdfs:label 'Approach Grade Percent' ;
    rdfs:comment 'Grade or slope of the roadway approach in percentage, used for calculating stopping sight distance and clearance times.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intersectionWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Intersection Width Feet' ;
    rdfs:comment 'Width of the intersection in feet, used for calculating clearance intervals and pedestrian crossing times.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pedestrianCrossingDistanceFeet rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Crossing Distance Feet' ;
    rdfs:comment 'Distance in feet that pedestrians must traverse during the crossing phase, used to calculate pedestrian clearance time.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pedestrianWalkingSpeedFps rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Walking Speed Fps' ;
    rdfs:comment 'Assumed pedestrian walking speed in feet per second used for calculating pedestrian clearance intervals (typically 3.5 fps).' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coordinationReferencePoint rdf:type rdf:Property ;
    rdfs:label 'Coordination Reference Point' ;
    rdfs:comment 'Reference point in the signal cycle used for coordination timing (e.g., beginning of green, end of green, beginning of yellow, master clock).' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forceOffPointSeconds rdf:type rdf:Property ;
    rdfs:label 'Force Off Point Seconds' ;
    rdfs:comment 'Point in the cycle in seconds at which the green phase is forced to terminate in coordinated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:permissivePeriodSeconds rdf:type rdf:Property ;
    rdfs:label 'Permissive Period Seconds' ;
    rdfs:comment 'Duration in seconds during which the phase can be skipped or shortened if there is no demand in coordinated-actuated operation.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:atmsSystemId rdf:type rdf:Property ;
    rdfs:label 'Atms System Id' ;
    rdfs:comment 'Identifier of the ATMS system that manages and monitors this signal timing plan.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AtmsSystem .

ind:tmcRegion rdf:type rdf:Property ;
    rdfs:label 'Tmc Region' ;
    rdfs:comment 'Geographic region or district of the TMC responsible for managing this signal timing plan.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:losTarget rdf:type rdf:Property ;
    rdfs:label 'Los Target' ;
    rdfs:comment 'Target Level of Service (LOS) rating (A through F) that this timing plan is designed to achieve based on traffic flow and delay metrics.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designVolumeVph rdf:type rdf:Property ;
    rdfs:label 'Design Volume Vph' ;
    rdfs:comment 'Design traffic volume in vehicles per hour that this timing plan is intended to accommodate.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakHourFactor rdf:type rdf:Property ;
    rdfs:label 'Peak Hour Factor' ;
    rdfs:comment 'Peak hour factor (PHF) representing the ratio of total hourly volume to the peak 15-minute flow rate, used in capacity analysis.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controllerType rdf:type rdf:Property ;
    rdfs:label 'Controller Type' ;
    rdfs:comment 'Type or model of the traffic signal controller that implements this timing plan (e.g., NEMA, Type 170, ATC, Econolite).' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialEventFlag rdf:type rdf:Property ;
    rdfs:label 'Special Event Flag' ;
    rdfs:comment 'Indicates whether this timing plan is designed for special events such as sports games, concerts, or festivals.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentManagementFlag rdf:type rdf:Property ;
    rdfs:label 'Incident Management Flag' ;
    rdfs:comment 'Indicates whether this timing plan is designed for incident management scenarios to facilitate emergency response and traffic diversion.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weatherResponsiveFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Responsive Flag' ;
    rdfs:comment 'Indicates whether this timing plan is designed to be activated in response to adverse weather conditions.' ;
    rdfs:domain ind:SignalTimingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flowId rdf:type rdf:Property ;
    rdfs:label 'Flow Id' ;
    rdfs:comment 'Unique identifier for each traffic flow measurement record captured by detection equipment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Flow .

ind:measurementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Measurement Timestamp' ;
    rdfs:comment 'Precise date and time when the traffic flow measurement was captured by the detector.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:measurementDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Date' ;
    rdfs:comment 'Calendar date of the traffic flow measurement, used for daily aggregation and reporting.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Measurement Interval Minutes' ;
    rdfs:comment 'Duration in minutes over which the traffic flow data was aggregated (e.g., 5-minute, 15-minute intervals).' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleCount rdf:type rdf:Property ;
    rdfs:label 'Vehicle Count' ;
    rdfs:comment 'Total number of vehicles detected during the measurement interval.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Average Speed Mph' ;
    rdfs:comment 'Average speed of vehicles in miles per hour during the measurement interval.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:speedLimitMph rdf:type rdf:Property ;
    rdfs:label 'Speed Limit Mph' ;
    rdfs:comment 'Posted regulatory speed limit in miles per hour at the detector location.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupancyPercent rdf:type rdf:Property ;
    rdfs:label 'Occupancy Percent' ;
    rdfs:comment 'Percentage of time the detector was occupied by vehicles during the measurement interval, indicating traffic density.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumePerHour rdf:type rdf:Property ;
    rdfs:label 'Volume Per Hour' ;
    rdfs:comment 'Traffic volume extrapolated to vehicles per hour based on the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passengerCarCount rdf:type rdf:Property ;
    rdfs:label 'Passenger Car Count' ;
    rdfs:comment 'Number of passenger cars (FHWA Class 1-3) detected during the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:singleUnitTruckCount rdf:type rdf:Property ;
    rdfs:label 'Single Unit Truck Count' ;
    rdfs:comment 'Number of single-unit trucks (FHWA Class 4-7) detected during the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:combinationTruckCount rdf:type rdf:Property ;
    rdfs:label 'Combination Truck Count' ;
    rdfs:comment 'Number of combination trucks (FHWA Class 8-13) detected during the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:busCount rdf:type rdf:Property ;
    rdfs:label 'Bus Count' ;
    rdfs:comment 'Number of buses detected during the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleClassificationScheme rdf:type rdf:Property ;
    rdfs:label 'Vehicle Classification Scheme' ;
    rdfs:comment 'Classification scheme used for vehicle type categorization (e.g., FHWA 13-category, FHWA 4-category).' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heavyVehiclePercent rdf:type rdf:Property ;
    rdfs:label 'Heavy Vehicle Percent' ;
    rdfs:comment 'Percentage of heavy vehicles (trucks and buses) in the traffic stream during the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakPeriodIndicator rdf:type rdf:Property ;
    rdfs:label 'Peak Period Indicator' ;
    rdfs:comment 'Indicates whether the measurement was taken during a recognized peak travel period.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holidayIndicator rdf:type rdf:Property ;
    rdfs:label 'Holiday Indicator' ;
    rdfs:comment 'Indicates whether the measurement was taken on a recognized state or federal holiday, which may affect traffic patterns.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialEventIndicator rdf:type rdf:Property ;
    rdfs:label 'Special Event Indicator' ;
    rdfs:comment 'Indicates whether a special event (sports, concert, festival) was occurring that may have influenced traffic patterns.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pavementCondition rdf:type rdf:Property ;
    rdfs:label 'Pavement Condition' ;
    rdfs:comment 'Condition of the pavement surface at the time of measurement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:levelOfService rdf:type rdf:Property ;
    rdfs:label 'Level Of Service' ;
    rdfs:comment 'Highway Capacity Manual Level of Service grade (A-F) representing traffic flow quality, with A being best and F representing breakdown conditions.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:densityVehiclesPerMile rdf:type rdf:Property ;
    rdfs:label 'Density Vehicles Per Mile' ;
    rdfs:comment 'Traffic density calculated as vehicles per mile of roadway during the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:headwaySeconds rdf:type rdf:Property ;
    rdfs:label 'Headway Seconds' ;
    rdfs:comment 'Average time gap in seconds between consecutive vehicles passing the detector.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapSeconds rdf:type rdf:Property ;
    rdfs:label 'Gap Seconds' ;
    rdfs:comment 'Average time gap in seconds between the rear of one vehicle and the front of the following vehicle.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:queueLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Queue Length Feet' ;
    rdfs:comment 'Estimated length of vehicle queue in feet upstream of the detector, if applicable.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:travelTimeIndex rdf:type rdf:Property ;
    rdfs:label 'Travel Time Index' ;
    rdfs:comment 'Ratio of actual travel time to free-flow travel time, indicating congestion severity (1.0 = free flow).' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vmtVehicleMilesTraveled rdf:type rdf:Property ;
    rdfs:label 'Vmt Vehicle Miles Traveled' ;
    rdfs:comment 'Estimated vehicle miles traveled based on the traffic count and segment length.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataCompletenessPercent rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Percent' ;
    rdfs:comment 'Percentage of expected data points successfully captured during the measurement interval.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationFlag rdf:type rdf:Property ;
    rdfs:label 'Validation Flag' ;
    rdfs:comment 'Indicates whether the measurement data has passed quality validation checks.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:anomalyFlag rdf:type rdf:Property ;
    rdfs:label 'Anomaly Flag' ;
    rdfs:comment 'Indicates whether the measurement was flagged as anomalous by automated quality control algorithms.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imputationFlag rdf:type rdf:Property ;
    rdfs:label 'Imputation Flag' ;
    rdfs:comment 'Indicates whether missing or invalid data was imputed using statistical methods.' ;
    rdfs:domain ind:Flow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionMethod rdf:type rdf:Property ;
    rdfs:label 'Collection Method' ;
    rdfs:comment 'Method used to collect the traffic flow data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmcCode rdf:type rdf:Property ;
    rdfs:label 'Tmc Code' ;
    rdfs:comment 'Traffic Message Channel location code for the roadway segment, used for traffic information dissemination.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atmsStationId rdf:type rdf:Property ;
    rdfs:label 'Atms Station Id' ;
    rdfs:comment 'Identifier for the ATMS station that manages this detector within the NCDOT Traffic Management Center.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AtmsStation .

ind:hpmsSampleType rdf:type rdf:Property ;
    rdfs:label 'Hpms Sample Type' ;
    rdfs:comment 'Classification of the traffic count station for HPMS reporting purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalClassCode rdf:type rdf:Property ;
    rdfs:label 'Functional Class Code' ;
    rdfs:comment 'FHWA functional classification code for the roadway segment (e.g., 01=Interstate, 02=Principal Arterial).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:truckRouteIndicator rdf:type rdf:Property ;
    rdfs:label 'Truck Route Indicator' ;
    rdfs:comment 'Indicates whether the roadway segment is a designated truck route.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseActionId rdf:type rdf:Property ;
    rdfs:label 'Response Action Id' ;
    rdfs:comment 'Unique identifier for the response action taken in response to a safety incident.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incidentId rdf:type rdf:Property ;
    rdfs:label 'Incident Id' ;
    rdfs:comment 'Unique identifier of the safety incident to which this response action is associated.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Incident .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'The type or category of response action taken by emergency responders or NCDOT personnel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current status of the response action in its lifecycle.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Timestamp' ;
    rdfs:comment 'Date and time when the response action was dispatched or initiated.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:enRouteTimestamp rdf:type rdf:Property ;
    rdfs:label 'En Route Timestamp' ;
    rdfs:comment 'Date and time when the responder began traveling to the incident location.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:arrivalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Arrival Timestamp' ;
    rdfs:comment 'Date and time when the responder arrived at the incident scene.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actionStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Action Start Timestamp' ;
    rdfs:comment 'Date and time when the response action work actually began on scene.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actionEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Action End Timestamp' ;
    rdfs:comment 'Date and time when the response action work was completed.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:departureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Departure Timestamp' ;
    rdfs:comment 'Date and time when the responder departed from the incident scene.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Minutes' ;
    rdfs:comment 'Total time in minutes from dispatch to arrival on scene.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearanceTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Clearance Time Minutes' ;
    rdfs:comment 'Total time in minutes from arrival to incident clearance and departure.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:respondingAgency rdf:type rdf:Property ;
    rdfs:label 'Responding Agency' ;
    rdfs:comment 'The primary agency or organization responsible for this response action.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responderName rdf:type rdf:Property ;
    rdfs:label 'Responder Name' ;
    rdfs:comment 'Name of the primary responder or team leader who executed the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Responder Employee Id' ;
    rdfs:comment 'Employee identifier of the NCDOT personnel who responded, if applicable.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:responderContactNumber rdf:type rdf:Property ;
    rdfs:label 'Responder Contact Number' ;
    rdfs:comment 'Contact phone number of the responder for coordination purposes.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchSource rdf:type rdf:Property ;
    rdfs:label 'Dispatch Source' ;
    rdfs:comment 'The source or method by which the response action was initiated or dispatched.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceType rdf:type rdf:Property ;
    rdfs:label 'Resource Type' ;
    rdfs:comment 'Type of resource or equipment deployed for the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceCount rdf:type rdf:Property ;
    rdfs:label 'Resource Count' ;
    rdfs:comment 'Number of resources or units deployed for this response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:personnelCount rdf:type rdf:Property ;
    rdfs:label 'Personnel Count' ;
    rdfs:comment 'Number of personnel involved in executing the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionDescription rdf:type rdf:Property ;
    rdfs:label 'Action Description' ;
    rdfs:comment 'Detailed narrative description of the response action taken and activities performed.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficControlMethod rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Method' ;
    rdfs:comment 'Method of traffic control implemented during the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lanesClosedCount rdf:type rdf:Property ;
    rdfs:label 'Lanes Closed Count' ;
    rdfs:comment 'Number of traffic lanes closed as part of the response action.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roadClosureFlag rdf:type rdf:Property ;
    rdfs:label 'Road Closure Flag' ;
    rdfs:comment 'Indicates whether a full road closure was required for the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detourRouteDescription rdf:type rdf:Property ;
    rdfs:label 'Detour Route Description' ;
    rdfs:comment 'Description of the detour route established if road closure was necessary.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialsUsed rdf:type rdf:Property ;
    rdfs:label 'Materials Used' ;
    rdfs:comment 'Description of materials consumed or deployed during the response (e.g., absorbent, cones, signs).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Amount' ;
    rdfs:comment 'Estimated cost of the response action including labor, equipment, and materials.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Actual cost incurred for the response action after completion.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costRecoveryFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Recovery Flag' ;
    rdfs:comment 'Indicates whether costs for this response action are eligible for recovery from responsible parties.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visibilityCondition rdf:type rdf:Property ;
    rdfs:label 'Visibility Condition' ;
    rdfs:comment 'Lighting and visibility conditions at the time of the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Hazmat Involved Flag' ;
    rdfs:comment 'Indicates whether hazardous materials were involved requiring specialized response.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatMaterialType rdf:type rdf:Property ;
    rdfs:label 'Hazmat Material Type' ;
    rdfs:comment 'Type or classification of hazardous material involved in the incident response.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Injury Reported Flag' ;
    rdfs:comment 'Indicates whether injuries were reported during the incident requiring medical response.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fatalityReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Fatality Reported Flag' ;
    rdfs:comment 'Indicates whether fatalities were reported during the incident.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Secondary Incident Flag' ;
    rdfs:comment 'Indicates whether a secondary incident occurred during the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Coordination Required Flag' ;
    rdfs:comment 'Indicates whether coordination with multiple agencies was required for the response.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinatingAgencies rdf:type rdf:Property ;
    rdfs:label 'Coordinating Agencies' ;
    rdfs:comment 'List of agencies involved in coordinated response efforts.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentCommanderName rdf:type rdf:Property ;
    rdfs:label 'Incident Commander Name' ;
    rdfs:comment 'Name of the incident commander who coordinated the overall response effort.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmcNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Tmc Notified Flag' ;
    rdfs:comment 'Indicates whether the Traffic Management Center was notified of the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tmcNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Tmc Notification Timestamp' ;
    rdfs:comment 'Date and time when the TMC was notified of the incident and response.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:publicNotificationMethod rdf:type rdf:Property ;
    rdfs:label 'Public Notification Method' ;
    rdfs:comment 'Method used to notify the public about the incident and response actions.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmsMessagePosted rdf:type rdf:Property ;
    rdfs:label 'Dms Message Posted' ;
    rdfs:comment 'Content of the message posted on Dynamic Message Signs to inform motorists.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Media Coverage Flag' ;
    rdfs:comment 'Indicates whether the incident and response received media coverage.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roadwayType rdf:type rdf:Property ;
    rdfs:label 'Roadway Type' ;
    rdfs:comment 'Classification of the roadway where the response action took place.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficVolumeImpact rdf:type rdf:Property ;
    rdfs:label 'Traffic Volume Impact' ;
    rdfs:comment 'Estimated impact of the incident and response on traffic volume and flow.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Queue Length Miles' ;
    rdfs:comment 'Maximum length of traffic queue in miles resulting from the incident.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responseEffectivenessRating rdf:type rdf:Property ;
    rdfs:label 'Response Effectiveness Rating' ;
    rdfs:comment 'Qualitative rating of the effectiveness of the response action.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:afterActionReviewFlag rdf:type rdf:Property ;
    rdfs:label 'After Action Review Flag' ;
    rdfs:comment 'Indicates whether a formal after-action review was conducted for this response.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:afterActionReviewDate rdf:type rdf:Property ;
    rdfs:label 'After Action Review Date' ;
    rdfs:comment 'Date when the after-action review was conducted.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hsipEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hsip Eligible Flag' ;
    rdfs:comment 'Indicates whether the incident location is eligible for HSIP safety improvements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ghspNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Ghsp Notification Flag' ;
    rdfs:comment 'Indicates whether GHSP was notified for coordination on highway safety initiatives.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyDeclarationFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Declaration Flag' ;
    rdfs:comment 'Indicates whether a state or federal emergency declaration was in effect during the response.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalFundingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Eligible Flag' ;
    rdfs:comment 'Indicates whether the response costs are eligible for federal emergency funding reimbursement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationCompleteFlag rdf:type rdf:Property ;
    rdfs:label 'Documentation Complete Flag' ;
    rdfs:comment 'Indicates whether all required documentation for the response action has been completed.' ;
    rdfs:domain ind:ResponseAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Date and time when the response action was approved.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:correctiveActionId rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Id' ;
    rdfs:comment 'Unique identifier for the corrective action record. Primary key for tracking corrective actions generated from safety inspections or incident investigations.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionNumber rdf:type rdf:Property ;
    rdfs:label 'Action Number' ;
    rdfs:comment 'Human-readable business identifier for the corrective action, typically formatted as CA-YYYY-NNNNNN for tracking and reference purposes.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceType rdf:type rdf:Property ;
    rdfs:label 'Source Type' ;
    rdfs:comment 'Type of source event or activity that generated the corrective action requirement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Source Reference Number' ;
    rdfs:comment 'Reference identifier of the originating inspection, incident, audit, or other source event that generated this corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDescription rdf:type rdf:Property ;
    rdfs:label 'Finding Description' ;
    rdfs:comment 'Description of the specific finding, deficiency, or safety issue identified during the inspection or investigation that necessitated this corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyName rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Name' ;
    rdfs:comment 'Name of the individual, team, or organizational unit assigned responsibility for implementing and completing the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyEmail rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Email' ;
    rdfs:comment 'Email address of the responsible party for communication and notification regarding the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyPhone rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Phone' ;
    rdfs:comment 'Contact phone number for the responsible party assigned to the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extendedDueDate rdf:type rdf:Property ;
    rdfs:label 'Extended Due Date' ;
    rdfs:comment 'Revised due date if an extension was granted for completing the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionReason rdf:type rdf:Property ;
    rdfs:label 'Extension Reason' ;
    rdfs:comment 'Justification or explanation for granting an extension to the original due date.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'Actual date when the corrective action was completed and implemented by the responsible party.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verifiedDate rdf:type rdf:Property ;
    rdfs:label 'Verified Date' ;
    rdfs:comment 'Date when the completed corrective action was verified and validated as effective by the reviewing authority.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationNotes rdf:type rdf:Property ;
    rdfs:label 'Verification Notes' ;
    rdfs:comment 'Notes documenting the verification process, findings, and confirmation that the corrective action adequately addressed the identified issue.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedByName rdf:type rdf:Property ;
    rdfs:label 'Verified By Name' ;
    rdfs:comment 'Name of the individual who performed the verification and validation of the completed corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessRating rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Rating' ;
    rdfs:comment 'Assessment of how effective the corrective action was in addressing and resolving the identified safety issue.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceIndicator rdf:type rdf:Property ;
    rdfs:label 'Recurrence Indicator' ;
    rdfs:comment 'Flag indicating whether the safety issue recurred after the corrective action was implemented, suggesting the action may not have been fully effective.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryRequirement rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement' ;
    rdfs:comment 'Specific regulatory requirement, standard, or code that mandates or drives the corrective action (e.g., OSHA regulation, FHWA standard, MUTCD requirement).' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryCitation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Citation' ;
    rdfs:comment 'Specific citation or reference to the regulatory code, standard, or requirement (e.g., 29 CFR 1926.501, MUTCD Section 6E.01).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghspRelated rdf:type rdf:Property ;
    rdfs:label 'Ghsp Related' ;
    rdfs:comment 'Indicator of whether the corrective action is related to or coordinated with the Governors Highway Safety Program initiatives.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imapRelated rdf:type rdf:Property ;
    rdfs:label 'Imap Related' ;
    rdfs:comment 'Indicator of whether the corrective action is related to IMAP operations or incident management activities.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crashRelated rdf:type rdf:Property ;
    rdfs:label 'Crash Related' ;
    rdfs:comment 'Indicator of whether the corrective action is related to or resulted from crash data analysis or a specific crash incident.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crashReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Crash Reference Number' ;
    rdfs:comment 'Reference number of the crash incident that generated or is related to this corrective action, if applicable.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interimAction rdf:type rdf:Property ;
    rdfs:label 'Interim Action' ;
    rdfs:comment 'Indicator of whether this is an interim or temporary corrective action pending implementation of a permanent solution.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interimActionDescription rdf:type rdf:Property ;
    rdfs:label 'Interim Action Description' ;
    rdfs:comment 'Description of interim measures taken while the permanent corrective action is being planned or implemented.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permanentActionRequired rdf:type rdf:Property ;
    rdfs:label 'Permanent Action Required' ;
    rdfs:comment 'Indicator of whether a permanent corrective action is required following an interim action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpRequired rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required' ;
    rdfs:comment 'Indicator of whether follow-up monitoring or additional actions are required after initial implementation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Date' ;
    rdfs:comment 'Scheduled date for follow-up inspection or monitoring to assess ongoing effectiveness of the corrective action.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationSent rdf:type rdf:Property ;
    rdfs:label 'Notification Sent' ;
    rdfs:comment 'Indicator of whether formal notification was sent to the responsible party regarding the corrective action assignment.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signalId rdf:type rdf:Property ;
    rdfs:label 'Signal Id' ;
    rdfs:comment 'Unique identifier for the traffic signal controller. Primary key for the signal master record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Signal .

ind:controllerSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Controller Serial Number' ;
    rdfs:comment 'Manufacturer-assigned serial number for the traffic signal controller hardware unit.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controllerModel rdf:type rdf:Property ;
    rdfs:label 'Controller Model' ;
    rdfs:comment 'Model designation of the traffic signal controller hardware (e.g., Econolite ASC/3, McCain ATC, Siemens M50).' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmwareUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Firmware Update Date' ;
    rdfs:comment 'Date when the controller firmware was last updated or installed.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:communicationStatus rdf:type rdf:Property ;
    rdfs:label 'Communication Status' ;
    rdfs:comment 'Status of the communication link between the traffic signal controller and the Traffic Management Center (TMC) or Advanced Traffic Management System (ATMS).' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:macAddress rdf:type rdf:Property ;
    rdfs:label 'Mac Address' ;
    rdfs:comment 'Hardware MAC address of the network interface on the traffic signal controller.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intersectionName rdf:type rdf:Property ;
    rdfs:label 'Intersection Name' ;
    rdfs:comment 'Common name or description of the intersection where the traffic signal is located (e.g., \'Main St at Elm Ave\').' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossStreetName rdf:type rdf:Property ;
    rdfs:label 'Cross Street Name' ;
    rdfs:comment 'Name of the intersecting cross street at the signalized intersection.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timingPlanCount rdf:type rdf:Property ;
    rdfs:label 'Timing Plan Count' ;
    rdfs:comment 'Number of distinct timing plans programmed and available in the traffic signal controller for different traffic conditions (e.g., AM peak, PM peak, off-peak, weekend).' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeTimingPlanId rdf:type rdf:Property ;
    rdfs:label 'Active Timing Plan Id' ;
    rdfs:comment 'Identifier of the timing plan currently active and controlling the signal phasing and intervals.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:coordinationPatternId rdf:type rdf:Property ;
    rdfs:label 'Coordination Pattern Id' ;
    rdfs:comment 'Identifier for the coordination pattern used when the signal operates in coordinated mode with other signals along a corridor.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoordinationPattern .

ind:phaseCount rdf:type rdf:Property ;
    rdfs:label 'Phase Count' ;
    rdfs:comment 'Total number of signal phases configured in the controller (typically 2-8 phases depending on intersection complexity).' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pedestrianPhasesEnabled rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Phases Enabled' ;
    rdfs:comment 'Indicates whether pedestrian signal phases and walk intervals are configured and active at this intersection.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apsInstalled rdf:type rdf:Property ;
    rdfs:label 'Aps Installed' ;
    rdfs:comment 'Indicates whether Accessible Pedestrian Signals (audible and tactile devices) are installed to assist visually impaired pedestrians.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preemptionType rdf:type rdf:Property ;
    rdfs:label 'Preemption Type' ;
    rdfs:comment 'Type of preemption configured: none, emergency vehicle preemption (EVP), railroad preemption (RRP), or both.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitPriorityEnabled rdf:type rdf:Property ;
    rdfs:label 'Transit Priority Enabled' ;
    rdfs:comment 'Indicates whether Transit Signal Priority is enabled to provide preferential signal timing for public transit vehicles.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionType rdf:type rdf:Property ;
    rdfs:label 'Detection Type' ;
    rdfs:comment 'Type of vehicle detection technology used at the intersection (e.g., inductive loop, video detection, radar, microwave, or multiple technologies).' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionZoneCount rdf:type rdf:Property ;
    rdfs:label 'Detection Zone Count' ;
    rdfs:comment 'Number of vehicle detection zones configured at the intersection for actuated signal control.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cabinetType rdf:type rdf:Property ;
    rdfs:label 'Cabinet Type' ;
    rdfs:comment 'Type or model of the traffic signal cabinet housing the controller and associated equipment (e.g., NEMA TS-1, TS-2, Type 170, Type 2070).' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cabinetSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Cabinet Serial Number' ;
    rdfs:comment 'Serial number of the traffic signal cabinet housing the controller equipment.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upsInstalled rdf:type rdf:Property ;
    rdfs:label 'Ups Installed' ;
    rdfs:comment 'Indicates whether an uninterruptible power supply (UPS) or battery backup system is installed to maintain signal operation during power outages.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictMonitorModel rdf:type rdf:Property ;
    rdfs:label 'Conflict Monitor Model' ;
    rdfs:comment 'Model designation of the conflict monitor unit that detects unsafe signal display conflicts and places the signal in flash mode if conflicts occur.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malfunctionManagementUnitInstalled rdf:type rdf:Property ;
    rdfs:label 'Malfunction Management Unit Installed' ;
    rdfs:comment 'Indicates whether a Malfunction Management Unit is installed to monitor controller operation and log faults.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:atmsIntegrationEnabled rdf:type rdf:Property ;
    rdfs:label 'Atms Integration Enabled' ;
    rdfs:comment 'Indicates whether the signal controller is integrated with the NCDOT Advanced Traffic Management System for centralized monitoring and control.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tmcMonitored rdf:type rdf:Property ;
    rdfs:label 'Tmc Monitored' ;
    rdfs:comment 'Indicates whether the signal controller is actively monitored by the NCDOT Traffic Management Center.' ;
    rdfs:domain ind:Traffic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:videoDetectionCameraCount rdf:type rdf:Property ;
    rdfs:label 'Video Detection Camera Count' ;
    rdfs:comment 'Number of video detection cameras installed at the intersection for vehicle detection and traffic monitoring.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cctvCameraInstalled rdf:type rdf:Property ;
    rdfs:label 'Cctv Camera Installed' ;
    rdfs:comment 'Indicates whether a CCTV camera is installed at the intersection for traffic monitoring and incident detection by the TMC.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:headCount rdf:type rdf:Property ;
    rdfs:label 'Head Count' ;
    rdfs:comment 'Total number of signal heads (traffic signal displays) installed at the intersection.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ledConversionComplete rdf:type rdf:Property ;
    rdfs:label 'Led Conversion Complete' ;
    rdfs:comment 'Indicates whether all signal heads at the intersection have been converted from incandescent to LED technology.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetConditionRating rdf:type rdf:Property ;
    rdfs:label 'Asset Condition Rating' ;
    rdfs:comment 'Overall condition assessment of the traffic signal controller and associated equipment based on inspection and maintenance records.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementPriorityScore rdf:type rdf:Property ;
    rdfs:label 'Replacement Priority Score' ;
    rdfs:comment 'Calculated priority score for controller replacement based on age, condition, technology obsolescence, and operational criticality.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualAverageDailyTraffic rdf:type rdf:Property ;
    rdfs:label 'Annual Average Daily Traffic' ;
    rdfs:comment 'Annual Average Daily Traffic volume passing through the signalized intersection, used for capacity analysis and signal timing optimization.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:functionalClassification rdf:type rdf:Property ;
    rdfs:label 'Functional Classification' ;
    rdfs:comment 'FHWA functional classification of the primary roadway at the signalized intersection.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nhsDesignation rdf:type rdf:Property ;
    rdfs:label 'Nhs Designation' ;
    rdfs:comment 'Indicates whether the intersection is located on a roadway designated as part of the National Highway System.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashHistory3yrCount rdf:type rdf:Property ;
    rdfs:label 'Crash History 3yr Count' ;
    rdfs:comment 'Total number of reported traffic crashes at the intersection over the most recent 3-year period.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastTimingStudyDate rdf:type rdf:Property ;
    rdfs:label 'Last Timing Study Date' ;
    rdfs:comment 'Date when the most recent traffic signal timing study was conducted to optimize signal operations.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextTimingStudyDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Timing Study Due Date' ;
    rdfs:comment 'Scheduled date for the next traffic signal timing study based on NCDOT policy and operational changes.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:installationCostAmount rdf:type rdf:Property ;
    rdfs:label 'Installation Cost Amount' ;
    rdfs:comment 'Total cost in US dollars for the installation of the traffic signal controller and associated infrastructure.' ;
    rdfs:domain ind:Signal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualMaintenanceCostAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Maintenance Cost Amount' ;
    rdfs:comment 'Estimated or actual annual maintenance cost in US dollars for the traffic signal controller and equipment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crashReportId rdf:type rdf:Property ;
    rdfs:label 'Crash Report Id' ;
    rdfs:comment 'Unique identifier for each crash report record in the system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CrashReport .

ind:crashNumber rdf:type rdf:Property ;
    rdfs:label 'Crash Number' ;
    rdfs:comment 'Official crash report number assigned by law enforcement or NCDOT for tracking and reference purposes.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashDate rdf:type rdf:Property ;
    rdfs:label 'Crash Date' ;
    rdfs:comment 'The date on which the crash occurred.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:crashTime rdf:type rdf:Property ;
    rdfs:label 'Crash Time' ;
    rdfs:comment 'The time of day when the crash occurred, in 24-hour format.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashTimestamp rdf:type rdf:Property ;
    rdfs:label 'Crash Timestamp' ;
    rdfs:comment 'Precise timestamp combining date and time when the crash occurred.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:crashSeverity rdf:type rdf:Property ;
    rdfs:label 'Crash Severity' ;
    rdfs:comment 'Classification of crash severity based on the most severe injury sustained by any person involved.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fatalityCount rdf:type rdf:Property ;
    rdfs:label 'Fatality Count' ;
    rdfs:comment 'Total number of fatalities resulting from the crash.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:injuryCount rdf:type rdf:Property ;
    rdfs:label 'Injury Count' ;
    rdfs:comment 'Total number of persons injured in the crash, regardless of injury severity.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:personCount rdf:type rdf:Property ;
    rdfs:label 'Person Count' ;
    rdfs:comment 'Total number of persons involved in the crash, including drivers, passengers, pedestrians, and cyclists.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crashType rdf:type rdf:Property ;
    rdfs:label 'Crash Type' ;
    rdfs:comment 'General classification of the crash based on the entities involved.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collisionType rdf:type rdf:Property ;
    rdfs:label 'Collision Type' ;
    rdfs:comment 'Manner of collision describing how vehicles came into contact.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstHarmfulEvent rdf:type rdf:Property ;
    rdfs:label 'First Harmful Event' ;
    rdfs:comment 'The first injury or damage-producing event of the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mostHarmfulEvent rdf:type rdf:Property ;
    rdfs:label 'Most Harmful Event' ;
    rdfs:comment 'The event that resulted in the most severe injury or, if no injury, the greatest property damage.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mannerOfCollision rdf:type rdf:Property ;
    rdfs:label 'Manner Of Collision' ;
    rdfs:comment 'Describes the orientation of vehicles and the direction of force at the moment of impact.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cityName rdf:type rdf:Property ;
    rdfs:label 'City Name' ;
    rdfs:comment 'Name of the city or municipality where the crash occurred, if applicable.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intersectionType rdf:type rdf:Property ;
    rdfs:label 'Intersection Type' ;
    rdfs:comment 'Type of intersection where the crash occurred, if applicable.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceFromIntersection rdf:type rdf:Property ;
    rdfs:label 'Distance From Intersection' ;
    rdfs:comment 'Distance in feet from the nearest intersection to the crash location.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trafficControlDevice rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Device' ;
    rdfs:comment 'Type of traffic control device present at the crash location.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficControlFunctioning rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Functioning' ;
    rdfs:comment 'Operational status of the traffic control device at the time of the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadwayAlignment rdf:type rdf:Property ;
    rdfs:label 'Roadway Alignment' ;
    rdfs:comment 'Horizontal alignment of the roadway at the crash location.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadwayGrade rdf:type rdf:Property ;
    rdfs:label 'Roadway Grade' ;
    rdfs:comment 'Vertical grade or slope of the roadway at the crash location.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadwaySurfaceType rdf:type rdf:Property ;
    rdfs:label 'Roadway Surface Type' ;
    rdfs:comment 'Type of material comprising the roadway surface at the crash location.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadwaySurfaceCondition rdf:type rdf:Property ;
    rdfs:label 'Roadway Surface Condition' ;
    rdfs:comment 'Condition of the roadway surface at the time of the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadwayCharacter rdf:type rdf:Property ;
    rdfs:label 'Roadway Character' ;
    rdfs:comment 'Physical character of the roadway describing traffic flow direction and separation.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laneOfCrash rdf:type rdf:Property ;
    rdfs:label 'Lane Of Crash' ;
    rdfs:comment 'Specific lane where the crash occurred or initiated.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lightCondition rdf:type rdf:Property ;
    rdfs:label 'Light Condition' ;
    rdfs:comment 'Ambient light conditions at the time of the crash.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railroadCrossingIndicator rdf:type rdf:Property ;
    rdfs:label 'Railroad Crossing Indicator' ;
    rdfs:comment 'Indicates whether the crash occurred at or near a railroad crossing.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bridgeIndicator rdf:type rdf:Property ;
    rdfs:label 'Bridge Indicator' ;
    rdfs:comment 'Indicates whether the crash occurred on a bridge structure.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tunnelIndicator rdf:type rdf:Property ;
    rdfs:label 'Tunnel Indicator' ;
    rdfs:comment 'Indicates whether the crash occurred within a tunnel.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contributingFactorPrimary rdf:type rdf:Property ;
    rdfs:label 'Contributing Factor Primary' ;
    rdfs:comment 'The primary factor that contributed to the crash occurrence.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributingFactorSecondary rdf:type rdf:Property ;
    rdfs:label 'Contributing Factor Secondary' ;
    rdfs:comment 'Additional contributing factor that played a role in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverDistractionIndicator rdf:type rdf:Property ;
    rdfs:label 'Driver Distraction Indicator' ;
    rdfs:comment 'Indicates whether driver distraction was a contributing factor in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alcoholInvolvedIndicator rdf:type rdf:Property ;
    rdfs:label 'Alcohol Involved Indicator' ;
    rdfs:comment 'Indicates whether alcohol use by any person was a contributing factor in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drugInvolvedIndicator rdf:type rdf:Property ;
    rdfs:label 'Drug Involved Indicator' ;
    rdfs:comment 'Indicates whether drug use by any person was a contributing factor in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:speedingIndicator rdf:type rdf:Property ;
    rdfs:label 'Speeding Indicator' ;
    rdfs:comment 'Indicates whether speeding was a contributing factor in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aggressiveDrivingIndicator rdf:type rdf:Property ;
    rdfs:label 'Aggressive Driving Indicator' ;
    rdfs:comment 'Indicates whether aggressive driving behavior was a contributing factor in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hitAndRunIndicator rdf:type rdf:Property ;
    rdfs:label 'Hit And Run Indicator' ;
    rdfs:comment 'Indicates whether the crash involved a hit-and-run where a driver left the scene.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialVehicleIndicator rdf:type rdf:Property ;
    rdfs:label 'Commercial Vehicle Indicator' ;
    rdfs:comment 'Indicates whether a commercial motor vehicle was involved in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyVehicleIndicator rdf:type rdf:Property ;
    rdfs:label 'Emergency Vehicle Indicator' ;
    rdfs:comment 'Indicates whether an emergency vehicle was involved in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pedestrianInvolvedIndicator rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Involved Indicator' ;
    rdfs:comment 'Indicates whether a pedestrian was involved in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bicycleInvolvedIndicator rdf:type rdf:Property ;
    rdfs:label 'Bicycle Involved Indicator' ;
    rdfs:comment 'Indicates whether a bicycle was involved in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:motorcycleInvolvedIndicator rdf:type rdf:Property ;
    rdfs:label 'Motorcycle Involved Indicator' ;
    rdfs:comment 'Indicates whether a motorcycle was involved in the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingAgency rdf:type rdf:Property ;
    rdfs:label 'Reporting Agency' ;
    rdfs:comment 'Name of the law enforcement agency that investigated and reported the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingOfficerBadge rdf:type rdf:Property ;
    rdfs:label 'Reporting Officer Badge' ;
    rdfs:comment 'Badge or identification number of the law enforcement officer who completed the crash report.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Date when the crash report was officially filed or completed.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Timestamp' ;
    rdfs:comment 'Precise timestamp when the crash report was filed in the system.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:narrative rdf:type rdf:Property ;
    rdfs:label 'Narrative' ;
    rdfs:comment 'Detailed narrative description of the crash circumstances, sequence of events, and findings from the investigating officer.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagramAvailableIndicator rdf:type rdf:Property ;
    rdfs:label 'Diagram Available Indicator' ;
    rdfs:comment 'Indicates whether a crash diagram or sketch is available for this report.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:photosAvailableIndicator rdf:type rdf:Property ;
    rdfs:label 'Photos Available Indicator' ;
    rdfs:comment 'Indicates whether photographs of the crash scene are available.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedPropertyDamage rdf:type rdf:Property ;
    rdfs:label 'Estimated Property Damage' ;
    rdfs:comment 'Estimated total property damage in US dollars resulting from the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:towedVehicleCount rdf:type rdf:Property ;
    rdfs:label 'Towed Vehicle Count' ;
    rdfs:comment 'Number of vehicles that required towing from the crash scene.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roadClosureIndicator rdf:type rdf:Property ;
    rdfs:label 'Road Closure Indicator' ;
    rdfs:comment 'Indicates whether the crash resulted in a temporary road closure.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roadClosureDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Road Closure Duration Minutes' ;
    rdfs:comment 'Duration in minutes that the roadway was closed due to the crash.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:imapResponseIndicator rdf:type rdf:Property ;
    rdfs:label 'Imap Response Indicator' ;
    rdfs:comment 'Indicates whether NCDOT IMAP units responded to the crash scene.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hsipEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Hsip Eligible Indicator' ;
    rdfs:comment 'Indicates whether the crash location or characteristics make it eligible for HSIP funding consideration.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crashLocationVerifiedIndicator rdf:type rdf:Property ;
    rdfs:label 'Crash Location Verified Indicator' ;
    rdfs:comment 'Indicates whether the crash location coordinates have been verified and geocoded accurately.' ;
    rdfs:domain ind:CrashReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertId rdf:type rdf:Property ;
    rdfs:label 'Alert Id' ;
    rdfs:comment 'Unique identifier for each traffic alert record generated by the Traffic Management Center (TMC) or Advanced Traffic Management System (ATMS).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Alert .

ind:expectedDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Expected Duration Minutes' ;
    rdfs:comment 'Estimated duration in minutes that the traffic alert condition is expected to persist, used for traveler information.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Current Speed Mph' ;
    rdfs:comment 'Current average traffic speed in miles per hour on the affected segment during the alert, measured by ITS sensors or probe data.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Indicates whether the traffic alert has been confirmed by TMC operators or field personnel versus automated or unverified reports.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishedToMobileApp rdf:type rdf:Property ;
    rdfs:label 'Published To Mobile App' ;
    rdfs:comment 'Flag indicating whether the alert has been disseminated to the public via NCDOT mobile applications.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publishedToWebPortal rdf:type rdf:Property ;
    rdfs:label 'Published To Web Portal' ;
    rdfs:comment 'Flag indicating whether the alert has been published to NCDOT public web portals and traveler information websites.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publishedToDms rdf:type rdf:Property ;
    rdfs:label 'Published To Dms' ;
    rdfs:comment 'Flag indicating whether the alert has been displayed on roadside Dynamic Message Signs (DMS) for real-time traveler notification.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dmsMessageText rdf:type rdf:Property ;
    rdfs:label 'Dms Message Text' ;
    rdfs:comment 'Abbreviated message text displayed on Dynamic Message Signs, formatted according to MUTCD character and line limitations.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishedTo511 rdf:type rdf:Property ;
    rdfs:label 'Published To 511' ;
    rdfs:comment 'Flag indicating whether the alert has been disseminated through the NC 511 telephone and web-based traveler information system.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Number' ;
    rdfs:comment 'Unique incident tracking number assigned by TMC or law enforcement for cross-system reference and reporting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roadSurfaceCondition rdf:type rdf:Property ;
    rdfs:label 'Road Surface Condition' ;
    rdfs:comment 'Condition of the road surface at the alert location affecting vehicle traction and safety.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detourRoute rdf:type rdf:Property ;
    rdfs:label 'Detour Route' ;
    rdfs:comment 'Description of the recommended detour route for motorists to avoid the traffic alert location.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceMethod rdf:type rdf:Property ;
    rdfs:label 'Clearance Method' ;
    rdfs:comment 'Method or resource used to clear the incident and restore normal traffic flow.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantProgramId rdf:type rdf:Property ;
    rdfs:label 'Grant Program Id' ;
    rdfs:comment 'Unique identifier for the grant program record. Primary key for the program entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GrantProgram .

ind:federalAgency rdf:type rdf:Property ;
    rdfs:label 'Federal Agency' ;
    rdfs:comment 'Federal agency administering the grant program. Includes Federal Highway Administration (FHWA), Federal Transit Administration (FTA), Federal Aviation Administration (FAA), Federal Railroad Administration (FRA), National Highway Traffic Safety Administration (NHTSA), or United States Department of Transportation (USDOT).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cfdaNumber rdf:type rdf:Property ;
    rdfs:label 'Cfda Number' ;
    rdfs:comment 'Five-digit Catalog of Federal Domestic Assistance number assigned to federal grant programs for tracking and reporting purposes. Format: XX.XXX.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statutoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Statutory Authority' ;
    rdfs:comment 'Legal citation of the federal or state statute that authorizes the grant program, including public law number, USC citation, or state general statute reference.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizingLegislation rdf:type rdf:Property ;
    rdfs:label 'Authorizing Legislation' ;
    rdfs:comment 'Name and citation of the federal or state legislation that created or most recently reauthorized the grant program (e.g., Infrastructure Investment and Jobs Act, FAST Act, MAP-21).' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleApplicants rdf:type rdf:Property ;
    rdfs:label 'Eligible Applicants' ;
    rdfs:comment 'Types of organizations or entities eligible to apply for grants under this program (e.g., state DOTs, MPOs, RPOs, local governments, transit agencies, private entities).' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleActivities rdf:type rdf:Property ;
    rdfs:label 'Eligible Activities' ;
    rdfs:comment 'Types of transportation projects, activities, or expenditures that can be funded under this grant program (e.g., construction, planning, design, right-of-way acquisition, equipment purchase).' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchRequirementPercentage rdf:type rdf:Property ;
    rdfs:label 'Match Requirement Percentage' ;
    rdfs:comment 'Percentage of non-federal or local matching funds required for projects funded under this program. Expressed as a percentage (e.g., 20.00 for 20% match).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetAuthority rdf:type rdf:Property ;
    rdfs:label 'Budget Authority' ;
    rdfs:comment 'Total budget authority or appropriation allocated to this grant program for the current fiscal year, expressed in US dollars.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalProgramFunding rdf:type rdf:Property ;
    rdfs:label 'Total Program Funding' ;
    rdfs:comment 'Total funding available under this grant program across all fiscal years, including multi-year authorizations, expressed in US dollars.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualAllocation rdf:type rdf:Property ;
    rdfs:label 'Annual Allocation' ;
    rdfs:comment 'Annual funding allocation for this grant program in the current fiscal year, expressed in US dollars.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAwardAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Award Amount' ;
    rdfs:comment 'Minimum grant award amount that can be requested or awarded under this program, expressed in US dollars.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumAwardAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Award Amount' ;
    rdfs:comment 'Maximum grant award amount that can be requested or awarded to a single project or applicant under this program, expressed in US dollars.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicationCycle rdf:type rdf:Property ;
    rdfs:label 'Application Cycle' ;
    rdfs:comment 'Frequency with which the grant program accepts applications (annual, biennial, quarterly, continuous rolling basis, one-time, or as-needed).' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDeadline rdf:type rdf:Property ;
    rdfs:label 'Application Deadline' ;
    rdfs:comment 'Deadline date for submitting grant applications for the current funding cycle, in format yyyy-MM-dd.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:awardNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Award Notification Date' ;
    rdfs:comment 'Expected or actual date when grant award decisions will be announced to applicants, in format yyyy-MM-dd.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reauthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Reauthorization Date' ;
    rdfs:comment 'Date when the grant program was most recently reauthorized by legislation, in format yyyy-MM-dd.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:administeringDivision rdf:type rdf:Property ;
    rdfs:label 'Administering Division' ;
    rdfs:comment 'NCDOT division or unit responsible for administering this grant program (e.g., Division of Highways, Division of Public Transportation, Division of Aviation).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administeringUnit rdf:type rdf:Property ;
    rdfs:label 'Administering Unit' ;
    rdfs:comment 'Specific organizational unit or section within NCDOT responsible for day-to-day administration of this grant program.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationPortalUrl rdf:type rdf:Property ;
    rdfs:label 'Application Portal Url' ;
    rdfs:comment 'Web address of the online application portal or system where grant applications are submitted.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingRequirements rdf:type rdf:Property ;
    rdfs:label 'Reporting Requirements' ;
    rdfs:comment 'Description of the periodic reporting requirements for grant recipients, including frequency, format, and content of progress reports, financial reports, and performance metrics.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency' ;
    rdfs:comment 'Frequency with which grant recipients must submit progress and financial reports (monthly, quarterly, semi-annual, annual, as-needed, or milestone-based).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditRequirements rdf:type rdf:Property ;
    rdfs:label 'Audit Requirements' ;
    rdfs:comment 'Description of audit requirements applicable to grant recipients under this program, including single audit thresholds and compliance requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:singleAuditThreshold rdf:type rdf:Property ;
    rdfs:label 'Single Audit Threshold' ;
    rdfs:comment 'Dollar threshold of federal expenditures that triggers single audit requirements under OMB Uniform Guidance, expressed in US dollars.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indirectCostRateAllowed rdf:type rdf:Property ;
    rdfs:label 'Indirect Cost Rate Allowed' ;
    rdfs:comment 'Indicates whether grant recipients are permitted to charge indirect costs to projects funded under this program.' ;
    rdfs:domain ind:GrantProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indirectCostRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Indirect Cost Rate Percentage' ;
    rdfs:comment 'Maximum allowable indirect cost rate that can be charged to projects under this program, expressed as a percentage.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
