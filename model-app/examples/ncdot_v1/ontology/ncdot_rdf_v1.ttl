ind:vendorInvoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Invoice Number' ;
    rdfs:comment 'Invoice number as assigned by the vendor on their original invoice document.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remitToVendorNumber rdf:type rdf:Property ;
    rdfs:label 'Remit To Vendor Number' ;
    rdfs:comment 'Vendor number for the remittance location if different from the ordering vendor.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineCount rdf:type rdf:Property ;
    rdfs:label 'Line Count' ;
    rdfs:comment 'Total number of line items included in the invoice.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recurringInvoiceFlag rdf:type rdf:Property ;
    rdfs:label 'Recurring Invoice Flag' ;
    rdfs:comment 'Indicator of whether this is a recurring invoice (e.g., monthly service fees).' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurringFrequency rdf:type rdf:Property ;
    rdfs:label 'Recurring Frequency' ;
    rdfs:comment 'Frequency at which the invoice recurs if it is a recurring invoice.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prepaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Prepayment Flag' ;
    rdfs:comment 'Indicator of whether this invoice represents a prepayment or advance payment.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:finalInvoiceFlag rdf:type rdf:Property ;
    rdfs:label 'Final Invoice Flag' ;
    rdfs:comment 'Indicator of whether this is the final invoice for a contract or project.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Batch Number' ;
    rdfs:comment 'Identifier of the payment batch in which this invoice payment was processed.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Date' ;
    rdfs:comment 'Date from which payment terms are calculated (typically invoice date or receipt date).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withholdingTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Amount' ;
    rdfs:comment 'Amount of tax withheld from vendor payment as required by tax regulations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdingTaxCode rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Code' ;
    rdfs:comment 'Code identifying the type of withholding tax applied.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentBlockCode rdf:type rdf:Property ;
    rdfs:label 'Payment Block Code' ;
    rdfs:comment 'Code indicating a payment block or hold preventing payment processing.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earlyPaymentDiscountTaken rdf:type rdf:Property ;
    rdfs:label 'Early Payment Discount Taken' ;
    rdfs:comment 'Dollar amount of early payment discount actually taken on this invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Financial Period Id' ;
    rdfs:comment 'Unique identifier for the financial period record. Primary key for the financial period reference table.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:periodCode rdf:type rdf:Property ;
    rdfs:label 'Period Code' ;
    rdfs:comment 'Short alphanumeric code representing the financial period, used for system integration and reporting (e.g., P01, P02, Q1, FY2024).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Full descriptive name of the financial period (e.g., \'January 2024\', \'Q1 FY2024\', \'Period 01 - July 2023\').' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Classification of the period granularity: monthly, quarterly, annual, semi-annual, or biennial reporting period.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calendarYear rdf:type rdf:Property ;
    rdfs:label 'Calendar Year' ;
    rdfs:comment 'Four-digit calendar year associated with the period for cross-reference to calendar-based reporting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodNumber rdf:type rdf:Property ;
    rdfs:label 'Period Number' ;
    rdfs:comment 'Sequential period number within the fiscal year (1-12 for monthly periods, 1-4 for quarterly periods).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quarterNumber rdf:type rdf:Property ;
    rdfs:label 'Quarter Number' ;
    rdfs:comment 'Fiscal quarter number (1-4) to which this period belongs within the fiscal year.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfDays rdf:type rdf:Property ;
    rdfs:label 'Number Of Days' ;
    rdfs:comment 'Total number of calendar days in the financial period (typically 28-31 for monthly, 90-92 for quarterly, 365-366 for annual).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isAdjustmentPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Adjustment Period' ;
    rdfs:comment 'Indicates whether this is a special adjustment period (typically Period 13 or 14) used for year-end adjustments and accruals after the regular fiscal year closes.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCurrentPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Current Period' ;
    rdfs:comment 'Flag indicating whether this is the currently active financial period for transaction posting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:periodOpenDate rdf:type rdf:Property ;
    rdfs:label 'Period Open Date' ;
    rdfs:comment 'Date when the financial period was opened for transaction posting. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodCloseDate rdf:type rdf:Property ;
    rdfs:label 'Period Close Date' ;
    rdfs:comment 'Date when the financial period was officially closed and locked for further posting. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closeDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Close Deadline Date' ;
    rdfs:comment 'Target deadline date by which the period close process must be completed per organizational policy. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Date' ;
    rdfs:comment 'Date by which financial reports for this period must be submitted to governing bodies (e.g., NC Legislature, FHWA, FTA). Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for budget planning and allocation processes.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Flag' ;
    rdfs:comment 'Indicates whether this period requires formal financial reporting to external stakeholders (legislature, federal agencies).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearEndFlag rdf:type rdf:Property ;
    rdfs:label 'Year End Flag' ;
    rdfs:comment 'Indicates whether this is the final period of the fiscal year requiring year-end close procedures.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sapPostingPeriod rdf:type rdf:Property ;
    rdfs:label 'Sap Posting Period' ;
    rdfs:comment 'SAP FI/CO posting period number (01-12 for regular periods, 13-16 for special/adjustment periods) used for transaction posting control.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncfsPeriodCode rdf:type rdf:Property ;
    rdfs:label 'Ncfs Period Code' ;
    rdfs:comment 'Period code used in the NC Financial System for state-level financial reporting and integration.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Federal Reporting Period' ;
    rdfs:comment 'Period designation used for federal grant reporting to FHWA, FTA, FAA, and other federal agencies.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasbReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Gasb Reporting Category' ;
    rdfs:comment 'GASB reporting category classification for this period (annual comprehensive financial report, interim report, or quarterly report).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Stip Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for STIP financial planning and project funding allocation.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grantReportingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Grant Reporting Period Flag' ;
    rdfs:comment 'Indicates whether this period requires federal grant financial reporting (e.g., HSIP, CMAQ, STP, BUILD, INFRA, RAISE).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accountsReceivableInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Accounts Receivable Invoice Id' ;
    rdfs:comment 'Unique identifier for the accounts receivable invoice record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccountsReceivableInvoice .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Classification of the invoice based on the nature of the receivable (e.g., inter-agency billing, service fees, permit fees).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Customer Account Number' ;
    rdfs:comment 'Unique account number assigned to the customer or inter-agency entity in the financial system.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Customer Address Line 1' ;
    rdfs:comment 'First line of the customer billing address.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Customer Address Line 2' ;
    rdfs:comment 'Second line of the customer billing address (suite, building, etc.).' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerCity rdf:type rdf:Property ;
    rdfs:label 'Customer City' ;
    rdfs:comment 'City of the customer billing address.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerState rdf:type rdf:Property ;
    rdfs:label 'Customer State' ;
    rdfs:comment 'State or province of the customer billing address (two-letter code).' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerPostalCode rdf:type rdf:Property ;
    rdfs:label 'Customer Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the customer billing address.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerCountryCode rdf:type rdf:Property ;
    rdfs:label 'Customer Country Code' ;
    rdfs:comment 'Three-letter ISO country code of the customer billing address.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Invoice Amount' ;
    rdfs:comment 'Total amount billed on the invoice before any adjustments or payments.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'Remaining unpaid balance on the invoice as of the current date.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceDescription rdf:type rdf:Property ;
    rdfs:label 'Service Description' ;
    rdfs:comment 'Detailed description of the services, goods, or fees being billed on the invoice.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingDivision rdf:type rdf:Property ;
    rdfs:label 'Billing Division' ;
    rdfs:comment 'NCDOT division or department responsible for issuing the invoice (e.g., Division of Highways, Division of Motor Vehicles).' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactName rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Name' ;
    rdfs:comment 'Name of the NCDOT staff member or contact responsible for the billing.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactEmail rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Email' ;
    rdfs:comment 'Email address of the NCDOT billing contact for inquiries or disputes.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactPhone rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Phone' ;
    rdfs:comment 'Phone number of the NCDOT billing contact for inquiries or disputes.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Document Number' ;
    rdfs:comment 'Reference number of the source document (e.g., purchase order, contract, permit) that generated the receivable.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceDocumentType rdf:type rdf:Property ;
    rdfs:label 'Reference Document Type' ;
    rdfs:comment 'Type of the source document that generated the receivable (e.g., purchase order, contract, permit).' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date of the most recent payment received against this invoice.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'Amount of the most recent payment received against this invoice.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'Number of days the invoice is overdue based on the due date and current date.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agingCategory rdf:type rdf:Property ;
    rdfs:label 'Aging Category' ;
    rdfs:comment 'Aging bucket classification for the receivable based on days past due (e.g., current, 1-30 days, 31-60 days).' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'Date when the receivable was written off as uncollectible, if applicable.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Amount written off as uncollectible, if applicable.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Reason or justification for writing off the receivable as uncollectible.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Date' ;
    rdfs:comment 'Date when the adjustment was applied to the invoice.' ;
    rdfs:domain ind:AccountsReceivableInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetLineId rdf:type rdf:Property ;
    rdfs:label 'Budget Line Id' ;
    rdfs:comment 'Unique identifier for the budget line item. Primary key for the budget line entity.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number within a budget document or allocation, used for ordering and reference purposes.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundName rdf:type rdf:Property ;
    rdfs:label 'Fund Name' ;
    rdfs:comment 'Descriptive name of the fund associated with this budget line.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountName rdf:type rdf:Property ;
    rdfs:label 'Account Name' ;
    rdfs:comment 'Descriptive name of the general ledger account associated with this budget line.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountCategory rdf:type rdf:Property ;
    rdfs:label 'Account Category' ;
    rdfs:comment 'High-level classification of the general ledger account (Asset, Liability, Equity, Revenue, Expense).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAreaCode rdf:type rdf:Property ;
    rdfs:label 'Functional Area Code' ;
    rdfs:comment 'Code representing the functional area or business segment (e.g., Highway Operations, DMV, Ferry Operations) to which this budget line applies.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAreaName rdf:type rdf:Property ;
    rdfs:label 'Functional Area Name' ;
    rdfs:comment 'Descriptive name of the functional area associated with this budget line.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetType rdf:type rdf:Property ;
    rdfs:label 'Budget Type' ;
    rdfs:comment 'Classification of the budget line by type (Operating, Capital, Grant, Federal, State, Local, Other).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Category' ;
    rdfs:comment 'Expenditure category classification for this budget line (e.g., Personnel, Equipment, Supplies, Contractual Services).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetSubcategory rdf:type rdf:Property ;
    rdfs:label 'Budget Subcategory' ;
    rdfs:comment 'More detailed subcategory within the budget category for granular expense tracking.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Original Budget Amount' ;
    rdfs:comment 'The initial budget amount allocated to this line item at the beginning of the fiscal year or budget period.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Budget Amount' ;
    rdfs:comment 'The current revised budget amount after adjustments, transfers, or amendments. This is the active budget amount.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:encumbranceAmount rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Amount' ;
    rdfs:comment 'The amount of budget committed through purchase orders, contracts, or other obligations but not yet expended.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Expenditure Amount' ;
    rdfs:comment 'The actual amount expended against this budget line to date.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Available Balance Amount' ;
    rdfs:comment 'The remaining budget balance available for expenditure, calculated as revised budget minus encumbrances minus actual expenditures.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetVersion rdf:type rdf:Property ;
    rdfs:label 'Budget Version' ;
    rdfs:comment 'Version identifier for the budget (e.g., Original, Revised, Final) to track budget iterations and amendments.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Status' ;
    rdfs:comment 'Current status of the budget line in the budget lifecycle (Draft, Submitted, Approved, Active, Closed, Cancelled).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalFundingIndicator rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Indicator' ;
    rdfs:comment 'Indicates whether this budget line includes federal funding sources (true) or not (false).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Federal Agency Code' ;
    rdfs:comment 'Code identifying the federal agency providing funding (e.g., FHWA, FTA, FAA, FRA) if federal funding is involved.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tipProjectIndicator rdf:type rdf:Property ;
    rdfs:label 'Tip Project Indicator' ;
    rdfs:comment 'Indicates whether this budget line is associated with a project in a regional Transportation Improvement Program (TIP).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:districtName rdf:type rdf:Property ;
    rdfs:label 'District Name' ;
    rdfs:comment 'Name of the NCDOT highway district associated with this budget line.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Date' ;
    rdfs:comment 'The date when this budget line was allocated or created. Format: yyyy-MM-dd' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetJustification rdf:type rdf:Property ;
    rdfs:label 'Budget Justification' ;
    rdfs:comment 'Detailed justification or rationale for this budget line allocation, explaining the business need and expected outcomes.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carryoverIndicator rdf:type rdf:Property ;
    rdfs:label 'Carryover Indicator' ;
    rdfs:comment 'Indicates whether this budget line includes carryover funds from a previous fiscal year (true) or not (false).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carryoverAmount rdf:type rdf:Property ;
    rdfs:label 'Carryover Amount' ;
    rdfs:comment 'The dollar amount of budget carried over from the previous fiscal year, if applicable.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reimbursableIndicator rdf:type rdf:Property ;
    rdfs:label 'Reimbursable Indicator' ;
    rdfs:comment 'Indicates whether expenditures on this budget line are eligible for reimbursement from external sources (true) or not (false).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitalOutlayIndicator rdf:type rdf:Property ;
    rdfs:label 'Capital Outlay Indicator' ;
    rdfs:comment 'Indicates whether this budget line represents capital outlay expenditures (true) or operating expenditures (false).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multiYearIndicator rdf:type rdf:Property ;
    rdfs:label 'Multi Year Indicator' ;
    rdfs:comment 'Indicates whether this budget line spans multiple fiscal years (true) or is limited to a single fiscal year (false).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contingencyIndicator rdf:type rdf:Property ;
    rdfs:label 'Contingency Indicator' ;
    rdfs:comment 'Indicates whether this budget line represents contingency or reserve funds (true) or regular budget allocation (false).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Source Document Reference' ;
    rdfs:comment 'Reference to the source document or transaction in the originating system (e.g., SAP document number).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Id' ;
    rdfs:comment 'Unique identifier for the budget record. Primary key for the finance budget entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:totalAppropriationAmount rdf:type rdf:Property ;
    rdfs:label 'Total Appropriation Amount' ;
    rdfs:comment 'Total authorized budget appropriation amount for the fiscal year, representing the maximum amount that can be obligated and expended.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Total Revenue Amount' ;
    rdfs:comment 'Total projected or budgeted revenue amount for the fiscal year, including all funding sources.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Total Expenditure Amount' ;
    rdfs:comment 'Total budgeted expenditure amount for the fiscal year across all programs and cost centers.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterName rdf:type rdf:Property ;
    rdfs:label 'Cost Center Name' ;
    rdfs:comment 'Descriptive name of the SAP cost center.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantProgramName rdf:type rdf:Property ;
    rdfs:label 'Grant Program Name' ;
    rdfs:comment 'Name of the grant program funding this budget (e.g., \'Highway Safety Improvement Program (HSIP)\', \'Congestion Mitigation and Air Quality (CMAQ)\', \'Surface Transportation Program (STP)\').' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'Start date of the budget period, typically the first day of the fiscal year (e.g., 2024-07-01 for SFY, 2023-10-01 for FFY).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'End date of the budget period, typically the last day of the fiscal year (e.g., 2025-06-30 for SFY, 2024-09-30 for FFY).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amendmentDate rdf:type rdf:Property ;
    rdfs:label 'Amendment Date' ;
    rdfs:comment 'Date of the most recent budget amendment, if applicable.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amendmentReason rdf:type rdf:Property ;
    rdfs:label 'Amendment Reason' ;
    rdfs:comment 'Description of the reason for the budget amendment (e.g., \'Additional federal grant awarded\', \'Emergency response funding\', \'Program reallocation\').' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personnelCostAmount rdf:type rdf:Property ;
    rdfs:label 'Personnel Cost Amount' ;
    rdfs:comment 'Budgeted amount allocated for personnel costs including salaries, wages, and benefits.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingCostAmount rdf:type rdf:Property ;
    rdfs:label 'Operating Cost Amount' ;
    rdfs:comment 'Budgeted amount allocated for operating expenses such as supplies, utilities, maintenance, and services.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalOutlayAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Outlay Amount' ;
    rdfs:comment 'Budgeted amount allocated for capital expenditures including infrastructure, equipment, and facilities.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debtServiceAmount rdf:type rdf:Property ;
    rdfs:label 'Debt Service Amount' ;
    rdfs:comment 'Budgeted amount allocated for debt service payments including principal and interest on bonds and loans (e.g., GARVEE bonds).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyAmount rdf:type rdf:Property ;
    rdfs:label 'Contingency Amount' ;
    rdfs:comment 'Budgeted contingency or reserve amount set aside for unforeseen expenses or emergencies.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stipReference rdf:type rdf:Property ;
    rdfs:label 'Stip Reference' ;
    rdfs:comment 'Reference to the State Transportation Improvement Program (STIP) document or project identifier if this budget is tied to STIP projects.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tipReference rdf:type rdf:Property ;
    rdfs:label 'Tip Reference' ;
    rdfs:comment 'Reference to the Transportation Improvement Program (TIP) document or project identifier if this budget is tied to TIP projects managed by MPO or RPO.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectCode rdf:type rdf:Property ;
    rdfs:label 'Object Code' ;
    rdfs:comment 'Governmental accounting object code classifying the nature of the expenditure (e.g., salaries, supplies, equipment, contractual services).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectCodeDescription rdf:type rdf:Property ;
    rdfs:label 'Object Code Description' ;
    rdfs:comment 'Description of the object code classification.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manager rdf:type rdf:Property ;
    rdfs:label 'Manager' ;
    rdfs:comment 'Name or identifier of the budget manager responsible for day-to-day budget monitoring and reporting.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiYearFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Year Flag' ;
    rdfs:comment 'Indicates whether this budget spans multiple fiscal years (true) or is for a single fiscal year (false).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multiYearStartYear rdf:type rdf:Property ;
    rdfs:label 'Multi Year Start Year' ;
    rdfs:comment 'Starting fiscal year for multi-year budgets.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiYearEndYear rdf:type rdf:Property ;
    rdfs:label 'Multi Year End Year' ;
    rdfs:comment 'Ending fiscal year for multi-year budgets.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Details of any compliance issues or special compliance requirements for this budget.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expendedAmount rdf:type rdf:Property ;
    rdfs:label 'Expended Amount' ;
    rdfs:comment 'Total amount of budget that has been expended (actual payments made) as of the current reporting period.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTarget rdf:type rdf:Property ;
    rdfs:label 'Performance Target' ;
    rdfs:comment 'Target value for the performance measure that this budget is intended to achieve.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionId rdf:type rdf:Property ;
    rdfs:label 'Position Id' ;
    rdfs:comment 'Unique identifier for the position within NCDOT. Primary key for the position master data.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:shortTitle rdf:type rdf:Property ;
    rdfs:label 'Short Title' ;
    rdfs:comment 'Abbreviated or shortened version of the position title for display and reporting purposes.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationCode rdf:type rdf:Property ;
    rdfs:label 'Classification Code' ;
    rdfs:comment 'State classification code that categorizes the position according to North Carolina Office of State Human Resources standards.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationTitle rdf:type rdf:Property ;
    rdfs:label 'Classification Title' ;
    rdfs:comment 'Official classification title corresponding to the classification code in the state classification system.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryGradeId rdf:type rdf:Property ;
    rdfs:label 'Salary Grade Id' ;
    rdfs:comment 'Pay grade level assigned to the position within the NCDOT compensation structure (e.g., GS-65, NC-12, SE-08).' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SalaryGrade .

ind:employmentType rdf:type rdf:Property ;
    rdfs:label 'Employment Type' ;
    rdfs:comment 'Type of employment arrangement for the position (full-time, part-time, temporary, seasonal, contract, intern).' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flsaStatus rdf:type rdf:Property ;
    rdfs:label 'Flsa Status' ;
    rdfs:comment 'Classification of the position under the Fair Labor Standards Act indicating whether the position is exempt or non-exempt from overtime pay requirements.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eeoCategory rdf:type rdf:Property ;
    rdfs:label 'Eeo Category' ;
    rdfs:comment 'Equal Employment Opportunity job category for federal reporting and compliance purposes.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentId rdf:type rdf:Property ;
    rdfs:label 'Department Id' ;
    rdfs:comment 'Code representing the NCDOT division to which the position is assigned (e.g., DOH, DMV, DCH, ITD).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
