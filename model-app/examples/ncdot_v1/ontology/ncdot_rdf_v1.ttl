ind:periodDepreciationRate rdf:type rdf:Property ;
    rdfs:label 'Period Depreciation Rate' ;
    rdfs:comment 'The depreciation rate for the specific fiscal period, calculated based on the depreciation method and useful life.' ;
    rdfs:domain ind:Depreciation ;
