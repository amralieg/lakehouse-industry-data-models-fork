ind:hardshipAcquisitionFlag rdf:type rdf:Property ;
    rdfs:label 'Hardship Acquisition Flag' ;
    rdfs:comment 'Indicates whether this is a hardship acquisition requested by property owner before normal project schedule.' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:protectiveAcquisitionFlag rdf:type rdf:Property ;
    rdfs:label 'Protective Acquisition Flag' ;
    rdfs:comment 'Indicates whether this is a protective acquisition to preserve corridor integrity before project authorization.' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:advanceAcquisitionFlag rdf:type rdf:Property ;
    rdfs:label 'Advance Acquisition Flag' ;
    rdfs:comment 'Indicates whether this is an advance acquisition conducted before project construction authorization.' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:donationAnticipatedFlag rdf:type rdf:Property ;
    rdfs:label 'Donation Anticipated Flag' ;
    rdfs:comment 'Indicates whether the property owner has expressed willingness to donate the right-of-way interest.' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:excessLandFlag rdf:type rdf:Property ;
    rdfs:label 'Excess Land Flag' ;
    rdfs:comment 'Indicates whether excess land beyond project needs may be acquired and later disposed.' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialProvisionsNotes rdf:type rdf:Property ;
    rdfs:label 'Special Provisions Notes' ;
    rdfs:comment 'Additional notes documenting special provisions, conditions, or requirements for this acquisition request.' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalComments rdf:type rdf:Property ;
    rdfs:label 'Internal Comments' ;
    rdfs:comment 'Internal comments and notes for NCDOT staff regarding the acquisition request processing.' ;
    rdfs:domain ind:AcquisitionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Modified Date' ;
    rdfs:comment 'Date when the acquisition request record was last modified or updated.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'State fiscal year in which the acquisition request was submitted or is planned for execution.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalFiscalYear rdf:type rdf:Property ;
    rdfs:label 'Federal Fiscal Year' ;
    rdfs:comment 'Federal fiscal year for projects with federal funding participation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationId rdf:type rdf:Property ;
    rdfs:label 'Violation Id' ;
    rdfs:comment 'Unique identifier for the traffic violation record. Primary key for the violation entity.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:citationNumber rdf:type rdf:Property ;
    rdfs:label 'Citation Number' ;
    rdfs:comment 'Official citation or ticket number issued by law enforcement for the traffic violation. Unique identifier printed on the physical or electronic citation.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Driver License Number' ;
    rdfs:comment 'The driver license number of the individual cited for the violation. Links to SADLS driver records.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverName rdf:type rdf:Property ;
    rdfs:label 'Driver Name' ;
    rdfs:comment 'Full legal name of the driver cited for the violation as recorded on the citation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverAddress rdf:type rdf:Property ;
    rdfs:label 'Driver Address' ;
    rdfs:comment 'Residential address of the driver at the time of citation issuance.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverCity rdf:type rdf:Property ;
    rdfs:label 'Driver City' ;
    rdfs:comment 'City of residence for the driver cited.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverState rdf:type rdf:Property ;
    rdfs:label 'Driver State' ;
    rdfs:comment 'State of residence for the driver cited, using two-letter state abbreviation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverZipCode rdf:type rdf:Property ;
    rdfs:label 'Driver Zip Code' ;
    rdfs:comment 'ZIP code of the driver\'s residential address.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Driver Date Of Birth' ;
    rdfs:comment 'Date of birth of the driver cited for the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:time rdf:type rdf:Property ;
    rdfs:label 'Time' ;
    rdfs:comment 'Precise date and time when the traffic violation occurred.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:locationDescription rdf:type rdf:Property ;
    rdfs:label 'Location Description' ;
    rdfs:comment 'Textual description of the location where the violation occurred (e.g., intersection, highway mile marker, street address).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streetAddress rdf:type rdf:Property ;
    rdfs:label 'Street Address' ;
    rdfs:comment 'Street address or nearest address to where the violation occurred.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality where the violation occurred.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:state rdf:type rdf:Property ;
    rdfs:label 'State' ;
    rdfs:comment 'State where the violation occurred, typically NC for North Carolina violations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipCode rdf:type rdf:Property ;
    rdfs:label 'Zip Code' ;
    rdfs:comment 'ZIP code of the location where the violation occurred.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the violation location in decimal degrees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the violation location in decimal degrees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mileMarker rdf:type rdf:Property ;
    rdfs:label 'Mile Marker' ;
    rdfs:comment 'Mile marker or milepost location on the highway where the violation occurred.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:speedLimit rdf:type rdf:Property ;
    rdfs:label 'Speed Limit' ;
    rdfs:comment 'Posted speed limit in miles per hour at the location where the violation occurred.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualSpeed rdf:type rdf:Property ;
    rdfs:label 'Actual Speed' ;
    rdfs:comment 'Actual speed in miles per hour at which the driver was traveling when cited for speeding violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:speedOverLimit rdf:type rdf:Property ;
    rdfs:label 'Speed Over Limit' ;
    rdfs:comment 'Number of miles per hour over the posted speed limit for speeding violations.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fineAmount rdf:type rdf:Property ;
    rdfs:label 'Fine Amount' ;
    rdfs:comment 'Monetary fine amount assessed for the violation in US dollars.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:courtCosts rdf:type rdf:Property ;
    rdfs:label 'Court Costs' ;
    rdfs:comment 'Court costs and administrative fees associated with the violation in US dollars.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAmountDue rdf:type rdf:Property ;
    rdfs:label 'Total Amount Due' ;
    rdfs:comment 'Total amount due including fine, court costs, and any additional fees in US dollars.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountPaid rdf:type rdf:Property ;
    rdfs:label 'Amount Paid' ;
    rdfs:comment 'Total amount paid by the driver toward the violation in US dollars.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'Date by which payment for the violation must be received to avoid additional penalties.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'Date on which payment was received for the violation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjudicationStatus rdf:type rdf:Property ;
    rdfs:label 'Adjudication Status' ;
    rdfs:comment 'Final adjudication outcome of the violation after court proceedings.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjudicationDate rdf:type rdf:Property ;
    rdfs:label 'Adjudication Date' ;
    rdfs:comment 'Date on which the violation was adjudicated in court.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtDate rdf:type rdf:Property ;
    rdfs:label 'Court Date' ;
    rdfs:comment 'Scheduled date for the driver to appear in court for the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtName rdf:type rdf:Property ;
    rdfs:label 'Court Name' ;
    rdfs:comment 'Name of the court where the violation case is or was heard.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtCounty rdf:type rdf:Property ;
    rdfs:label 'Court County' ;
    rdfs:comment 'County in which the court handling the violation is located.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:docketNumber rdf:type rdf:Property ;
    rdfs:label 'Docket Number' ;
    rdfs:comment 'Court docket or case number assigned to the violation for court proceedings.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointsAssessed rdf:type rdf:Property ;
    rdfs:label 'Points Assessed' ;
    rdfs:comment 'Number of points assessed against the driver\'s license for the violation under the NC point system.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insurancePoints rdf:type rdf:Property ;
    rdfs:label 'Insurance Points' ;
    rdfs:comment 'Number of insurance points assessed for the violation that may affect insurance premiums.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cdlViolationIndicator rdf:type rdf:Property ;
    rdfs:label 'Cdl Violation Indicator' ;
    rdfs:comment 'Indicates whether the violation occurred while the driver was operating a commercial vehicle under a CDL.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatIndicator rdf:type rdf:Property ;
    rdfs:label 'Hazmat Indicator' ;
    rdfs:comment 'Indicates whether the violation involved a vehicle transporting hazardous materials.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schoolZoneIndicator rdf:type rdf:Property ;
    rdfs:label 'School Zone Indicator' ;
    rdfs:comment 'Indicates whether the violation occurred in a designated school zone.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workZoneIndicator rdf:type rdf:Property ;
    rdfs:label 'Work Zone Indicator' ;
    rdfs:comment 'Indicates whether the violation occurred in an active highway work zone.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accidentRelatedIndicator rdf:type rdf:Property ;
    rdfs:label 'Accident Related Indicator' ;
    rdfs:comment 'Indicates whether the violation was associated with a traffic accident or crash.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:officerBadgeNumber rdf:type rdf:Property ;
    rdfs:label 'Officer Badge Number' ;
    rdfs:comment 'Badge or identification number of the law enforcement officer who issued the citation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officerName rdf:type rdf:Property ;
    rdfs:label 'Officer Name' ;
    rdfs:comment 'Name of the law enforcement officer who issued the citation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementAgency rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Agency' ;
    rdfs:comment 'Name of the law enforcement agency whose officer issued the citation (e.g., NC State Highway Patrol, local police department).' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyOriNumber rdf:type rdf:Property ;
    rdfs:label 'Agency Ori Number' ;
    rdfs:comment 'FBI-assigned Originating Agency Identifier for the law enforcement agency that issued the citation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:citationType rdf:type rdf:Property ;
    rdfs:label 'Citation Type' ;
    rdfs:comment 'Type or category of citation issued (e.g., traffic, criminal, parking, equipment violation).' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severity rdf:type rdf:Property ;
    rdfs:label 'Severity' ;
    rdfs:comment 'Legal severity classification of the violation (infraction, misdemeanor, or felony).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryCourtAppearanceIndicator rdf:type rdf:Property ;
    rdfs:label 'Mandatory Court Appearance Indicator' ;
    rdfs:comment 'Indicates whether the violation requires a mandatory court appearance by the driver.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseSuspensionIndicator rdf:type rdf:Property ;
    rdfs:label 'License Suspension Indicator' ;
    rdfs:comment 'Indicates whether the violation resulted in or may result in driver license suspension.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suspensionDurationDays rdf:type rdf:Property ;
    rdfs:label 'Suspension Duration Days' ;
    rdfs:comment 'Total number of days for which the driver license is suspended due to the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revocationIndicator rdf:type rdf:Property ;
    rdfs:label 'Revocation Indicator' ;
    rdfs:comment 'Indicates whether the violation resulted in driver license revocation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealFiledIndicator rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Indicator' ;
    rdfs:comment 'Indicates whether the driver has filed an appeal of the violation or court decision.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Date' ;
    rdfs:comment 'Date on which an appeal was filed for the violation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealOutcome rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome' ;
    rdfs:comment 'Outcome of the appeal process for the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantIssuedIndicator rdf:type rdf:Property ;
    rdfs:label 'Warrant Issued Indicator' ;
    rdfs:comment 'Indicates whether a warrant has been issued for failure to appear or failure to pay the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantIssueDate rdf:type rdf:Property ;
    rdfs:label 'Warrant Issue Date' ;
    rdfs:comment 'Date on which a warrant was issued related to the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:failureToAppearIndicator rdf:type rdf:Property ;
    rdfs:label 'Failure To Appear Indicator' ;
    rdfs:comment 'Indicates whether the driver failed to appear in court as required for the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:failureToAppearDate rdf:type rdf:Property ;
    rdfs:label 'Failure To Appear Date' ;
    rdfs:comment 'Date on which the driver failed to appear in court as scheduled.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prayerForJudgmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Prayer For Judgment Indicator' ;
    rdfs:comment 'Indicates whether a Prayer for Judgment Continued was granted for the violation, which defers judgment and may prevent insurance and license points.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalViolationCode rdf:type rdf:Property ;
    rdfs:label 'Original Violation Code' ;
    rdfs:comment 'Original violation code if the charge was subsequently reduced or amended.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedToDmvIndicator rdf:type rdf:Property ;
    rdfs:label 'Reported To Dmv Indicator' ;
    rdfs:comment 'Indicates whether the violation has been reported to the NC DMV for inclusion in the driver\'s Motor Vehicle Record (MVR).' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dmvReportDate rdf:type rdf:Property ;
    rdfs:label 'Dmv Report Date' ;
    rdfs:comment 'Date on which the violation was reported to the NC DMV.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outOfStateViolationIndicator rdf:type rdf:Property ;
    rdfs:label 'Out Of State Violation Indicator' ;
    rdfs:comment 'Indicates whether the violation occurred outside of North Carolina and was reported to NC DMV through interstate compact.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceState rdf:type rdf:Property ;
    rdfs:label 'Source State' ;
    rdfs:comment 'State that reported the out-of-state violation to NC DMV, using two-letter state abbreviation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Timestamp when the violation record was initially created in the system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Timestamp when the violation record was last updated or modified.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:licenseId rdf:type rdf:Property ;
    rdfs:label 'License Id' ;
    rdfs:comment 'Unique identifier for the driver license record in the system.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:License .

ind:class rdf:type rdf:Property ;
    rdfs:label 'Class' ;
    rdfs:comment 'The class of driver license indicating the type of vehicle the holder is authorized to operate (e.g., Class A, B, C for non-commercial; CDL-A, CDL-B, CDL-C for commercial).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsements rdf:type rdf:Property ;
    rdfs:label 'Endorsements' ;
    rdfs:comment 'Additional endorsements on the license authorizing the holder to operate specific vehicle types or carry specific cargo (e.g., H-Hazmat, N-Tank Vehicle, P-Passenger, S-School Bus, T-Double/Triple Trailers, X-Combination of Tank and Hazmat).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realIdCompliant rdf:type rdf:Property ;
    rdfs:label 'Real Id Compliant' ;
    rdfs:comment 'Indicates whether the license meets REAL ID Act requirements for federal identification purposes (e.g., boarding domestic flights, entering federal facilities).' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cardNumber rdf:type rdf:Property ;
    rdfs:label 'Card Number' ;
    rdfs:comment 'The unique card number assigned to the physical license card, distinct from the license number, used for card tracking and reissuance.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDiscriminator rdf:type rdf:Property ;
    rdfs:label 'Document Discriminator' ;
    rdfs:comment 'A unique identifier encoded on the license card to distinguish between different versions or reissues of the same license number.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'The DMV office or authority that issued the license (e.g., specific DMV branch location).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Previous License Number' ;
    rdfs:comment 'The previous license number if the driver\'s license number was changed due to reissuance or other administrative reasons.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfCertificationType rdf:type rdf:Property ;
    rdfs:label 'Self Certification Type' ;
    rdfs:comment 'The type of driving the CDL holder has self-certified to perform: non-excepted interstate, excepted interstate, non-excepted intrastate, or excepted intrastate.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible Date' ;
    rdfs:comment 'The earliest date on which the driver is eligible to apply for license reinstatement after suspension or revocation.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:duplicateIndicator rdf:type rdf:Property ;
    rdfs:label 'Duplicate Indicator' ;
    rdfs:comment 'Indicates whether this license is a duplicate issued to replace a lost, stolen, or damaged license.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:provisionalExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Provisional Expiration Date' ;
    rdfs:comment 'The expiration date of provisional license restrictions for drivers under age 18, after which full driving privileges are granted.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driverEducationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Driver Education Completion Date' ;
    rdfs:comment 'The date on which the driver completed an approved driver education course, if applicable.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:roadTestDate rdf:type rdf:Property ;
    rdfs:label 'Road Test Date' ;
    rdfs:comment 'The date on which the driver passed the road skills test for license issuance.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:writtenTestDate rdf:type rdf:Property ;
    rdfs:label 'Written Test Date' ;
    rdfs:comment 'The date on which the driver passed the written knowledge test for license issuance.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visionTestDate rdf:type rdf:Property ;
    rdfs:label 'Vision Test Date' ;
    rdfs:comment 'The date on which the driver\'s vision was tested for license issuance or renewal.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ignitionInterlockRequired rdf:type rdf:Property ;
    rdfs:label 'Ignition Interlock Required' ;
    rdfs:comment 'Indicates whether the driver is required to have an ignition interlock device installed in their vehicle as a condition of license restoration after DWI conviction.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ignitionInterlockStartDate rdf:type rdf:Property ;
    rdfs:label 'Ignition Interlock Start Date' ;
    rdfs:comment 'The date on which the ignition interlock device requirement began.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ignitionInterlockEndDate rdf:type rdf:Property ;
    rdfs:label 'Ignition Interlock End Date' ;
    rdfs:comment 'The date on which the ignition interlock device requirement is scheduled to end.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outOfStateConvictionIndicator rdf:type rdf:Property ;
    rdfs:label 'Out Of State Conviction Indicator' ;
    rdfs:comment 'Indicates whether the driver has out-of-state traffic convictions reported through the Driver License Compact or Non-Resident Violator Compact.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialLearnerPermitIndicator rdf:type rdf:Property ;
    rdfs:label 'Commercial Learner Permit Indicator' ;
    rdfs:comment 'Indicates whether this is a commercial learner permit rather than a full commercial driver license.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:skillsTestWaiverIndicator rdf:type rdf:Property ;
    rdfs:label 'Skills Test Waiver Indicator' ;
    rdfs:comment 'Indicates whether the driver received a waiver of the CDL skills test based on military or other qualifying experience.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawfulPresenceVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Lawful Presence Verified Date' ;
    rdfs:comment 'The date on which the driver\'s lawful presence in the United States was verified through SAVE (Systematic Alien Verification for Entitlements) or other authorized system.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:limitedTermIndicator rdf:type rdf:Property ;
    rdfs:label 'Limited Term Indicator' ;
    rdfs:comment 'Indicates whether this is a limited-term license issued to non-citizens with temporary lawful presence, with expiration tied to authorized stay period.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizedStayExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Authorized Stay Expiration Date' ;
    rdfs:comment 'The expiration date of the driver\'s authorized stay in the United States, applicable to limited-term licenses.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Record Source System' ;
    rdfs:comment 'The source system from which this license record originated (e.g., SADLS - State Automated Driver License System, DB2 Mainframe).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'The timestamp when this license record was last updated in the source system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:parcelId rdf:type rdf:Property ;
    rdfs:label 'Parcel Id' ;
    rdfs:comment 'Unique identifier for each land parcel within the agency\'s right-of-way inventory. Primary key for the parcel record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Parcel .

ind:countyName rdf:type rdf:Property ;
    rdfs:label 'County Name' ;
    rdfs:comment 'Name of the North Carolina county where the parcel is located.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionNumber rdf:type rdf:Property ;
    rdfs:label 'Division Number' ;
    rdfs:comment 'NCDOT division number responsible for managing this parcel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routeId rdf:type rdf:Property ;
    rdfs:label 'Route Id' ;
    rdfs:comment 'Highway or roadway route identifier associated with the right-of-way corridor containing this parcel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Route .

ind:beginMilepost rdf:type rdf:Property ;
    rdfs:label 'Begin Milepost' ;
    rdfs:comment 'Starting milepost location along the route where the parcel begins.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endMilepost rdf:type rdf:Property ;
    rdfs:label 'End Milepost' ;
    rdfs:comment 'Ending milepost location along the route where the parcel ends.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxParcelReference rdf:type rdf:Property ;
    rdfs:label 'Tax Parcel Reference' ;
    rdfs:comment 'County tax assessor\'s parcel identification number used for property tax purposes.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionType rdf:type rdf:Property ;
    rdfs:label 'Acquisition Type' ;
    rdfs:comment 'Type of property interest being acquired by the agency.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:landUseCode rdf:type rdf:Property ;
    rdfs:label 'Land Use Code' ;
    rdfs:comment 'Standardized code representing the current use classification of the parcel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:landUseDescription rdf:type rdf:Property ;
    rdfs:label 'Land Use Description' ;
    rdfs:comment 'Detailed description of the current use of the parcel (e.g., residential, commercial, agricultural, vacant).' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoningClassification rdf:type rdf:Property ;
    rdfs:label 'Zoning Classification' ;
    rdfs:comment 'Current zoning classification assigned by the local jurisdiction.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAreaAcres rdf:type rdf:Property ;
    rdfs:label 'Total Area Acres' ;
    rdfs:comment 'Total land area of the parcel measured in acres.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAreaSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Total Area Square Feet' ;
    rdfs:comment 'Total land area of the parcel measured in square feet.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquiredAreaAcres rdf:type rdf:Property ;
    rdfs:label 'Acquired Area Acres' ;
    rdfs:comment 'Portion of the parcel area acquired by the agency, measured in acres.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquiredAreaSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Acquired Area Square Feet' ;
    rdfs:comment 'Portion of the parcel area acquired by the agency, measured in square feet.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingAreaAcres rdf:type rdf:Property ;
    rdfs:label 'Remaining Area Acres' ;
    rdfs:comment 'Portion of the parcel area remaining with the owner after acquisition, measured in acres.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offerAmount rdf:type rdf:Property ;
    rdfs:label 'Offer Amount' ;
    rdfs:comment 'Dollar amount offered to the property owner for acquisition of the property interest.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offerDate rdf:type rdf:Property ;
    rdfs:label 'Offer Date' ;
    rdfs:comment 'Date when the acquisition offer was formally presented to the property owner.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount' ;
    rdfs:comment 'Final negotiated or adjudicated amount paid to the property owner for the property interest.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'Date when the final settlement agreement was reached with the property owner.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closingDate rdf:type rdf:Property ;
    rdfs:label 'Closing Date' ;
    rdfs:comment 'Date when the property transaction was closed and title transferred to the agency.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:possessionDate rdf:type rdf:Property ;
    rdfs:label 'Possession Date' ;
    rdfs:comment 'Date when the agency took physical possession of the property.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relocationStatus rdf:type rdf:Property ;
    rdfs:label 'Relocation Status' ;
    rdfs:comment 'Current status of relocation assistance activities for displaced persons.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementsPresentFlag rdf:type rdf:Property ;
    rdfs:label 'Improvements Present Flag' ;
    rdfs:comment 'Indicates whether buildings, structures, or other improvements exist on the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:improvementsDescription rdf:type rdf:Property ;
    rdfs:label 'Improvements Description' ;
    rdfs:comment 'Description of buildings, structures, or other improvements located on the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:historicPropertyFlag rdf:type rdf:Property ;
    rdfs:label 'Historic Property Flag' ;
    rdfs:comment 'Indicates whether the parcel or improvements are listed or eligible for listing on historic registers.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wetlandsPresentFlag rdf:type rdf:Property ;
    rdfs:label 'Wetlands Present Flag' ;
    rdfs:comment 'Indicates whether jurisdictional wetlands are present on the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazardousMaterialsFlag rdf:type rdf:Property ;
    rdfs:label 'Hazardous Materials Flag' ;
    rdfs:comment 'Indicates whether hazardous materials or contamination have been identified on the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:titleStatus rdf:type rdf:Property ;
    rdfs:label 'Title Status' ;
    rdfs:comment 'Status of the property title indicating any encumbrances, liens, or defects.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleExaminationDate rdf:type rdf:Property ;
    rdfs:label 'Title Examination Date' ;
    rdfs:comment 'Date when the title examination or title search was completed.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleInsurancePolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Title Insurance Policy Number' ;
    rdfs:comment 'Policy number for title insurance coverage on the acquired property interest.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyStatus rdf:type rdf:Property ;
    rdfs:label 'Survey Status' ;
    rdfs:comment 'Current status of boundary survey activities for the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Survey Completion Date' ;
    rdfs:comment 'Date when the boundary survey was completed and approved.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gisPolygonFeatureId rdf:type rdf:Property ;
    rdfs:label 'Gis Polygon Feature Id' ;
    rdfs:comment 'Unique identifier linking this parcel record to its spatial polygon feature in the GIS system.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feature .

ind:coordinateSystem rdf:type rdf:Property ;
    rdfs:label 'Coordinate System' ;
    rdfs:comment 'Spatial reference system used for the parcel coordinates (e.g., NAD83, WGS84, State Plane).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapReObjectReference rdf:type rdf:Property ;
    rdfs:label 'Sap Re Object Reference' ;
    rdfs:comment 'Unique object identifier in the SAP RE module linking this parcel to real estate management transactions.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapContractNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Contract Number' ;
    rdfs:comment 'SAP contract number associated with the acquisition or lease agreement for this parcel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSource rdf:type rdf:Property ;
    rdfs:label 'Funding Source' ;
    rdfs:comment 'Primary funding source or program used for the parcel acquisition (e.g., federal, state, local, STIP).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalAidProjectNumber rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Project Number' ;
    rdfs:comment 'Federal Highway Administration project number for federally funded acquisitions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpoName rdf:type rdf:Property ;
    rdfs:label 'Mpo Name' ;
    rdfs:comment 'Name of the MPO or RPO with jurisdiction over the project area containing this parcel.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessControlFlag rdf:type rdf:Property ;
    rdfs:label 'Access Control Flag' ;
    rdfs:comment 'Indicates whether access control rights were acquired with the parcel, restricting direct access to the highway.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilityConflictsFlag rdf:type rdf:Property ;
    rdfs:label 'Utility Conflicts Flag' ;
    rdfs:comment 'Indicates whether utility facilities are present on the parcel that require relocation or adjustment.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilityRelocationStatus rdf:type rdf:Property ;
    rdfs:label 'Utility Relocation Status' ;
    rdfs:comment 'Current status of utility relocation activities on the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementType rdf:type rdf:Property ;
    rdfs:label 'Easement Type' ;
    rdfs:comment 'Specific type of easement acquired if the acquisition type is an easement.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementDurationYears rdf:type rdf:Property ;
    rdfs:label 'Easement Duration Years' ;
    rdfs:comment 'Duration in years for temporary easements or limited-term property interests.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:condemnationCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Condemnation Case Number' ;
    rdfs:comment 'Court case number if the parcel acquisition proceeded through eminent domain condemnation proceedings.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:condemnationFilingDate rdf:type rdf:Property ;
    rdfs:label 'Condemnation Filing Date' ;
    rdfs:comment 'Date when condemnation proceedings were filed with the court.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:condemnationAwardAmount rdf:type rdf:Property ;
    rdfs:label 'Condemnation Award Amount' ;
    rdfs:comment 'Dollar amount awarded by the court in condemnation proceedings.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:condemnationAwardDate rdf:type rdf:Property ;
    rdfs:label 'Condemnation Award Date' ;
    rdfs:comment 'Date when the court issued the condemnation award.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:litigationStatus rdf:type rdf:Property ;
    rdfs:label 'Litigation Status' ;
    rdfs:comment 'Current status of any litigation related to the parcel acquisition.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentPhone rdf:type rdf:Property ;
    rdfs:label 'Agent Phone' ;
    rdfs:comment 'Contact phone number for the assigned right-of-way agent.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentEmail rdf:type rdf:Property ;
    rdfs:label 'Agent Email' ;
    rdfs:comment 'Email address for the assigned right-of-way agent.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appraiserLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Appraiser License Number' ;
    rdfs:comment 'State license or certification number of the appraiser.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewAppraiserName rdf:type rdf:Property ;
    rdfs:label 'Review Appraiser Name' ;
    rdfs:comment 'Name of the review appraiser who performed quality assurance review of the appraisal.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appraisalReviewDate rdf:type rdf:Property ;
    rdfs:label 'Appraisal Review Date' ;
    rdfs:comment 'Date when the appraisal review was completed.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorityCode rdf:type rdf:Property ;
    rdfs:label 'Priority Code' ;
    rdfs:comment 'Priority level assigned to the parcel acquisition based on project schedule and construction needs.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'Indicates whether the parcel record is currently active in the right-of-way inventory.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vehicleId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Id' ;
    rdfs:comment 'Unique system identifier for each vehicle registered in North Carolina. Primary key for the vehicle master record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:make rdf:type rdf:Property ;
    rdfs:label 'Make' ;
    rdfs:comment 'Manufacturer or brand name of the vehicle (e.g., Ford, Toyota, Honda).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:model rdf:type rdf:Property ;
    rdfs:label 'Model' ;
    rdfs:comment 'Specific model name or designation assigned by the manufacturer (e.g., Camry, F-150, Civic).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelYear rdf:type rdf:Property ;
    rdfs:label 'Model Year' ;
    rdfs:comment 'Year designated by the manufacturer for the vehicle model, which may differ from the calendar year of manufacture.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bodyType rdf:type rdf:Property ;
    rdfs:label 'Body Type' ;
    rdfs:comment 'Classification of the vehicle based on its body configuration and design (e.g., sedan, SUV, pickup truck).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelType rdf:type rdf:Property ;
    rdfs:label 'Fuel Type' ;
    rdfs:comment 'Primary fuel or energy source used to power the vehicle.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engineType rdf:type rdf:Property ;
    rdfs:label 'Engine Type' ;
    rdfs:comment 'Description of the engine configuration and characteristics (e.g., V6, inline-4, electric motor).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engineDisplacementLiters rdf:type rdf:Property ;
    rdfs:label 'Engine Displacement Liters' ;
    rdfs:comment 'Total volume of all cylinders in the engine measured in liters. Not applicable for electric vehicles.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cylinderCount rdf:type rdf:Property ;
    rdfs:label 'Cylinder Count' ;
    rdfs:comment 'Number of cylinders in the engine. Not applicable for electric vehicles.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transmissionType rdf:type rdf:Property ;
    rdfs:label 'Transmission Type' ;
    rdfs:comment 'Type of transmission system used in the vehicle (e.g., automatic, manual, continuously variable).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driveType rdf:type rdf:Property ;
    rdfs:label 'Drive Type' ;
    rdfs:comment 'Drivetrain configuration indicating which wheels receive power from the engine (front-wheel drive, rear-wheel drive, all-wheel drive, four-wheel drive).' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorPrimary rdf:type rdf:Property ;
    rdfs:label 'Color Primary' ;
    rdfs:comment 'Primary exterior color of the vehicle as recorded at registration.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorSecondary rdf:type rdf:Property ;
    rdfs:label 'Color Secondary' ;
    rdfs:comment 'Secondary exterior color for multi-tone vehicles. Null if vehicle has single color.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossVehicleWeightRatingLbs rdf:type rdf:Property ;
    rdfs:label 'Gross Vehicle Weight Rating Lbs' ;
    rdfs:comment 'Maximum total weight of the vehicle including passengers, cargo, and fuel as specified by the manufacturer. Critical for commercial vehicle classification and road use regulations.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:curbWeightLbs rdf:type rdf:Property ;
    rdfs:label 'Curb Weight Lbs' ;
    rdfs:comment 'Weight of the vehicle without passengers or cargo but with standard equipment and full fluids.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatingCapacity rdf:type rdf:Property ;
    rdfs:label 'Seating Capacity' ;
    rdfs:comment 'Maximum number of passengers the vehicle is designed to accommodate, including the driver.' ;
