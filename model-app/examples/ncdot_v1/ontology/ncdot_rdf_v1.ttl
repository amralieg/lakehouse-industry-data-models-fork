ind:leaveTypeDescription rdf:type rdf:Property ;
    rdfs:label 'Leave Type Description' ;
    rdfs:comment 'Human-readable description of the leave type (e.g., Annual Leave, Sick Leave, Family Medical Leave Act, Military Leave).' ;
