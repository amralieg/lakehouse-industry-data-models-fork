    rdfs:comment 'Maximum aggregate dollar amount payable for all claims involving the additional insured during the policy period. May be sub-limited below the policy aggregate.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aiAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Ai Address Line1' ;
    rdfs:comment 'First line of the additional insured\'s mailing or registered address. Used for certificate delivery, notice of cancellation, and claims correspondence.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Ai Address Line2' ;
    rdfs:comment 'Second line of the additional insured\'s mailing or registered address (suite, floor, unit). Supplements address line 1 for complete address capture.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiCity rdf:type rdf:Property ;
    rdfs:label 'Ai City' ;
    rdfs:comment 'City of the additional insured\'s mailing or registered address. Required for certificate issuance and regulatory notice compliance.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiCountryCode rdf:type rdf:Property ;
    rdfs:label 'Ai Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the additional insured\'s address. Required for international policies and cross-border certificate issuance.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiName rdf:type rdf:Property ;
    rdfs:label 'Ai Name' ;
    rdfs:comment 'Full legal name of the additional insured party as it appears on the endorsement and certificate of insurance. Used for claims and legal correspondence.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiNumber rdf:type rdf:Property ;
    rdfs:label 'Ai Number' ;
    rdfs:comment 'Externally visible business identifier for this additional insured record, used on certificates of insurance and correspondence. Unique within the policy.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiPostalCode rdf:type rdf:Property ;
    rdfs:label 'Ai Postal Code' ;
    rdfs:comment 'ZIP or postal code of the additional insured\'s address. Used for geographic rating, certificate issuance, and regulatory notice delivery.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiStateCode rdf:type rdf:Property ;
    rdfs:label 'Ai State Code' ;
    rdfs:comment 'Two-letter US state or territory code for the additional insured\'s address. Used for regulatory jurisdiction determination and certificate compliance.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiStatus rdf:type rdf:Property ;
    rdfs:label 'Ai Status' ;
    rdfs:comment 'Current lifecycle status of the additional insured endorsement record. Drives certificate issuance eligibility and claims coverage validation.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiType rdf:type rdf:Property ;
    rdfs:label 'Ai Type' ;
    rdfs:comment 'Classifies the additional insured as an individual, organization, government entity, trust, or joint venture. Drives certificate formatting and coverage scope rules.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoCertIssuanceFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Cert Issuance Flag' ;
    rdfs:comment 'Indicates whether certificates of insurance for this additional insured should be automatically generated and distributed upon policy issuance or renewal.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date on which the additional insured endorsement was cancelled or removed from the policy prior to its scheduled expiration. Null if not cancelled.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Reason code for the cancellation of the additional insured endorsement. Required for regulatory reporting and audit trail in states with mandatory cancellation notice rules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Flag' ;
    rdfs:comment 'Indicates whether the additional insured is also designated as a certificate holder on the ACORD 25 certificate of insurance. Drives automated certificate generation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractReference rdf:type rdf:Property ;
    rdfs:label 'Contract Reference' ;
    rdfs:comment 'Reference number or description of the underlying contract, lease, or agreement that requires the additional insured designation. Provides audit trail for AI requirement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageScope rdf:type rdf:Property ;
    rdfs:label 'Coverage Scope' ;
    rdfs:comment 'Defines the scope of coverage granted to the AI: ongoing operations, completed operations, both, products liability, or premises only. Directly tied to the endorsement form selected.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementFormEdition rdf:type rdf:Property ;
    rdfs:label 'Endorsement Form Edition' ;
    rdfs:comment 'Edition date of the ISO or proprietary endorsement form (MM/YY format), indicating the version of the AI grant language in use. Critical for coverage interpretation.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementFormNumber rdf:type rdf:Property ;
    rdfs:label 'Endorsement Form Number' ;
    rdfs:comment 'ISO or proprietary form number of the additional insured endorsement (e.g., CG 20 10, CG 20 26, CG 20 33, CG 20 37). Identifies the exact AI grant language applied.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionsDescription rdf:type rdf:Property ;
    rdfs:label 'Exclusions Description' ;
    rdfs:comment 'Free-text description of any specific exclusions or limitations applied to the additional insured\'s coverage grant beyond the standard endorsement form language.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date on which the additional insured endorsement expires and coverage rights terminate. Typically co-terminus with the policy expiration date unless separately scheduled.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lobCode rdf:type rdf:Property ;
    rdfs:label 'Lob Code' ;
    rdfs:comment 'Line of business under which this additional insured endorsement is issued (e.g., GL, CGL, BOP, WC, APD). Determines applicable coverage forms and regulatory requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeOfCancellationDays rdf:type rdf:Property ;
    rdfs:label 'Notice Of Cancellation Days' ;
    rdfs:comment 'Number of days advance written notice of cancellation or material change that must be provided to the additional insured. Typically 30 or 60 days per contract requirement.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occurrenceLimit rdf:type rdf:Property ;
    rdfs:label 'Occurrence Limit' ;
    rdfs:comment 'Maximum dollar amount payable per occurrence for claims involving the additional insured under this endorsement. May be sub-limited below the policy occurrence limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryNoncontributoryFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Noncontributory Flag' ;
    rdfs:comment 'Indicates whether the policy is designated as primary and non-contributory with respect to the additional insured\'s own insurance. Common contractual requirement in construction and leasing.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:projectDescription rdf:type rdf:Property ;
    rdfs:label 'Project Description' ;
    rdfs:comment 'Description of the specific project, location, or operations for which the additional insured designation applies. Scopes the AI grant to defined work or premises.' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'Categorizes the contractual relationship between the named insured and the additional insured (e.g., lessor, lender, owner, contractor, mortgagee). [ENUM-REF-CANDIDATE: lessor|lender|owner|contractor|mortgagee|franchisor|vendor|co-owner — promote to' ;
    rdfs:domain ind:AdditionalInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRefCode rdf:type rdf:Property ;
    rdfs:label 'Source System Ref Code' ;
    rdfs:comment 'Native record identifier from the originating policy administration system for this additional insured record. Enables lineage tracing and reconciliation with source systems.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverOfSubrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Of Subrogation Flag' ;
    rdfs:comment 'Indicates whether a waiver of subrogation in favor of the additional insured has been endorsed onto the policy. Prevents the insurer from pursuing recovery against the AI.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amendmentId rdf:type rdf:Property ;
    rdfs:label 'Amendment Id' ;
    rdfs:comment 'Unique surrogate identifier for a mid-term coverage amendment record on a policy. Primary key of the coverage_amendment product.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Id' ;
    rdfs:comment 'Native transaction or job ID from the originating policy administration system, enabling traceability back to the system of record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:uwDecisionId rdf:type rdf:Property ;
    rdfs:label 'Uw Decision Id' ;
    rdfs:comment 'Reference to the underwriter who reviewed and approved this coverage amendment. Required for UW authority audit trails.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UwDecision .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Externally visible business identifier for this amendment, used in correspondence, audit trails, and bordereaux reporting.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentStatus rdf:type rdf:Property ;
    rdfs:label 'Amendment Status' ;
    rdfs:comment 'Current workflow lifecycle state of the amendment from initiation through application or rejection.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentType rdf:type rdf:Property ;
    rdfs:label 'Amendment Type' ;
    rdfs:comment 'Categorizes the nature of the mid-term change. [ENUM-REF-CANDIDATE: limit_change|deductible_change|sir_change|location_add|location_remove|vehicle_add|vehicle_remove|coverage_add|coverage_remove — promote to reference product]' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Applied Timestamp' ;
    rdfs:comment 'Date and time at which the amendment was committed to the policy administration system and coverage terms were updated.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time at which an authorized underwriter or system workflow approved the coverage amendment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:changeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Change Reason Code' ;
    rdfs:comment 'Standardized code identifying the business reason for the mid-term amendment (e.g., insured request, underwriter correction, regulatory mandate, audit finding).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Change Reason Description' ;
    rdfs:comment 'Free-text narrative explaining the business justification for the coverage amendment, captured at time of entry.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormNumber rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Number' ;
    rdfs:comment 'ISO or proprietary form number of the coverage being amended (e.g., CG 00 01, HO 00 03). Identifies the specific policy form.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itvRatio rdf:type rdf:Property ;
    rdfs:label 'Itv Ratio' ;
    rdfs:comment 'Insurance to Value (ITV) ratio after the amendment, calculated as new TIV divided by replacement cost value. Flags coinsurance exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'New Deductible Amount' ;
    rdfs:comment 'Deductible amount effective after this amendment. Drives re-rating and impacts insured\'s out-of-pocket exposure.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newLimitAmount rdf:type rdf:Property ;
    rdfs:label 'New Limit Amount' ;
    rdfs:comment 'Coverage limit effective after this amendment is applied. Used for premium re-rating and reinsurance cession recalculation.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newSirAmount rdf:type rdf:Property ;
    rdfs:label 'New Sir Amount' ;
    rdfs:comment 'Self-Insured Retention (SIR) amount effective after this amendment. Impacts claims payment thresholds and reinsurance attachment.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newTivAmount rdf:type rdf:Property ;
    rdfs:label 'New Tiv Amount' ;
    rdfs:comment 'Total Insured Value (TIV) effective after this amendment. Drives property premium re-rating and reinsurance treaty cession updates.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Impact Amount' ;
    rdfs:comment 'Net additional or return premium resulting from this amendment, calculated pro-rata from the effective date to policy expiration.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumImpactType rdf:type rdf:Property ;
    rdfs:label 'Premium Impact Type' ;
    rdfs:comment 'Indicates whether the amendment generates an additional premium charge, a return premium credit, or a flat (no-change) premium adjustment.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Deductible Amount' ;
    rdfs:comment 'Deductible amount in force immediately before this amendment. Supports before/after comparison for premium adjustment.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Limit Amount' ;
    rdfs:comment 'Coverage limit in force immediately before this amendment. Retained for audit, regulatory, and premium adjustment purposes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorSirAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Sir Amount' ;
    rdfs:comment 'Self-Insured Retention (SIR) amount in force before this amendment. Relevant for large commercial and excess liability lines.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorTivAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Tiv Amount' ;
    rdfs:comment 'Total Insured Value (TIV) of the insured property or schedule before this amendment. Used for ITV analysis and CAT modeling.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'State DOI filing reference number associated with this amendment when a regulatory filing is required and submitted.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required' ;
    rdfs:comment 'Indicates whether this amendment triggers a state DOI rate or form filing obligation under applicable insurance regulations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Impact Flag' ;
    rdfs:comment 'Indicates whether this amendment materially affects reinsurance treaty cession amounts, requiring bordereaux update or facultative re-placement.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestedDate rdf:type rdf:Property ;
    rdfs:label 'Requested Date' ;
    rdfs:comment 'Calendar date on which the insured, producer, or underwriter formally requested the coverage amendment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requiresEndorsement rdf:type rdf:Property ;
    rdfs:label 'Requires Endorsement' ;
    rdfs:comment 'Indicates whether this amendment requires a formal endorsement document to be issued to the insured per policy terms or state regulation.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uwAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Uw Authority Level' ;
    rdfs:comment 'Underwriting authority tier required to approve this amendment based on limit size, LOB, and risk characteristics.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormId rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Id' ;
    rdfs:comment 'Foreign key linking to coverage.coverage_form. Business justification: Endorsements are based on ISO or proprietary coverage forms from the master catalog.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageForm .

ind:aggregateLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Amount' ;
    rdfs:comment 'Maximum total coverage limit for the policy period as established or modified by this endorsement. Applies to GL, CGL, and BOP aggregate caps.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficiaryName rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Name' ;
    rdfs:comment 'Name of the additional insured, loss payee, mortgagee, or other beneficiary granted rights under this endorsement. Required for AI grants and waiver of subrogation ENDTs.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryType rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Type' ;
    rdfs:comment 'Classification of the party receiving rights under this endorsement. Determines the scope of coverage extension and claims payment priority.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTerritory rdf:type rdf:Property ;
    rdfs:label 'Coverage Territory' ;
    rdfs:comment 'Geographic territory or jurisdiction to which this endorsement\'s coverage applies. Uses ISO 3166-1 alpha-2 state/country codes. Drives regulatory filing and rate bureau alignment.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementDescription rdf:type rdf:Property ;
    rdfs:label 'Endorsement Description' ;
    rdfs:comment 'Free-text narrative describing the purpose and scope of the endorsement. Printed on the DEC page and used by claims adjusters and UW for coverage interpretation.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementNumber rdf:type rdf:Property ;
    rdfs:label 'Endorsement Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier for the endorsement as printed on the declarations page. Used by agents, insureds, and regulators to reference a specific ENDT.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementStatus rdf:type rdf:Property ;
    rdfs:label 'Endorsement Status' ;
    rdfs:comment 'Current workflow state of the endorsement record. Controls whether the ENDT is binding, pending UW approval, superseded by a later ENDT, or cancelled.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementType rdf:type rdf:Property ;
    rdfs:label 'Endorsement Type' ;
    rdfs:comment 'Categorical classification of the endorsement action. Drives processing logic for AI grants, SubroFT waivers, mid-term amendments, and coverage changes. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionDescription rdf:type rdf:Property ;
    rdfs:label 'Exclusion Description' ;
    rdfs:comment 'Narrative description of any coverage exclusion added or removed by this endorsement. Used by claims adjusters for coverage determination and UW for risk selection.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuedDate rdf:type rdf:Property ;
    rdfs:label 'Issued Date' ;
    rdfs:comment 'Calendar date on which the endorsement was formally issued and delivered to the insured or broker. Distinct from effective_date for retroactive or prospective ENDTs.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:occurrenceLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Occurrence Limit Amount' ;
    rdfs:comment 'Maximum coverage limit per occurrence as established or modified by this endorsement. Distinct from aggregate limit; used for claims payment and reinsurance XOL attachment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyTransactionType rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Type' ;
    rdfs:comment 'Type of policy transaction that generated this endorsement (New Business, Renewal, Mid-term ENDT, Cancellation, Reinstatement, Rewrite). Aligns with NAIC transaction reporting.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Number' ;
    rdfs:comment 'State DOI or SERFF filing number associated with this endorsement form. Required for approved form tracking and regulatory examination responses.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required Flag' ;
    rdfs:comment 'Indicates whether this endorsement form requires a state DOI filing before use. Supports compliance tracking for rate and form filing obligations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestedByPartyType rdf:type rdf:Property ;
    rdfs:label 'Requested By Party Type' ;
    rdfs:comment 'Type of party who initiated the endorsement request. Supports producer commission attribution, UW workflow routing, and regulatory audit of mid-term changes.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retroactiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date' ;
    rdfs:comment 'Retroactive date established or modified by this endorsement for claims-made policies. Critical for determining coverage applicability on CGL and professional liability forms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sirAmount rdf:type rdf:Property ;
    rdfs:label 'Sir Amount' ;
    rdfs:comment 'Self-Insured Retention dollar threshold established or modified by this endorsement. Applicable to commercial lines where the insured retains a layer of risk below the policy limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemEndtRef rdf:type rdf:Property ;
    rdfs:label 'Source System Endt Ref' ;
    rdfs:comment 'Native endorsement identifier from the originating policy administration system (e.g., Guidewire PolicyCenter job number). Enables cross-system reconciliation and traceability.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationWaiverFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Waiver Flag' ;
    rdfs:comment 'Indicates whether this endorsement includes a waiver of subrogation rights against a specified party. Impacts recovery and SubroFT processes in ClaimCenter.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tivImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Tiv Impact Amount' ;
    rdfs:comment 'Change in Total Insured Value resulting from this endorsement. Used for property CAT modeling, PML calculations, and reinsurance cession adjustments.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Reason Code' ;
    rdfs:comment 'Coded reason for the endorsement transaction (e.g., insured request, UW correction, regulatory mandate, audit adjustment). Used for NAIC transaction reporting and analytics.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Uw Approval Required Flag' ;
    rdfs:comment 'Indicates whether this endorsement requires underwriter approval before binding. Drives workflow routing in PolicyCenter for non-standard or high-value ENDTs.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uwApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Uw Approved By' ;
    rdfs:comment 'Name or user ID of the underwriter who approved this endorsement. Supports UW authority audit trail and regulatory examination requirements.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwApprovedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Uw Approved Timestamp' ;
    rdfs:comment 'Date and time when the underwriter formally approved this endorsement. Provides a precise audit event for UW authority compliance and workflow SLA tracking.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Sequential version counter incremented each time this endorsement record is amended. Supports optimistic concurrency control and historical version tracking in the lakehouse.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleId rdf:type rdf:Property ;
    rdfs:label 'Deductible Id' ;
    rdfs:comment 'Foreign key linking to coverage.deductible. Business justification: Exposure records capture deductible_amount and deductible_type inline, but the deductible table contains structured deductible records with full details (flat, percentage, split' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Deductible .

ind:limitId rdf:type rdf:Property ;
    rdfs:label 'Limit Id' ;
    rdfs:comment 'Foreign key linking to coverage.limit. Business justification: Exposure records capture occurrence_limit, aggregate_limit, and sublimit_amount inline, but the limit table contains structured limit records with full details (limit type, basis, application' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Limit .

ind:sirLayerId rdf:type rdf:Property ;
    rdfs:label 'Sir Layer Id' ;
    rdfs:comment 'Foreign key linking to coverage.sir_layer. Business justification: Exposure records capture sir_amount inline, but the sir_layer table contains structured SIR records with full details (aggregate cap, erosion basis, defense inside/outside, ALAE treatment' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SirLayer .

ind:catExposedFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Exposed Flag' ;
    rdfs:comment 'Indicates whether this exposure is subject to catastrophe perils such as hurricane, earthquake, or flood.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:constructionType rdf:type rdf:Property ;
    rdfs:label 'Construction Type' ;
    rdfs:comment 'ISO construction type classification for this exposure used in property rating and underwriting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Amount' ;
    rdfs:comment 'Earned premium for this coverage exposure as of the current accounting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusionCodes rdf:type rdf:Property ;
    rdfs:label 'Exclusion Codes' ;
    rdfs:comment 'Comma-separated list of exclusion codes that apply to this coverage exposure limiting covered perils or losses.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureStatus rdf:type rdf:Property ;
    rdfs:label 'Exposure Status' ;
    rdfs:comment 'Current lifecycle status of the coverage exposure assignment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureType rdf:type rdf:Property ;
    rdfs:label 'Exposure Type' ;
    rdfs:comment 'Classification of the exposure being covered: fixed location, vehicle, scheduled item, blanket, or floating.' ;
    rdfs:domain ind:Exposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyCode rdf:type rdf:Property ;
    rdfs:label 'Occupancy Code' ;
    rdfs:comment 'ISO occupancy classification code describing the use of the property or vehicle at this exposure.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlAmount rdf:type rdf:Property ;
    rdfs:label 'Pml Amount' ;
    rdfs:comment 'Probable maximum loss estimate for this exposure used in catastrophe modeling and reinsurance placement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Premium Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for premium amounts on this exposure.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionClass rdf:type rdf:Property ;
    rdfs:label 'Protection Class' ;
    rdfs:comment 'ISO Public Protection Classification or similar fire protection rating for this exposure location.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Number' ;
    rdfs:comment 'Business-readable identifier for this coverage exposure assignment used in policy documents and bordereaux.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Eligible Flag' ;
    rdfs:comment 'Indicates whether this coverage exposure is eligible for reinsurance cession under treaty or facultative agreements.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tivAmount rdf:type rdf:Property ;
    rdfs:label 'Tiv Amount' ;
    rdfs:comment 'Total insured value for this specific exposure representing maximum property value at risk.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unearnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Unearned Premium Amount' ;
    rdfs:comment 'Unearned premium remaining for this coverage exposure representing future coverage obligation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationMethod rdf:type rdf:Property ;
    rdfs:label 'Valuation Method' ;
    rdfs:comment 'Method used to value losses for this exposure: Actual Cash Value, Replacement Cost Value, agreed value, stated amount, or market value.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Days' ;
    rdfs:comment 'Number of days after loss occurrence before coverage begins paying for this exposure, common in business interruption.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:writtenPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Written Premium Amount' ;
    rdfs:comment 'Written premium allocated to this specific coverage exposure for the policy term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aggregateLimitApplicable rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Applicable' ;
    rdfs:comment 'Indicates whether this coverage form supports a policy aggregate limit in addition to per-occurrence limits. Applicable to GL, CGL, and umbrella forms.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catExposed rdf:type rdf:Property ;
    rdfs:label 'Cat Exposed' ;
    rdfs:comment 'Indicates whether this coverage form provides coverage for catastrophe (CAT) perils such as hurricane, earthquake, or flood. Used for PML modeling and CAT XL reinsurance cession.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coinsurancePercent rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percent' ;
    rdfs:comment 'Required coinsurance percentage for property forms with ITV provisions (e.g., 80%, 90%, 100%). Null for forms without coinsurance requirements.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageCategory rdf:type rdf:Property ;
    rdfs:label 'Coverage Category' ;
    rdfs:comment 'Broad insurance coverage category grouping the form for product management and regulatory reporting (e.g., liability, property, auto, workers_comp, umbrella).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Default Deductible Amount' ;
    rdfs:comment 'Default deductible amount applied to this coverage form when no specific deductible is selected at policy binding. Expressed in USD.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Default Limit Amount' ;
    rdfs:comment 'Default per-occurrence or per-claim coverage limit amount associated with this form when no specific limit is selected at policy binding. Expressed in USD.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentTemplateCode rdf:type rdf:Property ;
    rdfs:label 'Document Template Code' ;
    rdfs:comment 'Reference code linking this coverage form to its policy document template in the document management system (OpenText/FileNet) for automated DEC page and policy packet generation.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:editionDate rdf:type rdf:Property ;
    rdfs:label 'Edition Date' ;
    rdfs:comment 'The edition date printed on the coverage form, indicating the version of the form language approved by the filing authority (e.g., 2013-04-01 for CG 00 01 04 13).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extendedReportingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Extended Reporting Period Days' ;
    rdfs:comment 'Number of days for the basic extended reporting period (tail coverage) available under claims-made forms after policy expiration. Zero for occurrence-based forms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'Date the coverage form was submitted to the state Department of Insurance for approval or informational filing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Filing Jurisdiction' ;
    rdfs:comment 'Two-letter US state or territory code where this form has been filed and approved by the Department of Insurance (DOI). Use \'ALL\' for multi-state or nationwide approved forms.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingStatus rdf:type rdf:Property ;
    rdfs:label 'Filing Status' ;
    rdfs:comment 'Current regulatory filing status of the form with the applicable state Department of Insurance. Tracks approval lifecycle for compliance and issuance eligibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formDescription rdf:type rdf:Property ;
    rdfs:label 'Form Description' ;
    rdfs:comment 'Detailed narrative description of the coverage form\'s insuring agreement, scope of coverage, and primary use case for underwriting and product management reference.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formName rdf:type rdf:Property ;
    rdfs:label 'Form Name' ;
    rdfs:comment 'Human-readable title of the coverage form as it appears on the declarations page or filing (e.g., \'Commercial General Liability Coverage Form\').' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formNumber rdf:type rdf:Property ;
    rdfs:label 'Form Number' ;
    rdfs:comment 'Externally recognized alphanumeric identifier assigned to the coverage form by ISO/Verisk or the insurer\'s proprietary filing (e.g., CG 00 01, HO 00 03). Unique within edition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formStatus rdf:type rdf:Property ;
    rdfs:label 'Form Status' ;
    rdfs:comment 'Current lifecycle state of the coverage form in the master catalog. Superseded forms remain for historical policy reference; withdrawn forms are no longer issuable.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formType rdf:type rdf:Property ;
    rdfs:label 'Form Type' ;
    rdfs:comment 'Classifies the form as a base coverage form, endorsement (ENDT), exclusion, schedule, declarations page (DEC), or conditions form within the policy structure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBaseForm rdf:type rdf:Property ;
    rdfs:label 'Is Base Form' ;
    rdfs:comment 'Indicates whether this is a base coverage form (True) or a supplemental endorsement/exclusion form (False). Base forms define primary insuring agreements; endorsements modify them.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIsoStandard rdf:type rdf:Property ;
    rdfs:label 'Is Iso Standard' ;
    rdfs:comment 'Indicates whether this form is an unmodified ISO/Verisk standard form (True) or a proprietary/manuscript deviation (False). Impacts rate filing and actuarial credibility.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Indicates whether this form is mandatory for all policies in the applicable LOB and jurisdiction, or optional/elective. Mandatory forms are auto-attached during policy issuance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoProgramCode rdf:type rdf:Property ;
    rdfs:label 'Iso Program Code' ;
    rdfs:comment 'ISO/Verisk program or manual code associated with this form, used for cross-referencing ISO rating content, loss costs, and advisory prospective loss cost filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobDescription rdf:type rdf:Property ;
    rdfs:label 'Lob Description' ;
    rdfs:comment 'Full descriptive name of the line of business associated with this form (e.g., \'Commercial General Liability\', \'Businessowners Policy\', \'Workers Compensation\').' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Amount' ;
    rdfs:comment 'Minimum premium amount required when this coverage form is attached to a policy. Expressed in USD. Null if no minimum applies.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicLineCode rdf:type rdf:Property ;
    rdfs:label 'Naic Line Code' ;
    rdfs:comment 'NAIC statutory line of business code used for Annual Statement reporting and regulatory filings (e.g., 17 for Other Liability, 19 for Workers Compensation).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceClaimsBasis rdf:type rdf:Property ;
    rdfs:label 'Occurrence Claims Basis' ;
    rdfs:comment 'Specifies the coverage trigger basis: occurrence (loss event date), claims-made (claim reported date), or reporting basis. Critical for reserve development and IBNR estimation.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:origin rdf:type rdf:Property ;
    rdfs:label 'Origin' ;
    rdfs:comment 'Identifies the originating standards body or source of the form: ISO/Verisk, AAIS, NCCI for WC, NFIP for flood, or insurer-proprietary/manuscript forms.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Policy Type Applicability' ;
    rdfs:comment 'Indicates whether the form applies to personal lines, commercial lines, or both. Drives underwriting eligibility rules in PolicyCenter and Duck Creek Policy.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumBasis rdf:type rdf:Property ;
    rdfs:label 'Premium Basis' ;
    rdfs:comment 'The exposure base used to calculate premium for this form (e.g., payroll for WC, gross receipts for GL, area for property). Drives rating engine configuration.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceEligible rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Eligible' ;
    rdfs:comment 'Indicates whether policies written on this form are eligible for cession under reinsurance treaties (QS, XOL, CAT XL) or facultative (FAC) placements.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactiveDateRequired rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date Required' ;
    rdfs:comment 'Indicates whether a retroactive date must be specified for this form. Required for claims-made forms to define the earliest date of covered occurrences.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sirEligible rdf:type rdf:Property ;
    rdfs:label 'Sir Eligible' ;
    rdfs:comment 'Indicates whether a Self-Insured Retention (SIR) can be applied to this coverage form in lieu of or in addition to a standard deductible. Relevant for large commercial accounts.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemFormCode rdf:type rdf:Property ;
    rdfs:label 'Source System Form Code' ;
    rdfs:comment 'Native identifier of this coverage form in the originating source system (e.g., Guidewire PolicyCenter internal form ID). Enables lineage tracing and reconciliation.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecificVersion rdf:type rdf:Property ;
    rdfs:label 'State Specific Version' ;
    rdfs:comment 'Indicates whether this form is a state-specific version with language deviating from the standard ISO form to comply with state DOI requirements or mandatory coverage provisions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tivApplicable rdf:type rdf:Property ;
    rdfs:label 'Tiv Applicable' ;
    rdfs:comment 'Indicates whether Total Insured Value (TIV) must be declared for this form. Applicable to property forms where ITV (Insurance to Value) coinsurance provisions apply.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valuationBasis rdf:type rdf:Property ;
    rdfs:label 'Valuation Basis' ;
    rdfs:comment 'Specifies the loss settlement valuation method: Actual Cash Value (ACV), Replacement Cost Value (RCV), agreed value, or functional replacement cost. Drives claims payment calculation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partId rdf:type rdf:Property ;
    rdfs:label 'Part Id' ;
    rdfs:comment 'Unique surrogate identifier for a coverage part record within the enterprise data platform. Primary key for the coverage_part product.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Part .

ind:productId rdf:type rdf:Property ;
    rdfs:label 'Product Id' ;
    rdfs:comment 'Reference to the insurance product definition that governs the forms, rules, and rating logic applicable to this coverage part.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Product .

ind:catExposedInd rdf:type rdf:Property ;
    rdfs:label 'Cat Exposed Ind' ;
    rdfs:comment 'Indicates whether this coverage part is exposed to catastrophe (CAT) perils such as hurricane, earthquake, or flood. Used for CAT modeling, PML analysis, and reinsurance treaty attachment.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsMadeInd rdf:type rdf:Property ;
    rdfs:label 'Claims Made Ind' ;
    rdfs:comment 'Indicates whether this coverage part is written on a claims-made basis (True) or occurrence basis (False). Determines IBNR reserving methodology and tail coverage requirements.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coinsurancePct rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Pct' ;
    rdfs:comment 'Coinsurance percentage requirement for this coverage part (e.g., 80%, 90%, 100%). Insured must maintain coverage at this percentage of replacement cost to avoid penalty at loss.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleType rdf:type rdf:Property ;
    rdfs:label 'Deductible Type' ;
    rdfs:comment 'Classification of the deductible structure applied to this coverage part (e.g., straight, franchise, aggregate, disappearing, per occurrence).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earnedPremium rdf:type rdf:Property ;
    rdfs:label 'Earned Premium' ;
    rdfs:comment 'Portion of Written Premium (WP) earned as of the reporting date, based on pro-rata or other earning method. Used for Loss Ratio (LR) and Combined Ratio (CR) calculations.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:experienceModFactor rdf:type rdf:Property ;
    rdfs:label 'Experience Mod Factor' ;
    rdfs:comment 'Experience modification factor (EMF or e-mod) applied to this coverage part, reflecting the insured\'s historical loss experience relative to expected losses. Primarily used for WC.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureAmount rdf:type rdf:Property ;
    rdfs:label 'Exposure Amount' ;
    rdfs:comment 'Quantified exposure base value for this coverage part (e.g., total payroll in USD for WC, square footage for property, number of vehicles for APD). Used in premium rating.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inceptionDate rdf:type rdf:Property ;
    rdfs:label 'Inception Date' ;
    rdfs:comment 'Original inception date of this coverage part, which may differ from effective_date for renewal or rewritten policies. Used for continuous coverage tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuringAgreementDesc rdf:type rdf:Property ;
    rdfs:label 'Insuring Agreement Desc' ;
    rdfs:comment 'Narrative description of the insuring agreement for this coverage part, summarizing the scope of coverage, perils insured, and key conditions as stated on the DEC page.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medExpenseLimit rdf:type rdf:Property ;
    rdfs:label 'Med Expense Limit' ;
    rdfs:comment 'Per-person limit for medical payments coverage (MedPay) under this coverage part, payable regardless of fault for bodily injury on the insured premises.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partName rdf:type rdf:Property ;
    rdfs:label 'Part Name' ;
    rdfs:comment 'Human-readable name of the coverage part (e.g., Commercial General Liability Coverage Part, Commercial Property Coverage Part, Workers Compensation and Employers Liability Part).' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partNumber rdf:type rdf:Property ;
    rdfs:label 'Part Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier for this coverage part, as printed on the Declarations (DEC) page and used in bordereaux and regulatory filings.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partStatus rdf:type rdf:Property ;
    rdfs:label 'Part Status' ;
    rdfs:comment 'Current lifecycle state of the coverage part within the policy administration system. Drives billing, claims eligibility, and regulatory reporting.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partType rdf:type rdf:Property ;
    rdfs:label 'Part Type' ;
    rdfs:comment 'Classifies the coverage part by Line of Business (LOB) form type. [ENUM-REF-CANDIDATE: GL|CGL|CP|WC_EL|APD|BOP|CPP|IM|CRIME|UMBRELLA|OTHER — promote to reference product]' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalAdvInjuryLimit rdf:type rdf:Property ;
    rdfs:label 'Personal Adv Injury Limit' ;
    rdfs:comment 'Per-occurrence limit for personal and advertising injury coverage under a CGL part, covering offenses such as libel, slander, and copyright infringement.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyTermMonths rdf:type rdf:Property ;
    rdfs:label 'Policy Term Months' ;
    rdfs:comment 'Duration of the coverage part in whole months (typically 6 or 12). Used for pro-rata premium calculation, Earned Premium (EP), and Unearned Premium Reserve (UEP).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:premiumCurrency rdf:type rdf:Property ;
    rdfs:label 'Premium Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for all premium and limit amounts on this coverage part (e.g., USD). Required for multi-currency and international program reporting.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productsCompletedOpsLimit rdf:type rdf:Property ;
    rdfs:label 'Products Completed Ops Limit' ;
    rdfs:comment 'Separate aggregate limit applying to products and completed operations exposures under a CGL coverage part, as defined by ISO CG 00 01 form structure.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratePerUnit rdf:type rdf:Property ;
    rdfs:label 'Rate Per Unit' ;
    rdfs:comment 'Manual or filed rate applied per unit of exposure for this coverage part (e.g., rate per $100 of payroll, rate per $1,000 of TIV). Core rating parameter from ISO or NCCI filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingBasis rdf:type rdf:Property ;
    rdfs:label 'Rating Basis' ;
    rdfs:comment 'Exposure base used to rate this coverage part (e.g., payroll for WC, revenue for GL, area for property). Drives premium calculation and actuarial loss development.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleModFactor rdf:type rdf:Property ;
    rdfs:label 'Schedule Mod Factor' ;
    rdfs:comment 'Underwriter-applied schedule rating modification factor for this coverage part, reflecting risk-specific credits or debits relative to the manual rate. Subject to state DOI filing limits.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemPartRef rdf:type rdf:Property ;
    rdfs:label 'Source System Part Ref' ;
    rdfs:comment 'Native identifier for this coverage part in the originating policy administration system (e.g., Guidewire PolicyCenter CoveragePartBean ID or Duck Creek Part GUID) for lineage tracing.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFiledInd rdf:type rdf:Property ;
    rdfs:label 'State Filed Ind' ;
    rdfs:comment 'Indicates whether the form and rate for this coverage part have been filed and approved by the applicable state Department of Insurance (DOI). Required for regulatory compliance tracking.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terrorismCoverageInd rdf:type rdf:Property ;
    rdfs:label 'Terrorism Coverage Ind' ;
    rdfs:comment 'Indicates whether terrorism coverage under TRIA (Terrorism Risk Insurance Act) is included in this coverage part. Required for TRIA certification and federal reporting.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unearnedPremium rdf:type rdf:Property ;
    rdfs:label 'Unearned Premium' ;
    rdfs:comment 'Unearned Premium Reserve (UEP) for this coverage part as of the reporting date, representing the unexpired portion of written premium. Required for NAIC statutory balance sheet.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writtenPremium rdf:type rdf:Property ;
    rdfs:label 'Written Premium' ;
    rdfs:comment 'Gross Written Premium (GWP) attributed to this coverage part for the current policy term. Used for Gross Written Premium (GWP) reporting, bordereaux, and reinsurance cession calculations.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coveragePerilId rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Id' ;
    rdfs:comment 'Unique surrogate identifier for each coverage-peril association record in the junction table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoveragePeril .

ind:perilCoveragePerilId rdf:type rdf:Property ;
    rdfs:label 'Peril Coverage Peril Id' ;
    rdfs:comment 'Reference to the peril definition record that is being associated with the coverage form.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoveragePeril .

ind:aggregateDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Deductible Amount' ;
    rdfs:comment 'Maximum total deductible the insured must pay for all losses from this peril in a policy period before the deductible is exhausted and full coverage applies.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:associationStatus rdf:type rdf:Property ;
    rdfs:label 'Association Status' ;
    rdfs:comment 'Current lifecycle status of this coverage-peril association record (ACTIVE, INACTIVE, PENDING approval, SUPERSEDED by endorsement, or WITHDRAWN).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catDesignationFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Designation Flag' ;
    rdfs:comment 'Indicates whether this peril is classified as a catastrophe event for reinsurance treaty and reserving purposes.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catEventType rdf:type rdf:Property ;
    rdfs:label 'Cat Event Type' ;
    rdfs:comment 'Specific catastrophe event classification when CAT designation flag is true, used for CAT modeling and PML calculation. [ENUM-REF-CANDIDATE: hurricane|tornado|earthquake|flood|wildfire|hail|windstorm|other|none — 9 candidates stripped; promote to' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catPerilCode rdf:type rdf:Property ;
    rdfs:label 'Cat Peril Code' ;
    rdfs:comment 'Industry-standard CAT peril code used in catastrophe modeling and reinsurance bordereaux (e.g., HU for Hurricane, EQ for Earthquake, FL for Flood, WS for Windstorm).' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catPerilFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Peril Flag' ;
    rdfs:comment 'Indicates whether this peril is classified as a catastrophe (CAT) peril for reinsurance treaty cession, PML modeling, and statutory CAT reporting purposes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catXlApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Xl Applicable Flag' ;
    rdfs:comment 'Indicates whether this peril is covered under catastrophe excess of loss reinsurance treaties.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coveragePerilCategory rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Category' ;
    rdfs:comment 'High-level classification grouping perils by origin or nature for underwriting and rating purposes. [ENUM-REF-CANDIDATE: natural|man-made|liability|theft|weather|fire|water|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveragePerilCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Code' ;
    rdfs:comment 'Standard industry code identifying the peril, typically ISO or carrier-specific classification code.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormEditionDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Edition Date' ;
    rdfs:comment 'Edition date of the coverage form version under which this peril association is defined, ensuring correct form version is applied for rating and claims.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coveragePerilStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Status' ;
    rdfs:comment 'Current lifecycle status of the peril definition in the reference catalog.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTrigger rdf:type rdf:Property ;
    rdfs:label 'Coverage Trigger' ;
    rdfs:comment 'Defines the event or condition that activates coverage for this peril under policy terms.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleBasis rdf:type rdf:Property ;
    rdfs:label 'Deductible Basis' ;
    rdfs:comment 'Basis on which the peril deductible is applied: per occurrence, per claim, annual aggregate, per location, or per unit.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductiblePercentage rdf:type rdf:Property ;
    rdfs:label 'Deductible Percentage' ;
    rdfs:comment 'Percentage used when peril_deductible_type is PERCENTAGE, expressed as a decimal (e.g., 0.02 = 2% of TIV). Null for flat deductibles.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coveragePerilDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Description' ;
    rdfs:comment 'Detailed definition of the peril including scope of covered loss events and typical manifestations.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementTypeCode rdf:type rdf:Property ;
    rdfs:label 'Endorsement Type Code' ;
    rdfs:comment 'Type of endorsement action that created this peril association: ADD a new peril, REMOVE an existing peril, MODIFY terms, RESTRICT coverage, or EXTEND coverage.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedByDefaultFlag rdf:type rdf:Property ;
    rdfs:label 'Excluded By Default Flag' ;
    rdfs:comment 'Indicates whether this peril is excluded by default in standard forms and requires explicit endorsement for coverage.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason Code' ;
    rdfs:comment 'Standardized code describing why the peril is excluded when insured_flag is False (e.g., FLOOD_ZONE, WAR, NUCLEAR, WEAR_TEAR). Null when peril is covered. [ENUM-REF-CANDIDATE: FLOOD_ZONE|WAR|NUCLEAR|WEAR_TEAR|INTENTIONAL|REGULATORY|OTHER — promote to' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyRating rdf:type rdf:Property ;
    rdfs:label 'Frequency Rating' ;
    rdfs:comment 'Typical loss frequency classification for underwriting and pricing purposes based on historical claim data.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'Typical geographic extent of loss events for this peril, used for exposure aggregation and PML modeling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupCode rdf:type rdf:Property ;
    rdfs:label 'Group Code' ;
    rdfs:comment 'Higher-level grouping code for the peril (e.g., CAT, NON-CAT, LIABILITY, THEFT). Used for aggregation in actuarial and reinsurance reporting. [ENUM-REF-CANDIDATE: CAT|NON_CAT|LIABILITY|THEFT|WEATHER|FIRE|OTHER — promote to reference product]' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurableFlag rdf:type rdf:Property ;
    rdfs:label 'Insurable Flag' ;
    rdfs:comment 'Indicates whether this peril is generally insurable under standard P&C policies or typically excluded.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuredFlag rdf:type rdf:Property ;
    rdfs:label 'Insured Flag' ;
    rdfs:comment 'Indicates whether the peril is covered (True) or excluded (False) under the associated coverage form. Core junction discriminator.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoPerilCode rdf:type rdf:Property ;
    rdfs:label 'Iso Peril Code' ;
    rdfs:comment 'ISO/Verisk standardized peril code used for industry statistical reporting, rate filings, and CLUE data exchange.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'Timestamp when this peril record was last modified in the reference catalog.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lossSettlementBasis rdf:type rdf:Property ;
    rdfs:label 'Loss Settlement Basis' ;
    rdfs:comment 'Basis on which losses from this peril are settled: occurrence-based, claims-made, or reporting form. Determines trigger and coverage period for peril losses.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryPerilFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Peril Flag' ;
    rdfs:comment 'Indicates whether this peril is mandatory under the coverage form and cannot be excluded by the insured (True) or is optional (False).' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naicPerilCode rdf:type rdf:Property ;
    rdfs:label 'Naic Peril Code' ;
    rdfs:comment 'NAIC statistical peril code used in Annual Statement Schedule P and other statutory filings for loss reporting by cause of loss.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveragePerilName rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Name' ;
    rdfs:comment 'Full business name of the peril as recognized in policy forms and coverage documentation.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nfipOverlapIndicator rdf:type rdf:Property ;
    rdfs:label 'Nfip Overlap Indicator' ;
    rdfs:comment 'Indicates whether this peril overlaps with NFIP coverage, requiring coordination of benefits and exclusion language.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pmlModelingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Pml Modeling Required Flag' ;
    rdfs:comment 'Indicates whether this peril requires PML modeling for exposure management and capital adequacy assessment.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Amount' ;
    rdfs:comment 'Portion of the written premium allocated to this specific peril within the coverage, used for peril-level profitability analysis and reinsurance pricing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rate rdf:type rdf:Property ;
    rdfs:label 'Rate' ;
    rdfs:comment 'Rate per unit of exposure (e.g., per $100 of TIV) applied to this peril for premium calculation purposes, sourced from the filed rate manual.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Flag' ;
    rdfs:comment 'Indicates whether losses from this peril require special regulatory reporting to state DOI or NAIC.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsurancePerilCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Peril Code' ;
    rdfs:comment 'Peril code used in reinsurance treaty and facultative (FAC) cession reporting and bordereaux submissions to reinsurers.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceTreatyApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Applicable Flag' ;
    rdfs:comment 'Indicates whether this peril is typically covered under reinsurance treaties or requires facultative placement.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledPerilFlag rdf:type rdf:Property ;
    rdfs:label 'Scheduled Peril Flag' ;
    rdfs:comment 'Indicates whether this peril is on a named/scheduled basis (True) requiring specific listing, versus an open-peril or all-risk basis (False).' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:severityRating rdf:type rdf:Property ;
    rdfs:label 'Severity Rating' ;
    rdfs:comment 'Typical loss severity classification for underwriting and pricing purposes based on historical claim data.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source System Record Code' ;
    rdfs:comment 'Native record identifier from the originating policy administration system, enabling traceability and reconciliation back to the system of record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sublimitBasis rdf:type rdf:Property ;
    rdfs:label 'Sublimit Basis' ;
    rdfs:comment 'Basis on which the peril sublimit is applied: per occurrence, per claim, annual aggregate, or per location. Governs how peril_sublimit_amount is consumed.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionId rdf:type rdf:Property ;
    rdfs:label 'Version Id' ;
    rdfs:comment 'Reference to the specific policy term (period) to which this coverage attachment applies. Supports multi-term policy structures.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Version .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for coverage cancellation (e.g., non-payment, underwriting, insured request). Required for state DOI cancellation notice compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Coverage Sequence Number' ;
    rdfs:comment 'Ordinal position of this coverage within the policy. Used to order and display coverages on the Declarations (DEC) page and in bordereaux reporting.' ;
    rdfs:domain ind:CoveragePolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageTypeCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Type Code' ;
    rdfs:comment 'Standardized code identifying the type of coverage (e.g., GL, CGL, APD, BI, PD, UM, UIM, PIP, MedPay, WC). Aligns with ISO/NAIC LOB codes. [ENUM-REF-CANDIDATE: GL|CGL|APD|BI|PD|UM|UIM|PIP|MedPay|WC|BOP|CPP — promote to reference product]' ;
    rdfs:domain ind:CoveragePolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementFlag rdf:type rdf:Property ;
    rdfs:label 'Endorsement Flag' ;
    rdfs:comment 'Indicates whether this coverage attachment was added or modified via a policy endorsement rather than being part of the original policy issuance.' ;
    rdfs:domain ind:CoveragePolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mandatoryCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Coverage Flag' ;
    rdfs:comment 'Indicates whether this coverage is statutorily or contractually required (e.g., state-mandated UM/UIM, PIP, or WC coverage). Prevents inadvertent removal during policy changes.' ;
    rdfs:domain ind:CoveragePolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateCode rdf:type rdf:Property ;
    rdfs:label 'Rate Code' ;
    rdfs:comment 'Rating code used by the rating engine to price this coverage. Links to the rate table and ISO/Verisk rating content used at time of quote and bind.' ;
    rdfs:domain ind:CoveragePolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Effective Date' ;
    rdfs:comment 'Effective date of the rate filing or rate table version used to price this coverage. Required for regulatory rate filing compliance and actuarial audit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemCoverageRef rdf:type rdf:Property ;
    rdfs:label 'Source System Coverage Ref' ;
    rdfs:comment 'Native identifier of this coverage attachment record in the originating policy administration system (e.g., Guidewire PolicyCenter coverage public ID). Enables reconciliation and lineage tracing.' ;
    rdfs:domain ind:CoveragePolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sublimitDescription rdf:type rdf:Property ;
    rdfs:label 'Sublimit Description' ;
    rdfs:comment 'Free-text description of the peril, property category, or coverage extension to which the sublimit applies (e.g., \'Flood\', \'Earthquake\', \'Business Income\').' ;
    rdfs:domain ind:CoveragePolicyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationMethod rdf:type rdf:Property ;
    rdfs:label 'Application Method' ;
    rdfs:comment 'Defines how the deductible is applied: per_occurrence, per_claim, per_accident, aggregate (annual), or per_location. Drives claims payment calculations and bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buybackAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Buyback Available Flag' ;
    rdfs:comment 'Indicates whether the insured has the option to purchase a deductible buyback endorsement to reduce or eliminate the deductible obligation for an additional premium.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buybackPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Buyback Premium Amount' ;
    rdfs:comment 'Additional premium charged to the insured to buy back (reduce or eliminate) the deductible. Applicable only when buyback_available_flag is True and the insured exercises the option.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catDeductibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Deductible Flag' ;
    rdfs:comment 'Indicates whether this deductible is a CAT-specific deductible triggered only by a declared catastrophe event (e.g., named storm, earthquake). Separate from the standard deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catPerilType rdf:type rdf:Property ;
    rdfs:label 'Cat Peril Type' ;
    rdfs:comment 'Specific catastrophe peril that triggers the CAT deductible. Applicable only when cat_deductible_flag is True. [ENUM-REF-CANDIDATE: named_storm|earthquake|flood|hail|wildfire|all_cat|tornado|ice_storm — promote to reference product]' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleCode rdf:type rdf:Property ;
    rdfs:label 'Deductible Code' ;
    rdfs:comment 'Externally-known alphanumeric code identifying this deductible structure, used in policy declarations, bordereaux, and regulatory filings.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Code' ;
    rdfs:comment 'ISO or proprietary form code identifying the coverage form to which this deductible applies (e.g., CG 00 01 for CGL, HO 00 03 for homeowners). Supports rate filing alignment.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleStatus rdf:type rdf:Property ;
    rdfs:label 'Deductible Status' ;
    rdfs:comment 'Current lifecycle state of the deductible record: active (in force), inactive (expired or removed), superseded (replaced by endorsement), or pending (awaiting binding).' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defenseInsideSirFlag rdf:type rdf:Property ;
    rdfs:label 'Defense Inside Sir Flag' ;
    rdfs:comment 'Indicates whether defense costs (legal fees, investigation) are included within and erode the SIR layer (True) or are paid outside the SIR by the insurer (False).' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disappearingMaxAmount rdf:type rdf:Property ;
    rdfs:label 'Disappearing Max Amount' ;
    rdfs:comment 'Loss threshold at which the deductible fully disappears (reduces to zero) in a disappearing deductible structure. Above this amount the insurer pays the full loss.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disappearingMinAmount rdf:type rdf:Property ;
    rdfs:label 'Disappearing Min Amount' ;
    rdfs:comment 'Minimum loss threshold below which the full deductible applies in a disappearing (franchise) deductible structure. Below this point the insured bears the full deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:erosionBasis rdf:type rdf:Property ;
    rdfs:label 'Erosion Basis' ;
    rdfs:comment 'Defines what costs erode (count against) the deductible or SIR: loss_only (indemnity only), loss_and_alae (loss plus Allocated Loss Adjustment Expense), or loss_and_lae (loss plus all LAE).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flatAmount rdf:type rdf:Property ;
    rdfs:label 'Flat Amount' ;
    rdfs:comment 'Fixed dollar amount the insured must pay per occurrence or per claim before the insurer\'s obligation begins. Applicable when deductible_type is flat or split.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Deductible Amount' ;
    rdfs:comment 'Ceiling dollar amount for the deductible, capping the insured\'s per-occurrence or per-claim obligation even when a percentage calculation yields a higher result.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Deductible Amount' ;
    rdfs:comment 'Floor dollar amount for the deductible, ensuring the insured\'s obligation does not fall below this value even when a percentage calculation yields a lower result.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentageBasis rdf:type rdf:Property ;
    rdfs:label 'Percentage Basis' ;
    rdfs:comment 'The value base against which the percentage deductible is calculated: TIV (Total Insured Value), loss (actual loss amount), SI (Sum Insured), or AAV (Agreed Amount Value).' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentageRate rdf:type rdf:Property ;
    rdfs:label 'Percentage Rate' ;
    rdfs:comment 'Deductible expressed as a percentage (e.g., 2.0000 = 2%) applied to the loss amount, Total Insured Value (TIV), or sum insured. Used when deductible_type is percentage.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateCreditFactor rdf:type rdf:Property ;
    rdfs:label 'Rate Credit Factor' ;
    rdfs:comment 'Multiplicative premium credit factor applied to the base rate as a result of the insured accepting this deductible or SIR level (e.g., 0.8500 = 15% credit). Used in premium rating.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementBasis rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Basis' ;
    rdfs:comment 'Defines whether the aggregate deductible or SIR cap reinstates after exhaustion: automatic (reinstates without additional premium), paid (reinstates for additional premium), or none.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sirAggregateCap rdf:type rdf:Property ;
    rdfs:label 'Sir Aggregate Cap' ;
    rdfs:comment 'Maximum annual aggregate dollar amount the insured is obligated to fund under the SIR layer across all occurrences in the policy period.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitAggregateAmount rdf:type rdf:Property ;
    rdfs:label 'Split Aggregate Amount' ;
    rdfs:comment 'Annual aggregate dollar cap on the insured\'s total deductible obligation under a split deductible structure. Once reached, the insurer absorbs subsequent losses.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitPerOccurrenceAmount rdf:type rdf:Property ;
    rdfs:label 'Split Per Occurrence Amount' ;
    rdfs:comment 'Per-occurrence dollar deductible component of a split deductible structure. The insured pays this amount for each individual loss event.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverOfDeductibleFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Of Deductible Flag' ;
    rdfs:comment 'Indicates whether the deductible has been waived by endorsement or underwriting authority for this coverage. When True, the insured pays no deductible regardless of the stated amount.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionId rdf:type rdf:Property ;
    rdfs:label 'Exclusion Id' ;
    rdfs:comment 'Unique surrogate identifier for a coverage exclusion, sublimit, condition, or warranty record in the P&C policy administration system.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bureauFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Bureau Filed Flag' ;
    rdfs:comment 'Indicates whether this clause has been filed with and approved by a rating bureau (ISO/Verisk) or state Department of Insurance (DOI) for use.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsHandlingNote rdf:type rdf:Property ;
    rdfs:label 'Claims Handling Note' ;
    rdfs:comment 'Operational guidance for claims adjusters on how to apply this exclusion during adjudication, including coverage denial language and documentation requirements.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clauseName rdf:type rdf:Property ;
    rdfs:label 'Clause Name' ;
    rdfs:comment 'Human-readable name of the exclusion or condition clause as it appears on the policy form, e.g., \'Pollution Exclusion\' or \'War and Terrorism Exclusion\'.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clauseStatus rdf:type rdf:Property ;
    rdfs:label 'Clause Status' ;
    rdfs:comment 'Current lifecycle status of the exclusion clause: active (in force), inactive (not yet effective), pending (awaiting approval), superseded (replaced), or voided.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clauseSummary rdf:type rdf:Property ;
    rdfs:label 'Clause Summary' ;
    rdfs:comment 'Plain-language summary of the clause for use in consumer-facing disclosures, declarations pages, and regulatory plain-language requirements.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clauseText rdf:type rdf:Property ;
    rdfs:label 'Clause Text' ;
    rdfs:comment 'Full verbatim text of the exclusion, sublimit, condition, or warranty clause as it appears in the policy form or endorsement wording.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clauseType rdf:type rdf:Property ;
    rdfs:label 'Clause Type' ;
    rdfs:comment 'Categorizes the clause as an exclusion (removes coverage), sublimit (caps coverage), condition (imposes obligation), warranty (guarantees a fact), or limitation.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cyberFlag rdf:type rdf:Property ;
    rdfs:label 'Cyber Flag' ;
    rdfs:comment 'Indicates whether this clause is a cyber or data breach exclusion, relevant for silent cyber exposure management and regulatory cyber reporting.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itvImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Itv Impact Flag' ;
    rdfs:comment 'Indicates whether this exclusion or sublimit affects the Insurance to Value (ITV) calculation for the insured property, relevant for coinsurance and valuation reporting.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manuscriptFlag rdf:type rdf:Property ;
    rdfs:label 'Manuscript Flag' ;
    rdfs:comment 'Indicates whether this exclusion clause is a manuscript (non-standard, bespoke) clause negotiated for this specific policy rather than a standard bureau form.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perilClass rdf:type rdf:Property ;
    rdfs:label 'Peril Class' ;
    rdfs:comment 'The peril or hazard category excluded or limited by this clause, e.g., flood, earthquake, pollution, terrorism, cyber, mold. [ENUM-REF-CANDIDATE: flood|earthquake|pollution|terrorism|cyber|mold|war|nuclear — promote to reference product]' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pollutionFlag rdf:type rdf:Property ;
    rdfs:label 'Pollution Flag' ;
    rdfs:comment 'Indicates whether this clause is an absolute or qualified pollution exclusion, relevant for environmental liability underwriting and claims adjudication.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyClass rdf:type rdf:Property ;
    rdfs:label 'Property Class' ;
    rdfs:comment 'The class of property or liability to which the exclusion scope is restricted, e.g., real property, personal property, bodily injury (BI), property damage (PD).' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Number' ;
    rdfs:comment 'State DOI or NAIC filing approval number for this clause form, required for statutory compliance and rate/form filing documentation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'Indicates whether the exclusion applies broadly (blanket), to a scheduled item, a specific location, a specific vehicle, named perils only, or all-risk basis.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRef rdf:type rdf:Property ;
    rdfs:label 'Source System Ref' ;
    rdfs:comment 'Native primary key or record identifier from the originating source system, used for lineage tracing and reconciliation with upstream policy administration systems.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terrorismFlag rdf:type rdf:Property ;
    rdfs:label 'Terrorism Flag' ;
    rdfs:comment 'Indicates whether this clause is a terrorism exclusion, relevant for TRIA (Terrorism Risk Insurance Act) compliance and federal backstop reporting.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tivReductionAmount rdf:type rdf:Property ;
    rdfs:label 'Tiv Reduction Amount' ;
    rdfs:comment 'Dollar amount by which this exclusion reduces the Total Insured Value (TIV) for the affected location or schedule item, used in CAT modeling and PML calculations.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverEndorsementRef rdf:type rdf:Property ;
    rdfs:label 'Waiver Endorsement Ref' ;
    rdfs:comment 'Reference number of the endorsement that waives this exclusion, populated only when waiver_flag is true.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Flag' ;
    rdfs:comment 'Indicates whether this exclusion has been waived by endorsement or underwriting agreement, restoring coverage for the excluded peril or property class.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itvAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Itv Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for each Insurance-to-Value assessment record on an insured property location.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acvEstimate rdf:type rdf:Property ;
    rdfs:label 'Acv Estimate' ;
    rdfs:comment 'Actual Cash Value (ACV) estimate for the insured property, calculated as RCV less depreciation, used for ACV policy settlements.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agreedValueFlag rdf:type rdf:Property ;
    rdfs:label 'Agreed Value Flag' ;
    rdfs:comment 'Indicates whether the policy carries an Agreed Value endorsement, suspending the coinsurance clause for this location.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assessedRcv rdf:type rdf:Property ;
    rdfs:label 'Assessed Rcv' ;
    rdfs:comment 'Replacement Cost Value (RCV) determined by the assessment methodology, representing the estimated cost to rebuild the structure at current prices.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'Calendar date on which the ITV assessment was conducted or the valuation report was produced.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assessment Method' ;
    rdfs:comment 'Valuation methodology used to derive the Replacement Cost Value (RCV). [ENUM-REF-CANDIDATE: marshall_swift|corelogic|xactware|internal_model|broker_estimate|appraisal — promote to reference product]' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Number' ;
    rdfs:comment 'Externally visible business identifier for this ITV assessment, used in underwriting correspondence and bordereaux reporting.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current workflow status of the ITV assessment record, driving underwriting action and coinsurance penalty determination.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Business trigger category for this assessment: new business underwriting, renewal review, mid-term endorsement, post-loss, or regulatory requirement.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorCredential rdf:type rdf:Property ;
    rdfs:label 'Assessor Credential' ;
    rdfs:comment 'Professional credential or license of the assessor (e.g., MAI, ASA, SRA), supporting regulatory and E&O defensibility.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorName rdf:type rdf:Property ;
    rdfs:label 'Assessor Name' ;
    rdfs:comment 'Name of the individual, firm, or automated service that performed the ITV assessment (e.g., Marshall Swift, CoreLogic, staff appraiser).' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsurancePenaltyFlag rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Penalty Flag' ;
    rdfs:comment 'Indicates whether the insured property is underinsured relative to the coinsurance requirement, triggering a proportional loss penalty.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costIndexFactor rdf:type rdf:Property ;
    rdfs:label 'Cost Index Factor' ;
    rdfs:comment 'Regional construction cost index factor from the valuation model (e.g., Marshall Swift regional multiplier) applied to base replacement cost.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Originating system or data feed that supplied this ITV assessment record (e.g., Guidewire PolicyCenter, Verisk, CoreLogic).' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expiryDate rdf:type rdf:Property ;
    rdfs:label 'Expiry Date' ;
    rdfs:comment 'Date after which this ITV assessment is no longer valid and a new assessment must be ordered before policy renewal.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inflationGuardPct rdf:type rdf:Property ;
    rdfs:label 'Inflation Guard Pct' ;
    rdfs:comment 'Annual inflation guard percentage applied to the insured value to keep pace with construction cost inflation between assessments.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfStories rdf:type rdf:Property ;
    rdfs:label 'Number Of Stories' ;
    rdfs:comment 'Number of above-grade stories in the insured building, influencing replacement cost per square foot in valuation models.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Report Reference Number' ;
    rdfs:comment 'External reference number of the valuation report or certificate issued by the assessment vendor, used for document retrieval.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedTiv rdf:type rdf:Property ;
    rdfs:label 'Reported Tiv' ;
    rdfs:comment 'Total Insured Value (TIV) as declared by the insured or broker on the policy application or schedule of values.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roofMaterial rdf:type rdf:Property ;
    rdfs:label 'Roof Material' ;
    rdfs:comment 'Primary roofing material of the insured structure, used in replacement cost estimation and CAT wind/hail underwriting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roofType rdf:type rdf:Property ;
    rdfs:label 'Roof Type' ;
    rdfs:comment 'Roof geometry classification of the insured structure, affecting both replacement cost estimation and wind/hail loss susceptibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roofYear rdf:type rdf:Property ;
    rdfs:label 'Roof Year' ;
    rdfs:comment 'Year the current roof was installed or last replaced, used in depreciation schedules and wind/hail underwriting eligibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sprinklerFlag rdf:type rdf:Property ;
    rdfs:label 'Sprinkler Flag' ;
    rdfs:comment 'Indicates whether the insured building is equipped with an automatic fire sprinkler system, qualifying for rate credits.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalAreaSqft rdf:type rdf:Property ;
    rdfs:label 'Total Area Sqft' ;
    rdfs:comment 'Total gross floor area of the insured structure in square feet, used as the primary size input for replacement cost estimation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underinsuranceGap rdf:type rdf:Property ;
    rdfs:label 'Underinsurance Gap' ;
    rdfs:comment 'Dollar shortfall between the assessed RCV and the reported TIV, representing the monetary exposure from underinsurance at this location.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uwActionTaken rdf:type rdf:Property ;
    rdfs:label 'Uw Action Taken' ;
    rdfs:comment 'Underwriting disposition recorded after review of the ITV assessment findings (e.g., limit increased, coinsurance waived, declined).' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Uw Review Required Flag' ;
    rdfs:comment 'Indicates that the ITV ratio or assessment findings require underwriter review before binding or renewal, triggering a UW referral.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uwReviewedDate rdf:type rdf:Property ;
    rdfs:label 'Uw Reviewed Date' ;
    rdfs:comment 'Date on which the underwriter completed review of the ITV assessment and recorded the UW action taken.' ;
    rdfs:domain ind:ItvAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:yearBuilt rdf:type rdf:Property ;
    rdfs:label 'Year Built' ;
    rdfs:comment 'Four-digit year the insured structure was originally constructed, used in depreciation and replacement cost calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentLimitId rdf:type rdf:Property ;
    rdfs:label 'Parent Limit Id' ;
    rdfs:comment 'Self-referencing FK to the parent limit record, enabling hierarchical sublimit modeling (e.g., peril-specific sublimit under an aggregate).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Limit .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'The principal monetary limit amount in the policy currency (e.g., per-occurrence limit, aggregate limit, per-person BI limit). Core financial fact for this limit record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amount2 rdf:type rdf:Property ;
    rdfs:label 'Amount 2' ;
    rdfs:comment 'Second monetary limit used in split-limit structures (e.g., PD limit in a BI/PD split, or per-person limit alongside per-occurrence). Null for non-split limits.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amount3 rdf:type rdf:Property ;
    rdfs:label 'Amount 3' ;
    rdfs:comment 'Third monetary limit in a three-part split structure (e.g., per-person BI / per-occurrence BI / PD). Null for non-three-part split limits.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:application rdf:type rdf:Property ;
    rdfs:label 'Application' ;
    rdfs:comment 'Defines how the limit applies across insured units: per insured, per location, per vehicle, per project, per employee, or blanket across all units.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basis rdf:type rdf:Property ;
    rdfs:label 'Basis' ;
    rdfs:comment 'The trigger basis on which the limit applies: occurrence, claims-made, accident, policy period, per location, or per vehicle.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitCode rdf:type rdf:Property ;
    rdfs:label 'Limit Code' ;
    rdfs:comment 'Externally-known alphanumeric code identifying this limit type, aligned with ISO form codes and carrier rating plans (e.g., OCC_LIMIT, AGG_LIMIT, PER_PERSON).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoLimitSymbol rdf:type rdf:Property ;
    rdfs:label 'Iso Limit Symbol' ;
    rdfs:comment 'ISO/Verisk rating symbol associated with this limit tier, used in ISO loss cost and rate filing calculations (e.g., auto liability symbol).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionStateCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction governing this limit, used for state-specific minimum limit compliance and statutory reporting.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitStatus rdf:type rdf:Property ;
    rdfs:label 'Limit Status' ;
    rdfs:comment 'Current lifecycle state of the limit record: active, inactive, superseded by endorsement, pending approval, or expired.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Structural classification of the limit: per-occurrence, aggregate, per-person, split (BI/PD), Combined Single Limit (CSL), sublimit, or per-claim. [ENUM-REF-CANDIDATE: per_occurrence|aggregate|per_person|split|csl|sublimit|per_claim — promote to reference' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Naic Coverage Code' ;
    rdfs:comment 'NAIC statistical coverage code associated with this limit for statutory reporting and Annual Statement Schedule P/T filings.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitName rdf:type rdf:Property ;
    rdfs:label 'Limit Name' ;
    rdfs:comment 'Human-readable name of the limit structure as displayed on the Declarations (DEC) page (e.g., Per-Occurrence Limit, Annual Aggregate Limit).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productsCompletedOpsAggregate rdf:type rdf:Property ;
    rdfs:label 'Products Completed Ops Aggregate' ;
    rdfs:comment 'Separate aggregate limit for products and completed operations exposures under CGL policies, per ISO CGL form structure.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatableFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatable Flag' ;
    rdfs:comment 'Indicates whether the limit can be reinstated after a loss payment (True), relevant for aggregate limits with reinstatement provisions.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementPremiumPct rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Pct' ;
    rdfs:comment 'Percentage of original premium charged to reinstate the aggregate limit after a loss, expressed as a decimal (e.g., 1.0000 = 100% pro-rata).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Retention Amount' ;
    rdfs:comment 'Net retention amount kept by the cedant after reinsurance cession for this limit layer, used in XOL and QS treaty calculations.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sharedLimitFlag rdf:type rdf:Property ;
    rdfs:label 'Shared Limit Flag' ;
    rdfs:comment 'Indicates whether this limit is shared across multiple coverages or insured locations on the same policy (True) or applies independently (False).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemLimitCode rdf:type rdf:Property ;
    rdfs:label 'Source System Limit Code' ;
    rdfs:comment 'Native primary key of this limit record in the originating operational system (e.g., Guidewire PolicyCenter internal limit GUID), used for reconciliation.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMinimumFlag rdf:type rdf:Property ;
    rdfs:label 'State Minimum Flag' ;
    rdfs:comment 'Indicates whether this limit equals the state-mandated minimum required by the applicable Department of Insurance (DOI), used for compliance monitoring.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:xolAttachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Xol Attachment Point' ;
    rdfs:comment 'Dollar attachment point at which Excess of Loss (XOL) reinsurance coverage begins for this limit layer. Null for non-XOL structures.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:namedInsuredId rdf:type rdf:Property ;
    rdfs:label 'Named Insured Id' ;
    rdfs:comment 'Unique surrogate identifier for a named insured record on a policy declarations page. Primary key for the named_insured data product in the coverage domain.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NamedInsured .

ind:annualPayroll rdf:type rdf:Property ;
    rdfs:label 'Annual Payroll' ;
    rdfs:comment 'Total annual payroll of the commercial named insured in USD. Primary exposure base for workers compensation (WC) premium rating and NCCI experience modification calculation.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualRevenue rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue' ;
    rdfs:comment 'Reported annual gross revenue of the commercial named insured in USD. Used as an exposure base for general liability (GL) and commercial general liability (CGL) premium rating.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consentToElectronicDelivery rdf:type rdf:Property ;
    rdfs:label 'Consent To Electronic Delivery' ;
    rdfs:comment 'Indicates whether the named insured has consented to receive policy documents, notices, and the declarations page (DEC) electronically. Required for e-delivery compliance under state DOI rules.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditScoreTier rdf:type rdf:Property ;
    rdfs:label 'Credit Score Tier' ;
    rdfs:comment 'Insurance credit score tier derived from the named insured\'s credit report. Used as a rating factor for personal lines where permitted; actual score is not stored per FCRA requirements.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'Date Of Incorporation' ;
    rdfs:comment 'Date on which the commercial named insured was legally incorporated or formed. Used for years-in-business underwriting factor and commercial eligibility rules.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:email rdf:type rdf:Property ;
    rdfs:label 'Email' ;
    rdfs:comment 'Primary email address of the named insured used for policy correspondence, renewal notices, and digital document delivery on the declarations page.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gender rdf:type rdf:Property ;
    rdfs:label 'Gender' ;
    rdfs:comment 'Self-reported gender of the individual named insured. Used for personal lines underwriting rating in jurisdictions where gender-based rating is permitted by state DOI.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredRole rdf:type rdf:Property ;
    rdfs:label 'Insured Role' ;
    rdfs:comment 'Role of this party on the declarations page. First named insured has primary rights and obligations; additional named insureds share coverage. [ENUM-REF-CANDIDATE: first_named|additional_named|mortgagee|loss_payee|additional_interest — promote to' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredType rdf:type rdf:Property ;
    rdfs:label 'Insured Type' ;
    rdfs:comment 'Legal entity type of the named insured. Drives underwriting eligibility, form selection, and regulatory reporting. [ENUM-REF-CANDIDATE: individual|corporation|partnership|llc|trust|government|non_profit — promote to reference product]' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFirstNamed rdf:type rdf:Property ;
    rdfs:label 'Is First Named' ;
    rdfs:comment 'Indicates whether this party is the first named insured on the declarations page (DEC). The first named insured holds primary rights including cancellation authority and premium refund entitlement.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryContact rdf:type rdf:Property ;
    rdfs:label 'Is Primary Contact' ;
    rdfs:comment 'Indicates whether this named insured is the primary contact for policy correspondence, billing notices, and renewal communications. Only one named insured per policy should be flagged true.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'Full legal name of the named insured as it appears on the declarations page (DEC). For individuals this is the full personal name; for entities it is the registered legal name.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maritalStatus rdf:type rdf:Property ;
    rdfs:label 'Marital Status' ;
    rdfs:comment 'Marital status of the individual named insured. Used as a personal lines underwriting (UW) rating variable for auto and homeowners policies where permitted by state DOI.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Naic Company Code' ;
    rdfs:comment 'Five-digit NAIC company code identifying the writing insurance company for this named insured\'s policy. Required for NAIC Annual Statement and state regulatory filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'Six-digit North American Industry Classification System (NAICS) code describing the primary business activity of the commercial named insured. Used for class-of-business rating and underwriting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namedInsuredStatus rdf:type rdf:Property ;
    rdfs:label 'Named Insured Status' ;
    rdfs:comment 'Current lifecycle status of this named insured on the policy. Active indicates coverage is in force; removed indicates the party was deleted by endorsement.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numEmployees rdf:type rdf:Property ;
    rdfs:label 'Num Employees' ;
    rdfs:comment 'Total number of full-time equivalent employees of the commercial named insured. Used as an underwriting (UW) eligibility factor and exposure indicator for workers compensation (WC) and GL.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phone rdf:type rdf:Property ;
    rdfs:label 'Phone' ;
    rdfs:comment 'Primary contact phone number for the named insured. Used for underwriting contact, claims first notice of loss (FNOL) intake, and billing communications.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Primary Address Line1' ;
    rdfs:comment 'First line of the named insured\'s primary mailing address as shown on the declarations page. Used for policy correspondence, premium billing, and regulatory filings.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Primary Address Line2' ;
    rdfs:comment 'Second line of the named insured\'s primary mailing address (suite, unit, floor, PO Box). Supplements address line 1 for complete address representation on the DEC.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCity rdf:type rdf:Property ;
    rdfs:label 'Primary City' ;
    rdfs:comment 'City of the named insured\'s primary mailing address. Used for territory rating, regulatory jurisdiction determination, and statutory reporting.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCountry rdf:type rdf:Property ;
    rdfs:label 'Primary Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the named insured\'s primary mailing address. Supports multinational commercial policies and IFRS 17 jurisdictional reporting.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryState rdf:type rdf:Property ;
    rdfs:label 'Primary State' ;
    rdfs:comment 'Two-letter US state code of the named insured\'s primary mailing address. Determines the governing state for policy issuance, rate filing, and regulatory compliance.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryZip rdf:type rdf:Property ;
    rdfs:label 'Primary Zip' ;
    rdfs:comment 'ZIP or ZIP+4 postal code of the named insured\'s primary mailing address. Used for territory rating, catastrophe (CAT) zone assignment, and USPS deliverability.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:removalReason rdf:type rdf:Property ;
    rdfs:label 'Removal Reason' ;
    rdfs:comment 'Reason code explaining why this named insured was removed from the policy. Populated only when status is removed or inactive; supports audit and regulatory compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sicCode rdf:type rdf:Property ;
    rdfs:label 'Sic Code' ;
    rdfs:comment 'Four-digit Standard Industrial Classification (SIC) code for the named insured\'s primary industry. Legacy classification used alongside NAICS for ISO rating and NAIC statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnMasked rdf:type rdf:Property ;
    rdfs:label 'Ssn Masked' ;
    rdfs:comment 'Masked Social Security Number (SSN) for individual named insureds, storing only the last four digits. Full SSN is stored in a restricted vault; this field supports identity verification without full exposure.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'State Of Incorporation' ;
    rdfs:comment 'Two-letter US state code where the commercial named insured is legally incorporated or domiciled. Drives jurisdictional form selection and regulatory compliance.' ;
    rdfs:domain ind:NamedInsured ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsInBusiness rdf:type rdf:Property ;
    rdfs:label 'Years In Business' ;
    rdfs:comment 'Number of years the commercial named insured has been continuously operating. Used as an underwriting (UW) rating factor for commercial lines eligibility and experience credit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sirRetentionId rdf:type rdf:Property ;
    rdfs:label 'Sir Retention Id' ;
    rdfs:comment 'FK to riskexposure.sir_retention.sir_retention_id — Links the coverage-side SIR layer to the risk-side SIR/large-deductible program so SIR erosion queries use a single authoritative retention record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SirRetention .

ind:aggregateSirCap rdf:type rdf:Property ;
    rdfs:label 'Aggregate Sir Cap' ;
    rdfs:comment 'Maximum cumulative SIR amount the insured is obligated to pay across all occurrences within the policy period before the insurer absorbs further losses.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alaeTreatment rdf:type rdf:Property ;
    rdfs:label 'Alae Treatment' ;
    rdfs:comment 'Specifies how ALAE is handled relative to the SIR: included within the retention amount, excluded entirely, or allocated pro-rata between insured and insurer.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsMadeFlag rdf:type rdf:Property ;
    rdfs:label 'Claims Made Flag' ;
    rdfs:comment 'Indicates whether the underlying policy is written on a claims-made basis (True) or occurrence basis (False), affecting SIR trigger and erosion timing.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Amount' ;
    rdfs:comment 'Dollar value of collateral posted by the insured to secure the SIR layer obligation, used for credit risk and financial security monitoring.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Collateral Expiry Date' ;
    rdfs:comment 'Date on which the collateral instrument securing the SIR obligation expires, triggering renewal or replacement requirements to maintain coverage continuity.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collateralRequired rdf:type rdf:Property ;
    rdfs:label 'Collateral Required' ;
    rdfs:comment 'Indicates whether the insurer requires the insured to post collateral (letter of credit, surety bond, or cash deposit) to secure the SIR obligation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralType rdf:type rdf:Property ;
    rdfs:label 'Collateral Type' ;
    rdfs:comment 'Type of financial security instrument posted by the insured to collateralize the SIR obligation, such as a letter of credit or surety bond.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defenseInsideSir rdf:type rdf:Property ;
    rdfs:label 'Defense Inside Sir' ;
    rdfs:comment 'Indicates whether Allocated Loss Adjustment Expenses (ALAE) and defense costs erode the SIR amount (True) or are paid outside and above the SIR (False).' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formEditionDate rdf:type rdf:Property ;
    rdfs:label 'Form Edition Date' ;
    rdfs:comment 'Edition date of the ISO or proprietary SIR endorsement form, used to identify the specific version of the form language governing the retention terms.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuredDefenseObligation rdf:type rdf:Property ;
    rdfs:label 'Insured Defense Obligation' ;
    rdfs:comment 'Indicates who controls and funds the legal defense within the SIR layer: the insured independently, the insurer, or a shared arrangement.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredFinancialRating rdf:type rdf:Property ;
    rdfs:label 'Insured Financial Rating' ;
    rdfs:comment 'Credit or financial strength rating of the insured entity (e.g., A.M. Best, S&P), used to assess the insured\'s ability to fund the SIR obligation.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerStatus rdf:type rdf:Property ;
    rdfs:label 'Layer Status' ;
    rdfs:comment 'Current lifecycle state of the SIR layer record, indicating whether the retention arrangement is operative, suspended, or terminated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumSirPremium rdf:type rdf:Property ;
    rdfs:label 'Minimum Sir Premium' ;
    rdfs:comment 'Minimum premium charged to the insured for the SIR layer arrangement, reflecting the insurer\'s administrative and risk management costs for the retention structure.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceAppliesAboveSir rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Applies Above Sir' ;
    rdfs:comment 'Indicates whether reinsurance treaty or facultative coverage attaches above the SIR layer, affecting net retained loss calculations and cession reporting.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riAttachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Ri Attachment Point' ;
    rdfs:comment 'Dollar threshold above the SIR at which reinsurance coverage attaches, defining the boundary between net retained risk and ceded risk.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sirAggregateErodedAmount rdf:type rdf:Property ;
    rdfs:label 'Sir Aggregate Eroded Amount' ;
    rdfs:comment 'Cumulative dollar amount of losses and/or ALAE that have eroded the aggregate SIR cap to date within the policy period, used for real-time retention monitoring.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sirPerOccurrenceErodedAmount rdf:type rdf:Property ;
    rdfs:label 'Sir Per Occurrence Eroded Amount' ;
    rdfs:comment 'Dollar amount of losses and/or ALAE that have eroded the per-occurrence SIR for the most recently tracked loss event, supporting claim-level retention accounting.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sirPremiumCredit rdf:type rdf:Property ;
    rdfs:label 'Sir Premium Credit' ;
    rdfs:comment 'Premium credit or reduction granted to the insured in exchange for accepting the SIR, representing the risk transfer value of the retention layer.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sirReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sir Reference Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier for this SIR layer record, used in policy documents, endorsements, and bordereaux reporting.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sirType rdf:type rdf:Property ;
    rdfs:label 'Sir Type' ;
    rdfs:comment 'Classifies the SIR structure as per-occurrence, per-claim, aggregate, or combined, determining how the retention threshold is measured and applied.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Uw Approval Date' ;
    rdfs:comment 'Date on which the underwriter formally approved this SIR layer, establishing the authorization timestamp for audit and compliance purposes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uwApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Uw Approval Required' ;
    rdfs:comment 'Indicates whether this SIR layer configuration requires explicit underwriting authority approval before binding, based on retention size or risk class.' ;
    rdfs:domain ind:SirLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverOfSubrogationId rdf:type rdf:Property ;
    rdfs:label 'Waiver Of Subrogation Id' ;
    rdfs:comment 'Unique surrogate identifier for the waiver of subrogation endorsement record on the Databricks Silver Layer.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentId rdf:type rdf:Property ;
    rdfs:label 'Document Id' ;
    rdfs:comment 'Reference identifier to the endorsement document stored in the content management system (OpenText or FileNet) for audit and compliance retrieval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:beneficiaryFein rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Fein' ;
    rdfs:comment 'Federal Employer Identification Number (FEIN) of the beneficiary organization, used for tax reporting and identity verification.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryRelationship rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Relationship' ;
    rdfs:comment 'Contractual or business relationship between the named insured and the waiver beneficiary (e.g., contractor, lessor). [ENUM-REF-CANDIDATE: additional_insured|contractor|subcontractor|lessor|lessee|mortgagee|owner|joint_venture|other — promote to reference' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blanketWaiverFlag rdf:type rdf:Property ;
    rdfs:label 'Blanket Waiver Flag' ;
    rdfs:comment 'Indicates whether this waiver of subrogation applies on a blanket basis to all parties with whom the insured has a written contract requiring such waiver.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractualRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Contractual Requirement Flag' ;
    rdfs:comment 'Indicates whether this waiver of subrogation was required by a written contract between the insured and the beneficiary prior to policy issuance.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionNotes rdf:type rdf:Property ;
    rdfs:label 'Exclusion Notes' ;
    rdfs:comment 'Free-text notes describing any exclusions or carve-outs from the waiver of subrogation, such as gross negligence or intentional acts exceptions.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationDescription rdf:type rdf:Property ;
    rdfs:label 'Location Description' ;
    rdfs:comment 'Free-text description of the insured location or job site address to which a location-specific waiver of subrogation is restricted.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectName rdf:type rdf:Property ;
    rdfs:label 'Project Name' ;
    rdfs:comment 'Name of the specific construction project, contract, or job site to which a project-specific waiver of subrogation applies. Null for blanket waivers.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNumber rdf:type rdf:Property ;
    rdfs:label 'Project Number' ;
    rdfs:comment 'External project or contract number associated with a project-specific waiver, enabling cross-reference to the insured\'s contract management system.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Status' ;
    rdfs:comment 'Current status of the regulatory form filing for this waiver endorsement with the applicable state Department of Insurance.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Source System Reference Code' ;
    rdfs:comment 'Native primary key or reference identifier of this waiver record in the originating policy administration system, used for data lineage and reconciliation.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationRightsDescription rdf:type rdf:Property ;
    rdfs:label 'Subrogation Rights Description' ;
    rdfs:comment 'Free-text description of the specific subrogation rights being waived, including any limitations or conditions on the scope of the waiver.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverType rdf:type rdf:Property ;
    rdfs:label 'Waiver Type' ;
    rdfs:comment 'Classification of the waiver of subrogation as blanket (all parties), specific (named party), contractual (per contract requirement), or statutory.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wcClassCode rdf:type rdf:Property ;
    rdfs:label 'Wc Class Code' ;
    rdfs:comment 'NCCI Workers Compensation (WC) class code applicable when the waiver is issued under a WC policy, driving the premium surcharge calculation.' ;
    rdfs:domain ind:WaiverOfSubrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:binderId rdf:type rdf:Property ;
    rdfs:label 'Binder Id' ;
    rdfs:comment 'Unique identifier for the temporary insurance binder record.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:binderProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Binder Producers Producer Id' ;
    rdfs:comment 'Reference to the agent or broker who issued the binder under binding authority.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:binderProducersProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Binder Producers Producers Producer Id' ;
    rdfs:comment 'Reference to the underwriter who authorized or will review the binder for policy conversion.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:bindingAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Id' ;
    rdfs:comment 'Reference to the binding authority agreement under which this binder was issued.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BindingAuthority .

ind:mailingStateId rdf:type rdf:Property ;
    rdfs:label 'Mailing State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Binder mailing state determines delivery compliance for binding authority documentation. FK to shared.state enables state-specific binder issuance rules.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:State .

ind:policyFormId rdf:type rdf:Property ;
    rdfs:label 'Policy Form Id' ;
    rdfs:comment 'Foreign key linking to policy.policy_form. Business justification: Binder references policy forms via form_numbers (denormalized STRING). Adding FK to primary policy_form enables proper form resolution.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyForm .

ind:quoteId rdf:type rdf:Property ;
    rdfs:label 'Quote Id' ;
    rdfs:comment 'Foreign key linking to policy.quote. Business justification: Binder is issued based on an accepted quote. Business flow: submission → quote → binder → policy. Tracking the originating quote provides critical lineage for the binder.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Quote .

ind:sourceBinderId rdf:type rdf:Property ;
    rdfs:label 'Source Binder Id' ;
    rdfs:comment 'Original binder identifier from the source system before transformation to enterprise standard.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Binder .

ind:submissionId rdf:type rdf:Property ;
    rdfs:label 'Submission Id' ;
    rdfs:comment 'Foreign key linking to policy.submission. Business justification: Binder originates from a submission (the application for coverage). Business flow: submission → quote → binder → policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Submission .

ind:binderStatus rdf:type rdf:Property ;
    rdfs:label 'Binder Status' ;
    rdfs:comment 'Current lifecycle status of the binder indicating whether it is active, converted to policy, or terminated.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Binding Timestamp' ;
    rdfs:comment 'Precise date and time when the binder was bound and coverage was confirmed by the producer.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:conversionDate rdf:type rdf:Property ;
    rdfs:label 'Conversion Date' ;
    rdfs:comment 'Date when the binder was converted to a formal policy, marking the end of temporary coverage status.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageSummary rdf:type rdf:Property ;
    rdfs:label 'Coverage Summary' ;
    rdfs:comment 'Brief narrative description of the coverages, limits, and perils included in the temporary binder.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declarationPageUrl rdf:type rdf:Property ;
    rdfs:label 'Declaration Page Url' ;
    rdfs:comment 'URL or document path to the binder declarations page stored in the document management system.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementNumbers rdf:type rdf:Property ;
    rdfs:label 'Endorsement Numbers' ;
    rdfs:comment 'Comma-separated list of endorsement form numbers modifying the standard binder coverage.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Premium Amount' ;
    rdfs:comment 'Preliminary premium amount charged for the temporary binder coverage period.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:formNumbers rdf:type rdf:Property ;
    rdfs:label 'Form Numbers' ;
    rdfs:comment 'Comma-separated list of ISO or proprietary form numbers attached to the binder for coverage terms.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line1' ;
    rdfs:comment 'Primary street address line for the insured party on the binder declarations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line2' ;
    rdfs:comment 'Secondary address line for suite, unit, or apartment number on the binder declarations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCity rdf:type rdf:Property ;
    rdfs:label 'Mailing City' ;
    rdfs:comment 'City name for the insured party mailing address on the binder.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Postal Code' ;
    rdfs:comment 'ZIP or postal code for the insured party mailing address on the binder.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namedInsured rdf:type rdf:Property ;
    rdfs:label 'Named Insured' ;
    rdfs:comment 'Full legal name of the primary insured party covered under this temporary binder.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perOccurrenceLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit Amount' ;
    rdfs:comment 'Maximum amount payable for any single occurrence or claim event under the binder.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryStateCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory State Code' ;
    rdfs:comment 'Two-letter code for the state Department of Insurance with jurisdiction over this binder.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Total Limit Amount' ;
    rdfs:comment 'Aggregate limit of liability provided under the binder across all covered perils and exposures.' ;
    rdfs:domain ind:Binder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:declarationsId rdf:type rdf:Property ;
    rdfs:label 'Declarations Id' ;
    rdfs:comment 'Unique identifier for the declarations page record.' ;
    rdfs:domain ind:Declarations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declarationsProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Declarations Producers Producer Id' ;
    rdfs:comment 'Reference to the producer entity who sold or serviced this policy.' ;
    rdfs:domain ind:Declarations ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:declarationsProducersProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Declarations Producers Producers Producer Id' ;
    rdfs:comment 'Reference to the underwriter who approved this policy.' ;
    rdfs:domain ind:Declarations ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:companyName rdf:type rdf:Property ;
    rdfs:label 'Company Name' ;
    rdfs:comment 'Legal name of the insurance company issuing this policy, as shown on the declarations page.' ;
    rdfs:domain ind:Declarations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageSummaryText rdf:type rdf:Property ;
    rdfs:label 'Coverage Summary Text' ;
    rdfs:comment 'High-level textual summary of coverages included in this policy, as displayed on the declarations page.' ;
    rdfs:domain ind:Declarations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decPageNumber rdf:type rdf:Property ;
    rdfs:label 'Dec Page Number' ;
    rdfs:comment 'Unique document control number assigned to this declarations page.' ;
    rdfs:domain ind:Declarations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decPageStatus rdf:type rdf:Property ;
    rdfs:label 'Dec Page Status' ;
    rdfs:comment 'Current lifecycle status of the declarations page document.' ;
    rdfs:domain ind:Declarations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentGeneratedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Document Generated Timestamp' ;
    rdfs:comment 'Timestamp when the declarations page document was generated.' ;
