ind:federalAidEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Eligible Flag' ;
    rdfs:comment 'Boolean indicator of whether the document is associated with a federally-funded project eligible for federal aid reimbursement.' ;
    rdfs:domain ind:Ncdot ;
