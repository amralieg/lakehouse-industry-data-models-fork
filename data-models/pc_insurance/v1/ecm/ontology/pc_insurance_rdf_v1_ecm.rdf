    rdfs:range xsd:decimal .

ind:parentOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Parent Org Unit Id' ;
    rdfs:comment 'Identifier of the parent organizational unit in the hierarchy, enabling multi-level organizational structures.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:budgetAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Amount' ;
    rdfs:comment 'Annual operating budget allocated to this organizational unit in the base currency.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orgUnitDescription rdf:type rdf:Property ;
    rdfs:label 'Org Unit Description' ;
    rdfs:comment 'Detailed narrative describing the organizational unit purpose, scope of operations, and business responsibilities.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headcount rdf:type rdf:Property ;
    rdfs:label 'Headcount' ;
    rdfs:comment 'Number of full-time equivalent employees assigned to this organizational unit.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isLicensed rdf:type rdf:Property ;
    rdfs:label 'Is Licensed' ;
    rdfs:comment 'Indicates whether this organizational unit holds active insurance licenses to transact business in its jurisdiction.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managerEmail rdf:type rdf:Property ;
    rdfs:label 'Manager Email' ;
    rdfs:comment 'Primary email address of the organizational unit manager for business communications.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerName rdf:type rdf:Property ;
    rdfs:label 'Manager Name' ;
    rdfs:comment 'Full name of the individual responsible for managing this organizational unit.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterCode rdf:type rdf:Property ;
    rdfs:label 'Profit Center Code' ;
    rdfs:comment 'General ledger profit center code used for revenue and profitability tracking for this organizational unit.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'Primary state or federal regulatory authority governing this organizational unit operations and compliance.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'IANA time zone identifier for the organizational unit location, used for scheduling and timestamp normalization.' ;
    rdfs:domain ind:Shared ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCode rdf:type rdf:Property ;
    rdfs:label 'Unit Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the organizational unit for reporting and system integration purposes.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitName rdf:type rdf:Property ;
    rdfs:label 'Unit Name' ;
    rdfs:comment 'Full business name of the organizational unit as used in internal communications and reporting.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitStatus rdf:type rdf:Property ;
    rdfs:label 'Unit Status' ;
    rdfs:comment 'Current operational status of the organizational unit in its lifecycle.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitType rdf:type rdf:Property ;
    rdfs:label 'Unit Type' ;
    rdfs:comment 'Classification of the organizational unit indicating its role in the enterprise structure.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeIndicator rdf:type rdf:Property ;
    rdfs:label 'Active Indicator' ;
    rdfs:comment 'Indicates whether the state record is currently active and available for policy issuance and regulatory operations.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catastropheExposureZone rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Exposure Zone' ;
    rdfs:comment 'Primary catastrophe exposure classification for the state used in underwriting and reinsurance placement. [ENUM-REF-CANDIDATE: Hurricane|Earthquake|Tornado|Flood|Wildfire|Multi-Peril|Low — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coastalStateIndicator rdf:type rdf:Property ;
    rdfs:label 'Coastal State Indicator' ;
    rdfs:comment 'Indicates whether the state has coastal exposure requiring special wind and flood underwriting considerations.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doiContactEmail rdf:type rdf:Property ;
    rdfs:label 'Doi Contact Email' ;
    rdfs:comment 'Primary contact email address for the state Department of Insurance.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiContactPhone rdf:type rdf:Property ;
    rdfs:label 'Doi Contact Phone' ;
    rdfs:comment 'Primary contact phone number for the state Department of Insurance.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiMailingAddress rdf:type rdf:Property ;
    rdfs:label 'Doi Mailing Address' ;
    rdfs:comment 'Full mailing address for the state Department of Insurance used for regulatory correspondence and filings.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiName rdf:type rdf:Property ;
    rdfs:label 'Doi Name' ;
    rdfs:comment 'Official name of the state Department of Insurance or equivalent regulatory authority.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Doi Website Url' ;
    rdfs:comment 'Official website URL for the state Department of Insurance for regulatory reference and filing access.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingSystemType rdf:type rdf:Property ;
    rdfs:label 'Filing System Type' ;
    rdfs:comment 'Type of regulatory filing system used by the state for rate and form submissions.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fipsCode rdf:type rdf:Property ;
    rdfs:label 'Fips Code' ;
    rdfs:comment 'Two-digit FIPS code assigned by the US Census Bureau for state identification.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formFilingRequirement rdf:type rdf:Property ;
    rdfs:label 'Form Filing Requirement' ;
    rdfs:comment 'Regulatory requirement type for insurance form filings in the state.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guarantyFundParticipation rdf:type rdf:Property ;
    rdfs:label 'Guaranty Fund Participation' ;
    rdfs:comment 'Indicates whether the state requires participation in the state guaranty fund for insurer insolvency protection.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoProgramParticipation rdf:type rdf:Property ;
    rdfs:label 'Iso Program Participation' ;
    rdfs:comment 'Indicates whether the state uses ISO rating programs and forms for property and casualty lines.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licensingAuthority rdf:type rdf:Property ;
    rdfs:label 'Licensing Authority' ;
    rdfs:comment 'Name of the state authority responsible for producer and adjuster licensing and appointments.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateName rdf:type rdf:Property ;
    rdfs:label 'State Name' ;
    rdfs:comment 'Full legal name of the state or territory.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncciParticipation rdf:type rdf:Property ;
    rdfs:label 'Ncci Participation' ;
    rdfs:comment 'Indicates whether the state participates in NCCI for workers compensation rating and statistical reporting.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:niprParticipation rdf:type rdf:Property ;
    rdfs:label 'Nipr Participation' ;
    rdfs:comment 'Indicates whether the state participates in NIPR for streamlined producer licensing and appointment processing.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateFilingRequirement rdf:type rdf:Property ;
    rdfs:label 'Rate Filing Requirement' ;
    rdfs:comment 'Regulatory requirement type for insurance rate filings in the state.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:region rdf:type rdf:Property ;
    rdfs:label 'Region' ;
    rdfs:comment 'Geographic region classification for the state or territory used for market segmentation and analysis. [ENUM-REF-CANDIDATE: Northeast|Southeast|Midwest|Southwest|West|Pacific|Territories — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualMarketMechanism rdf:type rdf:Property ;
    rdfs:label 'Residual Market Mechanism' ;
    rdfs:comment 'Name of the state residual market mechanism or assigned risk pool for high-risk placements.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stampingOfficeRequired rdf:type rdf:Property ;
    rdfs:label 'Stamping Office Required' ;
    rdfs:comment 'Indicates whether the state requires surplus lines policies to be stamped by a licensed stamping office.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statutoryReportingDeadline rdf:type rdf:Property ;
    rdfs:label 'Statutory Reporting Deadline' ;
    rdfs:comment 'Annual statutory financial statement filing deadline for the state, typically March 1 or state-specific date.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesTaxRate rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Tax Rate' ;
    rdfs:comment 'State surplus lines tax rate applied to non-admitted insurance placements, expressed as a decimal.' ;
    rdfs:domain ind:State ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Service Assignment Id' ;
    rdfs:comment 'Unique identifier for this service assignment record. Primary key.' ;
    rdfs:domain ind:ServiceAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'Date the vendor completed their service on the claim.' ;
    rdfs:domain ind:ServiceAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Invoice Amount' ;
    rdfs:comment 'Total amount invoiced by the vendor for services rendered on this assignment.' ;
    rdfs:domain ind:ServiceAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Performance rating assigned to the vendor for this specific assignment on a scale of 0.00 to 5.00.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Flag' ;
    rdfs:comment 'Indicates whether the vendor met service level agreement requirements for this assignment.' ;
    rdfs:domain ind:ServiceAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationConditionId rdf:type rdf:Property ;
    rdfs:label 'Location Condition Id' ;
    rdfs:comment 'Unique identifier for this location-condition association record. Primary key.' ;
    rdfs:domain ind:LocationCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyConditionId rdf:type rdf:Property ;
    rdfs:label 'Policy Condition Id' ;
    rdfs:comment 'Foreign key to the policy condition imposed on this location' ;
    rdfs:domain ind:LocationCondition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Condition .

ind:inspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Inspection Required Flag' ;
    rdfs:comment 'Indicator of whether physical inspection is required to verify compliance at this location' ;
    rdfs:domain ind:LocationCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Inspection Date' ;
    rdfs:comment 'Date of most recent inspection to verify condition compliance at this location' ;
    rdfs:domain ind:LocationCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vehicleFormApplicationId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Form Application Id' ;
    rdfs:comment 'Unique identifier for this vehicle form application record. Primary key.' ;
    rdfs:domain ind:VehicleFormApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formPolicyFormId rdf:type rdf:Property ;
    rdfs:label 'Form Policy Form Id' ;
    rdfs:comment 'Foreign key linking to the policy form applied to this vehicle' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyForm .

ind:applicationReason rdf:type rdf:Property ;
    rdfs:label 'Application Reason' ;
    rdfs:comment 'Business reason why this form was applied to the vehicle: new business, renewal, endorsement, mid-term change, or regulatory requirement' ;
    rdfs:domain ind:VehicleFormApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleFormApplicationStatus rdf:type rdf:Property ;
    rdfs:label 'Vehicle Form Application Status' ;
    rdfs:comment 'Current lifecycle status of this form application: active, pending approval, expired, cancelled, or superseded by newer version' ;
    rdfs:domain ind:VehicleFormApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumCessionAllocationId rdf:type rdf:Property ;
    rdfs:label 'Premium Cession Allocation Id' ;
    rdfs:comment 'Unique identifier for each premium cession allocation record' ;
    rdfs:domain ind:PremiumCessionAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Premium Amount' ;
    rdfs:comment 'Dollar amount of premium from the policy transaction allocated to this ceded premium transaction' ;
    rdfs:domain ind:PremiumCessionAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationCreatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Allocation Created By User Code' ;
    rdfs:comment 'User identifier of the reinsurance accountant who created this allocation record' ;
    rdfs:domain ind:PremiumCessionAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Allocation Created Timestamp' ;
    rdfs:comment 'System timestamp when this premium allocation record was created' ;
    rdfs:domain ind:PremiumCessionAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:allocationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Effective Date' ;
    rdfs:comment 'Date when this premium allocation becomes effective for reinsurance accounting purposes' ;
    rdfs:domain ind:PremiumCessionAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumAllocationBasis rdf:type rdf:Property ;
    rdfs:label 'Premium Allocation Basis' ;
    rdfs:comment 'Method used to allocate premium between policy and ceded transactions: written basis, earned basis, pro-rata, or risk-attaching basis' ;
    rdfs:domain ind:PremiumCessionAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageCessionId rdf:type rdf:Property ;
    rdfs:label 'Coverage Cession Id' ;
    rdfs:comment 'Unique surrogate identifier for each coverage-cession allocation record.' ;
    rdfs:domain ind:CoverageCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageCessionStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Cession Status' ;
    rdfs:comment 'Current lifecycle state of this coverage-cession allocation, supporting workflow management and audit trails.' ;
    rdfs:domain ind:CoverageCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageLayerAllocation rdf:type rdf:Property ;
    rdfs:label 'Coverage Layer Allocation' ;
    rdfs:comment 'Identifies the reinsurance layer or structure to which this coverage is allocated under this cession, such as primary, working excess, or catastrophe excess.' ;
    rdfs:domain ind:CoverageCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimPerilCausationId rdf:type rdf:Property ;
    rdfs:label 'Claim Peril Causation Id' ;
    rdfs:comment 'Unique identifier for this claim-peril causation record' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:determinedByAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Determined By Adjuster Id' ;
    rdfs:comment 'Reference to the adjuster who made the peril causation determination' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:causationSequenceOrder rdf:type rdf:Property ;
    rdfs:label 'Causation Sequence Order' ;
    rdfs:comment 'Order in which this peril occurred in the chain of causation for sequential loss events' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimPerilCausationStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Peril Causation Status' ;
    rdfs:comment 'Current status of the peril causation determination in the adjudication workflow' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concurrentCausationFlag rdf:type rdf:Property ;
    rdfs:label 'Concurrent Causation Flag' ;
    rdfs:comment 'Indicates whether this peril operated concurrently with other perils to cause loss' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Coverage Applicable Flag' ;
    rdfs:comment 'Indicates whether coverage applies for this peril based on policy terms and exclusions' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionReason rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason' ;
    rdfs:comment 'Specific policy exclusion clause or reason coverage was denied for this peril' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossCauseDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Loss Cause Determination Date' ;
    rdfs:comment 'Date when the adjuster determined this peril contributed to the loss event' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:perilContributionPercentage rdf:type rdf:Property ;
    rdfs:label 'Peril Contribution Percentage' ;
    rdfs:comment 'Percentage of total loss attributed to this peril for apportionment purposes' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proximateCauseFlag rdf:type rdf:Property ;
    rdfs:label 'Proximate Cause Flag' ;
    rdfs:comment 'Indicates whether this peril is the proximate cause of loss under coverage doctrine' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subrogationTargetFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Target Flag' ;
    rdfs:comment 'Indicates whether this peril causation supports subrogation against a responsible third party' ;
    rdfs:domain ind:ClaimPerilCausation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cessionId rdf:type rdf:Property ;
    rdfs:label 'Cession Id' ;
    rdfs:comment 'Unique surrogate primary key for each coverage cession record.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commissionPct rdf:type rdf:Property ;
    rdfs:label 'Commission Pct' ;
    rdfs:comment 'Commission percentage paid by the reinsurer to the ceding company on ceded premium.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facultativeCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Facultative Certificate Number' ;
    rdfs:comment 'Certificate number for facultative reinsurance placement, if this cession is facultative rather than treaty.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formFilingId rdf:type rdf:Property ;
    rdfs:label 'Form Filing Id' ;
    rdfs:comment 'Unique identifier for the form filing record' ;
    rdfs:domain ind:FormFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicableStates rdf:type rdf:Property ;
    rdfs:label 'Applicable States' ;
    rdfs:comment 'Comma-separated list of US state codes where this form is approved for use, such as CA,NY,TX. Empty if approved nationwide. [Moved from policy_form: This comma-separated list is a denormalized representation of the many-to-many relationship.' ;
    rdfs:domain ind:FormFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityTerritoryId rdf:type rdf:Property ;
    rdfs:label 'Authority Territory Id' ;
    rdfs:comment 'Unique surrogate identifier for this binding authority territory record' ;
    rdfs:domain ind:AuthorityTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aggregateLimitPerState rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Per State' ;
    rdfs:comment 'Maximum total gross written premium or total insured value the producer may bind annually within this state' ;
    rdfs:domain ind:AuthorityTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxPolicyLimitPerState rdf:type rdf:Property ;
    rdfs:label 'Max Policy Limit Per State' ;
    rdfs:comment 'State-specific ceiling on the total insured value or per-occurrence policy limit the producer may bind' ;
    rdfs:domain ind:AuthorityTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumTaxRateOverride rdf:type rdf:Property ;
    rdfs:label 'Premium Tax Rate Override' ;
    rdfs:comment 'State-specific premium tax rate override applicable to policies bound under this authority in this state' ;
    rdfs:domain ind:AuthorityTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateApprovalDate rdf:type rdf:Property ;
    rdfs:label 'State Approval Date' ;
    rdfs:comment 'Date on which the state Department of Insurance approved this binding authority for operation in the state' ;
    rdfs:domain ind:AuthorityTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateFilingReference rdf:type rdf:Property ;
    rdfs:label 'State Filing Reference' ;
    rdfs:comment 'Regulatory filing reference number or approval code issued by the state DOI for this binding authority' ;
    rdfs:domain ind:AuthorityTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleClaimantInvolvementId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Claimant Involvement Id' ;
    rdfs:comment 'Unique identifier for the vehicle-claimant involvement record. Primary key.' ;
    rdfs:domain ind:VehicleClaimantInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:driverAtTimeOfLoss rdf:type rdf:Property ;
    rdfs:label 'Driver At Time Of Loss' ;
    rdfs:comment 'Indicates whether this claimant was the driver of this vehicle at the time of the loss event.' ;
    rdfs:domain ind:VehicleClaimantInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:injuryCausedByVehicle rdf:type rdf:Property ;
    rdfs:label 'Injury Caused By Vehicle' ;
    rdfs:comment 'Description of injury or damage this claimant sustained specifically from this vehicle.' ;
    rdfs:domain ind:VehicleClaimantInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToInsured rdf:type rdf:Property ;
    rdfs:label 'Relationship To Insured' ;
    rdfs:comment 'Relationship of this claimant to the named insured of this vehicle at time of loss.' ;
    rdfs:domain ind:VehicleClaimantInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleOccupantPosition rdf:type rdf:Property ;
    rdfs:label 'Vehicle Occupant Position' ;
    rdfs:comment 'Position of the claimant in or relative to this vehicle at time of loss.' ;
    rdfs:domain ind:VehicleClaimantInvolvement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationClaimantInterestId rdf:type rdf:Property ;
    rdfs:label 'Location Claimant Interest Id' ;
    rdfs:comment 'Unique surrogate identifier for the location-claimant interest record. Primary key.' ;
    rdfs:domain ind:LocationClaimantInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:injuryLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Injury Location Description' ;
    rdfs:comment 'Narrative description of where within the insured location the claimant sustained injury or damage (e.g., parking lot, loading dock, second floor hallway). Supports premises liability claims.' ;
    rdfs:domain ind:LocationClaimantInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationClaimantInterestStatus rdf:type rdf:Property ;
