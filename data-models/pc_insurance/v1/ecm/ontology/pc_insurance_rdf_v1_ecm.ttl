ind:templateDescription rdf:type rdf:Property ;
    rdfs:label 'Template Description' ;
    rdfs:comment 'Detailed description of the notice template purpose, usage, and business context.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateFormat rdf:type rdf:Property ;
    rdfs:label 'Template Format' ;
    rdfs:comment 'Format of the notice template content, such as HTML, PDF, plain text, XML, or JSON.' ;
    rdfs:domain ind:NoticeTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateName rdf:type rdf:Property ;
    rdfs:label 'Template Name' ;
    rdfs:comment 'Human-readable name of the notice template describing its purpose.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageCount rdf:type rdf:Property ;
