ind:subcontractorPayrollAmount rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Payroll Amount' ;
    rdfs:comment 'Payroll amount for uninsured subcontractors included in this classification, subject to WC premium calculation if certificates not provided.' ;
    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terrorismRate rdf:type rdf:Property ;
    rdfs:label 'Terrorism Rate' ;
    rdfs:comment 'Additional rate per hundred dollars of payroll for terrorism coverage under TRIA, if applicable to this classification.' ;
    rdfs:domain ind:WcPayrollClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calendarDate rdf:type rdf:Property ;
    rdfs:label 'Calendar Date' ;
    rdfs:comment 'The specific date represented in this calendar record.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catSeasonIndicator rdf:type rdf:Property ;
    rdfs:label 'Cat Season Indicator' ;
    rdfs:comment 'Indicates the active catastrophe season for this date, used for catastrophe exposure management and reinsurance treaty activation.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dayName rdf:type rdf:Property ;
    rdfs:label 'Day Name' ;
    rdfs:comment 'The full name of the day of the week, used for human-readable reporting and operational dashboards. [ENUM-REF-CANDIDATE: Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dayOfMonth rdf:type rdf:Property ;
    rdfs:label 'Day Of Month' ;
    rdfs:comment 'The day number within the calendar month (1-31), used for billing cycle and payment due date calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayOfWeek rdf:type rdf:Property ;
    rdfs:label 'Day Of Week' ;
    rdfs:comment 'The day of the week as a numeric value (1=Monday, 7=Sunday), used for operational scheduling and claims intake patterns.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayOfYear rdf:type rdf:Property ;
    rdfs:label 'Day Of Year' ;
    rdfs:comment 'The ordinal day number within the calendar year (1-366), used for daily premium earning and exposure calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysInMonth rdf:type rdf:Property ;
    rdfs:label 'Days In Month' ;
    rdfs:comment 'The total number of days in the calendar month (28-31), used for pro-rata premium calculations and daily earning factors.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysInYear rdf:type rdf:Property ;
    rdfs:label 'Days In Year' ;
    rdfs:comment 'The total number of days in the calendar year (365 or 366 for leap years), used for annual premium earning and exposure calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Month' ;
    rdfs:comment 'The fiscal month within the fiscal year (1-12), used for monthly accounting close and premium earning calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period End Date' ;
    rdfs:comment 'The end date of the fiscal period to which this calendar date belongs, used for period cutoff and financial close validation.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fiscalPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period Start Date' ;
    rdfs:comment 'The start date of the fiscal period to which this calendar date belongs, used for period-to-date calculations and reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'The fiscal quarter within the fiscal year (1-4), used for quarterly financial and regulatory reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalWeek rdf:type rdf:Property ;
    rdfs:label 'Fiscal Week' ;
    rdfs:comment 'The fiscal week number within the fiscal year (1-53), used for operational reporting and performance tracking.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'The fiscal year to which this date belongs, used for financial reporting and statutory compliance.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holidayName rdf:type rdf:Property ;
    rdfs:label 'Holiday Name' ;
    rdfs:comment 'The name of the holiday if this date is a recognized holiday, used for operational planning and customer communication.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBusinessDay rdf:type rdf:Property ;
    rdfs:label 'Is Business Day' ;
    rdfs:comment 'Indicates whether this date is a business day (excluding weekends and holidays), used for payment processing and SLA calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCurrent rdf:type rdf:Property ;
    rdfs:label 'Is Current' ;
    rdfs:comment 'Indicates whether this calendar record is the current active version, used for filtering to the most recent calendar configuration.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHoliday rdf:type rdf:Property ;
    rdfs:label 'Is Holiday' ;
    rdfs:comment 'Indicates whether this date is a recognized company or statutory holiday, used for payment processing and service level agreements.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLeapYear rdf:type rdf:Property ;
    rdfs:label 'Is Leap Year' ;
    rdfs:comment 'Indicates whether the calendar year is a leap year (366 days), used for accurate daily premium earning and exposure day calculations.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMonthEnd rdf:type rdf:Property ;
    rdfs:label 'Is Month End' ;
    rdfs:comment 'Indicates whether this date is the last day of the calendar month, used for monthly accounting close and premium earning cutoffs.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isQuarterEnd rdf:type rdf:Property ;
    rdfs:label 'Is Quarter End' ;
    rdfs:comment 'Indicates whether this date is the last day of the fiscal quarter, used for quarterly financial reporting and regulatory filings.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWeekend rdf:type rdf:Property ;
    rdfs:label 'Is Weekend' ;
    rdfs:comment 'Indicates whether this date falls on a weekend (Saturday or Sunday), used for operational scheduling and staffing models.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isYearEnd rdf:type rdf:Property ;
    rdfs:label 'Is Year End' ;
    rdfs:comment 'Indicates whether this date is the last day of the fiscal year, used for annual statutory reporting and year-end close processes.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:month rdf:type rdf:Property ;
    rdfs:label 'Month' ;
    rdfs:comment 'The calendar month within the calendar year (1-12), used for policy effective dates and renewal cycles.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monthName rdf:type rdf:Property ;
    rdfs:label 'Month Name' ;
    rdfs:comment 'The full name of the calendar month, used for human-readable reporting and executive dashboards. [ENUM-REF-CANDIDATE: January|February|March|April|May|June|July|August|September|October|November|December — 12 candidates stripped; promote to reference' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quarter rdf:type rdf:Property ;
    rdfs:label 'Quarter' ;
    rdfs:comment 'The calendar quarter within the calendar year (1-4), used for market analysis and external benchmarking.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:week rdf:type rdf:Property ;
    rdfs:label 'Week' ;
    rdfs:comment 'The calendar week number within the calendar year (1-53), used for operational scheduling and resource planning.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'Indicates whether the country is currently active for underwriting, claims processing, and reinsurance operations. Inactive countries are retained for historical policy and claims data.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:addressFormatStandard rdf:type rdf:Property ;
    rdfs:label 'Address Format Standard' ;
    rdfs:comment 'Standard address format convention for the country. Used for policy declarations, claims correspondence, and regulatory filings to ensure proper mail delivery.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catExposureZone rdf:type rdf:Property ;
    rdfs:label 'Cat Exposure Zone' ;
    rdfs:comment 'Catastrophe risk exposure classification for the country. Used for CAT XL (Catastrophe Excess of Loss) treaty structuring, PML calculations, and underwriting guidelines.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continentCode rdf:type rdf:Property ;
    rdfs:label 'Continent Code' ;
    rdfs:comment 'Two-letter continent code where the country is located. Used for high-level geographic risk aggregation and PML (Probable Maximum Loss) analysis. [ENUM-REF-CANDIDATE: AF|AN|AS|EU|NA|OC|SA — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyRegime rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Regime' ;
    rdfs:comment 'Primary data privacy and protection regulatory framework applicable in the country. Governs PII handling, consent requirements, and breach notification for policyholders and claimants.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fullName rdf:type rdf:Property ;
    rdfs:label 'Full Name' ;
    rdfs:comment 'Complete official name of the country including formal designations. Used for legal documents, treaties, and statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoAlpha2Code rdf:type rdf:Property ;
    rdfs:label 'Iso Alpha 2 Code' ;
    rdfs:comment 'Two-letter country code as defined by ISO 3166-1 alpha-2 standard. Used for addresses, reinsurer domicile, and party identification.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoAlpha3Code rdf:type rdf:Property ;
    rdfs:label 'Iso Alpha 3 Code' ;
    rdfs:comment 'Three-letter country code as defined by ISO 3166-1 alpha-3 standard. Used for regulatory reporting and reinsurance bordereaux.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoNumericCode rdf:type rdf:Property ;
    rdfs:label 'Iso Numeric Code' ;
    rdfs:comment 'Three-digit numeric country code as defined by ISO 3166-1 numeric standard. Used for systems requiring numeric identifiers.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicCountryCode rdf:type rdf:Property ;
    rdfs:label 'Naic Country Code' ;
    rdfs:comment 'Country code used in NAIC statutory reporting and annual statement filings. Required for Schedule P, Schedule F, and reinsurance disclosures.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryName rdf:type rdf:Property ;
    rdfs:label 'Country Name' ;
    rdfs:comment 'Official short name of the country in English as recognized by ISO 3166. Used for display in policy documents, claims correspondence, and regulatory filings.' ;
    rdfs:domain ind:Shared ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneCountryCode rdf:type rdf:Property ;
    rdfs:label 'Phone Country Code' ;
    rdfs:comment 'International telephone dialing code prefix for the country. Used for FNOL (First Notice of Loss) contact validation and producer communication.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCodeFormat rdf:type rdf:Property ;
    rdfs:label 'Postal Code Format' ;
    rdfs:comment 'Regular expression pattern defining valid postal code formats for the country. Used for address validation in policy issuance, claims processing, and producer onboarding.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryJurisdictionType rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction Type' ;
    rdfs:comment 'Classification of the country for insurance regulatory purposes. Determines surplus lines tax treatment, alien insurer requirements, and DOI (Department of Insurance) reporting obligations.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceDomicileFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Domicile Flag' ;
    rdfs:comment 'Indicates whether the country is a recognized domicile for reinsurers. Used for credit for reinsurance determinations and collateral requirements under NAIC guidelines.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsStatus rdf:type rdf:Property ;
    rdfs:label 'Sanctions Status' ;
    rdfs:comment 'Current economic sanctions status applicable to the country. Impacts underwriting eligibility, reinsurance placement restrictions, and claims payment compliance under OFAC regulations.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sovereigntyStatus rdf:type rdf:Property ;
    rdfs:label 'Sovereignty Status' ;
    rdfs:comment 'Classification of the country\'s political sovereignty status. Impacts regulatory jurisdiction, treaty applicability, and reinsurance placement authority.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subregionCode rdf:type rdf:Property ;
    rdfs:label 'Subregion Code' ;
    rdfs:comment 'UN geographic subregion classification code. Used for granular risk segmentation and regulatory compliance reporting.' ;
    rdfs:domain ind:Country ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayFormat rdf:type rdf:Property ;
    rdfs:label 'Display Format' ;
    rdfs:comment 'Standard display format pattern for monetary amounts in this currency (e.g., $#,##0.00 for USD, €#.##0,00 for EUR).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCrypto rdf:type rdf:Property ;
    rdfs:label 'Is Crypto' ;
    rdfs:comment 'Indicates whether this is a cryptocurrency or digital asset rather than a fiat currency.' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoCode rdf:type rdf:Property ;
    rdfs:label 'Iso Code' ;
    rdfs:comment 'Three-letter alphabetic ISO 4217 currency code (e.g., USD, EUR, GBP, CAD, JPY).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minorUnit rdf:type rdf:Property ;
    rdfs:label 'Minor Unit' ;
    rdfs:comment 'Number of decimal places for the minor unit (e.g., 2 for cents in USD, 0 for JPY which has no minor unit).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currencyName rdf:type rdf:Property ;
    rdfs:label 'Currency Name' ;
    rdfs:comment 'Full official name of the currency (e.g., United States Dollar, Euro, British Pound Sterling).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numericCode rdf:type rdf:Property ;
    rdfs:label 'Numeric Code' ;
    rdfs:comment 'Three-digit numeric ISO 4217 currency code (e.g., 840 for USD, 978 for EUR).' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roundingMethod rdf:type rdf:Property ;
    rdfs:label 'Rounding Method' ;
    rdfs:comment 'Standard rounding method applied to monetary calculations in this currency.' ;
    rdfs:domain ind:Currency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric sort order for displaying currencies in user interfaces and reports (lower numbers appear first).' ;
    rdfs:domain ind:Shared ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsMadeBasisFlag rdf:type rdf:Property ;
    rdfs:label 'Claims Made Basis Flag' ;
    rdfs:comment 'Indicates whether this line is typically written on a claims-made basis (true) versus occurrence basis (false).' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lobCodeDescription rdf:type rdf:Property ;
    rdfs:label 'Lob Code Description' ;
    rdfs:comment 'Detailed description of the line of business including coverage scope, typical insureds, and key characteristics.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gaapAccountingLine rdf:type rdf:Property ;
    rdfs:label 'Gaap Accounting Line' ;
    rdfs:comment 'GAAP accounting line classification for financial statement reporting under US GAAP or IFRS 17.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdmitted rdf:type rdf:Property ;
    rdfs:label 'Is Admitted' ;
    rdfs:comment 'Indicates whether this line of business is written on an admitted basis (true) or surplus lines basis (false).' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMonoline rdf:type rdf:Property ;
    rdfs:label 'Is Monoline' ;
    rdfs:comment 'Indicates whether this line is typically written as a standalone monoline policy (true) or part of a package (false).' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPackageEligible rdf:type rdf:Property ;
    rdfs:label 'Is Package Eligible' ;
    rdfs:comment 'Indicates whether this line can be included in commercial package policies (CPP, BOP).' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoLineCode rdf:type rdf:Property ;
    rdfs:label 'Iso Line Code' ;
    rdfs:comment 'ISO standard line of business code used for rating and statistical reporting.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Lob Abbreviation' ;
    rdfs:comment 'Short abbreviation for the line of business used in operational systems and reporting.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobCategory rdf:type rdf:Property ;
    rdfs:label 'Lob Category' ;
    rdfs:comment 'High-level category classifying the line of business (personal, commercial, specialty, reinsurance).' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobStatus rdf:type rdf:Property ;
    rdfs:label 'Lob Status' ;
    rdfs:comment 'Current operational status of the line of business in the system.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobType rdf:type rdf:Property ;
    rdfs:label 'Lob Type' ;
    rdfs:comment 'Classification of the line by coverage type (property, casualty, liability, auto, workers compensation, package).' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longTailFlag rdf:type rdf:Property ;
