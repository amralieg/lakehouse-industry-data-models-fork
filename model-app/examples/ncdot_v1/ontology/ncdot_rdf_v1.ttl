ind:tipEligible rdf:type rdf:Property ;
    rdfs:label 'Tip Eligible' ;
    rdfs:comment 'Indicates whether projects in this procurement category are eligible for inclusion in regional Transportation Improvement Programs (TIP) through MPOs or RPOs.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lettingCycle rdf:type rdf:Property ;
    rdfs:label 'Letting Cycle' ;
    rdfs:comment 'Standard letting cycle frequency for contracts in this procurement category (monthly, quarterly, etc.). Letting refers to the public bidding process.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageProcurementLeadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Average Procurement Lead Time Days' ;
    rdfs:comment 'Typical number of days from requisition to contract award for purchases in this category. Used for planning and scheduling.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresSafetyPlan rdf:type rdf:Property ;
    rdfs:label 'Requires Safety Plan' ;
    rdfs:comment 'Indicates whether contractors must submit and maintain a safety plan for work in this procurement category per OSHA and NCDOT requirements.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresTrafficControlPlan rdf:type rdf:Property ;
    rdfs:label 'Requires Traffic Control Plan' ;
    rdfs:comment 'Indicates whether projects in this category require a traffic control plan (TCP) or maintenance of traffic (MOT) plan for work zone safety.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresErosionControl rdf:type rdf:Property ;
    rdfs:label 'Requires Erosion Control' ;
    rdfs:comment 'Indicates whether projects in this category require erosion and sediment control plans and best management practices per environmental regulations.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Approval Threshold Amount' ;
    rdfs:comment 'Dollar threshold above which higher-level approval authority is required for purchases in this category.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredVendorListRequired rdf:type rdf:Property ;
    rdfs:label 'Preferred Vendor List Required' ;
    rdfs:comment 'Indicates whether purchases in this category must be made from a pre-approved preferred vendor list or state contract.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cooperativePurchasingEligible rdf:type rdf:Property ;
    rdfs:label 'Cooperative Purchasing Eligible' ;
    rdfs:comment 'Indicates whether this category is eligible for cooperative purchasing agreements with other government agencies or consortiums.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyProcurementEligible rdf:type rdf:Property ;
    rdfs:label 'Emergency Procurement Eligible' ;
    rdfs:comment 'Indicates whether this category can be procured through expedited emergency procurement procedures when urgent needs arise.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:smallPurchaseThreshold rdf:type rdf:Property ;
    rdfs:label 'Small Purchase Threshold' ;
    rdfs:comment 'Dollar threshold below which simplified small purchase procedures can be used for this category without formal competitive bidding.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresVendorRegistration rdf:type rdf:Property ;
    rdfs:label 'Requires Vendor Registration' ;
    rdfs:comment 'Indicates whether vendors must be registered with NCDOT or the state procurement system before bidding on contracts in this category.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsCreditCardPayment rdf:type rdf:Property ;
    rdfs:label 'Allows Credit Card Payment' ;
    rdfs:comment 'Indicates whether purchases in this category can be paid using procurement credit cards (P-cards) subject to dollar limits.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditCardLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Card Limit Amount' ;
    rdfs:comment 'Maximum dollar amount that can be charged to a procurement credit card for purchases in this category.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresCostBenefitAnalysis rdf:type rdf:Property ;
    rdfs:label 'Requires Cost Benefit Analysis' ;
    rdfs:comment 'Indicates whether purchases above certain thresholds in this category require formal cost-benefit analysis documentation.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sustainabilityCriteriaRequired rdf:type rdf:Property ;
    rdfs:label 'Sustainability Criteria Required' ;
    rdfs:comment 'Indicates whether environmental sustainability criteria must be considered in vendor selection for this procurement category.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recycledContentRequired rdf:type rdf:Property ;
    rdfs:label 'Recycled Content Required' ;
    rdfs:comment 'Indicates whether materials in this category must contain minimum recycled content per environmental regulations.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumRecycledContentPercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Recycled Content Percentage' ;
    rdfs:comment 'Minimum percentage of recycled content required for materials in this category when recycled content requirements apply.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowsSoleSource rdf:type rdf:Property ;
    rdfs:label 'Allows Sole Source' ;
    rdfs:comment 'Indicates whether sole source procurement (non-competitive) is permitted for this category under specific justification circumstances.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:soleSourceJustificationRequired rdf:type rdf:Property ;
    rdfs:label 'Sole Source Justification Required' ;
    rdfs:comment 'Indicates whether written justification and approval are required for sole source procurements in this category.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:purchaseRequisitionId rdf:type rdf:Property ;
    rdfs:label 'Purchase Requisition Id' ;
    rdfs:comment 'Unique identifier for the purchase requisition record. Primary key for the purchase requisition entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PurchaseRequisition .

ind:requisitionType rdf:type rdf:Property ;
    rdfs:label 'Requisition Type' ;
    rdfs:comment 'Classification of the purchase requisition indicating the procurement method and approval workflow required.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Required Delivery Date' ;
    rdfs:comment 'Date by which the requested materials or services must be delivered to meet project or operational needs.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requesterEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Requester Employee Id' ;
    rdfs:comment 'Employee identifier of the person who initiated the purchase requisition, typically from Beacon HR system.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:budgetSource rdf:type rdf:Property ;
    rdfs:label 'Budget Source' ;
    rdfs:comment 'Primary source of funding for the requisition (state appropriation, federal funds, grant, bond proceeds, etc.).' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalArea rdf:type rdf:Property ;
    rdfs:label 'Functional Area' ;
    rdfs:comment 'SAP functional area code used for cross-organizational cost allocation and reporting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipProjectFlag rdf:type rdf:Property ;
    rdfs:label 'Stip Project Flag' ;
    rdfs:comment 'Indicator whether the requisition is associated with a project included in the State Transportation Improvement Program.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalAidFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Flag' ;
    rdfs:comment 'Indicator whether the requisition involves federal funding and requires federal compliance and reporting.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:solicitationType rdf:type rdf:Property ;
    rdfs:label 'Solicitation Type' ;
    rdfs:comment 'Type of formal solicitation document to be issued (Request for Proposal, Request for Qualifications, Invitation for Bids, Request for Information).' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedContractValue rdf:type rdf:Property ;
    rdfs:label 'Estimated Contract Value' ;
    rdfs:comment 'Estimated total value of the contract to be awarded, including all options and extensions if applicable.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:smallPurchaseFlag rdf:type rdf:Property ;
    rdfs:label 'Small Purchase Flag' ;
    rdfs:comment 'Indicator whether the requisition qualifies as a small purchase under simplified procurement thresholds.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyProcurementFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Procurement Flag' ;
    rdfs:comment 'Indicator whether the requisition is for emergency procurement requiring expedited processing and waiver of normal procedures.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:soleSourceFlag rdf:type rdf:Property ;
    rdfs:label 'Sole Source Flag' ;
    rdfs:comment 'Indicator whether the requisition is for sole source procurement from a single vendor without competition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:soleSourceJustification rdf:type rdf:Property ;
    rdfs:label 'Sole Source Justification' ;
    rdfs:comment 'Detailed justification explaining why sole source procurement is necessary and appropriate, required for approval.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredVendorId rdf:type rdf:Property ;
    rdfs:label 'Preferred Vendor Id' ;
    rdfs:comment 'SAP vendor master identifier for a preferred or suggested vendor, if applicable.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:preferredVendorName rdf:type rdf:Property ;
    rdfs:label 'Preferred Vendor Name' ;
    rdfs:comment 'Name of the preferred or suggested vendor for the requisition, if applicable.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hubParticipationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Hub Participation Required Flag' ;
    rdfs:comment 'Indicator whether Historically Underutilized Business participation is required for this requisition under state policy.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mbeParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Mbe Participation Flag' ;
    rdfs:comment 'Indicator whether Minority Business Enterprise participation is encouraged or required for this requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wbeParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Wbe Participation Flag' ;
    rdfs:comment 'Indicator whether Women Business Enterprise participation is encouraged or required for this requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Delivery Address Line1' ;
    rdfs:comment 'First line of the delivery address where requested materials or equipment should be shipped.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Delivery Address Line2' ;
    rdfs:comment 'Second line of the delivery address (building, suite, department) for material delivery.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryCity rdf:type rdf:Property ;
    rdfs:label 'Delivery City' ;
    rdfs:comment 'City name for the delivery location of requested materials or services.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryState rdf:type rdf:Property ;
    rdfs:label 'Delivery State' ;
    rdfs:comment 'Two-letter state code for the delivery location, typically NC for North Carolina.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryZipCode rdf:type rdf:Property ;
    rdfs:label 'Delivery Zip Code' ;
    rdfs:comment 'ZIP code or ZIP+4 code for the delivery location.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryCounty rdf:type rdf:Property ;
    rdfs:label 'Delivery County' ;
    rdfs:comment 'County name for the delivery location within North Carolina.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryContactName rdf:type rdf:Property ;
    rdfs:label 'Delivery Contact Name' ;
    rdfs:comment 'Name of the person to contact at the delivery location for receiving materials.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Delivery Contact Phone' ;
    rdfs:comment 'Phone number of the delivery contact person for coordination and notification.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingInstructions rdf:type rdf:Property ;
    rdfs:label 'Shipping Instructions' ;
    rdfs:comment 'Special instructions for shipping, handling, or delivery of the requested materials.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerEmail rdf:type rdf:Property ;
    rdfs:label 'Buyer Email' ;
    rdfs:comment 'Email address of the assigned procurement buyer for communication regarding the requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverLevel1Name rdf:type rdf:Property ;
    rdfs:label 'Approver Level 1 Name' ;
    rdfs:comment 'Name of the first-level approver (typically supervisor or manager) in the requisition approval workflow.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverLevel1Date rdf:type rdf:Property ;
    rdfs:label 'Approver Level 1 Date' ;
    rdfs:comment 'Date when the first-level approver approved the requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approverLevel2Name rdf:type rdf:Property ;
    rdfs:label 'Approver Level 2 Name' ;
    rdfs:comment 'Name of the second-level approver (typically division director or budget officer) in the approval workflow.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverLevel2Date rdf:type rdf:Property ;
    rdfs:label 'Approver Level 2 Date' ;
    rdfs:comment 'Date when the second-level approver approved the requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetApproverName rdf:type rdf:Property ;
    rdfs:label 'Budget Approver Name' ;
    rdfs:comment 'Name of the budget officer or financial manager who approved the budget allocation for the requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Budget Approval Date' ;
    rdfs:comment 'Date when budget approval was granted for the requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalApproverName rdf:type rdf:Property ;
    rdfs:label 'Final Approver Name' ;
    rdfs:comment 'Name of the final approver who authorized the requisition for conversion to purchase order.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Final Approval Date' ;
    rdfs:comment 'Date when final approval was granted and the requisition was authorized for procurement.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectedByName rdf:type rdf:Property ;
    rdfs:label 'Rejected By Name' ;
    rdfs:comment 'Name of the approver who rejected the requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseOrderDate rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Date' ;
    rdfs:comment 'Date when the purchase order was created from the approved requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lineItemCount rdf:type rdf:Property ;
    rdfs:label 'Line Item Count' ;
    rdfs:comment 'Total number of line items (individual materials or services) included in the purchase requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:environmentalComplianceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Required Flag' ;
    rdfs:comment 'Indicator whether the requisition requires environmental compliance review or permits (NEPA, Clean Water Act, etc.).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nepaClearanceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Nepa Clearance Required Flag' ;
    rdfs:comment 'Indicator whether NEPA environmental clearance is required before procurement can proceed.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilityCoordinationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Utility Coordination Required Flag' ;
    rdfs:comment 'Indicator whether utility coordination and relocation is required for the project associated with this requisition.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qaQcRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Qa Qc Required Flag' ;
    rdfs:comment 'Indicator whether formal quality assurance and quality control procedures are required for the procurement.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prevailingWageRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Prevailing Wage Required Flag' ;
    rdfs:comment 'Indicator whether prevailing wage requirements apply to the contract (Davis-Bacon Act for federal-aid projects).' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buyAmericaRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Buy America Required Flag' ;
    rdfs:comment 'Indicator whether Buy America provisions apply requiring domestic steel and manufactured products for federal-aid projects.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:arraFundedFlag rdf:type rdf:Property ;
    rdfs:label 'Arra Funded Flag' ;
    rdfs:comment 'Indicator whether the requisition is funded by ARRA or similar economic stimulus program with special reporting requirements.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialProvisions rdf:type rdf:Property ;
    rdfs:label 'Special Provisions' ;
    rdfs:comment 'Any special contractual provisions, requirements, or conditions that apply to the procurement.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancelledDate rdf:type rdf:Property ;
    rdfs:label 'Cancelled Date' ;
    rdfs:comment 'Date when the requisition was cancelled before conversion to purchase order.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractId rdf:type rdf:Property ;
    rdfs:label 'Contract Id' ;
    rdfs:comment 'Unique identifier for the contract record. Primary key for the contract entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:solicitationMethod rdf:type rdf:Property ;
    rdfs:label 'Solicitation Method' ;
    rdfs:comment 'The procurement method used to solicit and award the contract. IFB (Invitation for Bids) is used for price-based selection, RFP (Request for Proposal) for qualifications and technical approach, RFQ (Request for Qualifications) for professional services.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:solicitationNumber rdf:type rdf:Property ;
    rdfs:label 'Solicitation Number' ;
    rdfs:comment 'Unique identifier for the solicitation (IFB, RFP, or RFQ) that resulted in this contract award.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Date when the contract was formally executed and signed by all parties, establishing legal enforceability.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalValue rdf:type rdf:Property ;
    rdfs:label 'Original Value' ;
    rdfs:comment 'The initial total monetary value of the contract as awarded, before any amendments or change orders.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentValue rdf:type rdf:Property ;
    rdfs:label 'Current Value' ;
    rdfs:comment 'The current total monetary value of the contract including all approved amendments, change orders, and modifications.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:committedAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Amount' ;
    rdfs:comment 'Total amount committed or encumbered against the contract for financial planning and budget tracking purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidToDateAmount rdf:type rdf:Property ;
    rdfs:label 'Paid To Date Amount' ;
    rdfs:comment 'Cumulative amount paid to the contractor from contract inception through the current date.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Frequency' ;
    rdfs:comment 'Frequency at which payments are processed and issued to the contractor.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retainagePercentage rdf:type rdf:Property ;
    rdfs:label 'Retainage Percentage' ;
    rdfs:comment 'Percentage of each payment withheld by NCDOT until contract completion to ensure satisfactory performance and completion of all work.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retainageAmount rdf:type rdf:Property ;
    rdfs:label 'Retainage Amount' ;
    rdfs:comment 'Total dollar amount currently held in retainage, to be released upon satisfactory contract completion and acceptance.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentBondRequired rdf:type rdf:Property ;
    rdfs:label 'Payment Bond Required' ;
    rdfs:comment 'Indicates whether a payment bond is required to ensure payment to subcontractors and suppliers.' ;
    rdfs:domain ind:Procurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentBondAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Bond Amount' ;
    rdfs:comment 'Dollar amount of the payment bond required to protect subcontractors and material suppliers.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidBondAmount rdf:type rdf:Property ;
    rdfs:label 'Bid Bond Amount' ;
    rdfs:comment 'Dollar amount of the bid bond submitted with the contractor\'s bid to guarantee they will enter into the contract if selected.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hubParticipationRequired rdf:type rdf:Property ;
