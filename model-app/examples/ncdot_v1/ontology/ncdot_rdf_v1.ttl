    rdfs:domain ind:Depreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'The program or project code associated with the asset for tracking depreciation by program or initiative.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
