ind:beneficiaryPercentage rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Percentage' ;
    rdfs:comment 'Percentage of benefit allocated to this beneficiary (for plans allowing multiple beneficiaries).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dependentCount rdf:type rdf:Property ;
    rdfs:label 'Dependent Count' ;
    rdfs:comment 'Number of dependents covered under this benefit enrollment.' ;
