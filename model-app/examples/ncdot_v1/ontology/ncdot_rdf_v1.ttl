ind:fundingSourceName rdf:type rdf:Property ;
    rdfs:label 'Funding Source Name' ;
    rdfs:comment 'Descriptive name of the funding source providing the allocated funds.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
