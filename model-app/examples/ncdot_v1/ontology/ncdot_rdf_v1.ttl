    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaveTypeCode rdf:type rdf:Property ;
    rdfs:label 'Leave Type Code' ;
    rdfs:comment 'Standardized code representing the type of leave requested (e.g., annual, sick, FMLA, military, bereavement).' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
