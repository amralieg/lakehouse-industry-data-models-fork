    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualifyingEventType rdf:type rdf:Property ;
    rdfs:label 'Qualifying Event Type' ;
    rdfs:comment 'Type of qualifying life event that triggered a mid-year enrollment change (marriage, divorce, birth, adoption, death, loss of other coverage, employment status change, address change, dependent aging out, other).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifyingEventDate rdf:type rdf:Property ;
    rdfs:label 'Qualifying Event Date' ;
    rdfs:comment 'Date when the qualifying life event occurred that allowed the enrollment change.' ;
