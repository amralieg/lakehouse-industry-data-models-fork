    rdfs:comment 'Indicates whether the vehicle has been modified for wheelchair accessibility in compliance with ADA requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:airbagCount rdf:type rdf:Property ;
    rdfs:label 'Airbag Count' ;
    rdfs:comment 'Total number of airbags installed in the vehicle as a safety feature.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:absFlag rdf:type rdf:Property ;
    rdfs:label 'Abs Flag' ;
    rdfs:comment 'Indicates whether the vehicle is equipped with anti-lock braking system.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Record Last Updated Date' ;
    rdfs:comment 'Date when the vehicle record was most recently updated in the DMV system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeId rdf:type rdf:Property ;
    rdfs:label 'Fee Id' ;
    rdfs:comment 'Unique identifier for the fee record in the DMV fee reference table.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fee .

ind:code rdf:type rdf:Property ;
    rdfs:label 'Code' ;
    rdfs:comment 'Standardized alphanumeric code representing the fee type (e.g., DL01 for driver license issuance, REG01 for vehicle registration).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:name rdf:type rdf:Property ;
    rdfs:label 'Name' ;
    rdfs:comment 'Official name of the fee as it appears on DMV documentation and receipts.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:description rdf:type rdf:Property ;
    rdfs:label 'Description' ;
    rdfs:comment 'Detailed description of the fee purpose, applicability, and any special conditions or exemptions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:category rdf:type rdf:Property ;
    rdfs:label 'Category' ;
    rdfs:comment 'High-level classification of the fee type (e.g., license, registration, title, inspection).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcategory rdf:type rdf:Property ;
    rdfs:label 'Subcategory' ;
    rdfs:comment 'More granular classification within the fee category (e.g., original issuance, renewal, replacement, transfer).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'Standard fee amount charged in US dollars for the service or transaction.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Amount' ;
    rdfs:comment 'Minimum fee amount applicable when the fee is variable or calculated based on specific criteria.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Amount' ;
    rdfs:comment 'Maximum fee amount applicable when the fee is variable or has a statutory cap.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'Method used to calculate the fee amount (e.g., fixed, weight-based for vehicle registration, value-based for title transfer).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleClass rdf:type rdf:Property ;
    rdfs:label 'Vehicle Class' ;
    rdfs:comment 'Vehicle classification to which this fee applies (e.g., passenger, motorcycle, commercial, trailer). Null if not vehicle-specific.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdlIndicator rdf:type rdf:Property ;
    rdfs:label 'Cdl Indicator' ;
    rdfs:comment 'Indicates whether this fee applies specifically to Commercial Driver License (CDL) transactions.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statutoryReference rdf:type rdf:Property ;
    rdfs:label 'Statutory Reference' ;
    rdfs:comment 'North Carolina General Statute (NCGS) citation that establishes the legal authority and amount for this fee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Code' ;
    rdfs:comment 'Accounting code used to classify and track revenue from this fee in the state financial system.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundCode rdf:type rdf:Property ;
    rdfs:label 'Fund Code' ;
    rdfs:comment 'State fund to which revenue from this fee is allocated (e.g., Highway Fund, Highway Trust Fund, General Fund).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionMethod rdf:type rdf:Property ;
    rdfs:label 'Distribution Method' ;
    rdfs:comment 'Method by which fee revenue is distributed across state funds or agencies (e.g., single fund, split between multiple funds, formula-based allocation).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethodsAccepted rdf:type rdf:Property ;
    rdfs:label 'Payment Methods Accepted' ;
    rdfs:comment 'Comma-separated list of payment methods accepted for this fee (e.g., cash, check, credit card, debit card, electronic funds transfer).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onlinePaymentEligible rdf:type rdf:Property ;
    rdfs:label 'Online Payment Eligible' ;
    rdfs:comment 'Indicates whether this fee can be paid through the DMV online portal or web applications.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refundableIndicator rdf:type rdf:Property ;
    rdfs:label 'Refundable Indicator' ;
    rdfs:comment 'Indicates whether this fee is refundable under certain conditions (e.g., duplicate payment, service not rendered).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverEligible rdf:type rdf:Property ;
    rdfs:label 'Waiver Eligible' ;
    rdfs:comment 'Indicates whether this fee is eligible for waiver under specific circumstances (e.g., military service, disability, hardship).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverConditions rdf:type rdf:Property ;
    rdfs:label 'Waiver Conditions' ;
    rdfs:comment 'Description of conditions under which the fee may be waived (e.g., active military duty, Purple Heart recipient, disabled veteran).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptionCriteria rdf:type rdf:Property ;
    rdfs:label 'Exemption Criteria' ;
    rdfs:comment 'Criteria that qualify an individual or entity for exemption from this fee (e.g., government vehicles, certain nonprofit organizations).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRevisionDate rdf:type rdf:Property ;
    rdfs:label 'Last Revision Date' ;
    rdfs:comment 'Date of the most recent revision to the fee amount, structure, or applicability.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revisionAuthority rdf:type rdf:Property ;
    rdfs:label 'Revision Authority' ;
    rdfs:comment 'Authority responsible for the most recent fee revision (e.g., NC General Assembly, NCDOT Commissioner, DMV Director).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceChannel rdf:type rdf:Property ;
    rdfs:label 'Service Channel' ;
    rdfs:comment 'Comma-separated list of channels through which this fee can be collected (e.g., DMV office, online portal, mail, contracted agent, kiosk).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequency rdf:type rdf:Property ;
    rdfs:label 'Frequency' ;
    rdfs:comment 'Frequency at which the fee is charged (e.g., one-time, annual, biennial, quinquennial for 5-year licenses).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prorationAllowed rdf:type rdf:Property ;
    rdfs:label 'Proration Allowed' ;
    rdfs:comment 'Indicates whether the fee can be prorated based on partial service period (e.g., mid-year vehicle registration).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prorationMethod rdf:type rdf:Property ;
    rdfs:label 'Proration Method' ;
    rdfs:comment 'Method used to calculate prorated fee amount (e.g., monthly, quarterly, daily). Null if proration not allowed.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latePenaltyApplicable rdf:type rdf:Property ;
    rdfs:label 'Late Penalty Applicable' ;
    rdfs:comment 'Indicates whether late penalties or additional fees apply if this fee is not paid by the due date.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latePenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Late Penalty Amount' ;
    rdfs:comment 'Fixed late penalty amount charged when payment is not received by the due date. Null if late penalty is percentage-based or not applicable.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:latePenaltyPercentage rdf:type rdf:Property ;
    rdfs:label 'Late Penalty Percentage' ;
    rdfs:comment 'Percentage-based late penalty applied to the original fee amount. Null if late penalty is fixed amount or not applicable.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after the due date before late penalties are assessed. Null if no grace period exists.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processingPriority rdf:type rdf:Property ;
    rdfs:label 'Processing Priority' ;
    rdfs:comment 'Processing priority level associated with this fee (e.g., standard processing, expedited service, emergency issuance).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expeditedFeeIndicator rdf:type rdf:Property ;
    rdfs:label 'Expedited Fee Indicator' ;
    rdfs:comment 'Indicates whether this is an additional fee charged for expedited or rush processing of a service.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:convenienceFeeIndicator rdf:type rdf:Property ;
    rdfs:label 'Convenience Fee Indicator' ;
    rdfs:comment 'Indicates whether this is a convenience fee charged for using specific payment methods or service channels (e.g., credit card processing fee).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyVendor rdf:type rdf:Property ;
    rdfs:label 'Third Party Vendor' ;
    rdfs:comment 'Name of third-party vendor or contractor involved in fee collection or service delivery. Null if service is provided directly by DMV.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorPortionAmount rdf:type rdf:Property ;
    rdfs:label 'Vendor Portion Amount' ;
    rdfs:comment 'Portion of the fee amount retained by third-party vendor or contractor. Null if no third-party involvement.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statePortionAmount rdf:type rdf:Property ;
    rdfs:label 'State Portion Amount' ;
    rdfs:comment 'Portion of the fee amount retained by the state after vendor fees and distribution. Null if entire amount goes to state.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Federal Reporting Required' ;
    rdfs:comment 'Indicates whether revenue from this fee must be reported to federal agencies (e.g., FHWA, FTA) for compliance or funding purposes.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalProgramCode rdf:type rdf:Property ;
    rdfs:label 'Federal Program Code' ;
    rdfs:comment 'Federal program or funding source code associated with this fee for reporting purposes. Null if not federally related.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Frequency' ;
    rdfs:comment 'Frequency at which this fee is subject to internal or external audit review.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compensationPaymentId rdf:type rdf:Property ;
    rdfs:label 'Compensation Payment Id' ;
    rdfs:comment 'Unique identifier for the compensation payment transaction issued to a landowner for acquired or easement-impacted property.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompensationPayment .

ind:paymentCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Payment Currency Code' ;
    rdfs:comment 'The ISO 4217 three-letter currency code for the payment transaction, typically USD for NCDOT transactions.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'The classification of compensation payment based on the nature of property impact and acquisition type.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentCategory rdf:type rdf:Property ;
    rdfs:label 'Payment Category' ;
    rdfs:comment 'The broad category of compensation payment aligned with federal and state right-of-way acquisition regulations.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'The sequential check number assigned to the physical or electronic check used for payment disbursement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'The date on which the payment transaction was cleared through the banking system and funds were successfully transferred.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wireTransferReference rdf:type rdf:Property ;
    rdfs:label 'Wire Transfer Reference' ;
    rdfs:comment 'The unique reference number assigned to wire transfer transactions for tracking and reconciliation purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Number' ;
    rdfs:comment 'The account number for escrow arrangements where compensation funds are held pending resolution of title or legal issues.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAgentName rdf:type rdf:Property ;
    rdfs:label 'Escrow Agent Name' ;
    rdfs:comment 'The name of the third-party escrow agent or title company managing escrowed compensation funds.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negotiatedAmount rdf:type rdf:Property ;
    rdfs:label 'Negotiated Amount' ;
    rdfs:comment 'The final compensation amount agreed upon through negotiation between NCDOT and the property owner, which may differ from the initial appraisal.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'The date on which the property owner accepted NCDOT\'s compensation offer for the property acquisition.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:condemnationFlag rdf:type rdf:Property ;
    rdfs:label 'Condemnation Flag' ;
    rdfs:comment 'Boolean flag indicating whether the property acquisition required condemnation proceedings through eminent domain authority.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:courtAwardAmount rdf:type rdf:Property ;
    rdfs:label 'Court Award Amount' ;
    rdfs:comment 'The compensation amount determined by the court in condemnation proceedings, which may differ from the initial offer.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementFlag rdf:type rdf:Property ;
    rdfs:label 'Settlement Flag' ;
    rdfs:comment 'Boolean flag indicating whether the compensation payment represents an administrative settlement reached outside of court proceedings.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acreageAcquired rdf:type rdf:Property ;
    rdfs:label 'Acreage Acquired' ;
    rdfs:comment 'The total land area in acres acquired from the property owner for the transportation project.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:squareFootageAcquired rdf:type rdf:Property ;
    rdfs:label 'Square Footage Acquired' ;
    rdfs:comment 'The total land area in square feet acquired from the property owner, typically used for smaller urban parcels.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyAddress rdf:type rdf:Property ;
    rdfs:label 'Property Address' ;
    rdfs:comment 'The street address of the property from which rights were acquired for the transportation project.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyCity rdf:type rdf:Property ;
    rdfs:label 'Property City' ;
    rdfs:comment 'The city or municipality where the acquired property is located.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyCounty rdf:type rdf:Property ;
    rdfs:label 'Property County' ;
    rdfs:comment 'The North Carolina county in which the acquired property is located.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyZipCode rdf:type rdf:Property ;
    rdfs:label 'Property Zip Code' ;
    rdfs:comment 'The postal ZIP code for the acquired property location.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highwayRouteNumber rdf:type rdf:Property ;
    rdfs:label 'Highway Route Number' ;
    rdfs:comment 'The state or federal highway route number for the transportation corridor requiring the right-of-way acquisition.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milepostBegin rdf:type rdf:Property ;
    rdfs:label 'Milepost Begin' ;
    rdfs:comment 'The starting milepost location along the highway route where the acquired property rights begin.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:milepostEnd rdf:type rdf:Property ;
    rdfs:label 'Milepost End' ;
    rdfs:comment 'The ending milepost location along the highway route where the acquired property rights terminate.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:districtNumber rdf:type rdf:Property ;
    rdfs:label 'District Number' ;
    rdfs:comment 'The highway district number within the NCDOT division responsible for project delivery.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:federalShareAmount rdf:type rdf:Property ;
    rdfs:label 'Federal Share Amount' ;
    rdfs:comment 'The portion of the compensation payment funded by federal transportation funds.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateShareAmount rdf:type rdf:Property ;
    rdfs:label 'State Share Amount' ;
    rdfs:comment 'The portion of the compensation payment funded by North Carolina state transportation funds.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localShareAmount rdf:type rdf:Property ;
    rdfs:label 'Local Share Amount' ;
    rdfs:comment 'The portion of the compensation payment funded by local government or municipal funds.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCode rdf:type rdf:Property ;
    rdfs:label 'Budget Code' ;
    rdfs:comment 'The budget account code or cost center charged for the compensation payment in the financial system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generalLedgerAccount rdf:type rdf:Property ;
    rdfs:label 'General Ledger Account' ;
    rdfs:comment 'The general ledger account number in the financial system where the compensation payment is recorded.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElement rdf:type rdf:Property ;
    rdfs:label 'Wbs Element' ;
    rdfs:comment 'The SAP project system WBS element identifying the specific project phase or work package charged for the compensation payment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentItem rdf:type rdf:Property ;
    rdfs:label 'Commitment Item' ;
    rdfs:comment 'The budget commitment item number in SAP representing the encumbered funds for the compensation payment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Authorization Number' ;
    rdfs:comment 'The internal authorization or approval number required before disbursing the compensation payment.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Date' ;
    rdfs:comment 'The date on which the compensation payment was officially authorized for disbursement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processedBy rdf:type rdf:Property ;
    rdfs:label 'Processed By' ;
    rdfs:comment 'The name or identifier of the NCDOT staff member who processed the compensation payment transaction in the financial system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relocationAssistanceFlag rdf:type rdf:Property ;
    rdfs:label 'Relocation Assistance Flag' ;
    rdfs:comment 'Boolean flag indicating whether this payment includes relocation assistance benefits under the Uniform Relocation Act.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relocationAssistanceAmount rdf:type rdf:Property ;
    rdfs:label 'Relocation Assistance Amount' ;
    rdfs:comment 'The portion of the compensation payment allocated for relocation assistance benefits to displaced persons or businesses.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessDamagesAmount rdf:type rdf:Property ;
    rdfs:label 'Business Damages Amount' ;
    rdfs:comment 'The compensation amount paid for business losses or damages resulting from the property acquisition or construction activities.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:severanceDamagesAmount rdf:type rdf:Property ;
    rdfs:label 'Severance Damages Amount' ;
    rdfs:comment 'The compensation amount paid for diminished value of the remaining property after partial acquisition.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consequentialDamagesAmount rdf:type rdf:Property ;
    rdfs:label 'Consequential Damages Amount' ;
    rdfs:comment 'The compensation amount paid for indirect damages or losses resulting from the property acquisition or project construction.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestAmount rdf:type rdf:Property ;
    rdfs:label 'Interest Amount' ;
    rdfs:comment 'The interest amount paid to the property owner for delayed compensation payments as required by law.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'The annual interest rate applied to calculate interest on delayed compensation payments.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestStartDate rdf:type rdf:Property ;
    rdfs:label 'Interest Start Date' ;
    rdfs:comment 'The date from which interest begins accruing on the compensation payment.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attorneyFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Attorney Fees Amount' ;
    rdfs:comment 'The amount paid for the property owner\'s attorney fees when awarded by the court in condemnation proceedings.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expertWitnessFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Expert Witness Fees Amount' ;
    rdfs:comment 'The amount paid for expert witness fees incurred by the property owner in condemnation proceedings.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:titleCostsAmount rdf:type rdf:Property ;
    rdfs:label 'Title Costs Amount' ;
    rdfs:comment 'The amount paid for title examination, title insurance, and closing costs associated with the property acquisition.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordingFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Recording Fees Amount' ;
    rdfs:comment 'The amount paid for recording fees to register the deed or easement with the county register of deeds.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxWithholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Amount' ;
    rdfs:comment 'The amount withheld from the compensation payment for federal or state tax obligations.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'The net compensation amount disbursed to the payee after all deductions, withholdings, and adjustments.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentNotes rdf:type rdf:Property ;
    rdfs:label 'Payment Notes' ;
    rdfs:comment 'Free-text notes or comments regarding special circumstances, conditions, or details about the compensation payment.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'The reason or explanation for voiding or cancelling the compensation payment transaction.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'The date on which the compensation payment was voided or cancelled in the financial system.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reissueFlag rdf:type rdf:Property ;
    rdfs:label 'Reissue Flag' ;
    rdfs:comment 'Boolean flag indicating whether this payment is a reissued payment replacing a previous voided or returned payment.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalPaymentNumber rdf:type rdf:Property ;
    rdfs:label 'Original Payment Number' ;
    rdfs:comment 'The payment number of the original transaction when this payment is a reissue or replacement.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Document Number' ;
    rdfs:comment 'The unique SAP financial document number assigned to the compensation payment transaction in the SAP FI module.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapPostingDate rdf:type rdf:Property ;
    rdfs:label 'Sap Posting Date' ;
    rdfs:comment 'The accounting posting date in SAP when the compensation payment transaction was recorded to the general ledger.' ;
    rdfs:domain ind:CompensationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sapCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Sap Company Code' ;
    rdfs:comment 'The SAP company code representing the legal entity responsible for the compensation payment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailReference rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Reference' ;
    rdfs:comment 'A reference identifier linking the compensation payment to audit documentation and compliance records.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Flag' ;
    rdfs:comment 'Boolean flag indicating whether this compensation payment has undergone federal or state compliance review.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Date' ;
    rdfs:comment 'The date on which the compensation payment underwent compliance review for federal or state requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:classCode rdf:type rdf:Property ;
    rdfs:label 'Class Code' ;
    rdfs:comment 'Short alphanumeric code representing the vehicle classification used in registration and titling systems. This code is used for system processing and fee calculation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:className rdf:type rdf:Property ;
    rdfs:label 'Class Name' ;
    rdfs:comment 'Full descriptive name of the vehicle classification (e.g., Passenger Car, Commercial Truck, Motorcycle, Trailer).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classDescription rdf:type rdf:Property ;
    rdfs:label 'Class Description' ;
    rdfs:comment 'Detailed description of the vehicle classification including defining characteristics, weight ranges, usage types, and regulatory criteria.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classCategory rdf:type rdf:Property ;
    rdfs:label 'Class Category' ;
    rdfs:comment 'High-level category grouping for the vehicle class used for reporting and policy application.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhwaVehicleType rdf:type rdf:Property ;
    rdfs:label 'Fhwa Vehicle Type' ;
    rdfs:comment 'Federal Highway Administration standard vehicle type classification code (1-13) used for federal reporting and traffic monitoring.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightClass rdf:type rdf:Property ;
    rdfs:label 'Weight Class' ;
    rdfs:comment 'Weight-based classification of the vehicle (light, medium, heavy, extra heavy) used for fee calculation and road use regulations.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumWeightLbs rdf:type rdf:Property ;
    rdfs:label 'Minimum Weight Lbs' ;
    rdfs:comment 'Minimum gross vehicle weight in pounds for this classification. Used to determine eligibility for the class.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumWeightLbs rdf:type rdf:Property ;
    rdfs:label 'Maximum Weight Lbs' ;
    rdfs:comment 'Maximum gross vehicle weight in pounds for this classification. Used to determine eligibility for the class.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresCdl rdf:type rdf:Property ;
    rdfs:label 'Requires Cdl' ;
    rdfs:comment 'Indicates whether operating a vehicle in this class requires a Commercial Driver License (CDL).' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdlClassRequired rdf:type rdf:Property ;
    rdfs:label 'Cdl Class Required' ;
    rdfs:comment 'Specific CDL class required to operate vehicles in this classification (Class A, B, C, or none).' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Title Fee Amount' ;
    rdfs:comment 'Standard title fee amount in US dollars for vehicles in this classification.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Plate Fee Amount' ;
    rdfs:comment 'Standard license plate fee amount in US dollars for vehicles in this classification.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:highwayUseTaxRate rdf:type rdf:Property ;
    rdfs:label 'Highway Use Tax Rate' ;
    rdfs:comment 'Highway use tax rate (as decimal percentage) applied to vehicles in this classification at time of title transfer.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresInspection rdf:type rdf:Property ;
    rdfs:label 'Requires Inspection' ;
    rdfs:comment 'Indicates whether vehicles in this class are required to undergo periodic safety inspections through the North Carolina Vehicle Inspection Program (NCVIP).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Months' ;
    rdfs:comment 'Required frequency of safety inspections in months for vehicles in this classification (e.g., 12 for annual, 24 for biennial).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresEmissionsTest rdf:type rdf:Property ;
    rdfs:label 'Requires Emissions Test' ;
    rdfs:comment 'Indicates whether vehicles in this class are required to undergo emissions testing in applicable counties.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registrationPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Registration Period Months' ;
    rdfs:comment 'Standard registration period in months for vehicles in this classification (typically 12 for annual registration).' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCommercial rdf:type rdf:Property ;
    rdfs:label 'Is Commercial' ;
    rdfs:comment 'Indicates whether this vehicle class is designated as commercial, subject to commercial vehicle regulations and oversight.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isForHire rdf:type rdf:Property ;
    rdfs:label 'Is For Hire' ;
    rdfs:comment 'Indicates whether vehicles in this class are used for-hire (transporting passengers or goods for compensation).' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresInsurance rdf:type rdf:Property ;
    rdfs:label 'Requires Insurance' ;
    rdfs:comment 'Indicates whether vehicles in this class are required to maintain liability insurance coverage.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumInsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Insurance Amount' ;
    rdfs:comment 'Minimum required liability insurance coverage amount in US dollars for vehicles in this classification.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelTypeRestriction rdf:type rdf:Property ;
    rdfs:label 'Fuel Type Restriction' ;
    rdfs:comment 'Fuel type restriction or designation for vehicles in this classification, if applicable.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:axleCountMinimum rdf:type rdf:Property ;
    rdfs:label 'Axle Count Minimum' ;
    rdfs:comment 'Minimum number of axles for vehicles in this classification.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:axleCountMaximum rdf:type rdf:Property ;
    rdfs:label 'Axle Count Maximum' ;
    rdfs:comment 'Maximum number of axles for vehicles in this classification.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passengerCapacityMinimum rdf:type rdf:Property ;
    rdfs:label 'Passenger Capacity Minimum' ;
    rdfs:comment 'Minimum designed passenger seating capacity for vehicles in this classification.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passengerCapacityMaximum rdf:type rdf:Property ;
    rdfs:label 'Passenger Capacity Maximum' ;
    rdfs:comment 'Maximum designed passenger seating capacity for vehicles in this classification.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isExemptFromPropertyTax rdf:type rdf:Property ;
    rdfs:label 'Is Exempt From Property Tax' ;
    rdfs:comment 'Indicates whether vehicles in this class are exempt from local property tax assessments.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyTaxRate rdf:type rdf:Property ;
    rdfs:label 'Property Tax Rate' ;
    rdfs:comment 'Standard property tax rate (as decimal percentage) applied to vehicles in this classification, if applicable.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roadUseRestriction rdf:type rdf:Property ;
    rdfs:label 'Road Use Restriction' ;
    rdfs:comment 'Road use restrictions applicable to vehicles in this classification (e.g., limited access highways only, local roads only).' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:speedLimitRestrictionMph rdf:type rdf:Property ;
    rdfs:label 'Speed Limit Restriction Mph' ;
    rdfs:comment 'Maximum speed limit in miles per hour for vehicles in this classification, if a class-specific restriction applies.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresSpecialPermit rdf:type rdf:Property ;
    rdfs:label 'Requires Special Permit' ;
    rdfs:comment 'Indicates whether vehicles in this class require special permits for operation (e.g., oversize/overweight permits).' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permitTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Permit Type Required' ;
    rdfs:comment 'Type of special permit required for vehicles in this classification, if applicable (e.g., oversize, overweight, hazmat).' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSubjectToDotRegulations rdf:type rdf:Property ;
    rdfs:label 'Is Subject To Dot Regulations' ;
    rdfs:comment 'Indicates whether vehicles in this class are subject to federal Department of Transportation safety regulations.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresDotNumber rdf:type rdf:Property ;
    rdfs:label 'Requires Dot Number' ;
    rdfs:comment 'Indicates whether vehicles in this class must display a USDOT number for interstate commerce.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresMcNumber rdf:type rdf:Property ;
    rdfs:label 'Requires Mc Number' ;
    rdfs:comment 'Indicates whether vehicles in this class require a Motor Carrier (MC) number for for-hire interstate transportation.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatEligible rdf:type rdf:Property ;
    rdfs:label 'Hazmat Eligible' ;
    rdfs:comment 'Indicates whether vehicles in this class are eligible to transport hazardous materials with proper endorsements and permits.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByClassCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Class Code' ;
    rdfs:comment 'Vehicle class code that supersedes or replaces this classification, if this class has been deprecated.' ;
    rdfs:domain ind:VehicleClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric sort order for displaying vehicle classifications in user interfaces and reports.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isDefault rdf:type rdf:Property ;
    rdfs:label 'Is Default' ;
    rdfs:comment 'Indicates whether this is the default vehicle classification for a given category when class cannot be determined.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appointmentId rdf:type rdf:Property ;
    rdfs:label 'Appointment Id' ;
    rdfs:comment 'Unique identifier for the DMV appointment record. Primary key for the appointment entity.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Confirmation Number' ;
    rdfs:comment 'Citizen-facing confirmation number provided when the appointment is scheduled. Used for appointment lookup and verification.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceType rdf:type rdf:Property ;
    rdfs:label 'Service Type' ;
    rdfs:comment 'Type of DMV service requested for the appointment. Determines the service window duration and required documentation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceCategory rdf:type rdf:Property ;
    rdfs:label 'Service Category' ;
    rdfs:comment 'High-level categorization of the DMV service type for reporting and resource allocation purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'The date on which the appointment is scheduled to occur.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Scheduled Duration Minutes' ;
    rdfs:comment 'Expected duration of the appointment in minutes based on the service type. Used for scheduling optimization and resource planning.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerEmail rdf:type rdf:Property ;
    rdfs:label 'Customer Email' ;
    rdfs:comment 'Email address of the citizen used for appointment confirmation, reminders, and notifications.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerPhone rdf:type rdf:Property ;
    rdfs:label 'Customer Phone' ;
    rdfs:comment 'Primary contact phone number for the citizen. Used for appointment reminders and urgent notifications.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Date and time when the appointment was last modified or updated.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:confirmedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmed Timestamp' ;
    rdfs:comment 'Date and time when the citizen confirmed the appointment via email or SMS confirmation link.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:checkedInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Checked In Timestamp' ;
    rdfs:comment 'Date and time when the citizen checked in at the DMV office for their appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Service Start Timestamp' ;
    rdfs:comment 'Date and time when the DMV service actually began for the appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Service End Timestamp' ;
    rdfs:comment 'Date and time when the DMV service was completed for the appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancelledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancelled Timestamp' ;
    rdfs:comment 'Date and time when the appointment was cancelled by either the citizen or DMV staff.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancellationNotes rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notes' ;
    rdfs:comment 'Free-text notes providing additional context about the appointment cancellation.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rescheduledFromAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Rescheduled From Appointment Id' ;
    rdfs:comment 'Reference to the original appointment ID if this appointment was rescheduled from a previous appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bookingChannel rdf:type rdf:Property ;
    rdfs:label 'Booking Channel' ;
    rdfs:comment 'Channel through which the citizen scheduled the appointment. Used for channel effectiveness analysis.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reminderSentCount rdf:type rdf:Property ;
    rdfs:label 'Reminder Sent Count' ;
    rdfs:comment 'Number of reminder notifications sent to the citizen for this appointment via email or SMS.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastReminderSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Reminder Sent Timestamp' ;
    rdfs:comment 'Date and time when the most recent reminder notification was sent to the citizen.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:waitTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Wait Time Minutes' ;
    rdfs:comment 'Actual wait time in minutes between check-in and service start. Used for service level monitoring and quality metrics.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Service Duration Minutes' ;
    rdfs:comment 'Actual duration of service delivery in minutes from service start to service end.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:queueNumber rdf:type rdf:Property ;
    rdfs:label 'Queue Number' ;
    rdfs:comment 'Queue number assigned to the citizen upon check-in for service tracking and display purposes.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceWindowNumber rdf:type rdf:Property ;
    rdfs:label 'Service Window Number' ;
    rdfs:comment 'DMV service window or station number where the appointment service was delivered.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Staff Employee Id' ;
    rdfs:comment 'Employee ID of the DMV staff member who served the appointment. Used for performance tracking and quality assurance.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:serviceOutcome rdf:type rdf:Property ;
    rdfs:label 'Service Outcome' ;
    rdfs:comment 'Outcome of the appointment service indicating whether the requested service was successfully completed.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceOutcomeNotes rdf:type rdf:Property ;
    rdfs:label 'Service Outcome Notes' ;
    rdfs:comment 'Free-text notes providing additional details about the service outcome, including reasons for incomplete services.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentsVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Documents Verified Flag' ;
    rdfs:comment 'Indicates whether all required documents were verified during the appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Required Flag' ;
    rdfs:comment 'Indicates whether payment was required for the service provided during the appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'Total payment amount collected for the service if payment was required.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Unique transaction identifier from the payment processing system for reconciliation purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'Type of test administered during the appointment if applicable.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testResult rdf:type rdf:Property ;
    rdfs:label 'Test Result' ;
    rdfs:comment 'Result of the test administered during the appointment if applicable.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testScore rdf:type rdf:Property ;
    rdfs:label 'Test Score' ;
    rdfs:comment 'Numeric score achieved on the test if applicable, typically expressed as a percentage.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdlClass rdf:type rdf:Property ;
    rdfs:label 'Cdl Class' ;
    rdfs:comment 'Class of Commercial Driver License for CDL-related appointments.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realIdCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Real Id Compliant Flag' ;
    rdfs:comment 'Indicates whether the appointment was for a REAL ID compliant driver license or identification card.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required Flag' ;
    rdfs:comment 'Indicates whether language interpretation services were requested or required for the appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterLanguage rdf:type rdf:Property ;
    rdfs:label 'Interpreter Language' ;
    rdfs:comment 'Language for which interpretation services were provided during the appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibilityAccommodationFlag rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodation Flag' ;
    rdfs:comment 'Indicates whether accessibility accommodations were requested or provided for the appointment under ADA requirements.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accessibilityAccommodationType rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodation Type' ;
    rdfs:comment 'Description of the accessibility accommodation provided (e.g., wheelchair access, sign language interpreter, extended time).' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Service Flag' ;
    rdfs:comment 'Indicates whether the appointment was designated for priority service (e.g., senior citizen, veteran, disability).' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityServiceReason rdf:type rdf:Property ;
    rdfs:label 'Priority Service Reason' ;
    rdfs:comment 'Reason for priority service designation if applicable.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noShowFlag rdf:type rdf:Property ;
    rdfs:label 'No Show Flag' ;
    rdfs:comment 'Indicates whether the citizen failed to appear for their scheduled appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateArrivalFlag rdf:type rdf:Property ;
    rdfs:label 'Late Arrival Flag' ;
    rdfs:comment 'Indicates whether the citizen arrived late for their scheduled appointment time.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateArrivalMinutes rdf:type rdf:Property ;
    rdfs:label 'Late Arrival Minutes' ;
    rdfs:comment 'Number of minutes the citizen arrived late relative to their scheduled appointment time.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Score' ;
    rdfs:comment 'Customer satisfaction rating provided by the citizen after the appointment on a scale of 1 to 5.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerFeedbackComments rdf:type rdf:Property ;
    rdfs:label 'Customer Feedback Comments' ;
    rdfs:comment 'Free-text feedback comments provided by the citizen about their appointment experience.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Special instructions or notes associated with the appointment for staff reference.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeId rdf:type rdf:Property ;
    rdfs:label 'Office Id' ;
    rdfs:comment 'Unique identifier for the DMV office location. Primary key for the office entity.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Office .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line 1' ;
    rdfs:comment 'Primary street address of the DMV office location, including street number and name.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line 2' ;
    rdfs:comment 'Secondary address information such as suite number, building name, or floor designation for the DMV office.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneNumber rdf:type rdf:Property ;
    rdfs:label 'Phone Number' ;
    rdfs:comment 'Primary contact phone number for the DMV office. Used by citizens to inquire about services, hours, and appointments.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Web address for the DMV office-specific page or location information on the NCDOT website.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mondayOpenTime rdf:type rdf:Property ;
    rdfs:label 'Monday Open Time' ;
    rdfs:comment 'Time when the DMV office opens for business on Mondays, in 24-hour format (HH:MM). Value is \'closed\' if office is not open on Mondays.' ;
    rdfs:domain ind:Office ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mondayCloseTime rdf:type rdf:Property ;
    rdfs:label 'Monday Close Time' ;
    rdfs:comment 'Time when the DMV office closes for business on Mondays, in 24-hour format (HH:MM). Value is \'closed\' if office is not open on Mondays.' ;
    rdfs:domain ind:Office ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tuesdayOpenTime rdf:type rdf:Property ;
    rdfs:label 'Tuesday Open Time' ;
    rdfs:comment 'Time when the DMV office opens for business on Tuesdays, in 24-hour format (HH:MM). Value is \'closed\' if office is not open on Tuesdays.' ;
    rdfs:domain ind:Office ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tuesdayCloseTime rdf:type rdf:Property ;
    rdfs:label 'Tuesday Close Time' ;
    rdfs:comment 'Time when the DMV office closes for business on Tuesdays, in 24-hour format (HH:MM). Value is \'closed\' if office is not open on Tuesdays.' ;
    rdfs:domain ind:Office ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wednesdayOpenTime rdf:type rdf:Property ;
    rdfs:label 'Wednesday Open Time' ;
    rdfs:comment 'Time when the DMV office opens for business on Wednesdays, in 24-hour format (HH:MM). Value is \'closed\' if office is not open on Wednesdays.' ;
    rdfs:domain ind:Office ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wednesdayCloseTime rdf:type rdf:Property ;
    rdfs:label 'Wednesday Close Time' ;
    rdfs:comment 'Time when the DMV office closes for business on Wednesdays, in 24-hour format (HH:MM). Value is \'closed\' if office is not open on Wednesdays.' ;
    rdfs:domain ind:Office ;
