# RDFS Schema for Business: Pc_Insurance

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/pc_insurance#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Pc_Insurance ---
ind:PcInsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Pc_Insurance' ;
    rdfs:comment 'A Property & Casualty insurer underwriting personal and commercial lines. Prospects submit risk information, underwriters evaluate and price it, and quotes are bound into policies that renew, endorse, cancel, and reinstate over time. Policies carry coverages with limits, deductibles, exclusions, and conditions that attach to insured risks (properties, buildings, vehicles, drivers). Premium is booked as written, earned, unearned, and return transactions with charges, taxes, fees, and producer commission. Claims record loss events, claimants, and per-coverage exposures, with reserves, payments, recoveries, and expenses tracked as financial movements. Risk is distributed through agents and brokers and ceded through reinsurance treaties and facultative agreements, with catastrophe and geography used to aggregate exposure.' .

# --- Domain Classes ---
ind:Party rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Party' ;
    rdfs:comment 'SSOT for all persons and organizations the insurer interacts with: policyholders, named/additional insureds, claimants, producers, adjusters, and payees. Owns identity, demographics, KYC, and deduplication.' .

ind:Policy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Policy' ;
    rdfs:comment 'Authoritative record of the insurance contract lifecycle. Owns Policy (one row per policy), Policy Term (one row per policy per term), and Policy Transaction (NB, REN, END, CAN, RI, NR).' .

ind:Coverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Coverage' ;
    rdfs:comment 'Bridge between the policy contract and the insured risk. Owns Coverage (one row per coverage per policy term) with attached Limit, Deductible, Exclusion, and Condition.' .

ind:Premium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Premium' ;
    rdfs:comment 'Transactional ledger for all premium activity. Owns Premium Transaction (one row per financial transaction: Written, Earned, Unearned, Return) tied to Policy, Policy Term, Coverage, Insured Risk, and Accounting Period, with Charge, Tax, Fee, and' .

ind:Billing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Billing' ;
    rdfs:comment 'Manages invoicing, collections, disbursements, delinquency, and installment plan processing for policyholders and payees. Owns billing accounts, invoices, payment transactions, payment plans, returned payments, and write-offs.' .

ind:Reinsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Reinsurance' ;
    rdfs:comment 'Manages risk transfer to reinsurers. Owns Reinsurance Agreement, Treaty (QS/XOL/SL/CAT XL), Facultative Agreement, Cession, and Reinsurance Recovery linked to ceded Policy and Claim.' .

ind:Riskexposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Riskexposure' ;
    rdfs:comment 'Provisional description for user-specified domain \'risk_exposure\'. Awaiting a generated description of what this domain owns.' .

ind:Claims rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Claims' ;
    rdfs:comment 'Provisional description for user-specified domain \'claims\'. Awaiting a generated description of what this domain owns.' .

ind:Claimfinancials rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Claimfinancials' ;
    rdfs:comment 'Provisional description for user-specified domain \'claim_financials\'. Awaiting a generated description of what this domain owns.' .

ind:Producers rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Producers' ;
    rdfs:comment 'Provisional description for user-specified domain \'producers\'. Awaiting a generated description of what this domain owns.' .

ind:Catastrophegeography rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Catastrophegeography' ;
    rdfs:comment 'Provisional description for user-specified domain \'catastrophe_geography\'. Awaiting a generated description of what this domain owns.' .

ind:Shared rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Shared' ;
    rdfs:comment 'Cross-domain shared reference entities (currency, UoM, calendar, classification) consolidated for Single Source of Truth (SSOT).' .

# --- Data Product Classes (Tables) ---
ind:Party rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Party' ;
    rdfs:comment 'One row per party (person or organization). Master identity record. Roles, addresses, contacts, and identifiers are child tables. Never embed role on this record; use party.role with effective/expiration dates.' .

ind:Role rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Role' ;
    rdfs:comment 'One row per party-role assignment. A party may hold many roles over time: policyholder, named insured, additional insured, claimant, producer, adjuster, payee. Effective and expiration dates govern each assignment.' .

ind:Individual rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Individual' ;
    rdfs:comment 'One row per individual (person subtype of Party). Extends party.party with person-specific attributes: name parts, DOB, SSN hash, drivers license, MVR consent, credit score, and occupational data.' .

ind:Organization rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Organization' ;
    rdfs:comment 'One row per organization (entity subtype of Party). Extends party.party with org-specific attributes: legal name, FEIN, NAICS/SIC, revenue, employee count, incorporation details, and parent hierarchy.' .

ind:Address rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Address' ;
    rdfs:comment 'One row per party address record. Effective-dated address with geocode, USPS standardization, fire protection class, coastal/wind indicators, and CAT zone linkage. Supports territory and catastrophe aggregation.' .

ind:Contact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Contact' ;
    rdfs:comment 'One row per party contact method. Stores phone, email, and other contact channels with opt-in/opt-out flags, verification status, and effective dating. Supports do-not-contact compliance.' .

ind:Identifier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Identifier' ;
    rdfs:comment 'One row per party external identifier (SSN, TIN, NPN, license number, etc.). Effective-dated with masking, verification status, and MDM golden-record linkage. Supports KYC, OFAC, and deduplication workflows.' .

ind:Relationship rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Relationship' ;
    rdfs:comment 'One row per directed party-to-party relationship (spouse, employer, subsidiary, etc.). Effective-dated with ownership percentage, legal basis, and UW impact flag. Supports household and corporate hierarchy traversal.' .

ind:KycVerification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Kyc Verification' ;
    rdfs:comment 'One row per KYC verification event for a party. Records due-diligence level, OFAC/PEP screening, identity document details, analyst decision, SAR filing, and SIU referral. Links to submission and claim contexts.' .

ind:LossPayee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Loss Payee' ;
    rdfs:comment 'One row per loss payee or additional interest on a policy. Links party, policy, coverage, and insured risk. Captures lender details, loan number, loss-payable clause type, and cancellation notice requirements.' .

ind:License rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'License' ;
    rdfs:comment 'One row per party license (producer, adjuster, contractor). Tracks license number, type, state, effective/expiry dates, CE credits, NIPR verification, E&O coverage, and disciplinary actions.' .

ind:ProducersProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producers Producer' ;
    rdfs:comment 'Master record for every licensed insurance producer (agent or broker). One row per producer. Stores NPN, license numbers, resident state, producer type, appointment status, and E&O coverage details.' .

ind:Agency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Agency' ;
    rdfs:comment 'Master record for an insurance agency or brokerage firm. One row per agency. Captures agency name, FEIN, NAIC code, principal address, agency type, and parent agency hierarchy for MGA and wholesale relationships.' .

ind:ProducerLicense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer License' ;
    rdfs:comment 'Individual state license held by a producer. One row per producer per state per license class. Tracks license number, line of authority, issue date, expiration date, and DOI status for compliance and appointment eligibility.' .

ind:AgencyProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Agency Producer' ;
    rdfs:comment 'Association between a producer and an agency capturing the employment or affiliation relationship. One row per producer-agency pairing. Stores role, start date, end date, and primary-agency flag.' .

ind:ProducerAppointment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Appointment' ;
    rdfs:comment 'Formal appointment and binding authority granted by the insurer to a producer to sell specific lines in a state. One row per producer per insurer per state per LOB.' .

ind:DistributionChannel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Distribution Channel' ;
    rdfs:comment 'Reference classification of how business reaches the insurer (captive, independent, broker, direct, MGA, wholesale, affinity, digital). One row per channel. Drives commission schedule selection and producer underwriting authority rules.' .

ind:CommissionSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Schedule' ;
    rdfs:comment 'Contractual commission rate set for a producer or agency by LOB, transaction type (NB/REN/END), and coverage type over an effective period. One row per schedule version. Holds all rate lines (base, contingent, override) as embedded detail.' .

ind:CommissionRule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Rule' ;
    rdfs:comment 'Individual rate rule within a commission schedule. One row per rule. Specifies transaction type (NB, REN, END), LOB, coverage type, base rate, contingent rate, override rate, and effective date range.' .

ind:CommissionTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Transaction' ;
    rdfs:comment 'One row per commission financial movement earned by a producer on a premium transaction. Captures earned amount, claw-back amount, transaction type, accounting period, and payment status. Child of premium transaction.' .

ind:CommissionStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Statement' ;
    rdfs:comment 'Periodic statement issued to a producer or agency summarizing commission transactions due for a billing cycle. One row per statement. Tracks statement date, total earned, total adjustments, net payable, and payment status.' .

ind:UnderwritingAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Underwriting Authority' ;
    rdfs:comment 'Defines the binding authority granted to a producer or agency by LOB, coverage type, and limit tier. One row per authority grant. Tracks max TIV, max single-risk limit, eligible states, and authority expiration date.' .

ind:RiAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Agreement' ;
    rdfs:comment 'Master record for a reinsurance agreement between the cedant and one or more reinsurers. One row per agreement. Captures agreement type (Treaty/Facultative), status, inception/expiry, governing law, and currency.' .

ind:Treaty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty' ;
    rdfs:comment 'Defines a proportional or non-proportional treaty under a reinsurance agreement. One row per treaty. Captures treaty type (QS/XOL/SL/CAT XL), layer, retention, limit, ROL, and UNL basis.' .

ind:TreatyLayer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty Layer' ;
    rdfs:comment 'Individual attachment/exhaustion layer within an XOL or CAT XL treaty. One row per layer per treaty. Stores attachment point, limit per occurrence, annual aggregate limit, and reinstatement terms.' .

ind:FacAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Fac Agreement' ;
    rdfs:comment 'Facultative reinsurance agreement covering a single risk or policy. One row per FAC placement. Captures cedant, reinsurer, ceded percentage, premium rate, inception/expiry, and the linked policy or submission.' .

ind:Reinsurer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Reinsurer' ;
    rdfs:comment 'Master record for each reinsurance counterparty (assuming company, Lloyd\'s syndicate, or pool). One row per reinsurer. Stores legal name, NAIC code, AM Best rating, domicile, and authorized/unauthorized status for Schedule F credit.' .

ind:RiParticipant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Participant' ;
    rdfs:comment 'Allocation of a reinsurer\'s share within a treaty or FAC agreement. One row per reinsurer per agreement. Captures signed line percentage, written line percentage, and participation effective dates.' .

ind:Cession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Cession' ;
    rdfs:comment 'Records risk transfer of a policy term to a treaty layer or FAC. Grain: one row per policy term per treaty layer (or FAC). Direction flag (outward/retro) distinguishes cession from retrocession.' .

ind:RiPremiumTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Premium Transaction' ;
    rdfs:comment 'Ceded premium ledger. One row per financial movement (written, earned, unearned, return, reinstatement) for a cession. FK to cession, accounting period, treaty layer. Reinstatement rows carry occurrence reference and reinstated limit.' .

ind:RiClaimCession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Claim Cession' ;
    rdfs:comment 'Links a claim exposure to a reinsurance treaty layer or FAC agreement for loss recovery eligibility. One row per claim exposure per treaty layer. Stores ceded loss amount, ceded LAE, and UNL calculation basis.' .

ind:RiRecovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Recovery' ;
    rdfs:comment 'Single ceded loss ledger. Grain: one row per movement per ri_claim_cession per accounting period, discriminated by movement_type: case/IBNR/LAE reserve position, or cash recovery (loss/LAE/DCC, subrogation, salvage).' .

ind:Reserve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Reserve' ;
    rdfs:comment 'One row per reserve position per claim exposure per accounting period. Tracks Case, IBNR, and LAE reserves with opening balance, incremental movement (strengthening/release with reason code and authorizing adjuster), and closing balance.' .

ind:ClaimPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Claim Payment' ;
    rdfs:comment 'One row per payment disbursement per claim exposure per accounting period. Records indemnity, medical, and LAE payments with payee, method, check/EFT reference, void/reissue/stop-payment status, and AP batch grouping (batch id, bank account, settlement' .

ind:Recovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Recovery' ;
    rdfs:comment 'One row per recovery transaction per claim exposure per accounting period. SSOT for ALL claim recoveries: recovery_type (subrogation, salvage, reinsurance), responsible party, demand/collected/net amounts.' .

ind:Subrogation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Subrogation' ;
    rdfs:comment 'Master record for a subrogation pursuit against a liable third party. Tracks demand amount, collected amount, attorney assignment, litigation status, settlement date, and net recovery after expenses per claim.' .

ind:Salvage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Salvage' ;
    rdfs:comment 'Grain: one row per salvage financial movement per claim exposure. Records proceeds recovered by taking title to damaged property. FK to claim_exposure_id and accounting_period_id. PK: salvage_id.' .

ind:ClaimExpense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Claim Expense' ;
    rdfs:comment 'One row per expense transaction per claim exposure and accounting period. Classifies LAE into ALAE/ULAE, DCC, and AO categories with vendor, invoice reference, approval status, and GL account. Grain: one row per expense movement.' .

ind:AccountingPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Accounting Period' ;
    rdfs:comment 'Reference calendar for financial close cycles. Defines calendar year, accident year, policy year, and fiscal period boundaries used to bucket premium, loss, and expense transactions for statutory and GAAP reporting.' .

ind:FinancialTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Financial Transaction' ;
    rdfs:comment 'One row per atomic double-entry posting generated by a claim financial event (reserve, payment, recovery, expense), keyed to claim exposure and accounting period.' .

ind:ReinsuranceRecovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Reinsurance Recovery' ;
    rdfs:comment 'One row per reinsurance recovery billing per claim exposure and treaty or facultative agreement. Tracks ceded loss amount, ceded LAE, recovery billed, recovery collected, and outstanding balance. Links claim to reinsurance cession.' .

ind:Payee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claimfinancials ;
    rdfs:label 'Payee' ;
    rdfs:comment 'Master record for a party designated to receive claim payments. Captures payee name, tax ID (SSN/FEIN), address, bank account for EFT, 1099 reporting flag, and payee type (claimant, attorney, vendor, lienholder).' .

ind:PremiumTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Premium Transaction' ;
    rdfs:comment 'Grain: one row per financial premium transaction. Carries FKs to policy, policy term, coverage, insured risk, and accounting period. transaction_type enumerates Written, Earned, Unearned, Return.' .

ind:Charge rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Charge' ;
    rdfs:comment 'Child of Premium Transaction. One row per charge component (base premium, surcharge, credit, minimum premium) within a transaction. Enables granular decomposition of gross written premium by rating element and LOB.' .

ind:TaxLevy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Tax Levy' ;
    rdfs:comment 'Child of Premium Transaction. One row per state or surplus-lines tax, stamping fee, or regulatory assessment applied to a premium transaction. Tracks tax type, jurisdiction, rate, and computed amount for statutory remittance.' .

ind:PolicyFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Policy Fee' ;
    rdfs:comment 'Child of Premium Transaction. One row per non-premium fee (policy fee, inspection fee, installment fee) charged on a transaction. Fees are non-taxable in most jurisdictions and tracked separately from taxable premium.' .

ind:Commission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Commission' ;
    rdfs:comment 'Child of Premium Transaction. One row per producer commission calculation on a transaction: type (new/renewal/contingent), rate, basis, and computed payable. Calculation-only; commission settlement/payout is owned by the producers domain.' .

ind:RateTable rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Rate Table' ;
    rdfs:comment 'Versioned rate table published by the rating engine for a specific LOB, state, and effective date. Stores base rates, factors, and minimum premiums. Provides the authoritative rate version used to price each Policy Term.' .

ind:InstallmentPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Installment Plan' ;
    rdfs:comment 'Installment schedule elected for a Policy Term with per-installment lines: number, due dates, billed/paid amounts, fees, and status. Feeds delinquency and cancellation-for-non-payment.' .

ind:Policy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy' ;
    rdfs:comment 'One row per policy. Master policy record anchoring the full lifecycle. Carries policy number, status, effective/expiration dates, LOB, state, and carrier. FK lineage: Party -> Policy -> Policy Term -> Coverage.' .

ind:Term rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Term' ;
    rdfs:comment 'One row per policy per term. Time-bounded period of a policy (annual, short-rate, etc.). Enables reconstruction of coverages and premium in force at any date including loss date. Links Policy to Coverage via Coverage table.' .

ind:PolicyTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Transaction' ;
    rdfs:comment 'One row per policy transaction. Records every lifecycle event: New Business, Renewal, Endorsement, Cancellation, Reinstatement, Non-renewal. Effective-dated so in-force state is reconstructable at any point in time.' .

ind:Policyholder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policyholder' ;
    rdfs:comment 'One row per party-policy holder assignment. Links party.role to a policy and term with effective dating, holder type, interest type, billing responsibility, and waiver of subrogation. Supports multiple named insureds.' .

ind:Interest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Interest' ;
    rdfs:comment 'One row per additional interest on a policy term (mortgagee, lienholder, certificate holder). Links party, policy term, and insured risk with effective dating, coverage scope, and notification requirements.' .

ind:Form rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Form' ;
    rdfs:comment 'One row per form attached to a policy term. Tracks ISO/ACORD form number, edition date, state filing, mandatory flag, premium-bearing flag, and attachment sequence. Links to policy document for the physical artifact.' .

ind:Line rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Line' ;
    rdfs:comment 'One row per line of business per policy term. Captures LOB-level underwriting attributes: TIV, policy limit, deductible, rate factor, reinsurance treaty, CAT zone, and written premium. Child of policy term.' .

ind:PolicyProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Producer' ;
    rdfs:comment 'One row per producer-policy assignment. Links producer to policy and term with role type, commission rate, split percentage, license details, and servicing rights. Supports multi-producer and split-commission scenarios.' .

ind:Type rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Type' ;
    rdfs:comment 'One row per policy type definition (reference/lookup). Defines LOB category, term length, minimum/maximum premium, rating algorithm version, reinsurance eligibility, and state filing requirements.' .

ind:StateReg rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'State Reg' ;
    rdfs:comment 'One row per state regulatory record per policy transaction. Captures admitted status, DOI filing, surplus lines stamping, state/municipal tax amounts, guaranty fund assessments, and mandated coverage indicators.' .

ind:Fee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Fee' ;
    rdfs:comment 'One row per fee transaction on a policy. Records policy fee, inspection fee, installment fee, and similar charges with amount, type, accounting period, GL account, and refund/waiver tracking.' .

ind:Document rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Document' ;
    rdfs:comment 'One row per policy document issued. Tracks document type, delivery method, recipient party, delivery confirmation, storage URI, and supersession chain. Links to policy, term, and transaction for full audit trail.' .

ind:CatastropheEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Catastrophe Event' ;
    rdfs:comment 'Master record of a named CAT event (hurricane, quake, wildfire, flood, tornado), one row per event. Captures event type, peril, date range, footprint, industry loss estimate, PML class, ISO CAT serial number, event name, and affected states for statutory' .

ind:CatZone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Cat Zone' ;
    rdfs:comment 'Insurer-defined CAT zone or territory used for exposure aggregation and PML modeling. One row per zone. Zones map to peril types (wind, quake, flood) and carry AAL and PML thresholds for reinsurance treaty attachment.' .

ind:Geography rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Geography' ;
    rdfs:comment 'Enterprise geography hierarchy node (country, state, county, ZIP, CRESTA zone, census tract). One row per geography unit. Provides the spatial backbone for territory rating, CAT aggregation, and regulatory reporting.' .

ind:Territory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Territory' ;
    rdfs:comment 'Rating territory as filed with the DOI per state and LOB. One row per territory per LOB per state. Carries territory code, effective date, filed rate relativities, residual-market/wind-pool designation flags, and links to the geography hierarchy for' .

ind:Peril rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Peril' ;
    rdfs:comment 'Reference catalog of insured perils (wind, hail, earthquake, flood, fire, theft, liability). One row per peril. Carries NAIC peril code, CAT vs. non-CAT flag, reinsurance treaty peril mapping, and ISO cause-of-loss code.' .

ind:CatEventLoss rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Cat Event Loss' ;
    rdfs:comment 'CAT-attribution loss ESTIMATE per CAT event per LOB per geography (one row each). Holds modeled/actual gross, ceded, and net loss and IBNR loading for Schedule P CAT reporting only -- NOT the financial ledger; authoritative payments/reserves live in' .

ind:LocationGeocode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Location Geocode' ;
    rdfs:comment 'Per-location SSOT for geocode and hazard: one row per insured location. Stores lat/long, FIPS, CRESTA zone, FEMA FIRM flood zone, base flood elevation, FIRM panel, fire protection class, and model-derived AAL/PML/hazard band per peril and CAT model' .

ind:PmlRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Pml Run' ;
    rdfs:comment 'A probabilistic PML modeling run executed against the exposure portfolio. One row per run. Captures model vendor, model version, run date, return period set, gross and net PML at each return period, and the exposure snapshot used as input.' .

ind:AccumulationLimit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Accumulation Limit' ;
    rdfs:comment 'Insurer-defined maximum aggregate exposure limit per CAT zone, peril, and LOB. One row per zone per peril per LOB. Enforces underwriting appetite constraints; triggers referral or declination when TIV in zone exceeds the approved accumulation cap.' .

ind:PolicyCatExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Catastrophegeography ;
    rdfs:label 'Policy Cat Exposure' ;
    rdfs:comment 'Association linking an in-force policy to a CAT event or CAT zone for exposure tracking. One row per policy per CAT event or zone. Carries TIV, coverage type, and estimated gross loss used in FNOL triage and reinsurance bordereaux generation.' .

ind:Submission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Submission' ;
    rdfs:comment 'One row per submission (application for coverage). Entry point of the underwriting lifecycle. Captures applicant, producer, LOB, risk state, estimated premium, eligibility status, and links to bound policy when accepted.' .

ind:UwDecision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Uw Decision' ;
    rdfs:comment 'One row per underwriting decision on a submission or quote. Records accept/decline/refer outcome, risk score, authority level, conditions, exclusions added, modified limits/deductibles, and SLA compliance.' .

ind:UwReferral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Uw Referral' ;
    rdfs:comment 'One row per underwriting referral. Tracks referral reason, priority, assigned underwriter, escalation level, SLA due date, resolution outcome, and links to submission, quote, and policy for full audit trail.' .

ind:Quote rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Quote' ;
    rdfs:comment 'One row per quote version. Captures quoted premium, commission, fees, taxes, rating engine version, rating tier, and binding status. Versioned so multiple quote iterations per submission are preserved.' .

ind:QuoteCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Quote Coverage' ;
    rdfs:comment 'One row per coverage line on a quote. Captures quoted limit, deductible, premium, exclusion/condition codes, and coverage basis per insured risk. Links to bound coverage.coverage when quote is accepted.' .

ind:RatingFactor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Rating Factor' ;
    rdfs:comment 'One row per rating factor applied during premium calculation. Records factor name, value, basis, peril, and rating engine version. Supports full rate reconstruction and actuarial audit of any quoted or written premium.' .

ind:LossHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Loss History' ;
    rdfs:comment 'Prior loss record for a submission or insured risk from CLUE, MVR, or applicant disclosure: loss date, cause, paid amount, open/closed status. Grain: one row per prior loss. Used in appetite and pricing.' .

ind:BindRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Bind Request' ;
    rdfs:comment 'Formal request to bind a quoted policy, submitted by producer or applicant. Grain: one row per bind request. Captures requested effective date, payment plan, and bind confirmation or rejection reason.' .

ind:Binder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Binder' ;
    rdfs:comment 'Temporary insurance contract issued upon bind confirmation, providing coverage before the formal policy is issued. Captures binder number, effective/expiration dates, LOB, and issuing authority.' .

ind:InsuredRisk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Insured Risk' ;
    rdfs:comment 'Supertype master for every insurable object underwritten on a policy. One row per insured risk. Subtypes property_risk and auto_risk extend it via shared PK (explicit subtype FK).' .

ind:PropertyRisk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Property Risk' ;
    rdfs:comment 'Property-line subtype of insured_risk. One row per property risk. Captures COPE attributes (Construction, Occupancy, Protection, Exposure), ITV, year built, square footage, and ISO construction class for rating and CAT modeling.' .

ind:Location rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Location' ;
    rdfs:comment 'Physical address and geocoded site associated with a property risk. One row per insured location. Stores street address, lat/long, FIPS code, territory code, flood zone, and links to geography hierarchy for CAT aggregation.' .

ind:Building rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Building' ;
    rdfs:comment 'Individual structure on an insured location. One row per building. Captures number of stories, roof type, roof year, frame type, sprinkler indicator, replacement cost value, and ISO building class for property rating.' .

ind:AutoRisk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Auto Risk' ;
    rdfs:comment 'Auto-line subtype of insured_risk. One row per auto risk unit. Captures garaging state, primary use, annual mileage, radius of operation, and links to vehicle and driver records for PAP and CA rating.' .

ind:Vehicle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Vehicle' ;
    rdfs:comment 'Motor vehicle associated with an auto risk. One row per vehicle. Stores VIN, year, make, model, body type, ISO symbol, stated value, anti-theft device indicator, and safety rating for auto rating and claims.' .

ind:Driver rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Driver' ;
    rdfs:comment 'Licensed operator associated with an auto risk. One row per driver. Captures license number/state, DOB, gender, marital status, years licensed, SR-22 indicator, and MVR order/receipt/status and clean-record fields (absorbed from mvr_report) for auto' .

ind:RiskScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Point-in-time risk score attached to an insured risk for exposure grading. One row per scoring event per risk. Stores score value, model version, score date, component scores, and referral threshold flag.' .

ind:RiskInspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Inspection' ;
    rdfs:comment 'Physical or virtual inspection of an insured risk that produces exposure facts of record (condition, hazards, valuation checks). One row per inspection. Stores inspection type, ordered/completed dates, inspector party, findings summary, and recommendation' .

ind:Account rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Account' ;
    rdfs:comment 'Master billing account linking a policyholder or payee to invoicing and collections. One row per billing account. Tracks account type (direct bill, agency bill), status, payment method, and balance.' .

ind:Invoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Invoice' ;
    rdfs:comment 'Billing document issued to a policyholder or agency for premium charges, fees, and taxes due. One row per invoice. Grain: one invoice per billing cycle per billing account. Tracks due date, amount billed, and status.' .

ind:InvoiceItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Invoice Item' ;
    rdfs:comment 'Line-level detail on an invoice representing a single charge, tax, fee, or commission amount. One row per line item per invoice. Links to premium charge, coverage, and policy term for reconciliation.' .

ind:Payment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment' ;
    rdfs:comment 'Record of a payment received from a policyholder, agency, or third party against a billing account. One row per payment transaction. Captures payment method, amount, receipt date, and application status.' .

ind:PaymentApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Application' ;
    rdfs:comment 'Links a payment to one or more invoices or invoice items, and holds all unapplied/suspense cash pending identification of the correct account or invoice. One row per application or suspense holding.' .

ind:PaymentPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Plan' ;
    rdfs:comment 'Installment plan template defining the number of installments, down payment percentage, installment frequency, and applicable fees for a billing account or policy. Master record for plan configuration.' .

ind:InstallmentSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Installment Schedule' ;
    rdfs:comment 'Scheduled installment records generated for a billing account under a payment plan. One row per installment. Tracks scheduled due date, scheduled amount, actual paid amount, and installment status (due, paid, past due).' .

ind:Delinquency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Delinquency' ;
    rdfs:comment 'Delinquency lifecycle for a billing account that missed installments, including all workflow actions (past-due, cancellation, reinstatement, write-off trigger) and notices issued during collections. One row per delinquency event per account.' .

ind:DelinquencyAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Delinquency Action' ;
    rdfs:comment 'Individual workflow action taken within a delinquency process (notice issued, cancellation initiated, reinstatement offered, write-off triggered). One row per action per delinquency. Tracks action type, action date, and outcome.' .

ind:Disbursement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Disbursement' ;
    rdfs:comment 'Outbound payment to a producer, claimant, or payee, including producer commission payable pending settlement. One row per disbursement. Captures payee party, producer, policy, disbursement type (commission, refund, return premium), earned/withheld amount' .

ind:PaymentMethod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Stored payment instrument on file for a billing account (credit card, ACH/EFT, check, escrow). One row per payment method per billing account. Captures instrument type, masked account details, expiry, and EFT authorization status.' .

ind:AccountPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Account Policy' ;
    rdfs:comment 'Association linking a billing account to one or more policies. One row per billing-account-to-policy relationship. Supports agency bill and direct bill splits, and multi-policy billing account consolidation.' .

ind:Coverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage' ;
    rdfs:comment 'One row per coverage per policy term. Bridge between the policy contract and insured risk. Captures coverage type, LOB, form number, effective/expiration dates, and status. Links to Policy Term and Insured Risk.' .

ind:Limit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Limit' ;
    rdfs:comment 'Limit attached to a coverage: occurrence limit, aggregate limit, per-person limit, split limits. Supports stacked, CSL, and sublimit structures. One row per limit per coverage.' .

ind:Deductible rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Deductible' ;
    rdfs:comment 'Deductible attached to a coverage: flat, percentage, SIR, or disappearing. Captures amount, basis, application method, and waiver flags. One row per deductible per coverage.' .

ind:Exclusion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Exclusion' ;
    rdfs:comment 'Exclusion attached to a coverage: ISO or manuscript exclusion code, description, endorsement reference, and effective dates. One row per exclusion per coverage.' .

ind:Rate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Rate' ;
    rdfs:comment 'Rate element applied to a coverage during pricing: rate code, rate basis, rate value, territory factor, class factor, and effective date. Supports reconstruction of premium at any point in time.' .

ind:LossEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Loss Event' ;
    rdfs:comment 'Master record of a physical loss occurrence (storm, fire, collision, liability event). One row per occurrence. Links multiple claims arising from the same event. Supports CAT aggregation and PML analysis.' .

ind:Claim rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim' ;
    rdfs:comment 'Core claim record. Grain: one row per reported loss. Captures FNOL intake, line of business, accident date, report date, status, and FK links to policy, loss_event, and reinsurance cession keys for recovery linkage.' .

ind:Claimant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claimant' ;
    rdfs:comment 'Party involved in a claim as first-party insured or third-party claimant. Grain: one row per party per claim. Captures claimant type (FP/TP), injury or damage description, and links to Party domain.' .

ind:ClaimExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Exposure' ;
    rdfs:comment 'Coverage line within a claim. Grain: one row per coverage per claim. Junction between Claim and Coverage/Insured Risk. Drives all financial postings; prevents fan-out double-counting of reserves and payments.' .

ind:ClaimStatus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Status' ;
    rdfs:comment 'Lifecycle status history for a claim. Grain: one row per status transition per claim. Tracks Open, Pending, Closed, Reopened, Denied, Litigated transitions with effective timestamps and reason codes.' .

ind:Adjuster rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Adjuster' ;
    rdfs:comment 'Staff or independent adjuster assigned to handle claims. Captures adjuster type (staff/IA/TPA), license number, state appointments, assignment capacity, and links to Party domain for identity.' .

ind:AdjusterAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Adjuster Assignment' ;
    rdfs:comment 'Assignment of an adjuster to a claim or claim exposure. Grain: one row per assignment. Tracks assignment date, reassignment reason, workload at assignment, and primary vs supervisory role. FK to adjuster and claim.' .

ind:Fnol rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Fnol' ;
    rdfs:comment 'First Notice of Loss intake record. Grain: one row per FNOL submission. Captures report channel, reporter party, initial loss description, date/time of loss, and triage flags before a formal claim is opened.' .

ind:Litigation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Litigation' ;
    rdfs:comment 'Litigation record attached to a claim. Tracks lawsuit filing date, plaintiff attorney, defense counsel, court jurisdiction, trial date, verdict, and settlement amount. One row per lawsuit per claim.' .

ind:Currency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Currency' ;
    rdfs:comment 'Reference catalog of ISO 4217 currencies used across premium, claim, billing, and reinsurance financial transactions. One row per currency code. Carries code, name, minor unit, and active flag.' .

ind:LineOfBusiness rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Line Of Business' ;
    rdfs:comment 'Reference catalog of P&C lines of business (HO, PAP, CGL, BOP, CPP, WC, Commercial Auto, Umbrella). One row per LOB. SSOT for LOB codes referenced by policy, coverage, premium, claim, and reinsurance.' .

ind:Calendar rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Calendar' ;
    rdfs:comment 'Enterprise calendar reference of fiscal, accident, policy, and calendar-year periods. One row per period. Complements domain-local accounting_period tables by providing a single cross-domain date dimension.' .

ind:Household rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Party ;
    rdfs:label 'Household' ;
    rdfs:comment 'One row per household grouping of parties. Effective-dated with member count, credit score, CAT zone, territory, and marketing preferences. Supports household-level underwriting and customer analytics.' .

ind:Condition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Condition' ;
    rdfs:comment 'One row per contract Condition per Coverage. Attaches named Conditions to a Coverage and Policy Term, completing the VREQ-004 quartet alongside Limit, Deductible, and Exclusion.' .

# --- Attribute Properties ---
ind:partyId rdf:type rdf:Property ;
    rdfs:label 'Party Id' ;
    rdfs:comment 'Unique surrogate key for every person or organization in the MDM party master. One row per party. Role = MASTER_PARTY primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:masterPartyId rdf:type rdf:Property ;
    rdfs:label 'Master Party Id' ;
    rdfs:comment 'References the surviving golden-record party_id when this record has been merged into another. Null if this record is itself the golden record. Supports MDM deduplication lineage.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line1' ;
    rdfs:comment 'First line of the party\'s primary mailing/residence address (street number and name). Used for policy issuance, billing, regulatory filings, and territory rating.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line2' ;
    rdfs:comment 'Second line of the party\'s primary address (suite, apartment, unit, floor). Supplementary to address_line1 for complete mailing address.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality of the party\'s primary address. Used in territory rating, catastrophe aggregation, and regulatory jurisdiction determination.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueReportDate rdf:type rdf:Property ;
    rdfs:label 'Clue Report Date' ;
    rdfs:comment 'Date the most recent CLUE loss history report was ordered for this party. Used in personal lines underwriting to assess prior claims history. Governed by FCRA.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the party\'s primary address (e.g., USA, CAN). Required for international commercial lines and OFAC/sanctions screening.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Timestamp when the party record was first created in the MDM system. Immutable audit field. RECORD_AUDIT_CREATED per MASTER_PARTY canonical category.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:creditScore rdf:type rdf:Property ;
    rdfs:label 'Credit Score' ;
    rdfs:comment 'Insurance-based credit score used in personal lines rating (HO, PAP) where state-permitted. Sourced from credit bureaus under FCRA. Range typically 150–950. Null where prohibited by state DOI.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScoreDate rdf:type rdf:Property ;
    rdfs:label 'Credit Score Date' ;
    rdfs:comment 'Date the insurance credit score was last obtained from the credit bureau. Used to determine score freshness and re-pull schedules per FCRA and state DOI requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Date of birth for a natural person. Used in age-based rating, MVR eligibility, KYC identity verification, and OFAC/sanctions screening. Null for ORGANIZATION.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfDeath rdf:type rdf:Property ;
    rdfs:label 'Date Of Death' ;
    rdfs:comment 'Date of death for a natural person, populated when confirmed. Triggers policy lifecycle actions (cancellation, beneficiary notification) and stops billing. Null if living or ORGANIZATION.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'Date Of Incorporation' ;
    rdfs:comment 'Date the organization was legally incorporated or formed. Used to calculate years_in_business and validate commercial underwriting eligibility. Null for INDIVIDUAL.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doNotContactFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Flag' ;
    rdfs:comment 'Indicates the party has opted out of marketing and non-essential communications. Enforced in outbound campaign and billing communication workflows per TCPA and GLBA opt-out rules.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:familyName rdf:type rdf:Property ;
    rdfs:label 'Family Name' ;
    rdfs:comment 'Surname/family name of a natural person. Null for ORGANIZATION party type. Used in KYC, CLUE, MVR, and OFAC screening.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Flag' ;
    rdfs:comment 'Set to True when the SIU or fraud detection system has flagged this party for suspected fraudulent activity. Triggers enhanced review on new submissions and claims.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fullName rdf:type rdf:Property ;
    rdfs:label 'Full Name' ;
    rdfs:comment 'Golden-record display name. For individuals: concatenated given + family name. For organizations: legal entity name. Primary IDENTITY_LABEL per MDM golden record.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gender rdf:type rdf:Property ;
    rdfs:label 'Gender' ;
    rdfs:comment 'Self-reported gender of a natural person: M=Male, F=Female, X=Non-binary/Other, U=Unknown. Used in auto rating where state-permitted. Null for ORGANIZATION.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:givenName rdf:type rdf:Property ;
    rdfs:label 'Given Name' ;
    rdfs:comment 'First/given name of a natural person. Null for ORGANIZATION party type. Used in correspondence, KYC matching, and CLUE/MVR lookups.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goldenRecordFlag rdf:type rdf:Property ;
    rdfs:label 'Golden Record Flag' ;
    rdfs:comment 'True if this party record is the MDM-designated master (golden) record after deduplication. False for duplicate or candidate records pending merge resolution.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycStatus rdf:type rdf:Property ;
    rdfs:label 'Kyc Status' ;
    rdfs:comment 'Current KYC/AML verification status of the party. VERIFIED = identity confirmed; FAILED = verification failed; REVIEW = under enhanced due diligence. Required for GLBA and BSA/AML compliance.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified Date' ;
    rdfs:comment 'Date on which the party\'s identity was most recently verified through the KYC process. Used to determine re-verification schedules and compliance audit trails.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Registered legal name of an organization as filed with the state or federal authority. Null for INDIVIDUAL party type. Used in commercial lines underwriting and FEIN matching.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maritalStatus rdf:type rdf:Property ;
    rdfs:label 'Marital Status' ;
    rdfs:comment 'Marital status of a natural person used in personal lines rating (HO, PAP). Null for ORGANIZATION. [ENUM-REF-CANDIDATE: SINGLE|MARRIED|DIVORCED|WIDOWED|SEPARATED|UNKNOWN — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'NAICS code classifying the industry of an organization party. Used in commercial lines underwriting, CGL class rating, BOP eligibility, and actuarial segmentation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Ofac Match Flag' ;
    rdfs:comment 'Indicates whether the party returned a potential match on the OFAC SDN or consolidated sanctions list. True triggers manual review and blocks policy binding until cleared.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ofacScreenedDate rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened Date' ;
    rdfs:comment 'Most recent date the party was screened against the OFAC Specially Designated Nationals (SDN) list. Required for regulatory compliance before policy binding.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:organizationType rdf:type rdf:Property ;
    rdfs:label 'Organization Type' ;
    rdfs:comment 'Legal structure of an organization party. Drives commercial lines eligibility, CGL/BOP underwriting rules, and FEIN validation. Null for INDIVIDUAL. [ENUM-REF-CANDIDATE: CORPORATION|LLC|PARTNERSHIP|SOLE_PROP|TRUST|NONPROFIT|GOVERNMENT|OTHER — promote to' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyStatus rdf:type rdf:Property ;
    rdfs:label 'Party Status' ;
    rdfs:comment 'Current MDM lifecycle state of the party record. ACTIVE = in use; INACTIVE = no current relationships; DECEASED = confirmed death; MERGED = superseded by survivor; SUSPENDED = under review.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyType rdf:type rdf:Property ;
    rdfs:label 'Party Type' ;
    rdfs:comment 'Discriminator distinguishing a natural person (INDIVIDUAL) from a legal entity (ORGANIZATION). Drives which subtype attributes are populated and which KYC rules apply.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'US ZIP or ZIP+4 postal code for the party\'s primary address. Used in territory rating, catastrophe zone mapping, and USPS address validation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'Party\'s stated preference for receiving communications: EMAIL, PHONE, MAIL, TEXT, or PORTAL. Drives outbound communication routing in PAS and billing systems.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Preferred Language' ;
    rdfs:comment 'ISO 639-1 language code (optionally with BCP-47 region tag, e.g., en-US, es-MX) indicating the party\'s preferred language for documents and communications.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Email' ;
    rdfs:comment 'Primary electronic mail address for the party. Used for policy documents, billing notices, FNOL acknowledgements, and regulatory correspondence. PRIMARY_CONTACT field per MASTER_PARTY role.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Primary telephone number in E.164 format. Used for FNOL intake, billing collections, underwriting contact, and fraud/SIU outreach.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privacyOptOutFlag rdf:type rdf:Property ;
    rdfs:label 'Privacy Opt Out Flag' ;
    rdfs:comment 'Indicates the party has exercised their right to opt out of information sharing with non-affiliated third parties under GLBA/CCPA. Restricts data sharing in downstream systems.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sicCode rdf:type rdf:Property ;
    rdfs:label 'Sic Code' ;
    rdfs:comment 'Four-digit SIC code for an organization party. Legacy classification used alongside NAICS in commercial underwriting, ISO rating, and NAIC statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Identifies the operational system of record that originated this party record (e.g., PAS = Guidewire PolicyCenter, CLAIMS = ClaimCenter). Used for MDM lineage and deduplication.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemPartyCode rdf:type rdf:Property ;
    rdfs:label 'Source System Party Code' ;
    rdfs:comment 'The party\'s native identifier in the originating operational system (e.g., Guidewire contact ID, ClaimCenter party ID). Enables cross-system reconciliation and MDM matching.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter US state or territory code (USPS abbreviation) for the party\'s primary address. Determines applicable DOI jurisdiction, rate filings, and statutory requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'State Of Incorporation' ;
    rdfs:comment 'Two-letter US state code where the organization was legally incorporated. Relevant for surplus lines eligibility, admitted vs non-admitted determination, and regulatory filings.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdType rdf:type rdf:Property ;
    rdfs:label 'Tax Id Type' ;
    rdfs:comment 'Classifies the tax identifier held in the party identifier table: Social Security Number (SSN), Federal Employer Identification Number (FEIN), Individual Taxpayer Identification Number (ITIN), or other.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to the party record in the MDM system. Used for change data capture, audit trails, and downstream incremental loads.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:yearsInBusiness rdf:type rdf:Property ;
    rdfs:label 'Years In Business' ;
    rdfs:comment 'Number of years the organization has been in continuous operation. Used in commercial lines underwriting as a risk factor for BOP, CGL, and E&O eligibility.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roleId rdf:type rdf:Property ;
    rdfs:label 'Role Id' ;
    rdfs:comment 'Unique surrogate identifier for a party role assignment. One row per party-role assignment instance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Role .

ind:claimId rdf:type rdf:Property ;
    rdfs:label 'Claim Id' ;
    rdfs:comment 'Reference to the claim under which this role is assigned, when the role is claim-scoped (e.g., claimant, adjuster, payee on a specific claim).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:policyId rdf:type rdf:Property ;
    rdfs:label 'Policy Id' ;
    rdfs:comment 'Reference to the policy under which this role is assigned, when the role is policy-scoped (e.g., policyholder, named insured, additional insured).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:policyTermId rdf:type rdf:Property ;
    rdfs:label 'Policy Term Id' ;
    rdfs:comment 'Foreign key linking to policy.term. Business justification: Additional insureds, named insureds, and other party roles are added or removed by endorsement within a specific policy term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Term .

ind:acordRoleCode rdf:type rdf:Property ;
    rdfs:label 'Acord Role Code' ;
    rdfs:comment 'Standardized ACORD data standard role code for this party role assignment. Enables interoperability with trading partners, MGAs, and reinsurers using ACORD XML/JSON.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentReason rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason' ;
    rdfs:comment 'Business reason that triggered the creation of this role assignment. Supports audit trails and lifecycle analysis across the policy and claims lifecycle. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedDate rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Date' ;
    rdfs:comment 'Date on which the required consent was obtained from the party for this role. Null if consent has not yet been obtained or is not required.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'Date on which this party role assignment becomes effective. Used to reconstruct roles in force at any given date, including the loss date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date on which this party role assignment expires or is terminated. Null indicates the role is open-ended and currently active.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fraudScore rdf:type rdf:Property ;
    rdfs:label 'Fraud Score' ;
    rdfs:comment 'Numeric fraud risk score assigned to this party in this role by the fraud detection system. Higher values indicate greater fraud risk. Range 0.00 to 100.00.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guardianFlag rdf:type rdf:Property ;
    rdfs:label 'Guardian Flag' ;
    rdfs:comment 'Indicates whether this party is acting as a legal guardian for a minor or incapacitated insured in this role. Affects claims payment authorization and policy management.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestTypeCode rdf:type rdf:Property ;
    rdfs:label 'Interest Type Code' ;
    rdfs:comment 'Specifies the nature of the insurable interest held by the party in this role. Relevant for property and auto lines where multiple parties have financial interests.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Is Consent Required' ;
    rdfs:comment 'Flags whether this party role requires explicit consent for data processing or communications under GLBA, GDPR, or CCPA privacy regulations.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryRole rdf:type rdf:Property ;
    rdfs:label 'Is Primary Role' ;
    rdfs:comment 'Indicates whether this is the primary instance of the role type for the associated policy or claim. True for the first named insured or lead claimant.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycVerified rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified' ;
    rdfs:comment 'Indicates whether Know Your Customer identity verification has been completed for this party in this role. Required for producers and high-value policyholders.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'Preferred language for communications with this party in this role, expressed as a BCP 47 language tag (e.g., en-US, es-MX). Supports regulatory plain-language requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:litigationFlag rdf:type rdf:Property ;
    rdfs:label 'Litigation Flag' ;
    rdfs:comment 'Indicates whether this party role is involved in active litigation related to a claim or policy dispute. Triggers legal hold and restricts certain automated communications.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-text notes or remarks entered by underwriters, adjusters, or administrators regarding this specific party role assignment. Supports audit and workflow context.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'Preferred communication channel for this party in this role. Drives billing notices, policy documents, and claims correspondence delivery.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreenDate rdf:type rdf:Property ;
    rdfs:label 'Ofac Screen Date' ;
    rdfs:comment 'Most recent date on which the OFAC screening was performed for this party in this role. Supports periodic re-screening compliance requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ofacScreened rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened' ;
    rdfs:comment 'Indicates whether this party has been screened against the OFAC Specially Designated Nationals list for this role assignment. Mandatory for regulatory compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:powerOfAttorneyFlag rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Flag' ;
    rdfs:comment 'Indicates whether this party is acting under a power of attorney on behalf of another party in this role. Triggers additional documentation and authorization requirements.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relationshipToInsured rdf:type rdf:Property ;
    rdfs:label 'Relationship To Insured' ;
    rdfs:comment 'Describes the relationship of this party to the primary named insured. Used for household underwriting, rating, and claims adjudication. [ENUM-REF-CANDIDATE: SELF|SPOUSE|CHILD|PARENT|SIBLING|EMPLOYEE|PARTNER|OTHER — 8 candidates stripped; promote to' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:representedByCounsel rdf:type rdf:Property ;
    rdfs:label 'Represented By Counsel' ;
    rdfs:comment 'Indicates whether this party is represented by legal counsel in this role. When True, all communications must be directed to the attorney of record.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roleStatus rdf:type rdf:Property ;
    rdfs:label 'Role Status' ;
    rdfs:comment 'Current lifecycle state of this party role assignment. Drives eligibility checks, billing, and claims adjudication workflows.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Ordinal position when multiple parties hold the same role type on the same policy or claim (e.g., first named insured = 1, second named insured = 2).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:siuReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Flag' ;
    rdfs:comment 'Indicates whether this party role has been referred to the Special Investigations Unit for fraud investigation. Relevant for claimant and adjuster roles.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemRoleCode rdf:type rdf:Property ;
    rdfs:label 'Source System Role Code' ;
    rdfs:comment 'The native identifier for this role assignment in the originating source system (e.g., Guidewire PolicyCenter contact role ID). Supports lineage and reconciliation.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtypeCode rdf:type rdf:Property ;
    rdfs:label 'Subtype Code' ;
    rdfs:comment 'Further classifies the role within its type. For example, distinguishes First Party from Third Party claimants, or Primary from Secondary named insureds.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identification Number' ;
    rdfs:comment 'Federal tax identifier for this party in this role. May be an SSN for individuals or FEIN for organizations. Required for 1099 and statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Tax Reporting Required' ;
    rdfs:comment 'Indicates whether IRS tax reporting (e.g., 1099 issuance) is required for payments made to this party in this role. Relevant for payee, claimant, and producer roles.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'Business reason for the termination or expiration of this role assignment. Null if the role is still active. Supports regulatory and audit reporting. [ENUM-REF-CANDIDATE: CANCELLATION|NON_RENEWAL|ENDORSEMENT_REMOVAL|CLAIM_CLOSED|DEATH|COURT_ORDER|OTHER —' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeCode rdf:type rdf:Property ;
    rdfs:label 'Type Code' ;
    rdfs:comment 'Classifies the functional role the party plays in the insurance lifecycle. [ENUM-REF-CANDIDATE: POLICYHOLDER|NAMED_INSURED|ADDITIONAL_INSURED|CLAIMANT|PRODUCER|ADJUSTER|PAYEE|MORTGAGEE|LOSS_PAYEE|ADDITIONAL_INTEREST — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:w9OnFile rdf:type rdf:Property ;
    rdfs:label 'W9 On File' ;
    rdfs:comment 'Indicates whether a valid IRS Form W-9 has been collected and is on file for this party role. Required before issuing payments to producers, vendors, and claimants.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:w9ReceivedDate rdf:type rdf:Property ;
    rdfs:label 'W9 Received Date' ;
    rdfs:comment 'Date on which the IRS Form W-9 was received from this party for this role. Supports tax compliance audit trails and payment hold management.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:individualId rdf:type rdf:Property ;
    rdfs:label 'Individual Id' ;
    rdfs:comment 'Unique surrogate key identifying a natural person in the party master. One row per individual. MASTER_PARTY role; canonical-attrs-enforced.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:householdId rdf:type rdf:Property ;
    rdfs:label 'Household Id' ;
    rdfs:comment 'Foreign key linking to party.household. Business justification: An individual person belongs to a household — the canonical 1:N relationship for grouping family members.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Household .

ind:birthDate rdf:type rdf:Property ;
    rdfs:label 'Birth Date' ;
    rdfs:comment 'Individual\'s date of birth in ISO 8601 format. Used for age-based rating, eligibility screening, MVR ordering, and FCRA-compliant underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:citizenshipCountryCode rdf:type rdf:Property ;
    rdfs:label 'Citizenship Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the individual\'s country of citizenship. Used for KYC, OFAC screening, and international policy eligibility.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Clue Consent Flag' ;
    rdfs:comment 'Indicates whether the individual has consented to a CLUE report pull for prior loss history. Required under FCRA before accessing LexisNexis CLUE data.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationPreference rdf:type rdf:Property ;
    rdfs:label 'Communication Preference' ;
    rdfs:comment 'Individual\'s preferred channel for receiving policy documents, billing notices, and claims correspondence. Drives document delivery routing in the PAS and billing system.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScoreSource rdf:type rdf:Property ;
    rdfs:label 'Credit Score Source' ;
    rdfs:comment 'Name of the consumer reporting agency or scoring model that provided the insurance credit score. Required for FCRA adverse action notices and audit trails.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deceasedDate rdf:type rdf:Property ;
    rdfs:label 'Deceased Date' ;
    rdfs:comment 'Date of death for the individual if known. Triggers policy lifecycle actions (cancellation, beneficiary notification) and stops renewal processing.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driversLicenseExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Drivers License Expiry Date' ;
    rdfs:comment 'Expiration date of the individual\'s driver license. Used to flag expired licenses during auto underwriting eligibility checks and renewal processing.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driversLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Drivers License Number' ;
    rdfs:comment 'State-issued driver license number for the individual. Required for MVR ordering, auto underwriting eligibility, and claims investigation in personal and commercial auto lines.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driversLicenseState rdf:type rdf:Property ;
    rdfs:label 'Drivers License State' ;
    rdfs:comment 'Two-letter USPS state code of the jurisdiction that issued the individual\'s driver license. Required to route MVR orders to the correct state DMV.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerName rdf:type rdf:Property ;
    rdfs:label 'Employer Name' ;
    rdfs:comment 'Name of the individual\'s current employer. Used in commercial lines underwriting, group policy eligibility verification, and workers compensation exposure assessment.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Legal given name of the individual as it appears on government-issued identification. Used for policy issuance, claims, and regulatory reporting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderCode rdf:type rdf:Property ;
    rdfs:label 'Gender Code' ;
    rdfs:comment 'Gender of the individual as reported. M=Male, F=Female, X=Non-binary/Other, U=Unknown. Used in auto and life rating where permitted by state DOI regulations.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Legal surname of the individual as it appears on government-issued identification. Used for policy issuance, claims, and regulatory reporting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maritalStatusCode rdf:type rdf:Property ;
    rdfs:label 'Marital Status Code' ;
    rdfs:comment 'Marital status of the individual. S=Single, M=Married, D=Divorced, W=Widowed, P=Domestic Partner. Used as a rating variable in personal auto and homeowners lines.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:middleName rdf:type rdf:Property ;
    rdfs:label 'Middle Name' ;
    rdfs:comment 'Legal middle name or initial of the individual. Used for identity disambiguation and matching against MVR and CLUE reports.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Mvr Consent Flag' ;
    rdfs:comment 'Indicates whether the individual has provided written consent for the insurer to order an MVR report. Required under FCRA before pulling driving history for underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mvrOrderDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Order Date' ;
    rdfs:comment 'Date on which the most recent MVR report was ordered for this individual. Used to determine MVR currency and trigger re-order at renewal per underwriting guidelines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:namePrefix rdf:type rdf:Property ;
    rdfs:label 'Name Prefix' ;
    rdfs:comment 'Honorific or title prefix for the individual\'s name (e.g., Mr., Dr.). Used in correspondence, policy documents, and declarations pages.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameSuffix rdf:type rdf:Property ;
    rdfs:label 'Name Suffix' ;
    rdfs:comment 'Generational or professional suffix appended to the individual\'s legal name (e.g., Jr., Sr., II). Used for precise identity matching and document generation.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupationCode rdf:type rdf:Property ;
    rdfs:label 'Occupation Code' ;
    rdfs:comment 'Standardized occupation classification code for the individual. Used as a rating variable in personal lines and for SIC/NAICS alignment in commercial underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupationDescription rdf:type rdf:Property ;
    rdfs:label 'Occupation Description' ;
    rdfs:comment 'Free-text description of the individual\'s occupation or job title as self-reported on the application. Supplements the occupation code for underwriting review.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreenedFlag rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened Flag' ;
    rdfs:comment 'Indicates whether the individual has been screened against the OFAC Specially Designated Nationals list. Mandatory before policy issuance and claim payment.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Preferred Language Code' ;
    rdfs:comment 'BCP 47 language tag representing the individual\'s preferred communication language (e.g., en-US, es-MX). Used for policy document generation and claims correspondence.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCarrierName rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Name' ;
    rdfs:comment 'Name of the individual\'s most recent prior insurance carrier. Used in underwriting to verify continuous coverage and assess prior loss history context.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Expiry Date' ;
    rdfs:comment 'Expiration date of the individual\'s most recent prior policy. Used to calculate coverage lapse duration and apply lapse surcharges per underwriting guidelines.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:residencyCountryCode rdf:type rdf:Property ;
    rdfs:label 'Residency Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the individual\'s country of primary residence. Used for jurisdictional rating, regulatory compliance, and tax reporting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residencyStateCode rdf:type rdf:Property ;
    rdfs:label 'Residency State Code' ;
    rdfs:comment 'Two-letter USPS state code of the individual\'s state of primary residence. Determines applicable state DOI regulations, rating territory, and statutory form requirements.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siuReferralDate rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Date' ;
    rdfs:comment 'Date on which this individual was most recently referred to the Special Investigations Unit for fraud investigation. Null if no referral has occurred.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemPersonCode rdf:type rdf:Property ;
    rdfs:label 'Source System Person Code' ;
    rdfs:comment 'Native identifier for this individual in the originating operational system (e.g., Guidewire PolicyCenter contact ID). Used for cross-system reconciliation and ETL lineage.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnHash rdf:type rdf:Property ;
    rdfs:label 'Ssn Hash' ;
    rdfs:comment 'One-way cryptographic hash of the individual\'s SSN. Used for identity deduplication and CLUE/MVR ordering without storing the raw SSN in the lakehouse.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnLastFour rdf:type rdf:Property ;
    rdfs:label 'Ssn Last Four' ;
    rdfs:comment 'Last four digits of the individual\'s SSN retained for identity verification and customer service purposes per GLBA data minimization requirements.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsContinuouslyInsured rdf:type rdf:Property ;
    rdfs:label 'Years Continuously Insured' ;
    rdfs:comment 'Number of years the individual has maintained continuous insurance coverage without a lapse. Used as a rating and eligibility variable in personal lines underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:organizationId rdf:type rdf:Property ;
    rdfs:label 'Organization Id' ;
    rdfs:comment 'Unique surrogate identifier for the organization record in the party master data management system. Primary key for the organization entity.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currencyId rdf:type rdf:Property ;
    rdfs:label 'Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: Commercial insured organizations report annual_revenue and financial statements in a functional currency.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:mailingAddressId rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Organization embeds mailing address fields that duplicate the address table structure. The address table is the SSOT for all addresses and provides geocoding, territory codes, CAT zones, and' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:parentOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Parent Organization Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediate parent organization in a corporate hierarchy. Supports enterprise account management, consolidated TIV, and group policy structures.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:primaryUltimateParentOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Primary Ultimate Parent Organization Id' ;
    rdfs:comment 'Identifier of the top-level ultimate parent in the corporate ownership hierarchy. Used for enterprise-wide exposure aggregation, PML modeling, and group reinsurance treaty application.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:annualPayroll rdf:type rdf:Property ;
    rdfs:label 'Annual Payroll' ;
    rdfs:comment 'Organization\'s total annual payroll in USD. Primary rating basis for Workers Compensation (WC) and a secondary factor for CGL and employer liability lines.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualRevenue rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue' ;
    rdfs:comment 'Organization\'s most recently reported annual gross revenue in USD. Used as a rating basis for CGL, E&O, D&O, and EPLI lines, and for exposure-based premium calculations.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dbaName rdf:type rdf:Property ;
    rdfs:label 'Dba Name' ;
    rdfs:comment 'Trade name or doing-business-as name used by the organization in commercial operations, which may differ from the registered legal name.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dunsNumber rdf:type rdf:Property ;
    rdfs:label 'Duns Number' ;
    rdfs:comment 'Nine-digit Dun & Bradstreet Data Universal Numbering System (DUNS) number for the organization. Used for commercial credit scoring, financial strength assessment, and third-party data enrichment.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeCount rdf:type rdf:Property ;
    rdfs:label 'Employee Count' ;
    rdfs:comment 'Total number of full-time equivalent employees. Used in underwriting for WC classification, EPLI exposure assessment, and BOP eligibility determination.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Legal structure of the organization (e.g., corporation, LLC, partnership). Drives underwriting eligibility, policy form selection, and liability exposure assessment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fein rdf:type rdf:Property ;
    rdfs:label 'Fein' ;
    rdfs:comment 'IRS-issued Federal Employer Identification Number (FEIN) uniquely identifying the organization for tax and regulatory purposes. Required for commercial policy issuance and 1099 reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementDate rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Date' ;
    rdfs:comment 'Date of the most recent financial statement used to derive annual revenue and payroll figures. Ensures underwriting data currency and supports audit trail for rating basis.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fraudIndicator rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator' ;
    rdfs:comment 'Flag set by the SIU or fraud detection system indicating the organization has been associated with suspected or confirmed fraudulent activity. Triggers underwriting referral.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incorporationCountry rdf:type rdf:Property ;
    rdfs:label 'Incorporation Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code where the organization is incorporated. Required for international commercial accounts, reinsurance counterparties, and OFAC/sanctions screening.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incorporationDate rdf:type rdf:Property ;
    rdfs:label 'Incorporation Date' ;
    rdfs:comment 'Date the organization was legally incorporated or formed. Used in underwriting to assess years in business, business continuity risk, and eligibility for certain commercial lines.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incorporationState rdf:type rdf:Property ;
    rdfs:label 'Incorporation State' ;
    rdfs:comment 'Two-letter US state code where the organization is legally incorporated or registered. Used for jurisdictional underwriting rules, admitted vs. surplus lines determination, and regulatory compliance.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'Full legal name of the organization as registered with the state or federal authority. Used on policy declarations, certificates of insurance, and regulatory filings.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicCode rdf:type rdf:Property ;
    rdfs:label 'Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code assigned to insurance carriers and reinsurers. Used for statutory reporting, Schedule F, and reinsurance counterparty identification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsDescription rdf:type rdf:Property ;
    rdfs:label 'Naics Description' ;
    rdfs:comment 'Plain-text description of the organization\'s primary business activity corresponding to the NAICS code. Provides human-readable context for underwriters and auditors.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publiclyTraded rdf:type rdf:Property ;
    rdfs:label 'Publicly Traded' ;
    rdfs:comment 'Indicates whether the organization\'s securities are publicly traded on a recognized exchange. Relevant for D&O, EPLI, and E&O underwriting and for financial disclosure requirements.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemRefCode rdf:type rdf:Property ;
    rdfs:label 'Source System Ref Code' ;
    rdfs:comment 'Native identifier of this organization record in the originating source system. Enables cross-system reconciliation, deduplication, and lineage tracing in the MDM and data lakehouse.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockTicker rdf:type rdf:Property ;
    rdfs:label 'Stock Ticker' ;
    rdfs:comment 'Exchange ticker symbol for publicly traded organizations. Used in D&O underwriting, financial strength monitoring, and market capitalization-based exposure assessment.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Official website URL of the organization. Used in commercial underwriting for business activity verification, cyber risk assessment, and e-commerce exposure evaluation.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressId rdf:type rdf:Property ;
    rdfs:label 'Address Id' ;
    rdfs:comment 'Unique surrogate identifier for each address record in the party domain. Primary key. One row per address per party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:catZoneId rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.cat_zone. Business justification: Underwriting eligibility decisions, moratorium enforcement, and concentration management require direct cat_zone assignment to addresses.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatZone .

ind:acordAddressTypeCode rdf:type rdf:Property ;
    rdfs:label 'Acord Address Type Code' ;
    rdfs:comment 'ACORD standard address type code from the ACORD data dictionary. Enables interoperability with ACORD 125/126/140 forms and carrier/agency data exchanges.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressStatus rdf:type rdf:Property ;
    rdfs:label 'Address Status' ;
    rdfs:comment 'Current operational status of the address record. Active addresses receive policy documents and billing. Returned_mail triggers address update workflow in the PAS.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressType rdf:type rdf:Property ;
    rdfs:label 'Address Type' ;
    rdfs:comment 'Classifies the purpose of the address: mailing for correspondence, billing for invoices, risk for insured property location, garaging for auto, loss for claim site.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careOfName rdf:type rdf:Property ;
    rdfs:label 'Care Of Name' ;
    rdfs:comment 'In-care-of name for mail delivery when correspondence is directed through a third party (e.g., attorney, trustee, mortgagee). Common for additional insured notices.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusTract rdf:type rdf:Property ;
    rdfs:label 'Census Tract' ;
    rdfs:comment 'US Census Bureau census tract code for the address. Used for demographic risk analysis, CRA compliance, and actuarial territory segmentation in pricing models.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coastalIndicator rdf:type rdf:Property ;
    rdfs:label 'Coastal Indicator' ;
    rdfs:comment 'Flags whether the address is within a defined coastal zone subject to enhanced windstorm, storm surge, or tidal flood exposure. Used in underwriting eligibility screening.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:congressionalDistrict rdf:type rdf:Property ;
    rdfs:label 'Congressional District' ;
    rdfs:comment 'US Congressional district code for the address. Used for regulatory reporting, legislative tracking, and state DOI jurisdictional filings.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County or parish name for the address. Used for territory rating, surplus lines stamping, local tax jurisdiction, and catastrophe exposure aggregation.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceToCoastMiles rdf:type rdf:Property ;
    rdfs:label 'Distance To Coast Miles' ;
    rdfs:comment 'Straight-line distance in miles from the address to the nearest coastline. Used in windstorm rating, coastal surcharge calculation, and catastrophe model inputs.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distanceToFireStationMiles rdf:type rdf:Property ;
    rdfs:label 'Distance To Fire Station Miles' ;
    rdfs:comment 'Distance in miles from the address to the nearest responding fire station. Used in ISO PPC determination and property rating for rural or semi-rural locations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doNotMailIndicator rdf:type rdf:Property ;
    rdfs:label 'Do Not Mail Indicator' ;
    rdfs:comment 'Suppresses physical mail delivery to this address per party preference or returned mail. Compliance with GLBA and state DOI notice delivery requirements.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dpvConfirmationCode rdf:type rdf:Property ;
    rdfs:label 'Dpv Confirmation Code' ;
    rdfs:comment 'USPS DPV result: Y=confirmed deliverable, S=primary match only, D=default match, N=not confirmed. Validates address deliverability for policy documents and billing.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fipsCode rdf:type rdf:Property ;
    rdfs:label 'Fips Code' ;
    rdfs:comment 'Five-digit FIPS county code (2-digit state + 3-digit county). Used for catastrophe modeling, PML aggregation, and regulatory geographic reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireProtectionClass rdf:type rdf:Property ;
    rdfs:label 'Fire Protection Class' ;
    rdfs:comment 'ISO Public Protection Classification (PPC) code (1-10) for the address. Directly impacts property insurance rating; class 1 is best, 10 is unprotected.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geocodeQuality rdf:type rdf:Property ;
    rdfs:label 'Geocode Quality' ;
    rdfs:comment 'Precision level of the geocoded coordinates. Rooftop is highest precision; zip_centroid is lowest. Drives confidence weighting in catastrophe PML and AAL models.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geocodeSource rdf:type rdf:Property ;
    rdfs:label 'Geocode Source' ;
    rdfs:comment 'Name of the geocoding service or vendor that produced the latitude/longitude (e.g., Google Maps API, HERE, TomTom, ESRI). Supports data lineage and quality audits.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Iso Territory Code' ;
    rdfs:comment 'ISO-assigned rating territory code for this address. Used by the rating engine to apply territory-specific loss costs and rate factors per ISO circulars.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate in decimal degrees (WGS84). Enables precise catastrophe hazard scoring, PML modeling, and territory assignment for insured locations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:line1 rdf:type rdf:Property ;
    rdfs:label 'Line1' ;
    rdfs:comment 'Primary street address line including house/building number and street name. Used for mail delivery, risk location identification, and regulatory filings.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:line2 rdf:type rdf:Property ;
    rdfs:label 'Line2' ;
    rdfs:comment 'Secondary address line for suite, apartment, unit, floor, or building designator. Supplements address_line1 for complete delivery address.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate in decimal degrees (WGS84). Paired with latitude for precise catastrophe hazard scoring and exposure aggregation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poBox rdf:type rdf:Property ;
    rdfs:label 'Po Box' ;
    rdfs:comment 'Post Office box number when the mailing address is a PO Box rather than a street address. Used for billing and correspondence when party does not receive street delivery.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryIndicator rdf:type rdf:Property ;
    rdfs:label 'Primary Indicator' ;
    rdfs:comment 'Flags this as the primary address for the party when multiple addresses of the same type exist. Exactly one address per party per type should be primary at any time.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:province rdf:type rdf:Property ;
    rdfs:label 'Province' ;
    rdfs:comment 'Province or region name for non-US addresses (e.g., Canadian provinces, Mexican states). Required for international policies and IFRS 17 geographic segmentation.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalIndicator rdf:type rdf:Property ;
    rdfs:label 'Seasonal Indicator' ;
    rdfs:comment 'Indicates the address is a seasonal or secondary residence (e.g., vacation home). Relevant for homeowners underwriting, vacancy conditions, and occupancy rating.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemAddressCode rdf:type rdf:Property ;
    rdfs:label 'Source System Address Code' ;
    rdfs:comment 'Native address identifier from the originating operational system (e.g., Guidewire internal ID). Enables reconciliation between the lakehouse and the system of record.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'IANA time zone identifier for the address location (e.g., America/New_York). Used for loss date/time determination, FNOL timestamping, and notice deadline calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uspsStandardizedIndicator rdf:type rdf:Property ;
    rdfs:label 'Usps Standardized Indicator' ;
    rdfs:comment 'Indicates whether the address has been validated and standardized against the USPS Coding Accuracy Support System (CASS). Ensures deliverability and geocoding accuracy.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:windPoolIndicator rdf:type rdf:Property ;
    rdfs:label 'Wind Pool Indicator' ;
    rdfs:comment 'Indicates whether this address falls within a state wind pool or FAIR plan territory (e.g., Texas Windstorm, Florida Citizens). Affects coverage eligibility and reinsurance.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zipCode rdf:type rdf:Property ;
    rdfs:label 'Zip Code' ;
    rdfs:comment 'Five-digit US ZIP code for the address. Used for territory rating, catastrophe zone assignment, and USPS mail delivery routing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipPlus4 rdf:type rdf:Property ;
    rdfs:label 'Zip Plus4' ;
    rdfs:comment 'Four-digit ZIP+4 extension providing carrier route precision for USPS delivery. Enhances geocoding accuracy for catastrophe modeling and territory rating.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactId rdf:type rdf:Property ;
    rdfs:label 'Contact Id' ;
    rdfs:comment 'Unique surrogate identifier for each contact point record in the party contact master. One row per contact point per party.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acordContactTypeCode rdf:type rdf:Property ;
    rdfs:label 'Acord Contact Type Code' ;
    rdfs:comment 'ACORD standard contact type code from the ACORD data dictionary (e.g., ACORD 125/126 PhoneInfo/EmailInfo type codes). Enables interoperability with trading partners.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestContactTimeEnd rdf:type rdf:Property ;
    rdfs:label 'Best Contact Time End' ;
    rdfs:comment 'Latest time of day (HH:MM, 24-hour local) the party prefers to be contacted via this channel. Supports TCPA-compliant outbound call scheduling.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestContactTimeStart rdf:type rdf:Property ;
    rdfs:label 'Best Contact Time Start' ;
    rdfs:comment 'Earliest time of day (HH:MM, 24-hour local) the party prefers to be contacted via this channel. Supports TCPA-compliant outbound call scheduling.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentSource rdf:type rdf:Property ;
    rdfs:label 'Consent Source' ;
    rdfs:comment 'Channel or mechanism through which opt-in consent was captured (e.g., web_form, agent_recorded, ivr, written). Supports GLBA and TCPA audit trail requirements.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactStatus rdf:type rdf:Property ;
    rdfs:label 'Contact Status' ;
    rdfs:comment 'Current lifecycle status of this contact point. Bounced indicates delivery failure; opted_out reflects GLBA/TCPA suppression. Drives communication eligibility.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactType rdf:type rdf:Property ;
    rdfs:label 'Contact Type' ;
    rdfs:comment 'Classification of the communication channel for this contact point (e.g., phone, email, fax, sms, postal_address, web_portal). Drives routing in PAS and CMS.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotContactReason rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Reason' ;
    rdfs:comment 'Reason code explaining why the do_not_contact_flag is set. Supports legal hold, regulatory order, and SIU fraud investigation suppression scenarios.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Structured email address for the party when contact_type is email. Stored separately for validation, opt-in tracking, and GLBA compliance.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailBounceCode rdf:type rdf:Property ;
    rdfs:label 'Email Bounce Code' ;
    rdfs:comment 'SMTP bounce code or classification (e.g., 550 hard bounce, 421 soft bounce) returned when an email delivery attempt failed. Used to update contact_status to bounced.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPreferred rdf:type rdf:Property ;
    rdfs:label 'Is Preferred' ;
    rdfs:comment 'Indicates whether this is the party\'s overall preferred contact method across all contact types. Used by PAS and CMS to select the default outreach channel.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Indicates whether this contact point is the primary contact for the party within its contact_type. Only one record per party per contact_type should be primary.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVerifiedMobile rdf:type rdf:Property ;
    rdfs:label 'Is Verified Mobile' ;
    rdfs:comment 'Indicates whether a phone contact point has been confirmed as a mobile/wireless number via carrier lookup. Critical for TCPA autodialer and text message compliance.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWireless rdf:type rdf:Property ;
    rdfs:label 'Is Wireless' ;
    rdfs:comment 'Indicates whether the phone number is a wireless (cell) number as determined by carrier lookup. Distinct from is_verified_mobile; set by automated number type detection.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Contact Date' ;
    rdfs:comment 'Most recent date on which a successful outbound or inbound communication was recorded via this contact point. Used for contact recency analytics and dormancy detection.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastContactOutcome rdf:type rdf:Property ;
    rdfs:label 'Last Contact Outcome' ;
    rdfs:comment 'Result of the most recent communication attempt via this contact point (e.g., reached, no_answer, voicemail, bounced). Informs next-best-action in claims and billing.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optInFlag rdf:type rdf:Property ;
    rdfs:label 'Opt In Flag' ;
    rdfs:comment 'Indicates whether the party has affirmatively opted in to receive communications via this contact point. Required for GLBA and TCPA compliance tracking.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Opt In Timestamp' ;
    rdfs:comment 'Date and time when the party provided opt-in consent for this contact point. Retained as evidence of consent for GLBA and TCPA regulatory audits.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:optOutFlag rdf:type rdf:Property ;
    rdfs:label 'Opt Out Flag' ;
    rdfs:comment 'Indicates whether the party has explicitly opted out of communications via this contact point. Suppresses outbound contact in PAS, CMS, and Billing systems.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutTimestamp rdf:type rdf:Property ;
    rdfs:label 'Opt Out Timestamp' ;
    rdfs:comment 'Date and time when the party revoked consent or opted out for this contact point. Triggers suppression in all downstream communication systems.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:phoneExtension rdf:type rdf:Property ;
    rdfs:label 'Phone Extension' ;
    rdfs:comment 'Optional telephone extension appended to the phone number for commercial parties, brokers, or agency contacts in the Producer Management System.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneNumber rdf:type rdf:Property ;
    rdfs:label 'Phone Number' ;
    rdfs:comment 'Structured phone number in E.164 format for the party when contact_type is phone or sms. Used for FNOL intake, billing, and claims communication.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemContactCode rdf:type rdf:Property ;
    rdfs:label 'Source System Contact Code' ;
    rdfs:comment 'Native identifier of this contact record in the originating operational system (e.g., Guidewire ContactID). Enables cross-system reconciliation and MDM deduplication.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtype rdf:type rdf:Property ;
    rdfs:label 'Subtype' ;
    rdfs:comment 'Secondary classification refining the contact type (e.g., home, work, mobile, billing, claims, underwriting). [ENUM-REF-CANDIDATE: home|work|mobile|billing|claims|underwriting|other — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usagePurpose rdf:type rdf:Property ;
    rdfs:label 'Usage Purpose' ;
    rdfs:comment 'Business purpose for which this contact point is used (e.g., billing notices, claims FNOL, policy documents, marketing). Drives targeted communication routing.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:value rdf:type rdf:Property ;
    rdfs:label 'Value' ;
    rdfs:comment 'The actual contact point value: phone number, email address, fax number, SMS number, or postal address string depending on contact_type. Contains PII.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date on which the contact point was last verified through a validation process such as email ping, carrier lookup, or agent confirmation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify this contact point (e.g., carrier_lookup for phone, email_ping for email, agent_confirmed for manual review). Supports MDM data quality.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Indicates whether this contact point has been validated (e.g., email deliverability check, phone number validation via carrier lookup). Used in KYC and MDM.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifierId rdf:type rdf:Property ;
    rdfs:label 'Identifier Id' ;
    rdfs:comment 'Surrogate primary key uniquely identifying one party identifier record. One row per identifier per party. Grain: one row per external or internal identifier assigned to a party.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:identifierMdmGoldenPartyId rdf:type rdf:Property ;
    rdfs:label 'Identifier Mdm Golden Party Id' ;
    rdfs:comment 'The MDM golden record identifier assigned to the party after deduplication and survivorship processing. Links this identifier to the authoritative master party record across all source systems.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:identifierPartyId rdf:type rdf:Property ;
    rdfs:label 'Identifier Party Id' ;
    rdfs:comment 'Reference to the party record that owns this identifier. Links the identifier back to the master party in the Customer/Party MDM.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:identifierPasPartyId rdf:type rdf:Property ;
    rdfs:label 'Identifier Pas Party Id' ;
    rdfs:comment 'The party identifier as assigned by the Policy Administration System (Guidewire PolicyCenter or Duck Creek Policy). Used for cross-reference between the data lakehouse and the PAS.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:licenseId rdf:type rdf:Property ;
    rdfs:label 'License Id' ;
    rdfs:comment 'Foreign key linking to party.license. Business justification: The identifier table stores raw external identifier values (license numbers, NPNs, SSNs, TINs) as typed records, while the license table stores the full structured license entity with status' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:License .

ind:clueReportOrdered rdf:type rdf:Property ;
    rdfs:label 'Clue Report Ordered' ;
    rdfs:comment 'Indicates whether a CLUE (Comprehensive Loss Underwriting Exchange) report has been ordered for this party identifier. Used in personal lines underwriting to retrieve prior loss history.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dedupMatchKey rdf:type rdf:Property ;
    rdfs:label 'Dedup Match Key' ;
    rdfs:comment 'Normalized, standardized form of the identifier value used for fuzzy matching and deduplication in the Party MDM. Strips formatting characters (dashes, spaces) for consistent comparison.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifierStatus rdf:type rdf:Property ;
    rdfs:label 'Identifier Status' ;
    rdfs:comment 'Current lifecycle status of this identifier record: active (in use), inactive (superseded), expired (past validity), revoked (cancelled by issuing authority), pending_verification (awaiting confirmation).' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMasked rdf:type rdf:Property ;
    rdfs:label 'Is Masked' ;
    rdfs:comment 'Indicates whether the identifier_value stored is a masked or tokenized representation rather than the full plaintext value. True when only last-4 digits or a token is stored for PCI/GLBA compliance.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'Name of the government agency, regulatory body, or internal system that issued this identifier (e.g., IRS, SSA, NIPR, state DMV, state DOI, NAIC, internal MDM system).' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the country that issued this identifier (e.g., USA, CAN, GBR). Required for passports and foreign national identifiers.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingStateCode rdf:type rdf:Property ;
    rdfs:label 'Issuing State Code' ;
    rdfs:comment 'Two-letter US state or territory code of the jurisdiction that issued this identifier. Applicable for driver licenses, state-issued producer licenses, and state DOI registrations.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseClass rdf:type rdf:Property ;
    rdfs:label 'License Class' ;
    rdfs:comment 'Classification of the license associated with this identifier (e.g., producer license class: P&C, Life, Health; driver license class: A, B, C, M). Applicable for DLN and producer license identifier types.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseStateCode rdf:type rdf:Property ;
    rdfs:label 'License State Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction under which the license was issued. Distinct from issuing_state_code when a producer holds licenses in multiple states.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maskedValue rdf:type rdf:Property ;
    rdfs:label 'Masked Value' ;
    rdfs:comment 'Partially masked display version of the identifier for UI and reporting use (e.g., ***-**-1234 for SSN, **-***1234 for FEIN). Allows display without exposing the full sensitive value.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mvrOrdered rdf:type rdf:Property ;
    rdfs:label 'Mvr Ordered' ;
    rdfs:comment 'Indicates whether a Motor Vehicle Record (MVR) has been ordered for this driver license identifier. Applicable when identifier_type_code = DLN. Used in personal and commercial auto underwriting.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naicCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Naic Company Code' ;
    rdfs:comment 'Five-digit NAIC company code assigned to an insurance carrier or reinsurer. Populated when identifier_type_code = NAIC_CODE. Used in statutory reporting and Schedule F/P filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npn rdf:type rdf:Property ;
    rdfs:label 'Npn' ;
    rdfs:comment 'NIPR-assigned National Producer Number for licensed insurance producers and agencies. Populated when identifier_type_code = NPN. Required for producer appointment and commission processing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Ofac Check Status' ;
    rdfs:comment 'Result of OFAC SDN (Specially Designated Nationals) screening for this identifier. Required for sanctions compliance. Cleared = no match; Flagged = potential match requiring review.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemPartyRef rdf:type rdf:Property ;
    rdfs:label 'Source System Party Ref' ;
    rdfs:comment 'The party or entity reference key as it exists in the originating source system. Enables cross-system reconciliation and deduplication between PAS, MDM, billing, and claims systems.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinMatchStatus rdf:type rdf:Property ;
    rdfs:label 'Tin Match Status' ;
    rdfs:comment 'Result of IRS TIN matching for SSN/FEIN identifiers. Used for 1099 reporting compliance and backup withholding determination. Values: matched, not_matched, pending, not_checked.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinType rdf:type rdf:Property ;
    rdfs:label 'Tin Type' ;
    rdfs:comment 'Specifies the type of IRS Taxpayer Identification Number: SSN (Social Security Number), FEIN (Federal Employer Identification Number), ITIN (Individual Taxpayer Identification Number), or EIN (Employer Identification Number).' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationSource rdf:type rdf:Property ;
    rdfs:label 'Verification Source' ;
    rdfs:comment 'Name of the system or service used to verify this identifier (e.g., NIPR, IRS TIN Match, SSA, LexisNexis, Equifax, state DMV MVR, CLUE). Supports audit and compliance documentation.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipId rdf:type rdf:Property ;
    rdfs:label 'Relationship Id' ;
    rdfs:comment 'Unique surrogate identifier for a directed party-to-party relationship record. One row per relationship instance in the Party MDM.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fromPartyId rdf:type rdf:Property ;
    rdfs:label 'From Party Id' ;
    rdfs:comment 'Surrogate key of the originating (subject) party in the directed relationship, e.g., the policyholder or parent organization.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:toPartyId rdf:type rdf:Property ;
    rdfs:label 'To Party Id' ;
    rdfs:comment 'Surrogate key of the target (object) party in the directed relationship, e.g., the additional insured or subsidiary organization.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:relationshipCategory rdf:type rdf:Property ;
    rdfs:label 'Relationship Category' ;
    rdfs:comment 'Broad grouping of the relationship type: Personal (family/household), Commercial (business hierarchy), Legal (trust/guardianship), or Financial (guarantor/beneficiary).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlFlag rdf:type rdf:Property ;
    rdfs:label 'Control Flag' ;
    rdfs:comment 'Indicates whether the from-party exercises a controlling interest over the to-party for regulatory group reporting and affiliated transaction disclosures.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBidirectional rdf:type rdf:Property ;
    rdfs:label 'Is Bidirectional' ;
    rdfs:comment 'Indicates whether the relationship is symmetric (True) or strictly directed (False). Symmetric relationships such as spouse do not require a reciprocal row.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCountryCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction governing the relationship. Supports international and surplus lines business.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionStateCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction governing the relationship. Drives state-specific underwriting rules, regulatory filings, and DOI compliance.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalBasisCode rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Code' ;
    rdfs:comment 'Legal instrument or authority establishing the relationship, e.g., MARRIAGE certificate, COURT_ORDER, CORPORATE_FILING. Required for KYC and regulatory compliance.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalBasisDate rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Date' ;
    rdfs:comment 'Date the legal instrument establishing the relationship was executed or issued, e.g., date of marriage, date of court order, date of corporate filing.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalBasisReference rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Reference' ;
    rdfs:comment 'Document reference number or identifier for the legal instrument establishing the relationship, e.g., marriage certificate number, court order docket number.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of ownership or controlling interest held by the from-party over the to-party. Applicable for parent-subsidiary and investor relationships. Range 0.00–100.00.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:relationshipStatus rdf:type rdf:Property ;
    rdfs:label 'Relationship Status' ;
    rdfs:comment 'Current lifecycle state of the relationship record. ACTIVE means the relationship is in force; TERMINATED means it has ended; PENDING means awaiting verification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleFrom rdf:type rdf:Property ;
    rdfs:label 'Role From' ;
    rdfs:comment 'The specific role the from-party plays within this relationship instance, e.g., POLICYHOLDER, PARENT, EMPLOYER. Complements relationship_type_code for granular role tracking.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleTo rdf:type rdf:Property ;
    rdfs:label 'Role To' ;
    rdfs:comment 'The specific role the to-party plays within this relationship instance, e.g., ADDITIONAL_INSURED, SUBSIDIARY, EMPLOYEE. Enables multi-role party resolution.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRelationshipCode rdf:type rdf:Property ;
    rdfs:label 'Source System Relationship Code' ;
    rdfs:comment 'Native identifier of this relationship record in the originating source system. Enables lineage tracing and reconciliation back to Guidewire PolicyCenter or Duck Creek.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Actual date the relationship was terminated or dissolved, which may differ from the scheduled expiration date (e.g., divorce decree date, corporate dissolution date).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:terminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Code' ;
    rdfs:comment 'Coded reason explaining why the relationship was terminated. Supports audit, compliance, and underwriting eligibility re-evaluation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Uw Impact Flag' ;
    rdfs:comment 'Indicates whether this relationship has a material impact on underwriting eligibility or rating, e.g., a parent-subsidiary relationship affecting group pricing or a household relationship affecting multi-car discount.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or user identifier of the compliance officer or underwriter who verified the relationship. Supports audit trail and SOX controls.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerificationId rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Id' ;
    rdfs:comment 'Unique surrogate identifier for each KYC verification record. One row per KYC check performed on a party. Grain: one row per KYC verification event per party.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jurisdictionGeographyId rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Geography Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.geography. Business justification: KYC regulatory compliance reporting requires tracking verification jurisdiction by state/country geography.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:lineOfBusinessId rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Id' ;
    rdfs:comment 'Foreign key linking to shared.line_of_business. Business justification: KYC due diligence level and risk tier are LOB-driven in P&C: surplus lines require enhanced KYC, commercial lines differ from personal lines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LineOfBusiness .

ind:primaryKycAnalystPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Kyc Analyst Party Id' ;
    rdfs:comment 'Identifier of the compliance analyst or underwriter who performed or reviewed this KYC verification. Required for manual review cases and audit accountability. Links to the Party or User record.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:submissionId rdf:type rdf:Property ;
    rdfs:label 'Submission Id' ;
    rdfs:comment 'Foreign key linking to coverage.submission. Business justification: KYC/OFAC screening performed during underwriting (pre-bind) requires linkage to submission for regulatory audit trail, SIU referral tracking, and compliance with AML requirements at' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Submission .

ind:tertiaryKycPartyId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Kyc Party Id' ;
    rdfs:comment 'Reference to the party (person or organization) subject to this KYC verification. Links to the Party master record in the Party domain.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:adverseMediaSummary rdf:type rdf:Property ;
    rdfs:label 'Adverse Media Summary' ;
    rdfs:comment 'Brief narrative summary of adverse media findings when is_adverse_media is true. Captures the nature of the negative news (e.g., fraud allegation, regulatory sanction) for analyst review and documentation.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystDecision rdf:type rdf:Property ;
    rdfs:label 'Analyst Decision' ;
    rdfs:comment 'Final decision made by the compliance analyst after reviewing the KYC verification results. APPROVE=cleared to proceed; REJECT=relationship declined; ESCALATE=referred to senior compliance; DEFER=pending additional info.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystNotes rdf:type rdf:Property ;
    rdfs:label 'Analyst Notes' ;
    rdfs:comment 'Free-text notes entered by the compliance analyst documenting the rationale for the decision, exceptions granted, or additional context observed during the KYC review process.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficialOwnerCount rdf:type rdf:Property ;
    rdfs:label 'Beneficial Owner Count' ;
    rdfs:comment 'Number of beneficial owners identified and verified for a legal entity party. Per FinCEN CDD Rule, includes all natural persons owning 25% or more equity interest plus one control person.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:beneficialOwnerVerified rdf:type rdf:Property ;
    rdfs:label 'Beneficial Owner Verified' ;
    rdfs:comment 'Indicates whether the beneficial ownership of the party (for legal entities) has been verified per FinCEN CDD Rule requirements. Mandatory for legal entity customers with 25%+ ownership threshold.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceCode rdf:type rdf:Property ;
    rdfs:label 'Data Source Code' ;
    rdfs:comment 'Code identifying the originating system or data source for this KYC verification record (e.g., MDM_KYC, PAS_UW, CLAIMS_FNOL). Supports data lineage and source-system reconciliation in the lakehouse.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueDiligenceLevel rdf:type rdf:Property ;
    rdfs:label 'Due Diligence Level' ;
    rdfs:comment 'Level of due diligence applied for this KYC verification. SIMPLIFIED=low-risk customers; STANDARD=normal CDD; ENHANCED=high-risk, PEP, or OFAC-adjacent parties. Aligns with FinCEN CDD Rule tiers.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Narrative reason for escalating this KYC case to senior compliance or a Suspicious Activity Report (SAR) filing. Populated when analyst_decision is ESCALATE. Supports AML investigation workflow.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocumentExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Identity Document Expiry Date' ;
    rdfs:comment 'Expiration date of the identity document used during verification. An expired document may invalidate the KYC result and trigger a re-verification requirement.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityDocumentIssuingCountry rdf:type rdf:Property ;
    rdfs:label 'Identity Document Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the authority that issued the identity document used in verification. Used for sanctions screening and cross-border risk assessment.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Identity Document Number' ;
    rdfs:comment 'The document number from the identity document used for verification (e.g., passport number, driver license number, FEIN). Stored as restricted PII per GLBA and FCRA requirements.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocumentType rdf:type rdf:Property ;
    rdfs:label 'Identity Document Type' ;
    rdfs:comment 'Type of identity document presented or verified during the KYC check. PASSPORT, DRIVERS_LICENSE, NATIONAL_ID, STATE_ID, MILITARY_ID for individuals; FEIN (Federal Employer Identification Number) for organizations.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdverseMedia rdf:type rdf:Property ;
    rdfs:label 'Is Adverse Media' ;
    rdfs:comment 'Indicates whether adverse media (negative news coverage related to financial crime, fraud, sanctions, or regulatory action) was found for this party during the KYC screening process.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPep rdf:type rdf:Property ;
    rdfs:label 'Is Pep' ;
    rdfs:comment 'Indicates whether the party has been identified as a Politically Exposed Person (PEP) — a current or former senior government official or close associate. Triggers enhanced due diligence requirements.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Date on which the next periodic KYC review is scheduled for this party, based on risk tier and due diligence level. Drives compliance workflow queues and regulatory review cycle management.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ofacHitReference rdf:type rdf:Property ;
    rdfs:label 'Ofac Hit Reference' ;
    rdfs:comment 'OFAC SDN list entry reference number or identifier when a hit or potential hit is recorded. Populated only when ofac_screening_status is HIT or POTENTIAL_HIT. Used for regulatory escalation.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Ofac Screening Status' ;
    rdfs:comment 'Result of screening the party against the OFAC Specially Designated Nationals (SDN) and blocked persons list. CLEAR=no match; HIT=confirmed match; POTENTIAL_HIT=possible match requiring review.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideReason rdf:type rdf:Property ;
    rdfs:label 'Override Reason' ;
    rdfs:comment 'Documented reason when a KYC verification result is overridden by a compliance officer (e.g., false positive OFAC hit, known PEP with approved exception). Required for audit trail when verification_status is WAIVED.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pepCategory rdf:type rdf:Property ;
    rdfs:label 'Pep Category' ;
    rdfs:comment 'Classification of the PEP relationship when is_pep is true. DOMESTIC=domestic official; FOREIGN=foreign official; INTERNATIONAL_ORGANIZATION=IO official; CLOSE_ASSOCIATE=known associate; FAMILY_MEMBER=immediate family.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'Date on which the compliance analyst completed their manual review and recorded the analyst_decision. Distinct from verification_date which is when the automated check ran.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskTier rdf:type rdf:Property ;
    rdfs:label 'Risk Tier' ;
    rdfs:comment 'Customer risk classification assigned as a result of the KYC process. Determines due diligence level, review frequency, and monitoring intensity. Aligns with FATF risk-based approach.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sarFiled rdf:type rdf:Property ;
    rdfs:label 'Sar Filed' ;
    rdfs:comment 'Indicates whether a Suspicious Activity Report (SAR) was filed with FinCEN as a result of this KYC verification finding. Triggers restricted access controls on the record per BSA requirements.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sarReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sar Reference Number' ;
    rdfs:comment 'FinCEN-assigned reference number for the Suspicious Activity Report filed in connection with this KYC verification. Populated only when sar_filed is true. Strictly access-controlled.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siuCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Siu Case Number' ;
    rdfs:comment 'Case reference number assigned by the SIU system when this KYC verification triggered a fraud investigation referral. Populated only when siu_referral is true.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siuReferral rdf:type rdf:Property ;
    rdfs:label 'Siu Referral' ;
    rdfs:comment 'Indicates whether this KYC verification result triggered a referral to the Special Investigations Unit (SIU) for potential insurance fraud investigation. Integrates with the Fraud Detection/SIU System.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyProvider rdf:type rdf:Property ;
    rdfs:label 'Third Party Provider' ;
    rdfs:comment 'Name of the external vendor or service used to perform the KYC verification (e.g., LexisNexis, Experian, Equifax, Refinitiv World-Check). Populated when verification_method is THIRD_PARTY_SERVICE.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Third Party Reference Code' ;
    rdfs:comment 'Unique transaction or case reference number returned by the third-party KYC provider for this verification. Used for reconciliation, dispute resolution, and audit trail with the external vendor.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerEvent rdf:type rdf:Property ;
    rdfs:label 'Trigger Event' ;
    rdfs:comment 'Business event that initiated this KYC verification. NEW_BUSINESS=new policy application; RENEWAL=policy renewal; ENDORSEMENT=mid-term change; CLAIM_FNOL=first notice of loss; PERIODIC_REVIEW=scheduled refresh; RISK_CHANGE=risk profile change.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationResult rdf:type rdf:Property ;
    rdfs:label 'Verification Result' ;
    rdfs:comment 'Detailed outcome of the verification check. CLEAR=no issues found; MATCH=identity confirmed; NO_MATCH=identity not confirmed; PARTIAL_MATCH=partial data match requiring review; INCONCLUSIVE=insufficient data.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'Exact date and time the KYC verification was executed, including timezone offset. Provides precise audit trail for regulatory and compliance purposes beyond the calendar date.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:verificationType rdf:type rdf:Property ;
    rdfs:label 'Verification Type' ;
    rdfs:comment 'Category of KYC check performed. IDENTITY=identity document check; OFAC_SCREENING=sanctions list; PEP_SCREENING=politically exposed person; ADVERSE_MEDIA=negative news; EDU=enhanced due diligence; PERIODIC_REVIEW=scheduled refresh.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchlistHitDetail rdf:type rdf:Property ;
    rdfs:label 'Watchlist Hit Detail' ;
    rdfs:comment 'Description of any watchlist match found beyond OFAC screening, including the list name and entry reference. Populated when watchlist_screened is true and a match was identified.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchlistScreened rdf:type rdf:Property ;
    rdfs:label 'Watchlist Screened' ;
    rdfs:comment 'Indicates whether the party was screened against applicable government and industry watchlists beyond OFAC (e.g., FBI Most Wanted, Interpol, EU Consolidated List, UN Sanctions). Supports comprehensive AML compliance.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossPayeeId rdf:type rdf:Property ;
    rdfs:label 'Loss Payee Id' ;
    rdfs:comment 'Unique surrogate identifier for each loss payee or mortgagee interest record. One row per interest attachment on a party and policy or insured risk.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageId rdf:type rdf:Property ;
    rdfs:label 'Coverage Id' ;
    rdfs:comment 'Foreign key linking to coverage.coverage. Business justification: Loss payees (mortgagees, lienholders) are often specific to individual coverages rather than entire policies. Mortgagee on building coverage, lienholder on auto physical damage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coverage .

ind:insuredRiskId rdf:type rdf:Property ;
    rdfs:label 'Insured Risk Id' ;
    rdfs:comment 'Reference to the specific Insured Risk (property, vehicle, etc.) to which this loss payee interest is attached. Null when attached at policy level only.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredRisk .

ind:lenderAddressId rdf:type rdf:Property ;
    rdfs:label 'Lender Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Loss payee embeds lender address fields that should be normalized to the address table. The address table is the SSOT for all addresses.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:acordFormType rdf:type rdf:Property ;
    rdfs:label 'Acord Form Type' ;
    rdfs:comment 'ACORD standard form type used to evidence this loss payee or mortgagee interest (e.g., ACORD 25 Certificate of Liability, ACORD 28 Evidence of Property Insurance).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Date' ;
    rdfs:comment 'Date on which the cancellation or non-renewal notice was sent to this loss payee or mortgagee. Required for regulatory compliance and audit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationNoticeSent rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Sent' ;
    rdfs:comment 'Indicates whether the required cancellation or non-renewal notice has been sent to this loss payee or mortgagee per the policy terms and state regulations.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateIssueDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Issue Date' ;
    rdfs:comment 'Date on which the Certificate of Insurance (CoI) was issued to this loss payee or mortgagee. Used for compliance tracking and renewal notifications.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'Certificate of Insurance (CoI) number issued to this loss payee or mortgagee as evidence of coverage per ACORD 28 or equivalent form.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementNumber rdf:type rdf:Property ;
    rdfs:label 'Endorsement Number' ;
    rdfs:comment 'Policy endorsement number under which this loss payee or mortgagee interest was added or modified on the policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Number' ;
    rdfs:comment 'Lender escrow account number used to collect and remit insurance premium payments on behalf of the mortgagor. Supports billing integration with lender.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formNumber rdf:type rdf:Property ;
    rdfs:label 'Form Number' ;
    rdfs:comment 'ISO or proprietary form number of the loss payable or mortgagee endorsement attached to the policy (e.g., ISO CP 12 18, PP 03 03).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRank rdf:type rdf:Property ;
    rdfs:label 'Interest Rank' ;
    rdfs:comment 'Ordinal rank of this interest when multiple loss payees or mortgagees exist on the same insured risk (e.g., first mortgagee = 1, second mortgagee = 2).' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interestStatus rdf:type rdf:Property ;
    rdfs:label 'Interest Status' ;
    rdfs:comment 'Current lifecycle status of the loss payee or mortgagee interest record. Drives whether the interest is honored in claims payment and certificate issuance.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestType rdf:type rdf:Property ;
    rdfs:label 'Interest Type' ;
    rdfs:comment 'Classification of the financial interest held by the party on the policy or insured risk. Drives certificate of insurance (CoI) and claims payment routing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jointPayeeRequired rdf:type rdf:Property ;
    rdfs:label 'Joint Payee Required' ;
    rdfs:comment 'Indicates whether claim payments must be made jointly to both the insured and this loss payee or mortgagee rather than solely to the insured.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lenderEmail rdf:type rdf:Property ;
    rdfs:label 'Lender Email' ;
    rdfs:comment 'Email address of the lender or mortgagee institution used for electronic certificate of insurance delivery and claims payment notifications.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderFein rdf:type rdf:Property ;
    rdfs:label 'Lender Fein' ;
    rdfs:comment 'IRS-assigned Federal Employer Identification Number (FEIN) of the lending institution. Required for tax reporting on claim payments and 1099 issuance.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderName rdf:type rdf:Property ;
    rdfs:label 'Lender Name' ;
    rdfs:comment 'Legal name of the lending institution, mortgagee, or lienholder as it must appear on the policy declarations and loss payment instruments.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderPhone rdf:type rdf:Property ;
    rdfs:label 'Lender Phone' ;
    rdfs:comment 'Primary contact telephone number for the lender or mortgagee institution used for claims notification and certificate of insurance correspondence.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Lender Reference Number' ;
    rdfs:comment 'Secondary lender-assigned reference or account number (e.g., investor loan number, servicer reference) distinct from the primary loan number.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanNumber rdf:type rdf:Property ;
    rdfs:label 'Loan Number' ;
    rdfs:comment 'Lender-assigned loan or mortgage account number associated with the insured risk. Used to route claim payments and satisfy lender reporting requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossPayableClauseType rdf:type rdf:Property ;
    rdfs:label 'Loss Payable Clause Type' ;
    rdfs:comment 'Type of loss payable clause attached to the policy for this interest: Standard, Lenders (protects lender independently), Open, or Union mortgage clause.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicLenderCode rdf:type rdf:Property ;
    rdfs:label 'Naic Lender Code' ;
    rdfs:comment 'NAIC-assigned code identifying the lender or financial institution for statutory reporting and Schedule F bordereaux purposes.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDays rdf:type rdf:Property ;
    rdfs:label 'Notification Days' ;
    rdfs:comment 'Number of days advance notice required to be given to the lender or mortgagee before policy cancellation or non-renewal takes effect.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationRequired rdf:type rdf:Property ;
    rdfs:label 'Notification Required' ;
    rdfs:comment 'Indicates whether the lender or mortgagee must be notified of policy changes, cancellations, or non-renewals per the loss payable clause or lender agreement.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPayableTo rdf:type rdf:Property ;
    rdfs:label 'Payment Payable To' ;
    rdfs:comment 'Full legal name(s) as they must appear on claim payment instruments (checks or EFT) issued jointly or solely to this loss payee or mortgagee.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Threshold Amount' ;
    rdfs:comment 'Minimum claim payment amount above which joint payee or mortgagee co-endorsement is required per the lender agreement or loss payable clause.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumBilledToLender rdf:type rdf:Property ;
    rdfs:label 'Premium Billed To Lender' ;
    rdfs:comment 'Indicates whether the insurance premium is billed directly to the lender via escrow rather than to the policyholder. Drives billing system routing.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingGeographyId rdf:type rdf:Property ;
    rdfs:label 'Issuing Geography Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.geography. Business justification: Producer license validation by operating territory and regulatory compliance tracking require linking licenses to issuing state geography.' ;
    rdfs:domain ind:License ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:adjusterType rdf:type rdf:Property ;
    rdfs:label 'Adjuster Type' ;
    rdfs:comment 'Sub-type of adjuster license indicating the adjuster\'s operational role. Populated only when license_type is \'adjuster\'. Drives claim assignment eligibility rules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date on which the most recent background check was completed for this license. Used to determine if a re-check is required at renewal per state DOI requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backgroundCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Background Check Status' ;
    rdfs:comment 'Status of the criminal background check conducted as part of the license application or renewal process. Required by many state DOIs for producer and adjuster licensing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceCreditsCompleted rdf:type rdf:Property ;
    rdfs:label 'Ce Credits Completed' ;
    rdfs:comment 'Number of continuing education (CE) credit hours completed by the licensee in the current renewal cycle. Compared against ce_credits_required to assess compliance.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ceCreditsRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Credits Required' ;
    rdfs:comment 'Total number of continuing education (CE) credit hours required by the issuing state for the current renewal cycle. Varies by state and license class.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:class rdf:type rdf:Property ;
    rdfs:label 'Class' ;
    rdfs:comment 'Sub-classification of the license type as defined by the issuing state (e.g., Property, Casualty, Life, Health, Personal Lines, Commercial Lines). Drives appointment eligibility.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingEducationDueDate rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Due Date' ;
    rdfs:comment 'Date by which the licensee must complete required continuing education (CE) credit hours to maintain license validity. Drives CE compliance tracking and renewal alerts.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractorLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Contractor License Number' ;
    rdfs:comment 'State-issued contractor license number for parties who are licensed contractors (e.g., restoration vendors). Populated only when license_type is \'contractor\'. Used in claims vendor management.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionDescription rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Description' ;
    rdfs:comment 'Free-text description of any regulatory disciplinary actions, fines, or sanctions associated with this license. Populated only when disciplinary_action_indicator is True.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionIndicator rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Indicator' ;
    rdfs:comment 'Indicates whether the licensee has any regulatory disciplinary actions, fines, or sanctions on record with the issuing DOI (True) or not (False). Sourced from NIPR PDB.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:errorsOmissionsCarrier rdf:type rdf:Property ;
    rdfs:label 'Errors Omissions Carrier' ;
    rdfs:comment 'Name of the insurance carrier providing the licensee\'s Errors and Omissions (E&O) professional liability coverage. Required for producer appointment eligibility verification.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorsOmissionsExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Errors Omissions Expiry Date' ;
    rdfs:comment 'Expiration date of the licensee\'s Errors and Omissions (E&O) professional liability policy. Drives alerts when E&O coverage is about to lapse, which may affect appointment status.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:errorsOmissionsPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Errors Omissions Policy Number' ;
    rdfs:comment 'Policy number of the licensee\'s Errors and Omissions (E&O) professional liability insurance. Verified during producer appointment and renewal processes.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethicsCeCreditsCompleted rdf:type rdf:Property ;
    rdfs:label 'Ethics Ce Credits Completed' ;
    rdfs:comment 'Number of ethics-specific continuing education (CE) credit hours completed by the licensee in the current renewal cycle. Compared against ethics_ce_credits_required.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ethicsCeCreditsRequired rdf:type rdf:Property ;
    rdfs:label 'Ethics Ce Credits Required' ;
    rdfs:comment 'Number of ethics-specific continuing education (CE) credit hours mandated by the issuing state within the renewal cycle. Many states require a separate ethics CE component.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expiryDate rdf:type rdf:Property ;
    rdfs:label 'Expiry Date' ;
    rdfs:comment 'Date on which this license expires and must be renewed to remain valid. Null for licenses with no fixed expiration. Drives renewal workflow and appointment eligibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isResidentLicense rdf:type rdf:Property ;
    rdfs:label 'Is Resident License' ;
    rdfs:comment 'Indicates whether this is a resident (home-state) license (True) or a non-resident license (False). Non-resident licenses are issued under reciprocity agreements.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'Date on which the issuing state DOI originally granted this license. Used to calculate license tenure and continuing education (CE) cycle start.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseStatus rdf:type rdf:Property ;
    rdfs:label 'License Status' ;
    rdfs:comment 'Current regulatory status of the license as reported by the issuing DOI or NIPR. Drives eligibility for producer appointments and claim adjuster assignments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseType rdf:type rdf:Property ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Category of professional license held by the party. Distinguishes producer, adjuster, contractor, surplus lines, and other license types. [ENUM-REF-CANDIDATE: promote to reference product if types expand]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:niprLastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Nipr Last Verified Date' ;
    rdfs:comment 'Date on which this license record was last verified against the NIPR Producer Database (PDB). Supports ongoing compliance monitoring and stale-data detection.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:niprVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Nipr Verification Status' ;
    rdfs:comment 'Result of the most recent NIPR PDB verification check for this license. \'mismatch\' indicates discrepancies between internal records and NIPR data requiring remediation.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:number rdf:type rdf:Property ;
    rdfs:label 'Number' ;
    rdfs:comment 'Official license number assigned by the issuing state Department of Insurance (DOI) or regulatory authority. Used for NIPR validation and DOI compliance checks.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reciprocityStateCodes rdf:type rdf:Property ;
    rdfs:label 'Reciprocity State Codes' ;
    rdfs:comment 'Comma-delimited list of two-letter state codes where this license is recognized under reciprocity agreements. Enables multi-state appointment eligibility without separate applications.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Date on which the license was most recently renewed by the issuing DOI. Tracks renewal history and supports continuing education (CE) compliance monitoring.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:residentStateCode rdf:type rdf:Property ;
    rdfs:label 'Resident State Code' ;
    rdfs:comment 'Two-letter US state code of the licensee\'s home state of residence. Distinguishes resident licenses from non-resident licenses for NIPR and reciprocity tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemLicenseKey rdf:type rdf:Property ;
    rdfs:label 'Source System License Key' ;
    rdfs:comment 'Natural key or record identifier for this license in the originating source system (e.g., NIPR PDB record ID, PAS license record ID). Supports reconciliation and deduplication.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnLast4 rdf:type rdf:Property ;
    rdfs:label 'Ssn Last4' ;
    rdfs:comment 'Last four digits of the licensee\'s Social Security Number, stored for identity verification purposes only. Full SSN must not be stored per GLBA and GDPR/CCPA data minimization.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesAuthorized rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Authorized' ;
    rdfs:comment 'Indicates whether the licensee is authorized to place surplus lines business in the issuing state (True) or not (False). Required for non-admitted market placements.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surplusLinesNumber rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Number' ;
    rdfs:comment 'State-issued surplus lines license number, distinct from the standard producer license number. Required for stamping office filings and surplus lines tax remittance.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producersProducerId rdf:type rdf:Property ;
    rdfs:label 'Producers Producer Id' ;
    rdfs:comment 'Unique surrogate identifier for each licensed insurance producer record. Primary key. One row per producer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:distributionChannelId rdf:type rdf:Property ;
    rdfs:label 'Distribution Channel Id' ;
    rdfs:comment 'Reference to the distribution channel through which this producer operates (e.g., independent agent, direct, broker, MGA).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionChannel .

ind:territoryId rdf:type rdf:Property ;
    rdfs:label 'Territory Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.territory. Business justification: Territory-level production tracking and binding authority validation require knowing which rating territory a producer is authorized for.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Territory .

ind:appointmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Effective Date' ;
    rdfs:comment 'Date the producer\'s appointment with Pc_Insurance became effective. Marks the start of the producer\'s authority to bind business.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Status' ;
    rdfs:comment 'Current appointment status of the producer with the insurer. Drives eligibility to bind business. Lifecycle: pending -> active -> suspended/terminated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Termination Date' ;
    rdfs:comment 'Date the producer\'s appointment with Pc_Insurance was terminated. Null if appointment is currently active.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankAccountReference rdf:type rdf:Property ;
    rdfs:label 'Bank Account Reference' ;
    rdfs:comment 'Tokenized or masked reference to the producer\'s bank account used for ACH commission disbursements. Full account data stored in payment vault.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindingAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Flag' ;
    rdfs:comment 'Indicates whether the producer has delegated binding authority to issue policies on behalf of Pc_Insurance without prior underwriting approval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindingAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Limit' ;
    rdfs:comment 'Maximum single-risk premium or TIV the producer may bind without referral to underwriting. Null if binding_authority_flag is false.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Commission Schedule Code' ;
    rdfs:comment 'Code identifying the commission schedule applicable to this producer. Drives commission calculation on premium transactions.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentCommissionEligible rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Eligible' ;
    rdfs:comment 'Indicates whether the producer is eligible for contingent (profit-sharing) commission based on loss ratio and volume performance.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuingEducationHoursCompleted rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Hours Completed' ;
    rdfs:comment 'Number of continuing education credit hours completed in the current CE cycle. Tracked against state-mandated minimums.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Default Commission Rate' ;
    rdfs:comment 'Default commission rate (as a decimal, e.g., 0.1200 = 12%) applied to written premium for this producer absent a line-specific override.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eoCarrierName rdf:type rdf:Property ;
    rdfs:label 'Eo Carrier Name' ;
    rdfs:comment 'Name of the insurance carrier providing the producer\'s Errors & Omissions (E&O) professional liability coverage.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Amount' ;
    rdfs:comment 'Per-occurrence limit of the producer\'s E&O professional liability policy in USD. Used to verify minimum coverage requirements.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eoExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Eo Expiration Date' ;
    rdfs:comment 'Expiration date of the producer\'s E&O professional liability policy. Triggers renewal reminder and potential appointment suspension.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eoPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Eo Policy Number' ;
    rdfs:comment 'Policy number of the producer\'s E&O professional liability insurance. Required for appointment and renewal.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSurplusLinesLicensed rdf:type rdf:Property ;
    rdfs:label 'Is Surplus Lines Licensed' ;
    rdfs:comment 'Indicates whether the producer holds a surplus lines broker license, enabling placement of non-admitted coverage.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'License Effective Date' ;
    rdfs:comment 'Date the producer\'s resident state license became effective. Used to verify active licensure at time of policy binding.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Date the producer\'s resident state license expires. Triggers renewal workflow and appointment suspension if not renewed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'Primary state-issued insurance producer license number in the resident state. Additional non-resident licenses are tracked in the Producer Appointment table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobAuthorizations rdf:type rdf:Property ;
    rdfs:label 'Lob Authorizations' ;
    rdfs:comment 'Comma-delimited list of lines of business (LOB) codes the producer is authorized to write (e.g., HO, PAP, CGL, BOP, CA). Enforced at submission intake.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Method by which commission payments are disbursed to the producer (ACH direct deposit, paper check, or wire transfer).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerRole rdf:type rdf:Property ;
    rdfs:label 'Producer Role' ;
    rdfs:comment 'Functional role of the producer in the distribution channel. [ENUM-REF-CANDIDATE: agent|broker|managing_general_agent|surplus_lines_broker|independent_agent|captive_agent — promote to reference product]' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerType rdf:type rdf:Property ;
    rdfs:label 'Producer Type' ;
    rdfs:comment 'Indicates whether the producer is a natural person (individual) or a business entity (agency/firm). Drives licensing and appointment rules.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryActionFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Flag' ;
    rdfs:comment 'Indicates whether the producer has any open or historical regulatory actions, fines, or license sanctions on record.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sinceDate rdf:type rdf:Property ;
    rdfs:label 'Since Date' ;
    rdfs:comment 'Date the producer first became appointed with Pc_Insurance. Used for tenure-based commission tier calculations and relationship analytics.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surplusLinesLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines License Number' ;
    rdfs:comment 'State-issued surplus lines broker license number. Null if producer is not surplus lines licensed.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Writing Company Code' ;
    rdfs:comment 'NAIC company code of the Pc_Insurance legal entity (writing company) to which this producer is appointed. Supports multi-company insurer groups.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyId rdf:type rdf:Property ;
    rdfs:label 'Agency Id' ;
    rdfs:comment 'Unique identifier for the insurance agency or brokerage firm. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:geographyId rdf:type rdf:Property ;
    rdfs:label 'Geography Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.geography. Business justification: Agencies are assigned service territories defined in geography hierarchy. Used for producer appointment validation (ensuring producer is appointed in geography where risk is' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:parentAgencyId rdf:type rdf:Property ;
    rdfs:label 'Parent Agency Id' ;
    rdfs:comment 'Reference to the parent agency for hierarchical relationships such as MGA to sub-producer or wholesale to retail agency networks.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:principalAddressId rdf:type rdf:Property ;
    rdfs:label 'Principal Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Agency principal address drives geocoding, cat zone assignment, and state DOI regulatory address verification for agency licensing.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:agencyStatus rdf:type rdf:Property ;
    rdfs:label 'Agency Status' ;
    rdfs:comment 'Current lifecycle status of the agency relationship with the carrier: active, inactive, suspended, terminated, or pending appointment.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyType rdf:type rdf:Property ;
    rdfs:label 'Agency Type' ;
    rdfs:comment 'Classification of the agency business model: independent agent, captive agent, managing general agent (MGA), wholesale broker, retail broker, surplus lines broker, or direct writer.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualPremiumVolume rdf:type rdf:Property ;
    rdfs:label 'Annual Premium Volume' ;
    rdfs:comment 'Total annual written premium volume produced by the agency across all lines of business for the most recent calendar year.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Timestamp when the agency record was most recently updated reflecting changes to appointment status, contact information, or authorization.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mailingAddressSameAsPrincipal rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Same As Principal' ;
    rdfs:comment 'Indicates whether the mailing address is identical to the principal business address for correspondence and regulatory notices.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyCount rdf:type rdf:Property ;
    rdfs:label 'Policy Count' ;
    rdfs:comment 'Total number of active policies in force written by the agency as of the most recent reporting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surplusLinesEligible rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Eligible' ;
    rdfs:comment 'Indicates whether the agency is licensed and authorized to place surplus lines business with non-admitted carriers.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tier rdf:type rdf:Property ;
    rdfs:label 'Tier' ;
    rdfs:comment 'Performance tier classification based on premium volume, loss ratio, and retention metrics used for contingent commission and incentive programs.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerLicenseId rdf:type rdf:Property ;
    rdfs:label 'Producer License Id' ;
    rdfs:comment 'Unique identifier for the producer license record. Primary key. One row per producer per state per license class.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducerLicense .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'Date the producer submitted the license application to the state Department of Insurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentRequired rdf:type rdf:Property ;
    rdfs:label 'Appointment Required' ;
    rdfs:comment 'Indicates whether the state requires a carrier appointment for this license class.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date the license application was approved by the state Department of Insurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backgroundCheckRequired rdf:type rdf:Property ;
    rdfs:label 'Background Check Required' ;
    rdfs:comment 'Indicates whether the state requires a background check for this license.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ceDueDate rdf:type rdf:Property ;
    rdfs:label 'Ce Due Date' ;
    rdfs:comment 'Date by which continuing education requirements must be completed for renewal.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ceEthicsHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Ethics Hours Required' ;
    rdfs:comment 'Ethics-specific continuing education hours required for license renewal in this state.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceHoursCompleted rdf:type rdf:Property ;
    rdfs:label 'Ce Hours Completed' ;
    rdfs:comment 'Total continuing education hours completed toward current renewal cycle.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Hours Required' ;
    rdfs:comment 'Total continuing education hours required for license renewal in this state.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:denialDate rdf:type rdf:Property ;
    rdfs:label 'Denial Date' ;
    rdfs:comment 'Date the license application was denied by the state Department of Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:denialReason rdf:type rdf:Property ;
    rdfs:label 'Denial Reason' ;
    rdfs:comment 'Reason provided by the state Department of Insurance for denying the license application.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiActionDate rdf:type rdf:Property ;
    rdfs:label 'Doi Action Date' ;
    rdfs:comment 'Date the regulatory action was taken by the state Department of Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiActionDescription rdf:type rdf:Property ;
    rdfs:label 'Doi Action Description' ;
    rdfs:comment 'Detailed description of the regulatory action taken by the state Department of Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiActionFlag rdf:type rdf:Property ;
    rdfs:label 'Doi Action Flag' ;
    rdfs:comment 'Indicates whether any regulatory action has been taken against this license by the state DOI.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doiActionType rdf:type rdf:Property ;
    rdfs:label 'Doi Action Type' ;
    rdfs:comment 'Type of regulatory action taken: suspension, revocation, fine, probation, consent order, or cease and desist.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

