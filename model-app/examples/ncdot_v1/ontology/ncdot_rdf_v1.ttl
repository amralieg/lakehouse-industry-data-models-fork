ind:ffyProgrammed rdf:type rdf:Property ;
    rdfs:label 'Ffy Programmed' ;
    rdfs:comment 'Federal fiscal year in which the project is programmed in the STIP for funding obligation.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sfyProgrammed rdf:type rdf:Property ;
    rdfs:label 'Sfy Programmed' ;
    rdfs:comment 'State fiscal year in which the project is programmed for state funding allocation.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Contracting method used for project delivery (design-bid-build, design-build, construction manager at risk, public-private partnership).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementType rdf:type rdf:Property ;
    rdfs:label 'Pavement Type' ;
    rdfs:comment 'Type of pavement surface being constructed or rehabilitated (asphalt, concrete, composite).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfLanes rdf:type rdf:Property ;
    rdfs:label 'Number Of Lanes' ;
    rdfs:comment 'Total number of travel lanes in the project corridor after project completion.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bridgeCount rdf:type rdf:Property ;
    rdfs:label 'Bridge Count' ;
    rdfs:comment 'Number of bridges included in the project scope (new construction, replacement, or rehabilitation).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:culvertCount rdf:type rdf:Property ;
    rdfs:label 'Culvert Count' ;
    rdfs:comment 'Number of culverts included in the project scope.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:signalCount rdf:type rdf:Property ;
    rdfs:label 'Signal Count' ;
    rdfs:comment 'Number of traffic signals included in the project scope (new installation, upgrade, or replacement).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itsComponentsIncluded rdf:type rdf:Property ;
    rdfs:label 'Its Components Included' ;
    rdfs:comment 'Indicates whether the project includes Intelligent Transportation Systems components (DMS, CCTV, detection).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adaComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Required' ;
    rdfs:comment 'Indicates whether the project must comply with ADA accessibility requirements for pedestrian facilities.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bicycleFacilitiesIncluded rdf:type rdf:Property ;
    rdfs:label 'Bicycle Facilities Included' ;
    rdfs:comment 'Indicates whether the project includes dedicated bicycle facilities (lanes, paths, shared-use paths).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pedestrianFacilitiesIncluded rdf:type rdf:Property ;
    rdfs:label 'Pedestrian Facilities Included' ;
    rdfs:comment 'Indicates whether the project includes pedestrian facilities (sidewalks, crosswalks, pedestrian signals).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitFacilitiesIncluded rdf:type rdf:Property ;
    rdfs:label 'Transit Facilities Included' ;
    rdfs:comment 'Indicates whether the project includes public transit facilities (bus stops, shelters, park-and-ride).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilityRelocationRequired rdf:type rdf:Property ;
    rdfs:label 'Utility Relocation Required' ;
    rdfs:comment 'Indicates whether utility relocations are required as part of the project.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:railroadCoordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Railroad Coordination Required' ;
    rdfs:comment 'Indicates whether coordination with railroad companies is required for the project (grade crossings, bridges over rail).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyProjectIndicator rdf:type rdf:Property ;
    rdfs:label 'Emergency Project Indicator' ;
    rdfs:comment 'Indicates whether the project is designated as an emergency project due to natural disaster or critical infrastructure failure.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:femaDisasterNumber rdf:type rdf:Property ;
    rdfs:label 'Fema Disaster Number' ;
    rdfs:comment 'FEMA disaster declaration number if the project is related to federally declared disaster recovery.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phaseId rdf:type rdf:Property ;
    rdfs:label 'Phase Id' ;
    rdfs:comment 'Unique identifier for the project phase reference record. Primary key for the project phase reference list.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Phase .

ind:sapPsPhaseCode rdf:type rdf:Property ;
    rdfs:label 'Sap Ps Phase Code' ;
    rdfs:comment 'Corresponding phase code used in SAP PS (Project System) module for project structure and work breakdown structure (WBS) element mapping.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hicamsPhaseCode rdf:type rdf:Property ;
    rdfs:label 'Hicams Phase Code' ;
    rdfs:comment 'Corresponding phase code used in HiCAMS (Highway Construction and Materials System) for construction project tracking and materials management.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipPhaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Stip Phase Indicator' ;
    rdfs:comment 'Indicates whether this phase is reportable in the State Transportation Improvement Program (STIP) for federal and state compliance.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tipPhaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Tip Phase Indicator' ;
    rdfs:comment 'Indicates whether this phase is reportable in the Transportation Improvement Program (TIP) for Metropolitan Planning Organization (MPO) and Rural Planning Organization (RPO) compliance.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhwaReportableIndicator rdf:type rdf:Property ;
    rdfs:label 'Fhwa Reportable Indicator' ;
    rdfs:comment 'Indicates whether this phase requires reporting to the Federal Highway Administration (FHWA) for federal-aid project compliance and oversight.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Funding Eligible Indicator' ;
    rdfs:comment 'Indicates whether this phase is eligible for federal, state, or other funding sources under transportation funding programs.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalParticipationAllowed rdf:type rdf:Property ;
    rdfs:label 'Federal Participation Allowed' ;
    rdfs:comment 'Indicates whether federal funding participation is allowed for this project phase under FHWA regulations.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nepaPhaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Nepa Phase Indicator' ;
    rdfs:comment 'Indicates whether this phase involves National Environmental Policy Act (NEPA) environmental review and documentation requirements.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalClearanceRequired rdf:type rdf:Property ;
    rdfs:label 'Environmental Clearance Required' ;
    rdfs:comment 'Indicates whether environmental clearance (CE, EA, EIS, or FONSI) is required before this phase can proceed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Numeric sequence indicating the typical order of this phase in the project lifecycle. Lower numbers indicate earlier phases.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Typical Duration Months' ;
    rdfs:comment 'Typical or average duration in months for completing this project phase, used for project scheduling and planning estimates.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Minimum Duration Months' ;
    rdfs:comment 'Minimum feasible duration in months for completing this project phase under optimal conditions.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Maximum Duration Months' ;
    rdfs:comment 'Maximum expected duration in months for completing this project phase, used for risk planning and schedule contingency.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:predecessorPhaseCodes rdf:type rdf:Property ;
    rdfs:label 'Predecessor Phase Codes' ;
    rdfs:comment 'Comma-separated list of phase codes that typically must be completed before this phase can begin, defining phase dependencies.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successorPhaseCodes rdf:type rdf:Property ;
    rdfs:label 'Successor Phase Codes' ;
    rdfs:comment 'Comma-separated list of phase codes that typically follow this phase in the project lifecycle.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliverableRequirements rdf:type rdf:Property ;
    rdfs:label 'Deliverable Requirements' ;
    rdfs:comment 'Description of key deliverables, documents, and outputs required for completion of this project phase.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleDivision rdf:type rdf:Property ;
    rdfs:label 'Responsible Division' ;
    rdfs:comment 'Primary NCDOT division responsible for managing and executing this project phase (e.g., Division of Highways (DOH), Division of Central Highways (DCH)).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costEstimateRequired rdf:type rdf:Property ;
    rdfs:label 'Cost Estimate Required' ;
    rdfs:comment 'Indicates whether a formal cost estimate is required for this project phase for budgeting and funding allocation.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:typicalCostPercentage rdf:type rdf:Property ;
    rdfs:label 'Typical Cost Percentage' ;
    rdfs:comment 'Typical percentage of total project cost allocated to this phase, used for preliminary budgeting and cost estimation (e.g., PE typically 10-15% of total project cost).' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightOfWayPhaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Phase Indicator' ;
    rdfs:comment 'Indicates whether this phase involves Right-of-Way (ROW) acquisition, property appraisal, relocation assistance, or related activities.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilitiesCoordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Utilities Coordination Required' ;
    rdfs:comment 'Indicates whether coordination with utility companies for relocation or adjustment of utilities is required during this project phase.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:designApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Design Approval Required' ;
    rdfs:comment 'Indicates whether formal design approval from NCDOT State Roadway Design Unit or FHWA is required for this project phase.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lettingPhaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Letting Phase Indicator' ;
    rdfs:comment 'Indicates whether this phase involves a formal letting (bidding) process for contractor selection and award.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:constructionPhaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Construction Phase Indicator' ;
    rdfs:comment 'Indicates whether this phase involves physical construction activities in the field.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionRequired rdf:type rdf:Property ;
    rdfs:label 'Inspection Required' ;
    rdfs:comment 'Indicates whether formal inspection activities and documentation are required during this project phase.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialsTestingRequired rdf:type rdf:Property ;
    rdfs:label 'Materials Testing Required' ;
    rdfs:comment 'Indicates whether materials testing and quality control testing are required during this project phase, typically tracked in HiCAMS.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trafficControlRequired rdf:type rdf:Property ;
    rdfs:label 'Traffic Control Required' ;
    rdfs:comment 'Indicates whether Maintenance of Traffic (MOT) plans and traffic control measures are required during this project phase.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Safety Compliance Required' ;
    rdfs:comment 'Indicates whether formal safety compliance procedures and OSHA safety requirements must be followed during this project phase.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dbeParticipationTracked rdf:type rdf:Property ;
    rdfs:label 'Dbe Participation Tracked' ;
    rdfs:comment 'Indicates whether Disadvantaged Business Enterprise (DBE), Minority Business Enterprise (MBE), Women Business Enterprise (WBE), or Historically Underutilized Business (HUB) participation is tracked and reported for this phase.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalFiscalYearApplicable rdf:type rdf:Property ;
    rdfs:label 'Federal Fiscal Year Applicable' ;
    rdfs:comment 'Indicates whether Federal Fiscal Year (FFY) tracking and obligation deadlines apply to this project phase for federal funding compliance.' ;
    rdfs:domain ind:Phase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:obligationAuthorityRequired rdf:type rdf:Property ;
    rdfs:label 'Obligation Authority Required' ;
    rdfs:comment 'Indicates whether federal obligation authority must be secured before this project phase can proceed with federal funding.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueId rdf:type rdf:Property ;
    rdfs:label 'Issue Id' ;
    rdfs:comment 'Unique identifier for the project issue record. Primary key for the project issue entity.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Issue .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date when the issue was first identified and reported into the system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedBy rdf:type rdf:Property ;
    rdfs:label 'Reported By' ;
    rdfs:comment 'Name of the individual or role who identified and reported the issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedByOrganization rdf:type rdf:Property ;
    rdfs:label 'Reported By Organization' ;
    rdfs:comment 'Organization or division of the individual who reported the issue (e.g., Division of Highways, contractor, consultant).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedTo rdf:type rdf:Property ;
    rdfs:label 'Assigned To' ;
    rdfs:comment 'Name of the individual or role currently assigned as the owner responsible for resolving the issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToOrganization rdf:type rdf:Property ;
    rdfs:label 'Assigned To Organization' ;
    rdfs:comment 'Organization or division of the individual assigned to resolve the issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Target Resolution Date' ;
    rdfs:comment 'Planned or committed date by which the issue is expected to be resolved.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Resolution Date' ;
    rdfs:comment 'Actual date when the issue was resolved and corrective actions were completed.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date when the issue was formally closed after verification and acceptance of the resolution.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closedBy rdf:type rdf:Property ;
    rdfs:label 'Closed By' ;
    rdfs:comment 'Name of the individual who formally closed the issue after verifying resolution.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionDescription rdf:type rdf:Property ;
    rdfs:label 'Resolution Description' ;
    rdfs:comment 'Detailed narrative describing the actions taken to resolve the issue and the final outcome.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Identified root cause of the issue based on investigation and analysis.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveAction rdf:type rdf:Property ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Specific corrective actions implemented to address the issue and prevent recurrence.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveAction rdf:type rdf:Property ;
    rdfs:label 'Preventive Action' ;
    rdfs:comment 'Preventive measures or process improvements implemented to avoid similar issues in the future.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnSchedule rdf:type rdf:Property ;
    rdfs:label 'Impact On Schedule' ;
    rdfs:comment 'Assessment of the issue\'s impact on the project schedule and milestone dates.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleDelayDays rdf:type rdf:Property ;
    rdfs:label 'Schedule Delay Days' ;
    rdfs:comment 'Number of calendar days by which the project schedule was delayed due to this issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:impactOnBudget rdf:type rdf:Property ;
    rdfs:label 'Impact On Budget' ;
    rdfs:comment 'Assessment of the issue\'s impact on the project budget and financial performance.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Amount' ;
    rdfs:comment 'Estimated or actual financial cost impact of the issue on the project budget in US dollars.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impactOnScope rdf:type rdf:Property ;
    rdfs:label 'Impact On Scope' ;
    rdfs:comment 'Assessment of the issue\'s impact on the project scope and deliverables.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnQuality rdf:type rdf:Property ;
    rdfs:label 'Impact On Quality' ;
    rdfs:comment 'Assessment of the issue\'s impact on project quality standards and deliverable quality.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnSafety rdf:type rdf:Property ;
    rdfs:label 'Impact On Safety' ;
    rdfs:comment 'Assessment of the issue\'s impact on worker safety, public safety, or traffic safety.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedRfiNumber rdf:type rdf:Property ;
    rdfs:label 'Related Rfi Number' ;
    rdfs:comment 'Reference number of any Request for Information associated with this issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'Current escalation level indicating the management tier involved in issue resolution.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalatedDate rdf:type rdf:Property ;
    rdfs:label 'Escalated Date' ;
    rdfs:comment 'Date when the issue was escalated to a higher management level.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalatedTo rdf:type rdf:Property ;
    rdfs:label 'Escalated To' ;
    rdfs:comment 'Name of the individual or role to whom the issue was escalated.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workBreakdownStructureCode rdf:type rdf:Property ;
    rdfs:label 'Work Breakdown Structure Code' ;
    rdfs:comment 'Work Breakdown Structure code identifying the specific project component or work package affected by the issue.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milepost rdf:type rdf:Property ;
    rdfs:label 'Milepost' ;
    rdfs:comment 'Milepost location along the route where the issue is located.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractorResponsibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Contractor Responsibility Flag' ;
    rdfs:comment 'Indicator of whether the issue is attributed to contractor responsibility or performance.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consultantName rdf:type rdf:Property ;
    rdfs:label 'Consultant Name' ;
    rdfs:comment 'Name of the engineering or design consultant involved in or responsible for the issue, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresDesignChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Design Change Flag' ;
    rdfs:comment 'Indicator of whether the issue requires a design modification or revision.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresPermitModificationFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Permit Modification Flag' ;
    rdfs:comment 'Indicator of whether the issue requires modification of environmental or regulatory permits.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Flag' ;
    rdfs:comment 'Indicator of whether the issue has environmental implications or impacts.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicator of whether the issue involves regulatory compliance concerns or violations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicInvolvementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Involvement Required Flag' ;
    rdfs:comment 'Indicator of whether the issue requires public notification, engagement, or hearing.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stakeholderNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Notification Date' ;
    rdfs:comment 'Date when relevant stakeholders were notified of the issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lessonsLearned rdf:type rdf:Property ;
    rdfs:label 'Lessons Learned' ;
    rdfs:comment 'Documentation of lessons learned from the issue for knowledge management and continuous improvement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Category' ;
    rdfs:comment 'Risk management category to which the issue is related.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationStrategy rdf:type rdf:Property ;
    rdfs:label 'Mitigation Strategy' ;
    rdfs:comment 'Strategy or approach used to mitigate the issue and reduce its impact.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify that the issue has been properly resolved.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date when the issue resolution was verified and validated.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name of the individual who verified that the issue was properly resolved.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceFlag rdf:type rdf:Property ;
    rdfs:label 'Recurrence Flag' ;
    rdfs:comment 'Indicator of whether this issue is a recurrence of a previously resolved issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relatedIssueNumber rdf:type rdf:Property ;
    rdfs:label 'Related Issue Number' ;
    rdfs:comment 'Reference number of any related or parent issue, if this is a recurrence or dependent issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalAidCategory rdf:type rdf:Property ;
    rdfs:label 'Federal Aid Category' ;
    rdfs:comment 'Federal aid program category funding the project (e.g., National Highway System, Surface Transportation Program, Highway Safety Improvement Program).' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attachmentCount rdf:type rdf:Property ;
    rdfs:label 'Attachment Count' ;
    rdfs:comment 'Number of documents, photos, or files attached to the issue record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commentCount rdf:type rdf:Property ;
    rdfs:label 'Comment Count' ;
    rdfs:comment 'Number of comments or notes recorded against the issue.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemId rdf:type rdf:Property ;
    rdfs:label 'Source System Id' ;
    rdfs:comment 'Unique identifier of the issue in the source system of record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'Name of the user who last modified the issue record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskId rdf:type rdf:Property ;
    rdfs:label 'Risk Id' ;
    rdfs:comment 'Unique identifier for the project risk record. Primary key for the project risk entity.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Origin or source of the risk identification (e.g., risk workshop, project team, stakeholder input, historical data, audit finding).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identified Date' ;
    rdfs:comment 'Date when the risk was first identified and documented in the risk register.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identifiedBy rdf:type rdf:Property ;
    rdfs:label 'Identified By' ;
    rdfs:comment 'Name or identifier of the person or team who identified the risk.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probability rdf:type rdf:Property ;
    rdfs:label 'Probability' ;
    rdfs:comment 'Likelihood or probability that the risk event will occur, typically expressed as a qualitative rating (very low, low, medium, high, very high).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityScore rdf:type rdf:Property ;
    rdfs:label 'Probability Score' ;
    rdfs:comment 'Numerical probability score representing the likelihood of risk occurrence, typically on a scale (e.g., 0.0 to 1.0 or 1 to 10).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impact rdf:type rdf:Property ;
    rdfs:label 'Impact' ;
    rdfs:comment 'Severity or magnitude of the consequence if the risk event occurs, typically expressed as a qualitative rating (very low, low, medium, high, very high).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactScore rdf:type rdf:Property ;
    rdfs:label 'Impact Score' ;
    rdfs:comment 'Numerical impact score representing the severity of consequences if the risk occurs, typically on a scale (e.g., 1 to 10).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:score rdf:type rdf:Property ;
    rdfs:label 'Score' ;
    rdfs:comment 'Overall risk score calculated from probability and impact (typically probability_score × impact_score) to prioritize risks.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rating rdf:type rdf:Property ;
    rdfs:label 'Rating' ;
    rdfs:comment 'Qualitative risk rating derived from the risk score, used for prioritization and escalation (e.g., low, medium, high, critical).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleImpactDays rdf:type rdf:Property ;
    rdfs:label 'Schedule Impact Days' ;
    rdfs:comment 'Estimated number of days the project schedule could be delayed if this risk materializes.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scopeImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Impact Description' ;
    rdfs:comment 'Description of how the risk could affect project scope, deliverables, or quality if it occurs.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:owner rdf:type rdf:Property ;
    rdfs:label 'Owner' ;
    rdfs:comment 'Name or identifier of the person or organizational unit responsible for monitoring and managing this risk.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerEmail rdf:type rdf:Property ;
    rdfs:label 'Owner Email' ;
    rdfs:comment 'Email address of the risk owner for communication and escalation purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerPhone rdf:type rdf:Property ;
    rdfs:label 'Owner Phone' ;
    rdfs:comment 'Contact phone number of the risk owner for urgent communication regarding the risk.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseStrategy rdf:type rdf:Property ;
    rdfs:label 'Response Strategy' ;
    rdfs:comment 'Planned risk response strategy (e.g., avoid, mitigate, transfer, accept, escalate for threats; exploit, share, enhance for opportunities).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationPlan rdf:type rdf:Property ;
    rdfs:label 'Mitigation Plan' ;
    rdfs:comment 'Detailed description of the actions, strategies, or controls planned or implemented to reduce the probability or impact of the risk.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationOwner rdf:type rdf:Property ;
    rdfs:label 'Mitigation Owner' ;
    rdfs:comment 'Name or identifier of the person or team responsible for executing the mitigation plan.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Start Date' ;
    rdfs:comment 'Planned or actual start date for implementing the risk mitigation actions.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationTargetDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Target Date' ;
    rdfs:comment 'Target or planned completion date for the risk mitigation actions.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationActualDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Actual Date' ;
    rdfs:comment 'Actual date when the risk mitigation actions were completed.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationCost rdf:type rdf:Property ;
    rdfs:label 'Mitigation Cost' ;
    rdfs:comment 'Estimated or actual cost of implementing the risk mitigation actions, expressed in US dollars.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mitigationEffectiveness rdf:type rdf:Property ;
    rdfs:label 'Mitigation Effectiveness' ;
    rdfs:comment 'Assessment of how effective the mitigation actions have been in reducing the risk (e.g., not started, in progress, effective, partially effective, ineffective).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyPlan rdf:type rdf:Property ;
    rdfs:label 'Contingency Plan' ;
    rdfs:comment 'Contingency or fallback plan to be executed if the risk occurs despite mitigation efforts.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyTrigger rdf:type rdf:Property ;
    rdfs:label 'Contingency Trigger' ;
    rdfs:comment 'Specific conditions, events, or indicators that would trigger activation of the contingency plan.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyBudget rdf:type rdf:Property ;
    rdfs:label 'Contingency Budget' ;
    rdfs:comment 'Budget amount allocated or reserved for implementing the contingency plan if the risk materializes, expressed in US dollars.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residualProbability rdf:type rdf:Property ;
    rdfs:label 'Residual Probability' ;
    rdfs:comment 'Expected probability of the risk occurring after mitigation actions have been implemented.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualImpact rdf:type rdf:Property ;
    rdfs:label 'Residual Impact' ;
    rdfs:comment 'Expected impact severity of the risk after mitigation actions have been implemented.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualRiskScore rdf:type rdf:Property ;
    rdfs:label 'Residual Risk Score' ;
    rdfs:comment 'Calculated risk score after mitigation, representing the remaining risk exposure.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occurredFlag rdf:type rdf:Property ;
    rdfs:label 'Occurred Flag' ;
    rdfs:comment 'Indicator of whether the risk event has actually occurred (true) or remains a potential risk (false).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Occurrence Date' ;
    rdfs:comment 'Date when the risk event actually occurred, if applicable.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Actual Impact Description' ;
    rdfs:comment 'Description of the actual impact and consequences experienced when the risk occurred.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCostImpact rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Impact' ;
    rdfs:comment 'Actual financial impact incurred when the risk occurred, expressed in US dollars.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualScheduleImpactDays rdf:type rdf:Property ;
    rdfs:label 'Actual Schedule Impact Days' ;
    rdfs:comment 'Actual number of days the project schedule was delayed when the risk occurred.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closureReason rdf:type rdf:Property ;
    rdfs:label 'Closure Reason' ;
    rdfs:comment 'Explanation or justification for closing the risk record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Required Flag' ;
    rdfs:comment 'Indicator of whether the risk requires escalation to senior management or executive leadership.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationDate rdf:type rdf:Property ;
    rdfs:label 'Escalation Date' ;
    rdfs:comment 'Date when the risk was escalated to higher management levels.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Frequency' ;
    rdfs:comment 'Planned frequency for reviewing and reassessing this risk (e.g., daily, weekly, monthly, quarterly, as needed).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date when the risk was last reviewed and assessed by the project team or risk owner.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next risk review and reassessment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stipProgramYear rdf:type rdf:Property ;
    rdfs:label 'Stip Program Year' ;
    rdfs:comment 'STIP program year associated with the project to which this risk relates.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:district rdf:type rdf:Property ;
    rdfs:label 'District' ;
    rdfs:comment 'Geographic district or region within NCDOT where the project is located.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpoRpo rdf:type rdf:Property ;
    rdfs:label 'Mpo Rpo' ;
    rdfs:comment 'MPO or RPO jurisdiction associated with the project location.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalPermitRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Risk Flag' ;
    rdfs:comment 'Indicator of whether this risk is related to environmental permitting or compliance (NEPA, Section 404, endangered species, etc.).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rowAcquisitionRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Row Acquisition Risk Flag' ;
    rdfs:comment 'Indicator of whether this risk is related to right-of-way acquisition, property negotiations, or condemnation proceedings.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilityCoordinationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Utility Coordination Risk Flag' ;
    rdfs:comment 'Indicator of whether this risk is related to utility relocation, coordination, or conflicts.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:railroadCoordinationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Railroad Coordination Risk Flag' ;
    rdfs:comment 'Indicator of whether this risk involves railroad coordination, crossings, or FRA compliance.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceRecordId rdf:type rdf:Property ;
    rdfs:label 'Source Record Id' ;
    rdfs:comment 'Unique identifier of the risk record in the source system for traceability and reconciliation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentId rdf:type rdf:Property ;
    rdfs:label 'Document Id' ;
    rdfs:comment 'Unique identifier for the project document record. Primary key for the project document entity.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typeCode rdf:type rdf:Property ;
    rdfs:label 'Type Code' ;
    rdfs:comment 'Classification code indicating the type of project document (e.g., DRAWING for engineering drawings, PERMIT for regulatory permits, NEPA for National Environmental Policy Act documents, EA for Environmental Assessment, EIS for Environmental Impact Statement, FONSI for Finding of No Significant Impact, CE for Categorical Exclusion).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionNumber rdf:type rdf:Property ;
    rdfs:label 'Revision Number' ;
    rdfs:comment 'Sequential numeric revision counter for the document, incremented with each modification.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorName rdf:type rdf:Property ;
    rdfs:label 'Author Name' ;
    rdfs:comment 'Name of the individual or entity who created or authored the document.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorOrganization rdf:type rdf:Property ;
    rdfs:label 'Author Organization' ;
    rdfs:comment 'Organization, division, or company that the document author represents (e.g., NCDOT division, consultant firm, contractor).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparedByName rdf:type rdf:Property ;
    rdfs:label 'Prepared By Name' ;
    rdfs:comment 'Name of the individual who physically prepared or compiled the document.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creationDate rdf:type rdf:Property ;
    rdfs:label 'Creation Date' ;
    rdfs:comment 'Date when the document was originally created or authored.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'Date when the document underwent formal review process.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date when the document received official approval for use.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersededDate rdf:type rdf:Property ;
    rdfs:label 'Superseded Date' ;
    rdfs:comment 'Date when the document was replaced by a newer version or alternative document.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fileName rdf:type rdf:Property ;
    rdfs:label 'File Name' ;
    rdfs:comment 'Original file name of the electronic document as stored in the system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'Electronic file format or extension of the document (e.g., PDF, DWG for AutoCAD, DGN for MicroStation).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'File Size Bytes' ;
    rdfs:comment 'Size of the electronic document file measured in bytes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pageCount rdf:type rdf:Property ;
    rdfs:label 'Page Count' ;
    rdfs:comment 'Total number of pages in the document (for paginated documents).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'Physical or electronic storage location where the document is maintained (e.g., ProjectWise path, SharePoint URL, file server path).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageSystem rdf:type rdf:Property ;
    rdfs:label 'Storage System' ;
    rdfs:comment 'Name of the system or platform where the document is stored (e.g., ProjectWise for engineering documents, SharePoint for collaboration, SAP Document Management System).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:url rdf:type rdf:Property ;
    rdfs:label 'Url' ;
    rdfs:comment 'Direct hyperlink or URL to access the electronic document in its storage system.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checksumValue rdf:type rdf:Property ;
    rdfs:label 'Checksum Value' ;
    rdfs:comment 'Cryptographic hash or checksum value used to verify document integrity and detect unauthorized modifications.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityClassification rdf:type rdf:Property ;
    rdfs:label 'Security Classification' ;
    rdfs:comment 'Security classification level of the document determining access controls and handling requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Flag' ;
    rdfs:comment 'Boolean indicator of whether the document contains confidential or sensitive information requiring special handling.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicRecordFlag rdf:type rdf:Property ;
    rdfs:label 'Public Record Flag' ;
    rdfs:comment 'Boolean indicator of whether the document is considered a public record subject to disclosure under North Carolina public records law.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retentionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Retention Period Years' ;
    rdfs:comment 'Number of years the document must be retained according to records retention schedules before eligible for destruction.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retentionCategory rdf:type rdf:Property ;
    rdfs:label 'Retention Category' ;
    rdfs:comment 'Records retention category or schedule code that governs the document lifecycle and disposition.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionAction rdf:type rdf:Property ;
    rdfs:label 'Disposition Action' ;
    rdfs:comment 'Action to be taken with the document upon reaching the end of its retention period.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplineCode rdf:type rdf:Property ;
    rdfs:label 'Discipline Code' ;
    rdfs:comment 'Engineering or technical discipline associated with the document content.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sheetNumber rdf:type rdf:Property ;
    rdfs:label 'Sheet Number' ;
    rdfs:comment 'Sheet or drawing number within a set of engineering drawings or plans.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drawingScale rdf:type rdf:Property ;
    rdfs:label 'Drawing Scale' ;
    rdfs:comment 'Scale ratio used in engineering drawings or plans (e.g., 1:100, 1 inch = 50 feet).' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
