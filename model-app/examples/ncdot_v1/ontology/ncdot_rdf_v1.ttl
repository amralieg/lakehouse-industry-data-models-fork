ind:documentationReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Documentation Received Flag' ;
    rdfs:comment 'Indicates whether required supporting documentation has been received and verified.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
