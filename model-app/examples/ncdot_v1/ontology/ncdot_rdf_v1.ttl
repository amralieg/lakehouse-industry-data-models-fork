    rdfs:range xsd:string .

ind:successionPlanCritical rdf:type rdf:Property ;
    rdfs:label 'Succession Plan Critical' ;
    rdfs:comment 'Indicates whether the position is identified as critical for succession planning purposes due to specialized skills or organizational importance.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recruitmentDifficulty rdf:type rdf:Property ;
    rdfs:label 'Recruitment Difficulty' ;
    rdfs:comment 'Assessment of the difficulty level in recruiting qualified candidates for the position based on market conditions and skill requirements.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlNumber rdf:type rdf:Property ;
    rdfs:label 'Control Number' ;
    rdfs:comment 'State budget office position control number used for budget tracking and legislative reporting purposes.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beaconPositionId rdf:type rdf:Property ;
    rdfs:label 'Beacon Position Id' ;
    rdfs:comment 'Position identifier in the North Carolina Beacon HR and Payroll system for integration and cross-reference purposes.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapPositionId rdf:type rdf:Property ;
    rdfs:label 'Sap Position Id' ;
    rdfs:comment 'Position identifier in the SAP HR system for integration and cross-reference purposes.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Id' ;
    rdfs:comment 'Unique identifier for the journal entry record in the financial system.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:entryNumber rdf:type rdf:Property ;
    rdfs:label 'Entry Number' ;
    rdfs:comment 'Human-readable journal entry number assigned by the financial system for reference and tracking purposes.' ;
    rdfs:domain ind:JournalEntry ;
