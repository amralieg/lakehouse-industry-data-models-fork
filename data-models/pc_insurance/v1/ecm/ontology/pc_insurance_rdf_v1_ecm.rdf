    rdfs:domain ind:SurplusLinesTax ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Status' ;
    rdfs:comment 'Current lifecycle status of the surplus lines tax obligation.' ;
    rdfs:domain ind:SurplusLinesTax ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalTaxAndFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Tax And Fee Amount' ;
    rdfs:comment 'Combined total of surplus lines tax and stamping fee due.' ;
    rdfs:domain ind:SurplusLinesTax ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writtenPremiumId rdf:type rdf:Property ;
    rdfs:label 'Written Premium Id' ;
    rdfs:comment 'Unique identifier for the written premium transaction record.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exposureBasis rdf:type rdf:Property ;
    rdfs:label 'Exposure Basis' ;
    rdfs:comment 'Unit of measure for exposure, such as per $100 payroll, per vehicle, per square foot, or per $1000 insured value.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAuditPremium rdf:type rdf:Property ;
    rdfs:label 'Is Audit Premium' ;
    rdfs:comment 'Indicates whether this written premium transaction resulted from a policy audit adjustment.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInstallmentPlan rdf:type rdf:Property ;
    rdfs:label 'Is Installment Plan' ;
    rdfs:comment 'Indicates whether this written premium is part of an installment payment plan.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manualPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Manual Premium Amount' ;
    rdfs:comment 'Premium calculated using standard manual rates before application of experience modifications or schedule credits.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Policy Fee Amount' ;
    rdfs:comment 'Administrative or policy issuance fee charged in addition to premium.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyTermEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Policy Term Effective Date' ;
    rdfs:comment 'Start date of the policy term to which this written premium applies.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyTermExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Policy Term Expiration Date' ;
    rdfs:comment 'End date of the policy term to which this written premium applies.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduleCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Schedule Credit Amount' ;
    rdfs:comment 'Credit applied to premium for favorable risk characteristics identified during underwriting.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleDebitAmount rdf:type rdf:Property ;
    rdfs:label 'Schedule Debit Amount' ;
    rdfs:comment 'Debit applied to premium for unfavorable risk characteristics identified during underwriting.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statutoryReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Statutory Reporting Period' ;
    rdfs:comment 'Quarterly statutory reporting period in YYYY-Q# format for NAIC annual statement reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionBookingDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Booking Date' ;
    rdfs:comment 'Date when this premium transaction was recorded in the financial system.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:writtenPremiumStatus rdf:type rdf:Property ;
    rdfs:label 'Written Premium Status' ;
    rdfs:comment 'Current lifecycle status of this written premium transaction in the premium ledger.' ;
    rdfs:domain ind:WrittenPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionScheduleId rdf:type rdf:Property ;
    rdfs:label 'Commission Schedule Id' ;
    rdfs:comment 'Foreign key linking to producers.commission_schedule. Business justification: Agency master record references default commission schedule via string code. Adding proper FK enables referential integrity.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionSchedule .

ind:parentAgencyId rdf:type rdf:Property ;
    rdfs:label 'Parent Agency Id' ;
    rdfs:comment 'Self-referencing identifier linking this agency to its parent agency or network group, enabling hierarchical rollup of production, commission, and loss data.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:agencyStatus rdf:type rdf:Property ;
    rdfs:label 'Agency Status' ;
    rdfs:comment 'Current lifecycle status of the agency appointment with Pc_Insurance, governing whether the agency may bind new business or renew policies.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyType rdf:type rdf:Property ;
    rdfs:label 'Agency Type' ;
    rdfs:comment 'Classification of the agency by distribution channel role. [ENUM-REF-CANDIDATE: independent_agent|captive_agent|broker|managing_general_agent|surplus_lines_broker|wholesale_broker — promote to reference product]' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualPremiumVolume rdf:type rdf:Property ;
    rdfs:label 'Annual Premium Volume' ;
    rdfs:comment 'Most recently reported annual written premium (WP) volume placed by the agency across all carriers, used for producer tiering, contingent commission, and appetite decisions.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appointmentTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Termination Date' ;
    rdfs:comment 'Date on which the agency appointment with Pc_Insurance was or will be terminated. Null for active appointments. Required for DOI termination notice filings.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agencyCode rdf:type rdf:Property ;
    rdfs:label 'Agency Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned to the agency by Pc_Insurance, used on policy declarations, bordereaux, and commission statements.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentCommissionEligible rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Eligible' ;
    rdfs:comment 'Indicates whether the agency is eligible for contingent or profit-sharing commission based on loss ratio (LR) and volume performance thresholds.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eoCarrierName rdf:type rdf:Property ;
    rdfs:label 'Eo Carrier Name' ;
    rdfs:comment 'Name of the insurance carrier providing the agency Errors and Omissions (E&O) professional liability coverage, required for appointment and ongoing compliance.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Amount' ;
    rdfs:comment 'Per-occurrence limit of the agency E&O professional liability policy in USD. Pc_Insurance requires a minimum threshold for appointment eligibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faxNumber rdf:type rdf:Property ;
    rdfs:label 'Fax Number' ;
    rdfs:comment 'Business fax number for the agency, used for document transmission including policy applications, endorsement requests, and claims correspondence.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatio rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio' ;
    rdfs:comment 'Most recently calculated loss ratio (LR) for the agency book of business with Pc_Insurance, expressed as a decimal. Used for contingent commission eligibility and UW appetite review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managingGaFlag rdf:type rdf:Property ;
    rdfs:label 'Managing Ga Flag' ;
    rdfs:comment 'Indicates whether the agency operates as a Managing General Agent (MGA) with delegated underwriting authority, distinct from a standard retail or wholesale broker.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkCode rdf:type rdf:Property ;
    rdfs:label 'Network Code' ;
    rdfs:comment 'Code identifying the independent agency network or cluster group (e.g., Keystone, Argo) to which the agency belongs, used for network-level commission and volume tracking.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onboardingCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Completed Date' ;
    rdfs:comment 'Date on which the agency completed all onboarding requirements including licensing verification, E&O confirmation, background check, and system credentialing.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pcInsuranceGwp rdf:type rdf:Property ;
    rdfs:label 'Pc Insurance Gwp' ;
    rdfs:comment 'Gross written premium (GWP) placed with Pc_Insurance by this agency in the most recent policy year, used for production performance tracking and commission tier qualification.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredLobCodes rdf:type rdf:Property ;
    rdfs:label 'Preferred Lob Codes' ;
    rdfs:comment 'Comma-separated list of line of business (LOB) codes the agency is authorized or preferred to write, such as GL, BOP, WC, CPP, APD. Used for appetite and routing.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Principal Address Line1' ;
    rdfs:comment 'First line of the agency principal business address, used for regulatory correspondence, commission payments, and DOI licensing records.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Principal Address Line2' ;
    rdfs:comment 'Second line of the agency principal business address (suite, floor, unit). Supplements address_line1 for complete mailing address.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalCity rdf:type rdf:Property ;
    rdfs:label 'Principal City' ;
    rdfs:comment 'City of the agency principal business address, used for geographic segmentation, state licensing jurisdiction determination, and regulatory filings.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalCountryCode rdf:type rdf:Property ;
    rdfs:label 'Principal Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the agency principal business address. Typically USA for domestic agencies; supports surplus lines and international brokers.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalPostalCode rdf:type rdf:Property ;
    rdfs:label 'Principal Postal Code' ;
    rdfs:comment 'ZIP or ZIP+4 postal code for the agency principal business address, used for geographic rating territory assignment and regulatory correspondence.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesLicensed rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Licensed' ;
    rdfs:comment 'Indicates whether the agency holds a surplus lines broker license, authorizing placement of non-admitted coverage with eligible surplus lines insurers.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Public website URL for the agency, used for producer directory listings, digital marketing attribution, and consumer-facing producer locator tools.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyProducerId rdf:type rdf:Property ;
    rdfs:label 'Agency Producer Id' ;
    rdfs:comment 'Unique surrogate identifier for the agency-producer association record in the producers domain.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Agency Producers Producer Id' ;
    rdfs:comment 'Reference to the individual producer (agent or broker) associated with the agency.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:enoPolicyId rdf:type rdf:Property ;
    rdfs:label 'Eno Policy Id' ;
    rdfs:comment 'Foreign key linking to producers.eno_policy. Business justification: Agency-producer association tracks E&O coverage via string policy_number. Adding proper FK to eno_policy enables referential integrity and eliminates redundant storage of policy details.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnoPolicy .

ind:parentProducerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Parent Producer Producers Producer Id' ;
    rdfs:comment 'Reference to the supervising or parent producer within the agency hierarchy. Null if the producer is at the top of the hierarchy.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:appointmentDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Date' ;
    rdfs:comment 'Date the producer was formally appointed by the carrier or state DOI under this agency relationship.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Expiry Date' ;
    rdfs:comment 'Date on which the producer\'s state appointment under this agency expires and must be renewed to remain in good standing.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentNumber rdf:type rdf:Property ;
    rdfs:label 'Appointment Number' ;
    rdfs:comment 'State-issued or carrier-issued appointment number confirming the producer\'s authority to represent the agency and bind business on behalf of the insurer.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentState rdf:type rdf:Property ;
    rdfs:label 'Appointment State' ;
    rdfs:comment 'Two-letter US state code for the jurisdiction in which the producer is appointed under this agency association.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associationRole rdf:type rdf:Property ;
    rdfs:label 'Association Role' ;
    rdfs:comment 'Role the producer holds within the agency, such as principal agent, sub-agent, or broker. [ENUM-REF-CANDIDATE: principal_agent|sub_agent|broker|managing_agent|surplus_lines_agent|appointed_agent — promote to reference product]' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associationSource rdf:type rdf:Property ;
    rdfs:label 'Association Source' ;
    rdfs:comment 'Source system or process through which this agency-producer association record was created or last updated (e.g., AgentSync, Vertafore Sircon, manual entry).' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceCreditsCompleted rdf:type rdf:Property ;
    rdfs:label 'Ce Credits Completed' ;
    rdfs:comment 'Number of continuing education (CE) credit hours the producer has completed in the current compliance period under this agency association.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ceCreditsRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Credits Required' ;
    rdfs:comment 'Number of continuing education (CE) credit hours required for the producer to maintain compliance under this agency and state appointment.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelType rdf:type rdf:Property ;
    rdfs:label 'Channel Type' ;
    rdfs:comment 'Distribution channel classification for the producer within this agency (e.g., independent agent, captive agent, MGA, surplus lines broker).' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSplitPct rdf:type rdf:Property ;
    rdfs:label 'Commission Split Pct' ;
    rdfs:comment 'Decimal fraction (0.0000–1.0000) representing the producer\'s share of the agency commission for business written under this association.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalAssociationRef rdf:type rdf:Property ;
    rdfs:label 'External Association Ref' ;
    rdfs:comment 'Identifier for this agency-producer association in the source producer management system (AgentSync or Vertafore Sircon) for reconciliation and audit.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric level of the producer within the agency hierarchy (e.g., 1 = principal, 2 = senior agent, 3 = sub-agent). Used for commission override calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPrimaryAgency rdf:type rdf:Property ;
    rdfs:label 'Is Primary Agency' ;
    rdfs:comment 'Indicates whether this agency is the producer\'s primary or home agency, as opposed to a secondary or additional appointment.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrincipal rdf:type rdf:Property ;
    rdfs:label 'Is Principal' ;
    rdfs:comment 'Indicates whether the producer is the principal agent of the agency, holding primary authority and accountability within the agency hierarchy.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lobAuthorizations rdf:type rdf:Property ;
    rdfs:label 'Lob Authorizations' ;
    rdfs:comment 'Comma-separated list of Lines of Business (LOB) the producer is authorized to write under this agency (e.g., GL, WC, APD, BOP). Derived from appointment scope.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mgaFlag rdf:type rdf:Property ;
    rdfs:label 'Mga Flag' ;
    rdfs:comment 'Indicates whether the producer operates as a Managing General Agent (MGA) with delegated underwriting and binding authority under this agency.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naicPdbStatus rdf:type rdf:Property ;
    rdfs:label 'Naic Pdb Status' ;
    rdfs:comment 'Status of the producer in the NAIC Producer Database (PDB), reflecting any adverse licensing or regulatory history across all states.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Override Commission Pct' ;
    rdfs:comment 'Additional override commission percentage earned by a principal or managing agent on business written by sub-agents within the hierarchy.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordVersion rdf:type rdf:Property ;
    rdfs:label 'Record Version' ;
    rdfs:comment 'Optimistic locking version counter incremented on each update to this association record, supporting concurrency control and change tracking.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryActionFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Flag' ;
    rdfs:comment 'Indicates whether the producer has an open or historical regulatory action (e.g., DOI investigation, license suspension) relevant to this agency association.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationNotes rdf:type rdf:Property ;
    rdfs:label 'Termination Notes' ;
    rdfs:comment 'Free-text notes providing additional context for the termination of the producer-agency association, used for compliance documentation.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Training Compliance Status' ;
    rdfs:comment 'Indicates whether the producer has met all required continuing education (CE) and product training obligations under this agency association.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentId rdf:type rdf:Property ;
    rdfs:label 'Appointment Id' ;
    rdfs:comment 'Unique surrogate identifier for a producer appointment record in the Pc_Insurance system.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Appointment .

ind:orgUnitId rdf:type rdf:Property ;
    rdfs:label 'Org Unit Id' ;
    rdfs:comment 'Reference to the Pc_Insurance legal carrier entity (e.g., admitted vs. surplus lines subsidiary) issuing this appointment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:appointedByUser rdf:type rdf:Property ;
    rdfs:label 'Appointed By User' ;
    rdfs:comment 'Username or employee ID of the carrier underwriting or producer management staff member who authorized this appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Status' ;
    rdfs:comment 'Current lifecycle state of the producer appointment as recognized by the carrier and state DOI.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentType rdf:type rdf:Property ;
    rdfs:label 'Appointment Type' ;
    rdfs:comment 'Classification of the producer appointment relationship. [ENUM-REF-CANDIDATE: agent|broker|managing_general_agent|surplus_lines_broker|reinsurance_intermediary|solicitor — promote to reference product]' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Base Commission Rate' ;
    rdfs:comment 'Standard commission rate (as a decimal fraction) payable to the producer on new and renewal written premium under this appointment.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doiApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Doi Approval Date' ;
    rdfs:comment 'Date the state DOI confirmed or approved the producer appointment filing. Null if pending or not required.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiFilingDate rdf:type rdf:Property ;
    rdfs:label 'Doi Filing Date' ;
    rdfs:comment 'Date the appointment was submitted to the state DOI for regulatory filing and approval.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiFilingReference rdf:type rdf:Property ;
    rdfs:label 'Doi Filing Reference' ;
    rdfs:comment 'State Department of Insurance confirmation or tracking number assigned when the appointment was filed with the regulator.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBindingAuthority rdf:type rdf:Property ;
    rdfs:label 'Is Binding Authority' ;
    rdfs:comment 'Indicates whether the producer has been granted binding authority to commit coverage on behalf of Pc_Insurance without prior UW approval.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSurplusLines rdf:type rdf:Property ;
    rdfs:label 'Is Surplus Lines' ;
    rdfs:comment 'Indicates whether this appointment is for surplus lines (non-admitted) business, subject to separate state surplus lines regulations.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:producerLicenseClass rdf:type rdf:Property ;
    rdfs:label 'Producer License Class' ;
    rdfs:comment 'Class of the underlying producer license authorizing this appointment, e.g., property, casualty, surplus lines.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Producer License Number' ;
    rdfs:comment 'State-issued insurance producer license number that underpins this appointment. Must be active in the appointment state.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemAppointmentCode rdf:type rdf:Property ;
    rdfs:label 'Source System Appointment Code' ;
    rdfs:comment 'Native primary key or record identifier for this appointment in the originating producer management system of record.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingCompleted rdf:type rdf:Property ;
    rdfs:label 'Training Completed' ;
    rdfs:comment 'Indicates whether the producer has completed all mandatory carrier product and compliance training required for this appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Training Completion Date' ;
    rdfs:comment 'Date on which the producer completed all required carrier training for this appointment.' ;
    rdfs:domain ind:Appointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:producerAgreementId rdf:type rdf:Property ;
    rdfs:label 'Producer Agreement Id' ;
    rdfs:comment 'Foreign key linking to producers.producer_agreement. Business justification: Binding authority is granted under a producer agreement. Currently tracked via string reference (agreement_ref).' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducerAgreement .

ind:admittedCarrierFlag rdf:type rdf:Property ;
    rdfs:label 'Admitted Carrier Flag' ;
    rdfs:comment 'Indicates whether the insurer backing this binding authority is an admitted (licensed) carrier in the applicable state jurisdictions.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aggregateAnnualLimit rdf:type rdf:Property ;
    rdfs:label 'Aggregate Annual Limit' ;
    rdfs:comment 'Maximum total gross written premium (GWP) or total insured value the producer may bind under this authority within a single policy year.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Frequency' ;
    rdfs:comment 'Frequency at which the insurer conducts underwriting audits of policies bound under this authority to verify compliance with guidelines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityName rdf:type rdf:Property ;
    rdfs:label 'Authority Name' ;
    rdfs:comment 'Descriptive name or title of the binding authority arrangement, e.g., \'Commercial Property MGA Facility 2024\'.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityNumber rdf:type rdf:Property ;
    rdfs:label 'Authority Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this binding authority agreement, used on bordereaux and regulatory filings.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityStatus rdf:type rdf:Property ;
    rdfs:label 'Authority Status' ;
    rdfs:comment 'Current lifecycle state of the binding authority. Drives eligibility to bind new policies. [ENUM-REF-CANDIDATE: active|suspended|expired|terminated|pending_approval|under_review — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityType rdf:type rdf:Property ;
    rdfs:label 'Authority Type' ;
    rdfs:comment 'Classification of the delegated authority arrangement. [ENUM-REF-CANDIDATE: MGA|Coverholder|Wholesale_Broker|Surplus_Lines|Program_Administrator|Lloyd_Coverholder — promote to reference product]' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionRatePct rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Pct' ;
    rdfs:comment 'Standard commission rate (as a percentage of gross written premium) payable to the producer for policies bound under this authority.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleCoverageClasses rdf:type rdf:Property ;
    rdfs:label 'Eligible Coverage Classes' ;
    rdfs:comment 'Comma-delimited list of coverage class or program codes (e.g., personal_auto, commercial_property, inland_marine) permitted under this authority.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleLobCodes rdf:type rdf:Property ;
    rdfs:label 'Eligible Lob Codes' ;
    rdfs:comment 'Comma-delimited list of NAIC or ISO line-of-business codes (e.g., GL, CPP, BOP, WC, APD) that the producer is authorized to bind under this authority.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleRiskClasses rdf:type rdf:Property ;
    rdfs:label 'Eligible Risk Classes' ;
    rdfs:comment 'Comma-delimited list of risk class or NAICS/SIC codes the producer may bind. Restricts authority to specific occupancy or industry segments.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedRiskClasses rdf:type rdf:Property ;
    rdfs:label 'Excluded Risk Classes' ;
    rdfs:comment 'Comma-delimited list of NAICS/SIC or ISO risk class codes explicitly prohibited from being bound under this authority.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedZipCodes rdf:type rdf:Property ;
    rdfs:label 'Excluded Zip Codes' ;
    rdfs:comment 'Comma-delimited list of US ZIP codes or postal code prefixes explicitly excluded from the binding authority territory, e.g., CAT-prone coastal zones.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSuspended rdf:type rdf:Property ;
    rdfs:label 'Is Suspended' ;
    rdfs:comment 'Indicates whether the binding authority is currently suspended. True prevents new policy binding; used for real-time eligibility checks.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Audit Date' ;
    rdfs:comment 'Date of the most recent underwriting compliance audit conducted against this binding authority.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossRatioThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Threshold Pct' ;
    rdfs:comment 'Maximum permissible loss ratio (LR) on business bound under this authority before suspension or commission clawback is triggered.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxCatTiv rdf:type rdf:Property ;
    rdfs:label 'Max Cat Tiv' ;
    rdfs:comment 'Maximum aggregate total insured value (TIV) for CAT-exposed risks the producer may bind under this authority in a single policy year.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Max Deductible Amount' ;
    rdfs:comment 'Maximum deductible or SIR permitted on any single policy bound under this authority, in the authority currency.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxPolicyLimit rdf:type rdf:Property ;
    rdfs:label 'Max Policy Limit' ;
    rdfs:comment 'The ceiling on the total insured value (TIV) or per-occurrence policy limit that the producer is authorized to bind on a single policy, in USD.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxSingleRiskLimit rdf:type rdf:Property ;
    rdfs:label 'Max Single Risk Limit' ;
    rdfs:comment 'Maximum sum insured (SI) the producer may bind for any single risk location or insured object, in USD. Distinct from aggregate policy limit.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Min Deductible Amount' ;
    rdfs:comment 'Minimum deductible or self-insured retention (SIR) that must be applied to any policy bound under this authority, in the authority currency.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextAuditDate rdf:type rdf:Property ;
    rdfs:label 'Next Audit Date' ;
    rdfs:comment 'Scheduled date for the next underwriting compliance audit of policies bound under this authority.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Notice Period Days' ;
    rdfs:comment 'Number of calendar days advance notice required by either party to cancel or non-renew this binding authority agreement.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:profitCommissionRatePct rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Rate Pct' ;
    rdfs:comment 'Contingent profit commission rate payable to the producer if the loss ratio (LR) on bound business falls below the agreed threshold.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Internal program or facility code linking this binding authority to a specific underwriting program, rate filing, or product configuration in PolicyCenter.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateFilingReference rdf:type rdf:Property ;
    rdfs:label 'Rate Filing Reference' ;
    rdfs:comment 'State DOI rate and form filing reference number applicable to the products bound under this authority, ensuring regulatory compliance.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Required Flag' ;
    rdfs:comment 'Indicates whether facultative (FAC) or treaty reinsurance (RI) placement is mandatory before the producer may bind risks under this authority.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalType rdf:type rdf:Property ;
    rdfs:label 'Renewal Type' ;
    rdfs:comment 'Indicates whether this binding authority renews automatically (auto), requires manual review (manual), or will not be renewed (non_renew) at expiration.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionDate rdf:type rdf:Property ;
    rdfs:label 'Suspension Date' ;
    rdfs:comment 'Date on which the binding authority was suspended, preventing new policy binding until reinstatement. Null if never suspended.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:suspensionReason rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason' ;
    rdfs:comment 'Free-text explanation of why the binding authority was suspended, e.g., regulatory action, loss ratio breach, or compliance failure.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryCountryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the primary country jurisdiction of this binding authority, e.g., USA, CAN, GBR.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryStates rdf:type rdf:Property ;
    rdfs:label 'Territory States' ;
    rdfs:comment 'Comma-delimited list of US state abbreviations (e.g., CA,TX,FL) defining the geographic territory within which the producer may bind risks.' ;
    rdfs:domain ind:BindingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByCommissionScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Commission Schedule Id' ;
    rdfs:comment 'Reference to the commission_schedule_id of the newer schedule that replaced this one. Null if this is the current active version. Supports schedule lineage and audit trails.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionSchedule .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Internal approval workflow status for this commission schedule. Schedules must be approved before activation. Supports SOX-compliant change management and audit trail requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationChargebackRate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Chargeback Rate' ;
    rdfs:comment 'Rate at which previously paid commission is charged back to the producer upon policy cancellation (CANC). Applied to the unearned premium returned to the policyholder.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:combinedRatioThreshold rdf:type rdf:Property ;
    rdfs:label 'Combined Ratio Threshold' ;
    rdfs:comment 'Maximum permissible Combined Ratio (CR) for the producer\'s portfolio to qualify for profit-sharing or contingent bonus. Incorporates both Loss Ratio (LR) and Expense Ratio (ER).' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingentBonusRate rdf:type rdf:Property ;
    rdfs:label 'Contingent Bonus Rate' ;
    rdfs:comment 'Additional contingent bonus rate payable on top of the base commission when the producer meets profitability or volume thresholds defined in the bonus tier configuration.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dacEligible rdf:type rdf:Property ;
    rdfs:label 'Dac Eligible' ;
    rdfs:comment 'Indicates whether commissions paid under this schedule qualify as Deferred Acquisition Costs (DAC) for GAAP accounting purposes under ASC 944, requiring capitalization and amortization.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Commission Schedule Description' ;
    rdfs:comment 'Free-text narrative describing the business purpose, eligibility criteria, and special conditions of this commission schedule. Used in producer agreements and internal documentation.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementRate rdf:type rdf:Property ;
    rdfs:label 'Endorsement Rate' ;
    rdfs:comment 'Commission rate applied to mid-term endorsement (ENDT) transactions that generate additional premium. Applied to the net additional premium resulting from the endorsement.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingReference rdf:type rdf:Property ;
    rdfs:label 'Filing Reference' ;
    rdfs:comment 'State DOI filing reference number or SERFF tracking number associated with the regulatory submission of this commission schedule. Null if no filing is required.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioThreshold rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Threshold' ;
    rdfs:comment 'Maximum permissible Loss Ratio (LR) expressed as a decimal that the producer\'s book must not exceed to remain eligible for contingent bonus or profit-sharing commission under this schedule.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxVolumePremium rdf:type rdf:Property ;
    rdfs:label 'Max Volume Premium' ;
    rdfs:comment 'Upper Written Premium (WP) volume cap in USD above which this schedule tier no longer applies and the producer advances to the next tier. Null indicates no upper cap.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementPeriod rdf:type rdf:Property ;
    rdfs:label 'Measurement Period' ;
    rdfs:comment 'Time period over which producer volume, loss ratio, and profitability metrics are measured to determine eligibility and payout under this commission schedule.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minPolicyCount rdf:type rdf:Property ;
    rdfs:label 'Min Policy Count' ;
    rdfs:comment 'Minimum number of in-force policies the producer must maintain during the measurement period to qualify for this commission schedule or contingent bonus tier.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minVolumePremium rdf:type rdf:Property ;
    rdfs:label 'Min Volume Premium' ;
    rdfs:comment 'Minimum Written Premium (WP) volume in USD that a producer must generate within the measurement period to qualify for this commission schedule or contingent bonus tier.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newBusinessRate rdf:type rdf:Property ;
    rdfs:label 'New Business Rate' ;
    rdfs:comment 'Specific commission rate applied to New Business (NB) policy transactions when the schedule differentiates NB from renewal rates. Overrides base_commission_rate for NB transactions.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideRate rdf:type rdf:Property ;
    rdfs:label 'Override Rate' ;
    rdfs:comment 'Override percentage applied to the base commission rate for managing general agents or hierarchical producers who earn a spread on sub-producer business.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:producerTier rdf:type rdf:Property ;
    rdfs:label 'Producer Tier' ;
    rdfs:comment 'Producer performance or appointment tier to which this schedule applies. Tier determines eligibility for enhanced base rates, contingent bonuses, and override percentages.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerType rdf:type rdf:Property ;
    rdfs:label 'Producer Type' ;
    rdfs:comment 'Type of producer entity this schedule governs: independent agent, broker, Managing General Agent (MGA), MGA-E, or surplus lines broker. Affects regulatory disclosure and payout rules.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitSharingRate rdf:type rdf:Property ;
    rdfs:label 'Profit Sharing Rate' ;
    rdfs:comment 'Rate applied to the producer\'s eligible profit base to calculate profit-sharing commission. Payable when the producer\'s book achieves profitability targets defined by loss and combined ratio thresholds.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalRate rdf:type rdf:Property ;
    rdfs:label 'Renewal Rate' ;
    rdfs:comment 'Specific commission rate applied to Renewal (REN) policy transactions. Typically lower than the New Business (NB) rate, reflecting reduced acquisition cost for retained policies.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this commission schedule, used in producer agreements, bordereaux, and system configuration references.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Human-readable name describing this commission schedule, used in producer-facing documents, commission statements, and reporting dashboards.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Classifies the commission schedule as base, contingent, override, profit-sharing, or bonus. Drives calculation logic and payout eligibility rules in the commission engine.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statExpenseCode rdf:type rdf:Property ;
    rdfs:label 'Stat Expense Code' ;
    rdfs:comment 'NAIC statutory expense code used to classify commission payments in the Annual Statement Underwriting and Investment Exhibit. Required for statutory financial reporting.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionStatementId rdf:type rdf:Property ;
    rdfs:label 'Commission Statement Id' ;
    rdfs:comment 'Unique surrogate identifier for the commission statement record. Primary key for the commission_statement data product in the producers domain.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionStatement .

ind:adjustmentAmt rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amt' ;
    rdfs:comment 'Net miscellaneous adjustments applied to the statement, including corrections from prior periods, manual overrides, or regulatory-mandated recalculations.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusCommissionAmt rdf:type rdf:Property ;
    rdfs:label 'Bonus Commission Amt' ;
    rdfs:comment 'Discretionary or incentive bonus commission awarded to the producer for meeting new business, retention, or quality targets during the period.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargebackAmt rdf:type rdf:Property ;
    rdfs:label 'Chargeback Amt' ;
    rdfs:comment 'Commission previously paid that is reclaimed due to policy cancellations, mid-term endorsements, or return premium events during the settlement period.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingentCommissionAmt rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Amt' ;
    rdfs:comment 'Profit-sharing or contingent commission earned based on loss ratio, volume, or growth performance thresholds agreed in the producer contract.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dacEligibleAmt rdf:type rdf:Property ;
    rdfs:label 'Dac Eligible Amt' ;
    rdfs:comment 'Portion of commission on this statement that qualifies as Deferred Acquisition Cost (DAC) under US GAAP ASC 944 or IFRS 17 for capitalization and amortization.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Free-text description of the reason provided by the producer or internal reviewer for disputing this commission statement. Populated when is_disputed is true.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Date' ;
    rdfs:comment 'Date on which a disputed commission statement was formally resolved and approved for payment. Null if no dispute was raised or dispute is still open.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earnedCommissionAmt rdf:type rdf:Property ;
    rdfs:label 'Earned Commission Amt' ;
    rdfs:comment 'Total commission earned by the producer during the settlement period before adjustments, chargebacks, or contingent additions. Core gross commission figure.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossWrittenPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Gross Written Premium Amt' ;
    rdfs:comment 'Total Gross Written Premium (GWP) on policies attributed to this producer during the settlement period. Basis for commission calculation.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDisputed rdf:type rdf:Property ;
    rdfs:label 'Is Disputed' ;
    rdfs:comment 'Indicates whether the producer has formally disputed any line items or the total amount on this commission statement. Triggers dispute resolution workflow.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netPayableAmt rdf:type rdf:Property ;
    rdfs:label 'Net Payable Amt' ;
    rdfs:comment 'Final net amount payable to the producer after summing earned, contingent, and bonus commissions and subtracting chargebacks and adjustments.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newBusinessPolicyCount rdf:type rdf:Property ;
    rdfs:label 'New Business Policy Count' ;
    rdfs:comment 'Count of newly bound policies (NB) attributed to this producer during the settlement period. Supports new business incentive and bonus commission calculations.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentReference rdf:type rdf:Property ;
    rdfs:label 'Payment Reference' ;
    rdfs:comment 'Reference number of the payment transaction (ACH, check, wire) issued to settle this commission statement. Links to the accounts payable payment record.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPeriodBalanceAmt rdf:type rdf:Property ;
    rdfs:label 'Prior Period Balance Amt' ;
    rdfs:comment 'Outstanding balance carried forward from the previous settlement period, including unpaid amounts or disputed items not yet resolved.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDisclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Disclosure Required' ;
    rdfs:comment 'Indicates whether this commission statement requires regulatory disclosure to the insured or state Department of Insurance per applicable market conduct rules.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalPolicyCount rdf:type rdf:Property ;
    rdfs:label 'Renewal Policy Count' ;
    rdfs:comment 'Count of renewed policies (REN) attributed to this producer during the settlement period. Supports retention-based commission and No Claims Bonus (NCB) calculations.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:settlementFrequency rdf:type rdf:Property ;
    rdfs:label 'Settlement Frequency' ;
    rdfs:comment 'Frequency at which commission statements are generated and settled for this producer. Drives the statement cycle and payment schedule.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Period End Date' ;
    rdfs:comment 'Last calendar date of the commission settlement period covered by this statement. Defines the inclusive end of the earning window.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Period Start Date' ;
    rdfs:comment 'First calendar date of the commission settlement period covered by this statement. Defines the inclusive start of the earning window.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementType rdf:type rdf:Property ;
    rdfs:label 'Statement Type' ;
    rdfs:comment 'Classification of the statement indicating whether it is a standard periodic statement, a supplemental issuance, a correction of a prior statement, or a final settlement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxFormType rdf:type rdf:Property ;
    rdfs:label 'Tax Form Type' ;
    rdfs:comment 'IRS tax form type applicable to the commission payments on this statement (e.g., 1099-NEC for independent agents, W-2 for captive agents, none if below threshold).' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxWithheldAmt rdf:type rdf:Property ;
    rdfs:label 'Tax Withheld Amt' ;
    rdfs:comment 'Amount of income tax or backup withholding deducted from the commission payment per IRS or applicable state tax authority requirements.' ;
    rdfs:domain ind:CommissionStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionTransactionId rdf:type rdf:Property ;
    rdfs:label 'Commission Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each commission transaction record in the producers domain. Primary key for the commission_transaction data product.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Id' ;
    rdfs:comment 'For reversal or adjustment transactions, references the commission_transaction_id of the original transaction being corrected or reversed.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionTransaction .

ind:chargebackAmount rdf:type rdf:Property ;
    rdfs:label 'Chargeback Amount' ;
    rdfs:comment 'Amount clawed back from the producer due to policy cancellation, mid-term endorsement reduction, or non-payment of premium. Positive value represents a debit to the producer.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionType rdf:type rdf:Property ;
    rdfs:label 'Commission Type' ;
    rdfs:comment 'Categorizes the nature of the commission: Standard, Contingent, Override, Bonus, Chargeback, or Supplemental. [ENUM-REF-CANDIDATE: STANDARD|CONTINGENT|OVERRIDE|BONUS|CHARGEBACK|SUPPLEMENTAL — promote to reference product]' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentCommissionFlag rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Flag' ;
    rdfs:comment 'Indicates whether this transaction includes a contingent (profit-sharing) commission component subject to loss ratio performance thresholds.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dacEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Dac Eligible Flag' ;
    rdfs:comment 'Indicates whether this commission qualifies as a Deferred Acquisition Cost (DAC) under US GAAP ASC 944, requiring deferral and amortization over the policy term.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earnedCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Commission Amount' ;
    rdfs:comment 'The portion of net commission recognized as earned in the current accounting period, pro-rated over the policy term for DAC and Earned Premium (EP) alignment.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Commission Amount' ;
    rdfs:comment 'The total commission earned before any adjustments, chargebacks, or withholdings. Calculated as GWP basis multiplied by the commission rate.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gwpBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Gwp Basis Amount' ;
    rdfs:comment 'The Gross Written Premium (GWP) amount on which the commission rate is applied to calculate the earned commission for this transaction.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Net Commission Amount' ;
    rdfs:comment 'The final commission amount payable to the producer after applying all adjustments and chargebacks. Equals gross commission plus adjustment amount.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Override Commission Amount' ;
    rdfs:comment 'Additional override or bonus commission paid to a managing general agent (MGA) or supervising producer above the base commission rate.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proRataFactor rdf:type rdf:Property ;
    rdfs:label 'Pro Rata Factor' ;
    rdfs:comment 'The pro-rata fraction applied to compute earned or returned commission on mid-term endorsements and cancellations, based on days remaining in the policy term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Reference' ;
    rdfs:comment 'The native transaction identifier from the originating system of record (e.g., Guidewire BillingCenter transaction ID), used for lineage and reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxWithholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Amount' ;
    rdfs:comment 'Federal or state income tax withheld from the commission payment for 1099 or backup withholding compliance, reported on IRS Form 1099-MISC.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unearnedCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Unearned Commission Amount' ;
    rdfs:comment 'The portion of net commission deferred as unearned, corresponding to the Unearned Premium (UEP) reserve for the unexpired policy period.' ;
    rdfs:domain ind:CommissionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingentBonusId rdf:type rdf:Property ;
    rdfs:label 'Contingent Bonus Id' ;
    rdfs:comment 'Unique surrogate identifier for a contingent or profit-sharing bonus record for a producer or agency.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualLr rdf:type rdf:Property ;
    rdfs:label 'Actual Lr' ;
    rdfs:comment 'Actual Loss Ratio (LR) achieved by the producer during the measurement period, calculated as incurred losses divided by earned premium.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusNumber rdf:type rdf:Property ;
    rdfs:label 'Bonus Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for this contingent bonus record, used in producer statements and settlement documents.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bonusRate rdf:type rdf:Property ;
    rdfs:label 'Bonus Rate' ;
    rdfs:comment 'Percentage rate applied to the eligible premium base to calculate the contingent bonus earned amount, expressed as a decimal (e.g., 0.05 = 5%).' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusStatus rdf:type rdf:Property ;
    rdfs:label 'Bonus Status' ;
    rdfs:comment 'Current lifecycle state of the contingent bonus record: calculated, approved, disputed, paid, voided, or pending review.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bonusType rdf:type rdf:Property ;
    rdfs:label 'Bonus Type' ;
    rdfs:comment 'Classification of the bonus arrangement: profit sharing, contingent commission, growth, retention, volume, or performance. [ENUM-REF-CANDIDATE: promote to reference product if values expand]' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationDate rdf:type rdf:Property ;
    rdfs:label 'Calculation Date' ;
    rdfs:comment 'Date on which the contingent bonus amount was formally calculated based on the measurement period results.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earnedAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Amount' ;
    rdfs:comment 'Gross contingent bonus amount earned by the producer based on the bonus rate applied to the eligible premium base after meeting all thresholds.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:growthQualified rdf:type rdf:Property ;
    rdfs:label 'Growth Qualified' ;
    rdfs:comment 'Indicates whether the producer met the minimum GWP growth rate target during the measurement period to qualify for the growth component.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:growthTargetRate rdf:type rdf:Property ;
    rdfs:label 'Growth Target Rate' ;
    rdfs:comment 'Minimum GWP growth rate the producer must achieve to qualify for the growth component of the contingent bonus, expressed as a decimal.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gwpGrowthRate rdf:type rdf:Property ;
    rdfs:label 'Gwp Growth Rate' ;
    rdfs:comment 'Year-over-year GWP growth rate achieved by the producer during the measurement period, expressed as a decimal (e.g., 0.10 = 10%).' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incurredLossesAmount rdf:type rdf:Property ;
    rdfs:label 'Incurred Losses Amount' ;
    rdfs:comment 'Total incurred losses including paid losses and case reserves for the producer\'s book during the measurement period.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laeAmount rdf:type rdf:Property ;
    rdfs:label 'Lae Amount' ;
    rdfs:comment 'Total Loss Adjustment Expense (LAE) including ALAE and ULAE attributable to the producer\'s book during the measurement period.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lrQualified rdf:type rdf:Property ;
    rdfs:label 'Lr Qualified' ;
    rdfs:comment 'Indicates whether the producer met the LR threshold requirement during the measurement period. True if actual LR is at or below lr_threshold.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lrThreshold rdf:type rdf:Property ;
    rdfs:label 'Lr Threshold' ;
    rdfs:comment 'Maximum allowable Loss Ratio (LR) that the producer must achieve to qualify for the contingent bonus. Bonus is forfeited if actual LR exceeds this threshold.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End Date' ;
    rdfs:comment 'End date of the performance measurement period over which loss ratio, premium volume, and growth are evaluated for this bonus.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start Date' ;
    rdfs:comment 'Start date of the performance measurement period over which loss ratio, premium volume, and growth are evaluated for this bonus.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallQualified rdf:type rdf:Property ;
    rdfs:label 'Overall Qualified' ;
    rdfs:comment 'Indicates whether the producer met ALL qualification criteria (LR, volume, growth) and is eligible to receive the contingent bonus payment.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorYearGwpAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Gwp Amount' ;
    rdfs:comment 'Producer\'s GWP in the prior measurement period, used as the baseline for year-over-year growth rate calculation.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programYear rdf:type rdf:Property ;
    rdfs:label 'Program Year' ;
    rdfs:comment 'Calendar or fiscal year of the contingent bonus program under which this record is calculated (e.g., 2024).' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:volumeQualified rdf:type rdf:Property ;
    rdfs:label 'Volume Qualified' ;
    rdfs:comment 'Indicates whether the producer met the minimum premium volume target during the measurement period to qualify for the volume component.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:volumeTargetAmount rdf:type rdf:Property ;
    rdfs:label 'Volume Target Amount' ;
    rdfs:comment 'Minimum GWP or NWP volume the producer must write during the measurement period to qualify for the volume component of the contingent bonus.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdingTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Amount' ;
    rdfs:comment 'Federal or state withholding tax amount deducted from the contingent bonus payment where applicable per IRS or state tax regulations.' ;
    rdfs:domain ind:ContingentBonus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:additionalInsuredIndicator rdf:type rdf:Property ;
    rdfs:label 'Additional Insured Indicator' ;
    rdfs:comment 'Indicates whether the appointing carrier is listed as an additional insured on the producer\'s E&O policy.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Premium Amount' ;
    rdfs:comment 'Total annual premium paid by the producer or agency for the E&O policy. Used in cost-of-distribution and producer profitability analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoRenewalIndicator rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Indicator' ;
    rdfs:comment 'Indicates whether the E&O policy is set to automatically renew upon expiration without requiring manual re-submission.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Received Date' ;
    rdfs:comment 'Date on which the certificate of insurance evidencing E&O coverage was received and logged by the carrier\'s producer management team.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Status' ;
    rdfs:comment 'Compliance determination for the E&O policy relative to carrier appointment requirements. Drives appointment eligibility and suspension workflows.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceVerifiedBy rdf:type rdf:Property ;
    rdfs:label 'Compliance Verified By' ;
    rdfs:comment 'Name or user identifier of the compliance officer or system that last verified the E&O policy meets appointment requirements.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Verified Date' ;
    rdfs:comment 'Most recent date on which the E&O policy was verified as compliant with carrier appointment requirements by the producer management team.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageFormType rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Type' ;
    rdfs:comment 'Indicates whether the E&O policy is written on a claims-made or occurrence basis, which determines when coverage is triggered.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerNaicCode rdf:type rdf:Property ;
    rdfs:label 'Insurer Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code identifying the E&O insurer. Used for statutory reporting and carrier validation.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerName rdf:type rdf:Property ;
    rdfs:label 'Insurer Name' ;
    rdfs:comment 'Legal name of the insurance carrier providing the E&O coverage to the producer or agency.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobCovered rdf:type rdf:Property ;
    rdfs:label 'Lob Covered' ;
    rdfs:comment 'Comma-delimited list of lines of business (e.g., P&C, Life, Health) for which the E&O policy provides professional liability coverage.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumRequiredLimitMet rdf:type rdf:Property ;
    rdfs:label 'Minimum Required Limit Met' ;
    rdfs:comment 'Indicates whether the policy\'s per-occurrence and aggregate limits meet the carrier\'s minimum E&O requirements for appointment.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multiStateIndicator rdf:type rdf:Property ;
    rdfs:label 'Multi State Indicator' ;
    rdfs:comment 'Indicates whether the E&O policy provides coverage across multiple state jurisdictions beyond the primary filing state.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorActsCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Prior Acts Coverage Indicator' ;
    rdfs:comment 'Indicates whether the E&O policy includes prior acts coverage, extending protection to acts occurring before the retroactive date.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'Timestamp when this E&O policy record was first created in the data platform. Supports audit trail and data lineage requirements.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'Timestamp when this E&O policy record was last modified in the data platform. Used for change detection and incremental processing.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:renewalReminderDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Reminder Days' ;
    rdfs:comment 'Number of days before expiration that automated renewal reminder notifications are triggered to the producer and compliance team.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved By' ;
    rdfs:comment 'Name or user identifier of the compliance authority who approved the E&O compliance waiver for this producer.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Expiration Date' ;
    rdfs:comment 'Date on which the compliance waiver expires, after which the producer must provide a compliant E&O policy to maintain appointment.' ;
    rdfs:domain ind:EnoPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Documented justification for granting a compliance waiver when the E&O policy does not meet standard appointment requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onboardingCaseId rdf:type rdf:Property ;
    rdfs:label 'Onboarding Case Id' ;
    rdfs:comment 'Unique surrogate identifier for the producer onboarding and compliance case record in the silver layer.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Application Received Date' ;
    rdfs:comment 'Date the producer onboarding application was formally received and logged, marking the start of the onboarding case lifecycle.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentFilingDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Filing Date' ;
    rdfs:comment 'Date the producer appointment was formally filed with the applicable state Departments of Insurance following successful completion of all onboarding checks.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentStateCodes rdf:type rdf:Property ;
    rdfs:label 'Appointment State Codes' ;
    rdfs:comment 'Pipe-delimited list of two-letter state codes where the producer is being appointed or has active appointments with Pc_Insurance, per DOI filing requirements.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedUwReviewer rdf:type rdf:Property ;
    rdfs:label 'Assigned Uw Reviewer' ;
    rdfs:comment 'Name or employee identifier of the underwriting or compliance officer assigned to review and adjudicate the producer onboarding case.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckProvider rdf:type rdf:Property ;
    rdfs:label 'Background Check Provider' ;
    rdfs:comment 'Name of the third-party vendor engaged to conduct the producer background screening, used for audit trail and vendor management tracking.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindingAuthorityGranted rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Granted' ;
    rdfs:comment 'Indicates whether the producer has been granted binding authority to commit Pc_Insurance to coverage without prior underwriting approval, per the producer agreement.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseClosedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Case Closed Timestamp' ;
    rdfs:comment 'Timestamp when the onboarding case was formally closed, either through approval and system activation, rejection, or withdrawal.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Externally visible business identifier for the onboarding case, used in correspondence and regulatory filings with state Departments of Insurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseOpenedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Case Opened Timestamp' ;
    rdfs:comment 'Precise timestamp when the onboarding case record was created in the producer management system, serving as the audit creation marker.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:caseStatus rdf:type rdf:Property ;
    rdfs:label 'Case Status' ;
    rdfs:comment 'Current workflow state of the producer onboarding case lifecycle from application intake through appointment activation or rejection.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractingEntity rdf:type rdf:Property ;
    rdfs:label 'Contracting Entity' ;
    rdfs:comment 'Legal name of the Pc_Insurance entity or subsidiary with which the producer agreement is being executed, relevant for multi-company carrier groups.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiDisciplinaryReviewDate rdf:type rdf:Property ;
    rdfs:label 'Doi Disciplinary Review Date' ;
    rdfs:comment 'Date the DOI disciplinary history and market-conduct review was completed for the producer applicant during the onboarding compliance process.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiDisciplinaryReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Doi Disciplinary Review Status' ;
    rdfs:comment 'Status of the review of DOI disciplinary actions, market-conduct orders, and license revocations against the producer across all appointment states.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eOCoverageVerified rdf:type rdf:Property ;
    rdfs:label 'E O Coverage Verified' ;
    rdfs:comment 'Indicates whether the producer\'s Errors and Omissions (E&O) professional liability insurance coverage has been verified as meeting Pc_Insurance minimum requirements.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eOPolicyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'E O Policy Expiry Date' ;
    rdfs:comment 'Expiration date of the producer\'s E&O professional liability policy, used to trigger renewal verification and prevent appointment lapses.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedAnnualPremiumVolume rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Premium Volume' ;
    rdfs:comment 'Producer\'s estimated annual gross written premium (GWP) volume to be placed with Pc_Insurance, used for capacity planning and commission tier assignment.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:licenseVerificationDate rdf:type rdf:Property ;
    rdfs:label 'License Verification Date' ;
    rdfs:comment 'Date on which the most recent producer license verification was completed against NIPR or state DOI records during the onboarding process.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'License Verification Status' ;
    rdfs:comment 'Current status of the producer license verification check performed via NIPR or state DOI systems to confirm active, valid licensure in all appointment states.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npn rdf:type rdf:Property ;
    rdfs:label 'Npn' ;
    rdfs:comment 'Unique National Producer Number assigned by NIPR/NAIC, used as the primary cross-state identifier for producer licensing and appointment verification.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreeningDate rdf:type rdf:Property ;
    rdfs:label 'Ofac Screening Date' ;
    rdfs:comment 'Date the OFAC and sanctions screening was last performed on the producer applicant, required for BSA/AML compliance documentation.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ofacScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Ofac Screening Status' ;
    rdfs:comment 'Result of the OFAC Specially Designated Nationals (SDN) and sanctions list screening performed on the producer applicant as required by BSA/AML compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCarrierLossRatio rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Loss Ratio' ;
    rdfs:comment 'Historical loss ratio (LR) reported by the producer from prior carrier relationships, used by UW to assess book quality during onboarding risk evaluation.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:producerAgreementType rdf:type rdf:Property ;
    rdfs:label 'Producer Agreement Type' ;
    rdfs:comment 'Type of producer agreement governing the relationship, determining commission schedules, binding authority, and regulatory obligations.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerDbaName rdf:type rdf:Property ;
    rdfs:label 'Producer Dba Name' ;
    rdfs:comment 'Trade or DBA name under which the producer operates, if different from the legal name. Required for agency and broker appointment filings.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerLegalName rdf:type rdf:Property ;
    rdfs:label 'Producer Legal Name' ;
    rdfs:comment 'Full legal name of the producer entity or individual as submitted on the onboarding application, used for DOI appointment filings and NAIC records.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerTaxNumber rdf:type rdf:Property ;
    rdfs:label 'Producer Tax Number' ;
    rdfs:comment 'Federal Employer Identification Number (FEIN) for agencies or Social Security Number (SSN) for individual producers, required for IRS 1099 commission reporting.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceNotes rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Notes' ;
    rdfs:comment 'Free-text field capturing compliance officer observations, state DOI correspondence notes, or market-conduct findings relevant to the onboarding case review.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'Standardized code indicating the primary reason an onboarding case was rejected, used for regulatory reporting and adverse action notification compliance.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonNotes rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Notes' ;
    rdfs:comment 'Free-text narrative providing additional detail on the reason for onboarding case rejection, supplementing the rejection reason code for underwriting and compliance review.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemActivationDate rdf:type rdf:Property ;
    rdfs:label 'System Activation Date' ;
    rdfs:comment 'Date the producer was activated in Pc_Insurance operational systems (PolicyCenter, BillingCenter) enabling quoting, binding, and commission processing.' ;
    rdfs:domain ind:OnboardingCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorAgreementProducerAgreementId rdf:type rdf:Property ;
    rdfs:label 'Prior Agreement Producer Agreement Id' ;
    rdfs:comment 'Reference to the predecessor producer agreement that this version supersedes, enabling version chain traversal for audit and compliance.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducerAgreement .

ind:auditRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Rights Flag' ;
    rdfs:comment 'Indicates whether Pc_Insurance retains the contractual right to audit the producer\'s books, records, and premium trust accounts under this agreement.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Indicates whether this producer agreement automatically renews for successive terms upon expiration unless either party provides written notice of non-renewal.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceTrainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Training Required Flag' ;
    rdfs:comment 'Indicates whether the producer must complete Pc_Insurance-mandated compliance and product training as a condition of maintaining active agreement status.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eAndOCoverageLimit rdf:type rdf:Property ;
    rdfs:label 'E And O Coverage Limit' ;
    rdfs:comment 'Minimum required Errors and Omissions (E&O) professional liability coverage limit in USD that the producer must maintain as a condition of this agreement.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eAndOExpirationDate rdf:type rdf:Property ;
    rdfs:label 'E And O Expiration Date' ;
    rdfs:comment 'Expiration date of the producer\'s current Errors and Omissions (E&O) insurance policy on file with Pc_Insurance for compliance monitoring.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eAndORequiredFlag rdf:type rdf:Property ;
    rdfs:label 'E And O Required Flag' ;
    rdfs:comment 'Indicates whether the producer is contractually required to maintain Errors and Omissions (E&O) professional liability insurance as a condition of this agreement.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusivityFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Flag' ;
    rdfs:comment 'Indicates whether the producer is contractually restricted from placing competing lines of business with other insurers for the LOBs covered by this agreement.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Date on which both parties signed and executed the producer agreement. May differ from effective_date if the agreement is backdated or post-dated.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insurerSignatoryName rdf:type rdf:Property ;
    rdfs:label 'Insurer Signatory Name' ;
    rdfs:comment 'Full name of the Pc_Insurance officer or authorized representative who executed this agreement on behalf of the company.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastComplianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Review Date' ;
    rdfs:comment 'Date of the most recent compliance review or market conduct audit conducted on this producer agreement by Pc_Insurance or a state regulator.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lobScope rdf:type rdf:Property ;
    rdfs:label 'Lob Scope' ;
    rdfs:comment 'Pipe-delimited list of Lines of Business (LOBs) the producer is authorized to write under this agreement, e.g., personal_auto|homeowners|commercial_gl|bop|wc.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncbEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Ncb Eligible Flag' ;
    rdfs:comment 'Indicates whether the producer\'s book of business qualifies for No Claims Bonus (NCB) incentive adjustments under the commission plan.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumTrustRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Trust Required Flag' ;
    rdfs:comment 'Indicates whether the producer is required to maintain a separate premium trust account for policyholder funds collected on behalf of Pc_Insurance.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumVolumeMinimum rdf:type rdf:Property ;
    rdfs:label 'Premium Volume Minimum' ;
    rdfs:comment 'Minimum annual Written Premium (WP) volume in USD the producer commits to place with Pc_Insurance to maintain agreement terms and avoid renegotiation.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumVolumeTarget rdf:type rdf:Property ;
    rdfs:label 'Premium Volume Target' ;
    rdfs:comment 'Annual Written Premium (WP) production target in USD agreed between Pc_Insurance and the producer for performance tracking and contingent commission qualification.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:producerSignatoryName rdf:type rdf:Property ;
    rdfs:label 'Producer Signatory Name' ;
    rdfs:comment 'Full legal name of the individual who executed this agreement on behalf of the producer or agency.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalTermMonths rdf:type rdf:Property ;
    rdfs:label 'Renewal Term Months' ;
    rdfs:comment 'Duration in months of each automatic renewal term when auto_renewal_flag is true. Typically 12 months for annual agreements.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:subProducerAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Sub Producer Allowed Flag' ;
    rdfs:comment 'Indicates whether the producer is permitted to appoint sub-producers or sub-agents under this agreement to solicit business on their behalf.' ;
    rdfs:domain ind:ProducerAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:territoryScope rdf:type rdf:Property ;
    rdfs:label 'Territory Scope' ;
    rdfs:comment 'Pipe-delimited list of US state codes or territories where the producer is authorized to solicit and bind business under this agreement, e.g., CA|TX|NY|FL.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerComplianceId rdf:type rdf:Property ;
    rdfs:label 'Producer Compliance Id' ;
    rdfs:comment 'Unique surrogate identifier for the producer compliance onboarding and monitoring case record within the Pc_Insurance producer management system.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceReviewerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Compliance Reviewer Producers Producer Id' ;
    rdfs:comment 'Identifier of the internal compliance officer or analyst assigned to review and adjudicate this producer compliance case. Links to the employee or user master record.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'Date on which the producer was formally activated and authorized to bind business on behalf of Pc_Insurance following successful completion of all compliance checks.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amlTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Aml Training Date' ;
    rdfs:comment 'Date on which the producer completed the most recent AML training course. Used to determine whether re-training is required based on the applicable refresh cycle.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:antiMoneyLaunderingTrained rdf:type rdf:Property ;
    rdfs:label 'Anti Money Laundering Trained' ;
    rdfs:comment 'Indicates whether the producer has completed mandatory AML training as required by FinCEN and NAIC guidelines. Required for appointment in certain lines of business.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appointedLobCodes rdf:type rdf:Property ;
    rdfs:label 'Appointed Lob Codes' ;
    rdfs:comment 'Comma-separated list of NAIC line of business codes for which the producer is authorized to sell under this compliance case (e.g., 04=Fire, 05=Allied Lines, 17=CGL).' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentEligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Eligibility Status' ;
    rdfs:comment 'Overall eligibility determination for producer appointment based on the aggregate outcome of all compliance checks. Drives the final activation decision in the producer management system.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckReference rdf:type rdf:Property ;
    rdfs:label 'Background Check Reference' ;
    rdfs:comment 'Vendor-assigned reference or order number for the background check transaction. Used to retrieve detailed results from the screening vendor portal.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckVendor rdf:type rdf:Property ;
    rdfs:label 'Background Check Vendor' ;
    rdfs:comment 'Name of the third-party screening vendor that performed the background check (e.g., Sterling, First Advantage). Used for vendor management and audit trail.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseCloseDate rdf:type rdf:Property ;
    rdfs:label 'Case Close Date' ;
    rdfs:comment 'Calendar date on which the compliance case reached final disposition (approved, rejected, or closed). Null if the case is still open.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseOpenDate rdf:type rdf:Property ;
    rdfs:label 'Case Open Date' ;
    rdfs:comment 'Calendar date on which the compliance case was formally opened and submitted for review. Serves as the start anchor for SLA and regulatory turnaround tracking.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseType rdf:type rdf:Property ;
    rdfs:label 'Case Type' ;
    rdfs:comment 'Categorizes the nature of the compliance case: initial producer appointment, license renewal, reinstatement after lapse, disciplinary review, or periodic audit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceCreditHoursVerified rdf:type rdf:Property ;
    rdfs:label 'Ce Credit Hours Verified' ;
    rdfs:comment 'Number of continuing education credit hours confirmed as completed by the producer for the current license period. Compared against state-mandated minimums.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Free-text field for compliance officer annotations, escalation notes, or exception documentation related to this producer compliance case. Restricted to authorized compliance staff.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingEducationCompliant rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Compliant' ;
    rdfs:comment 'Indicates whether the producer has met all state-mandated continuing education (CE) credit hour requirements for the current license period as verified through NIPR or state DOI.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doiDisciplinaryDetail rdf:type rdf:Property ;
    rdfs:label 'Doi Disciplinary Detail' ;
    rdfs:comment 'Summary description of DOI disciplinary orders or regulatory actions against the producer, including state, order type, and effective date. Populated when doi_disciplinary_flag is true.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doiDisciplinaryFlag rdf:type rdf:Property ;
    rdfs:label 'Doi Disciplinary Flag' ;
    rdfs:comment 'Indicates whether the producer has any active or historical disciplinary orders on record with any state Department of Insurance. True triggers mandatory compliance review.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doiDisciplinaryOrderDate rdf:type rdf:Property ;
    rdfs:label 'Doi Disciplinary Order Date' ;
    rdfs:comment 'Date of the most recent DOI disciplinary order or regulatory action recorded against the producer. Used to assess recency and severity of compliance risk.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eOExpirationDate rdf:type rdf:Property ;
    rdfs:label 'E O Expiration Date' ;
    rdfs:comment 'Expiration date of the producer\'s E&O professional liability insurance policy. Triggers renewal alert workflow when within 60 days of expiry.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eOPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'E O Policy Number' ;
    rdfs:comment 'Policy number of the producer\'s active E&O professional liability insurance policy. Required for appointment and verified during onboarding compliance review.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ineligibilityReason rdf:type rdf:Property ;
    rdfs:label 'Ineligibility Reason' ;
    rdfs:comment 'Free-text explanation of why the producer was determined ineligible for appointment. Populated when appointment_eligibility_status is ineligible or conditional.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketConductFindingDetail rdf:type rdf:Property ;
    rdfs:label 'Market Conduct Finding Detail' ;
    rdfs:comment 'Narrative description of market conduct examination findings associated with the producer, including the examining state and finding category. Populated when flag is true.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketConductFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Market Conduct Finding Flag' ;
    rdfs:comment 'Indicates whether the producer has been cited in a state market conduct examination finding. True requires review by the compliance officer before appointment approval.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next periodic compliance review of this producer, based on risk tier, license renewal cycle, or regulatory requirement. Drives automated review scheduling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:niprTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Nipr Transaction Number' ;
    rdfs:comment 'Transaction identifier returned by NIPR when the appointment or license verification request was submitted. Used to reconcile NIPR responses with internal compliance records.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacMatchDetail rdf:type rdf:Property ;
    rdfs:label 'Ofac Match Detail' ;
    rdfs:comment 'Descriptive detail of any OFAC match found during screening, including the matched list name and match score. Populated only when ofac_screening_status is match_found or escalated.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Review Completed Date' ;
    rdfs:comment 'Date on which the assigned compliance reviewer completed their assessment of all checks and rendered an appointment eligibility determination for this case.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateAppointmentFiled rdf:type rdf:Property ;
    rdfs:label 'State Appointment Filed' ;
    rdfs:comment 'Indicates whether the formal producer appointment has been filed with the applicable state DOI through NIPR. Required in states that mandate company-filed appointments.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateAppointmentFiledDate rdf:type rdf:Property ;
    rdfs:label 'State Appointment Filed Date' ;
    rdfs:comment 'Date on which the producer appointment was filed with the state DOI via NIPR. Populated only when state_appointment_filed is true.' ;
    rdfs:domain ind:ProducerCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:producerLicenseId rdf:type rdf:Property ;
    rdfs:label 'Producer License Id' ;
    rdfs:comment 'Unique surrogate identifier for a producer license record in the Pc_Insurance data platform. Primary key for the producer_license entity.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appointmentRequired rdf:type rdf:Property ;
    rdfs:label 'Appointment Required' ;
    rdfs:comment 'Indicates whether the issuing state requires a formal carrier appointment in addition to this license before the producer may transact business on behalf of Pc_Insurance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ceComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ce Compliance Status' ;
    rdfs:comment 'Current compliance status of the producer with respect to continuing education (CE) requirements for this license. Drives renewal eligibility and compliance alerts.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingEducationRequired rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Required' ;
    rdfs:comment 'Indicates whether the issuing state requires the producer to complete continuing education (CE) credits as a condition of license renewal for this line of authority.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doiLastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Doi Last Verified Date' ;
    rdfs:comment 'Date on which this license record was last verified against the issuing state DOI or NIPR registry. Used to ensure data currency for compliance and appointment management.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Doi Verification Status' ;
    rdfs:comment 'Status of the license verification against the issuing state Department of Insurance (DOI) records or NIPR. Flags discrepancies between internal records and official DOI data.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inactivationDate rdf:type rdf:Property ;
    rdfs:label 'Inactivation Date' ;
    rdfs:comment 'Date on which this license record was marked inactive in Pc_Insurance systems due to expiration, revocation, or voluntary surrender. Null if the license remains active.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseType rdf:type rdf:Property ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Classifies the license as individual, business entity, surplus lines, adjuster, or other category as defined by the issuing state DOI. [ENUM-REF-CANDIDATE: individual|business_entity|surplus_lines|adjuster|public_adjuster|managing_general_agent — promote' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineOfAuthority rdf:type rdf:Property ;
    rdfs:label 'Line Of Authority' ;
    rdfs:comment 'Specific line of authority granted by the DOI under this license (e.g., Property, Casualty, Life, Health, Personal Lines, Commercial Lines). Determines which products the producer may sell.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryActionDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Date' ;
    rdfs:comment 'Date of the most recent regulatory action taken against this producer license by the issuing state DOI. Null if no regulatory action has occurred.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryActionDescription rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Description' ;
    rdfs:comment 'Free-text description of the regulatory action taken against this producer license, including the nature of the violation and the DOI order or consent decree reference.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryActionIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Indicator' ;
    rdfs:comment 'Indicates whether any regulatory action (e.g., suspension, revocation, fine, consent order) has been taken against this producer license by the issuing state DOI.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Date on which the producer last successfully renewed this license with the issuing state DOI. Null if the license has never been renewed since original issuance.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:residentNonresidentIndicator rdf:type rdf:Property ;
    rdfs:label 'Resident Nonresident Indicator' ;
    rdfs:comment 'Indicates whether this license is a resident license (producer domiciled in the issuing state) or a non-resident license (producer licensed in another home state).' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemLicenseCode rdf:type rdf:Property ;
    rdfs:label 'Source System License Code' ;
    rdfs:comment 'Native identifier for this license record in the originating operational system (e.g., AgentSync license record ID or Vertafore Sircon record key). Supports data lineage and reconciliation.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesEligible rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Eligible' ;
    rdfs:comment 'Indicates whether this license authorizes the producer to place business with non-admitted surplus lines carriers in the issuing state jurisdiction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surplusLinesLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines License Number' ;
    rdfs:comment 'Separate surplus lines license number issued by the state DOI when the producer is authorized to place non-admitted surplus lines business. Null if not applicable.' ;
    rdfs:domain ind:ProducerLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amlCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Aml Certification Date' ;
    rdfs:comment 'Date on which the producer completed the most recent AML training certification. Used to track certification currency and trigger renewal reminders.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:antiMoneyLaunderingCertified rdf:type rdf:Property ;
    rdfs:label 'Anti Money Laundering Certified' ;
    rdfs:comment 'Indicates whether the producer has completed required Anti-Money Laundering (AML) training certification. Mandatory for producers handling certain commercial and high-value personal lines.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessAddressCity rdf:type rdf:Property ;
    rdfs:label 'Business Address City' ;
    rdfs:comment 'City of the producer\'s principal place of business address.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAddressState rdf:type rdf:Property ;
    rdfs:label 'Business Address State' ;
    rdfs:comment 'Two-letter USPS state code for the producer\'s principal place of business. Used for state-level regulatory filings and geographic distribution analytics.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAddressZip rdf:type rdf:Property ;
    rdfs:label 'Business Address Zip' ;
    rdfs:comment 'US ZIP or ZIP+4 postal code for the producer\'s principal place of business. Used for geographic territory assignment and regulatory jurisdiction determination.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessEmail rdf:type rdf:Property ;
    rdfs:label 'Business Email' ;
    rdfs:comment 'Primary business email address for the producer. Used for policy documents, commission statements, regulatory notices, and system-generated alerts from PolicyCenter or Duck Creek.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessPhone rdf:type rdf:Property ;
    rdfs:label 'Business Phone' ;
    rdfs:comment 'Primary business telephone number for the producer\'s office. Used for underwriting communication, claims coordination, and regulatory correspondence.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eAndOCarrier rdf:type rdf:Property ;
    rdfs:label 'E And O Carrier' ;
    rdfs:comment 'Name of the insurance carrier providing the producer\'s Errors and Omissions (E&O) professional liability coverage. Carrier requires active E&O as a condition of appointment.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eAndOLimitAmount rdf:type rdf:Property ;
    rdfs:label 'E And O Limit Amount' ;
    rdfs:comment 'Per-occurrence coverage limit of the producer\'s E&O professional liability policy in USD. Carrier may require a minimum limit as a condition of appointment for certain LOBs.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eAndOPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'E And O Policy Number' ;
    rdfs:comment 'Policy number of the producer\'s active E&O professional liability insurance. Tracked to verify continuous coverage as a condition of maintaining carrier appointment.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseClass rdf:type rdf:Property ;
    rdfs:label 'License Class' ;
    rdfs:comment 'Classification of the producer\'s license type as defined by the domicile state DOI (e.g., Property, Casualty, Personal Lines, Commercial Lines, Life, Accident & Health).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:linesOfAuthority rdf:type rdf:Property ;
    rdfs:label 'Lines Of Authority' ;
    rdfs:comment 'Pipe-delimited list of lines of authority (LOA) for which the producer is licensed and appointed (e.g., Property|Casualty|Personal Lines). Governs which LOBs the producer may solicit.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managingGeneralAgentCode rdf:type rdf:Property ;
    rdfs:label 'Managing General Agent Code' ;
    rdfs:comment 'Code identifying the Managing General Agent (MGA) or wholesale broker through whom this producer accesses the carrier\'s products, if applicable. Used for MGA commission override calculations.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLob rdf:type rdf:Property ;
    rdfs:label 'Preferred Lob' ;
    rdfs:comment 'Primary line of business (LOB) in which the producer specializes or generates the majority of written premium (e.g., Personal Auto, Homeowners, Commercial GL, BOP, WC). Used for territory and product alignment.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnLast4 rdf:type rdf:Property ;
    rdfs:label 'Ssn Last4' ;
    rdfs:comment 'Last four digits of the individual producer\'s SSN retained for identity verification and 1099 tax reporting. Full SSN must not be stored per PCI DSS and NIST SP 800-122 data minimization.' ;
    rdfs:domain ind:ProducersProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationId rdf:type rdf:Property ;
    rdfs:label 'Termination Id' ;
    rdfs:comment 'Unique surrogate identifier for a producer appointment or agreement termination record in the Producer Management and Licensing System.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:terminationProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Termination Producers Producer Id' ;
    rdfs:comment 'Reference to the producer (agent or broker) whose appointment or agreement is being terminated.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:terminationSuccessorProducerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Termination Successor Producer Producers Producer Id' ;
    rdfs:comment 'Reference to the producer appointed to service the terminated producer\'s book of business following the termination.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:bookOfBusinessTransferDate rdf:type rdf:Property ;
    rdfs:label 'Book Of Business Transfer Date' ;
    rdfs:comment 'Date on which the terminated producer\'s book of business was fully transferred to the successor producer or insurer servicing team.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bookOfBusinessTransferStatus rdf:type rdf:Property ;
    rdfs:label 'Book Of Business Transfer Status' ;
    rdfs:comment 'Status of the transfer of the terminated producer\'s book of business (policies) to another appointed producer or to the insurer\'s direct servicing team.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Commission Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the pending commission amount (e.g., USD). Supports multi-currency operations for international entities.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSettlementStatus rdf:type rdf:Property ;
    rdfs:label 'Commission Settlement Status' ;
    rdfs:comment 'Status of the final commission settlement process following termination, tracking whether outstanding commissions have been paid, disputed, or written off.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contestOutcome rdf:type rdf:Property ;
    rdfs:label 'Contest Outcome' ;
    rdfs:comment 'Result of the producer\'s formal contest or appeal of the termination decision.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contestResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Contest Resolution Date' ;
    rdfs:comment 'Date on which a contested termination was resolved, either upholding the termination or reinstating the appointment. Null if not contested or unresolved.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eAndOCoverageExpiryDate rdf:type rdf:Property ;
    rdfs:label 'E And O Coverage Expiry Date' ;
    rdfs:comment 'Date on which the producer\'s Errors and Omissions (E&O) professional liability coverage expires post-termination, relevant for tail coverage obligations.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:initiatedByParty rdf:type rdf:Property ;
    rdfs:label 'Initiated By Party' ;
    rdfs:comment 'Identifies which party initiated the termination: the insurer, the producer, a regulatory authority, or by mutual agreement.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Notes' ;
    rdfs:comment 'Confidential internal notes recorded by underwriting or compliance staff regarding the circumstances of the termination, not shared externally.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isContested rdf:type rdf:Property ;
    rdfs:label 'Is Contested' ;
    rdfs:comment 'Indicates whether the producer has formally contested or appealed the termination, triggering a dispute resolution or regulatory review process.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isForCause rdf:type rdf:Property ;
    rdfs:label 'Is For Cause' ;
    rdfs:comment 'Indicates whether the termination is for cause (e.g., fraud, misrepresentation, license violation), triggering mandatory state regulatory reporting obligations.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryReportable rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Reportable' ;
    rdfs:comment 'Indicates whether this termination must be reported to the state Department of Insurance (DOI) or NAIC within the mandated reporting window.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pendingCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Pending Commission Amount' ;
    rdfs:comment 'Total commission amount owed to the producer at the time of termination that remains unpaid, subject to final settlement per the agency agreement terms.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportDueDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Due Date' ;
    rdfs:comment 'Deadline by which the termination must be reported to the applicable state DOI or NAIC, typically 30 days from the effective date per state statute.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Status' ;
    rdfs:comment 'Current status of the regulatory termination notification filing with the state DOI or NAIC, tracking compliance with mandatory reporting requirements.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Submitted Date' ;
    rdfs:comment 'Actual date on which the termination notification was submitted to the state DOI or NAIC, used to confirm timely compliance with reporting obligations.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementEligible rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible' ;
    rdfs:comment 'Indicates whether the terminated producer is eligible for future reinstatement of their appointment, based on the termination reason and regulatory standing.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible Date' ;
    rdfs:comment 'Earliest date on which the terminated producer may apply for reinstatement of their appointment, if applicable under state regulation or contract terms.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rescissionDate rdf:type rdf:Property ;
    rdfs:label 'Rescission Date' ;
    rdfs:comment 'Date on which a previously issued termination was rescinded or reversed, restoring the producer appointment. Null if the termination was not rescinded.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'State Notification Required' ;
    rdfs:comment 'Indicates whether the terminating state requires a formal notification filing with the DOI, distinct from the broader regulatory reportable flag.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationStatus rdf:type rdf:Property ;
    rdfs:label 'Termination Status' ;
    rdfs:comment 'Current workflow state of the termination action, tracking progress from initiation through regulatory confirmation or rescission.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationType rdf:type rdf:Property ;
    rdfs:label 'Termination Type' ;
    rdfs:comment 'Classifies the nature of the termination. [ENUM-REF-CANDIDATE: voluntary|involuntary|non_renewal|mutual_agreement|regulatory_action|death_disability — promote to reference product]' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryId rdf:type rdf:Property ;
    rdfs:label 'Territory Id' ;
    rdfs:comment 'Unique identifier for the territory data product (auto-inserted during validation).' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catZoneCode rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Code' ;
    rdfs:comment 'Designated Catastrophe (CAT) zone code (e.g., hurricane tier, earthquake zone, wildfire risk zone) assigned to this territory for PML and reinsurance purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelCode rdf:type rdf:Property ;
    rdfs:label 'Channel Code' ;
    rdfs:comment 'Distribution channel through which business is written in this territory: independent agent, captive agent, broker, direct, or Managing General Agent (MGA).' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictPriority rdf:type rdf:Property ;
    rdfs:label 'Conflict Priority' ;
    rdfs:comment 'Integer priority rank used to resolve overlapping territory assignments for the same geography and LOB. Lower value indicates higher precedence.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:countyFipsCode rdf:type rdf:Property ;
    rdfs:label 'County Fips Code' ;
    rdfs:comment 'Five-digit Federal Information Processing Standards (FIPS) county code scoping the territory to a specific county within the state.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionCode rdf:type rdf:Property ;
    rdfs:label 'Division Code' ;
    rdfs:comment 'Internal division code (e.g., personal lines, commercial lines, specialty) used for production roll-up and P&L reporting in Oracle Financials GL.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCatExposed rdf:type rdf:Property ;
    rdfs:label 'Is Cat Exposed' ;
    rdfs:comment 'Flags whether the territory falls within a designated Catastrophe (CAT) zone (e.g., hurricane, earthquake, wildfire), triggering underwriting restrictions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isExclusive rdf:type rdf:Property ;
    rdfs:label 'Is Exclusive' ;
    rdfs:comment 'Indicates whether the producer holds exclusive rights to solicit and bind business within this territory, preventing appointment of competing producers.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Iso Territory Code' ;
    rdfs:comment 'Insurance Services Office (ISO) / Verisk territory code used for rate filings, loss cost multipliers, and actuarial territory relativities.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketSegment rdf:type rdf:Property ;
    rdfs:label 'Market Segment' ;
    rdfs:comment 'Broad market segment classification for the territory: personal lines, commercial lines, specialty, or excess and surplus (E&S) lines.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxTiv rdf:type rdf:Property ;
    rdfs:label 'Max Tiv' ;
    rdfs:comment 'Maximum aggregate Total Insured Value (TIV) the producer is authorized to bind within this territory, enforcing capacity and concentration limits.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:msaCode rdf:type rdf:Property ;
    rdfs:label 'Msa Code' ;
    rdfs:comment 'US Census Bureau Metropolitan Statistical Area (MSA) code when the territory is scoped to an MSA rather than individual counties or ZIP codes.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Naic Territory Code' ;
    rdfs:comment 'National Association of Insurance Commissioners (NAIC) territory code used in statutory reporting and state rate filings.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryName rdf:type rdf:Property ;
    rdfs:label 'Territory Name' ;
    rdfs:comment 'Human-readable name of the territory (e.g., \'Northeast Commercial\', \'Gulf Coast Personal Lines\') used in producer portals and management reports.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newBusinessAllowed rdf:type rdf:Property ;
    rdfs:label 'New Business Allowed' ;
    rdfs:comment 'Indicates whether the producer is permitted to write New Business (NB) in this territory. May be restricted during CAT moratoriums or UW suspensions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ratingTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Rating Territory Code' ;
    rdfs:comment 'Internal rating territory code used by the policy rating engine (Guidewire PolicyCenter / Duck Creek Rating) to apply territory-specific rate factors.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionCode rdf:type rdf:Property ;
    rdfs:label 'Region Code' ;
    rdfs:comment 'Internal regional grouping code (e.g., NE, SE, MW, SW, W) used for production roll-up reporting and regional management oversight.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalAllowed rdf:type rdf:Property ;
    rdfs:label 'Renewal Allowed' ;
    rdfs:comment 'Indicates whether policy renewals (REN) are permitted within this territory. May differ from new business authority during non-renewal orders.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:territoryStatus rdf:type rdf:Property ;
    rdfs:label 'Territory Status' ;
    rdfs:comment 'Current lifecycle state of the territory assignment. Controls whether the producer may bind new business within the defined geographic scope.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryType rdf:type rdf:Property ;
    rdfs:label 'Territory Type' ;
    rdfs:comment 'Classification of the territory assignment indicating exclusivity and access rights granted to the producer. Drives conflict resolution and appointment rules.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwRestrictionCode rdf:type rdf:Property ;
    rdfs:label 'Uw Restriction Code' ;
    rdfs:comment 'Current underwriting (UW) restriction level applied to this territory. Drives policy binding authority and referral requirements in PolicyCenter.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenPremiumTarget rdf:type rdf:Property ;
    rdfs:label 'Written Premium Target' ;
    rdfs:comment 'Annual Written Premium (WP) production target assigned to the producer for this territory, used in performance tracking and commission tier calculations.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zipCodeEnd rdf:type rdf:Property ;
    rdfs:label 'Zip Code End' ;
    rdfs:comment 'Ending ZIP code of the contiguous ZIP-code range defining the geographic boundary of this territory assignment.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipCodeStart rdf:type rdf:Property ;
    rdfs:label 'Zip Code Start' ;
    rdfs:comment 'Starting ZIP code of the contiguous ZIP-code range defining the geographic boundary of this territory assignment.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bordereauxId rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Id' ;
    rdfs:comment 'Unique surrogate identifier for the bordereaux submission record in the reinsurance management system.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bordereaux .

ind:facCertificateId rdf:type rdf:Property ;
    rdfs:label 'Fac Certificate Id' ;
    rdfs:comment 'Foreign key linking to reinsurance.fac_certificate. Business justification: Bordereaux submissions can be for FAC certificates, not just treaties. Currently only has treaty_id. Missing FK for FAC bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacCertificate .

ind:priorBordereauxId rdf:type rdf:Property ;
    rdfs:label 'Prior Bordereaux Id' ;
    rdfs:comment 'Reference to the previous version of this bordereaux that was superseded by the current corrected or amended submission.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bordereaux .

ind:reinsurerId rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Id' ;
    rdfs:comment 'Reference to the reinsurer party receiving this bordereaux submission.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reinsurer .

ind:acknowledgementDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Date' ;
    rdfs:comment 'Date on which the reinsurer formally acknowledged receipt and acceptance of the bordereaux submission.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizedReinsurerFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Reinsurer Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is authorized or accredited in the cedant\'s domicile state, affecting credit for reinsurance on statutory balance sheet.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bordereauxType rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Type' ;
    rdfs:comment 'Classifies the bordereaux as a premium bordereaux (ceded premium activity), loss bordereaux (ceded loss activity), combined, or adjustment.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catEventCode rdf:type rdf:Property ;
    rdfs:label 'Cat Event Code' ;
    rdfs:comment 'Industry or internal CAT event code (e.g., ISO PCS code) identifying a catastrophe event included in this loss bordereaux.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Alae Amount' ;
    rdfs:comment 'Allocated Loss Adjustment Expense (ALAE) ceded to the reinsurer for the reporting period, recoverable under treaty terms.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededIbnrAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Ibnr Amount' ;
    rdfs:comment 'Ceded portion of the Incurred But Not Reported (IBNR) reserve included in this bordereaux for the reporting period.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Amount' ;
    rdfs:comment 'Total paid and outstanding ceded loss amount recoverable from the reinsurer for the reporting period.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPremiumAdjustment rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Adjustment' ;
    rdfs:comment 'Adjustment to ceded premium arising from endorsements, cancellations, or audit premiums included in this bordereaux period.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededSharePct rdf:type rdf:Property ;
    rdfs:label 'Ceded Share Pct' ;
    rdfs:comment 'Percentage of risk ceded to the reinsurer under the treaty for this bordereaux period, expressed as a decimal (e.g., 0.3000 = 30%).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededTiv rdf:type rdf:Property ;
    rdfs:label 'Ceded Tiv' ;
    rdfs:comment 'Aggregate Total Insured Value (TIV) of risks ceded to the reinsurer under this bordereaux for the reporting period.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededUlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Ulae Amount' ;
    rdfs:comment 'Unallocated Loss Adjustment Expense (ULAE) ceded to the reinsurer for the reporting period where treaty terms permit recovery.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Amount' ;
    rdfs:comment 'Total ceding commission earned by the cedant on ceded premium for the reporting period, reducing net ceded premium payable.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCount rdf:type rdf:Property ;
    rdfs:label 'Claim Count' ;
    rdfs:comment 'Number of individual claims included in this loss bordereaux submission for the reporting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:experienceRefundAmount rdf:type rdf:Property ;
    rdfs:label 'Experience Refund Amount' ;
    rdfs:comment 'Experience refund or sliding scale commission adjustment payable under the treaty based on loss experience for the period.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossCededPremium rdf:type rdf:Property ;
    rdfs:label 'Gross Ceded Premium' ;
    rdfs:comment 'Total gross written premium ceded to the reinsurer for the reporting period before deduction of ceding commission.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCededPremium rdf:type rdf:Property ;
    rdfs:label 'Net Ceded Premium' ;
    rdfs:comment 'Net premium ceded to the reinsurer after deducting ceding commission from gross ceded premium for the reporting period.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementBroker rdf:type rdf:Property ;
    rdfs:label 'Placement Broker' ;
    rdfs:comment 'Name of the reinsurance intermediary or broker who placed the treaty and through whom the bordereaux may be routed.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Amount' ;
    rdfs:comment 'Profit commission payable to the cedant by the reinsurer based on treaty profitability for the reporting period.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoverableBalance rdf:type rdf:Property ;
    rdfs:label 'Recoverable Balance' ;
    rdfs:comment 'Net outstanding reinsurance recoverable balance owed by the reinsurer as of the bordereaux reporting period end date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remarks rdf:type rdf:Property ;
    rdfs:label 'Remarks' ;
    rdfs:comment 'Free-text remarks or notes accompanying the bordereaux submission, such as explanations for adjustments or disputed items.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'Last day of the treaty period or accounting period covered by this bordereaux submission.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'First day of the treaty period or accounting period covered by this bordereaux submission.' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retentionAmount rdf:type rdf:Property ;
    rdfs:label 'Retention Amount' ;
    rdfs:comment 'Cedant net retention amount for the reporting period, representing the portion of risk not ceded to the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submissionFormat rdf:type rdf:Property ;
    rdfs:label 'Submission Format' ;
    rdfs:comment 'File or data format in which the bordereaux was submitted to the reinsurer (e.g., ACORD standard, CSV, XML, XLSX, PDF).' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'Channel or method used to transmit the bordereaux to the reinsurer (electronic data interchange, reinsurer portal, email, or paper).' ;
    rdfs:domain ind:Bordereaux ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyType rdf:type rdf:Property ;
    rdfs:label 'Treaty Type' ;
    rdfs:comment 'Type of reinsurance arrangement covered by this bordereaux: Quota Share (QS), Excess of Loss (XOL), Catastrophe Excess of Loss (CAT XL), surplus, or Facultative (FAC).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyYear rdf:type rdf:Property ;
    rdfs:label 'Treaty Year' ;
    rdfs:comment 'Underwriting or treaty year to which this bordereaux relates, used for year-of-account tracking and statutory reporting.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bordereauxLineId rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Line Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual line item within a bordereaux submission. Primary key for the bordereaux_line entity.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsuranceCessionId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Id' ;
    rdfs:comment 'Foreign key linking to reinsurance.cession. Business justification: Each bordereaux line reports a specific cession. Missing the cession FK that links bordereaux line items back to the cession being reported.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReinsuranceCession .

ind:cededEarnedPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Earned Premium' ;
    rdfs:comment 'The portion of earned premium ceded to the reinsurer for this bordereaux line, representing the time-proportionate share of ceded written premium.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Limit Amount' ;
    rdfs:comment 'The maximum reinsurance recovery limit applicable to this cession line under the treaty or FAC certificate.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Written Premium' ;
    rdfs:comment 'The portion of written premium ceded to the reinsurer for this bordereaux line, calculated as GWP multiplied by the ceded share percentage.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Pct' ;
    rdfs:comment 'The commission rate payable by the reinsurer to the cedant on ceded premium for this line, expressed as a decimal (e.g., 0.2500 = 25%).' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'The externally-known facultative certificate number carried on the line for FAC bordereaux reconciliation. Null for treaty lines.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageType rdf:type rdf:Property ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'The specific coverage type ceded on this line (e.g., BI, PD, UM, UIM, PIP, MedPay, GL, WC). Aligns to the coverage part of the underlying policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateOfLoss rdf:type rdf:Property ;
    rdfs:label 'Date Of Loss' ;
    rdfs:comment 'The date on which the insured loss event occurred. Populated for claim-type bordereaux lines; null for premium-only lines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Gross Written Premium' ;
    rdfs:comment 'The total gross written premium on the underlying cedant policy for this bordereaux line before any cession.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number within the bordereaux submission, used for ordering and reconciliation of individual cession or claim entries.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current processing status of this bordereaux line in the reconciliation workflow between cedant and reinsurer.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineType rdf:type rdf:Property ;
    rdfs:label 'Line Type' ;
    rdfs:comment 'Classifies the nature of the bordereaux line: premium cession, claim loss, adjustment, reinstatement premium, or return premium.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalTiv rdf:type rdf:Property ;
    rdfs:label 'Original Tiv' ;
    rdfs:comment 'Total Insured Value of the underlying risk exposure on the cedant policy for this bordereaux line, used for proportional share calculations.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Policy Expiry Date' ;
    rdfs:comment 'The expiration date of the underlying cedant policy associated with this bordereaux line.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Policy Inception Date' ;
    rdfs:comment 'The effective start date of the underlying cedant policy associated with this bordereaux line.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Amount' ;
    rdfs:comment 'Premium charged to reinstate the reinsurance limit after a loss occurrence under XOL or CAT XL treaties. Populated for reinstatement-type lines only.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Report Period End Date' ;
    rdfs:comment 'End date of the reporting period covered by this bordereaux line, used for earned premium and loss period attribution.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Report Period Start Date' ;
    rdfs:comment 'Start date of the reporting period covered by this bordereaux line, used for earned premium and loss period attribution.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Description' ;
    rdfs:comment 'Narrative description of the insured risk or exposure associated with this bordereaux line, as reported to the reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Risk Expiry Date' ;
    rdfs:comment 'The date on which the ceded risk exposure terminates under the reinsurance treaty or FAC certificate for this line.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Risk Inception Date' ;
    rdfs:comment 'The date on which the ceded risk exposure commenced under the reinsurance treaty or FAC certificate for this line.' ;
    rdfs:domain ind:BordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:xolExhaustionPoint rdf:type rdf:Property ;
    rdfs:label 'Xol Exhaustion Point' ;
    rdfs:comment 'The loss level at which the XOL reinsurance layer is fully exhausted for this bordereaux line. Null for quota share or non-XOL treaty lines.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catBondId rdf:type rdf:Property ;
    rdfs:label 'Cat Bond Id' ;
    rdfs:comment 'Unique identifier for the catastrophe bond instrument record.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aggregateLimitFlag rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Flag' ;
    rdfs:comment 'Indicates whether the catastrophe bond has an aggregate loss limit across multiple events.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Attachment Point' ;
    rdfs:comment 'Loss threshold amount at which the catastrophe bond begins to provide coverage and principal may be at risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basisRiskDescription rdf:type rdf:Property ;
    rdfs:label 'Basis Risk Description' ;
    rdfs:comment 'Description of potential basis risk where the trigger mechanism may not perfectly correlate with actual losses incurred by the sponsor.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondName rdf:type rdf:Property ;
    rdfs:label 'Bond Name' ;
    rdfs:comment 'Marketing or legal name of the catastrophe bond issuance.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondNumber rdf:type rdf:Property ;
    rdfs:label 'Bond Number' ;
    rdfs:comment 'Externally-known unique identifier or CUSIP for the catastrophe bond instrument.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondRating rdf:type rdf:Property ;
    rdfs:label 'Bond Rating' ;
    rdfs:comment 'Credit rating assigned to the catastrophe bond by the rating agency.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondStatus rdf:type rdf:Property ;
    rdfs:label 'Bond Status' ;
    rdfs:comment 'Current lifecycle status of the catastrophe bond instrument.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catEventDefinition rdf:type rdf:Property ;
    rdfs:label 'Cat Event Definition' ;
    rdfs:comment 'Detailed definition of what constitutes a triggering catastrophe event including magnitude, location, and measurement criteria.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponFrequency rdf:type rdf:Property ;
    rdfs:label 'Coupon Frequency' ;
    rdfs:comment 'Frequency at which coupon interest payments are made to catastrophe bond investors.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponRatePct rdf:type rdf:Property ;
    rdfs:label 'Coupon Rate Pct' ;
    rdfs:comment 'Annual interest rate paid to catastrophe bond investors, expressed as a decimal percentage.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exhaustionPoint rdf:type rdf:Property ;
    rdfs:label 'Exhaustion Point' ;
    rdfs:comment 'Loss amount at which the catastrophe bond coverage is fully exhausted and maximum principal loss occurs.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedLossPct rdf:type rdf:Property ;
    rdfs:label 'Expected Loss Pct' ;
    rdfs:comment 'Modeled expected annual loss as a percentage of the notional amount, representing the probability-weighted average loss.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuanceDate rdf:type rdf:Property ;
    rdfs:label 'Issuance Date' ;
    rdfs:comment 'Date when the catastrophe bond was issued and became effective.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maturityDate rdf:type rdf:Property ;
    rdfs:label 'Maturity Date' ;
    rdfs:comment 'Date when the catastrophe bond principal is scheduled to be repaid if no trigger event occurs.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modelingFirm rdf:type rdf:Property ;
    rdfs:label 'Modeling Firm' ;
    rdfs:comment 'Name of the catastrophe risk modeling firm used to assess and price the bond, such as RMS, AIR Worldwide, CoreLogic.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiEventFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Event Flag' ;
    rdfs:comment 'Indicates whether the catastrophe bond can be triggered by multiple separate catastrophe events during its term.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notionalAmount rdf:type rdf:Property ;
    rdfs:label 'Notional Amount' ;
    rdfs:comment 'Original principal amount of the catastrophe bond at issuance.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingNotional rdf:type rdf:Property ;
    rdfs:label 'Outstanding Notional' ;
    rdfs:comment 'Current outstanding principal amount of the catastrophe bond after any trigger events or partial redemptions.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perilsCovered rdf:type rdf:Property ;
    rdfs:label 'Perils Covered' ;
    rdfs:comment 'Comma-separated list of catastrophic perils covered by the bond such as hurricane, earthquake, windstorm, flood, wildfire.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalReductionAmount rdf:type rdf:Property ;
    rdfs:label 'Principal Reduction Amount' ;
    rdfs:comment 'Amount of principal reduced or forgiven due to a trigger event occurring.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingAgency rdf:type rdf:Property ;
    rdfs:label 'Rating Agency' ;
    rdfs:comment 'Name of the credit rating agency that rated the catastrophe bond, such as A.M. Best, S&P, Moodys, Fitch.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Provision Flag' ;
    rdfs:comment 'Indicates whether the catastrophe bond includes provisions for reinstatement of coverage after a trigger event.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorName rdf:type rdf:Property ;
    rdfs:label 'Sponsor Name' ;
    rdfs:comment 'Name of the insurance or reinsurance company sponsoring the catastrophe bond issuance.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spvDomicile rdf:type rdf:Property ;
    rdfs:label 'Spv Domicile' ;
    rdfs:comment 'Three-letter country code of the jurisdiction where the special purpose vehicle is domiciled.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spvName rdf:type rdf:Property ;
    rdfs:label 'Spv Name' ;
    rdfs:comment 'Legal name of the special purpose vehicle entity that issued the catastrophe bond.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spvRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Spv Registration Number' ;
    rdfs:comment 'Official registration or incorporation number of the special purpose vehicle with its domicile authority.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerEventCode rdf:type rdf:Property ;
    rdfs:label 'Trigger Event Code' ;
    rdfs:comment 'Industry-standard code identifying the specific catastrophe event that triggered the bond.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerEventDate rdf:type rdf:Property ;
    rdfs:label 'Trigger Event Date' ;
    rdfs:comment 'Date when a catastrophe event occurred that met the trigger criteria for the bond.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trusteeName rdf:type rdf:Property ;
    rdfs:label 'Trustee Name' ;
    rdfs:comment 'Name of the trustee institution responsible for holding collateral and administering the catastrophe bond.' ;
    rdfs:domain ind:CatBond ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededLossTransactionId rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Transaction Id' ;
    rdfs:comment 'Unique identifier for the ceded loss transaction record.' ;
    rdfs:domain ind:CededLossTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bordereauxSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Submission Date' ;
    rdfs:comment 'Date when the bordereaux containing this transaction was submitted to the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Flag' ;
    rdfs:comment 'Indicates whether this ceded loss is associated with a catastrophe event.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cededTotalAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Total Amount' ;
    rdfs:comment 'Total amount ceded including loss, ALAE, and ULAE.' ;
    rdfs:domain ind:CededLossTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionPercentage rdf:type rdf:Property ;
    rdfs:label 'Cession Percentage' ;
    rdfs:comment 'Percentage of the gross loss ceded to the reinsurer under this transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Current Reserve Amount' ;
    rdfs:comment 'Current ceded reserve amount after this transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether this ceded loss transaction is under dispute with the reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grossLossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Loss Amount' ;
    rdfs:comment 'Total gross loss amount before reinsurance cession.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerNumber rdf:type rdf:Property ;
    rdfs:label 'Layer Number' ;
    rdfs:comment 'Reinsurance layer number if the treaty has multiple layers.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:netLossAmount rdf:type rdf:Property ;
    rdfs:label 'Net Loss Amount' ;
    rdfs:comment 'Net loss amount retained by the cedant after reinsurance cession.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Recoverable Amount' ;
    rdfs:comment 'Amount already recovered from the reinsurer for this transaction.' ;
    rdfs:domain ind:CededLossTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsurerConfirmationDate rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Confirmation Date' ;
    rdfs:comment 'Date when the reinsurer confirmed receipt and acceptance of this ceded loss transaction.' ;
    rdfs:domain ind:CededLossTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Date when the loss was first reported to the insurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Reporting Period' ;
    rdfs:comment 'Financial reporting period for this ceded loss transaction, typically YYYY-MM format.' ;
    rdfs:domain ind:CededLossTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveMovementType rdf:type rdf:Property ;
    rdfs:label 'Reserve Movement Type' ;
    rdfs:comment 'Type of reserve movement: initial establishment, increase, decrease, closure, or reopening.' ;
    rdfs:domain ind:CededLossTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededPremiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each ceded premium transaction record in the reinsurance ledger.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CededPremiumTransaction .

ind:reversedTransactionCededPremiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Transaction Ceded Premium Transaction Id' ;
    rdfs:comment 'Reference to the original ceded premium transaction that this record reverses. Populated only when reversal_flag is true.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CededPremiumTransaction .

ind:accountingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Accounting Period End Date' ;
    rdfs:comment 'End date of the accounting period to which this ceded premium transaction is attributed for statutory and GAAP reporting.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Accounting Period Start Date' ;
    rdfs:comment 'Start date of the accounting period (month or quarter) to which this ceded premium transaction is attributed for statutory and GAAP reporting.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Premium Amount' ;
    rdfs:comment 'Premium adjustment amount arising from the difference between deposit premium and the final calculated premium based on actual subject premium volume.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bordereauxReference rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Reference' ;
    rdfs:comment 'Reference number of the bordereaux submission in which this ceded premium transaction was reported to the reinsurer for settlement.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cessionPct rdf:type rdf:Property ;
    rdfs:label 'Cession Pct' ;
    rdfs:comment 'Percentage of the original policy premium ceded to the reinsurer under this transaction, applicable to quota share and surplus treaties.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionType rdf:type rdf:Property ;
    rdfs:label 'Cession Type' ;
    rdfs:comment 'Indicates whether the cession is under a treaty, a facultative (FAC) certificate, or a facultative-obligatory arrangement.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dacCededAmount rdf:type rdf:Property ;
    rdfs:label 'Dac Ceded Amount' ;
    rdfs:comment 'Deferred acquisition cost attributable to the ceded portion of the policy, representing the ceded DAC asset to be amortized over the policy term.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium Amount' ;
    rdfs:comment 'Provisional deposit premium paid to the reinsurer at inception of the treaty period, subject to adjustment when actual subject premium is known.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnedPremiumCededAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Ceded Amount' ;
    rdfs:comment 'Portion of the ceded written premium that has been earned during the accounting period, computed on a pro-rata or other basis per treaty terms.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gwpCededAmount rdf:type rdf:Property ;
    rdfs:label 'Gwp Ceded Amount' ;
    rdfs:comment 'Gross written premium ceded to the reinsurer under this transaction before deduction of ceding commission. Represents the cedant\'s gross exposure transferred.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nwpCededAmount rdf:type rdf:Property ;
    rdfs:label 'Nwp Ceded Amount' ;
    rdfs:comment 'Net written premium ceded after deducting ceding commission from GWP ceded. Represents the net cost of reinsurance protection for this transaction.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rolPct rdf:type rdf:Property ;
    rdfs:label 'Rol Pct' ;
    rdfs:comment 'Rate on Line expressed as a percentage of the reinsurance limit, used for XOL and CAT XL layers to derive the ceded premium from the limit purchased.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementDueDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Due Date' ;
    rdfs:comment 'Contractual due date by which the ceded premium must be remitted to the reinsurer per the treaty or FAC certificate payment terms.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementStatus rdf:type rdf:Property ;
    rdfs:label 'Settlement Status' ;
    rdfs:comment 'Current settlement state of the ceded premium transaction with the reinsurer: pending, submitted in bordereaux, agreed, paid, or disputed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Subject Premium Amount' ;
    rdfs:comment 'The base premium amount on which the reinsurance rate or cession percentage is applied to derive the ceded premium for this transaction.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uepCededAmount rdf:type rdf:Property ;
    rdfs:label 'Uep Ceded Amount' ;
    rdfs:comment 'Portion of the ceded written premium that is unearned as of the accounting period end date, representing the ceded UEP reserve on the balance sheet.' ;
    rdfs:domain ind:CededPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treatyLayerId rdf:type rdf:Property ;
    rdfs:label 'Treaty Layer Id' ;
    rdfs:comment 'Foreign key linking to reinsurance.treaty_layer. Business justification: Cessions apply to specific treaty layers. Currently has layer_number (INT), should have proper FK to treaty_layer for full layer definition and terms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatyLayer .

ind:amBestRating rdf:type rdf:Property ;
    rdfs:label 'Am Best Rating' ;
    rdfs:comment 'A.M. Best financial strength rating of the assuming reinsurer at the time of cession placement, used for credit quality and collateral requirement assessment.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededAlae rdf:type rdf:Property ;
    rdfs:label 'Ceded Alae' ;
    rdfs:comment 'Allocated loss adjustment expense (ALAE) ceded to the reinsurer under this transaction, representing defense and cost containment expenses.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededIbnr rdf:type rdf:Property ;
    rdfs:label 'Ceded Ibnr' ;
    rdfs:comment 'Actuarial estimate of incurred but not reported (IBNR) losses ceded to the reinsurer, used in statutory reserving and Schedule F reporting.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLimit rdf:type rdf:Property ;
    rdfs:label 'Ceded Limit' ;
    rdfs:comment 'Maximum reinsurance recovery limit ceded under this transaction. For XOL structures, this is the layer limit above the retention.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossPaid rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Paid' ;
    rdfs:comment 'Cumulative paid loss amount ceded to and recovered from the reinsurer under this cession as of the reporting date.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossReserve rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Reserve' ;
    rdfs:comment 'Outstanding case reserve (OCR) amount ceded to the reinsurer representing estimated future loss payments recoverable under this cession.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededUnearnedPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Unearned Premium' ;
    rdfs:comment 'Unearned portion of the ceded written premium representing the reinsurer\'s liability for unexpired risk as of the reporting date.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsementReference rdf:type rdf:Property ;
    rdfs:label 'Endorsement Reference' ;
    rdfs:comment 'Reference to the policy endorsement (ENDT) that triggered or modified this cession, linking mid-term changes to the corresponding cession adjustment.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRetrocession rdf:type rdf:Property ;
    rdfs:label 'Is Retrocession' ;
    rdfs:comment 'Indicates whether this cession is a retrocession (i.e., the cedant is itself a reinsurer ceding risk further to a retrocessionaire).' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:placementType rdf:type rdf:Property ;
    rdfs:label 'Placement Type' ;
    rdfs:comment 'Indicates whether the cession is placed under a standing reinsurance treaty or a facultative (FAC) certificate for an individual risk.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Pct' ;
    rdfs:comment 'Percentage of reinsurer profit returned to the cedant as a profit commission under sliding-scale or profit-sharing treaty arrangements.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateOnLinePct rdf:type rdf:Property ;
    rdfs:label 'Rate On Line Pct' ;
    rdfs:comment 'Rate on line (ROL) expressed as a percentage of the reinsurance limit, used to price XOL and CAT XL layers and assess cost efficiency.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremium rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium' ;
    rdfs:comment 'Additional premium paid to reinstate the reinsurance limit after a loss occurrence has eroded the layer, applicable to XOL and CAT XL structures.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceCessionDate rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Date' ;
    rdfs:comment 'The business event date on which the cession was formally recorded and submitted to the reinsurer, distinct from the risk effective date.' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceCessionStatus rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Status' ;
    rdfs:comment 'Current lifecycle state of the cession transaction. [ENUM-REF-CANDIDATE: draft|active|amended|cancelled|expired|settled — promote to reference product if statuses expand]' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceCessionType rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Type' ;
    rdfs:comment 'Classification of the cession structure: pro-rata (quota share), excess of loss (XOL), facultative (FAC), catastrophe excess of loss (CAT XL), or catastrophe bond (CAT Bond).' ;
    rdfs:domain ind:ReinsuranceCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceRecoverable rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable' ;
    rdfs:comment 'Total reinsurance recoverable balance on this cession, comprising ceded paid losses, ceded reserves, and ceded IBNR outstanding from the reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimRiRecoveryId rdf:type rdf:Property ;
    rdfs:label 'Claim Ri Recovery Id' ;
    rdfs:comment 'Unique identifier for the claim reinsurance recovery junction record.' ;
    rdfs:domain ind:ClaimRiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collateralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Required Flag' ;
    rdfs:comment 'Indicates whether collateral is required from reinsurer to receive statutory credit for this recovery.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grossAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Alae Amount' ;
    rdfs:comment 'Total allocated loss adjustment expense on the underlying claim before reinsurance recovery.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerAttachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Layer Attachment Point' ;
    rdfs:comment 'Attachment point for excess of loss layer, loss must exceed this amount before reinsurer participates.' ;
    rdfs:domain ind:ClaimRiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Layer Limit Amount' ;
    rdfs:comment 'Maximum limit of the reinsurance layer applicable to this recovery.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Recoverable Amount' ;
    rdfs:comment 'Amount still outstanding from reinsurer, calculated as recoverable minus recovered.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Recoverable Amount' ;
    rdfs:comment 'Total amount recoverable from reinsurer, sum of ceded loss and ceded ALAE, subject to treaty terms and reinsurer credit quality.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveredAmount rdf:type rdf:Property ;
    rdfs:label 'Recovered Amount' ;
    rdfs:comment 'Actual amount recovered from reinsurer to date, may differ from recoverable due to disputes or partial payments.' ;
    rdfs:domain ind:ClaimRiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryBasis rdf:type rdf:Property ;
    rdfs:label 'Recovery Basis' ;
    rdfs:comment 'Basis on which recovery amount is calculated, defining whether loss adjustment expenses are included.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryNumber rdf:type rdf:Property ;
    rdfs:label 'Recovery Number' ;
    rdfs:comment 'Business identifier for this specific recovery transaction, often used in bordereaux and settlement reporting.' ;
    rdfs:domain ind:ClaimRiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Recovery Status' ;
    rdfs:comment 'Current lifecycle status of the reinsurance recovery claim. [ENUM-REF-CANDIDATE: pending|submitted|acknowledged|approved|paid|disputed|denied|reversed — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryType rdf:type rdf:Property ;
    rdfs:label 'Recovery Type' ;
    rdfs:comment 'Type of reinsurance arrangement under which recovery is being claimed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementNumber rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Number' ;
    rdfs:comment 'Reinstatement number if this recovery exhausted the original treaty limit and triggered a reinstatement provision.' ;
    rdfs:domain ind:ClaimRiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsurerSharePct rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Share Pct' ;
    rdfs:comment 'Percentage share of this specific reinsurer in a co-reinsured treaty or facultative placement.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bordereauxPeriod rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Period' ;
    rdfs:comment 'Reporting period (YYYY-MM or YYYY-Q#) in which this certificate is included in the bordereaux submission to the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundDate rdf:type rdf:Property ;
    rdfs:label 'Bound Date' ;
    rdfs:comment 'Date on which the facultative certificate was formally bound and accepted by the reinsurer, establishing the contractual obligation.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cededRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Retention Amount' ;
    rdfs:comment 'Dollar amount of loss retained by the cedant before the reinsurer\'s liability attaches under this facultative certificate.' ;
    rdfs:domain ind:FacCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificateStatus rdf:type rdf:Property ;
    rdfs:label 'Certificate Status' ;
    rdfs:comment 'Current lifecycle state of the facultative certificate from placement through expiry or cancellation.' ;
    rdfs:domain ind:FacCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facType rdf:type rdf:Property ;
    rdfs:label 'Fac Type' ;
    rdfs:comment 'Classification of the facultative arrangement: proportional (quota share, surplus) or non-proportional (excess of loss). Drives cession calculation methodology.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceLossId rdf:type rdf:Property ;
    rdfs:label 'Occurrence Loss Id' ;
    rdfs:comment 'Unique identifier for the occurrence loss record. Primary key for occurrence-based loss aggregation used in Excess of Loss (XOL) treaty application.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OccurrenceLoss .

ind:cessionDate rdf:type rdf:Property ;
    rdfs:label 'Cession Date' ;
    rdfs:comment 'Date when the occurrence loss was formally ceded to reinsurers under the applicable treaty terms.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO country code identifying the country where the occurrence event occurred.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalizedDate rdf:type rdf:Property ;
    rdfs:label 'Finalized Date' ;
    rdfs:comment 'Date when the occurrence loss record was closed and finalized, with no further claim additions or loss development expected.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Geographic area or territory where the occurrence event took place, used for treaty territory scope validation.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoursClauseCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Hours Clause Compliant Flag' ;
    rdfs:comment 'Indicator whether all claims aggregated into this occurrence fall within the treaty hours clause time window for valid occurrence treatment.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hoursClauseDuration rdf:type rdf:Property ;
    rdfs:label 'Hours Clause Duration' ;
    rdfs:comment 'Number of hours specified in the treaty hours clause for aggregating related losses into a single occurrence event.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Occurrence Date' ;
    rdfs:comment 'Date when the loss occurrence event took place. Critical for treaty layer attachment and hours clause determination.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:occurrenceEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Occurrence End Timestamp' ;
    rdfs:comment 'Date and time when the occurrence event concluded, used to determine the duration window for aggregating related claims under hours clause provisions.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:occurrenceName rdf:type rdf:Property ;
    rdfs:label 'Occurrence Name' ;
    rdfs:comment 'Descriptive name or title assigned to the occurrence event, typically used for catastrophic events or major loss incidents.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceNumber rdf:type rdf:Property ;
    rdfs:label 'Occurrence Number' ;
    rdfs:comment 'Business identifier for the occurrence event. Externally-known reference number used in reinsurance bordereaux and treaty reporting.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceStatus rdf:type rdf:Property ;
    rdfs:label 'Occurrence Status' ;
    rdfs:comment 'Current lifecycle status of the occurrence loss record in the reinsurance cession workflow.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Occurrence Timestamp' ;
    rdfs:comment 'Precise date and time when the occurrence event began, used for hours clause compliance verification in catastrophe treaties.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:perilDescription rdf:type rdf:Property ;
    rdfs:label 'Peril Description' ;
    rdfs:comment 'Detailed narrative description of the peril or cause of loss for the occurrence event.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementTriggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Triggered Flag' ;
    rdfs:comment 'Indicator whether this occurrence loss triggered a treaty layer reinstatement, requiring additional reinstatement premium payment.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateProvinceCode rdf:type rdf:Property ;
    rdfs:label 'State Province Code' ;
    rdfs:comment 'Code identifying the state or province where the occurrence event took place, used for regulatory and treaty reporting.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCededAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Ceded Alae Amount' ;
    rdfs:comment 'Total ALAE amount ceded to reinsurers for this occurrence under applicable treaty terms.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCededAmount rdf:type rdf:Property ;
    rdfs:label 'Total Ceded Amount' ;
    rdfs:comment 'Total amount ceded to reinsurers for this occurrence including loss and ALAE, representing the full reinsurance recovery.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCededLossAmount rdf:type rdf:Property ;
    rdfs:label 'Total Ceded Loss Amount' ;
    rdfs:comment 'Total loss amount ceded to reinsurers for this occurrence after applying retention and treaty layer limits.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalGrossAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Gross Alae Amount' ;
    rdfs:comment 'Total gross Allocated Loss Adjustment Expense aggregated from all claims in this occurrence, before reinsurance recovery.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalGrossIncurredAmount rdf:type rdf:Property ;
    rdfs:label 'Total Gross Incurred Amount' ;
    rdfs:comment 'Total gross incurred loss including indemnity, ALAE, and ULAE for this occurrence, representing the full exposure before reinsurance.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalGrossLossAmount rdf:type rdf:Property ;
    rdfs:label 'Total Gross Loss Amount' ;
    rdfs:comment 'Total gross loss amount aggregated from all claims associated with this occurrence, before any reinsurance cession or retention deduction.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalGrossUlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Gross Ulae Amount' ;
    rdfs:comment 'Total gross Unallocated Loss Adjustment Expense allocated to this occurrence based on company methodology.' ;
    rdfs:domain ind:OccurrenceLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyCessionId rdf:type rdf:Property ;
    rdfs:label 'Policy Cession Id' ;
    rdfs:comment 'Unique surrogate identifier for each policy-cession pairing record in the junction table.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bordereauxIncluded rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Included' ;
    rdfs:comment 'Indicates whether this policy-cession record has been included in a bordereaux submission to the reinsurer for the current reporting period.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cededPremiumEarned rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Earned' ;
    rdfs:comment 'Portion of the ceded written premium that has been earned as of the reporting date, based on the policy exposure period.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPremiumWritten rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Written' ;
    rdfs:comment 'Gross written premium (GWP) ceded to the reinsurer for this policy-cession pairing at policy inception or renewal.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Cession Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this policy-cession pairing, used in bordereaux and reinsurer reporting.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Net Written Premium' ;
    rdfs:comment 'Net written premium (NWP) retained by Pc_Insurance after cession for this policy, calculated as gross written premium minus ceded written premium.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyTermType rdf:type rdf:Property ;
    rdfs:label 'Policy Term Type' ;
    rdfs:comment 'Indicates whether this cession relates to a new business (NB), renewal (REN), endorsement (ENDT), cancellation (CANC), or reinstatement transaction.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tivCeded rdf:type rdf:Property ;
    rdfs:label 'Tiv Ceded' ;
    rdfs:comment 'Total insured value (TIV) of the ceded risk exposure under this policy-cession pairing, used for property CAT modeling and PML calculations.' ;
    rdfs:domain ind:PolicyCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profitCommissionId rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Id' ;
    rdfs:comment 'Unique identifier for the profit commission record.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accruedCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Accrued Commission Amount' ;
    rdfs:comment 'Accrued profit commission amount recognized in the financial statements for the period, may differ from calculated amount due to timing.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculatedCommissionRatePct rdf:type rdf:Property ;
    rdfs:label 'Calculated Commission Rate Pct' ;
    rdfs:comment 'Calculated profit commission rate percentage based on the treaty formula and actual loss ratio for the period.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculatedLossRatioPct rdf:type rdf:Property ;
    rdfs:label 'Calculated Loss Ratio Pct' ;
    rdfs:comment 'Calculated loss ratio percentage for the treaty and period, computed as total ceded loss and LAE divided by net ceded premium.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'Method used to determine the experience period for profit commission calculation, such as treaty year, accident year, or calendar year basis.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationNumber rdf:type rdf:Property ;
    rdfs:label 'Calculation Number' ;
    rdfs:comment 'Business identifier for the profit commission calculation, typically assigned by the reinsurance system.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationStatus rdf:type rdf:Property ;
    rdfs:label 'Calculation Status' ;
    rdfs:comment 'Current lifecycle status of the profit commission calculation. [ENUM-REF-CANDIDATE: draft|calculated|approved|accrued|paid|disputed|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formula rdf:type rdf:Property ;
    rdfs:label 'Formula' ;
    rdfs:comment 'Type of profit commission formula specified in the treaty: fixed rate, sliding scale, step function, or custom calculation.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Commission Amount' ;
    rdfs:comment 'Total profit commission amount paid to date for this calculation, tracking settlement progress.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'The date by which the profit commission payment is due per treaty terms.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorCalculationAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Calculation Amount' ;
    rdfs:comment 'Profit commission amount from the prior calculation for the same treaty and period, used to track adjustments and movements.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:provisionalFlag rdf:type rdf:Property ;
    rdfs:label 'Provisional Flag' ;
    rdfs:comment 'Indicates whether this profit commission calculation is provisional and subject to adjustment upon final bordereaux or audit.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slidingScaleMaxPct rdf:type rdf:Property ;
    rdfs:label 'Sliding Scale Max Pct' ;
    rdfs:comment 'Maximum profit commission percentage in a sliding scale formula, applicable when loss ratio is at or below the lower threshold.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slidingScaleMinPct rdf:type rdf:Property ;
    rdfs:label 'Sliding Scale Min Pct' ;
    rdfs:comment 'Minimum profit commission percentage in a sliding scale formula, applicable when loss ratio is at or above the upper threshold.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCededLossLae rdf:type rdf:Property ;
    rdfs:label 'Total Ceded Loss Lae' ;
    rdfs:comment 'Sum of ceded loss, ALAE, and ULAE amounts, used as the numerator in loss ratio calculation.' ;
    rdfs:domain ind:ProfitCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updatedBy rdf:type rdf:Property ;
    rdfs:label 'Updated By' ;
    rdfs:comment 'User identifier of the person or system that last updated this profit commission record.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementId rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Id' ;
    rdfs:comment 'Unique identifier for the reinstatement data product (auto-inserted during validation).' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:automaticReinstatementFlag rdf:type rdf:Property ;
    rdfs:label 'Automatic Reinstatement Flag' ;
    rdfs:comment 'Indicates whether the treaty limit is automatically reinstated upon payment of premium, without requiring reinsurer approval.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokerName rdf:type rdf:Property ;
    rdfs:label 'Broker Name' ;
    rdfs:comment 'Name of the reinsurance broker or intermediary facilitating the reinstatement transaction and premium settlement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeReinstatementFlag rdf:type rdf:Property ;
    rdfs:label 'Free Reinstatement Flag' ;
    rdfs:comment 'Indicates whether this reinstatement is provided at no additional premium cost per treaty terms, typically for first reinstatement.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'Date on which the reinstatement premium invoice was issued to the cedant by the reinsurer.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadReinsurerName rdf:type rdf:Property ;
    rdfs:label 'Lead Reinsurer Name' ;
    rdfs:comment 'Name of the lead reinsurer responsible for coordinating the reinstatement process and premium collection across the syndicate.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossAmountTriggering rdf:type rdf:Property ;
    rdfs:label 'Loss Amount Triggering' ;
    rdfs:comment 'Total ceded loss amount from the occurrence that exhausted the treaty layer and triggered the need for reinstatement.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumPct rdf:type rdf:Property ;
    rdfs:label 'Premium Pct' ;
    rdfs:comment 'Percentage rate applied to the original premium to calculate the reinstatement premium, as specified in the treaty terms.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prorataFactor rdf:type rdf:Property ;
    rdfs:label 'Prorata Factor' ;
    rdfs:comment 'Pro-rata adjustment factor applied when the reinstatement occurs partway through the treaty period, reducing the premium proportionally.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prorataPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Prorata Premium Amount' ;
    rdfs:comment 'Reinstatement premium adjusted for the pro-rata factor based on remaining treaty period at the time of reinstatement.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatedLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstated Limit Amount' ;
    rdfs:comment 'The treaty limit amount being reinstated and made available for subsequent losses after the triggering occurrence.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementStatus rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Status' ;
    rdfs:comment 'Current lifecycle status of the reinstatement transaction, tracking from initial calculation through payment settlement.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Approval Date' ;
    rdfs:comment 'Date on which the reinsurer formally approved the reinstatement of the treaty limit, if approval was required.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsurerApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Approval Required Flag' ;
    rdfs:comment 'Indicates whether explicit reinsurer approval is required before the treaty limit can be reinstated for subsequent losses.' ;
    rdfs:domain ind:Reinstatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amBestOutlook rdf:type rdf:Property ;
    rdfs:label 'Am Best Outlook' ;
    rdfs:comment 'A.M. Best rating outlook indicating the expected direction of the reinsurer\'s financial strength rating over the medium term.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amBestRatingDate rdf:type rdf:Property ;
    rdfs:label 'Am Best Rating Date' ;
    rdfs:comment 'Date on which the current A.M. Best Financial Strength Rating was assigned or last affirmed, used to assess rating currency for treaty approval.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedLobList rdf:type rdf:Property ;
    rdfs:label 'Approved Lob List' ;
    rdfs:comment 'Comma-delimited list of Lines of Business (LOB) for which this reinsurer is approved to accept cessions (e.g., GL, WC, APD, CAT XL). Governs treaty eligibility.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedStatus rdf:type rdf:Property ;
    rdfs:label 'Authorized Status' ;
    rdfs:comment 'Regulatory authorization status of the reinsurer in the cedant\'s domicile state, determining credit-for-reinsurance treatment under NAIC model law.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountReference rdf:type rdf:Property ;
    rdfs:label 'Bank Account Reference' ;
    rdfs:comment 'Internal reference code for the reinsurer\'s designated bank account used for premium and loss settlement, stored as a tokenized reference to the financial system.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsContactEmail rdf:type rdf:Property ;
    rdfs:label 'Claims Contact Email' ;
    rdfs:comment 'Email address of the reinsurer\'s claims department or designated claims contact for loss notification and recovery correspondence.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:class rdf:type rdf:Property ;
    rdfs:label 'Class' ;
    rdfs:comment 'Broad classification of the reinsurer by organizational class: professional reinsurer, captive, government-sponsored, Lloyd\'s syndicate, or industry pool.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyType rdf:type rdf:Property ;
    rdfs:label 'Counterparty Type' ;
    rdfs:comment 'Classification of the reinsurance counterparty indicating its structural role: reinsurer, retrocessionaire, captive, pool, Lloyd\'s syndicate, or fronting carrier.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitCurrency rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the reinsurer credit limit is denominated (e.g., USD, GBP, EUR).' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Usd' ;
    rdfs:comment 'Maximum aggregate ceded exposure in USD that Pc_Insurance is authorized to place with this reinsurer across all treaties and facultative certificates.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:domicileCountry rdf:type rdf:Property ;
    rdfs:label 'Domicile Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the reinsurer is legally domiciled and holds its primary insurance license.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domicileState rdf:type rdf:Property ;
    rdfs:label 'Domicile State' ;
    rdfs:comment 'Two-letter US state code of the reinsurer\'s state of domicile for domestic reinsurers, used in NAIC statutory reporting and credit-for-reinsurance determinations.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundsWithheldEligible rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld Eligible' ;
    rdfs:comment 'Indicates whether this reinsurer is eligible for funds-withheld collateral arrangements as an alternative to letters of credit for credit-for-reinsurance purposes.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date of the most recent periodic counterparty credit and compliance review conducted by the reinsurance or risk management team.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'Current operational status of the reinsurer counterparty record, governing whether new treaties or facultative placements may be bound with this entity.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lloydsSyndicateNumber rdf:type rdf:Property ;
    rdfs:label 'Lloyds Syndicate Number' ;
    rdfs:comment 'Lloyd\'s of London syndicate number for reinsurers operating as Lloyd\'s syndicates. Null for non-Lloyd\'s entities.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locRequired rdf:type rdf:Property ;
    rdfs:label 'Loc Required' ;
    rdfs:comment 'Indicates whether a Letter of Credit (LOC) is required from this reinsurer as collateral to support credit-for-reinsurance on the cedant\'s statutory balance sheet.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxSingleRiskLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Max Single Risk Limit Usd' ;
    rdfs:comment 'Maximum ceded limit in USD that may be placed with this reinsurer on any single risk or facultative certificate, per internal counterparty concentration policy.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicGroupCode rdf:type rdf:Property ;
    rdfs:label 'Naic Group Code' ;
    rdfs:comment 'NAIC-assigned group code identifying the reinsurance holding group, used for group-level concentration risk monitoring and statutory reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentGroupName rdf:type rdf:Property ;
    rdfs:label 'Parent Group Name' ;
    rdfs:comment 'Name of the ultimate parent holding group or reinsurance group to which this reinsurer entity belongs, used for group-level credit limit aggregation.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredSettlementCurrency rdf:type rdf:Property ;
    rdfs:label 'Preferred Settlement Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code preferred by the reinsurer for premium and loss settlement transactions.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressCity rdf:type rdf:Property ;
    rdfs:label 'Registered Address City' ;
    rdfs:comment 'City of the reinsurer\'s official registered office address.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressCountry rdf:type rdf:Property ;
    rdfs:label 'Registered Address Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the reinsurer\'s registered office address.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line1' ;
    rdfs:comment 'First line of the reinsurer\'s official registered office address as filed with the domicile regulator.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionsScreenDate rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screen Date' ;
    rdfs:comment 'Date on which the most recent OFAC and international sanctions screening was completed for this reinsurer counterparty.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionsScreened rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screened' ;
    rdfs:comment 'Indicates whether this reinsurer has passed the most recent OFAC and international sanctions screening required before treaty placement or payment.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementTermsDays rdf:type rdf:Property ;
    rdfs:label 'Settlement Terms Days' ;
    rdfs:comment 'Standard number of days from bordereaux submission or loss advice to expected settlement payment from the reinsurer, per treaty or market convention.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:spRating rdf:type rdf:Property ;
    rdfs:label 'Sp Rating' ;
    rdfs:comment 'S&P Global Ratings insurer financial strength rating for the reinsurer (e.g., AAA, AA+, AA, A+, A, BBB). Supplements A.M. Best for counterparty risk assessment.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spRatingDate rdf:type rdf:Property ;
    rdfs:label 'Sp Rating Date' ;
    rdfs:comment 'Date on which the current S&P Global financial strength rating was assigned or last affirmed.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:swiftBicCode rdf:type rdf:Property ;
    rdfs:label 'Swift Bic Code' ;
    rdfs:comment 'SWIFT Bank Identifier Code (BIC) for the reinsurer\'s settlement bank, used for international wire transfers of premium and loss payments.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradingName rdf:type rdf:Property ;
    rdfs:label 'Trading Name' ;
    rdfs:comment 'Doing Business As (DBA) or commercial brand name used by the reinsurer in market communications, distinct from the legal registered name.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trustFundEligible rdf:type rdf:Property ;
    rdfs:label 'Trust Fund Eligible' ;
    rdfs:comment 'Indicates whether this reinsurer maintains a qualifying US trust fund under NAIC model law, enabling credit-for-reinsurance without LOC for unauthorized reinsurers.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riBrokerId rdf:type rdf:Property ;
    rdfs:label 'Ri Broker Id' ;
    rdfs:comment 'Unique identifier for the reinsurance broker record.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiBroker .

ind:authorizedMarkets rdf:type rdf:Property ;
    rdfs:label 'Authorized Markets' ;
    rdfs:comment 'Comma-separated list of reinsurance markets where the broker is authorized to place business.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerCode rdf:type rdf:Property ;
    rdfs:label 'Broker Code' ;
    rdfs:comment 'Unique business identifier code assigned to the reinsurance broker for operational reference.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerStatus rdf:type rdf:Property ;
    rdfs:label 'Broker Status' ;
    rdfs:comment 'Current operational status of the broker relationship.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerType rdf:type rdf:Property ;
    rdfs:label 'Broker Type' ;
    rdfs:comment 'Classification of the reinsurance broker by operational focus and market segment.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerageRatePct rdf:type rdf:Property ;
    rdfs:label 'Brokerage Rate Pct' ;
    rdfs:comment 'Standard brokerage commission rate percentage charged by the broker on placed reinsurance premium.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catPlacementFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Placement Flag' ;
    rdfs:comment 'Indicates whether the broker is authorized and experienced in placing catastrophe reinsurance.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditRating rdf:type rdf:Property ;
    rdfs:label 'Credit Rating' ;
    rdfs:comment 'Financial strength or credit rating assigned to the broker by a recognized rating agency.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Eo Expiry Date' ;
    rdfs:comment 'Expiration date of the brokers current errors and omissions insurance policy.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facPlacementFlag rdf:type rdf:Property ;
    rdfs:label 'Fac Placement Flag' ;
    rdfs:comment 'Indicates whether the broker handles facultative certificate placements.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lloydsAuthorizedFlag rdf:type rdf:Property ;
    rdfs:label 'Lloyds Authorized Flag' ;
    rdfs:comment 'Indicates whether the broker is authorized to place business at Lloyds of London.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lloydsBrokerNumber rdf:type rdf:Property ;
    rdfs:label 'Lloyds Broker Number' ;
    rdfs:comment 'Unique registration number assigned by Lloyds of London for authorized Lloyds brokers.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentCompanyName rdf:type rdf:Property ;
    rdfs:label 'Parent Company Name' ;
    rdfs:comment 'Legal name of the parent company if the broker is part of a larger corporate group.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyLob rdf:type rdf:Property ;
    rdfs:label 'Specialty Lob' ;
    rdfs:comment 'Primary lines of business or perils in which the broker specializes for reinsurance placements.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyPlacementFlag rdf:type rdf:Property ;
    rdfs:label 'Treaty Placement Flag' ;
    rdfs:comment 'Indicates whether the broker handles treaty reinsurance placements.' ;
    rdfs:domain ind:RiBroker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riPlacementId rdf:type rdf:Property ;
    rdfs:label 'Ri Placement Id' ;
    rdfs:comment 'Unique identifier for the reinsurance placement record.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadReinsurerId rdf:type rdf:Property ;
    rdfs:label 'Lead Reinsurer Id' ;
    rdfs:comment 'Reference to the lead reinsurer who anchors the placement and typically takes the largest share.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reinsurer .

ind:placingAgencyId rdf:type rdf:Property ;
    rdfs:label 'Placing Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Agency-level attribution for reinsurance placements, especially for MGA/wholesale operations that place reinsurance on behalf of retail networks.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:bindingDate rdf:type rdf:Property ;
    rdfs:label 'Binding Date' ;
    rdfs:comment 'Date the placement was bound and the reinsurance contract became effective.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokeragePct rdf:type rdf:Property ;
    rdfs:label 'Brokerage Pct' ;
    rdfs:comment 'Percentage of premium paid to the reinsurance broker as commission for placement services.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leadReinsurerSharePct rdf:type rdf:Property ;
    rdfs:label 'Lead Reinsurer Share Pct' ;
    rdfs:comment 'Percentage of the total placement capacity taken by the lead reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketsApproachedCount rdf:type rdf:Property ;
    rdfs:label 'Markets Approached Count' ;
    rdfs:comment 'Number of reinsurance markets or reinsurers approached during the placement process.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:participatingReinsurersCount rdf:type rdf:Property ;
    rdfs:label 'Participating Reinsurers Count' ;
    rdfs:comment 'Number of reinsurers who ultimately signed and participated in the bound placement.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:placedCapacityAmount rdf:type rdf:Property ;
    rdfs:label 'Placed Capacity Amount' ;
    rdfs:comment 'Total reinsurance capacity amount successfully placed and bound with reinsurers.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementNotes rdf:type rdf:Property ;
    rdfs:label 'Placement Notes' ;
    rdfs:comment 'Free-text notes capturing key details, negotiations, special terms, or other relevant information about the placement.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementNumber rdf:type rdf:Property ;
    rdfs:label 'Placement Number' ;
    rdfs:comment 'Business identifier for the placement workflow, typically assigned by the broker or cedant.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementStage rdf:type rdf:Property ;
    rdfs:label 'Placement Stage' ;
    rdfs:comment 'High-level phase of the placement process indicating major workflow milestones.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementStatus rdf:type rdf:Property ;
    rdfs:label 'Placement Status' ;
    rdfs:comment 'Current stage of the placement workflow from initial submission through binding or decline. [ENUM-REF-CANDIDATE: draft|slip_submitted|market_quoted|negotiation|bound|declined|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Name of the broader reinsurance program or tower to which this placement belongs.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteDueDate rdf:type rdf:Property ;
    rdfs:label 'Quote Due Date' ;
    rdfs:comment 'Date by which reinsurers are expected to provide their quotes or indications.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:quotesReceivedCount rdf:type rdf:Property ;
    rdfs:label 'Quotes Received Count' ;
    rdfs:comment 'Number of formal quotes or indications received from reinsurers during the placement process.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slipSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Slip Submission Date' ;
    rdfs:comment 'Date the reinsurance slip was submitted to the market for underwriting consideration.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetCapacityAmount rdf:type rdf:Property ;
    rdfs:label 'Target Capacity Amount' ;
    rdfs:comment 'Total reinsurance capacity amount the cedant is seeking to place in the market.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalSignedLinePct rdf:type rdf:Property ;
    rdfs:label 'Total Signed Line Pct' ;
    rdfs:comment 'Aggregate percentage of the placement capacity that has been signed by all participating reinsurers.' ;
    rdfs:domain ind:RiPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoverableId rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Id' ;
    rdfs:comment 'Unique identifier for the reinsurance recoverable record.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catEventFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Event Flag' ;
    rdfs:comment 'Indicates whether this recoverable arises from a catastrophe event loss, subject to special treaty terms.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralHeldAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Held Amount' ;
    rdfs:comment 'Amount of collateral held by the cedant to secure this recoverable, reducing credit risk exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectedAmount rdf:type rdf:Property ;
    rdfs:label 'Collected Amount' ;
    rdfs:comment 'Total amount collected from the reinsurer to date against this recoverable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectedDate rdf:type rdf:Property ;
    rdfs:label 'Collected Date' ;
    rdfs:comment 'Date on which payment was received from the reinsurer, fully or partially settling the recoverable.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Credit Allowed Flag' ;
    rdfs:comment 'Indicates whether statutory credit is allowed for this recoverable under state insurance regulations.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Date' ;
    rdfs:comment 'Date on which the reinsurer formally disputed the recoverable, triggering dispute resolution procedures.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputedAmount rdf:type rdf:Property ;
    rdfs:label 'Disputed Amount' ;
    rdfs:comment 'Portion of the recoverable balance currently under dispute with the reinsurer.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossType rdf:type rdf:Property ;
    rdfs:label 'Loss Type' ;
    rdfs:comment 'Type of loss component for which reinsurance recovery is being tracked.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overdueFlag rdf:type rdf:Property ;
    rdfs:label 'Overdue Flag' ;
    rdfs:comment 'Indicates whether the recoverable balance is overdue per the reinsurance agreement payment terms.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoverableNumber rdf:type rdf:Property ;
    rdfs:label 'Recoverable Number' ;
    rdfs:comment 'Business identifier for the recoverable record, used for external reporting and bordereaux submission.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoverableStatus rdf:type rdf:Property ;
    rdfs:label 'Recoverable Status' ;
    rdfs:comment 'Current lifecycle status of the recoverable balance in the collection workflow.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoverableType rdf:type rdf:Property ;
    rdfs:label 'Recoverable Type' ;
    rdfs:comment 'Classification of the reinsurance arrangement type under which recovery is claimed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenOffAmount rdf:type rdf:Property ;
    rdfs:label 'Written Off Amount' ;
    rdfs:comment 'Portion of the recoverable balance written off as uncollectible due to reinsurer insolvency or dispute resolution.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writtenOffDate rdf:type rdf:Property ;
    rdfs:label 'Written Off Date' ;
    rdfs:comment 'Date on which the recoverable balance was written off as uncollectible.' ;
    rdfs:domain ind:RiRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riSettlementId rdf:type rdf:Property ;
    rdfs:label 'Ri Settlement Id' ;
    rdfs:comment 'Unique identifier for the reinsurance settlement record.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:balanceDirection rdf:type rdf:Property ;
    rdfs:label 'Balance Direction' ;
    rdfs:comment 'Indicates whether the net balance is due from the reinsurer, due to the reinsurer, or zero.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Broker Commission Amount' ;
    rdfs:comment 'Commission paid to the reinsurance broker for placement and servicing of the treaty or certificate.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Net Balance Amount' ;
    rdfs:comment 'Net settlement balance due to or from the reinsurer after all debits and credits; positive indicates amount due from reinsurer.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'End date of the accounting period covered by this settlement.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'Start date of the accounting period covered by this settlement.' ;
    rdfs:domain ind:RiSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Number' ;
    rdfs:comment 'Business identifier for the settlement statement, typically assigned by the cedant or reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingAgencyId rdf:type rdf:Property ;
    rdfs:label 'Originating Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Treaties track originating agency for premium volume aggregation and agency-level profit sharing arrangements.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:admittedReinsurerFlag rdf:type rdf:Property ;
    rdfs:label 'Admitted Reinsurer Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is admitted (licensed) in the cedant\'s domicile state. Admitted status affects credit for reinsurance on the NAIC statutory balance sheet.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aggregateRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Retention Amount' ;
    rdfs:comment 'Annual aggregate deductible or retention that must be exhausted before the aggregate reinsurance limit responds. Used in stop-loss and aggregate XOL structures.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokerCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Broker Commission Pct' ;
    rdfs:comment 'Percentage of ceded premium paid to the reinsurance broker as brokerage commission for placing the treaty. Expressed as a decimal (e.g., 0.0125 = 1.25%).' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundsWithheldFlag rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld Flag' ;
    rdfs:comment 'Indicates whether Pc_Insurance withholds ceded premium funds from the reinsurer under a funds-withheld collateral arrangement, common with non-admitted reinsurers.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCorridorLowerPct rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Lower Pct' ;
    rdfs:comment 'Lower bound of the loss corridor (as a percentage of subject premium) within which Pc_Insurance retains losses in a stop-loss or aggregate structure. Null if not applicable.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCorridorUpperPct rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Upper Pct' ;
    rdfs:comment 'Upper bound of the loss corridor (as a percentage of subject premium) above which reinsurance coverage resumes in a stop-loss or aggregate structure. Null if not applicable.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicReinsurerCode rdf:type rdf:Property ;
    rdfs:label 'Naic Reinsurer Code' ;
    rdfs:comment 'Five-digit NAIC company code assigned to the reinsurer, used for statutory Schedule F reporting and regulatory identification of the reinsurance counterparty.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCommissionThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Threshold Pct' ;
    rdfs:comment 'Loss ratio threshold below which the profit commission mechanism is triggered. Expressed as a decimal (e.g., 0.6500 = 65% loss ratio). Null if no profit commission applies.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementCount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Count' ;
    rdfs:comment 'Number of reinstatements available to restore the treaty limit after a loss occurrence. Common in CAT XL treaties. Zero indicates no reinstatements permitted.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retentionType rdf:type rdf:Property ;
    rdfs:label 'Retention Type' ;
    rdfs:comment 'Indicates whether the retention is expressed as a fixed monetary amount (e.g., SIR or attachment point in USD) or as a percentage of the risk (used in QS treaties).' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectPremiumBasis rdf:type rdf:Property ;
    rdfs:label 'Subject Premium Basis' ;
    rdfs:comment 'Defines the premium base to which the treaty rate or cession percentage is applied: Gross Written Premium (GWP), Net Written Premium (NWP), Earned Premium (EP), or Written Premium (WP).' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyName rdf:type rdf:Property ;
    rdfs:label 'Treaty Name' ;
    rdfs:comment 'Descriptive business name of the reinsurance treaty (e.g., \'Property CAT XL Layer 1 2024\') used for identification in bordereaux and management reporting.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyNumber rdf:type rdf:Property ;
    rdfs:label 'Treaty Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to the reinsurance treaty or facultative (FAC) certificate by the reinsurance management system or lead reinsurer.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyStatus rdf:type rdf:Property ;
    rdfs:label 'Treaty Status' ;
    rdfs:comment 'Current lifecycle state of the reinsurance treaty: DRAFT (in negotiation), BOUND (signed/agreed), ACTIVE (in-force), EXPIRED, CANCELLED, or SUSPENDED.' ;
    rdfs:domain ind:RiTreaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustedPremium rdf:type rdf:Property ;
    rdfs:label 'Adjusted Premium' ;
    rdfs:comment 'Final reinsurance premium after year-end adjustment reconciling deposit premium against actual subject premium earned. Reflects true cost of the layer for the period.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aggregateDeductible rdf:type rdf:Property ;
    rdfs:label 'Aggregate Deductible' ;
    rdfs:comment 'Cumulative loss amount the cedant must retain before the aggregate XOL layer responds. Used in aggregate stop-loss and aggregate XOL treaty structures.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alaeIncluded rdf:type rdf:Property ;
    rdfs:label 'Alae Included' ;
    rdfs:comment 'Indicates whether Allocated Loss Adjustment Expense (ALAE) is included within the layer limit and attachment point calculations for this treaty layer.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catEventLimit rdf:type rdf:Property ;
    rdfs:label 'Cat Event Limit' ;
    rdfs:comment 'Maximum reinsurer liability per defined catastrophe event under a CAT XL layer. Distinct from per-risk occurrence limit; applies to accumulation of losses from a single CAT event.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositPremium rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium' ;
    rdfs:comment 'Provisional premium paid to the reinsurer at inception of the treaty period, subject to adjustment at year-end based on actual subject premium earned.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusionsSummary rdf:type rdf:Property ;
    rdfs:label 'Exclusions Summary' ;
    rdfs:comment 'Free-text summary of key exclusions applicable to this layer (e.g., nuclear, cyber, war, NBCR). Supports underwriting review and reinsurer communication.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoursClause rdf:type rdf:Property ;
    rdfs:label 'Hours Clause' ;
    rdfs:comment 'Number of consecutive hours defining the event window for CAT XL loss aggregation. Losses occurring within this window are treated as a single occurrence (e.g., 72 or 168 hours).' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indexBaseYear rdf:type rdf:Property ;
    rdfs:label 'Index Base Year' ;
    rdfs:comment 'The reference year used as the base for the index or stability clause adjustment. Applicable only when index_clause is true.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indexClause rdf:type rdf:Property ;
    rdfs:label 'Index Clause' ;
    rdfs:comment 'Indicates whether an index or stability clause applies to this layer, adjusting the attachment point and limit for inflation over the treaty period.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laeTreatment rdf:type rdf:Property ;
    rdfs:label 'Lae Treatment' ;
    rdfs:comment 'Specifies how LAE is handled within this layer. INCLUDED=LAE erodes the limit, EXCLUDED=LAE outside limit, PRO_RATA=LAE shared proportionally with losses.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerLimit rdf:type rdf:Property ;
    rdfs:label 'Layer Limit' ;
    rdfs:comment 'Maximum amount the reinsurer will pay for losses within this layer per occurrence or per risk. Defines the top of the layer in the XOL tower.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerName rdf:type rdf:Property ;
    rdfs:label 'Layer Name' ;
    rdfs:comment 'Descriptive business name for the layer (e.g., \'First XOL Layer\', \'QS Tranche A\', \'CAT XL Working Layer\') used in bordereaux and reinsurer communications.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerType rdf:type rdf:Property ;
    rdfs:label 'Layer Type' ;
    rdfs:comment 'Classification of the reinsurance layer structure. XOL=Excess of Loss, QS=Quota Share, CAT XL=Catastrophe Excess of Loss, FAC=Facultative, AGGREGATE_XL=Aggregate Excess of Loss.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossBasis rdf:type rdf:Property ;
    rdfs:label 'Loss Basis' ;
    rdfs:comment 'Trigger basis determining how losses are measured and applied to this layer. OCCURRENCE=per event, RISK=per insured risk, AGGREGATE=cumulative annual, CLAIMS_MADE=claims-made trigger.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxCedingCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Max Ceding Commission Pct' ;
    rdfs:comment 'Ceiling ceding commission rate applicable under a sliding scale commission arrangement. The cedant receives at most this rate when loss ratio is at its lowest.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minCedingCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Min Ceding Commission Pct' ;
    rdfs:comment 'Floor ceding commission rate applicable under a sliding scale commission arrangement. The cedant receives at least this rate regardless of loss ratio.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmlBasis rdf:type rdf:Property ;
    rdfs:label 'Pml Basis' ;
    rdfs:comment 'Basis used to size the layer relative to the cedant\'s exposure. PML=Probable Maximum Loss, TIV=Total Insured Value, EML=Estimated Maximum Loss, MFL=Maximum Foreseeable Loss.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurancePremium rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Premium' ;
    rdfs:comment 'Gross premium ceded to reinsurers for this layer for the treaty period. For XOL layers, derived from ROL times limit; for QS, from cession percentage times subject premium.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rol rdf:type rdf:Property ;
    rdfs:label 'Rol' ;
    rdfs:comment 'Rate on Line expressed as a decimal fraction of the layer limit. Used to price non-proportional XOL and CAT XL layers. ROL multiplied by limit yields the reinsurance premium.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signedLinePct rdf:type rdf:Property ;
    rdfs:label 'Signed Line Pct' ;
    rdfs:comment 'Total percentage of the layer capacity that has been signed by reinsurers at placement. Should sum to 100% for a fully placed layer. Tracks placement completeness.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slidingScaleCommission rdf:type rdf:Property ;
    rdfs:label 'Sliding Scale Commission' ;
    rdfs:comment 'Indicates whether the ceding commission on this QS layer is subject to a sliding scale that varies inversely with the loss ratio, rewarding better underwriting performance.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:territorialScope rdf:type rdf:Property ;
    rdfs:label 'Territorial Scope' ;
    rdfs:comment 'Geographic territory covered by this treaty layer (e.g., \'USA\', \'USA and Canada\', specific state codes). Defines the geographic boundary of reinsurer liability.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenLinePct rdf:type rdf:Property ;
    rdfs:label 'Written Line Pct' ;
    rdfs:comment 'Percentage of the layer capacity initially offered and written by reinsurers before signing. May differ from signed line if the market is oversubscribed or undersubscribed.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treatyReinsurerId rdf:type rdf:Property ;
    rdfs:label 'Treaty Reinsurer Id' ;
    rdfs:comment 'Unique surrogate identifier for each treaty-reinsurer participation record in the reinsurance panel.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatyReplacementReinsurerId rdf:type rdf:Property ;
    rdfs:label 'Treaty Replacement Reinsurer Id' ;
    rdfs:comment 'Reference to the reinsurer who replaced this participant on the treaty panel following a withdrawal or capacity reduction.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reinsurer .

ind:brokerageCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Brokerage Commission Pct' ;
    rdfs:comment 'Percentage of ceded premium payable to the reinsurance broker for placing this reinsurer\'s line on the treaty.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Lae Amount' ;
    rdfs:comment 'Total Loss Adjustment Expense (LAE) ceded to this reinsurer under this treaty participation for the current treaty period.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralRequiredAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Required Amount' ;
    rdfs:comment 'Amount of collateral required from this reinsurer to support credit for reinsurance, based on authorization status and applicable regulations.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:domicileCountryCode rdf:type rdf:Property ;
    rdfs:label 'Domicile Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the reinsurer\'s domicile jurisdiction, used for credit for reinsurance and regulatory reporting.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundsWithheldAmount rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld Amount' ;
    rdfs:comment 'Amount of ceded premium withheld by the cedant from this reinsurer under a funds withheld arrangement, reducing settlement cash flows.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAuthorizedReinsurer rdf:type rdf:Property ;
    rdfs:label 'Is Authorized Reinsurer' ;
    rdfs:comment 'Indicates whether this reinsurer is authorized (licensed) in the cedant\'s domicile state, affecting credit for reinsurance treatment.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCertifiedReinsurer rdf:type rdf:Property ;
    rdfs:label 'Is Certified Reinsurer' ;
    rdfs:comment 'Indicates whether this reinsurer holds certified reinsurer status under NAIC Credit for Reinsurance Model Law, enabling reduced collateral requirements.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLeadReinsurer rdf:type rdf:Property ;
    rdfs:label 'Is Lead Reinsurer' ;
    rdfs:comment 'Indicates whether this reinsurer is the lead underwriter on the treaty panel, responsible for setting terms and conditions.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offeredLinePct rdf:type rdf:Property ;
    rdfs:label 'Offered Line Pct' ;
    rdfs:comment 'The percentage of the treaty capacity initially offered to this reinsurer during placement, before signing adjustments.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderHereonPct rdf:type rdf:Property ;
    rdfs:label 'Order Hereon Pct' ;
    rdfs:comment 'The percentage of the total treaty order placed with this reinsurer, reflecting the cedant\'s actual placement instruction.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:panelSequence rdf:type rdf:Property ;
    rdfs:label 'Panel Sequence' ;
    rdfs:comment 'Ordering sequence of this reinsurer within the treaty panel, used for bordereaux presentation and cession processing priority.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:participationNotes rdf:type rdf:Property ;
    rdfs:label 'Participation Notes' ;
    rdfs:comment 'Free-text notes capturing special conditions, side agreements, or underwriting remarks specific to this reinsurer\'s participation on the treaty.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationReference rdf:type rdf:Property ;
    rdfs:label 'Participation Reference' ;
    rdfs:comment 'Externally-known unique reference number assigned to this reinsurer\'s line on the treaty, used in bordereaux and cession statements.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationStatus rdf:type rdf:Property ;
    rdfs:label 'Participation Status' ;
    rdfs:comment 'Current lifecycle status of the reinsurer\'s participation on the treaty panel (e.g., active, signed, withdrawn, pending, cancelled, suspended).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Rating As Of Date' ;
    rdfs:comment 'Date as of which the reinsurer\'s financial strength ratings (A.M. Best, S&P) were captured for this participation record.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Commission Pct' ;
    rdfs:comment 'Commission percentage payable by this reinsurer to the cedant on ceded premium, applicable for quota share and proportional treaties.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsurerRole rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Role' ;
    rdfs:comment 'Role of the reinsurer on the treaty panel (e.g., lead, follow, co-reinsurer, fronting, security), indicating their authority and position.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingDate rdf:type rdf:Property ;
    rdfs:label 'Signing Date' ;
    rdfs:comment 'Date on which this reinsurer formally signed their line on the treaty, confirming their participation and subscribed share.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:slidingScaleMaxCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Sliding Scale Max Commission Pct' ;
    rdfs:comment 'Maximum commission percentage under a sliding scale commission arrangement, applied when the loss ratio is at its minimum threshold.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slidingScaleMinCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Sliding Scale Min Commission Pct' ;
    rdfs:comment 'Minimum commission percentage under a sliding scale commission arrangement, applied when the loss ratio reaches its maximum threshold.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subscribedSharePct rdf:type rdf:Property ;
    rdfs:label 'Subscribed Share Pct' ;
    rdfs:comment 'The reinsurer\'s confirmed subscribed share of the treaty, representing their proportional participation used for cession and premium allocation.' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withdrawalReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Reason' ;
    rdfs:comment 'Reason for the reinsurer\'s withdrawal from the treaty panel (e.g., capacity reduction, credit downgrade, market exit, cedant request).' ;
    rdfs:domain ind:TreatyReinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedCounties rdf:type rdf:Property ;
    rdfs:label 'Affected Counties' ;
    rdfs:comment 'Comma-separated list of county FIPS codes or county names within affected states where losses occurred.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedStates rdf:type rdf:Property ;
    rdfs:label 'Affected States' ;
    rdfs:comment 'Comma-separated list of US state codes where the catastrophe event caused insured losses (e.g., FL,GA,AL).' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alaeAmount rdf:type rdf:Property ;
    rdfs:label 'Alae Amount' ;
    rdfs:comment 'Total allocated loss adjustment expenses incurred for claims associated with this catastrophe event, in USD.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catBondTriggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Bond Triggered Flag' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered any catastrophe bond or insurance-linked securities held by the company.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catCloseDate rdf:type rdf:Property ;
    rdfs:label 'Cat Close Date' ;
    rdfs:comment 'Date when the catastrophe event was officially closed for new claim associations. Nullable if still open.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catEventStatus rdf:type rdf:Property ;
    rdfs:label 'Cat Event Status' ;
    rdfs:comment 'Current lifecycle status of the catastrophe event for claims reporting and aggregation purposes.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catOpenDate rdf:type rdf:Property ;
    rdfs:label 'Cat Open Date' ;
    rdfs:comment 'Date when the catastrophe event was officially opened for claims reporting and tracking by the insurer.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catXlTriggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Xl Triggered Flag' ;
    rdfs:comment 'Indicates whether this catastrophe event triggered the company\'s catastrophe excess of loss reinsurance treaty.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Closed Claim Count' ;
    rdfs:comment 'Total number of claims associated with this catastrophe event that have been closed with payment or denial.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:companyLossEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Company Loss Estimate Amount' ;
    rdfs:comment 'Estimated total gross loss for this insurer from the catastrophe event, in USD. Updated as claims develop.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:companyUltimateLossAmount rdf:type rdf:Property ;
    rdfs:label 'Company Ultimate Loss Amount' ;
    rdfs:comment 'Actuarial estimate of ultimate net loss to the company after all claims are settled and reinsurance recoveries applied, in USD.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:declarationDate rdf:type rdf:Property ;
    rdfs:label 'Declaration Date' ;
    rdfs:comment 'Date when the catastrophe event was officially declared by the company for internal tracking and reporting purposes.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Detailed narrative description of the catastrophe event, including meteorological or geological characteristics and impact summary.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventEndDate rdf:type rdf:Property ;
    rdfs:label 'Event End Date' ;
    rdfs:comment 'Date when the catastrophe event concluded or ceased causing new losses. Nullable for ongoing events.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventStartDate rdf:type rdf:Property ;
    rdfs:label 'Event Start Date' ;
    rdfs:comment 'Date when the catastrophe event began or first caused insured losses.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ibnrReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Reserve Amount' ;
    rdfs:comment 'Actuarial reserve estimate for losses incurred but not yet reported for this catastrophe event, in USD.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:industryLossEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Industry Loss Estimate Amount' ;
    rdfs:comment 'Estimated total insured loss across the entire insurance industry for this catastrophe event, in USD.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:industryLossEstimateDate rdf:type rdf:Property ;
    rdfs:label 'Industry Loss Estimate Date' ;
    rdfs:comment 'Date when the industry loss estimate was published or last updated.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:industryLossEstimateSource rdf:type rdf:Property ;
    rdfs:label 'Industry Loss Estimate Source' ;
    rdfs:comment 'Organization or entity that provided the industry loss estimate (e.g., ISO/PCS, AIR Worldwide, RMS).' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catEventName rdf:type rdf:Property ;
    rdfs:label 'Cat Event Name' ;
    rdfs:comment 'Common name or designation of the catastrophe event (e.g., Hurricane Katrina, California Wildfire 2020).' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openClaimCount rdf:type rdf:Property ;
    rdfs:label 'Open Claim Count' ;
    rdfs:comment 'Total number of claims associated with this catastrophe event that remain open and under active adjustment.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:perilType rdf:type rdf:Property ;
    rdfs:label 'Peril Type' ;
    rdfs:comment 'Primary peril or cause of loss associated with the catastrophe event. [ENUM-REF-CANDIDATE: hurricane|tornado|wildfire|earthquake|flood|hail|winter_storm|wind|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlTier rdf:type rdf:Property ;
    rdfs:label 'Pml Tier' ;
    rdfs:comment 'Classification tier indicating the severity of the catastrophe event relative to the company\'s PML thresholds for reinsurance attachment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Reported Claim Count' ;
    rdfs:comment 'Total number of claims reported and associated with this catastrophe event as of the last update.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Amount' ;
    rdfs:comment 'Total reinsurance recoverable amount expected or collected for losses from this catastrophe event, in USD.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Stat Reporting Required Flag' ;
    rdfs:comment 'Indicates whether this catastrophe event meets thresholds requiring special statutory reporting to state insurance departments.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalCaseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Total Case Reserve Amount' ;
    rdfs:comment 'Sum of outstanding case reserves held for all open claims associated with this catastrophe event, in USD.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalIncurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Total Incurred Loss Amount' ;
    rdfs:comment 'Sum of paid losses and outstanding case reserves for all claims associated with this catastrophe event, in USD.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Total Paid Loss Amount' ;
    rdfs:comment 'Sum of all loss payments made on claims associated with this catastrophe event, in USD.' ;
    rdfs:domain ind:CatEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ulaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ulae Amount' ;
    rdfs:comment 'Estimated unallocated loss adjustment expenses attributable to this catastrophe event, in USD.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:developmentTriangleId rdf:type rdf:Property ;
    rdfs:label 'Development Triangle Id' ;
    rdfs:comment 'Unique surrogate identifier for each loss development triangle record in the actuarial reserving system.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveStudyId rdf:type rdf:Property ;
    rdfs:label 'Reserve Study Id' ;
    rdfs:comment 'Foreign key linking to reservespayments.reserve_study. Business justification: Development triangles are analytical artifacts produced as part of a reserve study.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReserveStudy .

ind:accountingBasis rdf:type rdf:Property ;
    rdfs:label 'Accounting Basis' ;
    rdfs:comment 'Accounting framework under which the triangle data is prepared: STAT (Statutory Accounting Principles), GAAP (US Generally Accepted Accounting Principles), or IFRS.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialOpinionReference rdf:type rdf:Property ;
    rdfs:label 'Actuarial Opinion Reference' ;
    rdfs:comment 'Reference number or identifier of the actuarial opinion memorandum (AOM) or reserve study report in which this triangle was included and certified.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointedActuaryName rdf:type rdf:Property ;
    rdfs:label 'Appointed Actuary Name' ;
    rdfs:comment 'Name of the appointed actuary or actuarial analyst responsible for certifying or reviewing the ultimate loss estimates derived from this triangle.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bfUltimateLossEstimate rdf:type rdf:Property ;
    rdfs:label 'Bf Ultimate Loss Estimate' ;
    rdfs:comment 'Ultimate loss estimate produced by the Bornhuetter-Ferguson method, blending the development method projection with the a priori expected losses for this origin period.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catEventIndicator rdf:type rdf:Property ;
    rdfs:label 'Cat Event Indicator' ;
    rdfs:comment 'Flag indicating whether this triangle cell includes catastrophe losses. When true, CAT losses may be separately triangulated or excluded for non-CAT reserve analysis.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:companyNaicCode rdf:type rdf:Property ;
    rdfs:label 'Company Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code identifying the legal insurance entity for which this triangle is prepared. Required for statutory Schedule P and annual statement filings.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeIncurredAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Incurred Alae Amount' ;
    rdfs:comment 'Total cumulative incurred ALAE (paid plus case reserves for ALAE) for the origin period at the given development age as of the evaluation date.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeIncurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Incurred Loss Amount' ;
    rdfs:comment 'Total cumulative incurred losses (paid plus case reserves, excluding IBNR) for the origin period at the given development age as of the evaluation date.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeLdf rdf:type rdf:Property ;
    rdfs:label 'Cumulative Ldf' ;
    rdfs:comment 'Cumulative (age-to-ultimate) loss development factor for this origin period and development age. Product of all selected age-to-age LDFs from current age to ultimate.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativePaidAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Paid Alae Amount' ;
    rdfs:comment 'Total cumulative paid Allocated Loss Adjustment Expenses for the origin period at the given development age. Tracked separately from indemnity losses per NAIC STAT.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativePaidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Paid Loss Amount' ;
    rdfs:comment 'Total cumulative paid losses (excluding LAE) for the origin period at the given development age as of the evaluation date. Core triangle cell value.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:developmentAgeMonths rdf:type rdf:Property ;
    rdfs:label 'Development Age Months' ;
    rdfs:comment 'Number of months elapsed from the start of the origin period (accident year, policy year, or report year) to the evaluation date. Standard triangle column dimension.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evaluationDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Date' ;
    rdfs:comment 'The as-of date at which loss data in this triangle cell was evaluated and extracted from the claims system. Defines the diagonal of the development triangle.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationPeriodType rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period Type' ;
    rdfs:comment 'Frequency interval at which triangle evaluations are performed: annual, semi-annual, quarterly, or monthly. Determines the spacing of diagonals in the triangle.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedLossRatio rdf:type rdf:Property ;
    rdfs:label 'Expected Loss Ratio' ;
    rdfs:comment 'A priori expected loss ratio used as the Bornhuetter-Ferguson method input for this origin period and LOB segment. Expressed as a decimal (e.g., 0.65 for 65%).' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnerAmount rdf:type rdf:Property ;
    rdfs:label 'Ibner Amount' ;
    rdfs:comment 'IBNER component representing expected adverse development on already-reported claims. Subset of total IBNR reflecting case reserve inadequacy for known claims.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnrAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Amount' ;
    rdfs:comment 'IBNR reserve for the origin period, calculated as ultimate loss estimate minus cumulative incurred losses. Represents unreported and development on reported claims.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:largeLossIndicator rdf:type rdf:Property ;
    rdfs:label 'Large Loss Indicator' ;
    rdfs:comment 'Flag indicating whether this triangle cell includes large individual losses that may distort development patterns. Large losses are often capped or excluded in LDF selections.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:largeLossThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Large Loss Threshold Amount' ;
    rdfs:comment 'Dollar threshold above which an individual claim is classified as a large loss for this triangle segment. Used to define the capping level for LDF selection purposes.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyYear rdf:type rdf:Property ;
    rdfs:label 'Policy Year' ;
    rdfs:comment 'The year in which the policy that generated the loss was written or incepted. Used as an alternative origin period dimension alongside accident year.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceExtractTimestamp rdf:type rdf:Property ;
    rdfs:label 'Source Extract Timestamp' ;
    rdfs:comment 'Timestamp when the triangle data was extracted from the source actuarial reserving system. Used for data lineage, reconciliation, and audit trail in the Snowflake lakehouse.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statLineCode rdf:type rdf:Property ;
    rdfs:label 'Stat Line Code' ;
    rdfs:comment 'NAIC statutory line of business code used for Schedule P and other statutory filings. Maps internal LOB codes to NAIC-defined reporting lines.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tailFactor rdf:type rdf:Property ;
    rdfs:label 'Tail Factor' ;
    rdfs:comment 'Loss development factor applied beyond the last observed development age to project losses from the oldest observed age to ultimate. Critical for long-tail lines such as WC and CGL.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triangleReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Triangle Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to this triangle run or evaluation, used for cross-referencing actuarial reports and bordereaux.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triangleStatus rdf:type rdf:Property ;
    rdfs:label 'Triangle Status' ;
    rdfs:comment 'Lifecycle status of the development triangle record indicating whether it is a working draft, preliminary estimate, final actuarial selection, superseded, or archived.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triangleType rdf:type rdf:Property ;
    rdfs:label 'Triangle Type' ;
    rdfs:comment 'Classifies the triangle by the loss measure it tracks: paid loss, incurred loss, paid ALAE, incurred ALAE, paid LAE, or case reserve. [ENUM-REF-CANDIDATE: paid_loss|incurred_loss|paid_alae|incurred_alae|paid_lae|case_reserve — promote to reference product]' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wpAmount rdf:type rdf:Property ;
    rdfs:label 'Wp Amount' ;
    rdfs:comment 'Gross written premium for the origin period associated with this triangle segment. Used as an alternative exposure base and for premium development triangles.' ;
    rdfs:domain ind:DevelopmentTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnrEstimateId rdf:type rdf:Property ;
    rdfs:label 'Ibnr Estimate Id' ;
    rdfs:comment 'Unique surrogate primary key for the IBNR estimate record. Role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialAnalystId rdf:type rdf:Property ;
    rdfs:label 'Actuarial Analyst Id' ;
    rdfs:comment 'Reference to the internal party record of the credentialed actuary or actuarial analyst responsible for preparing and signing off on this IBNR estimate.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ActuarialAnalyst .

ind:actuarialMethod rdf:type rdf:Property ;
    rdfs:label 'Actuarial Method' ;
    rdfs:comment 'Primary actuarial method used to derive this estimate (e.g., Chain Ladder, Bornhuetter-Ferguson, Cape Cod, Clark LDF, Frequency-Severity). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialNotes rdf:type rdf:Property ;
    rdfs:label 'Actuarial Notes' ;
    rdfs:comment 'Free-text field for actuarial commentary, methodology rationale, data anomalies, or qualitative judgments supporting the IBNR estimate, as required by ASOP No. 43.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Case Reserve Amount' ;
    rdfs:comment 'Total outstanding case reserves held on open claims for the LOB and accident year as of the evaluation date, representing the known but unpaid loss liability.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Reserve Amount' ;
    rdfs:comment 'Portion of the IBNR reserve ceded to reinsurers under applicable treaty and facultative agreements, equal to gross minus net reserve amounts.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Confidence Level' ;
    rdfs:comment 'Statistical confidence level (as a percentage, e.g., 75.00 for 75th percentile) at which the IBNR estimate is stated, per actuarial range analysis or stochastic modeling.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'Name of the actuarial reserving or source system from which this IBNR estimate was extracted (e.g., Milliman Arius, Willis Towers Watson ResQ, Snowflake).' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimateReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Estimate Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for this actuarial bulk-reserve estimate, used in bordereaux, statutory filings, and actuarial reports.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimateStatus rdf:type rdf:Property ;
    rdfs:label 'Estimate Status' ;
    rdfs:comment 'Current lifecycle state of the IBNR estimate record within the actuarial review and approval workflow.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingPeriod rdf:type rdf:Property ;
    rdfs:label 'Filing Period' ;
    rdfs:comment 'Statutory reporting period for which this IBNR estimate is prepared, formatted as Q1-YYYY, Q2-YYYY, Q3-YYYY, Q4-YYYY, or ANNUAL-YYYY.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'High Estimate Amount' ;
    rdfs:comment 'Upper bound of the actuarial range of reasonable IBNR estimates, typically corresponding to a higher confidence percentile or adverse scenario.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCatEstimate rdf:type rdf:Property ;
    rdfs:label 'Is Cat Estimate' ;
    rdfs:comment 'Indicates whether this IBNR estimate is specifically associated with a catastrophe event. True when cat_code is populated and the estimate is CAT-segregated.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ldfSelected rdf:type rdf:Property ;
    rdfs:label 'Ldf Selected' ;
    rdfs:comment 'Actuarially selected cumulative loss development factor (tail factor) applied to reported or paid losses to project to ultimate for this accident year and evaluation age.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lobName rdf:type rdf:Property ;
    rdfs:label 'Lob Name' ;
    rdfs:comment 'Human-readable name of the Line of Business corresponding to lob_code (e.g., Commercial General Liability, Workers Compensation, Auto Physical Damage).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Low Estimate Amount' ;
    rdfs:comment 'Lower bound of the actuarial range of reasonable IBNR estimates, typically corresponding to a lower confidence percentile or optimistic scenario.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netOfReinsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Net Of Reinsurance Amount' ;
    rdfs:comment 'IBNR reserve amount net of reinsurance recoveries, reflecting the retained liability after cession under quota share, XOL, and facultative treaties.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidLossesAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Losses Amount' ;
    rdfs:comment 'Cumulative loss payments made for the LOB and accident year as of the evaluation date, used as the paid loss diagonal in actuarial development triangles.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentUnreported rdf:type rdf:Property ;
    rdfs:label 'Percent Unreported' ;
    rdfs:comment 'Estimated proportion of ultimate losses not yet reported as of the evaluation date, derived as 1 minus the inverse of the selected cumulative LDF.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Reserve Amount' ;
    rdfs:comment 'Total bulk reserve amount from the immediately preceding evaluation period for the same LOB and accident year, used to compute reserve development and redundancy/deficiency.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportedLossesAmount rdf:type rdf:Property ;
    rdfs:label 'Reported Losses Amount' ;
    rdfs:comment 'Cumulative paid losses plus outstanding case reserves (OCR) for the LOB and accident year as of the evaluation date, forming the reported diagonal of the loss triangle.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveDevelopmentAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Development Amount' ;
    rdfs:comment 'Change in total reserve from prior period to current evaluation date (current minus prior). Positive indicates adverse development; negative indicates favorable development.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statutoryBasis rdf:type rdf:Property ;
    rdfs:label 'Statutory Basis' ;
    rdfs:comment 'Accounting basis under which this IBNR estimate is prepared: SAP (Statutory Accounting Principles), GAAP (US Generally Accepted Accounting Principles), or IFRS 17.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Total Reserve Amount' ;
    rdfs:comment 'Sum of IBNR, IBNER, and ULAE reserve amounts representing the total actuarial bulk reserve position for this LOB, accident year, and evaluation date.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Amount' ;
    rdfs:comment 'Actuarially projected ultimate incurred loss amount for the LOB and accident year, equal to reported losses plus IBNR plus IBNER.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateLossRatio rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Ratio' ;
    rdfs:comment 'Actuarially estimated ultimate loss ratio for this LOB and accident year as of the evaluation date, computed as ultimate losses divided by earned premium.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laeAllocationId rdf:type rdf:Property ;
    rdfs:label 'Lae Allocation Id' ;
    rdfs:comment 'Unique surrogate primary key for each LAE allocation record in the Databricks Silver layer.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedAllocationId rdf:type rdf:Property ;
    rdfs:label 'Reversed Allocation Id' ;
    rdfs:comment 'Reference to the original LAE allocation record that this record reverses. Null when reversal_indicator is false. Supports audit trail and GL reconciliation.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LaeAllocation .

ind:accountingPeriodDate rdf:type rdf:Property ;
    rdfs:label 'Accounting Period Date' ;
    rdfs:comment 'First day of the accounting period (month/quarter/year) to which this LAE allocation is posted in the general ledger for statutory and GAAP financials.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'Gross allocated LAE amount in the reporting currency for this record. Core input to combined ratio (CR) and expense ratio (ER) calculations.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasis rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis' ;
    rdfs:comment 'Statistical basis used when applying a pro-rata or exposure-based allocation method, such as claim count or earned premium (EP) weighting.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Date' ;
    rdfs:comment 'The business event date on which the LAE cost was allocated to the claim or claim group. Used for period-matching in statutory and GAAP reporting.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Method used to allocate LAE costs to claims or claim groups. Drives actuarial credibility and combined ratio (CR) accuracy per NAIC and FASB guidance.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Number' ;
    rdfs:comment 'Externally visible business identifier for this LAE allocation record, used in bordereaux, statutory filings, and actuarial reports.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Status' ;
    rdfs:comment 'Current workflow state of the LAE allocation record, controlling whether it is included in statutory and GAAP financial reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Date' ;
    rdfs:comment 'Date on which the required authorization level approved this LAE allocation, providing an audit trail for SOX and regulatory compliance.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationLevel rdf:type rdf:Property ;
    rdfs:label 'Authorization Level' ;
    rdfs:comment 'Approval authority level required and applied for this LAE allocation, supporting SOX internal controls and claims expense governance.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Expense Category Code' ;
    rdfs:comment 'Standardized code classifying the type of LAE expense (e.g., legal fees, expert witness, adjuster fees, salvage/subrogation costs). [ENUM-REF-CANDIDATE: legal|adjuster|expert_witness|salvage_subro|medical_review|other — promote to reference product]' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseCategoryDescription rdf:type rdf:Property ;
    rdfs:label 'Expense Category Description' ;
    rdfs:comment 'Human-readable description of the LAE expense category, providing context for actuarial and finance reporting beyond the category code.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCatEvent rdf:type rdf:Property ;
    rdfs:label 'Is Cat Event' ;
    rdfs:comment 'Indicates whether this LAE allocation is associated with a catastrophe (CAT) event, enabling separate CAT LAE tracking for reinsurance and regulatory reporting.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laeType rdf:type rdf:Property ;
    rdfs:label 'Lae Type' ;
    rdfs:comment 'Distinguishes Allocated Loss Adjustment Expense (ALAE) directly tied to a specific claim from Unallocated Loss Adjustment Expense (ULAE) spread across claim groups.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Net Lae Amount' ;
    rdfs:comment 'Net LAE amount after deducting reinsurance recoverables. Used in net combined ratio (CR) and net expense ratio (ER) statutory and GAAP reporting.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Indicates this record is a reversal of a previously posted LAE allocation. When true, the reversed_allocation_id identifies the original record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riRecoverableLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Lae Amount' ;
    rdfs:comment 'Portion of the allocated LAE recoverable from reinsurers under treaty or facultative (FAC) agreements, used to derive net LAE for statutory reporting.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceType rdf:type rdf:Property ;
    rdfs:label 'Service Type' ;
    rdfs:comment 'Type of professional service generating the LAE cost. Supports granular expense ratio (ER) analysis by service category. [ENUM-REF-CANDIDATE: promote if values exceed 6]' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionRef rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Ref' ;
    rdfs:comment 'Native transaction identifier from the originating source system (e.g., Guidewire ClaimCenter payment ID), enabling cross-system audit and reconciliation.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorInvoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Invoice Number' ;
    rdfs:comment 'Invoice reference number from the external vendor providing LAE services, used for accounts payable reconciliation and audit trail.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredCurrencyId rdf:type rdf:Property ;
    rdfs:label 'Preferred Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: Payee currency preference drives payment processing, FX conversion decisions, and international wire transfers. Preferred_currency_code denormalizes currency master data.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:achAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Ach Authorization Date' ;
    rdfs:comment 'Date on which the payee authorized ACH direct deposit, establishing the NACHA-required authorization record.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backupWithholdingFlag rdf:type rdf:Property ;
    rdfs:label 'Backup Withholding Flag' ;
    rdfs:comment 'Indicates whether IRS-mandated backup withholding at the statutory rate applies to payments made to this payee.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankAccountType rdf:type rdf:Property ;
    rdfs:label 'Bank Account Type' ;
    rdfs:comment 'Type of bank account (checking or savings) used for ACH disbursements to this payee.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:form1099Type rdf:type rdf:Property ;
    rdfs:label 'Form 1099 Type' ;
    rdfs:comment 'Specifies the IRS 1099 form variant applicable to this payee (e.g., 1099-MISC for miscellaneous income, 1099-NEC for non-employee compensation).' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:is1099Reportable rdf:type rdf:Property ;
    rdfs:label 'Is 1099 Reportable' ;
    rdfs:comment 'Indicates whether payments to this payee must be reported to the IRS on Form 1099. Drives annual 1099 extract and filing.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAttorney rdf:type rdf:Property ;
    rdfs:label 'Is Attorney' ;
    rdfs:comment 'Indicates the payee is a legal representative (attorney or law firm) receiving settlement or fee payments on behalf of a claimant.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isClaimant rdf:type rdf:Property ;
    rdfs:label 'Is Claimant' ;
    rdfs:comment 'Indicates the payee is a first-party or third-party claimant receiving indemnity loss payments.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMedicalProvider rdf:type rdf:Property ;
    rdfs:label 'Is Medical Provider' ;
    rdfs:comment 'Indicates the payee is a licensed medical provider receiving direct payment for bodily injury (BI), PIP, or MedPay claim services.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseState rdf:type rdf:Property ;
    rdfs:label 'License State' ;
    rdfs:comment 'Two-letter state code of the jurisdiction that issued the payee professional or contractor license.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npiNumber rdf:type rdf:Property ;
    rdfs:label 'Npi Number' ;
    rdfs:comment 'CMS-issued National Provider Identifier for medical provider payees. Required for BI, PIP, and MedPay direct payment processing.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreenDate rdf:type rdf:Property ;
    rdfs:label 'Ofac Screen Date' ;
    rdfs:comment 'Most recent date on which the payee was screened against the OFAC SDN and consolidated sanctions lists.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ofacScreenResult rdf:type rdf:Property ;
    rdfs:label 'Ofac Screen Result' ;
    rdfs:comment 'Outcome of the most recent OFAC sanctions screening. Confirmed matches block payment disbursement.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreenedFlag rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened Flag' ;
    rdfs:comment 'Indicates whether the payee has been screened against the OFAC Specially Designated Nationals (SDN) list prior to payment.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payeeStatus rdf:type rdf:Property ;
    rdfs:label 'Payee Status' ;
    rdfs:comment 'Current lifecycle status of the payee record, controlling eligibility to receive loss payments.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentBlockFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Block Flag' ;
    rdfs:comment 'Indicates that all payments to this payee are currently blocked, typically due to OFAC match, fraud investigation, or legal hold.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentBlockReason rdf:type rdf:Property ;
    rdfs:label 'Payment Block Reason' ;
    rdfs:comment 'Reason code explaining why payments to this payee are blocked. Required when payment_block_flag is true.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdType rdf:type rdf:Property ;
    rdfs:label 'Tax Id Type' ;
    rdfs:comment 'Classifies the tax_id as SSN (Social Security Number), FEIN (Federal Employer Identification Number), ITIN, or EIN for correct IRS reporting.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Tin Verification Date' ;
    rdfs:comment 'Date on which the payee TIN was last verified through the IRS TIN matching program.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tinVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Tin Verified Flag' ;
    rdfs:comment 'Indicates whether the payee TIN has been verified against IRS TIN matching program prior to issuing payment.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:w9ReceivedDate rdf:type rdf:Property ;
    rdfs:label 'W9 Received Date' ;
    rdfs:comment 'Date on which the IRS Form W-9 was received from the payee, establishing the basis for backup withholding exemption.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:w9ReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'W9 Received Flag' ;
    rdfs:comment 'Indicates whether a completed IRS Form W-9 (Request for Taxpayer Identification Number) has been received from the payee.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentApprovalId rdf:type rdf:Property ;
    rdfs:label 'Payment Approval Id' ;
    rdfs:comment 'Unique surrogate identifier for the payment approval workflow record. Primary key for the payment_approval entity in the reserves_payments domain.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Payment Adjuster Id' ;
    rdfs:comment 'Reference to the party record of the supervisor or manager designated to approve or deny this payment request.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:paymentAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Payment Authority Id' ;
    rdfs:comment 'Foreign key linking to reservespayments.payment_authority. Business justification: Payment approvals should reference the specific payment_authority record that defines the approval threshold and escalation rules.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentAuthority .

ind:paymentEscalatedToAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Payment Escalated To Adjuster Id' ;
    rdfs:comment 'Reference to the party record of the higher-level approver to whom the request was escalated when the original approver could not decide.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:paymentRequestorAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Payment Requestor Adjuster Id' ;
    rdfs:comment 'Reference to the adjuster or staff member who initiated the payment approval request.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:approvalChannel rdf:type rdf:Property ;
    rdfs:label 'Approval Channel' ;
    rdfs:comment 'Method or channel through which the approver rendered their decision (system workflow, email, phone, in-person, or delegated authority).' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Approval Reference Number' ;
    rdfs:comment 'Externally visible alphanumeric reference number uniquely identifying this approval request, used in correspondence and audit trails.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalType rdf:type rdf:Property ;
    rdfs:label 'Approval Type' ;
    rdfs:comment 'Category of approval required based on payment amount, coverage type, or claim complexity. Determines routing and authority level.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Amount' ;
    rdfs:comment 'Dollar amount authorized by the approver. May be less than requested amount in cases of partial approval. Null if not yet decided.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimOfficeCode rdf:type rdf:Property ;
    rdfs:label 'Claim Office Code' ;
    rdfs:comment 'Code identifying the claims handling office or unit responsible for the claim associated with this payment approval request.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialReasonNotes rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Notes' ;
    rdfs:comment 'Free-text narrative provided by the approver explaining the basis for denying the payment request, supplementing the denial reason code.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'Numeric count of escalation steps this approval request has undergone. Zero indicates no escalation; increments with each escalation event.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fraudReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Referral Flag' ;
    rdfs:comment 'Indicates the payment was flagged for special investigation unit (SIU) review due to suspected fraud, requiring additional approval scrutiny.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLargeLoss rdf:type rdf:Property ;
    rdfs:label 'Is Large Loss' ;
    rdfs:comment 'Flags the payment as a large loss requiring enhanced oversight, typically triggered when requested amount exceeds a defined threshold.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOverride rdf:type rdf:Property ;
    rdfs:label 'Is Override' ;
    rdfs:comment 'Indicates whether this approval involved an override of a system-generated recommendation or standard authority limit.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSlaBreached rdf:type rdf:Property ;
    rdfs:label 'Is Sla Breached' ;
    rdfs:comment 'Indicates whether the approval decision was rendered after the SLA due date, triggering regulatory or operational escalation.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideJustification rdf:type rdf:Property ;
    rdfs:label 'Override Justification' ;
    rdfs:comment 'Mandatory free-text explanation when an approver overrides a system recommendation or approves outside normal authority parameters.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentCategory rdf:type rdf:Property ;
    rdfs:label 'Payment Category' ;
    rdfs:comment 'Classification of the payment by loss category: indemnity, ALAE (Allocated Loss Adjustment Expense), ULAE, subrogation recovery, salvage, medical, or legal fee.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceRecoverableFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Flag' ;
    rdfs:comment 'Indicates a portion of the approved payment is expected to be recovered from a reinsurance treaty or facultative certificate.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestDate rdf:type rdf:Property ;
    rdfs:label 'Request Date' ;
    rdfs:comment 'Calendar date on which the adjuster submitted the payment for supervisory or management approval.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestTimestamp rdf:type rdf:Property ;
    rdfs:label 'Request Timestamp' ;
    rdfs:comment 'Precise date and time the payment approval request was submitted, used for SLA tracking and audit trail purposes.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requestedAmount rdf:type rdf:Property ;
    rdfs:label 'Requested Amount' ;
    rdfs:comment 'Gross dollar amount submitted by the adjuster for approval. May differ from final approved amount if partially approved.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sirDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Sir Deductible Amount' ;
    rdfs:comment 'Dollar amount of the SIR or policy deductible to be applied against the approved payment, reducing the insurer net payment obligation.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Target date by which the approver must render a decision per internal SLA or state-mandated prompt payment requirements.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supportingDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Ref' ;
    rdfs:comment 'Reference identifier to the document management system (e.g., OpenText or FileNet) for supporting documentation attached to the approval request.' ;
    rdfs:domain ind:PaymentApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDelegatedByAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Payment Delegated By Adjuster Id' ;
    rdfs:comment 'Reference to the supervisor or manager who granted this delegated payment authority, providing audit trail for SOX compliance.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:paymentEscalationAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Payment Escalation Adjuster Id' ;
    rdfs:comment 'Reference to the next-level adjuster, supervisor, or manager to whom payments exceeding this authority limit are automatically escalated.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:adjusterRole rdf:type rdf:Property ;
    rdfs:label 'Adjuster Role' ;
    rdfs:comment 'Functional role of the adjuster to which this authority applies, e.g., Staff Adjuster, Senior Adjuster, Supervisor, Manager. [ENUM-REF-CANDIDATE: staff_adjuster|senior_adjuster|supervisor|manager|director|vp — promote to reference product]' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advancePaymentAllowed rdf:type rdf:Property ;
    rdfs:label 'Advance Payment Allowed' ;
    rdfs:comment 'Indicates whether the adjuster is authorized to issue advance payments on open claims under this authority record.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:advancePaymentLimit rdf:type rdf:Property ;
    rdfs:label 'Advance Payment Limit' ;
    rdfs:comment 'Maximum dollar amount of an advance payment the adjuster may issue on an open claim when advance_payment_allowed is true.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aggregatePaymentLimit rdf:type rdf:Property ;
    rdfs:label 'Aggregate Payment Limit' ;
    rdfs:comment 'Maximum cumulative payment amount the adjuster may approve on a single claim across all transactions before escalation is required.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalWorkflowCode rdf:type rdf:Property ;
    rdfs:label 'Approval Workflow Code' ;
    rdfs:comment 'Code referencing the specific ClaimCenter approval workflow rule set triggered when a payment approaches or exceeds this authority limit.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityCode rdf:type rdf:Property ;
    rdfs:label 'Authority Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this payment authority rule, used in bordereaux and audit references.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityNotes rdf:type rdf:Property ;
    rdfs:label 'Authority Notes' ;
    rdfs:comment 'Free-text notes capturing special conditions, exceptions, or context for this payment authority record, e.g., temporary elevation during CAT response.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegationBasis rdf:type rdf:Property ;
    rdfs:label 'Delegation Basis' ;
    rdfs:comment 'Basis on which authority is delegated: by role (all holders of the role), individual (named adjuster), temporary delegation, TPA, or vendor.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegationDate rdf:type rdf:Property ;
    rdfs:label 'Delegation Date' ;
    rdfs:comment 'Date on which the payment authority was formally delegated or granted to the adjuster by the authorizing manager.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dualApprovalThreshold rdf:type rdf:Property ;
    rdfs:label 'Dual Approval Threshold' ;
    rdfs:comment 'Dollar amount at or above which dual approval is required for a payment, when requires_dual_approval is true.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationPathDescription rdf:type rdf:Property ;
    rdfs:label 'Escalation Path Description' ;
    rdfs:comment 'Narrative description of the escalation chain for payments exceeding this authority, e.g., \'Supervisor → Manager → VP Claims\'.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCatAuthority rdf:type rdf:Property ;
    rdfs:label 'Is Cat Authority' ;
    rdfs:comment 'Indicates whether this authority record is specifically designated for CAT event claims handling, enabling surge-capacity payment processing.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:litigationPaymentAllowed rdf:type rdf:Property ;
    rdfs:label 'Litigation Payment Allowed' ;
    rdfs:comment 'Indicates whether this authority permits payment on litigated claims. Litigated claims often require elevated authority or legal department co-approval.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresDualApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Dual Approval' ;
    rdfs:comment 'Indicates whether payments at or near this authority limit require a second approver signature before disbursement, per SOX dual-control requirements.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveChangeLimit rdf:type rdf:Property ;
    rdfs:label 'Reserve Change Limit' ;
    rdfs:comment 'Maximum dollar amount of a single reserve increase or decrease the adjuster may authorize without supervisor approval.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Frequency' ;
    rdfs:comment 'Scheduled frequency at which this payment authority limit must be reviewed and reaffirmed by management per internal controls policy.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:singlePaymentLimit rdf:type rdf:Property ;
    rdfs:label 'Single Payment Limit' ;
    rdfs:comment 'Maximum dollar amount the adjuster may approve for a single payment transaction without escalation. Core threshold enforced in ClaimCenter payment workflow.' ;
    rdfs:domain ind:PaymentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalPaymentPaymentTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Payment Payment Transaction Id' ;
    rdfs:comment 'Self-referencing link to the original payment_transaction_id when this record is a reissue or replacement. Null for original payments.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentTransaction .

ind:reservespaymentsLossReserveId rdf:type rdf:Property ;
    rdfs:label 'Reservespayments Loss Reserve Id' ;
    rdfs:comment 'Reference to the case reserve line from which this payment is drawn, enabling reserve-to-payment reconciliation and OCR tracking.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReservespaymentsLossReserve .

ind:bankClearingDate rdf:type rdf:Property ;
    rdfs:label 'Bank Clearing Date' ;
    rdfs:comment 'Date the payment instrument cleared the issuing bank account. Used for cash management, bank reconciliation, and float analysis.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deductionAmount rdf:type rdf:Property ;
    rdfs:label 'Deduction Amount' ;
    rdfs:comment 'Total amount withheld from gross payment for SIR offsets, deductibles, liens, or tax withholding before net disbursement to payee.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glJournalReference rdf:type rdf:Property ;
    rdfs:label 'Gl Journal Reference' ;
    rdfs:comment 'Reference to the GL journal entry created in Oracle Financials or SAP FI for this payment. Supports audit trail and financial reconciliation.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineOfBusinessCode rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Code' ;
    rdfs:comment 'NAIC line of business code classifying the insurance product line for this payment. Used in statutory Schedule P and combined ratio reporting.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeTaxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Payee Tax Identification Number' ;
    rdfs:comment 'Federal tax identifier (SSN or FEIN) of the payee. Required for IRS 1099 reporting on claim payments exceeding statutory thresholds.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNotes rdf:type rdf:Property ;
    rdfs:label 'Payment Notes' ;
    rdfs:comment 'Free-text adjuster or AP notes describing special payment instructions, lien conditions, co-payee requirements, or other disbursement details.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueDate rdf:type rdf:Property ;
    rdfs:label 'Reissue Date' ;
    rdfs:comment 'Date a replacement payment was reissued following a void or stop-payment. Links to the original payment via original_payment_number.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Flag' ;
    rdfs:comment 'Indicates this payment has an associated subrogation recovery opportunity. Triggers SubroFT workflow in ClaimCenter for third-party recovery pursuit.' ;
    rdfs:domain ind:PaymentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryTransactionId rdf:type rdf:Property ;
    rdfs:label 'Recovery Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each recovery transaction record in the reserves and payments domain.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recoveredPaymentTransactionId rdf:type rdf:Property ;
    rdfs:label 'Recovered Payment Transaction Id' ;
    rdfs:comment 'Foreign key linking to reservespayments.payment_transaction. Business justification: Recovery transactions (subrogation, salvage, reinsurance recoveries) often relate to specific payment transactions that were previously issued.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentTransaction .

ind:reinsuranceRecoverableId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Id' ;
    rdfs:comment 'Foreign key linking to reservespayments.reinsurance_recoverable. Business justification: When recovery_transaction.recovery_type = \'Reinsurance Recovery\', it should link to the reinsurance_recoverable master record.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReinsuranceRecoverable .

ind:reservespaymentsClaimPaymentId rdf:type rdf:Property ;
    rdfs:label 'Reservespayments Claim Payment Id' ;
    rdfs:comment 'Reference to the specific claim payment disbursement that this recovery offsets or partially recovers.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReservespaymentsClaimPayment .

ind:salvageItemId rdf:type rdf:Property ;
    rdfs:label 'Salvage Item Id' ;
    rdfs:comment 'Foreign key linking to reservespayments.salvage_item. Business justification: When recovery_transaction.recovery_type = \'Salvage\', it should link to the salvage_item master record. This enables tracking which salvage item generated which recovery.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SalvageItem .

ind:subrogationCaseId rdf:type rdf:Property ;
    rdfs:label 'Subrogation Case Id' ;
    rdfs:comment 'Foreign key linking to reservespayments.subrogation_case. Business justification: When recovery_transaction.recovery_type = \'Subrogation\', it should link to the subrogation_case master record.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubrogationCase .

ind:atFaultPartyInsurer rdf:type rdf:Property ;
    rdfs:label 'At Fault Party Insurer' ;
    rdfs:comment 'Name of the liability insurer of the at-fault third party. Used to direct subrogation demands and track inter-company recovery negotiations.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atFaultPartyName rdf:type rdf:Property ;
    rdfs:label 'At Fault Party Name' ;
    rdfs:comment 'Legal name of the third party against whom subrogation or recovery action is pursued. Restricted PII when the party is an individual.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atFaultPartyPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'At Fault Party Policy Number' ;
    rdfs:comment 'Policy number of the at-fault third party\'s liability insurance. Used to identify the adverse carrier and track subrogation demand status.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionAttorneyFirm rdf:type rdf:Property ;
    rdfs:label 'Collection Attorney Firm' ;
    rdfs:comment 'Name of the external law firm or collection agency engaged to pursue the recovery action. Used for vendor management and ALAE expense tracking.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Collection Expense Amount' ;
    rdfs:comment 'Allocated Loss Adjustment Expense (ALAE) incurred to collect this recovery, including attorney fees, investigation costs, and court costs.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Recovery Amount' ;
    rdfs:comment 'Total gross amount recovered before deducting collection expenses, attorney fees, or reinsurance shares. Represents the full inbound recovery value.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initiatedDate rdf:type rdf:Property ;
    rdfs:label 'Initiated Date' ;
    rdfs:comment 'Date on which the recovery action was formally initiated (e.g., subrogation demand letter sent, salvage auction listed, reinsurance proof of loss submitted).' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isIntercompany rdf:type rdf:Property ;
    rdfs:label 'Is Intercompany' ;
    rdfs:comment 'Indicates whether this recovery involves an affiliated entity within the same insurance group. Triggers intercompany elimination in consolidated financial statements.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Net Recovery Amount' ;
    rdfs:comment 'Net recovery amount after deducting collection expenses from gross recovery. Represents the actual benefit to the insurer for loss ratio and reserve release purposes.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netRetainedRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Net Retained Recovery Amount' ;
    rdfs:comment 'Recovery amount retained by the insurer after deducting both collection expenses and the reinsurance share. Used for net loss ratio and financial reporting.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Recovery Method' ;
    rdfs:comment 'Mechanism by which the recovery proceeds were received: check, wire transfer, ACH, offset against payable, or credit note from reinsurer.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Recovery Reference Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier assigned to this recovery transaction, used in bordereaux, correspondence, and statutory reporting.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveReleaseAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Release Amount' ;
    rdfs:comment 'Amount of outstanding case reserve (OCR) released upon collection or closure of this recovery transaction. Used for reserve development reporting.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riShareAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Share Amount' ;
    rdfs:comment 'Portion of the gross recovery that must be remitted to reinsurers per treaty or facultative (FAC) agreement terms. Reduces net recovery retained by the cedant.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:secondInjuryFundState rdf:type rdf:Property ;
    rdfs:label 'Second Injury Fund State' ;
    rdfs:comment 'Two-letter state code of the Second Injury Fund from which recovery is sought in Workers Compensation (WC) claims. Null for non-WC or non-SIF recovery types.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statuteOfLimitationsDate rdf:type rdf:Property ;
    rdfs:label 'Statute Of Limitations Date' ;
    rdfs:comment 'Date by which legal action must be filed to preserve the recovery right. Critical for subrogation diary management and write-off decisions.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationDemandAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Demand Amount' ;
    rdfs:comment 'Full demand amount asserted against the at-fault third party in a subrogation (SubroFT) action. May exceed gross recovery if partial collection occurs.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Reason code explaining why a recovery was written off without full collection: uncollectible, statute expired, negotiated settlement, insolvency, or waived.' ;
    rdfs:domain ind:RecoveryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cessionReference rdf:type rdf:Property ;
    rdfs:label 'Cession Reference' ;
    rdfs:comment 'The cession or bordereau line reference assigned by the reinsurance management system (SICS/ReinsuranceMaster) linking this recoverable to its originating cession transaction.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Collectability Status' ;
    rdfs:comment 'Assessment of the likelihood of collecting the outstanding recoverable from the reinsurer. Drives NAIC Schedule F Part 3 aged-debt disclosure and allowance for uncollectible RI.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Collection Date' ;
    rdfs:comment 'Date of the most recent cash receipt from the reinsurer against this recoverable. Used for aged-debt analysis and NAIC Schedule F Part 3 overdue recoverable identification.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceType rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Type' ;
    rdfs:comment 'Indicates whether the recoverable arises under a proportional/non-proportional treaty arrangement or a facultative (FAC) certificate placed on a specific risk.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerCreditRating rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Credit Rating' ;
    rdfs:comment 'A.M. Best or S&P financial strength rating of the reinsurer at the valuation date. Used to assess collectability risk and support NAIC Schedule F Part 3 disclosures.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerNaicCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code assigned to the reinsurer. Required for NAIC Schedule F statutory reporting and state DOI filings identifying authorized vs. unauthorized reinsurers.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riRecoverableAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Alae Amount' ;
    rdfs:comment 'The ALAE portion of the total reinsurance recoverable, calculated as gross ALAE multiplied by the RI share where the treaty includes LAE coverage.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoverableLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Loss Amount' ;
    rdfs:comment 'The gross loss amount multiplied by the RI share percentage, representing the total loss amount recoverable from the reinsurer under this cession before any collections.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoverableTotalAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Total Amount' ;
    rdfs:comment 'Sum of RI recoverable loss and RI recoverable ALAE amounts. Represents the total gross amount due from the reinsurer before collections and any collectability adjustments.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riSharePercent rdf:type rdf:Property ;
    rdfs:label 'Ri Share Percent' ;
    rdfs:comment 'The percentage of the gross loss ceded to the reinsurer under the applicable treaty or FAC certificate. For QS treaties this is the cession rate; for XOL it reflects the layer participation.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uncollectibleAmount rdf:type rdf:Property ;
    rdfs:label 'Uncollectible Amount' ;
    rdfs:comment 'Amount of the outstanding recoverable deemed uncollectible due to reinsurer insolvency, dispute, or credit impairment. Reduces the net asset on the NAIC Schedule F Part 3 aged analysis.' ;
    rdfs:domain ind:ReinsuranceRecoverable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Reserve Evaluation Id' ;
    rdfs:comment 'Unique surrogate identifier for each periodic actuarial reserve evaluation record. Primary key for the reserve_evaluation data product in the reservespayments domain.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReserveEvaluation .

ind:appointedActuaryCredential rdf:type rdf:Property ;
    rdfs:label 'Appointed Actuary Credential' ;
    rdfs:comment 'Professional credential of the Appointed Actuary (e.g., FCAS, MAAA). Required for NAIC actuarial opinion qualification and state DOI regulatory filings.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Cat Reserve Amount' ;
    rdfs:comment 'Portion of the total reserve attributable to catastrophe (CAT) events as designated by ISO/PCS or internal CAT codes. Reported separately for NAIC CAT exhibits and reinsurance recoverable analysis.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evaluationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Evaluation Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to this reserve evaluation cycle, used in actuarial opinion filings, NAIC Schedule P submissions, and bordereaux reporting.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationStatus rdf:type rdf:Property ;
    rdfs:label 'Evaluation Status' ;
    rdfs:comment 'Current workflow state of the reserve evaluation, from initial draft through actuarial sign-off, management approval, and statutory filing. Drives sign-off and audit controls.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossCaseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Case Reserve Amount' ;
    rdfs:comment 'Total gross (before reinsurance) outstanding case reserve amount as of the evaluation date, representing the estimated liability for known reported claims. Expressed in USD.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossIbnerAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Ibner Amount' ;
    rdfs:comment 'Gross IBNER component of the total IBNR reserve, representing development on known claims where current case reserves are estimated to be inadequate.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossIbnrAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Ibnr Amount' ;
    rdfs:comment 'Gross IBNR reserve amount as of the evaluation date, covering losses incurred but not yet reported to the insurer. Includes pure IBNR and IBNER components.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossTotalReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Total Reserve Amount' ;
    rdfs:comment 'Sum of gross case reserves and gross IBNR/IBNER as of the evaluation date. Represents the total gross reserve position before reinsurance recoverables.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incurredLossesToDate rdf:type rdf:Property ;
    rdfs:label 'Incurred Losses To Date' ;
    rdfs:comment 'Cumulative gross incurred losses (paid plus case reserves) as of the evaluation date for the accident year and LOB. Primary input to the Bornhuetter-Ferguson and chain-ladder methods.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCaseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Net Case Reserve Amount' ;
    rdfs:comment 'Net (after reinsurance cession) outstanding case reserve amount as of the evaluation date. Reflects the insurer\'s retained liability on known reported claims.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netIbnrAmount rdf:type rdf:Property ;
    rdfs:label 'Net Ibnr Amount' ;
    rdfs:comment 'Net IBNR reserve amount after reinsurance recoverables as of the evaluation date. Used for net reserve adequacy testing and statutory surplus calculations.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netTotalReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Net Total Reserve Amount' ;
    rdfs:comment 'Total net reserve position (case + IBNR) after reinsurance recoverables as of the evaluation date. Key metric for statutory surplus and solvency reporting.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:opinionType rdf:type rdf:Property ;
    rdfs:label 'Opinion Type' ;
    rdfs:comment 'The type of actuarial opinion rendered on reserve adequacy: reasonable, deficient, excessive, qualified, or no opinion. Directly reported in NAIC statutory filings.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidLossesToDate rdf:type rdf:Property ;
    rdfs:label 'Paid Losses To Date' ;
    rdfs:comment 'Cumulative gross losses paid from policy inception through the evaluation date for the accident year and LOB. Used as the base for loss development triangle construction.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorEvaluationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Evaluation Date' ;
    rdfs:comment 'The as-of date of the immediately preceding reserve evaluation for the same accident year and LOB. Used to compute period-over-period reserve development.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reservingSystemSource rdf:type rdf:Property ;
    rdfs:label 'Reserving System Source' ;
    rdfs:comment 'The actuarial reserving system from which this evaluation record was sourced (e.g., Milliman Arius, Willis Towers Watson ResQ). Supports data lineage and audit traceability.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulePLine rdf:type rdf:Property ;
    rdfs:label 'Schedule P Line' ;
    rdfs:comment 'The specific NAIC Schedule P line (e.g., Line 1 - Homeowners, Line 5 - CGL) to which this reserve evaluation maps for statutory annual statement filing purposes.' ;
    rdfs:domain ind:ReserveEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ulaeReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ulae Reserve Amount' ;
    rdfs:comment 'Reserve for Unallocated Loss Adjustment Expenses not directly tied to individual claims, such as general claims department overhead. Estimated via Kittel or similar methods.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ulr rdf:type rdf:Property ;
    rdfs:label 'Ulr' ;
    rdfs:comment 'Ratio of the actuarial ultimate loss estimate to earned premium for the accident year and LOB. Key actuarial adequacy metric: ULR = ultimate_loss_estimate / ep_amount.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocatedGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Gross Amount' ;
    rdfs:comment 'Gross dollar amount of the payment allocated to this claim and coverage part before deducting recoveries, SIR, or deductibles. Basis for GWP loss ratio calculations.' ;
    rdfs:domain ind:ReservespaymentsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankClearanceDate rdf:type rdf:Property ;
    rdfs:label 'Bank Clearance Date' ;
    rdfs:comment 'Date the payment instrument cleared the issuing bank account. Confirms actual cash outflow for treasury management and outstanding check reconciliation.' ;
    rdfs:domain ind:ReservespaymentsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deductibleOffsetAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Offset Amount' ;
    rdfs:comment 'Portion of the gross payment amount withheld or offset against the insured\'s applicable deductible or SIR for this coverage part. Reduces insurer net payment.' ;
    rdfs:domain ind:ReservespaymentsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netOfRiAmount rdf:type rdf:Property ;
    rdfs:label 'Net Of Ri Amount' ;
    rdfs:comment 'Net payment amount retained by the insurer after deducting reinsurance recoverables. Equals net_payment_amount minus reinsurance_recoverable_amount. Key NWP metric.' ;
    rdfs:domain ind:ReservespaymentsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Amount' ;
    rdfs:comment 'Dollar amount recovered through salvage of damaged property associated with this claim payment. Reduces net incurred loss and is reported separately in NAIC statutory filings.' ;
    rdfs:domain ind:ReservespaymentsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationStatus rdf:type rdf:Property ;
    rdfs:label 'Subrogation Status' ;
    rdfs:comment 'Current status of subrogation pursuit for this payment allocation. Tracks whether a recovery opportunity has been identified, is being pursued, collected, or closed.' ;
    rdfs:domain ind:ReservespaymentsClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Incurred Loss Amount' ;
    rdfs:comment 'Total incurred loss = paid losses to date + current case reserve. Fundamental metric for loss ratio and reserve adequacy analysis.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initialReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Initial Reserve Amount' ;
    rdfs:comment 'Gross case reserve amount set at the time the reserve was first established. Baseline for reserve development and adequacy tracking.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastReserveChangeDate rdf:type rdf:Property ;
    rdfs:label 'Last Reserve Change Date' ;
    rdfs:comment 'Date of the most recent reserve adjustment. Supports reserve development tracking and adjuster activity monitoring.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paidAlaeToDate rdf:type rdf:Property ;
    rdfs:label 'Paid Alae To Date' ;
    rdfs:comment 'Cumulative ALAE payments made to date for this claim. Combined with paid losses to compute total incurred including LAE.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveAdequacyStatus rdf:type rdf:Property ;
    rdfs:label 'Reserve Adequacy Status' ;
    rdfs:comment 'Actuarial or adjuster assessment of whether the current reserve is adequate, deficient, or redundant relative to ultimate loss estimate.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveChangeReason rdf:type rdf:Property ;
    rdfs:label 'Reserve Change Reason' ;
    rdfs:comment 'Narrative or coded reason for the most recent reserve adjustment (e.g., new medical information, litigation update, coverage determination). [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveClosedDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Closed Date' ;
    rdfs:comment 'Date the reserve was closed or released to zero. Null if reserve remains open. Used for reserve development and closure analysis.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reserveEstablishedDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Established Date' ;
    rdfs:comment 'Date the initial case reserve was first established following FNOL or claim adjudication. Principal business event date for the reserve lifecycle.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salvageReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Reserve Amount' ;
    rdfs:comment 'Estimated recoverable amount from salvage of damaged property. Offsets gross reserve for net reserve reporting.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Reserve Amount' ;
    rdfs:comment 'Estimated recoverable amount through subrogation rights against liable third parties. Reduces net reserve and improves loss ratio.' ;
    rdfs:domain ind:ReservespaymentsLossReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservespaymentsReserveTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reservespayments Reserve Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each reserve transaction record in the loss reserve ledger.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedTransactionReservespaymentsReserveTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Transaction Reservespayments Reserve Transaction Id' ;
    rdfs:comment 'Reference to the original reserve transaction that this entry reverses, enabling full audit chain reconstruction.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReservespaymentsReserveTransaction .

ind:deltaAmount rdf:type rdf:Property ;
    rdfs:label 'Delta Amount' ;
    rdfs:comment 'The signed change in reserve amount for this transaction. Positive values indicate an increase; negative values indicate a decrease or release.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netReserveDelta rdf:type rdf:Property ;
    rdfs:label 'Net Reserve Delta' ;
    rdfs:comment 'Reserve delta net of reinsurance recoverables, representing the insurer\'s retained exposure change for this transaction.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveAmountAfter rdf:type rdf:Property ;
    rdfs:label 'Reserve Amount After' ;
    rdfs:comment 'Outstanding Case Reserve (OCR) balance immediately after this transaction is applied, representing the current reserve position.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveAmountBefore rdf:type rdf:Property ;
    rdfs:label 'Reserve Amount Before' ;
    rdfs:comment 'Outstanding Case Reserve (OCR) balance immediately prior to this transaction, enabling point-in-time reserve reconstruction.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveCloseDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Close Date' ;
    rdfs:comment 'The date on which the reserve was closed to zero, populated only for CLOSE transaction types. Null for all other transaction types.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionReasonNotes rdf:type rdf:Property ;
    rdfs:label 'Transaction Reason Notes' ;
    rdfs:comment 'Free-text narrative provided by the adjuster explaining the business rationale for this reserve movement.' ;
    rdfs:domain ind:ReservespaymentsReserveTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acvAtLoss rdf:type rdf:Property ;
    rdfs:label 'Acv At Loss' ;
    rdfs:comment 'Actual Cash Value (ACV) of the property at the Date of Loss (DOL), representing the pre-loss fair market value used as the basis for total-loss settlement.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjusterNotes rdf:type rdf:Property ;
    rdfs:label 'Adjuster Notes' ;
    rdfs:comment 'Free-text notes entered by the claims adjuster regarding the salvage item condition, disposal challenges, vendor negotiations, or other relevant operational details.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionLotNumber rdf:type rdf:Property ;
    rdfs:label 'Auction Lot Number' ;
    rdfs:comment 'Lot number assigned by the auction house for salvage items disposed of through auction channels. Used for reconciliation of auction proceeds remittances.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandedTitleFlag rdf:type rdf:Property ;
    rdfs:label 'Branded Title Flag' ;
    rdfs:comment 'Indicates whether the salvage title carries a branded designation (e.g., salvage, rebuilt, flood, junk) as required by state DMV regulations.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionAtTitle rdf:type rdf:Property ;
    rdfs:label 'Condition At Title' ;
    rdfs:comment 'Condition classification of the salvage item at the time title was acquired. [ENUM-REF-CANDIDATE: total_loss|major_damage|minor_damage|flood|fire|theft_recovery|hail|other — promote to reference product]' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalCost rdf:type rdf:Property ;
    rdfs:label 'Disposal Cost' ;
    rdfs:comment 'Total costs incurred to dispose of the salvage item including towing, storage, auction fees, environmental remediation, and administrative expenses.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposalDate rdf:type rdf:Property ;
    rdfs:label 'Disposal Date' ;
    rdfs:comment 'Date on which the salvage item was physically disposed of through the selected disposal method, triggering recognition of salvage proceeds.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disposalMethod rdf:type rdf:Property ;
    rdfs:label 'Disposal Method' ;
    rdfs:comment 'Method used to dispose of the salvage item. [ENUM-REF-CANDIDATE: auction|scrap|direct_sale|donation|return_to_insured|parts_only|other — promote to reference product]' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalHazardFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Hazard Flag' ;
    rdfs:comment 'Indicates whether the salvage item presents environmental hazards (e.g., fuel leaks, refrigerants, asbestos) requiring special handling and disposal procedures.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemDescription rdf:type rdf:Property ;
    rdfs:label 'Item Description' ;
    rdfs:comment 'Free-text description of the salvage property including make, model, year, condition, and any distinguishing characteristics relevant to valuation and disposal.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemType rdf:type rdf:Property ;
    rdfs:label 'Item Type' ;
    rdfs:comment 'Category of the physical property taken into salvage title. [ENUM-REF-CANDIDATE: vehicle|real_property|personal_property|equipment|watercraft|aircraft|other — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:make rdf:type rdf:Property ;
    rdfs:label 'Make' ;
    rdfs:comment 'Manufacturer or brand of the salvage item (e.g., Ford, Caterpillar, Carrier). Primarily used for vehicle and equipment salvage valuation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:model rdf:type rdf:Property ;
    rdfs:label 'Model' ;
    rdfs:comment 'Model designation of the salvage item as provided by the manufacturer, used in conjunction with make and year for ACV determination.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netSalvageRecovery rdf:type rdf:Property ;
    rdfs:label 'Net Salvage Recovery' ;
    rdfs:comment 'Net amount credited back to the claim calculated as salvage proceeds minus disposal costs. Reduces the ultimate net loss and is reported in statutory bordereaux.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:odometerReading rdf:type rdf:Property ;
    rdfs:label 'Odometer Reading' ;
    rdfs:comment 'Odometer reading in miles at the time of loss for vehicle salvage items. Used in ACV calculation and auction valuation. Null for non-vehicle items.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:proceedsReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Proceeds Received Date' ;
    rdfs:comment 'Date on which salvage proceeds were received and posted to the insurer\'s accounts receivable, triggering the net salvage credit to the claim reserve.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reserveCreditAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Reserve Credit Applied Flag' ;
    rdfs:comment 'Indicates whether the net salvage recovery has been credited back to the claim loss reserve in the actuarial reserving system, reducing the outstanding case reserve.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riRecoverableFlag rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Flag' ;
    rdfs:comment 'Indicates whether a portion of the salvage recovery is ceded to reinsurers under applicable treaty or facultative arrangements, requiring bordereaux reporting.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riSalvageCredit rdf:type rdf:Property ;
    rdfs:label 'Ri Salvage Credit' ;
    rdfs:comment 'Portion of net salvage recovery attributable to reinsurers under applicable cession arrangements. Reduces the reinsurance recoverable balance on the claim.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageProceeds rdf:type rdf:Property ;
    rdfs:label 'Salvage Proceeds' ;
    rdfs:comment 'Gross proceeds actually received from the disposal of the salvage item through auction, scrap, or direct sale before deducting disposal costs.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Salvage Reference Number' ;
    rdfs:comment 'Externally-known unique identifier assigned to this salvage item by the salvage vendor, auction house, or internal salvage management system.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageStatus rdf:type rdf:Property ;
    rdfs:label 'Salvage Status' ;
    rdfs:comment 'Current lifecycle state of the salvage item from title acquisition through final disposal. [ENUM-REF-CANDIDATE: pending|titled|listed|sold|scrapped|donated|returned|closed — promote to reference product]' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValueEstimate rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Estimate' ;
    rdfs:comment 'Estimated recoverable value of the salvage item at time of title acquisition, used for initial reserve credit and net loss calculation prior to actual disposal.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageVendorName rdf:type rdf:Property ;
    rdfs:label 'Salvage Vendor Name' ;
    rdfs:comment 'Name of the salvage vendor, auction house, or scrap dealer engaged to manage the disposal of the salvage item (e.g., Copart, IAA, local scrap yard).' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serialNumber rdf:type rdf:Property ;
    rdfs:label 'Serial Number' ;
    rdfs:comment 'Manufacturer serial number for non-vehicle salvage items such as equipment, electronics, or machinery. Supports title transfer and ownership verification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfLossCode rdf:type rdf:Property ;
    rdfs:label 'State Of Loss Code' ;
    rdfs:comment 'Two-letter US state code where the insured loss occurred. Governs applicable salvage regulations and statutory reporting jurisdiction.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'Physical address or facility identifier where the salvage item is stored pending disposal. Used for logistics coordination and storage cost accrual.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageStartDate rdf:type rdf:Property ;
    rdfs:label 'Storage Start Date' ;
    rdfs:comment 'Date the salvage item entered storage at the designated facility, used to calculate accrued storage costs and manage disposal timelines.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleAcquiredDate rdf:type rdf:Property ;
    rdfs:label 'Title Acquired Date' ;
    rdfs:comment 'Date on which the insurer formally acquired legal title to the salvage property following total-loss settlement payment to the insured.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleBrandType rdf:type rdf:Property ;
    rdfs:label 'Title Brand Type' ;
    rdfs:comment 'Specific brand designation applied to the salvage title by the issuing state DMV. Affects resale value and auction proceeds estimation. [ENUM-REF-CANDIDATE: salvage|rebuilt|flood|junk|parts_only|lemon|none — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleStateCode rdf:type rdf:Property ;
    rdfs:label 'Title State Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction in which the salvage title was issued. Governs title transfer requirements and branded title regulations.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLossSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Total Loss Settlement Date' ;
    rdfs:comment 'Date the total-loss claim settlement was paid to the insured, triggering the insurer\'s right to take salvage title to the damaged property.' ;
    rdfs:domain ind:SalvageItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vin rdf:type rdf:Property ;
    rdfs:label 'Vin' ;
    rdfs:comment '17-character Vehicle Identification Number (VIN) for salvage vehicles, conforming to ISO 3779. Null for non-vehicle salvage items.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearManufactured rdf:type rdf:Property ;
    rdfs:label 'Year Manufactured' ;
    rdfs:comment 'Four-digit model year or year of manufacture of the salvage item, used for ACV calculation and depreciation schedules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statReserveExhibitId rdf:type rdf:Property ;
    rdfs:label 'Stat Reserve Exhibit Id' ;
    rdfs:comment 'Unique surrogate identifier for each statutory reserve exhibit record in the NAIC Annual Statement Schedule P filing.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:developmentPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Development Period Months' ;
    rdfs:comment 'Number of months of development from the accident year origin to the valuation date, used to position the data point in the loss development triangle.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exhibitReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Exhibit Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for this statutory reserve exhibit, used in DOI filings and NAIC Annual Statement submissions.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exhibitStatus rdf:type rdf:Property ;
    rdfs:label 'Exhibit Status' ;
    rdfs:comment 'Current workflow state of the statutory reserve exhibit. [ENUM-REF-CANDIDATE: draft|under_review|certified|filed|amended|superseded — promote to reference product]' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingYear rdf:type rdf:Property ;
    rdfs:label 'Filing Year' ;
    rdfs:comment 'Calendar year of the NAIC Annual Statement filing to which this statutory reserve exhibit belongs (e.g., 2024).' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grossIncurredAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Incurred Alae Amount' ;
    rdfs:comment 'Gross incurred ALAE (paid ALAE plus ALAE case reserves) for the accident year at the valuation date, before reinsurance recoveries.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossIncurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Incurred Loss Amount' ;
    rdfs:comment 'Gross incurred losses (paid plus case reserves) for the accident year at the valuation date, before reinsurance, per NAIC Schedule P reporting.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPaidAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Paid Alae Amount' ;
    rdfs:comment 'Cumulative gross paid allocated loss adjustment expense (ALAE) for the accident year and development period, before reinsurance recoveries.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPaidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Paid Loss Amount' ;
    rdfs:comment 'Cumulative gross (before reinsurance) paid losses reported on this exhibit row for the accident year and development period, per NAIC Schedule P.' ;
    rdfs:domain ind:Reservespayments ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netIncurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Net Incurred Loss Amount' ;
    rdfs:comment 'Net incurred losses (gross incurred less reinsurance recoverables) for the accident year at the valuation date, as reported on the statutory exhibit.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netLossRatio rdf:type rdf:Property ;
    rdfs:label 'Net Loss Ratio' ;
    rdfs:comment 'Net loss ratio (LR) for the accident year: net incurred losses divided by earned premium (EP), as reported on the statutory exhibit.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPaidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Net Paid Loss Amount' ;
    rdfs:comment 'Cumulative net paid losses (gross paid losses less reinsurance recoveries received) for the accident year and development period.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorValuationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Valuation Date' ;
    rdfs:comment 'The prior year-end valuation date used as the baseline for measuring reserve development on this statutory exhibit row.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:schedulePPart rdf:type rdf:Property ;
    rdfs:label 'Schedule P Part' ;
    rdfs:comment 'Identifies the specific part of NAIC Annual Statement Schedule P this row populates (e.g., Part1=Summary, Part2=Paid, Part3=Incurred, Part4=Bulk/IBNR).' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectedLdf rdf:type rdf:Property ;
    rdfs:label 'Selected Ldf' ;
    rdfs:comment 'Actuarially selected cumulative loss development factor (LDF) applied to current incurred losses to project ultimate losses for this accident year.' ;
    rdfs:domain ind:StatReserveExhibit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:structuredSettlementId rdf:type rdf:Property ;
    rdfs:label 'Structured Settlement Id' ;
    rdfs:comment 'Unique surrogate identifier for the structured settlement record. Primary key for this entity.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agreementDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Date' ;
    rdfs:comment 'Date on which the structured settlement agreement was formally executed and signed by all parties.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annuityContractNumber rdf:type rdf:Property ;
    rdfs:label 'Annuity Contract Number' ;
    rdfs:comment 'Policy or contract number assigned by the annuity provider for the annuity contract that funds the structured settlement periodic payments.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annuityCostAmount rdf:type rdf:Property ;
    rdfs:label 'Annuity Cost Amount' ;
    rdfs:comment 'Actual premium paid to the annuity provider to fund the structured settlement annuity contract, representing the insurer\'s cost of settlement.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annuityProviderNaicCode rdf:type rdf:Property ;
    rdfs:label 'Annuity Provider Naic Code' ;
    rdfs:comment 'National Association of Insurance Commissioners (NAIC) company code for the annuity provider issuing the structured settlement annuity contract.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annuityProviderName rdf:type rdf:Property ;
    rdfs:label 'Annuity Provider Name' ;
    rdfs:comment 'Legal name of the life insurance company that issues and funds the annuity contract underlying the structured settlement.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantTaxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Claimant Tax Identification Number' ;
    rdfs:comment 'Social Security Number (SSN) or Federal Employer Identification Number (FEIN) of the claimant for IRS tax reporting on structured settlement payments.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colaRate rdf:type rdf:Property ;
    rdfs:label 'Cola Rate' ;
    rdfs:comment 'Annual cost-of-living adjustment (COLA) rate applied to periodic payments, expressed as a decimal (e.g., 0.0300 for 3%). Zero if no COLA applies.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:courtApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Court Approval Date' ;
    rdfs:comment 'Date on which a court of competent jurisdiction approved the structured settlement agreement, required for minor or incapacitated claimants.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Court Approval Required Flag' ;
    rdfs:comment 'Indicates whether court approval is required for this structured settlement, typically for minor or incapacitated claimants under state law.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discountRate rdf:type rdf:Property ;
    rdfs:label 'Discount Rate' ;
    rdfs:comment 'Actuarial discount rate used to calculate the present value of future periodic payments for reserving and financial reporting purposes.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guaranteePeriodYears rdf:type rdf:Property ;
    rdfs:label 'Guarantee Period Years' ;
    rdfs:comment 'Number of years for which periodic payments are guaranteed regardless of the annuitant\'s survival, providing a minimum payment floor.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentEndDate rdf:type rdf:Property ;
    rdfs:label 'Payment End Date' ;
    rdfs:comment 'Date on which the last scheduled periodic payment is due, or null for life-contingent settlements with no fixed end date.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentStartDate rdf:type rdf:Property ;
    rdfs:label 'Payment Start Date' ;
    rdfs:comment 'Date on which the first periodic payment under the structured settlement is scheduled to be disbursed to the claimant.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodicPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Periodic Payment Amount' ;
    rdfs:comment 'Base amount of each scheduled periodic payment disbursed to the claimant, before any cost-of-living adjustment (COLA) is applied.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:presentValueAmount rdf:type rdf:Property ;
    rdfs:label 'Present Value Amount' ;
    rdfs:comment 'Actuarially calculated present value of all future periodic payments under the structured settlement, used for reserving, accounting, and IFRS 17 liability measurement.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualifiedAssignmentCompany rdf:type rdf:Property ;
    rdfs:label 'Qualified Assignment Company' ;
    rdfs:comment 'Legal name of the qualified assignment company (QAC) that has assumed the periodic payment obligation from the insurer under IRC Section 130.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifiedAssignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Qualified Assignment Flag' ;
    rdfs:comment 'Indicates whether the periodic payment obligation has been assigned to a qualified assignment company under IRC Section 130, releasing the insurer from direct payment liability.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementType rdf:type rdf:Property ;
    rdfs:label 'Settlement Type' ;
    rdfs:comment 'Classification of the settlement payment structure. [ENUM-REF-CANDIDATE: periodic_payment|lump_sum_plus_periodic|life_contingent|life_with_period_certain|joint_and_survivor — promote to reference product]' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPayoutAmount rdf:type rdf:Property ;
    rdfs:label 'Total Payout Amount' ;
    rdfs:comment 'Sum of all scheduled periodic payments over the full term of the structured settlement, representing the gross undiscounted obligation.' ;
    rdfs:domain ind:StructuredSettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arbitrationFilingDate rdf:type rdf:Property ;
    rdfs:label 'Arbitration Filing Date' ;
    rdfs:comment 'Date on which the arbitration demand was formally filed with the selected arbitration forum.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:arbitrationForum rdf:type rdf:Property ;
    rdfs:label 'Arbitration Forum' ;
    rdfs:comment 'Arbitration forum selected for intercompany or third-party arbitration proceedings (e.g., AAIS, AAA, AICRB).' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attorneyFirmName rdf:type rdf:Property ;
    rdfs:label 'Attorney Firm Name' ;
    rdfs:comment 'Name of the law firm retained to pursue subrogation recovery through litigation or formal legal demand.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleReimbursedAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Reimbursed Amount' ;
    rdfs:comment 'Portion of the net recovery returned to the insured as reimbursement of their deductible, per policy terms and state law.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandSentDate rdf:type rdf:Property ;
    rdfs:label 'Demand Sent Date' ;
    rdfs:comment 'Date on which the formal demand letter was sent to the liable third party or their insurer.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liabilityPercentage rdf:type rdf:Property ;
    rdfs:label 'Liability Percentage' ;
    rdfs:comment 'Percentage of fault attributed to the liable third party, used to calculate the proportionate recovery demand in comparative negligence states.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:litigationFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Litigation Filed Flag' ;
    rdfs:comment 'Indicates whether a lawsuit has been formally filed in court to pursue the subrogation recovery.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openedDate rdf:type rdf:Property ;
    rdfs:label 'Opened Date' ;
    rdfs:comment 'Date on which the subrogation case was formally opened and assigned for pursuit.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Operational priority assigned to the subrogation case to guide adjuster workload management and pursuit urgency.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pursuitMethod rdf:type rdf:Property ;
    rdfs:label 'Pursuit Method' ;
    rdfs:comment 'Method selected to pursue recovery from the liable third party, such as demand letter, arbitration, or formal litigation.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Expense Amount' ;
    rdfs:comment 'Total expenses incurred in pursuing the subrogation recovery, including attorney fees, court costs, and investigation costs.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoveryShareAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Recovery Share Amount' ;
    rdfs:comment 'Dollar amount of the net subrogation recovery attributable to reinsurers, calculated per treaty or facultative terms.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thirdPartyClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Third Party Claim Number' ;
    rdfs:comment 'Claim number assigned by the at-fault third party\'s insurer for the corresponding liability claim.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyInsurerName rdf:type rdf:Property ;
    rdfs:label 'Third Party Insurer Name' ;
    rdfs:comment 'Name of the insurance carrier providing liability coverage to the at-fault third party.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyName rdf:type rdf:Property ;
    rdfs:label 'Third Party Name' ;
    rdfs:comment 'Full legal name of the liable third party against whom subrogation is being pursued.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Third Party Policy Number' ;
    rdfs:comment 'Policy number of the at-fault third party\'s liability insurance, used to facilitate demand and recovery negotiations.' ;
    rdfs:domain ind:SubrogationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catZoneId rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Id' ;
    rdfs:comment 'Unique identifier for the catastrophe zone record.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatZone .

ind:baseFloodElevationFt rdf:type rdf:Property ;
    rdfs:label 'Base Flood Elevation Ft' ;
    rdfs:comment 'Base flood elevation in feet above sea level for 100-year flood event, used for NFIP compliance.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catModelVendor rdf:type rdf:Property ;
    rdfs:label 'Cat Model Vendor' ;
    rdfs:comment 'Name of catastrophe modeling vendor whose model was used to define this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catModelVersion rdf:type rdf:Property ;
    rdfs:label 'Cat Model Version' ;
    rdfs:comment 'Version identifier of the catastrophe model used to define loss characteristics for this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceToCoastMiles rdf:type rdf:Property ;
    rdfs:label 'Distance To Coast Miles' ;
    rdfs:comment 'Distance in miles from this zone centroid to nearest coastline, relevant for hurricane and storm surge risk.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earthquakeMagnitudeScale rdf:type rdf:Property ;
    rdfs:label 'Earthquake Magnitude Scale' ;
    rdfs:comment 'Expected earthquake magnitude on Richter scale for seismic zones, used for exposure assessment.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:femaFloodZoneCode rdf:type rdf:Property ;
    rdfs:label 'Fema Flood Zone Code' ;
    rdfs:comment 'FEMA flood zone designation code indicating flood risk level for this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Firm Effective Date' ;
    rdfs:comment 'Date when the current FIRM panel became effective for this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firmPanelNumber rdf:type rdf:Property ;
    rdfs:label 'Firm Panel Number' ;
    rdfs:comment 'FEMA FIRM panel number identifying the official flood map for this zone.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographyType rdf:type rdf:Property ;
    rdfs:label 'Geography Type' ;
    rdfs:comment 'Type of geographic boundary used to define this catastrophe zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hurricaneWindSpeedMph rdf:type rdf:Property ;
    rdfs:label 'Hurricane Wind Speed Mph' ;
    rdfs:comment 'Design wind speed in miles per hour for hurricane peril zones, used for rating and building code compliance.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isoCrpcCode rdf:type rdf:Property ;
    rdfs:label 'Iso Crpc Code' ;
    rdfs:comment 'ISO CRPC code indicating fire protection class for commercial properties in this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Updated Date' ;
    rdfs:comment 'Date when this catastrophe zone record was last updated in the system.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the catastrophe zone centroid in decimal degrees.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the catastrophe zone centroid in decimal degrees.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mandatoryFloodPurchaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Mandatory Flood Purchase Indicator' ;
    rdfs:comment 'Indicates whether flood insurance is federally mandated for mortgaged properties in this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nfipCommunityCode rdf:type rdf:Property ;
    rdfs:label 'Nfip Community Code' ;
    rdfs:comment 'Six-digit NFIP community identifier for jurisdictions participating in the flood insurance program.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nfipParticipationStatus rdf:type rdf:Property ;
    rdfs:label 'Nfip Participation Status' ;
    rdfs:comment 'Current NFIP participation status of the community where this zone is located.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Return Period Years' ;
    rdfs:comment 'Statistical return period in years for the catastrophe event scenario modeled for this zone.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wildfireHazardSeverity rdf:type rdf:Property ;
    rdfs:label 'Wildfire Hazard Severity' ;
    rdfs:comment 'Wildfire hazard severity classification for this zone based on fuel load, topography, and climate.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windPoolEligible rdf:type rdf:Property ;
    rdfs:label 'Wind Pool Eligible' ;
    rdfs:comment 'Indicates whether properties in this zone are eligible for state wind pool or residual market coverage.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zipCode rdf:type rdf:Property ;
    rdfs:label 'Zip Code' ;
    rdfs:comment 'Five-digit postal ZIP code associated with this catastrophe zone, if applicable.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Business identifier code for the catastrophe zone, typically assigned by rating bureau or insurer.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Descriptive name of the catastrophe zone for business reference and reporting.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneStatus rdf:type rdf:Property ;
    rdfs:label 'Zone Status' ;
    rdfs:comment 'Current lifecycle status of the catastrophe zone definition.' ;
    rdfs:domain ind:CatZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueReportId rdf:type rdf:Property ;
    rdfs:label 'Clue Report Id' ;
    rdfs:comment 'Unique identifier for the CLUE report record.' ;
    rdfs:domain ind:ClueReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adverseActionRequired rdf:type rdf:Property ;
    rdfs:label 'Adverse Action Required' ;
    rdfs:comment 'Indicates whether an adverse action notice is required based on CLUE report usage.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseActionSentDate rdf:type rdf:Property ;
    rdfs:label 'Adverse Action Sent Date' ;
    rdfs:comment 'Date when the adverse action notice was sent to the applicant.' ;
