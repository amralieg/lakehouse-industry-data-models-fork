ind:grandfatheringEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Grandfathering Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether the property is eligible for grandfathered flood insurance rates due to map changes.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lenderName rdf:type rdf:Property ;
    rdfs:label 'Lender Name' ;
    rdfs:comment 'Name of the mortgage lender requiring flood zone determination for loan compliance purposes.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
