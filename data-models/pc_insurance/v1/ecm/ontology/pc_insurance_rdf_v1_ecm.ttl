    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newBusinessCreditRate rdf:type rdf:Property ;
    rdfs:label 'New Business Credit Rate' ;
    rdfs:comment 'Additional commission credit rate for new business production, expressed as a decimal percentage.' ;
