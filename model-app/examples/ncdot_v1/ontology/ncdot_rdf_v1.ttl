    rdfs:range xsd:date .

ind:federalCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Federal Certification Required' ;
    rdfs:comment 'Indicates whether the model is subject to federal certification requirements for air quality conformity or other federal mandates.' ;
