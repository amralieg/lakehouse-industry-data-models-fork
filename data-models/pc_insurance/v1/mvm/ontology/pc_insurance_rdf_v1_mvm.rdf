ind:commissionStatementId rdf:type rdf:Property ;
    rdfs:label 'Commission Statement Id' ;
    rdfs:comment 'Foreign key linking to producers.commission_statement. Business justification: Transactions roll up into periodic statements. Each transaction appears on exactly one statement for a given billing period. Standard transaction-to-statement aggregation link.' ;
    rdfs:domain ind:PcInsurance ;
