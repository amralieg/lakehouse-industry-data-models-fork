ind:certificateHolderName rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Name' ;
    rdfs:comment 'Name of the certificate holder for Certificate of Insurance (COI) documents.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Cms Reference Code' ;
    rdfs:comment 'Reference identifier linking this document record to the stored file in the CMS (OpenText or FileNet).' ;
    rdfs:domain ind:Document ;
