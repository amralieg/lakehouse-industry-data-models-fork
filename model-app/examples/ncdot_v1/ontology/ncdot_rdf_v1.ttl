ind:nextFraInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Fra Inspection Date' ;
    rdfs:comment 'The scheduled date for the next FRA safety inspection.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hazmatAuthorizedFlag rdf:type rdf:Property ;
    rdfs:label 'Hazmat Authorized Flag' ;
    rdfs:comment 'Indicates whether the operator is authorized and certified to transport hazardous materials.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazmatCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Hazmat Certification Number' ;
    rdfs:comment 'Certification number for hazardous materials transportation authority if applicable.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passengerServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Passenger Service Flag' ;
    rdfs:comment 'Indicates whether the operator provides passenger rail service.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:freightServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Freight Service Flag' ;
    rdfs:comment 'Indicates whether the operator provides freight rail service.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue Amount' ;
    rdfs:comment 'Total annual operating revenue in US dollars for the most recent fiscal year, used for operator classification.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualRevenueYear rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue Year' ;
    rdfs:comment 'The fiscal year for which the annual revenue amount is reported.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trackMilesOperated rdf:type rdf:Property ;
    rdfs:label 'Track Miles Operated' ;
    rdfs:comment 'Total miles of track operated by the rail operator within North Carolina.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeCount rdf:type rdf:Property ;
    rdfs:label 'Employee Count' ;
    rdfs:comment 'Total number of employees working for the rail operator.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:locomotiveCount rdf:type rdf:Property ;
    rdfs:label 'Locomotive Count' ;
    rdfs:comment 'Total number of locomotives owned or operated by the rail operator.' ;
    rdfs:domain ind:Rail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:railcarCount rdf:type rdf:Property ;
    rdfs:label 'Railcar Count' ;
    rdfs:comment 'Total number of railcars (freight or passenger) owned or operated by the rail operator.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatingAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Operating Agreement Number' ;
    rdfs:comment 'Reference number for the operating agreement or contract between NCDOT and the rail operator.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingAgreementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Operating Agreement Effective Date' ;
    rdfs:comment 'The date when the current operating agreement became effective.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatingAgreementExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Operating Agreement Expiration Date' ;
    rdfs:comment 'The date when the current operating agreement expires.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateSubsidyRecipientFlag rdf:type rdf:Property ;
    rdfs:label 'State Subsidy Recipient Flag' ;
    rdfs:comment 'Indicates whether the operator receives state funding or subsidies for rail operations.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalGrantRecipientFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Grant Recipient Flag' ;
    rdfs:comment 'Indicates whether the operator receives federal grant funding for rail operations or infrastructure.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dbeCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Dbe Certified Flag' ;
    rdfs:comment 'Indicates whether the operator is certified as a Disadvantaged Business Enterprise under federal regulations.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hubCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Hub Certified Flag' ;
    rdfs:comment 'Indicates whether the operator is certified as a Historically Underutilized Business in North Carolina.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Service Area Description' ;
    rdfs:comment 'Textual description of the geographic service area or routes operated by the rail operator within North Carolina.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCommodityHauled rdf:type rdf:Property ;
    rdfs:label 'Primary Commodity Hauled' ;
    rdfs:comment 'The primary type of commodity or freight transported by the operator (e.g., coal, chemicals, intermodal, agricultural products).' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interchangePartners rdf:type rdf:Property ;
    rdfs:label 'Interchange Partners' ;
    rdfs:comment 'List or description of other rail operators with which this operator has interchange agreements for freight or passenger transfer.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positiveTrainControlEquippedFlag rdf:type rdf:Property ;
    rdfs:label 'Positive Train Control Equipped Flag' ;
    rdfs:comment 'Indicates whether the operator has implemented Positive Train Control safety technology on their operations.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ptcImplementationDate rdf:type rdf:Property ;
    rdfs:label 'Ptc Implementation Date' ;
    rdfs:comment 'The date when Positive Train Control was fully implemented by the operator.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAccidentDate rdf:type rdf:Property ;
    rdfs:label 'Last Accident Date' ;
    rdfs:comment 'The date of the most recent reportable rail accident or incident involving this operator.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accidentRatePerMillionMiles rdf:type rdf:Property ;
    rdfs:label 'Accident Rate Per Million Miles' ;
    rdfs:comment 'The operator safety performance metric measuring reportable accidents per million train miles operated.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stopId rdf:type rdf:Property ;
    rdfs:label 'Stop Id' ;
    rdfs:comment 'Unique identifier for the transit stop or station. Primary key for the stop entity.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Stop .

ind:zoneId rdf:type rdf:Property ;
    rdfs:label 'Zone Id' ;
    rdfs:comment 'Identifies the fare zone for the stop. Used to calculate fare requirements for trips that cross zone boundaries.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Zone .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Indicates the type of location: stop (default boarding location), station (physical structure containing stops), entrance/exit, generic node, or boarding area.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentStationId rdf:type rdf:Property ;
    rdfs:label 'Parent Station Id' ;
    rdfs:comment 'For stops located within a station, this identifies the parent station. Used to group multiple platforms or boarding areas under a single station.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Stop .

ind:timezone rdf:type rdf:Property ;
    rdfs:label 'Timezone' ;
    rdfs:comment 'Timezone in which the stop is located. Inherits from agency timezone if not specified. Uses IANA timezone database format.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wheelchairBoarding rdf:type rdf:Property ;
    rdfs:label 'Wheelchair Boarding' ;
    rdfs:comment 'Indicates whether wheelchair boarding is possible at this stop. Supports ADA compliance tracking and rider accessibility planning.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:levelId rdf:type rdf:Property ;
    rdfs:label 'Level Id' ;
    rdfs:comment 'Identifies the level of the stop within a station (e.g., mezzanine, platform). Used for multi-level stations to help riders navigate.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Level .

ind:platformCode rdf:type rdf:Property ;
    rdfs:label 'Platform Code' ;
    rdfs:comment 'Platform identifier for stops located at a station. Displayed to riders to help them find the correct boarding location.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitAgencyId rdf:type rdf:Property ;
    rdfs:label 'Transit Agency Id' ;
    rdfs:comment 'Identifier for the transit agency or operator responsible for service at this stop. Links stop to the operating agency.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:transitAgencyName rdf:type rdf:Property ;
    rdfs:label 'Transit Agency Name' ;
    rdfs:comment 'Name of the transit agency or operator responsible for service at this stop.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shelterPresent rdf:type rdf:Property ;
    rdfs:label 'Shelter Present' ;
    rdfs:comment 'Indicates whether a shelter or covered waiting area is present at the stop. Important for rider comfort and ADA compliance.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchPresent rdf:type rdf:Property ;
    rdfs:label 'Bench Present' ;
    rdfs:comment 'Indicates whether seating (bench) is available at the stop. Supports accessibility and rider comfort.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lightingPresent rdf:type rdf:Property ;
    rdfs:label 'Lighting Present' ;
    rdfs:comment 'Indicates whether lighting is installed at the stop for safety and visibility during evening and night service.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trashReceptaclePresent rdf:type rdf:Property ;
    rdfs:label 'Trash Receptacle Present' ;
    rdfs:comment 'Indicates whether a trash receptacle is available at the stop for rider convenience and cleanliness.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bikeRackPresent rdf:type rdf:Property ;
    rdfs:label 'Bike Rack Present' ;
    rdfs:comment 'Indicates whether bicycle parking facilities are available at the stop. Supports multimodal transportation integration.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bikeRackCapacity rdf:type rdf:Property ;
    rdfs:label 'Bike Rack Capacity' ;
    rdfs:comment 'Number of bicycles that can be accommodated at the bike rack facility. Used for capacity planning and multimodal integration.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:realTimeDisplayPresent rdf:type rdf:Property ;
    rdfs:label 'Real Time Display Present' ;
    rdfs:comment 'Indicates whether a real-time arrival information display is installed at the stop. Enhances rider experience and service transparency.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sidewalkConnection rdf:type rdf:Property ;
    rdfs:label 'Sidewalk Connection' ;
    rdfs:comment 'Indicates whether the stop has a connected sidewalk providing safe pedestrian access. Critical for ADA compliance and pedestrian safety.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crosswalkPresent rdf:type rdf:Property ;
    rdfs:label 'Crosswalk Present' ;
    rdfs:comment 'Indicates whether a marked crosswalk is present near the stop for safe pedestrian crossing.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parkingAvailable rdf:type rdf:Property ;
    rdfs:label 'Parking Available' ;
    rdfs:comment 'Indicates whether parking facilities are available at or near the stop for park-and-ride service.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parkingCapacity rdf:type rdf:Property ;
    rdfs:label 'Parking Capacity' ;
    rdfs:comment 'Number of parking spaces available at the stop for park-and-ride service. Used for capacity planning and demand management.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installationDate rdf:type rdf:Property ;
    rdfs:label 'Installation Date' ;
    rdfs:comment 'Date when the transit stop was originally installed and put into service.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ridershipCategory rdf:type rdf:Property ;
    rdfs:label 'Ridership Category' ;
    rdfs:comment 'Classification of the stop based on ridership volume (high, medium, or low). Used for service planning and amenity prioritization.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeCount rdf:type rdf:Property ;
    rdfs:label 'Route Count' ;
    rdfs:comment 'Number of distinct transit routes that serve this stop. Indicates the connectivity and importance of the stop in the network.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transferPoint rdf:type rdf:Property ;
    rdfs:label 'Transfer Point' ;
    rdfs:comment 'Indicates whether this stop serves as a designated transfer point between routes or services.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parkAndRide rdf:type rdf:Property ;
    rdfs:label 'Park And Ride' ;
    rdfs:comment 'Indicates whether this stop is designated as a park-and-ride facility with parking for commuters.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ftaAssetId rdf:type rdf:Property ;
    rdfs:label 'Fta Asset Id' ;
    rdfs:comment 'FTA-assigned identifier for the transit stop asset. Used for federal reporting and grant compliance tracking.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:grantProgram rdf:type rdf:Property ;
    rdfs:label 'Grant Program' ;
    rdfs:comment 'Specific federal grant program that funded the stop construction or improvement (e.g., Section 5307, Section 5310, CMAQ).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusTract rdf:type rdf:Property ;
    rdfs:label 'Census Tract' ;
    rdfs:comment 'Census tract in which the stop is located. Used for demographic analysis and Title VI compliance reporting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusBlockGroup rdf:type rdf:Property ;
    rdfs:label 'Census Block Group' ;
    rdfs:comment 'Census block group in which the stop is located. Provides finer geographic resolution for demographic analysis.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalJusticeArea rdf:type rdf:Property ;
    rdfs:label 'Environmental Justice Area' ;
    rdfs:comment 'Indicates whether the stop is located in an environmental justice area (low-income or minority population). Used for Title VI and equity analysis.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:titleViProtected rdf:type rdf:Property ;
    rdfs:label 'Title Vi Protected' ;
    rdfs:comment 'Indicates whether the stop serves a Title VI protected population. Used for civil rights compliance and equity monitoring.' ;
    rdfs:domain ind:Stop ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:headsign rdf:type rdf:Property ;
    rdfs:label 'Headsign' ;
    rdfs:comment 'Text displayed on the vehicle headsign to identify the trip destination to passengers.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Public-facing short identifier for the trip, used in schedules and passenger information.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directionId rdf:type rdf:Property ;
    rdfs:label 'Direction Id' ;
    rdfs:comment 'Indicates the direction of travel for the trip. 0 = outbound/one direction, 1 = inbound/opposite direction.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Direction .

ind:directionName rdf:type rdf:Property ;
    rdfs:label 'Direction Name' ;
    rdfs:comment 'Descriptive name for the direction of travel (e.g., \'Northbound\', \'To Downtown\', \'Eastbound\').' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureId rdf:type rdf:Property ;
    rdfs:label 'Feature Id' ;
    rdfs:comment 'Identifier for the geographic path/alignment that the vehicle follows for this trip.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feature .

ind:scheduledStartTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Time' ;
    rdfs:comment 'Planned departure time from the first stop of the trip according to the published schedule.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledEndTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Time' ;
    rdfs:comment 'Planned arrival time at the final stop of the trip according to the published schedule.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartTime rdf:type rdf:Property ;
    rdfs:label 'Actual Start Time' ;
    rdfs:comment 'Actual departure time from the first stop of the trip as recorded by AVL (Automatic Vehicle Location) or operator.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualEndTime rdf:type rdf:Property ;
    rdfs:label 'Actual End Time' ;
    rdfs:comment 'Actual arrival time at the final stop of the trip as recorded by AVL (Automatic Vehicle Location) or operator.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceDate rdf:type rdf:Property ;
    rdfs:label 'Service Date' ;
    rdfs:comment 'Operating date for which this trip is scheduled, following transit day convention (service day may extend past midnight).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wheelchairAccessible rdf:type rdf:Property ;
    rdfs:label 'Wheelchair Accessible' ;
    rdfs:comment 'Indicates wheelchair accessibility for this trip. 0 = no information, 1 = accessible, 2 = not accessible.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bikesAllowed rdf:type rdf:Property ;
    rdfs:label 'Bikes Allowed' ;
    rdfs:comment 'Indicates whether bicycles are allowed on this trip. 0 = no information, 1 = allowed, 2 = not allowed.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakIndicator rdf:type rdf:Property ;
    rdfs:label 'Peak Indicator' ;
    rdfs:comment 'Indicates whether this trip operates during peak commute hours (true) or off-peak hours (false).' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fareClass rdf:type rdf:Property ;
    rdfs:label 'Fare Class' ;
    rdfs:comment 'Fare category or pricing tier applicable to this trip (e.g., \'standard\', \'express\', \'premium\').' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardingCount rdf:type rdf:Property ;
    rdfs:label 'Boarding Count' ;
    rdfs:comment 'Total number of passenger boardings across all stops during this trip.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alightingCount rdf:type rdf:Property ;
    rdfs:label 'Alighting Count' ;
    rdfs:comment 'Total number of passenger alightings (exits) across all stops during this trip.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxLoad rdf:type rdf:Property ;
    rdfs:label 'Max Load' ;
    rdfs:comment 'Maximum number of passengers on board the vehicle at any point during the trip (peak load point).' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatedCapacity rdf:type rdf:Property ;
    rdfs:label 'Seated Capacity' ;
    rdfs:comment 'Number of seated passenger positions available on the vehicle for this trip.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueMiles rdf:type rdf:Property ;
    rdfs:label 'Revenue Miles' ;
    rdfs:comment 'Miles traveled while the vehicle is in revenue service (available to passengers) during this trip.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deadheadMiles rdf:type rdf:Property ;
    rdfs:label 'Deadhead Miles' ;
    rdfs:comment 'Miles traveled while the vehicle is not in revenue service (e.g., traveling to/from garage, repositioning).' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueHours rdf:type rdf:Property ;
    rdfs:label 'Revenue Hours' ;
    rdfs:comment 'Hours the vehicle was in revenue service (available to passengers) during this trip.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:onTimePerformanceStatus rdf:type rdf:Property ;
    rdfs:label 'On Time Performance Status' ;
    rdfs:comment 'Indicates whether the trip met on-time performance standards based on schedule adherence thresholds.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diversionReason rdf:type rdf:Property ;
    rdfs:label 'Diversion Reason' ;
    rdfs:comment 'Reason code or description explaining why the trip was diverted from its normal route, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentType rdf:type rdf:Property ;
    rdfs:label 'Incident Type' ;
    rdfs:comment 'Classification of the incident that occurred during the trip (e.g., \'accident\', \'breakdown\', \'passenger injury\').' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherCondition rdf:type rdf:Property ;
    rdfs:label 'Weather Condition' ;
    rdfs:comment 'Prevailing weather conditions during the trip that may have affected operations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficCondition rdf:type rdf:Property ;
    rdfs:label 'Traffic Condition' ;
    rdfs:comment 'General traffic conditions encountered during the trip that may have affected schedule adherence.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ftaGrantNumber rdf:type rdf:Property ;
    rdfs:label 'Fta Grant Number' ;
    rdfs:comment 'FTA grant number under which this trip service is funded, if applicable.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaType rdf:type rdf:Property ;
    rdfs:label 'Service Area Type' ;
    rdfs:comment 'Classification of the geographic service area in which this trip operates.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fareRevenue rdf:type rdf:Property ;
    rdfs:label 'Fare Revenue' ;
    rdfs:comment 'Total fare revenue collected from passengers during this trip.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingCost rdf:type rdf:Property ;
    rdfs:label 'Operating Cost' ;
    rdfs:comment 'Estimated or allocated operating cost for this trip, including labor, fuel, and maintenance.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelConsumedGallons rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumed Gallons' ;
    rdfs:comment 'Amount of fuel consumed by the vehicle during this trip, measured in gallons.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:avlTrackingEnabled rdf:type rdf:Property ;
    rdfs:label 'Avl Tracking Enabled' ;
    rdfs:comment 'Indicates whether AVL tracking was active and recording location data for this trip.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:realTimeDataAvailable rdf:type rdf:Property ;
    rdfs:label 'Real Time Data Available' ;
    rdfs:comment 'Indicates whether real-time passenger information was available and published for this trip.' ;
    rdfs:domain ind:Trip ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riderCategory rdf:type rdf:Property ;
    rdfs:label 'Rider Category' ;
    rdfs:comment 'Classification of eligible riders for this fare structure based on demographic or eligibility criteria.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseFareAmount rdf:type rdf:Property ;
    rdfs:label 'Base Fare Amount' ;
    rdfs:comment 'The standard fare amount in US dollars before any discounts, surcharges, or zone adjustments are applied.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountPercentage rdf:type rdf:Property ;
    rdfs:label 'Discount Percentage' ;
    rdfs:comment 'Percentage discount applied to the base fare for eligible rider categories (e.g., 50% for seniors, 25% for students).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalFareAmount rdf:type rdf:Property ;
    rdfs:label 'Final Fare Amount' ;
    rdfs:comment 'The actual fare amount charged to the rider after all discounts and adjustments are applied.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originZone rdf:type rdf:Property ;
    rdfs:label 'Origin Zone' ;
    rdfs:comment 'Starting zone for zone-to-zone fare structures. Used in distance-based or multi-zone pricing models.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationZone rdf:type rdf:Property ;
    rdfs:label 'Destination Zone' ;
    rdfs:comment 'Ending zone for zone-to-zone fare structures. Used in distance-based or multi-zone pricing models.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Transfer Allowed Flag' ;
    rdfs:comment 'Indicates whether this fare structure permits transfers to other routes or modes within the transit system.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferCountLimit rdf:type rdf:Property ;
    rdfs:label 'Transfer Count Limit' ;
    rdfs:comment 'Maximum number of transfers permitted under this fare structure within the transfer validity window.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transferTimeLimitMinutes rdf:type rdf:Property ;
    rdfs:label 'Transfer Time Limit Minutes' ;
    rdfs:comment 'Time window in minutes during which transfers are valid after initial fare payment.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transferFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Transfer Fee Amount' ;
    rdfs:comment 'Additional fee charged for each transfer, if applicable. Zero indicates free transfers.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validityPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Validity Period Days' ;
    rdfs:comment 'Number of consecutive days the fare is valid from the date of purchase or first use (e.g., 1 for day pass, 30 for monthly pass).' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validityStartDate rdf:type rdf:Property ;
    rdfs:label 'Validity Start Date' ;
    rdfs:comment 'Date when this fare structure becomes effective and available for use.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validityEndDate rdf:type rdf:Property ;
    rdfs:label 'Validity End Date' ;
    rdfs:comment 'Date when this fare structure expires and is no longer available for purchase or use. Null indicates indefinite validity.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:purchaseChannel rdf:type rdf:Property ;
    rdfs:label 'Purchase Channel' ;
    rdfs:comment 'Distribution channel or location where this fare can be purchased.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaType rdf:type rdf:Property ;
    rdfs:label 'Media Type' ;
    rdfs:comment 'Physical or digital medium used to store and validate the fare.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundableFlag rdf:type rdf:Property ;
    rdfs:label 'Refundable Flag' ;
    rdfs:comment 'Indicates whether unused or partially used fares of this type can be refunded to the customer.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferableFlag rdf:type rdf:Property ;
    rdfs:label 'Transferable Flag' ;
    rdfs:comment 'Indicates whether this fare can be transferred or shared between different riders.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Peak Period Flag' ;
    rdfs:comment 'Indicates whether this fare structure applies during peak travel periods (typically weekday rush hours).' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offPeakPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Off Peak Period Flag' ;
    rdfs:comment 'Indicates whether this fare structure applies during off-peak travel periods.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weekendFlag rdf:type rdf:Property ;
    rdfs:label 'Weekend Flag' ;
    rdfs:comment 'Indicates whether this fare structure is valid for weekend travel (Saturday and Sunday).' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holidayFlag rdf:type rdf:Property ;
    rdfs:label 'Holiday Flag' ;
    rdfs:comment 'Indicates whether this fare structure applies on designated holidays.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumAge rdf:type rdf:Property ;
    rdfs:label 'Minimum Age' ;
    rdfs:comment 'Minimum age in years required for eligibility to use this fare structure.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumAge rdf:type rdf:Property ;
    rdfs:label 'Maximum Age' ;
    rdfs:comment 'Maximum age in years for eligibility to use this fare structure (e.g., youth fares typically end at age 18).' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityDocumentationRequired rdf:type rdf:Property ;
    rdfs:label 'Eligibility Documentation Required' ;
    rdfs:comment 'Description of documentation required to prove eligibility for this fare category (e.g., \'Valid student ID\', \'Medicare card\', \'Disability certification\').' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capDailyAmount rdf:type rdf:Property ;
    rdfs:label 'Cap Daily Amount' ;
    rdfs:comment 'Maximum total fare amount a rider will pay in a single day, after which additional trips are free. Null indicates no daily cap.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capWeeklyAmount rdf:type rdf:Property ;
    rdfs:label 'Cap Weekly Amount' ;
    rdfs:comment 'Maximum total fare amount a rider will pay in a single week, after which additional trips are free. Null indicates no weekly cap.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capMonthlyAmount rdf:type rdf:Property ;
    rdfs:label 'Cap Monthly Amount' ;
    rdfs:comment 'Maximum total fare amount a rider will pay in a single month, after which additional trips are free. Null indicates no monthly cap.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distanceMinimumMiles rdf:type rdf:Property ;
    rdfs:label 'Distance Minimum Miles' ;
    rdfs:comment 'Minimum trip distance in miles for distance-based fare structures. Trips shorter than this distance use the base fare.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distanceMaximumMiles rdf:type rdf:Property ;
    rdfs:label 'Distance Maximum Miles' ;
    rdfs:comment 'Maximum trip distance in miles covered by this fare structure. Longer trips may require additional fare payment.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distanceRatePerMile rdf:type rdf:Property ;
    rdfs:label 'Distance Rate Per Mile' ;
    rdfs:comment 'Fare rate charged per mile of travel for distance-based pricing models.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bulkPurchaseQuantity rdf:type rdf:Property ;
    rdfs:label 'Bulk Purchase Quantity' ;
    rdfs:comment 'Number of rides or passes included in a bulk purchase package (e.g., 10-ride ticket book).' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bulkPurchaseDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Bulk Purchase Discount Percentage' ;
    rdfs:comment 'Percentage discount applied when purchasing multiple rides or passes in bulk.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:promotionalCode rdf:type rdf:Property ;
    rdfs:label 'Promotional Code' ;
    rdfs:comment 'Special code associated with promotional or limited-time fare offerings.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionalStartDate rdf:type rdf:Property ;
    rdfs:label 'Promotional Start Date' ;
    rdfs:comment 'Start date for promotional fare offerings or special pricing periods.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:promotionalEndDate rdf:type rdf:Property ;
    rdfs:label 'Promotional End Date' ;
    rdfs:comment 'End date for promotional fare offerings or special pricing periods.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ftaFareCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Fta Fare Category Code' ;
    rdfs:comment 'Standardized FTA fare category code used for National Transit Database reporting and federal grant compliance.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueAllocationCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Allocation Code' ;
    rdfs:comment 'Accounting code used to allocate fare revenue to appropriate cost centers, funding sources, or financial accounts.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidySource rdf:type rdf:Property ;
    rdfs:label 'Subsidy Source' ;
    rdfs:comment 'Source of subsidy funding that reduces the fare amount for eligible riders (e.g., FTA grants, state transit assistance, employer programs).' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidyPercentage rdf:type rdf:Property ;
    rdfs:label 'Subsidy Percentage' ;
    rdfs:comment 'Percentage of the fare amount covered by subsidy funding rather than rider payment.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adaCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Compliant Flag' ;
    rdfs:comment 'Indicates whether this fare structure complies with ADA requirements for accessible transportation services.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:titleViCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Title Vi Compliant Flag' ;
    rdfs:comment 'Indicates whether this fare structure has been reviewed and approved for compliance with Title VI Civil Rights Act requirements prohibiting discrimination.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equityAnalysisDate rdf:type rdf:Property ;
    rdfs:label 'Equity Analysis Date' ;
    rdfs:comment 'Date when the most recent fare equity analysis was conducted for Title VI compliance review.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Board Approval Date' ;
    rdfs:comment 'Date when the fare structure was officially approved by the transit agency governing board.' ;
    rdfs:domain ind:Fare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fareType rdf:type rdf:Property ;
    rdfs:label 'Fare Type' ;
    rdfs:comment 'Pricing category applied to the ticket, indicating whether full fare, reduced fare, or special pricing was applied.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Total tax amount applied to the ticket transaction. Denominated in US dollars.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAmount rdf:type rdf:Property ;
    rdfs:label 'Total Amount' ;
    rdfs:comment 'Total amount paid for the ticket including base fare, taxes, fees, and after discounts. Denominated in US dollars.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Reference Number' ;
    rdfs:comment 'External payment processor or financial system reference number for the transaction, used for reconciliation and dispute resolution.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Purchase Timestamp' ;
    rdfs:comment 'Date and time when the ticket was purchased or issued, in format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Date and time when the ticket was first validated or activated for use, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. May be null for unused tickets.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expirationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expiration Timestamp' ;
    rdfs:comment 'Date and time when the ticket expires and is no longer valid for use, in format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validFromDate rdf:type rdf:Property ;
    rdfs:label 'Valid From Date' ;
    rdfs:comment 'Start date of the ticket validity period, in format yyyy-MM-dd. For passes and multi-day tickets.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validToDate rdf:type rdf:Property ;
    rdfs:label 'Valid To Date' ;
    rdfs:comment 'End date of the ticket validity period, in format yyyy-MM-dd. For passes and multi-day tickets.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originLocation rdf:type rdf:Property ;
    rdfs:label 'Origin Location' ;
    rdfs:comment 'Starting location or station for the trip associated with the ticket. For ferry tickets, this is the departure terminal. For transit, this is the boarding stop or station.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationLocation rdf:type rdf:Property ;
    rdfs:label 'Destination Location' ;
    rdfs:comment 'Ending location or station for the trip associated with the ticket. For ferry tickets, this is the arrival terminal. For transit, this is the alighting stop or station.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tripDate rdf:type rdf:Property ;
    rdfs:label 'Trip Date' ;
    rdfs:comment 'Scheduled date of travel for the ticket, in format yyyy-MM-dd. For single-ride tickets with specific trip reservations.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tripTime rdf:type rdf:Property ;
    rdfs:label 'Trip Time' ;
    rdfs:comment 'Scheduled departure time for the trip. For ferry reservations and scheduled transit services.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneOrigin rdf:type rdf:Property ;
    rdfs:label 'Zone Origin' ;
    rdfs:comment 'Fare zone identifier for the origin location. Used in zone-based fare systems.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneDestination rdf:type rdf:Property ;
    rdfs:label 'Zone Destination' ;
    rdfs:comment 'Fare zone identifier for the destination location. Used in zone-based fare systems.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferAllowed rdf:type rdf:Property ;
    rdfs:label 'Transfer Allowed' ;
    rdfs:comment 'Indicates whether the ticket allows transfers to other routes or services within the validity period.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferCount rdf:type rdf:Property ;
    rdfs:label 'Transfer Count' ;
    rdfs:comment 'Number of transfers allowed or used with this ticket. May be null for unlimited transfer passes.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:smartCardNumber rdf:type rdf:Property ;
    rdfs:label 'Smart Card Number' ;
    rdfs:comment 'Unique identifier of the smart card or fare media used for the ticket. Used for contactless payment systems and reloadable fare cards.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barcode rdf:type rdf:Property ;
    rdfs:label 'Barcode' ;
    rdfs:comment 'Barcode or QR code value printed on the ticket for validation and scanning purposes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentId rdf:type rdf:Property ;
    rdfs:label 'Equipment Id' ;
    rdfs:comment 'Identifier of the device or terminal where the ticket was validated (fare box, gate reader, handheld validator).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Equipment .

ind:validationLocation rdf:type rdf:Property ;
    rdfs:label 'Validation Location' ;
    rdfs:comment 'Physical location where the ticket was validated (station name, vehicle number, terminal).' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorCode rdf:type rdf:Property ;
    rdfs:label 'Operator Code' ;
    rdfs:comment 'Standardized code identifying the transit agency or ferry operator. Used for FTA reporting and inter-agency coordination.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidyProgram rdf:type rdf:Property ;
    rdfs:label 'Subsidy Program' ;
    rdfs:comment 'Name of the subsidy or assistance program applied to the ticket fare (senior discount program, low-income assistance, employer subsidy, etc.).' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidyAmount rdf:type rdf:Property ;
    rdfs:label 'Subsidy Amount' ;
    rdfs:comment 'Dollar amount of subsidy applied to the ticket from federal, state, or local assistance programs. Denominated in US dollars.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservationNumber rdf:type rdf:Property ;
    rdfs:label 'Reservation Number' ;
    rdfs:comment 'Unique reservation identifier for advance-booking services such as ferry reservations or paratransit trips.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Booking Timestamp' ;
    rdfs:comment 'Date and time when the reservation was made, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. May differ from purchase_timestamp for advance bookings.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:posTerminalId rdf:type rdf:Property ;
    rdfs:label 'Pos Terminal Id' ;
    rdfs:comment 'Identifier of the point-of-sale terminal or ticket vending machine where the transaction occurred.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Terminal .

ind:receiptNumber rdf:type rdf:Property ;
    rdfs:label 'Receipt Number' ;
    rdfs:comment 'Unique receipt number issued for the transaction, used for accounting reconciliation and customer service.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibilityRequired rdf:type rdf:Property ;
    rdfs:label 'Accessibility Required' ;
    rdfs:comment 'Indicates whether the rider requires accessible vehicle or service accommodations under ADA requirements.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:companionCount rdf:type rdf:Property ;
    rdfs:label 'Companion Count' ;
    rdfs:comment 'Number of companions or personal care attendants traveling with the rider. Relevant for paratransit and accessible services.' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialAccommodation rdf:type rdf:Property ;
    rdfs:label 'Special Accommodation' ;
    rdfs:comment 'Description of special accommodations requested or provided (wheelchair, service animal, mobility device, etc.).' ;
    rdfs:domain ind:Ticket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riderId rdf:type rdf:Property ;
    rdfs:label 'Rider Id' ;
    rdfs:comment 'Unique identifier for the transit rider. Primary key for the rider master record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rider .

ind:streetAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Street Address Line 1' ;
    rdfs:comment 'Primary street address line for the rider\'s residential address.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streetAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Street Address Line 2' ;
    rdfs:comment 'Secondary street address line (apartment, suite, unit number) for the rider\'s residential address.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressSameAsResidential rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Same As Residential' ;
    rdfs:comment 'Indicates whether the mailing address is the same as the residential address.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailingStreetAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Street Address Line 1' ;
    rdfs:comment 'Primary street address line for the rider\'s mailing address if different from residential.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingStreetAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Mailing Street Address Line 2' ;
    rdfs:comment 'Secondary street address line for the rider\'s mailing address if different from residential.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingStateCode rdf:type rdf:Property ;
    rdfs:label 'Mailing State Code' ;
    rdfs:comment 'Two-letter state abbreviation for the rider\'s mailing address if different from residential.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the rider\'s mailing address if different from residential.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityType rdf:type rdf:Property ;
    rdfs:label 'Eligibility Type' ;
    rdfs:comment 'Primary eligibility category for the rider, determining fare discount eligibility and service access. Categories include senior (65+), youth, student, disabled (ADA eligible), veteran, low-income, Medicare, and Medicaid beneficiaries.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Status' ;
    rdfs:comment 'Current status of the rider\'s eligibility verification for special fare programs or paratransit services.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Date' ;
    rdfs:comment 'Date when the rider\'s eligibility was last verified for special fare programs or paratransit services.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Expiration Date' ;
    rdfs:comment 'Date when the rider\'s current eligibility status expires and requires re-verification.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adaEligible rdf:type rdf:Property ;
    rdfs:label 'Ada Eligible' ;
    rdfs:comment 'Indicates whether the rider is eligible for ADA paratransit services due to a disability that prevents use of fixed-route transit.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adaCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Ada Certification Number' ;
    rdfs:comment 'Unique certification number issued for ADA paratransit eligibility.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobilityAidRequired rdf:type rdf:Property ;
    rdfs:label 'Mobility Aid Required' ;
    rdfs:comment 'Indicates whether the rider requires a mobility aid (wheelchair, walker, scooter) for transit use.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobilityAidType rdf:type rdf:Property ;
    rdfs:label 'Mobility Aid Type' ;
    rdfs:comment 'Type of mobility aid used by the rider, important for vehicle capacity planning and accessibility compliance.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalCareAttendantAllowed rdf:type rdf:Property ;
    rdfs:label 'Personal Care Attendant Allowed' ;
    rdfs:comment 'Indicates whether the rider is authorized to travel with a personal care attendant at no additional fare.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:companionAllowed rdf:type rdf:Property ;
    rdfs:label 'Companion Allowed' ;
    rdfs:comment 'Indicates whether the rider is allowed to bring a companion on paratransit trips.' ;
    rdfs:domain ind:Rider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationPreference rdf:type rdf:Property ;
    rdfs:label 'Communication Preference' ;
    rdfs:comment 'Rider\'s preferred method for receiving service alerts, notifications, and communications.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'Unique account number assigned to the rider for fare payment and loyalty program tracking.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fareCardNumber rdf:type rdf:Property ;
    rdfs:label 'Fare Card Number' ;
    rdfs:comment 'Unique identifier for the rider\'s transit fare card or smart card.' ;
