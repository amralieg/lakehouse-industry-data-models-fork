ind:coastalBarrierSystemIndicator rdf:type rdf:Property ;
    rdfs:label 'Coastal Barrier System Indicator' ;
    rdfs:comment 'Flag indicating whether the location is within a Coastal Barrier Resources System area where federal flood insurance is restricted.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:determinationDate rdf:type rdf:Property ;
    rdfs:label 'Determination Date' ;
    rdfs:comment 'Date when the flood zone determination was performed for the insured location.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:determinationMethod rdf:type rdf:Property ;
    rdfs:label 'Determination Method' ;
    rdfs:comment 'Method used to determine the flood zone classification for the location.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:determinationNumber rdf:type rdf:Property ;
    rdfs:label 'Determination Number' ;
    rdfs:comment 'Unique tracking number issued by the flood determination service provider for this assessment.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:determinationProvider rdf:type rdf:Property ;
    rdfs:label 'Determination Provider' ;
    rdfs:comment 'Name of the third-party vendor or service that performed the flood zone determination.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elevationCertificateAvailable rdf:type rdf:Property ;
    rdfs:label 'Elevation Certificate Available' ;
    rdfs:comment 'Flag indicating whether a FEMA Elevation Certificate has been obtained for the insured structure.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
