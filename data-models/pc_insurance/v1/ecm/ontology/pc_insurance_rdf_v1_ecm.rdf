    rdfs:range ind:Country .

ind:recipientStateId rdf:type rdf:Property ;
    rdfs:label 'Recipient State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Document recipient state determines delivery method compliance and notice period requirements. FK to shared.state enables state-specific document delivery rules.' ;
    rdfs:domain ind:Document ;
