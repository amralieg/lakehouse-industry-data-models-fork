ind:triggeringTransactionType rdf:type rdf:Property ;
    rdfs:label 'Triggering Transaction Type' ;
    rdfs:comment 'The type of policy transaction that caused this status transition. [ENUM-REF-CANDIDATE: new_business|renewal|endorsement|cancellation|reinstatement|non_renewal|lapse|expiration — 8 candidates stripped; promote to reference product]' ;
