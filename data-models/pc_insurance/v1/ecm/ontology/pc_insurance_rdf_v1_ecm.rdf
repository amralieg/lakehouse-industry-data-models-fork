    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageType rdf:type rdf:Property ;
    rdfs:label 'Storage Type' ;
    rdfs:comment 'Classification of how and where the equipment is stored when not in use.' ;
    rdfs:domain ind:Riskexposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoDocumentId rdf:type rdf:Property ;
