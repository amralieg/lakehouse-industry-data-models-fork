ind:repairScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Repair Scope Description' ;
    rdfs:comment 'Detailed description of the proposed repair work, including materials, labor, and methods.' ;
    rdfs:domain ind:RepairEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subletCostAmount rdf:type rdf:Property ;
    rdfs:label 'Sublet Cost Amount' ;
    rdfs:comment 'Cost of subcontracted or outsourced work (e.g., glass, upholstery, specialty trades), in policy currency.' ;
    rdfs:domain ind:RepairEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supplementNumber rdf:type rdf:Property ;
    rdfs:label 'Supplement Number' ;
    rdfs:comment 'Sequential number indicating this is the Nth supplement to the original estimate (0 for initial estimate).' ;
    rdfs:domain ind:RepairEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supplementReason rdf:type rdf:Property ;
    rdfs:label 'Supplement Reason' ;
    rdfs:comment 'Explanation for why a supplemental estimate was required (e.g., hidden damage discovered, scope change, price adjustment).' ;
    rdfs:domain ind:RepairEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Total Estimate Amount' ;
    rdfs:comment 'Total estimated cost of the repair including parts, labor, materials, sublet, and taxes, in policy currency.' ;
    rdfs:domain ind:RepairEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageDispositionId rdf:type rdf:Property ;
    rdfs:label 'Salvage Disposition Id' ;
    rdfs:comment 'Unique identifier for the salvage disposition record.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salvagePartyId rdf:type rdf:Property ;
    rdfs:label 'Salvage Party Id' ;
    rdfs:comment 'Identifier of the attorney handling subrogation litigation if legal action is involved.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:salvageSubrogationTargetPartyId rdf:type rdf:Property ;
    rdfs:label 'Salvage Subrogation Target Party Id' ;
    rdfs:comment 'Identifier of the liable third party from whom subrogation recovery is being pursued.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:abandonmentReason rdf:type rdf:Property ;
    rdfs:label 'Abandonment Reason' ;
    rdfs:comment 'Reason for abandoning the salvage or subrogation pursuit if status is abandoned.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualSalvageValue rdf:type rdf:Property ;
    rdfs:label 'Actual Salvage Value' ;
    rdfs:comment 'Actual amount recovered from the sale or disposition of salvaged property.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispositionNotes rdf:type rdf:Property ;
    rdfs:label 'Disposition Notes' ;
    rdfs:comment 'Free-text notes documenting key events, decisions, and outcomes in the salvage or subrogation pursuit.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionNumber rdf:type rdf:Property ;
    rdfs:label 'Disposition Number' ;
    rdfs:comment 'Business identifier for this salvage or subrogation disposition record.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionStatus rdf:type rdf:Property ;
    rdfs:label 'Disposition Status' ;
    rdfs:comment 'Current lifecycle status of the salvage or subrogation pursuit.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedSalvageValue rdf:type rdf:Property ;
    rdfs:label 'Estimated Salvage Value' ;
    rdfs:comment 'Estimated market value of the salvaged property at the time of disposition opening.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:litigationFiledDate rdf:type rdf:Property ;
    rdfs:label 'Litigation Filed Date' ;
    rdfs:comment 'Date when legal action was filed for subrogation recovery.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryExpenses rdf:type rdf:Property ;
    rdfs:label 'Recovery Expenses' ;
    rdfs:comment 'Total expenses incurred in pursuing salvage or subrogation recovery, including legal fees, vendor fees, and administrative costs.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saleDate rdf:type rdf:Property ;
    rdfs:label 'Sale Date' ;
    rdfs:comment 'Date when the salvaged property was sold or disposed of.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:saleMethod rdf:type rdf:Property ;
    rdfs:label 'Sale Method' ;
    rdfs:comment 'Method used to dispose of salvaged property: auction, private sale, scrap, donation, retained by insured, or other.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageItemType rdf:type rdf:Property ;
    rdfs:label 'Salvage Item Type' ;
    rdfs:comment 'Category of salvaged item: vehicle total loss, building materials, equipment, inventory, personal property, or other.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationDemandAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Demand Amount' ;
    rdfs:comment 'Total amount demanded from the liable third party in subrogation pursuit.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationRecoveredAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Recovered Amount' ;
    rdfs:comment 'Actual amount recovered through subrogation from the liable third party.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationTargetName rdf:type rdf:Property ;
    rdfs:label 'Subrogation Target Name' ;
    rdfs:comment 'Name of the liable third party or entity against whom subrogation is pursued.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleStatus rdf:type rdf:Property ;
    rdfs:label 'Title Status' ;
    rdfs:comment 'Legal title status of salvaged vehicle or property: clean, salvage, rebuilt, junk, pending transfer, or not applicable.' ;
    rdfs:domain ind:SalvageDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleVin rdf:type rdf:Property ;
    rdfs:label 'Vehicle Vin' ;
    rdfs:comment '17-character VIN for salvaged vehicle if recovery involves an auto total loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siuReferralId rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Id' ;
    rdfs:comment 'Unique identifier for the siu_referral data product (auto-inserted during validation).' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referringPartyId rdf:type rdf:Property ;
    rdfs:label 'Referring Party Id' ;
    rdfs:comment 'Identifier of the person or system that initiated the SIU referral.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Case number assigned by law enforcement agency for tracking prosecution.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueReportOrderedFlag rdf:type rdf:Property ;
    rdfs:label 'Clue Report Ordered Flag' ;
    rdfs:comment 'Indicates whether a CLUE report was ordered as part of the investigation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confirmedFraudAmount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Fraud Amount' ;
    rdfs:comment 'Confirmed dollar value of fraud identified after investigation completion.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposition rdf:type rdf:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Action taken or recommended based on the investigation outcome. [ENUM-REF-CANDIDATE: claim_denied|claim_adjusted|claim_paid|prosecution_recommended|civil_action|no_action|pending_review — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedFraudAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Fraud Amount' ;
    rdfs:comment 'Estimated dollar value of the suspected fraudulent claim or loss.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evidenceSummary rdf:type rdf:Property ;
    rdfs:label 'Evidence Summary' ;
    rdfs:comment 'Summary of evidence collected during the investigation supporting the outcome.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalDatabaseCheckFlag rdf:type rdf:Property ;
    rdfs:label 'External Database Check Flag' ;
    rdfs:comment 'Indicates whether external databases such as CLUE or ISO were queried during investigation.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudIndicatorCode rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Code' ;
    rdfs:comment 'Primary fraud indicator or red flag code that triggered the referral.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudIndicatorDescription rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Description' ;
    rdfs:comment 'Detailed description of the fraud indicator or suspicious activity observed.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudSchemeCategory rdf:type rdf:Property ;
    rdfs:label 'Fraud Scheme Category' ;
    rdfs:comment 'Category of fraud scheme suspected, such as staged accident, inflated claim, or false injury. [ENUM-REF-CANDIDATE: staged_accident|inflated_claim|false_injury|phantom_treatment|identity_theft|arson|premium_fraud|application_fraud — promote to reference' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudType rdf:type rdf:Property ;
    rdfs:label 'Fraud Type' ;
    rdfs:comment 'Classification of the suspected fraud type based on nature and severity.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCloseDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Close Date' ;
    rdfs:comment 'Date the SIU investigation was completed and closed.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationNotes rdf:type rdf:Property ;
    rdfs:label 'Investigation Notes' ;
    rdfs:comment 'Detailed notes and findings from the SIU investigation process.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationOutcome rdf:type rdf:Property ;
    rdfs:label 'Investigation Outcome' ;
    rdfs:comment 'Final determination of the SIU investigation regarding fraud presence.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Start Date' ;
    rdfs:comment 'Date the formal SIU investigation commenced.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isoClaimSearchFlag rdf:type rdf:Property ;
    rdfs:label 'Iso Claim Search Flag' ;
    rdfs:comment 'Indicates whether an ISO ClaimSearch was performed during the investigation.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementAgency rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Agency' ;
    rdfs:comment 'Name of the law enforcement agency to which the case was referred.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementReferralDate rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Date' ;
    rdfs:comment 'Date the case was referred to law enforcement authorities.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Flag' ;
    rdfs:comment 'Indicates whether the case was referred to law enforcement for criminal prosecution.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naicFraudCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Naic Fraud Category Code' ;
    rdfs:comment 'NAIC standardized code for fraud category used in regulatory reporting.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nicbReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Nicb Referral Flag' ;
    rdfs:comment 'Indicates whether the case was referred to NICB for industry-wide fraud tracking.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyCancellationRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Policy Cancellation Recommended Flag' ;
    rdfs:comment 'Indicates whether policy cancellation was recommended based on fraud findings.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryActionTaken rdf:type rdf:Property ;
    rdfs:label 'Recovery Action Taken' ;
    rdfs:comment 'Type of recovery action pursued to recoup fraudulent payments or losses.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralNumber rdf:type rdf:Property ;
    rdfs:label 'Referral Number' ;
    rdfs:comment 'Business identifier for the SIU referral, used for tracking and reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralSource rdf:type rdf:Property ;
    rdfs:label 'Referral Source' ;
    rdfs:comment 'Origin or channel through which the fraud suspicion was identified and referred. [ENUM-REF-CANDIDATE: adjuster|underwriter|automated_system|tip_line|claimant_interview|medical_review|surveillance|external_agency — 8 candidates stripped; promote to' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralStatus rdf:type rdf:Property ;
    rdfs:label 'Referral Status' ;
    rdfs:comment 'Current status of the SIU referral in the investigation lifecycle.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralTimestamp rdf:type rdf:Property ;
    rdfs:label 'Referral Timestamp' ;
    rdfs:comment 'Precise timestamp when the referral was created in the system.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referringPartyRole rdf:type rdf:Property ;
    rdfs:label 'Referring Party Role' ;
    rdfs:comment 'Role of the party who made the referral, such as adjuster, underwriter, or system.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:savingsAmount rdf:type rdf:Property ;
    rdfs:label 'Savings Amount' ;
    rdfs:comment 'Dollar amount saved by the insurer through fraud detection and prevention.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statementObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Statement Obtained Flag' ;
    rdfs:comment 'Indicates whether a formal statement was obtained from the claimant or suspect.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveillanceConductedFlag rdf:type rdf:Property ;
    rdfs:label 'Surveillance Conducted Flag' ;
    rdfs:comment 'Indicates whether physical or digital surveillance was conducted during investigation.' ;
    rdfs:domain ind:SiuReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:additionalInterestId rdf:type rdf:Property ;
    rdfs:label 'Additional Interest Id' ;
    rdfs:comment 'Unique identifier for the additional interest record.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blanketDescription rdf:type rdf:Property ;
    rdfs:label 'Blanket Description' ;
    rdfs:comment 'Description of the criteria or class of parties covered under a blanket additional insured endorsement.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blanketIndicator rdf:type rdf:Property ;
    rdfs:label 'Blanket Indicator' ;
    rdfs:comment 'Indicates whether this is a blanket additional insured endorsement covering multiple unnamed parties meeting specified criteria.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Days' ;
    rdfs:comment 'Number of days advance notice required to be given to this additional interest before policy cancellation.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificateHolderIndicator rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Indicator' ;
    rdfs:comment 'Indicates whether this party requires a Certificate of Insurance (CoI) to be issued.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateIssueDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Issue Date' ;
    rdfs:comment 'Date when the Certificate of Insurance (CoI) was issued to this additional interest.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Reference Number' ;
    rdfs:comment 'External contract or agreement number that requires this additional interest attachment.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementNumber rdf:type rdf:Property ;
    rdfs:label 'Endorsement Number' ;
    rdfs:comment 'Policy endorsement number that added or modified this additional interest.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestDescription rdf:type rdf:Property ;
    rdfs:label 'Interest Description' ;
    rdfs:comment 'Detailed description of the nature and scope of the additional interest.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestName rdf:type rdf:Property ;
    rdfs:label 'Interest Name' ;
    rdfs:comment 'Full legal name of the additional interest party as it appears on the policy.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestTypeCode rdf:type rdf:Property ;
    rdfs:label 'Interest Type Code' ;
    rdfs:comment 'Type of additional interest: AI (Additional Insured), ALI (Additional Loss Payee), LP (Loss Payee), MORT (Mortgagee), LH (Lienholder), COI (Certificate of Insurance Holder).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoFormNumber rdf:type rdf:Property ;
    rdfs:label 'Iso Form Number' ;
    rdfs:comment 'ISO form number used to attach this additional interest (e.g., CG 20 10 for Additional Insured).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanAmount rdf:type rdf:Property ;
    rdfs:label 'Loan Amount' ;
    rdfs:comment 'Outstanding loan or lien amount secured by the insured property.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryIndicator rdf:type rdf:Property ;
    rdfs:label 'Primary Indicator' ;
    rdfs:comment 'Indicates whether this is the primary additional interest when multiple interests exist on the same coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rankOrder rdf:type rdf:Property ;
    rdfs:label 'Rank Order' ;
    rdfs:comment 'Priority ranking for loss payment distribution when multiple interests exist (1 = highest priority).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:removalDate rdf:type rdf:Property ;
    rdfs:label 'Removal Date' ;
    rdfs:comment 'Date when the additional interest was removed from the coverage.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:removalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Removal Reason Code' ;
    rdfs:comment 'Reason for removing the additional interest: loan paid off, contract ended, party request, or data entry error.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverOfSubrogationIndicator rdf:type rdf:Property ;
    rdfs:label 'Waiver Of Subrogation Indicator' ;
    rdfs:comment 'Indicates whether the insurer waives subrogation rights against this additional interest.' ;
    rdfs:domain ind:AdditionalInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageConditionId rdf:type rdf:Property ;
    rdfs:label 'Coverage Condition Id' ;
    rdfs:comment 'Unique identifier for the condition data product (auto-inserted during validation).' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agreedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Agreed Value Amount' ;
    rdfs:comment 'The agreed value amount established for the insured property when agreed_value_indicator is true. Null otherwise.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agreedValueIndicator rdf:type rdf:Property ;
    rdfs:label 'Agreed Value Indicator' ;
    rdfs:comment 'True if this condition waives coinsurance and establishes an agreed value for the insured property. False otherwise.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clauseText rdf:type rdf:Property ;
    rdfs:label 'Clause Text' ;
    rdfs:comment 'Full legal text of the condition clause as it appears in the policy contract or endorsement form.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percentage' ;
    rdfs:comment 'Coinsurance percentage required under the condition. Typically 80%, 90%, or 100%. Null if condition is not coinsurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceStatusCode rdf:type rdf:Property ;
    rdfs:label 'Compliance Status Code' ;
    rdfs:comment 'Current compliance status: COMP=Compliant, NCOMP=Non-compliant, PEND=Pending verification, WAIV=Waived, UNKN=Unknown.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Verification Date' ;
    rdfs:comment 'Date on which compliance with this condition was last verified by the insurer or third party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceVerifiedBy rdf:type rdf:Property ;
    rdfs:label 'Compliance Verified By' ;
    rdfs:comment 'Name or identifier of the party who verified compliance: underwriter, inspector, third-party auditor, or insured self-certification.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageConditionDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Condition Description' ;
    rdfs:comment 'Detailed description of the condition, including its purpose and applicability to the coverage.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionFrequencyCode rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Code' ;
    rdfs:comment 'Frequency of inspection required: MONTH=Monthly, QUAR=Quarterly, SEMI=Semi-annually, ANN=Annually, ONDEM=On Demand. Null if not an inspection condition.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryIndicator rdf:type rdf:Property ;
    rdfs:label 'Mandatory Indicator' ;
    rdfs:comment 'True if this condition is mandatory per regulatory or underwriting requirements and cannot be waived. False if optional or negotiable.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marginPercentage rdf:type rdf:Property ;
    rdfs:label 'Margin Percentage' ;
    rdfs:comment 'Margin percentage allowed under a margin clause condition. Null if condition is not a margin clause.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageConditionName rdf:type rdf:Property ;
    rdfs:label 'Coverage Condition Name' ;
    rdfs:comment 'Business-friendly name of the condition as it appears on the policy declarations page.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonComplianceReason rdf:type rdf:Property ;
    rdfs:label 'Non Compliance Reason' ;
    rdfs:comment 'Explanation of why the insured is non-compliant with this condition. Null if compliant or status is unknown.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyMethodCode rdf:type rdf:Property ;
    rdfs:label 'Penalty Method Code' ;
    rdfs:comment 'Method for calculating penalty if condition is not met: PROP=Proportional reduction, FLAT=Flat penalty amount, NONE=No penalty specified.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Indicator' ;
    rdfs:comment 'True if this condition is required by state or federal regulation. False if it is a voluntary underwriting condition.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Days' ;
    rdfs:comment 'Number of days after the reporting period end by which the insured must submit the report. Null if not a reporting condition.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingFrequencyCode rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency Code' ;
    rdfs:comment 'Frequency of reporting required under a reporting condition: MONTH=Monthly, QUAR=Quarterly, SEMI=Semi-annually, ANN=Annually. Null if not a reporting condition.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeCode rdf:type rdf:Property ;
    rdfs:label 'Type Code' ;
    rdfs:comment 'Type of condition: COINS=Coinsurance, AGRVAL=Agreed Value, MARGIN=Margin Clause, REPORT=Reporting Requirement, INSP=Inspection Requirement, WARR=Warranty.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverGrantedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Granted By' ;
    rdfs:comment 'Name or identifier of the underwriter or authority who granted the waiver. Null if no waiver granted.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverGrantedDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Granted Date' ;
    rdfs:comment 'Date on which the waiver was granted by the insurer. Null if no waiver granted.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverGrantedIndicator rdf:type rdf:Property ;
    rdfs:label 'Waiver Granted Indicator' ;
    rdfs:comment 'True if the insurer has granted a waiver of this condition for the current policy term. False otherwise.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyDescription rdf:type rdf:Property ;
    rdfs:label 'Warranty Description' ;
    rdfs:comment 'Detailed description of the warranty obligation the insured must fulfill. Null if not a warranty condition.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyTypeCode rdf:type rdf:Property ;
    rdfs:label 'Warranty Type Code' ;
    rdfs:comment 'Type of warranty: PROM=Promissory (future action), AFFIRM=Affirmative (current state), COND=Conditional (if-then). Null if not a warranty condition.' ;
    rdfs:domain ind:CoverageCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureUnitOfMeasureId rdf:type rdf:Property ;
    rdfs:label 'Exposure Unit Of Measure Id' ;
    rdfs:comment 'Foreign key linking to shared.unit_of_measure. Business justification: Coverage exposure_units field requires UOM reference for rating basis validation, premium audit calculations, and exposure aggregation.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitOfMeasure .

ind:facAgreementId rdf:type rdf:Property ;
    rdfs:label 'Fac Agreement Id' ;
    rdfs:comment 'Foreign key linking to reinsurance.fac_agreement. Business justification: Facultative reinsurance is placed on specific high-value or unusual coverages. Underwriters and reinsurance managers need to track which coverages have facultative protection for' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacAgreement .

ind:partId rdf:type rdf:Property ;
    rdfs:label 'Part Id' ;
    rdfs:comment 'Foreign key linking to coverage.part. Business justification: coverage currently has \'part\' as STRING attribute. part is a product in this domain representing named coverage parts within CPP/BOP (e.g., Commercial Property, CGL).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Part .

ind:priorCoverageId rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Id' ;
    rdfs:comment 'Foreign key to the previous version of this coverage, if this is an endorsement or renewal.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coverage .

ind:aggregateLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Amount' ;
    rdfs:comment 'Maximum total amount payable under this coverage for all occurrences during the policy term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPercentage rdf:type rdf:Property ;
    rdfs:label 'Ceded Percentage' ;
    rdfs:comment 'Percentage of this coverage ceded to reinsurers.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Current lifecycle status of the coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Description' ;
    rdfs:comment 'Detailed textual description of what this coverage protects against.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureUnits rdf:type rdf:Property ;
    rdfs:label 'Exposure Units' ;
    rdfs:comment 'Number of rating units used to calculate premium (e.g., payroll amount, number of vehicles).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:formEditionDate rdf:type rdf:Property ;
    rdfs:label 'Form Edition Date' ;
    rdfs:comment 'Edition date of the coverage form used.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:formNumber rdf:type rdf:Property ;
    rdfs:label 'Form Number' ;
    rdfs:comment 'ISO or proprietary form number defining the coverage terms and conditions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMandatoryCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory Coverage' ;
    rdfs:comment 'Indicates whether this coverage is required by law or regulation.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOptionalCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Optional Coverage' ;
    rdfs:comment 'Indicates whether this coverage was elected by the insured as optional.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Primary Coverage' ;
    rdfs:comment 'Indicates whether this is the primary coverage on the policy term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Iso Coverage Code' ;
    rdfs:comment 'Standardized ISO code for this coverage type.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicLineCode rdf:type rdf:Property ;
    rdfs:label 'Naic Line Code' ;
    rdfs:comment 'NAIC line of business code for statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perOccurrenceLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit Amount' ;
    rdfs:comment 'Maximum amount payable per occurrence or event under this coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rate rdf:type rdf:Property ;
    rdfs:label 'Rate' ;
    rdfs:comment 'Rating factor or rate per unit applied to calculate premium for this coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingBasis rdf:type rdf:Property ;
    rdfs:label 'Rating Basis' ;
    rdfs:comment 'Unit of measure used for rating (e.g., per $1000 of coverage, per vehicle, per square foot).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Sub Coverage Code' ;
    rdfs:comment 'Code for sub-coverage or endorsement modifying the base coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territory rdf:type rdf:Property ;
    rdfs:label 'Territory' ;
    rdfs:comment 'Geographic territory where the coverage applies (e.g., USA, Worldwide).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationMethod rdf:type rdf:Property ;
    rdfs:label 'Valuation Method' ;
    rdfs:comment 'Method used to determine the value of a covered loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveragePerilId rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Id' ;
    rdfs:comment 'Primary key for peril' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:perilLinkId rdf:type rdf:Property ;
    rdfs:label 'Peril Link Id' ;
    rdfs:comment 'Unique identifier for the coverage peril reference record. Primary key.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerilLink .

ind:catIndicator rdf:type rdf:Property ;
    rdfs:label 'Cat Indicator' ;
    rdfs:comment 'Flag indicating whether this peril is classified as a catastrophe peril for exposure aggregation and Probable Maximum Loss (PML) modeling.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catModelCode rdf:type rdf:Property ;
    rdfs:label 'Cat Model Code' ;
    rdfs:comment 'Code identifying the catastrophe model used for this peril (e.g., RMS Hurricane, AIR Earthquake). Null if not a CAT peril.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsuranceApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Applicable Indicator' ;
    rdfs:comment 'Flag indicating whether coinsurance provisions typically apply to this peril.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coveragePerilStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Status' ;
    rdfs:comment 'Current lifecycle status of the peril reference record (e.g., ACTIVE, INACTIVE, DEPRECATED, PENDING).' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTrigger rdf:type rdf:Property ;
    rdfs:label 'Coverage Trigger' ;
    rdfs:comment 'The event that triggers coverage for this peril (e.g., OCCURRENCE, CLAIMS_MADE, LOSS_SUSTAINED, DISCOVERY).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Deductible Applicable Indicator' ;
    rdfs:comment 'Flag indicating whether a deductible typically applies to claims under this peril.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coveragePerilDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Peril Description' ;
    rdfs:comment 'Detailed business description of the peril, including coverage scope, typical exclusions, and underwriting considerations.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facultativeTypicalIndicator rdf:type rdf:Property ;
    rdfs:label 'Facultative Typical Indicator' ;
    rdfs:comment 'Flag indicating whether this peril commonly requires facultative reinsurance placement.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:firstPartyIndicator rdf:type rdf:Property ;
    rdfs:label 'First Party Indicator' ;
    rdfs:comment 'Flag indicating whether this peril applies to first-party (insured\'s own) losses.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoPerilCode rdf:type rdf:Property ;
    rdfs:label 'Iso Peril Code' ;
    rdfs:comment 'ISO standard peril code used for forms, rating, and industry benchmarking.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilCategory rdf:type rdf:Property ;
    rdfs:label 'Peril Category' ;
    rdfs:comment 'Line of business category to which the peril applies (e.g., PROPERTY, CASUALTY, LIABILITY, AUTO, WORKERS_COMP, SPECIALTY).' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilName rdf:type rdf:Property ;
    rdfs:label 'Peril Name' ;
    rdfs:comment 'Full descriptive name of the peril (e.g., Fire, Windstorm, Theft, Flood, General Liability).' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Pml Applicable Indicator' ;
    rdfs:comment 'Flag indicating whether Probable Maximum Loss (PML) calculations apply to this peril for exposure management.' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Indicator' ;
    rdfs:comment 'Flag indicating whether losses from this peril require specific regulatory reporting (e.g., CAT event reporting to state DOI).' ;
    rdfs:domain ind:CoveragePeril ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceTreatyEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether losses from this peril are typically eligible for treaty reinsurance cession.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric sequence for display ordering of perils in user interfaces and reports.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sublimitTypicalIndicator rdf:type rdf:Property ;
    rdfs:label 'Sublimit Typical Indicator' ;
    rdfs:comment 'Flag indicating whether sublimits are commonly applied to this peril (e.g., jewelry, fine arts, flood).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyIndicator rdf:type rdf:Property ;
    rdfs:label 'Third Party Indicator' ;
    rdfs:comment 'Flag indicating whether this peril applies to third-party (liability) losses.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aggregateLimitApplies rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Applies' ;
    rdfs:comment 'Indicates whether an aggregate limit applies to this peril across all claims during the policy term.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToFirstParty rdf:type rdf:Property ;
    rdfs:label 'Applies To First Party' ;
    rdfs:comment 'Indicates whether this peril coverage applies to first-party claims (insured\'s own losses).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToThirdParty rdf:type rdf:Property ;
    rdfs:label 'Applies To Third Party' ;
    rdfs:comment 'Indicates whether this peril coverage applies to third-party claims (liability to others).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buybackAvailableIndicator rdf:type rdf:Property ;
    rdfs:label 'Buyback Available Indicator' ;
    rdfs:comment 'Indicates whether the insured can buy back coverage for this peril if it is excluded by default.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buybackPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Buyback Premium Amount' ;
    rdfs:comment 'Additional premium charged to buy back coverage for this peril. Null if buyback is not available or not exercised.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catPerilIndicator rdf:type rdf:Property ;
    rdfs:label 'Cat Peril Indicator' ;
    rdfs:comment 'Indicates whether this peril is classified as a catastrophe peril for exposure aggregation and PML modeling purposes.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catZoneApplicable rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Applicable' ;
    rdfs:comment 'Indicates whether catastrophe zone restrictions apply to this peril coverage.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleBasis rdf:type rdf:Property ;
    rdfs:label 'Deductible Basis' ;
    rdfs:comment 'Basis on which the peril deductible applies, such as per occurrence, per claim, aggregate, or per location.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleCurrency rdf:type rdf:Property ;
    rdfs:label 'Deductible Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the deductible amount.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductiblePercentage rdf:type rdf:Property ;
    rdfs:label 'Deductible Percentage' ;
    rdfs:comment 'Percentage deductible applied to the loss amount for this peril, if deductible type is percentage. Null otherwise.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Endorsement Effective Date' ;
    rdfs:comment 'Effective date of the endorsement that modified this coverage-peril association. Null if no endorsement applies.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extendedReportingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Extended Reporting Period Days' ;
    rdfs:comment 'Number of days after policy expiration during which claims may be reported for this peril under claims-made coverage. Null if not applicable.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Inclusion Status' ;
    rdfs:comment 'Indicates whether the peril is included in, excluded from, or conditionally covered under the coverage.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilLinkStatus rdf:type rdf:Property ;
    rdfs:label 'Peril Link Status' ;
    rdfs:comment 'Current lifecycle status of the coverage-peril association.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perilTypeCode rdf:type rdf:Property ;
    rdfs:label 'Peril Type Code' ;
    rdfs:comment 'Classification code for the type of peril, such as fire, wind, hail, theft, flood, earthquake, or liability event.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryMandateIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate Indicator' ;
    rdfs:comment 'Indicates whether inclusion or exclusion of this peril is mandated by state or federal regulation.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date' ;
    rdfs:comment 'Retroactive date for claims-made coverage. Claims arising from events before this date are not covered. Null for occurrence-based coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateMandateCode rdf:type rdf:Property ;
    rdfs:label 'State Mandate Code' ;
    rdfs:comment 'Two-letter state code if this peril association is mandated by state-specific regulation. Null if not state-mandated.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sublimitAmount rdf:type rdf:Property ;
    rdfs:label 'Sublimit Amount' ;
    rdfs:comment 'Override limit amount specific to this peril, if different from the coverage limit. Null if no sublimit applies.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sublimitBasis rdf:type rdf:Property ;
    rdfs:label 'Sublimit Basis' ;
    rdfs:comment 'Basis on which the peril sublimit applies, such as per occurrence, per claim, aggregate, per location, or per person.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sublimitCurrency rdf:type rdf:Property ;
    rdfs:label 'Sublimit Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the sublimit amount.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'Type of trigger that activates coverage for this peril: occurrence-based, claims-made, or claims-made-and-reported.' ;
    rdfs:domain ind:PerilLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterNotes rdf:type rdf:Property ;
    rdfs:label 'Underwriter Notes' ;
    rdfs:comment 'Free-text notes from the underwriter regarding the inclusion, exclusion, or modification of this peril.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Days' ;
    rdfs:comment 'Number of days after policy inception before coverage for this peril becomes effective. Zero if no waiting period applies.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acordCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Acord Coverage Code' ;
    rdfs:comment 'ACORD standard coverage code for data exchange with agents, brokers, and trading partners. Enables interoperability across industry systems.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregateLimitRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Required Indicator' ;
    rdfs:comment 'True if this coverage type requires an aggregate limit for the policy term; false if per-occurrence only. Used in exposure tracking and limit erosion monitoring.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catastropheEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Eligible Indicator' ;
    rdfs:comment 'True if losses under this coverage may be designated as catastrophe losses for aggregation and reinsurance purposes; false otherwise.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsMadeIndicator rdf:type rdf:Property ;
    rdfs:label 'Claims Made Indicator' ;
    rdfs:comment 'True if coverage is triggered only when claim is made during the policy period; false if occurrence-based. Affects tail coverage and extended reporting periods.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coinsuranceAllowedIndicator rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Allowed Indicator' ;
    rdfs:comment 'True if coinsurance provisions may be attached to this coverage; false otherwise. Determines whether insured shares in loss beyond deductible.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageCategory rdf:type rdf:Property ;
    rdfs:label 'Coverage Category' ;
    rdfs:comment 'High-level classification grouping coverages by type of risk protected. Used for portfolio analysis and exposure aggregation.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the coverage type within the insurer\'s catalog. Business identifier used in rating, policy issuance, and claims.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageName rdf:type rdf:Property ;
    rdfs:label 'Coverage Name' ;
    rdfs:comment 'Full business name of the coverage type as displayed on policy documents and declarations pages.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Deductible Required Indicator' ;
    rdfs:comment 'True if a deductible must be specified for this coverage; false if no deductible applies. Influences rating and claims payment calculations.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defenseCostIncludedIndicator rdf:type rdf:Property ;
    rdfs:label 'Defense Cost Included Indicator' ;
    rdfs:comment 'True if defense and legal costs are included within the coverage limit; false if provided in addition to limit. Critical for liability coverage reserving.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoCoverageSymbol rdf:type rdf:Property ;
    rdfs:label 'Iso Coverage Symbol' ;
    rdfs:comment 'Standard ISO coverage symbol used for industry-wide classification and statistical reporting. Enables benchmarking and regulatory compliance.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoEditionDate rdf:type rdf:Property ;
    rdfs:label 'Iso Edition Date' ;
    rdfs:comment 'Edition date of the ISO form used for this coverage type. Ensures correct form version is applied to policies.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:naicCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Naic Coverage Code' ;
    rdfs:comment 'NAIC standardized coverage code for statutory reporting and regulatory filings. Required for Schedule P and Annual Statement submissions.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceBasisIndicator rdf:type rdf:Property ;
    rdfs:label 'Occurrence Basis Indicator' ;
    rdfs:comment 'True if coverage is triggered by loss occurrence during the policy period regardless of when reported; false if claims-made. Critical for reserving and IBNR estimation.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optionalIndicator rdf:type rdf:Property ;
    rdfs:label 'Optional Indicator' ;
    rdfs:comment 'True if this coverage may be elected by the policyholder; false if automatically included. Used in quote presentation and policy customization.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perOccurrenceLimitRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit Required Indicator' ;
    rdfs:comment 'True if this coverage type requires a per-occurrence limit; false if aggregate-only or unlimited. Drives limit configuration in policy issuance.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateTypeCode rdf:type rdf:Property ;
    rdfs:label 'Rate Type Code' ;
    rdfs:comment 'Type of rate structure applied: per-unit rate, percentage of value, flat fee, tiered schedule, or experience-rated. Determines premium calculation method.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingBasisCode rdf:type rdf:Property ;
    rdfs:label 'Rating Basis Code' ;
    rdfs:comment 'Unit of measure used to calculate premium for this coverage: exposure units, payroll, sales, area, number of units, underlying premium, or flat charge. [ENUM-REF-CANDIDATE: EXPOSURE|PAYROLL|SALES|AREA|UNITS|PREMIUM|FLAT — 7 candidates stripped; promote to' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Required Indicator' ;
    rdfs:comment 'True if this coverage type requires state Department of Insurance approval before use; false if filed-and-use or exempt. Drives compliance workflow.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salvageAllowedIndicator rdf:type rdf:Property ;
    rdfs:label 'Salvage Allowed Indicator' ;
    rdfs:comment 'True if the insurer may take salvage rights on damaged property after total loss settlement; false otherwise. Relevant for property and auto physical damage coverages.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sublimitAllowedIndicator rdf:type rdf:Property ;
    rdfs:label 'Sublimit Allowed Indicator' ;
    rdfs:comment 'True if sublimits may be applied to specific perils or property classes within this coverage; false if single limit only. Used in complex commercial policies.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subrogationAllowedIndicator rdf:type rdf:Property ;
    rdfs:label 'Subrogation Allowed Indicator' ;
    rdfs:comment 'True if the insurer retains subrogation rights after paying a claim under this coverage; false if waived. Impacts recovery potential and claims handling.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supplementaryPaymentsIndicator rdf:type rdf:Property ;
    rdfs:label 'Supplementary Payments Indicator' ;
    rdfs:comment 'True if coverage includes supplementary payments such as bail bonds, loss of earnings, or post-judgment interest in addition to limits; false otherwise.' ;
    rdfs:domain ind:CoverageType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valuationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Valuation Method Code' ;
    rdfs:comment 'Method used to determine loss settlement value: Actual Cash Value, Replacement Cost, Agreed Value, Stated Amount, Functional Replacement, or Market Value.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleId rdf:type rdf:Property ;
    rdfs:label 'Deductible Id' ;
    rdfs:comment 'Unique identifier for the deductible record. Primary key.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acordCode rdf:type rdf:Property ;
    rdfs:label 'Acord Code' ;
    rdfs:comment 'ACORD standard code for this deductible type, used for data exchange and reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregateLimit rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit' ;
    rdfs:comment 'Maximum total deductible amount the insured must pay during the policy term when deductible_basis is aggregate_annual.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliesToCoveragePart rdf:type rdf:Property ;
    rdfs:label 'Applies To Coverage Part' ;
    rdfs:comment 'Specific coverage part to which this deductible applies (e.g., Property, Liability, Medical Payments). Null if applies to entire coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToLaeFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Lae Flag' ;
    rdfs:comment 'Indicates whether the deductible applies to Loss Adjustment Expenses in addition to the loss amount. True if LAE is subject to deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToPeril rdf:type rdf:Property ;
    rdfs:label 'Applies To Peril' ;
    rdfs:comment 'Specific peril or cause of loss to which this deductible applies (e.g., wind, hail, earthquake, flood). Null if applies to all perils.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToSalvageFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Salvage Flag' ;
    rdfs:comment 'Indicates whether salvage recoveries reduce the deductible amount. True if salvage offsets deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToSubrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Subrogation Flag' ;
    rdfs:comment 'Indicates whether subrogation recoveries reduce the deductible amount. True if subrogation offsets deductible.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleDescription rdf:type rdf:Property ;
    rdfs:label 'Deductible Description' ;
    rdfs:comment 'Free-text description of the deductible terms, conditions, and any special provisions or endorsements.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disappearingThreshold rdf:type rdf:Property ;
    rdfs:label 'Disappearing Threshold' ;
    rdfs:comment 'Loss amount at which a disappearing deductible fully disappears. Deductible reduces proportionally as loss approaches this threshold.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isoFormCode rdf:type rdf:Property ;
    rdfs:label 'Iso Form Code' ;
    rdfs:comment 'ISO form code or endorsement number that defines this deductible structure (e.g., IL 03 10, CP 03 10).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Deductible Amount' ;
    rdfs:comment 'Maximum dollar amount for percentage-based or disappearing deductibles. Caps the deductible at this ceiling.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Deductible Amount' ;
    rdfs:comment 'Minimum dollar amount for percentage-based deductibles. Ensures deductible does not fall below this floor.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicCode rdf:type rdf:Property ;
    rdfs:label 'Naic Code' ;
    rdfs:comment 'NAIC code for deductible classification used in statutory reporting (Schedule P, Annual Statement).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentage rdf:type rdf:Property ;
    rdfs:label 'Percentage' ;
    rdfs:comment 'Percentage of loss or insured value when deductible_type is percentage. Stored as decimal (e.g., 5.00 for 5%).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Effective Date' ;
    rdfs:comment 'Effective date of the policy transaction that created or modified this deductible.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverAuthority rdf:type rdf:Property ;
    rdfs:label 'Waiver Authority' ;
    rdfs:comment 'Name or role of the person or system that authorized the deductible waiver.' ;
    rdfs:domain ind:Deductible ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Date' ;
    rdfs:comment 'Date on which the deductible waiver was granted.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Flag' ;
    rdfs:comment 'Indicates whether the deductible has been waived for this coverage. True if waived, False otherwise.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageEndorsementId rdf:type rdf:Property ;
    rdfs:label 'Coverage Endorsement Id' ;
    rdfs:comment 'Unique identifier for the endorsement data product (auto-inserted during validation).' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageFormId rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Id' ;
    rdfs:comment 'Foreign key linking to coverage.form. Business justification: endorsement currently has form_number (STRING) and form_edition_date (DATE) as denormalized attributes.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageForm .

ind:coveragePartyId rdf:type rdf:Property ;
    rdfs:label 'Coverage Party Id' ;
    rdfs:comment 'Reference to the underwriter who approved the endorsement.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:coverageRequestedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Coverage Requested By Party Id' ;
    rdfs:comment 'Reference to the party who requested the endorsement, typically the insured or producer.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:policyDocumentId rdf:type rdf:Property ;
    rdfs:label 'Policy Document Id' ;
    rdfs:comment 'Reference to the physical or electronic document containing the endorsement form and language.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyDocument .

ind:policyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Id' ;
    rdfs:comment 'Reference to the policy transaction that created this endorsement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:premiumImpactCurrencyId rdf:type rdf:Property ;
    rdfs:label 'Premium Impact Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: Endorsement premium impacts require currency reference for mid-term policy changes, pro-rata calculations, and audit reconciliation.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:supersededByEndorsementId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Endorsement Id' ;
    rdfs:comment 'Reference to a subsequent endorsement that supersedes this one, if applicable.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageEndorsement .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Date on which the endorsement was approved by underwriting.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deductibleChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Change Amount' ;
    rdfs:comment 'Net change in deductible amount resulting from this endorsement, if applicable.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageEndorsementDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Endorsement Description' ;
    rdfs:comment 'Detailed description of the change being made to the coverage by this endorsement.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuedDate rdf:type rdf:Property ;
    rdfs:label 'Issued Date' ;
    rdfs:comment 'Date on which the endorsement was formally issued and communicated to the insured.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:limitChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Limit Change Amount' ;
    rdfs:comment 'Net change in coverage limit resulting from this endorsement, if applicable.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Impact Amount' ;
    rdfs:comment 'Net change in premium resulting from this endorsement, positive for additional premium, negative for return premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAuthorityCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority Code' ;
    rdfs:comment 'Code identifying the regulatory authority mandating the endorsement, if applicable.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedDate rdf:type rdf:Property ;
    rdfs:label 'Requested Date' ;
    rdfs:comment 'Date on which the endorsement was requested by the insured or producer.' ;
    rdfs:domain ind:CoverageEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:title rdf:type rdf:Property ;
    rdfs:label 'Title' ;
    rdfs:comment 'Full title or name of the endorsement as it appears on the policy declarations page.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionId rdf:type rdf:Property ;
    rdfs:label 'Exclusion Id' ;
    rdfs:comment 'Unique identifier for the exclusion record. Primary key.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specificInsuredRiskId rdf:type rdf:Property ;
    rdfs:label 'Specific Insured Risk Id' ;
    rdfs:comment 'Foreign key to a specific insured risk if this exclusion applies only to that risk. Null if exclusion applies to all risks under the coverage.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredRisk .

ind:supersededByExclusionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Exclusion Id' ;
    rdfs:comment 'Foreign key to the exclusion record that supersedes this one, if this exclusion has been replaced by a later endorsement. Null if current.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Exclusion .

ind:appliesToAllInsuredRisks rdf:type rdf:Property ;
    rdfs:label 'Applies To All Insured Risks' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies blanket to all insured risks under the coverage or only to specific risks.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buybackEndorsementAvailable rdf:type rdf:Property ;
    rdfs:label 'Buyback Endorsement Available' ;
    rdfs:comment 'Boolean flag indicating whether a standard endorsement exists to buy back coverage for this exclusion.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionCategory rdf:type rdf:Property ;
    rdfs:label 'Exclusion Category' ;
    rdfs:comment 'High-level classification of what dimension the exclusion applies to: specific peril, property type, activity, location, person, time period, condition, or other.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsMadeTrigger rdf:type rdf:Property ;
    rdfs:label 'Claims Made Trigger' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies only to claims-made policies or claims-made coverage triggers.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionCode rdf:type rdf:Property ;
    rdfs:label 'Exclusion Code' ;
    rdfs:comment 'Standard code identifying the exclusion type. May be ISO (Insurance Services Office) standard code or carrier-specific manuscript code.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionDescription rdf:type rdf:Property ;
    rdfs:label 'Exclusion Description' ;
    rdfs:comment 'Detailed narrative description of what perils, circumstances, or losses are excluded from coverage under this exclusion clause.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Exclusion Status' ;
    rdfs:comment 'Current lifecycle status of the exclusion: active and in force, inactive, superseded by a later endorsement, deleted, or pending approval.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionType rdf:type rdf:Property ;
    rdfs:label 'Exclusion Type' ;
    rdfs:comment 'Classification of the exclusion origin: ISO standard form, manuscript custom language, endorsement-based, statutory requirement, regulatory mandate, or carrier-specific.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageText rdf:type rdf:Property ;
    rdfs:label 'Language Text' ;
    rdfs:comment 'Full legal text of the exclusion clause as it appears in the policy contract or endorsement.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionName rdf:type rdf:Property ;
    rdfs:label 'Exclusion Name' ;
    rdfs:comment 'Short business-friendly name of the exclusion for display and reporting purposes.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceTrigger rdf:type rdf:Property ;
    rdfs:label 'Occurrence Trigger' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion applies to occurrence-based policies or occurrence coverage triggers.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryMandateFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate Flag' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion is mandated by state or federal regulation and cannot be waived.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'Scope level at which the exclusion operates: coverage-level, policy-wide, location-specific, vehicle-specific, driver-specific, building-specific, or other.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waivableFlag rdf:type rdf:Property ;
    rdfs:label 'Waivable Flag' ;
    rdfs:comment 'Boolean flag indicating whether this exclusion can be waived or bought back through an endorsement or additional premium.' ;
    rdfs:domain ind:Exclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acordFormCode rdf:type rdf:Property ;
    rdfs:label 'Acord Form Code' ;
    rdfs:comment 'The standardized ACORD form code if this is an ACORD form. Example: ACORD 125, ACORD 126, ACORD 140.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormCategory rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Category' ;
    rdfs:comment 'Functional category of the form: coverage extension, coverage restriction, additional insured, waiver of subrogation, or other.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Status' ;
    rdfs:comment 'The current lifecycle status of the form: active, inactive, withdrawn, or obsolete.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormType rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Type' ;
    rdfs:comment 'Classification of the form: base coverage form, endorsement, exclusion, condition, schedule, declaration page, or manuscript form. [ENUM-REF-CANDIDATE: base_coverage|endorsement|exclusion|condition|schedule|declaration|manuscript — 7 candidates stripped' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Description' ;
    rdfs:comment 'Detailed description of the coverage, exclusion, or condition provided by this form. Used for underwriting and claims interpretation.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUri rdf:type rdf:Property ;
    rdfs:label 'Document Uri' ;
    rdfs:comment 'The URI or file path to the digital copy of the form document stored in the document management system.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:editionDate rdf:type rdf:Property ;
    rdfs:label 'Edition Date' ;
    rdfs:comment 'The edition or revision date of the form as published by ISO or the carrier. Critical for regulatory compliance and coverage interpretation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isAmendatory rdf:type rdf:Property ;
    rdfs:label 'Is Amendatory' ;
    rdfs:comment 'Indicates whether this form is an amendatory endorsement that modifies the base coverage form. True for amendatory endorsements, false otherwise.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Indicates whether this form is mandatory for the coverage or policy term. True if required by regulation or underwriting rules, false if optional.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'The regulatory jurisdiction governing this form. Typically the state name or multi-state designation.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageFormName rdf:type rdf:Property ;
    rdfs:label 'Coverage Form Name' ;
    rdfs:comment 'The full descriptive name of the form. Example: Commercial General Liability Coverage Form, Homeowners Special Form, Business Auto Coverage Form.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumBearingFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Bearing Flag' ;
    rdfs:comment 'Indicates whether this form carries an additional premium charge. True if the form has a premium impact, false if it is informational or no-charge.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sequence rdf:type rdf:Property ;
    rdfs:label 'Sequence' ;
    rdfs:comment 'The order in which this form appears in the policy document or declarations page. Used for document assembly and printing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededFormNumber rdf:type rdf:Property ;
    rdfs:label 'Superseded Form Number' ;
    rdfs:comment 'The form number of the previous form that this form replaces or supersedes. Used for form version tracking and historical analysis.' ;
    rdfs:domain ind:CoverageForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:version rdf:type rdf:Property ;
    rdfs:label 'Version' ;
    rdfs:comment 'The internal version number or identifier for this form. Used to track revisions and updates to carrier proprietary or manuscript forms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitId rdf:type rdf:Property ;
    rdfs:label 'Limit Id' ;
    rdfs:comment 'Unique identifier for the limit record. Primary key.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sharedLimitGroupId rdf:type rdf:Property ;
    rdfs:label 'Shared Limit Group Id' ;
    rdfs:comment 'Identifier for the group of coverages or risks that share this limit. Null if limit is not shared.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SharedLimitGroup .

ind:aggregateLimitPeriod rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Period' ;
    rdfs:comment 'Time period over which the aggregate limit applies: policy period, calendar year, accident year, or rolling 12 months.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitCode rdf:type rdf:Property ;
    rdfs:label 'Limit Code' ;
    rdfs:comment 'Standard code or abbreviation for the limit type, often used in rating and policy administration systems (e.g., ISO limit codes).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitDescription rdf:type rdf:Property ;
    rdfs:label 'Limit Description' ;
    rdfs:comment 'Detailed textual description of the limit, including any special conditions, exclusions, or clarifications.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erosionMethod rdf:type rdf:Property ;
    rdfs:label 'Erosion Method' ;
    rdfs:comment 'Method by which the limit is eroded or depleted: per claim, per payment, or aggregate depletion over the policy period.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exhaustedDate rdf:type rdf:Property ;
    rdfs:label 'Exhausted Date' ;
    rdfs:comment 'Date on which the limit was fully exhausted by claim payments. Null if limit has not been exhausted.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCombinedSingleLimit rdf:type rdf:Property ;
    rdfs:label 'Is Combined Single Limit' ;
    rdfs:comment 'Indicates whether this is a combined single limit (CSL) covering bodily injury and property damage under one limit.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSharedLimit rdf:type rdf:Property ;
    rdfs:label 'Is Shared Limit' ;
    rdfs:comment 'Indicates whether this limit is shared across multiple coverages, insured risks, or policy terms.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStacked rdf:type rdf:Property ;
    rdfs:label 'Is Stacked' ;
    rdfs:comment 'Indicates whether this limit can be stacked with other limits (e.g., uninsured/underinsured motorist coverage).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoLimitCode rdf:type rdf:Property ;
    rdfs:label 'Iso Limit Code' ;
    rdfs:comment 'Standard ISO code for the limit type, used for rating and statistical reporting.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitStatus rdf:type rdf:Property ;
    rdfs:label 'Limit Status' ;
    rdfs:comment 'Current status of the limit: active, suspended, exhausted (fully depleted by claims), cancelled, or expired.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicLimitCode rdf:type rdf:Property ;
    rdfs:label 'Naic Limit Code' ;
    rdfs:comment 'NAIC standard code for the limit type, used for regulatory and statutory reporting.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementPremiumRate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Rate' ;
    rdfs:comment 'Rate or percentage of the original premium charged for reinstating the limit after a claim. Null if no reinstatement premium applies.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementProvision rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Provision' ;
    rdfs:comment 'Provision for reinstating the limit after a claim: automatic reinstatement, manual reinstatement with additional premium, or no reinstatement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Limit Amount' ;
    rdfs:comment 'Current remaining amount of the limit after deducting claim payments and reserves. Null if not tracked or if limit is not aggregate.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitLimitBodilyInjuryPerAccident rdf:type rdf:Property ;
    rdfs:label 'Split Limit Bodily Injury Per Accident' ;
    rdfs:comment 'For split limits, the maximum amount payable for bodily injury per accident (all persons combined).' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitLimitBodilyInjuryPerPerson rdf:type rdf:Property ;
    rdfs:label 'Split Limit Bodily Injury Per Person' ;
    rdfs:comment 'For split limits, the maximum amount payable for bodily injury per person per accident.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitLimitPropertyDamagePerAccident rdf:type rdf:Property ;
    rdfs:label 'Split Limit Property Damage Per Accident' ;
    rdfs:comment 'For split limits, the maximum amount payable for property damage per accident.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Audit Required Indicator' ;
    rdfs:comment 'Indicates whether this coverage part requires a premium audit at policy expiration.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catExposureIndicator rdf:type rdf:Property ;
    rdfs:label 'Cat Exposure Indicator' ;
    rdfs:comment 'Indicates whether this coverage part has catastrophe exposure requiring CAT modeling.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Percentage' ;
    rdfs:comment 'Commission rate percentage paid to the producer for this coverage part.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleTypeCode rdf:type rdf:Property ;
    rdfs:label 'Deductible Type Code' ;
    rdfs:comment 'Type of deductible applied to this coverage part (per occurrence, aggregate, percentage of loss, etc.).' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partDescription rdf:type rdf:Property ;
    rdfs:label 'Part Description' ;
    rdfs:comment 'Detailed textual description of the coverage part, including any special terms or conditions.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementCount rdf:type rdf:Property ;
    rdfs:label 'Endorsement Count' ;
    rdfs:comment 'Number of endorsements applied to this coverage part during the policy term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isoFormEditionDate rdf:type rdf:Property ;
    rdfs:label 'Iso Form Edition Date' ;
    rdfs:comment 'Edition date of the ISO form used for this coverage part.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:partName rdf:type rdf:Property ;
    rdfs:label 'Part Name' ;
    rdfs:comment 'Human-readable name of the coverage part (e.g., Commercial Property, General Liability, Commercial Auto).' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageIndicator rdf:type rdf:Property ;
    rdfs:label 'Package Indicator' ;
    rdfs:comment 'Indicates whether this part is part of a package policy (CPP, BOP) or standalone.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:packageTypeCode rdf:type rdf:Property ;
    rdfs:label 'Package Type Code' ;
    rdfs:comment 'Type of package policy this part belongs to (Commercial Package Policy, Business Owners Policy, etc.).' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partStatus rdf:type rdf:Property ;
    rdfs:label 'Part Status' ;
    rdfs:comment 'Current lifecycle status of the coverage part within the policy term.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Premium Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for premium amounts. Typically USD for US P&C insurers.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratePerUnit rdf:type rdf:Property ;
    rdfs:label 'Rate Per Unit' ;
    rdfs:comment 'Premium rate applied per unit of rating basis (e.g., $0.50 per $100 of payroll).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingBasisUnit rdf:type rdf:Property ;
    rdfs:label 'Rating Basis Unit' ;
    rdfs:comment 'Unit of measure for the rating basis value (e.g., sq_ft, USD, vehicles, employees).' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingBasisValue rdf:type rdf:Property ;
    rdfs:label 'Rating Basis Value' ;
    rdfs:comment 'Numeric value of the rating basis used to calculate premium (e.g., 10000 sq ft, $500000 payroll).' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceTreatyIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Indicator' ;
    rdfs:comment 'Indicates whether this coverage part is subject to reinsurance treaty cession.' ;
    rdfs:domain ind:Part ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateId rdf:type rdf:Property ;
    rdfs:label 'Rate Id' ;
    rdfs:comment 'Unique identifier for the rate element applied to a coverage during pricing.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:classificationCodeId rdf:type rdf:Property ;
    rdfs:label 'Classification Code Id' ;
    rdfs:comment 'Foreign key linking to shared.classification_code. Business justification: Rating requires formal link to classification code master for base rate lookup, hazard group assignment, loss cost retrieval, and regulatory filing compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClassificationCode .

ind:ratingBasisUnitOfMeasureId rdf:type rdf:Property ;
    rdfs:label 'Rating Basis Unit Of Measure Id' ;
    rdfs:comment 'Foreign key linking to shared.unit_of_measure. Business justification: Rating basis requires UOM reference for rate-per-unit calculations, audit reconciliation, and exposure conversion.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitOfMeasure .

ind:basisCode rdf:type rdf:Property ;
    rdfs:label 'Basis Code' ;
    rdfs:comment 'The unit of measure to which the rate applies: per hundred of coverage, per thousand, per unit, per vehicle, per location, per employee, per payroll unit, or flat amount.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCode rdf:type rdf:Property ;
    rdfs:label 'Rate Code' ;
    rdfs:comment 'The unique code identifying the rate element in the rating engine or rate table.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsuranceFactor rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Factor' ;
    rdfs:comment 'Factor applied when coinsurance provisions are in effect, adjusting premium based on the ratio of insurance to value.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleCreditFactor rdf:type rdf:Property ;
    rdfs:label 'Deductible Credit Factor' ;
    rdfs:comment 'Credit factor applied to reduce premium when a deductible is selected, reflecting reduced carrier exposure.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:experienceModifier rdf:type rdf:Property ;
    rdfs:label 'Experience Modifier' ;
    rdfs:comment 'Experience modification factor applied to adjust premium based on the insureds historical loss experience. Typically ranges from 0.500 to 2.000.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:factor rdf:type rdf:Property ;
    rdfs:label 'Factor' ;
    rdfs:comment 'Multiplicative factor applied to base rate for territory, class, or experience adjustments. Typically a decimal multiplier.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Filing Approval Date' ;
    rdfs:comment 'The date on which the state Department of Insurance (DOI) approved this rate for use.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingStateCode rdf:type rdf:Property ;
    rdfs:label 'Filing State Code' ;
    rdfs:comment 'Two-letter state code where this rate was filed and approved. Rates are state-specific in Property and Casualty insurance.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:increasedLimitsFactor rdf:type rdf:Property ;
    rdfs:label 'Increased Limits Factor' ;
    rdfs:comment 'Factor applied when coverage limits exceed the base limit, reflecting the increased exposure. Common in liability coverages.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Override Approval Date' ;
    rdfs:comment 'Date on which the rate override was approved.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Override Approved By' ;
    rdfs:comment 'Name or identifier of the underwriter or manager who approved the rate override.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideIndicator rdf:type rdf:Property ;
    rdfs:label 'Override Indicator' ;
    rdfs:comment 'Indicates whether this rate was manually overridden by an underwriter, deviating from the standard rating algorithm.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideReason rdf:type rdf:Property ;
    rdfs:label 'Override Reason' ;
    rdfs:comment 'Business justification for the rate override, required for audit and regulatory compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAlgorithmCode rdf:type rdf:Property ;
    rdfs:label 'Rating Algorithm Code' ;
    rdfs:comment 'Code identifying the rating algorithm or pricing model used to calculate this rate element.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingVariableName rdf:type rdf:Property ;
    rdfs:label 'Rating Variable Name' ;
    rdfs:comment 'Name of the rating variable or input factor used in the rating algorithm for this rate element.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingVariableValue rdf:type rdf:Property ;
    rdfs:label 'Rating Variable Value' ;
    rdfs:comment 'The value of the rating variable at the time of rating, captured for premium reconstruction and audit purposes.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCreditDebitAmount rdf:type rdf:Property ;
    rdfs:label 'Schedule Credit Debit Amount' ;
    rdfs:comment 'Dollar amount of schedule credit (negative) or debit (positive) applied for underwriting judgment factors such as management quality, safety programs, or loss control.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCreditDebitPercentage rdf:type rdf:Property ;
    rdfs:label 'Schedule Credit Debit Percentage' ;
    rdfs:comment 'Percentage credit (negative) or debit (positive) applied for underwriting judgment factors. Expressed as a percentage of base premium.' ;
    rdfs:domain ind:Rate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tableName rdf:type rdf:Property ;
    rdfs:label 'Table Name' ;
    rdfs:comment 'Name or identifier of the rate table from which this rate element was retrieved.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableVersion rdf:type rdf:Property ;
    rdfs:label 'Table Version' ;
    rdfs:comment 'Version identifier of the rate table, enabling reconstruction of premium at any point in time using the correct rate version.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Type Code' ;
    rdfs:comment 'Type of policy transaction that introduced or modified this rate element: New Business (NB), Renewal (REN), Endorsement (END), Cancellation (CAN), or Reinstatement (RI).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:value rdf:type rdf:Property ;
    rdfs:label 'Value' ;
    rdfs:comment 'The numeric rate value or factor applied during premium calculation. Precision supports actuarial rating accuracy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressId rdf:type rdf:Property ;
    rdfs:label 'Address Id' ;
    rdfs:comment 'Unique surrogate identifier for each address record in the party domain. Primary key. One row per address per party.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acordAddressTypeCode rdf:type rdf:Property ;
    rdfs:label 'Acord Address Type Code' ;
    rdfs:comment 'ACORD standard address type code from the ACORD data dictionary. Enables interoperability with ACORD 125/126/140 forms and carrier/agency data exchanges.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressStatus rdf:type rdf:Property ;
    rdfs:label 'Address Status' ;
    rdfs:comment 'Current operational status of the address record. Active addresses receive policy documents and billing. Returned_mail triggers address update workflow in the PAS.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressType rdf:type rdf:Property ;
    rdfs:label 'Address Type' ;
    rdfs:comment 'Classifies the purpose of the address: mailing for correspondence, billing for invoices, risk for insured property location, garaging for auto, loss for claim site.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careOfName rdf:type rdf:Property ;
    rdfs:label 'Care Of Name' ;
    rdfs:comment 'In-care-of name for mail delivery when correspondence is directed through a third party (e.g., attorney, trustee, mortgagee). Common for additional insured notices.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusTract rdf:type rdf:Property ;
    rdfs:label 'Census Tract' ;
    rdfs:comment 'US Census Bureau census tract code for the address. Used for demographic risk analysis, CRA compliance, and actuarial territory segmentation in pricing models.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:congressionalDistrict rdf:type rdf:Property ;
    rdfs:label 'Congressional District' ;
    rdfs:comment 'US Congressional district code for the address. Used for regulatory reporting, legislative tracking, and state DOI jurisdictional filings.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County or parish name for the address. Used for territory rating, surplus lines stamping, local tax jurisdiction, and catastrophe exposure aggregation.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceToFireStationMiles rdf:type rdf:Property ;
    rdfs:label 'Distance To Fire Station Miles' ;
    rdfs:comment 'Distance in miles from the address to the nearest responding fire station. Used in ISO PPC determination and property rating for rural or semi-rural locations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doNotMailIndicator rdf:type rdf:Property ;
    rdfs:label 'Do Not Mail Indicator' ;
    rdfs:comment 'Suppresses physical mail delivery to this address per party preference or returned mail. Compliance with GLBA and state DOI notice delivery requirements.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dpvConfirmationCode rdf:type rdf:Property ;
    rdfs:label 'Dpv Confirmation Code' ;
    rdfs:comment 'USPS DPV result: Y=confirmed deliverable, S=primary match only, D=default match, N=not confirmed. Validates address deliverability for policy documents and billing.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fipsCode rdf:type rdf:Property ;
    rdfs:label 'Fips Code' ;
    rdfs:comment 'Five-digit FIPS county code (2-digit state + 3-digit county). Used for catastrophe modeling, PML aggregation, and regulatory geographic reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:line1 rdf:type rdf:Property ;
    rdfs:label 'Line1' ;
    rdfs:comment 'Primary street address line including house/building number and street name. Used for mail delivery, risk location identification, and regulatory filings.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:line2 rdf:type rdf:Property ;
    rdfs:label 'Line2' ;
    rdfs:comment 'Secondary address line for suite, apartment, unit, floor, or building designator. Supplements address_line1 for complete delivery address.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poBox rdf:type rdf:Property ;
    rdfs:label 'Po Box' ;
    rdfs:comment 'Post Office box number when the mailing address is a PO Box rather than a street address. Used for billing and correspondence when party does not receive street delivery.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:province rdf:type rdf:Property ;
    rdfs:label 'Province' ;
    rdfs:comment 'Province or region name for non-US addresses (e.g., Canadian provinces, Mexican states). Required for international policies and IFRS 17 geographic segmentation.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalIndicator rdf:type rdf:Property ;
    rdfs:label 'Seasonal Indicator' ;
    rdfs:comment 'Indicates the address is a seasonal or secondary residence (e.g., vacation home). Relevant for homeowners underwriting, vacancy conditions, and occupancy rating.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemAddressCode rdf:type rdf:Property ;
    rdfs:label 'Source System Address Code' ;
    rdfs:comment 'Native address identifier from the originating operational system (e.g., Guidewire internal ID). Enables reconciliation between the lakehouse and the system of record.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uspsStandardizedIndicator rdf:type rdf:Property ;
    rdfs:label 'Usps Standardized Indicator' ;
    rdfs:comment 'Indicates whether the address has been validated and standardized against the USPS Coding Accuracy Support System (CASS). Ensures deliverability and geocoding accuracy.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:windPoolIndicator rdf:type rdf:Property ;
    rdfs:label 'Wind Pool Indicator' ;
    rdfs:comment 'Indicates whether this address falls within a state wind pool or FAIR plan territory (e.g., Texas Windstorm, Florida Citizens). Affects coverage eligibility and reinsurance.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zipPlus4 rdf:type rdf:Property ;
    rdfs:label 'Zip Plus4' ;
    rdfs:comment 'Four-digit ZIP+4 extension providing carrier route precision for USPS delivery. Enhances geocoding accuracy for catastrophe modeling and territory rating.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentGuardianPartyId rdf:type rdf:Property ;
    rdfs:label 'Consent Guardian Party Id' ;
    rdfs:comment 'Reference to the Party record of the parent or legal guardian who provided consent on behalf of a minor. Null when is_minor is false or guardian consent is not required.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:consentPartyId rdf:type rdf:Property ;
    rdfs:label 'Consent Party Id' ;
    rdfs:comment 'Reference to the Party who granted, withheld, or revoked consent. Links to the Party master record in the Customer/Party MDM.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorConsentRecordId rdf:type rdf:Property ;
    rdfs:label 'Prior Consent Record Id' ;
    rdfs:comment 'Reference to the previous consent record that this event supersedes or replaces. Enables a linked-list audit chain of consent history for a party and consent type over time.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecord .

ind:roleId rdf:type rdf:Property ;
    rdfs:label 'Role Id' ;
    rdfs:comment 'Reference to the specific Party Role (policyholder, claimant, producer, etc.) under which consent was captured, enabling role-scoped consent tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Role .

ind:agentNpn rdf:type rdf:Property ;
    rdfs:label 'Agent Npn' ;
    rdfs:comment 'The National Producer Number (NPN) of the producer or agent who facilitated the consent capture on behalf of the party. Null for self-service digital channels.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentAction rdf:type rdf:Property ;
    rdfs:label 'Consent Action' ;
    rdfs:comment 'The action taken by the party on this consent event: granted (affirmative consent), revoked (withdrawal), opted_out (negative election), renewed (re-affirmation), or pending (awaiting confirmation).' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentChannel rdf:type rdf:Property ;
    rdfs:label 'Consent Channel' ;
    rdfs:comment 'The interface or channel through which the party provided or withdrew consent. [ENUM-REF-CANDIDATE: web|mobile_app|ivr|agent|paper|email|sms|chat|kiosk — promote to reference product if more than 6 values needed]' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentLanguage rdf:type rdf:Property ;
    rdfs:label 'Consent Language' ;
    rdfs:comment 'IETF BCP 47 language tag (e.g., en-US, es-MX) of the consent notice presented to the party. Supports multilingual compliance and state DOI requirements for non-English disclosures.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Method' ;
    rdfs:comment 'The mechanism by which consent was obtained: opt_in (affirmative click/signature), opt_out (negative election), double_opt_in (confirmed via follow-up), implied (by contract), or written (signed document).' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Status' ;
    rdfs:comment 'Current lifecycle state of this consent record. Active means the consent is in force; superseded means a newer record has replaced it; expired means the consent lapsed past its expiration date.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentTextHash rdf:type rdf:Property ;
    rdfs:label 'Consent Text Hash' ;
    rdfs:comment 'SHA-256 hash of the exact consent notice text presented to the party. Provides tamper-evident proof of the specific language used, supporting regulatory audit without storing full text.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Timestamp' ;
    rdfs:comment 'The precise date and time (with timezone offset) when the party performed the consent action. This is the principal real-world event time, distinct from the record audit timestamp.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentType rdf:type rdf:Property ;
    rdfs:label 'Consent Type' ;
    rdfs:comment 'Category of consent or opt-out captured. Examples: marketing communications, electronic policy delivery, telematics data collection, credit pull authorization, Motor Vehicle Record (MVR) pull, data sharing.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVersion rdf:type rdf:Property ;
    rdfs:label 'Consent Version' ;
    rdfs:comment 'Version identifier of the consent notice, disclosure form, or privacy policy presented to the party at the time of consent. Enables tracking of which notice language was in effect.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditPullPermissiblePurpose rdf:type rdf:Property ;
    rdfs:label 'Credit Pull Permissible Purpose' ;
    rdfs:comment 'The FCRA-defined permissible purpose for which a credit report pull is authorized (e.g., underwriting, rating, renewal). Required for FCRA compliance when consent_type is credit_pull.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCategoriesCovered rdf:type rdf:Property ;
    rdfs:label 'Data Categories Covered' ;
    rdfs:comment 'Comma-delimited list of personal data categories covered by this consent (e.g., driving behavior, credit score, location data, health data). Required for GDPR Article 13 transparency.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataUsePurpose rdf:type rdf:Property ;
    rdfs:label 'Data Use Purpose' ;
    rdfs:comment 'Specific stated purpose for which data will be used under this consent (e.g., underwriting rating, claims processing, marketing, telematics scoring). Aligns with GDPR purpose limitation principle.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceFingerprint rdf:type rdf:Property ;
    rdfs:label 'Device Fingerprint' ;
    rdfs:comment 'Hashed or tokenized identifier of the device used to submit consent. Supports fraud detection and non-repudiation for digital consent events. Stored as a hash, not raw device data.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotContactFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Flag' ;
    rdfs:comment 'Indicates the party has requested no contact for any purpose beyond contractual necessity. Distinct from suppression_flag which is channel/purpose-specific. Overrides all outreach.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicDeliveryFormat rdf:type rdf:Property ;
    rdfs:label 'Electronic Delivery Format' ;
    rdfs:comment 'The agreed electronic format for policy document delivery when consent_type is electronic_delivery. Populated per state e-delivery statutes and NAIC Model Electronic Transactions Act.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipAddress rdf:type rdf:Property ;
    rdfs:label 'Ip Address' ;
    rdfs:comment 'The IP address of the device from which the party submitted the consent action online. Used for fraud detection, audit, and jurisdictional determination. May be PII under GDPR/CCPA.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionCountry rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction governing this consent record. Supports GDPR applicability determination for international or EU-exposed business.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionState rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction governing this consent record. Determines which state DOI regulations and privacy laws (e.g., CCPA for CA) apply to this consent event.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrPullState rdf:type rdf:Property ;
    rdfs:label 'Mvr Pull State' ;
    rdfs:comment 'Two-letter US state code of the DMV from which the Motor Vehicle Record (MVR) pull is authorized. Populated only when consent_type is mvr_pull. Drives state-specific MVR ordering.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optOutReason rdf:type rdf:Property ;
    rdfs:label 'Opt Out Reason' ;
    rdfs:comment 'Free-text or coded reason provided by the party when revoking consent or opting out. Supports customer experience analysis and regulatory response documentation.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proofOfConsentRef rdf:type rdf:Property ;
    rdfs:label 'Proof Of Consent Ref' ;
    rdfs:comment 'Reference to the stored evidence of consent (e.g., signed form scan ID, recorded call ID, e-signature token, screenshot hash). Supports regulatory audit and non-repudiation.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryBasis rdf:type rdf:Property ;
    rdfs:label 'Regulatory Basis' ;
    rdfs:comment 'The primary legal or regulatory framework under which this consent was obtained or is required. Drives compliance reporting and data handling obligations. Examples: GLBA, CCPA, GDPR, FCRA, TCPA.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revocation Timestamp' ;
    rdfs:comment 'The precise date and time when the party revoked or withdrew consent. Null if consent has not been revoked. Supports GDPR right-to-withdraw and CCPA opt-out audit trails.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Code' ;
    rdfs:comment 'The unique transaction or session identifier from the originating source system at the time consent was captured. Enables cross-system audit trail reconciliation.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Suppression Flag' ;
    rdfs:comment 'Indicates whether this party is suppressed from the associated data use (e.g., marketing suppression list, do-not-call registry). Drives downstream campaign and outreach exclusion logic.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telematicsProgramCode rdf:type rdf:Property ;
    rdfs:label 'Telematics Program Code' ;
    rdfs:comment 'Identifier of the telematics or usage-based insurance (UBI) program for which consent was obtained. Populated only when consent_type is telematics. Links to the telematics program configuration.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartySharingFlag rdf:type rdf:Property ;
    rdfs:label 'Third Party Sharing Flag' ;
    rdfs:comment 'Indicates whether this consent authorizes sharing of the party\'s data with third parties (e.g., reinsurers, data vendors, ISO/CLUE). Drives GLBA opt-out and CCPA sale-of-data controls.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'The date and time when the consent event was independently verified (e.g., double opt-in confirmation received). Null if verified_flag is false or verification is not required.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:verifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Verified Flag' ;
    rdfs:comment 'Indicates whether the consent event has been independently verified (e.g., double opt-in email confirmation received, recorded call reviewed). Supports quality assurance and regulatory defensibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactId rdf:type rdf:Property ;
    rdfs:label 'Contact Id' ;
    rdfs:comment 'Unique surrogate identifier for each contact point record in the party contact master. One row per contact point per party.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acordContactTypeCode rdf:type rdf:Property ;
    rdfs:label 'Acord Contact Type Code' ;
    rdfs:comment 'ACORD standard contact type code from the ACORD data dictionary (e.g., ACORD 125/126 PhoneInfo/EmailInfo type codes). Enables interoperability with trading partners.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestContactTimeEnd rdf:type rdf:Property ;
    rdfs:label 'Best Contact Time End' ;
    rdfs:comment 'Latest time of day (HH:MM, 24-hour local) the party prefers to be contacted via this channel. Supports TCPA-compliant outbound call scheduling.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestContactTimeStart rdf:type rdf:Property ;
    rdfs:label 'Best Contact Time Start' ;
    rdfs:comment 'Earliest time of day (HH:MM, 24-hour local) the party prefers to be contacted via this channel. Supports TCPA-compliant outbound call scheduling.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentSource rdf:type rdf:Property ;
    rdfs:label 'Consent Source' ;
    rdfs:comment 'Channel or mechanism through which opt-in consent was captured (e.g., web_form, agent_recorded, ivr, written). Supports GLBA and TCPA audit trail requirements.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactStatus rdf:type rdf:Property ;
    rdfs:label 'Contact Status' ;
    rdfs:comment 'Current lifecycle status of this contact point. Bounced indicates delivery failure; opted_out reflects GLBA/TCPA suppression. Drives communication eligibility.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactType rdf:type rdf:Property ;
    rdfs:label 'Contact Type' ;
    rdfs:comment 'Classification of the communication channel for this contact point (e.g., phone, email, fax, sms, postal_address, web_portal). Drives routing in PAS and CMS.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotContactReason rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Reason' ;
    rdfs:comment 'Reason code explaining why the do_not_contact_flag is set. Supports legal hold, regulatory order, and SIU fraud investigation suppression scenarios.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Structured email address for the party when contact_type is email. Stored separately for validation, opt-in tracking, and GLBA compliance.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailBounceCode rdf:type rdf:Property ;
    rdfs:label 'Email Bounce Code' ;
    rdfs:comment 'SMTP bounce code or classification (e.g., 550 hard bounce, 421 soft bounce) returned when an email delivery attempt failed. Used to update contact_status to bounced.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPreferred rdf:type rdf:Property ;
    rdfs:label 'Is Preferred' ;
    rdfs:comment 'Indicates whether this is the party\'s overall preferred contact method across all contact types. Used by PAS and CMS to select the default outreach channel.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Indicates whether this contact point is the primary contact for the party within its contact_type. Only one record per party per contact_type should be primary.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVerifiedMobile rdf:type rdf:Property ;
    rdfs:label 'Is Verified Mobile' ;
    rdfs:comment 'Indicates whether a phone contact point has been confirmed as a mobile/wireless number via carrier lookup. Critical for TCPA autodialer and text message compliance.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWireless rdf:type rdf:Property ;
    rdfs:label 'Is Wireless' ;
    rdfs:comment 'Indicates whether the phone number is a wireless (cell) number as determined by carrier lookup. Distinct from is_verified_mobile; set by automated number type detection.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'Preferred language for communications via this contact point in BCP 47 format (e.g., en-US, es-MX). Supports state DOI language access requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Contact Date' ;
    rdfs:comment 'Most recent date on which a successful outbound or inbound communication was recorded via this contact point. Used for contact recency analytics and dormancy detection.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastContactOutcome rdf:type rdf:Property ;
    rdfs:label 'Last Contact Outcome' ;
    rdfs:comment 'Result of the most recent communication attempt via this contact point (e.g., reached, no_answer, voicemail, bounced). Informs next-best-action in claims and billing.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optInFlag rdf:type rdf:Property ;
    rdfs:label 'Opt In Flag' ;
    rdfs:comment 'Indicates whether the party has affirmatively opted in to receive communications via this contact point. Required for GLBA and TCPA compliance tracking.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Opt In Timestamp' ;
    rdfs:comment 'Date and time when the party provided opt-in consent for this contact point. Retained as evidence of consent for GLBA and TCPA regulatory audits.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:optOutFlag rdf:type rdf:Property ;
    rdfs:label 'Opt Out Flag' ;
    rdfs:comment 'Indicates whether the party has explicitly opted out of communications via this contact point. Suppresses outbound contact in PAS, CMS, and Billing systems.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutTimestamp rdf:type rdf:Property ;
    rdfs:label 'Opt Out Timestamp' ;
    rdfs:comment 'Date and time when the party revoked consent or opted out for this contact point. Triggers suppression in all downstream communication systems.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:phoneExtension rdf:type rdf:Property ;
    rdfs:label 'Phone Extension' ;
    rdfs:comment 'Optional telephone extension appended to the phone number for commercial parties, brokers, or agency contacts in the Producer Management System.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneNumber rdf:type rdf:Property ;
    rdfs:label 'Phone Number' ;
    rdfs:comment 'Structured phone number in E.164 format for the party when contact_type is phone or sms. Used for FNOL intake, billing, and claims communication.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemContactCode rdf:type rdf:Property ;
    rdfs:label 'Source System Contact Code' ;
    rdfs:comment 'Native identifier of this contact record in the originating operational system (e.g., Guidewire ContactID). Enables cross-system reconciliation and MDM deduplication.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtype rdf:type rdf:Property ;
    rdfs:label 'Subtype' ;
    rdfs:comment 'Secondary classification refining the contact type (e.g., home, work, mobile, billing, claims, underwriting). [ENUM-REF-CANDIDATE: home|work|mobile|billing|claims|underwriting|other — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usagePurpose rdf:type rdf:Property ;
    rdfs:label 'Usage Purpose' ;
    rdfs:comment 'Business purpose for which this contact point is used (e.g., billing notices, claims FNOL, policy documents, marketing). Drives targeted communication routing.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date on which the contact point was last verified through a validation process such as email ping, carrier lookup, or agent confirmation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersededByDocumentPartyDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Document Party Document Id' ;
    rdfs:comment 'Reference to the newer document_id that replaces this document when a revised version is received. Null if this is the current active version. Enables version chain traversal.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PartyDocument .

ind:acordFormEdition rdf:type rdf:Property ;
    rdfs:label 'Acord Form Edition' ;
    rdfs:comment 'Edition date or version of the ACORD form (e.g., \'2016/03\'). Ensures the correct form version is used for regulatory and underwriting compliance.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acordFormNumber rdf:type rdf:Property ;
    rdfs:label 'Acord Form Number' ;
    rdfs:comment 'ACORD standard form number associated with the document (e.g., 125, 126, 140). Null for non-ACORD documents. Enables ISO/ACORD forms library alignment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimNumber rdf:type rdf:Property ;
    rdfs:label 'Claim Number' ;
    rdfs:comment 'Claim number to which this document is associated, if applicable (e.g., FNOL intake form, adjuster report, SIU referral). Null for non-claim documents.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueReportNumber rdf:type rdf:Property ;
    rdfs:label 'Clue Report Number' ;
    rdfs:comment 'Reference number for a CLUE loss history report obtained from LexisNexis. Null for non-CLUE documents. Used in personal lines underwriting risk evaluation.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coiHolderName rdf:type rdf:Property ;
    rdfs:label 'Coi Holder Name' ;
    rdfs:comment 'Name of the certificate holder on a Certificate of Insurance document. Null for non-CoI documents. Required for additional insured and lender tracking.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyDocumentDescription rdf:type rdf:Property ;
    rdfs:label 'Party Document Description' ;
    rdfs:comment 'Free-text description of the document content, purpose, or any special notes added by the underwriter, adjuster, or KYC analyst during intake or review.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expiryDate rdf:type rdf:Property ;
    rdfs:label 'Expiry Date' ;
    rdfs:comment 'Date on which the document expires and is no longer valid. Null for documents with no expiration. Drives renewal alerts and KYC re-verification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isKycDocument rdf:type rdf:Property ;
    rdfs:label 'Is Kyc Document' ;
    rdfs:comment 'Indicates whether this document is used to satisfy KYC identity verification requirements for the party. Drives compliance reporting and onboarding workflows.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSensitive rdf:type rdf:Property ;
    rdfs:label 'Is Sensitive' ;
    rdfs:comment 'Indicates whether the document contains sensitive PII, PHI, or legally privileged content requiring restricted access controls under GLBA or GDPR.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'Name of the government body, agency, or organization that issued the document (e.g., US Department of State, California DMV, ISO).' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingCountry rdf:type rdf:Property ;
    rdfs:label 'Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the authority that issued the document (e.g., USA, CAN, GBR). Required for KYC and OFAC screening.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingState rdf:type rdf:Property ;
    rdfs:label 'Issuing State' ;
    rdfs:comment 'Two-letter US state or territory code of the issuing authority (e.g., CA, NY, TX). Applicable for state-issued IDs, driver licenses, and producer licenses.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Method' ;
    rdfs:comment 'Method used to verify the document for KYC purposes: manual review, automated OCR/AI, or third-party verification service (e.g., LexisNexis, Experian).' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'ISO 639-1 language code of the document content (e.g., en, es, fr). Supports multilingual document management and regulatory translation requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Mvr Order Number' ;
    rdfs:comment 'Order or reference number from the MVR vendor for Motor Vehicle Record documents. Null for non-MVR documents. Used for PAP and CA underwriting.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyDocumentStatus rdf:type rdf:Property ;
    rdfs:label 'Party Document Status' ;
    rdfs:comment 'Current lifecycle state of the document within the KYC and underwriting workflow. Drives eligibility and compliance checks.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyDocumentType rdf:type rdf:Property ;
    rdfs:label 'Party Document Type' ;
    rdfs:comment 'Classification of the document by business purpose. [ENUM-REF-CANDIDATE: GOVT_ID|PROOF_OF_ADDRESS|ACORD_APPLICATION|COI|MVR|LOSS_RUN|POLICY_DEC|OTHER — promote to reference product]' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purgeDate rdf:type rdf:Property ;
    rdfs:label 'Purge Date' ;
    rdfs:comment 'Scheduled date on which the document is eligible for deletion or archival per the retention_category policy. Null for permanent retention documents.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retentionCategory rdf:type rdf:Property ;
    rdfs:label 'Retention Category' ;
    rdfs:comment 'Records retention classification governing how long the document must be kept per regulatory and statutory requirements (e.g., NAIC, state DOI, SOX, GLBA).' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemDocCode rdf:type rdf:Property ;
    rdfs:label 'Source System Doc Code' ;
    rdfs:comment 'Native document identifier from the originating operational system (e.g., Guidewire PolicyCenter document GUID). Enables lineage tracing back to the system of record.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageUri rdf:type rdf:Property ;
    rdfs:label 'Storage Uri' ;
    rdfs:comment 'Fully qualified URI pointing to the document file in the document management or object storage system (e.g., S3 path, SharePoint URL). Confidential due to access control.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionNumber rdf:type rdf:Property ;
    rdfs:label 'Submission Number' ;
    rdfs:comment 'Underwriting submission number to which this document is associated (e.g., ACORD application submitted for a new risk). Null for documents not tied to a submission.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tags rdf:type rdf:Property ;
    rdfs:label 'Tags' ;
    rdfs:comment 'Comma-separated business tags applied to the document for search and categorization (e.g., \'renewal,endorsement,high-value\'). Supports document retrieval workflows.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or user identifier of the underwriter, adjuster, or KYC analyst who verified the document. Supports audit trail and compliance review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedDate rdf:type rdf:Property ;
    rdfs:label 'Verified Date' ;
    rdfs:comment 'Date the document was verified as authentic and acceptable by the underwriting or KYC team. Null if not yet verified.' ;
    rdfs:domain ind:PartyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identifierId rdf:type rdf:Property ;
    rdfs:label 'Identifier Id' ;
    rdfs:comment 'Surrogate primary key uniquely identifying one party identifier record. One row per identifier per party. Grain: one row per external or internal identifier assigned to a party.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:identifierMdmGoldenPartyId rdf:type rdf:Property ;
    rdfs:label 'Identifier Mdm Golden Party Id' ;
    rdfs:comment 'The MDM golden record identifier assigned to the party after deduplication and survivorship processing. Links this identifier to the authoritative master party record across all source systems.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:identifierPartyId rdf:type rdf:Property ;
    rdfs:label 'Identifier Party Id' ;
    rdfs:comment 'Reference to the party record that owns this identifier. Links the identifier back to the master party in the Customer/Party MDM.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:identifierPasPartyId rdf:type rdf:Property ;
    rdfs:label 'Identifier Pas Party Id' ;
    rdfs:comment 'The party identifier as assigned by the Policy Administration System (Guidewire PolicyCenter or Duck Creek Policy). Used for cross-reference between the data lakehouse and the PAS.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:clueReportOrdered rdf:type rdf:Property ;
    rdfs:label 'Clue Report Ordered' ;
    rdfs:comment 'Indicates whether a CLUE (Comprehensive Loss Underwriting Exchange) report has been ordered for this party identifier. Used in personal lines underwriting to retrieve prior loss history.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dedupMatchKey rdf:type rdf:Property ;
    rdfs:label 'Dedup Match Key' ;
    rdfs:comment 'Normalized, standardized form of the identifier value used for fuzzy matching and deduplication in the Party MDM. Strips formatting characters (dashes, spaces) for consistent comparison.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifierStatus rdf:type rdf:Property ;
    rdfs:label 'Identifier Status' ;
    rdfs:comment 'Current lifecycle status of this identifier record: active (in use), inactive (superseded), expired (past validity), revoked (cancelled by issuing authority), pending_verification (awaiting confirmation).' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMasked rdf:type rdf:Property ;
    rdfs:label 'Is Masked' ;
    rdfs:comment 'Indicates whether the identifier_value stored is a masked or tokenized representation rather than the full plaintext value. True when only last-4 digits or a token is stored for PCI/GLBA compliance.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the country that issued this identifier (e.g., USA, CAN, GBR). Required for passports and foreign national identifiers.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingStateCode rdf:type rdf:Property ;
    rdfs:label 'Issuing State Code' ;
    rdfs:comment 'Two-letter US state or territory code of the jurisdiction that issued this identifier. Applicable for driver licenses, state-issued producer licenses, and state DOI registrations.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycStatus rdf:type rdf:Property ;
    rdfs:label 'Kyc Status' ;
    rdfs:comment 'Know Your Customer compliance status for this identifier as part of anti-money laundering and fraud screening. Tracks whether the identifier has passed identity verification per GLBA and BSA/AML requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseClass rdf:type rdf:Property ;
    rdfs:label 'License Class' ;
    rdfs:comment 'Classification of the license associated with this identifier (e.g., producer license class: P&C, Life, Health; driver license class: A, B, C, M). Applicable for DLN and producer license identifier types.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseStateCode rdf:type rdf:Property ;
    rdfs:label 'License State Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction under which the license was issued. Distinct from issuing_state_code when a producer holds licenses in multiple states.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maskedValue rdf:type rdf:Property ;
    rdfs:label 'Masked Value' ;
    rdfs:comment 'Partially masked display version of the identifier for UI and reporting use (e.g., ***-**-1234 for SSN, **-***1234 for FEIN). Allows display without exposing the full sensitive value.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mvrOrderDate rdf:type rdf:Property ;
    rdfs:label 'Mvr Order Date' ;
    rdfs:comment 'Date on which the most recent MVR was ordered for this driver license identifier. Used to determine MVR currency and whether a refresh is required per underwriting guidelines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mvrOrdered rdf:type rdf:Property ;
    rdfs:label 'Mvr Ordered' ;
    rdfs:comment 'Indicates whether a Motor Vehicle Record (MVR) has been ordered for this driver license identifier. Applicable when identifier_type_code = DLN. Used in personal and commercial auto underwriting.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ofacCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Ofac Check Status' ;
    rdfs:comment 'Result of OFAC SDN (Specially Designated Nationals) screening for this identifier. Required for sanctions compliance. Cleared = no match; Flagged = potential match requiring review.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemPartyRef rdf:type rdf:Property ;
    rdfs:label 'Source System Party Ref' ;
    rdfs:comment 'The party or entity reference key as it exists in the originating source system. Enables cross-system reconciliation and deduplication between PAS, MDM, billing, and claims systems.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinMatchStatus rdf:type rdf:Property ;
    rdfs:label 'Tin Match Status' ;
    rdfs:comment 'Result of IRS TIN matching for SSN/FEIN identifiers. Used for 1099 reporting compliance and backup withholding determination. Values: matched, not_matched, pending, not_checked.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinType rdf:type rdf:Property ;
    rdfs:label 'Tin Type' ;
    rdfs:comment 'Specifies the type of IRS Taxpayer Identification Number: SSN (Social Security Number), FEIN (Federal Employer Identification Number), ITIN (Individual Taxpayer Identification Number), or EIN (Employer Identification Number).' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationSource rdf:type rdf:Property ;
    rdfs:label 'Verification Source' ;
    rdfs:comment 'Name of the system or service used to verify this identifier (e.g., NIPR, IRS TIN Match, SSA, LexisNexis, Equifax, state DMV MVR, CLUE). Supports audit and compliance documentation.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:individualId rdf:type rdf:Property ;
    rdfs:label 'Individual Id' ;
    rdfs:comment 'Unique surrogate key identifying a natural person in the party master. One row per individual. MASTER_PARTY role; canonical-attrs-enforced.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:birthDate rdf:type rdf:Property ;
    rdfs:label 'Birth Date' ;
    rdfs:comment 'Individual\'s date of birth in ISO 8601 format. Used for age-based rating, eligibility screening, MVR ordering, and FCRA-compliant underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:citizenshipCountryCode rdf:type rdf:Property ;
    rdfs:label 'Citizenship Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the individual\'s country of citizenship. Used for KYC, OFAC screening, and international policy eligibility.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Clue Consent Flag' ;
    rdfs:comment 'Indicates whether the individual has consented to a CLUE report pull for prior loss history. Required under FCRA before accessing LexisNexis CLUE data.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationPreference rdf:type rdf:Property ;
    rdfs:label 'Communication Preference' ;
    rdfs:comment 'Individual\'s preferred channel for receiving policy documents, billing notices, and claims correspondence. Drives document delivery routing in the PAS and billing system.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScore rdf:type rdf:Property ;
    rdfs:label 'Credit Score' ;
    rdfs:comment 'Insurance-based credit score obtained from a consumer reporting agency. Used as a rating variable in personal lines where permitted by state DOI. Governed by FCRA.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScoreDate rdf:type rdf:Property ;
    rdfs:label 'Credit Score Date' ;
    rdfs:comment 'Date on which the insurance credit score was last obtained. Used to determine score currency and trigger re-pull at renewal per underwriting guidelines.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditScoreSource rdf:type rdf:Property ;
    rdfs:label 'Credit Score Source' ;
    rdfs:comment 'Name of the consumer reporting agency or scoring model that provided the insurance credit score. Required for FCRA adverse action notices and audit trails.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deceasedDate rdf:type rdf:Property ;
    rdfs:label 'Deceased Date' ;
    rdfs:comment 'Date of death for the individual if known. Triggers policy lifecycle actions (cancellation, beneficiary notification) and stops renewal processing.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driversLicenseExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Drivers License Expiry Date' ;
    rdfs:comment 'Expiration date of the individual\'s driver license. Used to flag expired licenses during auto underwriting eligibility checks and renewal processing.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driversLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Drivers License Number' ;
    rdfs:comment 'State-issued driver license number for the individual. Required for MVR ordering, auto underwriting eligibility, and claims investigation in personal and commercial auto lines.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driversLicenseState rdf:type rdf:Property ;
    rdfs:label 'Drivers License State' ;
    rdfs:comment 'Two-letter USPS state code of the jurisdiction that issued the individual\'s driver license. Required to route MVR orders to the correct state DMV.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerName rdf:type rdf:Property ;
    rdfs:label 'Employer Name' ;
    rdfs:comment 'Name of the individual\'s current employer. Used in commercial lines underwriting, group policy eligibility verification, and workers compensation exposure assessment.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Legal given name of the individual as it appears on government-issued identification. Used for policy issuance, claims, and regulatory reporting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderCode rdf:type rdf:Property ;
    rdfs:label 'Gender Code' ;
    rdfs:comment 'Gender of the individual as reported. M=Male, F=Female, X=Non-binary/Other, U=Unknown. Used in auto and life rating where permitted by state DOI regulations.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goldenRecordFlag rdf:type rdf:Property ;
    rdfs:label 'Golden Record Flag' ;
    rdfs:comment 'Indicates this individual record is the master golden record in the MDM after deduplication. Non-golden records are survivorship candidates linked to the golden record.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified Date' ;
    rdfs:comment 'Date on which the individual\'s identity was last successfully verified through the KYC process. Used to determine re-verification cadence per compliance policy.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Legal surname of the individual as it appears on government-issued identification. Used for policy issuance, claims, and regulatory reporting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maritalStatusCode rdf:type rdf:Property ;
    rdfs:label 'Marital Status Code' ;
    rdfs:comment 'Marital status of the individual. S=Single, M=Married, D=Divorced, W=Widowed, P=Domestic Partner. Used as a rating variable in personal auto and homeowners lines.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:middleName rdf:type rdf:Property ;
    rdfs:label 'Middle Name' ;
    rdfs:comment 'Legal middle name or initial of the individual. Used for identity disambiguation and matching against MVR and CLUE reports.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Mvr Consent Flag' ;
    rdfs:comment 'Indicates whether the individual has provided written consent for the insurer to order an MVR report. Required under FCRA before pulling driving history for underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:namePrefix rdf:type rdf:Property ;
    rdfs:label 'Name Prefix' ;
    rdfs:comment 'Honorific or title prefix for the individual\'s name (e.g., Mr., Dr.). Used in correspondence, policy documents, and declarations pages.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameSuffix rdf:type rdf:Property ;
    rdfs:label 'Name Suffix' ;
    rdfs:comment 'Generational or professional suffix appended to the individual\'s legal name (e.g., Jr., Sr., II). Used for precise identity matching and document generation.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupationCode rdf:type rdf:Property ;
    rdfs:label 'Occupation Code' ;
    rdfs:comment 'Standardized occupation classification code for the individual. Used as a rating variable in personal lines and for SIC/NAICS alignment in commercial underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupationDescription rdf:type rdf:Property ;
    rdfs:label 'Occupation Description' ;
    rdfs:comment 'Free-text description of the individual\'s occupation or job title as self-reported on the application. Supplements the occupation code for underwriting review.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreenedFlag rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened Flag' ;
    rdfs:comment 'Indicates whether the individual has been screened against the OFAC Specially Designated Nationals list. Mandatory before policy issuance and claim payment.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Preferred Language Code' ;
    rdfs:comment 'BCP 47 language tag representing the individual\'s preferred communication language (e.g., en-US, es-MX). Used for policy document generation and claims correspondence.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCarrierName rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Name' ;
    rdfs:comment 'Name of the individual\'s most recent prior insurance carrier. Used in underwriting to verify continuous coverage and assess prior loss history context.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Expiry Date' ;
    rdfs:comment 'Expiration date of the individual\'s most recent prior policy. Used to calculate coverage lapse duration and apply lapse surcharges per underwriting guidelines.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:residencyCountryCode rdf:type rdf:Property ;
    rdfs:label 'Residency Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the individual\'s country of primary residence. Used for jurisdictional rating, regulatory compliance, and tax reporting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residencyStateCode rdf:type rdf:Property ;
    rdfs:label 'Residency State Code' ;
    rdfs:comment 'Two-letter USPS state code of the individual\'s state of primary residence. Determines applicable state DOI regulations, rating territory, and statutory form requirements.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemPersonCode rdf:type rdf:Property ;
    rdfs:label 'Source System Person Code' ;
    rdfs:comment 'Native identifier for this individual in the originating operational system (e.g., Guidewire PolicyCenter contact ID). Used for cross-system reconciliation and ETL lineage.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnHash rdf:type rdf:Property ;
    rdfs:label 'Ssn Hash' ;
    rdfs:comment 'One-way cryptographic hash of the individual\'s SSN. Used for identity deduplication and CLUE/MVR ordering without storing the raw SSN in the lakehouse.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnLastFour rdf:type rdf:Property ;
    rdfs:label 'Ssn Last Four' ;
    rdfs:comment 'Last four digits of the individual\'s SSN retained for identity verification and customer service purposes per GLBA data minimization requirements.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsContinuouslyInsured rdf:type rdf:Property ;
    rdfs:label 'Years Continuously Insured' ;
    rdfs:comment 'Number of years the individual has maintained continuous insurance coverage without a lapse. Used as a rating and eligibility variable in personal lines underwriting.' ;
    rdfs:domain ind:Individual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:kycVerificationId rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Id' ;
    rdfs:comment 'Unique surrogate identifier for each KYC verification record. One row per KYC check performed on a party. Grain: one row per KYC verification event per party.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jurisdictionGeographyId rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Geography Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.geography. Business justification: KYC regulatory compliance reporting requires tracking verification jurisdiction by state/country geography.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:kycAnalystPartyId rdf:type rdf:Property ;
    rdfs:label 'Kyc Analyst Party Id' ;
    rdfs:comment 'Identifier of the compliance analyst or underwriter who performed or reviewed this KYC verification. Required for manual review cases and audit accountability. Links to the Party or User record.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:kycOverrideApproverPartyId rdf:type rdf:Property ;
    rdfs:label 'Kyc Override Approver Party Id' ;
    rdfs:comment 'Identifier of the senior compliance officer or manager who approved the override of a KYC verification result. Populated only when override_reason is present. Supports SOX audit controls.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:kycPartyId rdf:type rdf:Property ;
    rdfs:label 'Kyc Party Id' ;
    rdfs:comment 'Reference to the party (person or organization) subject to this KYC verification. Links to the Party master record in the Party domain.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:adverseMediaSummary rdf:type rdf:Property ;
    rdfs:label 'Adverse Media Summary' ;
    rdfs:comment 'Brief narrative summary of adverse media findings when is_adverse_media is true. Captures the nature of the negative news (e.g., fraud allegation, regulatory sanction) for analyst review and documentation.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystDecision rdf:type rdf:Property ;
    rdfs:label 'Analyst Decision' ;
    rdfs:comment 'Final decision made by the compliance analyst after reviewing the KYC verification results. APPROVE=cleared to proceed; REJECT=relationship declined; ESCALATE=referred to senior compliance; DEFER=pending additional info.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystNotes rdf:type rdf:Property ;
    rdfs:label 'Analyst Notes' ;
    rdfs:comment 'Free-text notes entered by the compliance analyst documenting the rationale for the decision, exceptions granted, or additional context observed during the KYC review process.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficialOwnerCount rdf:type rdf:Property ;
    rdfs:label 'Beneficial Owner Count' ;
    rdfs:comment 'Number of beneficial owners identified and verified for a legal entity party. Per FinCEN CDD Rule, includes all natural persons owning 25% or more equity interest plus one control person.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:beneficialOwnerVerified rdf:type rdf:Property ;
    rdfs:label 'Beneficial Owner Verified' ;
    rdfs:comment 'Indicates whether the beneficial ownership of the party (for legal entities) has been verified per FinCEN CDD Rule requirements. Mandatory for legal entity customers with 25%+ ownership threshold.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceCode rdf:type rdf:Property ;
    rdfs:label 'Data Source Code' ;
    rdfs:comment 'Code identifying the originating system or data source for this KYC verification record (e.g., MDM_KYC, PAS_UW, CLAIMS_FNOL). Supports data lineage and source-system reconciliation in the lakehouse.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueDiligenceLevel rdf:type rdf:Property ;
    rdfs:label 'Due Diligence Level' ;
    rdfs:comment 'Level of due diligence applied for this KYC verification. SIMPLIFIED=low-risk customers; STANDARD=normal CDD; ENHANCED=high-risk, PEP, or OFAC-adjacent parties. Aligns with FinCEN CDD Rule tiers.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Narrative reason for escalating this KYC case to senior compliance or a Suspicious Activity Report (SAR) filing. Populated when analyst_decision is ESCALATE. Supports AML investigation workflow.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocumentExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Identity Document Expiry Date' ;
    rdfs:comment 'Expiration date of the identity document used during verification. An expired document may invalidate the KYC result and trigger a re-verification requirement.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityDocumentIssuingCountry rdf:type rdf:Property ;
    rdfs:label 'Identity Document Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the authority that issued the identity document used in verification. Used for sanctions screening and cross-border risk assessment.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Identity Document Number' ;
    rdfs:comment 'The document number from the identity document used for verification (e.g., passport number, driver license number, FEIN). Stored as restricted PII per GLBA and FCRA requirements.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocumentType rdf:type rdf:Property ;
    rdfs:label 'Identity Document Type' ;
    rdfs:comment 'Type of identity document presented or verified during the KYC check. PASSPORT, DRIVERS_LICENSE, NATIONAL_ID, STATE_ID, MILITARY_ID for individuals; FEIN (Federal Employer Identification Number) for organizations.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdverseMedia rdf:type rdf:Property ;
    rdfs:label 'Is Adverse Media' ;
    rdfs:comment 'Indicates whether adverse media (negative news coverage related to financial crime, fraud, sanctions, or regulatory action) was found for this party during the KYC screening process.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPep rdf:type rdf:Property ;
    rdfs:label 'Is Pep' ;
    rdfs:comment 'Indicates whether the party has been identified as a Politically Exposed Person (PEP) — a current or former senior government official or close associate. Triggers enhanced due diligence requirements.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ofacHitReference rdf:type rdf:Property ;
    rdfs:label 'Ofac Hit Reference' ;
    rdfs:comment 'OFAC SDN list entry reference number or identifier when a hit or potential hit is recorded. Populated only when ofac_screening_status is HIT or POTENTIAL_HIT. Used for regulatory escalation.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Ofac Screening Status' ;
    rdfs:comment 'Result of screening the party against the OFAC Specially Designated Nationals (SDN) and blocked persons list. CLEAR=no match; HIT=confirmed match; POTENTIAL_HIT=possible match requiring review.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pepCategory rdf:type rdf:Property ;
    rdfs:label 'Pep Category' ;
    rdfs:comment 'Classification of the PEP relationship when is_pep is true. DOMESTIC=domestic official; FOREIGN=foreign official; INTERNATIONAL_ORGANIZATION=IO official; CLOSE_ASSOCIATE=known associate; FAMILY_MEMBER=immediate family.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'Date on which the compliance analyst completed their manual review and recorded the analyst_decision. Distinct from verification_date which is when the automated check ran.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskTier rdf:type rdf:Property ;
    rdfs:label 'Risk Tier' ;
    rdfs:comment 'Customer risk classification assigned as a result of the KYC process. Determines due diligence level, review frequency, and monitoring intensity. Aligns with FATF risk-based approach.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sarFiled rdf:type rdf:Property ;
    rdfs:label 'Sar Filed' ;
    rdfs:comment 'Indicates whether a Suspicious Activity Report (SAR) was filed with FinCEN as a result of this KYC verification finding. Triggers restricted access controls on the record per BSA requirements.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sarReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sar Reference Number' ;
    rdfs:comment 'FinCEN-assigned reference number for the Suspicious Activity Report filed in connection with this KYC verification. Populated only when sar_filed is true. Strictly access-controlled.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siuCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Siu Case Number' ;
    rdfs:comment 'Case reference number assigned by the SIU system when this KYC verification triggered a fraud investigation referral. Populated only when siu_referral is true.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siuReferral rdf:type rdf:Property ;
    rdfs:label 'Siu Referral' ;
    rdfs:comment 'Indicates whether this KYC verification result triggered a referral to the Special Investigations Unit (SIU) for potential insurance fraud investigation. Integrates with the Fraud Detection/SIU System.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyProvider rdf:type rdf:Property ;
    rdfs:label 'Third Party Provider' ;
    rdfs:comment 'Name of the external vendor or service used to perform the KYC verification (e.g., LexisNexis, Experian, Equifax, Refinitiv World-Check). Populated when verification_method is THIRD_PARTY_SERVICE.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Third Party Reference Code' ;
    rdfs:comment 'Unique transaction or case reference number returned by the third-party KYC provider for this verification. Used for reconciliation, dispute resolution, and audit trail with the external vendor.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerEvent rdf:type rdf:Property ;
    rdfs:label 'Trigger Event' ;
    rdfs:comment 'Business event that initiated this KYC verification. NEW_BUSINESS=new policy application; RENEWAL=policy renewal; ENDORSEMENT=mid-term change; CLAIM_FNOL=first notice of loss; PERIODIC_REVIEW=scheduled refresh; RISK_CHANGE=risk profile change.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationResult rdf:type rdf:Property ;
    rdfs:label 'Verification Result' ;
    rdfs:comment 'Detailed outcome of the verification check. CLEAR=no issues found; MATCH=identity confirmed; NO_MATCH=identity not confirmed; PARTIAL_MATCH=partial data match requiring review; INCONCLUSIVE=insufficient data.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationType rdf:type rdf:Property ;
    rdfs:label 'Verification Type' ;
    rdfs:comment 'Category of KYC check performed. IDENTITY=identity document check; OFAC_SCREENING=sanctions list; PEP_SCREENING=politically exposed person; ADVERSE_MEDIA=negative news; EDU=enhanced due diligence; PERIODIC_REVIEW=scheduled refresh.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchlistHitDetail rdf:type rdf:Property ;
    rdfs:label 'Watchlist Hit Detail' ;
    rdfs:comment 'Description of any watchlist match found beyond OFAC screening, including the list name and entry reference. Populated when watchlist_screened is true and a match was identified.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchlistScreened rdf:type rdf:Property ;
    rdfs:label 'Watchlist Screened' ;
    rdfs:comment 'Indicates whether the party was screened against applicable government and industry watchlists beyond OFAC (e.g., FBI Most Wanted, Interpol, EU Consolidated List, UN Sanctions). Supports comprehensive AML compliance.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseId rdf:type rdf:Property ;
    rdfs:label 'License Id' ;
    rdfs:comment 'Unique surrogate identifier for a professional license record held by a party. Primary key of the license table; one row per license per party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:License .

ind:issuingGeographyId rdf:type rdf:Property ;
    rdfs:label 'Issuing Geography Id' ;
    rdfs:comment 'Foreign key linking to catastrophegeography.geography. Business justification: Producer license validation by operating territory and regulatory compliance tracking require linking licenses to issuing state geography.' ;
    rdfs:domain ind:License ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Geography .

ind:ceCreditsCompleted rdf:type rdf:Property ;
    rdfs:label 'Ce Credits Completed' ;
    rdfs:comment 'Number of continuing education (CE) credit hours completed by the licensee in the current renewal cycle. Compared against ce_credits_required to assess compliance.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ceCreditsRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Credits Required' ;
    rdfs:comment 'Total number of continuing education (CE) credit hours required by the issuing state for the current renewal cycle. Varies by state and license class.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:class rdf:type rdf:Property ;
    rdfs:label 'Class' ;
    rdfs:comment 'Sub-classification of the license type as defined by the issuing state (e.g., Property, Casualty, Life, Health, Personal Lines, Commercial Lines). Drives appointment eligibility.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingEducationDueDate rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Due Date' ;
    rdfs:comment 'Date by which the licensee must complete required continuing education (CE) credit hours to maintain license validity. Drives CE compliance tracking and renewal alerts.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractorLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Contractor License Number' ;
    rdfs:comment 'State-issued contractor license number for parties who are licensed contractors (e.g., restoration vendors). Populated only when license_type is \'contractor\'. Used in claims vendor management.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionDescription rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Description' ;
    rdfs:comment 'Free-text description of any regulatory disciplinary actions, fines, or sanctions associated with this license. Populated only when disciplinary_action_indicator is True.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionIndicator rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Indicator' ;
    rdfs:comment 'Indicates whether the licensee has any regulatory disciplinary actions, fines, or sanctions on record with the issuing DOI (True) or not (False). Sourced from NIPR PDB.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:errorsOmissionsCarrier rdf:type rdf:Property ;
    rdfs:label 'Errors Omissions Carrier' ;
    rdfs:comment 'Name of the insurance carrier providing the licensee\'s Errors and Omissions (E&O) professional liability coverage. Required for producer appointment eligibility verification.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorsOmissionsExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Errors Omissions Expiry Date' ;
    rdfs:comment 'Expiration date of the licensee\'s Errors and Omissions (E&O) professional liability policy. Drives alerts when E&O coverage is about to lapse, which may affect appointment status.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:errorsOmissionsPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Errors Omissions Policy Number' ;
    rdfs:comment 'Policy number of the licensee\'s Errors and Omissions (E&O) professional liability insurance. Verified during producer appointment and renewal processes.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethicsCeCreditsCompleted rdf:type rdf:Property ;
    rdfs:label 'Ethics Ce Credits Completed' ;
    rdfs:comment 'Number of ethics-specific continuing education (CE) credit hours completed by the licensee in the current renewal cycle. Compared against ethics_ce_credits_required.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ethicsCeCreditsRequired rdf:type rdf:Property ;
    rdfs:label 'Ethics Ce Credits Required' ;
    rdfs:comment 'Number of ethics-specific continuing education (CE) credit hours mandated by the issuing state within the renewal cycle. Many states require a separate ethics CE component.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fein rdf:type rdf:Property ;
    rdfs:label 'Fein' ;
    rdfs:comment 'Federal Employer Identification Number of the licensed entity when the licensee is an organization (agency or firm). Used for tax reporting and IRS compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isResidentLicense rdf:type rdf:Property ;
    rdfs:label 'Is Resident License' ;
    rdfs:comment 'Indicates whether this is a resident (home-state) license (True) or a non-resident license (False). Non-resident licenses are issued under reciprocity agreements.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'Date on which the issuing state DOI originally granted this license. Used to calculate license tenure and continuing education (CE) cycle start.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseStatus rdf:type rdf:Property ;
    rdfs:label 'License Status' ;
    rdfs:comment 'Current regulatory status of the license as reported by the issuing DOI or NIPR. Drives eligibility for producer appointments and claim adjuster assignments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseType rdf:type rdf:Property ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Category of professional license held by the party. Distinguishes producer, adjuster, contractor, surplus lines, and other license types. [ENUM-REF-CANDIDATE: promote to reference product if types expand]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:niprLastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Nipr Last Verified Date' ;
    rdfs:comment 'Date on which this license record was last verified against the NIPR Producer Database (PDB). Supports ongoing compliance monitoring and stale-data detection.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:niprVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Nipr Verification Status' ;
    rdfs:comment 'Result of the most recent NIPR PDB verification check for this license. \'mismatch\' indicates discrepancies between internal records and NIPR data requiring remediation.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reciprocityStateCodes rdf:type rdf:Property ;
    rdfs:label 'Reciprocity State Codes' ;
    rdfs:comment 'Comma-delimited list of two-letter state codes where this license is recognized under reciprocity agreements. Enables multi-state appointment eligibility without separate applications.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Date on which the license was most recently renewed by the issuing DOI. Tracks renewal history and supports continuing education (CE) compliance monitoring.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:residentStateCode rdf:type rdf:Property ;
    rdfs:label 'Resident State Code' ;
    rdfs:comment 'Two-letter US state code of the licensee\'s home state of residence. Distinguishes resident licenses from non-resident licenses for NIPR and reciprocity tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemLicenseKey rdf:type rdf:Property ;
    rdfs:label 'Source System License Key' ;
    rdfs:comment 'Natural key or record identifier for this license in the originating source system (e.g., NIPR PDB record ID, PAS license record ID). Supports reconciliation and deduplication.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnLast4 rdf:type rdf:Property ;
    rdfs:label 'Ssn Last4' ;
    rdfs:comment 'Last four digits of the licensee\'s Social Security Number, stored for identity verification purposes only. Full SSN must not be stored per GLBA and GDPR/CCPA data minimization.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesAuthorized rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Authorized' ;
    rdfs:comment 'Indicates whether the licensee is authorized to place surplus lines business in the issuing state (True) or not (False). Required for non-admitted market placements.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surplusLinesNumber rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Number' ;
    rdfs:comment 'State-issued surplus lines license number, distinct from the standard producer license number. Required for stamping office filings and surplus lines tax remittance.' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'Reason code explaining why the license was terminated or revoked. Populated only when termination_date is set. Supports regulatory and compliance reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossPayeeId rdf:type rdf:Property ;
    rdfs:label 'Loss Payee Id' ;
    rdfs:comment 'Unique surrogate identifier for each loss payee or mortgagee interest record. One row per interest attachment on a party and policy or insured risk.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lenderAddressId rdf:type rdf:Property ;
    rdfs:label 'Lender Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Loss payee embeds lender address fields that should be normalized to the address table. The address table is the SSOT for all addresses.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:acordFormType rdf:type rdf:Property ;
    rdfs:label 'Acord Form Type' ;
    rdfs:comment 'ACORD standard form type used to evidence this loss payee or mortgagee interest (e.g., ACORD 25 Certificate of Liability, ACORD 28 Evidence of Property Insurance).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationNoticeSent rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Sent' ;
    rdfs:comment 'Indicates whether the required cancellation or non-renewal notice has been sent to this loss payee or mortgagee per the policy terms and state regulations.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Number' ;
    rdfs:comment 'Lender escrow account number used to collect and remit insurance premium payments on behalf of the mortgagor. Supports billing integration with lender.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRank rdf:type rdf:Property ;
    rdfs:label 'Interest Rank' ;
    rdfs:comment 'Ordinal rank of this interest when multiple loss payees or mortgagees exist on the same insured risk (e.g., first mortgagee = 1, second mortgagee = 2).' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interestStatus rdf:type rdf:Property ;
    rdfs:label 'Interest Status' ;
    rdfs:comment 'Current lifecycle status of the loss payee or mortgagee interest record. Drives whether the interest is honored in claims payment and certificate issuance.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestType rdf:type rdf:Property ;
    rdfs:label 'Interest Type' ;
    rdfs:comment 'Classification of the financial interest held by the party on the policy or insured risk. Drives certificate of insurance (CoI) and claims payment routing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jointPayeeRequired rdf:type rdf:Property ;
    rdfs:label 'Joint Payee Required' ;
    rdfs:comment 'Indicates whether claim payments must be made jointly to both the insured and this loss payee or mortgagee rather than solely to the insured.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lenderEmail rdf:type rdf:Property ;
    rdfs:label 'Lender Email' ;
    rdfs:comment 'Email address of the lender or mortgagee institution used for electronic certificate of insurance delivery and claims payment notifications.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderFein rdf:type rdf:Property ;
    rdfs:label 'Lender Fein' ;
    rdfs:comment 'IRS-assigned Federal Employer Identification Number (FEIN) of the lending institution. Required for tax reporting on claim payments and 1099 issuance.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderName rdf:type rdf:Property ;
    rdfs:label 'Lender Name' ;
    rdfs:comment 'Legal name of the lending institution, mortgagee, or lienholder as it must appear on the policy declarations and loss payment instruments.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderPhone rdf:type rdf:Property ;
    rdfs:label 'Lender Phone' ;
    rdfs:comment 'Primary contact telephone number for the lender or mortgagee institution used for claims notification and certificate of insurance correspondence.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Lender Reference Number' ;
    rdfs:comment 'Secondary lender-assigned reference or account number (e.g., investor loan number, servicer reference) distinct from the primary loan number.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossPayableClauseType rdf:type rdf:Property ;
    rdfs:label 'Loss Payable Clause Type' ;
    rdfs:comment 'Type of loss payable clause attached to the policy for this interest: Standard, Lenders (protects lender independently), Open, or Union mortgage clause.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicLenderCode rdf:type rdf:Property ;
    rdfs:label 'Naic Lender Code' ;
    rdfs:comment 'NAIC-assigned code identifying the lender or financial institution for statutory reporting and Schedule F bordereaux purposes.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDays rdf:type rdf:Property ;
    rdfs:label 'Notification Days' ;
    rdfs:comment 'Number of days advance notice required to be given to the lender or mortgagee before policy cancellation or non-renewal takes effect.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationRequired rdf:type rdf:Property ;
    rdfs:label 'Notification Required' ;
    rdfs:comment 'Indicates whether the lender or mortgagee must be notified of policy changes, cancellations, or non-renewals per the loss payable clause or lender agreement.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPayableTo rdf:type rdf:Property ;
    rdfs:label 'Payment Payable To' ;
    rdfs:comment 'Full legal name(s) as they must appear on claim payment instruments (checks or EFT) issued jointly or solely to this loss payee or mortgagee.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Threshold Amount' ;
    rdfs:comment 'Minimum claim payment amount above which joint payee or mortgagee co-endorsement is required per the lender agreement or loss payable clause.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumBilledToLender rdf:type rdf:Property ;
    rdfs:label 'Premium Billed To Lender' ;
    rdfs:comment 'Indicates whether the insurance premium is billed directly to the lender via escrow rather than to the policyholder. Drives billing system routing.' ;
    rdfs:domain ind:LossPayee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemRefCode rdf:type rdf:Property ;
    rdfs:label 'Source System Ref Code' ;
    rdfs:comment 'Native identifier of this loss payee interest record in the originating operational system (e.g., Guidewire PolicyCenter internal ID) for lineage and reconciliation.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeEventId rdf:type rdf:Property ;
    rdfs:label 'Merge Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each Master Data Management (MDM) party merge event. One row per merge operation in the Party MDM deduplication process.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mergeApprovedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Merge Approved By Party Id' ;
    rdfs:comment 'Foreign key to the Party (operator/user) who reviewed and approved the merge decision. Required for audit trail and SOX compliance.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:mergeReversedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Merge Reversed By Party Id' ;
    rdfs:comment 'Foreign key to the Party (operator/user) who authorized and executed the reversal of this merge event. Null if no reversal has occurred.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:mergeSurvivorPartyId rdf:type rdf:Property ;
    rdfs:label 'Merge Survivor Party Id' ;
    rdfs:comment 'Foreign key to the Party record designated as the golden/survivor record after the merge. All downstream references are repointed to this party.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:primaryMergedPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Merged Party Id' ;
    rdfs:comment 'Foreign key to the Party record identified as the duplicate and absorbed into the survivor. This party is retired after the merge operation completes.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:affectedBillingAccountCount rdf:type rdf:Property ;
    rdfs:label 'Affected Billing Account Count' ;
    rdfs:comment 'Number of billing accounts linked to the merged party that were consolidated under the survivor party as part of this merge operation.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Affected Claim Count' ;
    rdfs:comment 'Number of claims linked to the merged (duplicate) party that were repointed to the survivor party as a result of this merge operation.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedPolicyCount rdf:type rdf:Property ;
    rdfs:label 'Affected Policy Count' ;
    rdfs:comment 'Number of active or historical policies linked to the merged (duplicate) party that were repointed to the survivor party as a result of this merge operation.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:batchRunCode rdf:type rdf:Property ;
    rdfs:label 'Batch Run Code' ;
    rdfs:comment 'Identifier of the MDM deduplication batch job run that generated this merge event, if the merge was produced by an automated batch matching process rather than a real-time request.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictResolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Conflict Resolution Notes' ;
    rdfs:comment 'Operator-entered notes describing how conflicting attribute values between the survivor and merged party were resolved. Null if no conflicts were detected.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataConflictFlag rdf:type rdf:Property ;
    rdfs:label 'Data Conflict Flag' ;
    rdfs:comment 'Indicates whether conflicting attribute values (e.g., different addresses, DOBs, or contact details) were detected between the survivor and merged party records during the merge.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycReviewCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Kyc Review Completed Flag' ;
    rdfs:comment 'Indicates whether the post-merge KYC review has been completed for the survivor party. Relevant only when kyc_review_required_flag is true.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Kyc Review Required Flag' ;
    rdfs:comment 'Indicates whether the merge triggered a KYC re-verification requirement for the survivor party, typically when identity attributes differ between the two records.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchRuleSet rdf:type rdf:Property ;
    rdfs:label 'Match Rule Set' ;
    rdfs:comment 'Identifier or name of the matching rule set or algorithm version applied by the MDM engine to compute the match score (e.g., RULE_SET_V3_NAME_DOB_SSN).' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchScore rdf:type rdf:Property ;
    rdfs:label 'Match Score' ;
    rdfs:comment 'Probabilistic similarity score (0.00–100.00) produced by the MDM matching algorithm comparing the survivor and merged party records. Higher scores indicate stronger duplicate confidence.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mergeApprovedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Merge Approved Timestamp' ;
    rdfs:comment 'Date and time when an authorized operator approved the merge operation. Null if the merge is automated and requires no human approval step.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mergeChannel rdf:type rdf:Property ;
    rdfs:label 'Merge Channel' ;
    rdfs:comment 'The processing channel through which the merge was initiated: batch deduplication job, real-time event trigger, API call from an integrated system, or manual entry via the MDM user interface.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeExecutedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Merge Executed Timestamp' ;
    rdfs:comment 'Date and time when the merge operation was physically applied in the MDM system, retiring the duplicate party and consolidating records under the survivor.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mergeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Merge Reason Code' ;
    rdfs:comment 'Standardized code classifying the root cause of the duplicate. Drives reporting on data quality issues and MDM process improvement. [ENUM-REF-CANDIDATE: promote to reference product if codes expand]' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Merge Reason Description' ;
    rdfs:comment 'Free-text narrative explaining the specific circumstances that led to the duplicate party records and the rationale for selecting the survivor record.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeRequestCode rdf:type rdf:Property ;
    rdfs:label 'Merge Request Code' ;
    rdfs:comment 'Externally visible business identifier for the merge request ticket or workflow instance, as assigned by the MDM or deduplication system (e.g., MDM-2024-00123).' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeRequestedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Merge Requested Timestamp' ;
    rdfs:comment 'Date and time when the merge request was first submitted into the MDM workflow queue, in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mergeStatus rdf:type rdf:Property ;
    rdfs:label 'Merge Status' ;
    rdfs:comment 'Current lifecycle state of the merge operation. Pending awaits approval; approved is authorized but not yet executed; completed is fully applied; reversed is undone; failed encountered an error.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeType rdf:type rdf:Property ;
    rdfs:label 'Merge Type' ;
    rdfs:comment 'Indicates whether the merge was initiated manually by an operator, triggered automatically by the MDM matching engine, or surfaced as a system suggestion pending human review.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergedPartyPreMergeStatus rdf:type rdf:Property ;
    rdfs:label 'Merged Party Pre Merge Status' ;
    rdfs:comment 'Lifecycle status of the duplicate party record immediately before the merge was executed. Preserved for audit and potential reversal.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required Flag' ;
    rdfs:comment 'Indicates whether the merge of these party records triggers a regulatory notification obligation, such as under GLBA, GDPR/CCPA, or state DOI market conduct requirements.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Sent Flag' ;
    rdfs:comment 'Indicates whether the required regulatory notification has been dispatched following the merge. Relevant only when regulatory_notification_required_flag is true.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reversal Timestamp' ;
    rdfs:comment 'Date and time when a completed merge was reversed (un-merged). Null if the merge has not been reversed. Supports audit trail for erroneous merges.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemMergeRef rdf:type rdf:Property ;
    rdfs:label 'Source System Merge Ref' ;
    rdfs:comment 'The native identifier or transaction reference for this merge event as recorded in the originating source system, enabling cross-system traceability.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorPartyPreMergeStatus rdf:type rdf:Property ;
    rdfs:label 'Survivor Party Pre Merge Status' ;
    rdfs:comment 'Lifecycle status of the survivor party record immediately before the merge was executed. Preserved for audit and potential reversal.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorSelectionBasis rdf:type rdf:Property ;
    rdfs:label 'Survivor Selection Basis' ;
    rdfs:comment 'Criterion used to designate the survivor record: most recently updated, most data-complete, most associated policies, operator override, or system default rule.' ;
    rdfs:domain ind:MergeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationId rdf:type rdf:Property ;
    rdfs:label 'Organization Id' ;
    rdfs:comment 'Unique surrogate identifier for the organization record in the party master data management system. Primary key for the organization entity.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mailingAddressId rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Id' ;
    rdfs:comment 'Foreign key linking to party.address. Business justification: Organization embeds mailing address fields that duplicate the address table structure. The address table is the SSOT for all addresses and provides geocoding, territory codes, CAT zones, and' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:parentOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Parent Organization Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediate parent organization in a corporate hierarchy. Supports enterprise account management, consolidated TIV, and group policy structures.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:primaryUltimateParentOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Primary Ultimate Parent Organization Id' ;
    rdfs:comment 'Identifier of the top-level ultimate parent in the corporate ownership hierarchy. Used for enterprise-wide exposure aggregation, PML modeling, and group reinsurance treaty application.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:annualPayroll rdf:type rdf:Property ;
    rdfs:label 'Annual Payroll' ;
    rdfs:comment 'Organization\'s total annual payroll in USD. Primary rating basis for Workers Compensation (WC) and a secondary factor for CGL and employer liability lines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualRevenue rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue' ;
    rdfs:comment 'Organization\'s most recently reported annual gross revenue in USD. Used as a rating basis for CGL, E&O, D&O, and EPLI lines, and for exposure-based premium calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dbaName rdf:type rdf:Property ;
    rdfs:label 'Dba Name' ;
    rdfs:comment 'Trade name or doing-business-as name used by the organization in commercial operations, which may differ from the registered legal name.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dunsNumber rdf:type rdf:Property ;
    rdfs:label 'Duns Number' ;
    rdfs:comment 'Nine-digit Dun & Bradstreet Data Universal Numbering System (DUNS) number for the organization. Used for commercial credit scoring, financial strength assessment, and third-party data enrichment.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeCount rdf:type rdf:Property ;
    rdfs:label 'Employee Count' ;
    rdfs:comment 'Total number of full-time equivalent employees. Used in underwriting for WC classification, EPLI exposure assessment, and BOP eligibility determination.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialStatementDate rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Date' ;
    rdfs:comment 'Date of the most recent financial statement used to derive annual revenue and payroll figures. Ensures underwriting data currency and supports audit trail for rating basis.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incorporationCountry rdf:type rdf:Property ;
    rdfs:label 'Incorporation Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code where the organization is incorporated. Required for international commercial accounts, reinsurance counterparties, and OFAC/sanctions screening.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incorporationDate rdf:type rdf:Property ;
    rdfs:label 'Incorporation Date' ;
    rdfs:comment 'Date the organization was legally incorporated or formed. Used in underwriting to assess years in business, business continuity risk, and eligibility for certain commercial lines.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incorporationState rdf:type rdf:Property ;
    rdfs:label 'Incorporation State' ;
    rdfs:comment 'Two-letter US state code where the organization is legally incorporated or registered. Used for jurisdictional underwriting rules, admitted vs. surplus lines determination, and regulatory compliance.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'Full legal name of the organization as registered with the state or federal authority. Used on policy declarations, certificates of insurance, and regulatory filings.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'Six-digit NAICS code identifying the organization\'s primary industry. Supplements SIC for modern commercial underwriting, risk classification, and regulatory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsDescription rdf:type rdf:Property ;
    rdfs:label 'Naics Description' ;
    rdfs:comment 'Plain-text description of the organization\'s primary business activity corresponding to the NAICS code. Provides human-readable context for underwriters and auditors.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Preferred Language' ;
    rdfs:comment 'BCP 47 language tag representing the organization\'s preferred language for communications (e.g., en-US, es-MX). Drives document generation and customer service routing.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Email' ;
    rdfs:comment 'Primary business email address for the organization. Used for policy document delivery, billing notices, claims correspondence, and regulatory communications.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Primary business telephone number for the organization. Used for underwriting contact, claims notification, billing, and producer communication.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publiclyTraded rdf:type rdf:Property ;
    rdfs:label 'Publicly Traded' ;
    rdfs:comment 'Indicates whether the organization\'s securities are publicly traded on a recognized exchange. Relevant for D&O, EPLI, and E&O underwriting and for financial disclosure requirements.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueCurrency rdf:type rdf:Property ;
    rdfs:label 'Revenue Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the annual revenue and payroll amounts. Defaults to USD for domestic accounts; required for multinational commercial programs.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sicCode rdf:type rdf:Property ;
    rdfs:label 'Sic Code' ;
    rdfs:comment 'Four-digit SIC code classifying the organization by primary business activity. Used in commercial underwriting, rating, and ISO classification for CGL and BOP lines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockTicker rdf:type rdf:Property ;
    rdfs:label 'Stock Ticker' ;
    rdfs:comment 'Exchange ticker symbol for publicly traded organizations. Used in D&O underwriting, financial strength monitoring, and market capitalization-based exposure assessment.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Official website URL of the organization. Used in commercial underwriting for business activity verification, cyber risk assessment, and e-commerce exposure evaluation.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsInBusiness rdf:type rdf:Property ;
    rdfs:label 'Years In Business' ;
    rdfs:comment 'Number of years the organization has been in continuous operation. Key underwriting factor for commercial lines eligibility, experience rating, and risk assessment.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:masterPartyId rdf:type rdf:Property ;
    rdfs:label 'Master Party Id' ;
    rdfs:comment 'References the surviving golden-record party_id when this record has been merged into another. Null if this record is itself the golden record. Supports MDM deduplication lineage.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:clueReportDate rdf:type rdf:Property ;
    rdfs:label 'Clue Report Date' ;
    rdfs:comment 'Date the most recent CLUE loss history report was ordered for this party. Used in personal lines underwriting to assess prior claims history. Governed by FCRA.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Date of birth for a natural person. Used in age-based rating, MVR eligibility, KYC identity verification, and OFAC/sanctions screening. Null for ORGANIZATION.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'Date Of Incorporation' ;
    rdfs:comment 'Date the organization was legally incorporated or formed. Used to calculate years_in_business and validate commercial underwriting eligibility. Null for INDIVIDUAL.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:familyName rdf:type rdf:Property ;
    rdfs:label 'Family Name' ;
    rdfs:comment 'Surname/family name of a natural person. Null for ORGANIZATION party type. Used in KYC, CLUE, MVR, and OFAC screening.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fullName rdf:type rdf:Property ;
    rdfs:label 'Full Name' ;
    rdfs:comment 'Golden-record display name. For individuals: concatenated given + family name. For organizations: legal entity name. Primary IDENTITY_LABEL per MDM golden record.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gender rdf:type rdf:Property ;
    rdfs:label 'Gender' ;
    rdfs:comment 'Self-reported gender of a natural person: M=Male, F=Female, X=Non-binary/Other, U=Unknown. Used in auto rating where state-permitted. Null for ORGANIZATION.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:givenName rdf:type rdf:Property ;
    rdfs:label 'Given Name' ;
    rdfs:comment 'First/given name of a natural person. Null for ORGANIZATION party type. Used in correspondence, KYC matching, and CLUE/MVR lookups.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Registered legal name of an organization as filed with the state or federal authority. Null for INDIVIDUAL party type. Used in commercial lines underwriting and FEIN matching.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maritalStatus rdf:type rdf:Property ;
    rdfs:label 'Marital Status' ;
    rdfs:comment 'Marital status of a natural person used in personal lines rating (HO, PAP). Null for ORGANIZATION. [ENUM-REF-CANDIDATE: SINGLE|MARRIED|DIVORCED|WIDOWED|SEPARATED|UNKNOWN — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreenedDate rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened Date' ;
    rdfs:comment 'Most recent date the party was screened against the OFAC Specially Designated Nationals (SDN) list. Required for regulatory compliance before policy binding.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:organizationType rdf:type rdf:Property ;
    rdfs:label 'Organization Type' ;
    rdfs:comment 'Legal structure of an organization party. Drives commercial lines eligibility, CGL/BOP underwriting rules, and FEIN validation. Null for INDIVIDUAL. [ENUM-REF-CANDIDATE: CORPORATION|LLC|PARTNERSHIP|SOLE_PROP|TRUST|NONPROFIT|GOVERNMENT|OTHER — promote to' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyStatus rdf:type rdf:Property ;
    rdfs:label 'Party Status' ;
    rdfs:comment 'Current MDM lifecycle state of the party record. ACTIVE = in use; INACTIVE = no current relationships; DECEASED = confirmed death; MERGED = superseded by survivor; SUSPENDED = under review.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyType rdf:type rdf:Property ;
    rdfs:label 'Party Type' ;
    rdfs:comment 'Discriminator distinguishing a natural person (INDIVIDUAL) from a legal entity (ORGANIZATION). Drives which subtype attributes are populated and which KYC rules apply.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'Party\'s stated preference for receiving communications: EMAIL, PHONE, MAIL, TEXT, or PORTAL. Drives outbound communication routing in PAS and billing systems.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privacyOptOutFlag rdf:type rdf:Property ;
    rdfs:label 'Privacy Opt Out Flag' ;
    rdfs:comment 'Indicates the party has exercised their right to opt out of information sharing with non-affiliated third parties under GLBA/CCPA. Restricts data sharing in downstream systems.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemPartyCode rdf:type rdf:Property ;
    rdfs:label 'Source System Party Code' ;
    rdfs:comment 'The party\'s native identifier in the originating operational system (e.g., Guidewire contact ID, ClaimCenter party ID). Enables cross-system reconciliation and MDM matching.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'State Of Incorporation' ;
    rdfs:comment 'Two-letter US state code where the organization was legally incorporated. Relevant for surplus lines eligibility, admitted vs non-admitted determination, and regulatory filings.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acordRoleCode rdf:type rdf:Property ;
    rdfs:label 'Acord Role Code' ;
    rdfs:comment 'Standardized ACORD data standard role code for this party role assignment. Enables interoperability with trading partners, MGAs, and reinsurers using ACORD XML/JSON.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentReason rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason' ;
    rdfs:comment 'Business reason that triggered the creation of this role assignment. Supports audit trails and lifecycle analysis across the policy and claims lifecycle. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedDate rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Date' ;
    rdfs:comment 'Date on which the required consent was obtained from the party for this role. Null if consent has not yet been obtained or is not required.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fraudScore rdf:type rdf:Property ;
    rdfs:label 'Fraud Score' ;
    rdfs:comment 'Numeric fraud risk score assigned to this party in this role by the fraud detection system. Higher values indicate greater fraud risk. Range 0.00 to 100.00.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guardianFlag rdf:type rdf:Property ;
    rdfs:label 'Guardian Flag' ;
    rdfs:comment 'Indicates whether this party is acting as a legal guardian for a minor or incapacitated insured in this role. Affects claims payment authorization and policy management.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Is Consent Required' ;
    rdfs:comment 'Flags whether this party role requires explicit consent for data processing or communications under GLBA, GDPR, or CCPA privacy regulations.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryRole rdf:type rdf:Property ;
    rdfs:label 'Is Primary Role' ;
    rdfs:comment 'Indicates whether this is the primary instance of the role type for the associated policy or claim. True for the first named insured or lead claimant.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycVerified rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified' ;
    rdfs:comment 'Indicates whether Know Your Customer identity verification has been completed for this party in this role. Required for producers and high-value policyholders.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'Preferred communication channel for this party in this role. Drives billing notices, policy documents, and claims correspondence delivery.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerOfAttorneyFlag rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Flag' ;
    rdfs:comment 'Indicates whether this party is acting under a power of attorney on behalf of another party in this role. Triggers additional documentation and authorization requirements.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:representedByCounsel rdf:type rdf:Property ;
    rdfs:label 'Represented By Counsel' ;
    rdfs:comment 'Indicates whether this party is represented by legal counsel in this role. When True, all communications must be directed to the attorney of record.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roleStatus rdf:type rdf:Property ;
    rdfs:label 'Role Status' ;
    rdfs:comment 'Current lifecycle state of this party role assignment. Drives eligibility checks, billing, and claims adjudication workflows.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRoleCode rdf:type rdf:Property ;
    rdfs:label 'Source System Role Code' ;
    rdfs:comment 'The native identifier for this role assignment in the originating source system (e.g., Guidewire PolicyCenter contact role ID). Supports lineage and reconciliation.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtypeCode rdf:type rdf:Property ;
    rdfs:label 'Subtype Code' ;
    rdfs:comment 'Further classifies the role within its type. For example, distinguishes First Party from Third Party claimants, or Primary from Secondary named insureds.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identification Number' ;
    rdfs:comment 'Federal tax identifier for this party in this role. May be an SSN for individuals or FEIN for organizations. Required for 1099 and statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Tax Reporting Required' ;
    rdfs:comment 'Indicates whether IRS tax reporting (e.g., 1099 issuance) is required for payments made to this party in this role. Relevant for payee, claimant, and producer roles.' ;
    rdfs:domain ind:Role ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:w9OnFile rdf:type rdf:Property ;
    rdfs:label 'W9 On File' ;
    rdfs:comment 'Indicates whether a valid IRS Form W-9 has been collected and is on file for this party role. Required before issuing payments to producers, vendors, and claimants.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relationshipId rdf:type rdf:Property ;
    rdfs:label 'Relationship Id' ;
    rdfs:comment 'Unique surrogate identifier for a directed party-to-party relationship record. One row per relationship instance in the Party MDM.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fromPartyId rdf:type rdf:Property ;
    rdfs:label 'From Party Id' ;
    rdfs:comment 'Surrogate key of the originating (subject) party in the directed relationship, e.g., the policyholder or parent organization.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:partyGroupId rdf:type rdf:Property ;
    rdfs:label 'Party Group Id' ;
    rdfs:comment 'Identifier for a commercial group or affiliated enterprise to which both parties belong. Supports group policy pricing, NAIC group reporting, and affiliated transaction rules.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PartyGroup .

ind:householdId rdf:type rdf:Property ;
    rdfs:label 'Household Id' ;
    rdfs:comment 'Identifier linking parties that belong to the same household unit. Used for multi-policy household bundling, cross-sell analytics, and personal lines rating.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Household .

ind:toPartyId rdf:type rdf:Property ;
    rdfs:label 'To Party Id' ;
    rdfs:comment 'Surrogate key of the target (object) party in the directed relationship, e.g., the additional insured or subsidiary organization.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:relationshipCategory rdf:type rdf:Property ;
    rdfs:label 'Relationship Category' ;
    rdfs:comment 'Broad grouping of the relationship type: Personal (family/household), Commercial (business hierarchy), Legal (trust/guardianship), or Financial (guarantor/beneficiary).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlFlag rdf:type rdf:Property ;
    rdfs:label 'Control Flag' ;
    rdfs:comment 'Indicates whether the from-party exercises a controlling interest over the to-party for regulatory group reporting and affiliated transaction disclosures.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBidirectional rdf:type rdf:Property ;
    rdfs:label 'Is Bidirectional' ;
    rdfs:comment 'Indicates whether the relationship is symmetric (True) or strictly directed (False). Symmetric relationships such as spouse do not require a reciprocal row.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCountryCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction governing the relationship. Supports international and surplus lines business.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionStateCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction governing the relationship. Drives state-specific underwriting rules, regulatory filings, and DOI compliance.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalBasisCode rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Code' ;
    rdfs:comment 'Legal instrument or authority establishing the relationship, e.g., MARRIAGE certificate, COURT_ORDER, CORPORATE_FILING. Required for KYC and regulatory compliance.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalBasisDate rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Date' ;
    rdfs:comment 'Date the legal instrument establishing the relationship was executed or issued, e.g., date of marriage, date of court order, date of corporate filing.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalBasisReference rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Reference' ;
    rdfs:comment 'Document reference number or identifier for the legal instrument establishing the relationship, e.g., marriage certificate number, court order docket number.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of ownership or controlling interest held by the from-party over the to-party. Applicable for parent-subsidiary and investor relationships. Range 0.00–100.00.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roleFrom rdf:type rdf:Property ;
    rdfs:label 'Role From' ;
    rdfs:comment 'The specific role the from-party plays within this relationship instance, e.g., POLICYHOLDER, PARENT, EMPLOYER. Complements relationship_type_code for granular role tracking.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleTo rdf:type rdf:Property ;
    rdfs:label 'Role To' ;
    rdfs:comment 'The specific role the to-party plays within this relationship instance, e.g., ADDITIONAL_INSURED, SUBSIDIARY, EMPLOYEE. Enables multi-role party resolution.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRelationshipCode rdf:type rdf:Property ;
    rdfs:label 'Source System Relationship Code' ;
    rdfs:comment 'Native identifier of this relationship record in the originating source system. Enables lineage tracing and reconciliation back to Guidewire PolicyCenter or Duck Creek.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Uw Impact Flag' ;
    rdfs:comment 'Indicates whether this relationship has a material impact on underwriting eligibility or rating, e.g., a parent-subsidiary relationship affecting group pricing or a household relationship affecting multi-car discount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:segmentId rdf:type rdf:Property ;
    rdfs:label 'Segment Id' ;
    rdfs:comment 'Unique surrogate identifier for a party segment assignment record. One row per segment assignment per party. Primary key of the segment table.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedBy rdf:type rdf:Property ;
    rdfs:label 'Assigned By' ;
    rdfs:comment 'User ID or system process name that created or last modified this segment assignment. Supports audit trail and SOX compliance for underwriting decisions.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catZone rdf:type rdf:Property ;
    rdfs:label 'Cat Zone' ;
    rdfs:comment 'Catastrophe zone designation for the party\'s primary location. Used in CAT XL treaty cession eligibility, PML aggregation, and reinsurance bordereaux reporting.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clueIndicator rdf:type rdf:Property ;
    rdfs:label 'Clue Indicator' ;
    rdfs:comment 'Summary indicator of the party\'s CLUE loss history report result at time of segmentation. Influences underwriting tier and rate plan. CLUE is a LexisNexis product used in P&C underwriting.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentCode rdf:type rdf:Property ;
    rdfs:label 'Segment Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the segment classification (e.g., PERS_PREF, COMM_STD, HNW). Used in rating, underwriting appetite rules, and marketing targeting.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScoreBand rdf:type rdf:Property ;
    rdfs:label 'Credit Score Band' ;
    rdfs:comment 'Banded credit quality tier derived from the party\'s insurance credit score at time of segmentation. Used in personal lines rating and underwriting eligibility per state DOI rules.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionChannel rdf:type rdf:Property ;
    rdfs:label 'Distribution Channel' ;
    rdfs:comment 'Distribution channel through which the party was acquired or is primarily serviced. Influences commission schedules, marketing campaigns, and segment-level profitability analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeCountBand rdf:type rdf:Property ;
    rdfs:label 'Employee Count Band' ;
    rdfs:comment 'Banded employee headcount of the commercial party at time of segmentation. Relevant for WC, EPLI, and GL class plan assignment and underwriting appetite screening.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioBand rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Band' ;
    rdfs:comment 'Banded historical loss ratio for the party at time of segmentation. Derived from actuarial reserving data. Informs renewal pricing, tier migration, and non-renewal decisions.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketSegment rdf:type rdf:Property ;
    rdfs:label 'Market Segment' ;
    rdfs:comment 'Marketing-oriented segment grouping used for campaign targeting and distribution channel alignment. Distinct from underwriting tier; reflects revenue and growth strategy.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvrIndicator rdf:type rdf:Property ;
    rdfs:label 'Mvr Indicator' ;
    rdfs:comment 'Summary indicator of the party\'s MVR result at time of segmentation. Applicable for personal and commercial auto lines. Drives tier assignment and surcharge eligibility.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentName rdf:type rdf:Property ;
    rdfs:label 'Segment Name' ;
    rdfs:comment 'Human-readable name of the segment classification assigned to the party (e.g., Personal Lines Preferred, Commercial Lines Standard, High-Net-Worth).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyTypeAtAssignment rdf:type rdf:Property ;
    rdfs:label 'Party Type At Assignment' ;
    rdfs:comment 'Whether the party was classified as an individual (person) or organization at the time this segment was assigned. Supports personal vs. commercial lines segmentation logic.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCountBand rdf:type rdf:Property ;
    rdfs:label 'Policy Count Band' ;
    rdfs:comment 'Banded count of active policies held by the party at time of segmentation. Supports multi-policy discount eligibility, cross-sell targeting, and account rounding strategies.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredProgramCode rdf:type rdf:Property ;
    rdfs:label 'Preferred Program Code' ;
    rdfs:comment 'Code identifying the specific underwriting program or product tier the party qualifies for (e.g., HNW_PLATINUM, BOP_GOLD, PAP_PREFERRED). Links to rate plan and form set selection.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitabilityTier rdf:type rdf:Property ;
    rdfs:label 'Profitability Tier' ;
    rdfs:comment 'Actuarially derived profitability classification for the party based on historical loss ratio and expense ratio. Used in renewal underwriting decisions and retention strategy.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryClassification rdf:type rdf:Property ;
    rdfs:label 'Regulatory Classification' ;
    rdfs:comment 'Regulatory market classification applicable to the party\'s segment: admitted, non-admitted, surplus lines, or residual market. Drives statutory reporting and stamping office obligations.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueBand rdf:type rdf:Property ;
    rdfs:label 'Revenue Band' ;
    rdfs:comment 'Annual revenue band of the commercial party at time of segmentation. Used to classify commercial accounts into market segments and determine eligibility for BOP, CPP, or large-account programs.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Numeric risk score assigned to the party at the time of segmentation, derived from underwriting workbench scoring models. Higher values indicate higher risk. Range typically 0.0000–9999.9999.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentStatus rdf:type rdf:Property ;
    rdfs:label 'Segment Status' ;
    rdfs:comment 'Current lifecycle status of this segment assignment record: active (in force), inactive (expired), superseded (replaced by a newer assignment), or pending review.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentType rdf:type rdf:Property ;
    rdfs:label 'Segment Type' ;
    rdfs:comment 'Functional category of the segmentation: underwriting appetite, marketing targeting, billing tier, regulatory classification, or actuarial cohort. Determines which business process consumes this segment.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRef rdf:type rdf:Property ;
    rdfs:label 'Source System Ref' ;
    rdfs:comment 'Native identifier of this segment record in the originating source system. Enables reconciliation between the lakehouse silver layer and the operational system of record.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfDomicile rdf:type rdf:Property ;
    rdfs:label 'State Of Domicile' ;
    rdfs:comment 'Two-letter US state code of the party\'s primary domicile at time of segmentation. Drives state-specific underwriting rules, rate filings, and DOI regulatory compliance.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tivBand rdf:type rdf:Property ;
    rdfs:label 'Tiv Band' ;
    rdfs:comment 'Banded Total Insured Value of the party\'s insurable assets at time of segmentation. Used in property underwriting appetite, CAT exposure aggregation, and PML modeling.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwAppetiteFlag rdf:type rdf:Property ;
    rdfs:label 'Uw Appetite Flag' ;
    rdfs:comment 'Indicates whether this segment falls within the insurer\'s current underwriting appetite. True = in-appetite; False = out-of-appetite or restricted. Used in submission triage and eligibility screening.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearsAsCustomer rdf:type rdf:Property ;
    rdfs:label 'Years As Customer' ;
    rdfs:comment 'Number of complete years the party has been a policyholder with the insurer at time of segmentation. Used in loyalty-based pricing, NCB eligibility, and retention analytics.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeId rdf:type rdf:Property ;
    rdfs:label 'Fee Id' ;
    rdfs:comment 'Unique identifier for the fee record. Primary key.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalFeeId rdf:type rdf:Property ;
    rdfs:label 'Original Fee Id' ;
    rdfs:comment 'Foreign key to the original fee record that this record reverses, if this is a reversal transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fee .

ind:billingMethodCode rdf:type rdf:Property ;
    rdfs:label 'Billing Method Code' ;
    rdfs:comment 'Code indicating the billing method under which this fee is collected: direct bill, agency bill, list bill, or account current.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeDescription rdf:type rdf:Property ;
    rdfs:label 'Fee Description' ;
    rdfs:comment 'Detailed description of the fee, including the reason for assessment and any relevant context.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionBureauCode rdf:type rdf:Property ;
    rdfs:label 'Inspection Bureau Code' ;
    rdfs:comment 'Code identifying the inspection bureau to which inspection fees are remitted.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPlanCode rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Code' ;
    rdfs:comment 'Code identifying the payment plan under which this fee is assessed, relevant for installment fees.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundDate rdf:type rdf:Property ;
    rdfs:label 'Refund Date' ;
    rdfs:comment 'Date on which the fee was refunded, if applicable.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundReasonCode rdf:type rdf:Property ;
    rdfs:label 'Refund Reason Code' ;
    rdfs:comment 'Code indicating the reason the fee was refunded, if applicable.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundedFlag rdf:type rdf:Property ;
    rdfs:label 'Refunded Flag' ;
    rdfs:comment 'Indicates whether this fee was refunded to the policyholder. True if refunded, False otherwise.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remittanceDestinationCode rdf:type rdf:Property ;
    rdfs:label 'Remittance Destination Code' ;
    rdfs:comment 'Code indicating the entity to which this fee must be remitted: carrier, state Department of Insurance, surplus lines stamping office, inspection bureau, or third party.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittancePayeeName rdf:type rdf:Property ;
    rdfs:label 'Remittance Payee Name' ;
    rdfs:comment 'Name of the entity or organization to which the fee is remitted.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemFeeCode rdf:type rdf:Property ;
    rdfs:label 'Source System Fee Code' ;
    rdfs:comment 'Unique identifier for this fee in the source system, used for reconciliation and traceability.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesStampingOfficeCode rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Stamping Office Code' ;
    rdfs:comment 'Code identifying the surplus lines stamping office to which surplus lines fees are remitted.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxableFlag rdf:type rdf:Property ;
    rdfs:label 'Taxable Flag' ;
    rdfs:comment 'Indicates whether this fee is subject to sales tax or other levies. True if taxable, False otherwise.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverAuthorizedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Authorized By' ;
    rdfs:comment 'Name or identifier of the person who authorized the fee waiver.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverReasonCode rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason Code' ;
    rdfs:comment 'Code indicating the reason the fee was waived, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyInterestId rdf:type rdf:Property ;
    rdfs:label 'Policy Interest Id' ;
    rdfs:comment 'Unique identifier for the additional interest record. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyInterest .

ind:buildingId rdf:type rdf:Property ;
    rdfs:label 'Building Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.building. Business justification: Commercial property mortgagees and loss payees attach at building-level granularity for multi-building locations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Building .

ind:primaryPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Primary Policy Transaction Id' ;
    rdfs:comment 'Reference to the policy transaction that added this interest to the policy term.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:propertyRiskId rdf:type rdf:Property ;
    rdfs:label 'Property Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.property_risk. Business justification: Mortgagees, loss payees, and additional insureds attach to specific commercial properties for loss payment routing, subrogation waiver, and certificate issuance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PropertyRisk .

ind:vehicleId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.vehicle. Business justification: Lienholders and lessors attach to specific financed or leased vehicles for loss payee endorsements and total loss settlement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:blanketAdditionalInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Blanket Additional Insured Flag' ;
    rdfs:comment 'Indicates whether the interest is covered under a blanket additional insured endorsement.' ;
    rdfs:domain ind:PolicyInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Email address for the interest holder contact for certificate delivery and notifications.' ;
    rdfs:domain ind:PolicyInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the interest holder organization for policy and certificate matters.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Primary phone number for the interest holder contact.' ;
    rdfs:domain ind:PolicyInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageScope rdf:type rdf:Property ;
    rdfs:label 'Coverage Scope' ;
    rdfs:comment 'Description of the scope of coverage provided to the interest holder, including any limitations or conditions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementFormNumber rdf:type rdf:Property ;
    rdfs:label 'Endorsement Form Number' ;
    rdfs:comment 'ISO or carrier-specific form number of the endorsement that adds this interest to the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyInterestName rdf:type rdf:Property ;
    rdfs:label 'Policy Interest Name' ;
    rdfs:comment 'Full legal name of the party holding the interest as it appears on the policy or certificate.' ;
    rdfs:domain ind:PolicyInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Required Flag' ;
    rdfs:comment 'Indicates whether the interest holder must be notified of policy changes, cancellations, or non-renewals.' ;
    rdfs:domain ind:PolicyInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyInterestStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Interest Status' ;
    rdfs:comment 'Current lifecycle status of the interest on the policy.' ;
    rdfs:domain ind:PolicyInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryNoncontributoryFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Noncontributory Flag' ;
    rdfs:comment 'Indicates whether coverage is primary and non-contributory with respect to the interest holder\'s own insurance.' ;
    rdfs:domain ind:PolicyInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remarks rdf:type rdf:Property ;
    rdfs:label 'Remarks' ;
    rdfs:comment 'Free-form notes or special instructions related to the interest holder, coverage requirements, or certificate issuance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverOfSubrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Of Subrogation Flag' ;
    rdfs:comment 'Indicates whether the insurer has waived subrogation rights against the interest holder.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyTypeId rdf:type rdf:Property ;
    rdfs:label 'Policy Type Id' ;
    rdfs:comment 'Foreign key linking to policy.policy_type. Business justification: Policy.type (STRING) currently stores policy type codes inline. Normalizing to policy_type reference table eliminates redundancy and enables centralized management of policy type' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyType .

ind:agencyCode rdf:type rdf:Property ;
    rdfs:label 'Agency Code' ;
    rdfs:comment 'Identifier for the agency through which the policy was sold.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renew Flag' ;
    rdfs:comment 'Flag indicating whether the policy is set to automatically renew at expiration. True if auto-renew enabled.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindingDate rdf:type rdf:Property ;
    rdfs:label 'Binding Date' ;
    rdfs:comment 'Date the policy was bound and coverage became contractually obligated.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carrierCode rdf:type rdf:Property ;
    rdfs:label 'Carrier Code' ;
    rdfs:comment 'Identifier for the insurance carrier or legal entity issuing the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catZoneCode rdf:type rdf:Property ;
    rdfs:label 'Cat Zone Code' ;
    rdfs:comment 'Catastrophe zone code for exposure aggregation and PML modeling. Links to geography hierarchy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facultativeFlag rdf:type rdf:Property ;
    rdfs:label 'Facultative Flag' ;
    rdfs:comment 'Flag indicating whether facultative reinsurance was placed for this policy. True if facultative coverage exists.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formCode rdf:type rdf:Property ;
    rdfs:label 'Form Code' ;
    rdfs:comment 'ISO or proprietary form code identifying the base policy contract form.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inceptionDate rdf:type rdf:Property ;
    rdfs:label 'Inception Date' ;
    rdfs:comment 'Date the policy contract first becomes effective. Start of the initial term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonRenewalNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Non Renewal Notice Date' ;
    rdfs:comment 'Date non-renewal notice was sent to the policyholder, if applicable. Null if policy is renewing.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonRenewalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Non Renewal Reason Code' ;
    rdfs:comment 'Reason for non-renewal: underwriting decision, loss history, non-payment, program exit, or regulatory requirement.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Status' ;
    rdfs:comment 'Current lifecycle status of the policy contract. [ENUM-REF-CANDIDATE: draft|quoted|bound|in_force|cancelled|expired|non_renewed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Number' ;
    rdfs:comment 'Policy number of the prior term if this is a renewal or rewrite. Null for new business.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerCode rdf:type rdf:Property ;
    rdfs:label 'Producer Code' ;
    rdfs:comment 'Identifier for the producer (agent or broker) who sold the policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Internal program or product line identifier under which the policy is written.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteDate rdf:type rdf:Property ;
    rdfs:label 'Quote Date' ;
    rdfs:comment 'Date the initial quote was generated for this policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceTreatyCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Code' ;
    rdfs:comment 'Identifier for the reinsurance treaty under which this policy is ceded, if applicable.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalIndicator rdf:type rdf:Property ;
    rdfs:label 'Renewal Indicator' ;
    rdfs:comment 'Flag indicating whether this policy is a renewal of a prior term. True if renewal, false if new business.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termMonths rdf:type rdf:Property ;
    rdfs:label 'Term Months' ;
    rdfs:comment 'Length of the policy term in months. Typically 12 for annual policies, 6 for semi-annual.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyConditionId rdf:type rdf:Property ;
    rdfs:label 'Policy Condition Id' ;
    rdfs:comment 'Unique identifier for the policy condition record. Primary key.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyFormId rdf:type rdf:Property ;
    rdfs:label 'Policy Form Id' ;
    rdfs:comment 'Foreign key linking to policy.policy_form. Business justification: Policy conditions are documented in forms (e.g., protective safeguard warranty form ISO XX XX XX).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyForm .

ind:appliesToCoverageScope rdf:type rdf:Property ;
    rdfs:label 'Applies To Coverage Scope' ;
    rdfs:comment 'Scope of coverages to which this condition applies: all coverages on the term, specific coverage, named perils, or excluded perils.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachConsequence rdf:type rdf:Property ;
    rdfs:label 'Breach Consequence' ;
    rdfs:comment 'Consequence if the insured breaches this condition: coverage void, claim denial, premium adjustment, policy cancellation, or no consequence.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsHandlingInstruction rdf:type rdf:Property ;
    rdfs:label 'Claims Handling Instruction' ;
    rdfs:comment 'Special instructions for claims adjusters on how to handle claims when this condition is in force.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Required Flag' ;
    rdfs:comment 'Indicates whether the insured must actively comply with this condition for coverage to remain in force.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionCategory rdf:type rdf:Property ;
    rdfs:label 'Condition Category' ;
    rdfs:comment 'Business category grouping conditions by subject area: occupancy, protective device, construction, maintenance, operational, financial, reporting, or compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCode rdf:type rdf:Property ;
    rdfs:label 'Condition Code' ;
    rdfs:comment 'Standard code identifying the condition type, typically from ISO or carrier-specific library.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionDescription rdf:type rdf:Property ;
    rdfs:label 'Condition Description' ;
    rdfs:comment 'Plain-language summary of the condition for underwriting and claims reference.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionName rdf:type rdf:Property ;
    rdfs:label 'Condition Name' ;
    rdfs:comment 'Human-readable name of the condition or warranty attached to the policy term.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionStatus rdf:type rdf:Property ;
    rdfs:label 'Condition Status' ;
    rdfs:comment 'Current lifecycle status of the condition: active, suspended, removed, expired, or pending.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionText rdf:type rdf:Property ;
    rdfs:label 'Condition Text' ;
    rdfs:comment 'Full legal text of the condition or warranty as it appears on the policy declarations or endorsement.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionType rdf:type rdf:Property ;
    rdfs:label 'Condition Type' ;
    rdfs:comment 'Classification of the condition: general condition, warranty, protective safeguard, or special condition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Reference Number' ;
    rdfs:comment 'State DOI filing reference number for this condition form, if applicable.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Flag' ;
    rdfs:comment 'Indicates whether this condition is mandatory per regulatory or underwriting guidelines, or optional.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumCreditPercentage rdf:type rdf:Property ;
    rdfs:label 'Premium Credit Percentage' ;
    rdfs:comment 'Percentage premium credit applied if this condition is met, expressed as a decimal (e.g., 5.00 for 5 percent).' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Impact Flag' ;
    rdfs:comment 'Indicates whether compliance or non-compliance with this condition affects premium calculation.' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumSurchargePercentage rdf:type rdf:Property ;
    rdfs:label 'Premium Surcharge Percentage' ;
    rdfs:comment 'Percentage premium surcharge applied if this condition is not met, expressed as a decimal (e.g., 10.00 for 10 percent).' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateFiledFlag rdf:type rdf:Property ;
    rdfs:label 'State Filed Flag' ;
    rdfs:comment 'Indicates whether this condition form has been filed with and approved by the state Department of Insurance (DOI).' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationFrequency rdf:type rdf:Property ;
    rdfs:label 'Verification Frequency' ;
    rdfs:comment 'Frequency at which compliance verification is required: annual, semi-annual, quarterly, monthly, one-time, as-needed, or none. [ENUM-REF-CANDIDATE: annual|semi_annual|quarterly|monthly|one_time|as_needed|none — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:PolicyCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientPartyId rdf:type rdf:Property ;
    rdfs:label 'Recipient Party Id' ;
    rdfs:comment 'Foreign key to the party who is the intended recipient of this document (policyholder, named insured, additional insured, loss payee, etc.).' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:recipientPartyRoleId rdf:type rdf:Property ;
    rdfs:label 'Recipient Party Role Id' ;
    rdfs:comment 'Foreign key to the party role of the recipient at the time of document issuance.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Role .

ind:supersededDocumentPolicyDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Document Policy Document Id' ;
    rdfs:comment 'Foreign key to the prior document that this document replaces or supersedes, if applicable.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyDocument .

ind:documentTemplateId rdf:type rdf:Property ;
    rdfs:label 'Document Template Id' ;
    rdfs:comment 'Identifier of the document template used to generate this document in the document management system.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DocumentTemplate .

ind:deliveryConfirmationFlag rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Flag' ;
    rdfs:comment 'Indicates whether delivery confirmation was received from the recipient (True) or not (False).' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryConfirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Timestamp' ;
    rdfs:comment 'Date and time when delivery confirmation was received, if applicable.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:generationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Generation Timestamp' ;
    rdfs:comment 'Date and time when the document was generated by the policy administration or document management system.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:hash rdf:type rdf:Property ;
    rdfs:label 'Hash' ;
    rdfs:comment 'Cryptographic hash (e.g., SHA-256) of the document file for integrity verification and tamper detection.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Recipient Address Line1' ;
    rdfs:comment 'First line of the mailing address to which the document was sent.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Recipient Address Line2' ;
    rdfs:comment 'Second line of the mailing address (suite, apartment, etc.).' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientCity rdf:type rdf:Property ;
    rdfs:label 'Recipient City' ;
    rdfs:comment 'City of the recipient mailing address.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientCountryCode rdf:type rdf:Property ;
    rdfs:label 'Recipient Country Code' ;
    rdfs:comment 'Three-letter ISO country code of the recipient mailing address.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientEmail rdf:type rdf:Property ;
    rdfs:label 'Recipient Email' ;
    rdfs:comment 'Email address to which the document was sent, if delivered electronically.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientName rdf:type rdf:Property ;
    rdfs:label 'Recipient Name' ;
    rdfs:comment 'Name of the recipient as it appears on the document for delivery purposes.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientPostalCode rdf:type rdf:Property ;
    rdfs:label 'Recipient Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the recipient mailing address.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientStateCode rdf:type rdf:Property ;
    rdfs:label 'Recipient State Code' ;
    rdfs:comment 'Two-letter state or province code of the recipient mailing address.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageLocationUri rdf:type rdf:Property ;
    rdfs:label 'Storage Location Uri' ;
    rdfs:comment 'URI or path to the document file in the document management system or content repository.' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidFlag rdf:type rdf:Property ;
    rdfs:label 'Void Flag' ;
    rdfs:comment 'Indicates whether this document has been voided and is no longer valid (True) or remains valid (False).' ;
    rdfs:domain ind:PolicyDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voidReasonCode rdf:type rdf:Property ;
    rdfs:label 'Void Reason Code' ;
    rdfs:comment 'Code indicating the reason the document was voided (e.g., error, reissue, policy cancellation).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acordFormFlag rdf:type rdf:Property ;
    rdfs:label 'Acord Form Flag' ;
    rdfs:comment 'Indicates whether this is a standard ACORD form (true) or not (false).' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Attachment Reason Code' ;
    rdfs:comment 'Coded reason for attaching this form: regulatory requirement, risk mitigation, customer request, underwriting referral, rate modification, or coverage enhancement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attachmentSequence rdf:type rdf:Property ;
    rdfs:label 'Attachment Sequence' ;
    rdfs:comment 'The order in which this form is attached to the policy term, used for precedence and document assembly.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formCategory rdf:type rdf:Property ;
    rdfs:label 'Form Category' ;
    rdfs:comment 'High-level category of the form indicating the major coverage area it addresses. [ENUM-REF-CANDIDATE: coverage|liability|property|auto|workers_comp|umbrella|inland_marine|crime|professional_liability — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formDescription rdf:type rdf:Property ;
    rdfs:label 'Form Description' ;
    rdfs:comment 'Detailed description of the coverage, exclusion, or condition provided by this form.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formName rdf:type rdf:Property ;
    rdfs:label 'Form Name' ;
    rdfs:comment 'The full descriptive name of the form (e.g., Homeowners 3 Special Form, Commercial General Liability Coverage Form).' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formStatus rdf:type rdf:Property ;
    rdfs:label 'Form Status' ;
    rdfs:comment 'Current status of the form attachment: active, superseded by a newer edition, withdrawn, or pending approval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formType rdf:type rdf:Property ;
    rdfs:label 'Form Type' ;
    rdfs:comment 'Classification of the form: base policy form, endorsement, exclusion, condition, declaration page, schedule, or certificate of insurance. [ENUM-REF-CANDIDATE: base|endorsement|exclusion|condition|declaration|schedule|certificate — 7 candidates stripped' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoFormFlag rdf:type rdf:Property ;
    rdfs:label 'Iso Form Flag' ;
    rdfs:comment 'Indicates whether this is a standard ISO form (true) or a carrier-proprietary form (false).' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByFormNumber rdf:type rdf:Property ;
    rdfs:label 'Superseded By Form Number' ;
    rdfs:comment 'The form number that supersedes this form, if the form has been replaced by a newer edition.' ;
    rdfs:domain ind:PolicyForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineId rdf:type rdf:Property ;
    rdfs:label 'Line Id' ;
    rdfs:comment 'Primary key for line' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:endorsementsAttached rdf:type rdf:Property ;
    rdfs:label 'Endorsements Attached' ;
    rdfs:comment 'Comma-separated list of endorsement form numbers modifying coverage for this line of business.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experienceModFactor rdf:type rdf:Property ;
    rdfs:label 'Experience Mod Factor' ;
    rdfs:comment 'Experience modification factor applied to adjust premium based on the insureds historical loss experience. Common in Workers Compensation and Commercial Auto.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:formsAttached rdf:type rdf:Property ;
    rdfs:label 'Forms Attached' ;
    rdfs:comment 'Comma-separated list of ISO or proprietary form numbers attached to this line of business.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Lob Effective Date' ;
    rdfs:comment 'Date when this line of business coverage becomes effective within the policy term.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lobExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Lob Expiration Date' ;
    rdfs:comment 'Date when this line of business coverage expires within the policy term.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lobStatus rdf:type rdf:Property ;
    rdfs:label 'Lob Status' ;
    rdfs:comment 'Current lifecycle status of this line of business within the policy term.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioTarget rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Target' ;
    rdfs:comment 'Target loss ratio for this line of business used in pricing and profitability analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicLobCode rdf:type rdf:Property ;
    rdfs:label 'Naic Lob Code' ;
    rdfs:comment 'NAIC statutory reporting code for the line of business used in Schedule P and statutory financial statements.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Package Discount Percentage' ;
    rdfs:comment 'Discount percentage applied to this line of business when written as part of a package policy.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Descriptive name of the program or product offering.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBasis rdf:type rdf:Property ;
    rdfs:label 'Rate Basis' ;
    rdfs:comment 'Unit of measure used as the basis for premium rating. Examples: per $1000 of coverage, per vehicle, per employee, per square foot.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateFactor rdf:type rdf:Property ;
    rdfs:label 'Rate Factor' ;
    rdfs:comment 'Base rate factor applied to the rate basis to calculate premium for this line of business.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCreditPercentage rdf:type rdf:Property ;
    rdfs:label 'Schedule Credit Percentage' ;
    rdfs:comment 'Underwriter-applied schedule credit percentage for this line of business based on risk characteristics.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleDebitPercentage rdf:type rdf:Property ;
    rdfs:label 'Schedule Debit Percentage' ;
    rdfs:comment 'Underwriter-applied schedule debit percentage for this line of business based on adverse risk characteristics.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subLineCode rdf:type rdf:Property ;
    rdfs:label 'Sub Line Code' ;
    rdfs:comment 'Sub-line or product variant code within the primary line of business for granular classification.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subLineName rdf:type rdf:Property ;
    rdfs:label 'Sub Line Name' ;
    rdfs:comment 'Descriptive name of the sub-line or product variant.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tivCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Tiv Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the total insured value amount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalInsuredValueAmount rdf:type rdf:Property ;
    rdfs:label 'Total Insured Value Amount' ;
    rdfs:comment 'Total insured value or sum insured for all risks covered under this line of business. Used for catastrophe exposure aggregation and PML modeling.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyProducerId rdf:type rdf:Property ;
    rdfs:label 'Policy Producer Id' ;
    rdfs:comment 'Unique identifier for the policy producer association record.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appointmentDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Date' ;
    rdfs:comment 'Date the producer was appointed by the carrier to sell this line of business.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Status' ;
    rdfs:comment 'Current status of the producers appointment with the carrier for this policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionPlanCode rdf:type rdf:Property ;
    rdfs:label 'Commission Plan Code' ;
    rdfs:comment 'Code identifying the commission schedule or plan applied to this producer for this policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentCommissionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Eligible Flag' ;
    rdfs:comment 'Indicates whether this producer is eligible for contingent or profit-sharing commission on this policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eoCoverageVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Verified Flag' ;
    rdfs:comment 'Indicates whether the producers E&O insurance coverage has been verified for this policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eoExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Eo Expiration Date' ;
    rdfs:comment 'Expiration date of the producers E&O insurance coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eoPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Eo Policy Number' ;
    rdfs:comment 'Policy number of the producers E&O insurance coverage on file.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobAuthority rdf:type rdf:Property ;
    rdfs:label 'Lob Authority' ;
    rdfs:comment 'Specific lines of business the producer is authorized to write under this association.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofRecordFlag rdf:type rdf:Property ;
    rdfs:label 'Of Record Flag' ;
    rdfs:comment 'Indicates whether this producer is the official producer of record for the policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideRate rdf:type rdf:Property ;
    rdfs:label 'Override Rate' ;
    rdfs:comment 'Additional override commission rate for managing general agents or agency principals.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:producerTier rdf:type rdf:Property ;
    rdfs:label 'Producer Tier' ;
    rdfs:comment 'Performance tier classification affecting commission rates and incentives.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleType rdf:type rdf:Property ;
    rdfs:label 'Role Type' ;
    rdfs:comment 'Classification of the producers role on this policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicingOfficeCode rdf:type rdf:Property ;
    rdfs:label 'Servicing Office Code' ;
    rdfs:comment 'Internal code identifying the carrier office or region servicing this producer relationship.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicingRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Servicing Rights Flag' ;
    rdfs:comment 'Indicates whether this producer retains servicing rights for the policy.' ;
    rdfs:domain ind:PolicyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:writingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Writing Company Code' ;
    rdfs:comment 'NAIC company code of the carrier entity this producer represents for this policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPriorTransactionPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Primary Prior Transaction Policy Transaction Id' ;
    rdfs:comment 'Reference to the immediately preceding transaction in the policy lifecycle. Enables transaction chain reconstruction.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:accountingDate rdf:type rdf:Property ;
    rdfs:label 'Accounting Date' ;
    rdfs:comment 'Date when the transaction is recognized for accounting and statutory reporting purposes. May differ from effective and processed dates.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationBasis rdf:type rdf:Property ;
    rdfs:label 'Cancellation Basis' ;
    rdfs:comment 'Legal or business basis for cancellation. Determines regulatory notice requirements and return premium method. Null for non-cancellation transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Impact Amount' ;
    rdfs:comment 'Net change in producer commission resulting from this transaction. Used for commission settlement and payables.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'Reference to the generated policy document, declarations page, or endorsement form associated with this transaction.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementDescription rdf:type rdf:Property ;
    rdfs:label 'Endorsement Description' ;
    rdfs:comment 'Business description of the endorsement changes. Summarizes coverage, limit, or risk modifications. Null for non-endorsement transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBackdatedFlag rdf:type rdf:Property ;
    rdfs:label 'Is Backdated Flag' ;
    rdfs:comment 'Indicates whether the effective date is prior to the processed date. Used for audit and compliance monitoring.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMidtermFlag rdf:type rdf:Property ;
    rdfs:label 'Is Midterm Flag' ;
    rdfs:comment 'Indicates whether this transaction occurred mid-term (between policy inception and expiration). True for endorsements, cancellations, reinstatements.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Is Renewal Flag' ;
    rdfs:comment 'Indicates whether this transaction represents a policy renewal. True for REN transaction type, false otherwise.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issued Timestamp' ;
    rdfs:comment 'Date and time when the transaction was issued and documents were generated. Marks final commitment.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processedDate rdf:type rdf:Property ;
    rdfs:label 'Processed Date' ;
    rdfs:comment 'Date when the transaction was processed and recorded in the system. May differ from effective date.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryFilingDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Date' ;
    rdfs:comment 'Date when regulatory filing was submitted. Null if no filing required or not yet filed.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryFilingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required Flag' ;
    rdfs:comment 'Indicates whether this transaction requires filing with state Department of Insurance or other regulatory body.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementLapseDays rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Lapse Days' ;
    rdfs:comment 'Number of days the policy was lapsed before reinstatement. Used for underwriting and pricing adjustments. Null for non-reinstatement transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsuranceCessionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Required Flag' ;
    rdfs:comment 'Indicates whether this transaction triggers reinsurance cession under treaty or facultative agreements.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresUnderwritingReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Underwriting Review Flag' ;
    rdfs:comment 'Indicates whether this transaction triggered underwriting referral or manual review based on risk appetite rules.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceTransactionId rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Id' ;
    rdfs:comment 'Original transaction identifier from the source system. Enables traceability back to operational system of record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumTransaction .

ind:voidedReasonCode rdf:type rdf:Property ;
    rdfs:label 'Voided Reason Code' ;
    rdfs:comment 'Standardized code indicating why the transaction was voided. Null for active transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Voided Timestamp' ;
    rdfs:comment 'Date and time when the transaction was voided or reversed. Null for active transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:writtenPremiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Written Premium Change Amount' ;
    rdfs:comment 'Net change in written premium resulting from this transaction. Positive for increases, negative for returns. Used for premium accounting and statutory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Cancellation Allowed Flag' ;
    rdfs:comment 'Indicates whether policies of this type can be cancelled mid-term by the insurer or insured.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catExposureFlag rdf:type rdf:Property ;
    rdfs:label 'Cat Exposure Flag' ;
    rdfs:comment 'Indicates whether policies of this type carry catastrophe exposure requiring CAT modeling and aggregation.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageBasis rdf:type rdf:Property ;
    rdfs:label 'Coverage Basis' ;
    rdfs:comment 'Trigger basis for coverage (Occurrence, Claims-Made, Claims-Made and Reported). Determines when a loss must occur or be reported to be covered.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Deductible Required Flag' ;
    rdfs:comment 'Indicates whether a deductible is required for policies of this type.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endorsementAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Endorsement Allowed Flag' ;
    rdfs:comment 'Indicates whether mid-term endorsements are allowed for this policy type.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoProgramCode rdf:type rdf:Property ;
    rdfs:label 'Iso Program Code' ;
    rdfs:comment 'ISO program identifier for standardized forms and rating (e.g., HO for Homeowners, CA for Commercial Auto).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Limit Required Flag' ;
    rdfs:comment 'Indicates whether coverage limits must be specified for policies of this type.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lobCategory rdf:type rdf:Property ;
    rdfs:label 'Lob Category' ;
    rdfs:comment 'High-level line of business category for the policy type (Property, Casualty, Liability, Auto, Workers Compensation, Specialty).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monolinePackageIndicator rdf:type rdf:Property ;
    rdfs:label 'Monoline Package Indicator' ;
    rdfs:comment 'Indicates whether the policy type is a monoline (single coverage) or package (multiple coverages bundled) policy.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalCommercialFlag rdf:type rdf:Property ;
    rdfs:label 'Personal Commercial Flag' ;
    rdfs:comment 'Indicates whether the policy type is for personal lines or commercial lines business.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyTermLengthMonths rdf:type rdf:Property ;
    rdfs:label 'Policy Term Length Months' ;
    rdfs:comment 'Standard term length in months for this policy type (e.g., 12 for annual, 6 for semi-annual).' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyTypeStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Type Status' ;
    rdfs:comment 'Current lifecycle status of the policy type. Active types are available for new business.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerCommissionScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Producer Commission Schedule Code' ;
    rdfs:comment 'Default commission schedule code for producers selling this policy type.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAlgorithmVersion rdf:type rdf:Property ;
    rdfs:label 'Rating Algorithm Version' ;
    rdfs:comment 'Version identifier of the rating algorithm or pricing model used for this policy type.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Allowed Flag' ;
    rdfs:comment 'Indicates whether cancelled policies of this type can be reinstated within a grace period.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Eligible Flag' ;
    rdfs:comment 'Indicates whether policies of this type are eligible for reinsurance cession under treaty or facultative agreements.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Eligible Flag' ;
    rdfs:comment 'Indicates whether policies of this type are eligible for renewal. False for non-renewable policy types.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAppetiteScore rdf:type rdf:Property ;
    rdfs:label 'Risk Appetite Score' ;
    rdfs:comment 'Numeric score representing the companys risk appetite for this policy type (0-100 scale). Higher scores indicate greater appetite.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateFilingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'State Filing Required Flag' ;
    rdfs:comment 'Indicates whether rates and forms for this policy type require state Department of Insurance filing and approval.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetLossRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Target Loss Ratio Percent' ;
    rdfs:comment 'Target loss ratio percentage for this policy type, used for pricing and profitability analysis.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:typeDescription rdf:type rdf:Property ;
    rdfs:label 'Type Description' ;
    rdfs:comment 'Detailed description of the policy type, including coverage scope, target market, and key features.' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeName rdf:type rdf:Property ;
    rdfs:label 'Type Name' ;
    rdfs:comment 'Full business name of the policy type (e.g., Homeowners Special Form, Personal Auto Policy, Business Owners Policy).' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingTierCount rdf:type rdf:Property ;
    rdfs:label 'Underwriting Tier Count' ;
    rdfs:comment 'Number of underwriting tiers or risk classes available for this policy type (e.g., Preferred, Standard, Non-Standard).' ;
    rdfs:domain ind:PolicyType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyholderPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Policyholder Policy Transaction Id' ;
    rdfs:comment 'Reference to the policy transaction that added this policyholder to the policy.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:policyholderRemovedByTransactionPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Policyholder Removed By Transaction Policy Transaction Id' ;
    rdfs:comment 'Reference to the policy transaction that removed this policyholder from the policy. Null if still active.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:additionalInsuredEndorsementCode rdf:type rdf:Property ;
    rdfs:label 'Additional Insured Endorsement Code' ;
    rdfs:comment 'ISO or carrier-specific endorsement form code granting additional insured status to this party.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingResponsibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Responsibility Flag' ;
    rdfs:comment 'Indicates whether this policyholder is responsible for premium payment. True if responsible, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Flag' ;
    rdfs:comment 'Indicates whether this party should receive a Certificate of Insurance. True if certificate holder, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holderSequence rdf:type rdf:Property ;
    rdfs:label 'Holder Sequence' ;
    rdfs:comment 'Ordinal position of this policyholder within the policy, used for display and reporting order.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holderType rdf:type rdf:Property ;
    rdfs:label 'Holder Type' ;
    rdfs:comment 'Classification of the policyholder role on the policy contract.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryInsured rdf:type rdf:Property ;
    rdfs:label 'Is Primary Insured' ;
    rdfs:comment 'Indicates whether this party is the primary named insured on the policy. True if primary, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailingAddressSameAsPrimaryFlag rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Same As Primary Flag' ;
    rdfs:comment 'Indicates whether this policyholder uses the same mailing address as the primary insured. True if same, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notice Required Flag' ;
    rdfs:comment 'Indicates whether this party must receive policy notices such as cancellation or non-renewal. True if required, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyholderStatus rdf:type rdf:Property ;
    rdfs:label 'Policyholder Status' ;
    rdfs:comment 'Current lifecycle status of this policyholder association on the policy contract.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToPrimary rdf:type rdf:Property ;
    rdfs:label 'Relationship To Primary' ;
    rdfs:comment 'Nature of the relationship between this policyholder and the primary named insured. [ENUM-REF-CANDIDATE: Spouse|Domestic Partner|Child|Parent|Sibling|Business Partner|Landlord|Tenant|Contractor|Vendor|Other — 11 candidates stripped; promote to reference' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceLinkId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Link Id' ;
    rdfs:comment 'Unique identifier for the reinsurance link record. One row per reinsurance placement per policy term.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsurerId rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Id' ;
    rdfs:comment 'Foreign key to the primary reinsurer for this placement. For multi-reinsurer placements, see ri_participant table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reinsurer .

ind:aggregateDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Deductible Amount' ;
    rdfs:comment 'Aggregate deductible amount the ceding company must retain before reinsurance applies on an aggregate basis.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizedFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is authorized or admitted in the ceding companys domicile state. Affects statutory credit treatment.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bordereauxFrequency rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Frequency' ;
    rdfs:comment 'Frequency at which bordereaux reports must be submitted to the reinsurer for this placement.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Limit Amount' ;
    rdfs:comment 'Maximum limit amount ceded to reinsurance under this placement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionBasis rdf:type rdf:Property ;
    rdfs:label 'Cession Basis' ;
    rdfs:comment 'Basis on which the policy is ceded to reinsurance: risk attaching, loss occurring, or claims made.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Amount' ;
    rdfs:comment 'Amount of collateral posted by the reinsurer for this placement, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Required Flag' ;
    rdfs:comment 'Indicates whether collateral is required from the reinsurer to receive statutory credit for this placement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionPercentage rdf:type rdf:Property ;
    rdfs:label 'Commission Percentage' ;
    rdfs:comment 'Commission percentage paid by the reinsurer to the ceding company. Applicable to proportional treaties.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commutationDate rdf:type rdf:Property ;
    rdfs:label 'Commutation Date' ;
    rdfs:comment 'Date when the reinsurance agreement was commuted, if applicable. Commutation is the final settlement of all obligations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hoursClause rdf:type rdf:Property ;
    rdfs:label 'Hours Clause' ;
    rdfs:comment 'Number of hours defining a single catastrophe event for aggregation purposes. Common values are 72 or 168 hours.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossCorridorFlag rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Flag' ;
    rdfs:comment 'Indicates whether the treaty includes a loss corridor where the ceding company retains a portion of losses within a specified range.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:placementDate rdf:type rdf:Property ;
    rdfs:label 'Placement Date' ;
    rdfs:comment 'Date when the reinsurance placement was bound or executed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:placementStatus rdf:type rdf:Property ;
    rdfs:label 'Placement Status' ;
    rdfs:comment 'Current status of the reinsurance placement: pending, bound, active, expired, cancelled, or commuted.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementType rdf:type rdf:Property ;
    rdfs:label 'Placement Type' ;
    rdfs:comment 'Type of reinsurance placement: treaty, facultative, or hybrid combination.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCommissionPercentage rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Percentage' ;
    rdfs:comment 'Profit commission percentage paid by the reinsurer based on favorable loss experience.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremiumPercentage rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Percentage' ;
    rdfs:comment 'Percentage of the original premium charged for each reinstatement of the reinsurance limit.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Provision Flag' ;
    rdfs:comment 'Indicates whether the treaty includes reinstatement provisions allowing the limit to be restored after a loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceLayerNumber rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Layer Number' ;
    rdfs:comment 'Sequential layer number when multiple reinsurance layers apply to the same policy term.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsurerSharePercentage rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Share Percentage' ;
    rdfs:comment 'Percentage of the ceded risk assumed by the primary reinsurer. For multi-reinsurer placements, see ri_participant table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementFrequency rdf:type rdf:Property ;
    rdfs:label 'Settlement Frequency' ;
    rdfs:comment 'Frequency at which premium and loss settlements occur between the ceding company and reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slidingScaleFlag rdf:type rdf:Property ;
    rdfs:label 'Sliding Scale Flag' ;
    rdfs:comment 'Indicates whether the commission rate varies based on loss ratio under a sliding scale arrangement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:territorialScope rdf:type rdf:Property ;
    rdfs:label 'Territorial Scope' ;
    rdfs:comment 'Geographic scope of the reinsurance coverage. May specify countries, states, or regions covered.' ;
    rdfs:domain ind:ReinsuranceLink ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateRegId rdf:type rdf:Property ;
    rdfs:label 'State Reg Id' ;
    rdfs:comment 'Unique identifier for the state regulatory record. Primary key.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:admittedStatus rdf:type rdf:Property ;
    rdfs:label 'Admitted Status' ;
    rdfs:comment 'Indicates whether the policy is written on an admitted or surplus lines basis in this state.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedRiskPoolIndicator rdf:type rdf:Property ;
    rdfs:label 'Assigned Risk Pool Indicator' ;
    rdfs:comment 'Indicates whether this policy is written through a state-mandated assigned risk pool or residual market mechanism.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignedRiskPoolName rdf:type rdf:Property ;
    rdfs:label 'Assigned Risk Pool Name' ;
    rdfs:comment 'Name of the assigned risk pool or residual market facility through which the policy is written.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Free-text notes regarding regulatory compliance issues, exceptions, or special handling for this policy.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Date' ;
    rdfs:comment 'Date of the most recent regulatory compliance review for this policy.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doiFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Doi Filing Number' ;
    rdfs:comment 'State Department of Insurance filing or approval number for the policy form or rate filing.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fairPlanIndicator rdf:type rdf:Property ;
    rdfs:label 'Fair Plan Indicator' ;
    rdfs:comment 'Indicates whether this policy is written through a state FAIR plan for high-risk properties.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fairPlanName rdf:type rdf:Property ;
    rdfs:label 'Fair Plan Name' ;
    rdfs:comment 'Name of the FAIR plan facility through which the policy is written, if applicable.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialResponsibilityFilingDate rdf:type rdf:Property ;
    rdfs:label 'Financial Responsibility Filing Date' ;
    rdfs:comment 'Date the financial responsibility filing was submitted to the state.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialResponsibilityFilingIndicator rdf:type rdf:Property ;
    rdfs:label 'Financial Responsibility Filing Indicator' ;
    rdfs:comment 'Indicates whether a financial responsibility filing (e.g., SR-22, FR-44) is required for this policy.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialResponsibilityFilingType rdf:type rdf:Property ;
    rdfs:label 'Financial Responsibility Filing Type' ;
    rdfs:comment 'Type of financial responsibility filing required by the state (e.g., SR-22, FR-44).' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guarantyFundAssessmentAmount rdf:type rdf:Property ;
    rdfs:label 'Guaranty Fund Assessment Amount' ;
    rdfs:comment 'Total state guaranty fund assessment collected for this policy, in USD.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guarantyFundAssessmentRate rdf:type rdf:Property ;
    rdfs:label 'Guaranty Fund Assessment Rate' ;
    rdfs:comment 'State guaranty fund assessment rate applicable to this policy, expressed as a decimal.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumLiabilityLimitRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Liability Limit Required' ;
    rdfs:comment 'State-mandated minimum liability limit required for this line of business, in USD.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:municipalTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Municipal Tax Amount' ;
    rdfs:comment 'Total municipal or local premium tax amount collected for this policy, in USD.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:municipalTaxRate rdf:type rdf:Property ;
    rdfs:label 'Municipal Tax Rate' ;
    rdfs:comment 'Municipal or local premium tax rate applicable to this policy, expressed as a decimal.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicLineOfBusinessCode rdf:type rdf:Property ;
    rdfs:label 'Naic Line Of Business Code' ;
    rdfs:comment 'NAIC line of business code for statutory reporting classification of this policy.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Status' ;
    rdfs:comment 'Current compliance status of this policy with state regulatory requirements.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stampingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Stamping Fee Amount' ;
    rdfs:comment 'Fee charged by the stamping office for processing the surplus lines filing, in USD.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stampingOfficeFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Stamping Office Filing Number' ;
    rdfs:comment 'Filing or stamp number assigned by the surplus lines stamping office for this policy.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFormNumber rdf:type rdf:Property ;
    rdfs:label 'State Form Number' ;
    rdfs:comment 'State-specific policy form number or edition approved for use in this jurisdiction.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMandatedCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'State Mandated Coverage Indicator' ;
    rdfs:comment 'Indicates whether this policy includes state-mandated coverage requirements specific to this jurisdiction.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateMandatedCoverageList rdf:type rdf:Property ;
    rdfs:label 'State Mandated Coverage List' ;
    rdfs:comment 'Comma-separated list of state-mandated coverages included in this policy (e.g., uninsured motorist, personal injury protection).' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateReportingCode rdf:type rdf:Property ;
    rdfs:label 'State Reporting Code' ;
    rdfs:comment 'State-specific reporting code used for statutory financial reporting and NAIC Annual Statement preparation.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecificEndorsementList rdf:type rdf:Property ;
    rdfs:label 'State Specific Endorsement List' ;
    rdfs:comment 'Comma-separated list of state-specific endorsements attached to this policy.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateTaxAmount rdf:type rdf:Property ;
    rdfs:label 'State Tax Amount' ;
    rdfs:comment 'Total state premium tax amount collected for this policy, in USD.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateTaxRate rdf:type rdf:Property ;
    rdfs:label 'State Tax Rate' ;
    rdfs:comment 'State premium tax rate applicable to this policy, expressed as a decimal (e.g., 0.0250 for 2.5%).' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surplusLinesStampingOffice rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Stamping Office' ;
    rdfs:comment 'Name of the surplus lines stamping office or service office that processed the filing, if applicable.' ;
    rdfs:domain ind:StateReg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termId rdf:type rdf:Property ;
    rdfs:label 'Term Id' ;
    rdfs:comment 'Unique identifier for the policy term. Primary key. One row per policy per term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Term .

ind:calendarId rdf:type rdf:Property ;
    rdfs:label 'Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Policy terms must map to accounting periods for premium earning calculations, reserve valuations, and GAAP/SAP financial statement preparation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:priorTermId rdf:type rdf:Property ;
    rdfs:label 'Prior Term Id' ;
    rdfs:comment 'Foreign key to the immediately preceding term. Null for new business, populated for renewals.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Term .

ind:boundDate rdf:type rdf:Property ;
    rdfs:label 'Bound Date' ;
    rdfs:comment 'Date when the term was bound and coverage became contractually effective.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationType rdf:type rdf:Property ;
    rdfs:label 'Cancellation Type' ;
    rdfs:comment 'Type of cancellation determining premium return calculation. Flat, short-rate, or pro-rata.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationDays rdf:type rdf:Property ;
    rdfs:label 'Duration Days' ;
    rdfs:comment 'Number of days between term effective and expiration dates. Typically 365 for annual policies.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isRenewal rdf:type rdf:Property ;
    rdfs:label 'Is Renewal' ;
    rdfs:comment 'Indicates whether this term is a renewal of a prior term. False for new business, true for renewals.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Effective Date' ;
    rdfs:comment 'Effective date of the rate table used to price this term. Required for regulatory rate filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateVersion rdf:type rdf:Property ;
    rdfs:label 'Rate Version' ;
    rdfs:comment 'Version identifier of the rating algorithm used to price this term. Enables rate change analysis.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalAcceptedDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Accepted Date' ;
    rdfs:comment 'Date when the insured accepted the renewal offer. Null if renewal was not accepted.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalOfferDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Offer Date' ;
    rdfs:comment 'Date when renewal offer was extended to the insured. Used for renewal cycle tracking.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalType rdf:type rdf:Property ;
    rdfs:label 'Renewal Type' ;
    rdfs:comment 'Classification of the renewal process. Indicates whether renewal was automatic, manual, or conditional.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termStatus rdf:type rdf:Property ;
    rdfs:label 'Term Status' ;
    rdfs:comment 'Current lifecycle status of the policy term. Indicates whether the term is active, expired, or cancelled.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Underwriting Company Code' ;
    rdfs:comment 'NAIC company code of the insurer underwriting this term. Used for statutory reporting.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingCompanyName rdf:type rdf:Property ;
    rdfs:label 'Underwriting Company Name' ;
    rdfs:comment 'Legal name of the insurance company underwriting this term.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bearingCoverageId rdf:type rdf:Property ;
    rdfs:label 'Bearing Coverage Id' ;
    rdfs:comment 'Unique identifier for the bearing coverage allocation record. Primary key.' ;
    rdfs:domain ind:BearingCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalBearingCoverageId rdf:type rdf:Property ;
    rdfs:label 'Original Bearing Coverage Id' ;
    rdfs:comment 'Foreign key to the original bearing coverage record that this record reverses or adjusts.' ;
    rdfs:domain ind:BearingCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BearingCoverage .

ind:allocationBasis rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis' ;
    rdfs:comment 'Basis for premium allocation: Total Insured Value (TIV), exposure units, coverage limit, rate, or manual entry.' ;
    rdfs:domain ind:BearingCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationSequence rdf:type rdf:Property ;
    rdfs:label 'Allocation Sequence' ;
    rdfs:comment 'Sequence number for ordering multiple coverage allocations within a single premium transaction.' ;
    rdfs:domain ind:BearingCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationType rdf:type rdf:Property ;
    rdfs:label 'Allocation Type' ;
    rdfs:comment 'Method used to allocate premium to this coverage: direct assignment, proportional split, specific calculation, manual override, or system-calculated.' ;
    rdfs:domain ind:BearingCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCeded rdf:type rdf:Property ;
    rdfs:label 'Is Ceded' ;
    rdfs:comment 'Indicates whether this allocated premium is subject to reinsurance cession (true) or retained net (false).' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCommissionable rdf:type rdf:Property ;
    rdfs:label 'Is Commissionable' ;
    rdfs:comment 'Indicates whether this allocated premium is subject to producer commission (true) or non-commissionable (false).' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskType rdf:type rdf:Property ;
    rdfs:label 'Risk Type' ;
    rdfs:comment 'Type of insured risk this allocation applies to: property, auto, liability, workers compensation, umbrella, inland marine, or other. [ENUM-REF-CANDIDATE: property|auto|liability|workers_comp|umbrella|inland_marine|other — 7 candidates stripped; promote to' ;
    rdfs:domain ind:BearingCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statutoryLineCode rdf:type rdf:Property ;
    rdfs:label 'Statutory Line Code' ;
    rdfs:comment 'NAIC statutory line of business code for regulatory reporting and Schedule P classification.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionBookingDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Booking Date' ;
    rdfs:comment 'Date on which this bearing coverage allocation was booked in the financial system.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cededPremiumId rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Id' ;
    rdfs:comment 'Unique identifier for the ceded premium transaction record. Primary key.' ;
    rdfs:domain ind:CededPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalCededPremiumId rdf:type rdf:Property ;
    rdfs:label 'Original Ceded Premium Id' ;
    rdfs:comment 'Reference to the original ceded premium transaction if this is a reversal or adjustment.' ;
    rdfs:domain ind:CededPremium ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CededPremium .

ind:ratingWorksheetId rdf:type rdf:Property ;
    rdfs:label 'Rating Worksheet Id' ;
    rdfs:comment 'Foreign key linking to coverage.rating_worksheet. Business justification: Ceded premium calculations reference rating worksheets to determine cession basis, validate treaty attachment points, and support reinsurance bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RatingWorksheet .

ind:bordereauxSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Submission Date' ;
    rdfs:comment 'Date on which the bordereaux report containing this ceded premium was submitted to the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cededEarnedPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Earned Premium' ;
    rdfs:comment 'Amount of earned premium ceded to the reinsurer, recognized over the coverage period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededUnearnedPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Unearned Premium' ;
    rdfs:comment 'Amount of unearned premium ceded to the reinsurer, representing future coverage obligation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Written Premium' ;
    rdfs:comment 'Amount of written premium ceded to the reinsurer under the agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Amount' ;
    rdfs:comment 'Dollar amount of ceding commission received from the reinsurer on ceded premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Rate' ;
    rdfs:comment 'Commission rate paid by the reinsurer to the ceding company on ceded premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionNumber rdf:type rdf:Property ;
    rdfs:label 'Cession Number' ;
    rdfs:comment 'Business identifier for the cession transaction, used for tracking and reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cessionRate rdf:type rdf:Property ;
    rdfs:label 'Cession Rate' ;
    rdfs:comment 'Percentage or rate at which premium is ceded to the reinsurer under the agreement.' ;
    rdfs:domain ind:CededPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCededPremium rdf:type rdf:Property ;
    rdfs:label 'Net Ceded Premium' ;
    rdfs:comment 'Net premium ceded after deducting ceding commission and other adjustments.' ;
    rdfs:domain ind:CededPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profitCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Amount' ;
    rdfs:comment 'Dollar amount of profit commission earned on the ceded premium under the reinsurance agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profitCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Rate' ;
    rdfs:comment 'Profit commission rate applicable to the ceded premium under the reinsurance agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementStatus rdf:type rdf:Property ;
    rdfs:label 'Settlement Status' ;
    rdfs:comment 'Current settlement status of the ceded premium transaction with the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basisAmount rdf:type rdf:Property ;
    rdfs:label 'Basis Amount' ;
    rdfs:comment 'Base amount to which the charge rate is applied to derive the charge amount.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeCategory rdf:type rdf:Property ;
    rdfs:label 'Charge Category' ;
    rdfs:comment 'High-level category of the charge: premium, fee, penalty, refund, or adjustment.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeStatus rdf:type rdf:Property ;
    rdfs:label 'Charge Status' ;
    rdfs:comment 'Current lifecycle status of the charge: active, voided, reversed, adjusted, or pending.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeType rdf:type rdf:Property ;
    rdfs:label 'Charge Type' ;
    rdfs:comment 'Classification of the charge component: base premium, surcharge, credit, discount, minimum premium, flat charge, or adjustment. [ENUM-REF-CANDIDATE: base_premium|surcharge|credit|discount|minimum_premium|flat_charge|adjustment — 7 candidates stripped' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earnedAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Amount' ;
    rdfs:comment 'Portion of the charge amount that has been earned as of the accounting period date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isEarned rdf:type rdf:Property ;
    rdfs:label 'Is Earned' ;
    rdfs:comment 'Indicates whether this charge has been earned as of the accounting period date.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMinimumPremium rdf:type rdf:Property ;
    rdfs:label 'Is Minimum Premium' ;
    rdfs:comment 'Indicates whether this charge represents a minimum premium requirement for the policy or coverage.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProrated rdf:type rdf:Property ;
    rdfs:label 'Is Prorated' ;
    rdfs:comment 'Indicates whether the charge amount has been prorated for a partial term or endorsement period.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ratingElementCode rdf:type rdf:Property ;
    rdfs:label 'Rating Element Code' ;
    rdfs:comment 'Code identifying the rating element or factor that generated this charge, per the rating engine.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingElementDescription rdf:type rdf:Property ;
    rdfs:label 'Rating Element Description' ;
    rdfs:comment 'Human-readable description of the rating element or factor that generated this charge.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unearnedAmount rdf:type rdf:Property ;
    rdfs:label 'Unearned Amount' ;
    rdfs:comment 'Portion of the charge amount that remains unearned as of the accounting period date.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalCommissionId rdf:type rdf:Property ;
    rdfs:label 'Original Commission Id' ;
    rdfs:comment 'Foreign key to the original commission record that this transaction reverses or adjusts.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Commission .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'The method used to calculate the commission: flat rate, tiered structure, sliding scale, or manual override.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargebackIndicator rdf:type rdf:Property ;
    rdfs:label 'Chargeback Indicator' ;
    rdfs:comment 'Flag indicating whether this commission is a chargeback reversing a previously paid commission due to policy cancellation or return premium.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chargebackReason rdf:type rdf:Property ;
    rdfs:label 'Chargeback Reason' ;
    rdfs:comment 'Explanation for why the commission was charged back, typically due to policy cancellation, non-payment, or return premium.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionStatus rdf:type rdf:Property ;
    rdfs:label 'Commission Status' ;
    rdfs:comment 'Current lifecycle status of the commission: calculated, approved, pending payment, paid, reversed, or cancelled.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentIndicator rdf:type rdf:Property ;
    rdfs:label 'Contingent Indicator' ;
    rdfs:comment 'Flag indicating whether this is a contingent commission based on volume, profitability, or other performance criteria.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyTransactionType rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Type' ;
    rdfs:comment 'The type of policy transaction that triggered this commission: new business, renewal, endorsement, cancellation, or reinstatement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Code' ;
    rdfs:comment 'Code identifying the commission schedule or rate table used to calculate this commission.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxWithholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Amount' ;
    rdfs:comment 'The amount of tax withheld from the commission payment, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierLevel rdf:type rdf:Property ;
    rdfs:label 'Tier Level' ;
    rdfs:comment 'The producer tier or level within a tiered commission structure, affecting the commission rate.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositPremiumId rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium Id' ;
    rdfs:comment 'Unique identifier for the deposit premium record. Primary key.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depositInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Deposit Invoice Id' ;
    rdfs:comment 'Foreign key linking to billing.invoice. Business justification: Deposit premium transactions generate invoices for initial deposit billing. Billing operations must link invoices to deposit records for audit reconciliation, final premium adjustment' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:actualExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Exposure Amount' ;
    rdfs:comment 'The actual quantity of the exposure basis determined through audit, such as actual annual payroll or actual sales volume.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'The difference between the deposit premium and the final premium, representing additional premium due or return premium owed to the insured.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentType rdf:type rdf:Property ;
    rdfs:label 'Adjustment Type' ;
    rdfs:comment 'Classification of the premium adjustment: additional premium due from insured, return premium owed to insured, or no change required.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Audit Completed Date' ;
    rdfs:comment 'The date on which the premium audit was completed and final exposure data was captured.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Required Flag' ;
    rdfs:comment 'Indicates whether a premium audit is required at policy expiration to reconcile the deposit premium against actual exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Audit Scheduled Date' ;
    rdfs:comment 'The scheduled date for the premium audit to be conducted, typically within 90 days of policy expiration.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditType rdf:type rdf:Property ;
    rdfs:label 'Audit Type' ;
    rdfs:comment 'The method by which the premium audit will be conducted: physical on-site audit, mail audit, telephone audit, waived audit, or no audit required.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basisOfEstimate rdf:type rdf:Property ;
    rdfs:label 'Basis Of Estimate' ;
    rdfs:comment 'Description of the method or data used to estimate the deposit premium, such as prior year payroll, estimated sales, projected vehicle count, or underwriter judgment.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Amount' ;
    rdfs:comment 'The estimated deposit premium amount collected at policy inception or during the term, subject to later audit or retrospective adjustment.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositNumber rdf:type rdf:Property ;
    rdfs:label 'Deposit Number' ;
    rdfs:comment 'Business identifier for the deposit premium, often displayed on billing statements and declarations pages.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositPercentage rdf:type rdf:Property ;
    rdfs:label 'Deposit Percentage' ;
    rdfs:comment 'The percentage of estimated final premium collected as deposit, typically ranging from 25 to 100 percent depending on line of business and underwriting requirements.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositStatus rdf:type rdf:Property ;
    rdfs:label 'Deposit Status' ;
    rdfs:comment 'Current lifecycle status of the deposit premium: estimated at binding, billed to insured, collected by billing system, reconciled against audit, adjusted, or refunded.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositType rdf:type rdf:Property ;
    rdfs:label 'Deposit Type' ;
    rdfs:comment 'Classification of the deposit premium: initial deposit at inception, interim deposit during term, supplemental deposit for coverage changes, or adjustment deposit.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Exposure Amount' ;
    rdfs:comment 'The estimated quantity of the exposure basis used to calculate the deposit premium, such as estimated annual payroll or projected sales volume.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedExposureBasis rdf:type rdf:Property ;
    rdfs:label 'Estimated Exposure Basis' ;
    rdfs:comment 'The exposure unit or rating basis used to calculate the deposit premium, such as payroll, sales, receipts, area, vehicle count, or number of employees.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Final Premium Amount' ;
    rdfs:comment 'The final calculated premium amount based on actual exposure determined through audit or retrospective rating calculation.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumDepositAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Deposit Amount' ;
    rdfs:comment 'The contractual maximum deposit premium amount that can be collected, if applicable, as specified in the policy terms.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumDepositAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Deposit Amount' ;
    rdfs:comment 'The contractual minimum deposit premium amount that must be collected regardless of actual exposure, as specified in the policy terms.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Date' ;
    rdfs:comment 'The date on which the deposit premium was reconciled against the final premium and any adjustment was calculated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroAdjustmentDate rdf:type rdf:Property ;
    rdfs:label 'Retro Adjustment Date' ;
    rdfs:comment 'The date on which the retrospective rating adjustment was calculated and applied to the deposit premium.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroRatedFlag rdf:type rdf:Property ;
    rdfs:label 'Retro Rated Flag' ;
    rdfs:comment 'Indicates whether this deposit premium is subject to retrospective rating adjustment based on actual loss experience during the policy term.' ;
    rdfs:domain ind:DepositPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earnedPremiumScheduleId rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Schedule Id' ;
    rdfs:comment 'Unique identifier for the earned premium schedule record. Primary key.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorScheduleId rdf:type rdf:Property ;
    rdfs:label 'Prior Schedule Id' ;
    rdfs:comment 'Reference to the previous earning schedule that this schedule supersedes or adjusts.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EarnedPremiumSchedule .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Code indicating reason for schedule adjustment: endorsement, rate change, correction, audit, etc.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeEarnedAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Earned Amount' ;
    rdfs:comment 'Total premium earned from effective date through the schedule date, cumulative sum.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dailyEarnedAmount rdf:type rdf:Property ;
    rdfs:label 'Daily Earned Amount' ;
    rdfs:comment 'Premium amount earned per day, used for daily pro-rata earning calculations.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysElapsed rdf:type rdf:Property ;
    rdfs:label 'Days Elapsed' ;
    rdfs:comment 'Number of days elapsed from effective date to schedule date, used in pro-rata calculations.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysInPeriod rdf:type rdf:Property ;
    rdfs:label 'Days In Period' ;
    rdfs:comment 'Total number of days in the coverage period for which premium is being earned.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysRemaining rdf:type rdf:Property ;
    rdfs:label 'Days Remaining' ;
    rdfs:comment 'Number of days remaining from schedule date to expiration date, representing future coverage period.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:earningMethod rdf:type rdf:Property ;
    rdfs:label 'Earning Method' ;
    rdfs:comment 'Granularity at which premium is earned: daily, monthly, quarterly, annual, or event-based.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earningPercentage rdf:type rdf:Property ;
    rdfs:label 'Earning Percentage' ;
    rdfs:comment 'Percentage of total premium earned as of the schedule date, expressed as decimal.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ifrs17CohortCode rdf:type rdf:Property ;
    rdfs:label 'Ifrs17 Cohort Code' ;
    rdfs:comment 'IFRS 17 cohort identifier for grouping contracts issued in same period with similar risk characteristics.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMinimumEarned rdf:type rdf:Property ;
    rdfs:label 'Is Minimum Earned' ;
    rdfs:comment 'Indicates whether minimum earned premium rule applies, ensuring minimum premium is retained regardless of cancellation timing.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isShortRate rdf:type rdf:Property ;
    rdfs:label 'Is Short Rate' ;
    rdfs:comment 'Indicates whether premium earning uses short-rate method with penalty for mid-term cancellation.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumEarnedAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Earned Amount' ;
    rdfs:comment 'Minimum premium amount that must be earned regardless of cancellation date, per policy terms.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleDate rdf:type rdf:Property ;
    rdfs:label 'Schedule Date' ;
    rdfs:comment 'Specific date for which earned and unearned premium amounts are calculated in this schedule entry.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduleNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Number' ;
    rdfs:comment 'Business identifier for the earning schedule, typically derived from policy and coverage identifiers.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the earning schedule: active, cancelled, expired, suspended, or adjusted.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Method used to calculate earned premium: pro-rata, short-rate, or custom earning pattern.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortRatePenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Short Rate Penalty Amount' ;
    rdfs:comment 'Penalty amount applied when policy is cancelled mid-term using short-rate method, reducing return premium.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Short Rate Percentage' ;
    rdfs:comment 'Percentage applied for short-rate cancellation, typically higher than pro-rata to penalize early termination.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Total Premium Amount' ;
    rdfs:comment 'Total written premium amount subject to earning over the coverage period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unearnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Unearned Premium Amount' ;
    rdfs:comment 'Premium amount not yet earned as of the schedule date, representing future coverage obligation.' ;
    rdfs:domain ind:EarnedPremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentPlanId rdf:type rdf:Property ;
    rdfs:label 'Installment Plan Id' ;
    rdfs:comment 'Unique identifier for the installment plan. Primary key.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amountOutstanding rdf:type rdf:Property ;
    rdfs:label 'Amount Outstanding' ;
    rdfs:comment 'Remaining unpaid balance on the installment plan, including overdue amounts.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountPaidToDate rdf:type rdf:Property ;
    rdfs:label 'Amount Paid To Date' ;
    rdfs:comment 'Cumulative amount paid by the policyholder against this installment plan to date.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysDelinquent rdf:type rdf:Property ;
    rdfs:label 'Days Delinquent' ;
    rdfs:comment 'Number of days the installment plan has been in delinquent status.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Down Payment Amount' ;
    rdfs:comment 'Initial down payment amount required at policy binding before installment schedule begins.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Down Payment Date' ;
    rdfs:comment 'Date on which the down payment was received or is due.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Final Installment Due Date' ;
    rdfs:comment 'Due date for the last scheduled installment payment under this plan.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'First Installment Due Date' ;
    rdfs:comment 'Due date for the first scheduled installment payment after the down payment.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:installmentFeePerPayment rdf:type rdf:Property ;
    rdfs:label 'Installment Fee Per Payment' ;
    rdfs:comment 'Fee charged per installment payment to cover administrative costs of the payment plan.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentsOutstanding rdf:type rdf:Property ;
    rdfs:label 'Installments Outstanding' ;
    rdfs:comment 'Count of installments that remain unpaid or partially paid.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentsPaid rdf:type rdf:Property ;
    rdfs:label 'Installments Paid' ;
    rdfs:comment 'Count of installments that have been fully paid to date.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isDelinquent rdf:type rdf:Property ;
    rdfs:label 'Is Delinquent' ;
    rdfs:comment 'Indicates whether the installment plan is currently delinquent due to missed or late payments.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Total Fees Amount' ;
    rdfs:comment 'Total installment fees charged across all scheduled payments under this plan.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPlanAmount rdf:type rdf:Property ;
    rdfs:label 'Total Plan Amount' ;
    rdfs:comment 'Total amount due under the installment plan, including premium and all fees.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumEarnedPremiumId rdf:type rdf:Property ;
    rdfs:label 'Minimum Earned Premium Id' ;
    rdfs:comment 'Unique identifier for the minimum earned premium rule. Primary key.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationLevel rdf:type rdf:Property ;
    rdfs:label 'Application Level' ;
    rdfs:comment 'Level at which the minimum earned premium rule applies: policy term, coverage, or insured risk.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToEndorsementFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Endorsement Flag' ;
    rdfs:comment 'Indicates whether this minimum earned premium rule applies to endorsement transactions.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToNewBusinessFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To New Business Flag' ;
    rdfs:comment 'Indicates whether this minimum earned premium rule applies to new business transactions.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Applies To Renewal Flag' ;
    rdfs:comment 'Indicates whether this minimum earned premium rule applies to renewal transactions.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Amount' ;
    rdfs:comment 'The floor amount of earned premium that must be retained by the insurer regardless of cancellation timing or return premium calculation.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumDaysInForce rdf:type rdf:Property ;
    rdfs:label 'Minimum Days In Force' ;
    rdfs:comment 'Minimum number of days the policy must be in force before the minimum earned premium rule applies. Nullable if no threshold exists.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumEarnedPremiumStatus rdf:type rdf:Property ;
    rdfs:label 'Minimum Earned Premium Status' ;
    rdfs:comment 'Current lifecycle status of the minimum earned premium rule.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentageOfWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Percentage Of Written Premium' ;
    rdfs:comment 'Minimum earned premium expressed as a percentage of the total written premium. Used when rule is percentage-based rather than fixed amount.' ;
    rdfs:domain ind:MinimumEarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ruleCode rdf:type rdf:Property ;
    rdfs:label 'Rule Code' ;
    rdfs:comment 'Business code identifying the minimum earned premium rule type or schedule.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleName rdf:type rdf:Property ;
    rdfs:label 'Rule Name' ;
    rdfs:comment 'Descriptive name of the minimum earned premium rule for business users.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyFeeId rdf:type rdf:Property ;
    rdfs:label 'Policy Fee Id' ;
    rdfs:comment 'Unique identifier for the policy fee transaction record.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeBasis rdf:type rdf:Property ;
    rdfs:label 'Fee Basis' ;
    rdfs:comment 'Basis on which the fee is calculated: flat amount, per policy, per vehicle, per location, per driver, per installment, or percentage of premium. [ENUM-REF-CANDIDATE: flat|per_policy|per_vehicle|per_location|per_driver|per_installment|percentage_of_premium' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCode rdf:type rdf:Property ;
    rdfs:label 'Fee Code' ;
    rdfs:comment 'Standardized code identifying the type of fee charged, aligned with rating engine and billing system fee schedules.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeQuantity rdf:type rdf:Property ;
    rdfs:label 'Fee Quantity' ;
    rdfs:comment 'Quantity or count used to calculate the fee when charged on a per-unit basis; null for flat or percentage fees.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeRate rdf:type rdf:Property ;
    rdfs:label 'Fee Rate' ;
    rdfs:comment 'Rate applied when fee is calculated as a percentage or per-unit charge; null for flat fees.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Status' ;
    rdfs:comment 'Current lifecycle status of the fee transaction: pending, posted, reversed, refunded, or written off.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeType rdf:type rdf:Property ;
    rdfs:label 'Fee Type' ;
    rdfs:comment 'Classification of the fee by business purpose: policy fee, inspection fee, installment fee, service fee, late fee, reinstatement fee, endorsement fee, or cancellation fee.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCommissionBearing rdf:type rdf:Property ;
    rdfs:label 'Is Commission Bearing' ;
    rdfs:comment 'Indicates whether producer commission is calculated on this fee; typically false for most policy fees.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRefundable rdf:type rdf:Property ;
    rdfs:label 'Is Refundable' ;
    rdfs:comment 'Indicates whether this fee is refundable upon policy cancellation or endorsement reversal.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTaxable rdf:type rdf:Property ;
    rdfs:label 'Is Taxable' ;
    rdfs:comment 'Indicates whether this fee is subject to state or local taxes; most policy fees are non-taxable.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Code' ;
    rdfs:comment 'Regulatory jurisdiction code for fee compliance and reporting, may include county or municipal codes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumAccountingPeriodId rdf:type rdf:Property ;
    rdfs:label 'Premium Accounting Period Id' ;
    rdfs:comment 'Unique surrogate identifier for the accounting period record. Role: REFERENCE_LOOKUP — this is a calendar reference table; canonical minimums for transactional roles do not apply.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumAccountingPeriod .

ind:priorPeriodPremiumAccountingPeriodId rdf:type rdf:Property ;
    rdfs:label 'Prior Period Premium Accounting Period Id' ;
    rdfs:comment 'Reference to the immediately preceding accounting period of the same type. Supports period-over-period comparisons and loss development triangle chaining.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumAccountingPeriod .

ind:accidentYearAy rdf:type rdf:Property ;
    rdfs:label 'Accident Year Ay' ;
    rdfs:comment 'Accident Year (AY) associated with this period for loss development and IBNR reserving. Losses are assigned to the AY in which the loss event occurred.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialReserveCutoffDate rdf:type rdf:Property ;
    rdfs:label 'Actuarial Reserve Cutoff Date' ;
    rdfs:comment 'Date through which loss and IBNR reserve data is included in the actuarial reserve study for this period. Aligns with the loss triangle evaluation date.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bordereauxDueDate rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Due Date' ;
    rdfs:comment 'Date by which the reinsurance premium and loss bordereaux for this period must be submitted to reinsurers, per treaty and facultative agreement terms.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calendarYearCy rdf:type rdf:Property ;
    rdfs:label 'Calendar Year Cy' ;
    rdfs:comment 'Calendar Year (CY) in which this period falls. Used for CY loss ratio, CY written premium, and Schedule P CY diagonal reporting.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:earnedPremiumBasis rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Basis' ;
    rdfs:comment 'Method used to calculate Earned Premium (EP) within this period: PRO_RATA (proportional to days), DAILY (day-by-day), or MONTHLY (full-month convention).' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCurrentPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Current Period' ;
    rdfs:comment 'Indicates whether this is the currently active accounting period for premium transaction posting. True for exactly one OPEN period at any given time.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIfrs17ReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Ifrs17 Reporting Period' ;
    rdfs:comment 'Indicates whether this period is used for IFRS 17 Insurance Contracts reporting, including Contractual Service Margin (CSM) and Loss Component calculations.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStatutoryFilingPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Statutory Filing Period' ;
    rdfs:comment 'Indicates whether this period corresponds to a statutory filing deadline (quarterly or annual NAIC statement). Drives automated Schedule P and Schedule F generation.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentPeriodId rdf:type rdf:Property ;
    rdfs:label 'Parent Period Id' ;
    rdfs:comment 'Reference to the parent period in the hierarchy, e.g., a monthly period\'s parent is its quarter, a quarterly period\'s parent is its annual period.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyYearPy rdf:type rdf:Property ;
    rdfs:label 'Policy Year Py' ;
    rdfs:comment 'Policy Year (PY) associated with this period. Groups premium and losses by the year in which the policy was written, used for PY loss development triangles.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryFilingDeadline rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Deadline' ;
    rdfs:comment 'Statutory deadline by which the NAIC Annual or Quarterly Statement covering this period must be filed with the applicable State Department of Insurance (DOI).' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reopenReason rdf:type rdf:Property ;
    rdfs:label 'Reopen Reason' ;
    rdfs:comment 'Free-text explanation for why a closed or locked period was reopened, e.g., audit adjustment, restatement, or regulatory correction. Null if never reopened.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulePYearType rdf:type rdf:Property ;
    rdfs:label 'Schedule P Year Type' ;
    rdfs:comment 'Designates which Schedule P year-type view this period supports: CY (Calendar Year), AY (Accident Year), or PY (Policy Year), per NAIC Annual Statement Part 2 requirements.' ;
    rdfs:domain ind:PremiumAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditId rdf:type rdf:Property ;
    rdfs:label 'Audit Id' ;
    rdfs:comment 'Unique identifier for the premium_audit data product (auto-inserted during validation).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditorIndividualId rdf:type rdf:Property ;
    rdfs:label 'Auditor Individual Id' ;
    rdfs:comment 'Foreign key linking to party.individual. Business justification: Premium auditors are individuals. Linking premium_audit to individual (rather than just storing auditor_name as text) enables operational reporting (auditor workload, quality metrics)' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Individual .

ind:unitOfMeasureId rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure Id' ;
    rdfs:comment 'Foreign key linking to shared.unit_of_measure. Business justification: Premium audits verify exposure measured in units. FK enables unit-based audit reconciliation, conversion, and ensures exposure_basis_code references valid UOMs for premium adjustment' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitOfMeasure .

ind:additionalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Additional Premium Amount' ;
    rdfs:comment 'Additional premium owed by the policyholder if audited premium exceeds estimated premium.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditNumber rdf:type rdf:Property ;
    rdfs:label 'Audit Number' ;
    rdfs:comment 'Unique business identifier for this premium audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditStatus rdf:type rdf:Property ;
    rdfs:label 'Audit Status' ;
    rdfs:comment 'Current lifecycle status of the premium audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditedExposure rdf:type rdf:Property ;
    rdfs:label 'Audited Exposure' ;
    rdfs:comment 'Actual exposure basis determined during the audit based on policyholder records.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Audited Premium Amount' ;
    rdfs:comment 'Final premium amount calculated based on audited exposure.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingAdjustmentStatus rdf:type rdf:Property ;
    rdfs:label 'Billing Adjustment Status' ;
    rdfs:comment 'Status of billing adjustments triggered by the audit results.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Deposit Reconciliation Status' ;
    rdfs:comment 'Status of the deposit premium reconciliation process following the audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether the policyholder has disputed the audit findings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Date' ;
    rdfs:comment 'Date when the audit dispute was resolved.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedExposure rdf:type rdf:Property ;
    rdfs:label 'Estimated Exposure' ;
    rdfs:comment 'Original estimated exposure basis used to calculate deposit or estimated premium at policy inception.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Premium Amount' ;
    rdfs:comment 'Original estimated or deposit premium amount charged at policy inception.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureBasisDescription rdf:type rdf:Property ;
    rdfs:label 'Exposure Basis Description' ;
    rdfs:comment 'Description of the exposure basis used for premium calculation.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureVariance rdf:type rdf:Property ;
    rdfs:label 'Exposure Variance' ;
    rdfs:comment 'Difference between audited exposure and estimated exposure (audited minus estimated).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureVariancePercentage rdf:type rdf:Property ;
    rdfs:label 'Exposure Variance Percentage' ;
    rdfs:comment 'Percentage variance between audited and estimated exposure.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMinimumPremiumApplied rdf:type rdf:Property ;
    rdfs:label 'Is Minimum Premium Applied' ;
    rdfs:comment 'Indicates whether the minimum premium was applied during the audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'End date of the policy period being audited.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'Start date of the policy period being audited.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyholderSignatureDate rdf:type rdf:Property ;
    rdfs:label 'Policyholder Signature Date' ;
    rdfs:comment 'Date when the policyholder signed the audit acknowledgment or agreement.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Variance Amount' ;
    rdfs:comment 'Difference between audited premium and estimated premium (audited minus estimated). Positive indicates additional premium due; negative indicates return premium.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Return Premium Amount' ;
    rdfs:comment 'Premium to be returned to the policyholder if audited premium is less than estimated premium.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumEndorsementId rdf:type rdf:Property ;
    rdfs:label 'Premium Endorsement Id' ;
    rdfs:comment 'Unique identifier for the premium endorsement record.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedEndorsementId rdf:type rdf:Property ;
    rdfs:label 'Reversed Endorsement Id' ;
    rdfs:comment 'Foreign key to the original Premium Endorsement record being reversed, if this is a reversal transaction.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumEndorsement .

ind:billingStatus rdf:type rdf:Property ;
    rdfs:label 'Billing Status' ;
    rdfs:comment 'Current billing status of the endorsement premium change.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededPremiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Change Amount' ;
    rdfs:comment 'Portion of the premium change ceded to reinsurers under treaty or facultative agreements.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Change Amount' ;
    rdfs:comment 'Change in producer commission payable resulting from the endorsement premium change.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysInTermRemaining rdf:type rdf:Property ;
    rdfs:label 'Days In Term Remaining' ;
    rdfs:comment 'Number of days remaining in the policy term from the endorsement effective date to term expiration.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:earnedPremiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Change Amount' ;
    rdfs:comment 'Change in earned premium resulting from the endorsement, calculated based on the earning pattern.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Change Amount' ;
    rdfs:comment 'Change in policy fees (policy fee, installment fee, service fee) resulting from the endorsement.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPremiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Premium Change Amount' ;
    rdfs:comment 'Gross premium change before deducting ceded reinsurance amounts.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBillable rdf:type rdf:Property ;
    rdfs:label 'Is Billable' ;
    rdfs:comment 'Indicates whether this endorsement generates a billing transaction (true for additional premium, false for return premium credited).' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netPremiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Net Premium Change Amount' ;
    rdfs:comment 'Net change in premium resulting from this endorsement; positive for additional premium, negative for return premium.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Source System Transaction Code' ;
    rdfs:comment 'Unique transaction identifier from the source policy administration system.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Change Amount' ;
    rdfs:comment 'Change in taxes (premium tax, surplus lines tax, stamping fees) resulting from the endorsement.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalChargeChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Charge Change Amount' ;
    rdfs:comment 'Total change in all charges (premium, taxes, fees) billed to the policyholder.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Reason Code' ;
    rdfs:comment 'Code indicating the business reason for the endorsement (e.g., coverage change, insured risk addition, address correction).' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transaction Reason Description' ;
    rdfs:comment 'Detailed description of why the endorsement was issued.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unearnedPremiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Unearned Premium Change Amount' ;
    rdfs:comment 'Change in unearned premium reserve resulting from the endorsement.' ;
    rdfs:domain ind:PremiumEndorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ruleId rdf:type rdf:Property ;
    rdfs:label 'Rule Id' ;
    rdfs:comment 'Unique identifier for the premium_rule data product (auto-inserted during validation).' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByRuleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Rule Id' ;
    rdfs:comment 'Identifier of the rule that supersedes this rule. Null if this rule is current or has not been replaced.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rule .

ind:appliesToCancellation rdf:type rdf:Property ;
    rdfs:label 'Applies To Cancellation' ;
    rdfs:comment 'Indicates whether this rule applies to policy cancellation transactions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToEndorsement rdf:type rdf:Property ;
    rdfs:label 'Applies To Endorsement' ;
    rdfs:comment 'Indicates whether this rule applies to mid-term endorsement transactions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToNewBusiness rdf:type rdf:Property ;
    rdfs:label 'Applies To New Business' ;
    rdfs:comment 'Indicates whether this rule applies to new business policy transactions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToReinstatement rdf:type rdf:Property ;
    rdfs:label 'Applies To Reinstatement' ;
    rdfs:comment 'Indicates whether this rule applies to policy reinstatement transactions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToRenewal rdf:type rdf:Property ;
    rdfs:label 'Applies To Renewal' ;
    rdfs:comment 'Indicates whether this rule applies to renewal policy transactions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ruleCategory rdf:type rdf:Property ;
    rdfs:label 'Rule Category' ;
    rdfs:comment 'Functional category of the rule: earning method, calculation logic, split allocation, floor threshold, cap limit, or adjustment factor.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionExpression rdf:type rdf:Property ;
    rdfs:label 'Condition Expression' ;
    rdfs:comment 'Logical condition that must be satisfied for this rule to apply. Expressed in rating engine syntax. Null indicates unconditional application.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleDescription rdf:type rdf:Property ;
    rdfs:label 'Rule Description' ;
    rdfs:comment 'Detailed business description of the rule, its purpose, and its application context for underwriters and actuaries.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formulaExpression rdf:type rdf:Property ;
    rdfs:label 'Formula Expression' ;
    rdfs:comment 'Mathematical or logical expression defining the premium calculation when calculation_method is formula. Null for non-formula methods.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumEarnedPercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Earned Percentage' ;
    rdfs:comment 'Minimum percentage of premium that must be earned regardless of cancellation timing. Used for minimum-earned rules.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentageRate rdf:type rdf:Property ;
    rdfs:label 'Percentage Rate' ;
    rdfs:comment 'Percentage rate applied in the premium calculation or earning logic. Expressed as a decimal (e.g., 0.0850 for 8.5 percent).' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prioritySequence rdf:type rdf:Property ;
    rdfs:label 'Priority Sequence' ;
    rdfs:comment 'Execution order when multiple rules apply to the same premium transaction. Lower numbers execute first.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleStatus rdf:type rdf:Property ;
    rdfs:label 'Rule Status' ;
    rdfs:comment 'Current lifecycle status of the rule: draft, pending-approval, active, suspended, expired, or superseded.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleType rdf:type rdf:Property ;
    rdfs:label 'Rule Type' ;
    rdfs:comment 'Classification of the premium calculation or earning method: pro-rata, short-rate, flat, minimum-earned, deposit, audit, or installment. [ENUM-REF-CANDIDATE: pro-rata|short-rate|flat|minimum-earned|deposit|audit|installment — 7 candidates stripped' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortRatePenaltyPercentage rdf:type rdf:Property ;
    rdfs:label 'Short Rate Penalty Percentage' ;
    rdfs:comment 'Penalty percentage applied when a policy is cancelled mid-term by the insured under short-rate rules. Null for pro-rata cancellations.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Threshold Amount' ;
    rdfs:comment 'Minimum or maximum premium amount threshold enforced by this rule. Used for floor and cap rules.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdType rdf:type rdf:Property ;
    rdfs:label 'Threshold Type' ;
    rdfs:comment 'Type of threshold enforced: minimum floor, maximum cap, or target benchmark.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Id' ;
    rdfs:comment 'Reference to the original premium transaction that this record reverses or corrects. Populated only when reversal_indicator is True. Supports audit trail.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PcInsurance .

ind:auditBasis rdf:type rdf:Property ;
    rdfs:label 'Audit Basis' ;
    rdfs:comment 'Exposure basis used for auditable policies (e.g., WC, CGL) to determine final earned premium: Payroll, Revenue, Units, Receipts, or None for non-auditable policies.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysInForce rdf:type rdf:Property ;
    rdfs:label 'Days In Force' ;
    rdfs:comment 'Number of days the coverage was in force during the accounting period for this premium transaction. Used in pro-rata earning and exposure calculations.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:directBilledIndicator rdf:type rdf:Property ;
    rdfs:label 'Direct Billed Indicator' ;
    rdfs:comment 'Indicates whether this premium is billed directly to the policyholder (True) or through the producer/agency (False = agency billed). Drives billing workflow routing.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earnedPremium rdf:type rdf:Property ;
    rdfs:label 'Earned Premium' ;
    rdfs:comment 'Portion of written premium recognized as earned for the accounting period based on pro-rata or other earning methodology. Core input to loss ratio (LR) calculation.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsementType rdf:type rdf:Property ;
    rdfs:label 'Endorsement Type' ;
    rdfs:comment 'Type of endorsement premium adjustment: Additional (increase), Return (decrease/credit), Flat (no change), Audit (audit-based adjustment), or None for non-endorsement transactions.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureAmount rdf:type rdf:Property ;
    rdfs:label 'Exposure Amount' ;
    rdfs:comment 'Quantitative exposure measure (e.g., payroll dollars, vehicle count, property TIV) underlying the premium calculation. Used for rate adequacy and actuarial analysis.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Gross Written Premium' ;
    rdfs:comment 'Total gross written premium amount for this transaction before cessions, taxes, fees, and commissions. Core ledger amount for statutory and GAAP reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Net Written Premium' ;
    rdfs:comment 'Written premium net of reinsurance cessions. NWP = GWP minus ceded written premium. Used for net retention reporting and RBC calculations.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proRataFactor rdf:type rdf:Property ;
    rdfs:label 'Pro Rata Factor' ;
    rdfs:comment 'Decimal factor (0.0 to 1.0) representing the proportion of the policy period elapsed as of the accounting period end date. Used to compute earned premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPremium rdf:type rdf:Property ;
    rdfs:label 'Return Premium' ;
    rdfs:comment 'Premium amount returned to the policyholder due to cancellation, mid-term endorsement reduction, or audit adjustment. Negative financial movement in the ledger.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unearnedPremium rdf:type rdf:Property ;
    rdfs:label 'Unearned Premium' ;
    rdfs:comment 'Portion of written premium not yet earned as of the accounting period end date. Represents the UEP reserve liability on the balance sheet.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateTableId rdf:type rdf:Property ;
    rdfs:label 'Rate Table Id' ;
    rdfs:comment 'Unique identifier for the rate table version. Primary key.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateTable .

ind:filingOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Filing Organization Id' ;
    rdfs:comment 'Foreign key linking to party.organization. Business justification: Rate tables are filed by or on behalf of specific carrier organizations or MGAs. Linking rate_table to organization supports regulatory compliance (which entity filed this rate)' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:actuarialMemoReference rdf:type rdf:Property ;
    rdfs:label 'Actuarial Memo Reference' ;
    rdfs:comment 'Reference number or document identifier for the actuarial memorandum supporting this rate table filing.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseRateAmount rdf:type rdf:Property ;
    rdfs:label 'Base Rate Amount' ;
    rdfs:comment 'Primary rate value or starting premium amount before application of factors and adjustments.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateTableCode rdf:type rdf:Property ;
    rdfs:label 'Rate Table Code' ;
    rdfs:comment 'Business identifier for the rate table, typically combining LOB, state, and version components for external reference.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credibilityFactor rdf:type rdf:Property ;
    rdfs:label 'Credibility Factor' ;
    rdfs:comment 'Actuarial credibility weight applied to experience data used to develop this rate table, ranging from 0 to 1.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseProvisionPercentage rdf:type rdf:Property ;
    rdfs:label 'Expense Provision Percentage' ;
    rdfs:comment 'Percentage load for underwriting expenses, commissions, and overhead included in the rate.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isFileAndUse rdf:type rdf:Property ;
    rdfs:label 'Is File And Use' ;
    rdfs:comment 'Indicates whether this rate table was implemented under file-and-use regulatory framework, requiring filing before use but not prior approval.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPriorApproval rdf:type rdf:Property ;
    rdfs:label 'Is Prior Approval' ;
    rdfs:comment 'Indicates whether this rate table required prior regulatory approval before implementation.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUseAndFile rdf:type rdf:Property ;
    rdfs:label 'Is Use And File' ;
    rdfs:comment 'Indicates whether this rate table was implemented under use-and-file regulatory framework, allowing immediate use before approval.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCostBasis rdf:type rdf:Property ;
    rdfs:label 'Loss Cost Basis' ;
    rdfs:comment 'Actuarial loss cost per exposure unit underlying this rate table, before expense and profit loads.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateTableName rdf:type rdf:Property ;
    rdfs:label 'Rate Table Name' ;
    rdfs:comment 'Human-readable name describing the rate table purpose and scope.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitProvisionPercentage rdf:type rdf:Property ;
    rdfs:label 'Profit Provision Percentage' ;
    rdfs:comment 'Percentage load for underwriting profit and contingencies included in the rate.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publishedDate rdf:type rdf:Property ;
    rdfs:label 'Published Date' ;
    rdfs:comment 'Date when this rate table version was released to the rating engine and made available for policy transactions.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Change Percentage' ;
    rdfs:comment 'Overall percentage increase or decrease from the prior rate table version, used for regulatory filing disclosure.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateManualEdition rdf:type rdf:Property ;
    rdfs:label 'Rate Manual Edition' ;
    rdfs:comment 'Edition or publication date of the rate manual or rating guide this table is published in.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateSource rdf:type rdf:Property ;
    rdfs:label 'Rate Source' ;
    rdfs:comment 'Origin of the rate data: proprietary company rates, ISO advisory, NCCI, state-mandated manual, or competitor benchmark.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateTableStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Table Status' ;
    rdfs:comment 'Current operational status of this rate table version in the rating engine.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateType rdf:type rdf:Property ;
    rdfs:label 'Rate Type' ;
    rdfs:comment 'Classification of rate content: base rates, rating factors, minimum premiums, surcharges, discounts, or credits.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryDefinition rdf:type rdf:Property ;
    rdfs:label 'Territory Definition' ;
    rdfs:comment 'Geographic territory or rating zone structure this rate table applies to, such as county groups or ZIP code ranges.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trendFactor rdf:type rdf:Property ;
    rdfs:label 'Trend Factor' ;
    rdfs:comment 'Actuarial trend adjustment factor applied to historical loss data to project future losses for this rate table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withdrawnDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Date' ;
    rdfs:comment 'Date when this rate table version was removed from active use in the rating engine.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retrospectiveAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Retrospective Adjustment Id' ;
    rdfs:comment 'Unique identifier for the retrospective premium adjustment record.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustmentInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Adjustment Invoice Id' ;
    rdfs:comment 'Foreign key linking to billing.invoice. Business justification: Retrospective rating adjustments generate additional premium invoices. Billing must reference the retro adjustment for premium reconciliation, policyholder inquiries, and audit trails.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:reversedAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Reversed Adjustment Id' ;
    rdfs:comment 'Foreign key to the original retrospective adjustment record that this adjustment reverses, if applicable.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RetrospectiveAdjustment .

ind:adjustmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Effective Date' ;
    rdfs:comment 'Date from which the retrospective adjustment becomes effective for accounting and billing purposes.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Number' ;
    rdfs:comment 'Business identifier for this retrospective adjustment, typically sequential within the policy term.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentSequence rdf:type rdf:Property ;
    rdfs:label 'Adjustment Sequence' ;
    rdfs:comment 'Sequential order of this adjustment within the policy term, starting at 1 for the first adjustment.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustmentStatus rdf:type rdf:Property ;
    rdfs:label 'Adjustment Status' ;
    rdfs:comment 'Current lifecycle status of the retrospective adjustment in the billing and payment workflow.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Variance Amount' ;
    rdfs:comment 'Difference between current and prior retrospective premium, representing the additional premium due or return premium owed.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basicPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Basic Premium Amount' ;
    rdfs:comment 'The fixed component of retrospective premium covering insurer expenses and profit, not subject to loss adjustment.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculatedRetroPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Calculated Retro Premium Amount' ;
    rdfs:comment 'Retrospective premium computed from the formula before applying minimum and maximum limits.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Calculation Method Code' ;
    rdfs:comment 'Code identifying the specific retrospective rating formula or plan used for this adjustment.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:convertedLossesAmount rdf:type rdf:Property ;
    rdfs:label 'Converted Losses Amount' ;
    rdfs:comment 'Incurred losses multiplied by the loss conversion factor, representing the loss-based premium component.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalRetroPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Final Retro Premium Amount' ;
    rdfs:comment 'Retrospective premium after applying minimum and maximum limits, representing the actual premium due.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incurredLossesAmount rdf:type rdf:Property ;
    rdfs:label 'Incurred Losses Amount' ;
    rdfs:comment 'Total losses incurred during the policy term as of the evaluation date, including paid losses and outstanding reserves.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMaximumApplied rdf:type rdf:Property ;
    rdfs:label 'Is Maximum Applied' ;
    rdfs:comment 'Flag indicating whether the maximum premium limit was applied in this adjustment calculation.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMinimumApplied rdf:type rdf:Property ;
    rdfs:label 'Is Minimum Applied' ;
    rdfs:comment 'Flag indicating whether the minimum premium limit was applied in this adjustment calculation.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossConversionFactor rdf:type rdf:Property ;
    rdfs:label 'Loss Conversion Factor' ;
    rdfs:comment 'Multiplier applied to incurred losses to convert them to premium equivalent, covering loss adjustment expenses and profit margin.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossLimitationAmount rdf:type rdf:Property ;
    rdfs:label 'Loss Limitation Amount' ;
    rdfs:comment 'Maximum loss amount per occurrence or in aggregate used in the retrospective premium calculation.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossLimitationType rdf:type rdf:Property ;
    rdfs:label 'Loss Limitation Type' ;
    rdfs:comment 'Type of loss limitation applied in the retrospective rating plan to cap individual claim or aggregate loss amounts.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorRetroPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Retro Premium Amount' ;
    rdfs:comment 'Retrospective premium amount from the previous adjustment, used to calculate the incremental change.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Standard Premium Amount' ;
    rdfs:comment 'The base premium amount before retrospective adjustment, calculated using standard rates and exposures.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxMultiplier rdf:type rdf:Property ;
    rdfs:label 'Tax Multiplier' ;
    rdfs:comment 'Factor applied to gross retrospective premium to account for premium taxes and assessments.' ;
    rdfs:domain ind:RetrospectiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalTaxLevyId rdf:type rdf:Property ;
    rdfs:label 'Original Tax Levy Id' ;
    rdfs:comment 'Foreign key to the original tax levy record being adjusted or corrected, if this is an adjustment transaction. Null for original levies.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxLevy .

ind:taxLevyDescription rdf:type rdf:Property ;
    rdfs:label 'Tax Levy Description' ;
    rdfs:comment 'Free-text description providing additional context or detail about the tax levy, such as special assessments or regulatory notes.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTransactionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Type Code' ;
    rdfs:comment 'Type of policy transaction that triggered the premium and associated tax levy: new business, renewal, endorsement, cancellation, or reinstatement.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stampingOfficeCode rdf:type rdf:Property ;
    rdfs:label 'Stamping Office Code' ;
    rdfs:comment 'Code identifying the surplus lines stamping office responsible for processing and collecting the tax, if applicable.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesFlag rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Flag' ;
    rdfs:comment 'Indicates whether this tax levy applies to a surplus lines policy, subject to surplus lines tax and stamping requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Adjustment Flag' ;
    rdfs:comment 'Indicates whether this tax levy record represents an adjustment or correction to a previously recorded tax levy.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Tax Authority Name' ;
    rdfs:comment 'Name of the regulatory or governmental authority to which the tax is remitted, such as State Department of Insurance or Surplus Lines Stamping Office.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCalculationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Tax Calculation Method Code' ;
    rdfs:comment 'Method used to calculate the tax levy: statutory rate, flat fee, tiered rate schedule, or minimum tax threshold.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Tax Effective Date' ;
    rdfs:comment 'The date on which the tax levy becomes effective, typically aligned with the premium transaction effective date.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxExemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exemption Flag' ;
    rdfs:comment 'Indicates whether the premium transaction qualifies for a tax exemption under statutory or regulatory provisions.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxExemptionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Tax Exemption Reason Code' ;
    rdfs:comment 'Code indicating the reason for tax exemption: exempt entity, reinsurance, export, federal program, or other statutory exemption.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRemittanceBatchCode rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Batch Code' ;
    rdfs:comment 'Identifier of the remittance batch or payment run in which this tax levy was included for payment to the authority.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRemittanceDate rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Date' ;
    rdfs:comment 'The actual date on which the tax was remitted to the taxing authority. Null if not yet remitted.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxRemittanceDueDate rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Due Date' ;
    rdfs:comment 'The statutory due date by which the tax must be remitted to the taxing authority to avoid penalties.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxRemittanceStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Status' ;
    rdfs:comment 'Current remittance status of the tax levy: pending, remitted, overdue, waived, or adjusted.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxReportingCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Tax Reporting Category Code' ;
    rdfs:comment 'Reporting category for statutory and regulatory tax filings: direct written premium, assumed reinsurance, or ceded reinsurance.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxTypeCode rdf:type rdf:Property ;
    rdfs:label 'Tax Type Code' ;
    rdfs:comment 'Classification of the tax levy: state premium tax, surplus lines tax, stamping fee, municipal tax, fire marshal tax, or guaranty fund assessment.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxablePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Taxable Premium Amount' ;
    rdfs:comment 'The base premium amount subject to tax, after any exemptions or adjustments, in US dollars.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionChannelId rdf:type rdf:Property ;
    rdfs:label 'Distribution Channel Id' ;
    rdfs:comment 'Foreign key linking to producers.distribution_channel. Business justification: Agencies operate through a specific distribution channel (captive, independent, broker, direct). Replace STRING distribution_channel_code with FK. N:1 relationship.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionChannel .

ind:parentAgencyId rdf:type rdf:Property ;
    rdfs:label 'Parent Agency Id' ;
    rdfs:comment 'Reference to the parent agency for hierarchical relationships such as MGA to sub-producer or wholesale to retail agency networks.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:agencyStatus rdf:type rdf:Property ;
    rdfs:label 'Agency Status' ;
    rdfs:comment 'Current lifecycle status of the agency relationship with the carrier: active, inactive, suspended, terminated, or pending appointment.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyType rdf:type rdf:Property ;
    rdfs:label 'Agency Type' ;
    rdfs:comment 'Classification of the agency business model: independent agent, captive agent, managing general agent (MGA), wholesale broker, retail broker, surplus lines broker, or direct writer.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualPremiumVolume rdf:type rdf:Property ;
    rdfs:label 'Annual Premium Volume' ;
    rdfs:comment 'Total annual written premium volume produced by the agency across all lines of business for the most recent calendar year.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appointmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Effective Date' ;
    rdfs:comment 'Date when the agency appointment with the carrier became effective and the agency was authorized to bind business.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Termination Date' ;
    rdfs:comment 'Date when the agency appointment with the carrier was terminated or expired, ending binding authority.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bindingAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Flag' ;
    rdfs:comment 'Indicates whether the agency has binding authority to issue policies on behalf of the carrier without prior underwriting approval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindingAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Binding Authority Limit' ;
    rdfs:comment 'Maximum total insured value or premium amount the agency is authorized to bind without carrier underwriting review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Commission Schedule Code' ;
    rdfs:comment 'Reference code to the commission rate schedule applicable to this agency for new business, renewals, and endorsements by line of business.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentCommissionEligible rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Eligible' ;
    rdfs:comment 'Indicates whether the agency is eligible for contingent or profit-sharing commission based on loss ratio and volume performance.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defaultCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Default Commission Rate' ;
    rdfs:comment 'Default commission rate as a decimal percentage applied to written premium when no line-specific rate is defined in the commission schedule.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eoCarrierName rdf:type rdf:Property ;
    rdfs:label 'Eo Carrier Name' ;
    rdfs:comment 'Name of the insurance carrier providing errors and omissions professional liability coverage for the agency.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Amount' ;
    rdfs:comment 'Total coverage limit amount for the agency errors and omissions professional liability insurance policy.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lobAuthorizations rdf:type rdf:Property ;
    rdfs:label 'Lob Authorizations' ;
    rdfs:comment 'Comma-separated list of lines of business the agency is authorized to write: personal auto, homeowners, commercial property, general liability, workers compensation, etc.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressSameAsPrincipal rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Same As Principal' ;
    rdfs:comment 'Indicates whether the mailing address is identical to the principal business address for correspondence and regulatory notices.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:principalAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Principal Address Line1' ;
    rdfs:comment 'First line of the principal business address for the agency as registered with the state Department of Insurance (DOI).' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Principal Address Line2' ;
    rdfs:comment 'Second line of the principal business address including suite, floor, or building number.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalCity rdf:type rdf:Property ;
    rdfs:label 'Principal City' ;
    rdfs:comment 'City name for the principal business address of the agency.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalCountryCode rdf:type rdf:Property ;
    rdfs:label 'Principal Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the principal business address of the agency.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalCounty rdf:type rdf:Property ;
    rdfs:label 'Principal County' ;
    rdfs:comment 'County name for the principal business address used for territory and catastrophe exposure aggregation.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalPostalCode rdf:type rdf:Property ;
    rdfs:label 'Principal Postal Code' ;
    rdfs:comment 'ZIP or ZIP+4 postal code for the principal business address of the agency.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalStateCode rdf:type rdf:Property ;
    rdfs:label 'Principal State Code' ;
    rdfs:comment 'Two-letter state code for the principal business address and domicile state of the agency.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surplusLinesEligible rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines Eligible' ;
    rdfs:comment 'Indicates whether the agency is licensed and authorized to place surplus lines business with non-admitted carriers.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surplusLinesLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Surplus Lines License Number' ;
    rdfs:comment 'State-issued surplus lines broker license number authorizing the agency to place business with non-admitted carriers.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyProducerId rdf:type rdf:Property ;
    rdfs:label 'Agency Producer Id' ;
    rdfs:comment 'Unique identifier for the agency-producer relationship record. Primary key.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Agency Producers Producer Id' ;
    rdfs:comment 'Foreign key to the producer in this agency relationship.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:agencyReportingManagerProducerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Agency Reporting Manager Producer Producers Producer Id' ;
    rdfs:comment 'Producer ID of the direct manager or supervisor for this producer within the agency.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:annualProductionTarget rdf:type rdf:Property ;
    rdfs:label 'Annual Production Target' ;
    rdfs:comment 'Annual written premium production target assigned to the producer through this agency.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookOfBusinessOwnership rdf:type rdf:Property ;
    rdfs:label 'Book Of Business Ownership' ;
    rdfs:comment 'Indicates who owns the book of business generated by the producer through this agency.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSplitPercentage rdf:type rdf:Property ;
    rdfs:label 'Commission Split Percentage' ;
    rdfs:comment 'Percentage of commission allocated to the producer in split arrangements with the agency.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Contract Document Reference' ;
    rdfs:comment 'Reference identifier or URI to the producer-agency contract or agreement document.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deskLocation rdf:type rdf:Property ;
    rdfs:label 'Desk Location' ;
    rdfs:comment 'Physical desk or office location identifier within the agency premises.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoCoverageRequired rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Required' ;
    rdfs:comment 'Indicates whether E&O insurance coverage is required for this producer-agency relationship.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eoCoverageVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Verified Date' ;
    rdfs:comment 'Date when E&O insurance coverage was last verified for this producer-agency pairing.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonCompeteClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Non Compete Clause Flag' ;
    rdfs:comment 'Indicates whether a non-compete clause exists in the producer-agency agreement.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nonCompeteExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Non Compete Expiration Date' ;
    rdfs:comment 'Date when the non-compete obligation expires after relationship termination.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceTier rdf:type rdf:Property ;
    rdfs:label 'Performance Tier' ;
    rdfs:comment 'Performance classification or tier assigned to the producer within the agency structure.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Agency Flag' ;
    rdfs:comment 'Indicates whether this is the producers primary or home agency affiliation.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Record Version Number' ;
    rdfs:comment 'Version number tracking changes to this relationship record for audit and concurrency control.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Source System Reference Code' ;
    rdfs:comment 'Unique identifier for this relationship record in the source system.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writingAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Writing Authority Level' ;
    rdfs:comment 'Level of underwriting and binding authority granted to the producer within this agency.' ;
    rdfs:domain ind:AgencyProducer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerOfRecordChangeId rdf:type rdf:Property ;
    rdfs:label 'Broker Of Record Change Id' ;
    rdfs:comment 'Unique surrogate identifier for each Broker of Record change request. One row per BOR change event on a policy.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brokerApprovedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Broker Approved By Party Id' ;
    rdfs:comment 'Reference to the internal party (underwriter or operations staff) who approved the BOR change within the insurer\'s workflow.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:brokerIncomingAgencyId rdf:type rdf:Property ;
    rdfs:label 'Broker Incoming Agency Id' ;
    rdfs:comment 'Reference to the agency associated with the incoming producer. Supports commission routing and agency-level reporting.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:brokerOutgoingAgencyId rdf:type rdf:Property ;
    rdfs:label 'Broker Outgoing Agency Id' ;
    rdfs:comment 'Reference to the agency associated with the outgoing producer. Used for commission clawback and reconciliation.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:brokerOutgoingProducerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Broker Outgoing Producer Producers Producer Id' ;
    rdfs:comment 'Reference to the producer who is being replaced as the Broker of Record. Null if no prior producer was assigned.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:brokerProducersProducerId rdf:type rdf:Property ;
    rdfs:label 'Broker Producers Producer Id' ;
    rdfs:comment 'Reference to the producer (agent or broker) who is being designated as the new Broker of Record for the policy.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:brokerRequestedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Broker Requested By Party Id' ;
    rdfs:comment 'Reference to the party (insured, incoming producer, or insurer representative) who initiated the BOR change request.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:supersededByBorChangeId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Bor Change Id' ;
    rdfs:comment 'Reference to a subsequent BOR change record that supersedes this one. Supports chained BOR change history on a single policy.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BrokerOfRecordChange .

ind:borLetterReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Bor Letter Received Date' ;
    rdfs:comment 'Date the signed Broker of Record letter (ACORD 36 or equivalent) was received by the insurer from the incoming producer.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:changeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Change Reason Code' ;
    rdfs:comment 'Coded reason for the Broker of Record change. Supports market conduct analysis and producer retention reporting. [ENUM-REF-CANDIDATE: INSURED_REQUEST|PRODUCER_MERGER|PRODUCER_TERMINATION|SERVICE_DISSATISFACTION|AGENCY_TRANSFER|OTHER — promote to reference' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Change Reason Description' ;
    rdfs:comment 'Free-text narrative explaining the reason for the Broker of Record change, supplementing the coded reason for audit and compliance purposes.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeStatus rdf:type rdf:Property ;
    rdfs:label 'Change Status' ;
    rdfs:comment 'Current workflow status of the Broker of Record change request within the Producer/Agency Management System lifecycle.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSplitBasis rdf:type rdf:Property ;
    rdfs:label 'Commission Split Basis' ;
    rdfs:comment 'Method used to calculate the commission split between incoming and outgoing producers when the BOR change occurs mid-term.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSplitIncomingPct rdf:type rdf:Property ;
    rdfs:label 'Commission Split Incoming Pct' ;
    rdfs:comment 'Percentage of the policy commission allocated to the incoming producer for the period from the BOR effective date to the policy term end.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionSplitOutgoingPct rdf:type rdf:Property ;
    rdfs:label 'Commission Split Outgoing Pct' ;
    rdfs:comment 'Percentage of the policy commission retained by the outgoing producer for the period from policy term start to the BOR effective date.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consentDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Consent Document Reference' ;
    rdfs:comment 'Document management system reference or identifier for the insured consent letter or ACORD BOR form on file. Supports audit and market conduct exams.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomingCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Incoming Commission Rate' ;
    rdfs:comment 'Commission rate (as a decimal percentage) to be applied to the incoming producer from the BOR effective date. Expressed as a proportion (e.g., 0.1200 = 12%).' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomingProducerAppointmentVerified rdf:type rdf:Property ;
    rdfs:label 'Incoming Producer Appointment Verified' ;
    rdfs:comment 'Indicates whether the incoming producer\'s appointment with the insurer in the policy state was verified as active at the time of the BOR change approval.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incomingProducerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Incoming Producer License Number' ;
    rdfs:comment 'State-issued producer license number of the incoming producer in the policy state at the time of the BOR change. Required for appointment validation.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomingProducerNpn rdf:type rdf:Property ;
    rdfs:label 'Incoming Producer Npn' ;
    rdfs:comment 'NIPR-issued National Producer Number of the incoming producer at the time of the BOR change request. Stored for regulatory audit trail.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredConsentDate rdf:type rdf:Property ;
    rdfs:label 'Insured Consent Date' ;
    rdfs:comment 'Date on which the named insured provided written consent authorizing the Broker of Record change, as required by most state DOI regulations.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuredConsentMethod rdf:type rdf:Property ;
    rdfs:label 'Insured Consent Method' ;
    rdfs:comment 'Method by which the named insured provided consent for the BOR change. Required for state DOI market conduct compliance documentation.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:midTermChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Mid Term Change Flag' ;
    rdfs:comment 'Indicates whether the BOR change is effective mid-term (True) or at renewal (False). Drives commission split logic and endorsement processing.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outgoingCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Outgoing Commission Rate' ;
    rdfs:comment 'Commission rate that was in effect for the outgoing producer prior to the BOR change. Used for commission clawback and reconciliation calculations.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outgoingProducerNpn rdf:type rdf:Property ;
    rdfs:label 'Outgoing Producer Npn' ;
    rdfs:comment 'NIPR-issued National Producer Number of the outgoing producer at the time of the BOR change. Stored for regulatory audit trail.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyState rdf:type rdf:Property ;
    rdfs:label 'Policy State' ;
    rdfs:comment 'Two-letter US state code of the policy\'s principal garaging or risk location. Determines which state DOI rules govern the BOR change process.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTermExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Policy Term Expiration Date' ;
    rdfs:comment 'Expiration date of the current policy term at the time of the BOR change. Used to calculate remaining term for commission split purposes.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyTermStartDate rdf:type rdf:Property ;
    rdfs:label 'Policy Term Start Date' ;
    rdfs:comment 'Start date of the current policy term at the time of the BOR change. Used to calculate pro-rata commission splits and earned premium attribution.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'Date on which the BOR change request was rejected. Populated only when change_status is Rejected.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'Coded reason for rejection of the BOR change request. Populated only when change_status is Rejected.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalBorFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Bor Flag' ;
    rdfs:comment 'Indicates whether this BOR change is designated to take effect at the next policy renewal rather than mid-term.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestDate rdf:type rdf:Property ;
    rdfs:label 'Request Date' ;
    rdfs:comment 'Calendar date on which the Broker of Record change request was formally submitted by the incoming producer or insured.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:writtenPremiumAtChange rdf:type rdf:Property ;
    rdfs:label 'Written Premium At Change' ;
    rdfs:comment 'Total written premium on the policy at the time of the BOR change. Used as the basis for commission split calculations and financial reporting.' ;
    rdfs:domain ind:BrokerOfRecordChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionPaymentId rdf:type rdf:Property ;
    rdfs:label 'Commission Payment Id' ;
    rdfs:comment 'Unique identifier for the commission payment record. Primary key.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commissionStatementId rdf:type rdf:Property ;
    rdfs:label 'Commission Statement Id' ;
    rdfs:comment 'Reference to the commission statement that this payment settles or partially settles.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionStatement .

ind:achTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Ach Trace Number' ;
    rdfs:comment 'ACH trace number for electronic payments, used for reconciliation and tracking.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:form1099ReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Form 1099 Reportable Flag' ;
    rdfs:comment 'Indicates whether this payment is reportable on IRS Form 1099-MISC or 1099-NEC for the producer.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payeeAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Payee Address Line1' ;
    rdfs:comment 'First line of the payee mailing address for check delivery or record keeping.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Payee Address Line2' ;
    rdfs:comment 'Second line of the payee mailing address, such as suite or apartment number.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeCity rdf:type rdf:Property ;
    rdfs:label 'Payee City' ;
    rdfs:comment 'City of the payee mailing address.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeCountryCode rdf:type rdf:Property ;
    rdfs:label 'Payee Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the payee mailing address.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeePostalCode rdf:type rdf:Property ;
    rdfs:label 'Payee Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the payee mailing address.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeStateCode rdf:type rdf:Property ;
    rdfs:label 'Payee State Code' ;
    rdfs:comment 'Two-letter state or province code for the payee mailing address.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'Gross amount of the commission payment before any adjustments or withholdings.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentMemo rdf:type rdf:Property ;
    rdfs:label 'Payment Memo' ;
    rdfs:comment 'Free-text memo or note describing the purpose or details of this commission payment.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueFlag rdf:type rdf:Property ;
    rdfs:label 'Reissue Flag' ;
    rdfs:comment 'Indicates whether this payment is a reissue of a previously voided or lost payment.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxYear rdf:type rdf:Property ;
    rdfs:label 'Tax Year' ;
    rdfs:comment 'Calendar year for which this payment is reported for tax purposes, used for 1099 reporting.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wireReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Wire Reference Number' ;
    rdfs:comment 'Wire transfer reference number for wire payments, used for reconciliation.' ;
    rdfs:domain ind:CommissionPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Base Commission Rate' ;
    rdfs:comment 'Standard commission rate expressed as a decimal percentage applied to written premium for this rule.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargebackEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Chargeback Eligible Flag' ;
    rdfs:comment 'Indicates whether commission paid under this rule is subject to chargeback if the policy cancels or premium is returned.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chargebackPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Chargeback Period Days' ;
    rdfs:comment 'Number of days from policy effective date during which commission chargeback applies if the policy cancels.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commissionBasisCode rdf:type rdf:Property ;
    rdfs:label 'Commission Basis Code' ;
    rdfs:comment 'Premium basis on which commission is calculated: written premium, earned premium, billed premium, or collected premium.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSplitFlag rdf:type rdf:Property ;
    rdfs:label 'Commission Split Flag' ;
    rdfs:comment 'Indicates whether this rule supports splitting commission among multiple producers.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contingentCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Contingent Commission Rate' ;
    rdfs:comment 'Additional performance-based commission rate applied when volume, profitability, or retention thresholds are met.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossRatioThreshold rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Threshold' ;
    rdfs:comment 'Maximum loss ratio threshold for contingent commission eligibility; expressed as a decimal percentage.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Commission Amount' ;
    rdfs:comment 'Ceiling amount for commission payment; if calculated commission exceeds this, the maximum is paid instead.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Commission Amount' ;
    rdfs:comment 'Floor amount for commission payment; if calculated commission is below this, the minimum is paid instead.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Override Commission Rate' ;
    rdfs:comment 'Hierarchical override commission rate paid to managing producers or agency principals on downline production.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTimingCode rdf:type rdf:Property ;
    rdfs:label 'Payment Timing Code' ;
    rdfs:comment 'Timing of commission payment under this rule: immediate upon transaction, monthly, quarterly, or annual settlement.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStateCode rdf:type rdf:Property ;
    rdfs:label 'Policy State Code' ;
    rdfs:comment 'Two-letter state or jurisdiction code where the policy is written; rule applies only to policies in this state.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumTierMaximum rdf:type rdf:Property ;
    rdfs:label 'Premium Tier Maximum' ;
    rdfs:comment 'Maximum written premium threshold for this rule to apply; enables tiered commission structures.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumTierMinimum rdf:type rdf:Property ;
    rdfs:label 'Premium Tier Minimum' ;
    rdfs:comment 'Minimum written premium threshold for this rule to apply; enables tiered commission structures.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:producerTypeCode rdf:type rdf:Property ;
    rdfs:label 'Producer Type Code' ;
    rdfs:comment 'Type of producer this rule applies to: agent, broker, managing general agent, or direct.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionRateThreshold rdf:type rdf:Property ;
    rdfs:label 'Retention Rate Threshold' ;
    rdfs:comment 'Minimum policy retention rate threshold for contingent commission eligibility; expressed as a decimal percentage.' ;
    rdfs:domain ind:Producers ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ruleNotes rdf:type rdf:Property ;
    rdfs:label 'Rule Notes' ;
    rdfs:comment 'Free-text notes or comments about this commission rule for internal reference and documentation.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Rule Sequence Number' ;
    rdfs:comment 'Ordering of this rule within the parent schedule for evaluation precedence.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceRuleReference rdf:type rdf:Property ;
    rdfs:label 'Source Rule Reference' ;
    rdfs:comment 'External reference or identifier for this rule in the source producer management or commission system.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Volume Threshold Amount' ;
    rdfs:comment 'Cumulative premium volume threshold that must be met for contingent or bonus commission rates to apply.' ;
    rdfs:domain ind:CommissionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supersededByScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Schedule Id' ;
    rdfs:comment 'Identifier of the commission schedule that replaces this one, if superseded.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionSchedule .

ind:bonusCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Bonus Commission Rate' ;
    rdfs:comment 'Bonus commission rate as a decimal percentage, awarded for exceptional performance or strategic initiatives.' ;
    rdfs:domain ind:CommissionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargebackProvision rdf:type rdf:Property ;
    rdfs:label 'Chargeback Provision' ;
    rdfs:comment 'Indicates whether commission is subject to chargeback if policy cancels within a specified period.' ;
