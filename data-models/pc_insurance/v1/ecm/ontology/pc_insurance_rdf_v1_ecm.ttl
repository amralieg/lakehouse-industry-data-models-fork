    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPeriod250NetPml rdf:type rdf:Property ;
    rdfs:label 'Return Period 250 Net Pml' ;
    rdfs:comment 'Net PML amount at 250-year return period after reinsurance recoveries.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPeriod500GrossPml rdf:type rdf:Property ;
    rdfs:label 'Return Period 500 Gross Pml' ;
    rdfs:comment 'Gross PML amount at 500-year return period before reinsurance.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPeriod500NetPml rdf:type rdf:Property ;
    rdfs:label 'Return Period 500 Net Pml' ;
    rdfs:comment 'Net PML amount at 500-year return period after reinsurance recoveries.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:runDate rdf:type rdf:Property ;
    rdfs:label 'Run Date' ;
    rdfs:comment 'Date when the PML modeling run was executed.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:runDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Run Duration Minutes' ;
    rdfs:comment 'Total elapsed time in minutes from run initiation to completion.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runName rdf:type rdf:Property ;
    rdfs:label 'Run Name' ;
    rdfs:comment 'Descriptive name assigned to the PML run for identification and reporting purposes.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runNumber rdf:type rdf:Property ;
    rdfs:label 'Run Number' ;
    rdfs:comment 'Business-assigned unique run number or code for external reference and tracking.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runStatus rdf:type rdf:Property ;
    rdfs:label 'Run Status' ;
    rdfs:comment 'Current lifecycle status of the PML modeling run.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run Timestamp' ;
    rdfs:comment 'Precise timestamp when the PML modeling run was initiated.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Classification of the PML run based on its business purpose and frequency.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Treaty Effective Date' ;
    rdfs:comment 'Effective date of the reinsurance treaty used in net PML calculations.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vulnerabilitySetVersion rdf:type rdf:Property ;
    rdfs:label 'Vulnerability Set Version' ;
    rdfs:comment 'Version identifier of the vulnerability functions used in this run.' ;
    rdfs:domain ind:PmlRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCatExposureId rdf:type rdf:Property ;
    rdfs:label 'Policy Cat Exposure Id' ;
    rdfs:comment 'Unique identifier for the policy catastrophe exposure record. One row per policy per CAT event or zone.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bordereauxReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Reporting Flag' ;
    rdfs:comment 'Indicates whether this exposure must be reported to reinsurers via bordereaux submissions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Deductible amount or percentage applicable to catastrophe claims for this exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleType rdf:type rdf:Property ;
    rdfs:label 'Deductible Type' ;
    rdfs:comment 'Type of deductible applied to catastrophe losses (flat dollar, percentage of TIV, franchise).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedGrossLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Gross Loss Amount' ;
    rdfs:comment 'Modeled or estimated gross loss amount for this exposure, used in FNOL triage and reinsurance bordereaux.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedNetLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Net Loss Amount' ;
    rdfs:comment 'Estimated net loss after deductible and policy limits, used for reserving and reinsurance recovery estimation.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Exposure Effective Date' ;
    rdfs:comment 'Date when the catastrophe exposure begins for this policy and location.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exposureExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Exposure Expiration Date' ;
    rdfs:comment 'Date when the catastrophe exposure ends for this policy and location.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exposureStatus rdf:type rdf:Property ;
    rdfs:label 'Exposure Status' ;
    rdfs:comment 'Current status of the catastrophe exposure record (active, expired, cancelled, suspended).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fnolTriagePriority rdf:type rdf:Property ;
    rdfs:label 'Fnol Triage Priority' ;
    rdfs:comment 'Priority level for FNOL triage based on estimated loss severity and policy characteristics.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceProgramCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Program Code' ;
    rdfs:comment 'Code identifying the reinsurance program or treaty applicable to this catastrophe exposure.' ;
    rdfs:domain ind:PolicyCatExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryId rdf:type rdf:Property ;
    rdfs:label 'Territory Id' ;
    rdfs:comment 'Unique identifier for the rating territory. Primary key.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aalContributionPct rdf:type rdf:Property ;
    rdfs:label 'Aal Contribution Pct' ;
    rdfs:comment 'Percentage contribution of this territory to the overall portfolio AAL for catastrophe risk management.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRate rdf:type rdf:Property ;
    rdfs:label 'Base Rate' ;
    rdfs:comment 'The base premium rate per unit of exposure for this territory, as filed with the DOI.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countyList rdf:type rdf:Property ;
    rdfs:label 'County List' ;
    rdfs:comment 'Comma-separated list of county names or FIPS codes included in this territory definition.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crimeIndex rdf:type rdf:Property ;
    rdfs:label 'Crime Index' ;
    rdfs:comment 'Composite crime index score for the territory, used in underwriting and pricing for property and liability lines.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureBase rdf:type rdf:Property ;
    rdfs:label 'Exposure Base' ;
    rdfs:comment 'The unit of exposure to which the rate or loss cost applies, such as per policy, per vehicle, per location, per 100 of payroll.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'Date on which the rate filing containing this territory definition was submitted to the Department of Insurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Number' ;
    rdfs:comment 'The official rate filing number assigned by the Department of Insurance for this territory definition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingStatus rdf:type rdf:Property ;
    rdfs:label 'Filing Status' ;
    rdfs:comment 'Current regulatory status of the rate filing containing this territory definition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Classification of the territory by geographic characteristics relevant to risk assessment and pricing.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossCost rdf:type rdf:Property ;
    rdfs:label 'Loss Cost' ;
    rdfs:comment 'The expected loss cost per unit of exposure for this territory, used in actuarial pricing and rate development.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moratoriumEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium Effective Date' ;
    rdfs:comment 'Date on which the current moratorium became effective, if applicable.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:moratoriumExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Moratorium Expiration Date' ;
    rdfs:comment 'Date on which the current moratorium is scheduled to expire, if applicable.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:territoryName rdf:type rdf:Property ;
    rdfs:label 'Territory Name' ;
    rdfs:comment 'Human-readable name or description of the territory, often referencing geographic boundaries or county groupings.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmlContributionPct rdf:type rdf:Property ;
    rdfs:label 'Pml Contribution Pct' ;
    rdfs:comment 'Percentage contribution of this territory to the overall portfolio PML for catastrophe risk management.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:populationDensity rdf:type rdf:Property ;
    rdfs:label 'Population Density' ;
    rdfs:comment 'Average population density per square mile for the territory, used in risk assessment and pricing.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protectionClassRange rdf:type rdf:Property ;
    rdfs:label 'Protection Class Range' ;
    rdfs:comment 'Range of ISO Public Protection Classification codes applicable to this territory for property rating.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateRelativity rdf:type rdf:Property ;
    rdfs:label 'Rate Relativity' ;
    rdfs:comment 'The filed rate relativity factor for this territory, representing the multiplicative adjustment to base rates.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residualMarketFlag rdf:type rdf:Property ;
    rdfs:label 'Residual Market Flag' ;
    rdfs:comment 'Indicates whether this territory is designated as a residual or involuntary market territory requiring special handling.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tier rdf:type rdf:Property ;
    rdfs:label 'Tier' ;
    rdfs:comment 'Tiering classification within the territory for additional rate segmentation, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tivConcentration rdf:type rdf:Property ;
    rdfs:label 'Tiv Concentration' ;
    rdfs:comment 'Total insured value concentration within this territory, used for exposure management and catastrophe aggregation.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwritingTier rdf:type rdf:Property ;
    rdfs:label 'Underwriting Tier' ;
    rdfs:comment 'Underwriting tier classification for this territory, indicating appetite and risk selection guidelines.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherZone rdf:type rdf:Property ;
    rdfs:label 'Weather Zone' ;
    rdfs:comment 'Code identifying the weather or climate zone for this territory, relevant for catastrophe and weather-related perils.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windPoolFlag rdf:type rdf:Property ;
    rdfs:label 'Wind Pool Flag' ;
    rdfs:comment 'Indicates whether this territory is subject to state wind pool or catastrophe fund requirements for coastal exposure.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zipCodeList rdf:type rdf:Property ;
    rdfs:label 'Zip Code List' ;
    rdfs:comment 'Comma-separated list of ZIP codes or ZIP code ranges included in this territory definition.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPeriodClaimfinancialsAccountingPeriodId rdf:type rdf:Property ;
    rdfs:label 'Prior Period Claimfinancials Accounting Period Id' ;
    rdfs:comment 'Reference to the immediately preceding accounting period. Supports period-over-period variance analysis, loss triangle chaining, and reserve roll-forward calculations.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimfinancialsAccountingPeriod .

ind:bordereauxPeriodCode rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Period Code' ;
    rdfs:comment 'Period code used in reinsurance bordereaux submissions to treaty reinsurers. Aligns cession, premium, and loss data to the reinsurer\'s reporting calendar.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calendarYear rdf:type rdf:Property ;
    rdfs:label 'Calendar Year' ;
    rdfs:comment 'Four-digit calendar year (January–December). Used for CY loss ratio, CY written premium, and CY combined ratio analytics per NAIC Schedule P.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeDate rdf:type rdf:Property ;
    rdfs:label 'Close Date' ;
    rdfs:comment 'Date on which the accounting period was officially closed (soft close). After this date, new transactions require a journal entry adjustment or period reopening.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Last calendar date included in this accounting period (inclusive). Transactions with an effective date on or before this date fall within the period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fiscalMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Month' ;
    rdfs:comment 'Month number (1–12) within the fiscal year. Used for monthly close cycles, premium booking, and loss reserve movements in the GL.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'Quarter number (1–4) within the fiscal year. Used for quarterly statutory filings, NAIC quarterly statements, and interim GAAP reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'Four-digit fiscal year to which this period belongs (e.g., 2024). Aligns with the company\'s statutory and GAAP reporting year.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fxRateToUsd rdf:type rdf:Property ;
    rdfs:label 'Fx Rate To Usd' ;
    rdfs:comment 'Exchange rate to USD applicable for this period\'s financial translations. Used for multi-currency consolidation in statutory and GAAP reporting.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glPeriodCode rdf:type rdf:Property ;
    rdfs:label 'Gl Period Code' ;
    rdfs:comment 'Period code as defined in the General Ledger system (Oracle/SAP). Used to reconcile premium, loss, and expense transactions between the data warehouse and the GL.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ifrs17ReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Ifrs17 Reporting Period' ;
    rdfs:comment 'Period identifier as used in IFRS 17 insurance contract reporting (e.g., \'2024-Q1\'). Supports CSM amortization, loss component tracking, and IFRS 17 disclosure requirements.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isQuarterEnd rdf:type rdf:Property ;
    rdfs:label 'Is Quarter End' ;
    rdfs:comment 'True if this period is the last month of a fiscal quarter, triggering quarterly NAIC statement preparation and interim GAAP reporting.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStubPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Stub Period' ;
    rdfs:comment 'True if this period is a partial period (fewer days than a standard month), such as a company formation period or mid-year fiscal year change.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isYearEnd rdf:type rdf:Property ;
    rdfs:label 'Is Year End' ;
    rdfs:comment 'True if this period represents the final period of the fiscal or calendar year, triggering year-end statutory close, NAIC Annual Statement preparation, and RBC calculations.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockDate rdf:type rdf:Property ;
    rdfs:label 'Lock Date' ;
    rdfs:comment 'Date on which the period was hard-locked, preventing any further postings. Supports SOX controls and statutory filing integrity.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossDevelopmentLag rdf:type rdf:Property ;
    rdfs:label 'Loss Development Lag' ;
    rdfs:comment 'Number of months elapsed from the accident year start to this period\'s end date. Used to position the period on loss development triangles for IBNR and IBNER estimation.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:naicStatementPeriod rdf:type rdf:Property ;
    rdfs:label 'Naic Statement Period' ;
    rdfs:comment 'NAIC filing period designation: Q1, Q2, Q3 for quarterly statements, or ANNUAL for the year-end NAIC Annual Statement. Drives statutory reporting schedules.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodBasis rdf:type rdf:Property ;
    rdfs:label 'Period Basis' ;
    rdfs:comment 'Actuarial and statutory basis: CY (Calendar Year), AY (Accident Year), PY (Policy Year), or FY (Fiscal Year). Drives loss triangle bucketing and Schedule P reporting.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodCode rdf:type rdf:Property ;
    rdfs:label 'Period Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the period (e.g., CY-2024-03 for calendar year 2024 March). Used in GL, statutory, and bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodDays rdf:type rdf:Property ;
    rdfs:label 'Period Days' ;
    rdfs:comment 'Number of calendar days in this accounting period. Used for daily pro-rata premium earning, exposure day calculations, and IFRS 17 coverage unit computations.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Human-readable label for the period (e.g., \'March 2024\', \'Q1 2024\', \'AY 2023\'). Used in reports, dashboards, and statutory filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodStatus rdf:type rdf:Property ;
    rdfs:label 'Period Status' ;
    rdfs:comment 'Current state of the period in the financial close lifecycle: OPEN (transactions posting), CLOSED (soft close), LOCKED (hard close, no further postings), REOPENED (adjustment window).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Granularity of the period: MONTHLY for standard close cycles, QUARTERLY for interim reporting, SEMI_ANNUAL, or ANNUAL for year-end statutory filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyYear rdf:type rdf:Property ;
    rdfs:label 'Policy Year' ;
    rdfs:comment 'Four-digit policy year for policy-year loss development. Losses and premium are bucketed by the year the policy was written, used in Schedule P and reinsurance bordereaux.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:premiumEarningMethod rdf:type rdf:Property ;
    rdfs:label 'Premium Earning Method' ;
    rdfs:comment 'Method used to earn written premium into earned premium during this period: PRO_RATA (daily pro-rata), RULE_OF_78, DAILY, or MONTHLY. Drives UEP and EP calculations.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reopenDate rdf:type rdf:Property ;
    rdfs:label 'Reopen Date' ;
    rdfs:comment 'Date on which a previously closed or locked period was reopened for adjustment postings. Null if the period has never been reopened.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingFramework rdf:type rdf:Property ;
    rdfs:label 'Reporting Framework' ;
    rdfs:comment 'Accounting framework under which this period is reported: SAP (Statutory Accounting Principles), GAAP (US GAAP/FASB), IFRS17 (IASB IFRS 17), or STATUTORY for state-specific filings.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulePPeriodLabel rdf:type rdf:Property ;
    rdfs:label 'Schedule P Period Label' ;
    rdfs:comment 'Label used to identify this period on NAIC Schedule P loss development exhibits (e.g., \'2024 1 Year\', \'2023 2 Years\'). Supports actuarial reserving and regulatory filing.' ;
    rdfs:domain ind:ClaimfinancialsAccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimExpenseId rdf:type rdf:Property ;
    rdfs:label 'Claim Expense Id' ;
    rdfs:comment 'Unique surrogate identifier for each claim expense transaction record. Primary key for the claim_expense table. One row per expense movement per claim exposure and accounting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimExpense .

ind:adjusterId rdf:type rdf:Property ;
    rdfs:label 'Adjuster Id' ;
    rdfs:comment 'Reference to the claims adjuster responsible for authorizing or submitting this expense. Links expense to the handling adjuster for workload and cost reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:approvedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Approved By Party Id' ;
    rdfs:comment 'Reference to the party (adjuster supervisor or manager) who approved this expense transaction. Required for audit trail and authority-level compliance.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:originalExpenseClaimExpenseId rdf:type rdf:Property ;
    rdfs:label 'Original Expense Claim Expense Id' ;
    rdfs:comment 'For reversal transactions, references the claim_expense_id of the original expense being reversed. Null for original (non-reversal) expense transactions.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimExpense .

ind:payeeId rdf:type rdf:Property ;
    rdfs:label 'Payee Id' ;
    rdfs:comment 'Reference to the party record of the vendor or service provider who rendered the service and generated this expense (e.g., law firm, medical examiner, appraiser).' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payee .

ind:financialTransactionId rdf:type rdf:Property ;
    rdfs:label 'Financial Transaction Id' ;
    rdfs:comment 'The native transaction identifier from the originating system of record (e.g., Guidewire ClaimCenter expense ID). Enables traceability back to the source system.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialTransaction .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Approval workflow status for the expense. Expenses above authority thresholds require supervisor or management approval before payment can be issued.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'Internal cost center or department code responsible for this expense. Supports management reporting, expense allocation, and budget variance analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'Exchange rate applied to convert the expense from transaction currency to functional currency at the transaction date. Stored for audit and restatement purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Amount' ;
    rdfs:comment 'Gross amount of the expense transaction in the policy currency before any adjustments or recoveries. Positive for charges; negative for reversals or credits.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseDate rdf:type rdf:Property ;
    rdfs:label 'Expense Date' ;
    rdfs:comment 'The date on which the expense was incurred or the service was rendered. Used for accident-year and policy-year LAE allocation in Schedule P reporting.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenseDescription rdf:type rdf:Property ;
    rdfs:label 'Expense Description' ;
    rdfs:comment 'Free-text description of the services rendered or expense incurred as provided by the adjuster or vendor. Used for audit review and dispute resolution.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseNumber rdf:type rdf:Property ;
    rdfs:label 'Expense Number' ;
    rdfs:comment 'Externally visible, human-readable identifier for this expense transaction. Used in vendor correspondence, GL postings, and audit trails.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseStatus rdf:type rdf:Property ;
    rdfs:label 'Expense Status' ;
    rdfs:comment 'Current workflow state of the expense transaction from initial entry through approval, payment, and potential voiding or dispute resolution.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseType rdf:type rdf:Property ;
    rdfs:label 'Expense Type' ;
    rdfs:comment 'Detailed classification of the nature of the expense. Drives GL account mapping and regulatory cost categorization. [ENUM-REF-CANDIDATE: legal_fee|expert_witness|medical_exam|investigation|appraisal|court_cost|adjuster_fee|other — promote to reference' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Amount' ;
    rdfs:comment 'Expense amount converted to the company functional currency (USD) using the exchange rate at transaction date. Used for consolidated statutory and GAAP reporting.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'The invoice or billing reference number issued by the vendor. Used for three-way matching (PO, receipt, invoice) and duplicate payment prevention.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Received Date' ;
    rdfs:comment 'Date the invoice was received by the claims department. Used to measure vendor billing timeliness and trigger payment due-date calculations.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isDccExpense rdf:type rdf:Property ;
    rdfs:label 'Is Dcc Expense' ;
    rdfs:comment 'Indicates whether this expense is classified as Defense and Cost Containment (DCC) per NAIC Schedule P definitions. Distinct from AO (Adjusting and Other) expenses.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecoverable rdf:type rdf:Property ;
    rdfs:label 'Is Recoverable' ;
    rdfs:comment 'Indicates whether this expense is subject to reinsurance recovery under a treaty or facultative agreement. Drives cession and bordereaux reporting.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laeCategory rdf:type rdf:Property ;
    rdfs:label 'Lae Category' ;
    rdfs:comment 'Classifies the expense into LAE sub-categories: ALAE (Allocated LAE), ULAE (Unallocated LAE), DCC (Defense and Cost Containment), or AO (Adjusting and Other). Required for Schedule P.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'The date on which the expense was actually disbursed to the vendor or payee. Null if the expense has not yet been paid. Used for cash-basis reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Amount' ;
    rdfs:comment 'Portion of this expense recoverable from reinsurers under applicable treaty or facultative agreements. Used in Schedule F and bordereaux reporting.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceEndDate rdf:type rdf:Property ;
    rdfs:label 'Service End Date' ;
    rdfs:comment 'End date of the service period covered by this expense. Together with service_start_date defines the billing period for period-based vendor engagements.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceStartDate rdf:type rdf:Property ;
    rdfs:label 'Service Start Date' ;
    rdfs:comment 'Start date of the service period covered by this expense (e.g., legal retainer period, expert engagement). Used for period-based expense accrual.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:siuReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Flag' ;
    rdfs:comment 'Indicates this expense has been flagged for SIU review due to suspected fraud, inflated billing, or unusual vendor patterns. Triggers SIU workflow.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimFinancialSnapshotId rdf:type rdf:Property ;
    rdfs:label 'Claim Financial Snapshot Id' ;
    rdfs:comment 'Unique surrogate key for each point-in-time financial position record per claim exposure and valuation date. Grain: one row per claim exposure per valuation date.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:caseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Case Reserve Amount' ;
    rdfs:comment 'Outstanding case reserve (OSLR) set by the adjuster for this claim exposure as of the valuation date. Represents the estimated future loss payment.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catastropheIndicator rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Indicator' ;
    rdfs:comment 'Indicates whether this claim exposure is associated with a declared catastrophe event. Drives CAT loss reporting and reinsurance CAT XL recovery.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cededIbnrAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Ibnr Amount' ;
    rdfs:comment 'Portion of the IBNR reserve ceded to reinsurers as of the valuation date. Used for net IBNR and Schedule F reinsurance reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Paid Amount' ;
    rdfs:comment 'Cumulative loss payments ceded to and recovered from reinsurers on this claim exposure through the valuation date.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Reserve Amount' ;
    rdfs:comment 'Portion of the outstanding case reserve ceded to reinsurers under treaty or facultative agreements as of the valuation date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Status' ;
    rdfs:comment 'Current adjudication status of the claim as of the valuation date. Drives reserve adequacy assessment and closure rate analytics.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTypeCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Type Code' ;
    rdfs:comment 'Specific coverage type within the LOB (e.g., BI, PD, COMP, COLL, MED, UMBI) identifying the peril or benefit being claimed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:developmentPeriod rdf:type rdf:Property ;
    rdfs:label 'Development Period' ;
    rdfs:comment 'Number of months elapsed from the accident year start to the valuation date. Used as the x-axis in loss development triangles (e.g., 12, 24, 36 months).' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ibnrReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Reserve Amount' ;
    rdfs:comment 'Actuarially allocated IBNR reserve for this claim exposure or cohort as of the valuation date. Includes IBNER development on known claims.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laeReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Lae Reserve Amount' ;
    rdfs:comment 'Case reserve for allocated loss adjustment expenses (ALAE/DCC) associated with this claim exposure as of the valuation date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netIncurredAmount rdf:type rdf:Property ;
    rdfs:label 'Net Incurred Amount' ;
    rdfs:comment 'Net retained total incurred loss after reinsurance cessions and recoveries. Key metric for net loss ratio and RBC capital calculations.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Net Reserve Amount' ;
    rdfs:comment 'Net retained case reserve after cessions to reinsurers (gross case reserve minus ceded reserve). Represents the company\'s retained liability.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Lae Amount' ;
    rdfs:comment 'Cumulative allocated loss adjustment expense (ALAE) payments made on this claim exposure through the valuation date.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Loss Amount' ;
    rdfs:comment 'Cumulative loss payments made on this claim exposure through the valuation date, net of recoveries. Excludes LAE payments.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Policy Limit Amount' ;
    rdfs:comment 'Maximum coverage limit applicable to this claim exposure as of the loss date. Used to cap incurred amounts and assess limit adequacy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodIncurredAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Incurred Amount' ;
    rdfs:comment 'Total incurred amount as of the immediately preceding valuation period. Enables period-over-period reserve development and redundancy/deficiency analysis.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Paid Amount' ;
    rdfs:comment 'Cumulative paid loss as of the immediately preceding valuation period. Used to compute incremental paid loss development in loss triangles.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveBasis rdf:type rdf:Property ;
    rdfs:label 'Reserve Basis' ;
    rdfs:comment 'Identifies the reserving methodology basis for this snapshot record (case, IBNR, LAE, ULAE, or bulk). Supports actuarial triangle segmentation.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Change Amount' ;
    rdfs:comment 'Change in total incurred from prior period to current valuation date (current incurred minus prior incurred). Positive = strengthening; negative = release.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Reserve Amount' ;
    rdfs:comment 'Estimated future salvage recovery reserved against this claim exposure as of the valuation date. Reduces net incurred loss.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sirAmount rdf:type rdf:Property ;
    rdfs:label 'Sir Amount' ;
    rdfs:comment 'Self-insured retention amount applicable to this claim exposure for large commercial accounts. Insurer pays above the SIR threshold.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:snapshotCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Snapshot Created Timestamp' ;
    rdfs:comment 'Timestamp when this financial snapshot record was first created in the data warehouse. Supports audit trail and data lineage for statutory reporting.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:snapshotStatus rdf:type rdf:Property ;
    rdfs:label 'Snapshot Status' ;
    rdfs:comment 'Lifecycle status of this financial snapshot record indicating whether it is the current active position or has been superseded by a later valuation.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Snapshot Updated Timestamp' ;
    rdfs:comment 'Timestamp when this financial snapshot record was last modified. Used to detect restatements and track reserve re-estimations over time.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:subrogationReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Reserve Amount' ;
    rdfs:comment 'Estimated future subrogation recovery reserved against this claim exposure as of the valuation date. Reduces net incurred loss.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalIncurredAmount rdf:type rdf:Property ;
    rdfs:label 'Total Incurred Amount' ;
    rdfs:comment 'Total incurred loss = paid loss + case reserve + IBNR allocation as of the valuation date. Primary metric for Schedule P and loss ratio reporting.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalIncurredLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Incurred Lae Amount' ;
    rdfs:comment 'Total incurred LAE = paid LAE + LAE reserve as of the valuation date. Used for combined ratio and expense ratio statutory reporting.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRecoveryCollectedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Recovery Collected Amount' ;
    rdfs:comment 'Cumulative subrogation, salvage, and other third-party recoveries actually collected on this claim exposure through the valuation date.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ulaeReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ulae Reserve Amount' ;
    rdfs:comment 'Allocated portion of the ULAE reserve for this claim exposure as of the valuation date. Covers overhead claims handling costs not directly assignable.' ;
    rdfs:domain ind:ClaimFinancialSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Date' ;
    rdfs:comment 'The as-of date for this financial snapshot. All reserve, paid, and incurred amounts reflect the financial position as of this date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalPaymentClaimPaymentId rdf:type rdf:Property ;
    rdfs:label 'Original Payment Claim Payment Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original payment record when this row represents a reissue or replacement. Null for original disbursements.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimPayment .

ind:underwritingLossHistoryId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Loss History Id' ;
    rdfs:comment 'Foreign key linking to coverage.loss_history. Business justification: Underwriters verify CLUE/MVR loss runs against internal payment history. Business process: loss_history records from submissions reference actual historical claim_payment' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LossHistory .

ind:apBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Ap Batch Number' ;
    rdfs:comment 'Identifier of the AP disbursement batch in which this payment was grouped for bank settlement. Used for batch reconciliation in Oracle/SAP AP module.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Authority Limit Amount' ;
    rdfs:comment 'Maximum payment amount the authorizing user was permitted to approve per the claims authority matrix at the time of authorization.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankAccountCode rdf:type rdf:Property ;
    rdfs:label 'Bank Account Code' ;
    rdfs:comment 'Internal code identifying the company bank account from which the payment was funded. Supports multi-bank disbursement and reconciliation workflows.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkEftReference rdf:type rdf:Property ;
    rdfs:label 'Check Eft Reference' ;
    rdfs:comment 'Check number or EFT transaction reference issued by the bank or payment processor. Used for bank reconciliation and stop-payment processing.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleOffsetAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Offset Amount' ;
    rdfs:comment 'Amount of the payment attributable to the insured\'s deductible or Self-Insured Retention (SIR) that is to be collected back from the policyholder.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Payment Amount' ;
    rdfs:comment 'Total gross amount disbursed before any deductions, withholdings, or offsets. Denominated in the currency indicated by currency_code.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:is1099Reportable rdf:type rdf:Property ;
    rdfs:label 'Is 1099 Reportable' ;
    rdfs:comment 'Indicates whether this payment must be reported to the IRS on Form 1099-MISC or 1099-NEC. Drives year-end tax reporting extract.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFinalPayment rdf:type rdf:Property ;
    rdfs:label 'Is Final Payment' ;
    rdfs:comment 'Indicates this payment closes the claim exposure financially. When true, triggers reserve release and exposure closure workflow in ClaimCenter.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStructuredSettlement rdf:type rdf:Property ;
    rdfs:label 'Is Structured Settlement' ;
    rdfs:comment 'Indicates whether this payment is part of a structured settlement annuity arrangement rather than a lump-sum disbursement.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCategory rdf:type rdf:Property ;
    rdfs:label 'Loss Category' ;
    rdfs:comment 'Detailed loss sub-category classifying the nature of the payment: Bodily Injury (BI), Property Damage (PD), Medical Payments (MP), Uninsured Motorist (UM), etc.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Actual amount disbursed to the payee after withholding and deductions. Net = gross_payment_amount minus withholding_amount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentAuthorizationCode rdf:type rdf:Property ;
    rdfs:label 'Payment Authorization Code' ;
    rdfs:comment 'Internal authorization or approval code assigned by the claims supervisor or authority matrix before payment release. Supports SOX payment controls.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Description' ;
    rdfs:comment 'Free-text narrative describing the purpose or nature of the payment (e.g., \'Partial settlement for dwelling damage\', \'Attorney fee disbursement\').' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Externally visible, human-readable payment reference number assigned by the claims payment system or AP module. Used for reconciliation and payee inquiries.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueDate rdf:type rdf:Property ;
    rdfs:label 'Reissue Date' ;
    rdfs:comment 'Date a replacement payment was reissued after a void or stop-payment. Links to the original payment via original_payment_id for audit trail.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceMemo rdf:type rdf:Property ;
    rdfs:label 'Remittance Memo' ;
    rdfs:comment 'Short memo line printed on the check or included in the EFT remittance advice to the payee. Typically includes claim number and coverage description.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateJurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction governing this payment for regulatory reporting and state DOI compliance purposes.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Stop Payment Flag' ;
    rdfs:comment 'Indicates a stop-payment order has been placed on this check with the issuing bank. Triggers reissue workflow and outstanding check reconciliation.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Amount' ;
    rdfs:comment 'Amount withheld from the gross payment for tax withholding, Medicare Set-Aside (MSA), or other statutory deductions before net disbursement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimfinancialsBordereauxLineId rdf:type rdf:Property ;
    rdfs:label 'Claimfinancials Bordereaux Line Id' ;
    rdfs:comment 'Unique surrogate primary key for one claim line in a reinsurance bordereaux submission. Grain: one row per claim exposure per bordereaux reporting period per reinsurance agreement.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bordereauxId rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Id' ;
    rdfs:comment 'Reference to the bordereaux batch submission header under which this line was transmitted to the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bordereaux .

ind:bordereauxType rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Type' ;
    rdfs:comment 'Indicates whether this bordereaux line is a loss bordereaux, premium bordereaux, or combined bordereaux submission.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheFlag rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Flag' ;
    rdfs:comment 'Indicates whether the underlying loss event is designated as a catastrophe, triggering CAT XL treaty layers and separate bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catastropheNumber rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Number' ;
    rdfs:comment 'Industry-standard catastrophe serial number (e.g., ISO PCS CAT number) assigned to the loss event, used to aggregate CAT bordereaux lines.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Alae Amount' ;
    rdfs:comment 'Reinsurer\'s share of allocated loss adjustment expenses (defense, investigation costs) directly attributable to this claim exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededCaseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Case Reserve Amount' ;
    rdfs:comment 'Reinsurer\'s share of the outstanding case reserve for this claim exposure, representing the ceded portion of estimated future loss payments.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Lae Amount' ;
    rdfs:comment 'Portion of loss adjustment expense ceded to the reinsurer under this agreement, recoverable alongside the ceded loss amount.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPaidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Paid Loss Amount' ;
    rdfs:comment 'Portion of actual loss payments made to claimants that is recoverable from the reinsurer under this cession as of the evaluation date.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionPct rdf:type rdf:Property ;
    rdfs:label 'Cession Pct' ;
    rdfs:comment 'Percentage of the gross loss ceded to the reinsurer under this agreement, expressed as a decimal (e.g., 0.7500 = 75%). Applies to quota share treaties.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:companyCode rdf:type rdf:Property ;
    rdfs:label 'Company Code' ;
    rdfs:comment 'Internal legal entity or writing company code identifying the cedant entity responsible for this cession, for multi-company group reporting.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Free-text or coded reason provided when the reinsurer disputes this bordereaux line, capturing the basis for the disagreement for resolution tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Date' ;
    rdfs:comment 'As-of date for the financial values (reserves, payments) reported on this bordereaux line, enabling point-in-time reinsurer reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossIncurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Incurred Loss Amount' ;
    rdfs:comment 'Total gross incurred loss (paid plus case reserve) for this claim exposure before reinsurance, as of the evaluation date.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Lae Amount' ;
    rdfs:comment 'Total gross loss adjustment expense (ALAE + ULAE) incurred on this claim exposure before reinsurance, as of the evaluation date.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current processing status of this bordereaux line in the reinsurer settlement workflow. [ENUM-REF-CANDIDATE: DRAFT|SUBMITTED|ACKNOWLEDGED|DISPUTED|SETTLED|VOIDED|AMENDED — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossDate rdf:type rdf:Property ;
    rdfs:label 'Loss Date' ;
    rdfs:comment 'Date of the underlying loss event (accident year anchor), used to determine which reinsurance treaty year applies to this cession.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossDevelopmentAmount rdf:type rdf:Property ;
    rdfs:label 'Loss Development Amount' ;
    rdfs:comment 'Change in ceded incurred loss between the current and prior bordereaux period for this claim line, representing adverse or favorable development.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'Policy number of the underlying insured policy to which the claim and cession relate, as reported on the bordereaux.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPeriodCededLossAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Ceded Loss Amount' ;
    rdfs:comment 'Ceded loss amount reported on the immediately preceding bordereaux period for this claim line, enabling period-over-period development tracking.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Recovery Status' ;
    rdfs:comment 'Status of the reinsurance recovery for this ceded claim line, indicating whether amounts have been collected, are outstanding, or are in dispute.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Date the claim was first reported (FNOL date), used for claims-made policy triggers and reinsurance reporting lag analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riAgreementType rdf:type rdf:Property ;
    rdfs:label 'Ri Agreement Type' ;
    rdfs:comment 'Indicates whether the reinsurance arrangement is a treaty (automatic) or facultative (individually negotiated) agreement.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riCollectedAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Collected Amount' ;
    rdfs:comment 'Amount actually received from the reinsurer against this bordereaux line to date, used to compute the outstanding reinsurance receivable.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Limit Amount' ;
    rdfs:comment 'Maximum reinsurance recovery available under the applicable treaty layer or facultative certificate for this claim exposure.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Recoverable Amount' ;
    rdfs:comment 'Total amount recoverable from the reinsurer on this line (ceded loss plus ceded LAE), representing the gross reinsurance asset on the balance sheet.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Ri Retention Amount' ;
    rdfs:comment 'Dollar amount of the loss retained by the cedant (self-insured retention or treaty retention layer) before reinsurance recovery applies.' ;
    rdfs:domain ind:ClaimfinancialsBordereauxLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Date this bordereaux line was transmitted to the reinsurer as part of the settlement batch.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:treatyType rdf:type rdf:Property ;
    rdfs:label 'Treaty Type' ;
    rdfs:comment 'Classification of the treaty structure: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), Catastrophe XL (CAT XL), or Aggregate. [ENUM-REF-CANDIDATE: QS|XOL|SL|CAT_XL|AGGREGATE|RETRO — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalTransactionFinancialTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Financial Transaction Id' ;
    rdfs:comment 'For reversal or correction transactions, references the original financial_transaction_id that this entry offsets or corrects. Null for original (non-reversal) postings.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialTransaction .

ind:salvageId rdf:type rdf:Property ;
    rdfs:label 'Salvage Id' ;
    rdfs:comment 'Reference to the associated salvage record when this financial transaction represents a salvage recovery. Links the GL posting to the salvage disposition record.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Salvage .

ind:cededAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Amount' ;
    rdfs:comment 'Portion of the gross amount ceded to reinsurers under applicable treaty or facultative agreements. Used for net retained loss calculation and reinsurance bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseCategory rdf:type rdf:Property ;
    rdfs:label 'Expense Category' ;
    rdfs:comment 'For expense-type transactions, classifies the LAE component: DCC (Defense and Cost Containment), AO (Adjusting and Other), ULAE (Unallocated Loss Adjustment Expense). Null for non-expense transactions.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'Date and time when this financial transaction was posted to the general ledger and claims system. Used for audit trail and reconciliation with GL batch runs.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priorBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Balance Amount' ;
    rdfs:comment 'The reserve or financial balance on the claim exposure immediately before this transaction was applied. Enables incremental change analysis and reserve development tracking.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceRecoverableIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Indicator' ;
    rdfs:comment 'Indicates whether any portion of this financial transaction is recoverable from reinsurers under a treaty or facultative agreement. Drives reinsurance bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveType rdf:type rdf:Property ;
    rdfs:label 'Reserve Type' ;
    rdfs:comment 'For reserve transactions, identifies the reserve category: CASE (case reserve set by adjuster), IBNR (incurred but not reported), IBNER (incurred but not enough reported), LAE (loss adjustment expense reserve). Null for non-reserve transactions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Indicates whether this transaction is a reversal (offsetting entry) of a previously posted financial transaction. True if this is a correcting reversal entry.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Reference' ;
    rdfs:comment 'The native transaction identifier or reference number from the originating source system (e.g., ClaimCenter transaction ID, GL journal entry number). Enables cross-system reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDescription rdf:type rdf:Property ;
    rdfs:label 'Transaction Description' ;
    rdfs:comment 'Free-text narrative describing the reason for or nature of this financial posting (e.g., \'Initial case reserve set at FNOL\', \'Partial indemnity payment to claimant\'). Supports adjuster notes.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionSubtype rdf:type rdf:Property ;
    rdfs:label 'Transaction Subtype' ;
    rdfs:comment 'Granular classification within the transaction type. Examples: CASE_RESERVE, IBNR_RESERVE, LAE_RESERVE, INDEMNITY_PAYMENT, MEDICAL_PAYMENT, SUBROGATION_RECOVERY, SALVAGE_RECOVERY, REINSURANCE_RECOVERY, DCC_EXPENSE, AO_EXPENSE.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ibnrEstimateId rdf:type rdf:Property ;
    rdfs:label 'Ibnr Estimate Id' ;
    rdfs:comment 'Unique surrogate primary key for each IBNR/IBNER actuarial estimate record. One row per LOB, accident year, and valuation date combination per actuarial run.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuaryPartyId rdf:type rdf:Property ;
    rdfs:label 'Actuary Party Id' ;
    rdfs:comment 'Reference to the Party record of the credentialed actuary (FCAS/ACAS) who reviewed and signed off on this IBNR estimate per NAIC actuarial opinion requirements.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:underwritingRiskScoreId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Risk Score Id' ;
    rdfs:comment 'Foreign key linking to coverage.underwriting_risk_score. Business justification: Actuarial IBNR models segment by underwriting risk score band to reflect loss emergence patterns by risk tier.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnderwritingRiskScore .

ind:actuarialNotes rdf:type rdf:Property ;
    rdfs:label 'Actuarial Notes' ;
    rdfs:comment 'Free-text field for the actuary to document material assumptions, data limitations, method selections, or qualifications associated with this IBNR estimate.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialRunNumber rdf:type rdf:Property ;
    rdfs:label 'Actuarial Run Number' ;
    rdfs:comment 'Identifier for the actuarial reserving system batch run that produced this estimate. Enables traceability back to the specific model run in the Data Warehouse/Actuarial Reserving System.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarySignoffDate rdf:type rdf:Property ;
    rdfs:label 'Actuary Signoff Date' ;
    rdfs:comment 'Date on which the credentialed actuary formally approved and signed off on this IBNR estimate for inclusion in the statutory actuarial opinion or management reserve review.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ageToAgeFactor rdf:type rdf:Property ;
    rdfs:label 'Age To Age Factor' ;
    rdfs:comment 'Selected cumulative loss development factor (LDF) from current age to ultimate, used to project reported or paid losses to their ultimate value in the chain ladder method.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caseReserveAmt rdf:type rdf:Property ;
    rdfs:label 'Case Reserve Amt' ;
    rdfs:comment 'Outstanding case reserves (OSLR) held by claims adjusters for known reported claims as of the valuation date. Excludes IBNR and LAE reserves.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCountReported rdf:type rdf:Property ;
    rdfs:label 'Claim Count Reported' ;
    rdfs:comment 'Number of claims reported to the insurer for this accident year and LOB as of the valuation date. Used in frequency-severity IBNR methods and claim count development.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimCountUltimate rdf:type rdf:Property ;
    rdfs:label 'Claim Count Ultimate' ;
    rdfs:comment 'Actuarially selected ultimate number of claims expected for this accident year and LOB, including unreported claims. Used in frequency-severity IBNR estimation.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:committeeApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Committee Approval Date' ;
    rdfs:comment 'Date on which the reserve committee or senior management formally approved this IBNR estimate for booking to the general ledger and statutory financial statements.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:confidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Confidence Level' ;
    rdfs:comment 'Statistical confidence level associated with the IBNR estimate (e.g., 0.75 = 75th percentile). Used in risk-based capital (RBC) and ORSA reserve adequacy assessments.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeLdf rdf:type rdf:Property ;
    rdfs:label 'Cumulative Ldf' ;
    rdfs:comment 'Product of all age-to-age factors from current maturity to ultimate, including the tail factor. Applied to reported or paid losses to derive the selected ultimate.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'Operational system from which loss triangle data was sourced for this estimate (e.g., Data Warehouse/Actuarial Reserving System, ClaimCenter, manual upload).' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:developmentMethod rdf:type rdf:Property ;
    rdfs:label 'Development Method' ;
    rdfs:comment 'Actuarial method used to estimate IBNR (e.g., Chain Ladder, Bornhuetter-Ferguson, Cape Cod, Clark LDF, Frequency-Severity). [ENUM-REF-CANDIDATE: chain_ladder|bornhuetter_ferguson|cape_cod|clark_ldf|frequency_severity|expected_loss — promote to reference' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earnedPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Amt' ;
    rdfs:comment 'Net earned premium for this accident year and LOB as of the valuation date, used as the denominator for loss ratio calculations and ELR derivation.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimateNumber rdf:type rdf:Property ;
    rdfs:label 'Estimate Number' ;
    rdfs:comment 'Human-readable business identifier for this actuarial estimate record, used in actuarial opinion letters, Schedule P filings, and reserving committee presentations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimateType rdf:type rdf:Property ;
    rdfs:label 'Estimate Type' ;
    rdfs:comment 'Distinguishes the type of actuarial reserve estimate: pure IBNR (unreported claims), IBNER (development on known claims), total IBNR, or LAE IBNR.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedLossRatio rdf:type rdf:Property ;
    rdfs:label 'Expected Loss Ratio' ;
    rdfs:comment 'A priori expected loss ratio used in Bornhuetter-Ferguson and Cape Cod methods, derived from pricing or industry benchmarks. Expressed as a decimal (e.g., 0.65 = 65%).' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:highEstimateAmt rdf:type rdf:Property ;
    rdfs:label 'High Estimate Amt' ;
    rdfs:comment 'Upper bound of the actuarial range of reasonable IBNR estimates as required by ASOP No. 43. Supports reserve adequacy disclosures in the actuarial opinion.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnerAmt rdf:type rdf:Property ;
    rdfs:label 'Ibner Amt' ;
    rdfs:comment 'Estimated development on known reported claims where current case reserves are expected to be inadequate. Subset of total IBNR for IBNER-specific tracking.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnrAmt rdf:type rdf:Property ;
    rdfs:label 'Ibnr Amt' ;
    rdfs:comment 'Actuarially estimated reserve for losses incurred but not yet reported to the insurer as of the valuation date. Core output of this estimate record.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnrClaimCount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Claim Count' ;
    rdfs:comment 'Estimated number of claims incurred but not yet reported as of the valuation date. Equals ultimate claim count minus reported claim count.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCatIncluded rdf:type rdf:Property ;
    rdfs:label 'Is Cat Included' ;
    rdfs:comment 'Indicates whether catastrophe (CAT) losses are included in this IBNR estimate. Actuaries often produce separate ex-CAT and total estimates for Schedule P and PML analysis.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReinsuranceNet rdf:type rdf:Property ;
    rdfs:label 'Is Reinsurance Net' ;
    rdfs:comment 'Indicates whether this IBNR estimate is net of reinsurance recoveries (true) or gross of reinsurance (false). Both gross and net estimates are required for Schedule F and IFRS 17.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laeIbnrAmt rdf:type rdf:Property ;
    rdfs:label 'Lae Ibnr Amt' ;
    rdfs:comment 'Actuarially estimated reserve for unallocated and allocated loss adjustment expenses (ULAE/ALAE) on unreported and underdeveloped claims as of the valuation date.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lobDescription rdf:type rdf:Property ;
    rdfs:label 'Lob Description' ;
    rdfs:comment 'Human-readable name of the line of business corresponding to lob_code, such as Commercial Multi-Peril, Personal Auto Liability, or Homeowners.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowEstimateAmt rdf:type rdf:Property ;
    rdfs:label 'Low Estimate Amt' ;
    rdfs:comment 'Lower bound of the actuarial range of reasonable IBNR estimates as required by ASOP No. 43. Supports reserve adequacy disclosures in the actuarial opinion.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidLossesAmt rdf:type rdf:Property ;
    rdfs:label 'Paid Losses Amt' ;
    rdfs:comment 'Cumulative loss payments made through the valuation date for this accident year and LOB, net of recoveries. Used in paid loss development triangle.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentDeveloped rdf:type rdf:Property ;
    rdfs:label 'Percent Developed' ;
    rdfs:comment 'Reciprocal of the cumulative LDF, representing the estimated proportion of ultimate losses already reported or paid as of the valuation date (e.g., 0.80 = 80% developed).' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorIbnrAmt rdf:type rdf:Property ;
    rdfs:label 'Prior Ibnr Amt' ;
    rdfs:comment 'IBNR estimate from the immediately preceding valuation date for this accident year and LOB. Enables period-over-period reserve development and redundancy/deficiency analysis.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportedLossesAmt rdf:type rdf:Property ;
    rdfs:label 'Reported Losses Amt' ;
    rdfs:comment 'Cumulative paid losses plus case reserves (OSLR) as of the valuation date for this accident year and LOB. Serves as the starting point for IBNR development.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveChangeAmt rdf:type rdf:Property ;
    rdfs:label 'Reserve Change Amt' ;
    rdfs:comment 'Change in IBNR estimate from prior valuation to current valuation (current minus prior). Positive indicates reserve strengthening; negative indicates redundancy release.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservingBasis rdf:type rdf:Property ;
    rdfs:label 'Reserving Basis' ;
    rdfs:comment 'Accounting basis under which this IBNR estimate is prepared: Statutory Accounting Principles (SAP), US GAAP, IFRS 17, or internal management basis.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tailFactor rdf:type rdf:Property ;
    rdfs:label 'Tail Factor' ;
    rdfs:comment 'Loss development factor applied beyond the last observed development period to account for late-emerging losses. Critical for long-tail lines such as GL, WC, and medical malpractice.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triangleMaturityMonths rdf:type rdf:Property ;
    rdfs:label 'Triangle Maturity Months' ;
    rdfs:comment 'Age of the accident year in months as of the valuation date (e.g., 12, 24, 36). Identifies the column position in the loss development triangle used for this estimate.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ulr rdf:type rdf:Property ;
    rdfs:label 'Ulr' ;
    rdfs:comment 'Selected ultimate loss ratio for this accident year and LOB, calculated as ultimate loss amount divided by earned premium. Key actuarial KPI for reserving adequacy.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateLossAmt rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Amt' ;
    rdfs:comment 'Actuary-selected ultimate loss estimate for this accident year and LOB, representing total expected losses at full development. Equals reported losses plus IBNR.' ;
    rdfs:domain ind:IbnrEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laeAllocationId rdf:type rdf:Property ;
    rdfs:label 'Lae Allocation Id' ;
    rdfs:comment 'Unique surrogate identifier for each LAE allocation record. Grain: one row per ULAE allocation transaction per claim exposure per accounting period.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalAllocationLaeAllocationId rdf:type rdf:Property ;
    rdfs:label 'Original Allocation Lae Allocation Id' ;
    rdfs:comment 'For reversal or adjustment records, references the original allocation being corrected, enabling audit trail of allocation amendments.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LaeAllocation .

ind:actuarialReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Actuarial Review Flag' ;
    rdfs:comment 'Indicates this allocation record has been flagged for actuarial review due to anomalous weight, amount, or method deviation.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allocatedAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Alae Amount' ;
    rdfs:comment 'The dollar amount of ALAE directly assigned to this claim exposure, distinct from ULAE which is spread via actuarial method.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocatedUlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Ulae Amount' ;
    rdfs:comment 'The dollar amount of ULAE allocated to this specific claim exposure for the accounting period using the selected actuarial method.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Amount' ;
    rdfs:comment 'The denominator value for this claim exposure used in the allocation calculation (e.g., paid loss amount, incurred loss amount, or claim count).' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasisCode rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Code' ;
    rdfs:comment 'The denominator basis used to spread ULAE across claim exposures (e.g., paid losses, incurred losses, claim count, earned premium).' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Allocation Method Code' ;
    rdfs:comment 'Actuarial method used to allocate ULAE to individual claim exposures. [ENUM-REF-CANDIDATE: PAID_TO_PAID|KITTEL|BORNHUETTER_FERGUSON|DEVELOPMENT|BUDGETED|OTHER — promote to reference product]' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationMethodName rdf:type rdf:Property ;
    rdfs:label 'Allocation Method Name' ;
    rdfs:comment 'Human-readable name of the actuarial allocation method applied (e.g., Paid-to-Paid, Kittel Method), for reporting and audit trail.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Number' ;
    rdfs:comment 'Business-facing unique identifier for this allocation transaction, used in actuarial bordereaux and Schedule P reporting.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationRunDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Run Date' ;
    rdfs:comment 'The date on which the actuarial allocation batch run was executed, used for version control and audit of actuarial estimates.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationRunNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Run Number' ;
    rdfs:comment 'Identifier for the actuarial batch run that produced this allocation, enabling full traceability and re-run comparison across allocation cycles.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Status' ;
    rdfs:comment 'Current lifecycle state of the allocation record within the actuarial reserving and GL posting workflow.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationWeight rdf:type rdf:Property ;
    rdfs:label 'Allocation Weight' ;
    rdfs:comment 'The proportional weight assigned to this claim exposure in the ULAE allocation calculation, expressed as a decimal fraction (0 to 1).' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossNetIndicator rdf:type rdf:Property ;
    rdfs:label 'Gross Net Indicator' ;
    rdfs:comment 'Specifies whether this allocation represents gross (before reinsurance), net (after reinsurance), or ceded LAE for statutory reporting.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laeTypeCode rdf:type rdf:Property ;
    rdfs:label 'Lae Type Code' ;
    rdfs:comment 'Classifies the LAE component being allocated: ULAE (Unallocated), ALAE (Allocated), DCC (Defense & Cost Containment), or AO (Adjusting & Other).' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedDate rdf:type rdf:Property ;
    rdfs:label 'Posted Date' ;
    rdfs:comment 'The date this allocation was posted to the General Ledger, used for reconciliation between actuarial and accounting records.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceNetIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Net Indicator' ;
    rdfs:comment 'Indicates whether the allocated LAE amount is net of reinsurance recoveries, distinguishing gross vs. net LAE for Schedule F reporting.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Lae Amount' ;
    rdfs:comment 'Sum of allocated ULAE and ALAE for this claim exposure and accounting period, used for combined LAE reporting on Schedule P.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPoolBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Total Pool Basis Amount' ;
    rdfs:comment 'The total denominator (basis) amount across all claim exposures in the allocation pool, used to verify allocation weight calculations.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPoolUlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Pool Ulae Amount' ;
    rdfs:comment 'The total ULAE pool amount for the LOB and accounting period from which this allocation is drawn, enabling reconciliation to the pool total.' ;
    rdfs:domain ind:LaeAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossTriangleId rdf:type rdf:Property ;
    rdfs:label 'Loss Triangle Id' ;
    rdfs:comment 'Unique surrogate identifier for each loss development triangle row. One row per cohort, development period, and triangle type combination.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossApprovedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Loss Approved By Party Id' ;
    rdfs:comment 'References the appointed actuary or senior reviewer who approved this triangle cell for statutory filing. Required for NAIC Annual Statement certification.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:lossPartyId rdf:type rdf:Property ;
    rdfs:label 'Loss Party Id' ;
    rdfs:comment 'References the actuary or analyst responsible for selecting development factors and ultimate estimates for this triangle cell. Required for ORSA and SOX sign-off.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:accidentHalfYear rdf:type rdf:Property ;
    rdfs:label 'Accident Half Year' ;
    rdfs:comment 'Semi-annual sub-period within the cohort year (e.g., 2022-H1, 2022-H2) for lines requiring half-year granularity such as short-tail property.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseAlaeReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Case Alae Reserve Amount' ;
    rdfs:comment 'Outstanding case reserve for allocated loss adjustment expenses (ALAE) on known open claims in this cohort as of the evaluation date.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCountClosed rdf:type rdf:Property ;
    rdfs:label 'Claim Count Closed' ;
    rdfs:comment 'Cumulative count of claims closed (with or without payment) for this cohort as of the evaluation date. Used in closure rate and tail factor analysis.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimCountOpen rdf:type rdf:Property ;
    rdfs:label 'Claim Count Open' ;
    rdfs:comment 'Count of claims still open (RBNS) for this cohort as of the evaluation date. Derived operationally as reported minus closed; stored for audit and triangle integrity.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cohortType rdf:type rdf:Property ;
    rdfs:label 'Cohort Type' ;
    rdfs:comment 'Defines the basis for grouping losses into cohort rows: Accident Year (AY), Policy Year (PY), Calendar Year (CY), or Report Year. Determines triangle orientation.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cohortYear rdf:type rdf:Property ;
    rdfs:label 'Cohort Year' ;
    rdfs:comment 'The four-digit year identifying the loss cohort row (e.g., accident year 2021, policy year 2020). Forms the vertical axis of the development triangle.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:developmentFactor rdf:type rdf:Property ;
    rdfs:label 'Development Factor' ;
    rdfs:comment 'Cumulative loss development factor (LDF) from this development period to ultimate, as selected by the actuary. Used to project ultimate losses from current incurred.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Amount' ;
    rdfs:comment 'Earned premium for the cohort year used as the denominator in loss ratio calculations. Enables calendar-year and accident-year loss ratio derivation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:groupCode rdf:type rdf:Property ;
    rdfs:label 'Group Code' ;
    rdfs:comment 'NAIC group code for the insurance holding company group. Enables consolidated group-level Schedule P and RBC reporting across affiliated entities.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ibnrAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Alae Amount' ;
    rdfs:comment 'Actuarial IBNR estimate for allocated loss adjustment expenses for this cohort. Combined with case ALAE reserve to form total ALAE reserve.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnrAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Amount' ;
    rdfs:comment 'Actuarial estimate of losses incurred but not yet reported (IBNR), including IBNER development, for this cohort as of the evaluation date.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Incurred Loss Amount' ;
    rdfs:comment 'Total incurred losses = paid losses + case reserves for this cohort and development period. Excludes IBNR. Used in loss ratio and Schedule P reporting.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDiagonal rdf:type rdf:Property ;
    rdfs:label 'Is Diagonal' ;
    rdfs:comment 'True if this cell falls on the latest diagonal of the triangle (most recent evaluation for each cohort year). Used to filter current reserve position for reporting.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTailPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Tail Period' ;
    rdfs:comment 'True if this development period is beyond the last observed data point and the amount is a tail-factor projection rather than an observed value.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lobName rdf:type rdf:Property ;
    rdfs:label 'Lob Name' ;
    rdfs:comment 'Human-readable name of the line of business corresponding to lob_code, such as Private Passenger Auto Liability or Commercial General Liability.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Alae Amount' ;
    rdfs:comment 'Cumulative paid allocated loss adjustment expenses (ALAE/DCC) for this cohort as of the evaluation date. Reported separately on NAIC Schedule P.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodUltimateAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Ultimate Amount' ;
    rdfs:comment 'Ultimate loss estimate for this cohort from the prior evaluation period. Enables period-over-period reserve development and redundancy/deficiency analysis.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceProgramType rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Program Type' ;
    rdfs:comment 'Identifies the reinsurance structure applied when gross_net_indicator is net or ceded. Supports Schedule F and reinsurance bordereaux reporting.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveDevelopmentAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Development Amount' ;
    rdfs:comment 'Change in ultimate loss estimate from prior to current evaluation period (favorable = negative, adverse = positive). Key metric for Schedule P reserve adequacy.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservingMethod rdf:type rdf:Property ;
    rdfs:label 'Reserving Method' ;
    rdfs:comment 'Actuarial method used to estimate ultimate losses for this triangle cell. [ENUM-REF-CANDIDATE: chain_ladder|bornhuetter_ferguson|cape_cod|frequency_severity|clark_ldf|benktander|average_hindsight — promote to reference product]' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triangleRunNumber rdf:type rdf:Property ;
    rdfs:label 'Triangle Run Number' ;
    rdfs:comment 'References the actuarial reserving run or batch that produced this triangle snapshot, enabling version comparison across evaluation dates.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triangleStatus rdf:type rdf:Property ;
    rdfs:label 'Triangle Status' ;
    rdfs:comment 'Workflow status of this triangle cell within the actuarial reserving cycle. Approved and published cells are used for statutory filings; superseded cells are retained for audit.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triangleType rdf:type rdf:Property ;
    rdfs:label 'Triangle Type' ;
    rdfs:comment 'Identifies the financial measure populating this triangle cell. [ENUM-REF-CANDIDATE: paid_loss|incurred_loss|case_reserve|ibnr|paid_alae|incurred_alae|paid_ulae|lae_total — promote to reference product]' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ultimateAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ultimate Alae Amount' ;
    rdfs:comment 'Actuarial estimate of total ultimate ALAE for this cohort = paid ALAE + case ALAE reserve + IBNR ALAE. Used in combined ratio and Schedule P analytics.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Amount' ;
    rdfs:comment 'Actuarial estimate of total ultimate losses for this cohort = incurred losses + IBNR. The primary output of the reserving process used in Schedule P.' ;
    rdfs:domain ind:LossTriangle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writtenPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Written Premium Amount' ;
    rdfs:comment 'Direct written premium (DPW) for the cohort year. Used alongside earned premium for policy year and accident year loss ratio benchmarking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredCurrencyId rdf:type rdf:Property ;
    rdfs:label 'Preferred Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: International payee management requires currency master for payment processing in payee\'s preferred currency, withholding tax calculation, bank account validation, and 1099/tax reporting.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line1' ;
    rdfs:comment 'Primary street address line for the payee. Used for check mailing, 1099 form delivery, and OFAC/fraud screening. Required for all check-based payment methods.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line2' ;
    rdfs:comment 'Secondary address line (suite, apartment, unit, floor) for the payee. Supplements address_line1 for complete mailing address on checks and 1099 forms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attorneyBarNumber rdf:type rdf:Property ;
    rdfs:label 'Attorney Bar Number' ;
    rdfs:comment 'State bar license number for payees classified as attorneys. Used to validate attorney payees in ClaimCenter and supports regulatory reporting of legal expense payments.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backupWithholdingFlag rdf:type rdf:Property ;
    rdfs:label 'Backup Withholding Flag' ;
    rdfs:comment 'Indicates whether the payee is subject to IRS backup withholding (currently 24%). Set when TIN is missing, unverified, or IRS notifies the payer of withholding obligation.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number' ;
    rdfs:comment 'Payee\'s bank account number for EFT/ACH disbursements. Stored in tokenized or encrypted form per PCI DSS and GLBA requirements. Required when payment_method is EFT or wire.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotPayFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Pay Flag' ;
    rdfs:comment 'Hard stop flag that prevents any payment from being issued to this payee. Set by compliance, SIU, or legal hold. Overrides all payment authorizations until manually cleared.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:email rdf:type rdf:Property ;
    rdfs:label 'Email' ;
    rdfs:comment 'Primary email address for the payee. Used for EFT remittance advice delivery, payment notifications, and electronic 1099 delivery where consent is obtained.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Indicates whether the payee is a natural person (individual) or a legal entity (organization). Determines which tax identification type applies and governs 1099/W-9 requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Flag' ;
    rdfs:comment 'Indicates whether the Fraud Detection/SIU system has flagged this payee as a potential fraud risk based on pattern analysis, prior SIU findings, or external data sources (e.g., NICB).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:guardianName rdf:type rdf:Property ;
    rdfs:label 'Guardian Name' ;
    rdfs:comment 'Full legal name of the court-appointed guardian or conservator when the payee is a minor or legally incapacitated. Payments are issued in the guardian\'s name on behalf of the payee.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMinor rdf:type rdf:Property ;
    rdfs:label 'Is Minor' ;
    rdfs:comment 'Indicates whether the payee is a minor (under 18). Triggers guardian/conservator payment controls, court approval requirements, and special handling in ClaimCenter payment workflows.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lienHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Lien Holder Flag' ;
    rdfs:comment 'Indicates whether the payee holds a lien or security interest on the insured property. When true, the payee must be co-payee on property damage payments per standard mortgage/lien clauses.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ofacMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Ofac Match Flag' ;
    rdfs:comment 'Indicates whether the payee returned a potential match against the OFAC SDN list during screening. A true value triggers a compliance hold and manual review before payment release.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ofacScreenDate rdf:type rdf:Property ;
    rdfs:label 'Ofac Screen Date' ;
    rdfs:comment 'Most recent date on which the payee was screened against the OFAC SDN and consolidated sanctions lists. Supports periodic re-screening compliance requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ofacScreened rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened' ;
    rdfs:comment 'Indicates whether the payee has been screened against the OFAC Specially Designated Nationals (SDN) list. Payments to blocked persons are prohibited under U.S. sanctions law.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payeeStatus rdf:type rdf:Property ;
    rdfs:label 'Payee Status' ;
    rdfs:comment 'Current lifecycle state of the payee record. Blocked payees cannot receive payments until cleared by SIU or compliance review. Drives payment eligibility checks in ClaimCenter.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeType rdf:type rdf:Property ;
    rdfs:label 'Payee Type' ;
    rdfs:comment 'Classifies the payee\'s role in the payment transaction. Drives 1099 reporting rules, authority limits, and payment workflow routing within ClaimCenter.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phone rdf:type rdf:Property ;
    rdfs:label 'Phone' ;
    rdfs:comment 'Primary contact phone number for the payee. Used for payment confirmation, returned check follow-up, and EFT pre-notification as required by NACHA rules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdType rdf:type rdf:Property ;
    rdfs:label 'Tax Id Type' ;
    rdfs:comment 'Classifies the tax_id field: SSN (Social Security Number), FEIN (Federal Employer Identification Number), ITIN (Individual Taxpayer Identification Number), or EIN (Employer Identification Number).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdVerified rdf:type rdf:Property ;
    rdfs:label 'Tax Id Verified' ;
    rdfs:comment 'Indicates whether the payee\'s TIN has been validated against IRS TIN Matching or equivalent verification service. Required before issuing 1099 forms.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Number' ;
    rdfs:comment 'Federal tax identifier for the payee: Social Security Number (SSN) for individuals or Federal Employer Identification Number (FEIN) for organizations. Required for IRS 1099 reporting.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCode rdf:type rdf:Property ;
    rdfs:label 'Vendor Code' ;
    rdfs:comment 'Internal vendor identifier assigned by the Accounts Payable system (Oracle/SAP) for payees classified as vendors (e.g., repair shops, medical providers, appraisers). Enables AP reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:w9Received rdf:type rdf:Property ;
    rdfs:label 'W9 Received' ;
    rdfs:comment 'Indicates whether a completed IRS Form W-9 (Request for Taxpayer Identification Number and Certification) has been received from the payee. Required before releasing payments subject to backup withholding.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:w9ReceivedDate rdf:type rdf:Property ;
    rdfs:label 'W9 Received Date' ;
    rdfs:comment 'Date on which the IRS Form W-9 was received from the payee. Used to establish the effective date of TIN certification and backup withholding exemption.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryId rdf:type rdf:Property ;
    rdfs:label 'Recovery Id' ;
    rdfs:comment 'Unique surrogate identifier for each claim recovery transaction. One row per recovery transaction per claim exposure per accounting period.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attorneyOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Attorney Organization Id' ;
    rdfs:comment 'Foreign key linking to party.organization. Business justification: Recovery (salvage, subrogation, reinsurance) often involves legal counsel. Law firms are organizations requiring full party attribution for vendor management, payment processing, and' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:responsiblePartyId rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Id' ;
    rdfs:comment 'Reference to the party from whom recovery is sought: tortfeasor for subrogation, salvage buyer for salvage, or reinsurer for reinsurance recovery.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:riskexposurePropertyRiskId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Property Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.property_risk. Business justification: Salvage teams track disposition of damaged buildings and subrogation pursues liable parties for property damage at specific locations.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PropertyRisk .

ind:subrogationId rdf:type rdf:Property ;
    rdfs:label 'Subrogation Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.subrogation. Business justification: Recovery is the transaction record for collected amounts. Subrogation is the master record for a subrogation pursuit.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Subrogation .

ind:bordereauxPeriod rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Period' ;
    rdfs:comment 'YYYY-MM formatted period for which this recovery is included in reinsurance bordereaux reporting to the reinsurer. Applicable for reinsurance recoveries.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'Date on which the recovery file was formally closed, either after full collection, settlement, or abandonment of pursuit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectedAmount rdf:type rdf:Property ;
    rdfs:label 'Collected Amount' ;
    rdfs:comment 'Gross amount actually received from the responsible party or reinsurer prior to deducting collection expenses or attorney fees.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectedDate rdf:type rdf:Property ;
    rdfs:label 'Collected Date' ;
    rdfs:comment 'Date on which recovery funds were actually received and posted. Null if recovery has not yet been collected.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Collection Expense Amount' ;
    rdfs:comment 'Costs incurred to pursue and collect the recovery, including attorney fees, court costs, and investigation expenses. Deducted to derive net recovery.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandAmount rdf:type rdf:Property ;
    rdfs:label 'Demand Amount' ;
    rdfs:comment 'Gross amount formally demanded from the responsible party or reinsurer. Represents the maximum expected recovery before negotiation or adjustment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandDate rdf:type rdf:Property ;
    rdfs:label 'Demand Date' ;
    rdfs:comment 'Date on which the formal demand for recovery was first issued to the responsible party, tortfeasor, or reinsurer.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:litigationFlag rdf:type rdf:Property ;
    rdfs:label 'Litigation Flag' ;
    rdfs:comment 'Indicates whether legal action has been filed to pursue this recovery. True when a lawsuit or arbitration proceeding is active.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentReference rdf:type rdf:Property ;
    rdfs:label 'Payment Reference' ;
    rdfs:comment 'Check number, wire transfer reference, EFT trace number, or other payment instrument identifier for the collected recovery funds.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryType rdf:type rdf:Property ;
    rdfs:label 'Recovery Type' ;
    rdfs:comment 'Classifies the nature of the recovery: subrogation (pursuit of third-party tortfeasor), salvage (sale of damaged property), reinsurance (ceded loss recovery), or other.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riParticipationPct rdf:type rdf:Property ;
    rdfs:label 'Ri Participation Pct' ;
    rdfs:comment 'Percentage of the ceded loss recoverable from the reinsurer under the applicable treaty or facultative agreement (e.g., 0.7500 = 75%).' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoveryBasis rdf:type rdf:Property ;
    rdfs:label 'Ri Recovery Basis' ;
    rdfs:comment 'Reinsurance structure under which the recovery is claimed: quota share (QS), excess of loss (XOL), stop loss (SL), or facultative (FAC).' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageItemDescription rdf:type rdf:Property ;
    rdfs:label 'Salvage Item Description' ;
    rdfs:comment 'Description of the salvaged property or item sold, including condition, make/model for vehicles, or material type for property salvage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageType rdf:type rdf:Property ;
    rdfs:label 'Salvage Type' ;
    rdfs:comment 'Classification of salvage recovery: total loss vehicle, damaged property, scrap material, or auction proceeds. Applicable only when recovery_type is salvage.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statuteOfLimitationsDate rdf:type rdf:Property ;
    rdfs:label 'Statute Of Limitations Date' ;
    rdfs:comment 'Date by which legal action must be filed to preserve the right of recovery. Critical for subrogation diary management and SIU oversight.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationBasis rdf:type rdf:Property ;
    rdfs:label 'Subrogation Basis' ;
    rdfs:comment 'Legal theory under which subrogation is pursued: tort (negligence), contract (breach), statutory (workers comp lien), or equitable subrogation.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceRecoveryId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recovery Id' ;
    rdfs:comment 'Unique surrogate identifier for each reinsurance recovery billing record. One row per reinsurance recovery billing per claim exposure and treaty or facultative agreement.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsurerPartyId rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Party Id' ;
    rdfs:comment 'Reference to the party record representing the reinsurer from whom recovery is sought.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:riRecoveryId rdf:type rdf:Property ;
    rdfs:label 'Ri Recovery Id' ;
    rdfs:comment 'FK to reinsurance.ri_recovery.ri_recovery_id — Links the cedant-side reinsurance recovery accrual to the reinsurance ceded-loss ledger so ceded recovery is booked once and reconciled, preventing double-counting of recoverables (VREQ-009/VREQ-014).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiRecovery .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Indicates whether the recovery is under a treaty (automatic) or facultative (individually negotiated) reinsurance agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Attachment Point' ;
    rdfs:comment 'The loss threshold above which the reinsurer\'s obligation begins under an Excess of Loss (XOL) or Stop Loss (SL) treaty layer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedControlLevelFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Control Level Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is an authorized (admitted) reinsurer for statutory credit purposes, affecting RBC and Schedule F treatment.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingDate rdf:type rdf:Property ;
    rdfs:label 'Billing Date' ;
    rdfs:comment 'The date on which the reinsurance recovery was billed to the reinsurer. Principal business event date for this transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cashCallIndicator rdf:type rdf:Property ;
    rdfs:label 'Cash Call Indicator' ;
    rdfs:comment 'Indicates whether this recovery was billed as an interim cash call to the reinsurer prior to final claim settlement, as permitted under large-loss provisions.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cessionPercentage rdf:type rdf:Property ;
    rdfs:label 'Cession Percentage' ;
    rdfs:comment 'The percentage of the loss ceded to the reinsurer under the applicable agreement, expressed as a decimal (e.g., 0.7500 = 75%). Applicable primarily to quota share treaties.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralHeldAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Held Amount' ;
    rdfs:comment 'Amount of collateral (letters of credit, trust funds) held from the reinsurer that can be applied against this outstanding recovery balance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionDate rdf:type rdf:Property ;
    rdfs:label 'Collection Date' ;
    rdfs:comment 'The date on which the recovery amount was actually received from the reinsurer. Null if not yet collected.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commutationIndicator rdf:type rdf:Property ;
    rdfs:label 'Commutation Indicator' ;
    rdfs:comment 'Flags whether this recovery record has been settled via a commutation agreement, extinguishing future obligations between cedant and reinsurer.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysOverdue rdf:type rdf:Property ;
    rdfs:label 'Days Overdue' ;
    rdfs:comment 'Number of calendar days the outstanding recovery balance has been past the contractual due date. Used for Schedule F aging buckets and credit risk monitoring.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disputedAmount rdf:type rdf:Property ;
    rdfs:label 'Disputed Amount' ;
    rdfs:comment 'Portion of the billed recovery amount that the reinsurer has formally disputed. Tracked separately for collections and reserving purposes.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdueIndicator rdf:type rdf:Property ;
    rdfs:label 'Overdue Indicator' ;
    rdfs:comment 'Flags recoveries where the outstanding balance has exceeded the contractual due date. Drives NAIC Schedule F overdue reinsurance reporting.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryBilledAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Billed Amount' ;
    rdfs:comment 'Total amount billed to the reinsurer for this recovery, combining ceded loss and ceded LAE. Represents the gross recovery claim submitted.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryCollectedAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Collected Amount' ;
    rdfs:comment 'Actual amount received from the reinsurer to date. May be less than billed if partial payment or dispute exists.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryNumber rdf:type rdf:Property ;
    rdfs:label 'Recovery Number' ;
    rdfs:comment 'Externally-known business identifier for this recovery billing, used in bordereaux reporting and reinsurer correspondence. Assigned by the Reinsurance Management System.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerLimit rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Limit' ;
    rdfs:comment 'Maximum amount the reinsurer is obligated to pay under the applicable treaty layer or facultative certificate for this claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementReference rdf:type rdf:Property ;
    rdfs:label 'Settlement Reference' ;
    rdfs:comment 'Reference number of the reinsurance settlement or cash call under which this recovery was remitted by the reinsurer.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenOffAmount rdf:type rdf:Property ;
    rdfs:label 'Written Off Amount' ;
    rdfs:comment 'Amount of the recovery deemed uncollectible and written off, typically due to reinsurer insolvency or commutation agreement.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveId rdf:type rdf:Property ;
    rdfs:label 'Reserve Id' ;
    rdfs:comment 'Unique surrogate identifier for each reserve position record. One row per reserve type per claim exposure per accounting period. Grain: one reserve movement per claim exposure per period.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:basis rdf:type rdf:Property ;
    rdfs:label 'Basis' ;
    rdfs:comment 'Indicates whether the reserve amounts are stated on a Gross (before reinsurance), Net (after reinsurance), or Ceded (reinsurer share only) basis for this record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseReserveAdequacyFlag rdf:type rdf:Property ;
    rdfs:label 'Case Reserve Adequacy Flag' ;
    rdfs:comment 'Actuarial or supervisory assessment of whether the case reserve is adequate relative to the expected ultimate loss. Used in reserve review and ORSA reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveCategory rdf:type rdf:Property ;
    rdfs:label 'Reserve Category' ;
    rdfs:comment 'Broad financial category of the reserve: Loss (indemnity), Expense (LAE/DCC/AO), Salvage (anticipated recovery from salvage), or Subrogation (anticipated recovery from third parties).' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededClosingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Closing Balance Amount' ;
    rdfs:comment 'Portion of the closing reserve balance ceded to reinsurers. Net reserve equals closing balance minus ceded closing balance. Required for Schedule F statutory reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededMovementAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Movement Amount' ;
    rdfs:comment 'Incremental change in the ceded reserve portion during the accounting period. Supports net reserve calculation and reinsurance bordereaux reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededOpeningBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Opening Balance Amount' ;
    rdfs:comment 'Portion of the opening reserve balance ceded to reinsurers under applicable treaties or facultative agreements. Used for net reserve and Schedule F reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Closing Balance Amount' ;
    rdfs:comment 'Reserve balance at the end of the accounting period for this claim exposure and reserve type. Equals opening balance plus movement amount. Gross of reinsurance.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ibnrFactor rdf:type rdf:Property ;
    rdfs:label 'Ibnr Factor' ;
    rdfs:comment 'Actuarial development factor applied to derive the IBNR reserve component. Sourced from the actuarial reserving system loss development triangle for the applicable LOB and accident year.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:movementAmount rdf:type rdf:Property ;
    rdfs:label 'Movement Amount' ;
    rdfs:comment 'Incremental change to the reserve during the accounting period. Positive value indicates reserve strengthening; negative value indicates reserve release. Gross of reinsurance.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:movementReasonCode rdf:type rdf:Property ;
    rdfs:label 'Movement Reason Code' ;
    rdfs:comment 'Coded reason for the reserve movement in this period (e.g., NEW_RESERVE, STRENGTHENING, PARTIAL_RELEASE, FULL_RELEASE, PAYMENT_OFFSET, REOPEN). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Movement Reason Description' ;
    rdfs:comment 'Free-text narrative provided by the adjuster or actuarial team explaining the basis for the reserve movement. Supports audit trail and reserve review documentation.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Opening Balance Amount' ;
    rdfs:comment 'Reserve balance carried forward from the prior accounting period for this claim exposure and reserve type. Starting point for the period movement calculation.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresSupervisorApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Supervisor Approval' ;
    rdfs:comment 'Indicates whether this reserve movement exceeded the adjuster authority limit and required supervisor or management approval before posting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveStatus rdf:type rdf:Property ;
    rdfs:label 'Reserve Status' ;
    rdfs:comment 'Current lifecycle state of the reserve position. Open reserves are active; Closed reserves have been fully settled or released; Reopened indicates a previously closed reserve reactivated.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageAnticipatedAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Anticipated Amount' ;
    rdfs:comment 'Estimated salvage recovery anticipated on this claim exposure. Reduces the net reserve position and is reported separately in NAIC statutory filings.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationAnticipatedAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Anticipated Amount' ;
    rdfs:comment 'Estimated subrogation recovery anticipated on this claim exposure. Reduces the net reserve position and is tracked separately for recovery management and statutory reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskexposureVehicleId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Vehicle Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.vehicle. Business justification: Salvage vendors require VIN, title number, and vehicle specifications for auction processing and title transfer.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:vendorPayeeId rdf:type rdf:Property ;
    rdfs:label 'Vendor Payee Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.payee. Business justification: Salvage has vendor_name and vendor_code (STRING) for the salvage vendor (auction house, salvage yard). Vendors are payees. Adding vendor_payee_id FK normalizes vendor master data.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payee .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date the salvage item was formally assigned to the salvage vendor or auction house for disposition.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auctionDate rdf:type rdf:Property ;
    rdfs:label 'Auction Date' ;
    rdfs:comment 'Date on which the salvaged item was auctioned or sold. Used to align proceeds recognition with the correct accounting period.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auctionFee rdf:type rdf:Property ;
    rdfs:label 'Auction Fee' ;
    rdfs:comment 'Fee charged by the auction house or salvage vendor for facilitating the sale, deducted from gross proceeds to arrive at net salvage.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionProceeds rdf:type rdf:Property ;
    rdfs:label 'Auction Proceeds' ;
    rdfs:comment 'Gross cash proceeds received from the auction or direct sale of the salvaged item before deducting storage, towing, and auction fees.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buyerName rdf:type rdf:Property ;
    rdfs:label 'Buyer Name' ;
    rdfs:comment 'Name of the individual or entity that purchased the salvaged item at auction or direct sale.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerType rdf:type rdf:Property ;
    rdfs:label 'Buyer Type' ;
    rdfs:comment 'Classification of the salvage buyer. Determines applicable title transfer rules and tax reporting obligations.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheCode rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Code' ;
    rdfs:comment 'ISO or internal catastrophe event code linking this salvage to a declared CAT event for PML aggregation and reinsurance recovery.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'Certificate of destruction or salvage certificate number issued by the state DMV or relevant authority for the disposed item.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionMethod rdf:type rdf:Property ;
    rdfs:label 'Disposition Method' ;
    rdfs:comment 'Method by which the salvaged item is disposed of. Impacts net salvage calculation and title transfer obligations.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredRetainedIndicator rdf:type rdf:Property ;
    rdfs:label 'Insured Retained Indicator' ;
    rdfs:comment 'Indicates whether the insured elected to retain the salvaged item, resulting in a deduction from the total-loss settlement payment.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuredRetentionDeduction rdf:type rdf:Property ;
    rdfs:label 'Insured Retention Deduction' ;
    rdfs:comment 'Amount deducted from the total-loss settlement when the insured elects to retain the salvaged item, equal to the salvage value estimate.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netSalvageAmount rdf:type rdf:Property ;
    rdfs:label 'Net Salvage Amount' ;
    rdfs:comment 'Net proceeds from salvage after deducting storage, towing, and auction fees from gross auction proceeds. Credited against claim payments.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceSalvageShare rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Salvage Share' ;
    rdfs:comment 'Portion of net salvage proceeds attributable to reinsurers under applicable treaty or facultative agreement, per SSAP No. 62R.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageStatus rdf:type rdf:Property ;
    rdfs:label 'Salvage Status' ;
    rdfs:comment 'Current lifecycle state of the salvage activity. Drives workflow in ClaimCenter Recovery module and financial recognition timing.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siuReferralIndicator rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Indicator' ;
    rdfs:comment 'Indicates whether this salvage activity has been referred to the SIU for fraud investigation (e.g., staged total loss).' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:storageCost rdf:type rdf:Property ;
    rdfs:label 'Storage Cost' ;
    rdfs:comment 'Cumulative cost of storing the salvaged item from date of loss to date of disposition, deducted from gross proceeds.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageEndDate rdf:type rdf:Property ;
    rdfs:label 'Storage End Date' ;
    rdfs:comment 'Date the salvaged item was removed from storage upon sale, transfer, or destruction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'Address or facility name where the salvaged item is stored pending auction or disposition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageStartDate rdf:type rdf:Property ;
    rdfs:label 'Storage Start Date' ;
    rdfs:comment 'Date the salvaged item entered storage, used to calculate accrued storage costs and vendor billing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleNumber rdf:type rdf:Property ;
    rdfs:label 'Title Number' ;
    rdfs:comment 'State-issued salvage title number assigned to the vehicle or property after total-loss declaration, required for legal resale.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Title Received Date' ;
    rdfs:comment 'Date the insurer physically received the signed title document from the insured, initiating the transfer process.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleTransferDate rdf:type rdf:Property ;
    rdfs:label 'Title Transfer Date' ;
    rdfs:comment 'Date on which the title of the salvaged item was legally transferred from the insured to the insurer or designated buyer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleTransferStatus rdf:type rdf:Property ;
    rdfs:label 'Title Transfer Status' ;
    rdfs:comment 'Status of the vehicle or property title transfer from the insured to the insurer or salvage buyer. Required for total-loss compliance.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLossIndicator rdf:type rdf:Property ;
    rdfs:label 'Total Loss Indicator' ;
    rdfs:comment 'Indicates whether the insured item was declared a total loss, triggering full salvage disposition and title transfer requirements.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:towingCost rdf:type rdf:Property ;
    rdfs:label 'Towing Cost' ;
    rdfs:comment 'Cost of towing or transporting the salvaged item to the storage yard or auction facility, deducted from gross proceeds.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueEstimate rdf:type rdf:Property ;
    rdfs:label 'Value Estimate' ;
    rdfs:comment 'Appraised or estimated market value of the salvaged item prior to auction or sale, used to set reserve and evaluate offers.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vin rdf:type rdf:Property ;
    rdfs:label 'Vin' ;
    rdfs:comment '17-character Vehicle Identification Number for salvaged vehicles, used for title transfer, DMV reporting, and CLUE database updates.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statutoryReserveFilingId rdf:type rdf:Property ;
    rdfs:label 'Statutory Reserve Filing Id' ;
    rdfs:comment 'Unique surrogate identifier for each statutory reserve filing record submitted to a state DOI or NAIC. Grain: one row per filing per LOB per state per accident year per accounting period.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageTypeId rdf:type rdf:Property ;
    rdfs:label 'Coverage Type Id' ;
    rdfs:comment 'Foreign key linking to coverage.coverage_type. Business justification: Schedule P filings aggregate reserves by coverage type (NAIC line code) for regulatory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageType .

ind:originalFilingStatutoryReserveFilingId rdf:type rdf:Property ;
    rdfs:label 'Original Filing Statutory Reserve Filing Id' ;
    rdfs:comment 'Reference to the original statutory_reserve_filing_id that this record amends or supersedes, populated only when amended_filing_indicator is true.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StatutoryReserveFiling .

ind:actuaryCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Actuary Certification Date' ;
    rdfs:comment 'Date on which the appointed actuary signed and certified the reserve opinion included in this statutory filing.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actuaryCredential rdf:type rdf:Property ;
    rdfs:label 'Actuary Credential' ;
    rdfs:comment 'Professional designation of the certifying actuary (e.g., FCAS, ACAS, MAAA) confirming qualification to opine on P&C reserves.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendedFilingIndicator rdf:type rdf:Property ;
    rdfs:label 'Amended Filing Indicator' ;
    rdfs:comment 'Indicates whether this filing is an amendment to a previously submitted statutory reserve filing for the same period, LOB, and state.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:companyName rdf:type rdf:Property ;
    rdfs:label 'Company Name' ;
    rdfs:comment 'Legal name of the insurance company entity submitting the statutory reserve filing.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingType rdf:type rdf:Property ;
    rdfs:label 'Filing Type' ;
    rdfs:comment 'Classification of the filing as annual, quarterly, amended, or supplemental per NAIC statement requirements.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorYearReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Reserve Amount' ;
    rdfs:comment 'Total reserve amount carried in the prior year-end filing for the same LOB, state, and accident year cohort, used to measure reserve development.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rbcImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Rbc Impact Amount' ;
    rdfs:comment 'Estimated impact of the reserve position on the company\'s Risk-Based Capital (RBC) ratio, used for solvency monitoring and ORSA reporting.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDueDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Due Date' ;
    rdfs:comment 'Statutory deadline by which this reserve filing must be submitted to the state DOI or NAIC to remain in compliance.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingBasis rdf:type rdf:Property ;
    rdfs:label 'Reporting Basis' ;
    rdfs:comment 'Accounting basis under which reserves are stated: Statutory Accounting Principles (SAP), US GAAP, or IFRS 17.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveAdequacyOpinion rdf:type rdf:Property ;
    rdfs:label 'Reserve Adequacy Opinion' ;
    rdfs:comment 'Actuarial opinion on whether the carried reserves are adequate, reasonable, or require qualification per the appointed actuary\'s review.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulePLine rdf:type rdf:Property ;
    rdfs:label 'Schedule P Line' ;
    rdfs:comment 'NAIC Schedule P line designation (e.g., Line 1 - Homeowners, Line 5 - Commercial Auto) to which this reserve filing maps for statutory reporting.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Total Reserve Amount' ;
    rdfs:comment 'Sum of case reserve, IBNR, and LAE reserve representing the total unpaid loss and LAE obligation reported in this filing.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateLossEstimate rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Estimate' ;
    rdfs:comment 'Actuarial estimate of the ultimate net loss (UNL) for the accident year and LOB, representing the final expected total cost of all claims.' ;
    rdfs:domain ind:StatutoryReserveFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liablePartyId rdf:type rdf:Property ;
    rdfs:label 'Liable Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Subrogation pursues recovery from liable third parties who are tracked as party entities. Demand letters, settlement negotiations, and litigation require full party attribution including address' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:riskexposureAutoRiskId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Auto Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.auto_risk. Business justification: Subrogation adjusters reference insured vehicle details, driver information, and garaging location when pursuing third-party recoveries.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AutoRisk .

ind:arbitrationAwardAmount rdf:type rdf:Property ;
    rdfs:label 'Arbitration Award Amount' ;
    rdfs:comment 'Dollar amount awarded by the arbitration panel in favor of the insurer. May differ from demand amount. Drives final collection and closure processing.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arbitrationFilingDate rdf:type rdf:Property ;
    rdfs:label 'Arbitration Filing Date' ;
    rdfs:comment 'Date the subrogation dispute was filed with the arbitration forum. Used to track filing deadlines and arbitration cycle times.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:arbitrationForum rdf:type rdf:Property ;
    rdfs:label 'Arbitration Forum' ;
    rdfs:comment 'Arbitration body used for intercompany dispute resolution. Arbitration Forums Inc. is standard for auto subrogation. Drives filing fee tracking and award enforcement.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureReason rdf:type rdf:Property ;
    rdfs:label 'Closure Reason' ;
    rdfs:comment 'Reason the subrogation pursuit was closed. Required for recovery analytics, SIU referral decisions, and regulatory reporting. [ENUM-REF-CANDIDATE: promote to reference product if values expand]' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectibleAmount rdf:type rdf:Property ;
    rdfs:label 'Collectible Amount' ;
    rdfs:comment 'Estimated collectible portion of the demand amount after applying comparative negligence, policy limits of the liable party, and asset assessment. Used for reserve adequacy.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuredReimbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Insured Reimbursement Amount' ;
    rdfs:comment 'Portion of the net recovery returned to the insured, typically representing their deductible or uninsured loss. Required by the made-whole doctrine in most jurisdictions.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'Date of the most recent action taken on the subrogation file (demand, payment received, court filing, etc.). Used for diary management and dormant file identification.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liablePartyClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Liable Party Claim Number' ;
    rdfs:comment 'Claim number assigned by the liable party\'s insurer for the same loss event. Enables cross-carrier reconciliation and arbitration tracking.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liablePartyInsurer rdf:type rdf:Property ;
    rdfs:label 'Liable Party Insurer' ;
    rdfs:comment 'Name of the insurance carrier for the liable third party. Used to route intercompany arbitration and direct demand letters to the correct carrier.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liablePartyPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Liable Party Policy Number' ;
    rdfs:comment 'Policy number of the liable third party\'s insurance coverage. Required for intercompany arbitration filings and demand correspondence.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:litigationStatus rdf:type rdf:Property ;
    rdfs:label 'Litigation Status' ;
    rdfs:comment 'Current stage of legal proceedings for the subrogation pursuit. Drives reserve adequacy reviews and legal expense forecasting. [ENUM-REF-CANDIDATE: promote to reference product if stages expand]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:madeWholeIndicator rdf:type rdf:Property ;
    rdfs:label 'Made Whole Indicator' ;
    rdfs:comment 'Indicates whether the insured has been fully compensated for their loss before the insurer may retain subrogation proceeds. Required by the made-whole doctrine in most states.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:negligencePct rdf:type rdf:Property ;
    rdfs:label 'Negligence Pct' ;
    rdfs:comment 'Percentage of fault attributed to the liable third party as determined by investigation or adjudication. Drives the collectible amount calculation under comparative negligence statutes.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Net Recovery Amount' ;
    rdfs:comment 'Net recovery after deducting recovery expenses from collected amount (collected_amount minus recovery_expense_amount). Represents the actual financial benefit to the insurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextActionDate rdf:type rdf:Property ;
    rdfs:label 'Next Action Date' ;
    rdfs:comment 'Diary date for the next required action on the subrogation file. Drives case management queues and ensures statute of limitations compliance.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openedDate rdf:type rdf:Property ;
    rdfs:label 'Opened Date' ;
    rdfs:comment 'Date the subrogation pursuit was formally opened in the claims management system. Used as the start point for cycle time and recovery lag analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pursuitStatus rdf:type rdf:Property ;
    rdfs:label 'Pursuit Status' ;
    rdfs:comment 'Current workflow state of the subrogation pursuit. Drives case management queues and recovery reporting. [ENUM-REF-CANDIDATE: Open|Demand Issued|Negotiating|Settled|Collected|Closed - No Recovery|Referred to Litigation — promote to reference product]' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Expense Amount' ;
    rdfs:comment 'Total allocated expenses incurred in pursuing the subrogation recovery, including attorney fees, court costs, and investigation costs (DCC/ALAE). Deducted to compute net recovery.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Recovery Method' ;
    rdfs:comment 'Mechanism used to pursue the subrogation recovery. Intercompany Arbitration applies to auto claims under Arbitration Forum agreements. Drives legal cost allocation.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralDate rdf:type rdf:Property ;
    rdfs:label 'Referral Date' ;
    rdfs:comment 'Date the subrogation file was referred to outside counsel or a subrogation vendor for legal pursuit. Triggers DCC expense tracking and litigation status updates.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recovery Amount' ;
    rdfs:comment 'Portion of the gross subrogation collected amount allocable to reinsurers per treaty or facultative cession terms. Reported on Schedule F and reinsurance bordereaux.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceRecoveryIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recovery Indicator' ;
    rdfs:comment 'Indicates whether a portion of the subrogation recovery must be remitted to reinsurers per cession agreements. Triggers reinsurance bordereaux reporting and recovery allocation.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount' ;
    rdfs:comment 'Agreed gross settlement amount with the liable party. May differ from demand amount due to negotiation, comparative negligence, or policy limits of the liable party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'Date a settlement agreement was reached with the liable party or their insurer. Triggers final payment processing and closure of the subrogation pursuit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateOfLoss rdf:type rdf:Property ;
    rdfs:label 'State Of Loss' ;
    rdfs:comment 'Two-letter US state code where the loss occurred. Determines applicable subrogation statutes, comparative negligence rules, and statute of limitations periods.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationType rdf:type rdf:Property ;
    rdfs:label 'Subrogation Type' ;
    rdfs:comment 'Legal basis of the recovery action: Subrogation (insurer steps into insured\'s rights), Contribution (recovery from co-insurer), or Indemnification (contractual hold-harmless recovery).' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suitFiledDate rdf:type rdf:Property ;
    rdfs:label 'Suit Filed Date' ;
    rdfs:comment 'Date the subrogation lawsuit was filed in court. Marks the transition from pre-litigation to litigation phase and triggers enhanced reserve and expense tracking.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supervisorAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Adjuster Id' ;
    rdfs:comment 'Reference to the supervising adjuster or claims manager overseeing this adjuster\'s work.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:adjusterStatus rdf:type rdf:Property ;
    rdfs:label 'Adjuster Status' ;
    rdfs:comment 'Current operational status of the adjuster indicating availability for claim assignments.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjusterType rdf:type rdf:Property ;
    rdfs:label 'Adjuster Type' ;
    rdfs:comment 'Classification of adjuster employment relationship: staff employee, independent contractor, third-party administrator, catastrophe specialist, or public adjuster.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date the most recent background check was completed for the adjuster.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backgroundCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Background Check Status' ;
    rdfs:comment 'Result status of the most recent background check.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheQualifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Qualified Flag' ;
    rdfs:comment 'Indicates whether the adjuster is qualified and available for catastrophe event deployments.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationDesignations rdf:type rdf:Property ;
    rdfs:label 'Certification Designations' ;
    rdfs:comment 'Professional certifications held by the adjuster such as AIC, CPCU, SCLA, or other industry designations.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentCaseloadCount rdf:type rdf:Property ;
    rdfs:label 'Current Caseload Count' ;
    rdfs:comment 'Number of open claims currently assigned to the adjuster.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fieldAdjusterFlag rdf:type rdf:Property ;
    rdfs:label 'Field Adjuster Flag' ;
    rdfs:comment 'Indicates whether the adjuster conducts on-site field inspections versus desk-only adjusting.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hireDate rdf:type rdf:Property ;
    rdfs:label 'Hire Date' ;
    rdfs:comment 'Date the adjuster was hired or contracted by the insurer or TPA.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:homeOfficeLocation rdf:type rdf:Property ;
    rdfs:label 'Home Office Location' ;
    rdfs:comment 'Primary office or geographic location where the adjuster is based.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageSkills rdf:type rdf:Property ;
    rdfs:label 'Language Skills' ;
    rdfs:comment 'Comma-separated list of languages the adjuster is fluent in for claimant communication.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformanceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Performance Review Date' ;
    rdfs:comment 'Date of the most recent formal performance review.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'License Issue Date' ;
    rdfs:comment 'Date the adjuster license was originally issued by the state authority.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'State-issued license number authorizing the adjuster to handle insurance claims.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseState rdf:type rdf:Property ;
    rdfs:label 'License State' ;
    rdfs:comment 'Two-letter state code where the adjuster holds their primary license.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxCaseloadCapacity rdf:type rdf:Property ;
    rdfs:label 'Max Caseload Capacity' ;
    rdfs:comment 'Maximum number of concurrent claims the adjuster can handle based on workload management policies.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxClaimAuthority rdf:type rdf:Property ;
    rdfs:label 'Max Claim Authority' ;
    rdfs:comment 'Maximum dollar amount the adjuster is authorized to settle without supervisory approval.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:multiStateLicensedFlag rdf:type rdf:Property ;
    rdfs:label 'Multi State Licensed Flag' ;
    rdfs:comment 'Indicates whether the adjuster holds licenses in multiple states.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npn rdf:type rdf:Property ;
    rdfs:label 'Npn' ;
    rdfs:comment 'National Producer Number assigned by NIPR if the adjuster also holds producer licensing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Most recent performance evaluation rating for the adjuster.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritory rdf:type rdf:Property ;
    rdfs:label 'Service Territory' ;
    rdfs:comment 'Geographic territory or region the adjuster is assigned to cover for claim investigations.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyLines rdf:type rdf:Property ;
    rdfs:label 'Specialty Lines' ;
    rdfs:comment 'Comma-separated list of insurance lines the adjuster specializes in handling, such as property, auto, liability, workers compensation.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCompanyName rdf:type rdf:Property ;
    rdfs:label 'Vendor Company Name' ;
    rdfs:comment 'Name of the independent adjusting firm or TPA if the adjuster is not a staff employee.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContractNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Contract Number' ;
    rdfs:comment 'Contract identifier for independent or TPA adjusters linking to the vendor agreement.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsExperience rdf:type rdf:Property ;
    rdfs:label 'Years Experience' ;
    rdfs:comment 'Total years of claims adjusting experience across all employers.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjusterAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Adjuster Assignment Id' ;
    rdfs:comment 'Unique identifier for the adjuster assignment record. Primary key.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Primary Adjuster Id' ;
    rdfs:comment 'The adjuster assigned to handle the claim or exposure.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:assignedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Assigned By User Code' ;
    rdfs:comment 'The system user or supervisor who made the assignment. Null for automatic assignments.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Assignment Authority Level' ;
    rdfs:comment 'The level of authority the adjuster has in this assignment: full settlement authority, limited, or advisory only.' ;
