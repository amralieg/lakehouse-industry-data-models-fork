    rdfs:comment 'Indicates whether this is a long-tail line with extended claim development periods (e.g., GL, WC).' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossDevelopmentPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Loss Development Period Months' ;
    rdfs:comment 'Typical loss development period in months for claims in this line of business.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryNotes rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notes' ;
    rdfs:comment 'Regulatory compliance notes including state-specific requirements, filing obligations, and restrictions.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceCededPct rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Ceded Pct' ;
    rdfs:comment 'Typical percentage of premium ceded to reinsurers for this line of business.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalCommissionRatePct rdf:type rdf:Property ;
    rdfs:label 'Renewal Commission Rate Pct' ;
    rdfs:comment 'Standard commission rate percentage paid to producers for renewal business in this line.' ;
    rdfs:domain ind:LobCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresStateFiling rdf:type rdf:Property ;
