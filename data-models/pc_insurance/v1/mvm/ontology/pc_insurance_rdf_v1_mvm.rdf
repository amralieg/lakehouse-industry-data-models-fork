ind:isoConstructionCode rdf:type rdf:Property ;
    rdfs:label 'Iso Construction Code' ;
    rdfs:comment 'ISO standard construction classification code used for rating and catastrophe modeling.' ;
    rdfs:domain ind:PropertyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfUnits rdf:type rdf:Property ;
    rdfs:label 'Number Of Units' ;
    rdfs:comment 'The number of dwelling units or rental units in the property, if applicable for multi-family or commercial properties.' ;
