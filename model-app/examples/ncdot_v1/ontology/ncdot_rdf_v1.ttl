ind:scheduledStartYear rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Year' ;
    rdfs:comment 'Planned fiscal or calendar year for project initiation or start of construction.' ;
    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledCompletionYear rdf:type rdf:Property ;
