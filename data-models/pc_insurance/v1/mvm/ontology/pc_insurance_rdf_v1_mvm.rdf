    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distanceToFireHydrantFeet rdf:type rdf:Property ;
    rdfs:label 'Distance To Fire Hydrant Feet' ;
    rdfs:comment 'Distance in feet from the property to the nearest fire hydrant. Impacts protection class and rating.' ;
