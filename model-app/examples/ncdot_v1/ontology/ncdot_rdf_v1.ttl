    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProjectBudget .

ind:otherAmount rdf:type rdf:Property ;
    rdfs:label 'Other Amount' ;
    rdfs:comment 'The portion of the project budget funded by other sources not classified as federal, state, or local, such as private contributions or special grants.' ;
