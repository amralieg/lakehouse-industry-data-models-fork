ind:freightCapacityTons rdf:type rdf:Property ;
    rdfs:label 'Freight Capacity Tons' ;
    rdfs:comment 'Maximum freight carrying capacity in tons for freight train services.' ;
    rdfs:domain ind:TrainSchedule ;
