ind:piiFlag rdf:type rdf:Property ;
    rdfs:label 'Pii Flag' ;
    rdfs:comment 'Indicates whether the document contains personally identifiable information.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'Date the document was physically or electronically received by the insurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:redactionRequiredFlag rdf:type rdf:Property ;
