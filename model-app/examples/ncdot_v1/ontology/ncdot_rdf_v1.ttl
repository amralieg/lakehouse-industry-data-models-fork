ind:rebuiltFlag rdf:type rdf:Property ;
    rdfs:label 'Rebuilt Flag' ;
    rdfs:comment 'Indicates whether the vehicle was previously salvaged and has been rebuilt and inspected for road use.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stolenFlag rdf:type rdf:Property ;
    rdfs:label 'Stolen Flag' ;
    rdfs:comment 'Indicates whether the vehicle has been reported stolen and is in the National Crime Information Center (NCIC) database.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
