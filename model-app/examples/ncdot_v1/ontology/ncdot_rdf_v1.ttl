ind:payPlanCode rdf:type rdf:Property ;
    rdfs:label 'Pay Plan Code' ;
    rdfs:comment 'Code identifying the pay plan or compensation structure to which this salary grade belongs (e.g., \'STATE\', \'EXEMPT\', \'NONEXEMPT\').' ;
    rdfs:domain ind:SalaryGrade ;
