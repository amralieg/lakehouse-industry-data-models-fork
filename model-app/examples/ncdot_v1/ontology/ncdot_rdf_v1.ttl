ind:archiveDate rdf:type rdf:Property ;
    rdfs:label 'Archive Date' ;
    rdfs:comment 'Date when the document was moved to archive or long-term storage.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:destructionEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Destruction Eligible Date' ;
    rdfs:comment 'Date when the document becomes eligible for destruction according to records retention schedules.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transitScheduleId rdf:type rdf:Property ;
    rdfs:label 'Transit Schedule Id' ;
    rdfs:comment 'Unique identifier for the transit schedule record. Primary key for the transit schedule entity.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceId rdf:type rdf:Property ;
    rdfs:label 'Service Id' ;
    rdfs:comment 'Identifier for the service pattern (e.g., weekday, weekend, holiday) that defines when this schedule is active.' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Service .

ind:serviceName rdf:type rdf:Property ;
    rdfs:label 'Service Name' ;
    rdfs:comment 'Descriptive name for the service pattern (e.g., Weekday Service, Saturday Service, Holiday Service).' ;
    rdfs:domain ind:Transit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tripId rdf:type rdf:Property ;
    rdfs:label 'Trip Id' ;
    rdfs:comment 'Unique identifier for a specific trip within the schedule. A trip represents one vehicle traveling along a route.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Trip .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
    rdfs:comment 'Direction of travel for the trip (e.g., inbound, outbound, northbound).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockId rdf:type rdf:Property ;
    rdfs:label 'Block Id' ;
    rdfs:comment 'Identifier for the block of trips that a single vehicle operates. Used for vehicle and operator scheduling.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
