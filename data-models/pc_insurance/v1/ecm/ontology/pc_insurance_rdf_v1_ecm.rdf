ind:underwritingGuidelinesVersion rdf:type rdf:Property ;
    rdfs:label 'Underwriting Guidelines Version' ;
    rdfs:comment 'Version of the underwriting guidelines applied when making this decision, for audit and compliance tracking.' ;
