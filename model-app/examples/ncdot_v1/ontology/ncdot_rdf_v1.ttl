    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impairmentAmount rdf:type rdf:Property ;
    rdfs:label 'Impairment Amount' ;
    rdfs:comment 'The monetary amount of asset impairment loss recognized, in US dollars.' ;
