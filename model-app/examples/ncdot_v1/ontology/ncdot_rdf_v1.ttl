ind:vehicleLicensePlate rdf:type rdf:Property ;
    rdfs:label 'Vehicle License Plate' ;
    rdfs:comment 'License plate number of the vehicle associated with the reservation.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleState rdf:type rdf:Property ;
    rdfs:label 'Vehicle State' ;
    rdfs:comment 'Two-letter state code where the vehicle is registered.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passengerCount rdf:type rdf:Property ;
    rdfs:label 'Passenger Count' ;
    rdfs:comment 'Total number of passengers included in this reservation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ticketId rdf:type rdf:Property ;
    rdfs:label 'Ticket Id' ;
    rdfs:comment 'Identifier of the ticket issued for this reservation, if payment has been completed.' ;
