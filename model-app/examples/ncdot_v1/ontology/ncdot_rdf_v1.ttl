ind:peakHeadwayMinutes rdf:type rdf:Property ;
    rdfs:label 'Peak Headway Minutes' ;
    rdfs:comment 'Time interval in minutes between consecutive vehicle departures during peak service hours.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
