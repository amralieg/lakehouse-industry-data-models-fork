    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Vehicle Length Feet' ;
    rdfs:comment 'Length of the vehicle in feet, used for capacity planning and fare calculation.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
