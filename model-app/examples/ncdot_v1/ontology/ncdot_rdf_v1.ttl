    rdfs:range xsd:decimal .

ind:isMultiYear rdf:type rdf:Property ;
    rdfs:label 'Is Multi Year' ;
    rdfs:comment 'Boolean flag indicating whether the budget spans multiple fiscal years requiring multi-year appropriation authority.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementRate rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Rate' ;
    rdfs:comment 'The percentage rate at which expenditures will be reimbursed by the federal or other funding source.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profile rdf:type rdf:Property ;
    rdfs:label 'Profile' ;
    rdfs:comment 'The SAP budget profile code defining the budget control parameters and tolerance limits for the project.' ;
