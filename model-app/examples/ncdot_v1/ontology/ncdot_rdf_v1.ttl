ind:requestPurpose rdf:type rdf:Property ;
    rdfs:label 'Request Purpose' ;
    rdfs:comment 'The business purpose or use case for the geocoding request (e.g., project planning, asset location, incident mapping).' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBatchRequest rdf:type rdf:Property ;
    rdfs:label 'Is Batch Request' ;
    rdfs:comment 'Indicates whether this geocoding request was part of a batch processing job.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offsetDistanceFt rdf:type rdf:Property ;
    rdfs:label 'Offset Distance Ft' ;
    rdfs:comment 'The perpendicular distance in feet from the road centerline to the geocoded point.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sideOfStreet rdf:type rdf:Property ;
    rdfs:label 'Side Of Street' ;
    rdfs:comment 'Indicates which side of the street the geocoded address is located on relative to the direction of the road.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'The governmental jurisdiction responsible for the road or location (e.g., State, County, Municipality).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSenateDistrict rdf:type rdf:Property ;
    rdfs:label 'State Senate District' ;
    rdfs:comment 'The North Carolina State Senate district in which the geocoded location resides.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateHouseDistrict rdf:type rdf:Property ;
    rdfs:label 'State House District' ;
    rdfs:comment 'The North Carolina State House of Representatives district in which the geocoded location resides.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elevationFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Ft' ;
    rdfs:comment 'The elevation above sea level in feet at the geocoded location.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyRadiusFt rdf:type rdf:Property ;
    rdfs:label 'Accuracy Radius Ft' ;
    rdfs:comment 'The estimated accuracy radius in feet representing the confidence area around the geocoded coordinates.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isInterpolated rdf:type rdf:Property ;
    rdfs:label 'Is Interpolated' ;
    rdfs:comment 'Indicates whether the coordinates were interpolated from address ranges rather than matched to a specific point.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:addressType rdf:type rdf:Property ;
    rdfs:label 'Address Type' ;
    rdfs:comment 'Classification of the input address type (e.g., street address, intersection, postal code, landmark).' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryCount rdf:type rdf:Property ;
    rdfs:label 'Retry Count' ;
    rdfs:comment 'The number of retry attempts made for this geocoding request before success or final failure.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cacheHit rdf:type rdf:Property ;
    rdfs:label 'Cache Hit' ;
    rdfs:comment 'Indicates whether the geocoding result was retrieved from cache rather than processed in real-time.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Flag' ;
    rdfs:comment 'Overall quality assessment flag for the geocoding result based on match score and validation rules.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manualReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Manual Review Required' ;
    rdfs:comment 'Indicates whether the geocoding result requires manual review due to low match score or ambiguous results.' ;
    rdfs:domain ind:GeocodeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:airportFeeId rdf:type rdf:Property ;
    rdfs:label 'Airport Fee Id' ;
    rdfs:comment 'Unique identifier for the airport fee transaction record.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:airportCode rdf:type rdf:Property ;
    rdfs:label 'Airport Code' ;
    rdfs:comment 'Federal Aviation Administration (FAA) assigned airport identifier code (IATA or ICAO format).' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airlineCode rdf:type rdf:Property ;
    rdfs:label 'Airline Code' ;
    rdfs:comment 'IATA or ICAO airline designator code for the carrier being charged the fee.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeType rdf:type rdf:Property ;
    rdfs:label 'Fee Type' ;
    rdfs:comment 'Category of airport service fee being charged to the airline or operator.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCategory rdf:type rdf:Property ;
    rdfs:label 'Fee Category' ;
    rdfs:comment 'High-level classification of the fee as aeronautical (directly related to aircraft operations) or non-aeronautical revenue.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'Start date of the billing period for recurring or aggregated fees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'End date of the billing period for recurring or aggregated fees.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baseFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Base Fee Amount' ;
    rdfs:comment 'Base or standard fee amount before any adjustments, discounts, or surcharges are applied.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aircraftWeightClass rdf:type rdf:Property ;
    rdfs:label 'Aircraft Weight Class' ;
    rdfs:comment 'FAA weight classification of the aircraft used for fee calculation purposes.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumTakeoffWeightLbs rdf:type rdf:Property ;
    rdfs:label 'Maximum Takeoff Weight Lbs' ;
    rdfs:comment 'Maximum certified takeoff weight of the aircraft in pounds, used as a basis for weight-based fee calculations.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:landingCount rdf:type rdf:Property ;
    rdfs:label 'Landing Count' ;
    rdfs:comment 'Number of aircraft landings included in this fee transaction.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parkingHours rdf:type rdf:Property ;
    rdfs:label 'Parking Hours' ;
    rdfs:comment 'Total number of hours the aircraft was parked at the airport facility.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gateHours rdf:type rdf:Property ;
    rdfs:label 'Gate Hours' ;
    rdfs:comment 'Total number of hours the aircraft occupied a gate position.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cargoWeightLbs rdf:type rdf:Property ;
    rdfs:label 'Cargo Weight Lbs' ;
    rdfs:comment 'Total weight of cargo in pounds loaded or unloaded for cargo-based fee calculations.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelGallons rdf:type rdf:Property ;
    rdfs:label 'Fuel Gallons' ;
    rdfs:comment 'Number of gallons of fuel dispensed for fuel flowage fee calculations.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminalName rdf:type rdf:Property ;
    rdfs:label 'Terminal Name' ;
    rdfs:comment 'Name or identifier of the airport terminal where services were provided.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apronLocation rdf:type rdf:Property ;
    rdfs:label 'Apron Location' ;
    rdfs:comment 'Specific apron or ramp area location where the aircraft was positioned.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Code' ;
    rdfs:comment 'Code identifying the specific rate schedule or tariff applied to calculate the fee.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratePerUnit rdf:type rdf:Property ;
    rdfs:label 'Rate Per Unit' ;
    rdfs:comment 'Unit rate applied to calculate the fee (e.g., dollars per landing, dollars per 1000 lbs, dollars per hour).' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Explanation or justification if the fee was waived or reduced from standard rates.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved By' ;
    rdfs:comment 'Name or identifier of the authority who approved the fee waiver or reduction.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Approval Date' ;
    rdfs:comment 'Date when the fee waiver or reduction was officially approved.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordedBy rdf:type rdf:Property ;
    rdfs:label 'Recorded By' ;
    rdfs:comment 'Name or identifier of the staff member who recorded the fee transaction.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Contract Effective Date' ;
    rdfs:comment 'Effective date of the airline operating agreement or contract.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:latePaymentPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Amount' ;
    rdfs:comment 'Penalty amount assessed for late payment of the airport fee.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Reference' ;
    rdfs:comment 'Original transaction identifier from the source operational system.' ;
    rdfs:domain ind:AirportFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionTypeId rdf:type rdf:Property ;
    rdfs:label 'Inspection Type Id' ;
    rdfs:comment 'Unique identifier for the bridge inspection type. Primary key for the inspection type lookup table.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionType .

ind:nbisRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Nbis Required Flag' ;
    rdfs:comment 'Indicates whether this inspection type is mandated by federal NBIS regulations (23 CFR 650). True for routine, fracture critical, and underwater inspections; false for optional or state-specific inspection types.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Frequency Months' ;
    rdfs:comment 'Standard inspection frequency interval in months as defined by NBIS or NCDOT policy. For example, routine inspections are typically 24 months, fracture critical inspections may be 24 months, and underwater inspections may be 60 months.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Minimum Frequency Months' ;
    rdfs:comment 'Minimum allowable frequency interval in months for this inspection type, representing the most frequent inspection cycle permitted under NBIS or NCDOT standards.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Maximum Frequency Months' ;
    rdfs:comment 'Maximum allowable frequency interval in months for this inspection type, representing the longest permissible time between inspections under NBIS or NCDOT standards before non-compliance occurs.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triggerEvent rdf:type rdf:Property ;
    rdfs:label 'Trigger Event' ;
    rdfs:comment 'Specific event or condition that triggers this inspection type (e.g., hurricane, flood, earthquake, vehicle impact, fire, structural damage report, routine schedule). Applicable primarily to unscheduled and emergency inspection types.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionLevel rdf:type rdf:Property ;
    rdfs:label 'Inspection Level' ;
    rdfs:comment 'Inspection depth level as defined by AASHTO Manual for Bridge Evaluation: Level 1 (visual), Level 2 (detailed visual with access), Level 3 (highly detailed with NDE), Level 4 (laboratory testing).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessRequirements rdf:type rdf:Property ;
    rdfs:label 'Access Requirements' ;
    rdfs:comment 'Description of special access equipment or methods required to perform this inspection type (e.g., snooper truck, ladder, boat, diving equipment, rope access, traffic control, lane closure).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialEquipmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Special Equipment Required Flag' ;
    rdfs:comment 'Indicates whether specialized equipment beyond standard inspection tools is required for this inspection type (e.g., underwater diving gear, ultrasonic testing equipment, snooper trucks, drones).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualifiedInspectorLevel rdf:type rdf:Property ;
    rdfs:label 'Qualified Inspector Level' ;
    rdfs:comment 'Minimum qualification level required for inspectors performing this inspection type, as defined by NBIS and NCDOT certification standards (e.g., team leader, bridge inspector, fracture critical inspector, underwater inspector, NDE technician).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamSizeMinimum rdf:type rdf:Property ;
    rdfs:label 'Team Size Minimum' ;
    rdfs:comment 'Minimum number of qualified personnel required to safely and effectively perform this inspection type, as defined by NBIS safety standards and NCDOT policy.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingFormat rdf:type rdf:Property ;
    rdfs:label 'Reporting Format' ;
    rdfs:comment 'Standard reporting format or template required for documenting results of this inspection type (e.g., NBI format for routine inspections, detailed narrative report for special inspections, NDE report for non-destructive evaluation).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nbiSubmissionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Nbi Submission Required Flag' ;
    rdfs:comment 'Indicates whether results from this inspection type must be submitted to the National Bridge Inventory database maintained by FHWA.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bmsIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Bms Integration Flag' ;
    rdfs:comment 'Indicates whether inspection results from this type are integrated into the NCDOT Bridge Management System for condition assessment, prioritization, and lifecycle planning.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costEstimateLow rdf:type rdf:Property ;
    rdfs:label 'Cost Estimate Low' ;
    rdfs:comment 'Lower bound of typical cost range in USD to perform this inspection type for an average bridge structure. Used for budgeting and resource allocation.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costEstimateHigh rdf:type rdf:Property ;
    rdfs:label 'Cost Estimate High' ;
    rdfs:comment 'Upper bound of typical cost range in USD to perform this inspection type for an average bridge structure. Used for budgeting and resource allocation.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seasonalRestrictions rdf:type rdf:Property ;
    rdfs:label 'Seasonal Restrictions' ;
    rdfs:comment 'Description of any seasonal restrictions or preferred timing for this inspection type (e.g., underwater inspections best performed in summer, avoid winter for detailed inspections due to ice, environmental restrictions during nesting season).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Safety Risk Level' ;
    rdfs:comment 'Assessment of inherent safety risk to inspection personnel performing this inspection type: extreme (underwater, high elevation rope access), high (under-bridge access, confined spaces), moderate (traffic exposure), low (visual from ground).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableBridgeTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Bridge Types' ;
    rdfs:comment 'Types of bridge structures for which this inspection type is applicable or required (e.g., all bridges, fracture critical bridges only, movable bridges, suspension bridges, truss bridges, bridges over water).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableMaterialTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Material Types' ;
    rdfs:comment 'Bridge construction material types for which this inspection type is applicable (e.g., steel, concrete, timber, composite). Some inspection types are material-specific (e.g., fracture critical inspections primarily for steel structures).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionRatingImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Condition Rating Impact Flag' ;
    rdfs:comment 'Indicates whether results from this inspection type directly impact the official NBI condition ratings (deck rating, superstructure rating, substructure rating, culvert rating).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadRatingImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Load Rating Impact Flag' ;
    rdfs:comment 'Indicates whether findings from this inspection type may trigger a load rating analysis or update to the bridge operating and inventory ratings.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closureRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Closure Risk Flag' ;
    rdfs:comment 'Indicates whether this inspection type has potential to identify conditions that could result in immediate bridge closure or load posting (typically true for damage inspections, special inspections, and fracture critical inspections).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpInspectionType rdf:type rdf:Property ;
    rdfs:label 'Follow Up Inspection Type' ;
    rdfs:comment 'Type of follow-up inspection typically required or recommended based on findings from this inspection type (e.g., routine inspection may trigger special inspection, damage inspection may trigger in-depth inspection).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRequirements rdf:type rdf:Property ;
    rdfs:label 'Documentation Requirements' ;
    rdfs:comment 'Specific documentation requirements for this inspection type beyond standard reporting (e.g., photographic documentation of all members, sketches of damage locations, NDE test results, underwater video footage, drone imagery).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoDocumentationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Photo Documentation Required Flag' ;
    rdfs:comment 'Indicates whether photographic documentation is mandatory for this inspection type as part of the inspection record.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:videoDocumentationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Video Documentation Required Flag' ;
    rdfs:comment 'Indicates whether video documentation is required for this inspection type (typically true for underwater inspections and some special inspections).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ndeMethodsApplicable rdf:type rdf:Property ;
    rdfs:label 'Nde Methods Applicable' ;
    rdfs:comment 'List of non-destructive evaluation methods that may be employed during this inspection type (e.g., ultrasonic testing, magnetic particle testing, dye penetrant testing, ground penetrating radar, acoustic emission testing).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityAssuranceLevel rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Level' ;
    rdfs:comment 'Level of quality assurance review required for inspection reports of this type: Level 1 (peer review), Level 2 (supervisory review), Level 3 (independent QA team review). Higher risk inspection types require higher QA levels.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Review Approval Required Flag' ;
    rdfs:comment 'Indicates whether inspection reports of this type require formal review and approval by a qualified team leader or program manager before finalization.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhwaNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Fhwa Notification Required Flag' ;
    rdfs:comment 'Indicates whether FHWA must be notified of inspection findings from this type (typically true for critical findings, bridge closures, or significant structural deficiencies).' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByInspectionType rdf:type rdf:Property ;
    rdfs:label 'Superseded By Inspection Type' ;
    rdfs:comment 'Code or name of the inspection type that replaced this inspection type, if applicable. Used to track evolution of inspection standards and practices.' ;
    rdfs:domain ind:InspectionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'Primary regulatory authority or standard that defines or mandates this inspection type (e.g., FHWA NBIS, AASHTO Manual for Bridge Evaluation, NCDOT Bridge Inspection Manual, State Statute).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetName rdf:type rdf:Property ;
    rdfs:label 'Dataset Name' ;
    rdfs:comment 'The name of the feature dataset grouping related feature classes within the geodatabase.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:globalId rdf:type rdf:Property ;
    rdfs:label 'Global Id' ;
    rdfs:comment 'Globally unique identifier (GUID) for the feature enabling synchronization and replication across distributed GIS environments.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectId rdf:type rdf:Property ;
    rdfs:label 'Object Id' ;
    rdfs:comment 'Internal object identifier assigned by the geodatabase for feature management and indexing.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geometryWkb rdf:type rdf:Property ;
    rdfs:label 'Geometry Wkb' ;
    rdfs:comment 'The spatial geometry of the feature represented in Well-Known Binary (WKB) format for efficient storage and processing.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinateSystemName rdf:type rdf:Property ;
    rdfs:label 'Coordinate System Name' ;
    rdfs:comment 'The name of the coordinate system or projection used for the feature (e.g., NAD83 State Plane North Carolina, WGS84).' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:xCoordinate rdf:type rdf:Property ;
    rdfs:label 'X Coordinate' ;
    rdfs:comment 'The X coordinate (longitude) of the feature centroid or representative point in the defined spatial reference system.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yCoordinate rdf:type rdf:Property ;
    rdfs:label 'Y Coordinate' ;
    rdfs:comment 'The Y coordinate (latitude) of the feature centroid or representative point in the defined spatial reference system.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zCoordinate rdf:type rdf:Property ;
    rdfs:label 'Z Coordinate' ;
    rdfs:comment 'The Z coordinate (elevation) of the feature in the defined spatial reference system, if applicable.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lengthMeters rdf:type rdf:Property ;
    rdfs:label 'Length Meters' ;
    rdfs:comment 'The calculated length of the feature in meters, applicable to line and polygon features.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaSquareMeters rdf:type rdf:Property ;
    rdfs:label 'Area Square Meters' ;
    rdfs:comment 'The calculated area of the feature in square meters, applicable to polygon features.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perimeterMeters rdf:type rdf:Property ;
    rdfs:label 'Perimeter Meters' ;
    rdfs:comment 'The calculated perimeter of the feature in meters, applicable to polygon features.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:municipalityCode rdf:type rdf:Property ;
    rdfs:label 'Municipality Code' ;
    rdfs:comment 'The code identifying the municipality or incorporated area where the feature is located.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceUnitCode rdf:type rdf:Property ;
    rdfs:label 'Maintenance Unit Code' ;
    rdfs:comment 'The code identifying the NCDOT maintenance unit responsible for the feature.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementCostUsd rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Usd' ;
    rdfs:comment 'The estimated cost to replace the feature in current US dollars.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquisitionCostUsd rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost Usd' ;
    rdfs:comment 'The original acquisition or construction cost of the feature in US dollars.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalDocumentType rdf:type rdf:Property ;
    rdfs:label 'Environmental Document Type' ;
    rdfs:comment 'The type of environmental documentation completed for the feature (CE - Categorical Exclusion, EA - Environmental Assessment, EIS - Environmental Impact Statement, FONSI - Finding of No Significant Impact).' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataAccuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Data Accuracy Meters' ;
    rdfs:comment 'The horizontal positional accuracy of the feature geometry in meters.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:verticalAccuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Vertical Accuracy Meters' ;
    rdfs:comment 'The vertical positional accuracy of the feature elevation data in meters.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:metadataStandard rdf:type rdf:Property ;
    rdfs:label 'Metadata Standard' ;
    rdfs:comment 'The metadata standard used to document the feature (e.g., FGDC CSDGM, ISO 19115).' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicationStatus rdf:type rdf:Property ;
    rdfs:label 'Publication Status' ;
    rdfs:comment 'The publication status of the feature in the GIS system (draft, published, archived, deprecated).' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicAccessIndicator rdf:type rdf:Property ;
    rdfs:label 'Public Access Indicator' ;
    rdfs:comment 'Indicator whether the feature data is available for public access and distribution.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:editorName rdf:type rdf:Property ;
    rdfs:label 'Editor Name' ;
    rdfs:comment 'The name or identifier of the user who last edited the feature.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:editDate rdf:type rdf:Property ;
    rdfs:label 'Edit Date' ;
    rdfs:comment 'The timestamp when the feature was last edited or modified.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:parentFeatureId rdf:type rdf:Property ;
    rdfs:label 'Parent Feature Id' ;
    rdfs:comment 'The identifier of the parent feature in hierarchical feature relationships (e.g., a segment belonging to a route).' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hyperlinkUrl rdf:type rdf:Property ;
    rdfs:label 'Hyperlink Url' ;
    rdfs:comment 'A hyperlink URL to external resources or documentation related to the feature.' ;
    rdfs:domain ind:Feature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pilotLicenseId rdf:type rdf:Property ;
    rdfs:label 'Pilot License Id' ;
    rdfs:comment 'Unique identifier for the pilot license record. Primary key for the pilot license data product.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicalCertificateClass rdf:type rdf:Property ;
    rdfs:label 'Medical Certificate Class' ;
    rdfs:comment 'The class of medical certificate held by the pilot, indicating the level of medical fitness required for their license type.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalCertificateIssueDate rdf:type rdf:Property ;
    rdfs:label 'Medical Certificate Issue Date' ;
    rdfs:comment 'The date on which the pilot\'s current medical certificate was issued by an Federal Aviation Administration (FAA) Aviation Medical Examiner (AME).' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalCertificateExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Medical Certificate Expiration Date' ;
    rdfs:comment 'The date on which the pilot\'s medical certificate expires and requires renewal to maintain flight privileges.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalCertificateStatus rdf:type rdf:Property ;
    rdfs:label 'Medical Certificate Status' ;
    rdfs:comment 'The current status of the pilot\'s medical certificate, indicating whether it is valid for flight operations.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalRestrictions rdf:type rdf:Property ;
    rdfs:label 'Medical Restrictions' ;
    rdfs:comment 'Any limitations or restrictions placed on the pilot\'s medical certificate by the Federal Aviation Administration (FAA), such as corrective lenses required or daytime flight only.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Instrument Rating Flag' ;
    rdfs:comment 'Indicates whether the pilot holds an instrument rating, allowing flight under Instrument Flight Rules (IFR) and in instrument meteorological conditions.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentRatingDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Rating Date' ;
    rdfs:comment 'The date on which the pilot\'s instrument rating was issued, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:multiEngineRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Engine Rating Flag' ;
    rdfs:comment 'Indicates whether the pilot holds a multi-engine rating, allowing operation of aircraft with more than one engine.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multiEngineRatingDate rdf:type rdf:Property ;
    rdfs:label 'Multi Engine Rating Date' ;
    rdfs:comment 'The date on which the pilot\'s multi-engine rating was issued, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:flightInstructorRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Flight Instructor Rating Flag' ;
    rdfs:comment 'Indicates whether the pilot holds a Certified Flight Instructor (CFI) rating, allowing them to provide flight instruction.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flightInstructorRatingDate rdf:type rdf:Property ;
    rdfs:label 'Flight Instructor Rating Date' ;
    rdfs:comment 'The date on which the pilot\'s Certified Flight Instructor (CFI) rating was issued, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:typeRatings rdf:type rdf:Property ;
    rdfs:label 'Type Ratings' ;
    rdfs:comment 'A comma-separated list of specific aircraft type ratings held by the pilot, required for operation of large or turbojet-powered aircraft.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFlightHours rdf:type rdf:Property ;
    rdfs:label 'Total Flight Hours' ;
    rdfs:comment 'The cumulative total number of flight hours logged by the pilot across all aircraft types and conditions.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pilotInCommandHours rdf:type rdf:Property ;
    rdfs:label 'Pilot In Command Hours' ;
    rdfs:comment 'The total number of flight hours during which the pilot served as Pilot in Command (PIC), having final authority and responsibility for the flight.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:instrumentFlightHours rdf:type rdf:Property ;
    rdfs:label 'Instrument Flight Hours' ;
    rdfs:comment 'The total number of flight hours logged under Instrument Flight Rules (IFR) or in simulated instrument conditions.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crossCountryHours rdf:type rdf:Property ;
    rdfs:label 'Cross Country Hours' ;
    rdfs:comment 'The total number of cross-country flight hours, defined as flights with landings at points more than 50 nautical miles from the departure point.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nightFlightHours rdf:type rdf:Property ;
    rdfs:label 'Night Flight Hours' ;
    rdfs:comment 'The total number of flight hours logged during night conditions, defined as the period from the end of evening civil twilight to the beginning of morning civil twilight.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastFlightReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Flight Review Date' ;
    rdfs:comment 'The date of the pilot\'s most recent biennial flight review, required to maintain currency for acting as Pilot in Command (PIC).' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextFlightReviewDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Flight Review Due Date' ;
    rdfs:comment 'The date by which the pilot must complete their next biennial flight review to maintain currency.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastInstrumentProficiencyCheckDate rdf:type rdf:Property ;
    rdfs:label 'Last Instrument Proficiency Check Date' ;
    rdfs:comment 'The date of the pilot\'s most recent Instrument Proficiency Check (IPC), required to maintain instrument currency.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:citizenshipCountryCode rdf:type rdf:Property ;
    rdfs:label 'Citizenship Country Code' ;
    rdfs:comment 'The three-letter ISO country code representing the pilot\'s country of citizenship.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tsaCitizenshipVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Tsa Citizenship Verification Flag' ;
    rdfs:comment 'Indicates whether the pilot has completed Transportation Security Administration (TSA) citizenship verification requirements for flight training, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tsaVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Tsa Verification Date' ;
    rdfs:comment 'The date on which Transportation Security Administration (TSA) citizenship verification was completed, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingExaminerName rdf:type rdf:Property ;
    rdfs:label 'Issuing Examiner Name' ;
    rdfs:comment 'The name of the Designated Pilot Examiner (DPE) or Federal Aviation Administration (FAA) inspector who conducted the practical test and issued the license.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingExaminerCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Issuing Examiner Certificate Number' ;
    rdfs:comment 'The certificate number of the Designated Pilot Examiner (DPE) who conducted the practical test.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practicalTestDate rdf:type rdf:Property ;
    rdfs:label 'Practical Test Date' ;
    rdfs:comment 'The date on which the pilot successfully completed the practical test (checkride) for the license.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:knowledgeTestDate rdf:type rdf:Property ;
    rdfs:label 'Knowledge Test Date' ;
    rdfs:comment 'The date on which the pilot successfully completed the Federal Aviation Administration (FAA) knowledge test (written exam) for the license.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:knowledgeTestScore rdf:type rdf:Property ;
    rdfs:label 'Knowledge Test Score' ;
    rdfs:comment 'The numerical score achieved by the pilot on the Federal Aviation Administration (FAA) knowledge test, typically expressed as a percentage.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Training Institution Name' ;
    rdfs:comment 'The name of the flight school or training institution where the pilot completed their primary flight training.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingInstitutionCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Training Institution Certificate Number' ;
    rdfs:comment 'The Federal Aviation Administration (FAA) certificate number of the flight training institution, if it is a Part 141 certified school.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:englishProficiencyLevel rdf:type rdf:Property ;
    rdfs:label 'English Proficiency Level' ;
    rdfs:comment 'The International Civil Aviation Organization (ICAO) English language proficiency level of the pilot, required for international operations.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:englishProficiencyTestDate rdf:type rdf:Property ;
    rdfs:label 'English Proficiency Test Date' ;
    rdfs:comment 'The date on which the pilot\'s English language proficiency was assessed, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:violationsCount rdf:type rdf:Property ;
    rdfs:label 'Violations Count' ;
    rdfs:comment 'The total number of Federal Aviation Regulation (FAR) violations recorded against the pilot\'s license.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accidentsCount rdf:type rdf:Property ;
    rdfs:label 'Accidents Count' ;
    rdfs:comment 'The total number of reportable aircraft accidents in which the pilot was involved as Pilot in Command (PIC) or crew member.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incidentsCount rdf:type rdf:Property ;
    rdfs:label 'Incidents Count' ;
    rdfs:comment 'The total number of reportable aircraft incidents in which the pilot was involved as Pilot in Command (PIC) or crew member.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:securityClearanceLevel rdf:type rdf:Property ;
    rdfs:label 'Security Clearance Level' ;
    rdfs:comment 'The level of security clearance held by the pilot, if applicable for military or government aviation operations.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityClearanceExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Security Clearance Expiration Date' ;
    rdfs:comment 'The date on which the pilot\'s security clearance expires, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ncAviationRegistrationFlag rdf:type rdf:Property ;
    rdfs:label 'Nc Aviation Registration Flag' ;
    rdfs:comment 'Indicates whether the pilot is registered with the North Carolina Department of Transportation (NCDOT) Division of Aviation for state-level tracking and coordination.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncRegistrationDate rdf:type rdf:Property ;
    rdfs:label 'Nc Registration Date' ;
    rdfs:comment 'The date on which the pilot registered with the North Carolina Department of Transportation (NCDOT) Division of Aviation, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ncBasedAirportCode rdf:type rdf:Property ;
    rdfs:label 'Nc Based Airport Code' ;
    rdfs:comment 'The Federal Aviation Administration (FAA) airport identifier code for the pilot\'s primary base airport within North Carolina, if applicable.' ;
    rdfs:domain ind:PilotLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mapLayerId rdf:type rdf:Property ;
    rdfs:label 'Map Layer Id' ;
    rdfs:comment 'Unique identifier for each map layer published in ArcGIS Enterprise. Primary key for the map layer entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MapLayer .

ind:layerType rdf:type rdf:Property ;
    rdfs:label 'Layer Type' ;
    rdfs:comment 'The technical type of the map layer indicating the data structure and rendering method used in ArcGIS Enterprise.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geometryType rdf:type rdf:Property ;
    rdfs:label 'Geometry Type' ;
    rdfs:comment 'The geometric representation type for feature layers, defining how spatial features are stored and displayed (e.g., highway centerlines as polylines, bridge locations as points).' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDatasetName rdf:type rdf:Property ;
    rdfs:label 'Source Dataset Name' ;
    rdfs:comment 'The name of the underlying source dataset or feature class from which this map layer is derived. Links the published layer to its authoritative data source.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDatabase rdf:type rdf:Property ;
    rdfs:label 'Source Database' ;
    rdfs:comment 'The database or geodatabase containing the source dataset for this map layer (e.g., SDE connection, file geodatabase path).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceUrl rdf:type rdf:Property ;
    rdfs:label 'Service Url' ;
    rdfs:comment 'The REST endpoint URL where this map layer service is published and accessible to consuming applications and users.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:folderPath rdf:type rdf:Property ;
    rdfs:label 'Folder Path' ;
    rdfs:comment 'The organizational folder path within ArcGIS Enterprise where this layer is stored, supporting hierarchical organization by division or domain (e.g., /DOH/Highway_Assets, /DMV/Facilities).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerUsername rdf:type rdf:Property ;
    rdfs:label 'Owner Username' ;
    rdfs:comment 'The ArcGIS Enterprise username of the individual or service account that owns and maintains this map layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerDivision rdf:type rdf:Property ;
    rdfs:label 'Owner Division' ;
    rdfs:comment 'The NCDOT division responsible for maintaining and updating this map layer (e.g., Division of Highways, Division of Motor Vehicles).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visibility rdf:type rdf:Property ;
    rdfs:label 'Visibility' ;
    rdfs:comment 'The access visibility level determining who can discover and view this map layer within and outside NCDOT.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharingLevel rdf:type rdf:Property ;
    rdfs:label 'Sharing Level' ;
    rdfs:comment 'The ArcGIS Enterprise sharing configuration controlling which users and groups can access this layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minScale rdf:type rdf:Property ;
    rdfs:label 'Min Scale' ;
    rdfs:comment 'The minimum map scale at which this layer is visible. Layers are hidden when zoomed out beyond this scale to optimize performance and readability.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxScale rdf:type rdf:Property ;
    rdfs:label 'Max Scale' ;
    rdfs:comment 'The maximum map scale at which this layer is visible. Layers are hidden when zoomed in beyond this scale to prevent inappropriate detail levels.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultVisibility rdf:type rdf:Property ;
    rdfs:label 'Default Visibility' ;
    rdfs:comment 'Indicates whether this layer is visible by default when added to a map or web application. Users can toggle visibility after loading.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:opacity rdf:type rdf:Property ;
    rdfs:label 'Opacity' ;
    rdfs:comment 'The transparency level of the layer expressed as a percentage (0-100), where 100 is fully opaque and 0 is fully transparent.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rendererType rdf:type rdf:Property ;
    rdfs:label 'Renderer Type' ;
    rdfs:comment 'The symbolization method used to render features in this layer, determining how data values are visually represented on the map.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rendererDefinition rdf:type rdf:Property ;
    rdfs:label 'Renderer Definition' ;
    rdfs:comment 'The JSON or XML definition of the rendering properties including symbols, colors, sizes, and classification rules applied to this layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labelingEnabled rdf:type rdf:Property ;
    rdfs:label 'Labeling Enabled' ;
    rdfs:comment 'Indicates whether feature labels are displayed on the map for this layer (e.g., highway route numbers, facility names).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labelField rdf:type rdf:Property ;
    rdfs:label 'Label Field' ;
    rdfs:comment 'The attribute field name used to generate labels for features in this layer when labeling is enabled.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labelExpression rdf:type rdf:Property ;
    rdfs:label 'Label Expression' ;
    rdfs:comment 'The expression or formula used to construct complex labels from multiple fields or with formatting (e.g., concatenating route type and number).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:popupEnabled rdf:type rdf:Property ;
    rdfs:label 'Popup Enabled' ;
    rdfs:comment 'Indicates whether popup windows displaying feature attributes are enabled when users click on features in this layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:popupTemplate rdf:type rdf:Property ;
    rdfs:label 'Popup Template' ;
    rdfs:comment 'The HTML or JSON template defining the structure and content of popup windows for features in this layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureCount rdf:type rdf:Property ;
    rdfs:label 'Feature Count' ;
    rdfs:comment 'The total number of spatial features (points, lines, or polygons) contained in this map layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extentXmin rdf:type rdf:Property ;
    rdfs:label 'Extent Xmin' ;
    rdfs:comment 'The minimum X coordinate (westernmost longitude) of the bounding box encompassing all features in this layer.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extentYmin rdf:type rdf:Property ;
    rdfs:label 'Extent Ymin' ;
    rdfs:comment 'The minimum Y coordinate (southernmost latitude) of the bounding box encompassing all features in this layer.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extentXmax rdf:type rdf:Property ;
    rdfs:label 'Extent Xmax' ;
    rdfs:comment 'The maximum X coordinate (easternmost longitude) of the bounding box encompassing all features in this layer.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extentYmax rdf:type rdf:Property ;
    rdfs:label 'Extent Ymax' ;
    rdfs:comment 'The maximum Y coordinate (northernmost latitude) of the bounding box encompassing all features in this layer.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updateFrequency rdf:type rdf:Property ;
    rdfs:label 'Update Frequency' ;
    rdfs:comment 'The expected frequency at which the source data for this layer is refreshed or updated, informing users about data currency.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Update Date' ;
    rdfs:comment 'The date when the source data for this map layer was last updated or refreshed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastEditDate rdf:type rdf:Property ;
    rdfs:label 'Last Edit Date' ;
    rdfs:comment 'The date when the map layer configuration or properties were last modified in ArcGIS Enterprise.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:copyrightText rdf:type rdf:Property ;
    rdfs:label 'Copyright Text' ;
    rdfs:comment 'The copyright notice and attribution text to be displayed with this layer, acknowledging data sources and ownership.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:useRestrictions rdf:type rdf:Property ;
    rdfs:label 'Use Restrictions' ;
    rdfs:comment 'Legal or policy restrictions on the use, distribution, or reproduction of this map layer and its underlying data.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metadataUrl rdf:type rdf:Property ;
    rdfs:label 'Metadata Url' ;
    rdfs:comment 'The URL to the formal metadata record for this layer, providing detailed documentation of data lineage, quality, and standards compliance.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thumbnailUrl rdf:type rdf:Property ;
    rdfs:label 'Thumbnail Url' ;
    rdfs:comment 'The URL to a thumbnail image preview of this map layer used in catalogs and search results.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capabilities rdf:type rdf:Property ;
    rdfs:label 'Capabilities' ;
    rdfs:comment 'Comma-separated list of capabilities enabled for this layer service (e.g., Query, Create, Update, Delete, Sync, Extract).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsQuery rdf:type rdf:Property ;
    rdfs:label 'Supports Query' ;
    rdfs:comment 'Indicates whether this layer supports attribute and spatial queries through the REST API.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsEditing rdf:type rdf:Property ;
    rdfs:label 'Supports Editing' ;
    rdfs:comment 'Indicates whether this layer allows users to create, update, or delete features through web editing interfaces.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsAttachments rdf:type rdf:Property ;
    rdfs:label 'Supports Attachments' ;
    rdfs:comment 'Indicates whether this layer supports file attachments (photos, documents) associated with individual features.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsTime rdf:type rdf:Property ;
    rdfs:label 'Supports Time' ;
    rdfs:comment 'Indicates whether this layer is time-enabled, allowing temporal queries and animation of features over time.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeField rdf:type rdf:Property ;
    rdfs:label 'Time Field' ;
    rdfs:comment 'The attribute field name containing timestamp values used for temporal queries and visualization when time support is enabled.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeInterval rdf:type rdf:Property ;
    rdfs:label 'Time Interval' ;
    rdfs:comment 'The time interval unit and value for temporal aggregation or animation (e.g., 1 day, 1 hour).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:definitionQuery rdf:type rdf:Property ;
    rdfs:label 'Definition Query' ;
    rdfs:comment 'The SQL WHERE clause applied to filter which features from the source dataset are included in this published layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayField rdf:type rdf:Property ;
    rdfs:label 'Display Field' ;
    rdfs:comment 'The primary attribute field used to identify features in this layer when displaying results or popups.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectIdField rdf:type rdf:Property ;
    rdfs:label 'Object Id Field' ;
    rdfs:comment 'The name of the field containing unique object identifiers for features in this layer (typically OBJECTID or FID).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:globalIdField rdf:type rdf:Property ;
    rdfs:label 'Global Id Field' ;
    rdfs:comment 'The name of the field containing globally unique identifiers (GUIDs) for features, used for replication and synchronization.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shapeField rdf:type rdf:Property ;
    rdfs:label 'Shape Field' ;
    rdfs:comment 'The name of the geometry field containing the spatial coordinates and shape information for features in this layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hasZValues rdf:type rdf:Property ;
    rdfs:label 'Has Z Values' ;
    rdfs:comment 'Indicates whether feature geometries in this layer include Z coordinate values for elevation or height.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasMValues rdf:type rdf:Property ;
    rdfs:label 'Has M Values' ;
    rdfs:comment 'Indicates whether feature geometries in this layer include M (measure) values for linear referencing along routes.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drawingOrder rdf:type rdf:Property ;
    rdfs:label 'Drawing Order' ;
    rdfs:comment 'The numeric order in which this layer is drawn relative to other layers in a map, with lower numbers drawn first (bottom) and higher numbers drawn last (top).' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:refreshInterval rdf:type rdf:Property ;
    rdfs:label 'Refresh Interval' ;
    rdfs:comment 'The number of seconds between automatic refreshes of this layer in web maps and applications, used for real-time or frequently updated data.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxRecordCount rdf:type rdf:Property ;
    rdfs:label 'Max Record Count' ;
    rdfs:comment 'The maximum number of features that can be returned in a single query response from this layer service.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxImageHeight rdf:type rdf:Property ;
    rdfs:label 'Max Image Height' ;
    rdfs:comment 'The maximum height in pixels for map images exported from this layer service.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxImageWidth rdf:type rdf:Property ;
    rdfs:label 'Max Image Width' ;
    rdfs:comment 'The maximum width in pixels for map images exported from this layer service.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tileCacheEnabled rdf:type rdf:Property ;
    rdfs:label 'Tile Cache Enabled' ;
    rdfs:comment 'Indicates whether pre-generated map tiles are cached for this layer to improve performance and reduce server load.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tileScheme rdf:type rdf:Property ;
    rdfs:label 'Tile Scheme' ;
    rdfs:comment 'The tiling scheme used for cached layers, defining the spatial reference, tile size, and level of detail structure.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minLod rdf:type rdf:Property ;
    rdfs:label 'Min Lod' ;
    rdfs:comment 'The minimum zoom level (level of detail) at which tiles are generated and displayed for this cached layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxLod rdf:type rdf:Property ;
    rdfs:label 'Max Lod' ;
    rdfs:comment 'The maximum zoom level (level of detail) at which tiles are generated and displayed for this cached layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cacheSizeMb rdf:type rdf:Property ;
    rdfs:label 'Cache Size Mb' ;
    rdfs:comment 'The total storage size in megabytes of the tile cache for this layer, if tile caching is enabled.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:versionName rdf:type rdf:Property ;
    rdfs:label 'Version Name' ;
    rdfs:comment 'The geodatabase version name from which this layer is published, supporting multi-user editing workflows and version management.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isVersioned rdf:type rdf:Property ;
    rdfs:label 'Is Versioned' ;
    rdfs:comment 'Indicates whether the source dataset for this layer is registered as versioned in the geodatabase, enabling version-based editing.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isArchived rdf:type rdf:Property ;
    rdfs:label 'Is Archived' ;
    rdfs:comment 'Indicates whether the source dataset has archiving enabled, maintaining historical records of feature changes over time.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:syncEnabled rdf:type rdf:Property ;
    rdfs:label 'Sync Enabled' ;
    rdfs:comment 'Indicates whether this layer supports offline synchronization for mobile and disconnected editing workflows.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extractEnabled rdf:type rdf:Property ;
    rdfs:label 'Extract Enabled' ;
    rdfs:comment 'Indicates whether users can extract data from this layer for offline use or external analysis.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tags rdf:type rdf:Property ;
    rdfs:label 'Tags' ;
    rdfs:comment 'Comma-separated keywords and tags used for searching and discovering this layer in ArcGIS Enterprise catalogs and portals.' ;
    rdfs:domain ind:Gis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domain rdf:type rdf:Property ;
    rdfs:label 'Domain' ;
    rdfs:comment 'The NCDOT business domain that this map layer primarily supports, aligning with organizational divisions and functional areas.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityScore rdf:type rdf:Property ;
    rdfs:label 'Quality Score' ;
    rdfs:comment 'A numeric score (0-100) representing the overall data quality of this layer based on completeness, accuracy, and currency assessments.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completenessPercentage rdf:type rdf:Property ;
    rdfs:label 'Completeness Percentage' ;
    rdfs:comment 'The percentage of expected features and attributes that are present and populated in this layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionalAccuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Positional Accuracy Meters' ;
    rdfs:comment 'The estimated horizontal positional accuracy of features in this layer expressed in meters, indicating spatial precision.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineageDescription rdf:type rdf:Property ;
    rdfs:label 'Lineage Description' ;
    rdfs:comment 'A description of the data sources, processing steps, and transformations applied to create this map layer.' ;
    rdfs:domain ind:MapLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bridgeId rdf:type rdf:Property ;
    rdfs:label 'Bridge Id' ;
    rdfs:comment 'Unique identifier for each state-owned bridge in the NCDOT inventory. Primary key for bridge asset management and regulatory reporting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bridge .

ind:structureNumber rdf:type rdf:Property ;
    rdfs:label 'Structure Number' ;
    rdfs:comment 'Federal 15-digit structure identification number assigned per FHWA standards for National Bridge Inventory reporting.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityCarried rdf:type rdf:Property ;
    rdfs:label 'Facility Carried' ;
    rdfs:comment 'Description of the roadway or facility carried by the bridge (e.g., US 70, NC 54, I-40).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureIntersected rdf:type rdf:Property ;
    rdfs:label 'Feature Intersected' ;
    rdfs:comment 'Description of the feature crossed by the bridge (e.g., river name, railroad, highway, ravine).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routePrefix rdf:type rdf:Property ;
    rdfs:label 'Route Prefix' ;
    rdfs:comment 'Route prefix code indicating the type of route carried (e.g., I for Interstate, US for US Highway, NC for State Route).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeSuffix rdf:type rdf:Property ;
    rdfs:label 'Route Suffix' ;
    rdfs:comment 'Route suffix code providing additional route designation information (e.g., Business, Alternate, Bypass).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipDescription rdf:type rdf:Property ;
    rdfs:label 'Ownership Description' ;
    rdfs:comment 'Descriptive name of the entity that owns the bridge structure.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceResponsibilityCode rdf:type rdf:Property ;
    rdfs:label 'Maintenance Responsibility Code' ;
    rdfs:comment 'Two-digit code identifying the agency responsible for maintaining the bridge per FHWA coding standards.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceResponsibilityDescription rdf:type rdf:Property ;
    rdfs:label 'Maintenance Responsibility Description' ;
    rdfs:comment 'Descriptive name of the agency responsible for maintaining the bridge.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearBuilt rdf:type rdf:Property ;
    rdfs:label 'Year Built' ;
    rdfs:comment 'Four-digit year when the original bridge structure was constructed and opened to traffic.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yearReconstructed rdf:type rdf:Property ;
    rdfs:label 'Year Reconstructed' ;
    rdfs:comment 'Four-digit year when the bridge was reconstructed or underwent major rehabilitation that significantly changed its structural characteristics.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:structureTypeMainCode rdf:type rdf:Property ;
    rdfs:label 'Structure Type Main Code' ;
    rdfs:comment 'Two-digit code identifying the main span structure type and material per FHWA coding standards.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:structureTypeMainDescription rdf:type rdf:Property ;
    rdfs:label 'Structure Type Main Description' ;
    rdfs:comment 'Descriptive name of the main span structure type (e.g., Steel Girder, Prestressed Concrete, Concrete Arch).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:structureTypeApproachCode rdf:type rdf:Property ;
    rdfs:label 'Structure Type Approach Code' ;
    rdfs:comment 'Two-digit code identifying the approach span structure type and material per FHWA coding standards.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:structureTypeApproachDescription rdf:type rdf:Property ;
    rdfs:label 'Structure Type Approach Description' ;
    rdfs:comment 'Descriptive name of the approach span structure type.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfSpansMain rdf:type rdf:Property ;
    rdfs:label 'Number Of Spans Main' ;
    rdfs:comment 'Count of main spans in the bridge structure.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfSpansApproach rdf:type rdf:Property ;
    rdfs:label 'Number Of Spans Approach' ;
    rdfs:comment 'Count of approach spans in the bridge structure.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:structureLengthFt rdf:type rdf:Property ;
    rdfs:label 'Structure Length Ft' ;
    rdfs:comment 'Total length of the bridge structure measured in feet from back of back wall to back of back wall.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxSpanLengthFt rdf:type rdf:Property ;
    rdfs:label 'Max Span Length Ft' ;
    rdfs:comment 'Length of the longest span in the bridge structure measured in feet.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deckWidthFt rdf:type rdf:Property ;
    rdfs:label 'Deck Width Ft' ;
    rdfs:comment 'Out-to-out width of the bridge deck measured in feet, including parapets and railings.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roadwayWidthFt rdf:type rdf:Property ;
    rdfs:label 'Roadway Width Ft' ;
    rdfs:comment 'Curb-to-curb width of the roadway on the bridge measured in feet.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deckAreaSqFt rdf:type rdf:Property ;
    rdfs:label 'Deck Area Sq Ft' ;
    rdfs:comment 'Total area of the bridge deck measured in square feet, calculated as structure length multiplied by deck width.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lanesOnStructure rdf:type rdf:Property ;
    rdfs:label 'Lanes On Structure' ;
    rdfs:comment 'Number of lanes on the bridge structure available for vehicular traffic.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lanesUnderStructure rdf:type rdf:Property ;
    rdfs:label 'Lanes Under Structure' ;
    rdfs:comment 'Number of lanes passing under the bridge structure.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:truckTrafficPercent rdf:type rdf:Property ;
    rdfs:label 'Truck Traffic Percent' ;
    rdfs:comment 'Percentage of AADT that consists of truck traffic (vehicles with more than four tires touching the pavement).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:designLoadCode rdf:type rdf:Property ;
    rdfs:label 'Design Load Code' ;
    rdfs:comment 'Single-digit code identifying the live load for which the bridge was designed per AASHTO standards.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designLoadDescription rdf:type rdf:Property ;
    rdfs:label 'Design Load Description' ;
    rdfs:comment 'Descriptive name of the design load standard (e.g., HS20, HL93, H15).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingRatingTons rdf:type rdf:Property ;
    rdfs:label 'Operating Rating Tons' ;
    rdfs:comment 'Maximum permissible live load that the bridge can support for routine traffic, measured in tons.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inventoryRatingTons rdf:type rdf:Property ;
    rdfs:label 'Inventory Rating Tons' ;
    rdfs:comment 'Load level that the bridge can support for an indefinite period of time, measured in tons.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:channelConditionRating rdf:type rdf:Property ;
    rdfs:label 'Channel Condition Rating' ;
    rdfs:comment 'Single-digit rating (0-9 or N) assessing the condition of the channel and channel protection for bridges over waterways.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:culvertConditionRating rdf:type rdf:Property ;
    rdfs:label 'Culvert Condition Rating' ;
    rdfs:comment 'Single-digit rating (0-9 or N) assessing the condition of culvert structures.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:structuralEvaluation rdf:type rdf:Property ;
    rdfs:label 'Structural Evaluation' ;
    rdfs:comment 'Single-digit rating (0-9 or N) providing an overall structural evaluation of the bridge based on condition ratings.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deckGeometryEvaluation rdf:type rdf:Property ;
    rdfs:label 'Deck Geometry Evaluation' ;
    rdfs:comment 'Single-digit rating (0-9 or N) evaluating the deck geometry including roadway width and vertical clearance adequacy.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underclearanceEvaluation rdf:type rdf:Property ;
    rdfs:label 'Underclearance Evaluation' ;
    rdfs:comment 'Single-digit rating (0-9 or N) evaluating the adequacy of vertical and horizontal clearances under the bridge.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterwayAdequacyEvaluation rdf:type rdf:Property ;
    rdfs:label 'Waterway Adequacy Evaluation' ;
    rdfs:comment 'Single-digit rating (0-9 or N) evaluating the adequacy of the waterway opening for bridges over waterways.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approachRoadwayAlignment rdf:type rdf:Property ;
    rdfs:label 'Approach Roadway Alignment' ;
    rdfs:comment 'Single-digit rating (0-9 or N) evaluating the alignment and condition of approach roadways to the bridge.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sufficiencyRating rdf:type rdf:Property ;
    rdfs:label 'Sufficiency Rating' ;
    rdfs:comment 'Numeric rating (0-100) indicating the sufficiency of the bridge to remain in service, calculated using FHWA formula based on structural adequacy, serviceability, and essentiality.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:structurallyDeficientFlag rdf:type rdf:Property ;
    rdfs:label 'Structurally Deficient Flag' ;
    rdfs:comment 'Boolean indicator whether the bridge is classified as structurally deficient based on condition ratings.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:functionallyObsoleteFlag rdf:type rdf:Property ;
    rdfs:label 'Functionally Obsolete Flag' ;
    rdfs:comment 'Boolean indicator whether the bridge is classified as functionally obsolete based on geometry and clearance evaluations.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tollFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Toll Facility Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge is part of a toll facility.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parallelStructureDesignation rdf:type rdf:Property ;
    rdfs:label 'Parallel Structure Designation' ;
    rdfs:comment 'Code indicating whether the bridge is part of a parallel structure configuration (e.g., dual bridges carrying opposite directions of traffic).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficDirectionCode rdf:type rdf:Property ;
    rdfs:label 'Traffic Direction Code' ;
    rdfs:comment 'Single-digit code indicating the direction of traffic flow on the bridge (e.g., one-way, two-way).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temporaryStructureCode rdf:type rdf:Property ;
    rdfs:label 'Temporary Structure Code' ;
    rdfs:comment 'Single-character code indicating whether the bridge is a temporary structure.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highwaySystemCode rdf:type rdf:Property ;
    rdfs:label 'Highway System Code' ;
    rdfs:comment 'Single-digit code identifying the highway system to which the route on the bridge belongs.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalLandsHighwayCode rdf:type rdf:Property ;
    rdfs:label 'Federal Lands Highway Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge is on a Federal Lands Highway.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strahnetDesignation rdf:type rdf:Property ;
    rdfs:label 'Strahnet Designation' ;
    rdfs:comment 'Single-digit code indicating whether the bridge is on the Strategic Highway Network for national defense purposes.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verticalClearanceFt rdf:type rdf:Property ;
    rdfs:label 'Vertical Clearance Ft' ;
    rdfs:comment 'Minimum vertical clearance under the bridge measured in feet from the roadway surface to the lowest structural member.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:verticalClearanceOverFt rdf:type rdf:Property ;
    rdfs:label 'Vertical Clearance Over Ft' ;
    rdfs:comment 'Minimum vertical clearance over the bridge measured in feet from the bridge deck to overhead structures.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:horizontalClearanceFt rdf:type rdf:Property ;
    rdfs:label 'Horizontal Clearance Ft' ;
    rdfs:comment 'Minimum horizontal clearance under the bridge measured in feet between piers or abutments.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navigationControlCode rdf:type rdf:Property ;
    rdfs:label 'Navigation Control Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge is subject to navigation control requirements.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:navigationVerticalClearanceFt rdf:type rdf:Property ;
    rdfs:label 'Navigation Vertical Clearance Ft' ;
    rdfs:comment 'Minimum vertical clearance for navigation under the bridge measured in feet from normal water level.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navigationHorizontalClearanceFt rdf:type rdf:Property ;
    rdfs:label 'Navigation Horizontal Clearance Ft' ;
    rdfs:comment 'Minimum horizontal clearance for navigation under the bridge measured in feet between piers.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceOnBridgeCode rdf:type rdf:Property ;
    rdfs:label 'Service On Bridge Code' ;
    rdfs:comment 'Single-digit code identifying the type of service carried on the bridge (e.g., highway, pedestrian, railroad).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceUnderBridgeCode rdf:type rdf:Property ;
    rdfs:label 'Service Under Bridge Code' ;
    rdfs:comment 'Single-digit code identifying the type of service passing under the bridge (e.g., highway, railroad, waterway).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deckStructureTypeCode rdf:type rdf:Property ;
    rdfs:label 'Deck Structure Type Code' ;
    rdfs:comment 'Single-digit code identifying the type of deck structure (e.g., concrete, steel grid, timber).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wearingSurfaceTypeCode rdf:type rdf:Property ;
    rdfs:label 'Wearing Surface Type Code' ;
    rdfs:comment 'Single-digit code identifying the type of wearing surface on the bridge deck.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membraneTypeCode rdf:type rdf:Property ;
    rdfs:label 'Membrane Type Code' ;
    rdfs:comment 'Single-digit code identifying the type of membrane protection on the bridge deck.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deckProtectionCode rdf:type rdf:Property ;
    rdfs:label 'Deck Protection Code' ;
    rdfs:comment 'Single-digit code identifying the type of deck protection system installed.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pierProtectionCode rdf:type rdf:Property ;
    rdfs:label 'Pier Protection Code' ;
    rdfs:comment 'Single-digit code indicating whether pier protection systems are installed to prevent collision damage.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:railingsCode rdf:type rdf:Property ;
    rdfs:label 'Railings Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge has railings and their adequacy per current standards.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionsCode rdf:type rdf:Property ;
    rdfs:label 'Transitions Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge has approach guardrail transitions and their adequacy.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approachGuardrailCode rdf:type rdf:Property ;
    rdfs:label 'Approach Guardrail Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge approaches have guardrails and their adequacy.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approachGuardrailEndsCode rdf:type rdf:Property ;
    rdfs:label 'Approach Guardrail Ends Code' ;
    rdfs:comment 'Single-digit code indicating whether the approach guardrail ends meet current safety standards.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:historicalSignificanceCode rdf:type rdf:Property ;
    rdfs:label 'Historical Significance Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge has been evaluated for historical significance per National Historic Preservation Act.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingStatusCode rdf:type rdf:Property ;
    rdfs:label 'Posting Status Code' ;
    rdfs:comment 'Single-digit code indicating whether the bridge has weight restrictions posted.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedWeightLimitTons rdf:type rdf:Property ;
    rdfs:label 'Posted Weight Limit Tons' ;
    rdfs:comment 'Maximum weight limit posted on the bridge for legal vehicle loads, measured in tons.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:futureAadt rdf:type rdf:Property ;
    rdfs:label 'Future Aadt' ;
    rdfs:comment 'Projected average number of vehicles per day expected to cross the bridge in a future year.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:futureAadtYear rdf:type rdf:Property ;
    rdfs:label 'Future Aadt Year' ;
    rdfs:comment 'Four-digit year for which the future AADT projection is calculated.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detourLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Detour Length Miles' ;
    rdfs:comment 'Length of the detour route in miles if the bridge were closed to traffic.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:improvementCost rdf:type rdf:Property ;
    rdfs:label 'Improvement Cost' ;
    rdfs:comment 'Estimated cost in dollars for recommended bridge improvements or replacement.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roadwayImprovementCost rdf:type rdf:Property ;
    rdfs:label 'Roadway Improvement Cost' ;
    rdfs:comment 'Estimated cost in dollars for recommended roadway approach improvements associated with the bridge.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearOfImprovementCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Year Of Improvement Cost Estimate' ;
    rdfs:comment 'Four-digit year when the improvement cost estimate was prepared.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workProposedCode rdf:type rdf:Property ;
    rdfs:label 'Work Proposed Code' ;
    rdfs:comment 'Two-digit code identifying the type of work proposed for the bridge (e.g., replacement, rehabilitation, widening).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workDoneByCode rdf:type rdf:Property ;
    rdfs:label 'Work Done By Code' ;
    rdfs:comment 'Single-digit code identifying the entity responsible for performing proposed work (e.g., state forces, contract).' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipProjectNumber rdf:type rdf:Property ;
    rdfs:label 'Stip Project Number' ;
    rdfs:comment 'Project number assigned in the State Transportation Improvement Program for planned bridge work.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bmsBridgeKey rdf:type rdf:Property ;
    rdfs:label 'Bms Bridge Key' ;
    rdfs:comment 'Unique identifier for the bridge in the NCDOT Bridge Management System.' ;
    rdfs:domain ind:Bridge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tileCacheId rdf:type rdf:Property ;
    rdfs:label 'Tile Cache Id' ;
    rdfs:comment 'Unique identifier for the cached map tile configuration. Primary key for the tile cache reference data.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cacheName rdf:type rdf:Property ;
    rdfs:label 'Cache Name' ;
    rdfs:comment 'Descriptive name of the tile cache service or layer, used for identification and reference by GIS applications and users.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cacheDescription rdf:type rdf:Property ;
    rdfs:label 'Cache Description' ;
    rdfs:comment 'Detailed description of the tile cache content, purpose, and intended use cases within NCDOT transportation planning and operations.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tileFormat rdf:type rdf:Property ;
    rdfs:label 'Tile Format' ;
    rdfs:comment 'Image or data format used for storing individual tiles in the cache, affecting file size, quality, and compatibility.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tileMatrixSet rdf:type rdf:Property ;
    rdfs:label 'Tile Matrix Set' ;
    rdfs:comment 'Tiling scheme identifier defining the spatial reference system, origin, tile dimensions, and scale levels used for the cache.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minZoomLevel rdf:type rdf:Property ;
    rdfs:label 'Min Zoom Level' ;
    rdfs:comment 'Lowest level of detail (most zoomed out) available in the tile cache, typically ranging from 0 (world view) to higher numbers.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxZoomLevel rdf:type rdf:Property ;
    rdfs:label 'Max Zoom Level' ;
    rdfs:comment 'Highest level of detail (most zoomed in) available in the tile cache, determining the finest resolution accessible to users.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tileWidthPixels rdf:type rdf:Property ;
    rdfs:label 'Tile Width Pixels' ;
    rdfs:comment 'Width of each tile image in pixels, typically 256 or 512 pixels for standard web mapping applications.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tileHeightPixels rdf:type rdf:Property ;
    rdfs:label 'Tile Height Pixels' ;
    rdfs:comment 'Height of each tile image in pixels, typically 256 or 512 pixels for standard web mapping applications.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tileOriginX rdf:type rdf:Property ;
    rdfs:label 'Tile Origin X' ;
    rdfs:comment 'X-coordinate of the tile matrix origin point in the spatial reference system, defining the starting point for tile indexing.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tileOriginY rdf:type rdf:Property ;
    rdfs:label 'Tile Origin Y' ;
    rdfs:comment 'Y-coordinate of the tile matrix origin point in the spatial reference system, defining the starting point for tile indexing.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageLocationPath rdf:type rdf:Property ;
    rdfs:label 'Storage Location Path' ;
    rdfs:comment 'File system path, network share, or cloud storage location where the tile cache files are physically stored.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageType rdf:type rdf:Property ;
    rdfs:label 'Storage Type' ;
    rdfs:comment 'Method used to store tile cache files, affecting performance, scalability, and management characteristics.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cacheSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Cache Size Bytes' ;
    rdfs:comment 'Total storage space consumed by the tile cache in bytes, used for capacity planning and storage management.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tileCount rdf:type rdf:Property ;
    rdfs:label 'Tile Count' ;
    rdfs:comment 'Total number of individual tiles stored in the cache across all zoom levels and spatial extents.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cacheStatus rdf:type rdf:Property ;
    rdfs:label 'Cache Status' ;
    rdfs:comment 'Current operational status of the tile cache, indicating availability and maintenance state.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refreshScheduleType rdf:type rdf:Property ;
    rdfs:label 'Refresh Schedule Type' ;
    rdfs:comment 'Frequency pattern for updating the tile cache with new source data to maintain currency and accuracy.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refreshScheduleCron rdf:type rdf:Property ;
    rdfs:label 'Refresh Schedule Cron' ;
    rdfs:comment 'Cron expression defining the specific timing for automated tile cache refresh operations.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRefreshTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Refresh Timestamp' ;
    rdfs:comment 'Date and time when the tile cache was last successfully updated with new source data.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:nextScheduledRefreshTimestamp rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Refresh Timestamp' ;
    rdfs:comment 'Date and time when the next automated tile cache refresh is scheduled to occur.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceLayerName rdf:type rdf:Property ;
    rdfs:label 'Source Layer Name' ;
    rdfs:comment 'Name of the source GIS layer or feature class from which the tile cache is generated.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDataTimestamp rdf:type rdf:Property ;
    rdfs:label 'Source Data Timestamp' ;
    rdfs:comment 'Date and time when the source data used to build the current tile cache was last modified or published.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:antialiasingMode rdf:type rdf:Property ;
    rdfs:label 'Antialiasing Mode' ;
    rdfs:comment 'Level of antialiasing applied during tile rendering to smooth edges and improve visual quality.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compressionQuality rdf:type rdf:Property ;
    rdfs:label 'Compression Quality' ;
    rdfs:comment 'Quality level for lossy compression formats (JPEG), ranging from 0 (lowest quality, smallest size) to 100 (highest quality, largest size).' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resamplingMethod rdf:type rdf:Property ;
    rdfs:label 'Resampling Method' ;
    rdfs:comment 'Algorithm used to resample source imagery when generating tiles at different zoom levels.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transparencyEnabled rdf:type rdf:Property ;
    rdfs:label 'Transparency Enabled' ;
    rdfs:comment 'Indicates whether the tile cache supports transparent backgrounds, allowing overlay on other map layers.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backgroundColorHex rdf:type rdf:Property ;
    rdfs:label 'Background Color Hex' ;
    rdfs:comment 'Hexadecimal color code for the tile background when transparency is not enabled.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicCoverageArea rdf:type rdf:Property ;
    rdfs:label 'Geographic Coverage Area' ;
    rdfs:comment 'Descriptive name of the geographic area covered by the tile cache, such as county names, regions, or statewide.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Rest Endpoint Url' ;
    rdfs:comment 'RESTful API endpoint for programmatic access to tile cache metadata and tiles.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wmtsEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Wmts Endpoint Url' ;
    rdfs:comment 'OGC WMTS standard endpoint for accessing the tile cache through standard web mapping protocols.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessLevel rdf:type rdf:Property ;
    rdfs:label 'Access Level' ;
    rdfs:comment 'Security classification determining who can access and use the tile cache service.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authenticationRequired rdf:type rdf:Property ;
    rdfs:label 'Authentication Required' ;
    rdfs:comment 'Indicates whether users must authenticate before accessing the tile cache service.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authenticationMethod rdf:type rdf:Property ;
    rdfs:label 'Authentication Method' ;
    rdfs:comment 'Authentication mechanism used to verify user identity when accessing the tile cache.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerContactName rdf:type rdf:Property ;
    rdfs:label 'Owner Contact Name' ;
    rdfs:comment 'Name of the primary contact person responsible for the tile cache service.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Owner Contact Email' ;
    rdfs:comment 'Email address of the primary contact person for questions and issues related to the tile cache.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Owner Contact Phone' ;
    rdfs:comment 'Phone number of the primary contact person for the tile cache service.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessDomain rdf:type rdf:Property ;
    rdfs:label 'Business Domain' ;
    rdfs:comment 'NCDOT business domain or functional area that the tile cache primarily supports, such as Highway Operations, DMV, or Ferry Operations.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageCategory rdf:type rdf:Property ;
    rdfs:label 'Usage Category' ;
    rdfs:comment 'Primary use case category for the tile cache within NCDOT operations and services.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceTier rdf:type rdf:Property ;
    rdfs:label 'Performance Tier' ;
    rdfs:comment 'Service level tier indicating expected performance, availability, and support priority for the tile cache.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cacheBuildDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Cache Build Duration Minutes' ;
    rdfs:comment 'Time required to generate or rebuild the complete tile cache, used for maintenance planning.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageTileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Average Tile Size Bytes' ;
    rdfs:comment 'Mean file size of individual tiles in the cache, used for performance and bandwidth estimation.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cacheHitRatePercent rdf:type rdf:Property ;
    rdfs:label 'Cache Hit Rate Percent' ;
    rdfs:comment 'Percentage of tile requests served from cache versus requiring regeneration, indicating cache effectiveness.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dailyRequestCountAvg rdf:type rdf:Property ;
    rdfs:label 'Daily Request Count Avg' ;
    rdfs:comment 'Average number of tile requests served per day, used for capacity planning and usage analysis.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:concurrentUserLimit rdf:type rdf:Property ;
    rdfs:label 'Concurrent User Limit' ;
    rdfs:comment 'Maximum number of simultaneous users or connections supported by the tile cache service.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cdnEnabled rdf:type rdf:Property ;
    rdfs:label 'Cdn Enabled' ;
    rdfs:comment 'Indicates whether the tile cache is distributed through a content delivery network for improved performance.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnProvider rdf:type rdf:Property ;
    rdfs:label 'Cdn Provider' ;
    rdfs:comment 'Name of the CDN service provider used to distribute the tile cache, if applicable.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backupEnabled rdf:type rdf:Property ;
    rdfs:label 'Backup Enabled' ;
    rdfs:comment 'Indicates whether the tile cache is included in automated backup procedures for disaster recovery.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backupFrequency rdf:type rdf:Property ;
    rdfs:label 'Backup Frequency' ;
    rdfs:comment 'Frequency at which the tile cache is backed up to secondary storage.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastBackupTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Backup Timestamp' ;
    rdfs:comment 'Date and time when the tile cache was last successfully backed up.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:retentionPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Retention Period Days' ;
    rdfs:comment 'Number of days that tile cache versions and backups are retained before archival or deletion.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Creation Timestamp' ;
    rdfs:comment 'Date and time when the tile cache was initially created and configured.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deprecationDate rdf:type rdf:Property ;
    rdfs:label 'Deprecation Date' ;
    rdfs:comment 'Planned date when the tile cache will be deprecated and no longer actively maintained.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:copyrightStatement rdf:type rdf:Property ;
    rdfs:label 'Copyright Statement' ;
    rdfs:comment 'Copyright notice and attribution requirements for the tile cache content.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:horizontalAccuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Horizontal Accuracy Meters' ;
    rdfs:comment 'Estimated horizontal positional accuracy of features in the tile cache, measured in meters.' ;
    rdfs:domain ind:TileCache ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectBoundaryId rdf:type rdf:Property ;
    rdfs:label 'Project Boundary Id' ;
    rdfs:comment 'Unique identifier for the project boundary polygon geometry record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProjectBoundary .

ind:tipProjectNumber rdf:type rdf:Property ;
    rdfs:label 'Tip Project Number' ;
    rdfs:comment 'The Transportation Improvement Program project number for MPO or RPO coordinated projects.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundaryGeometry rdf:type rdf:Property ;
    rdfs:label 'Boundary Geometry' ;
    rdfs:comment 'The spatial polygon geometry defining the geographic extent of the project boundary, stored in Well-Known Text (WKT) or GeoJSON format.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundaryVersion rdf:type rdf:Property ;
    rdfs:label 'Boundary Version' ;
    rdfs:comment 'Version number of the project boundary geometry, incremented when boundary is revised or updated.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:boundaryStatus rdf:type rdf:Property ;
    rdfs:label 'Boundary Status' ;
    rdfs:comment 'Current approval and lifecycle status of the project boundary definition.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundaryType rdf:type rdf:Property ;
    rdfs:label 'Boundary Type' ;
    rdfs:comment 'Classification of the boundary purpose and scope within the project context.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:additionalCounties rdf:type rdf:Property ;
    rdfs:label 'Additional Counties' ;
    rdfs:comment 'Comma-separated list of additional counties if the project boundary spans multiple counties.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundaryAreaAcres rdf:type rdf:Property ;
    rdfs:label 'Boundary Area Acres' ;
    rdfs:comment 'The total area enclosed by the project boundary polygon, measured in acres.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundaryAreaSqMiles rdf:type rdf:Property ;
    rdfs:label 'Boundary Area Sq Miles' ;
    rdfs:comment 'The total area enclosed by the project boundary polygon, measured in square miles.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perimeterLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Perimeter Length Feet' ;
    rdfs:comment 'The total perimeter length of the project boundary polygon, measured in feet.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:centroidLatitude rdf:type rdf:Property ;
    rdfs:label 'Centroid Latitude' ;
    rdfs:comment 'The latitude coordinate of the geometric centroid of the project boundary polygon.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:centroidLongitude rdf:type rdf:Property ;
    rdfs:label 'Centroid Longitude' ;
    rdfs:comment 'The longitude coordinate of the geometric centroid of the project boundary polygon.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Environmental Document Number' ;
    rdfs:comment 'The reference number of the environmental review document (EA, EIS, or CE) associated with the project.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowAcquisitionRequired rdf:type rdf:Property ;
    rdfs:label 'Row Acquisition Required' ;
    rdfs:comment 'Indicates whether right-of-way acquisition is required for the project.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rowParcelsCount rdf:type rdf:Property ;
    rdfs:label 'Row Parcels Count' ;
    rdfs:comment 'The estimated or actual number of property parcels requiring right-of-way acquisition.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:railroadInvolvement rdf:type rdf:Property ;
    rdfs:label 'Railroad Involvement' ;
    rdfs:comment 'Indicates whether the project involves railroad crossings, coordination, or infrastructure.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bridgeInvolvement rdf:type rdf:Property ;
    rdfs:label 'Bridge Involvement' ;
    rdfs:comment 'Indicates whether the project includes bridge construction, replacement, or rehabilitation.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itsComponents rdf:type rdf:Property ;
    rdfs:label 'Its Components' ;
    rdfs:comment 'Indicates whether the project includes ITS infrastructure such as traffic signals, cameras, or dynamic message signs.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bicyclePedestrianFacilities rdf:type rdf:Property ;
    rdfs:label 'Bicycle Pedestrian Facilities' ;
    rdfs:comment 'Indicates whether the project includes bicycle lanes, sidewalks, or other pedestrian facilities.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wetlandsPresent rdf:type rdf:Property ;
    rdfs:label 'Wetlands Present' ;
    rdfs:comment 'Indicates whether wetlands subject to Clean Water Act Section 404 permitting are present within the project boundary.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:floodplainInvolvement rdf:type rdf:Property ;
    rdfs:label 'Floodplain Involvement' ;
    rdfs:comment 'Indicates whether the project boundary includes areas within FEMA-designated floodplains.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Last Updated By' ;
    rdfs:comment 'The name or identifier of the person who last updated the project boundary record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyLevel rdf:type rdf:Property ;
    rdfs:label 'Accuracy Level' ;
    rdfs:comment 'The level of spatial accuracy of the project boundary geometry.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:horizontalAccuracyFeet rdf:type rdf:Property ;
    rdfs:label 'Horizontal Accuracy Feet' ;
    rdfs:comment 'The estimated horizontal positional accuracy of the boundary geometry, measured in feet.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataQualityNotes rdf:type rdf:Property ;
    rdfs:label 'Data Quality Notes' ;
    rdfs:comment 'Free-text notes regarding data quality, limitations, or special considerations for the project boundary.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arcgisFeatureServiceUrl rdf:type rdf:Property ;
    rdfs:label 'Arcgis Feature Service Url' ;
    rdfs:comment 'The URL of the ArcGIS Enterprise feature service where the project boundary is published for web access.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByBoundaryId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Boundary Id' ;
    rdfs:comment 'The project_boundary_id of the newer boundary version that supersedes this record, if applicable.' ;
    rdfs:domain ind:ProjectBoundary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planId rdf:type rdf:Property ;
    rdfs:label 'Plan Id' ;
    rdfs:comment 'Unique identifier for the transportation plan record. Primary key for the plan entity.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:geographicAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Geographic Area Description' ;
    rdfs:comment 'Detailed description of the geographic area covered by the plan including counties, municipalities, or specific boundaries.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modalScope rdf:type rdf:Property ;
    rdfs:label 'Modal Scope' ;
    rdfs:comment 'Transportation modes addressed in the plan indicating whether it covers single or multiple transportation modes.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseYear rdf:type rdf:Property ;
    rdfs:label 'Base Year' ;
    rdfs:comment 'The reference year for existing conditions and baseline data used in the transportation plan analysis.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:horizonYear rdf:type rdf:Property ;
    rdfs:label 'Horizon Year' ;
    rdfs:comment 'The future target year for which the transportation plan projects needs, investments, and outcomes (typically 20-30 years from base year).' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intermediateMilestoneYears rdf:type rdf:Property ;
    rdfs:label 'Intermediate Milestone Years' ;
    rdfs:comment 'Comma-separated list of intermediate planning years between base year and horizon year for phased implementation tracking.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adoptionDate rdf:type rdf:Property ;
    rdfs:label 'Adoption Date' ;
    rdfs:comment 'Official date when the transportation plan was formally adopted by the governing body or planning organization.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextUpdateDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Update Due Date' ;
    rdfs:comment 'Scheduled date for the next required update or revision of the transportation plan per federal or state requirements.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:updateCycleYears rdf:type rdf:Property ;
    rdfs:label 'Update Cycle Years' ;
    rdfs:comment 'Required frequency in years for updating the transportation plan (typically 4-5 years for metropolitan areas, 5 years for non-metropolitan).' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalEstimatedCost rdf:type rdf:Property ;
    rdfs:label 'Total Estimated Cost' ;
    rdfs:comment 'Total estimated cost in US dollars for all projects and programs included in the transportation plan over the planning horizon.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalFundingAmount rdf:type rdf:Property ;
    rdfs:label 'Federal Funding Amount' ;
    rdfs:comment 'Total estimated federal funding allocation in US dollars for the transportation plan from FHWA, FTA, FAA, or other federal sources.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateFundingAmount rdf:type rdf:Property ;
    rdfs:label 'State Funding Amount' ;
    rdfs:comment 'Total estimated North Carolina state funding allocation in US dollars for the transportation plan.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localFundingAmount rdf:type rdf:Property ;
    rdfs:label 'Local Funding Amount' ;
    rdfs:comment 'Total estimated local government funding contribution in US dollars for the transportation plan from counties, municipalities, or other local sources.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherFundingAmount rdf:type rdf:Property ;
    rdfs:label 'Other Funding Amount' ;
    rdfs:comment 'Total estimated funding from other sources in US dollars including private investment, grants, or alternative financing mechanisms.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingConstraintStatus rdf:type rdf:Property ;
    rdfs:label 'Funding Constraint Status' ;
    rdfs:comment 'Indicates whether the plan is fiscally constrained (limited to reasonably expected revenues) or unconstrained (vision-based without funding limitations).' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airQualityConformityStatus rdf:type rdf:Property ;
    rdfs:label 'Air Quality Conformity Status' ;
    rdfs:comment 'Current air quality conformity determination status indicating whether the plan meets Clean Air Act requirements.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nepaComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Nepa Compliance Status' ;
    rdfs:comment 'NEPA environmental review status for the plan. CE (Categorical Exclusion), EA (Environmental Assessment) with FONSI (Finding of No Significant Impact), EIS (Environmental Impact Statement) with ROD (Record of Decision).' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicParticipationPlanReference rdf:type rdf:Property ;
    rdfs:label 'Public Participation Plan Reference' ;
    rdfs:comment 'Reference to the public participation plan document or process used for stakeholder engagement during plan development.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicCommentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period Start Date' ;
    rdfs:comment 'Start date of the public comment period for the transportation plan draft or amendment.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicCommentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period End Date' ;
    rdfs:comment 'End date of the public comment period for the transportation plan draft or amendment.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:numberOfPublicCommentsReceived rdf:type rdf:Property ;
    rdfs:label 'Number Of Public Comments Received' ;
    rdfs:comment 'Total count of public comments received during the public participation process for the plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:goalsAndObjectives rdf:type rdf:Property ;
    rdfs:label 'Goals And Objectives' ;
    rdfs:comment 'Comprehensive statement of the transportation plan\'s strategic goals and measurable objectives aligned with statewide and regional priorities.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMeasuresIncluded rdf:type rdf:Property ;
    rdfs:label 'Performance Measures Included' ;
    rdfs:comment 'Indicates whether the plan includes performance-based planning measures and targets as required by federal regulations.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceTargetSummary rdf:type rdf:Property ;
    rdfs:label 'Performance Target Summary' ;
    rdfs:comment 'Summary of key performance targets established in the plan for safety, pavement condition, bridge condition, system performance, and other federal measures.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyEmphasis rdf:type rdf:Property ;
    rdfs:label 'Safety Emphasis' ;
    rdfs:comment 'Level of emphasis placed on safety improvements and Highway Safety Improvement Program (HSIP) projects within the plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:congestionManagementProcessIntegrated rdf:type rdf:Property ;
    rdfs:label 'Congestion Management Process Integrated' ;
    rdfs:comment 'Indicates whether the plan integrates a Congestion Management Process (CMP) as required for Transportation Management Areas.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:freightPlanningIntegrated rdf:type rdf:Property ;
    rdfs:label 'Freight Planning Integrated' ;
    rdfs:comment 'Indicates whether freight transportation planning and considerations are integrated into the plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitPlanningIntegrated rdf:type rdf:Property ;
    rdfs:label 'Transit Planning Integrated' ;
    rdfs:comment 'Indicates whether public transit planning and Federal Transit Administration (FTA) coordination are integrated into the plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bicyclePedestrianPlanningIntegrated rdf:type rdf:Property ;
    rdfs:label 'Bicycle Pedestrian Planning Integrated' ;
    rdfs:comment 'Indicates whether bicycle and pedestrian infrastructure planning and active transportation considerations are integrated into the plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:climateResilienceAddressed rdf:type rdf:Property ;
    rdfs:label 'Climate Resilience Addressed' ;
    rdfs:comment 'Indicates whether climate change impacts, adaptation strategies, and transportation system resilience are addressed in the plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equityConsiderationsAddressed rdf:type rdf:Property ;
    rdfs:label 'Equity Considerations Addressed' ;
    rdfs:comment 'Indicates whether transportation equity, accessibility, and impacts on underserved communities are explicitly addressed in the plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelDemandModelUsed rdf:type rdf:Property ;
    rdfs:label 'Travel Demand Model Used' ;
    rdfs:comment 'Name and version of the travel demand forecasting model used for transportation analysis in the plan development.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelValidationYear rdf:type rdf:Property ;
    rdfs:label 'Model Validation Year' ;
    rdfs:comment 'Year when the travel demand model was last validated against observed traffic data.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationForecastBaseYear rdf:type rdf:Property ;
    rdfs:label 'Population Forecast Base Year' ;
    rdfs:comment 'Base year population used as the starting point for demographic forecasting in the transportation plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationForecastHorizonYear rdf:type rdf:Property ;
    rdfs:label 'Population Forecast Horizon Year' ;
    rdfs:comment 'Horizon year population projection used for long-range transportation demand forecasting.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employmentForecastBaseYear rdf:type rdf:Property ;
    rdfs:label 'Employment Forecast Base Year' ;
    rdfs:comment 'Base year employment used as the starting point for economic forecasting in the transportation plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employmentForecastHorizonYear rdf:type rdf:Property ;
    rdfs:label 'Employment Forecast Horizon Year' ;
    rdfs:comment 'Horizon year employment projection used for long-range transportation demand forecasting.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:socioeconomicDataSource rdf:type rdf:Property ;
    rdfs:label 'Socioeconomic Data Source' ;
    rdfs:comment 'Primary source of socioeconomic data (population, employment, demographics) used in the plan analysis.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficDataSource rdf:type rdf:Property ;
    rdfs:label 'Traffic Data Source' ;
    rdfs:comment 'Primary source of traffic volume and operational data used in the plan analysis, such as HPMS (Highway Performance Monitoring System) or local traffic counts.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisDataLayersIncluded rdf:type rdf:Property ;
    rdfs:label 'Gis Data Layers Included' ;
    rdfs:comment 'Comma-separated list of GIS data layers and spatial datasets included in the transportation plan analysis and documentation.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'Web URL or document repository location where the official transportation plan document is published and accessible.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executiveSummary rdf:type rdf:Property ;
    rdfs:label 'Executive Summary' ;
    rdfs:comment 'Brief executive summary of the transportation plan highlighting key findings, recommendations, and strategic priorities.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadPlannerName rdf:type rdf:Property ;
    rdfs:label 'Lead Planner Name' ;
    rdfs:comment 'Name of the lead transportation planner or project manager responsible for coordinating the plan development.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadPlannerEmail rdf:type rdf:Property ;
    rdfs:label 'Lead Planner Email' ;
    rdfs:comment 'Email address of the lead transportation planner for plan inquiries and coordination.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadPlannerPhone rdf:type rdf:Property ;
    rdfs:label 'Lead Planner Phone' ;
    rdfs:comment 'Phone number of the lead transportation planner for plan inquiries and coordination.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalAuthorizationReceived rdf:type rdf:Property ;
    rdfs:label 'Federal Authorization Received' ;
    rdfs:comment 'Indicates whether federal authorization or approval has been received for the transportation plan from FHWA, FTA, or other federal agencies.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Federal Authorization Date' ;
    rdfs:comment 'Date when federal authorization or approval was received for the transportation plan.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stipIntegrationStatus rdf:type rdf:Property ;
    rdfs:label 'Stip Integration Status' ;
    rdfs:comment 'Status indicating whether projects from this plan have been integrated into the State Transportation Improvement Program (STIP) for funding and implementation.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrativeModificationCount rdf:type rdf:Property ;
    rdfs:label 'Administrative Modification Count' ;
    rdfs:comment 'Total number of administrative modifications made to the transportation plan since original adoption (minor changes not requiring full amendment process).' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededPlanReference rdf:type rdf:Property ;
    rdfs:label 'Superseded Plan Reference' ;
    rdfs:comment 'Reference identifier or name of the previous transportation plan that this plan supersedes or replaces.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedStudiesReferences rdf:type rdf:Property ;
    rdfs:label 'Related Studies References' ;
    rdfs:comment 'Comma-separated list of related transportation studies, corridor studies, or technical reports that informed the plan development.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStatusId rdf:type rdf:Property ;
    rdfs:label 'Plan Status Id' ;
    rdfs:comment 'Unique identifier for the plan status record. Primary key for the plan status reference table.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allowsEditing rdf:type rdf:Property ;
    rdfs:label 'Allows Editing' ;
    rdfs:comment 'Boolean flag indicating whether transportation plans in this status can be edited or modified by authorized users.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicVisibility rdf:type rdf:Property ;
    rdfs:label 'Public Visibility' ;
    rdfs:comment 'Boolean flag indicating whether plans in this status are visible to the public through citizen-facing portals and websites.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mpoCoordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Mpo Coordination Required' ;
    rdfs:comment 'Boolean flag indicating whether plans in this status require coordination with Metropolitan Planning Organizations.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rpoCoordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Rpo Coordination Required' ;
    rdfs:comment 'Boolean flag indicating whether plans in this status require coordination with Rural Planning Organizations.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Federal Review Required' ;
    rdfs:comment 'Boolean flag indicating whether plans in this status require review by federal agencies such as Federal Highway Administration (FHWA) or Federal Transit Administration (FTA).' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicCommentPeriodRequired rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period Required' ;
    rdfs:comment 'Boolean flag indicating whether plans in this status must undergo a public comment period before advancing to the next status.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Plan Type Applicability' ;
    rdfs:comment 'Comma-separated list of plan types to which this status applies (e.g., Long Range Transportation Plan (LRTP), Comprehensive Transportation Plan (CTP), State Transportation Improvement Program (STIP), Transportation Improvement Program (TIP)).' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStage rdf:type rdf:Property ;
    rdfs:label 'Workflow Stage' ;
    rdfs:comment 'The stage in the transportation planning workflow that this status represents (e.g., Initiation, Development, Review, Approval, Implementation, Closeout).' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageDurationDays rdf:type rdf:Property ;
    rdfs:label 'Average Duration Days' ;
    rdfs:comment 'Historical average number of days that transportation plans typically remain in this status before transitioning to another status.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaDurationDays rdf:type rdf:Property ;
    rdfs:label 'Sla Duration Days' ;
    rdfs:comment 'Target number of days within which plans in this status should be processed or transitioned, as defined by service level agreements or business rules.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Days' ;
    rdfs:comment 'Number of days after which plans remaining in this status trigger escalation notifications to management or stakeholders.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusUsageCount rdf:type rdf:Property ;
    rdfs:label 'Status Usage Count' ;
    rdfs:comment 'Total number of transportation plans that have been assigned this status historically. Used for analytics and status utilization reporting.' ;
    rdfs:domain ind:PlanStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundingSourceId rdf:type rdf:Property ;
    rdfs:label 'Funding Source Id' ;
    rdfs:comment 'Unique identifier for the funding source record. Primary key for the funding source reference table.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FundingSource .

ind:sourceCode rdf:type rdf:Property ;
    rdfs:label 'Source Code' ;
    rdfs:comment 'Short alphanumeric code representing the funding source type. Used as a business key for referencing funding sources in project and financial systems.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceName rdf:type rdf:Property ;
    rdfs:label 'Source Name' ;
    rdfs:comment 'Full descriptive name of the funding source (e.g., Federal Highway Administration, State Transportation Improvement Program, Grant Anticipation Revenue Vehicle).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Source Abbreviation' ;
    rdfs:comment 'Standard abbreviation for the funding source name (e.g., FHWA, STIP, GARVEE, BUILD, INFRA, RAISE).' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingType rdf:type rdf:Property ;
    rdfs:label 'Funding Type' ;
    rdfs:comment 'Classification of the funding purpose or allocation method (capital, operating, maintenance, planning, emergency, discretionary, or formula-based).' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMatchRequired rdf:type rdf:Property ;
    rdfs:label 'State Match Required' ;
    rdfs:comment 'Indicates whether state matching funds are required when using this funding source.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateMatchPercentage rdf:type rdf:Property ;
    rdfs:label 'State Match Percentage' ;
    rdfs:comment 'Required state matching percentage for projects using this funding source, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localMatchRequired rdf:type rdf:Property ;
    rdfs:label 'Local Match Required' ;
    rdfs:comment 'Indicates whether local government matching funds are required when using this funding source.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:localMatchPercentage rdf:type rdf:Property ;
    rdfs:label 'Local Match Percentage' ;
    rdfs:comment 'Required local matching percentage for projects using this funding source, if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleProjectTypes rdf:type rdf:Property ;
    rdfs:label 'Eligible Project Types' ;
    rdfs:comment 'Description of project types and activities eligible for funding from this source (e.g., highway construction, bridge rehabilitation, transit capital, planning studies).' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleExpenseCategories rdf:type rdf:Property ;
    rdfs:label 'Eligible Expense Categories' ;
    rdfs:comment 'Categories of expenses that can be charged to this funding source (e.g., preliminary engineering, right-of-way, construction, construction engineering).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationReference rdf:type rdf:Property ;
    rdfs:label 'Authorization Reference' ;
    rdfs:comment 'Reference to the legislative act, statute, or authorization that established this funding source (e.g., FAST Act, IIJA, NCGS 136-44.2).' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYearType rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year Type' ;
    rdfs:comment 'Type of fiscal year used for this funding source (federal fiscal year, state fiscal year, or calendar year).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitiveApplicationRequired rdf:type rdf:Property ;
    rdfs:label 'Competitive Application Required' ;
    rdfs:comment 'Indicates whether projects must compete through a competitive application process to receive this funding.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sunsetProvision rdf:type rdf:Property ;
    rdfs:label 'Sunset Provision' ;
    rdfs:comment 'Description of any sunset provisions or conditions under which this funding source will be discontinued.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbeGoalsApplicable rdf:type rdf:Property ;
    rdfs:label 'Dbe Goals Applicable' ;
    rdfs:comment 'Indicates whether Disadvantaged Business Enterprise participation goals apply to projects funded by this source.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prevailingWageRequired rdf:type rdf:Property ;
    rdfs:label 'Prevailing Wage Required' ;
    rdfs:comment 'Indicates whether Davis-Bacon prevailing wage requirements apply to projects using this funding source.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stipInclusionRequired rdf:type rdf:Property ;
    rdfs:label 'Stip Inclusion Required' ;
    rdfs:comment 'Indicates whether projects using this funding source must be included in the State Transportation Improvement Program.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flexibilityScore rdf:type rdf:Property ;
    rdfs:label 'Flexibility Score' ;
    rdfs:comment 'Numeric score (1-10) indicating the flexibility and ease of use of this funding source, with higher scores indicating greater flexibility.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactPerson rdf:type rdf:Property ;
    rdfs:label 'Contact Person' ;
    rdfs:comment 'Name of the NCDOT staff person or office responsible for administering or providing guidance on this funding source.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceUrl rdf:type rdf:Property ;
    rdfs:label 'Reference Url' ;
    rdfs:comment 'Web URL linking to additional information, guidance documents, or official resources about this funding source.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpoDesignation rdf:type rdf:Property ;
    rdfs:label 'Mpo Designation' ;
    rdfs:comment 'Official MPO designation name if the stakeholder is a federally designated metropolitan planning organization.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpoDesignation rdf:type rdf:Property ;
    rdfs:label 'Rpo Designation' ;
    rdfs:comment 'Official RPO designation name if the stakeholder is a rural planning organization established under state guidelines.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryContactName rdf:type rdf:Property ;
    rdfs:label 'Secondary Contact Name' ;
    rdfs:comment 'Full name of the secondary or alternate contact person for the stakeholder organization.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryContactTitle rdf:type rdf:Property ;
    rdfs:label 'Secondary Contact Title' ;
    rdfs:comment 'Job title or position of the secondary contact person within the stakeholder organization.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicalAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Physical Address Line1' ;
    rdfs:comment 'First line of the stakeholder organization\'s physical office location including street number and name.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicalAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Physical Address Line2' ;
    rdfs:comment 'Second line of the physical address for suite, building, or additional location information.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalEin rdf:type rdf:Property ;
    rdfs:label 'Federal Ein' ;
    rdfs:comment 'Federal tax identification number assigned by the IRS to the stakeholder organization.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleInPlanning rdf:type rdf:Property ;
    rdfs:label 'Role In Planning' ;
    rdfs:comment 'Description of the stakeholder\'s specific role, responsibilities, and participation in NCDOT transportation planning processes.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planningAreaCoverage rdf:type rdf:Property ;
    rdfs:label 'Planning Area Coverage' ;
    rdfs:comment 'Geographic scope or planning area that the stakeholder has authority or interest in for transportation planning purposes.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationLevel rdf:type rdf:Property ;
    rdfs:label 'Participation Level' ;
    rdfs:comment 'Level of formal participation and decision-making authority the stakeholder has in planning processes.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lrtpInvolvementFlag rdf:type rdf:Property ;
    rdfs:label 'Lrtp Involvement Flag' ;
    rdfs:comment 'Indicates whether the stakeholder is actively involved in Long Range Transportation Plan development and updates.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ctpInvolvementFlag rdf:type rdf:Property ;
    rdfs:label 'Ctp Involvement Flag' ;
    rdfs:comment 'Indicates whether the stakeholder participates in Comprehensive Transportation Plan development for their jurisdiction.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stipInvolvementFlag rdf:type rdf:Property ;
    rdfs:label 'Stip Involvement Flag' ;
    rdfs:comment 'Indicates whether the stakeholder participates in State Transportation Improvement Program development and prioritization.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tipInvolvementFlag rdf:type rdf:Property ;
    rdfs:label 'Tip Involvement Flag' ;
    rdfs:comment 'Indicates whether the stakeholder is involved in metropolitan Transportation Improvement Program development.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modalFocus rdf:type rdf:Property ;
    rdfs:label 'Modal Focus' ;
    rdfs:comment 'Primary transportation modes that the stakeholder focuses on, such as highway, transit, rail, aviation, bicycle, pedestrian, or multimodal.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSourceFlag rdf:type rdf:Property ;
    rdfs:label 'Funding Source Flag' ;
    rdfs:comment 'Indicates whether the stakeholder provides funding or financial resources for transportation planning or projects.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Type of formal agreement or arrangement governing the relationship between NCDOT and the stakeholder.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'Unique identifier for the formal agreement or contract between NCDOT and the stakeholder.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementStartDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Start Date' ;
    rdfs:comment 'Effective start date of the formal agreement or relationship with the stakeholder.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementEndDate rdf:type rdf:Property ;
    rdfs:label 'Agreement End Date' ;
    rdfs:comment 'Expiration or termination date of the formal agreement with the stakeholder.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Renewal Date' ;
    rdfs:comment 'Next scheduled date for renewal or review of the stakeholder agreement.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:meetingFrequency rdf:type rdf:Property ;
    rdfs:label 'Meeting Frequency' ;
    rdfs:comment 'Regular frequency of scheduled meetings or coordination sessions with the stakeholder.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Last Meeting Date' ;
    rdfs:comment 'Date of the most recent meeting or formal engagement with the stakeholder.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Next Meeting Date' ;
    rdfs:comment 'Date scheduled for the next meeting or engagement with the stakeholder.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationListFlag rdf:type rdf:Property ;
    rdfs:label 'Notification List Flag' ;
    rdfs:comment 'Indicates whether the stakeholder is included in automated notification lists for planning updates and announcements.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicInvolvementRole rdf:type rdf:Property ;
    rdfs:label 'Public Involvement Role' ;
    rdfs:comment 'Specific role the stakeholder plays in public involvement and community engagement activities for transportation planning.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalJusticeCommunityFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Justice Community Flag' ;
    rdfs:comment 'Indicates whether the stakeholder represents or serves an environmental justice community requiring special consideration under federal guidelines.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tribalConsultationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Tribal Consultation Required Flag' ;
    rdfs:comment 'Indicates whether formal tribal consultation is required when engaging with this stakeholder under federal and state law.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSharingAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Agreement Flag' ;
    rdfs:comment 'Indicates whether a formal data sharing agreement exists between NCDOT and the stakeholder for planning data exchange.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisDataProviderFlag rdf:type rdf:Property ;
    rdfs:label 'Gis Data Provider Flag' ;
    rdfs:comment 'Indicates whether the stakeholder provides GIS data or spatial information to support transportation planning activities.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelDemandModelParticipantFlag rdf:type rdf:Property ;
    rdfs:label 'Travel Demand Model Participant Flag' ;
    rdfs:comment 'Indicates whether the stakeholder participates in travel demand modeling activities or provides input data for transportation models.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:influenceLevel rdf:type rdf:Property ;
    rdfs:label 'Influence Level' ;
    rdfs:comment 'Assessment of the stakeholder\'s level of influence on transportation planning decisions and outcomes.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestLevel rdf:type rdf:Property ;
    rdfs:label 'Interest Level' ;
    rdfs:comment 'Assessment of the stakeholder\'s level of interest and engagement in transportation planning activities.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipStartDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Start Date' ;
    rdfs:comment 'Date when the formal relationship or engagement between NCDOT and the stakeholder began.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inactiveDate rdf:type rdf:Property ;
    rdfs:label 'Inactive Date' ;
    rdfs:comment 'Date when the stakeholder relationship became inactive or was terminated.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inactiveReason rdf:type rdf:Property ;
    rdfs:label 'Inactive Reason' ;
    rdfs:comment 'Explanation or reason for the stakeholder relationship becoming inactive or terminated.' ;
    rdfs:domain ind:Stakeholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioId rdf:type rdf:Property ;
    rdfs:label 'Scenario Id' ;
    rdfs:comment 'Unique identifier for the planning scenario used in transportation modeling and analysis.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Scenario .

ind:planningHorizonYear rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon Year' ;
    rdfs:comment 'The target year for which this scenario projects future conditions (e.g., 2045, 2050).' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationAssumption rdf:type rdf:Property ;
    rdfs:label 'Population Assumption' ;
    rdfs:comment 'Description of the demographic and population growth assumptions underlying this scenario (e.g., high growth, moderate growth, declining population).' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentAssumption rdf:type rdf:Property ;
    rdfs:label 'Employment Assumption' ;
    rdfs:comment 'Description of the employment and economic development assumptions used in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:landUseAssumption rdf:type rdf:Property ;
    rdfs:label 'Land Use Assumption' ;
    rdfs:comment 'Description of land use patterns, development density, and urban form assumptions incorporated in the scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:economicGrowthRate rdf:type rdf:Property ;
    rdfs:label 'Economic Growth Rate' ;
    rdfs:comment 'The assumed annual economic growth rate (as a percentage) used in scenario modeling.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleMilesTraveledAssumption rdf:type rdf:Property ;
    rdfs:label 'Vehicle Miles Traveled Assumption' ;
    rdfs:comment 'Description of the assumptions regarding future vehicle miles traveled patterns and trends in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modeShareAssumption rdf:type rdf:Property ;
    rdfs:label 'Mode Share Assumption' ;
    rdfs:comment 'Description of the assumed distribution of travel across different transportation modes (auto, transit, bike, walk) in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technologyAssumption rdf:type rdf:Property ;
    rdfs:label 'Technology Assumption' ;
    rdfs:comment 'Description of assumptions regarding adoption of transportation technologies (e.g., electric vehicles, autonomous vehicles, connected vehicles) in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateAssumption rdf:type rdf:Property ;
    rdfs:label 'Climate Assumption' ;
    rdfs:comment 'Description of climate change impacts, environmental constraints, and sustainability assumptions incorporated in the scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyAssumption rdf:type rdf:Property ;
    rdfs:label 'Policy Assumption' ;
    rdfs:comment 'Description of transportation policies, regulations, and strategic initiatives assumed to be in effect in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingAssumption rdf:type rdf:Property ;
    rdfs:label 'Funding Assumption' ;
    rdfs:comment 'Description of the funding levels, revenue sources, and fiscal constraints assumed in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkAssumption rdf:type rdf:Property ;
    rdfs:label 'Network Assumption' ;
    rdfs:comment 'Description of the transportation network configuration, capacity improvements, and infrastructure investments assumed in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:travelDemandModelVersion rdf:type rdf:Property ;
    rdfs:label 'Travel Demand Model Version' ;
    rdfs:comment 'The version identifier of the travel demand forecasting model used to analyze this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelRunIdentifier rdf:type rdf:Property ;
    rdfs:label 'Model Run Identifier' ;
    rdfs:comment 'Unique identifier for the specific model run or simulation associated with this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisPeriod rdf:type rdf:Property ;
    rdfs:label 'Analysis Period' ;
    rdfs:comment 'Description of the time period or timeframe analyzed in this scenario (e.g., 2025-2045, 20-year horizon).' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Confidence Level' ;
    rdfs:comment 'Assessment of the confidence or reliability of the scenario assumptions and projections based on data quality and analytical rigor.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensitivityAnalysisPerformed rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Analysis Performed' ;
    rdfs:comment 'Indicates whether sensitivity analysis was conducted to test the robustness of scenario outcomes under varying assumptions.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicEngagementLevel rdf:type rdf:Property ;
    rdfs:label 'Public Engagement Level' ;
    rdfs:comment 'The extent of public participation and stakeholder engagement conducted during scenario development.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalJusticeConsidered rdf:type rdf:Property ;
    rdfs:label 'Environmental Justice Considered' ;
    rdfs:comment 'Indicates whether environmental justice and equity considerations were incorporated in scenario development and analysis.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fiscalConstraintMet rdf:type rdf:Property ;
    rdfs:label 'Fiscal Constraint Met' ;
    rdfs:comment 'Indicates whether the scenario meets federal fiscal constraint requirements by including only projects with reasonably expected funding.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyPerformanceAssumption rdf:type rdf:Property ;
    rdfs:label 'Safety Performance Assumption' ;
    rdfs:comment 'Description of assumptions regarding safety improvements, crash reduction targets, and Highway Safety Improvement Program (HSIP) investments in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pavementConditionAssumption rdf:type rdf:Property ;
    rdfs:label 'Pavement Condition Assumption' ;
    rdfs:comment 'Description of assumptions regarding pavement condition, preservation strategies, and Pavement Management System (PMS) targets in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bridgeConditionAssumption rdf:type rdf:Property ;
    rdfs:label 'Bridge Condition Assumption' ;
    rdfs:comment 'Description of assumptions regarding bridge condition, inspection schedules, and Bridge Management System (BMS) targets in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:congestionManagementAssumption rdf:type rdf:Property ;
    rdfs:label 'Congestion Management Assumption' ;
    rdfs:comment 'Description of congestion management strategies and traffic operations improvements assumed in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freightMovementAssumption rdf:type rdf:Property ;
    rdfs:label 'Freight Movement Assumption' ;
    rdfs:comment 'Description of assumptions regarding freight transportation demand, truck traffic patterns, and goods movement in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resilienceAssumption rdf:type rdf:Property ;
    rdfs:label 'Resilience Assumption' ;
    rdfs:comment 'Description of assumptions regarding transportation system resilience, emergency response capabilities, and disaster recovery in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibilityAssumption rdf:type rdf:Property ;
    rdfs:label 'Accessibility Assumption' ;
    rdfs:comment 'Description of assumptions regarding accessibility to jobs, services, and opportunities, and overall mobility improvements in this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityConsideration rdf:type rdf:Property ;
    rdfs:label 'Equity Consideration' ;
    rdfs:comment 'Description of how equity, social justice, and impacts on disadvantaged communities were considered in scenario development.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationUrl rdf:type rdf:Property ;
    rdfs:label 'Documentation Url' ;
    rdfs:comment 'Web link to detailed documentation, technical reports, or supporting materials for this scenario.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodology rdf:type rdf:Property ;
    rdfs:label 'Methodology' ;
    rdfs:comment 'Description of the analytical methodology, modeling approach, and technical procedures used to develop and analyze this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comparisonBaseline rdf:type rdf:Property ;
    rdfs:label 'Comparison Baseline' ;
    rdfs:comment 'Identifier or name of the baseline scenario against which this scenario is compared for alternatives analysis.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stakeholderConsensus rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Consensus' ;
    rdfs:comment 'Assessment of the level of agreement or consensus among stakeholders regarding this scenario.' ;
    rdfs:domain ind:Scenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyId rdf:type rdf:Property ;
    rdfs:label 'Policy Id' ;
    rdfs:comment 'Unique identifier for the policy document within the planning domain. Primary key for the policy data product.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvingAuthority rdf:type rdf:Property ;
    rdfs:label 'Approving Authority' ;
    rdfs:comment 'Name of the organizational unit, official, or body that has the authority to approve and authorize this policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingOfficialName rdf:type rdf:Property ;
    rdfs:label 'Approving Official Name' ;
    rdfs:comment 'Full name of the individual official who approved the policy document.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingOfficialTitle rdf:type rdf:Property ;
    rdfs:label 'Approving Official Title' ;
    rdfs:comment 'Official title or position of the individual who approved the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicability rdf:type rdf:Property ;
    rdfs:label 'Applicability' ;
    rdfs:comment 'Detailed description of the situations, projects, or organizational units to which the policy applies.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedStatuteReference rdf:type rdf:Property ;
    rdfs:label 'Related Statute Reference' ;
    rdfs:comment 'Citation of North Carolina General Statutes (NCGS) or other statutory authority that mandates or authorizes the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedRegulationReference rdf:type rdf:Property ;
    rdfs:label 'Related Regulation Reference' ;
    rdfs:comment 'Citation of federal or state regulations (CFR, state administrative code) that the policy implements or complies with.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Requirement Flag' ;
    rdfs:comment 'Indicates whether the policy is required by federal law, regulation, or funding conditions (FHWA, FTA, FAA, FRA requirements).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enforcementMechanism rdf:type rdf:Property ;
    rdfs:label 'Enforcement Mechanism' ;
    rdfs:comment 'Description of how compliance with the policy is monitored and enforced, including audit procedures, reporting requirements, or penalties for non-compliance.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedMpoRpoFlag rdf:type rdf:Property ;
    rdfs:label 'Related Mpo Rpo Flag' ;
    rdfs:comment 'Indicates whether the policy involves coordination with or applies to Metropolitan Planning Organizations (MPO) or Rural Planning Organizations (RPO).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stipRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Stip Related Flag' ;
    rdfs:comment 'Indicates whether the policy directly relates to the State Transportation Improvement Program (STIP) development, approval, or implementation.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lrtpRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Lrtp Related Flag' ;
    rdfs:comment 'Indicates whether the policy directly relates to Long Range Transportation Plan (LRTP) development, approval, or implementation.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ctpRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Ctp Related Flag' ;
    rdfs:comment 'Indicates whether the policy directly relates to Comprehensive Transportation Plan (CTP) development, approval, or implementation.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nepaRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Nepa Related Flag' ;
    rdfs:comment 'Indicates whether the policy addresses National Environmental Policy Act (NEPA) compliance, environmental review, or documentation requirements.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multimodalFlag rdf:type rdf:Property ;
    rdfs:label 'Multimodal Flag' ;
    rdfs:comment 'Indicates whether the policy addresses multimodal transportation planning involving highways, rail, aviation, ferry, transit, bicycle, or pedestrian modes.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transportationModes rdf:type rdf:Property ;
    rdfs:label 'Transportation Modes' ;
    rdfs:comment 'Comma-separated list of transportation modes addressed by the policy (highway, rail, ferry, aviation, transit, bicycle, pedestrian).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicParticipationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Participation Required Flag' ;
    rdfs:comment 'Indicates whether the policy requires public participation, public comment periods, or public hearings as part of its implementation.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalJusticeFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Justice Flag' ;
    rdfs:comment 'Indicates whether the policy addresses environmental justice considerations for minority and low-income populations.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingSourceApplicability rdf:type rdf:Property ;
    rdfs:label 'Funding Source Applicability' ;
    rdfs:comment 'Description of federal, state, or local funding sources to which the policy applies, such as HSIP, CMAQ, STP, BUILD, INFRA, RAISE, or state appropriations.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentLocationUrl rdf:type rdf:Property ;
    rdfs:label 'Document Location Url' ;
    rdfs:comment 'URL or file path to the official policy document stored in SharePoint, ProjectWise, or other document management system.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentFormat rdf:type rdf:Property ;
    rdfs:label 'Document Format' ;
    rdfs:comment 'File format of the official policy document (PDF, Word, HTML, etc.).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersedesPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Supersedes Policy Number' ;
    rdfs:comment 'Policy number of the previous policy document that this policy supersedes or replaces.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Superseded By Policy Number' ;
    rdfs:comment 'Policy number of the newer policy document that supersedes this policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedPolicyNumbers rdf:type rdf:Property ;
    rdfs:label 'Related Policy Numbers' ;
    rdfs:comment 'Comma-separated list of related policy numbers that should be referenced in conjunction with this policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentHistory rdf:type rdf:Property ;
    rdfs:label 'Amendment History' ;
    rdfs:comment 'Summary of amendments, revisions, or modifications made to the policy since original approval.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Public Access Flag' ;
    rdfs:comment 'Indicates whether the policy document is publicly accessible or restricted to internal NCDOT use only.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'Data classification level of the policy document indicating access restrictions and handling requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Review Required Flag' ;
    rdfs:comment 'Indicates whether the policy requires legal review by NCDOT legal counsel or the NC Attorney General\'s office.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReviewDate rdf:type rdf:Property ;
    rdfs:label 'Legal Review Date' ;
    rdfs:comment 'Date on which the policy was reviewed and approved by legal counsel.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impactAssessmentCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Completed Flag' ;
    rdfs:comment 'Indicates whether a formal impact assessment was conducted to evaluate the policy\'s effects on operations, budget, or stakeholders.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impactSummary rdf:type rdf:Property ;
    rdfs:label 'Impact Summary' ;
    rdfs:comment 'Summary of the anticipated or actual impacts of the policy on NCDOT operations, projects, budget, or external stakeholders.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingMaterialsUrl rdf:type rdf:Property ;
    rdfs:label 'Training Materials Url' ;
    rdfs:comment 'URL or file path to training materials, presentations, or guides related to the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Comment Period Start Date' ;
    rdfs:comment 'Start date of the public or internal comment period for the draft policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Comment Period End Date' ;
    rdfs:comment 'End date of the public or internal comment period for the draft policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commentsSummary rdf:type rdf:Property ;
    rdfs:label 'Comments Summary' ;
    rdfs:comment 'Summary of key themes, concerns, or recommendations from comments received during the comment period.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archiveReason rdf:type rdf:Property ;
    rdfs:label 'Archive Reason' ;
    rdfs:comment 'Reason for archiving the policy document.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planningPriority rdf:type rdf:Property ;
    rdfs:label 'Planning Priority' ;
    rdfs:comment 'Priority ranking assigned to the corridor for planning, funding, and project development purposes.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startLocation rdf:type rdf:Property ;
    rdfs:label 'Start Location' ;
    rdfs:comment 'Geographic description or landmark identifying the beginning point of the corridor.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endLocation rdf:type rdf:Property ;
    rdfs:label 'End Location' ;
    rdfs:comment 'Geographic description or landmark identifying the ending point of the corridor.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geometryReference rdf:type rdf:Property ;
    rdfs:label 'Geometry Reference' ;
    rdfs:comment 'Reference identifier linking to the spatial geometry representation of the corridor in the Geographic Information System (GIS).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyList rdf:type rdf:Property ;
    rdfs:label 'County List' ;
    rdfs:comment 'Comma-separated list of North Carolina counties through which the corridor passes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionList rdf:type rdf:Property ;
    rdfs:label 'Division List' ;
    rdfs:comment 'List of NCDOT Division of Highways (DOH) divisions responsible for maintenance and operations along this corridor.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateRouteNumbers rdf:type rdf:Property ;
    rdfs:label 'Alternate Route Numbers' ;
    rdfs:comment 'Additional route numbers or designations that apply to portions of the corridor.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:losCurrent rdf:type rdf:Property ;
    rdfs:label 'Los Current' ;
    rdfs:comment 'Current Level of Service (LOS) rating indicating traffic flow quality and congestion on the corridor, ranging from A (best) to F (worst).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:losProjected rdf:type rdf:Property ;
    rdfs:label 'Los Projected' ;
    rdfs:comment 'Projected future Level of Service (LOS) rating based on transportation modeling and forecasted traffic growth.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:losProjectionYear rdf:type rdf:Property ;
    rdfs:label 'Los Projection Year' ;
    rdfs:comment 'Target year for the projected Level of Service (LOS) analysis.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityVehiclesPerDay rdf:type rdf:Property ;
    rdfs:label 'Capacity Vehicles Per Day' ;
    rdfs:comment 'Maximum daily vehicle capacity of the corridor under current configuration and conditions.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:structurallyDeficientBridges rdf:type rdf:Property ;
    rdfs:label 'Structurally Deficient Bridges' ;
    rdfs:comment 'Count of bridges along the corridor classified as structurally deficient according to National Bridge Inspection Standards (NBIS).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:freightCorridor rdf:type rdf:Property ;
    rdfs:label 'Freight Corridor' ;
    rdfs:comment 'Indicates whether the corridor is designated as a critical freight corridor for commercial goods movement.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:strategicHighwayNetwork rdf:type rdf:Property ;
    rdfs:label 'Strategic Highway Network' ;
    rdfs:comment 'Indicates whether the corridor is part of the Strategic Highway Network (STRAHNET) for national defense purposes.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scenicByway rdf:type rdf:Property ;
    rdfs:label 'Scenic Byway' ;
    rdfs:comment 'Indicates whether the corridor has been designated as a state or national scenic byway.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:historicDistrict rdf:type rdf:Property ;
    rdfs:label 'Historic District' ;
    rdfs:comment 'Indicates whether the corridor passes through or adjacent to designated historic districts requiring Section 106 review.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stipProjectCount rdf:type rdf:Property ;
    rdfs:label 'Stip Project Count' ;
    rdfs:comment 'Number of active projects along this corridor included in the current State Transportation Improvement Program (STIP).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lrtpInclusion rdf:type rdf:Property ;
    rdfs:label 'Lrtp Inclusion' ;
    rdfs:comment 'Indicates whether the corridor is included in the statewide or regional Long Range Transportation Plan (LRTP).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ctpDesignation rdf:type rdf:Property ;
    rdfs:label 'Ctp Designation' ;
    rdfs:comment 'Designation or classification assigned to the corridor in applicable Comprehensive Transportation Plans (CTP).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multimodalFacilities rdf:type rdf:Property ;
    rdfs:label 'Multimodal Facilities' ;
    rdfs:comment 'Description of multimodal transportation facilities present along the corridor (e.g., bike lanes, sidewalks, transit stops, park-and-ride).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itsDeployment rdf:type rdf:Property ;
    rdfs:label 'Its Deployment' ;
    rdfs:comment 'Description of Intelligent Transportation Systems (ITS) infrastructure deployed along the corridor (e.g., dynamic message signs, CCTV, traffic sensors).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmcCoverage rdf:type rdf:Property ;
    rdfs:label 'Tmc Coverage' ;
    rdfs:comment 'Indicates whether the corridor is monitored and managed by a Traffic Management Center (TMC).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightOfWayWidthFt rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Width Ft' ;
    rdfs:comment 'Typical Right-of-Way (ROW) width in feet along the corridor.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rowAcquisitionStatus rdf:type rdf:Property ;
    rdfs:label 'Row Acquisition Status' ;
    rdfs:comment 'Status of Right-of-Way (ROW) acquisition activities for planned corridor improvements.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedImprovementCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Improvement Cost' ;
    rdfs:comment 'Estimated total cost in US dollars for planned improvements along the corridor.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingSources rdf:type rdf:Property ;
    rdfs:label 'Funding Sources' ;
    rdfs:comment 'List of current or anticipated funding sources for corridor projects (e.g., STIP, HSIP, CMAQ, BUILD, INFRA, RAISE).' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planningStudyReference rdf:type rdf:Property ;
    rdfs:label 'Planning Study Reference' ;
    rdfs:comment 'Reference to corridor studies, feasibility analyses, or planning documents that inform corridor development.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicEngagementStatus rdf:type rdf:Property ;
    rdfs:label 'Public Engagement Status' ;
    rdfs:comment 'Status of public involvement and stakeholder engagement activities for corridor planning.' ;
    rdfs:domain ind:Corridor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelId rdf:type rdf:Property ;
    rdfs:label 'Model Id' ;
    rdfs:comment 'Unique identifier for the transportation model record. Primary key for the model entity.' ;
    rdfs:domain ind:Planning ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Model .

ind:softwarePlatform rdf:type rdf:Property ;
    rdfs:label 'Software Platform' ;
    rdfs:comment 'The software application or platform used to develop and execute the transportation model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:softwareVersion rdf:type rdf:Property ;
    rdfs:label 'Software Version' ;
    rdfs:comment 'Version number of the modeling software platform used for this model.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicBoundaryDescription rdf:type rdf:Property ;
    rdfs:label 'Geographic Boundary Description' ;
    rdfs:comment 'Textual description of the specific geographic boundaries and coverage area of the model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temporalResolution rdf:type rdf:Property ;
    rdfs:label 'Temporal Resolution' ;
    rdfs:comment 'The time granularity at which the model analyzes and forecasts transportation activity.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spatialResolution rdf:type rdf:Property ;
    rdfs:label 'Spatial Resolution' ;
    rdfs:comment 'The geographic unit of analysis used in the model for representing land use and travel patterns.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfZones rdf:type rdf:Property ;
    rdfs:label 'Number Of Zones' ;
    rdfs:comment 'Total count of traffic analysis zones or spatial units included in the model network.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calibrationStatus rdf:type rdf:Property ;
    rdfs:label 'Calibration Status' ;
    rdfs:comment 'Current state of the model calibration process indicating whether the model has been adjusted to match observed conditions.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calibrationTargetVmt rdf:type rdf:Property ;
    rdfs:label 'Calibration Target Vmt' ;
    rdfs:comment 'The observed vehicle miles traveled value used as a calibration target for the model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calibrationAchievedVmt rdf:type rdf:Property ;
    rdfs:label 'Calibration Achieved Vmt' ;
    rdfs:comment 'The vehicle miles traveled value produced by the calibrated model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vmtPercentError rdf:type rdf:Property ;
    rdfs:label 'Vmt Percent Error' ;
    rdfs:comment 'The percentage difference between calibration target VMT and achieved VMT, indicating model accuracy.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tripGenerationMethod rdf:type rdf:Property ;
    rdfs:label 'Trip Generation Method' ;
    rdfs:comment 'The methodological approach used to estimate the number of trips produced and attracted by each zone.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tripDistributionMethod rdf:type rdf:Property ;
    rdfs:label 'Trip Distribution Method' ;
    rdfs:comment 'The methodological approach used to allocate trips between origin and destination zones.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modeChoiceMethod rdf:type rdf:Property ;
    rdfs:label 'Mode Choice Method' ;
    rdfs:comment 'The methodological approach used to predict the transportation mode selected by travelers.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficAssignmentMethod rdf:type rdf:Property ;
    rdfs:label 'Traffic Assignment Method' ;
    rdfs:comment 'The methodological approach used to assign trips to specific routes on the transportation network.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:includesFreight rdf:type rdf:Property ;
    rdfs:label 'Includes Freight' ;
    rdfs:comment 'Indicates whether the model explicitly represents freight and commercial vehicle movements.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesTransit rdf:type rdf:Property ;
    rdfs:label 'Includes Transit' ;
    rdfs:comment 'Indicates whether the model explicitly represents public transportation services and ridership.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesActiveTransportation rdf:type rdf:Property ;
    rdfs:label 'Includes Active Transportation' ;
    rdfs:comment 'Indicates whether the model explicitly represents bicycle and pedestrian travel modes.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesEmissions rdf:type rdf:Property ;
    rdfs:label 'Includes Emissions' ;
    rdfs:comment 'Indicates whether the model calculates air quality emissions from transportation activity.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emissionsMethodology rdf:type rdf:Property ;
    rdfs:label 'Emissions Methodology' ;
    rdfs:comment 'The specific methodology or tool used to estimate transportation-related air emissions.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:includesSafetyAnalysis rdf:type rdf:Property ;
    rdfs:label 'Includes Safety Analysis' ;
    rdfs:comment 'Indicates whether the model includes crash prediction or safety performance evaluation capabilities.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesEconomicAnalysis rdf:type rdf:Property ;
    rdfs:label 'Includes Economic Analysis' ;
    rdfs:comment 'Indicates whether the model estimates economic impacts of transportation investments or policies.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkSource rdf:type rdf:Property ;
    rdfs:label 'Network Source' ;
    rdfs:comment 'The primary source of roadway and transit network data used in the model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkYear rdf:type rdf:Property ;
    rdfs:label 'Network Year' ;
    rdfs:comment 'The year for which the transportation network data represents actual conditions.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trafficCountSource rdf:type rdf:Property ;
    rdfs:label 'Traffic Count Source' ;
    rdfs:comment 'The primary source of observed traffic volume data used for model calibration and validation.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:travelSurveySource rdf:type rdf:Property ;
    rdfs:label 'Travel Survey Source' ;
    rdfs:comment 'The household travel survey or other behavioral data source used to develop model parameters.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:structure rdf:type rdf:Property ;
    rdfs:label 'Structure' ;
    rdfs:comment 'The fundamental modeling paradigm and structure used to represent travel behavior.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timePeriodsModeled rdf:type rdf:Property ;
    rdfs:label 'Time Periods Modeled' ;
    rdfs:comment 'Description of the specific time periods analyzed by the model (e.g., AM Peak, PM Peak, Off-Peak).' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:convergenceCriteria rdf:type rdf:Property ;
    rdfs:label 'Convergence Criteria' ;
    rdfs:comment 'The mathematical criteria used to determine when the traffic assignment process has reached equilibrium.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumIterations rdf:type rdf:Property ;
    rdfs:label 'Maximum Iterations' ;
    rdfs:comment 'The maximum number of iterations allowed for the traffic assignment algorithm to converge.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:volumeDelayFunction rdf:type rdf:Property ;
    rdfs:label 'Volume Delay Function' ;
    rdfs:comment 'The mathematical function used to represent the relationship between traffic volume and travel time on network links.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacitySource rdf:type rdf:Property ;
    rdfs:label 'Capacity Source' ;
    rdfs:comment 'The source of roadway capacity values used in the model network.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeFlowSpeedSource rdf:type rdf:Property ;
    rdfs:label 'Free Flow Speed Source' ;
    rdfs:comment 'The source of free-flow speed values used for network links in the model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueOfTime rdf:type rdf:Property ;
    rdfs:label 'Value Of Time' ;
    rdfs:comment 'The monetary value assigned to travel time savings in the model, typically expressed in dollars per hour.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoOperatingCostPerMile rdf:type rdf:Property ;
    rdfs:label 'Auto Operating Cost Per Mile' ;
    rdfs:comment 'The assumed cost per mile for automobile operation used in mode choice and route choice calculations.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
