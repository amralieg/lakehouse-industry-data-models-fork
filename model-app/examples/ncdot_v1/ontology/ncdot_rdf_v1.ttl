    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Employee Premium Amount' ;
    rdfs:comment 'Dollar amount of premium paid by the employee per pay period for this benefit coverage.' ;
