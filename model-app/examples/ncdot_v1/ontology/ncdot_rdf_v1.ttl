    rdfs:comment 'Status of the quality assurance and quality control review process for the document.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalSignatureFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Signature Flag' ;
    rdfs:comment 'Boolean indicator of whether the document contains a digital signature for authentication and non-repudiation.' ;
    rdfs:domain ind:Document ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sealRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Seal Required Flag' ;
    rdfs:comment 'Boolean indicator of whether the document requires a professional engineer (PE) seal or other professional certification seal.' ;
    rdfs:domain ind:Document ;
