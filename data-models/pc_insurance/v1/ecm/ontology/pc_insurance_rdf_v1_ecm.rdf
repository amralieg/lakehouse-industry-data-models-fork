    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driverLicenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Driver License Expiration Date' ;
    rdfs:comment 'Date when the driver\'s license expires, monitored for underwriting compliance.' ;
    rdfs:domain ind:DriverAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driverLicenseNumber rdf:type rdf:Property ;
