ind:averageVehicleOccupancy rdf:type rdf:Property ;
    rdfs:label 'Average Vehicle Occupancy' ;
    rdfs:comment 'The average number of persons per vehicle assumed in the model for converting person trips to vehicle trips.' ;
    rdfs:domain ind:Model ;
