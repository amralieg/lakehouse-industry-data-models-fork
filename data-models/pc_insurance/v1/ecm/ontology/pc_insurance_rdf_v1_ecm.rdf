    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardsIdentified rdf:type rdf:Property ;
    rdfs:label 'Hazards Identified' ;
    rdfs:comment 'Detailed list of specific hazards, deficiencies, or risk factors observed during the inspection.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementDeadlineDate rdf:type rdf:Property ;
