ind:dacAmount rdf:type rdf:Property ;
    rdfs:label 'Dac Amount' ;
    rdfs:comment 'Deferred acquisition costs amortized in proportion to earned premium.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnedPremiumStatus rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Status' ;
    rdfs:comment 'Current processing status of the earned premium record.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earningMethod rdf:type rdf:Property ;
