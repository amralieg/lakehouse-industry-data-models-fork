    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:inspectionOrderId rdf:type rdf:Property ;
    rdfs:label 'Inspection Order Id' ;
    rdfs:comment 'Foreign key linking to coverage.inspection_order. Business justification: Pre-bind inspection reports establish baseline property condition for damage assessment, fraud detection, and pre-existing damage disputes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionOrder .

ind:lossEventId rdf:type rdf:Property ;
    rdfs:label 'Loss Event Id' ;
    rdfs:comment 'Foreign key to the loss event that triggered this claim.' ;
