ind:positiveTrainControlEquipped rdf:type rdf:Property ;
    rdfs:label 'Positive Train Control Equipped' ;
    rdfs:comment 'Indicates whether the train is equipped with Positive Train Control safety technology as mandated by FRA.' ;
    rdfs:domain ind:Rail ;
