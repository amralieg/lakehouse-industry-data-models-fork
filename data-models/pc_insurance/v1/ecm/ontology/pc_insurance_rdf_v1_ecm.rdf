ind:lomaLomrCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Loma Lomr Case Number' ;
    rdfs:comment 'FEMA case number for the LOMA or LOMR if one has been issued for this location.' ;
    rdfs:domain ind:FloodZoneAssignment ;
    rdf:type owl:DatatypeProperty ;
