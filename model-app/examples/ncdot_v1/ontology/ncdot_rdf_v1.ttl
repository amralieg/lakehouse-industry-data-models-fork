ind:enrollmentPeriodType rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period Type' ;
    rdfs:comment 'Type of enrollment period during which the enrollment occurred (open enrollment, new hire, qualifying life event, special enrollment, annual enrollment).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentPeriodYear rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period Year' ;
    rdfs:comment 'Calendar year of the enrollment period (e.g., 2024 for 2024 open enrollment).' ;
