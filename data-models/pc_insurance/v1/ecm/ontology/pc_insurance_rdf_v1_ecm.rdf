    rdfs:comment 'Percentage of total premium earned during this accounting period.' ;
    rdfs:domain ind:EarnedPremium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:epAmount rdf:type rdf:Property ;
