    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimStatusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Claim Status History Id' ;
    rdfs:comment 'Unique identifier for each claim status transition record in the immutable audit log.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:examinerAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Examiner Adjuster Id' ;
    rdfs:comment 'Reference to the claims examiner responsible for oversight at the time of this status transition.' ;
    rdfs:domain ind:ClaimStatusHistory ;
    rdf:type owl:ObjectProperty ;
