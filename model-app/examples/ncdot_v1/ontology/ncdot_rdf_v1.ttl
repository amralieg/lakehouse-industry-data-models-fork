    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leadDays rdf:type rdf:Property ;
    rdfs:label 'Lead Days' ;
    rdfs:comment 'Number of lead days (overlap) allowing successor to start before predecessor completes, measured in days.' ;
