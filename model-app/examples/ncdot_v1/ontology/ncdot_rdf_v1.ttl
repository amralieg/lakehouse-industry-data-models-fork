    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Premium Amount' ;
    rdfs:comment 'Dollar amount of premium paid by NCDOT as the employer per pay period for this benefit coverage.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumFrequency rdf:type rdf:Property ;
    rdfs:label 'Premium Frequency' ;
    rdfs:comment 'Frequency at which premiums are deducted or paid (weekly, biweekly, semi-monthly, monthly, quarterly, annual).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductionCode rdf:type rdf:Property ;
    rdfs:label 'Deduction Code' ;
    rdfs:comment 'Code used in the payroll system (Beacon) to identify and process the benefit premium deduction.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualElectionAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Election Amount' ;
    rdfs:comment 'Annual dollar amount elected by employee for flexible spending accounts or similar benefit plans.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficiaryDesignation rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Designation' ;
    rdfs:comment 'Name or identifier of the designated beneficiary for life insurance or retirement benefits.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
