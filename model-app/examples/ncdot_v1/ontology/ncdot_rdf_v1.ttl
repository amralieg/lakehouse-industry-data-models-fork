ind:fundingSourceType rdf:type rdf:Property ;
    rdfs:label 'Funding Source Type' ;
    rdfs:comment 'High-level classification of the funding source by governmental level or origin.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
