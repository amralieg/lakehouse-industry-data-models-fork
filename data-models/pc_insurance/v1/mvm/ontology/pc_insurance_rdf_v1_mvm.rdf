    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxSingleRiskLimit rdf:type rdf:Property ;
    rdfs:label 'Max Single Risk Limit' ;
    rdfs:comment 'Maximum policy limit the producer may bind on a single insured risk without referral to underwriting.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTiv rdf:type rdf:Property ;
    rdfs:label 'Max Tiv' ;
    rdfs:comment 'Maximum total insured value the producer may bind without underwriting referral.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minPremiumThreshold rdf:type rdf:Property ;
    rdfs:label 'Min Premium Threshold' ;
    rdfs:comment 'Minimum written premium amount required for the producer to exercise binding authority on a policy.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newBusinessAllowed rdf:type rdf:Property ;
    rdfs:label 'New Business Allowed' ;
    rdfs:comment 'Indicates whether this authority permits binding new business policies.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occupancyRestrictions rdf:type rdf:Property ;
    rdfs:label 'Occupancy Restrictions' ;
    rdfs:comment 'Specific occupancy types or uses excluded from this binding authority per Construction, Occupancy, Protection, Exposure (COPE) criteria.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionClassMax rdf:type rdf:Property ;
    rdfs:label 'Protection Class Max' ;
    rdfs:comment 'Maximum ISO protection class rating allowed for binding under this authority without referral.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protectionClassMin rdf:type rdf:Property ;
    rdfs:label 'Protection Class Min' ;
    rdfs:comment 'Minimum ISO protection class rating required for the producer to bind coverage under this authority.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralCriteria rdf:type rdf:Property ;
    rdfs:label 'Referral Criteria' ;
    rdfs:comment 'Business rules or conditions that trigger mandatory referral to underwriting despite binding authority.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementAllowed rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Allowed' ;
    rdfs:comment 'Indicates whether this authority permits reinstating lapsed or canceled policies.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalAllowed rdf:type rdf:Property ;
    rdfs:label 'Renewal Allowed' ;
    rdfs:comment 'Indicates whether this authority permits binding renewal policies.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalEligible rdf:type rdf:Property ;
    rdfs:label 'Renewal Eligible' ;
    rdfs:comment 'Indicates whether this authority grant is eligible for renewal upon expiration.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date when the underwriting authority was revoked or terminated prior to expiration.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revocationReason rdf:type rdf:Property ;
    rdfs:label 'Revocation Reason' ;
    rdfs:comment 'Business reason or cause for revoking the underwriting authority prior to expiration.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskClassRestrictions rdf:type rdf:Property ;
    rdfs:label 'Risk Class Restrictions' ;
    rdfs:comment 'Comma-separated list of risk classes or NAICS codes for which this authority is restricted or excluded.' ;
    rdfs:domain ind:UnderwritingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riAgreementId rdf:type rdf:Property ;
    rdfs:label 'Ri Agreement Id' ;
    rdfs:comment 'Unique surrogate identifier for the reinsurance agreement record. Primary key. One row per reinsurance agreement between the cedant and one or more reinsurers.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiAgreement .

ind:brokerAgencyId rdf:type rdf:Property ;
    rdfs:label 'Broker Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Treaty agreements are placed through reinsurance brokers (agencies). Formalizing broker_name as FK enables producer performance tracking on treaty placements, commission reconciliation, and' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:cedantPartyId rdf:type rdf:Property ;
    rdfs:label 'Cedant Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: NAIC Schedule F regulatory reporting requires cedant identification by legal entity. Multi-entity P&C insurers must file reinsurance assumed/ceded by legal entity.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:aggregateLimitAmt rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Amt' ;
    rdfs:comment 'Maximum cumulative reinsurance recovery across all losses in the treaty period. Caps total reinsurer exposure for Stop Loss and aggregate XOL structures. Null if no aggregate cap.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agreementName rdf:type rdf:Property ;
    rdfs:label 'Agreement Name' ;
    rdfs:comment 'Descriptive name or title of the reinsurance agreement (e.g., \'2024 Property CAT XL Layer 1\'). Used for human-readable identification in reports and workbenches.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to the reinsurance agreement by the cedant or reinsurance management system. Used in bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementStatus rdf:type rdf:Property ;
    rdfs:label 'Agreement Status' ;
    rdfs:comment 'Current lifecycle state of the reinsurance agreement. Active indicates the agreement is in force and cessions may be made. Expired indicates the term has ended with no renewal.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Broad classification of the reinsurance arrangement: Treaty (automatic cession under standing contract), Facultative (individual risk negotiation), or Facultative-Obligatory.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arbitrationClause rdf:type rdf:Property ;
    rdfs:label 'Arbitration Clause' ;
    rdfs:comment 'Indicates whether the agreement contains a mandatory arbitration clause for dispute resolution in lieu of litigation. True if arbitration is required.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentPointAmt rdf:type rdf:Property ;
    rdfs:label 'Attachment Point Amt' ;
    rdfs:comment 'The loss threshold at which the reinsurance layer attaches and begins to respond for XOL and CAT XL treaties. Expressed in agreement currency. Null for proportional treaties.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizedStatus rdf:type rdf:Property ;
    rdfs:label 'Authorized Status' ;
    rdfs:comment 'Regulatory authorization status of the lead reinsurer in the cedant\'s domicile state: Authorized, Unauthorized, Certified (under NAIC Credit for Reinsurance Model Law), or Reciprocal.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catEventScope rdf:type rdf:Property ;
    rdfs:label 'Cat Event Scope' ;
    rdfs:comment 'Defines the loss aggregation basis for CAT XL treaties: Per Risk, Per Occurrence, Per Event (hours clause), or Aggregate. Determines how losses from a single CAT event are combined.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cedingCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Pct' ;
    rdfs:comment 'Percentage of ceded premium returned to the cedant as a ceding commission under proportional (QS/Surplus) treaties to offset acquisition and overhead costs.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionPct rdf:type rdf:Property ;
    rdfs:label 'Cession Pct' ;
    rdfs:comment 'Percentage of risk ceded to reinsurers under a Quota Share treaty (e.g., 25.0000 = 25%). Null for XOL and non-proportional treaties where cession is loss-triggered.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralRequired rdf:type rdf:Property ;
    rdfs:label 'Collateral Required' ;
    rdfs:comment 'Indicates whether the reinsurer is required to post collateral (LOC, trust, funds withheld) due to unauthorized/alien reinsurer status. Drives Schedule F credit allowance.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralType rdf:type rdf:Property ;
    rdfs:label 'Collateral Type' ;
    rdfs:comment 'Type of collateral posted by the reinsurer: Letter of Credit (LOC), Trust Account, Funds Withheld, Cash, or None. Required for unauthorized reinsurer credit under SAP SSAP No. 62R.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageBasis rdf:type rdf:Property ;
    rdfs:label 'Coverage Basis' ;
    rdfs:comment 'Defines which losses are covered: Losses Occurring (loss event in treaty period), Risks Attaching (policy incepting in treaty period), or Claims Made (claim reported in treaty period).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium Amt' ;
    rdfs:comment 'Initial premium paid by the cedant at inception of the treaty year, subject to adjustment at year-end based on actual subject premium. Used in ROL and premium settlement calculations.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundsWithheld rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld' ;
    rdfs:comment 'Indicates whether the cedant withholds ceded premium reserves rather than remitting to the reinsurer. Affects Schedule F credit and collateral requirements under SAP SSAP No. 62R.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingLaw rdf:type rdf:Property ;
    rdfs:label 'Governing Law' ;
    rdfs:comment 'Legal jurisdiction whose laws govern interpretation and enforcement of the agreement (e.g., \'New York\', \'England and Wales\'). Required for dispute resolution and regulatory compliance.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoursClauseHrs rdf:type rdf:Property ;
    rdfs:label 'Hours Clause Hrs' ;
    rdfs:comment 'Number of consecutive hours within which losses from a single occurrence are aggregated for CAT XL recovery purposes (e.g., 72 hours for wind, 168 hours for flood). Null if not applicable.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inceptionDate rdf:type rdf:Property ;
    rdfs:label 'Inception Date' ;
    rdfs:comment 'The date on which the reinsurance agreement becomes effective and cessions may begin. Aligns with the treaty year start for annual treaties.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insolvencyClause rdf:type rdf:Property ;
    rdfs:label 'Insolvency Clause' ;
    rdfs:comment 'Indicates whether the agreement contains an insolvency clause ensuring reinsurer obligations survive cedant insolvency. Required under SAP SSAP No. 62R for credit as reinsurance.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadReinsurerNaicCode rdf:type rdf:Property ;
    rdfs:label 'Lead Reinsurer Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code for the lead reinsurer. Required for Schedule F counterparty identification and credit risk assessment under SAP SSAP No. 62R.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadReinsurerName rdf:type rdf:Property ;
    rdfs:label 'Lead Reinsurer Name' ;
    rdfs:comment 'Legal name of the lead reinsurer on the agreement. For syndicated treaties, this is the lead market that sets terms. Used in bordereaux and Schedule F counterparty reporting.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitAmt rdf:type rdf:Property ;
    rdfs:label 'Limit Amt' ;
    rdfs:comment 'Maximum amount the reinsurer will pay per risk, per occurrence, or in aggregate under this agreement. Defines the top of the reinsurance layer for XOL treaties.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCorridorPct rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Pct' ;
    rdfs:comment 'Loss ratio band within which the cedant retains losses before the reinsurer re-engages, used in Stop Loss and aggregate structures. Null if no loss corridor provision.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremiumAmt rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Amt' ;
    rdfs:comment 'Minimum reinsurance premium guaranteed to the reinsurer regardless of actual subject premium volume. Protects reinsurer against cedant portfolio shrinkage.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offsetClause rdf:type rdf:Property ;
    rdfs:label 'Offset Clause' ;
    rdfs:comment 'Indicates whether the agreement permits mutual offset of amounts owed between cedant and reinsurer. Relevant for credit risk management and Schedule F balance netting.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Profit Commission Pct' ;
    rdfs:comment 'Percentage of reinsurer profit returned to the cedant under a profit commission clause. Calculated on the treaty year result after losses and expenses. Null if no profit commission.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programLayer rdf:type rdf:Property ;
    rdfs:label 'Program Layer' ;
    rdfs:comment 'Identifies the layer within a multi-layer reinsurance program (e.g., \'Layer 1\', \'Layer 2\', \'Top Layer\'). Used to sequence layers for loss allocation and PML modeling.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementCount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Count' ;
    rdfs:comment 'Number of times the reinsurance limit may be reinstated after a loss exhausts the layer. Common in CAT XL treaties. Zero indicates no reinstatement provision.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinstatementPremiumPct rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Pct' ;
    rdfs:comment 'Percentage of the original reinsurance premium charged to reinstate the limit after a loss. Expressed as a percentage of the annual deposit premium (e.g., 100% = pro-rata reinstatement).' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retentionAmt rdf:type rdf:Property ;
    rdfs:label 'Retention Amt' ;
    rdfs:comment 'The cedant\'s net retained amount per risk or per occurrence before reinsurance responds. For XOL, this is the attachment point (SIR). For QS, this is the retained share in currency.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retrocessionFlag rdf:type rdf:Property ;
    rdfs:label 'Retrocession Flag' ;
    rdfs:comment 'Indicates whether this agreement is a retrocession (reinsurer ceding risk to another reinsurer) rather than a primary cession from the cedant. Affects Schedule F netting.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rolPct rdf:type rdf:Property ;
    rdfs:label 'Rol Pct' ;
    rdfs:comment 'Rate on Line expressed as a percentage: reinsurance premium divided by the reinsurance limit. Key pricing metric for XOL and CAT XL layers used in actuarial and underwriting analysis.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signedDate rdf:type rdf:Property ;
    rdfs:label 'Signed Date' ;
    rdfs:comment 'The date the reinsurance agreement was formally executed and signed by all parties. May differ from inception date for retroactive or late-signed treaties.' ;
    rdfs:domain ind:RiAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:territoryScope rdf:type rdf:Property ;
    rdfs:label 'Territory Scope' ;
    rdfs:comment 'Geographic scope of risks covered by the agreement (e.g., \'USA and Canada\', \'Worldwide excluding War Zones\'). Drives exposure aggregation and CAT model alignment.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyType rdf:type rdf:Property ;
    rdfs:label 'Treaty Type' ;
    rdfs:comment 'Sub-classification for Treaty agreements: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), Catastrophe Excess of Loss (CAT XL), Surplus Share, or Other. Null for Facultative agreements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unlBasis rdf:type rdf:Property ;
    rdfs:label 'Unl Basis' ;
    rdfs:comment 'Defines how Ultimate Net Loss is calculated for recovery purposes: Gross (before other RI), Net of Inuring RI (after lower layers), or Net of All RI. Critical for layered program structures.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyId rdf:type rdf:Property ;
    rdfs:label 'Treaty Id' ;
    rdfs:comment 'Unique surrogate identifier for a reinsurance treaty record. Primary key. One row per treaty under a reinsurance agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Treaty .

ind:intermediaryAgencyId rdf:type rdf:Property ;
    rdfs:label 'Intermediary Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Treaties track intermediary/broker by name; should formalize as FK to agency. Enables broker performance analysis on treaty placements, commission tracking for reinsurance intermediation' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:reinsurerId rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Id' ;
    rdfs:comment 'Foreign key linking to reinsurance.reinsurer. Business justification: Treaty has denormalized reinsurer attributes (reinsurer_name, reinsurer_naic_code, reinsurer_share_pct). Adding FK to reinsurer master and removing redundant name and NAIC code.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reinsurer .

ind:aggregateDeductible rdf:type rdf:Property ;
    rdfs:label 'Aggregate Deductible' ;
    rdfs:comment 'Cumulative loss amount the cedant must absorb before aggregate stop loss or aggregate XOL reinsurance attaches. Also known as the annual aggregate retention.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aggregateLimit rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit' ;
    rdfs:comment 'Maximum total reinsurance recovery across all occurrences during the treaty period. Caps cumulative recoveries for aggregate XOL and Stop Loss treaties.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Attachment Point' ;
    rdfs:comment 'Dollar amount at which reinsurance coverage attaches for XOL and CAT XL treaties. Losses below this threshold are retained by the cedant. Null for proportional treaties.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizedReinsurerFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Reinsurer Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is authorized/accredited in the cedant\'s domicile state. Affects credit for reinsurance on the statutory balance sheet per NAIC requirements.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokeragePct rdf:type rdf:Property ;
    rdfs:label 'Brokerage Pct' ;
    rdfs:comment 'Percentage of ceded premium paid to the reinsurance intermediary as brokerage commission. Expressed as a decimal (e.g., 0.0250 = 2.5%).' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Required Flag' ;
    rdfs:comment 'Indicates whether the reinsurer must post collateral (letter of credit or trust fund) to support credit for reinsurance on the cedant\'s statutory balance sheet.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depositPremium rdf:type rdf:Property ;
    rdfs:label 'Deposit Premium' ;
    rdfs:comment 'Provisional premium paid at treaty inception, subject to adjustment at year-end based on actual subject premium. Common in proportional and adjustable XOL treaties.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hoursClause rdf:type rdf:Property ;
    rdfs:label 'Hours Clause' ;
    rdfs:comment 'Maximum number of consecutive hours within which losses from a single catastrophe event are aggregated for recovery purposes (e.g., 72 hours for windstorm, 168 hours for flood).' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inceptionYear rdf:type rdf:Property ;
    rdfs:label 'Inception Year' ;
    rdfs:comment 'Calendar year in which the treaty incepted. Used for underwriting year (UY) and policy year (PY) loss triangle segmentation in actuarial reserving.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:layerNumber rdf:type rdf:Property ;
    rdfs:label 'Layer Number' ;
    rdfs:comment 'Sequential layer number within a tower of XOL or CAT XL protection (e.g., Layer 1, Layer 2). Distinguishes multiple treaties in the same program year.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:limit rdf:type rdf:Property ;
    rdfs:label 'Limit' ;
    rdfs:comment 'Maximum reinsurance recovery available under this treaty per occurrence or in aggregate. Defines the top of the layer for XOL/CAT XL treaties.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCorridorLower rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Lower' ;
    rdfs:comment 'Lower bound of the loss ratio corridor retained by the cedant in a Stop Loss treaty. Expressed as a decimal loss ratio (e.g., 0.7000 = 70%). Null for non-SL treaties.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCorridorUpper rdf:type rdf:Property ;
    rdfs:label 'Loss Corridor Upper' ;
    rdfs:comment 'Upper bound of the loss ratio corridor at which Stop Loss reinsurance attaches. Expressed as a decimal loss ratio (e.g., 0.9000 = 90%). Null for non-SL treaties.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremium rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium' ;
    rdfs:comment 'Minimum reinsurance premium guaranteed to the reinsurer regardless of ceded subject premium volume. Protects reinsurer against low-volume years.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treatyName rdf:type rdf:Property ;
    rdfs:label 'Treaty Name' ;
    rdfs:comment 'Descriptive name of the treaty (e.g., \'Property CAT XL Layer 1 2024\'). Used for human identification in reinsurance management system and bordereaux.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceLimit rdf:type rdf:Property ;
    rdfs:label 'Occurrence Limit' ;
    rdfs:comment 'Maximum reinsurance recovery per single occurrence or event under this treaty. Distinct from aggregate limit. Applies to per-occurrence XOL and CAT XL structures.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementPct rdf:type rdf:Property ;
    rdfs:label 'Placement Pct' ;
    rdfs:comment 'Total percentage of treaty capacity placed with all reinsurers combined. A value less than 1.0000 indicates a partially placed treaty with net retained gap.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premium rdf:type rdf:Property ;
    rdfs:label 'Premium' ;
    rdfs:comment 'Total reinsurance premium ceded to reinsurers under this treaty for the treaty period. For QS treaties, this is the ceded written premium. For XOL, this is the flat or deposit premium.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsurerSharePct rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Share Pct' ;
    rdfs:comment 'Percentage of the treaty capacity subscribed by the lead reinsurer. For fully placed treaties this may be 100%; for syndicated treaties it reflects the lead line.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retentionAmount rdf:type rdf:Property ;
    rdfs:label 'Retention Amount' ;
    rdfs:comment 'The cedant\'s net retained loss amount before reinsurance attaches. For XOL, this is the attachment point per occurrence. For QS, this is the retained percentage expressed as a dollar floor.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retentionPct rdf:type rdf:Property ;
    rdfs:label 'Retention Pct' ;
    rdfs:comment 'Percentage of risk retained by the cedant under a proportional (QS or Surplus) treaty. Expressed as a decimal (e.g., 0.2500 = 25%). Null for non-proportional treaties.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subjectPremiumBasis rdf:type rdf:Property ;
    rdfs:label 'Subject Premium Basis' ;
    rdfs:comment 'Defines the premium base used to calculate ceded premium under proportional treaties: Gross Written Premium (GWP), Net Written Premium (NWP), Direct Premium Written (DPW), or Net Earned.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territory rdf:type rdf:Property ;
    rdfs:label 'Territory' ;
    rdfs:comment 'Geographic scope of risks covered by this treaty (e.g., \'USA\', \'USA and Canada\', \'Worldwide Excluding\'). Defines eligible cession geography for bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyStatus rdf:type rdf:Property ;
    rdfs:label 'Treaty Status' ;
    rdfs:comment 'Current lifecycle state of the treaty. Controls whether new cessions can be written against it and whether recoveries are eligible.' ;
    rdfs:domain ind:Treaty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyLayerId rdf:type rdf:Property ;
    rdfs:label 'Treaty Layer Id' ;
    rdfs:comment 'Unique surrogate identifier for a single attachment/exhaustion layer within an XOL or CAT XL reinsurance treaty. One row per layer per treaty.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatyLayer .

ind:parentTreatyLayerId rdf:type rdf:Property ;
    rdfs:label 'Parent Treaty Layer Id' ;
    rdfs:comment 'Self-referencing identifier of the immediately underlying treaty layer in a multi-layer tower. Null for the first layer above the cedant retention.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatyLayer .

ind:accountingBasis rdf:type rdf:Property ;
    rdfs:label 'Accounting Basis' ;
    rdfs:comment 'Basis on which losses are covered: losses_occurring (losses that occur during the treaty period) or risks_attaching (policies attaching during the treaty period).' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualAggregateDeductible rdf:type rdf:Property ;
    rdfs:label 'Annual Aggregate Deductible' ;
    rdfs:comment 'Cumulative loss amount the cedant must retain across all occurrences before the annual aggregate limit of this layer begins to respond.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualAggregateLimit rdf:type rdf:Property ;
    rdfs:label 'Annual Aggregate Limit' ;
    rdfs:comment 'Maximum total dollar amount recoverable from reinsurers under this layer across all occurrences within the treaty year. Null if no aggregate cap applies.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokerReference rdf:type rdf:Property ;
    rdfs:label 'Broker Reference' ;
    rdfs:comment 'Reinsurance broker\'s reference number or slip identifier for this layer as used in placement correspondence and market submissions.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cedantRetentionPct rdf:type rdf:Property ;
    rdfs:label 'Cedant Retention Pct' ;
    rdfs:comment 'Percentage of loss within this layer retained by the cedant (co-participation). Expressed as a decimal (e.g., 0.1000 = 10%). Remainder is ceded to reinsurers.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPct rdf:type rdf:Property ;
    rdfs:label 'Ceded Pct' ;
    rdfs:comment 'Percentage of loss within this layer ceded to reinsurers. Equals 1 minus cedant_retention_pct. Stored explicitly for bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exhaustionPoint rdf:type rdf:Property ;
    rdfs:label 'Exhaustion Point' ;
    rdfs:comment 'Dollar amount at which this layer is fully exhausted, equal to attachment_point plus layer_limit. Stored explicitly for bordereaux reporting and PML tower analysis.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexBasis rdf:type rdf:Property ;
    rdfs:label 'Index Basis' ;
    rdfs:comment 'Name or description of the index used for the index clause (e.g., CPI, Marshall & Swift construction cost index). Null if index_clause_flag is false.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Index Clause Flag' ;
    rdfs:comment 'Indicates whether an index or stability clause applies to this layer, adjusting the attachment point and limit in line with an inflation or price index.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:layerCode rdf:type rdf:Property ;
    rdfs:label 'Layer Code' ;
    rdfs:comment 'Externally-known alphanumeric code identifying this layer as referenced in bordereaux, reinsurer slips, and Schedule F filings.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerLimit rdf:type rdf:Property ;
    rdfs:label 'Layer Limit' ;
    rdfs:comment 'Maximum dollar amount recoverable from reinsurers under this layer for a single occurrence or event. Defines the exhaustion point as attachment_point + layer_limit.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerName rdf:type rdf:Property ;
    rdfs:label 'Layer Name' ;
    rdfs:comment 'Descriptive name for this layer (e.g., \'1st XOL Layer\', \'2nd CAT XL Layer\') used in reinsurer communications and internal reporting.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerNotes rdf:type rdf:Property ;
    rdfs:label 'Layer Notes' ;
    rdfs:comment 'Free-text field for underwriter or reinsurance analyst notes regarding special terms, conditions, or exceptions applicable to this layer not captured in structured fields.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerStatus rdf:type rdf:Property ;
    rdfs:label 'Layer Status' ;
    rdfs:comment 'Current lifecycle state of the treaty layer indicating whether it is actively in force, expired, cancelled, pending placement, or suspended.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layerType rdf:type rdf:Property ;
    rdfs:label 'Layer Type' ;
    rdfs:comment 'Classification of the reinsurance layer structure. XOL=Excess of Loss, CAT_XL=Catastrophe Excess of Loss, QS=Quota Share, SL=Stop Loss, WORKING=working layer, CLASH=clash cover.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobScope rdf:type rdf:Property ;
    rdfs:label 'Lob Scope' ;
    rdfs:comment 'Comma-delimited list of Lines of Business covered by this layer (e.g., HO, PAP, CGL, BOP). Defines the subject business eligible for recovery under this layer.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossOccurrenceDefinition rdf:type rdf:Property ;
    rdfs:label 'Loss Occurrence Definition' ;
    rdfs:comment 'Contractual definition of a single occurrence for this layer (e.g., 168-hour clause for windstorm, 72-hour clause for earthquake). Critical for CAT XL aggregation.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placedPct rdf:type rdf:Property ;
    rdfs:label 'Placed Pct' ;
    rdfs:comment 'Percentage of this layer that has been placed with reinsurers. A value less than 1.0 indicates the layer is not fully subscribed.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementBasis rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Basis' ;
    rdfs:comment 'Basis on which reinstatement premium is calculated: pro_rata (proportional to loss), flat (fixed percentage), or free (no additional premium charged).' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurancePremium rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Premium' ;
    rdfs:comment 'Gross reinsurance premium payable by the cedant to reinsurers for this layer for the treaty period. Used in bordereaux and Schedule F premium reporting.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signedLinePct rdf:type rdf:Property ;
    rdfs:label 'Signed Line Pct' ;
    rdfs:comment 'Total signed line percentage across all reinsurers participating in this layer after signing-down from written lines. Should sum to placed_pct.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slidingScaleFlag rdf:type rdf:Property ;
    rdfs:label 'Sliding Scale Flag' ;
    rdfs:comment 'Indicates whether a sliding scale commission arrangement applies to this layer, where the ceding commission varies inversely with the loss ratio.' ;
    rdfs:domain ind:TreatyLayer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facAgreementId rdf:type rdf:Property ;
    rdfs:label 'Fac Agreement Id' ;
    rdfs:comment 'Unique surrogate primary key for the facultative reinsurance agreement. One row per FAC placement covering a single risk or policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacAgreement .

ind:autoRiskId rdf:type rdf:Property ;
    rdfs:label 'Auto Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.auto_risk. Business justification: Facultative reinsurance is placed on large commercial auto fleets and high-value vehicles.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AutoRisk .

ind:catastropheEventId rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Event Id' ;
    rdfs:comment 'Reference to a catastrophe event record if this FAC placement was triggered or influenced by a specific CAT event exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatastropheEvent .

ind:facBrokerAgencyId rdf:type rdf:Property ;
    rdfs:label 'Fac Broker Agency Id' ;
    rdfs:comment 'Foreign key linking to producers.agency. Business justification: Facultative placements are placed through broker agencies. Commission statements, binding authority verification, and appointment checks require the placing agency record.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:primaryFacBrokerPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Fac Broker Party Id' ;
    rdfs:comment 'Reference to the party record for the reinsurance intermediary/broker who placed this FAC agreement on behalf of the cedant.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:propertyRiskId rdf:type rdf:Property ;
    rdfs:label 'Property Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.property_risk. Business justification: Facultative underwriters evaluate property-specific attributes (construction type, replacement cost, TIV, roof type) when pricing and binding fac placements on commercial property.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PropertyRisk .

ind:riskexposureInsuredRiskId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Insured Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.insured_risk. Business justification: Facultative reinsurance is placed on specific high-value or unusual individual risks. Underwriters submit detailed risk characteristics to reinsurers for facultative quotes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredRisk .

ind:tertiaryFacReinsurerPartyId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Fac Reinsurer Party Id' ;
    rdfs:comment 'Reference to the party record representing the assuming reinsurer accepting the ceded risk under this FAC placement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:uwDecisionId rdf:type rdf:Property ;
    rdfs:label 'Uw Decision Id' ;
    rdfs:comment 'Foreign key linking to coverage.uw_decision. Business justification: Facultative reinsurers require underwriting decision context (risk tier, referral reasons, conditions, decline rationale) to assess participation and price fac certificates.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UwDecision .

ind:uwReferralId rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Id' ;
    rdfs:comment 'Foreign key linking to coverage.uw_referral. Business justification: High-risk submissions triggering underwriting referrals often require facultative reinsurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UwReferral .

ind:boundDate rdf:type rdf:Property ;
    rdfs:label 'Bound Date' ;
    rdfs:comment 'Date on which the reinsurer formally bound coverage under this facultative agreement, confirming acceptance of the ceded risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokerCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Broker Commission Rate' ;
    rdfs:comment 'Percentage of ceded premium payable to the reinsurance broker as intermediary commission for placing this FAC agreement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date on which the facultative agreement was cancelled, if applicable. Null for agreements that run to natural expiry.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cededLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Limit Amount' ;
    rdfs:comment 'Maximum dollar amount of loss the reinsurer will pay under this FAC agreement. Represents the reinsurer\'s liability cap for the placement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPercentage rdf:type rdf:Property ;
    rdfs:label 'Ceded Percentage' ;
    rdfs:comment 'Percentage of the original risk ceded to the reinsurer under this FAC agreement, expressed as a decimal (e.g., 0.5000 = 50%). Applies to pro-rata placements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Amount' ;
    rdfs:comment 'Dollar amount of premium ceded to the reinsurer under this FAC agreement. Reduces net written premium (NWP) for the cedant.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Amount' ;
    rdfs:comment 'Dollar amount of ceding commission receivable from the reinsurer. Calculated as ceded premium multiplied by the ceding commission rate.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission Rate' ;
    rdfs:comment 'Percentage of ceded premium returned to the cedant by the reinsurer as a ceding commission to offset acquisition and administrative costs.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Amount' ;
    rdfs:comment 'Dollar amount of collateral posted by the reinsurer (letter of credit or trust) to secure obligations under this FAC agreement.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Fac Certificate Number' ;
    rdfs:comment 'Certificate number issued by the reinsurer confirming acceptance of the facultative placement. Used for claims recovery and bordereaux reconciliation.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facPremiumRate rdf:type rdf:Property ;
    rdfs:label 'Fac Premium Rate' ;
    rdfs:comment 'Rate applied to the ceded limit or TIV to derive the FAC reinsurance premium. Expressed as a decimal (e.g., 0.005000 = 0.50%). Also known as Rate on Line (ROL) for XOL placements.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Fac Reference Number' ;
    rdfs:comment 'Externally-known business identifier assigned to this FAC placement, used in bordereaux reporting and reinsurer correspondence. Unique per placement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facType rdf:type rdf:Property ;
    rdfs:label 'Fac Type' ;
    rdfs:comment 'Structural type of the facultative placement: pro-rata (quota share basis) or excess of loss. Determines how premium and losses are shared.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Gross Written Premium' ;
    rdfs:comment 'Total gross written premium on the underlying policy before cession. Basis for calculating the ceded reinsurance premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossParticipationRate rdf:type rdf:Property ;
    rdfs:label 'Loss Participation Rate' ;
    rdfs:comment 'Percentage of losses the cedant participates in alongside the reinsurer under profit-sharing or loss-sensitive FAC structures.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalInsuredTiv rdf:type rdf:Property ;
    rdfs:label 'Original Insured Tiv' ;
    rdfs:comment 'Total Insured Value of the underlying risk at the time of FAC placement. Used to calculate ceded exposure and Rate on Line (ROL).' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementBasis rdf:type rdf:Property ;
    rdfs:label 'Placement Basis' ;
    rdfs:comment 'Basis on which the FAC agreement responds: risks attaching (policies incepting during the period) or losses occurring (losses during the period).' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementPremiumRate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Rate' ;
    rdfs:comment 'Rate applied to the original FAC premium to calculate the reinstatement premium payable when the ceded limit is reinstated after a loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementProvision rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Provision' ;
    rdfs:comment 'Indicates whether the FAC agreement includes a reinstatement provision allowing the ceded limit to be restored after a loss, typically for XOL placements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerSharePercentage rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Share Percentage' ;
    rdfs:comment 'Percentage of the FAC placement accepted by this specific reinsurer. Relevant when a single FAC risk is placed with multiple reinsurers (co-reinsurance).' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsurerUnderwriterName rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Underwriter Name' ;
    rdfs:comment 'Name of the underwriter at the assuming reinsurer who accepted and bound this FAC placement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleFCategory rdf:type rdf:Property ;
    rdfs:label 'Schedule F Category' ;
    rdfs:comment 'NAIC Schedule F classification of the reinsurer for statutory reporting: authorized, unauthorized, certified, or reciprocal jurisdiction reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slipReference rdf:type rdf:Property ;
    rdfs:label 'Slip Reference' ;
    rdfs:comment 'Market slip or cover note reference number associated with this FAC placement, used in London Market or broker-placed reinsurance transactions.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialConditions rdf:type rdf:Property ;
    rdfs:label 'Special Conditions' ;
    rdfs:comment 'Free-text description of any special terms, conditions, exclusions, or warranties specific to this facultative placement not captured in structured fields.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterName rdf:type rdf:Property ;
    rdfs:label 'Underwriter Name' ;
    rdfs:comment 'Name of the cedant\'s underwriter responsible for placing and managing this facultative reinsurance agreement.' ;
    rdfs:domain ind:FacAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentReinsurerId rdf:type rdf:Property ;
    rdfs:label 'Parent Reinsurer Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the parent reinsurer entity for group-level exposure aggregation, credit limit monitoring, and group Schedule F reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reinsurer .

ind:amBestOutlook rdf:type rdf:Property ;
    rdfs:label 'Am Best Outlook' ;
    rdfs:comment 'AM Best rating outlook indicating the likely direction of the reinsurer\'s financial strength rating over the medium term. Informs counterparty risk monitoring.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amBestRating rdf:type rdf:Property ;
    rdfs:label 'Am Best Rating' ;
    rdfs:comment 'AM Best Financial Strength Rating (FSR) assigned to the reinsurer. Used in underwriting guidelines to validate counterparty credit quality and treaty eligibility thresholds.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amBestRatingDate rdf:type rdf:Property ;
    rdfs:label 'Am Best Rating Date' ;
    rdfs:comment 'Date on which the current AM Best Financial Strength Rating was assigned or last affirmed. Used to assess rating currency and trigger counterparty review workflows.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Approval Expiry Date' ;
    rdfs:comment 'Date on which the current internal approval for the reinsurer expires and must be renewed by the credit committee. Drives counterparty review scheduling.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedFlag rdf:type rdf:Property ;
    rdfs:label 'Approved Flag' ;
    rdfs:comment 'Indicates whether the reinsurer has been formally approved by the cedant\'s internal credit and counterparty risk committee for placement of new reinsurance agreements.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Authorization Status' ;
    rdfs:comment 'Indicates whether the reinsurer is authorized, unauthorized, certified, or accredited in the cedant\'s domicile state. Determines Schedule F credit for reinsurance and collateral obligations.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerIntermediaryName rdf:type rdf:Property ;
    rdfs:label 'Broker Intermediary Name' ;
    rdfs:comment 'Name of the reinsurance broker or intermediary through which business is placed with this reinsurer. Used for commission tracking and intermediary credit risk assessment.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Code' ;
    rdfs:comment 'Internal alphanumeric code assigned to uniquely identify the reinsurer within the Reinsurance Management System for bordereaux and cession processing.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Amount' ;
    rdfs:comment 'Maximum aggregate ceded exposure (in USD) approved for this reinsurer by the internal credit committee. Enforced at cession booking to prevent counterparty concentration breaches.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:domicileCountry rdf:type rdf:Property ;
    rdfs:label 'Domicile Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the reinsurer is legally domiciled. Used for Schedule F foreign reinsurer classification and credit determination.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domicileState rdf:type rdf:Property ;
    rdfs:label 'Domicile State' ;
    rdfs:comment 'Two-letter US state or territory code where the reinsurer is domiciled, if a domestic entity. Used for state-level authorization and credit for reinsurance analysis.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalExciseTaxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Excise Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is exempt from US Federal Excise Tax on reinsurance premiums under a tax treaty or qualified jurisdiction status per IRC Section 4371.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:groupName rdf:type rdf:Property ;
    rdfs:label 'Group Name' ;
    rdfs:comment 'Name of the reinsurance group or holding company to which this reinsurer belongs. Used for group-level credit exposure aggregation and counterparty concentration risk.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date of the most recent formal counterparty credit review conducted by the cedant\'s reinsurance credit committee. Supports ORSA and governance audit requirements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lloydsSyndicateNumber rdf:type rdf:Property ;
    rdfs:label 'Lloyds Syndicate Number' ;
    rdfs:comment 'Four-digit Lloyd\'s of London syndicate number. Populated only when reinsurer_type is lloyds_syndicate. Required for Lloyd\'s-specific bordereaux and premium trust fund reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumAmBestRating rdf:type rdf:Property ;
    rdfs:label 'Minimum Am Best Rating' ;
    rdfs:comment 'Minimum AM Best Financial Strength Rating required by internal policy for this reinsurer to remain eligible for new cessions. Triggers review if current rating falls below threshold.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moodysRating rdf:type rdf:Property ;
    rdfs:label 'Moodys Rating' ;
    rdfs:comment 'Moody\'s Investors Service insurance financial strength rating for the reinsurer. Used as a tertiary credit quality indicator in counterparty risk frameworks.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poolName rdf:type rdf:Property ;
    rdfs:label 'Pool Name' ;
    rdfs:comment 'Name of the reinsurance pool or facility when the reinsurer participates as a pool member. Used for pool-level aggregation in bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerStatus rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Status' ;
    rdfs:comment 'Current operational status of the reinsurer in the cedant\'s system. Controls eligibility for new cessions and triggers collection escalation for run-off or insolvent counterparties.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerType rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Type' ;
    rdfs:comment 'Classification of the reinsurer entity structure. Drives Schedule F credit treatment and collateral requirements. [ENUM-REF-CANDIDATE: assuming_company|lloyds_syndicate|pool|captive|government|other — promote to reference product]' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Inception Date' ;
    rdfs:comment 'Date on which the cedant first entered into a reinsurance agreement with this counterparty. Used for relationship tenure analysis and counterparty history reporting.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Abbreviated or commonly used trading name of the reinsurer used in bordereaux reports, internal systems, and operational communications.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spRating rdf:type rdf:Property ;
    rdfs:label 'Sp Rating' ;
    rdfs:comment 'S&P Global Ratings financial strength rating for the reinsurer. Supplementary credit quality indicator used alongside AM Best for counterparty risk assessment.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxWithholdingRate rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Rate' ;
    rdfs:comment 'Federal excise tax or withholding rate applicable to premium payments to this reinsurer, expressed as a decimal (e.g., 0.01 = 1%). Applies to foreign unauthorized reinsurers per IRC Section 4371.' ;
    rdfs:domain ind:Reinsurer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riParticipantId rdf:type rdf:Property ;
    rdfs:label 'Ri Participant Id' ;
    rdfs:comment 'Unique surrogate identifier for a reinsurer\'s participation record within a treaty or facultative agreement. One row per reinsurer per agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiParticipant .

ind:primaryRiPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Ri Party Id' ;
    rdfs:comment 'Reference to the reinsurance intermediary (broker) who placed this participant\'s line. Used for broker commission settlement and bordereaux routing.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:accountCurrentBasis rdf:type rdf:Property ;
    rdfs:label 'Account Current Basis' ;
    rdfs:comment 'Basis on which the account current (bordereaux) is prepared for this participant: written premium basis, earned premium basis, or cash basis.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerageCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Brokerage Commission Pct' ;
    rdfs:comment 'Percentage of ceded premium payable to the reinsurance broker for placing this participant\'s line. Applied to the participant\'s share of written premium.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionSharePct rdf:type rdf:Property ;
    rdfs:label 'Cession Share Pct' ;
    rdfs:comment 'Effective share of each cession allocated to this participant, derived from signed line and order hereon. Used to compute this reinsurer\'s portion of premium and loss.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commutationAmount rdf:type rdf:Property ;
    rdfs:label 'Commutation Amount' ;
    rdfs:comment 'Lump-sum amount agreed upon in the commutation to settle all outstanding reserves and future obligations for this reinsurer\'s participation share.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commutationDate rdf:type rdf:Property ;
    rdfs:label 'Commutation Date' ;
    rdfs:comment 'Date on which the commutation agreement was executed, extinguishing all future obligations between the cedant and this reinsurer under this participation.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commutationFlag rdf:type rdf:Property ;
    rdfs:label 'Commutation Flag' ;
    rdfs:comment 'Indicates whether this participation has been commuted, meaning all outstanding obligations have been settled by a lump-sum payment and the agreement extinguished.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cutThroughClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Cut Through Clause Flag' ;
    rdfs:comment 'Indicates whether a cut-through endorsement exists allowing the cedant\'s policyholders to claim directly against this reinsurer in the event of the cedant\'s insolvency.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundsWithheldFlag rdf:type rdf:Property ;
    rdfs:label 'Funds Withheld Flag' ;
    rdfs:comment 'Indicates whether the cedant withholds ceded premium from this reinsurer under a funds-withheld arrangement, used as collateral for unauthorized reinsurers.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insolvencyClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Insolvency Clause Flag' ;
    rdfs:comment 'Indicates whether the standard insolvency clause is included, requiring the reinsurer to pay claims even if the cedant becomes insolvent, per NAIC model law requirements.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcAmount rdf:type rdf:Property ;
    rdfs:label 'Lc Amount' ;
    rdfs:comment 'Dollar amount of the letter of credit posted by this reinsurer as collateral. Required for Schedule F credit for reinsurance calculations for unauthorized reinsurers.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lcRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Lc Required Flag' ;
    rdfs:comment 'Indicates whether this reinsurer is required to post a letter of credit as collateral for credit for reinsurance purposes under state regulation.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offsetClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Offset Clause Flag' ;
    rdfs:comment 'Indicates whether the participation agreement includes an offset clause allowing mutual debts between cedant and reinsurer to be netted in settlement.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderHereonPct rdf:type rdf:Property ;
    rdfs:label 'Order Hereon Pct' ;
    rdfs:comment 'The cedant\'s order percentage representing the total share of risk placed with the reinsurance market. Used to scale signed and written lines to the actual ceded amount.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:participantReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Participant Reference Number' ;
    rdfs:comment 'Externally-known unique identifier assigned by the reinsurance management system to this participation line, used in bordereaux and Schedule F reporting.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participantStatus rdf:type rdf:Property ;
    rdfs:label 'Participant Status' ;
    rdfs:comment 'Current lifecycle state of the reinsurer\'s participation in the agreement. Controls whether cessions and recoveries can be posted against this participant.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationType rdf:type rdf:Property ;
    rdfs:label 'Participation Type' ;
    rdfs:comment 'Classifies the reinsurer\'s role in the panel: leader sets terms, followers subscribe, sole reinsurer takes 100%. Drives bordereaux and settlement logic.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementDate rdf:type rdf:Property ;
    rdfs:label 'Placement Date' ;
    rdfs:comment 'Date on which the reinsurer\'s line was formally placed and agreed, which may precede the participation effective date. Used for audit trail and contract management.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementFrequency rdf:type rdf:Property ;
    rdfs:label 'Settlement Frequency' ;
    rdfs:comment 'Frequency at which premium and loss accounts are settled between the cedant and this reinsurer. Drives bordereaux generation and cash settlement scheduling.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingDate rdf:type rdf:Property ;
    rdfs:label 'Signing Date' ;
    rdfs:comment 'Date on which the reinsurer formally signed the slip or contract, confirming their committed signed line percentage. Distinct from placement date.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trustFundAmount rdf:type rdf:Property ;
    rdfs:label 'Trust Fund Amount' ;
    rdfs:comment 'Amount held in a reinsurance trust fund by this reinsurer as an alternative collateral mechanism for credit for reinsurance under NAIC model law.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writtenLinePct rdf:type rdf:Property ;
    rdfs:label 'Written Line Pct' ;
    rdfs:comment 'The percentage of the agreement initially offered to and accepted by the reinsurer before signing-down. May differ from signed line when the placement is oversubscribed.' ;
    rdfs:domain ind:RiParticipant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionId rdf:type rdf:Property ;
    rdfs:label 'Cession Id' ;
    rdfs:comment 'Unique surrogate identifier for each cession record. One row per policy term per treaty layer or facultative agreement. Primary key of the cession table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cession .

ind:calendarId rdf:type rdf:Property ;
    rdfs:label 'Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Cession records must align to NAIC reporting quarters and SAP/GAAP fiscal periods for bordereaux aggregation and Schedule F filing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:lineId rdf:type rdf:Property ;
    rdfs:label 'Line Id' ;
    rdfs:comment 'Foreign key linking to policy.line. Business justification: Reinsurance cessions are allocated by LOB line within a policy term. Linking cession to the policy line record enables LOB-level bordereaux production, Schedule F reporting by line, and' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Line .

ind:policyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Id' ;
    rdfs:comment 'Foreign key linking to policy.policy_transaction. Business justification: Mid-term endorsements, cancellations, and reinstatements change subject premium and trigger cession adjustments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:quoteCoverageId rdf:type rdf:Property ;
    rdfs:label 'Quote Coverage Id' ;
    rdfs:comment 'Foreign key linking to coverage.quote_coverage. Business justification: Cessions must reconcile back to the original quoted coverage that was bound, enabling auditors and actuaries to trace ceded premium from quote through bind to cession.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QuoteCoverage .

ind:reinsurerPartyId rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Party Id' ;
    rdfs:comment 'Reference to the reinsurer party accepting this cession. Supports multi-reinsurer panels where each reinsurer has a separate cession row.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:accidentYear rdf:type rdf:Property ;
    rdfs:label 'Accident Year' ;
    rdfs:comment 'Accident Year (AY) associated with losses ceded under this cession. Used for loss development triangles and IBNR reserving on ceded basis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bookingDate rdf:type rdf:Property ;
    rdfs:label 'Booking Date' ;
    rdfs:comment 'Date on which this cession was recorded in the Reinsurance Management System and booked to the general ledger for statutory reporting.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bordereauxPeriod rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Period' ;
    rdfs:comment 'Reporting period (YYYY-MM or YYYY-Q#) for which this cession is included in the reinsurance bordereaux submission to the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededCaseReserve rdf:type rdf:Property ;
    rdfs:label 'Ceded Case Reserve' ;
    rdfs:comment 'Reinsurer\'s share of the case reserve for known reported losses ceded under this cession. Used for ceded reserve reporting on Schedule F.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededEarnedPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Earned Premium' ;
    rdfs:comment 'Portion of the ceded premium that has been earned as of the reporting date, based on the pro-rata exposure period elapsed.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededGwp rdf:type rdf:Property ;
    rdfs:label 'Ceded Gwp' ;
    rdfs:comment 'Gross Written Premium (GWP) ceded to the reinsurer for this policy term. Represents the cedant\'s cost of reinsurance before ceding commission.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededIbnrReserve rdf:type rdf:Property ;
    rdfs:label 'Ceded Ibnr Reserve' ;
    rdfs:comment 'Reinsurer\'s share of the IBNR reserve for losses incurred but not yet reported under this cession. Required for ceded IBNR disclosure on Schedule F.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLimit rdf:type rdf:Property ;
    rdfs:label 'Ceded Limit' ;
    rdfs:comment 'Maximum reinsurer liability under this cession. For XOL treaties, this is the layer limit; for QS, it is the proportional share of the policy limit.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededTiv rdf:type rdf:Property ;
    rdfs:label 'Ceded Tiv' ;
    rdfs:comment 'Total Insured Value (TIV) transferred to the reinsurer under this cession. Represents the gross exposure ceded for property lines.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededUnearnedPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Unearned Premium' ;
    rdfs:comment 'Portion of the ceded premium not yet earned as of the reporting date. Represents the reinsurer\'s liability for the unexpired risk period.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
    rdfs:comment 'Indicates whether this is an outward cession (cedant to reinsurer) or a retrocession (reinsurer ceding further). Distinguishes primary cession from retro.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundsHeldAmount rdf:type rdf:Property ;
    rdfs:label 'Funds Held Amount' ;
    rdfs:comment 'Amount of reinsurance premium held by the cedant as funds held under the reinsurance agreement, rather than remitted to the reinsurer.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCatastropheCession rdf:type rdf:Property ;
    rdfs:label 'Is Catastrophe Cession' ;
    rdfs:comment 'Indicates whether this cession is associated with a catastrophe event (CAT XL treaty). Flags cessions for CAT PML aggregation and catastrophe bordereaux reporting.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyYear rdf:type rdf:Property ;
    rdfs:label 'Policy Year' ;
    rdfs:comment 'Policy Year (PY) in which the ceded policy term incepted. Used for actuarial loss development, Schedule P, and reinsurance year-of-account reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateOnLine rdf:type rdf:Property ;
    rdfs:label 'Rate On Line' ;
    rdfs:comment 'Rate on Line (ROL) expressed as a percentage of the ceded limit. Key pricing metric for XOL and CAT XL layers; equals ceded premium divided by ceded limit.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceCessionStatus rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Status' ;
    rdfs:comment 'Current lifecycle state of the cession record within the reinsurance management workflow.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Authorization Status' ;
    rdfs:comment 'NAIC authorization classification of the assuming reinsurer: authorized, accredited, certified, unauthorized, or reciprocal. Drives collateral and credit requirements.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerDomicileCountry rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Domicile Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the reinsurer\'s domicile. Determines whether the reinsurer is authorized, accredited, or unauthorized under NAIC Schedule F.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerNaicCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code of the assuming reinsurer. Required for NAIC Schedule F statutory reporting and reinsurer credit risk assessment.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharePct rdf:type rdf:Property ;
    rdfs:label 'Share Pct' ;
    rdfs:comment 'Proportional share (as a percentage) ceded to the reinsurer. Applicable for Quota Share treaties. For XOL, this represents the reinsurer\'s participation percentage in the layer.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ultimateNetLoss rdf:type rdf:Property ;
    rdfs:label 'Ultimate Net Loss' ;
    rdfs:comment 'Ultimate Net Loss (UNL) ceded under this cession, representing the reinsurer\'s share of total incurred losses including LAE. Key metric for XOL treaty performance.' ;
    rdfs:domain ind:Cession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riPremiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Ri Premium Transaction Id' ;
    rdfs:comment 'Unique surrogate key for each reinsurance ceded premium financial movement. One row per written, earned, unearned, return, or reinstatement transaction for a cession. TRANSACTION_HEADER role.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiPremiumTransaction .

ind:originalTransactionRiPremiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Ri Premium Transaction Id' ;
    rdfs:comment 'For reversal or correction transactions, references the ri_premium_transaction_id of the original entry being reversed. Null for original transactions. Supports audit trail and net balance reconciliation.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiPremiumTransaction .

ind:accountingDate rdf:type rdf:Property ;
    rdfs:label 'Accounting Date' ;
    rdfs:comment 'The date on which this transaction is recognized in the general ledger and statutory accounts. May differ from transaction_date due to period-end cut-off adjustments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bordereauxStatus rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Status' ;
    rdfs:comment 'Tracks the submission lifecycle of this transaction in the reinsurance bordereaux process. Acknowledged by reinsurer confirms premium settlement; Disputed triggers reconciliation workflow.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Ceded Written Premium' ;
    rdfs:comment 'The portion of written premium transferred to the reinsurer under this cession. For QS treaties, equals GWP multiplied by the cession percentage. Core field for NWP and DPW calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cedingCommission rdf:type rdf:Property ;
    rdfs:label 'Ceding Commission' ;
    rdfs:comment 'Commission paid by the reinsurer to the cedant to offset acquisition and administrative costs. Expressed as a flat amount per transaction. Reduces the net cost of reinsurance.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionPercentage rdf:type rdf:Property ;
    rdfs:label 'Cession Percentage' ;
    rdfs:comment 'The percentage of the underlying risk ceded to the reinsurer under a quota share or surplus share treaty (e.g., 0.3000 = 30%). Null for XOL treaties where cession is event-triggered.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionType rdf:type rdf:Property ;
    rdfs:label 'Cession Type' ;
    rdfs:comment 'Indicates whether the ceded premium relates to a treaty arrangement, a facultative (FAC) placement, or a retrocession. Drives bordereaux format and Schedule F classification.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'Exchange rate used to convert foreign currency amounts to the cedant\'s functional reporting currency (USD). Applied as of the accounting_date for statutory reporting purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occurrenceReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Occurrence Reference Code' ;
    rdfs:comment 'Reference to the loss occurrence or catastrophe event that triggered a reinstatement premium. Populated only for transaction_type = Reinstatement. Links to the loss event record.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Policy Effective Date' ;
    rdfs:comment 'The date the underlying direct policy became effective. Used to assign the ceded premium to the correct policy year (PY) for actuarial and Schedule P/F reporting.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Policy Expiration Date' ;
    rdfs:comment 'The date the underlying direct policy expires. Used to calculate the unearned premium period and pro-rata earning of ceded premium over the policy term.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:profitCommission rdf:type rdf:Property ;
    rdfs:label 'Profit Commission' ;
    rdfs:comment 'Contingent commission earned by the cedant when the reinsurer\'s loss ratio on the treaty falls below a specified threshold. Booked as a reduction in net reinsurance cost.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatedLimit rdf:type rdf:Property ;
    rdfs:label 'Reinstated Limit' ;
    rdfs:comment 'The amount of treaty limit reinstated following a loss occurrence, for which the reinstatement_premium is charged. Applicable only when transaction_type = Reinstatement.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremium rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium' ;
    rdfs:comment 'Additional premium paid to the reinsurer to reinstate exhausted treaty limit following a loss occurrence. Applicable to XOL and CAT XL treaties. Linked to occurrence_reference_id.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency Amount' ;
    rdfs:comment 'Ceded written premium converted to the cedant\'s statutory reporting currency (USD) using the exchange_rate. Used for NAIC Annual Statement and Schedule F USD-denominated filings.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPremium rdf:type rdf:Property ;
    rdfs:label 'Return Premium' ;
    rdfs:comment 'Premium returned to the cedant from the reinsurer due to policy cancellation, mid-term endorsement reducing exposure, or audit adjustment. Negative impact on ceded written premium.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this transaction is a reversal of a previously posted reinsurance premium entry. True = reversal transaction. Used for audit trail and net premium reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Risk Effective Date' ;
    rdfs:comment 'The date from which the reinsurer\'s coverage obligation begins for this cession. May differ from policy_effective_date for mid-term facultative placements or endorsements.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Risk Expiration Date' ;
    rdfs:comment 'The date on which the reinsurer\'s coverage obligation ends for this cession. Used to determine the ceded unearned premium reserve at any balance sheet date.' ;
    rdfs:domain ind:RiPremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:treatyYear rdf:type rdf:Property ;
    rdfs:label 'Treaty Year' ;
    rdfs:comment 'The underwriting year of the reinsurance treaty under which this premium is ceded (e.g., 2024). Used for treaty-year loss ratio monitoring and bordereaux aggregation.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riClaimCessionId rdf:type rdf:Property ;
    rdfs:label 'Ri Claim Cession Id' ;
    rdfs:comment 'Unique surrogate primary key for the reinsurance claim cession record. One row per claim exposure per treaty layer or facultative agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiClaimCession .

ind:claimExposureId rdf:type rdf:Property ;
    rdfs:label 'Claim Exposure Id' ;
    rdfs:comment 'Reference to the claim exposure (coverage line within a claim) being ceded to the reinsurer. Links the cession to the specific coverage and insured risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimExposure .

ind:lossEventId rdf:type rdf:Property ;
    rdfs:label 'Loss Event Id' ;
    rdfs:comment 'Foreign key linking to claims.loss_event. Business justification: Per-occurrence treaty aggregation requires grouping all cessions under a single loss occurrence for hours-clause compliance and per-occurrence limit calculations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LossEvent .

ind:bordereauxSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Submission Date' ;
    rdfs:comment 'Date on which this cession record was included in a bordereaux submission to the reinsurer for loss recovery billing.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catEventCode rdf:type rdf:Property ;
    rdfs:label 'Cat Event Code' ;
    rdfs:comment 'Industry-standard catastrophe event code (e.g., ISO PCS serial number) identifying the CAT event for aggregation under CAT XL treaty layers.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Alae Amount' ;
    rdfs:comment 'Allocated Loss Adjustment Expense (ALAE) component of the ceded LAE, representing defense and cost containment (DCC) expenses ceded to the reinsurer.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLaeAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Lae Amount' ;
    rdfs:comment 'The portion of Loss Adjustment Expense (LAE) ceded to the reinsurer, including ALAE and applicable ULAE, per the treaty terms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Loss Amount' ;
    rdfs:comment 'The portion of the gross incurred loss ceded to the reinsurer under this agreement layer. Core financial metric for reinsurance recovery eligibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededPaidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Paid Loss Amount' ;
    rdfs:comment 'Cumulative loss payments already recovered from or billed to the reinsurer under this cession as of the reporting date.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Reserve Amount' ;
    rdfs:comment 'Outstanding case reserve amount ceded to the reinsurer for this claim exposure, representing the reinsurer\'s share of unpaid losses.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cessionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cession Effective Date' ;
    rdfs:comment 'Date on which this claim cession becomes effective under the reinsurance agreement, typically aligned with the loss date or treaty inception.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cessionStatus rdf:type rdf:Property ;
    rdfs:label 'Cession Status' ;
    rdfs:comment 'Current lifecycle state of the claim cession record within the reinsurance recovery workflow.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Description of the reason for a reinsurer dispute on this cession, if applicable. Populated when recovery_status is \'disputed\'.' ;
    rdfs:domain ind:Reinsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossLossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Loss Amount' ;
    rdfs:comment 'Total gross (pre-reinsurance) incurred loss amount for the claim exposure, including paid losses and outstanding reserves before any cession.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCatClaim rdf:type rdf:Property ;
    rdfs:label 'Is Cat Claim' ;
    rdfs:comment 'Indicates whether this claim cession is associated with a declared catastrophe event, triggering CAT XL treaty layer eligibility review.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:layerLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Layer Limit Amount' ;
    rdfs:comment 'Maximum reinsurance recovery available under this treaty layer for the ceded claim exposure. Defines the per-occurrence or per-risk limit.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:layerRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Layer Retention Amount' ;
    rdfs:comment 'The cedant\'s retained loss amount at the applicable treaty layer before reinsurance recovery applies. Represents the SIR or attachment point retention.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossDate rdf:type rdf:Property ;
    rdfs:label 'Loss Date' ;
    rdfs:comment 'Date of the underlying loss event that triggered the claim, used to determine which treaty year and layer applies for cession eligibility.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryBilledDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Billed Date' ;
    rdfs:comment 'Date on which the reinsurance recovery was formally billed to the reinsurer for this claim cession.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Received Date' ;
    rdfs:comment 'Date on which payment was received from the reinsurer for this cession, used for cash flow and Schedule F counterparty aging analysis.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Recovery Status' ;
    rdfs:comment 'Current status of the reinsurance recovery billing and collection process for this cession. Tracks progress from billing through settlement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceType rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Type' ;
    rdfs:comment 'Classification of the reinsurance structure: Quota Share (QS), Excess of Loss (XOL), Stop Loss (SL), CAT XL, or facultative variants. [ENUM-REF-CANDIDATE: quota_share|excess_of_loss|stop_loss|cat_xl|facultative_proportional|facultative_non_proportional —' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerParticipationPct rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Participation Pct' ;
    rdfs:comment 'The reinsurer\'s share of the treaty layer as a decimal (e.g., 0.5000 = 50%), used when multiple reinsurers participate in a single layer.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Date the claim was reported to the cedant, used for claims-made policy cession eligibility and IBNR bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rolRate rdf:type rdf:Property ;
    rdfs:label 'Rol Rate' ;
    rdfs:comment 'Rate on Line (ROL) applicable to this treaty layer, expressed as a decimal. Used for pricing analysis and reinsurance cost allocation.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unlAmount rdf:type rdf:Property ;
    rdfs:label 'Unl Amount' ;
    rdfs:comment 'Ultimate Net Loss (UNL) calculation basis for this cession, representing the net loss after salvage, subrogation, and other recoveries, used to determine XOL trigger.' ;
    rdfs:domain ind:RiClaimCession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoveryId rdf:type rdf:Property ;
    rdfs:label 'Ri Recovery Id' ;
    rdfs:comment 'Unique identifier for each reinsurance recovery financial movement. Primary key. Grain: one row per movement per cession per accounting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiRecovery .

ind:billedDate rdf:type rdf:Property ;
    rdfs:label 'Billed Date' ;
    rdfs:comment 'The date on which the recovery was billed to the reinsurer via bordereaux or facultative certificate.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:catCode rdf:type rdf:Property ;
    rdfs:label 'Cat Code' ;
    rdfs:comment 'Industry-standard catastrophe code (e.g., PCS number) identifying the catastrophic event.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededSharePercentage rdf:type rdf:Property ;
    rdfs:label 'Ceded Share Percentage' ;
    rdfs:comment 'The percentage of the underlying loss that is ceded to the reinsurer under the agreement (e.g., 50.00 for 50% quota share).' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectedAmount rdf:type rdf:Property ;
    rdfs:label 'Collected Amount' ;
    rdfs:comment 'The actual cash amount collected from the reinsurer, which may differ from the billed recovery amount due to disputes or adjustments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectedDate rdf:type rdf:Property ;
    rdfs:label 'Collected Date' ;
    rdfs:comment 'The date on which cash payment was received from the reinsurer for this recovery.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facultativeCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Facultative Certificate Number' ;
    rdfs:comment 'The certificate number for facultative reinsurance agreements, if applicable.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementDate rdf:type rdf:Property ;
    rdfs:label 'Movement Date' ;
    rdfs:comment 'The business date on which this recovery movement was recorded or effective.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:movementType rdf:type rdf:Property ;
    rdfs:label 'Movement Type' ;
    rdfs:comment 'Discriminator indicating the type of financial movement: reserve position (case/IBNR/LAE) or cash recovery (loss/LAE/DCC payment, subrogation, salvage). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outstandingAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Amount' ;
    rdfs:comment 'The amount of recovery still outstanding (billed but not yet collected) from the reinsurer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Type of payment for cash movements: loss (indemnity), LAE (loss adjustment expense), DCC (defense and cost containment), subrogation, salvage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount' ;
    rdfs:comment 'The gross amount of reinsurance recovery for this movement, in the policy currency. Positive for recoveries due from reinsurer, negative for adjustments or reversals.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount Usd' ;
    rdfs:comment 'The recovery amount converted to USD for statutory and consolidated reporting purposes.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Amount' ;
    rdfs:comment 'The amount of reinstatement premium payable to the reinsurer to restore coverage after a loss recovery.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementPremiumFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Premium Flag' ;
    rdfs:comment 'Boolean indicator (True/False) whether a reinstatement premium is due to the reinsurer as a result of this recovery.' ;
    rdfs:domain ind:RiRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveType rdf:type rdf:Property ;
    rdfs:label 'Reserve Type' ;
    rdfs:comment 'Type of reserve for reserve movements: case (reported loss), IBNR (incurred but not reported), LAE (loss adjustment expense), ULAE (unallocated LAE), ALAE (allocated LAE).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveId rdf:type rdf:Property ;
    rdfs:label 'Reserve Id' ;
    rdfs:comment 'Unique surrogate identifier for each reserve position record. One row per reserve type per claim exposure per accounting period. Grain: one reserve movement per claim exposure per period.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjusterId rdf:type rdf:Property ;
    rdfs:label 'Adjuster Id' ;
    rdfs:comment 'Reference to the adjuster who authorized or last modified this reserve position. Required for reserve authority and audit trail.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:approvedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Approved By Party Id' ;
    rdfs:comment 'Reference to the party (supervisor or manager) who approved this reserve movement when it exceeded adjuster authority limits. Null if no approval was required.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:financialTransactionId rdf:type rdf:Property ;
    rdfs:label 'Financial Transaction Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.financial_transaction. Business justification: Every reserve movement (case, IBNR, LAE) generates an atomic double-entry posting in financial_transaction.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialTransaction .

ind:litigationId rdf:type rdf:Property ;
    rdfs:label 'Litigation Id' ;
    rdfs:comment 'Foreign key linking to claims.litigation. Business justification: Litigation reserves are a distinct reserve category (reserve_category field confirms this) set when a claim enters suit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Litigation .

ind:riskexposureAutoRiskId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Auto Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.auto_risk. Business justification: Auto liability reserve adequacy benchmarking requires auto risk attributes (territory, use class, radius of operation) for actuarial development factor selection.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AutoRisk .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Date and time when the reserve movement was approved by the authorizing supervisor or manager. Null if no approval was required for this movement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorityLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Authority Limit Amount' ;
    rdfs:comment 'Maximum reserve amount the authorizing adjuster is permitted to set without escalation per the claims reserving authority matrix. Supports reserve governance and SOX controls.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basis rdf:type rdf:Property ;
    rdfs:label 'Basis' ;
    rdfs:comment 'Indicates whether the reserve amounts are stated on a Gross (before reinsurance), Net (after reinsurance), or Ceded (reinsurer share only) basis for this record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseReserveAdequacyFlag rdf:type rdf:Property ;
    rdfs:label 'Case Reserve Adequacy Flag' ;
    rdfs:comment 'Actuarial or supervisory assessment of whether the case reserve is adequate relative to the expected ultimate loss. Used in reserve review and ORSA reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catastropheIndicator rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Indicator' ;
    rdfs:comment 'Indicates whether this reserve is associated with a declared catastrophe event. Enables CAT vs. non-CAT reserve segregation for PML analysis and reinsurance recovery tracking.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveCategory rdf:type rdf:Property ;
    rdfs:label 'Reserve Category' ;
    rdfs:comment 'Broad financial category of the reserve: Loss (indemnity), Expense (LAE/DCC/AO), Salvage (anticipated recovery from salvage), or Subrogation (anticipated recovery from third parties).' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cededClosingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Closing Balance Amount' ;
    rdfs:comment 'Portion of the closing reserve balance ceded to reinsurers. Net reserve equals closing balance minus ceded closing balance. Required for Schedule F statutory reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededMovementAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Movement Amount' ;
    rdfs:comment 'Incremental change in the ceded reserve portion during the accounting period. Supports net reserve calculation and reinsurance bordereaux reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cededOpeningBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Opening Balance Amount' ;
    rdfs:comment 'Portion of the opening reserve balance ceded to reinsurers under applicable treaties or facultative agreements. Used for net reserve and Schedule F reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Closing Balance Amount' ;
    rdfs:comment 'Reserve balance at the end of the accounting period for this claim exposure and reserve type. Equals opening balance plus movement amount. Gross of reinsurance.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'Internal cost center to which this reserve is allocated for management accounting and expense reporting purposes. Supports departmental P&L and RBC capital allocation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:developmentPeriod rdf:type rdf:Property ;
    rdfs:label 'Development Period' ;
    rdfs:comment 'Number of months elapsed from the accident year start to the end of the accounting period. Used to position this reserve in the loss development triangle (e.g., 12, 24, 36 months).' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ibnrFactor rdf:type rdf:Property ;
    rdfs:label 'Ibnr Factor' ;
    rdfs:comment 'Actuarial development factor applied to derive the IBNR reserve component. Sourced from the actuarial reserving system loss development triangle for the applicable LOB and accident year.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'Methodology used to establish or update this reserve: Case_Estimate (adjuster judgment), Formula (system-calculated), Actuarial (actuarial model output), Bulk (portfolio-level), or Tabular (mortality/morbidity table).' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementAmount rdf:type rdf:Property ;
    rdfs:label 'Movement Amount' ;
    rdfs:comment 'Incremental change to the reserve during the accounting period. Positive value indicates reserve strengthening; negative value indicates reserve release. Gross of reinsurance.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:movementReasonCode rdf:type rdf:Property ;
    rdfs:label 'Movement Reason Code' ;
    rdfs:comment 'Coded reason for the reserve movement in this period (e.g., NEW_RESERVE, STRENGTHENING, PARTIAL_RELEASE, FULL_RELEASE, PAYMENT_OFFSET, REOPEN). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Movement Reason Description' ;
    rdfs:comment 'Free-text narrative provided by the adjuster or actuarial team explaining the basis for the reserve movement. Supports audit trail and reserve review documentation.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Opening Balance Amount' ;
    rdfs:comment 'Reserve balance carried forward from the prior accounting period for this claim exposure and reserve type. Starting point for the period movement calculation.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Amount' ;
    rdfs:comment 'Estimated reinsurance recoverable on this reserve position based on applicable treaty or facultative cession. Supports Schedule F reporting and net reserve calculation.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresSupervisorApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Supervisor Approval' ;
    rdfs:comment 'Indicates whether this reserve movement exceeded the adjuster authority limit and required supervisor or management approval before posting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveStatus rdf:type rdf:Property ;
    rdfs:label 'Reserve Status' ;
    rdfs:comment 'Current lifecycle state of the reserve position. Open reserves are active; Closed reserves have been fully settled or released; Reopened indicates a previously closed reserve reactivated.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageAnticipatedAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Anticipated Amount' ;
    rdfs:comment 'Estimated salvage recovery anticipated on this claim exposure. Reduces the net reserve position and is reported separately in NAIC statutory filings.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationAnticipatedAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Anticipated Amount' ;
    rdfs:comment 'Estimated subrogation recovery anticipated on this claim exposure. Reduces the net reserve position and is tracked separately for recovery management and statutory reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimPaymentId rdf:type rdf:Property ;
    rdfs:label 'Claim Payment Id' ;
    rdfs:comment 'Unique surrogate identifier for each claim payment disbursement record. Primary key. One row per payment per claim exposure per accounting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimPayment .

ind:claimPartyId rdf:type rdf:Property ;
    rdfs:label 'Claim Party Id' ;
    rdfs:comment 'System user ID of the claims examiner or supervisor who authorized this payment within the authority limit matrix.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:claimPayeePartyId rdf:type rdf:Property ;
    rdfs:label 'Claim Payee Party Id' ;
    rdfs:comment 'Reference to the Party record identifying the individual or organization receiving this payment (claimant, vendor, attorney, lienholder, loss payee).' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:claimantId rdf:type rdf:Property ;
    rdfs:label 'Claimant Id' ;
    rdfs:comment 'Foreign key linking to claims.claimant. Business justification: Settlement payments are issued to specific claimants. This FK enables per-claimant payment reconciliation, release-signed-date validation before disbursement, 1099 reporting at the claimant' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claimant .

ind:originalPaymentClaimPaymentId rdf:type rdf:Property ;
    rdfs:label 'Original Payment Claim Payment Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original payment record when this row represents a reissue or replacement. Null for original disbursements.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimPayment .

ind:payeeId rdf:type rdf:Property ;
    rdfs:label 'Payee Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.payee. Business justification: claim_payment carries denormalized payee_name and payee_tax_number that duplicate the authoritative claimfinancials.payee master record.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payee .

ind:apBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Ap Batch Number' ;
    rdfs:comment 'Identifier of the AP disbursement batch in which this payment was grouped for bank settlement. Used for batch reconciliation in Oracle/SAP AP module.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountCode rdf:type rdf:Property ;
    rdfs:label 'Bank Account Code' ;
    rdfs:comment 'Internal code identifying the company bank account from which the payment was funded. Supports multi-bank disbursement and reconciliation workflows.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkEftReference rdf:type rdf:Property ;
    rdfs:label 'Check Eft Reference' ;
    rdfs:comment 'Check number or EFT transaction reference issued by the bank or payment processor. Used for bank reconciliation and stop-payment processing.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'Date the payment instrument cleared the bank. Null until the check or EFT is confirmed settled. Used for outstanding check reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deductibleOffsetAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Offset Amount' ;
    rdfs:comment 'Amount of the payment attributable to the insured\'s deductible or Self-Insured Retention (SIR) that is to be collected back from the policyholder.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Payment Amount' ;
    rdfs:comment 'Total gross amount disbursed before any deductions, withholdings, or offsets. Denominated in the currency indicated by currency_code.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:is1099Reportable rdf:type rdf:Property ;
    rdfs:label 'Is 1099 Reportable' ;
    rdfs:comment 'Indicates whether this payment must be reported to the IRS on Form 1099-MISC or 1099-NEC. Drives year-end tax reporting extract.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFinalPayment rdf:type rdf:Property ;
    rdfs:label 'Is Final Payment' ;
    rdfs:comment 'Indicates this payment closes the claim exposure financially. When true, triggers reserve release and exposure closure workflow in ClaimCenter.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStructuredSettlement rdf:type rdf:Property ;
    rdfs:label 'Is Structured Settlement' ;
    rdfs:comment 'Indicates whether this payment is part of a structured settlement annuity arrangement rather than a lump-sum disbursement.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCategory rdf:type rdf:Property ;
    rdfs:label 'Loss Category' ;
    rdfs:comment 'Detailed loss sub-category classifying the nature of the payment: Bodily Injury (BI), Property Damage (PD), Medical Payments (MP), Uninsured Motorist (UM), etc.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Actual amount disbursed to the payee after withholding and deductions. Net = gross_payment_amount minus withholding_amount.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentAuthorizationCode rdf:type rdf:Property ;
    rdfs:label 'Payment Authorization Code' ;
    rdfs:comment 'Internal authorization or approval code assigned by the claims supervisor or authority matrix before payment release. Supports SOX payment controls.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Description' ;
    rdfs:comment 'Free-text narrative describing the purpose or nature of the payment (e.g., \'Partial settlement for dwelling damage\', \'Attorney fee disbursement\').' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Externally visible, human-readable payment reference number assigned by the claims payment system or AP module. Used for reconciliation and payee inquiries.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueDate rdf:type rdf:Property ;
    rdfs:label 'Reissue Date' ;
    rdfs:comment 'Date a replacement payment was reissued after a void or stop-payment. Links to the original payment via original_payment_id for audit trail.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceMemo rdf:type rdf:Property ;
    rdfs:label 'Remittance Memo' ;
    rdfs:comment 'Short memo line printed on the check or included in the EFT remittance advice to the payee. Typically includes claim number and coverage description.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateJurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction Code' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction governing this payment for regulatory reporting and state DOI compliance purposes.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Stop Payment Flag' ;
    rdfs:comment 'Indicates a stop-payment order has been placed on this check with the issuing bank. Triggers reissue workflow and outstanding check reconciliation.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'Date the payment was voided. Populated only when payment_status is Voided. Triggers reversal entries in the general ledger.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Amount' ;
    rdfs:comment 'Amount withheld from the gross payment for tax withholding, Medicare Set-Aside (MSA), or other statutory deductions before net disbursement.' ;
    rdfs:domain ind:ClaimPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryId rdf:type rdf:Property ;
    rdfs:label 'Recovery Id' ;
    rdfs:comment 'Unique surrogate identifier for each claim recovery transaction. One row per recovery transaction per claim exposure per accounting period.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attorneyOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Attorney Organization Id' ;
    rdfs:comment 'Foreign key linking to party.organization. Business justification: Recovery (salvage, subrogation, reinsurance) often involves legal counsel. Law firms are organizations requiring full party attribution for vendor management, payment processing, and' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:responsiblePartyId rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Id' ;
    rdfs:comment 'Reference to the party from whom recovery is sought: tortfeasor for subrogation, salvage buyer for salvage, or reinsurer for reinsurance recovery.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:salvageId rdf:type rdf:Property ;
    rdfs:label 'Salvage Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.salvage. Business justification: Recovery is the transaction record for collected amounts. Salvage is the master record for salvage activity.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Salvage .

ind:subrogationId rdf:type rdf:Property ;
    rdfs:label 'Subrogation Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.subrogation. Business justification: Recovery is the transaction record for collected amounts. Subrogation is the master record for a subrogation pursuit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Subrogation .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'Date on which the recovery file was formally closed, either after full collection, settlement, or abandonment of pursuit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Collection Expense Amount' ;
    rdfs:comment 'Costs incurred to pursue and collect the recovery, including attorney fees, court costs, and investigation expenses. Deducted to derive net recovery.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandAmount rdf:type rdf:Property ;
    rdfs:label 'Demand Amount' ;
    rdfs:comment 'Gross amount formally demanded from the responsible party or reinsurer. Represents the maximum expected recovery before negotiation or adjustment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandDate rdf:type rdf:Property ;
    rdfs:label 'Demand Date' ;
    rdfs:comment 'Date on which the formal demand for recovery was first issued to the responsible party, tortfeasor, or reinsurer.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'Net recovery amount after deducting collection expenses from collected amount. Used for statutory reporting and loss ratio calculations (NWP basis).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentReference rdf:type rdf:Property ;
    rdfs:label 'Payment Reference' ;
    rdfs:comment 'Check number, wire transfer reference, EFT trace number, or other payment instrument identifier for the collected recovery funds.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryType rdf:type rdf:Property ;
    rdfs:label 'Recovery Type' ;
    rdfs:comment 'Classifies the nature of the recovery: subrogation (pursuit of third-party tortfeasor), salvage (sale of damaged property), reinsurance (ceded loss recovery), or other.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riParticipationPct rdf:type rdf:Property ;
    rdfs:label 'Ri Participation Pct' ;
    rdfs:comment 'Percentage of the ceded loss recoverable from the reinsurer under the applicable treaty or facultative agreement (e.g., 0.7500 = 75%).' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riRecoveryBasis rdf:type rdf:Property ;
    rdfs:label 'Ri Recovery Basis' ;
    rdfs:comment 'Reinsurance structure under which the recovery is claimed: quota share (QS), excess of loss (XOL), stop loss (SL), or facultative (FAC).' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageItemDescription rdf:type rdf:Property ;
    rdfs:label 'Salvage Item Description' ;
    rdfs:comment 'Description of the salvaged property or item sold, including condition, make/model for vehicles, or material type for property salvage.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageType rdf:type rdf:Property ;
    rdfs:label 'Salvage Type' ;
    rdfs:comment 'Classification of salvage recovery: total loss vehicle, damaged property, scrap material, or auction proceeds. Applicable only when recovery_type is salvage.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statuteOfLimitationsDate rdf:type rdf:Property ;
    rdfs:label 'Statute Of Limitations Date' ;
    rdfs:comment 'Date by which legal action must be filed to preserve the right of recovery. Critical for subrogation diary management and SIU oversight.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationBasis rdf:type rdf:Property ;
    rdfs:label 'Subrogation Basis' ;
    rdfs:comment 'Legal theory under which subrogation is pursued: tort (negligence), contract (breach), statutory (workers comp lien), or equitable subrogation.' ;
    rdfs:domain ind:Recovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liablePartyId rdf:type rdf:Property ;
    rdfs:label 'Liable Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Subrogation pursues recovery from liable third parties who are tracked as party entities. Demand letters, settlement negotiations, and litigation require full party attribution including address' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:arbitrationAwardAmount rdf:type rdf:Property ;
    rdfs:label 'Arbitration Award Amount' ;
    rdfs:comment 'Dollar amount awarded by the arbitration panel in favor of the insurer. May differ from demand amount. Drives final collection and closure processing.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arbitrationFilingDate rdf:type rdf:Property ;
    rdfs:label 'Arbitration Filing Date' ;
    rdfs:comment 'Date the subrogation dispute was filed with the arbitration forum. Used to track filing deadlines and arbitration cycle times.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:arbitrationForum rdf:type rdf:Property ;
    rdfs:label 'Arbitration Forum' ;
    rdfs:comment 'Arbitration body used for intercompany dispute resolution. Arbitration Forums Inc. is standard for auto subrogation. Drives filing fee tracking and award enforcement.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureReason rdf:type rdf:Property ;
    rdfs:label 'Closure Reason' ;
    rdfs:comment 'Reason the subrogation pursuit was closed. Required for recovery analytics, SIU referral decisions, and regulatory reporting. [ENUM-REF-CANDIDATE: promote to reference product if values expand]' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectibleAmount rdf:type rdf:Property ;
    rdfs:label 'Collectible Amount' ;
    rdfs:comment 'Estimated collectible portion of the demand amount after applying comparative negligence, policy limits of the liable party, and asset assessment. Used for reserve adequacy.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuredReimbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Insured Reimbursement Amount' ;
    rdfs:comment 'Portion of the net recovery returned to the insured, typically representing their deductible or uninsured loss. Required by the made-whole doctrine in most jurisdictions.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'Date of the most recent action taken on the subrogation file (demand, payment received, court filing, etc.). Used for diary management and dormant file identification.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liablePartyClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Liable Party Claim Number' ;
    rdfs:comment 'Claim number assigned by the liable party\'s insurer for the same loss event. Enables cross-carrier reconciliation and arbitration tracking.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liablePartyInsurer rdf:type rdf:Property ;
    rdfs:label 'Liable Party Insurer' ;
    rdfs:comment 'Name of the insurance carrier for the liable third party. Used to route intercompany arbitration and direct demand letters to the correct carrier.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liablePartyPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Liable Party Policy Number' ;
    rdfs:comment 'Policy number of the liable third party\'s insurance coverage. Required for intercompany arbitration filings and demand correspondence.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:litigationStatus rdf:type rdf:Property ;
    rdfs:label 'Litigation Status' ;
    rdfs:comment 'Current stage of legal proceedings for the subrogation pursuit. Drives reserve adequacy reviews and legal expense forecasting. [ENUM-REF-CANDIDATE: promote to reference product if stages expand]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:madeWholeIndicator rdf:type rdf:Property ;
    rdfs:label 'Made Whole Indicator' ;
    rdfs:comment 'Indicates whether the insured has been fully compensated for their loss before the insurer may retain subrogation proceeds. Required by the made-whole doctrine in most states.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:negligencePct rdf:type rdf:Property ;
    rdfs:label 'Negligence Pct' ;
    rdfs:comment 'Percentage of fault attributed to the liable third party as determined by investigation or adjudication. Drives the collectible amount calculation under comparative negligence statutes.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Net Recovery Amount' ;
    rdfs:comment 'Net recovery after deducting recovery expenses from collected amount (collected_amount minus recovery_expense_amount). Represents the actual financial benefit to the insurer.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextActionDate rdf:type rdf:Property ;
    rdfs:label 'Next Action Date' ;
    rdfs:comment 'Diary date for the next required action on the subrogation file. Drives case management queues and ensures statute of limitations compliance.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openedDate rdf:type rdf:Property ;
    rdfs:label 'Opened Date' ;
    rdfs:comment 'Date the subrogation pursuit was formally opened in the claims management system. Used as the start point for cycle time and recovery lag analysis.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pursuitStatus rdf:type rdf:Property ;
    rdfs:label 'Pursuit Status' ;
    rdfs:comment 'Current workflow state of the subrogation pursuit. Drives case management queues and recovery reporting. [ENUM-REF-CANDIDATE: Open|Demand Issued|Negotiating|Settled|Collected|Closed - No Recovery|Referred to Litigation — promote to reference product]' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Expense Amount' ;
    rdfs:comment 'Total allocated expenses incurred in pursuing the subrogation recovery, including attorney fees, court costs, and investigation costs (DCC/ALAE). Deducted to compute net recovery.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Recovery Method' ;
    rdfs:comment 'Mechanism used to pursue the subrogation recovery. Intercompany Arbitration applies to auto claims under Arbitration Forum agreements. Drives legal cost allocation.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralDate rdf:type rdf:Property ;
    rdfs:label 'Referral Date' ;
    rdfs:comment 'Date the subrogation file was referred to outside counsel or a subrogation vendor for legal pursuit. Triggers DCC expense tracking and litigation status updates.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceRecoveryIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recovery Indicator' ;
    rdfs:comment 'Indicates whether a portion of the subrogation recovery must be remitted to reinsurers per cession agreements. Triggers reinsurance bordereaux reporting and recovery allocation.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount' ;
    rdfs:comment 'Agreed gross settlement amount with the liable party. May differ from demand amount due to negotiation, comparative negligence, or policy limits of the liable party.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'Date a settlement agreement was reached with the liable party or their insurer. Triggers final payment processing and closure of the subrogation pursuit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:siuReferralIndicator rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Indicator' ;
    rdfs:comment 'Indicates whether the subrogation file has been referred to the Special Investigations Unit (SIU) for fraud investigation related to the liable party or loss circumstances.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateOfLoss rdf:type rdf:Property ;
    rdfs:label 'State Of Loss' ;
    rdfs:comment 'Two-letter US state code where the loss occurred. Determines applicable subrogation statutes, comparative negligence rules, and statute of limitations periods.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationType rdf:type rdf:Property ;
    rdfs:label 'Subrogation Type' ;
    rdfs:comment 'Legal basis of the recovery action: Subrogation (insurer steps into insured\'s rights), Contribution (recovery from co-insurer), or Indemnification (contractual hold-harmless recovery).' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suitFiledDate rdf:type rdf:Property ;
    rdfs:label 'Suit Filed Date' ;
    rdfs:comment 'Date the subrogation lawsuit was filed in court. Marks the transition from pre-litigation to litigation phase and triggers enhanced reserve and expense tracking.' ;
    rdfs:domain ind:Subrogation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:buyerPartyId rdf:type rdf:Property ;
    rdfs:label 'Buyer Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Salvage buyers (auto auctions, scrap dealers) must be tracked as parties for 1099 tax reporting, OFAC screening, and fraud detection.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:riskexposurePropertyRiskId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Property Risk Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.property_risk. Business justification: Salvage teams coordinate property demolition, environmental remediation, and land sale with specific property characteristics.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PropertyRisk .

ind:riskexposureVehicleId rdf:type rdf:Property ;
    rdfs:label 'Riskexposure Vehicle Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.vehicle. Business justification: Salvage vendors require VIN, title number, and vehicle specifications for auction processing and title transfer.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:vendorPayeeId rdf:type rdf:Property ;
    rdfs:label 'Vendor Payee Id' ;
    rdfs:comment 'Foreign key linking to claimfinancials.payee. Business justification: Salvage has vendor_name and vendor_code (STRING) for the salvage vendor (auction house, salvage yard). Vendors are payees. Adding vendor_payee_id FK normalizes vendor master data.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payee .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date the salvage item was formally assigned to the salvage vendor or auction house for disposition.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auctionDate rdf:type rdf:Property ;
    rdfs:label 'Auction Date' ;
    rdfs:comment 'Date on which the salvaged item was auctioned or sold. Used to align proceeds recognition with the correct accounting period.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auctionFee rdf:type rdf:Property ;
    rdfs:label 'Auction Fee' ;
    rdfs:comment 'Fee charged by the auction house or salvage vendor for facilitating the sale, deducted from gross proceeds to arrive at net salvage.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionProceeds rdf:type rdf:Property ;
    rdfs:label 'Auction Proceeds' ;
    rdfs:comment 'Gross cash proceeds received from the auction or direct sale of the salvaged item before deducting storage, towing, and auction fees.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buyerType rdf:type rdf:Property ;
    rdfs:label 'Buyer Type' ;
    rdfs:comment 'Classification of the salvage buyer. Determines applicable title transfer rules and tax reporting obligations.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionMethod rdf:type rdf:Property ;
    rdfs:label 'Disposition Method' ;
    rdfs:comment 'Method by which the salvaged item is disposed of. Impacts net salvage calculation and title transfer obligations.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredRetainedIndicator rdf:type rdf:Property ;
    rdfs:label 'Insured Retained Indicator' ;
    rdfs:comment 'Indicates whether the insured elected to retain the salvaged item, resulting in a deduction from the total-loss settlement payment.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuredRetentionDeduction rdf:type rdf:Property ;
    rdfs:label 'Insured Retention Deduction' ;
    rdfs:comment 'Amount deducted from the total-loss settlement when the insured elects to retain the salvaged item, equal to the salvage value estimate.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:itemDescription rdf:type rdf:Property ;
    rdfs:label 'Item Description' ;
    rdfs:comment 'Free-text description of the salvaged item including make, model, year, condition, or property type to support valuation and disposition.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netSalvageAmount rdf:type rdf:Property ;
    rdfs:label 'Net Salvage Amount' ;
    rdfs:comment 'Net proceeds from salvage after deducting storage, towing, and auction fees from gross auction proceeds. Credited against claim payments.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceRecoverableIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Indicator' ;
    rdfs:comment 'Indicates whether a portion of the net salvage proceeds is recoverable by or creditable to a reinsurer under treaty or facultative agreement.' ;
    rdfs:domain ind:Claimfinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceSalvageShare rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Salvage Share' ;
    rdfs:comment 'Portion of net salvage proceeds attributable to reinsurers under applicable treaty or facultative agreement, per SSAP No. 62R.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salvageStatus rdf:type rdf:Property ;
    rdfs:label 'Salvage Status' ;
    rdfs:comment 'Current lifecycle state of the salvage activity. Drives workflow in ClaimCenter Recovery module and financial recognition timing.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageCost rdf:type rdf:Property ;
    rdfs:label 'Storage Cost' ;
    rdfs:comment 'Cumulative cost of storing the salvaged item from date of loss to date of disposition, deducted from gross proceeds.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageEndDate rdf:type rdf:Property ;
    rdfs:label 'Storage End Date' ;
    rdfs:comment 'Date the salvaged item was removed from storage upon sale, transfer, or destruction.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'Address or facility name where the salvaged item is stored pending auction or disposition.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageStartDate rdf:type rdf:Property ;
    rdfs:label 'Storage Start Date' ;
    rdfs:comment 'Date the salvaged item entered storage, used to calculate accrued storage costs and vendor billing.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleNumber rdf:type rdf:Property ;
    rdfs:label 'Title Number' ;
    rdfs:comment 'State-issued salvage title number assigned to the vehicle or property after total-loss declaration, required for legal resale.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Title Received Date' ;
    rdfs:comment 'Date the insurer physically received the signed title document from the insured, initiating the transfer process.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleTransferDate rdf:type rdf:Property ;
    rdfs:label 'Title Transfer Date' ;
    rdfs:comment 'Date on which the title of the salvaged item was legally transferred from the insured to the insurer or designated buyer.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleTransferStatus rdf:type rdf:Property ;
    rdfs:label 'Title Transfer Status' ;
    rdfs:comment 'Status of the vehicle or property title transfer from the insured to the insurer or salvage buyer. Required for total-loss compliance.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLossIndicator rdf:type rdf:Property ;
    rdfs:label 'Total Loss Indicator' ;
    rdfs:comment 'Indicates whether the insured item was declared a total loss, triggering full salvage disposition and title transfer requirements.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:towingCost rdf:type rdf:Property ;
    rdfs:label 'Towing Cost' ;
    rdfs:comment 'Cost of towing or transporting the salvaged item to the storage yard or auction facility, deducted from gross proceeds.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueEstimate rdf:type rdf:Property ;
    rdfs:label 'Value Estimate' ;
    rdfs:comment 'Appraised or estimated market value of the salvaged item prior to auction or sale, used to set reserve and evaluate offers.' ;
    rdfs:domain ind:Salvage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vin rdf:type rdf:Property ;
    rdfs:label 'Vin' ;
    rdfs:comment '17-character Vehicle Identification Number for salvaged vehicles, used for title transfer, DMV reporting, and CLUE database updates.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimExpenseId rdf:type rdf:Property ;
    rdfs:label 'Claim Expense Id' ;
    rdfs:comment 'Unique surrogate identifier for each claim expense transaction record. Primary key for the claim_expense table. One row per expense movement per claim exposure and accounting period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimExpense .

ind:originalExpenseClaimExpenseId rdf:type rdf:Property ;
    rdfs:label 'Original Expense Claim Expense Id' ;
    rdfs:comment 'For reversal transactions, references the claim_expense_id of the original expense being reversed. Null for original (non-reversal) expense transactions.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimExpense .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Approval workflow status for the expense. Expenses above authority thresholds require supervisor or management approval before payment can be issued.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'Check or EFT reference number issued for payment of this expense. Used for bank reconciliation and positive pay verification. Null for non-check payments.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Amount' ;
    rdfs:comment 'Gross amount of the expense transaction in the policy currency before any adjustments or recoveries. Positive for charges; negative for reversals or credits.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseDate rdf:type rdf:Property ;
    rdfs:label 'Expense Date' ;
    rdfs:comment 'The date on which the expense was incurred or the service was rendered. Used for accident-year and policy-year LAE allocation in Schedule P reporting.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenseDescription rdf:type rdf:Property ;
    rdfs:label 'Expense Description' ;
    rdfs:comment 'Free-text description of the services rendered or expense incurred as provided by the adjuster or vendor. Used for audit review and dispute resolution.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseNumber rdf:type rdf:Property ;
    rdfs:label 'Expense Number' ;
    rdfs:comment 'Externally visible, human-readable identifier for this expense transaction. Used in vendor correspondence, GL postings, and audit trails.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseStatus rdf:type rdf:Property ;
    rdfs:label 'Expense Status' ;
    rdfs:comment 'Current workflow state of the expense transaction from initial entry through approval, payment, and potential voiding or dispute resolution.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseType rdf:type rdf:Property ;
    rdfs:label 'Expense Type' ;
    rdfs:comment 'Detailed classification of the nature of the expense. Drives GL account mapping and regulatory cost categorization. [ENUM-REF-CANDIDATE: legal_fee|expert_witness|medical_exam|investigation|appraisal|court_cost|adjuster_fee|other — promote to reference' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Amount' ;
    rdfs:comment 'Expense amount converted to the company functional currency (USD) using the exchange rate at transaction date. Used for consolidated statutory and GAAP reporting.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'Date printed on the vendor invoice. Used for accounts payable aging, payment terms calculation, and late-payment penalty assessment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'The invoice or billing reference number issued by the vendor. Used for three-way matching (PO, receipt, invoice) and duplicate payment prevention.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Received Date' ;
    rdfs:comment 'Date the invoice was received by the claims department. Used to measure vendor billing timeliness and trigger payment due-date calculations.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isDccExpense rdf:type rdf:Property ;
    rdfs:label 'Is Dcc Expense' ;
    rdfs:comment 'Indicates whether this expense is classified as Defense and Cost Containment (DCC) per NAIC Schedule P definitions. Distinct from AO (Adjusting and Other) expenses.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecoverable rdf:type rdf:Property ;
    rdfs:label 'Is Recoverable' ;
    rdfs:comment 'Indicates whether this expense is subject to reinsurance recovery under a treaty or facultative agreement. Drives cession and bordereaux reporting.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laeCategory rdf:type rdf:Property ;
    rdfs:label 'Lae Category' ;
    rdfs:comment 'Classifies the expense into LAE sub-categories: ALAE (Allocated LAE), ULAE (Unallocated LAE), DCC (Defense and Cost Containment), or AO (Adjusting and Other). Required for Schedule P.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceEndDate rdf:type rdf:Property ;
    rdfs:label 'Service End Date' ;
    rdfs:comment 'End date of the service period covered by this expense. Together with service_start_date defines the billing period for period-based vendor engagements.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceStartDate rdf:type rdf:Property ;
    rdfs:label 'Service Start Date' ;
    rdfs:comment 'Start date of the service period covered by this expense (e.g., legal retainer period, expert engagement). Used for period-based expense accrual.' ;
    rdfs:domain ind:ClaimExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorPeriodClaimfinancialsAccountingPeriodId rdf:type rdf:Property ;
    rdfs:label 'Prior Period Claimfinancials Accounting Period Id' ;
    rdfs:comment 'Reference to the immediately preceding accounting period. Supports period-over-period variance analysis, loss triangle chaining, and reserve roll-forward calculations.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccountingPeriod .

ind:bordereauxPeriodCode rdf:type rdf:Property ;
    rdfs:label 'Bordereaux Period Code' ;
    rdfs:comment 'Period code used in reinsurance bordereaux submissions to treaty reinsurers. Aligns cession, premium, and loss data to the reinsurer\'s reporting calendar.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calendarYear rdf:type rdf:Property ;
    rdfs:label 'Calendar Year' ;
    rdfs:comment 'Four-digit calendar year (January–December). Used for CY loss ratio, CY written premium, and CY combined ratio analytics per NAIC Schedule P.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeDate rdf:type rdf:Property ;
    rdfs:label 'Close Date' ;
    rdfs:comment 'Date on which the accounting period was officially closed (soft close). After this date, new transactions require a journal entry adjustment or period reopening.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Last calendar date included in this accounting period (inclusive). Transactions with an effective date on or before this date fall within the period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fiscalMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Month' ;
    rdfs:comment 'Month number (1–12) within the fiscal year. Used for monthly close cycles, premium booking, and loss reserve movements in the GL.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'Quarter number (1–4) within the fiscal year. Used for quarterly statutory filings, NAIC quarterly statements, and interim GAAP reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'Four-digit fiscal year to which this period belongs (e.g., 2024). Aligns with the company\'s statutory and GAAP reporting year.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fxRateToUsd rdf:type rdf:Property ;
    rdfs:label 'Fx Rate To Usd' ;
    rdfs:comment 'Exchange rate to USD applicable for this period\'s financial translations. Used for multi-currency consolidation in statutory and GAAP reporting.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glPeriodCode rdf:type rdf:Property ;
    rdfs:label 'Gl Period Code' ;
    rdfs:comment 'Period code as defined in the General Ledger system (Oracle/SAP). Used to reconcile premium, loss, and expense transactions between the data warehouse and the GL.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ifrs17ReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Ifrs17 Reporting Period' ;
    rdfs:comment 'Period identifier as used in IFRS 17 insurance contract reporting (e.g., \'2024-Q1\'). Supports CSM amortization, loss component tracking, and IFRS 17 disclosure requirements.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isQuarterEnd rdf:type rdf:Property ;
    rdfs:label 'Is Quarter End' ;
    rdfs:comment 'True if this period is the last month of a fiscal quarter, triggering quarterly NAIC statement preparation and interim GAAP reporting.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStubPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Stub Period' ;
    rdfs:comment 'True if this period is a partial period (fewer days than a standard month), such as a company formation period or mid-year fiscal year change.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isYearEnd rdf:type rdf:Property ;
    rdfs:label 'Is Year End' ;
    rdfs:comment 'True if this period represents the final period of the fiscal or calendar year, triggering year-end statutory close, NAIC Annual Statement preparation, and RBC calculations.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockDate rdf:type rdf:Property ;
    rdfs:label 'Lock Date' ;
    rdfs:comment 'Date on which the period was hard-locked, preventing any further postings. Supports SOX controls and statutory filing integrity.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossDevelopmentLag rdf:type rdf:Property ;
    rdfs:label 'Loss Development Lag' ;
    rdfs:comment 'Number of months elapsed from the accident year start to this period\'s end date. Used to position the period on loss development triangles for IBNR and IBNER estimation.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:naicStatementPeriod rdf:type rdf:Property ;
    rdfs:label 'Naic Statement Period' ;
    rdfs:comment 'NAIC filing period designation: Q1, Q2, Q3 for quarterly statements, or ANNUAL for the year-end NAIC Annual Statement. Drives statutory reporting schedules.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodBasis rdf:type rdf:Property ;
    rdfs:label 'Period Basis' ;
    rdfs:comment 'Actuarial and statutory basis: CY (Calendar Year), AY (Accident Year), PY (Policy Year), or FY (Fiscal Year). Drives loss triangle bucketing and Schedule P reporting.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodCode rdf:type rdf:Property ;
    rdfs:label 'Period Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the period (e.g., CY-2024-03 for calendar year 2024 March). Used in GL, statutory, and bordereaux reporting.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodDays rdf:type rdf:Property ;
    rdfs:label 'Period Days' ;
    rdfs:comment 'Number of calendar days in this accounting period. Used for daily pro-rata premium earning, exposure day calculations, and IFRS 17 coverage unit computations.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Human-readable label for the period (e.g., \'March 2024\', \'Q1 2024\', \'AY 2023\'). Used in reports, dashboards, and statutory filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodStatus rdf:type rdf:Property ;
    rdfs:label 'Period Status' ;
    rdfs:comment 'Current state of the period in the financial close lifecycle: OPEN (transactions posting), CLOSED (soft close), LOCKED (hard close, no further postings), REOPENED (adjustment window).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Granularity of the period: MONTHLY for standard close cycles, QUARTERLY for interim reporting, SEMI_ANNUAL, or ANNUAL for year-end statutory filings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumEarningMethod rdf:type rdf:Property ;
    rdfs:label 'Premium Earning Method' ;
    rdfs:comment 'Method used to earn written premium into earned premium during this period: PRO_RATA (daily pro-rata), RULE_OF_78, DAILY, or MONTHLY. Drives UEP and EP calculations.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reopenDate rdf:type rdf:Property ;
    rdfs:label 'Reopen Date' ;
    rdfs:comment 'Date on which a previously closed or locked period was reopened for adjustment postings. Null if the period has never been reopened.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingFramework rdf:type rdf:Property ;
    rdfs:label 'Reporting Framework' ;
    rdfs:comment 'Accounting framework under which this period is reported: SAP (Statutory Accounting Principles), GAAP (US GAAP/FASB), IFRS17 (IASB IFRS 17), or STATUTORY for state-specific filings.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulePPeriodLabel rdf:type rdf:Property ;
    rdfs:label 'Schedule P Period Label' ;
    rdfs:comment 'Label used to identify this period on NAIC Schedule P loss development exhibits (e.g., \'2024 1 Year\', \'2023 2 Years\'). Supports actuarial reserving and regulatory filing.' ;
    rdfs:domain ind:AccountingPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'First calendar date included in this accounting period. Transactions with an effective date on or after this date fall within the period.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalTransactionFinancialTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Financial Transaction Id' ;
    rdfs:comment 'For reversal or correction transactions, references the original financial_transaction_id that this entry offsets or corrects. Null for original (non-reversal) postings.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialTransaction .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Reference to the associated claim payment record when this financial transaction represents a disbursement. Links the GL posting to the payment instrument record for reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:cededAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Amount' ;
    rdfs:comment 'Portion of the gross amount ceded to reinsurers under applicable treaty or facultative agreements. Used for net retained loss calculation and reinsurance bordereaux reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Current Balance Amount' ;
    rdfs:comment 'The reserve or financial balance on the claim exposure immediately after this transaction was applied. Supports outstanding loss reserve (OSLR) and IBNR reporting.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseCategory rdf:type rdf:Property ;
    rdfs:label 'Expense Category' ;
    rdfs:comment 'For expense-type transactions, classifies the LAE component: DCC (Defense and Cost Containment), AO (Adjusting and Other), ULAE (Unallocated Loss Adjustment Expense). Null for non-expense transactions.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Amount' ;
    rdfs:comment 'The full gross monetary amount of this financial posting before any reinsurance, deductible, or offset adjustments. Positive for charges/losses; negative for recoveries/credits.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'Date and time when this financial transaction was posted to the general ledger and claims system. Used for audit trail and reconciliation with GL batch runs.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priorBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Balance Amount' ;
    rdfs:comment 'The reserve or financial balance on the claim exposure immediately before this transaction was applied. Enables incremental change analysis and reserve development tracking.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Indicates whether this transaction is a reversal (offsetting entry) of a previously posted financial transaction. True if this is a correcting reversal entry.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionDescription rdf:type rdf:Property ;
    rdfs:label 'Transaction Description' ;
    rdfs:comment 'Free-text narrative describing the reason for or nature of this financial posting (e.g., \'Initial case reserve set at FNOL\', \'Partial indemnity payment to claimant\'). Supports adjuster notes.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionSubtype rdf:type rdf:Property ;
    rdfs:label 'Transaction Subtype' ;
    rdfs:comment 'Granular classification within the transaction type. Examples: CASE_RESERVE, IBNR_RESERVE, LAE_RESERVE, INDEMNITY_PAYMENT, MEDICAL_PAYMENT, SUBROGATION_RECOVERY, SALVAGE_RECOVERY, REINSURANCE_RECOVERY, DCC_EXPENSE, AO_EXPENSE.' ;
    rdfs:domain ind:FinancialTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceRecoveryId rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recovery Id' ;
    rdfs:comment 'Unique surrogate identifier for each reinsurance recovery billing record. One row per reinsurance recovery billing per claim exposure and treaty or facultative agreement.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReinsuranceRecovery .

ind:authorizedControlLevelFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Control Level Flag' ;
    rdfs:comment 'Indicates whether the reinsurer is an authorized (admitted) reinsurer for statutory credit purposes, affecting RBC and Schedule F treatment.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingDate rdf:type rdf:Property ;
    rdfs:label 'Billing Date' ;
    rdfs:comment 'The date on which the reinsurance recovery was billed to the reinsurer. Principal business event date for this transaction.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cashCallIndicator rdf:type rdf:Property ;
    rdfs:label 'Cash Call Indicator' ;
    rdfs:comment 'Indicates whether this recovery was billed as an interim cash call to the reinsurer prior to final claim settlement, as permitted under large-loss provisions.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralHeldAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Held Amount' ;
    rdfs:comment 'Amount of collateral (letters of credit, trust funds) held from the reinsurer that can be applied against this outstanding recovery balance.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionDate rdf:type rdf:Property ;
    rdfs:label 'Collection Date' ;
    rdfs:comment 'The date on which the recovery amount was actually received from the reinsurer. Null if not yet collected.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commutationIndicator rdf:type rdf:Property ;
    rdfs:label 'Commutation Indicator' ;
    rdfs:comment 'Flags whether this recovery record has been settled via a commutation agreement, extinguishing future obligations between cedant and reinsurer.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysOverdue rdf:type rdf:Property ;
    rdfs:label 'Days Overdue' ;
    rdfs:comment 'Number of calendar days the outstanding recovery balance has been past the contractual due date. Used for Schedule F aging buckets and credit risk monitoring.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disputedAmount rdf:type rdf:Property ;
    rdfs:label 'Disputed Amount' ;
    rdfs:comment 'Portion of the billed recovery amount that the reinsurer has formally disputed. Tracked separately for collections and reserving purposes.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Contractual due date by which the reinsurer is obligated to remit the recovery amount per the reinsurance agreement terms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'Unpaid balance owed by the reinsurer, calculated as recovery billed minus recovery collected. Used for Schedule F overdue reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdueIndicator rdf:type rdf:Property ;
    rdfs:label 'Overdue Indicator' ;
    rdfs:comment 'Flags recoveries where the outstanding balance has exceeded the contractual due date. Drives NAIC Schedule F overdue reinsurance reporting.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryBilledAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Billed Amount' ;
    rdfs:comment 'Total amount billed to the reinsurer for this recovery, combining ceded loss and ceded LAE. Represents the gross recovery claim submitted.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryCollectedAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Collected Amount' ;
    rdfs:comment 'Actual amount received from the reinsurer to date. May be less than billed if partial payment or dispute exists.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryNumber rdf:type rdf:Property ;
    rdfs:label 'Recovery Number' ;
    rdfs:comment 'Externally-known business identifier for this recovery billing, used in bordereaux reporting and reinsurer correspondence. Assigned by the Reinsurance Management System.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsurerLimit rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Limit' ;
    rdfs:comment 'Maximum amount the reinsurer is obligated to pay under the applicable treaty layer or facultative certificate for this claim.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementReference rdf:type rdf:Property ;
    rdfs:label 'Settlement Reference' ;
    rdfs:comment 'Reference number of the reinsurance settlement or cash call under which this recovery was remitted by the reinsurer.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenOffAmount rdf:type rdf:Property ;
    rdfs:label 'Written Off Amount' ;
    rdfs:comment 'Amount of the recovery deemed uncollectible and written off, typically due to reinsurer insolvency or commutation agreement.' ;
    rdfs:domain ind:ReinsuranceRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredCurrencyId rdf:type rdf:Property ;
    rdfs:label 'Preferred Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: International payee management requires currency master for payment processing in payee\'s preferred currency, withholding tax calculation, bank account validation, and 1099/tax reporting.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:attorneyBarNumber rdf:type rdf:Property ;
    rdfs:label 'Attorney Bar Number' ;
    rdfs:comment 'State bar license number for payees classified as attorneys. Used to validate attorney payees in ClaimCenter and supports regulatory reporting of legal expense payments.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backupWithholdingFlag rdf:type rdf:Property ;
    rdfs:label 'Backup Withholding Flag' ;
    rdfs:comment 'Indicates whether the payee is subject to IRS backup withholding (currently 24%). Set when TIN is missing, unverified, or IRS notifies the payer of withholding obligation.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number' ;
    rdfs:comment 'Payee\'s bank account number for EFT/ACH disbursements. Stored in tokenized or encrypted form per PCI DSS and GLBA requirements. Required when payment_method is EFT or wire.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountType rdf:type rdf:Property ;
    rdfs:label 'Bank Account Type' ;
    rdfs:comment 'Type of bank account used for EFT disbursements: checking or savings. Required by NACHA for ACH transaction formatting and return code handling.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'Name of the financial institution holding the payee\'s account. Used for EFT remittance documentation and payment reconciliation in the General Ledger.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'ABA routing transit number (9 digits) identifying the payee\'s financial institution for ACH/EFT transactions. Required when payment_method is EFT or wire.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotPayFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Pay Flag' ;
    rdfs:comment 'Hard stop flag that prevents any payment from being issued to this payee. Set by compliance, SIU, or legal hold. Overrides all payment authorizations until manually cleared.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:email rdf:type rdf:Property ;
    rdfs:label 'Email' ;
    rdfs:comment 'Primary email address for the payee. Used for EFT remittance advice delivery, payment notifications, and electronic 1099 delivery where consent is obtained.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guardianName rdf:type rdf:Property ;
    rdfs:label 'Guardian Name' ;
    rdfs:comment 'Full legal name of the court-appointed guardian or conservator when the payee is a minor or legally incapacitated. Payments are issued in the guardian\'s name on behalf of the payee.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMinor rdf:type rdf:Property ;
    rdfs:label 'Is Minor' ;
    rdfs:comment 'Indicates whether the payee is a minor (under 18). Triggers guardian/conservator payment controls, court approval requirements, and special handling in ClaimCenter payment workflows.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lienHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Lien Holder Flag' ;
    rdfs:comment 'Indicates whether the payee holds a lien or security interest on the insured property. When true, the payee must be co-payee on property damage payments per standard mortgage/lien clauses.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payeeName rdf:type rdf:Property ;
    rdfs:label 'Payee Name' ;
    rdfs:comment 'Full legal name of the payee as it must appear on the payment instrument (check or EFT). For individuals this is the legal name; for entities the registered business name.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeStatus rdf:type rdf:Property ;
    rdfs:label 'Payee Status' ;
    rdfs:comment 'Current lifecycle state of the payee record. Blocked payees cannot receive payments until cleared by SIU or compliance review. Drives payment eligibility checks in ClaimCenter.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeType rdf:type rdf:Property ;
    rdfs:label 'Payee Type' ;
    rdfs:comment 'Classifies the payee\'s role in the payment transaction. Drives 1099 reporting rules, authority limits, and payment workflow routing within ClaimCenter.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phone rdf:type rdf:Property ;
    rdfs:label 'Phone' ;
    rdfs:comment 'Primary contact phone number for the payee. Used for payment confirmation, returned check follow-up, and EFT pre-notification as required by NACHA rules.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdVerified rdf:type rdf:Property ;
    rdfs:label 'Tax Id Verified' ;
    rdfs:comment 'Indicates whether the payee\'s TIN has been validated against IRS TIN Matching or equivalent verification service. Required before issuing 1099 forms.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Number' ;
    rdfs:comment 'Federal tax identifier for the payee: Social Security Number (SSN) for individuals or Federal Employer Identification Number (FEIN) for organizations. Required for IRS 1099 reporting.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCode rdf:type rdf:Property ;
    rdfs:label 'Vendor Code' ;
    rdfs:comment 'Internal vendor identifier assigned by the Accounts Payable system (Oracle/SAP) for payees classified as vendors (e.g., repair shops, medical providers, appraisers). Enables AP reconciliation.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:w9Received rdf:type rdf:Property ;
    rdfs:label 'W9 Received' ;
    rdfs:comment 'Indicates whether a completed IRS Form W-9 (Request for Taxpayer Identification Number and Certification) has been received from the payee. Required before releasing payments subject to backup withholding.' ;
    rdfs:domain ind:Payee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationId rdf:type rdf:Property ;
    rdfs:label 'Location Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.location. Business justification: Commercial lines CAT accumulation reports and exposure management aggregate written/earned premium by insured location.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:originalTransactionPremiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Premium Transaction Id' ;
    rdfs:comment 'Reference to the original premium transaction that this record reverses or corrects. Populated only when reversal_indicator is True. Supports audit trail.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumTransaction .

ind:quoteId rdf:type rdf:Property ;
    rdfs:label 'Quote Id' ;
    rdfs:comment 'Foreign key linking to coverage.quote. Business justification: Premium transactions originate from bound quotes; accounting audit trail requires quote reference for rate reconciliation, variance analysis between quoted and booked premium, and' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Quote .

ind:rateTableId rdf:type rdf:Property ;
    rdfs:label 'Rate Table Id' ;
    rdfs:comment 'Foreign key linking to premium.rate_table. Business justification: Links each premium transaction to the versioned rate table used to price it, enabling audit of which rate filing, base rate, and algorithm produced the written premium.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateTable .

ind:auditBasis rdf:type rdf:Property ;
    rdfs:label 'Audit Basis' ;
    rdfs:comment 'Exposure basis used for auditable policies (e.g., WC, CGL) to determine final earned premium: Payroll, Revenue, Units, Receipts, or None for non-auditable policies.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysInForce rdf:type rdf:Property ;
    rdfs:label 'Days In Force' ;
    rdfs:comment 'Number of days the coverage was in force during the accounting period for this premium transaction. Used in pro-rata earning and exposure calculations.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:directBilledIndicator rdf:type rdf:Property ;
    rdfs:label 'Direct Billed Indicator' ;
    rdfs:comment 'Indicates whether this premium is billed directly to the policyholder (True) or through the producer/agency (False = agency billed). Drives billing workflow routing.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earnedPremium rdf:type rdf:Property ;
    rdfs:label 'Earned Premium' ;
    rdfs:comment 'Portion of written premium recognized as earned for the accounting period based on pro-rata or other earning methodology. Core input to loss ratio (LR) calculation.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earningMethod rdf:type rdf:Property ;
    rdfs:label 'Earning Method' ;
    rdfs:comment 'Method used to recognize written premium as earned over the policy period: Pro-Rata (daily), 1/365, 1/24 (monthly), Flat (fully earned at inception), or Other.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementType rdf:type rdf:Property ;
    rdfs:label 'Endorsement Type' ;
    rdfs:comment 'Type of endorsement premium adjustment: Additional (increase), Return (decrease/credit), Flat (no change), Audit (audit-based adjustment), or None for non-endorsement transactions.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureAmount rdf:type rdf:Property ;
    rdfs:label 'Exposure Amount' ;
    rdfs:comment 'Quantitative exposure measure (e.g., payroll dollars, vehicle count, property TIV) underlying the premium calculation. Used for rate adequacy and actuarial analysis.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netWrittenPremium rdf:type rdf:Property ;
    rdfs:label 'Net Written Premium' ;
    rdfs:comment 'Written premium net of reinsurance cessions. NWP = GWP minus ceded written premium. Used for net retention reporting and RBC calculations.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanCode rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Code' ;
    rdfs:comment 'Code identifying the installment or payment plan under which this premium is billed (e.g., Annual, Semi-Annual, Quarterly, Monthly, Pay-As-You-Go).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proRataFactor rdf:type rdf:Property ;
    rdfs:label 'Pro Rata Factor' ;
    rdfs:comment 'Decimal factor (0.0 to 1.0) representing the proportion of the policy period elapsed as of the accounting period end date. Used to compute earned premium.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rate rdf:type rdf:Property ;
    rdfs:label 'Rate' ;
    rdfs:comment 'The rate applied to the exposure base to calculate the premium for this transaction. Expressed per unit of exposure (e.g., per $100 payroll, per $1000 TIV).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Effective Date' ;
    rdfs:comment 'Date on which the rate used for this premium transaction became effective. Required for rate adequacy monitoring and DOI rate filing compliance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unearnedPremium rdf:type rdf:Property ;
    rdfs:label 'Unearned Premium' ;
    rdfs:comment 'Portion of written premium not yet earned as of the accounting period end date. Represents the UEP reserve liability on the balance sheet.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeId rdf:type rdf:Property ;
    rdfs:label 'Charge Id' ;
    rdfs:comment 'Unique identifier for the charge component within a premium transaction.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Charge .

ind:driverId rdf:type rdf:Property ;
    rdfs:label 'Driver Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.driver. Business justification: Personal auto point surcharges, defensive driving credits, and good-student discounts are booked as named charges attributed to a specific driver.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Driver .

ind:vehicleId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.vehicle. Business justification: Commercial auto policies apply per-vehicle charges such as safety equipment credits, anti-theft discounts, and radius-of-operation surcharges.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'Monetary value of the charge component in the policy currency.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basisAmount rdf:type rdf:Property ;
    rdfs:label 'Basis Amount' ;
    rdfs:comment 'Base amount to which the charge rate is applied to derive the charge amount.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeCategory rdf:type rdf:Property ;
    rdfs:label 'Charge Category' ;
    rdfs:comment 'High-level category of the charge: premium, fee, penalty, refund, or adjustment.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeStatus rdf:type rdf:Property ;
    rdfs:label 'Charge Status' ;
    rdfs:comment 'Current lifecycle status of the charge: active, voided, reversed, adjusted, or pending.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeType rdf:type rdf:Property ;
    rdfs:label 'Charge Type' ;
    rdfs:comment 'Classification of the charge component: base premium, surcharge, credit, discount, minimum premium, flat charge, or adjustment. [ENUM-REF-CANDIDATE: base_premium|surcharge|credit|discount|minimum_premium|flat_charge|adjustment — 7 candidates stripped' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Amount' ;
    rdfs:comment 'Commission amount payable to the producer based on this charge, if commissionable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeDescription rdf:type rdf:Property ;
    rdfs:label 'Charge Description' ;
    rdfs:comment 'Detailed business description of the charge component and its purpose.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCeded rdf:type rdf:Property ;
    rdfs:label 'Is Ceded' ;
    rdfs:comment 'Indicates whether this charge is subject to reinsurance cession under a treaty or facultative agreement.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCommissionable rdf:type rdf:Property ;
    rdfs:label 'Is Commissionable' ;
    rdfs:comment 'Indicates whether this charge is subject to producer commission calculation.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEarned rdf:type rdf:Property ;
    rdfs:label 'Is Earned' ;
    rdfs:comment 'Indicates whether this charge has been earned as of the accounting period date.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMinimumPremium rdf:type rdf:Property ;
    rdfs:label 'Is Minimum Premium' ;
    rdfs:comment 'Indicates whether this charge represents a minimum premium requirement for the policy or coverage.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProrated rdf:type rdf:Property ;
    rdfs:label 'Is Prorated' ;
    rdfs:comment 'Indicates whether the charge amount has been prorated for a partial term or endorsement period.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentage rdf:type rdf:Property ;
    rdfs:label 'Percentage' ;
    rdfs:comment 'Percentage applied to the basis amount to calculate the charge, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prorationFactor rdf:type rdf:Property ;
    rdfs:label 'Proration Factor' ;
    rdfs:comment 'Factor applied to prorate the charge for a partial term, typically a fraction of the full term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingElementCode rdf:type rdf:Property ;
    rdfs:label 'Rating Element Code' ;
    rdfs:comment 'Code identifying the rating element or factor that generated this charge, per the rating engine.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingElementDescription rdf:type rdf:Property ;
    rdfs:label 'Rating Element Description' ;
    rdfs:comment 'Human-readable description of the rating element or factor that generated this charge.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequence rdf:type rdf:Property ;
    rdfs:label 'Sequence' ;
    rdfs:comment 'Ordering sequence of this charge within the premium transaction for display and calculation purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statutoryLineCode rdf:type rdf:Property ;
    rdfs:label 'Statutory Line Code' ;
    rdfs:comment 'NAIC statutory line of business code for regulatory reporting and Schedule P aggregation.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unearnedAmount rdf:type rdf:Property ;
    rdfs:label 'Unearned Amount' ;
    rdfs:comment 'Portion of the charge amount that remains unearned as of the accounting period date.' ;
    rdfs:domain ind:Charge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxLevyId rdf:type rdf:Property ;
    rdfs:label 'Tax Levy Id' ;
    rdfs:comment 'Unique identifier for the tax levy record. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxLevy .

ind:originalTaxLevyId rdf:type rdf:Property ;
    rdfs:label 'Original Tax Levy Id' ;
    rdfs:comment 'Foreign key to the original tax levy record being adjusted or corrected, if this is an adjustment transaction. Null for original levies.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxLevy .

ind:stateRegId rdf:type rdf:Property ;
    rdfs:label 'State Reg Id' ;
    rdfs:comment 'Foreign key linking to policy.state_reg. Business justification: Surplus lines stamping fees, guaranty fund assessments, and municipal taxes are governed by the state regulatory record for the policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StateReg .

ind:taxLevyDescription rdf:type rdf:Property ;
    rdfs:label 'Tax Levy Description' ;
    rdfs:comment 'Free-text description providing additional context or detail about the tax levy, such as special assessments or regulatory notes.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTransactionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Policy Transaction Type Code' ;
    rdfs:comment 'Type of policy transaction that triggered the premium and associated tax levy: new business, renewal, endorsement, cancellation, or reinstatement.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stampingOfficeCode rdf:type rdf:Property ;
    rdfs:label 'Stamping Office Code' ;
    rdfs:comment 'Code identifying the surplus lines stamping office responsible for processing and collecting the tax, if applicable.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Adjustment Flag' ;
    rdfs:comment 'Indicates whether this tax levy record represents an adjustment or correction to a previously recorded tax levy.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Tax Authority Name' ;
    rdfs:comment 'Name of the regulatory or governmental authority to which the tax is remitted, such as State Department of Insurance or Surplus Lines Stamping Office.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCalculationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Tax Calculation Method Code' ;
    rdfs:comment 'Method used to calculate the tax levy: statutory rate, flat fee, tiered rate schedule, or minimum tax threshold.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Tax Effective Date' ;
    rdfs:comment 'The date on which the tax levy becomes effective, typically aligned with the premium transaction effective date.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxExemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exemption Flag' ;
    rdfs:comment 'Indicates whether the premium transaction qualifies for a tax exemption under statutory or regulatory provisions.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxExemptionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Tax Exemption Reason Code' ;
    rdfs:comment 'Code indicating the reason for tax exemption: exempt entity, reinsurance, export, federal program, or other statutory exemption.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRate rdf:type rdf:Property ;
    rdfs:label 'Tax Rate' ;
    rdfs:comment 'The statutory tax rate applied to the taxable premium base, expressed as a decimal (e.g., 0.025 for 2.5 percent).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxRemittanceBatchCode rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Batch Code' ;
    rdfs:comment 'Identifier of the remittance batch or payment run in which this tax levy was included for payment to the authority.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRemittanceDate rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Date' ;
    rdfs:comment 'The actual date on which the tax was remitted to the taxing authority. Null if not yet remitted.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxRemittanceDueDate rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Due Date' ;
    rdfs:comment 'The statutory due date by which the tax must be remitted to the taxing authority to avoid penalties.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxRemittanceStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Status' ;
    rdfs:comment 'Current remittance status of the tax levy: pending, remitted, overdue, waived, or adjusted.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxReportingCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Tax Reporting Category Code' ;
    rdfs:comment 'Reporting category for statutory and regulatory tax filings: direct written premium, assumed reinsurance, or ceded reinsurance.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxTypeCode rdf:type rdf:Property ;
    rdfs:label 'Tax Type Code' ;
    rdfs:comment 'Classification of the tax levy: state premium tax, surplus lines tax, stamping fee, municipal tax, fire marshal tax, or guaranty fund assessment.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxablePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Taxable Premium Amount' ;
    rdfs:comment 'The base premium amount subject to tax, after any exemptions or adjustments, in US dollars.' ;
    rdfs:domain ind:TaxLevy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyFeeId rdf:type rdf:Property ;
    rdfs:label 'Policy Fee Id' ;
    rdfs:comment 'Unique identifier for the policy fee transaction record.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Foreign key to the billing invoice on which this fee appears; null if not yet invoiced.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:paymentPlanId rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Id' ;
    rdfs:comment 'Foreign key to the payment plan under which this fee is financed; null for full-pay policies.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentPlan .

ind:billingMethod rdf:type rdf:Property ;
    rdfs:label 'Billing Method' ;
    rdfs:comment 'Method by which the fee is billed: direct bill to insured, agency bill through producer, list bill, or account current.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Amount' ;
    rdfs:comment 'Monetary amount of the fee charged, in the policy currency.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeBasis rdf:type rdf:Property ;
    rdfs:label 'Fee Basis' ;
    rdfs:comment 'Basis on which the fee is calculated: flat amount, per policy, per vehicle, per location, per driver, per installment, or percentage of premium. [ENUM-REF-CANDIDATE: flat|per_policy|per_vehicle|per_location|per_driver|per_installment|percentage_of_premium' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCode rdf:type rdf:Property ;
    rdfs:label 'Fee Code' ;
    rdfs:comment 'Standardized code identifying the type of fee charged, aligned with rating engine and billing system fee schedules.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeDescription rdf:type rdf:Property ;
    rdfs:label 'Fee Description' ;
    rdfs:comment 'Human-readable description of the fee, displayed on declarations pages and billing statements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeQuantity rdf:type rdf:Property ;
    rdfs:label 'Fee Quantity' ;
    rdfs:comment 'Quantity or count used to calculate the fee when charged on a per-unit basis; null for flat or percentage fees.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeRate rdf:type rdf:Property ;
    rdfs:label 'Fee Rate' ;
    rdfs:comment 'Rate applied when fee is calculated as a percentage or per-unit charge; null for flat fees.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Status' ;
    rdfs:comment 'Current lifecycle status of the fee transaction: pending, posted, reversed, refunded, or written off.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeType rdf:type rdf:Property ;
    rdfs:label 'Fee Type' ;
    rdfs:comment 'Classification of the fee by business purpose: policy fee, inspection fee, installment fee, service fee, late fee, reinstatement fee, endorsement fee, or cancellation fee.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCommissionBearing rdf:type rdf:Property ;
    rdfs:label 'Is Commission Bearing' ;
    rdfs:comment 'Indicates whether producer commission is calculated on this fee; typically false for most policy fees.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRefundable rdf:type rdf:Property ;
    rdfs:label 'Is Refundable' ;
    rdfs:comment 'Indicates whether this fee is refundable upon policy cancellation or endorsement reversal.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTaxable rdf:type rdf:Property ;
    rdfs:label 'Is Taxable' ;
    rdfs:comment 'Indicates whether this fee is subject to state or local taxes; most policy fees are non-taxable.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'Date on which the fee was reversed or refunded; null if not reversed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionBookingDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Booking Date' ;
    rdfs:comment 'Date on which the fee transaction was recorded in the financial ledger.' ;
    rdfs:domain ind:PolicyFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Effective Date' ;
    rdfs:comment 'Date on which the fee transaction becomes effective for policy accounting purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waivedFlag rdf:type rdf:Property ;
    rdfs:label 'Waived Flag' ;
    rdfs:comment 'Indicates whether this fee was waived as part of underwriting discretion or customer service exception.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverAuthorizedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Authorized By' ;
    rdfs:comment 'User ID or name of the underwriter or manager who authorized the fee waiver; null if not waived.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverReasonCode rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason Code' ;
    rdfs:comment 'Code indicating the reason for fee waiver; null if not waived.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionId rdf:type rdf:Property ;
    rdfs:label 'Commission Id' ;
    rdfs:comment 'Unique identifier for the commission transaction record.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disbursementId rdf:type rdf:Property ;
    rdfs:label 'Disbursement Id' ;
    rdfs:comment 'Foreign key linking to billing.disbursement. Business justification: Commission records earned amounts; disbursement records actual payment to producer. Reconciliation of earned vs paid commission is critical for producer accounting, commission payable' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Disbursement .

ind:originalCommissionId rdf:type rdf:Property ;
    rdfs:label 'Original Commission Id' ;
    rdfs:comment 'Foreign key to the original commission record that this transaction reverses or adjusts.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Commission .

ind:payeePartyId rdf:type rdf:Property ;
    rdfs:label 'Payee Party Id' ;
    rdfs:comment 'Foreign key linking to party.party. Business justification: Commission disbursement requires identifying the payee party for 1099 tax reporting, W-9 verification, and OFAC screening — all named regulatory obligations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:policyProducerId rdf:type rdf:Property ;
    rdfs:label 'Policy Producer Id' ;
    rdfs:comment 'Foreign key linking to policy.policy_producer. Business justification: Split-commission calculations and producer statement generation require knowing the specific policy_producer appointment record (split percentage, commission plan, of-record flag)' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyProducer .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'The method used to calculate the commission: flat rate, tiered structure, sliding scale, or manual override.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargebackIndicator rdf:type rdf:Property ;
    rdfs:label 'Chargeback Indicator' ;
    rdfs:comment 'Flag indicating whether this commission is a chargeback reversing a previously paid commission due to policy cancellation or return premium.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chargebackReason rdf:type rdf:Property ;
    rdfs:label 'Chargeback Reason' ;
    rdfs:comment 'Explanation for why the commission was charged back, typically due to policy cancellation, non-payment, or return premium.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionStatus rdf:type rdf:Property ;
    rdfs:label 'Commission Status' ;
    rdfs:comment 'Current lifecycle status of the commission: calculated, approved, pending payment, paid, reversed, or cancelled.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionType rdf:type rdf:Property ;
    rdfs:label 'Commission Type' ;
    rdfs:comment 'Type of commission: new business, renewal, endorsement, contingent, override, or bonus.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentIndicator rdf:type rdf:Property ;
    rdfs:label 'Contingent Indicator' ;
    rdfs:comment 'Flag indicating whether this is a contingent commission based on volume, profitability, or other performance criteria.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earnedDate rdf:type rdf:Property ;
    rdfs:label 'Earned Date' ;
    rdfs:comment 'The date on which the commission was earned, typically aligned with premium earning.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'The timestamp when this commission record was last modified.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:netPayableAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payable Amount' ;
    rdfs:comment 'The net commission amount payable to the producer after deductions, offsets, and withholdings.' ;
    rdfs:domain ind:Commission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideIndicator rdf:type rdf:Property ;
    rdfs:label 'Override Indicator' ;
    rdfs:comment 'Flag indicating whether this commission is an override commission paid to a managing or supervising producer.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:filingOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Filing Organization Id' ;
    rdfs:comment 'Foreign key linking to party.organization. Business justification: Rate tables are filed by or on behalf of specific carrier organizations or MGAs. Linking rate_table to organization supports regulatory compliance (which entity filed this rate)' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:typeId rdf:type rdf:Property ;
    rdfs:label 'Type Id' ;
    rdfs:comment 'Foreign key linking to policy.policy_type. Business justification: Rate tables are filed, approved, and versioned per policy type (HO3, BOP, CPP, PAP). Actuarial rate adequacy reviews and state DOI filings require linking each rate table version to the' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Type .

ind:actuarialMemoReference rdf:type rdf:Property ;
    rdfs:label 'Actuarial Memo Reference' ;
    rdfs:comment 'Reference number or document identifier for the actuarial memorandum supporting this rate table filing.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseRateAmount rdf:type rdf:Property ;
    rdfs:label 'Base Rate Amount' ;
    rdfs:comment 'Primary rate value or starting premium amount before application of factors and adjustments.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateTableCode rdf:type rdf:Property ;
    rdfs:label 'Rate Table Code' ;
    rdfs:comment 'Business identifier for the rate table, typically combining LOB, state, and version components for external reference.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credibilityFactor rdf:type rdf:Property ;
    rdfs:label 'Credibility Factor' ;
    rdfs:comment 'Actuarial credibility weight applied to experience data used to develop this rate table, ranging from 0 to 1.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Standard deductible level this rate table is designed for, if rate varies by deductible.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseProvisionPercentage rdf:type rdf:Property ;
    rdfs:label 'Expense Provision Percentage' ;
    rdfs:comment 'Percentage load for underwriting expenses, commissions, and overhead included in the rate.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'Date when this rate table was submitted to the state regulator for approval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Number' ;
    rdfs:comment 'State Department of Insurance filing reference number for regulatory approval of this rate table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFileAndUse rdf:type rdf:Property ;
    rdfs:label 'Is File And Use' ;
    rdfs:comment 'Indicates whether this rate table was implemented under file-and-use regulatory framework, requiring filing before use but not prior approval.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPriorApproval rdf:type rdf:Property ;
    rdfs:label 'Is Prior Approval' ;
    rdfs:comment 'Indicates whether this rate table required prior regulatory approval before implementation.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUseAndFile rdf:type rdf:Property ;
    rdfs:label 'Is Use And File' ;
    rdfs:comment 'Indicates whether this rate table was implemented under use-and-file regulatory framework, allowing immediate use before approval.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoProgramCode rdf:type rdf:Property ;
    rdfs:label 'Iso Program Code' ;
    rdfs:comment 'ISO program or form edition code if this rate table is based on ISO advisory rates or forms.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitAmount rdf:type rdf:Property ;
    rdfs:label 'Limit Amount' ;
    rdfs:comment 'Standard coverage limit this rate table is designed for, if rate varies by limit.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCostBasis rdf:type rdf:Property ;
    rdfs:label 'Loss Cost Basis' ;
    rdfs:comment 'Actuarial loss cost per exposure unit underlying this rate table, before expense and profit loads.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Premium Amount' ;
    rdfs:comment 'Ceiling premium amount that cannot be exceeded for this rate table, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Amount' ;
    rdfs:comment 'Floor premium amount that must be charged regardless of calculated premium for this rate table.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateTableName rdf:type rdf:Property ;
    rdfs:label 'Rate Table Name' ;
    rdfs:comment 'Human-readable name describing the rate table purpose and scope.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitProvisionPercentage rdf:type rdf:Property ;
    rdfs:label 'Profit Provision Percentage' ;
    rdfs:comment 'Percentage load for underwriting profit and contingencies included in the rate.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publishedDate rdf:type rdf:Property ;
    rdfs:label 'Published Date' ;
    rdfs:comment 'Date when this rate table version was released to the rating engine and made available for policy transactions.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Change Percentage' ;
    rdfs:comment 'Overall percentage increase or decrease from the prior rate table version, used for regulatory filing disclosure.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateManualEdition rdf:type rdf:Property ;
    rdfs:label 'Rate Manual Edition' ;
    rdfs:comment 'Edition or publication date of the rate manual or rating guide this table is published in.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateSource rdf:type rdf:Property ;
    rdfs:label 'Rate Source' ;
    rdfs:comment 'Origin of the rate data: proprietary company rates, ISO advisory, NCCI, state-mandated manual, or competitor benchmark.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateTableStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Table Status' ;
    rdfs:comment 'Current operational status of this rate table version in the rating engine.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateType rdf:type rdf:Property ;
    rdfs:label 'Rate Type' ;
    rdfs:comment 'Classification of rate content: base rates, rating factors, minimum premiums, surcharges, discounts, or credits.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAlgorithmCode rdf:type rdf:Property ;
    rdfs:label 'Rating Algorithm Code' ;
    rdfs:comment 'Identifier for the calculation method or formula used to apply this rate table during policy rating.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trendFactor rdf:type rdf:Property ;
    rdfs:label 'Trend Factor' ;
    rdfs:comment 'Actuarial trend adjustment factor applied to historical loss data to project future losses for this rate table.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withdrawnDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Date' ;
    rdfs:comment 'Date when this rate table version was removed from active use in the rating engine.' ;
    rdfs:domain ind:RateTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:installmentPlanId rdf:type rdf:Property ;
    rdfs:label 'Installment Plan Id' ;
    rdfs:comment 'Unique identifier for the installment plan. Primary key.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InstallmentPlan .

ind:billingAccountId rdf:type rdf:Property ;
    rdfs:label 'Billing Account Id' ;
    rdfs:comment 'Foreign key linking to billing.account. Business justification: Installment plan is executed against a billing account. The installment_plan table tracks the elected payment schedule for a policy term, and that schedule is managed within the context of a' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:amountOutstanding rdf:type rdf:Property ;
    rdfs:label 'Amount Outstanding' ;
    rdfs:comment 'Remaining unpaid balance on the installment plan, including overdue amounts.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountPaidToDate rdf:type rdf:Property ;
    rdfs:label 'Amount Paid To Date' ;
    rdfs:comment 'Cumulative amount paid by the policyholder against this installment plan to date.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoPayFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Flag' ;
    rdfs:comment 'Indicates whether automatic payment is enabled for this installment plan.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Effective Date' ;
    rdfs:comment 'Date on which the policy will be cancelled if outstanding installments are not paid.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:daysDelinquent rdf:type rdf:Property ;
    rdfs:label 'Days Delinquent' ;
    rdfs:comment 'Number of days the installment plan has been in delinquent status.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delinquencyDate rdf:type rdf:Property ;
    rdfs:label 'Delinquency Date' ;
    rdfs:comment 'Date on which the installment plan first became delinquent.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:downPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Down Payment Amount' ;
    rdfs:comment 'Initial down payment amount required at policy binding before installment schedule begins.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Down Payment Date' ;
    rdfs:comment 'Date on which the down payment was received or is due.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Final Installment Due Date' ;
    rdfs:comment 'Due date for the last scheduled installment payment under this plan.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'First Installment Due Date' ;
    rdfs:comment 'Due date for the first scheduled installment payment after the down payment.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after the due date during which payment may be made without penalty or cancellation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentFeePerPayment rdf:type rdf:Property ;
    rdfs:label 'Installment Fee Per Payment' ;
    rdfs:comment 'Fee charged per installment payment to cover administrative costs of the payment plan.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentsOutstanding rdf:type rdf:Property ;
    rdfs:label 'Installments Outstanding' ;
    rdfs:comment 'Count of installments that remain unpaid or partially paid.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentsPaid rdf:type rdf:Property ;
    rdfs:label 'Installments Paid' ;
    rdfs:comment 'Count of installments that have been fully paid to date.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isDelinquent rdf:type rdf:Property ;
    rdfs:label 'Is Delinquent' ;
    rdfs:comment 'Indicates whether the installment plan is currently delinquent due to missed or late payments.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Standard late fee charged per installment when payment is received after the grace period.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfInstallments rdf:type rdf:Property ;
    rdfs:label 'Number Of Installments' ;
    rdfs:comment 'Total count of installment payments scheduled under this plan for the policy term.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle status of the installment plan: active, completed, cancelled, suspended, or defaulted.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Date' ;
    rdfs:comment 'Date on which a previously cancelled or suspended installment plan was reinstated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Fee Amount' ;
    rdfs:comment 'Fee charged to reinstate a cancelled or suspended installment plan.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Total Fees Amount' ;
    rdfs:comment 'Total installment fees charged across all scheduled payments under this plan.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPlanAmount rdf:type rdf:Property ;
    rdfs:label 'Total Plan Amount' ;
    rdfs:comment 'Total amount due under the installment plan, including premium and all fees.' ;
    rdfs:domain ind:InstallmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Total Premium Amount' ;
    rdfs:comment 'Total premium amount to be collected across all installments under this plan.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoRenewFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renew Flag' ;
    rdfs:comment 'Flag indicating whether the policy is set to automatically renew at expiration. True if auto-renew enabled.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindingDate rdf:type rdf:Property ;
    rdfs:label 'Binding Date' ;
    rdfs:comment 'Date the policy was bound and coverage became contractually obligated.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Reason for policy cancellation: non-payment, insured request, underwriting decision, fraud, material change, or non-renewal.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierCode rdf:type rdf:Property ;
    rdfs:label 'Carrier Code' ;
    rdfs:comment 'Identifier for the insurance carrier or legal entity issuing the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facultativeFlag rdf:type rdf:Property ;
    rdfs:label 'Facultative Flag' ;
    rdfs:comment 'Flag indicating whether facultative reinsurance was placed for this policy. True if facultative coverage exists.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formCode rdf:type rdf:Property ;
    rdfs:label 'Form Code' ;
    rdfs:comment 'ISO or proprietary form code identifying the base policy contract form.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonRenewalNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Non Renewal Notice Date' ;
    rdfs:comment 'Date non-renewal notice was sent to the policyholder, if applicable. Null if policy is renewing.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonRenewalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Non Renewal Reason Code' ;
    rdfs:comment 'Reason for non-renewal: underwriting decision, loss history, non-payment, program exit, or regulatory requirement.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Status' ;
    rdfs:comment 'Current lifecycle status of the policy contract. [ENUM-REF-CANDIDATE: draft|quoted|bound|in_force|cancelled|expired|non_renewed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Number' ;
    rdfs:comment 'Policy number of the prior term if this is a renewal or rewrite. Null for new business.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producerCode rdf:type rdf:Property ;
    rdfs:label 'Producer Code' ;
    rdfs:comment 'Identifier for the producer (agent or broker) who sold the policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Internal program or product line identifier under which the policy is written.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quoteDate rdf:type rdf:Property ;
    rdfs:label 'Quote Date' ;
    rdfs:comment 'Date the initial quote was generated for this policy.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinsuranceTreatyCode rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Code' ;
    rdfs:comment 'Identifier for the reinsurance treaty under which this policy is ceded, if applicable.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalIndicator rdf:type rdf:Property ;
    rdfs:label 'Renewal Indicator' ;
    rdfs:comment 'Flag indicating whether this policy is a renewal of a prior term. True if renewal, false if new business.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Numeric risk score assigned by underwriting or rating engine. Higher score indicates higher risk.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Date the risk submission was received for underwriting evaluation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:termMonths rdf:type rdf:Property ;
    rdfs:label 'Term Months' ;
    rdfs:comment 'Length of the policy term in months. Typically 12 for annual policies, 6 for semi-annual.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalInsuredValue rdf:type rdf:Property ;
    rdfs:label 'Total Insured Value' ;
    rdfs:comment 'Total insured value across all coverages and insured risks on the policy. Sum of all limits.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwritingTier rdf:type rdf:Property ;
    rdfs:label 'Underwriting Tier' ;
    rdfs:comment 'Risk tier assigned during underwriting: preferred, standard, non-standard, or declined.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Written Premium Amount' ;
    rdfs:comment 'Total written premium for the policy term. Gross premium before adjustments.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termId rdf:type rdf:Property ;
    rdfs:label 'Term Id' ;
    rdfs:comment 'Unique identifier for the policy term. Primary key. One row per policy per term.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Term .

ind:priorTermId rdf:type rdf:Property ;
    rdfs:label 'Prior Term Id' ;
    rdfs:comment 'Foreign key to the immediately preceding term. Null for new business, populated for renewals.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Term .

ind:cancellationType rdf:type rdf:Property ;
    rdfs:label 'Cancellation Type' ;
    rdfs:comment 'Type of cancellation determining premium return calculation. Flat, short-rate, or pro-rata.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationDays rdf:type rdf:Property ;
    rdfs:label 'Duration Days' ;
    rdfs:comment 'Number of days between term effective and expiration dates. Typically 365 for annual policies.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isRenewal rdf:type rdf:Property ;
    rdfs:label 'Is Renewal' ;
    rdfs:comment 'Indicates whether this term is a renewal of a prior term. False for new business, true for renewals.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedDate rdf:type rdf:Property ;
    rdfs:label 'Issued Date' ;
    rdfs:comment 'Date when the policy documents for this term were issued to the insured.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateVersion rdf:type rdf:Property ;
    rdfs:label 'Rate Version' ;
    rdfs:comment 'Version identifier of the rating algorithm used to price this term. Enables rate change analysis.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalAcceptedDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Accepted Date' ;
    rdfs:comment 'Date when the insured accepted the renewal offer. Null if renewal was not accepted.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalOfferDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Offer Date' ;
    rdfs:comment 'Date when renewal offer was extended to the insured. Used for renewal cycle tracking.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalType rdf:type rdf:Property ;
    rdfs:label 'Renewal Type' ;
    rdfs:comment 'Classification of the renewal process. Indicates whether renewal was automatic, manual, or conditional.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termStatus rdf:type rdf:Property ;
    rdfs:label 'Term Status' ;
    rdfs:comment 'Current lifecycle status of the policy term. Indicates whether the term is active, expired, or cancelled.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Underwriting Company Code' ;
    rdfs:comment 'NAIC company code of the insurer underwriting this term. Used for statutory reporting.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingCompanyName rdf:type rdf:Property ;
    rdfs:label 'Underwriting Company Name' ;
    rdfs:comment 'Legal name of the insurance company underwriting this term.' ;
    rdfs:domain ind:Term ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPriorTransactionPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Primary Prior Transaction Policy Transaction Id' ;
    rdfs:comment 'Reference to the immediately preceding transaction in the policy lifecycle. Enables transaction chain reconstruction.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time when the transaction was approved. Distinct from processed and effective timestamps.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancellationBasis rdf:type rdf:Property ;
    rdfs:label 'Cancellation Basis' ;
    rdfs:comment 'Legal or business basis for cancellation. Determines regulatory notice requirements and return premium method. Null for non-cancellation transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationTypeCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Type Code' ;
    rdfs:comment 'Method used to calculate return premium for cancellations: flat (no return), short_rate (penalty), pro_rata (proportional). Null for non-cancellation transactions.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Impact Amount' ;
    rdfs:comment 'Net change in producer commission resulting from this transaction. Used for commission settlement and payables.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'Reference to the generated policy document, declarations page, or endorsement form associated with this transaction.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementDescription rdf:type rdf:Property ;
    rdfs:label 'Endorsement Description' ;
    rdfs:comment 'Business description of the endorsement changes. Summarizes coverage, limit, or risk modifications. Null for non-endorsement transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementFormNumber rdf:type rdf:Property ;
    rdfs:label 'Endorsement Form Number' ;
    rdfs:comment 'ISO or proprietary form number attached to this endorsement transaction. Null for non-endorsement transactions.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBackdatedFlag rdf:type rdf:Property ;
    rdfs:label 'Is Backdated Flag' ;
    rdfs:comment 'Indicates whether the effective date is prior to the processed date. Used for audit and compliance monitoring.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMidtermFlag rdf:type rdf:Property ;
    rdfs:label 'Is Midterm Flag' ;
    rdfs:comment 'Indicates whether this transaction occurred mid-term (between policy inception and expiration). True for endorsements, cancellations, reinstatements.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Is Renewal Flag' ;
    rdfs:comment 'Indicates whether this transaction represents a policy renewal. True for REN transaction type, false otherwise.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issued Timestamp' ;
    rdfs:comment 'Date and time when the transaction was issued and documents were generated. Marks final commitment.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processedDate rdf:type rdf:Property ;
    rdfs:label 'Processed Date' ;
    rdfs:comment 'Date when the transaction was processed and recorded in the system. May differ from effective date.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code indicating the business reason for the transaction. Type-specific: endorsement reason, cancellation cause, reinstatement justification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why the transaction was initiated. Supplements the reason code with context.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Date' ;
    rdfs:comment 'Date when regulatory filing was submitted. Null if no filing required or not yet filed.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryFilingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required Flag' ;
    rdfs:comment 'Indicates whether this transaction requires filing with state Department of Insurance or other regulatory body.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementLapseDays rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Lapse Days' ;
    rdfs:comment 'Number of days the policy was lapsed before reinstatement. Used for underwriting and pricing adjustments. Null for non-reinstatement transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsuranceCessionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Cession Required Flag' ;
    rdfs:comment 'Indicates whether this transaction triggers reinsurance cession under treaty or facultative agreements.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresUnderwritingReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Underwriting Review Flag' ;
    rdfs:comment 'Indicates whether this transaction triggered underwriting referral or manual review based on risk appetite rules.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voidedReasonCode rdf:type rdf:Property ;
    rdfs:label 'Voided Reason Code' ;
    rdfs:comment 'Standardized code indicating why the transaction was voided. Null for active transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Voided Timestamp' ;
    rdfs:comment 'Date and time when the transaction was voided or reversed. Null for active transactions.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:writtenPremiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Written Premium Change Amount' ;
    rdfs:comment 'Net change in written premium resulting from this transaction. Positive for increases, negative for returns. Used for premium accounting and statutory reporting.' ;
    rdfs:domain ind:PolicyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyholderId rdf:type rdf:Property ;
    rdfs:label 'Policyholder Id' ;
    rdfs:comment 'Unique identifier for the policyholder data product (auto-inserted during validation).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policyholder .

ind:policyholderPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Policyholder Policy Transaction Id' ;
    rdfs:comment 'Reference to the policy transaction that added this policyholder to the policy.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:policyholderRemovedByTransactionPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Policyholder Removed By Transaction Policy Transaction Id' ;
    rdfs:comment 'Reference to the policy transaction that removed this policyholder from the policy. Null if still active.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:billingResponsibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Responsibility Flag' ;
    rdfs:comment 'Indicates whether this policyholder is responsible for premium payment. True if responsible, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Flag' ;
    rdfs:comment 'Indicates whether this party should receive a Certificate of Insurance. True if certificate holder, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holderSequence rdf:type rdf:Property ;
    rdfs:label 'Holder Sequence' ;
    rdfs:comment 'Ordinal position of this policyholder within the policy, used for display and reporting order.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holderType rdf:type rdf:Property ;
    rdfs:label 'Holder Type' ;
    rdfs:comment 'Classification of the policyholder role on the policy contract.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryInsured rdf:type rdf:Property ;
    rdfs:label 'Is Primary Insured' ;
    rdfs:comment 'Indicates whether this party is the primary named insured on the policy. True if primary, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailingAddressSameAsPrimaryFlag rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Same As Primary Flag' ;
    rdfs:comment 'Indicates whether this policyholder uses the same mailing address as the primary insured. True if same, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notice Required Flag' ;
    rdfs:comment 'Indicates whether this party must receive policy notices such as cancellation or non-renewal. True if required, false otherwise.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyholderStatus rdf:type rdf:Property ;
    rdfs:label 'Policyholder Status' ;
    rdfs:comment 'Current lifecycle status of this policyholder association on the policy contract.' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rankOrder rdf:type rdf:Property ;
    rdfs:label 'Rank Order' ;
    rdfs:comment 'Priority ranking for loss payment when multiple loss payees or mortgagees exist. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:relationshipToPrimary rdf:type rdf:Property ;
    rdfs:label 'Relationship To Primary' ;
    rdfs:comment 'Nature of the relationship between this policyholder and the primary named insured. [ENUM-REF-CANDIDATE: Spouse|Domestic Partner|Child|Parent|Sibling|Business Partner|Landlord|Tenant|Contractor|Vendor|Other — 11 candidates stripped; promote to reference' ;
    rdfs:domain ind:Policyholder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remarks rdf:type rdf:Property ;
    rdfs:label 'Remarks' ;
    rdfs:comment 'Free-form notes or special instructions related to this policyholder association.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverOfSubrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Of Subrogation Flag' ;
    rdfs:comment 'Indicates whether the insurer has waived subrogation rights against this party. True if waived, false otherwise.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestId rdf:type rdf:Property ;
    rdfs:label 'Interest Id' ;
    rdfs:comment 'Unique identifier for the additional interest record. Primary key.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:buildingId rdf:type rdf:Property ;
    rdfs:label 'Building Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.building. Business justification: Commercial property mortgagees and loss payees attach at building-level granularity for multi-building locations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Building .

ind:primaryPolicyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Primary Policy Transaction Id' ;
    rdfs:comment 'Reference to the policy transaction that added this interest to the policy term.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyTransaction .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line 1' ;
    rdfs:comment 'Primary street address of the interest holder for certificate mailing and notification purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line 2' ;
    rdfs:comment 'Secondary address line for suite, unit, or building information.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blanketAdditionalInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Blanket Additional Insured Flag' ;
    rdfs:comment 'Indicates whether the interest is covered under a blanket additional insured endorsement.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Email address for the interest holder contact for certificate delivery and notifications.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the interest holder organization for policy and certificate matters.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Primary phone number for the interest holder contact.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageScope rdf:type rdf:Property ;
    rdfs:label 'Coverage Scope' ;
    rdfs:comment 'Description of the scope of coverage provided to the interest holder, including any limitations or conditions.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Required Flag' ;
    rdfs:comment 'Indicates whether the interest holder must be notified of policy changes, cancellations, or non-renewals.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyInterestName rdf:type rdf:Property ;
    rdfs:label 'Policy Interest Name' ;
    rdfs:comment 'Full legal name of the party holding the interest as it appears on the policy or certificate.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyInterestStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Interest Status' ;
    rdfs:comment 'Current lifecycle status of the interest on the policy.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryNoncontributoryFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Noncontributory Flag' ;
    rdfs:comment 'Indicates whether coverage is primary and non-contributory with respect to the interest holder\'s own insurance.' ;
    rdfs:domain ind:Interest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateProvinceCode rdf:type rdf:Property ;
    rdfs:label 'State Province Code' ;
    rdfs:comment 'Two-letter state or province code for the interest holder\'s address.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formId rdf:type rdf:Property ;
    rdfs:label 'Form Id' ;
    rdfs:comment 'Unique identifier for the policy form attachment record. Primary key.' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentId rdf:type rdf:Property ;
    rdfs:label 'Document Id' ;
    rdfs:comment 'Reference to the physical or digital document storage location for the form PDF or image.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:acordFormFlag rdf:type rdf:Property ;
    rdfs:label 'Acord Form Flag' ;
    rdfs:comment 'Indicates whether this is a standard ACORD form (true) or not (false).' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Attachment Reason Code' ;
    rdfs:comment 'Coded reason for attaching this form: regulatory requirement, risk mitigation, customer request, underwriting referral, rate modification, or coverage enhancement.' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attachmentSequence rdf:type rdf:Property ;
    rdfs:label 'Attachment Sequence' ;
    rdfs:comment 'The order in which this form is attached to the policy term, used for precedence and document assembly.' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formCategory rdf:type rdf:Property ;
    rdfs:label 'Form Category' ;
    rdfs:comment 'High-level category of the form indicating the major coverage area it addresses. [ENUM-REF-CANDIDATE: coverage|liability|property|auto|workers_comp|umbrella|inland_marine|crime|professional_liability — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formDescription rdf:type rdf:Property ;
    rdfs:label 'Form Description' ;
    rdfs:comment 'Detailed description of the coverage, exclusion, or condition provided by this form.' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:editionDate rdf:type rdf:Property ;
    rdfs:label 'Edition Date' ;
    rdfs:comment 'The edition date of the form as published by ISO or the carrier, indicating the version in use.' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:formStatus rdf:type rdf:Property ;
    rdfs:label 'Form Status' ;
    rdfs:comment 'Current status of the form attachment: active, superseded by a newer edition, withdrawn, or pending approval.' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formType rdf:type rdf:Property ;
    rdfs:label 'Form Type' ;
    rdfs:comment 'Classification of the form: base policy form, endorsement, exclusion, condition, declaration page, schedule, or certificate of insurance. [ENUM-REF-CANDIDATE: base|endorsement|exclusion|condition|declaration|schedule|certificate — 7 candidates stripped' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoFormFlag rdf:type rdf:Property ;
    rdfs:label 'Iso Form Flag' ;
    rdfs:comment 'Indicates whether this is a standard ISO form (true) or a carrier-proprietary form (false).' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:language rdf:type rdf:Property ;
    rdfs:label 'Language' ;
    rdfs:comment 'The language in which the form is written (e.g., English, Spanish, French).' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Flag' ;
    rdfs:comment 'Indicates whether this form is mandatory per state filing or carrier underwriting rules (true) or optional (false).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formName rdf:type rdf:Property ;
    rdfs:label 'Form Name' ;
    rdfs:comment 'The full descriptive name of the form (e.g., Homeowners 3 Special Form, Commercial General Liability Coverage Form).' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Amount' ;
    rdfs:comment 'The additional premium amount charged for this form attachment, if premium-bearing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumBearingFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Bearing Flag' ;
    rdfs:comment 'Indicates whether this form attachment carries an additional premium charge (true) or is included at no charge (false).' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByFormNumber rdf:type rdf:Property ;
    rdfs:label 'Superseded By Form Number' ;
    rdfs:comment 'The form number that supersedes this form, if the form has been replaced by a newer edition.' ;
    rdfs:domain ind:Form ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterNotes rdf:type rdf:Property ;
    rdfs:label 'Underwriter Notes' ;
    rdfs:comment 'Free-text notes from the underwriter regarding the reason for attaching this form or special considerations.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:version rdf:type rdf:Property ;
    rdfs:label 'Version' ;
    rdfs:comment 'Internal version identifier for carrier-proprietary forms, tracking revisions and updates.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aalAmount rdf:type rdf:Property ;
    rdfs:label 'Aal Amount' ;
    rdfs:comment 'Average annual loss amount for this line of business based on catastrophe modeling.' ;
