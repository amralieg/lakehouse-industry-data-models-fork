ind:appliedAmount rdf:type rdf:Property ;
    rdfs:label 'Applied Amount' ;
    rdfs:comment 'Portion of the payment amount that has been applied to outstanding invoices or installments.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Authorization or approval code returned by the payment processor for card transactions.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'Interface or touchpoint through which the payment was submitted (web portal, mobile app, agent office, mail, phone, branch, lockbox). [ENUM-REF-CANDIDATE: web|mobile|agent|mail|phone|branch|lockbox — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:convenienceFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Convenience Fee Amount' ;
    rdfs:comment 'Additional fee charged to the payer for using a specific payment method or channel.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositDate rdf:type rdf:Property ;
    rdfs:label 'Deposit Date' ;
    rdfs:comment 'Date the payment was deposited into the insurers bank account.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:installmentNumber rdf:type rdf:Property ;
    rdfs:label 'Installment Number' ;
    rdfs:comment 'Sequence number of the installment this payment satisfies within the payment plan.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'User ID or system identifier that last modified the payment record.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Payer Account Number' ;
    rdfs:comment 'Masked or tokenized account number from which the payment was drawn (last 4 digits of card or bank account).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerName rdf:type rdf:Property ;
    rdfs:label 'Payer Name' ;
    rdfs:comment 'Name of the individual or entity that remitted the payment.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Processing Fee Amount' ;
    rdfs:comment 'Fee charged by the payment processor or gateway for handling the transaction.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receiptIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Issued Date' ;
    rdfs:comment 'Date the payment receipt was generated and issued to the payer.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receiptNumber rdf:type rdf:Property ;
    rdfs:label 'Receipt Number' ;
    rdfs:comment 'Official receipt number issued to the payer acknowledging the payment.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Origin or category of the payer (policyholder, third party, agent, reinsurer, subrogation recovery).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unappliedAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Amount' ;
    rdfs:comment 'Portion of the payment held in suspense, not yet matched to a policy or account balance.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'User ID or system identifier that created the payment record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Payment Application Id' ;
    rdfs:comment 'Unique identifier for the payment application record. Primary key for the junction table linking premium payments to installments.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationPriority rdf:type rdf:Property ;
    rdfs:label 'Allocation Priority' ;
    rdfs:comment 'Numeric priority order used to allocate payment across multiple installments or charge types. Lower numbers applied first per billing rules.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'Business date on which the payment was applied to the installment. May differ from payment received date due to batch processing or suspense clearing.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationNotes rdf:type rdf:Property ;
    rdfs:label 'Application Notes' ;
    rdfs:comment 'Free-text notes entered by CSR or system explaining special circumstances of the payment application such as manual allocation reason or suspense research outcome.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationSequence rdf:type rdf:Property ;
    rdfs:label 'Application Sequence' ;
    rdfs:comment 'Sequential order in which this payment application was processed. Supports audit trail and reversal logic for multi-installment payments.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current lifecycle status of the payment application. Applied is normal state; reversed indicates the application was undone; pending for suspense items.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Application Timestamp' ;
    rdfs:comment 'Precise date and time when the payment application transaction was recorded in the billing system. Supports audit and reconciliation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:appliedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Applied By User Code' ;
    rdfs:comment 'User ID of the CSR or system account that executed the payment application. Null for fully automated applications. Supports audit and quality review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedToFeeFlag rdf:type rdf:Property ;
    rdfs:label 'Applied To Fee Flag' ;
    rdfs:comment 'Indicates whether this application was allocated to fees such as late payment fees, NSF fees, or installment fees rather than premium principal.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliedToInterestFlag rdf:type rdf:Property ;
    rdfs:label 'Applied To Interest Flag' ;
    rdfs:comment 'Indicates whether this application was allocated to accrued interest charges on overdue installments rather than premium principal.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliedToPrincipalFlag rdf:type rdf:Property ;
    rdfs:label 'Applied To Principal Flag' ;
    rdfs:comment 'Indicates whether this application reduced the principal premium amount. True for standard applications; false for fee or interest applications.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Billing Account Number' ;
    rdfs:comment 'Billing account number under which the installment and payment are managed. Denormalized for cash application and reconciliation reporting.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentBalanceAfter rdf:type rdf:Property ;
    rdfs:label 'Installment Balance After' ;
    rdfs:comment 'Outstanding balance of the installment immediately after this payment application. Should equal balance_before minus applied_amount.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentBalanceBefore rdf:type rdf:Property ;
    rdfs:label 'Installment Balance Before' ;
    rdfs:comment 'Outstanding balance of the installment immediately before this payment application. Enables balance reconciliation and audit trail.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nsfReversalFlag rdf:type rdf:Property ;
    rdfs:label 'Nsf Reversal Flag' ;
    rdfs:comment 'Indicates whether this application was reversed due to a returned or dishonored payment such as NSF check or failed ACH. Triggers reinstatement of installment balance.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'Policy number associated with the installment to which payment is applied. Denormalized for reporting and reconciliation convenience.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'Standardized code indicating why this payment application was reversed. Null if application has not been reversed. Used for audit and reporting.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reversal Timestamp' ;
    rdfs:comment 'Precise date and time when the payment application was reversed. Null if not reversed. Supports audit trail and temporal queries.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:suspenseClearingFlag rdf:type rdf:Property ;
    rdfs:label 'Suspense Clearing Flag' ;
    rdfs:comment 'Indicates whether this application cleared a payment from suspense account. True when unidentified payment is matched to installment after research.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumRateFilingId rdf:type rdf:Property ;
    rdfs:label 'Premium Rate Filing Id' ;
    rdfs:comment 'Unique identifier for the premium rate filing record. Primary key.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialJustification rdf:type rdf:Property ;
    rdfs:label 'Actuarial Justification' ;
    rdfs:comment 'Summary of the actuarial analysis and justification supporting the proposed rate change, including loss experience and trend factors.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuaryCredential rdf:type rdf:Property ;
    rdfs:label 'Actuary Credential' ;
    rdfs:comment 'Professional actuarial credential of the certifying actuary, such as FCAS, ACAS, FSA, ASA, MAAA.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuaryName rdf:type rdf:Property ;
    rdfs:label 'Actuary Name' ;
    rdfs:comment 'Name of the credentialed actuary who prepared and certified the rate filing analysis.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Date' ;
    rdfs:comment 'Date when the actuary certified the rate filing analysis and supporting documentation.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:competitiveImpactAnalysis rdf:type rdf:Property ;
    rdfs:label 'Competitive Impact Analysis' ;
    rdfs:comment 'Summary of the competitive market impact analysis showing how the proposed rates compare to market competitors.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consumerImpactStatement rdf:type rdf:Property ;
    rdfs:label 'Consumer Impact Statement' ;
    rdfs:comment 'Statement describing the expected impact of the rate change on policyholders and consumers in the affected market.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDescription rdf:type rdf:Property ;
    rdfs:label 'Filing Description' ;
    rdfs:comment 'Detailed description of the rate filing purpose, scope, and key changes being proposed to the regulator.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Filing Fee Amount' ;
    rdfs:comment 'Regulatory filing fee amount paid to the state Department of Insurance for processing the rate filing.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingFeePaidFlag rdf:type rdf:Property ;
    rdfs:label 'Filing Fee Paid Flag' ;
    rdfs:comment 'Indicates whether the required filing fee has been paid to the state regulator. True if paid, False if outstanding.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indicatedRateChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Indicated Rate Change Percentage' ;
    rdfs:comment 'Actuarially indicated rate change percentage based on loss experience analysis, before any capping or phasing adjustments.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insurerResponse rdf:type rdf:Property ;
    rdfs:label 'Insurer Response' ;
    rdfs:comment 'Insurers formal response to regulator comments, questions, or objections during the filing review process.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioTarget rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Target' ;
    rdfs:comment 'Target loss ratio the rate filing is designed to achieve, expressed as a decimal (e.g., 0.6500 for 65%).' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:objectionPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Objection Period End Date' ;
    rdfs:comment 'Date when the regulatory objection period ends, after which the filing is deemed approved if no objections are raised.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Filing Number' ;
    rdfs:comment 'Filing number of the previous rate filing for this line of business and state, establishing the baseline for the current change.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Change Percentage' ;
    rdfs:comment 'Overall percentage change in rates being proposed in this filing, expressed as a decimal (e.g., 0.0750 for 7.5% increase, -0.0300 for 3% decrease).' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Rate Impact Amount' ;
    rdfs:comment 'Estimated dollar impact of the rate change on total written premium for the affected line of business and state.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateManualVersion rdf:type rdf:Property ;
    rdfs:label 'Rate Manual Version' ;
    rdfs:comment 'Version identifier of the rate manual or rating algorithm being filed for regulatory approval.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorComments rdf:type rdf:Property ;
    rdfs:label 'Regulator Comments' ;
    rdfs:comment 'Comments, questions, or objections provided by the state Department of Insurance during the review process.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'Date when the state Department of Insurance rejected the rate filing. Null if approved or still under review.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersededFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Superseded Filing Number' ;
    rdfs:comment 'Filing number of any filing that this rate filing supersedes or replaces upon approval.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentCount rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Count' ;
    rdfs:comment 'Number of supporting documents submitted with the rate filing, including actuarial memoranda, rate manuals, and exhibits.' ;
    rdfs:domain ind:PremiumRateFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedTransactionPremiumTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Transaction Premium Transaction Id' ;
    rdfs:comment 'Reference to the original premium transaction that this transaction reverses, if applicable.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumTransaction .

ind:riTreatyId rdf:type rdf:Property ;
    rdfs:label 'Ri Treaty Id' ;
    rdfs:comment 'Reference to the reinsurance treaty under which premium is ceded for this transaction, if applicable.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiTreaty .

ind:auditCode rdf:type rdf:Property ;
    rdfs:label 'Audit Code' ;
    rdfs:comment 'Reference to the premium audit that resulted in this additional or return premium transaction, if applicable.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cededPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Ceded Premium Amount' ;
    rdfs:comment 'Portion of the gross written premium ceded to reinsurers under treaty or facultative agreements.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coveragePartCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Part Code' ;
    rdfs:comment 'Code identifying the specific coverage part or section of the policy to which this premium applies.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureUnits rdf:type rdf:Property ;
    rdfs:label 'Exposure Units' ;
    rdfs:comment 'Number of exposure units used to calculate the premium for this transaction, such as payroll, sales, or vehicle count.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'Date on which payment for this premium transaction was received from the policyholder or producer.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionDescription rdf:type rdf:Property ;
    rdfs:label 'Transaction Description' ;
    rdfs:comment 'Free-text description providing additional context or explanation for this premium transaction.' ;
    rdfs:domain ind:PremiumTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateElementId rdf:type rdf:Property ;
    rdfs:label 'Rate Element Id' ;
    rdfs:comment 'Unique identifier for the rate element. Primary key.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calculationFormula rdf:type rdf:Property ;
    rdfs:label 'Calculation Formula' ;
    rdfs:comment 'Mathematical formula or expression defining how this rate element is applied in premium computation.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catLoadingFactor rdf:type rdf:Property ;
    rdfs:label 'Cat Loading Factor' ;
    rdfs:comment 'Factor applied to load premium for catastrophe exposure, reflecting probable maximum loss and reinsurance costs.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateElementCategory rdf:type rdf:Property ;
    rdfs:label 'Rate Element Category' ;
    rdfs:comment 'Broader grouping of the rate element for reporting and rate filing purposes.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classCode rdf:type rdf:Property ;
    rdfs:label 'Class Code' ;
    rdfs:comment 'Risk classification code to which this rate element applies, such as NCCI class codes or ISO class codes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateElementCode rdf:type rdf:Property ;
    rdfs:label 'Rate Element Code' ;
    rdfs:comment 'Business identifier code for the rate element used in rating calculations and external references.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credibilityFactor rdf:type rdf:Property ;
    rdfs:label 'Credibility Factor' ;
    rdfs:comment 'Statistical credibility weight applied to experience-based rate elements, ranging from 0 to 1.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleCreditFactor rdf:type rdf:Property ;
    rdfs:label 'Deductible Credit Factor' ;
    rdfs:comment 'Factor applied to reduce premium when a deductible is selected, reflecting reduced insurer exposure.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultValue rdf:type rdf:Property ;
    rdfs:label 'Default Value' ;
    rdfs:comment 'Default value applied when no specific rate element value is determined during rating.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateElementDescription rdf:type rdf:Property ;
    rdfs:label 'Rate Element Description' ;
    rdfs:comment 'Detailed business description of the rate element, its purpose, and how it is applied in premium calculations.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseProvision rdf:type rdf:Property ;
    rdfs:label 'Expense Provision' ;
    rdfs:comment 'Percentage or factor representing underwriting expenses, commissions, and overhead included in the rate element.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:increasedLimitsFactor rdf:type rdf:Property ;
    rdfs:label 'Increased Limits Factor' ;
    rdfs:comment 'Factor applied to adjust premium when policy limits exceed the base limit, reflecting increased exposure.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isFiled rdf:type rdf:Property ;
    rdfs:label 'Is Filed' ;
    rdfs:comment 'Indicates whether this rate element has been filed with and approved by the regulatory authority.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCost rdf:type rdf:Property ;
    rdfs:label 'Loss Cost' ;
    rdfs:comment 'Pure premium or expected loss per unit of exposure, excluding expenses and profit, used as the foundation for rate development.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumValue rdf:type rdf:Property ;
    rdfs:label 'Maximum Value' ;
    rdfs:comment 'Maximum allowable value for this rate element as defined by regulatory or underwriting guidelines.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumValue rdf:type rdf:Property ;
    rdfs:label 'Minimum Value' ;
    rdfs:comment 'Minimum allowable value for this rate element as defined by regulatory or underwriting guidelines.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateElementName rdf:type rdf:Property ;
    rdfs:label 'Rate Element Name' ;
    rdfs:comment 'Human-readable name of the rate element describing its purpose in premium computation.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitMargin rdf:type rdf:Property ;
    rdfs:label 'Profit Margin' ;
    rdfs:comment 'Percentage or factor representing the profit and contingency margin included in the rate element.' ;
    rdfs:domain ind:RateElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateBasis rdf:type rdf:Property ;
    rdfs:label 'Rate Basis' ;
    rdfs:comment 'Unit of measure or basis on which the rate element is applied during premium computation. [ENUM-REF-CANDIDATE: per_100_payroll|per_1000_receipts|per_unit|per_vehicle|per_location|flat|percentage — 7 candidates stripped; promote to reference product]' ;
