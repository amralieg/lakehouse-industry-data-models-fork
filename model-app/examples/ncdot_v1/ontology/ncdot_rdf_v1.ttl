    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wellnessProgramIncludedIndicator rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Included Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan includes wellness program features or incentives.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telemedicineIncludedIndicator rdf:type rdf:Property ;
    rdfs:label 'Telemedicine Included Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan includes telemedicine or virtual care services.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mentalHealthParityCompliantIndicator rdf:type rdf:Property ;
    rdfs:label 'Mental Health Parity Compliant Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan complies with mental health parity requirements.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveCareCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan covers preventive care services at no cost to the employee.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateContinuationEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'State Continuation Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether the benefit plan is subject to North Carolina state continuation coverage requirements.' ;
    rdfs:domain ind:BenefitPlan ;
