    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratePerHundred rdf:type rdf:Property ;
    rdfs:label 'Rate Per Hundred' ;
    rdfs:comment 'Rating factor expressed as premium per hundred dollars of insured value for this equipment.' ;
