    rdfs:comment 'Date when the underwriter reviewed the survey findings and made the underwriting decision.' ;
    rdfs:domain ind:UwSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskGrade rdf:type rdf:Property ;
