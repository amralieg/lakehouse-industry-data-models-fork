    rdfs:comment 'The typical computational time required to execute a complete model run, measured in minutes.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataStorageSizeGb rdf:type rdf:Property ;
    rdfs:label 'Data Storage Size Gb' ;
    rdfs:comment 'The total storage space required for model files and data, measured in gigabytes.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'The date when the software license for the modeling platform expires.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annualLicenseCost rdf:type rdf:Property ;
    rdfs:label 'Annual License Cost' ;
    rdfs:comment 'The annual cost for software licenses required to operate the transportation model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:developmentCost rdf:type rdf:Property ;
    rdfs:label 'Development Cost' ;
    rdfs:comment 'The total cost incurred to develop, calibrate, and validate the transportation model.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalGrantNumber rdf:type rdf:Property ;
    rdfs:label 'Federal Grant Number' ;
    rdfs:comment 'The federal grant or award number associated with funding for model development, if applicable.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedProjectId rdf:type rdf:Property ;
