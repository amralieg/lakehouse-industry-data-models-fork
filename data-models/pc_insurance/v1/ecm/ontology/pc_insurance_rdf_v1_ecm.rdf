    rdfs:range ind:UserAccount .

ind:recipientCountryId rdf:type rdf:Property ;
    rdfs:label 'Recipient Country Id' ;
    rdfs:comment 'Foreign key linking to shared.country. Business justification: Document recipient country supports international policy servicing and cross-border delivery. FK to shared.country enforces valid country codes and enables international mailing rules.' ;
    rdfs:domain ind:Document ;
