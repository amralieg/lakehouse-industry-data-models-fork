ind:ncFirstRegistrationDate rdf:type rdf:Property ;
    rdfs:label 'Nc First Registration Date' ;
    rdfs:comment 'Date when the vehicle was first registered in North Carolina, which may differ from first registration date if vehicle was transferred from another state.' ;
    rdfs:domain ind:Vehicle ;
