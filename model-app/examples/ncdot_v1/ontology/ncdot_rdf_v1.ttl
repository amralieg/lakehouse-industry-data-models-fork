ind:performingOrganizationCode rdf:type rdf:Property ;
    rdfs:label 'Performing Organization Code' ;
    rdfs:comment 'Standardized code identifying the organizational unit or contractor performing the work, aligned with SAP organizational hierarchy.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:winterWeatherEvent rdf:type rdf:Property ;
