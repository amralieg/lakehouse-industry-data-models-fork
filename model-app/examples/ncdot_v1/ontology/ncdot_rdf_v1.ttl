# --- Attribute Properties ---
ind:acquisitionStatusId rdf:type rdf:Property ;
    rdfs:label 'Acquisition Status Id' ;
    rdfs:comment 'Unique identifier for the acquisition status code. Primary key for the acquisition status reference table.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AcquisitionStatus .

ind:statusCode rdf:type rdf:Property ;
    rdfs:label 'Status Code' ;
    rdfs:comment 'Short alphanumeric code representing the acquisition status (e.g., PEND, APPR, SURV, CLSD, CANC). Used as a business key for system integration and reporting.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusName rdf:type rdf:Property ;
    rdfs:label 'Status Name' ;
    rdfs:comment 'Full descriptive name of the acquisition status (e.g., Pending, Approved, In Survey, Closed, Cancelled). Human-readable label for business users.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusDescription rdf:type rdf:Property ;
    rdfs:label 'Status Description' ;
    rdfs:comment 'Detailed explanation of what the acquisition status represents, including business rules and conditions that trigger this status.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusCategory rdf:type rdf:Property ;
    rdfs:label 'Status Category' ;
    rdfs:comment 'High-level grouping of the acquisition status for reporting and filtering purposes. Categorizes statuses into broader lifecycle phases.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Indicates whether this status code is currently active and available for use in new acquisitions. Inactive statuses are retained for historical reference only.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTerminal rdf:type rdf:Property ;
    rdfs:label 'Is Terminal' ;
    rdfs:comment 'Indicates whether this status represents a final state in the acquisition lifecycle (e.g., Closed, Cancelled) from which no further transitions are expected.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Approval' ;
    rdfs:comment 'Indicates whether transitioning to this status requires formal approval from authorized personnel or management.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Level' ;
    rdfs:comment 'The organizational level required to approve transition to this status. Defines the authority level needed for status changes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresDocumentation rdf:type rdf:Property ;
    rdfs:label 'Requires Documentation' ;
    rdfs:comment 'Indicates whether supporting documentation must be attached or referenced when an acquisition reaches this status.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentTypesRequired rdf:type rdf:Property ;
    rdfs:label 'Document Types Required' ;
    rdfs:comment 'Comma-separated list of document types that must be provided when an acquisition reaches this status (e.g., appraisal, title report, environmental clearance).' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggersNotification rdf:type rdf:Property ;
    rdfs:label 'Triggers Notification' ;
    rdfs:comment 'Indicates whether reaching this status automatically triggers notifications to stakeholders, property owners, or other parties.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationRecipients rdf:type rdf:Property ;
    rdfs:label 'Notification Recipients' ;
    rdfs:comment 'Comma-separated list of recipient roles or groups that should be notified when an acquisition reaches this status (e.g., property_owner, project_manager, legal_counsel).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowsPayment rdf:type rdf:Property ;
    rdfs:label 'Allows Payment' ;
    rdfs:comment 'Indicates whether payment to property owners can be processed when an acquisition is in this status. Controls financial transaction authorization.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresLegalReview rdf:type rdf:Property ;
    rdfs:label 'Requires Legal Review' ;
    rdfs:comment 'Indicates whether legal counsel review is required before or during this status. Ensures compliance with legal requirements.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresEnvironmentalClearance rdf:type rdf:Property ;
    rdfs:label 'Requires Environmental Clearance' ;
    rdfs:comment 'Indicates whether environmental clearance or assessment must be completed before reaching this status. Ensures NEPA compliance.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:displayOrder rdf:type rdf:Property ;
    rdfs:label 'Display Order' ;
    rdfs:comment 'Numeric value controlling the sort order for displaying status codes in user interfaces and reports. Lower numbers appear first.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:displayColorCode rdf:type rdf:Property ;
    rdfs:label 'Display Color Code' ;
    rdfs:comment 'Hexadecimal color code used for visual representation of this status in dashboards and reports (e.g., #00FF00 for approved, #FF0000 for cancelled).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iconName rdf:type rdf:Property ;
    rdfs:label 'Icon Name' ;
    rdfs:comment 'Name or identifier of the icon used to represent this status in user interfaces. References standard icon library.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDays rdf:type rdf:Property ;
    rdfs:label 'Sla Days' ;
    rdfs:comment 'Target number of calendar days an acquisition should remain in this status before progressing to the next stage. Used for performance monitoring.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationDays rdf:type rdf:Property ;
    rdfs:label 'Escalation Days' ;
    rdfs:comment 'Number of days after which an acquisition in this status should be escalated to management attention if not progressed. Supports proactive management.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:federalReportingCode rdf:type rdf:Property ;
    rdfs:label 'Federal Reporting Code' ;
    rdfs:comment 'Code used for reporting acquisition status to federal agencies such as FHWA. Maps internal status to federal reporting requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stipStatusMapping rdf:type rdf:Property ;
    rdfs:label 'Stip Status Mapping' ;
    rdfs:comment 'Corresponding status code used in the State Transportation Improvement Program reporting. Enables cross-system status reconciliation.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactsProjectSchedule rdf:type rdf:Property ;
    rdfs:label 'Impacts Project Schedule' ;
    rdfs:comment 'Indicates whether acquisitions in this status are considered critical path items that could impact overall project schedule if delayed.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsModification rdf:type rdf:Property ;
    rdfs:label 'Allows Modification' ;
    rdfs:comment 'Indicates whether acquisition details can be modified when in this status. Controls data editing permissions based on lifecycle stage.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresSurvey rdf:type rdf:Property ;
    rdfs:label 'Requires Survey' ;
    rdfs:comment 'Indicates whether a property survey must be completed before or during this status. Ensures accurate property boundary definition.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAppraisal rdf:type rdf:Property ;
    rdfs:label 'Requires Appraisal' ;
    rdfs:comment 'Indicates whether a formal property appraisal must be completed before reaching this status. Ensures fair market value determination.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresTitleReview rdf:type rdf:Property ;
    rdfs:label 'Requires Title Review' ;
    rdfs:comment 'Indicates whether title examination and clearance must be completed before or during this status. Ensures clear property ownership.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'Date when this status code became active and available for use in the system. Supports temporal tracking of reference data changes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date when this status code was or will be retired from active use. Null indicates the status is currently active with no planned retirement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retirementReason rdf:type rdf:Property ;
    rdfs:label 'Retirement Reason' ;
    rdfs:comment 'Explanation of why this status code was retired or made inactive. Provides historical context for reference data changes.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementStatusCode rdf:type rdf:Property ;
    rdfs:label 'Replacement Status Code' ;
    rdfs:comment 'Code of the status that replaced this one if it was retired. Supports data migration and historical analysis.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageCount rdf:type rdf:Property ;
    rdfs:label 'Usage Count' ;
    rdfs:comment 'Number of active acquisitions currently assigned to this status. Provides operational visibility into status distribution.' ;
    rdfs:domain ind:AcquisitionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastUsedDate rdf:type rdf:Property ;
    rdfs:label 'Last Used Date' ;
    rdfs:comment 'Most recent date when this status was assigned to an acquisition. Helps identify obsolete or rarely used status codes.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:createdDate rdf:type rdf:Property ;
    rdfs:label 'Created Date' ;
    rdfs:comment 'Date when this status code record was originally created in the system. Supports audit trail and historical tracking.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedDate rdf:type rdf:Property ;
    rdfs:label 'Modified Date' ;
    rdfs:comment 'Date when this status code record was last modified. Supports change tracking and data quality monitoring.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Additional free-form notes or comments about this status code, including special handling instructions or business context.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementId rdf:type rdf:Property ;
    rdfs:label 'Easement Id' ;
    rdfs:comment 'Unique system-generated identifier for the easement record. Primary key for the easement entity.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Easement .

ind:number rdf:type rdf:Property ;
    rdfs:label 'Number' ;
    rdfs:comment 'Business-assigned unique reference number for the easement used in legal documents and external communications.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:type rdf:type rdf:Property ;
    rdfs:label 'Type' ;
    rdfs:comment 'Classification of the easement based on duration and purpose. Permanent easements grant indefinite rights, temporary easements are time-limited, perpetual easements run with the land forever, and term easements have specific end dates.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purpose rdf:type rdf:Property ;
    rdfs:label 'Purpose' ;
    rdfs:comment 'Detailed description of the intended use and purpose of the easement, such as highway construction, utility installation, drainage management, slope stabilization, or maintenance access.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:granteeName rdf:type rdf:Property ;
    rdfs:label 'Grantee Name' ;
    rdfs:comment 'Name of the entity receiving the easement rights, typically North Carolina Department of Transportation or a specific NCDOT division.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionDate rdf:type rdf:Property ;
    rdfs:label 'Acquisition Date' ;
    rdfs:comment 'Date when the easement was legally acquired by NCDOT, typically the execution date of the easement agreement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordingDate rdf:type rdf:Property ;
    rdfs:label 'Recording Date' ;
    rdfs:comment 'Date when the easement was officially recorded with the county Register of Deeds, establishing public notice of the easement.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:durationYears rdf:type rdf:Property ;
    rdfs:label 'Duration Years' ;
    rdfs:comment 'Specified duration of the easement in years for term easements. Null for permanent or perpetual easements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:areaAcres rdf:type rdf:Property ;
    rdfs:label 'Area Acres' ;
    rdfs:comment 'Total area of the easement parcel measured in acres, as determined by survey.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:widthFeet rdf:type rdf:Property ;
    rdfs:label 'Width Feet' ;
    rdfs:comment 'Width of the easement corridor in feet, applicable for linear easements such as utility or access easements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lengthFeet rdf:type rdf:Property ;
    rdfs:label 'Length Feet' ;
    rdfs:comment 'Length of the easement corridor in feet, applicable for linear easements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compensationAmount rdf:type rdf:Property ;
    rdfs:label 'Compensation Amount' ;
    rdfs:comment 'Total monetary compensation paid to the grantor for granting the easement rights, in US dollars.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appraisedValue rdf:type rdf:Property ;
    rdfs:label 'Appraised Value' ;
    rdfs:comment 'Fair market value of the easement as determined by a certified appraiser, in US dollars.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appraisalDate rdf:type rdf:Property ;
    rdfs:label 'Appraisal Date' ;
    rdfs:comment 'Date when the easement appraisal was completed.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appraiserName rdf:type rdf:Property ;
    rdfs:label 'Appraiser Name' ;
    rdfs:comment 'Name of the certified appraiser or appraisal firm that conducted the easement valuation.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'North Carolina county where the easement property is located.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:township rdf:type rdf:Property ;
    rdfs:label 'Township' ;
    rdfs:comment 'Township or municipal jurisdiction where the easement property is located.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deedBook rdf:type rdf:Property ;
    rdfs:label 'Deed Book' ;
    rdfs:comment 'Book number in the county Register of Deeds where the easement deed is recorded.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deedPage rdf:type rdf:Property ;
    rdfs:label 'Deed Page' ;
    rdfs:comment 'Page number in the deed book where the easement deed is recorded.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentNumber rdf:type rdf:Property ;
    rdfs:label 'Instrument Number' ;
    rdfs:comment 'Unique instrument or document number assigned by the Register of Deeds when the easement was recorded.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyPlatNumber rdf:type rdf:Property ;
    rdfs:label 'Survey Plat Number' ;
    rdfs:comment 'Reference number of the survey plat that depicts the easement boundaries and dimensions.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'Date when the boundary survey for the easement was completed.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyorName rdf:type rdf:Property ;
    rdfs:label 'Surveyor Name' ;
    rdfs:comment 'Name of the licensed professional land surveyor or surveying firm that conducted the easement survey.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNumber rdf:type rdf:Property ;
    rdfs:label 'Project Number' ;
    rdfs:comment 'NCDOT project identification number for the transportation project requiring this easement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeNumber rdf:type rdf:Property ;
    rdfs:label 'Route Number' ;
    rdfs:comment 'State or federal highway route number associated with the easement, such as US-1, NC-55, or I-40.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictions rdf:type rdf:Property ;
    rdfs:label 'Restrictions' ;
    rdfs:comment 'Description of any restrictions or limitations on the use of the easement, such as prohibited activities, access limitations, or environmental constraints.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encumbrances rdf:type rdf:Property ;
    rdfs:label 'Encumbrances' ;
    rdfs:comment 'Description of any existing encumbrances on the property that may affect the easement, such as mortgages, liens, or other easements.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Environmental Clearance Status' ;
    rdfs:comment 'Status of environmental clearance under NEPA for the easement acquisition and use.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalClearanceDate rdf:type rdf:Property ;
    rdfs:label 'Environmental Clearance Date' ;
    rdfs:comment 'Date when environmental clearance was granted for the easement.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:federalParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Federal Participation Flag' ;
    rdfs:comment 'Indicates whether federal funds are being used for the project requiring this easement, which triggers additional compliance requirements.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acquisitionMethod rdf:type rdf:Property ;
    rdfs:label 'Acquisition Method' ;
    rdfs:comment 'Method by which the easement was acquired from the property owner.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalDescription rdf:type rdf:Property ;
    rdfs:label 'Legal Description' ;
    rdfs:comment 'Complete legal description of the easement area as it appears in the recorded deed, including metes and bounds or lot and block references.' ;
    rdfs:domain ind:Rightofway ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStorageLocation rdf:type rdf:Property ;
    rdfs:label 'Document Storage Location' ;
    rdfs:comment 'Reference to the physical or electronic location where the original easement documents, surveys, and related materials are stored, such as SharePoint site or ProjectWise folder path.' ;
    rdfs:domain ind:Easement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationId rdf:type rdf:Property ;
    rdfs:label 'Registration Id' ;
    rdfs:comment 'Unique identifier for the vehicle registration record.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registration .

ind:plateNumber rdf:type rdf:Property ;
    rdfs:label 'Plate Number' ;
    rdfs:comment 'The license plate number displayed on the vehicle.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plateType rdf:type rdf:Property ;
    rdfs:label 'Plate Type' ;
    rdfs:comment 'The type or category of license plate issued for the vehicle.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vin rdf:type rdf:Property ;
    rdfs:label 'Vin' ;
    rdfs:comment 'The 17-character Vehicle Identification Number (VIN) uniquely identifying the vehicle.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerName rdf:type rdf:Property ;
    rdfs:label 'Owner Name' ;
    rdfs:comment 'The full legal name of the individual or entity that owns the vehicle.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerType rdf:type rdf:Property ;
    rdfs:label 'Owner Type' ;
    rdfs:comment 'The classification of the vehicle owner (individual, business, government entity, etc.).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Owner Address Line 1' ;
    rdfs:comment 'The first line of the registered owner\'s mailing address.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Owner Address Line 2' ;
    rdfs:comment 'The second line of the registered owner\'s mailing address (apartment, suite, etc.).' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerCity rdf:type rdf:Property ;
    rdfs:label 'Owner City' ;
    rdfs:comment 'The city of the registered owner\'s mailing address.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerState rdf:type rdf:Property ;
    rdfs:label 'Owner State' ;
    rdfs:comment 'The two-letter state code of the registered owner\'s mailing address.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerZipCode rdf:type rdf:Property ;
    rdfs:label 'Owner Zip Code' ;
    rdfs:comment 'The ZIP code of the registered owner\'s mailing address.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerCountry rdf:type rdf:Property ;
    rdfs:label 'Owner Country' ;
    rdfs:comment 'The three-letter country code of the registered owner\'s mailing address.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coOwnerName rdf:type rdf:Property ;
    rdfs:label 'Co Owner Name' ;
    rdfs:comment 'The full legal name of the co-owner, if applicable.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienholderName rdf:type rdf:Property ;
    rdfs:label 'Lienholder Name' ;
    rdfs:comment 'The name of the financial institution or entity holding a lien on the vehicle.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienholderAddress rdf:type rdf:Property ;
    rdfs:label 'Lienholder Address' ;
    rdfs:comment 'The mailing address of the lienholder.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienDate rdf:type rdf:Property ;
    rdfs:label 'Lien Date' ;
    rdfs:comment 'The date when the lien was placed on the vehicle.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lienReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Lien Release Date' ;
    rdfs:comment 'The date when the lien was released or satisfied.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:status rdf:type rdf:Property ;
    rdfs:label 'Status' ;
    rdfs:comment 'The current status of the vehicle registration.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Renewal Period Months' ;
    rdfs:comment 'The number of months for which the registration is valid before renewal is required.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleUse rdf:type rdf:Property ;
    rdfs:label 'Vehicle Use' ;
    rdfs:comment 'The primary use or purpose of the vehicle.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossVehicleWeight rdf:type rdf:Property ;
    rdfs:label 'Gross Vehicle Weight' ;
    rdfs:comment 'The gross vehicle weight rating in pounds, used for commercial vehicle classification and fee calculation.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Amount' ;
    rdfs:comment 'The total fee amount paid for the vehicle registration.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:highwayUseTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Highway Use Tax Amount' ;
    rdfs:comment 'The highway use tax amount paid at the time of registration.' ;
    rdfs:domain ind:Dmv ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supplementalFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Supplemental Fee Amount' ;
    rdfs:comment 'Any supplemental fees paid for specialty plates or additional services.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Fee Amount' ;
    rdfs:comment 'The total amount paid including registration fee, taxes, and supplemental fees.' ;
    rdfs:domain ind:Registration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'The method of payment used for the registration transaction.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The date when the registration transaction was processed.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'The unique transaction number assigned to the registration payment.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
    rdfs:comment 'The identifier of the Division of Motor Vehicles (DMV) agent who processed the registration.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:ObjectProperty ;
