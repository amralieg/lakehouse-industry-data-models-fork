# RDFS Schema for Business: Pc_Insurance

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/pc_insurance#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Pc_Insurance ---
ind:PcInsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Pc_Insurance' ;
    rdfs:comment 'A Property & Casualty insurer that underwrites personal and commercial lines, binds policies with coverages and endorsements, prices premium against rated risk exposures, adjudicates and pays claims, holds and develops loss reserves, cedes risk through reinsurance treaties and facultative certificates, and distributes through agents and brokers who earn commission.' .

# --- Domain Classes ---
ind:Policy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Policy' ;
    rdfs:comment 'SSOT for the policy lifecycle across personal and commercial lines: issuance, endorsements (ENDT), cancellations (CANC), renewals (REN), reinstatements, and declarations (DEC). Anchors the core lineage policy to coverage to insured risk and exposure.' .

ind:Coverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Coverage' ;
    rdfs:comment 'SSOT for coverage structures, endorsements, limits, deductibles, SIR, and exclusions attached to a policy. Manages LOB-specific forms (GL, CGL, BOP, WC, APD, BI/PD, UM/UIM, PIP, MedPay) and tracks TIV and ITV per insured location or vehicle.' .

ind:Premium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Premium' ;
    rdfs:comment 'SSOT for premium transactions: GWP, NWP, WP, EP, UEP, DAC, and billing. Owns rate calculations (RPP, ROL), installment schedules, payment applications, and billing events. Links rated risk exposures and premium back to the bound policy.' .

ind:Reinsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Reinsurance' ;
    rdfs:comment 'Owns RI treaty and facultative (FAC) placements, cession and bordereaux processing, XOL, QS, CAT XL, and CAT Bond structures. Tracks retention/limit layers, ceded premium, ceded loss, and recoverable balances per treaty or certificate.' .

ind:Riskexposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Riskexposure' ;
    rdfs:comment 'Provisional description for user-specified domain \'risk_exposure\'. Awaiting a generated description of what this domain owns.' .

ind:Claims rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Claims' ;
    rdfs:comment 'Provisional description for user-specified domain \'claims\'. Awaiting a generated description of what this domain owns.' .

ind:Reservespayments rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Reservespayments' ;
    rdfs:comment 'Provisional description for user-specified domain \'reserves_payments\'. Awaiting a generated description of what this domain owns.' .

ind:Producers rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Producers' ;
    rdfs:comment 'Provisional description for user-specified domain \'producers\'. Awaiting a generated description of what this domain owns.' .

ind:Shared rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PcInsurance ;
    rdfs:label 'Shared' ;
    rdfs:comment 'Cross-domain shared reference entities (currency, UoM, calendar, classification) consolidated for Single Source of Truth (SSOT).' .

# --- Data Product Classes (Tables) ---
ind:ProducersProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producers Producer' ;
    rdfs:comment 'SSOT master for every licensed insurance producer (agent or broker) appointed by the carrier. Owns producer identity, NPN, FEIN/SSN, entity type, and active status across all lines of business.' .

ind:ProducerLicense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer License' ;
    rdfs:comment 'State-issued insurance license held by a producer, including license number, line of authority (LOB), state jurisdiction, issue date, expiration date, and current status per DOI records.' .

ind:Appointment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Appointment' ;
    rdfs:comment 'Formal carrier appointment authorizing a producer to sell specific LOBs in a given state on behalf of Pc_Insurance. Tracks appointment status, effective/expiration dates, and DOI filing reference.' .

ind:Agency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Agency' ;
    rdfs:comment 'Master record for an agency or brokerage firm through which producers operate. Captures agency name, FEIN, DBA, principal address, agency type, and E&O coverage details.' .

ind:AgencyProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Agency Producer' ;
    rdfs:comment 'Junction table associating producers to agencies, capturing role, start/end dates, and whether the producer is the principal or sub-agent within the agency hierarchy.' .

ind:EnoPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Eno Policy' ;
    rdfs:comment 'Errors and Omissions (E&O) insurance policy held by a producer or agency. Tracks insurer, policy number, coverage limit, effective/expiration dates, and compliance status required for appointment.' .

ind:CommissionSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Schedule' ;
    rdfs:comment 'Reference schedule defining base commission rates, contingent bonus tiers, and override percentages by LOB, policy transaction type (NB, REN), and producer tier. SSOT for commission rate configuration.' .

ind:CommissionTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Transaction' ;
    rdfs:comment 'Individual commission earned or adjusted for a producer on a specific policy transaction. FKs to producer, commission_schedule, and commission_statement. Captures GWP basis, rate, earned amount, type (NB, REN, ENDT, CANC), and payment status.' .

ind:CommissionStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Commission Statement' ;
    rdfs:comment 'Periodic statement issued to a producer or agency summarizing commission transactions within a settlement period. FKs to producer. Tracks statement date, total earned, adjustments, net payable, and payment reference.' .

ind:ContingentBonus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Contingent Bonus' ;
    rdfs:comment 'Contingent or profit-sharing bonus calculated for a producer or agency based on loss ratio, premium volume, and growth targets over a measurement period. Tracks earned amount, LR threshold, and payment status.' .

ind:ProducerAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Agreement' ;
    rdfs:comment 'Contractual producer agreement between Pc_Insurance and a producer or agency defining compensation terms, binding authority, LOB scope, territory, and compliance obligations. Tracks version, effective dates, and signatory.' .

ind:BindingAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Binding Authority' ;
    rdfs:comment 'Delegated binding authority granted to a producer or MGA specifying maximum policy limit, eligible LOBs, geographic territory, and risk class restrictions. Tracks authority ceiling, expiration, and suspension flags.' .

ind:OnboardingCase rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Onboarding Case' ;
    rdfs:comment 'Single authoritative producer onboarding and compliance case covering application intake, background check, license verification, DOI disciplinary and market-conduct review, and OFAC/sanctions screening through appointment filing and system activation.' .

ind:Termination rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Termination' ;
    rdfs:comment 'Records the termination or non-renewal of a producer appointment or agreement, including termination reason code, for-cause flag, effective date, state notification requirement, and regulatory reporting status.' .

ind:ProducerCompliance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Producer Compliance' ;
    rdfs:comment 'Compliance and onboarding case for a producer tracking background check, license verification, DOI disciplinary orders, market conduct findings, and OFAC/sanctions screening status through activation.' .

ind:Territory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Territory' ;
    rdfs:comment 'Geographic territory assigned to a producer or agency by state, county, and ZIP-code range with LOB scope. Supports territory management, conflict resolution, and production roll-up.' .

ind:Policy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy' ;
    rdfs:comment 'Master record for a P&C policy across personal and commercial lines. SSOT for policy identity, LOB and NAIC line code, term dates, and status. Anchors the lifecycle: NB, REN, ENDT, CANC, reinstatement, non-renewal.' .

ind:Version rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Version' ;
    rdfs:comment 'Immutable snapshot of a policy at each transaction (NB, ENDT, REN, CANC, reinstatement). Tracks effective and expiration dates per version, enabling full audit lineage of policy changes over time.' .

ind:PolicyCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Coverage' ;
    rdfs:comment 'Junction table resolving the M:N relationship between policies and coverages. Carries coverage-specific limits, deductibles, SIR, and effective dates as they apply to a specific policy version.' .

ind:PolicyInsured rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Insured' ;
    rdfs:comment 'Master record for the named insured or additional insured on a policy. Captures party identity (individual or commercial entity), FEIN/SSN, DBA, and insured type. SSOT for insured party within the policy domain.' .

ind:Insured rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Insured' ;
    rdfs:comment 'Association table linking insureds to a policy version with role (named insured, additional insured, loss payee, mortgagee). Supports multiple insured parties per policy and tracks role effective dates.' .

ind:Declarations rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Declarations' ;
    rdfs:comment 'DEC page record for a policy version: summarizes insured name, policy number, LOB, coverage summary, TIV, total premium, and effective/expiration dates. Represents the formal policy document snapshot issued to the insured.' .

ind:UwDecision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Uw Decision' ;
    rdfs:comment 'Underwriting decision record for a policy submission or renewal: UW action (accept, decline, refer, modify), decision date, UW authority level, reason codes, and any conditions or exclusions imposed.' .

ind:Quote rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Quote' ;
    rdfs:comment 'Pre-bind quote and temporary binder: rated premium, coverage options, TIV, quote and binder effective/expiration dates, binding authority, binder number, and status (draft, presented, bound, declined).' .

ind:Submission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Submission' ;
    rdfs:comment 'Underwriting submission record representing an application for coverage: submission date, source channel, LOB, applicant details, risk information, and submission status (new, in-review, quoted, bound, declined).' .

ind:PolicyProducer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Producer' ;
    rdfs:comment 'Junction table linking a policy to the writing producer (agent/broker) and servicing producer. Captures producer role, commission split percentage, appointment effective date, and producer code.' .

ind:StatusHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Status History' ;
    rdfs:comment 'Audit trail of all policy status transitions (active, cancelled, lapsed, expired, reinstated, non-renewed). Records prior status, new status, transition timestamp, and the triggering transaction reference.' .

ind:PolicyForm rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Form' ;
    rdfs:comment 'Reference catalog of policy forms and ISO form numbers used across LOBs: form number, edition date, form type (base, endorsement, exclusion), applicable states, and regulatory filing status.' .

ind:Condition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Condition' ;
    rdfs:comment 'Records special conditions, warranties, and UW requirements attached to a policy version: condition type, description, compliance due date, and whether the condition has been satisfied or is outstanding.' .

ind:Document rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Document' ;
    rdfs:comment 'Metadata registry for policy documents: DEC page instance, ENDT, CANC notice, binder, and COI. Stores document type, DEC snapshot fields, certificate-holder details, generation date, delivery method, and CMS reference.' .

ind:Binder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Binder' ;
    rdfs:comment 'Temporary insurance binder record providing coverage confirmation prior to formal policy issuance. Captures binder number, effective date, expiration date, coverage summary, and binding authority used.' .

ind:PolicyRateFiling rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Rate Filing' ;
    rdfs:comment 'Reference record for approved rate and form filings with state DOIs. Tracks filing number, LOB, effective date, state, filing type (rate, rule, form), approval status, and SERFF tracking number.' .

ind:CoveragePolicyCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Policy Coverage' ;
    rdfs:comment 'Junction table resolving the M:N relationship between policies and coverage forms. Carries effective/expiration dates, coverage status, and sequence order. SSOT for which coverages are attached to a given policy term.' .

ind:CoverageForm rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Form' ;
    rdfs:comment 'Master catalog of ISO and proprietary coverage forms available for each LOB (GL, CGL, BOP, WC, APD, BI/PD, UM/UIM, PIP, MedPay). Defines form number, edition date, filing jurisdiction, and applicable line of business.' .

ind:Part rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Part' ;
    rdfs:comment 'Represents a discrete coverage part within a policy (e.g., CGL Coverage Part, Commercial Property Part, WC and EL Part). Groups related coverage forms under a single insuring agreement within a CPP or BOP structure.' .

ind:Limit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Limit' ;
    rdfs:comment 'SSOT for coverage limit structures per attached coverage: per-occurrence, aggregate, per-person, split, CSL, and peril-specific sublimits modeled via self-referencing parent-limit link.' .

ind:Deductible rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Deductible' ;
    rdfs:comment 'SSOT for deductible and self-insured retention (SIR) per attached coverage: flat, percentage, split, disappearing, and SIR-layer structures. Captures amount, basis, application method, defense-inside-SIR flag, aggregate SIR cap, and erosion basis.' .

ind:SirLayer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Sir Layer' ;
    rdfs:comment 'Self-Insured Retention layer record for large commercial and excess policies. Tracks SIR amount, defense-inside vs outside SIR flag, aggregate SIR cap, and erosion basis (paid vs incurred).' .

ind:Endorsement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Endorsement' ;
    rdfs:comment 'ENDT records modifying, adding, or deleting coverage on a policy, including AI grants, subrogation waivers, and mid-term amendments. Captures endorsement type, form number, edition/effective date, premium impact, beneficiary/scope, and prior vs new values.' .

ind:Exclusion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Exclusion' ;
    rdfs:comment 'Coverage exclusions, sublimits, conditions, and warranties attached to a coverage form or endorsement. Records clause type, peril/property class scope, and sublimit amount.' .

ind:InsuredLocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Insured Location' ;
    rdfs:comment 'Master SSOT for a physical premises or location insured under a P&C policy. Captures address, COPE attributes, occupancy, TIV, protection class, and geocode.' .

ind:AdditionalInsured rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Additional Insured' ;
    rdfs:comment 'Additional insured (AI) endorsement records granting third-party coverage rights on a policy. Captures AI name, relationship type (lessor, lender, owner), endorsement form, and scope of coverage granted.' .

ind:NamedInsured rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Named Insured' ;
    rdfs:comment 'Named insured parties listed on the declarations page (DEC) of a policy. Supports multiple named insureds per policy with role (first named, additional named), FEIN/SSN reference, and DBA name.' .

ind:Amendment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Amendment' ;
    rdfs:comment 'Tracks mid-term amendments to coverage terms (limit changes, deductible changes, added/removed locations or vehicles) outside of a full endorsement cycle. Records change reason, effective date, and prior vs new values.' .

ind:ItvAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Itv Assessment' ;
    rdfs:comment 'Insurance-to-Value (ITV) assessment records for insured property locations. Captures assessed replacement cost value (RCV), reported TIV, ITV ratio, assessment method (Marshall Swift, CoreLogic), and coinsurance penalty flag.' .

ind:CoveragePeril rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Coverage Peril' ;
    rdfs:comment 'Reference catalog of insured and excluded perils (fire, wind, hail, flood, earthquake, theft, liability). Stores ISO peril code, peril category, CAT designation flag, and NFIP overlap indicator.' .

ind:Peril rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Peril' ;
    rdfs:comment 'Junction table associating coverage forms with the specific perils they insure or exclude. Carries insured/excluded flag, sublimit linkage, and peril-specific deductible override for each coverage-peril combination.' .

ind:ScheduledItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Scheduled Item' ;
    rdfs:comment 'Individually scheduled personal or commercial property items (jewelry, fine art, equipment, tools). Stores item description, agreed value, appraisal date, serial number, and blanket vs scheduled coverage flag.' .

ind:WaiverOfSubrogation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Waiver Of Subrogation' ;
    rdfs:comment 'Waiver of subrogation endorsement records granting a third party immunity from recovery actions. Captures beneficiary name, relationship, endorsement form number, and effective coverage scope.' .

ind:ReservespaymentsLossReserve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Reservespayments Loss Reserve' ;
    rdfs:comment 'SSOT for case reserves (OCR) established per claim. Tracks initial reserve, current reserve, IBNR allocation, IBNER adjustments, ALAE/ULAE splits, and reserve adequacy status per line of business.' .

ind:ReservespaymentsReserveTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Reservespayments Reserve Transaction' ;
    rdfs:comment 'Transactional ledger of every reserve movement (set, increase, decrease, close) against a loss reserve. Captures transaction date, amount delta, reserve type (loss vs ALAE), and authorizing adjuster.' .

ind:IbnrEstimate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Ibnr Estimate' ;
    rdfs:comment 'Actuarial bulk-reserve SSOT for IBNR, IBNER, and unallocated ULAE positions by LOB, accident year, and evaluation date, with optional CAT-code tagging.' .

ind:ReserveEvaluation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Reserve Evaluation' ;
    rdfs:comment 'Periodic actuarial reserve evaluation SSOT (quarterly/annual): gross and net reserve positions, ULR/loss ratio, embedded loss development triangles, actuarial opinion reference, and NAIC Schedule P / state DOI statutory exhibits, signed off for statutory' .

ind:ReservespaymentsClaimPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Reservespayments Claim Payment' ;
    rdfs:comment 'Junction table for the many-to-many relationship between claims and payments. Captures payment allocation per claim, coverage part, payment type (indemnity, ALAE, MedPay, PIP), and net-of-recovery amount.' .

ind:PaymentTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Payment Transaction' ;
    rdfs:comment 'Master record of every outbound loss payment issued (check, EFT, wire). Tracks payee, payment method, gross amount, void/reissue status, bank clearing date, and GL posting reference. Source: ClaimCenter / Oracle AP.' .

ind:RecoveryTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Recovery Transaction' ;
    rdfs:comment 'Records all inbound recoveries against paid losses: subrogation (SubroFT), salvage, reinsurance recoverable, and second-injury fund. Tracks recovery type, gross recovery, net recovery, and collection status.' .

ind:SubrogationCase rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Subrogation Case' ;
    rdfs:comment 'Master record for a subrogation pursuit against a liable third party. Tracks demand amount, collected amount, attorney assignment, statute of limitations date, settlement status, and net recovery after expenses.' .

ind:SalvageItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Salvage Item' ;
    rdfs:comment 'Tracks physical salvage property taken title to after a total-loss settlement. Records ACV at loss, salvage proceeds, disposal method (auction, scrap), and net salvage recovery credited back to the claim.' .

ind:LaeAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Lae Allocation' ;
    rdfs:comment 'Allocates LAE (ALAE and ULAE) costs to individual claims or claim groups. Captures expense category, allocated amount, allocation method, and period. Supports combined ratio (CR) and expense ratio (ER) reporting.' .

ind:PaymentAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Payment Authority' ;
    rdfs:comment 'Defines payment authority limits by adjuster role, LOB, and coverage type. Stores approval threshold, escalation path, effective date, and delegated authority level. Governs payment approval workflow in ClaimCenter.' .

ind:PaymentApproval rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Payment Approval' ;
    rdfs:comment 'Workflow record for payment requests requiring supervisory or management approval above adjuster authority. Tracks requested amount, approver, approval date, approval status, and override justification.' .

ind:Payee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Payee' ;
    rdfs:comment 'Master record of all parties eligible to receive loss payments: claimants, attorneys, medical providers, repair vendors, and mortgagees. Stores payee type, tax ID (SSN/FEIN), banking details, and 1099 reporting flag.' .

ind:ReinsuranceRecoverable rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Reinsurance Recoverable' ;
    rdfs:comment 'Tracks amounts recoverable from reinsurers on paid and reserved losses under treaty and facultative (FAC) agreements. Records cession reference, gross loss, RI share, collected amount, and collectability status.' .

ind:StructuredSettlement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Structured Settlement' ;
    rdfs:comment 'Records periodic-payment structured settlement agreements that replace lump-sum indemnity. Captures annuity provider, present value, payment schedule, guarantee period, and assignment to a qualified assignment company.' .

ind:DevelopmentTriangle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Development Triangle' ;
    rdfs:comment 'Stores loss development triangle data by LOB, accident year, and development age. Captures cumulative paid loss, cumulative incurred loss, and earned premium for each evaluation period. Source: Milliman Arius / WTW ResQ.' .

ind:StatReserveExhibit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Stat Reserve Exhibit' ;
    rdfs:comment 'Statutory reserve exhibit prepared for NAIC Annual Statement Schedule P and state DOI filings. Captures net and gross reserve positions, loss ratio, and actuarial opinion reference by LOB and accident year.' .

ind:RiTreaty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Treaty' ;
    rdfs:comment 'Master record for each reinsurance treaty (XOL, QS, CAT XL, CAT Bond) placed by Pc_Insurance. Captures treaty type, structure, effective/expiry dates, reinsurer panel, retention, limit, and placement status.' .

ind:FacCertificate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Fac Certificate' ;
    rdfs:comment 'Master record for each facultative (FAC) reinsurance certificate placed on a specific risk or policy. Tracks FAC type, ceded limit, ceded premium, reinsurer, and certificate status independent of treaty structures.' .

ind:TreatyLayer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty Layer' ;
    rdfs:comment 'Defines each retention/limit layer within a treaty (e.g., first XOL layer, second XOL layer, QS tranche). Stores attachment point, limit, ROL, and layer sequence for multi-layer treaty structures.' .

ind:Reinsurer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Reinsurer' ;
    rdfs:comment 'Master record for each reinsurance counterparty (reinsurer or retrocessionaire). Captures legal name, NAIC code, A.M. Best rating, domicile, authorized status, and credit limit for counterparty risk management.' .

ind:TreatyReinsurer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Treaty Reinsurer' ;
    rdfs:comment 'Junction table linking a treaty to its participating reinsurers with each reinsurer\'s subscribed share percentage, signed line, written line, and participation status. Supports multi-reinsurer panel structures.' .

ind:ReinsuranceCession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Reinsurance Cession' ;
    rdfs:comment 'Transactional cession event linking a ceded policy or risk exposure to a treaty or FAC certificate via foreign keys. Captures ceded TIV, premium, limit, retention, effective date, share, per-policy endorsement reference, and cession basis (pro-rata or' .

ind:PolicyCession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Policy Cession' ;
    rdfs:comment 'Junction table resolving the many-to-many relationship between policies and cessions. Tracks which policies are ceded under which cession records, with ceded share, effective period, and endorsement reference per policy-cession pairing.' .

ind:Bordereaux rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Bordereaux' ;
    rdfs:comment 'Periodic bordereaux submission record sent to reinsurers summarizing ceded premium and loss activity for a treaty period. Captures bordereaux type (premium or loss), reporting period, submission date, and aggregate ceded amounts.' .

ind:BordereauxLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Bordereaux Line' ;
    rdfs:comment 'Individual line item within a bordereaux submission representing one cession or claim entry. Stores policy reference, ceded premium, ceded loss, ceded LAE, and line-level status for granular bordereaux reconciliation.' .

ind:CededPremiumTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ceded Premium Transaction' ;
    rdfs:comment 'Transactional record of each ceded premium movement (written, earned, return) under a treaty or FAC certificate. Tracks GWP ceded, NWP ceded, UEP ceded, DAC ceded, accounting period, and settlement status.' .

ind:CededLossTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ceded Loss Transaction' ;
    rdfs:comment 'Ledger of each ceded loss, LAE, and reserve movement (paid, case/OCR, IBNR, IBNER) reported to a reinsurer under a treaty or FAC. Single owner of ceded reserve balances after ri_loss_reserve merge.' .

ind:RiRecoverable rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Recoverable' ;
    rdfs:comment 'Tracks outstanding reinsurance recoverable balances and ceded loss reserves (OCR, IBNR, IBNER) owed by reinsurers for paid and reserved losses under treaty and FAC agreements.' .

ind:RiSettlement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Settlement' ;
    rdfs:comment 'Records each account-current statement and cash settlement of net balances between Pc_Insurance and a reinsurer for a treaty period.' .

ind:ClaimRiRecovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Claim Ri Recovery' ;
    rdfs:comment 'Junction table resolving the many-to-many relationship between claims and reinsurance recoveries. Links a specific claim to one or more treaty/FAC recoveries, capturing recovered amount, recovery basis, and payment reference per claim-recovery pairing.' .

ind:CatBond rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Cat Bond' ;
    rdfs:comment 'Master record for each catastrophe bond (CAT Bond) instrument issued or held by Pc_Insurance. Tracks trigger type (indemnity, parametric, index), attachment, exhaustion, coupon, maturity date, SPV details, and outstanding notional.' .

ind:ProfitCommission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Profit Commission' ;
    rdfs:comment 'Tracks profit commission calculations and accruals owed to Pc_Insurance under QS treaties with profit commission clauses. Stores loss ratio threshold, sliding scale parameters, calculated commission rate, and accrued commission amount.' .

ind:Reinstatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Reinstatement' ;
    rdfs:comment 'Records reinstatement of treaty limit following a loss occurrence under XOL or CAT XL treaties. Captures reinstatement premium, reinstated limit, occurrence reference, reinstatement number, and effective date per treaty layer.' .

ind:RiBroker rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Broker' ;
    rdfs:comment 'Master record for each reinsurance intermediary (RI broker) involved in treaty or FAC placement. Captures broker legal name, Lloyd\'s registration, brokerage rate, contact details, and authorized markets for placement management.' .

ind:RiPlacement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Ri Placement' ;
    rdfs:comment 'Tracks the placement workflow for a treaty or FAC certificate from slip submission through binding. Captures placement stage, market approached, lead reinsurer, signed line percentage, brokerage, and binding date.' .

ind:OccurrenceLoss rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reinsurance ;
    rdfs:label 'Occurrence Loss' ;
    rdfs:comment 'Aggregates losses from multiple claims into a single occurrence for XOL treaty application. Stores occurrence date, peril, total gross loss, total ceded loss, applicable treaty layer, and hours clause compliance flag.' .

ind:InsuredVehicle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Insured Vehicle' ;
    rdfs:comment 'Master SSOT for a motor vehicle insured under a personal or commercial auto policy. Stores VIN, year, make, model, body type, garaging address, usage, and symbol.' .

ind:InsuredEntity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Insured Entity' ;
    rdfs:comment 'Master record for a named insured party (individual, household, or commercial entity) tied to a risk exposure. Captures legal name, FEIN or SSN, NAICS/SIC code, DBA, entity type, and underwriting tier.' .

ind:RiskUnit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Unit' ;
    rdfs:comment 'Atomic unit of insurable risk on a policy (building, vehicle, employee class, or GL operation). Single SSOT for rated exposure quantity, SI, TIV, exposure base, payroll, and LOB risk characteristics. Anchors the policy-coverage-exposure FK lineage.' .

ind:CatZone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Cat Zone' ;
    rdfs:comment 'Reference for catastrophe peril zones (hurricane, quake, flood, wildfire, hail) mapped to geography. Stores PML tier, CAT loading, FEMA/NFIP flood zone code, BFE, FIRM panel, and mandatory-purchase indicator for flood compliance.' .

ind:RiskCharacteristic rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Characteristic' ;
    rdfs:comment 'Stores LOB-specific underwriting characteristics for a risk unit (e.g., roof age, alarm type, sprinkler system, driver age, MVR points, years in business). Each row is one characteristic name-value pair per risk unit.' .

ind:ExposurePeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Exposure Period' ;
    rdfs:comment 'Tracks the effective date range during which a risk unit is on-risk within a policy term. Captures written exposure, earned exposure, and mid-term changes due to endorsements, cancellations, or reinstatements.' .

ind:UwSurvey rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Uw Survey' ;
    rdfs:comment 'Underwriting field survey or inspection record for a risk unit. Captures survey date, inspector, findings, recommended improvements, UW action (accept, decline, refer), and survey source (internal, ISO, third-party).' .

ind:MvrReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Mvr Report' ;
    rdfs:comment 'Motor Vehicle Report obtained for a driver risk unit. Stores pull date, license state, license number, violation count, accident count, MVR score, and source (CLUE Auto / state DMV). Used in personal and commercial auto UW.' .

ind:ClueReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Clue Report' ;
    rdfs:comment 'Comprehensive Loss Underwriting Exchange (CLUE) property or auto loss history report for an insured entity or vehicle. Captures report date, prior carrier, prior losses, and CLUE score used in UW risk selection.' .

ind:TivSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Tiv Schedule' ;
    rdfs:comment 'Schedule of Total Insured Values for a commercial property or inland marine risk. Each row represents one scheduled item (building, contents, equipment) with its SI, RCV, ACV, and depreciation basis.' .

ind:WcPayrollClass rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Wc Payroll Class' ;
    rdfs:comment 'Master SSOT linking an employer risk unit to an NCCI or state WC classification code with payroll basis, rate, and manual premium.' .

ind:DriverAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Driver Assignment' ;
    rdfs:comment 'Junction table assigning a driver (insured entity) to an insured vehicle on a policy. Captures principal vs. occasional driver designation, assignment effective date, and usage percentage. Supports auto rating and UW.' .

ind:RiskScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Underwriting risk score record for a risk unit derived from third-party models (ISO FireLine, Verisk Wildfire, LexisNexis, credit-based insurance score). Stores score value, model version, pull date, and score tier.' .

ind:PmlEstimate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Pml Estimate' ;
    rdfs:comment 'Probable Maximum Loss estimate for a property or CAT-exposed risk unit. Stores PML percentage, scenario (1-in-100, 1-in-250), peril, model vendor (AIR, RMS, CoreLogic), run date, and gross vs. net of reinsurance values.' .

ind:FloodZoneAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Flood Zone Assignment' ;
    rdfs:comment 'FEMA/NFIP flood zone designation assigned to an insured location. Stores flood zone code, BFE (Base Flood Elevation), FIRM panel number, determination date, and mandatory purchase indicator for mortgage compliance.' .

ind:GlOperation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Gl Operation' ;
    rdfs:comment 'General Liability operations record describing the business activities of a commercial insured risk unit. Stores ISO GL class code, operation description, receipts, area, payroll, and products-completed operations split.' .

ind:ScheduledEquipment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Scheduled Equipment' ;
    rdfs:comment 'Scheduled inland marine or equipment floater item record. Captures equipment type, serial number, year, ACV, RCV, location, and blanket vs. specific coverage designation. Used for CPP and BOP equipment scheduling.' .

ind:ExperienceMod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Experience Mod' ;
    rdfs:comment 'Experience modification factor (EMod) record for a WC or GL insured, including WC payroll classification linkage. Stores NCCI or state bureau EMod value, effective date, interstate designation, primary and excess loss components, and history.' .

ind:SirRetention rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Sir Retention' ;
    rdfs:comment 'Self-Insured Retention or large deductible program record for a commercial risk. Stores SIR amount, aggregate limit, collateral type, collateral amount, loss fund, and program administrator. Links to the risk unit and policy.' .

ind:RiskChangeEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Risk Change Event' ;
    rdfs:comment 'Transactional record of a mid-term change to a risk unit (e.g., location added, vehicle replaced, payroll updated, construction upgrade). Captures change type, effective date, prior and new values, and triggering endorsement.' .

ind:WrittenPremium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Written Premium' ;
    rdfs:comment 'SSOT for gross written premium (GWP) transactions per policy term. Captures WP, NWP, ceded premium, and net retained amounts at policy/coverage level. Anchors the premium ledger for statutory and GAAP reporting.' .

ind:EarnedPremium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Earned Premium' ;
    rdfs:comment 'Tracks EP recognized over the policy exposure period via pro-rata or short-rate earning methods. Supports UEP calculation, GAAP revenue recognition, and IFRS 17 premium allocation approach.' .

ind:PremiumTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Premium Transaction' ;
    rdfs:comment 'Atomic premium ledger entry and single SSOT for every premium movement: new business, endorsement AP/RP, cancellation, reinstatement, audit, return premium, refund disbursement, and write-off.' .

ind:RateElement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Rate Element' ;
    rdfs:comment 'Master catalog of individual rating factors and their values used in premium computation: base rates, class factors, territory multipliers, schedule credits/debits, and ISO RPP elements. SSOT for rate content.' .

ind:RateTable rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Rate Table' ;
    rdfs:comment 'Versioned rate table and single SSOT for all rate content: base rates, class/territory factors, schedule credits/debits, and ISO RPP elements, held as rows grouped by LOB, state, effective date, and filing across multi-tier plans.' .

ind:RatingWorksheet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Rating Worksheet' ;
    rdfs:comment 'Step-by-step premium calculation audit trail for a quoted or bound risk. Captures each rating step, applied factor, intermediate result, and final charged premium. Supports UW review and rate adequacy audits.' .

ind:BillingAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Billing Account' ;
    rdfs:comment 'Master billing account grouping one or more policies under a single payer relationship. Manages payment plan, billing method (direct bill vs. agency bill), and account-level balance. SSOT for payer identity in billing.' .

ind:InstallmentSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Installment Schedule' ;
    rdfs:comment 'Payment-plan definition and instantiated billing schedule for an account or policy: plan code/name, installment count, down payment, due dates, amounts, fees, and eligibility by LOB and state.' .

ind:Installment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Installment' ;
    rdfs:comment 'Individual installment due record within a schedule: due date, billed amount, paid amount, outstanding balance, and delinquency status. Drives billing notices, late fees, and cancellation-for-nonpayment workflows.' .

ind:Payment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Payment' ;
    rdfs:comment 'Records each premium payment received: date, amount, method (check, ACH, card), and any unapplied suspense balance pending policy/account matching. Applied to installments via the payment_application junction.' .

ind:PaymentApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Payment Application' ;
    rdfs:comment 'Junction table resolving the many-to-many relationship between premium payments and installments. Records applied amount, application date, and sequence. Enables full cash application audit trail.' .

ind:DacTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Dac Transaction' ;
    rdfs:comment 'Deferred Acquisition Cost transaction recording capitalized and amortized DAC amounts per policy. Tracks DAC asset balance, amortization schedule, and write-off events per US GAAP ASC 944 and IFRS 17.' .

ind:MinimumEarnedPremium rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Minimum Earned Premium' ;
    rdfs:comment 'Defines the minimum earned premium (MEP) threshold per policy or coverage. Enforces MEP on short-rate cancellations and ensures minimum retained premium per regulatory and contractual requirements.' .

ind:SurplusLinesTax rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Surplus Lines Tax' ;
    rdfs:comment 'Surplus lines tax and stamping fee record per non-admitted policy. Captures state-specific tax rates, stamping office fees, diligent search requirements, and remittance due dates per state DOI surplus lines regulations.' .

ind:FinanceAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Finance Agreement' ;
    rdfs:comment 'Records premium financing arrangements where a third-party premium finance company funds the policy premium. Tracks financed amount, interest rate, repayment schedule, and power-of-attorney cancellation rights.' .

ind:PremiumRateFiling rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Premium Rate Filing' ;
    rdfs:comment 'Tracks state rate and rule filing submissions to DOI: filing number, LOB, effective date, approval status, SERFF tracking number, and rate change percentage. SSOT for regulatory rate approval lifecycle.' .

ind:AgencyBillStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Premium ;
    rdfs:label 'Agency Bill Statement' ;
    rdfs:comment 'Monthly agency bill statement sent to producing agents/brokers summarizing net premiums due, commissions retained, and balance owed. Supports agency bill reconciliation and producer account settlement.' .

ind:Fnol rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Fnol' ;
    rdfs:comment 'First Notice of Loss record capturing initial claim intake: date of loss, loss location, reported peril, claimant contact, policy reference, and FNOL channel. SSOT for claim origination events.' .

ind:Claim rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim' ;
    rdfs:comment 'Master P&C claim record for a loss event: claim number, line of business, coverage type, loss cause, CAT code, open/closed status, adjuster assignment, and total incurred. SSOT for claim activity.' .

ind:Claimant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claimant' ;
    rdfs:comment 'Party asserting a loss under a claim: name, role (insured, third-party, lienholder), contact details, injury/damage type, representation status, and attorney info. Supports BI, PD, PIP, and WC claimant tracking.' .

ind:ClaimCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Coverage' ;
    rdfs:comment 'Junction resolving the many-to-many claim-to-coverage relationship: applicable limit, deductible, SIR, coverage part, and coverage-level incurred amounts for each policy coverage triggered by the loss.' .

ind:ClaimsLossReserve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claims Loss Reserve' ;
    rdfs:comment 'Case reserve for a claim or claim-coverage line: OCR amount, ALAE reserve, reserve type (case/IBNR/IBNER), set date, basis, and actuarial segment. SSOT for reserve development fed to actuarial reserving.' .

ind:ClaimsReserveTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claims Reserve Transaction' ;
    rdfs:comment 'Audit-grade ledger of every reserve movement on a claim: prior amount, new amount, delta, transaction type (set/increase/decrease/close), and authorizing adjuster. Supports IBNR development and NAIC Schedule P triangles.' .

ind:ClaimsClaimPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claims Claim Payment' ;
    rdfs:comment 'Junction table linking a claim (or claim-coverage line) to a disbursement: payee, payment amount, payment type (indemnity/ALAE/ULAE/subrogation recovery), check number, and payment date. Resolves the many-to-many claim-to-payment relationship.' .

ind:Disbursement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Disbursement' ;
    rdfs:comment 'Financial disbursement record for a claim payment: payee party, bank/check details, gross amount, net amount, withholding, void flag, EFT/check indicator, and GL posting reference. SSOT for claim cash outflow.' .

ind:Adjuster rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Adjuster' ;
    rdfs:comment 'Claims adjuster master: staff or independent adjuster name, license number, state appointments, adjuster type (staff/IA/TPA), specialization (CAT/auto/GL/WC), and current workload capacity. SSOT for adjuster identity.' .

ind:AdjusterAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Adjuster Assignment' ;
    rdfs:comment 'Assignment of an adjuster to a claim: assignment date, role (primary/supervisor/CAT/specialist), reassignment reason, and active flag. Tracks adjuster workload and claim ownership history.' .

ind:ClaimNote rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Note' ;
    rdfs:comment 'Structured diary and activity note on a claim: note type (diary/coverage/legal/medical), author, note date, body text, confidentiality flag, and linked activity. Supports adjudication audit trail and litigation management.' .

ind:ClaimDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Document' ;
    rdfs:comment 'Document attached to a claim: document type (police report/medical record/estimate/DEC page), source system, file reference (OpenText/FileNet), upload date, author, and retention class. Supports adjudication and litigation.' .

ind:Litigation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Litigation' ;
    rdfs:comment 'Litigation record for a claim in suit: plaintiff attorney, defense counsel, court jurisdiction, suit filed date, trial date, verdict amount, settlement amount, and litigation status. Tracks legal exposure and LAE spend.' .

ind:MedicalBill rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Medical Bill' ;
    rdfs:comment 'Medical bill record for BI, PIP, MedPay, or WC claims: provider NPI, bill date, CPT codes, billed amount, allowed amount, paid amount, bill review outcome, and fee schedule applied. Supports medical cost containment.' .

ind:DamageEstimate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Damage Estimate' ;
    rdfs:comment 'Property or vehicle damage estimate: estimator type (staff/IA/vendor), estimate date, RCV amount, ACV amount, depreciation, repair vs. total-loss decision, and vendor reference. Supports APD and property claim settlement.' .

ind:ServiceVendor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Service Vendor' ;
    rdfs:comment 'Third-party service vendor engaged on a claim: vendor type (body shop/restoration/IA/attorney/IME/nurse case manager), TIN, license, preferred-vendor flag, state approvals, and performance tier. SSOT for claim vendor master.' .

ind:CatEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Cat Event' ;
    rdfs:comment 'Catastrophe event master: CAT code (ISO/PCS), event name, peril type, affected states/counties, open/close dates, industry loss estimate, and PML tier. SSOT for CAT claim aggregation and CAT XL triggering.' .

ind:ClaimStatusHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Status History' ;
    rdfs:comment 'Immutable log of every claim status transition: prior status, new status, transition reason, effective timestamp, and acting user. Supports SLA compliance, adjudication audit, and regulatory reporting.' .

ind:FraudReferral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Fraud Referral' ;
    rdfs:comment 'Operational SIU fraud referral record for a claim: referral date, referral reason, SIU investigator assigned, investigation status, outcome (confirmed fraud/unfounded/pending), and recovery amount. Supports SIU workflow.' .

ind:Exposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Exposure' ;
    rdfs:comment 'Junction resolving the M:N between coverage_policy_coverage and insured exposures (insured_location, scheduled_vehicle, scheduled_item). Carries applied limit, deductible, and coverage scope per exposure.' .

ind:PolicyTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Policy Transaction' ;
    rdfs:comment 'Unified transaction ledger per policy version: transaction type (NB, ENDT, CANC, REN, reinstatement, non-renewal), effective date, premium impact, reason code, initiating party, form/ISO reference, and notice-compliance fields.' .

ind:Currency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Currency' ;
    rdfs:comment 'Reference catalog of ISO 4217 currency codes used across premium, claims, reserve, and reinsurance monetary amounts. Stores code, name, minor unit, and active flag.' .

ind:State rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'State' ;
    rdfs:comment 'Reference catalog of US states and territories used for filings, licensing, garaging, and jurisdiction. Stores FIPS code, postal abbreviation, DOI reference, and region.' .

ind:Country rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Country' ;
    rdfs:comment 'Reference catalog of ISO 3166 country codes used for addresses, reinsurers, and party identification. Stores alpha-2, alpha-3, numeric code, and name.' .

ind:OrgUnit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Org Unit' ;
    rdfs:comment 'Reference hierarchy of internal organizational units (branch, region, business unit, cost center) used to attribute policies, claims, and financial transactions.' .

ind:LobCode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Lob Code' ;
    rdfs:comment 'Reference catalog of lines of business and NAIC line codes (GL, CGL, BOP, WC, APD, PIP) used consistently across policy, coverage, premium, claims, and reserves.' .

ind:Calendar rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Calendar' ;
    rdfs:comment 'Reference calendar of fiscal periods, accident years, and accounting months used for premium earning, reserve evaluation, and statutory reporting cadence.' .

ind:ServiceAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Service Assignment' ;
    rdfs:comment 'Association between claim and service_vendor capturing each engagement of a third-party vendor on a claim. Tracks assignment lifecycle, performance, and cost for vendor management and regulatory reporting..' .

ind:LocationCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Location Condition' ;
    rdfs:comment 'Association between policy conditions and insured locations. Tracks compliance status, due dates, and satisfaction for underwriting requirements imposed on specific premises..' .

ind:VehicleFormApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Vehicle Form Application' ;
    rdfs:comment 'Association between policy forms and insured vehicles, tracking which forms apply to each vehicle with effective dates, mandatory status, and state-specific versions for regulatory compliance and coverage verification..' .

ind:PremiumCessionAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Premium Cession Allocation' ;
    rdfs:comment 'Association product representing the allocation of direct policy premium transactions to reinsurance ceded premium transactions. Each record links one policy transaction to one ceded premium transaction with cession-specific allocation attributes..' .

ind:CoverageCession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Coverage Cession' ;
    rdfs:comment 'Junction table resolving the M:N relationship between policy coverages and reinsurance cessions. Captures coverage-specific ceded limits, share percentages, layer allocations, and effective dates for each coverage-cession pairing..' .

ind:ClaimPerilCausation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Claim Peril Causation' ;
    rdfs:comment 'Association between claim and peril capturing which perils contributed to a loss event. Records proximate vs concurrent cause determinations, contribution percentages for apportionment, and causation analysis required for coverage application and' .

ind:Cession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Cession' ;
    rdfs:comment 'Represents the cession of a specific policy coverage to a reinsurer. Captures the reinsurer\'s participation share, ceded limits, recoverable balances, and settlement status for each coverage-reinsurer combination..' .

ind:FormFiling rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Form Filing' ;
    rdfs:comment 'Represents the regulatory filing and approval of a policy form in a specific state. Each record tracks the filing status, approval dates, and effective period for one form-state combination managed by compliance teams..' .

ind:AuthorityTerritory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Producers ;
    rdfs:label 'Authority Territory' ;
    rdfs:comment 'Represents the delegated binding authority granted to a producer within a specific state jurisdiction. Captures state-specific limits, effective dates, and regulatory compliance requirements for each producer-state combination..' .

ind:VehicleClaimantInvolvement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Vehicle Claimant Involvement' ;
    rdfs:comment 'Association representing the involvement of a claimant with a specific insured vehicle in a claim event. Captures driver status, occupant position, fault allocation, and injury details specific to the vehicle-claimant relationship..' .

ind:LocationClaimantInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Riskexposure ;
    rdfs:label 'Location Claimant Interest' ;
    rdfs:comment 'Association between insured locations and claimants capturing property interest, loss exposure allocation, and claimant role at specific premises. Supports multi-party claims where multiple claimants assert interest in a single location or a claimant has' .

ind:Product rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Coverage ;
    rdfs:label 'Product' ;
    rdfs:comment 'Master reference table for product. Referenced by product_id.' .

ind:DocumentTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Document Template' ;
    rdfs:comment 'Master reference table for document_template. Referenced by template_id.' .

ind:Underwriter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Policy ;
    rdfs:label 'Underwriter' ;
    rdfs:comment 'Master reference table for underwriter. Referenced by underwriter_id.' .

ind:UserAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'User Account' ;
    rdfs:comment 'Master reference table for user_account. Referenced by generated_by_user_id.' .

ind:Party rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Party' ;
    rdfs:comment 'Master reference table for party. Referenced by assigned_to_party_id.' .

ind:ReserveStudy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Reserve Study' ;
    rdfs:comment 'Master reference table for reserve_study. Referenced by reserve_study_id.' .

ind:ActuarialAnalyst rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reservespayments ;
    rdfs:label 'Actuarial Analyst' ;
    rdfs:comment 'Master reference table for actuarial_analyst. Referenced by actuarial_analyst_id.' .

ind:Tpa rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Tpa' ;
    rdfs:comment 'Master reference table for tpa. Referenced by tpa_id.' .

ind:Attorney rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claims ;
    rdfs:label 'Attorney' ;
    rdfs:comment 'Master reference table for attorney. Referenced by attorney_id.' .

# --- Attribute Properties ---
ind:adjusterId rdf:type rdf:Property ;
    rdfs:label 'Adjuster Id' ;
    rdfs:comment 'Unique identifier for the claims adjuster record. Primary key.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:licenseIssueCalendarId rdf:type rdf:Property ;
    rdfs:label 'License Issue Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Adjuster license issue date tracks license lifecycle for compliance monitoring and license history analysis. Essential for adjuster qualification tracking and regulatory compliance.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:licenseStateId rdf:type rdf:Property ;
    rdfs:label 'License State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Adjuster license state links to state licensing authority (DOI) for license verification, continuing education requirements, and regulatory compliance.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:State .

ind:supervisorAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Adjuster Id' ;
    rdfs:comment 'Identifier of the supervising adjuster or claims manager responsible for oversight and escalations.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:tpaId rdf:type rdf:Property ;
    rdfs:label 'Tpa Id' ;
    rdfs:comment 'Foreign key linking to claims.tpa. Business justification: Adjusters can be employed by TPAs (Third Party Administrators) rather than directly by the insurer. One TPA employs many adjusters; one adjuster works for one TPA (when adjuster_type = \'TPA\').' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Tpa .

ind:adjusterType rdf:type rdf:Property ;
    rdfs:label 'Adjuster Type' ;
    rdfs:comment 'Classification of adjuster employment relationship: staff employee, independent contractor, Third-Party Administrator (TPA), Catastrophe (CAT) specialist, or public adjuster.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date the most recent background check was completed for compliance and risk management.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backgroundCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Background Check Status' ;
    rdfs:comment 'Result status of the most recent background check screening.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceDueDate rdf:type rdf:Property ;
    rdfs:label 'Ce Due Date' ;
    rdfs:comment 'Date by which the adjuster must complete required continuing education hours to maintain license.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:continuingEducationHours rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Hours' ;
    rdfs:comment 'Total continuing education hours completed in the current licensing period for compliance tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Timestamp when the adjuster record was first created in the system.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:currentWorkloadCount rdf:type rdf:Property ;
    rdfs:label 'Current Workload Count' ;
    rdfs:comment 'Number of open claims currently assigned to the adjuster for capacity planning and workload balancing.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Primary business email address for adjuster communication and claim correspondence.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentStatus rdf:type rdf:Property ;
    rdfs:label 'Employment Status' ;
    rdfs:comment 'Current employment or engagement status of the adjuster.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Eo Expiration Date' ;
    rdfs:comment 'Expiration date of the errors and omissions insurance policy for compliance monitoring.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eoInsuranceCarrier rdf:type rdf:Property ;
    rdfs:label 'Eo Insurance Carrier' ;
    rdfs:comment 'Name of the insurance carrier providing errors and omissions coverage for the adjuster.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Eo Policy Number' ;
    rdfs:comment 'Policy number of the errors and omissions insurance coverage required for independent adjusters.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fein rdf:type rdf:Property ;
    rdfs:label 'Fein' ;
    rdfs:comment 'Federal tax identification number for independent adjusters operating as business entities.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Legal first name of the adjuster as registered with licensing authorities.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hireDate rdf:type rdf:Property ;
    rdfs:label 'Hire Date' ;
    rdfs:comment 'Date the adjuster was hired or contracted to begin claims handling services.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:homeOfficeLocation rdf:type rdf:Property ;
    rdfs:label 'Home Office Location' ;
    rdfs:comment 'Primary office or branch location where the adjuster is based for assignment and reporting purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Legal last name of the adjuster as registered with licensing authorities.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Date the adjuster license expires and requires renewal to maintain active status.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'License Issue Date' ;
    rdfs:comment 'Date the adjuster license was originally issued by the state Department of Insurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'Primary state-issued adjuster license number for regulatory compliance and claim handling authority.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseStatus rdf:type rdf:Property ;
    rdfs:label 'License Status' ;
    rdfs:comment 'Current regulatory status of the adjuster license with the state Department of Insurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobAuthority rdf:type rdf:Property ;
    rdfs:label 'Lob Authority' ;
    rdfs:comment 'Comma-separated list of lines of business the adjuster is authorized to handle based on license and training. [ENUM-REF-CANDIDATE: personal_auto|commercial_auto|homeowners|commercial_property|GL|WC|umbrella|inland_marine — promote to reference product]' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxWorkloadCapacity rdf:type rdf:Property ;
    rdfs:label 'Max Workload Capacity' ;
    rdfs:comment 'Maximum number of concurrent claims the adjuster can handle based on complexity and line of business.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:middleName rdf:type rdf:Property ;
    rdfs:label 'Middle Name' ;
    rdfs:comment 'Middle name or initial of the adjuster.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobileNumber rdf:type rdf:Property ;
    rdfs:label 'Mobile Number' ;
    rdfs:comment 'Mobile phone number for field adjuster contact and emergency communication.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicCode rdf:type rdf:Property ;
    rdfs:label 'Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code if adjuster is associated with a specific carrier for regulatory reporting.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-form notes capturing special skills, restrictions, preferences, or administrative remarks about the adjuster.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:number rdf:type rdf:Property ;
    rdfs:label 'Number' ;
    rdfs:comment 'Business identifier assigned to the adjuster for external reference and licensing purposes.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneNumber rdf:type rdf:Property ;
    rdfs:label 'Phone Number' ;
    rdfs:comment 'Primary contact phone number for the adjuster.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Reserve Authority Limit' ;
    rdfs:comment 'Maximum dollar amount the adjuster is authorized to establish or modify case reserves without supervisory approval.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Settlement Authority Limit' ;
    rdfs:comment 'Maximum dollar amount the adjuster is authorized to settle without supervisory approval.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialization rdf:type rdf:Property ;
    rdfs:label 'Specialization' ;
    rdfs:comment 'Primary area of claims expertise such as CAT, auto physical damage, general liability, workers compensation, property, or medical. [ENUM-REF-CANDIDATE: CAT|auto|APD|GL|CGL|WC|property|medical|subrogation|fraud — promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnLastFour rdf:type rdf:Property ;
    rdfs:label 'Ssn Last Four' ;
    rdfs:comment 'Last four digits of the adjuster Social Security Number for identity verification and tax reporting.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Date the adjuster employment or contract was terminated.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:territoryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Code' ;
    rdfs:comment 'Geographic territory code defining the adjuster service area for claim assignment routing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Timestamp when the adjuster record was last modified.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vendorCompanyName rdf:type rdf:Property ;
    rdfs:label 'Vendor Company Name' ;
    rdfs:comment 'Name of the independent adjusting firm or TPA if adjuster is not a staff employee.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContractNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Contract Number' ;
    rdfs:comment 'Contract or agreement number governing the independent adjuster or TPA engagement terms.' ;
    rdfs:domain ind:Adjuster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsOfExperience rdf:type rdf:Property ;
    rdfs:label 'Years Of Experience' ;
    rdfs:comment 'Total years of claims adjusting experience across all employers and lines of business.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjusterAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Adjuster Assignment Id' ;
    rdfs:comment 'Unique identifier for the adjuster assignment record.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentCalendarId rdf:type rdf:Property ;
    rdfs:label 'Assignment Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Adjuster assignment date determines assignment period for workload analysis, assignment lag metrics, and operational reporting.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:claimId rdf:type rdf:Property ;
    rdfs:label 'Claim Id' ;
    rdfs:comment 'Reference to the claim being assigned to an adjuster.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:insuredLocationId rdf:type rdf:Property ;
    rdfs:label 'Insured Location Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.insured_location. Business justification: Adjuster assignments for property claims must link to location for geographic routing, workload management by territory, travel optimization, and local expertise matching.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredLocation .

ind:primaryAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Primary Adjuster Id' ;
    rdfs:comment 'Reference to the adjuster assigned to handle the claim.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:actualHours rdf:type rdf:Property ;
    rdfs:label 'Actual Hours' ;
    rdfs:comment 'Actual number of hours spent by the adjuster on this claim assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignedByName rdf:type rdf:Property ;
    rdfs:label 'Assigned By Name' ;
    rdfs:comment 'Name of the user or system that performed the assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Assigned By User Code' ;
    rdfs:comment 'Reference to the user who performed the assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Date' ;
    rdfs:comment 'Date when the adjuster was assigned to the claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assignment Method' ;
    rdfs:comment 'Method used to assign the adjuster: manual selection, automatic routing, round-robin, skill-based matching, geographic proximity, or workload balancing algorithm.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes' ;
    rdfs:comment 'Free-text notes or comments regarding the assignment, including special instructions or context.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assignment Number' ;
    rdfs:comment 'Business-readable unique identifier for the assignment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentReason rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason' ;
    rdfs:comment 'Business reason for the assignment: initial intake, workload balancing, expertise required, geographic coverage, catastrophe response, or other justification.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentRole rdf:type rdf:Property ;
    rdfs:label 'Assignment Role' ;
    rdfs:comment 'Role of the adjuster in this assignment: primary handler, supervisor, catastrophe adjuster, specialist, desk adjuster, field adjuster, or independent adjuster.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current status of the adjuster assignment.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assignment Timestamp' ;
    rdfs:comment 'Precise timestamp when the adjuster assignment was created.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentType rdf:type rdf:Property ;
    rdfs:label 'Assignment Type' ;
    rdfs:comment 'Type of assignment: initial assignment, reassignment, escalation, transfer, temporary coverage, or permanent assignment.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catCode rdf:type rdf:Property ;
    rdfs:label 'Cat Code' ;
    rdfs:comment 'Catastrophe event code if this assignment is related to a declared catastrophe event.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complexityLevel rdf:type rdf:Property ;
    rdfs:label 'Complexity Level' ;
    rdfs:comment 'Assessed complexity level of the claim for assignment and workload planning purposes.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'Date when the assignment becomes effective.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Date when the assignment ended or was terminated.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endReason rdf:type rdf:Property ;
    rdfs:label 'End Reason' ;
    rdfs:comment 'Reason the assignment ended: claim closed, reassignment, adjuster departure, escalation, or other termination cause.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endTimestamp rdf:type rdf:Property ;
    rdfs:label 'End Timestamp' ;
    rdfs:comment 'Precise timestamp when the assignment was ended or terminated.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Hours' ;
    rdfs:comment 'Estimated number of hours required to handle this claim assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstContactDate rdf:type rdf:Property ;
    rdfs:label 'First Contact Date' ;
    rdfs:comment 'Date when the adjuster first contacted the claimant or insured after assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Indicates whether this is the current active assignment for the claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCatAssignment rdf:type rdf:Property ;
    rdfs:label 'Is Cat Assignment' ;
    rdfs:comment 'Indicates whether this assignment is part of a catastrophe response effort.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Indicates whether this adjuster is the primary handler for the claim.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'Date of the most recent activity or action taken by the adjuster on this assignment.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseRequired rdf:type rdf:Property ;
    rdfs:label 'License Required' ;
    rdfs:comment 'Adjuster license or certification required for this assignment based on jurisdiction and claim type.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lob rdf:type rdf:Property ;
    rdfs:label 'Lob' ;
    rdfs:comment 'Line of business for the claim: personal auto, homeowners, commercial property, general liability, workers compensation, or other product line.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Modified By User Code' ;
    rdfs:comment 'Reference to the user who last modified the assignment record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Timestamp when the assignment record was last modified.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reassignmentReason rdf:type rdf:Property ;
    rdfs:label 'Reassignment Reason' ;
    rdfs:comment 'Reason for reassigning the claim to a different adjuster: workload rebalancing, adjuster unavailability, escalation, conflict of interest, or other cause.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaTargetDays rdf:type rdf:Property ;
    rdfs:label 'Sla Target Days' ;
    rdfs:comment 'Target number of days to complete key milestones for this assignment per service level agreement.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialtyRequired rdf:type rdf:Property ;
    rdfs:label 'Specialty Required' ;
    rdfs:comment 'Specific adjuster specialty or expertise required for this assignment: bodily injury, property damage, subrogation, fraud investigation, large loss, or other specialization.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workloadPriority rdf:type rdf:Property ;
    rdfs:label 'Workload Priority' ;
    rdfs:comment 'Priority ranking of this assignment within the adjuster\'s workload, with lower numbers indicating higher priority.' ;
    rdfs:domain ind:AdjusterAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catEventId rdf:type rdf:Property ;
    rdfs:label 'Cat Event Id' ;
    rdfs:comment 'FK to reservespayments.cat_event.cat_event_id — Ties claims to the single catastrophe master for deterministic CAT rollups (PCS code aggregation) across claims, reserves, and reinsurance.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CatEvent .

ind:claimAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Claim Adjuster Id' ;
    rdfs:comment 'Reference to the claims adjuster assigned to handle this claim.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:claimExaminerAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Claim Examiner Adjuster Id' ;
    rdfs:comment 'Reference to the claims examiner responsible for oversight and approval of claim decisions.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:claimantPartyId rdf:type rdf:Property ;
    rdfs:label 'Claimant Party Id' ;
    rdfs:comment 'Reference to the party making the claim (insured, third party, or other claimant).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:currencyId rdf:type rdf:Property ;
    rdfs:label 'Currency Id' ;
    rdfs:comment 'Foreign key linking to shared.currency. Business justification: Multi-currency claim financials require proper currency reference for total_incurred_amount, paid_loss_amount, outstanding_reserve_amount, ALAE amounts, subrogation, salvage, and deductible.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Currency .

ind:dolCalendarId rdf:type rdf:Property ;
    rdfs:label 'Dol Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Date of loss determines accident year for loss development analysis, IBNR calculations, and statutory reporting.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:insuredVehicleId rdf:type rdf:Property ;
    rdfs:label 'Insured Vehicle Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.insured_vehicle. Business justification: Auto claims must link to the specific vehicle involved for VIN validation, coverage verification, vehicle valuation, total loss determination, and symbol rating validation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuredVehicle .

ind:lobCodeId rdf:type rdf:Property ;
    rdfs:label 'Lob Code Id' ;
    rdfs:comment 'Foreign key linking to shared.lob_code. Business justification: Claim LOB determines handling protocols, reserve authority limits, reinsurance treaty applicability, and statutory reporting classification.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LobCode .

ind:lossLocationCountryId rdf:type rdf:Property ;
    rdfs:label 'Loss Location Country Id' ;
    rdfs:comment 'Foreign key linking to shared.country. Business justification: Loss location country determines international jurisdiction, applicable law, reinsurance treaty applicability, and catastrophe exposure zone.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Country .

ind:lossLocationStateId rdf:type rdf:Property ;
    rdfs:label 'Loss Location State Id' ;
    rdfs:comment 'Foreign key linking to shared.state. Business justification: Loss location state determines jurisdiction for coverage interpretation, statute of limitations, comparative negligence rules, and regulatory reporting.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:State .

ind:coveragePolicyCoverageId rdf:type rdf:Property ;
    rdfs:label 'Coverage Policy Coverage Id' ;
    rdfs:comment 'Foreign key linking to coverage.coverage_policy_coverage. Business justification: Claims are filed under specific policy coverages. Core adjudication process requires linking claim to the exact coverage_policy_coverage for limit verification, deductible' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoveragePolicyCoverage .

ind:policyId rdf:type rdf:Property ;
    rdfs:label 'Policy Id' ;
    rdfs:comment 'Reference to the policy under which this claim is filed.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:policyInsuredId rdf:type rdf:Property ;
    rdfs:label 'Policy Insured Id' ;
    rdfs:comment 'Reference to the named insured party on the policy at the time of loss.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyInsured .

ind:producersProducerId rdf:type rdf:Property ;
    rdfs:label 'Producers Producer Id' ;
    rdfs:comment 'Foreign key linking to producers.producers_producer. Business justification: Claims must link to the producer who wrote the underlying policy for loss ratio calculation, contingent commission determination, producer performance evaluation, E&O exposure' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProducersProducer .

ind:scheduledItemId rdf:type rdf:Property ;
    rdfs:label 'Scheduled Item Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.scheduled_item. Business justification: Claims for scheduled personal property (jewelry, fine arts, collectibles) must link to the scheduled item for agreed value verification, appraisal validation, and item-specific' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScheduledItem .

ind:alaePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Alae Paid Amount' ;
    rdfs:comment 'Total allocated loss adjustment expenses paid to date (legal, expert, investigation costs directly attributable to this claim).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alaeReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Alae Reserve Amount' ;
    rdfs:comment 'Outstanding reserve for allocated loss adjustment expenses on this claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catIndicator rdf:type rdf:Property ;
    rdfs:label 'Cat Indicator' ;
    rdfs:comment 'Flag indicating whether the claim is part of a catastrophe event.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Status' ;
    rdfs:comment 'Current lifecycle status of the claim in the adjudication workflow.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimType rdf:type rdf:Property ;
    rdfs:label 'Claim Type' ;
    rdfs:comment 'Classification of the claim based on the relationship of the claimant to the policy (first-party, third-party, subrogation, salvage).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'The date the claim was closed (final closure if reopened multiple times).' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closedReason rdf:type rdf:Property ;
    rdfs:label 'Closed Reason' ;
    rdfs:comment 'Reason code or description for claim closure (e.g., paid in full, denied, withdrawn, settled).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Policy deductible amount applicable to this claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dol rdf:type rdf:Property ;
    rdfs:label 'Dol' ;
    rdfs:comment 'The date on which the loss event occurred.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fnolDate rdf:type rdf:Property ;
    rdfs:label 'Fnol Date' ;
    rdfs:comment 'The date the claim was first reported to the insurer.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fnolTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fnol Timestamp' ;
    rdfs:comment 'The precise timestamp when the claim was first reported to the insurer.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fraudIndicator rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator' ;
    rdfs:comment 'Flag indicating whether the claim has been flagged for potential fraud investigation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:litigationIndicator rdf:type rdf:Property ;
    rdfs:label 'Litigation Indicator' ;
    rdfs:comment 'Flag indicating whether the claim is in litigation or legal proceedings.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCause rdf:type rdf:Property ;
    rdfs:label 'Loss Cause' ;
    rdfs:comment 'The peril or cause of loss (e.g., collision, fire, theft, wind, hail, water damage, liability incident).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossDescription rdf:type rdf:Property ;
    rdfs:label 'Loss Description' ;
    rdfs:comment 'Narrative description of the loss event and circumstances as reported by the claimant or adjuster.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossTime rdf:type rdf:Property ;
    rdfs:label 'Loss Time' ;
    rdfs:comment 'The precise timestamp when the loss event occurred, if known.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outstandingReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Reserve Amount' ;
    rdfs:comment 'Current outstanding case reserve amount for unpaid losses on this claim.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Loss Amount' ;
    rdfs:comment 'Total amount paid to date for indemnity losses on this claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reopenedCount rdf:type rdf:Property ;
    rdfs:label 'Reopened Count' ;
    rdfs:comment 'Number of times the claim has been reopened after initial closure.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportedBy rdf:type rdf:Property ;
    rdfs:label 'Reported By' ;
    rdfs:comment 'Name or identifier of the person or entity who reported the claim (insured, agent, third party).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValueAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Amount' ;
    rdfs:comment 'Estimated or realized salvage value from damaged property retained by the insurer.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'The date a settlement agreement was reached with the claimant.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationPotentialAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Potential Amount' ;
    rdfs:comment 'Estimated recoverable amount from subrogation against responsible third parties.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationRecoveredAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Recovered Amount' ;
    rdfs:comment 'Actual amount recovered to date through subrogation activities.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalIncurredAmount rdf:type rdf:Property ;
    rdfs:label 'Total Incurred Amount' ;
    rdfs:comment 'Total incurred loss amount including paid losses, outstanding case reserves, and allocated loss adjustment expenses.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCoverageId rdf:type rdf:Property ;
    rdfs:label 'Claim Coverage Id' ;
    rdfs:comment 'Unique identifier for the claim coverage junction record linking a claim to a specific policy coverage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimCoverage .

ind:coverageAdjusterId rdf:type rdf:Property ;
    rdfs:label 'Coverage Adjuster Id' ;
    rdfs:comment 'Identifier of the adjuster who made the coverage determination for this claim coverage.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjuster .

ind:policyCoverageId rdf:type rdf:Property ;
    rdfs:label 'Policy Coverage Id' ;
    rdfs:comment 'Foreign key reference to the specific policy coverage being applied to this claim.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyCoverage .

ind:lossCalendarId rdf:type rdf:Property ;
    rdfs:label 'Loss Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Coverage loss date determines coverage trigger analysis for claims-made vs. occurrence policies. Essential for coverage determination, policy period matching, and trigger date disputes.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:riskUnitId rdf:type rdf:Property ;
    rdfs:label 'Risk Unit Id' ;
    rdfs:comment 'Foreign key linking to riskexposure.risk_unit. Business justification: Coverage determinations must link to the specific risk unit that was rated and covered for exposure validation, limit verification, deductible application, and premium allocation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskUnit .

ind:applicableDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Applicable Deductible Amount' ;
    rdfs:comment 'The deductible amount that applies to this coverage for the claim, representing the insured\'s out-of-pocket responsibility before coverage begins.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicableLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Applicable Limit Amount' ;
    rdfs:comment 'The maximum coverage limit amount applicable to this specific coverage for the claim, reflecting per-occurrence, per-person, or aggregate limits.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicableSirAmount rdf:type rdf:Property ;
    rdfs:label 'Applicable Sir Amount' ;
    rdfs:comment 'The self-insured retention amount applicable to this coverage, representing the amount the insured must pay before the insurer\'s obligation begins.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percentage' ;
    rdfs:comment 'The percentage of loss shared by the insured after deductible is met, expressed as a decimal percentage.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageAlaeAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Alae Amount' ;
    rdfs:comment 'Allocated loss adjustment expenses directly attributable to this coverage, including legal fees, expert fees, and investigation costs.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageBasis rdf:type rdf:Property ;
    rdfs:label 'Coverage Basis' ;
    rdfs:comment 'The basis on which coverage limits and deductibles apply, such as per occurrence, per claim, or aggregate.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDenialReasonCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Denial Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for coverage denial if coverage status is denied, such as exclusion, policy lapse, or non-covered peril.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDenialReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Denial Reason Description' ;
    rdfs:comment 'Detailed explanation of why coverage was denied for this claim under this specific coverage.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Determination Date' ;
    rdfs:comment 'Date when the coverage determination was made by the adjuster or underwriter for this claim coverage.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageIncurredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Incurred Loss Amount' ;
    rdfs:comment 'Total incurred loss amount attributed to this specific coverage, including paid losses and outstanding reserves.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageNotes rdf:type rdf:Property ;
    rdfs:label 'Coverage Notes' ;
    rdfs:comment 'Free-text notes documenting coverage decisions, special considerations, or adjuster commentary for this claim coverage.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageOutstandingReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Outstanding Reserve Amount' ;
    rdfs:comment 'Outstanding case reserve amount held for this specific coverage representing estimated future payments.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coveragePaidLossAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Paid Loss Amount' ;
    rdfs:comment 'Total amount of loss payments made under this specific coverage to date.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coveragePart rdf:type rdf:Property ;
    rdfs:label 'Coverage Part' ;
    rdfs:comment 'The specific part or section of the policy coverage applicable to this claim, such as liability, property, medical payments, or other coverage divisions.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Current adjudication status of this coverage for the claim indicating whether coverage applies, is denied, or is under review.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTriggerType rdf:type rdf:Property ;
    rdfs:label 'Coverage Trigger Type' ;
    rdfs:comment 'The type of trigger that activates this coverage, such as occurrence-based, claims-made, or manifestation trigger.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUserCode rdf:type rdf:Property ;
    rdfs:label 'Created By User Code' ;
    rdfs:comment 'Identifier of the user or system process that created this claim coverage record.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleSatisfiedDate rdf:type rdf:Property ;
    rdfs:label 'Deductible Satisfied Date' ;
    rdfs:comment 'Date when the deductible was fully satisfied for this coverage.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deductibleSatisfiedFlag rdf:type rdf:Property ;
    rdfs:label 'Deductible Satisfied Flag' ;
    rdfs:comment 'Indicates whether the applicable deductible has been fully satisfied by the insured for this coverage.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Applied Flag' ;
    rdfs:comment 'Indicates whether a policy exclusion was applied that affects coverage for this claim.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionCode rdf:type rdf:Property ;
    rdfs:label 'Exclusion Code' ;
    rdfs:comment 'Code identifying the specific policy exclusion applied to this claim coverage, if applicable.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitErosionAmount rdf:type rdf:Property ;
    rdfs:label 'Limit Erosion Amount' ;
    rdfs:comment 'The amount by which the coverage limit has been reduced due to prior claims or payments under the same policy term.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossDate rdf:type rdf:Property ;
    rdfs:label 'Loss Date' ;
    rdfs:comment 'Date when the loss occurred, used to determine coverage applicability and trigger evaluation.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Policy Effective Date' ;
    rdfs:comment 'Effective date of the policy coverage at the time of loss, used to validate coverage applicability.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Policy Expiration Date' ;
    rdfs:comment 'Expiration date of the policy coverage at the time of loss, used to validate coverage applicability.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remainingLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Limit Amount' ;
    rdfs:comment 'The remaining available coverage limit after accounting for limit erosion and current claim incurred amounts.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sublimitAmount rdf:type rdf:Property ;
    rdfs:label 'Sublimit Amount' ;
    rdfs:comment 'The sublimit amount applicable to this coverage if a sublimit applies, representing a lower maximum payout for specific perils or property types.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sublimitAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Sublimit Applied Flag' ;
    rdfs:comment 'Indicates whether a sublimit applies to this coverage for the claim, restricting the maximum payout below the main policy limit.' ;
    rdfs:domain ind:ClaimCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:updatedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Updated By User Code' ;
    rdfs:comment 'Identifier of the user or system process that last updated this claim coverage record.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimDocumentId rdf:type rdf:Property ;
    rdfs:label 'Claim Document Id' ;
    rdfs:comment 'Unique identifier for the claim document record.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentCalendarId rdf:type rdf:Property ;
    rdfs:label 'Document Calendar Id' ;
    rdfs:comment 'Foreign key linking to shared.calendar. Business justification: Claim document date determines document period for document management, retention policy application, and audit trail. Essential for document lifecycle management and legal hold tracking.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:fnolId rdf:type rdf:Property ;
    rdfs:label 'Fnol Id' ;
    rdfs:comment 'Reference to the FNOL record if document was submitted at intake.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fnol .

ind:approvedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Approved By User Code' ;
    rdfs:comment 'User identifier of the person who approved the document.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Date the document was approved for use in claim processing.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedFlag rdf:type rdf:Property ;
    rdfs:label 'Approved Flag' ;
    rdfs:comment 'Indicates whether the document has been approved for use in claim adjudication.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorName rdf:type rdf:Property ;
    rdfs:label 'Author Name' ;
    rdfs:comment 'Name of the person or entity who authored or created the document.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorOrganization rdf:type rdf:Property ;
    rdfs:label 'Author Organization' ;
    rdfs:comment 'Organization or company affiliation of the document author.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialFlag rdf:type rdf:Property ;
    rdfs:label 'Confidential Flag' ;
    rdfs:comment 'Indicates whether the document contains confidential or sensitive information.' ;
    rdfs:domain ind:Claims ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimDocumentDescription rdf:type rdf:Property ;
    rdfs:label 'Claim Document Description' ;
    rdfs:comment 'Free-text description or summary of the document content and purpose.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDate rdf:type rdf:Property ;
    rdfs:label 'Document Date' ;
    rdfs:comment 'Date the document was originally created or issued by the author.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'Business-facing unique document number or reference code.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current lifecycle status of the document in the claims workflow. [ENUM-REF-CANDIDATE: pending_review|approved|rejected|archived|deleted|under_review|requires_resubmission — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSubtype rdf:type rdf:Property ;
    rdfs:label 'Document Subtype' ;
    rdfs:comment 'Granular subtype or category within the primary document type.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Classification of the document type supporting claim adjudication. [ENUM-REF-CANDIDATE: police_report|medical_record|repair_estimate|photo|video|dec_page|correspondence|legal_filing|subrogation_demand|witness_statement|appraisal|invoice — 12 candidates' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ecmFolderPath rdf:type rdf:Property ;
    rdfs:label 'Ecm Folder Path' ;
    rdfs:comment 'Hierarchical folder or path location within the ECM repository.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ecmRepository rdf:type rdf:Property ;
    rdfs:label 'Ecm Repository' ;
    rdfs:comment 'Name of the ECM or document management system storing the file.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileExtension rdf:type rdf:Property ;
    rdfs:label 'File Extension' ;
    rdfs:comment 'File format extension indicating the document type. [ENUM-REF-CANDIDATE: pdf|jpg|jpeg|png|tif|tiff|doc|docx|xls|xlsx|msg|eml — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileName rdf:type rdf:Property ;
    rdfs:label 'File Name' ;
    rdfs:comment 'Original file name of the uploaded or scanned document.' ;
    rdfs:domain ind:ClaimDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'File Size Bytes' ;
    rdfs:comment 'Size of the document file in bytes for storage and retrieval tracking.' ;
    rdfs:domain ind:PcInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:legalHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Flag' ;
    rdfs:comment 'Indicates whether the document is under legal hold and cannot be destroyed.' ;
