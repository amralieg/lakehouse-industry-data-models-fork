ind:spaceAllocationType rdf:type rdf:Property ;
    rdfs:label 'Space Allocation Type' ;
    rdfs:comment 'Type of space allocated on the vessel for this reservation.' ;
    rdfs:domain ind:Reservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loyaltyProgramNumber rdf:type rdf:Property ;
    rdfs:label 'Loyalty Program Number' ;
    rdfs:comment 'Frequent rider or loyalty program membership number if applicable.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactName rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Name' ;
    rdfs:comment 'Name of emergency contact person provided by the passenger.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Phone' ;
    rdfs:comment 'Phone number of emergency contact person provided by the passenger.' ;
