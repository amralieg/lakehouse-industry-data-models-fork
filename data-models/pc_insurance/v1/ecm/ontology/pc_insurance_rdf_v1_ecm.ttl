ind:sharedLimitGroupStatus rdf:type rdf:Property ;
    rdfs:label 'Shared Limit Group Status' ;
    rdfs:comment 'Current lifecycle status of the shared limit group in the underwriting and policy administration system.' ;
    rdfs:domain ind:SharedLimitGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentRuleSetId rdf:type rdf:Property ;
    rdfs:label 'Parent Rule Set Id' ;
    rdfs:comment 'Reference to a parent rating rule set when this rule set is a specialized or derived version, enabling hierarchical rule set structures.' ;
    rdfs:domain ind:RatingRuleSet ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RatingRuleSet .

ind:actuarialBasis rdf:type rdf:Property ;
    rdfs:label 'Actuarial Basis' ;
    rdfs:comment 'Description of the actuarial data, loss experience, and statistical methods underlying the development of this rating rule set.' ;
    rdfs:domain ind:RatingRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catastropheLoadPercentage rdf:type rdf:Property ;
    rdfs:label 'Catastrophe Load Percentage' ;
    rdfs:comment 'Additional premium percentage loaded into rates to cover expected catastrophe losses for the jurisdiction and line of business.' ;
    rdfs:domain ind:RatingRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCostMultiplier rdf:type rdf:Property ;
    rdfs:label 'Loss Cost Multiplier' ;
    rdfs:comment 'Factor applied to advisory loss costs to derive final premium rates, incorporating expenses, profit, and contingencies.' ;
    rdfs:domain ind:RatingRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorityOrder rdf:type rdf:Property ;
    rdfs:label 'Priority Order' ;
    rdfs:comment 'Numeric sequence defining the order in which this rating rule set is applied when multiple rule sets are chained in a rating workflow.' ;
    rdfs:domain ind:RatingRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:profitMarginPercentage rdf:type rdf:Property ;
    rdfs:label 'Profit Margin Percentage' ;
    rdfs:comment 'Target profit margin built into the premium rates calculated by this rating rule set, expressed as a percentage.' ;
    rdfs:domain ind:RatingRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Rating Algorithm' ;
    rdfs:comment 'Mathematical approach used by this rule set to calculate premium factors or rates.' ;
    rdfs:domain ind:RatingRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roundingRule rdf:type rdf:Property ;
    rdfs:label 'Rounding Rule' ;
