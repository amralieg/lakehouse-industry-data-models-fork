ind:serviceFrequencyPerDay rdf:type rdf:Property ;
    rdfs:label 'Service Frequency Per Day' ;
    rdfs:comment 'Number of times this train service operates per day on the specified route.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalService rdf:type rdf:Property ;
    rdfs:label 'Seasonal Service' ;
    rdfs:comment 'Indicates whether this train service operates only during specific seasons of the year.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalMonths rdf:type rdf:Property ;
    rdfs:label 'Seasonal Months' ;
    rdfs:comment 'Specific months during which seasonal train service operates (e.g., June-September).' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherDependent rdf:type rdf:Property ;
    rdfs:label 'Weather Dependent' ;
    rdfs:comment 'Indicates whether train service operations are subject to weather conditions and may be cancelled or modified.' ;
    rdfs:domain ind:Ncdot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alternateRouteAvailable rdf:type rdf:Property ;
