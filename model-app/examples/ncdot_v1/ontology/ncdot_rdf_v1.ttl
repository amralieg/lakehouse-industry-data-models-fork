ind:documentationReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Documentation Received Date' ;
    rdfs:comment 'Date when required supporting documentation was received by benefits administration.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carrierPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Carrier Policy Number' ;
    rdfs:comment 'Policy or contract number assigned by the insurance carrier for this coverage.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierMemberId rdf:type rdf:Property ;
    rdfs:label 'Carrier Member Id' ;
    rdfs:comment 'Member identification number assigned by the insurance carrier to the employee.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierGroupNumber rdf:type rdf:Property ;
    rdfs:label 'Carrier Group Number' ;
    rdfs:comment 'Group number assigned by the insurance carrier to identify NCDOT as the employer group.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preTaxFlag rdf:type rdf:Property ;
    rdfs:label 'Pre Tax Flag' ;
    rdfs:comment 'Indicates whether employee premium contributions are deducted on a pre-tax basis under Section 125 cafeteria plan.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tobaccoUserFlag rdf:type rdf:Property ;
    rdfs:label 'Tobacco User Flag' ;
    rdfs:comment 'Indicates whether the employee is a tobacco user, which may affect premium rates for health insurance.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wellnessProgramParticipantFlag rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Participant Flag' ;
    rdfs:comment 'Indicates whether the employee is participating in employer wellness programs that may affect premium rates.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabilityAccommodationFlag rdf:type rdf:Property ;
    rdfs:label 'Disability Accommodation Flag' ;
    rdfs:comment 'Indicates whether the employee requires disability accommodations related to benefit enrollment or administration.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentNotes rdf:type rdf:Property ;
    rdfs:label 'Enrollment Notes' ;
    rdfs:comment 'Free-text notes or comments related to the enrollment transaction, recorded by benefits administrator or HR.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingCourseId rdf:type rdf:Property ;
    rdfs:label 'Training Course Id' ;
    rdfs:comment 'Unique identifier for the training course record. Primary key for the training course entity.' ;
    rdfs:domain ind:Hr ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrainingCourse .

ind:courseCode rdf:type rdf:Property ;
    rdfs:label 'Course Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to identify the training course in the learning management system. Used for course registration and tracking.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseTitle rdf:type rdf:Property ;
    rdfs:label 'Course Title' ;
    rdfs:comment 'Official title or name of the training course as it appears in the course catalog and on certificates.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseDescription rdf:type rdf:Property ;
    rdfs:label 'Course Description' ;
    rdfs:comment 'Detailed description of the training course content, objectives, and learning outcomes. Provides employees with information about what they will learn.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseCategory rdf:type rdf:Property ;
    rdfs:label 'Course Category' ;
    rdfs:comment 'High-level classification of the training course type. Used for organizing courses in the catalog and reporting on training by category.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseSubcategory rdf:type rdf:Property ;
    rdfs:label 'Course Subcategory' ;
    rdfs:comment 'More granular classification within the course category. Provides additional detail for course organization and filtering.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditHours rdf:type rdf:Property ;
    rdfs:label 'Credit Hours' ;
    rdfs:comment 'Number of continuing education or professional development credit hours awarded upon successful completion of the course. May be used for certification maintenance or professional licensing requirements.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceuCredits rdf:type rdf:Property ;
    rdfs:label 'Ceu Credits' ;
    rdfs:comment 'Number of Continuing Education Units awarded for course completion. CEUs are a standardized measure used by many professional organizations and licensing boards.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:courseLevel rdf:type rdf:Property ;
    rdfs:label 'Course Level' ;
    rdfs:comment 'Difficulty or experience level required for the training course. Helps employees select appropriate courses based on their current skill level.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prerequisites rdf:type rdf:Property ;
    rdfs:label 'Prerequisites' ;
    rdfs:comment 'Description of any prerequisite courses, certifications, or experience required before enrolling in this training course.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAudience rdf:type rdf:Property ;
    rdfs:label 'Target Audience' ;
    rdfs:comment 'Description of the intended audience for the training course, such as specific job roles, divisions, or employee groups.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Email' ;
    rdfs:comment 'Primary email address for contacting the external training vendor regarding course logistics, content, or scheduling.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Phone' ;
    rdfs:comment 'Primary phone number for contacting the external training vendor regarding course logistics, content, or scheduling.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPerParticipant rdf:type rdf:Property ;
    rdfs:label 'Cost Per Participant' ;
    rdfs:comment 'Cost charged per participant for the training course. Used for budgeting and tracking training expenditures.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumEnrollment rdf:type rdf:Property ;
    rdfs:label 'Maximum Enrollment' ;
    rdfs:comment 'Maximum number of participants that can enroll in a single offering of the training course. Used for capacity planning and registration management.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumEnrollment rdf:type rdf:Property ;
    rdfs:label 'Minimum Enrollment' ;
    rdfs:comment 'Minimum number of participants required for the training course to be conducted. Courses may be cancelled if minimum enrollment is not met.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationExpirationMonths rdf:type rdf:Property ;
    rdfs:label 'Certification Expiration Months' ;
    rdfs:comment 'Number of months until the certification awarded by this course expires and requires renewal or recertification.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isComplianceTraining rdf:type rdf:Property ;
    rdfs:label 'Is Compliance Training' ;
    rdfs:comment 'Indicates whether the training course is required for regulatory compliance, such as safety training, ethics training, or legal requirements.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceRegulation rdf:type rdf:Property ;
    rdfs:label 'Compliance Regulation' ;
    rdfs:comment 'Name of the specific regulation, standard, or legal requirement that this compliance training addresses (e.g., OSHA 1910, FHWA regulations).' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Recertification Required' ;
    rdfs:comment 'Indicates whether employees must retake or renew this training course periodically to maintain certification or compliance.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recertificationFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Recertification Frequency Months' ;
    rdfs:comment 'Number of months between required recertification or refresher training for this course.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:courseMaterialsUrl rdf:type rdf:Property ;
    rdfs:label 'Course Materials Url' ;
    rdfs:comment 'Web address or link to access course materials, handouts, presentations, or supplementary resources for the training course.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:learningManagementSystem rdf:type rdf:Property ;
    rdfs:label 'Learning Management System' ;
    rdfs:comment 'Name of the learning management system or platform where the course is hosted and managed (e.g., SAP SuccessFactors, Cornerstone, Moodle).' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseOwnerDivision rdf:type rdf:Property ;
    rdfs:label 'Course Owner Division' ;
    rdfs:comment 'NCDOT division or department responsible for developing, maintaining, and administering the training course.' ;
    rdfs:domain ind:TrainingCourse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseOwnerContactName rdf:type rdf:Property ;
    rdfs:label 'Course Owner Contact Name' ;
