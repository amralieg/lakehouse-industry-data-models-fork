ind:projectJustification rdf:type rdf:Property ;
    rdfs:label 'Project Justification' ;
    rdfs:comment 'Business case and rationale for the project, including needs assessment and expected benefits.' ;
    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purposeAndNeed rdf:type rdf:Property ;
    rdfs:label 'Purpose And Need' ;
    rdfs:comment 'Formal statement of the project purpose and transportation need being addressed, required for NEPA documentation.' ;
    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyImprovementIndicator rdf:type rdf:Property ;
    rdfs:label 'Safety Improvement Indicator' ;
    rdfs:comment 'Indicates whether the project includes safety improvements or is part of a highway safety program.' ;
    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:congestionReliefIndicator rdf:type rdf:Property ;
