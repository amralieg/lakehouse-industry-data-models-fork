ind:importDate rdf:type rdf:Property ;
    rdfs:label 'Import Date' ;
    rdfs:comment 'Date when the vehicle was imported into the United States. Null if domestically manufactured.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstRegistrationDate rdf:type rdf:Property ;
    rdfs:label 'First Registration Date' ;
    rdfs:comment 'Date when the vehicle was first registered in any jurisdiction, typically when sold as new.' ;
    rdfs:domain ind:Vehicle ;
    rdf:type owl:DatatypeProperty ;
