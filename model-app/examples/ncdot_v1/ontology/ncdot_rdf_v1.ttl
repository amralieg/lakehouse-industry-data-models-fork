ind:costCategoryName rdf:type rdf:Property ;
    rdfs:label 'Cost Category Name' ;
    rdfs:comment 'Descriptive name of the cost category for the budget allocation (e.g., Preliminary Engineering, Right-of-Way Acquisition, Construction, Utilities, Environmental Mitigation).' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programArea rdf:type rdf:Property ;
    rdfs:label 'Program Area' ;
    rdfs:comment 'The NCDOT program area or modal category to which the project budget is assigned for strategic planning and resource allocation.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationAmount rdf:type rdf:Property ;
    rdfs:label 'Obligation Amount' ;
    rdfs:comment 'The amount of budget that has been obligated through contracts, purchase orders, or other binding commitments.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Expenditure Amount' ;
    rdfs:comment 'The actual amount of budget that has been expended or paid out as of the reporting date.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableAmount rdf:type rdf:Property ;
    rdfs:label 'Available Amount' ;
    rdfs:comment 'The remaining budget amount available for new obligations, calculated as total budget minus obligations, expenditures, and encumbrances.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inflationFactor rdf:type rdf:Property ;
