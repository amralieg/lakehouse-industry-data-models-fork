    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bicyclePedestrianFacilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Bicycle Pedestrian Facility Indicator' ;
    rdfs:comment 'Indicates whether the project includes bicycle or pedestrian facilities.' ;
    rdfs:domain ind:PlannedProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitComponentIndicator rdf:type rdf:Property ;
    rdfs:label 'Transit Component Indicator' ;
    rdfs:comment 'Indicates whether the project includes public transit components or improvements.' ;
