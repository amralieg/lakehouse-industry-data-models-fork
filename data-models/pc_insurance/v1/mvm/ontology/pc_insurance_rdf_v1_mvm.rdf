    rdfs:range ind:Peril .

ind:auditFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Frequency' ;
    rdfs:comment 'Frequency at which policies bound under this authority must be audited: monthly, quarterly, semi-annual, annual, or per policy.' ;
