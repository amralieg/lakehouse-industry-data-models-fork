    rdfs:comment 'Name or identifier of the ticketing system used for passenger reservations and fare collection.' ;
    rdfs:domain ind:TrainSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fareClassAvailable rdf:type rdf:Property ;
    rdfs:label 'Fare Class Available' ;
