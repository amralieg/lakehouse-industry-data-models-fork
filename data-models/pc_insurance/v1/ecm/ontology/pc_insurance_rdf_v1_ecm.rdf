    rdfs:comment 'Current lifecycle status of this policy version snapshot. [ENUM-REF-CANDIDATE: DRAFT|QUOTED|BOUND|ISSUED|ACTIVE|EXPIRED|CANCELLED — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Version ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyBillStatementId rdf:type rdf:Property ;
