ind:wednesdayServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Wednesday Service Flag' ;
    rdfs:comment 'Indicates whether service operates on Wednesdays under this schedule.' ;
    rdfs:domain ind:TransitSchedule ;
    rdf:type owl:DatatypeProperty ;
